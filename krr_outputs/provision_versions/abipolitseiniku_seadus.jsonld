      }
    },
    {
      "@id": "estleg:ABIPOL_Par_28_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik võib füüsilist jõudu, erivahendit ja relva kasutada käesoleva seaduse §-des 29–36 sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_28 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_28_v114032014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 28",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_28_v114032014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik võib füüsilist jõudu, erivahendit ja relva kasutada korrakaitseseaduses sätestatud alusel ja korras ainult juhul, kui isikule kehtiva haldusaktiga ohu tõrjumiseks või korrarikkumise kõrvaldamiseks pandud kohustuse täitmise tagamine muu haldussunnivahendiga ei ole võimalik või ei ole õigel ajal võimalik. Kui hoiatusega määratakse isikule haldusakti täitmise tähtaeg, võib vahetut sundi kohaldada, kui isik jätab haldusakti tähtaja jooksul täitmata. (2) Abipolitseinik võib isiku suhtes kasutada käeraudu, kui on alust arvata, et isik võib: rünnata teist isikut, osutada korrakaitseorgani ametiisikule füüsilist vastupanu või kahjustada suure väärtusega varalist hüvet; põgeneda või teda võidakse ebaseaduslikult vabastada, kui temalt on seaduse alusel võetud vabadus, või ennast vigastada või enese tappa. (3) Kui käeraudade kasutamine ei ole võimalik, võib abipolitseinik käesoleva paragrahvi lõikes 2 nimetatud alustel kasutada sidumisvahendit, kui see ei sea ohtu isiku elu, ei tekita talle kehavigastust ega põhjusta kestvat füüsilist valu. Sidumisvahendi kasutamine ei tohi kesta üle ühe tunni järjest. (4) Abipolitseinikul ei ole õigust kasutada jalaraudu.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_28 (redaktsioon 114032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014005",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_28_v112032015074"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014005",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 28",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_28_v112032015074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik võib füüsilist jõudu, erivahendit ja relva kasutada korrakaitseseaduses sätestatud alusel ja korras, arvestades käesoleva seaduse erisusi. (2) Abipolitseinikul on õigus kohaldada vahetut sundi politseiametniku korraldusel, kui see on vältimatult vajalik politseiametniku poolt riikliku järelevalve meetme kohaldamise eesmärgi saavutamiseks.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_28 (redaktsioon 112032015074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015074",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015074",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 28",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_29_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik võib kohaldada vahetut sundi ainult juhul, kui isikule kehtiva haldusaktiga ohu tõrjumiseks või korrarikkumise kõrvaldamiseks pandud kohustuse täitmise tagamine muu haldussunnivahendiga ei ole võimalik või ei ole õigel ajal võimalik. Kui hoiatusega määratakse isikule haldusakti täitmise tähtaeg, võib vahetut sundi kohaldada, kui isik jätab haldusakti tähtaegselt täitmata. (2) Vahetut sundi on lubatud kohaldada ilma eelneva kohustava haldusaktita, kui haldusakti andmine ei ole võimalik vahetu kõrgendatud ohu tõrjumise või korrarikkumise kõrvaldamise kiire vajaduse tõttu.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_29 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_29_v114032014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 29",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_29_v114032014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ABIPOL_Par_29 (redaktsioon 114032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014005",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 29",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_3_v22280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik kinnitatakse politseiasutuse juhi käskkirjaga politseiametniku juurde või arvatakse politseiasutuse juures asuva abipolitseinike formeeringu koosseisu. (2) Abipolitseinike formeeringu moodustab ja selle töökorralduse kehtestab politseiasutuse juht. (3) Abipolitseinike väljaõpet korraldab politseiasutus. Väljaõppe nõuded kehtestab politseipeadirektor.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_3 (redaktsioon 22280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22280",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_3_v13246643"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22280",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_3_v13246643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik kinnitatakse politseiasutuse juhi käskkirjaga politseiametniku juurde või arvatakse politseiasutuse juures asuva abipolitseinike formeeringu koosseisu. (2) Abipolitseinike formeeringu moodustab ja selle töökorralduse kehtestab politseiasutuse juht. (3) Abipolitseinike väljaõpet korraldab politseiasutus. Väljaõppe nõuded kehtestab Politsei- ja Piirivalveameti peadirektor.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_3 (redaktsioon 13246643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13246643",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_3_v120122010001"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13246643",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_3_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseiniku pädevuses on politsei abistamine avalikku korda ähvardava ohu ennetamisel, väljaselgitamisel, tõrjumisel ja avaliku korra rikkumise kõrvaldamisel ning politsei abistamine liiklusturvalisuse tagamisel ja liiklusjärelevalve teostamisel. (2) Abipolitseinik võib politsei ülesandel teostada iseseisvalt järelevalvet avalikus kohas käitumise nõuete üle ning politsei ülesandel täita iseseisvalt ülesannet avalikku korda ähvardava vahetu kõrgendatud ohu tõrjumiseks.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_3 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_3_v112032015074"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_3_v112032015074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseiniku pädevuses on politsei abistamine avalikku korda ähvardava ohu ennetamisel, väljaselgitamisel, tõrjumisel ja avaliku korra rikkumise kõrvaldamisel ning politsei abistamine liiklusturvalisuse tagamisel ja liiklusjärelevalve teostamisel. (2) Abipolitseinik võib politsei ülesandel teostada iseseisvalt järelevalvet avalikus kohas käitumise nõuete üle ning politsei ülesandel täita iseseisvalt ülesannet avalikku korda ähvardava vahetu kõrgendatud ohu tõrjumiseks. (3) Abipolitseiniku pädevus võib isiku taotlusel piirduda ainult politsei abistamisega süüteoennetuses korrakaitseseaduse §-s 18 sätestatud alustel.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_3 (redaktsioon 112032015074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015074",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_3_v113032019029"
      },
      "estleg:versionValidTo": {
        "@value": "2019-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015074",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_3_v113032019029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseiniku pädevuses on politsei abistamine avalikku korda ähvardava ohu ennetamisel, väljaselgitamisel ja tõrjumisel ning avaliku korra rikkumise kõrvaldamisel. (2) Abipolitseinik võib politsei ülesandel teostada iseseisvalt liiklusjärelevalvet ja järelevalvet avalikus kohas käitumise nõuete üle ning politsei ülesandel täita iseseisvalt ülesannet avalikku korda ähvardava vahetu kõrgendatud ohu tõrjumiseks. (3) Abipolitseiniku pädevus võib isiku taotlusel piirduda ainult politsei abistamisega süüteoennetuses korrakaitseseaduse §-s 18 sätestatud alustel.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_3 (redaktsioon 113032019029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019029",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 3",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_30_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne vahetu sunni kohaldamist on abipolitseinik kohustatud hoiatama isikut, kelle suhtes või kelle omandis või valduses oleva looma või asja suhtes ta kavatseb vahetut sundi kohaldada. Võimaluse korral määratakse hoiatuses haldusakti täitmiseks tähtaeg, mis võimaldab haldusakti adressaadil kohustuse täita. (2) Kui hoiatus on tehtud kirjalikult, kordab abipolitseinik hoiatust suuliselt, enne kui asub vahetut sundi kohaldama. (3) Rahvahulga vastu vahetu sunni kohaldamisest tuleb isikuid võimaluse korral eelnevalt hoiatada arvestusega, et soovijatel oleks võimalik vabatahtlikult eemalduda. Rahvahulga vastu vahetut sundi kohaldades ei pea isikuid hoiatama nende suhtes tehnilise tõkke kasutamisest. (4) Hoiatamisest võib loobuda ainult juhul, kui hoiatamine ei ole võimalik vahetu kõrgendatud ohu tõrjumise või korrarikkumise kõrvaldamise kiire vajaduse tõttu. Tulirelva kasutamisest hoiatamise eest rahvahulga vastu ei või loobuda.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_30 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_30_v114032014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 30",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_30_v114032014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ABIPOL_Par_30 (redaktsioon 114032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014005",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 30",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_31_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vahetu sunni kohaldamisega tekitatakse isikule kehavigastus, on abipolitseinik kohustatud tagama isikule esimesel võimalusel esmaabi andmise ning vajaduse korral kiirabi kutsumise.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_31 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_31_v114032014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 31",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
