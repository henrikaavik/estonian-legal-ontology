      }
    },
    {
      "@id": "estleg:ABIPOL_Par_27_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vahetu sund on füüsilise isiku (edaspidi isik), looma või asja mõjutamine füüsilise jõuga, erivahendiga või relvaga. (2) Erivahend on asi, mis on ette nähtud isiku, looma või asja füüsiliseks mõjutamiseks ja mis ei ole relv.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_27 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_27_v114032014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 27",
      "estleg:partOfAct": {
