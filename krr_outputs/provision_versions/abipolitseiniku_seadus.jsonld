    },
    {
      "@id": "estleg:ABIPOL_Par_42_v112032015074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik vabastatakse abipolitseiniku staatusest Politsei- ja Piirivalveameti peadirektori või tema volitatud ametniku otsusega: abipolitseiniku algatusel; tema mittevastavuse korral käesoleva seaduse §-des 4 ja 5 ning § 8 lõikes 4 sätestatud tingimustele või seoses abipolitseinikule sobimatu käitumisega, sealhulgas kui abipolitseinik rikub avalikus kohas käitumise nõudeid või käitub muul viisil õigusvastaselt; abipolitseiniku surma korral.",
      "rdfs:label": {
