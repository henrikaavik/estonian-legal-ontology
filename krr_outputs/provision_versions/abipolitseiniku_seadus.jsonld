    {
      "@id": "estleg:ABIPOL_Par_5_v22280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei tegevuses osalemisel on abipolitseinikul õigus: nõuda õiguserikkujalt korrarikkumise lõpetamist ja avalikust korrast kinnipidamist; kontrollida õiguserikkumise toimepanemises kahtlustatava isikut tõendavaid dokumente; koostada protokolle nendes haldusõiguserikkumise asjades, mille kohta protokolli koostamise õigus on politseiametnikul; protokoll koostatakse politseiametniku puudumise korral või tema korraldusel; pidada seaduses ettenähtud korras kinni ja toimetada politseiasutusse kuriteo toimepanemises kahtlustatavaid isikuid ja teisi õiguserikkujaid; toimetada ravi- või politseiasutusse isikuid, kes alkohoolse-, toksilise- või narkootilise joobe tõttu võivad ohustada iseennast või teisi isikuid, samuti õiguserikkujaid nende isiku kindlakstegemiseks ja vajaduse korral haldusõiguserikkumise protokolli koostamiseks; politsei ülesandel korraldada isiku sundtoomist seaduses ettenähtud juhtudel; kontrollida koos politseiametnikuga seaduste ja muude õigusaktidega kehtestatud korras materiaalsete väärtuste hoidmist ettevõtetes, asutustes ja organisatsioonides; siseneda koos politseiga elanike valdusse, kaasa arvatud elu- ja muud ruumid, samuti organisatsioonide ruumidesse ja territooriumile kuriteo tõkestamiseks või kurjategija tabamiseks, samuti loodusõnnetuse või muu erakorralise sündmuse puhul, mis ohustab inimese elu või tervist; peatada õiguserikkumise kahtluse korral sõidukeid ning kontrollida juhi-, sõiduki- ja veosedokumente; kõrvaldada sõiduki juhtimiselt isik, kellel puudub vastava kategooria sõiduki juhtimise või kasutamise õigust tõendav dokument või keda kahtlustatakse alkohoolses, toksilises või narkootilises joobes, ning kontrollida joovet kohapeal või saata joobes kahtlustatav ekspertiisi; asutada vajaduse korral takistamatult organisatsioonile kuuluvaid sidevahendeid ning edasilükkamatul juhul ka mootorsõidukeid (välja arvatud välisriigi diplomaatilisele, konsulaar- või muule esindusele, samuti rahvusvahelisele organisatsioonile kuuluvad ning eriotstarbelised mootorsõidukid) vältimatut arstiabi vajavate isikute toimetamiseks raviasutusse; kontrollida tegevusloa või litsentsi olemasolu; kanda ja kasutada tulirelva ja erivahendeid politseiseaduse paragrahvides 14, 15 ja 151 sätestatud juhtudel ja korras; võtta sõiduki kütusepaagist või mujalt kütusesüsteemist proove selles sõidukis mootorikütusena kasutatava kütuse erimärgistatuse kindlakstegemiseks.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_5 (redaktsioon 22280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22280",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_5_v184440"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22280",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 5",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_5_v184440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei tegevuses osalemisel on abipolitseinikul õigus: nõuda õiguserikkujalt korrarikkumise lõpetamist ja avalikust korrast kinnipidamist; kontrollida õiguserikkumise toimepanemises kahtlustatava isikut tõendavaid dokumente; koostada protokolle nendes haldusõiguserikkumise asjades, mille kohta protokolli koostamise õigus on politseiametnikul; protokoll koostatakse politseiametniku puudumise korral või tema korraldusel; pidada seaduses ettenähtud korras kinni ja toimetada politseiasutusse kuriteo toimepanemises kahtlustatavaid isikuid ja teisi õiguserikkujaid; toimetada ravi- või politseiasutusse isikuid, kes alkohoolse-, toksilise- või narkootilise joobe tõttu võivad ohustada iseennast või teisi isikuid, samuti õiguserikkujaid nende isiku kindlakstegemiseks ja vajaduse korral haldusõiguserikkumise protokolli koostamiseks; politsei ülesandel korraldada isiku sundtoomist seaduses ettenähtud juhtudel; kontrollida koos politseiametnikuga seaduste ja muude õigusaktidega kehtestatud korras materiaalsete väärtuste hoidmist ettevõtetes, asutustes ja organisatsioonides; siseneda koos politseiga elanike valdusse, kaasa arvatud elu- ja muud ruumid, samuti organisatsioonide ruumidesse ja territooriumile kuriteo tõkestamiseks või kurjategija tabamiseks, samuti loodusõnnetuse või muu erakorralise sündmuse puhul, mis ohustab inimese elu või tervist; peatada õiguserikkumise kahtluse korral sõidukeid ning kontrollida juhi-, sõiduki- ja veosedokumente; 1O) kõrvaldada sõiduki juhtimiselt isik, kellel puudub vastava kategooria sõiduki juhtimise või kasutamise õigust tõendav dokument või keda kahtlustatakse alkohoolses, toksilises või narkootilises joobes, ning kontrollida joovet kohapeal või saata joobes kahtlustatav ekspertiisi; kasutada vajaduse korral takistamatult organisatsioonile kuuluvaid sidevahendeid ning edasilükkamatul juhul ka mootorsõidukeid (välja arvatud välisriigi diplomaatilisele, konsulaar- või muule esindusele, samuti rahvusvahelisele organisatsioonile kuuluvad ning eriotstarbelised mootorsõidukid) vältimatut arstiabi vajavate isikute toimetamiseks raviasutusse; kontrollida tegevusloa või litsentsi olemasolu; kanda ja kasutada tulirelva ja erivahendeid politseiseaduse paragrahvides 14, 15 ja 151 sätestatud juhtudel ja korras; võtta sõiduki kütusepaagist või mujalt kütusesüsteemist proove selles sõidukis mootorikütusena kasutatava kütuse erimärgistatuse kindlakstegemiseks.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_5 (redaktsioon 184440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184440",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_5_v228268"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/184440",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 5",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_5_v228268",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei tegevuses osalemisel on abipolitseinikul õigus: nõuda õiguserikkujalt korrarikkumise lõpetamist ja avalikust korrast kinnipidamist; kontrollida õiguserikkumise toimepanemises kahtlustatava isikut tõendavaid dokumente; [kehtetu]; pidada seaduses ettenähtud korras kinni ja toimetada politseiasutusse õiguserikkujaid ja õiguserikkumises kahtlustatavaid isikuid; toimetada ravi- või politseiasutusse isikuid, kes alkohoolse-, toksilise- või narkootilise joobe tõttu võivad ohustada iseennast või teisi isikuid, samuti õiguserikkujaid nende isiku kindlakstegemiseks ja vajaduse korral haldusõiguserikkumise protokolli koostamiseks; politsei ülesandel korraldada isiku sundtoomist seaduses ettenähtud juhtudel; kontrollida koos politseiametnikuga seaduste ja muude õigusaktidega kehtestatud korras materiaalsete väärtuste hoidmist ettevõtetes, asutustes ja organisatsioonides; siseneda koos politseiga elanike valdusse, kaasa arvatud elu- ja muud ruumid, samuti organisatsioonide ruumidesse ja territooriumile kuriteo tõkestamiseks või kurjategija tabamiseks, samuti loodusõnnetuse või muu erakorralise sündmuse puhul, mis ohustab inimese elu või tervist; peatada liiklusseaduse (RT I 2001, 3, 6; 2002, 92, 531) § 46 lõike 2 alusel Vabariigi Valitsuse poolt kehtestatud korras sõidukeid ning kontrollida sõitjate- ja veosevedu ning sõidudokumente; kõrvaldada sõiduki juhtimiselt isik, kellel puudub vastava kategooria sõiduki juhtimise või kasutamise õigust tõendav dokument või keda kahtlustatakse alkohoolses, toksilises või narkootilises joobes, ning kontrollida joovet kohapeal või saata joobes kahtlustatav ekspertiisi; kasutada vajaduse korral takistamatult organisatsioonile kuuluvaid sidevahendeid ning edasilükkamatul juhul ka mootorsõidukeid (välja arvatud välisriigi diplomaatilisele, konsulaar- või muule esindusele, samuti rahvusvahelisele organisatsioonile kuuluvad ning eriotstarbelised mootorsõidukid) vältimatut arstiabi vajavate isikute toimetamiseks raviasutusse; kontrollida tegevusloa või litsentsi olemasolu; kanda ja kasutada tulirelva ja erivahendeid politseiseaduse paragrahvides 14, 15 ja 151 sätestatud juhtudel ja korras; võtta sõiduki kütusepaagist või mujalt kütusesüsteemist proove selles sõidukis mootorikütusena kasutatava kütuse erimärgistatuse kindlakstegemiseks.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_5 (redaktsioon 228268)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "228268",
      "estleg:supersededByVersion": {
