      }
    },
    {
      "@id": "estleg:ABIPOL_Par_17_v13246643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "ABIPOL_Par_17 (redaktsioon 13246643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13246643",
      "estleg:supersededByVersion": {
