        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus sätestab abipolitseiniku õigused, kohustused ja tegevusala eesmärgiga kaasata kodanikke politseitegevusse avaliku korra kaitseks ja turvalise ühiskonna tagamiseks. (2) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_1 (redaktsioon 13246643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13246643",
