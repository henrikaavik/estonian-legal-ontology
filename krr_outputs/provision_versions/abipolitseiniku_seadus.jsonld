        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014005",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_4_v112032015074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikuks võib nimetada 18-aastaseks saanud vähemalt põhiharidusega Eesti kodaniku, kes oskab eesti keelt vähemalt B2-tasemel ning kes vastab abipolitseiniku kutsesobivuse nõuetele. (1¹) Abipolitseinikul, kes täidab politsei ülesandel iseseisvalt käesoleva seaduse § 3 lõikes 2 sätestatud ülesandeid, peab olema vähemalt keskharidus ja ta peab oskama eesti keelt vähemalt C1-tasemel. (2) Abipolitseinikuks ei või nimetada kohtunikku ja prokuröri. (3) Abipolitseiniku kutsesobivuse nõuded määrusega.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_4 (redaktsioon 112032015074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015074",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_4_v117122015033"
      },
      "estleg:versionValidTo": {
        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015074",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_4_v117122015033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikuks võib nimetada 18-aastaseks saanud vähemalt põhiharidusega Eesti kodaniku, kes oskab eesti keelt vähemalt B2-tasemel ning kes vastab abipolitseiniku kutsesobivuse nõuetele. (1¹) Abipolitseinikul, kes täidab politsei ülesandel iseseisvalt käesoleva seaduse § 3 lõikes 2 sätestatud ülesandeid, peab olema vähemalt keskharidus ja ta peab oskama eesti keelt vähemalt C1-tasemel. (2) Abipolitseinikuks ei või nimetada kohtunikku ja prokuröri. (3) Abipolitseiniku kutsesobivuse nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_4 (redaktsioon 117122015033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117122015033",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_40_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseiniku transpordi-, side- ja muud politseiasutuse juhi poolt ettenähtud ja temale ülesande täitmiseks vajalikud kulud hüvitab politseiasutus. (2) Kokkuleppel politseiasutusega võib käesoleva paragrahvi lõikes 1 nimetatud kulud hüvitada kohalik omavalitsus.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_40 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_40_v130122011058"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 40",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_40_v130122011058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseiniku transpordi-, side- ja muud Politsei- ja Piirivalveameti ettenähtud ja temale ülesande täitmiseks vajalikud kulud hüvitab Politsei- ja Piirivalveamet. (2) Politsei- ja Piirivalveametil on õigus hüvitada abipolitseiniku tervisekontrolli kulutusi. (3) Käesoleva paragrahvi lõikes 1 nimetatud kulude hüvitamise piirmäära ja korra kehtestab Politsei- ja Piirivalveameti peadirektor käskkirjaga. (4) Kokkuleppel Politsei- ja Piirivalveametiga võib käesoleva paragrahvi lõikes 1 nimetatud kulud hüvitada kohalik omavalitsus.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_40 (redaktsioon 130122011058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011058",
