        "@type": "xsd:date"
      },
      "estleg:versionText": "ÕIEND Kustutatud § 11 lõike 1 eelmise redaktsiooni punktid 1 ja 2. Alus: \"Riigi Teataja seaduse\" § 17 lõige 32.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_17 (redaktsioon 228268)",
        "@language": "et"
      },
