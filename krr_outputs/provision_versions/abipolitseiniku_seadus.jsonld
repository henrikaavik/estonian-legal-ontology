    {
      "@id": "estleg:ABIPOL_Par_4_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikuks võib nimetada 18-aastaseks saanud vähemalt keskharidusega Eesti kodaniku, kes valdab eesti keelt politseiametnikele ettenähtud keeleoskustasemel ning vastab abipolitseiniku kutsesobivuse nõuetele. (2) Abipolitseinikuks ei või nimetada kohtunikku ja prokuröri. (3) Abipolitseiniku kutsesobivuse nõuded",
      "rdfs:label": {
        "@value": "ABIPOL_Par_4 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_4_v114032014005"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 4",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_4_v114032014005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikuks võib nimetada 18-aastaseks saanud vähemalt keskharidusega Eesti kodaniku, kes valdab eesti keelt politseiametnikele ettenähtud keeleoskustasemel ning vastab abipolitseiniku kutsesobivuse nõuetele. (2) Abipolitseinikuks ei või nimetada kohtunikku ja prokuröri. (3) Abipolitseiniku kutsesobivuse nõuded määrusega.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_4 (redaktsioon 114032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014005",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_4_v112032015074"
      },
      "estleg:versionValidTo": {
