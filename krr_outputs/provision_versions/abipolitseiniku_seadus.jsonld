      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Käesoleva seaduse §-s 43 sätestatud väärteo kohtuväline menetleja on Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_44 (redaktsioon 112072014013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072014013",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 44",
