      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ABIPOL_Par_27 (redaktsioon 114032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014005",
      "estleg:sourceAct": "Abipolitseiniku seadus",
