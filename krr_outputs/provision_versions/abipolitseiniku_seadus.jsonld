        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik on kohustatud viivitamata teavitama politsei juhtimiskeskust tulirelva kasutamisest abipolitseiniku ülesande täitmisel.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_36 (redaktsioon 130122011058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011058",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_36_v113032019029"
      },
      "estleg:versionValidTo": {
        "@value": "2019-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122011058",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 36",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_36_v113032019029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik on kohustatud viivitamata teavitama politsei juhtimiskeskust tulirelva või elektrišokirelva kasutamisest abipolitseiniku ülesande täitmisel.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_36 (redaktsioon 113032019029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019029",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 36",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_37_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikule antakse abipolitseiniku tunnistus ja eritunnused. Abipolitseiniku eritunnused on varrukaembleem, rinnamärk ja kiri „ABIPOLITSEINIK”. Tunnistuse ja eritunnuste kirjelduse (2) Abipolitseinik kannab abipolitseiniku ülesande täitmisel rinnamärki ja politsei ohutusvesti kirjaga „ABIPOLITSEINIK”. Politseiasutuse juhi loal võib erandjuhtudel, kui see tuleneb ülesande iseloomust, loobuda rinnamärgi ja ohutusvesti kandmisest abipolitseiniku ülesande täitmisel. Abipolitseinik peab esitama isikule tema nõudmisel abipolitseiniku tunnistuse. (3) Abipolitseinik võib kanda politseiametniku vormiriietust abipolitseiniku eritunnustega. (4) Abipolitseinik peab kandma politseiametniku vormiriietust abipolitseiniku eritunnustega, kui ta: kannab abipolitseiniku ülesande täitmisel tulirelva või täidab politsei ülesandel käesoleva seaduse § 3 lõikes 2 sätestatud ülesannet iseseisvalt. (5) Abipolitseinikul on keelatud abipolitseiniku ülesande täitmise ajal kanda: ametniku, välja arvatud politseiametniku, vormiriietust; turvatöötaja vormiriietust; riietust, millel on kaitseväe või Kaitseliidu eraldusmärgid. (6) Eritunnused ja abipolitseinikule väljastatud vormiriietus tagastatakse abipolitseiniku staatusest vabastamisel. (7) Eritunnuste ja abipolitseinikule väljastatud vormiriietuse andmise ja kandmise korra kehtestab politseipeadirektor.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_37 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ABIPOL_Par_37_v130122011058"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 37",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_37_v130122011058",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinikule antakse abipolitseiniku tunnistus ja eritunnused. Abipolitseiniku eritunnused on varrukaembleem, rinnamärk ja kiri „ABIPOLITSEINIK”. Tunnistuse ja eritunnuste kirjelduse (2) Abipolitseinik kannab abipolitseiniku ülesande täitmisel rinnamärki ja politsei ohutusvesti kirjaga „ABIPOLITSEINIK”. Politsei- ja Piirivalveameti peadirektori või tema volitatud ametniku loal võib erandjuhtudel, kui see tuleneb ülesande iseloomust, loobuda rinnamärgi ja ohutusvesti kandmisest abipolitseiniku ülesande täitmisel. Abipolitseinik peab esitama isikule tema nõudmisel abipolitseiniku tunnistuse. (3) Abipolitseinik võib kanda politseiametniku vormiriietust abipolitseiniku eritunnustega. (4) Abipolitseinik peab kandma politseiametniku vormiriietust abipolitseiniku eritunnustega, kui ta: kannab abipolitseiniku ülesande täitmisel tulirelva või täidab politsei ülesandel käesoleva seaduse § 3 lõikes 2 sätestatud ülesannet iseseisvalt. (5) Abipolitseinikul on keelatud abipolitseiniku ülesande täitmise ajal kanda: ametniku, välja arvatud politseiametniku, vormiriietust; turvatöötaja vormiriietust; riietust, millel on kaitseväe või Kaitseliidu eraldusmärgid. (6) Eritunnused ja abipolitseinikule väljastatud vormiriietus tagastatakse abipolitseiniku staatusest vabastamisel. (7) Eritunnuste ja abipolitseinikule väljastatud vormiriietuse andmise ja kandmise korra kehtestab Politsei- ja Piirivalveameti peadirektor.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_37 (redaktsioon 130122011058)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011058",
