        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveameti peadirektor esitab kaks korda kalendriaastas valdkonna eest vastutavale ministrile ülevaate abipolitseinike tegevusest.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_15 (redaktsioon 114032014005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032014005",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 15",
