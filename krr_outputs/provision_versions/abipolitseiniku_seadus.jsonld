        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik võib abipolitseiniku ülesande täitmisel tulirelva kasutada üksnes hädakaitses, seejuures hädakaitse piire ületamata.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_35 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
