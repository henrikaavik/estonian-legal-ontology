      }
    },
    {
      "@id": "estleg:ABIPOL_Par_40_v113032019029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseiniku transpordi-, side- ja muud Politsei- ja Piirivalveameti ettenähtud ja temale ülesande täitmiseks vajalikud kulud hüvitab Politsei- ja Piirivalveamet. (1¹) Politsei- ja Piirivalveametil on õigus lähetada abipolitseinikku välisriiki ning maksta abipolitseinikule lähetusega seotud sõidu- ja majutuskulude hüvitist ning päevaraha. (2) Politsei- ja Piirivalveametil on õigus hüvitada abipolitseiniku tervisekontrolli kulutusi. (3) Käesoleva paragrahvi lõikes 1 nimetatud kulude hüvitamise piirmäära ja korra kehtestab Politsei- ja Piirivalveameti peadirektor käskkirjaga. (4) Kokkuleppel Politsei- ja Piirivalveametiga võib käesoleva paragrahvi lõikes 1 nimetatud kulud hüvitada kohalik omavalitsus.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_40 (redaktsioon 113032019029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019029",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 40",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_41_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Silmapaistvate teenete eest võib abipolitseinikku ergutada politsei ja piirivalve seaduse 5. peatüki 8. jaos sätestatud korras.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_41 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_42_v120122010001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abipolitseinik vabastatakse abipolitseiniku staatusest politseiasutuse juhi käskkirjaga: abipolitseiniku algatusel; tema mittevastavuse korral käesoleva seaduse §-des 4 ja 5 ning § 8 lõikes 4 sätestatud tingimustele või seoses abipolitseinikule sobimatu käitumisega, sealhulgas kui abipolitseinik rikub avalikus kohas käitumise nõudeid või käitub muul viisil õigusvastaselt.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_42 (redaktsioon 120122010001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122010001",
      "estleg:supersededByVersion": {
