        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveameti peadirektor esitab kaks korda kalendriaastas siseministrile ülevaate abipolitseinike tegevusest.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_15 (redaktsioon 120122010001)",
