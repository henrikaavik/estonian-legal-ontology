      },
      "estleg:versionValidTo": {
        "@value": "2019-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015074",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 35",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_35_v113032019029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik võib abipolitseiniku ülesande täitmisel tulirelva või elektrišokirelva kasutada üksnes hädakaitses, seejuures hädakaitse piire ületamata. (2) Abipolitseinik võib kasutada tulirelva või elektrišokirelva looma suhtes ainult looma ründevõimetuks muutmiseks juhul, kui seda eesmärki ei ole võimalik saavutada muu sunnivahendiga.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_35 (redaktsioon 113032019029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019029",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 35",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_36_v120122010001",
