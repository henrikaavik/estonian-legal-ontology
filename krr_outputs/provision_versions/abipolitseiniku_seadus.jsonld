      },
      "estleg:versionValidTo": {
        "@value": "2015-03-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120122010001",
      "estleg:sourceAct": "Abipolitseiniku seadus",
      "estleg:provisionRef": "ABIPOL § 35",
      "estleg:partOfAct": {
        "@id": "estleg:ABIPOL_Map"
      }
    },
    {
      "@id": "estleg:ABIPOL_Par_35_v112032015074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ABIPOL_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abipolitseinik võib abipolitseiniku ülesande täitmisel tulirelva kasutada üksnes hädakaitses, seejuures hädakaitse piire ületamata. (2) Abipolitseinik võib kasutada tulirelva looma suhtes ainult looma ründevõimetuks muutmiseks juhul, kui seda eesmärki ei ole võimalik saavutada muu sunnivahendiga.",
      "rdfs:label": {
        "@value": "ABIPOL_Par_35 (redaktsioon 112032015074)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015074",
      "estleg:supersededByVersion": {
