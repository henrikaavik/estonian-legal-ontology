    {
      "@id": "estleg:Reg_1041720_Par_20_v1041720",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041720_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1041720_Par_20 (redaktsioon 1041720)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041720",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041720",
      "estleg:sourceAct": "Taarikõnnu looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041720 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041720_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041720_Par_3_v1041720",
