      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041720_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1041720_Par_3 (redaktsioon 1041720)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041720",
