        "@id": "estleg:Reg_1041720_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041720_Par_13_v1041720",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041720_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Kõnnu piiranguvöönd. Kaitsealal on Kõnnu piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1041720_Par_13 (redaktsioon 1041720)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041720",
