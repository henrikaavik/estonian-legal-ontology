      "estleg:provisionRef": "Reg_1041720 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041720_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041720_Par_10_v1041720",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041720_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevööndis on lubatud kuni 20 osalejaga rahvaürituse korraldamine kaitseala valitseja nõusolekul selleks ettevalmistatud kohas. Sihtkaitsevööndis on lubatud kuni 20 osalejaga rahvaürituse korraldamine kaitseala valitseja nõusolekul selleks ettevalmistatud kohas. 2 (2) Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) rohkem kui 20 osalejaga rahvaürituse korraldamine; 2 2) olemasolevate maaparandussüsteemide hoiutööd ja loodusliku veerežiimi taastamine; 3 3) koosluse kujundamine vastavalt kaitse-eesmärgile; 4 4) olemasolevate ehitiste hooldustööd; 5 5) tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks; 6 6) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: rohkem kui 20 osalejaga rahvaürituse korraldamine; olemasolevate maaparandussüsteemide hoiutööd ja loodusliku veerežiimi taastamine; koosluse kujundamine vastavalt kaitse-eesmärgile; olemasolevate ehitiste hooldustööd; tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks; kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus.",
      "rdfs:label": {
        "@value": "Reg_1041720_Par_10 (redaktsioon 1041720)",
        "@language": "et"
      },
