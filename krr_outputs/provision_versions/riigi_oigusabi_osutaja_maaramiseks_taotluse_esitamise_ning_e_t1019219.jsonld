      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigi õigusabi osutaja määramiseks taotluse esitamise ning e-toimiku süsteemi kaudu riigi õigusabi tasu ja kulude kindlaksmääramiseks dokumentide esitamise kord (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigi õigusabi osutaja määramiseks taotluse esitamise ning e-toimiku süsteemi kaudu riigi õigusabi tasu ja kulude kindlaksmääramiseks dokumentide esitamise kord"
    },
    {
      "@id": "estleg:Reg_1019219_Par_1_v1019219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019219_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse riigi õigusabi osutaja määramiseks taotluse Eesti Advokatuurile (edaspidi advokatuur) esitamise kord, advokaadi poolt riigi õigusabi tasu suuruse ja riigi õigusabi kulude hüvitamise kindlaksmääramise taotluse esitamise kord ning kohtu, uurimisasutuse või prokuratuuri poolt riigi õigusabi osutamise eest tasu ja kulude kindlaksmääramise otsuse või määruse esitamise kord. Käesoleva määrusega kehtestatakse riigi õigusabi osutaja määramiseks taotluse Eesti Advokatuurile (edaspidi advokatuur) esitamise kord, advokaadi poolt riigi õigusabi tasu suuruse ja riigi õigusabi kulude hüvitamise kindlaksmääramise taotluse esitamise kord ning kohtu, uurimisasutuse või prokuratuuri poolt riigi õigusabi osutamise eest tasu ja kulude kindlaksmääramise otsuse või määruse esitamise kord.",
      "rdfs:label": {
        "@value": "Reg_1019219_Par_1 (redaktsioon 1019219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019219",
