      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2014. aastal. Määrus jõustub 1. jaanuaril 2014. aastal.",
      "rdfs:label": {
        "@value": "Reg_1019219_Par_10 (redaktsioon 1019219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019219",
