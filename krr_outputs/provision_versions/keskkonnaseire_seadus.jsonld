      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnisasja sundvõõrandamise seaduse § 3 lõiget 1 täiendatakse punktiga 154 järgmises sõnastuses:„154) keskkonnaseirejaama rajamiseks;”.",
      "rdfs:label": {
        "@value": "KESKKO_2_Par_25 (redaktsioon 118052016001)",
