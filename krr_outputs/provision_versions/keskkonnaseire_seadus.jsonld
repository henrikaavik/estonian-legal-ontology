      }
    },
    {
      "@id": "estleg:KESKKO_2_Par_3_v123032015283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_2_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku keskkonnaseiret korraldab Keskkonnaministeerium. (2) Riiklikku keskkonnaseiret teostatakse valdkonna eest vastutava ministri kinnitatud programmi alusel. Riikliku keskkonnaseire programm peab sisaldama: allprogrammide nimetusi; kavandatavate tööde kirjeldust; andmeid allprogrammide vastutavate täitjate kohta; programmi täitmiseks ettenähtud vahendeid. (3) Riiklikku keskkonnaseire programmi finantseeritakse: riigieelarvest; rahvusvaheliste programmide eelarvetest; [kehtetu] (4) Riikliku keskkonnaseire koostisosa võib olla ka rahvusvaheliste programmide alusel tehtav keskkonnaseire. Neid töid finantseeritakse käesoleva paragrahvi lõike 3 punkti 2 alusel.",
      "rdfs:label": {
        "@value": "KESKKO_2_Par_3 (redaktsioon 123032015283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015283",
      "estleg:supersededByVersion": {
        "@id": "estleg:KESKKO_2_Par_3_v118052016001"
      },
      "estleg:versionValidTo": {
        "@value": "2016-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015283",
      "estleg:sourceAct": "Keskkonnaseire seadus",
      "estleg:provisionRef": "KESKKO_2 § 3",
      "estleg:partOfAct": {
