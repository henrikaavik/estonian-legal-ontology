      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet käesoleva seaduse § 10 lõikes 2 sätestatud keelu ja §-s 14 sätestatud nõuete järgimise ning § 10 lõike 3 alusel kehtestatud korra täitmise üle teostab Keskkonnaamet.",
      "rdfs:label": {
        "@value": "KESKKO_2_Par_16 (redaktsioon 110072020048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110072020048",
      "estleg:sourceAct": "Keskkonnaseire seadus",
      "estleg:provisionRef": "KESKKO_2 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:KESKKO_2_Map"
      }
    },
    {
      "@id": "estleg:KESKKO_2_Par_17_v118052016001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KESKKO_2_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioon võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30–32 ja 49–51 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "KESKKO_2_Par_17 (redaktsioon 118052016001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118052016001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KESKKO_2_Par_17_v110072020048"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118052016001",
      "estleg:sourceAct": "Keskkonnaseire seadus",
      "estleg:provisionRef": "KESKKO_2 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:KESKKO_2_Map"
      }
    },
    {
      "@id": "estleg:KESKKO_2_Par_17_v110072020048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
