    {
      "@id": "estleg:Reg_1056297_Par_2_v1056297",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056297_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põlvamaal võetakse kaitse alla järgmised üksikobjektid koos neid ümbritseva piiranguvööndiga, mille ulatus on märgitud käesoleva määruse asjaomastes punktides ja mille piir on esitatud kaardil määruse lisas1: 1 1) Maaritsa magnoolia Valgjärve vallas – 15 meetrit; 2 2) Rõsna kadakas Mikitamäe vallas; RT I 2020-01-03 3 103012020003 2020-01-13 3 3) Tsõõrikmäe meteoriidikraater Räpina vallas – 50 meetrit; 4 4) Himmaste allikad Põlva vallas – 1,49 ha. Põlvamaal võetakse kaitse alla järgmised üksikobjektid koos neid ümbritseva piiranguvööndiga, mille ulatus on märgitud käesoleva määruse asjaomastes punktides ja mille piir on esitatud kaardil määruse lisas1: Maaritsa magnoolia Valgjärve vallas – 15 meetrit; Rõsna kadakas Mikitamäe vallas; Tsõõrikmäe meteoriidikraater Räpina vallas – 50 meetrit; Himmaste allikad Põlva vallas – 1,49 ha.",
      "rdfs:label": {
        "@value": "Reg_1056297_Par_2 (redaktsioon 1056297)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056297",
