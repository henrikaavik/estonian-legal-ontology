      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitse alla võtmise eesmärk on tagada Põlva maakonnas asuvate esindusliku meteoriidikraatri, hüdrogeoloogilise tähtsusega langeallikate rühma ja esteetilise väärtusega põlispuude säilimine. Kaitse alla võtmise eesmärk on tagada Põlva maakonnas asuvate esindusliku meteoriidikraatri, hüdrogeoloogilise tähtsusega langeallikate rühma ja esteetilise väärtusega põlispuude säilimine.",
      "rdfs:label": {
        "@value": "Reg_1056297_Par_1 (redaktsioon 1056297)",
        "@language": "et"
      },
