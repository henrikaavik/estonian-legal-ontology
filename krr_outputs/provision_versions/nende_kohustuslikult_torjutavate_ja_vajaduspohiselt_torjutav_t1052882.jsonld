      "estleg:provisionRef": "Reg_1052882 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052882_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052882_Par_2_v1052882",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052882_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loomatauditõrjega tekkinud kahju hüvitatakse järgmiste kohustuslikult tõrjutavate ja vajaduspõhiselt tõrjutavate loomataudide puhul: 1 1) veiste brutselloos; 2 2) veiste tuberkuloos; 3 3) veiste enzootiline leukoos; 4 4) lammaste-kitsede brutselloos (B. melitensis); 5 5) marutaud. Loomatauditõrjega tekkinud kahju hüvitatakse järgmiste kohustuslikult tõrjutavate ja vajaduspõhiselt tõrjutavate loomataudide puhul: veiste brutselloos; veiste tuberkuloos; veiste enzootiline leukoos; lammaste-kitsede brutselloos (B. melitensis); marutaud.",
      "rdfs:label": {
        "@value": "Reg_1052882_Par_2 (redaktsioon 1052882)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052882",
