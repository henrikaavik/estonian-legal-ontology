      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse nende kohustuslikult tõrjutavate ja vajaduspõhiselt tõrjutavate loomataudide nimekiri, mille puhul loomatauditõrjega tekkinud kahju hüvitatakse. Määrusega kehtestatakse nende kohustuslikult tõrjutavate ja vajaduspõhiselt tõrjutavate loomataudide nimekiri, mille puhul loomatauditõrjega tekkinud kahju hüvitatakse.",
      "rdfs:label": {
        "@value": "Reg_1052882_Par_1 (redaktsioon 1052882)",
        "@language": "et"
      },
