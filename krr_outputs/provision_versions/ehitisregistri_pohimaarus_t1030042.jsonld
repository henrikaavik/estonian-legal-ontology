    {
      "@id": "estleg:Reg_1030042_Par_12_13_v1030042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030042_Par_12_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võrguvaldaja huvipiirkonna andmed on: 1 1) huvipiirkonna ruumikuju või selle koordinaadid; 2 2) võrguvaldaja ärinimi, registrikood ja tegevusala. RT I 2019-06-28 9 128062019009 2019-07-01 Võrguvaldaja huvipiirkonna andmed on: huvipiirkonna ruumikuju või selle koordinaadid; võrguvaldaja ärinimi, registrikood ja tegevusala.",
      "rdfs:label": {
        "@value": "Reg_1030042_Par_12_13 (redaktsioon 1030042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030042",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030042",
      "estleg:sourceAct": "Ehitisregistri põhimäärus",
      "estleg:provisionRef": "Reg_1030042 § 12_13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030042_Map"
      }
    },
    {
      "@id": "estleg:Reg_1030042_Par_13_v1030042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030042_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vallasasjast ehitisega seonduvate pantide, keeldude ja arestide andmed on: 1 1) vallasasjast ehitise pantimise ja pandiõiguse lõppemise kuupäev, seotud osa ja selgitus; 2 2) pandipidaja ees- ja perekonnanimi, isikukood või sünniaeg või juriidilise isiku ärinimi ja registrikood; 3 3) pantija ees- ja perekonnanimi, isikukood või sünniaeg, juriidilise isiku ärinimi ja registrikood; 4 4) selle notaribüroo nimetus, kelle juures vallasasjast ehitis panditi või ehitise pantimine lõpetati; 5 5) vallasasjast ehitise aresti või keelu liik, vara arestimise või käsutamise keelamise või käsutamise keelu lõppemise või vara arestist vabastamise kuupäev, seotud osa ja selgitus; 6 6) vallasasjast ehitise arestimise või käsutamise keelu seadja ees- ja perekonnanimi, isikukood või sünniaeg, juriidilise isiku või institutsiooni nimi ja registrikood; 7 7) vallasasjast ehitise arestist vabastamise või käsutamise keelu lõpetaja ees- ja perekonnanimi, isikukood või sünniaeg, juriidilise isiku või institutsiooni nimi ja registrikood; 8 8) kinnistamisavalduse esitamise kuupäev esmakinnistamisel. Vallasasjast ehitisega seonduvate pantide, keeldude ja arestide andmed on: vallasasjast ehitise pantimise ja pandiõiguse lõppemise kuupäev, seotud osa ja selgitus; pandipidaja ees- ja perekonnanimi, isikukood või sünniaeg või juriidilise isiku ärinimi ja registrikood; pantija ees- ja perekonnanimi, isikukood või sünniaeg, juriidilise isiku ärinimi ja registrikood; selle notaribüroo nimetus, kelle juures vallasasjast ehitis panditi või ehitise pantimine lõpetati; vallasasjast ehitise aresti või keelu liik, vara arestimise või käsutamise keelamise või käsutamise keelu lõppemise või vara arestist vabastamise kuupäev, seotud osa ja selgitus; vallasasjast ehitise arestimise või käsutamise keelu seadja ees- ja perekonnanimi, isikukood või sünniaeg, juriidilise isiku või institutsiooni nimi ja registrikood; vallasasjast ehitise arestist vabastamise või käsutamise keelu lõpetaja ees- ja perekonnanimi, isikukood või sünniaeg, juriidilise isiku või institutsiooni nimi ja registrikood; kinnistamisavalduse esitamise kuupäev esmakinnistamisel.",
      "rdfs:label": {
        "@value": "Reg_1030042_Par_13 (redaktsioon 1030042)",
        "@language": "et"
