      "estleg:versionValidFrom": {
        "@value": "2023-10-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) 2024. aastal võetakse ajateenistusse kuni 3900 isikut. RT I 2023-10-26 2 126102023002 2023-10-29 2024. aastal võetakse ajateenistusse kuni 3900 isikut. 2 (2) Kehtetu - RT I 2023-10-26 2 126102023002 2023-10-29 Kehtetu - 3 (3) 2024. aastal ajateenistusse võetavate isikute jaotus Kaitseväe struktuuriüksuste vahel on esitatud käesoleva määruse lisas 1 „Ajateenistusse asunute arvuline jagunemine Kaitseväe struktuuriüksuste vahel 2024. aastal”. 2024. aastal ajateenistusse võetavate isikute jaotus Kaitseväe struktuuriüksuste vahel on esitatud käesoleva määruse lisas 1 „Ajateenistusse asunute arvuline jagunemine Kaitseväe struktuuriüksuste vahel 2024. aastal”.",
      "rdfs:label": {
        "@value": "Reg_1054937_Par_2 (redaktsioon 1054937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054937",
