      "estleg:sourceAct": "Ajateenistusse asumise tähtajad, ajateenistusse võetavate isikute arvuline jagunemine ajateenijate väljaõppega tegelevate struktuuriüksuste vahel ning ajateenistuse kestus 2024. aastal ning 2026. aastal",
      "estleg:provisionRef": "Reg_1054937 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054937_Map_2026"
      }
    },
    {
