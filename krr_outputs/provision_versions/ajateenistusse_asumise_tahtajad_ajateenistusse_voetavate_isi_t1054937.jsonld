      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ajateenistusse asumise tähtajad, ajateenistusse võetavate isikute arvuline jagunemine ajateenijate väljaõppega tegelevate struktuuriüksuste vahel ning ajateenistuse kestus 2024. aastal ning 2026. aastal (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ajateenistusse asumise tähtajad, ajateenistusse võetavate isikute arvuline jagunemine ajateenijate väljaõppega tegelevate struktuuriüksuste vahel ning ajateenistuse kestus 2024. aastal ning 2026. aastal"
    },
