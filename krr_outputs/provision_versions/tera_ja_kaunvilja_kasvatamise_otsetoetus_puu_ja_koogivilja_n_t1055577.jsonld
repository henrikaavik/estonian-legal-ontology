  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tera_ja_kaunvilja_kasvatamise_otsetoetus_puu_ja_koogivilja_n_t1055577_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tera- ja kaunvilja kasvatamise otsetoetus, puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetus ning seemnekartuli kasvatamise otsetoetus (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tera- ja kaunvilja kasvatamise otsetoetus, puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetus ning seemnekartuli kasvatamise otsetoetus"
    },
    {
      "@id": "estleg:Reg_1055577_Par_1_v1055577",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055577_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse järgmiste tootmiskohustusega seotud otsetoetuste saamise täpsemad nõuded ning toetuse taotlemise ja taotluse menetlemise kord: 1 1) tera- ja kaunvilja kasvatamise otsetoetus; 2 2) puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetus; 3 3) seemnekartuli kasvatamise otsetoetus. Määrusega kehtestatakse järgmiste tootmiskohustusega seotud otsetoetuste saamise täpsemad nõuded ning toetuse taotlemise ja taotluse menetlemise kord: tera- ja kaunvilja kasvatamise otsetoetus; puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetus; seemnekartuli kasvatamise otsetoetus.",
      "rdfs:label": {
        "@value": "Reg_1055577_Par_1 (redaktsioon 1055577)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055577",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055577",
      "estleg:sourceAct": "Tera- ja kaunvilja kasvatamise otsetoetus, puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetus ning seemnekartuli kasvatamise otsetoetus",
      "estleg:provisionRef": "Reg_1055577 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055577_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055577_Par_10_v1055577",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055577_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA teeb puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetuse ning tera- ja kaunvilja kasvatamise otsetoetuse taotluse rahuldamise või rahuldamata jätmise otsuse taotluse esitamise kalendriaasta 10. detsembriks. PRIA teeb puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetuse ning tera- ja kaunvilja kasvatamise otsetoetuse taotluse rahuldamise või rahuldamata jätmise otsuse taotluse esitamise kalendriaasta 10. detsembriks. 2 (2) PRIA teeb seemnekartuli kasvatamise otsetoetuse taotluse rahuldamise või rahuldamata jätmise otsuse taotluse esitamise kalendriaastale järgneva kalendriaasta 10. juuniks. PRIA teeb seemnekartuli kasvatamise otsetoetuse taotluse rahuldamise või rahuldamata jätmise otsuse taotluse esitamise kalendriaastale järgneva kalendriaasta 10. juuniks. 3 (3) PRIA teeb taotluse rahuldamata jätmise otsuse Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artiklis 62 ning Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 16 lõikes 8 sätestatud alustel. RT I 2025-08-02 1 102082025001 2025-08-05 PRIA teeb taotluse rahuldamata jätmise otsuse Euroopa Parlamendi ja nõukogu määruse (EL) 2021/2116 artiklis 62 ning Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 16 lõikes 8 sätestatud alustel.",
      "rdfs:label": {
        "@value": "Reg_1055577_Par_10 (redaktsioon 1055577)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055577",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055577",
      "estleg:sourceAct": "Tera- ja kaunvilja kasvatamise otsetoetus, puu- ja köögivilja ning marjakultuuride kasvatamise otsetoetus ning seemnekartuli kasvatamise otsetoetus",
      "estleg:provisionRef": "Reg_1055577 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055577_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055577_Par_11_v1055577",
      "@type": [
        "owl:NamedIndividual",
