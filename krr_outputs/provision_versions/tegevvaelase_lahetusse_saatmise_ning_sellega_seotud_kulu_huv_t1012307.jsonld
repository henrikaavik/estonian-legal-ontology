      "estleg:provisionRef": "Reg_1012307 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012307_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_14_v1012307",
