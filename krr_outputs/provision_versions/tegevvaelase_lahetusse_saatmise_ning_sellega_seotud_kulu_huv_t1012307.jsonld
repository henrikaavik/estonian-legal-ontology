    {
      "@id": "estleg:Reg_1012307_Par_7_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigisisese lähetusega seotud muu kulu hüvitatakse lähetajaasutuse juhi või tema volitatud isiku otsuse alusel. Riigisisese lähetusega seotud muu kulu hüvitatakse lähetajaasutuse juhi või tema volitatud isiku otsuse alusel.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_7 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012307",
      "estleg:sourceAct": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1012307 § 7",
