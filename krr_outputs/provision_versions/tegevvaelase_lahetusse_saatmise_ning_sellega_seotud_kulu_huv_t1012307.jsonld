  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tegevvaelase_lahetusse_saatmise_ning_sellega_seotud_kulu_huv_t1012307_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord (22 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1012307_Par_1_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrust kohaldatakse tegevväelasele, kes lähetatakse: 1 1) riigisiseselt ajutise ülesande täitmiseks kuni 30 päevaks; 2 2) riigisiseselt teenistusülesande täitmiseks teise Kaitseväe või Kaitseliidu struktuuriüksusesse; 3 3) riigisiseselt koolitusele; 4 4) välisriiki lühiajaliselt kuni kuueks kuuks; 5 5) välisriiki koolitusele kuni kuueks kuuks; RT I 2015-03-13 5 113032015005 2015-03-16 6 6) välisriiki osalema rahvusvahelises sõjalises operatsioonis. Määrust kohaldatakse tegevväelasele, kes lähetatakse: riigisiseselt ajutise ülesande täitmiseks kuni 30 päevaks; riigisiseselt teenistusülesande täitmiseks teise Kaitseväe või Kaitseliidu struktuuriüksusesse; riigisiseselt koolitusele; välisriiki lühiajaliselt kuni kuueks kuuks; välisriiki koolitusele kuni kuueks kuuks; välisriiki osalema rahvusvahelises sõjalises operatsioonis. 2 (2) Määrust ei kohaldata: 1 1) tegevväelasele, kes on suunatud sõjaväelise auastmeta ameti- või töökohale; 2 2) tegevväelase lähetamisel riiklike ülesannete täitmiseks välisriiki pikemalt kui kuueks kuuks; 3 3) tegevväelasele, kes on välisteenistuses. Määrust ei kohaldata: tegevväelasele, kes on suunatud sõjaväelise auastmeta ameti- või töökohale; tegevväelase lähetamisel riiklike ülesannete täitmiseks välisriiki pikemalt kui kuueks kuuks; tegevväelasele, kes on välisteenistuses. 3 (3) Lähetajaasutuseks käesoleva määruse tähenduses on Kaitsevägi ja Kaitseliit. Rahvusvahelises sõjalises operatsioonis osalemisel on lähetajaasutuseks Kaitsevägi. Lähetajaasutuseks käesoleva määruse tähenduses on Kaitsevägi ja Kaitseliit. Rahvusvahelises sõjalises operatsioonis osalemisel on lähetajaasutuseks Kaitsevägi.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_1 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012307",
      "estleg:sourceAct": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1012307 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012307_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_10_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Välislähetusse saadetud tegevväelasele hüvitatakse reisikindlustuse ja viisa vormistamise kulu kindlustuspoliisi koopia või viisa koopia või muu selle kulu tekkimist tõendava dokumendi alusel. Välislähetusse saadetud tegevväelasele hüvitatakse reisikindlustuse ja viisa vormistamise kulu kindlustuspoliisi koopia või viisa koopia või muu selle kulu tekkimist tõendava dokumendi alusel. 2 (2) Muu välislähetusega seotud kulu hüvitatakse lähetajaasutuse juhi või tema volitatud isiku otsuse alusel. RT I 2023-03-29 10 129032023010 2023-04-01 Muu välislähetusega seotud kulu hüvitatakse lähetajaasutuse juhi või tema volitatud isiku otsuse alusel.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_10 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012307",
      "estleg:sourceAct": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1012307 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012307_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_11_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevväelasele makstakse välislähetusse saatmisel päevaraha, mille alammäär on 40 eurot päevas ja ülemmäär tulumaksuseaduse § 13 lõike 3 punktis 1 sätestatud välislähetuse päevaraha maksuvaba piirmäär. RT I 2025-07-02 14 102072025014 2025-07-05 Tegevväelasele makstakse välislähetusse saatmisel päevaraha, mille alammäär on 40 eurot päevas ja ülemmäär tulumaksuseaduse § 13 lõike 3 punktis 1 sätestatud välislähetuse päevaraha maksuvaba piirmäär.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_11 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012307",
      "estleg:sourceAct": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1012307 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012307_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_12_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välislähetusse väljasõidu päev loetakse välislähetuse päevaks ja selle eest makstakse tegevväelasele päevaraha, kui välisriiki suunduv sõiduk väljub vähemalt kolm tundi enne keskööd. Välislähetusest saabumise päev loetakse välislähetuse päevaks ja selle eest makstakse päevaraha siis, kui saabumispäeva algusest (kell 00.00) on sõiduki saabumise ajaks möödunud vähemalt kolm tundi. Välislähetusse väljasõidu päev loetakse välislähetuse päevaks ja selle eest makstakse tegevväelasele päevaraha, kui välisriiki suunduv sõiduk väljub vähemalt kolm tundi enne keskööd. Välislähetusest saabumise päev loetakse välislähetuse päevaks ja selle eest makstakse päevaraha siis, kui saabumispäeva algusest (kell 00.00) on sõiduki saabumise ajaks möödunud vähemalt kolm tundi.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_12 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012307",
      "estleg:sourceAct": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1012307 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012307_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_13_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Päevaraha määra võib vähendada kuni 70 protsenti päeva eest, millal tegevväelasele tagatakse tasuta toitlustamine. RT I 2023-03-29 10 129032023010 2023-04-01 Päevaraha määra võib vähendada kuni 70 protsenti päeva eest, millal tegevväelasele tagatakse tasuta toitlustamine. 2 (2) Tegevväelane on kohustatud juhul, kui talle maksab päevaraha muu isik või asutus või organisatsioon, esitama teenistust korraldavale ülemale muu isiku või asutuse või organisatsiooni kinnituse päevaraha maksmise kohta või ise kinnitama selle saamist. Lähetamist taotlenud asutus on kohustatud maksma päevarahana §-s 11 sätestatud päevaraha määra ja muu isiku või asutuse või organisatsiooni makstava summa vahe, kui muu isiku või asutuse või organisatsiooni makstav päevaraha on väiksem käesolevas määruses sätestatud päevarahast. Tegevväelane on kohustatud juhul, kui talle maksab päevaraha muu isik või asutus või organisatsioon, esitama teenistust korraldavale ülemale muu isiku või asutuse või organisatsiooni kinnituse päevaraha maksmise kohta või ise kinnitama selle saamist. Lähetamist taotlenud asutus on kohustatud maksma päevarahana §-s 11 sätestatud päevaraha määra ja muu isiku või asutuse või organisatsiooni makstava summa vahe, kui muu isiku või asutuse või organisatsiooni makstav päevaraha on väiksem käesolevas määruses sätestatud päevarahast.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_13 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
