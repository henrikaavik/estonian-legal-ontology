      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_2_v1012307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012307_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tegevväelase riigisisese lähetamise otsustab lähetajaasutuse, mille koosseisu kuulub tegevväelase sõjaväelise auastmega rahuaja ametikoht (edaspidi ametikoht), juht või tema volitatud isik. Tegevväelase riigisisese lähetamise otsustab lähetajaasutuse, mille koosseisu kuulub tegevväelase sõjaväelise auastmega rahuaja ametikoht (edaspidi ametikoht), juht või tema volitatud isik. 2 (2) Tegevväelase välisriiki lähetamise (edaspidi välislähetus) otsustab Kaitseväe juhataja või tema volitatud isik või seaduses sätestatud juhul Kaitseliidu ülem. Välisriiki lähetamise korral on lähetajaasutuseks asutus, mille koosseisu kuulub tegevväelase ametikoht. RT I 2023-03-29 10 129032023010 2023-04-01 Tegevväelase välisriiki lähetamise (edaspidi välislähetus) otsustab Kaitseväe juhataja või tema volitatud isik või seaduses sätestatud juhul Kaitseliidu ülem. Välisriiki lähetamise korral on lähetajaasutuseks asutus, mille koosseisu kuulub tegevväelase ametikoht. 3 (3) Kaitseväe juhataja lähetamise otsustab kaitseminister. Kaitseväe juhataja lähetamisel on lähetajaasutuseks Kaitsevägi. Kaitseväe juhataja lähetamise otsustab kaitseminister. Kaitseväe juhataja lähetamisel on lähetajaasutuseks Kaitsevägi.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_2 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012307",
      "estleg:sourceAct": "Tegevväelase lähetusse saatmise ning sellega seotud kulu hüvitamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1012307 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012307_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012307_Par_21_v1012307",
      "@type": [
