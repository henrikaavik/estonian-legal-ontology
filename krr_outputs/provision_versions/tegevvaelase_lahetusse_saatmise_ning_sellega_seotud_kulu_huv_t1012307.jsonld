      "estleg:versionText": "Määrus jõustub 1. aprillil 2013. a. Määrus jõustub 1. aprillil 2013. a.",
      "rdfs:label": {
        "@value": "Reg_1012307_Par_28 (redaktsioon 1012307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012307",
