      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riikliku järelevalve teostamise ajal kannab Põllumajandusameti ametnik ametiriietust.",
      "rdfs:label": {
        "@value": "TPSKS_Par_116 (redaktsioon 129062014075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014075",
