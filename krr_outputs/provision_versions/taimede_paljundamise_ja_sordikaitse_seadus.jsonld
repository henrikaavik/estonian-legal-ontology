      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sordinimi peab vastama nõuetele, mis on kehtestatud komisjoni määrusega (EÜ) nr 637/2009, millega kehtestatakse rakenduseeskirjad seoses põllumajandustaimesortide ja -köögiviljasortide nimede sobivusega (ELT L 191, 23.07.2009, lk 10–14).",
      "rdfs:label": {
        "@value": "TPSKS_Par_15 (redaktsioon 13331807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331807",
