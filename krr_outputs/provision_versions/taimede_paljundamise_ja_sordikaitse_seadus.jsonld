      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13331807",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 7_1",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_7_1_v108122020004",
      "@type": [
        "owl:NamedIndividual",
