    {
      "@id": "estleg:TPSKS_Par_87_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemneproovi võtmise tegevusloale lisatakse kõrvaltingimusena seemneproovi võtja nimi ja õigus osutada proovivõtmise teenust, kui ettevõtja on seda tegevusloa taotluses taotlenud.",
      "rdfs:label": {
        "@value": "TPSKS_Par_87 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 87",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_88_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemneproovi võtja õiguste taotleja: on läbinud seemneproovi võtja koolituse seemneproovide võtmiseks Rahvusvahelise Seemnekontrolli Assotsiatsiooni ( International Seed Testing Association , edaspidi ISTA ) meetodite kohaselt akrediteeritud laboratooriumi juures; on võimeline tegutsema erapooletult.",
      "rdfs:label": {
        "@value": "TPSKS_Par_88 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_88_v13332763"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 88",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_88_v13332763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemneproovi võtja õiguste taotleja: on läbinud seemneproovi võtja koolituse seemneproovide võtmiseks Rahvusvahelise Seemnekontrolli Assotsiatsiooni (International Seed Testing Association, edaspidi ISTA) meetodite kohaselt akrediteeritud laboratooriumi juures; on võimeline tegutsema erapooletult.",
      "rdfs:label": {
        "@value": "TPSKS_Par_88 (redaktsioon 13332763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13332763",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_88_v119032019112"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13332763",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 88",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_88_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja läbib koolituse seemneproovide võtmiseks Rahvusvahelise Seemnekontrolli Assotsiatsiooni (International Seed Testing Association, edaspidi ISTA) akrediteeritud laboratooriumi juures. (2) Seemneproovi võtja koolitus koosneb aluskoolitusest ja täienduskoolitusest. (3) Seemneproovi võtja aluskoolitus lõpeb eksamiga. (4) Isikul, kes ei sooritanud käesoleva paragrahvi lõikes 3 nimetatud eksamit, võimaldatakse teha korduseksam aasta jooksul eksami mittesooritamise ajast arvates. Isik, kes ei sooritanud korduseksamit, läbib seemneproovi võtja aluskoolituse uuesti. (5) Seemneproovi võtja aluskoolituse läbimise kohta antakse isikule tunnistus, mis kehtib tähtajatult. (6) Isik, kes on saanud käesoleva paragrahvi lõikes 5 nimetatud seemneproovi võtja aluskoolituse läbimise kohta tunnistuse, läbib igal aastal seemneproovi võtmise täienduskoolituse. (7) Seemneproovi võtja aluskoolituse läbimise kohta antud tunnistus kehtib üks aasta tunnistuse andmise aastast arvates juhul, kui isik: ei ole osalenud ühe aasta jooksul tunnistuse andmise aastast arvates seemneproovi võtja täienduskoolitusel või on võtnud kalendriaasta jooksul vähem kui kümme seemneproovi.",
      "rdfs:label": {
        "@value": "TPSKS_Par_88 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 88",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_89_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja volituse saamiseks esitab taotleja Taimetoodangu Inspektsioonile: avalduse volituse saamiseks; eluloolised andmed ja töökäigu kirjelduse; seemneproovi võtja koolituse läbimist tõendava dokumendi koopia. (2) Taimetoodangu Inspektsioon vaatab käesoleva paragrahvi lõikes 1 nimetatud dokumendid läbi ja hindab taotleja vastavust seemneproovi võtjale esitatud nõuetele. Taimetoodangu Inspektsioonil on õigus kontrollida volituse taotleja esitatud dokumentide õigsust ning vajaduse korral nõuda lisaandmeid ja -dokumente.",
      "rdfs:label": {
        "@value": "TPSKS_Par_89 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_89_v13225921"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 89",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_89_v13225921",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja volituse saamiseks esitab taotleja Põllumajandusametile: avalduse volituse saamiseks; eluloolised andmed ja töökäigu kirjelduse; seemneproovi võtja koolituse läbimist tõendava dokumendi koopia. (2) Põllumajandusamet vaatab käesoleva paragrahvi lõikes 1 nimetatud dokumendid läbi ja hindab taotleja vastavust seemneproovi võtjale esitatud nõuetele. Põllumajandusametil on õigus kontrollida volituse taotleja esitatud dokumentide õigsust ning vajaduse korral nõuda lisaandmeid ja -dokumente.",
      "rdfs:label": {
        "@value": "TPSKS_Par_89 (redaktsioon 13225921)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13225921",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_89_v119032019112"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13225921",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 89",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_89_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja: võtab proove rahvusvaheliselt kehtestatud metoodika kohaselt; täidab oma ülesandeid erapooletult ja nõuetekohaselt; koostab seemneproovi võtmise protokolli; sulgeb sertifitseeritava seemnepartii müügipakendi või konteineri turvakleebisega või plommiga; märgistab sertifitseeritud seemnepartii müügipakendi või konteineri Põllumajandusameti väljastatud või tootjal endal trükkida lubatud etiketiga; tagab tellimislehe, seemneproovi koti etikettide ja turvakleebiste õiguspärase, nõuetekohase ning täpse koostamise ja vormistamise. (2) Seemneproovi võtja võetud seemneproove analüüsitakse seemne kvaliteedi määramiseks eraõigusliku isiku või Eesti või Euroopa Majanduspiirkonna lepinguriigi riikliku akrediteerimisasutuse akrediteeritud seemnekontrolli laboratooriumis.",
      "rdfs:label": {
        "@value": "TPSKS_Par_89 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_89_v108122020004"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 89",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_89_v108122020004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja: võtab proove rahvusvaheliselt kehtestatud metoodika kohaselt; täidab oma ülesandeid erapooletult ja nõuetekohaselt; koostab seemneproovi võtmise protokolli; sulgeb sertifitseeritava seemnepartii müügipakendi või konteineri turvakleebisega või plommiga; märgistab sertifitseeritud seemnepartii müügipakendi või konteineri Põllumajandus- ja Toiduameti väljastatud või tootjal endal trükkida lubatud etiketiga; tagab tellimislehe, seemneproovi koti etikettide ja turvakleebiste õiguspärase, nõuetekohase ning täpse koostamise ja vormistamise. (2) Seemneproovi võtja võetud seemneproove analüüsitakse seemne kvaliteedi määramiseks eraõigusliku isiku või Eesti või Euroopa Majanduspiirkonna lepinguriigi riikliku akrediteerimisasutuse akrediteeritud seemnekontrolli laboratooriumis.",
      "rdfs:label": {
        "@value": "TPSKS_Par_89 (redaktsioon 108122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122020004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108122020004",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 89",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_9_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sordi aretaja on füüsiline isik või isikute grupp, kes erinevaid aretusmeetodeid kasutades on sordi aretanud või kindlaks teinud. (2) Sordi omanik on sordi aretaja või isik, kes õiguslikul alusel on omandanud sordi omaniku õigused. (3) Kui aretaja on sordi aretanud töö- või teenistusülesannet või lepingukohustust täites, loetakse sordi omanikuks aretaja tööandja või töö tellija. (4) Kui sordi aretaja või omaniku elu- või asukoht ei ole Eesti Vabariigis või Euroopa Liidu liikmesriigis, peab tal sordi registreerimise, sordi kaitse alla võtmise või muu käesolevas seaduses sätestatud toimingu tegemiseks olema esindaja, kelle elu- või asukoht on Eesti Vabariigis või Euroopa Liidu liikmesriigis. Esindusele kohaldatakse tsiviilõiguse üldpõhimõtteid.",
      "rdfs:label": {
        "@value": "TPSKS_Par_9 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_90_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja volituse annab ja haldusülesande täitmiseks halduslepingu sõlmib Taimetoodangu Inspektsioon. (2) Taimetoodangu Inspektsioon otsustab taotlejale volituse andmise või sellest keeldumise taotluse saamisest arvates 30 tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "TPSKS_Par_90 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_90_v13225921"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 90",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_90_v13225921",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtja volituse annab ja haldusülesande täitmiseks halduslepingu sõlmib Põllumajandusamet. (2) Põllumajandusamet otsustab taotlejale volituse andmise või sellest keeldumise taotluse saamisest arvates 30 tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "TPSKS_Par_90 (redaktsioon 13225921)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13225921",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_90_v119032019112"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13225921",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 90",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_90_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sertifitseeritava seemnepartii kvaliteedi määramiseks sellest võetud seemneproovi analüüsimiseks peab ettevõtjal olema seemneproovi analüüsimise tegevusluba.",
      "rdfs:label": {
        "@value": "TPSKS_Par_90 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 90",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_91_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemneproovi võtja on kohustatud: täitma erapooletult temale volitusega pandud ülesanded; sulgema sertifitseeritava seemnepartii müügipakendi või konteineri Taimetoodangu Inspektsiooni turvakleebisega; tagama tellimislehe, proovikoti etikettide ja turvakleebiste õiguspärase, nõuetekohase ja korrektse vormistamise; hoidma talle proovi võtmisel teatavaks saanud äri- ja ametisaladust; esitama Taimetoodangu Inspektsioonile tema nõudmisel kõik volitusega seotud tegevuse üle järelevalve tegemiseks vajalikud dokumendid.",
      "rdfs:label": {
        "@value": "TPSKS_Par_91 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_91_v13225921"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_91_v13225921",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemneproovi võtja on kohustatud: täitma erapooletult temale volitusega pandud ülesanded; sulgema sertifitseeritava seemnepartii müügipakendi või konteineri Põllumajandusameti turvakleebisega; tagama tellimislehe, proovikoti etikettide ja turvakleebiste õiguspärase, nõuetekohase ja korrektse vormistamise; hoidma talle proovi võtmisel teatavaks saanud äri- ja ametisaladust; esitama Põllumajandusametile tema nõudmisel kõik volitusega seotud tegevuse üle järelevalve tegemiseks vajalikud dokumendid.",
      "rdfs:label": {
        "@value": "TPSKS_Par_91 (redaktsioon 13225921)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13225921",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_91_v119032019112"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13225921",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_91_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi analüüsimise tegevusloa taotluse lahendab tegevusloa andmisega või sellest keeldumisega Põllumajandusamet. (2) Seemneproovi analüüsimise tegevusloa taotluses esitatakse lisaks majandustegevuse seadustiku üldosa seaduse § 19 lõikes 2 sätestatud andmetele järgmised andmed ja dokumendid: seemneanalüütiku ja juhtiva seemneanalüütiku nimi ja kontaktandmed; seemnekontrolli laboratooriumi akrediteerimist tõendava dokumendi ärakiri; andmed kasutatavate analüüsimeetodite kohta; teave selle kohta, kas soovitakse osutada sertifitseeritava seemnepartii seemne kvaliteedi määramise teenust. (3) Käesoleva paragrahvi lõikes 2 nimetatud andmed kantakse taimekaitseseaduse § 30 lõike 1 alusel asutatud taimetervise registrisse. (4) Seemneproovi analüüsimise tegevusloa taotluse lahendamise eest ei tasu isik riigilõivu.",
      "rdfs:label": {
        "@value": "TPSKS_Par_91 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_91_v108122020004"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_91_v108122020004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi analüüsimise tegevusloa taotluse lahendab tegevusloa andmisega või sellest keeldumisega Põllumajandus- ja Toiduamet. (2) Seemneproovi analüüsimise tegevusloa taotluses esitatakse lisaks majandustegevuse seadustiku üldosa seaduse § 19 lõikes 2 sätestatud andmetele järgmised andmed ja dokumendid: seemneanalüütiku ja juhtiva seemneanalüütiku nimi ja kontaktandmed; seemnekontrolli laboratooriumi akrediteerimist tõendava dokumendi ärakiri; andmed kasutatavate analüüsimeetodite kohta; teave selle kohta, kas soovitakse osutada sertifitseeritava seemnepartii seemne kvaliteedi määramise teenust. (3) Käesoleva paragrahvi lõikes 2 nimetatud andmed kantakse taimekaitseseaduse § 30 lõike 1 alusel asutatud taimetervise registrisse. (4) Seemneproovi analüüsimise tegevusloa taotluse lahendamise eest ei tasu isik riigilõivu.",
      "rdfs:label": {
        "@value": "TPSKS_Par_91 (redaktsioon 108122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122020004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108122020004",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_92_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitus lõpeb: volitusest loobumise korral; volituse tähtaja möödumisega; volitatu surma korral; volituse tagasivõtmise korral. (2) Seemneproovi võtjal on õigus volitusest loobuda, teatades sellest Taimetoodangu Inspektsioonile posti teel lihtkirjaga vähemalt 30 päeva ette. (3) Kui seemneproovi võtja volitusega seotud tegevus ei ole nõuetekohane, peatab Taimetoodangu Inspektsioon volituse ja annab tähtaja puuduse kõrvaldamiseks. Kui tähtpäevaks puudust ei kõrvaldata, võtab Taimetoodangu Inspektsioon volituse tagasi ja lõpetab ühepoolselt halduslepingu.",
      "rdfs:label": {
        "@value": "TPSKS_Par_92 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_92_v13223610"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 92",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_92_v13223610",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitus lõpeb: volitusest loobumise korral; volituse tähtaja möödumisega; volitatu surma korral; volituse tagasivõtmise korral. (2) Seemneproovi võtjal on õigus volitusest loobuda, teatades sellest Taimetoodangu Inspektsioonile posti teel lihtkirjaga vähemalt 30 päeva ette. (3) Kui seemneproovi võtja volitusega seotud tegevus ei ole nõuetekohane, on Taimetoodangu Inspektsioonil õigus: võtta volitus tagasi ning lõpetada ühepoolselt haldusleping; peatada volitus ja anda seemneproovi võtjale tähtaeg puuduse kõrvaldamiseks. Kui tähtpäevaks puudust ei kõrvaldata või kui puudust ei ole võimalik kõrvaldada, võtab Taimetoodangu Inspektsioon volituse tagasi ja lõpetab ühepoolselt halduslepingu.",
      "rdfs:label": {
