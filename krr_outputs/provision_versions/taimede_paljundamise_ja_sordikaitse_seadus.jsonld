      }
    },
    {
      "@id": "estleg:TPSKS_Par_107_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seemne ning paljundus- või kultiveerimismaterjali turustamisega tegelev isik peab oma tegevuse kohta täpset arvestust. Seemne ning paljundus- või kultiveerimismaterjali turustamist käsitlevaid dokumente säilitatakse vähemalt kolm aastat.",
      "rdfs:label": {
        "@value": "TPSKS_Par_107 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_107_v13223610"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 107",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_107_v13223610",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemne ning paljundus- või kultiveerimismaterjali turustamisega tegelev isik peab oma tegevuse kohta täpset arvestust. Seemne ning paljundus- või kultiveerimismaterjali turustamist käsitlevaid dokumente säilitatakse vähemalt kolm aastat. (2) Seemne tootja või paljundusmaterjali tarnija teavitab kalendriaasta jooksul geneetiliste ressursside säilitamiseks ettenähtud sordi seemne ja paljundusmaterjali turustatud kogustest pädevat järelevalveasutust kalendriaastale järgneva aasta 31. jaanuariks.",
      "rdfs:label": {
        "@value": "TPSKS_Par_107 (redaktsioon 13223610)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13223610",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_107_v109112011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13223610",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 107",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_107_v109112011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemne ning paljundus- või kultiveerimismaterjali turustamisega tegelev isik peab oma tegevuse kohta täpset arvestust. Seemne ning paljundus- või kultiveerimismaterjali turustamist käsitlevaid dokumente säilitatakse vähemalt kolm aastat. (2) Seemne tootja või paljundusmaterjali tarnija teavitab kalendriaasta jooksul geneetiliste ressursside säilitamiseks ettenähtud sordi seemne, säilitussegu ja paljundusmaterjali turustatud kogustest pädevat järelevalveasutust kalendriaastale järgneva aasta 31. jaanuariks. (3) Käesoleva seaduse § 72 lõikes 4 nimetatud isik ning isik, kes tegeleb söödakultuuride seemnesegu importimise või teisest liikmesriigist Eestisse toimetamisega, teavitab Põllumajandusametit kalendriaasta esimese kümne kalendrikuu jooksul Eestis turustatud söödakultuuride seemnesegu kogusest sama aasta 1. detsembriks.",
      "rdfs:label": {
        "@value": "TPSKS_Par_107 (redaktsioon 109112011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011007",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_107_v129062014075"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011007",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 107",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
