    {
      "@id": "estleg:TPSKS_Par_119_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemne ning paljundus- ja kultiveerimismaterjali Euroopa Liidu õigusaktide nõuetele vastavuse kontrollimiseks korraldatakse Euroopa Liidu võrdlevad katsed. (2) Järelevalveametnik võtab seemnest ning paljundus- ja kultiveerimismaterjalist isiku kulul vajalikus koguses proove Euroopa Liidu võrdlevates katsetes osalemiseks.",
      "rdfs:label": {
        "@value": "TPSKS_Par_119 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_119_v129062014075"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 119",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_119_v129062014075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
