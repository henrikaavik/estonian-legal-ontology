        "@type": "xsd:date"
      },
      "estleg:versionText": "Põldtunnustaja peab olema läbinud Põllumajandusameti korraldatud asjakohase koolituse.",
      "rdfs:label": {
        "@value": "TPSKS_Par_80 (redaktsioon 129062014075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014075",
