  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_taimede_paljundamise_ja_sordikaitse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Taimede paljundamise ja sordikaitse seadus (582 versiooni)",
        "@language": "et"
      },
      "dc:source": "Taimede paljundamise ja sordikaitse seadus"
    },
    {
      "@id": "estleg:TPSKS_Par_1_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib taimesordi (edaspidi sort ) registreerimist, sordi sordilehte ja kaitse alla võtmist, kaitsealuse sordi omaniku õigusi, seemne ning taimse paljundusmaterjali (edaspidi paljundusmaterjal ) ja kultiveerimismaterjali turustamisotstarbelist tootmist, sealhulgas pakendamist, turustamist ja Eestisse toimetamist, riiklikku järelevalvet ning vastutust käesoleva seaduse ja selle alusel kehtestatud õigusaktide rikkumise eest. (2) Käesolevat seadust ei kohaldata sellise seemne ning paljundus- ja kultiveerimismaterjali suhtes, mis on: toodetud oma tarbeks kasutamiseks; ette nähtud ekspordiks, välja arvatud lõpuni sertifitseerimata seeme; vähesel määral jaemüügi korras kohaliku turu kaudu lõpptarbijale turustamiseks ettenähtud paljundusmaterjal, välja arvatud seemnekartul; tööstustoormena kasutatav seeme. (3) Euroopa Liidu õigusaktides, käesolevas seaduses ja selle alusel antavates õigusaktides ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades Euroopa Liidu õigusaktide ja käesoleva seaduse erisusi. (4) Seemne kasutamisel toidutoorme või toiduna kohaldatakse toiduseaduse sätteid. (5) Seemne kasutamisel sööda või selle koostisosana kohaldatakse söödaseaduse sätteid.",
      "rdfs:label": {
        "@value": "TPSKS_Par_1 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_1_v1041451"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
