      }
    },
    {
      "@id": "estleg:TPSKS_Par_8_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitse alla, sordilehte või põllukultuuride soovitatud sordilehte võib võtta registreeritud sorti. Sordi registreerimine on menetlus, mille käigus tehakse kindlaks sordi vastavus käesolevas seaduses sätestatud nõuetele ja kantakse nõuetekohane sort riiklikku sordiregistrisse. (2) Sordi registreerimiseks esitab taotleja riikliku sordiregistri volitatud töötlejale (edaspidi registripidaja ) vormikohase taotluse. Taotluse esitaja vastutab taotluses esitatud andmete õigsuse eest. (4) Koos sordi registreerimisega võib sordi omanik taotleda ka sordi kaitse alla või sordilehte võtmist.",
      "rdfs:label": {
        "@value": "TPSKS_Par_8 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_8_v12975262"
      },
      "estleg:versionValidTo": {
        "@value": "2008-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_8_v12975262",
      "@type": [
        "owl:NamedIndividual",
