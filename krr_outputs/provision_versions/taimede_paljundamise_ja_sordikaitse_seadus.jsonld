    {
      "@id": "estleg:TPSKS_Par_4_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paljundusmaterjal käesoleva seaduse tähenduses on seemnekartul ning aiakultuuri puhul eelkõige liigi paljundamiseks või istutusmaterjali tootmiseks kasutatav taimne materjal, sealhulgas puuvilja-, marja- ja dekoratiivkultuuri puhul ka seeme ning vegetatiiv- ja seemikalus ning puuvilja-, marja- ja köögiviljakultuuri puhul ka istutusmaterjal, milleks on istutamiseks või ümberistutamiseks ettenähtud taim või taimeosa. (2) Seemnekartul ning puuvilja- ja marjakultuuri paljundusmaterjal jagatakse nende põlvnemise ja kvaliteedi alusel kategooriatesse.",
      "rdfs:label": {
        "@value": "TPSKS_Par_4 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_4_v13223610"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_4_v13223610",
