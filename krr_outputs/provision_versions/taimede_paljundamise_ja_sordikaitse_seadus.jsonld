      "estleg:provisionRef": "TPSKS § 131",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_131_v12975262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
