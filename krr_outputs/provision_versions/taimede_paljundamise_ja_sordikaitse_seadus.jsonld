    },
    {
      "@id": "estleg:TPSKS_Par_98_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemne pakendamise loa kehtivus peatatakse osaliselt või täielikult kuni: käesoleva seaduse rikkumise asjaolude selgumiseni; ettekirjutuse täitmiseni, kui ettevõttes ei ole seal ajutiselt valitsevate olude tõttu võimalik tagada pakendatava seemne nõuetekohasust. (2) Seemne pakendamise loa kehtivuse osalise või täieliku peatamise otsuse teeb järelevalveasutus käesoleva paragrahvi lõikes 1 nimetatud asjaolust teadasaamisest arvates kümne tööpäeva jooksul. (3) Seemne pakendamise loa kehtivuse peatamisest teadasaamisest alates peatab pakendaja seemne pakendamise otsuses määratud ulatuses. (4) Pakendaja teavitab järelevalveasutust seemne pakendamise loa kehtivuse peatamise põhjuseks olnud asjaolu kõrvaldamisest. Järelevalveasutus kontrollib esitatud teabe õigsust. (5) Kui seemne pakendamise loa kehtivuse peatamise aluseks olnud asjaolu on kõrvaldatud, taastab järelevalveasutus seemne pakendamise loa kehtivuse.",
      "rdfs:label": {
        "@value": "TPSKS_Par_98 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_98_v129062014075"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
