        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13223610",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 117",
