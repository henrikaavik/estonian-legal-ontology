        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Liidu asjakohases õigusaktis sätestatud pädev asutus või vastutav asutus on Põllumajandus- ja Toiduamet ja Keskkonnaamet käesolevas seaduses sätestatud pädevuse piires.",
      "rdfs:label": {
        "@value": "TPSKS_Par_7_1 (redaktsioon 108122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122020004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108122020004",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 7_1",
      "estleg:partOfAct": {
