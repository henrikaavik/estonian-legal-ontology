      }
    },
    {
      "@id": "estleg:TPSKS_Par_18_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registripidaja teeb registreerimiskatsete tulemuste põhjal otsuse sordi eristatavuse, ühtlikkuse ja püsivuse nõuetekohasuse või mittenõuetekohasuse kohta 30 tööpäeva jooksul registreerimiskatsete aruande saamisest arvates. (2) Kui registripidaja otsustab geneetiliste ressursside säilitamiseks ettenähtud sordi nõuetekohasuse või mittenõuetekohasuse sordikirjelduse ja muude andmete alusel, teeb ta otsuse 30 tööpäeva jooksul sordikirjelduse ja asjakohaste andmete saamisest arvates. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "TPSKS_Par_18 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
