    {
      "@id": "estleg:TPSKS_Par_47_v112072014133",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_47"
      },
