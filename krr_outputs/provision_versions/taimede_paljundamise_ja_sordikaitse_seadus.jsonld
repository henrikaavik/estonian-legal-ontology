      }
    },
    {
      "@id": "estleg:TPSKS_Par_4_1_v119122024005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sordikaitse alla võtmata seemet ja paljundusmaterjali, mille taimeliiki või -liikide gruppi iseloomustab suurem geneetiline mitmekesisus, haiguskindlus või -taluvus ning kohanemine eri kohalike mulla- ja ilmastikutingimustega, võib käesoleva seaduse teisi asjakohaseid nõudeid järgimata turustada sellises koguses, mis taimeliigi või -liikide grupi kaupa ei ületa aasta kohta selleks lubatud kogust (edaspidi väike kogus). (2) kehtestab määrusega käesoleva paragrahvi lõikes 1 nimetatud seemne ja paljundusmaterjali aasta jooksul turustada lubatud väikesed kogused seemne müügipakendi maksimaalse netomassina või istutusmaterjali maksimaalse kogusena taimeliigi või -liikide grupi kaupa selliselt, et need oleksid selgelt väiksemad sama taimeliigi sordi seemne või paljundusmaterjali harilikust turustatavast kogusest ning geneetiliste ressursside säilitamiseks ettenähtud sordi seemne ja paljundusmaterjali turustamiseks ettenähtud kogusest. (3) Käesoleva paragrahvi lõikes 1 nimetatud seemne ja paljundusmaterjali väikeses koguses turustamisega tegelev isik peab enda turustatava seemne ja paljundusmaterjali üle täpset arvestust. Andmeid ja dokumente nimetatud seemne ja paljundusmaterjali väikeses koguses turustamise kohta säilitatakse kolm aastat.",
      "rdfs:label": {
        "@value": "TPSKS_Par_4_1 (redaktsioon 119122024005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122024005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119122024005",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 4_1",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_5_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kultiveerimismaterjal käesoleva seaduse tähenduses on nõukogu direktiivi 1999/105/EÜ metsapaljundusmaterjali turustamise kohta (EÜT L 011, 15.01.2000, lk 17–40) lisas I nimetatud ning metsanduslikul eesmärgil kasutatavate puuliikide ja nende hübriidide seemned, taimeosad ja istutamiseks või ümberistutamiseks ettenähtud istutusmaterjal. (2) Kultiveerimismaterjal jagatakse algmaterjali päritolu ja kvaliteedi alusel kategooriatesse. (3) Kultiveerimismaterjali kategooriad ja algmaterjali nõuded kehtestab keskkonnaminister.",
      "rdfs:label": {
        "@value": "TPSKS_Par_5 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_5_v1041451"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
