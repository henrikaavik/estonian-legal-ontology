      },
      "estleg:versionValidTo": {
        "@value": "2010-07-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_15_v13331807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
