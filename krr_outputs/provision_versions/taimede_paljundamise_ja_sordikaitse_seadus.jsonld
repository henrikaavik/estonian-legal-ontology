      }
    },
    {
      "@id": "estleg:TPSKS_Par_59_v108122020004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registripidaja keeldub registrisse kande tegemisest, kui: riigilõiv on tasumata; taotleja on esitanud Põllumajandus- ja Toiduametile teadvalt valeandmeid või on mõjutanud Põllumajandus- ja Toiduametit õigusvastasel viisil.",
      "rdfs:label": {
        "@value": "TPSKS_Par_59 (redaktsioon 108122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122020004",
