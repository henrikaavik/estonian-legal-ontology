    {
      "@id": "estleg:TPSKS_Par_84_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põldtunnustaja on kohustatud: täitma erapooletult temale volitusega pandud ülesanded; tagama põldtunnustamisakti ja muu dokumendi õiguspärase, nõuetekohase ja korrektse vormistamise; hoidma talle põldtunnustamisel teatavaks saanud äri- ja ametisaladust; tagama põldtunnustamisakti üleandmise oma tegevuspiirkonna järelevalveametnikule kümne tööpäeva jooksul, talivilja puhul viie tööpäeva jooksul põldtunnustamisest arvates; andma pärast volituse lõppemist käesoleva lõike punktis 4 nimetatud dokumendi üle Taimetoodangu Inspektsioonile; esitama Taimetoodangu Inspektsioonile tema nõudmisel kõik volitusega seotud tegevuse üle järelevalve tegemiseks vajalikud dokumendid.",
      "rdfs:label": {
        "@value": "TPSKS_Par_84 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_84_v13225921"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 84",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
