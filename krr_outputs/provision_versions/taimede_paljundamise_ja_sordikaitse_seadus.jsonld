      },
      "estleg:versionValidFrom": {
        "@value": "2009-10-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemne või paljundusmaterjali tootmine käesoleva seaduse tähenduses on seemne või paljundusmaterjali paljundamine vegetatiivsel või muul viisil, kasvatamine, töötlemine, säilitamine ja pakendamine turustamise eesmärgil. (2) Kultiveerimismaterjali tootmine käesoleva seaduse tähenduses on metsapuude turustamisotstarbelise seemnepartii moodustamine ning istutusmaterjali kasvatamine seemnest, taimeosast või taimest.",
      "rdfs:label": {
        "@value": "TPSKS_Par_62 (redaktsioon 13223610)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13223610",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_62_v119032019112"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13223610",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 62",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_62_v119032019112",
      "@type": [
