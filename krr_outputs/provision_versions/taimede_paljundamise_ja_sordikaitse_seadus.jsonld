      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsapuude seemnete pakendamise tegevusloale lisatakse kõrvaltingimustena pakendatavate seemnete loetelu puuliikide kaupa ja kehtivusaeg.",
      "rdfs:label": {
        "@value": "TPSKS_Par_97_2 (redaktsioon 129062014075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014075",
