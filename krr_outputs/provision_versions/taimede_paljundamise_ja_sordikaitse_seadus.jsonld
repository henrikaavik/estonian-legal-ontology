      },
      "estleg:versionText": "Euroopa Liidu asjakohases õigusaktis sätestatud pädev asutus või vastutav asutus on Põllumajandusamet ja Keskkonnaamet käesolevas seaduses sätestatud pädevuse piires.",
      "rdfs:label": {
        "@value": "TPSKS_Par_7_1 (redaktsioon 13331807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331807",
      "estleg:supersededByVersion": {
