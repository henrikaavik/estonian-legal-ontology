      }
    },
    {
      "@id": "estleg:TPSKS_Par_85_v119032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemneproovi võtmise tegevusloa taotluse lahendab tegevusloa andmisega või sellest keeldumisega Põllumajandusamet. (2) Seemneproovi võtmise tegevusloa taotluses esitatakse lisaks majandustegevuse seadustiku üldosa seaduse § 19 lõikes 2 sätestatud andmetele järgmised andmed: kehtiva seemneproovi võtja aluskoolituse läbimise tunnistuse number; seemneproovi võtja nõuetele vastava isiku nimi ja kontaktandmed; teave selle kohta, kas soovitakse osutada seemneproovi võtmise teenust. (3) Käesoleva paragrahvi lõikes 2 nimetatud andmed kantakse taimekaitseseaduse § 30 lõike 1 alusel asutatud taimetervise registrisse. (4) Seemneproovi võtmise tegevusloa taotluse lahendamise eest ei tasu isik riigilõivu.",
      "rdfs:label": {
        "@value": "TPSKS_Par_85 (redaktsioon 119032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019112",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_85_v108122020004"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019112",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_85_v108122020004",
