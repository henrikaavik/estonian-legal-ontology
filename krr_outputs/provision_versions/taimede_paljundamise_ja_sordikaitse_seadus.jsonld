      }
    },
    {
      "@id": "estleg:TPSKS_Par_119_v108122020004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seemne ning paljundus- ja kultiveerimismaterjali Euroopa Liidu õigusaktide nõuetele vastavuse kontrollimiseks korraldatakse Euroopa Liidu võrdlevad katsed. (2) Põllumajandus- ja Toiduamet või Keskkonnaamet võtab seemnest ning paljundus- ja kultiveerimismaterjalist isiku kulul vajalikus koguses proove Euroopa Liidu võrdlevates katsetes osalemiseks.",
      "rdfs:label": {
        "@value": "TPSKS_Par_119 (redaktsioon 108122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122020004",
