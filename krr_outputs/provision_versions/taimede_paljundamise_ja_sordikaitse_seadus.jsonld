      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registripidaja keeldub registrisse kande tegemisest, kui: riigilõiv on tasumata; taotleja on esitanud registripidajale või järelevalveametnikule teadvalt valeandmeid või on mõjutanud registripidajat või järelevalveametnikku õigusvastasel viisil.",
      "rdfs:label": {
        "@value": "TPSKS_Par_59 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_59_v129062014075"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
