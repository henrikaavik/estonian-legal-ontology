      }
    },
    {
      "@id": "estleg:TPSKS_Par_85_v969383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitus lõpeb: volitusest loobumise korral; volituse tähtaja möödumisega; volitatu surma korral; volituse tagasivõtmise korral. (2) Taimetoodangu Inspektsioon võtab viivitamata tarvitusele meetmed haldusülesande täitmise tagamiseks, kui haldusleping lõpetatakse ühepoolselt või kui esineb muu põhjus, mis takistab isikul jätkata haldusülesande täitmist.",
      "rdfs:label": {
        "@value": "TPSKS_Par_85 (redaktsioon 969383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "969383",
      "estleg:supersededByVersion": {
        "@id": "estleg:TPSKS_Par_85_v13225921"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/969383",
      "estleg:sourceAct": "Taimede paljundamise ja sordikaitse seadus",
      "estleg:provisionRef": "TPSKS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:TPSKS_Map"
      }
    },
    {
      "@id": "estleg:TPSKS_Par_85_v13225921",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TPSKS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitus lõpeb: volitusest loobumise korral; volituse tähtaja möödumisega; volitatu surma korral; volituse tagasivõtmise korral. (2) Põllumajandusamet võtab viivitamata tarvitusele meetmed haldusülesande täitmise tagamiseks, kui haldusleping lõpetatakse ühepoolselt või kui esineb muu põhjus, mis takistab isikul jätkata haldusülesande täitmist.",
      "rdfs:label": {
