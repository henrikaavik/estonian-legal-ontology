    {
      "@id": "estleg:Reg_1025378_Par_2_v1025378",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025378_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse tähenduses jaotatakse laevad järgmistesse kategooriatesse: 1 1) A-kategooriasse kuuluvad laevad, mille sõidu piirkond ei ole piiratud; 2 2) B-kategooriasse kuuluvad laevad, mis ei kaugene enam kui 150 meremiili lähimast sadamast, kust on võimalik saada tervishoiuteenust; 3 3) C-kategooriasse kuuluvad siseveekogudel sõitvad laevad ja kohaliku rannasõidu laevad. Käesoleva määruse tähenduses jaotatakse laevad järgmistesse kategooriatesse: A-kategooriasse kuuluvad laevad, mille sõidu piirkond ei ole piiratud; B-kategooriasse kuuluvad laevad, mis ei kaugene enam kui 150 meremiili lähimast sadamast, kust on võimalik saada tervishoiuteenust; C-kategooriasse kuuluvad siseveekogudel sõitvad laevad ja kohaliku rannasõidu laevad.",
      "rdfs:label": {
        "@value": "Reg_1025378_Par_2 (redaktsioon 1025378)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025378",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025378",
      "estleg:sourceAct": "Meditsiiniabi korraldamise nõuded laeval ja laeval nõutava meditsiinivarustuse loetelu",
      "estleg:provisionRef": "Reg_1025378 § 2",
      "estleg:partOfAct": {
