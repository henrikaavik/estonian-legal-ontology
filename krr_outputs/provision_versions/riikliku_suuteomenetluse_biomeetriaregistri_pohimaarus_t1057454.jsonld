      "estleg:provisionRef": "Reg_1057454 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057454_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1057454_Par_8_v1057454",
