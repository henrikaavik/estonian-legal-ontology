    {
      "@id": "estleg:Reg_1057454_Par_13_v1057454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057454_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Otsejuurdepääs registri andmetele on ainult selleks õigustatud EKEI töötajatel. Otsejuurdepääs registri andmetele on ainult selleks õigustatud EKEI töötajatel. 2 (2) RIK-il on juurdepääs registri andmetele ainult § 4 lõigetes 4 ja 6 nimetatud ülesannete täitmiseks. RIK-il on juurdepääs registri andmetele ainult § 4 lõigetes 4 ja 6 nimetatud ülesannete täitmiseks. 3 (3) Registrile juurdepääsu taotlus esitatakse EKEI direktorile, kes edastab rahuldatud taotluse RIK-ile, kes tagab registrile vajaliku juurdepääsu. Registrile juurdepääsu taotlus esitatakse EKEI direktorile, kes edastab rahuldatud taotluse RIK-ile, kes tagab registrile vajaliku juurdepääsu.",
      "rdfs:label": {
        "@value": "Reg_1057454_Par_13 (redaktsioon 1057454)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057454",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057454",
      "estleg:sourceAct": "Riikliku süüteomenetluse biomeetriaregistri põhimäärus",
      "estleg:provisionRef": "Reg_1057454 § 13",
