    {
      "@id": "estleg:Reg_1057454_Par_14_v1057454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057454_Par_14"
