      "estleg:versionValidFrom": {
        "@value": "2022-09-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 25. mai 2021. a käskkirjaga nr 1-2/21/254 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 25. mai 2021. a käskkirjaga nr 1-2/21/254 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1054741_Par_10 (redaktsioon 1054741)",
        "@language": "et"
      },
