        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
