    {
      "@id": "estleg:Reg_1039252_Par_26_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vormiriietusel kasutatavad eraldusmärgid on: 1 1) vapiembleem; 2 2) riigitunnus; 3 3) kiriembleem; 4 4) nimesilt ja identifitseerimissilt; 5 5) tekstiline tähis; 6 6) Maksu- ja Tolliameti uurimisosakonna embleem; 7 7) koerajuhi embleem; 8 8) tikand; 9 9) vorminööbid. Vormiriietusel kasutatavad eraldusmärgid on: vapiembleem; riigitunnus; kiriembleem; nimesilt ja identifitseerimissilt; tekstiline tähis; Maksu- ja Tolliameti uurimisosakonna embleem; koerajuhi embleem; tikand; vorminööbid. 2 (2) Vormiriietusel kasutatavate eraldusmärkide kujutised esitatakse määruse lisas (lisatud). RT I 2022-05-10 12 110052022012 2022-05-16 Vormiriietusel kasutatavate eraldusmärkide kujutised esitatakse määruse lisas (lisatud).",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_26 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 26",
      "estleg:partOfAct": {
