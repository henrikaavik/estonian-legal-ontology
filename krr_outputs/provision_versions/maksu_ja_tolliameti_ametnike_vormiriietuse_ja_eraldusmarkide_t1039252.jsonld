      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 33_41",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_34_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vorminööbid on hõbedasest metallist, kolme lõvi kujutisega. Suure vorminööbi läbimõõt on 2,2 cm, väikese vorminööbi läbimõõt on 1,4 cm. Vorminööbid on hõbedasest metallist, kolme lõvi kujutisega. Suure vorminööbi läbimõõt on 2,2 cm, väikese vorminööbi läbimõõt on 1,4 cm.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_34 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
