      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_4_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Naiste vormikuub on üherealine ja reväärkraega ning kergelt taljesse töödeldud. Vormikuue esikinnisel on kolm suurt vorminööpi. Mõlemal hõlmal on sissetöödeldud klapiga küljetasku. Vormikuue vasakul varrukal on vapiembleem ja paremal varrukal riigitunnus. Kuue paremal hõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. RT I 2022-05-10 12 110052022012 2022-05-16 Naiste vormikuub on üherealine ja reväärkraega ning kergelt taljesse töödeldud. Vormikuue esikinnisel on kolm suurt vorminööpi. Mõlemal hõlmal on sissetöödeldud klapiga küljetasku. Vormikuue vasakul varrukal on vapiembleem ja paremal varrukal riigitunnus. Kuue paremal hõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. 2 (2) Naiste vormikuub on vastavalt teenistusülesannetele kas üleni tumesinine või tumesinine punaste kantidega. Naiste vormikuub on vastavalt teenistusülesannetele kas üleni tumesinine või tumesinine punaste kantidega. 3 (3) Meeste vormikuub on üherealine ja reväärkraega ning kergelt taljesse töödeldud. Vormikuue esikinnisel on kaks suurt vorminööpi. Vormikuue vasakul varrukal on vapiembleem ja paremal varrukal riigitunnus. Kuue paremal hõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. Varruka otstes on kinnine lõhik, millel on neli väikest vorminööpi. Meeste vormikuub on tumesinine. RT I 2022-05-10 12 110052022012 2022-05-16 Meeste vormikuub on üherealine ja reväärkraega ning kergelt taljesse töödeldud. Vormikuue esikinnisel on kaks suurt vorminööpi. Vormikuue vasakul varrukal on vapiembleem ja paremal varrukal riigitunnus. Kuue paremal hõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. Varruka otstes on kinnine lõhik, millel on neli väikest vorminööpi. Meeste vormikuub on tumesinine.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_4 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_5_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Naiste vest on V-kaelusega, üherealine ja kergelt taljesse töödeldud. Vest kinnitatakse eest nelja suure vorminööbiga. Vesti paremal hõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. Naiste vest on V-kaelusega, üherealine ja kergelt taljesse töödeldud. Vest kinnitatakse eest nelja suure vorminööbiga. Vesti paremal hõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. 2 (2) Naiste vest on vastavalt teenistusülesannetele kas üleni tumesinine või tumesinine punaste kantidega. Naiste vest on vastavalt teenistusülesannetele kas üleni tumesinine või tumesinine punaste kantidega.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_5 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_6_v1039252",
      "@type": [
        "owl:NamedIndividual",
