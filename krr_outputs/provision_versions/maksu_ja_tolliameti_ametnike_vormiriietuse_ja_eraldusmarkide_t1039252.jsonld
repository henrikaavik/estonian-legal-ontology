    {
      "@id": "estleg:Reg_1039252_Par_25_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pikeesärk on tumesinine, kraega, esiosas nööbiliistuga, klapiga rinnataskutega, lühikeste või pikkade varrukatega. Särgi vasaku rinnatasku kohal on kiriembleem ning parema rinnatasku kohal alus nimesildi kinnitamiseks. RT I 2022-05-10 12 110052022012 2022-05-16 Pikeesärk on tumesinine, kraega, esiosas nööbiliistuga, klapiga rinnataskutega, lühikeste või pikkade varrukatega. Särgi vasaku rinnatasku kohal on kiriembleem ning parema rinnatasku kohal alus nimesildi kinnitamiseks. 2 (2) T-särk on tumesinine, ümara kaeluse ja lühikeste või pikkade varrukatega. Särgi vasakul hõlmal on kiriembleem. RT I 2022-05-10 12 110052022012 2022-05-16 T-särk on tumesinine, ümara kaeluse ja lühikeste või pikkade varrukatega. Särgi vasakul hõlmal on kiriembleem. 3 (3) Termopolo on must või tumesinine, kergelt taljes lõikega, kõrge tagasipööratava kaelusega ja lukk-kinnisega. Termopolo on must või tumesinine, kergelt taljes lõikega, kõrge tagasipööratava kaelusega ja lukk-kinnisega.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_25 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
