        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohutusvest on erkkollane, helkurpaeltega, sügava kolmnurkse kaelusega, eest suletav. Vasakul rinna piirkonnas ja seljaosal on sinisel põhjal kiri „MAKSU- JA TOLLIAMET / Estonian Tax and Customs Board”. RT I 2022-05-10 12 110052022012 2022-05-16 Ohutusvest on erkkollane, helkurpaeltega, sügava kolmnurkse kaelusega, eest suletav. Vasakul rinna piirkonnas ja seljaosal on sinisel põhjal kiri „MAKSU- JA TOLLIAMET / Estonian Tax and Customs Board”.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_17 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_17_19_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
