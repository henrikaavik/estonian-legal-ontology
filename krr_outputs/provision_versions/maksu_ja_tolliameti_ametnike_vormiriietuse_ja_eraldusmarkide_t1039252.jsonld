    {
      "@id": "estleg:Reg_1039252_Par_33_39_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_33_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksu- ja Tolliameti uurimisosakonna embleem on prinditud, kootud või tikitud mustale taustale kuldse ja hõbedase värviga. Embleemil on väikese riigivapi kujutis ning sõnad „MTA” ja „MTA UURIMISOSAKOND”. Embleemi mõõdud on 7×5 cm. RT I 2025-01-28 8 128012025008 2025-01-31 Maksu- ja Tolliameti uurimisosakonna embleem on prinditud, kootud või tikitud mustale taustale kuldse ja hõbedase värviga. Embleemil on väikese riigivapi kujutis ning sõnad „MTA” ja „MTA UURIMISOSAKOND”. Embleemi mõõdud on 7×5 cm. 2 (2) Maksu- ja Tolliameti uurimisosakonna embleemi kasutatakse: 1 1) särgi esiosa vasakul hõlmal või särgi paremal varrukal; 2 2) jope paremal hõlmal või jope paremal varrukal riigitunnuse all; 3 3) ohutusvesti ja taktikalise vesti esiosa vasakul hõlmal. RT I 2025-01-28 8 128012025008 2025-01-31 Maksu- ja Tolliameti uurimisosakonna embleemi kasutatakse: särgi esiosa vasakul hõlmal või särgi paremal varrukal; jope paremal hõlmal või jope paremal varrukal riigitunnuse all; ohutusvesti ja taktikalise vesti esiosa vasakul hõlmal.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_33_39 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 33_39",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_33_40_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_33_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koerajuhi embleemi mustal taustal on kujutatud riigilippu, labrador retriiver tõugu koera ja koerajuhtide rahvusvahelist tunnust K-9 (sinine 18-4252 TP BLUE ASTER, must 19-4205 TP PHANTOM ja valge 11-0601 TP BRIGHT WHITE). Embleemil on valgete trükitähtedega kiri „MAKSU- JA TOLLIAMET / ESTONIAN TAX AND CUSTOMS BOARD”. Embleemi läbimõõt on 9 cm. Koerajuhi embleemi mustal taustal on kujutatud riigilippu, labrador retriiver tõugu koera ja koerajuhtide rahvusvahelist tunnust K-9 (sinine 18-4252 TP BLUE ASTER, must 19-4205 TP PHANTOM ja valge 11-0601 TP BRIGHT WHITE). Embleemil on valgete trükitähtedega kiri „MAKSU- JA TOLLIAMET / ESTONIAN TAX AND CUSTOMS BOARD”. Embleemi läbimõõt on 9 cm. 2 (2) Koerajuhi embleem kinnitatakse vormiriietuse parema varruka välisküljele takjaalusele. RT I 2022-05-10 12 110052022012 2022-05-16 Koerajuhi embleem kinnitatakse vormiriietuse parema varruka välisküljele takjaalusele.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_33_40 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 33_40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_33_41_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_33_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tikand tekstiga „MAKSU- JA TOLLIAMET” valmistatakse fluorestseeruva LUNA-tüüpi niidiga, kasutades fonti ALLER. Tikandi kõrgus on 1,0 cm ja pikkus on 13 cm. Tikand tekstiga „MAKSU- JA TOLLIAMET” valmistatakse fluorestseeruva LUNA-tüüpi niidiga, kasutades fonti ALLER. Tikandi kõrgus on 1,0 cm ja pikkus on 13 cm. 2 (2) Tikand tikitakse tavavormi pükste vasaku sääre taskuklapile. RT I 2022-05-10 12 110052022012 2022-05-16 Tikand tikitakse tavavormi pükste vasaku sääre taskuklapile.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_33_41 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
