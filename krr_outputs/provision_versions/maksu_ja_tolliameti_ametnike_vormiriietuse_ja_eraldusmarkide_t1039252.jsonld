      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 23_26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_23_27_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
