    {
      "@id": "estleg:Reg_1039252_Par_23_26_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_23_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Softshell-jakk on softshell’i omadustega materjalist, tumesinine, püstkraega, trukkidega eemaldatava kapuutsi ja lukkudega eemaldatavate varrukatega ning eest avatava lukk-kinnisega. Jaki vasakul varrukal on vapiembleem ja paremal varrukal riigitunnus. Jaki vasakul hõlmal on helkurkirjaga prinditud „MAKSU- JA TOLLIAMET” ja paremal hõlmal alus nimesildi kinnitamiseks. Jaki seljaosale on prinditud helkurprindiga kiri „MAKSU- JA TOLLIAMET / Estonian Tax and Customs Board”. RT I 2022-05-10 12 110052022012 2022-05-16 Softshell-jakk on softshell’i omadustega materjalist, tumesinine, püstkraega, trukkidega eemaldatava kapuutsi ja lukkudega eemaldatavate varrukatega ning eest avatava lukk-kinnisega. Jaki vasakul varrukal on vapiembleem ja paremal varrukal riigitunnus. Jaki vasakul hõlmal on helkurkirjaga prinditud „MAKSU- JA TOLLIAMET” ja paremal hõlmal alus nimesildi kinnitamiseks. Jaki seljaosale on prinditud helkurprindiga kiri „MAKSU- JA TOLLIAMET / Estonian Tax and Customs Board”.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_23_26 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
