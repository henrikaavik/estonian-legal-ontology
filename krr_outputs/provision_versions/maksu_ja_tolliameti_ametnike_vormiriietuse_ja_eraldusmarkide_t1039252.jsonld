      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_29_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nimesilt on tumesinine (19-4013 TPX DARK NAVY), mõõtmetega 3×9 cm ja takjapaelaga kinnituv. Nimesildile on valgete kirjatähtedega tikitud ametniku ees- ja perekonnanimi, tähe kõrgus 1 cm. Identifitseerimissilt vastab nimesildi tunnustele, kuid ees- ja perekonnanime asemel kasutatakse ametisiseselt fikseeritud numbrikombinatsiooni. RT I 2022-05-10 12 110052022012 2022-05-16 Nimesilt on tumesinine (19-4013 TPX DARK NAVY), mõõtmetega 3×9 cm ja takjapaelaga kinnituv. Nimesildile on valgete kirjatähtedega tikitud ametniku ees- ja perekonnanimi, tähe kõrgus 1 cm. Identifitseerimissilt vastab nimesildi tunnustele, kuid ees- ja perekonnanime asemel kasutatakse ametisiseselt fikseeritud numbrikombinatsiooni.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_29 (redaktsioon 1039252)",
        "@language": "et"
      },
