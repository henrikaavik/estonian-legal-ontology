      "estleg:provisionRef": "Reg_1039252 § 23_27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_24_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sviiter on kootud, pagunitega. Sviitril on pealeõmmeldud rinnatasku. Sviitri kaeluse äär, varrukaotsad ja alumine äär on soonikkoes. Sviitri vasakul varrukal on vapiembleem. Sviitri paremal esihõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. Sviiter on kootud, pagunitega. Sviitril on pealeõmmeldud rinnatasku. Sviitri kaeluse äär, varrukaotsad ja alumine äär on soonikkoes. Sviitri vasakul varrukal on vapiembleem. Sviitri paremal esihõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_24 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
