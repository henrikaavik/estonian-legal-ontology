    {
      "@id": "estleg:Reg_1039252_Par_27_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vapiembleem on väikese riigivapi kujutis. Vapiembleem on väikese riigivapi kujutis. 2 (2) Vapiembleemi kõrgus on 8 cm ja laius 6,5 cm. Vapiembleemi kõrgus on 8 cm ja laius 6,5 cm. 3 (3) Vapiembleemi taust on kollane (PANTONE 14-1064 TPX) ja lõvid sinised (PANTONE 285 C; C 91%; M 43%; Y 0%; B 0%). Vapiembleemi taust on kollane (PANTONE 14-1064 TPX) ja lõvid sinised (PANTONE 285 C; C 91%; M 43%; Y 0%; B 0%). 4 (4) Vapiembleemi ääristus on kollane, toon toonis vapiembleemi taustaga. Vapiembleemi ääristus on kollane, toon toonis vapiembleemi taustaga. 5 (5) Vapiembleem kinnitatakse vasaku varruka välisküljele 7 cm õlaõmblusest allapoole. Vapiembleem kinnitatakse vasaku varruka välisküljele 7 cm õlaõmblusest allapoole.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_27 (redaktsioon 1039252)",
        "@language": "et"
      },
