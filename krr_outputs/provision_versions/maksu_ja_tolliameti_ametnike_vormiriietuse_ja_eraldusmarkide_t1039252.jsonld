    {
      "@id": "estleg:Reg_1039252_Par_27_32_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_27_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigitunnus on vormiriietuse kangale tikitud Eesti riigilipu kujutis (sinine 18-4252 TP BLUE ASTER, must 19-4205 TP PHANTOM ja valge 11-0601 TP BRIGHT WHITE), mille all on sõna „ESTONIA” tähekõrgusega 0,6 cm ja tähejoone paksusega 0,1 cm (värvus 11-0601 TP BRIGHT WHITE). Riigitunnuse pikkus on 5,3 cm ja laius 6,5 cm. Riigitunnus on vormiriietuse kangale tikitud Eesti riigilipu kujutis (sinine 18-4252 TP BLUE ASTER, must 19-4205 TP PHANTOM ja valge 11-0601 TP BRIGHT WHITE), mille all on sõna „ESTONIA” tähekõrgusega 0,6 cm ja tähejoone paksusega 0,1 cm (värvus 11-0601 TP BRIGHT WHITE). Riigitunnuse pikkus on 5,3 cm ja laius 6,5 cm. 2 (2) Riigitunnus kinnitatakse vormiriietuse parema varruka välisküljele, 7 cm õlaõmblusest allapoole. RT I 2022-05-10 12 110052022012 2022-05-16 Riigitunnus kinnitatakse vormiriietuse parema varruka välisküljele, 7 cm õlaõmblusest allapoole.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_27_32 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
