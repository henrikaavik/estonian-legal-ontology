      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Naiste kardigan on tumesininine. Naiste kardigan on tumesininine. 2 (2) Naiste kardigan on kootud. Lühike kardigan ulatub puusajooneni ja pikk kardigan ulatub põlvejooneni. Pikk kardigan on kantav vööga. Kardigani paremal esihõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem. RT I 2022-05-10 12 110052022012 2022-05-16 Naiste kardigan on kootud. Lühike kardigan ulatub puusajooneni ja pikk kardigan ulatub põlvejooneni. Pikk kardigan on kantav vööga. Kardigani paremal esihõlmal on alus nimesildi kinnitamiseks ja vasakul hõlmal kiriembleem.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_8_9 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 8_9",
      "estleg:partOfAct": {
