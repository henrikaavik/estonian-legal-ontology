      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_34_43_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_34_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2022. aasta 16. maid kehtinud määruse redaktsiooni kohaseid vormiriietuse esemeid ja eraldusmärke, mis erinevad alates 2022. aasta 16. maist kehtivast määruse redaktsioonist, on lubatud kanda kuni laovarude lõppemiseni või nende kandmiskõlbmatuks muutumiseni, kuid mitte kauem kui 2023. aasta 31. detsembrini. RT I 2022-05-10 12 110052022012 2022-05-16 Enne 2022. aasta 16. maid kehtinud määruse redaktsiooni kohaseid vormiriietuse esemeid ja eraldusmärke, mis erinevad alates 2022. aasta 16. maist kehtivast määruse redaktsioonist, on lubatud kanda kuni laovarude lõppemiseni või nende kandmiskõlbmatuks muutumiseni, kuid mitte kauem kui 2023. aasta 31. detsembrini.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_34_43 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 34_43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039252_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039252_Par_35_v1039252",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039252_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2017. aasta 1. juulil. Määrus jõustub 2017. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "Reg_1039252_Par_35 (redaktsioon 1039252)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039252",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039252",
      "estleg:sourceAct": "Maksu- ja Tolliameti ametnike vormiriietuse ja eraldusmärkide kirjeldus",
      "estleg:provisionRef": "Reg_1039252 § 35",
