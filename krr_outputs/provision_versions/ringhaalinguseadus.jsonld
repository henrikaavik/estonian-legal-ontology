    {
      "@id": "estleg:RingHS_Par_33_v22285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikontroll kontrollib Eesti Raadio ja Eesti Televisiooni tegevust vastavalt Riigikontrolli seadusele. (2) Eesti Raadio ja Eesti Televisiooni majandustegevust kontrollivad ringhäälingunõukogu määratud korralised ja erakorralised revisjonid.",
