      },
      "estleg:versionText": "Eesti Raadio ja Eesti Televisiooni tegevus lõpetatakse seaduse alusel, milles nähakse ette ka Eesti Raadio ja Eesti Televisiooni varade edasine kuuluvus.",
      "rdfs:label": {
        "@value": "RingHS_Par_36 (redaktsioon 22285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22285",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_36_v12787649"
      },
