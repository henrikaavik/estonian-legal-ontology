      "estleg:provisionRef": "RingHS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_24_v22285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Raadio ja Eesti Televisioon on avalik-õiguslikud juriidilised isikud, kes täidavad käesoleva seaduse alusel avalik-õiguslike raadio- ja televisiooniorganisatsioonide ülesandeid. (2) Eesti Raadiol ja Eesti Televisioonil on juriidilise isiku õigused käesoleva seadusega ja nende põhikirjadega sätestatud ulatuses. (3) Eesti Raadio ja Eesti Televisiooni põhikirjad kinnitab ringhäälingunõukogu. (4) [kehtetu] (5) Eesti Raadio ja Eesti Televisiooni ringhäälingusagedused määrab Kultuuriministeerium.",
      "rdfs:label": {
        "@value": "RingHS_Par_24 (redaktsioon 22285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22285",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_24_v186646"
      },
      "estleg:versionValidTo": {
