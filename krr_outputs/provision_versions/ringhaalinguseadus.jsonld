        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_42_v121122010027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet käesoleva seaduse täitmise, välja arvatud käesoleva seaduse §-s 7 sätestatud nõuete täitmine, ja ringhäälinguloa tingimustest kinnipidamise üle teostavad Kultuuriministeeriumi levitalituse ja Tehnilise Järelevalve Ameti ametnikud. (2) Kultuuriministeeriumi levitalituse ametnikud teostavad järelevalvet käesoleva seaduse nõuetest, samuti programmiga seotud tingimustest ja tegevuse alustamise tähtajast (käesoleva seaduse § 38 lõike 1 punktid 3–6) kinnipidamise üle. (3) Kehtetu – (4) Järelevalvet teostaval ametnikul on õigus: saada vajadusel ringhäälinguorganisatsioonide saadete salvestisi; teha ringhäälinguorganisatsioonile käesoleva seaduse §-s 43 sätestatud korras kohustuslik ettekirjutus käesoleva seaduse või ringhäälinguloa tingimuste rikkumise korral; teha kultuuriministrile esildis ringhäälinguloa kehtivuse peatamiseks või ringhäälinguloa kehtetuks tunnistamiseks; saada vajaduse korral ringhäälinguorganisatsioonilt andmeid käesoleva seaduse täitmise ja ringhäälingulubade tingimustest kinnipidamise kohta.",
      "rdfs:label": {
        "@value": "RingHS_Par_42 (redaktsioon 121122010027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010027",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_43_v22285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettekirjutuses tuuakse ära: selle koostamise aeg ja koht; asutuse nimi ja aadress, kelle nimel ettekirjutus koostatakse; ettekirjutuse koostanud isiku ametinimetus, ees- ja perekonnanimi; õiguserikkumise koht, aeg ja kirjeldus; sätted, mis näevad ette vastutuse õiguserikkumise eest; nõue õiguserikkumise lõpetamiseks ja ettekirjutuse täitmise tähtaeg. (2) Ettekirjutuse mittetäitmisel või mittekohasel täitmisel kohaldatakse käesolevas seaduses või haldusõiguserikkumiste seadustikus (RT 1992, 29, 396; RT I 1999, 41, 496; 45, õiend) ettenähtud vastutust.",
      "rdfs:label": {
        "@value": "RingHS_Par_43 (redaktsioon 22285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22285",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_43_v12895138"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22285",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 43",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_43_v12895138",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettekirjutuses tuuakse ära: selle koostamise aeg ja koht; asutuse nimi ja aadress, kelle nimel ettekirjutus koostatakse; ettekirjutuse koostanud isiku ametinimetus, ees- ja perekonnanimi; õiguserikkumise koht, aeg ja kirjeldus; sätted, mis näevad ette vastutuse õiguserikkumise eest; nõue õiguserikkumise lõpetamiseks ja ettekirjutuse täitmise tähtaeg. (2) Ettekirjutuse mittetäitmisel või mittekohasel täitmisel kohaldatakse käesolevas seaduses või haldusõiguserikkumiste seadustikus ettenähtud vastutust.",
      "rdfs:label": {
        "@value": "RingHS_Par_43 (redaktsioon 12895138)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895138",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895138",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 43",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_44_v22285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne käesoleva seaduse jõustumist väljaantud televisiooni ja raadio tegevuslitsentsid asendatakse ringhäälingulubadega käesolevas seaduses sätestatud korras. (2) Litsentsi asendamiseks ringhäälinguloaga tuleb loa taotlejal kahe kuu jooksul, arvates seaduse jõustumisest, esitada Kultuuri- ja Haridusministeeriumile käesoleva seaduse nõuetele vastav taotlus. Taotlus vaadatakse läbi käesoleva seaduse alusel ja korras. (3) Enne käesoleva seaduse jõustumist väljaantud televisiooni ja raadio tegevuslitsentsid kaotavad kehtivuse: tegevuslitsentsi ringhäälinguloaga asendamise taotluse rahuldamise juhul - ringhäälinguloa väljaandmise otsuse tegemisele järgnevast päevast; muudel juhtudel - viie kuu möödumisel käesoleva seaduse jõustumise päevast.",
      "rdfs:label": {
        "@value": "RingHS_Par_44 (redaktsioon 22285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22285",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_44_v121122010027"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22285",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_44_v121122010027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne käesoleva seaduse jõustumist väljaantud televisiooni ja raadio tegevuslitsentsid asendatakse ringhäälingulubadega käesolevas seaduses sätestatud korras. (2) Litsentsi asendamiseks ringhäälinguloaga tuleb loa taotlejal kahe kuu jooksul, arvates seaduse jõustumisest, esitada Kultuuri- ja Haridusministeeriumile käesoleva seaduse nõuetele vastav taotlus. Taotlus vaadatakse läbi käesoleva seaduse alusel ja korras. (3) Enne käesoleva seaduse jõustumist väljaantud televisiooni ja raadio tegevuslitsentsid kaotavad kehtivuse: tegevuslitsentsi ringhäälinguloaga asendamise taotluse rahuldamise juhul – ringhäälinguloa väljaandmise otsuse tegemisele järgnevast päevast; muudel juhtudel – viie kuu möödumisel käesoleva seaduse jõustumise päevast.",
      "rdfs:label": {
        "@value": "RingHS_Par_44 (redaktsioon 121122010027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010027",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 44",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_45_v22285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigiettevõtte \"Eesti Telekommunikatsioonid\" Ringhäälingu Saatekeskuse tervikvara baasil asutab Vabariigi Valitsus 1996. aasta 1. jaanuariks aktsiaseltsi äriseadustikus (RT I 1995, 26-28, 355; 57, 976) kehtestatud korras. (2) Käesoleva paragrahvi 1. lõikes nimetatud aktsiaseltsi aktsiad kuuluvad asutamisel riigile. Aktsiate võõrandamine toimub riigivaraseaduses (RT I 1995, 22, 327) kehtestatud korras, kusjuures aktsiate võõrandamisel peab riigile jääma vähemalt 51% aktsiatega esindatud häältest. (3) -- (6) [Kehtetud]",
      "rdfs:label": {
        "@value": "RingHS_Par_45 (redaktsioon 22285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22285",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_45_v178885"
      },
