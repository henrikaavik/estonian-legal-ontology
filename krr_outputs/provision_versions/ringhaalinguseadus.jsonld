      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reklaami ja otsepakkumise tellija ei tohi mõjutada saadete sisu ega programmi struktuuri.",
      "rdfs:label": {
