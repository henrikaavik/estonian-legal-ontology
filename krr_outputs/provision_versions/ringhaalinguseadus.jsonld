      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "RingHS_Par_34 (redaktsioon 12778158)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12778158",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12778158",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 34",
      "estleg:partOfAct": {
