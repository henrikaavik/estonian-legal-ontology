    {
      "@id": "estleg:RingHS_Par_23_v22285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringhäälingusaateid ning -programme võib omandada, luua ja vahendada igaüks. (2) Saateid ja programme võib ringhäälinguorganisatsiooni, -saatja või -saatjate võrgu kaudu edastada ringhäälinguluba omav eraõiguslik isik või käesoleva seaduse alusel tegutsevad avalik-õiguslikud isikud.",
      "rdfs:label": {
        "@value": "RingHS_Par_23 (redaktsioon 22285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22285",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_23_v12778158"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22285",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
    {
      "@id": "estleg:RingHS_Par_23_v12778158",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringhäälingusaateid ning -programme võib omandada, luua ja vahendada igaüks. (2) Saateid ja programme võib ringhäälinguorganisatsiooni, -saatja või -saatjate võrgu kaudu edastada ringhäälinguluba omav eraõiguslik isik või käesoleva seaduse alusel tegutsevad avalik-õiguslikud isikud. (3) Ringhäälinguluba ei vaja isik, kes taasedastab avalik-õigusliku isiku või ringhäälinguluba omava eraõigusliku isiku saateid ja programme.",
      "rdfs:label": {
        "@value": "RingHS_Par_23 (redaktsioon 12778158)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12778158",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12778158",
