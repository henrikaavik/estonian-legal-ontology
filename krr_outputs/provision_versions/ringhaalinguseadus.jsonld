      }
    },
    {
      "@id": "estleg:RingHS_Par_42_v186646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RingHS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet käesoleva seaduse täitmise ja ringhäälinguloa tingimustest kinnipidamise üle teostavad Kultuuriministeeriumi levitalituse ja Sideameti ametnikud. (2) Kultuuriministeeriumi levitalituse ametnikud teostavad järelevalvet käesoleva seaduse nõuetest, samuti programmiga seotud tingimustest ja tegevuse alustamise tähtajast (käesoleva seaduse § 38 lõike 1 punktid 3-6) kinnipidamise üle. (3) Sideameti ametnikud teostavad järelevalvet ringhäälinguloa tehnilistest tingimustest (käesoleva seaduse § 38 lõike 1 punktid 1 ja 2) kinnipidamise üle. (4) Järelevalvet teostaval ametnikul on õigus: saada vajadusel ringhäälinguorganisatsioonide saadete salvestisi; teha ringhäälinguorganisatsioonile käesoleva seaduse §-s 43 sätestatud korras kohustuslik ettekirjutus käesoleva seaduse või ringhäälinguloa tingimuste rikkumise korral; teha kultuuriministrile esildis ringhäälinguloa kehtivuse peatamiseks või ringhäälinguloa kehtetuks tunnistamiseks; saada vajaduse korral ringhäälinguorganisatsioonilt andmeid käesoleva seaduse täitmise ja ringhäälingulubade tingimustest kinnipidamise kohta.",
      "rdfs:label": {
        "@value": "RingHS_Par_42 (redaktsioon 186646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186646",
      "estleg:supersededByVersion": {
        "@id": "estleg:RingHS_Par_42_v831359"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186646",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:RingHS_Map"
      }
    },
