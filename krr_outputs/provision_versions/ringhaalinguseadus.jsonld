      },
      "estleg:versionText": "Kehtetud –",
      "rdfs:label": {
        "@value": "RingHS_Par_36 (redaktsioon 12787649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12787649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12787649",
      "estleg:sourceAct": "Ringhäälinguseadus",
      "estleg:provisionRef": "RingHS § 36",
