    {
      "@id": "estleg:Reg_339863_Par_4_v339863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339863_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Infosüsteemi peetakse ühetasandilise infotehnoloogilise andmekoguna. Infosüsteemi alamsüsteem on majutusteenuse kasutajate infosüsteem. RT I 2024-05-31 1 131052024001 2024-06-03 Infosüsteemi peetakse ühetasandilise infotehnoloogilise andmekoguna. Infosüsteemi alamsüsteem on majutusteenuse kasutajate infosüsteem. 2 (2) Infosüsteemi pidamisel kasutatakse automatiseeritud andmetöötlust ja andmed säilitatakse digitaalsel kujul. Infosüsteemi pidamisel kasutatakse automatiseeritud andmetöötlust ja andmed säilitatakse digitaalsel kujul.",
      "rdfs:label": {
        "@value": "Reg_339863_Par_4 (redaktsioon 339863)",
        "@language": "et"
      },
