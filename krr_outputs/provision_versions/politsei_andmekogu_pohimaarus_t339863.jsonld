      "estleg:provisionRef": "Reg_339863 § 19_21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339863_Map"
      }
    },
    {
      "@id": "estleg:Reg_339863_Par_19_22_v339863",
      "@type": [
        "owl:NamedIndividual",
