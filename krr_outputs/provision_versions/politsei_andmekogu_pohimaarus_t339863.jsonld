    {
      "@id": "estleg:Reg_339863_Par_5_v339863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339863_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Infosüsteemi vastutav töötleja on Politsei- ja Piirivalveamet (edaspidi vastutav töötleja). RT I 2019-03-12 5 112032019005 2019-03-15 Infosüsteemi vastutav töötleja on Politsei- ja Piirivalveamet (edaspidi vastutav töötleja). 2 (2) Infosüsteemi volitatud töötleja on käesoleva määruse §-des 191 ja 192 nimetatud asutus. RT I 2025-04-01 7 101042025007 2025-04-04 Infosüsteemi volitatud töötleja on käesoleva määruse §-des 191 ja 192 nimetatud asutus.",
      "rdfs:label": {
        "@value": "Reg_339863_Par_5 (redaktsioon 339863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339863",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339863",
