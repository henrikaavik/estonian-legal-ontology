      },
      "estleg:versionText": "Andmeandja vastutab tema poolt infosüsteemi kantud andmete õigsuse eest andmete infosüsteemi kandmise ajal. Andmeandja vastutab tema poolt infosüsteemi kantud andmete õigsuse eest andmete infosüsteemi kandmise ajal.",
      "rdfs:label": {
        "@value": "Reg_339863_Par_17 (redaktsioon 339863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339863",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339863",
      "estleg:sourceAct": "Politsei andmekogu põhimäärus",
