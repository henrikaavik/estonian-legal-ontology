    {
      "@id": "estleg:Reg_339863_Par_18_v339863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339863_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui andmeandja või andmete töötleja avastab ebaõiged andmed, võtab ta tarvitusele vajalikud meetmed nende parandamiseks. Kui andmeandja või andmete töötleja avastab ebaõiged andmed, võtab ta tarvitusele vajalikud meetmed nende parandamiseks. 2 (2) Andmesubjektil on õigus nõuda andmete töötlejalt ebaõigete isikuandmete parandamist. Kui andmesubjekti nõudmine on põhjendatud, parandab andmete töötleja andmesubjekti ebaõiged isikuandmed viivitamata. Kui andmesubjekti nõudmine ei ole põhjendatud, keeldub andmete töötleja andmete parandamisest, põhjendades seda kirjalikult. Andmesubjektil on õigus nõuda andmete töötlejalt ebaõigete isikuandmete parandamist. Kui andmesubjekti nõudmine on põhjendatud, parandab andmete töötleja andmesubjekti ebaõiged isikuandmed viivitamata. Kui andmesubjekti nõudmine ei ole põhjendatud, keeldub andmete töötleja andmete parandamisest, põhjendades seda kirjalikult.",
      "rdfs:label": {
        "@value": "Reg_339863_Par_18 (redaktsioon 339863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339863",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339863",
      "estleg:sourceAct": "Politsei andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_339863 § 18",
