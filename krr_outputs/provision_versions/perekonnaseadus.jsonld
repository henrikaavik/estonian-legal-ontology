      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-st 111 tulenev nõue aegub sünnitusele järgneva aasta lõpust alates ühe aasta möödudes, kui aegumistähtaja kulg ei ole peatunud või katkenud.",
      "rdfs:label": {
        "@value": "PKS_Par_112 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_112_v129062014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_112_v129062014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-st 111 tulenev nõue aegub, kui aegumistähtaja kulg ei ole peatunud või katkenud, sünnitusele järgneva aasta lõpust ühe aasta möödudes või, kui ülalpidamiskohustus tekib hiljem, ülalpidamiskohustuse tekkimise aasta lõpust ühe aasta möödudes.",
      "rdfs:label": {
        "@value": "PKS_Par_112 (redaktsioon 129062014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014103",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
