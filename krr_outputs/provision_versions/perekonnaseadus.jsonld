      }
    },
    {
      "@id": "estleg:PKS_Par_63_v1011053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_63"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elatise käesoleva seaduse § -s 60 nimetatud täisealisele isikule mõistab kohus vanemalt välja selle isiku nõudel, lähtudes käesoleva seaduse § -s 61 sätestatust. (2) Kui pärast vanemalt täisealisele isikule elatise väljamõistmist muutus selle isiku või vanema varaline seisund, võib kohus neist ükskõik kumma nõudel elatise suurust muuta või elatise maksmise lõpetada käesoleva seaduse § -s 61 sätestatud alustel.",
      "rdfs:label": {
        "@value": "PKS_Par_63 (redaktsioon 1011053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011053",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_63_v13330603"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1011053",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 63",
      "estleg:partOfAct": {
