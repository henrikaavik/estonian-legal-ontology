      }
    },
    {
      "@id": "estleg:PKS_Par_2_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omavahel ei või abielluda: otsejoones üleneja ja alaneja sugulane; vend ja õde ning poolvend ja poolõde. (2) Käesoleva paragrahvi lõikes 1 sätestatu kehtib ka siis, kui isikute sugulussuhe on ühe isiku lapsendamise tagajärjel lõppenud.",
      "rdfs:label": {
        "@value": "PKS_Par_2 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_2_v106072023007"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_2_v106072023007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omavahel ei või abielluda: otsejoones üleneja ja alaneja sugulane; vennad ja õed ning poolvennad ja poolõed. (2) Käesoleva paragrahvi lõikes 1 sätestatu kehtib ka siis, kui isikute sugulussuhe on ühe isiku lapsendamise tagajärjel lõppenud.",
      "rdfs:label": {
        "@value": "PKS_Par_2 (redaktsioon 106072023007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072023007",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_20_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Oma varalise kohustuse eest vastutab abikaasa oma lahusvaraga ja ühisvara selle osaga, mis kuuluks talle ühisvara jagamisel. (2) Perekonna huvides võetud varalise kohustuse järgi vastutavad abikaasad ühisvaraga ja mõlema abikaasa lahusvaraga. (3) Kui ühe abikaasa kuriteo läbi suurenes abikaasade ühis- või teise abikaasa lahusvara, hüvitatakse kuriteoga tekitatud kahju lisaks käesoleva paragrahvi 1. lõikes nimetatule ka teise abikaasa osa arvel ühisvaras, samuti teise abikaasa lahusvara arvel selle osa ulatuses, mille võrra tema lahusvara kuriteo läbi suurenes.",
      "rdfs:label": {
        "@value": "PKS_Par_20 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_20_v178633"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 20",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_20_v178633",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Oma varalise kohustuse eest vastutab abikaasa oma lahusvaraga ja ühisvara selle osaga, mis kuuluks talle ühisvara jagamisel. (2) Perekonna huvides voetud varalise kohustuse järgi vastutavad abikaasad ühisvaraga ja mõlema abikaasa lahusvaraga. (3) Kui ühe abikaasa kuriteo läbi suurenes abikaasade ühis- või teise abikaasa lahusvara, hüvitatakse kuriteoga tekitatud kahju lisaks käesoleva paragrahvi 1. lõikes nimetatule ka teise abikaasa osa arvel ühisvaras, samuti teise abikaasa lahusvara arvel selle osa ulatuses, mille võrra tema lahusvara kuriteo läbi suurenes.",
      "rdfs:label": {
