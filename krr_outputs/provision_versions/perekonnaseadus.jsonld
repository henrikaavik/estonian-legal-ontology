      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_96_v686631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestkostjaks ei või olla: alaealine; piiratud teovõimega isik; isik, kellelt vanema õigused on ära võetud või kellelt laps on ära võetud vanema õiguste äravõtmiseta; eestkostja või hooldaja kohustuste täitmisest kõrvaldatud isik; isik, kes muul põhjusel ei ole võimeline täitma eestkostja kohustusi.",
      "rdfs:label": {
        "@value": "PKS_Par_96 (redaktsioon 686631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "686631",
