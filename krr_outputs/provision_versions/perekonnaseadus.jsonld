      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Perekonnaseisuaktide koostamise, muutmise, parandamise, taastamise ja tühistamise ning perekonnaseisutunnistuste väljaandmise kord, sealhulgas perekonnaseisuaktide ja -tunnistuste vormid ning perekonnaseisutunnistuste tehniline kirjeldus",
