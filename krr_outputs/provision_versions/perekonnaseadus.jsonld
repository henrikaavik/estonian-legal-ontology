      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Perekonnaseisuaktide koostamise, muutmise, parandamise, taastamise ja tühistamise ning perekonnaseisutunnistuste väljaandmise kord, sealhulgas perekonnaseisuaktide ja -tunnistuste vormid kehtestatakse Vabariigi Valitsuse määrusega.",
      "rdfs:label": {
