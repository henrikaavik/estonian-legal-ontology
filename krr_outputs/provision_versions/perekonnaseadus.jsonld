        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/686631",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_96_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülalpidamist on kohustatud andma täisealised esimese ja teise astme ülenejad ja alanejad sugulased (edaspidi ülalpidamiskohustuslased ).",
      "rdfs:label": {
        "@value": "PKS_Par_96 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_96_v121122010014"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_96_v121122010014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülalpidamist on kohustatud andma täisealised esimese ja teise astme ülenejad ja alanejad sugulased (edaspidi ülalpidamiskohustuslased).",
      "rdfs:label": {
        "@value": "PKS_Par_96 (redaktsioon 121122010014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010014",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_96_v129062014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010014",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_96_v129062014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülalpidamist on kohustatud andma täisealised esimese ja teise astme ülenejad ja alanejad sugulased (edaspidi ülalpidamiskohustuslased). Ülalpidamiskohustust ei mõjuta muudatused hooldusõiguses.",
      "rdfs:label": {
        "@value": "PKS_Par_96 (redaktsioon 129062014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014103",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_96_v128042022004"
      },
      "estleg:versionValidTo": {
        "@value": "2022-05-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014103",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_96_v128042022004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülalpidamist on kohustatud andma täisealised esimese astme ülenejad ja alanejad sugulased (edaspidi ülalpidamiskohustuslased). Ülalpidamiskohustust ei mõjuta muudatused hooldusõiguses. (2) Teise astme ülenejad sugulased on ülalpidamiskohustuslased oma alaealiste alanejate sugulaste suhtes.",
      "rdfs:label": {
        "@value": "PKS_Par_96 (redaktsioon 128042022004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128042022004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128042022004",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_97_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestkostja on lapse seaduslik esindaja. (2) Eestkostja on kohustatud hoolitsema lapse kasvatamise ja ülalpidamise eest.",
      "rdfs:label": {
        "@value": "PKS_Par_97 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_97_v13330603"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 97",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_97_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülalpidamist on õigustatud saama: alaealine laps; laps, kes täisealiseks saanuna jätkab põhi- või keskhariduse omandamist põhikoolis, gümnaasiumis või kutseõppeasutuses, kuid mitte kauem kui 21-aastaseks saamiseni; muu abivajav alaneja või üleneja sugulane, kes ei ole võimeline ennast ise ülal pidama.",
      "rdfs:label": {
        "@value": "PKS_Par_97 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_97_v112032015098"
      },
      "estleg:versionValidTo": {
        "@value": "2015-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 97",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_97_v112032015098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülalpidamist on õigustatud saama: alaealine laps; laps, kes täisealisena omandab põhi-, kesk- või kõrgharidust või õpib kutseõppe tasemeõppes, kuid mitte kauem kui 21-aastaseks saamiseni; muu abivajav alaneja või üleneja sugulane, kes ei ole võimeline ennast ise ülal pidama.",
      "rdfs:label": {
        "@value": "PKS_Par_97 (redaktsioon 112032015098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015098",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015098",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 97",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_98_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestkostja on teovõimetu või piiratud teovõimega isiku seaduslik esindaja. (2) Eestkostja on kohustatud hoolitsema teovõimetu ja tema ülalpidamise eest.",
      "rdfs:label": {
        "@value": "PKS_Par_98 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_98_v178633"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_98_v178633",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestkostja on eestkostetava seaduslik esindaja. (2) Eestkostja on kohustatud hoolitsema eestkostetava ja tema ülalpidamise eest ning lähtuma oma tegevuses eestkostetava huvidest.",
      "rdfs:label": {
        "@value": "PKS_Par_98 (redaktsioon 178633)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178633",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_98_v13330603"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/178633",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_98_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ülalpidamist saama õigustatud isikuid on mitu ja ülalpidamiskohustuslane ei ole võimeline neile kõigile ülalpidamist andma, siis eelistatakse alaealist last teistele lastele, lapsi kaugema astme alanejatele sugulastele, alanejat sugulast ülenejale sugulasele ning ülenejate sugulaste puhul lähema astme sugulast kaugema astme sugulasele. (2) Abikaasa on õigustatud isikute järjestuses võrdsustatud alaealise lapsega ning ta saab ülalpidamist enne täiskasvanud last või abielus olevat alaealist last ja ülejäänud sugulasi.",
      "rdfs:label": {
        "@value": "PKS_Par_98 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_98_v129062014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_98_v129062014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ülalpidamist saama õigustatud isikuid on mitu ja ülalpidamiskohustuslane ei ole võimeline neile kõigile ülalpidamist andma, siis eelistatakse alaealist last teistele lastele, lapsi kaugema astme alanejatele sugulastele, alanejat sugulast ülenejale sugulasele ning ülenejate sugulaste puhul lähema astme sugulast kaugema astme sugulasele. (2) Abikaasa on õigustatud isikute järjestuses võrdsustatud alaealise lapsega ning ta saab ülalpidamist enne täiskasvanud last või abielus olevat alaealist last ja ülejäänud sugulasi. (3) Last hooldav lahutatud abikaasa ja käesoleva seaduse § 111 kohaselt lapse sünni puhust ülalpidamist saama õigustatud vanem asub õigustatud isikute järjestuses alaealise lapse järel ning saab ülalpidamist enne täiskasvanud last ja abielus olevat alaealist last ning ülejäänud sugulasi. (4) Käesoleva seaduse § 73 kohaselt ülalpidamist saama õigustatud lahutatud abikaasa asub õigustatud isikute järjestuses täisealise lapse järel ning saab ülalpidamist enne ülejäänud sugulasi.",
      "rdfs:label": {
        "@value": "PKS_Par_98 (redaktsioon 129062014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014103",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_98_v106072023007"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014103",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_98_v106072023007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ülalpidamist saama õigustatud isikuid on mitu ja ülalpidamiskohustuslane ei ole võimeline neile kõigile ülalpidamist andma, siis eelistatakse alaealist last teistele lastele, lapsi kaugema astme alanejatele sugulastele, alanejat sugulast ülenejale sugulasele ning ülenejate sugulaste puhul lähema astme sugulast kaugema astme sugulasele. (2) Abikaasa on õigustatud isikute järjestuses võrdsustatud alaealise lapsega ning ta saab ülalpidamist enne täiskasvanud last või abielus olevat alaealist last ja ülejäänud sugulasi. (2¹) Registreeritud elukaaslane on kooselulepingu kehtivuse ajal õigustatud isikute järjestuses võrdsustatud alaealise lapsega. Kui kooselulepingus on kokku lepitud, et registreeritud elukaaslasel on õigus saada ülalpidamist pärast kooselulepingu lõppemist, on registreeritud elukaaslasel õigus saada ülalpidamist enne täisealist last või abielus olevat alaealist last ja ülejäänud sugulasi. (3) Last hooldav lahutatud abikaasa ja käesoleva seaduse § 111 kohaselt lapse sünni puhust ülalpidamist saama õigustatud vanem asub õigustatud isikute järjestuses alaealise lapse järel ning saab ülalpidamist enne täiskasvanud last ja abielus olevat alaealist last ning ülejäänud sugulasi. (4) Käesoleva seaduse § 73 kohaselt ülalpidamist saama õigustatud lahutatud abikaasa asub õigustatud isikute järjestuses täisealise lapse järel ning saab ülalpidamist enne ülejäänud sugulasi.",
      "rdfs:label": {
        "@value": "PKS_Par_98 (redaktsioon 106072023007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072023007",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_99_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestkosteasutuse eelneva nõusolekuta ei või eestkostja: võõrandada eestkostetava kinnisasju või koormata seda piiratud asjaõigusega; võõrandada eestkostetava vallasasja, millel on eestkostetava jaoks eriline väärtus; kinkida eestkostetava vallasasja, välja arvatud tavapärased kingitused; pantida eestkostetava vallasasju; võtta eestkostetava nimel laenu ja loobuda võla sissenõudmisest; loobuda eestkostetava nimel pärandi vastuvõtmisest. (2) Käesoleva paragrahvi 1. lõikes nimetatud tehingute tegemiseks ei või piiratud teovõimega isiku eestkostja anda nõusolekut eestkosteasutuse eelneva nõusolekuta. (3) Eestkostja kohta käesoleva paragrahvi 1. ja 2. lõikes sätestatut kohaldatakse ka vanema ja lapse suhtes.",
      "rdfs:label": {
        "@value": "PKS_Par_99 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_99_v13330603"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 99",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_99_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülalpidamise ulatus määratakse kindlaks ülalpidamist saama õigustatud isiku vajadustest ja tema tavalisest elulaadist lähtudes. (2) Ülalpidamise kindlaksmääramisel arvestatakse õigustatud isiku kõiki eluvajadusi, sealhulgas tema võimete ja kalduvuste kohase hariduse ja kutsealase ettevalmistusega seotud kulutusi, alaealise ülalpeetava puhul ka tema kasvatamise kulutusi.",
      "rdfs:label": {
        "@value": "PKS_Par_99 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
