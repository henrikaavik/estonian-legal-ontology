      }
    },
    {
      "@id": "estleg:PKS_Par_140_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus peatab vanema hooldusõiguse, kui vanem on kestvalt võimetu lapse hooldusõigust teostama. (2) Kohus taastab vanema hooldusõiguse, kui on tuvastatud peatamise aluse äralangemine. (3) Hooldusõiguse peatumise ajal ei või vanem hooldusõigust teostada. (4) Kui hooldusõigus kuulub vanematele ühiselt ning ühe vanema hooldusõigus on peatatud, teostab teine vanem hooldusõigust üksinda. Kui vanemale seaduse või kohtulahendi alusel kuuluv ainuhooldusõigus lapse suhtes on peatatud ja peatamise põhjuse äralangemist ei ole alust oodata, annab kohus hooldusõiguse üle teisele vanemale, kui see vastab lapse huvidele.",
      "rdfs:label": {
        "@value": "PKS_Par_140 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_140_v129062014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_140_v129062014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus peatab vanema hooldusõiguse, kui vanem on kestvalt võimetu lapse hooldusõigust teostama. (2) Kohus ennistab vanema hooldusõiguse, kui on tuvastatud hooldusõiguse peatamise aluse äralangemine. (3) Hooldusõiguse peatumise ajal ei või vanem hooldusõigust teostada. (4) Kui hooldusõigus kuulub vanematele ühiselt ning ühe vanema hooldusõigus on peatatud, teostab teine vanem hooldusõigust üksinda. Kui vanemale seaduse või kohtulahendi alusel kuuluv ainuhooldusõigus lapse suhtes on peatatud ja peatamise põhjuse äralangemist ei ole alust oodata, annab kohus hooldusõiguse üle teisele vanemale, kui see vastab lapse huvidele.",
      "rdfs:label": {
        "@value": "PKS_Par_140 (redaktsioon 129062014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014103",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_141_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abielu kestel abikaasale tagastatud või asendatud õigusvastaselt võõrandatud vara või selle vara eest makstav hüvitus (kompensatsioon) on abikaasa lahusvara, kui seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "PKS_Par_141 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_141_v13330603"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 141",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_141_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vanema hooldusõigus lõpeb või peatub, annab ta lapsele tema vara välja ja esitab lapse või tema seadusliku esindaja taotlusel vara valitsemise aruande.",
      "rdfs:label": {
        "@value": "PKS_Par_141 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 141",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_142_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiend Lugeda RT I 1994, 75, 1326 avaldatud perekonnaseaduse § 17 lõikes 3 sõna \"vallaasi\" asemel õigeks sõna \"vallasasi\". Alus: \"Riigi Teataja seaduse\" § 17 lg 3 ja lg 31 punkt 2 ning Riigikogu õiguskomisjoni taotlus 22.03.2007 2-8/184.",
      "rdfs:label": {
        "@value": "PKS_Par_142 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_142_v13249859"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 142",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_142_v13249859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "PKS_Par_142 (redaktsioon 13249859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249859",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_142_v13330603"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249859",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 142",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_142_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vanem võib jätkata lapse isikuhoolduse ja varahooldusega seotud asjaajamist, kuni talle saab teatavaks või peab teatavaks saama tema hooldusõiguse lõppemine. Kolmas isik ei või vanema õigusele tugineda, kui ta tehingu tegemise ajal teadis või pidi teadma hooldusõiguse lõppemisest. (2) Lõiget 1 kohaldatakse ka vanema hooldusõiguse peatamise korral.",
      "rdfs:label": {
        "@value": "PKS_Par_142 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 142",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_143_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lapsel on õigus isiklikult suhelda mõlema vanemaga. Mõlemal vanemal on kohustus ja õigus suhelda lapsega isiklikult. (2) Vanem peab hoiduma tegevusest, mis kahjustab lapse suhet teise vanemaga või raskendab lapse kasvatamist. Sama säte kehtib, kui last hooldab ja kasvatab muu isik. (3) Lapse huvides võib kohus suhtlusõigust või selle kohta tehtud varasemate lahendite täitmist piirata või suhtlusõiguse teostamise või selle kohta tehtud varasemate lahendite täitmise lõpetada. Kohus võib määrata, et laps suhtleb vanemaga või muu isikuga sobiva kolmanda isiku juuresolekul. Kui kolmas isik on valla- või linnavalitsus või eraõiguslik juriidiline isik, määrab valla- või linnavalitsus või juriidiline isik seda ülesannet täitma pädeva füüsilise isiku. (4) Kohus võib keelata kolmandal isikul lapsega suhtlemise või seda piirata. Kohus võib asjassepuutuvale isikule panna kohustuse hoiduda tegevusest, mis kahjustab lapse suhet vanematega või raskendab lapse kasvatamist. (5) Kohus võib käesolevas paragrahvis nimetatud meetmeid rakendada ka omal algatusel.",
      "rdfs:label": {
        "@value": "PKS_Par_143 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_143_v129062014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 143",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_143_v129062014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lapsel on õigus isiklikult suhelda mõlema vanemaga. Mõlemal vanemal on kohustus ja õigus suhelda lapsega isiklikult. (2) Vanem peab hoiduma tegevusest, mis kahjustab lapse suhet teise vanemaga või raskendab lapse kasvatamist. Sama säte kehtib, kui last hooldab ja kasvatab muu isik. (2¹) Vanemate lahuselu korral lepivad vanemad kokku lahuselava vanema ja lapse suhtlemises. Vanemate vaidluse puhul määrab vanema ja lapse suhtlemise korra vanema nõudel kohus. (3) Lapse huvides võib kohus piirata suhtlusõigust või selle kohta tehtud varasemate lahendite täitmist või lõpetada suhtlusõiguse teostamise või selle kohta tehtud varasemate lahendite täitmise. (3¹) Kohus võib määrata, et laps suhtleb vanemaga sobiva kolmanda isiku juuresolekul. Kui kolmas isik on valla- või linnavalitsus või eraõiguslik juriidiline isik, määrab valla- või linnavalitsus või juriidiline isik seda ülesannet täitma pädeva füüsilise isiku. (4) Kohus võib lapse huvides lubada kolmandal isikul lapsega suhelda, keelata tal lapsega suhtlemise või seda piirata. Kohus võib asjassepuutuvale isikule panna kohustuse hoiduda tegevusest, mis kahjustab lapse suhet vanematega või raskendab lapse kasvatamist. (5) Kohus võib käesolevas paragrahvis nimetatud meetmeid rakendada ka omal algatusel.",
      "rdfs:label": {
        "@value": "PKS_Par_143 (redaktsioon 129062014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014103",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 143",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_144_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanemal on õigus nõuda teiselt vanemalt teavet lapse isikuga ja varaga seotud tähtsate asjaolude kohta, kui see ei ole vastuolus lapse huvidega.",
      "rdfs:label": {
        "@value": "PKS_Par_144 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 144",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_145_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ühist hooldusõigust omavad vanemad elavad alaliselt lahus, otsustavad nad lapsega seotud olulisi asju ühiselt. (2) Hooldusõigusega vanemal, kelle juures laps teise vanema nõusolekul või kohtulahendi alusel alaliselt elab, on õigus otsustada lapse igapäevaelu (tavahooldamise) asju ainuisikuliselt. Igapäevaelu asjade otsustamisena tuleb üldjuhul mõista sellise tavaotsustuse tegemist, mis esineb sageli ja mis lapse arengut püsivalt ei mõjuta. (3) Kui laps viibib käesoleva paragrahvi lõikes 2 nimetatud vanema nõusolekul või kohtulahendi alusel teise vanema juures, otsustab lapse tavahooldamise asju see vanem. (4) Hooldusõiguseta vanemal on otsustusõigus, kui laps viibib tema juures teise vanema või muu hooldusõigusega isiku nõusolekul või kohtulahendi alusel. Lapse huvides võib kohus hooldusõiguseta vanema otsustusõigust piirata.",
      "rdfs:label": {
        "@value": "PKS_Par_145 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_145_v129062014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 145",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_145_v129062014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ühist hooldusõigust omavad vanemad elavad alaliselt lahus, otsustavad nad lapsega seotud olulisi asju ühiselt. (2) Hooldusõigusega vanemal, kelle juures laps teise vanema nõusolekul või kohtulahendi alusel alaliselt elab, on õigus otsustada lapse igapäevaelu (tavahooldamise) asju ainuisikuliselt. Igapäevaelu asjade otsustamisena tuleb üldjuhul mõista sellise tavaotsustuse tegemist, mis esineb sageli ja mis lapse arengut püsivalt ei mõjuta. (3) Kui laps viibib käesoleva paragrahvi lõikes 2 nimetatud vanema nõusolekul või kohtulahendi alusel teise vanema juures, otsustab lapse tavahooldamise asju see vanem. (4) Hooldusõiguseta vanemal on käesoleva paragrahvi lõikes 2 nimetatud otsustusõigus, kui laps viibib tema juures teise vanema või muu hooldusõigusega isiku nõusolekul või kohtulahendi alusel. Lapse huvides võib kohus hooldusõiguseta vanema otsustusõigust piirata.",
      "rdfs:label": {
        "@value": "PKS_Par_145 (redaktsioon 129062014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014103",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 145",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_146_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui laps elab pikemat aega kasuperekonnas, siis on last tegelikult hooldaval ja kasvataval isikul (edaspidi kasuvanem ) õigus otsustada lapse tavahooldamise asju ning õigus neis asjades last esindada. (2) Kasuvanemal ei ole sellist õigust, kui hooldusõigusega isik vaidleb sellele vastu või kui kohus on käesoleva paragrahvi lõikest 1 tulenevat otsustusõigust piiranud või selle välistanud. (3) Kui laps viibib kohtulahendi alusel kolmanda isiku juures, võib tema lõikes 1 nimetatud otsustusõigust piirata või välistada ainult kohus.",
      "rdfs:label": {
        "@value": "PKS_Par_146 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_146_v121122010014"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 146",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_146_v121122010014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui laps elab pikemat aega kasuperekonnas, siis on last tegelikult hooldaval ja kasvataval isikul (edaspidi kasuvanem) õigus otsustada lapse tavahooldamise asju ning õigus neis asjades last esindada. (2) Kasuvanemal ei ole sellist õigust, kui hooldusõigusega isik vaidleb sellele vastu või kui kohus on käesoleva paragrahvi lõikest 1 tulenevat otsustusõigust piiranud või selle välistanud. (3) Kui laps viibib kohtulahendi alusel kolmanda isiku juures, võib tema lõikes 1 nimetatud otsustusõigust piirata või välistada ainult kohus.",
      "rdfs:label": {
        "@value": "PKS_Par_146 (redaktsioon 121122010014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010014",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121122010014",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 146",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_147_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lapsendada on lubatud, kui see on lapse huvides vajalik ning on alust arvata, et lapsendaja ja lapse vahel tekib vanema ja lapse suhe. Lapsendajat valides arvestatakse tema isikuomadusi, suhteid lapsendatavaga, varalist seisundit ja võimet täita lapsendamissuhtest tulenevaid kohustusi, samuti võimaluse korral lapse vanemate eeldatavat tahet. Otsustamisel arvestatakse võimaluse korral ka lapse üleskasvatamise järjepidevuse vajadust ning tema rahvuslikku, usulist, kultuurilist ja keelelist päritolu. (2) Lapsendamine ei ole lubatud, kui selle vastu räägivad lapsendaja laste või lapsendatava kaalukad huvid või kui on põhjendatud kahtlus, et lapsendaja lapsed kahjustavad lapsendatava huve. Lapsendamist otsustades varalistest huvidest ei lähtuta. Otsustades tuleb veenduda, et lapsendamise nõusolekuid ei ole antud tasu või muu hüvitise eest. (3) Lapsendamist otsustades hoidutakse võimaluse korral õdede ja vendade lahutamisest. (4) Lapsendada võib ainult alaealist.",
      "rdfs:label": {
        "@value": "PKS_Par_147 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 147",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_148_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vallaline isik võib lapse lapsendada ainult üksinda. (2) Abielus olevad isikud võivad lapse lapsendada ühiselt. Lapse võib lapsendada ka ainult üks abikaasa, kui: ta lapsendab teise abikaasa lapse; teine abikaasa ei saa lapsendada põhjusel, et ta on piiratud teovõimega.",
      "rdfs:label": {
        "@value": "PKS_Par_148 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_148_v106072023007"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 148",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_148_v106072023007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes ei ole abielus ega registreeritud kooselus, võib lapse lapsendada ainult üksinda. (2) Abielus olevad isikud võivad lapse lapsendada ühiselt. Lapse võib lapsendada ka ainult üks abikaasa, kui: ta lapsendab teise abikaasa lapse; teine abikaasa ei saa lapsendada põhjusel, et ta on piiratud teovõimega. (3) Registreeritud elukaaslane võib lapsendada teise registreeritud elukaaslase lapse käesolevas peatükis ja kooseluseaduse §-s 15 sätestatud korras.",
      "rdfs:label": {
        "@value": "PKS_Par_148 (redaktsioon 106072023007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072023007",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 148",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_149_v13330603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lapsendatut ei või lapsendamissuhte kestel lapsendada muu isik kui lapsendaja abikaasa.",
      "rdfs:label": {
        "@value": "PKS_Par_149 (redaktsioon 13330603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13330603",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_149_v106072023007"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13330603",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 149",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_149_v106072023007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lapsendatut ei või lapsendamissuhte kestel lapsendada muu isik kui lapsendaja abikaasa või registreeritud elukaaslane.",
      "rdfs:label": {
        "@value": "PKS_Par_149 (redaktsioon 106072023007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072023007",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 149",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_15_v22303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abikaasa lahusvara on tema omandis enne abiellumist olnud vara, samuti tema poolt abielu kestel kinke või pärimise teel omandatud vara ning vara, mille see abikaasa on omandanud pärast abielusuhete lõppemist. (2) Abielu kestel omandatud isiklikud tarbeesemed on abikaasa lahusvara.",
      "rdfs:label": {
        "@value": "PKS_Par_15 (redaktsioon 22303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22303",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_15_v178633"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22303",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:provisionRef": "PKS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:PKS_Map"
      }
    },
    {
      "@id": "estleg:PKS_Par_15_v178633",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
