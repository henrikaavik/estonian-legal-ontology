    {
      "@id": "estleg:PKS_Par_2_v1011053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abielu sõlmitakse abiellujate ühisel soovil. (2) Abielu ei või sõlmida, kui abielluja ei kinnita oma abiellumissoovi või kui abielluja ei ole abiellumisealine või kui ilmnevad käesoleva seaduse § -s 4 nimetatud asjaolud.",
      "rdfs:label": {
        "@value": "PKS_Par_2 (redaktsioon 1011053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011053",
      "estleg:supersededByVersion": {
