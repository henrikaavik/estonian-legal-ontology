      }
    },
    {
      "@id": "estleg:PKS_Par_103_v130122011022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKS_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus võib kohustatud isiku ülalpidamiskohustuse täitmisest vabastada või täitmist ajaliselt piirata või elatise suurust vähendada, kui kohustuse täitmist on äärmiselt ebaõiglane nõuda, eelkõige kui: ülalpidamist saama õigustatud isiku abivajadus on tekkinud tema enda ebamõistliku käitumise tagajärjel; õigustatud isik on jämedalt rikkunud oma ülalpidamiskohustust ülalpidamiskohustuslase vastu; õigustatud isik on süüdi tahtlikus kuriteos ülalpidamist andma kohustatud isiku või tema lähikondse suhtes. (2) Lõiget 1 ei kohaldata vanema ülalpidamiskohustusele, mis tal on oma alaealise lapse vastu. (3) Kui abivajava isiku nõuet selle paragrahvi alusel piiratakse, ei või ta esitada ülalpidamisnõuet teiste ülalpidamiskohustuslaste vastu.",
      "rdfs:label": {
        "@value": "PKS_Par_103 (redaktsioon 130122011022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011022",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKS_Par_103_v122122021015"
      },
      "estleg:versionValidTo": {
        "@value": "2021-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122011022",
      "estleg:sourceAct": "Perekonnaseadus",
