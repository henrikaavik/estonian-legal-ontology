        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine ja taastamine. Piiranguvööndi kaitse-eesmärk on looduse mitmekesisuse ja maastikuilme säilitamine ja taastamine.",
      "rdfs:label": {
        "@value": "Reg_1031605_Par_14 (redaktsioon 1031605)",
        "@language": "et"
