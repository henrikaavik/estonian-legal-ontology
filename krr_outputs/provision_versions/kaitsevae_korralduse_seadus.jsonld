      }
    },
    {
      "@id": "estleg:KAITSE_2_Par_23_v129052018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_2_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväge juhib ainujuhtimise põhimõttel Kaitseväe juhataja, kes allub valdkonna eest vastutavale ministrile. Valdkonna eest vastutaval ministril ei ole käsuõigust Kaitseväe juhataja üle käesoleva seaduse § 27 mõistes. (2) Kehtetu - (3) Kehtetu - (4) Kehtetu - (5) Kehtetu -",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_23 (redaktsioon 129052018002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129052018002"
    },
    {
      "@id": "estleg:KAITSE_2_Par_24_v12997721",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_2_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe juhataja: juhib kaitseväe tegevust ja korraldab kaitseväe pädevusse kuuluvate ülesannete täitmist; esindab kaitseväge ja annab volitusi kaitseväe esindamiseks väeliikide või struktuuriüksuste ülematele; sõlmib ja lõpetab tegevteenistuslepinguid ning määrab ametikohale ja vabastab ametikohalt kaitseväelasi oma pädevuse piires kaitseväeteenistuse seaduses sätestatud korras; nimetab ametisse ja vabastab ametist kaitseväe ametnikud ning sõlmib, muudab ja lõpetab töölepingud asutuse abiteenistujatega või volitab nimetatud ülesandeid täitma väeliigi või struktuuriüksuse ülema; esitab kaitseministrile kaitseväe eelarve projekti; korraldab kaitseväe raamatupidamist või annab volitusi raamatupidamise korraldamiseks käsutab kaitseväe eelarvelisi vahendeid või annab volitusi eelarveliste vahendite käsutamiseks korraldab kaitseväe valdusesse antud riigivara kasutamist kooskõlas riigivaraseadusega; korraldab riigisaladuse kaitset kaitseväes kooskõlas õigusaktidega; vastutab kaitseväe tegevust korraldavate õigusaktide täpse ja otstarbeka täitmise eest, eelarvevahendite sihipärase kasutamise eest ning annab aru kaitseministrile; inspekteerib ja teostab teenistuslikku järelevalvet kaitseväe struktuuriüksuste ja ametiisikute tegevuse üle; täidab muid õigusaktidest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_24 (redaktsioon 12997721)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12997721",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_2_Par_24_v13276906"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_2_Par_24_v13276906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_2_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe juhataja: juhib kaitseväe tegevust ja korraldab kaitseväe pädevusse kuuluvate ülesannete täitmist; esindab kaitseväge ja annab volitusi kaitseväe esindamiseks; sõlmib ja lõpetab tegevteenistuslepinguid ning määrab ametikohale ja vabastab ametikohalt kaitseväelasi oma pädevuse piires kaitseväeteenistuse seaduses sätestatud korras; nimetab ametisse ja vabastab ametist kaitseväe ametnikud ning sõlmib, muudab ja lõpetab töölepingud asutuse abiteenistujatega või volitab nimetatud ülesandeid täitma väeliigi või struktuuriüksuse ülema; esitab kaitseministrile kaitseväe eelarve projekti; korraldab kaitseväe raamatupidamist või annab volitusi raamatupidamise korraldamiseks käsutab kaitseväe eelarvelisi vahendeid või annab volitusi eelarveliste vahendite käsutamiseks korraldab kaitseväe valdusesse antud riigivara kasutamist kooskõlas riigivaraseadusega; korraldab riigisaladuse kaitset kaitseväes kooskõlas õigusaktidega; vastutab kaitseväe tegevust korraldavate õigusaktide täpse ja otstarbeka täitmise eest, eelarvevahendite sihipärase kasutamise eest ning annab aru kaitseministrile; inspekteerib ja teostab teenistuslikku järelevalvet kaitseväe struktuuriüksuste ja ametiisikute tegevuse üle; täidab muid õigusaktidest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_24 (redaktsioon 13276906)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13276906",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_2_Par_24_v120032013018"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_2_Par_24_v120032013018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_2_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe juhataja: juhib Kaitseväe tegevust ja korraldab Kaitseväe pädevusse kuuluvate ülesannete täitmist; esindab Kaitseväge ja annab volitusi Kaitseväe esindamiseks; võtab isiku tegevteenistusse ja vabastab tegevteenistusest, nimetab ametikohale ja vabastab ametikohalt kaitseväelase oma pädevuse piires kaitseväeteenistuse seaduses sätestatud korras; nimetab ametisse ja vabastab ametist Kaitseväes töötava ametniku ning sõlmib, muudab ja lõpetab töötaja töölepingu või volitab nimetatud ülesannet täitma väeliigi või struktuuriüksuse ülema; esitab kaitseministrile Kaitseväe eelarve projekti; korraldab Kaitseväe raamatupidamist või annab volitusi raamatupidamise korraldamiseks käsutab Kaitseväe eelarvelisi vahendeid või annab volitusi eelarveliste vahendite käsutamiseks korraldab Kaitseväe valdusesse antud riigivara kasutamist kooskõlas riigivaraseadusega; korraldab riigisaladuse kaitset Kaitseväes kooskõlas õigusaktidega; vastutab Kaitseväe tegevust korraldavate õigusaktide täpse ja otstarbeka täitmise eest, eelarvevahendite sihipärase kasutamise eest ning annab aru kaitseministrile; inspekteerib ja teostab teenistuslikku järelevalvet Kaitseväe struktuuriüksuste ja ametiisikute tegevuse üle; kehtestab Kaitseväe tegevust reguleerivad eeskirjad ja korrad, sealhulgas sisekorra; täidab muid õigusaktidest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_24 (redaktsioon 120032013018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120032013018",
      "estleg:supersededByVersion": {
        "@id": "estleg:KAITSE_2_Par_24_v114032014035"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
