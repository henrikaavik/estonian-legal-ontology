      },
      "estleg:versionValidTo": {
        "@value": "2024-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_2_Par_35_2_v121062024014",
      "@type": [
        "owl:NamedIndividual",
