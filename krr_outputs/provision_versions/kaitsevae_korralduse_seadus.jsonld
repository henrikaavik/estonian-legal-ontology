      }
    },
    {
      "@id": "estleg:KAITSE_2_Par_3_v13320756",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_2_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe ülesanded on: riigi sõjaline kaitsmine ja osalemine kollektiivses enesekaitses; valmistumine riigi sõjaliseks kaitseks ja osalemiseks kollektiivses enesekaitses; osalemine rahvusvahelises sõjalises koostöös rahvusvahelise sõjalise koostöö seaduses sätestatud korras; osalemine erakorralise seisukorra ja hädaolukordade lahendamisel ning turvalisuse tagamisel seaduses sätestatud alustel ja korras; lahingumoona kahjutuks tegemine sise- ja territoriaalmeres ning majandusvööndis; demineerimistöö kaitseväe ja Kaitseliidu territooriumil ning harjutusväljadel; muude talle seadusega antud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_3 (redaktsioon 13320756)",
        "@language": "et"
