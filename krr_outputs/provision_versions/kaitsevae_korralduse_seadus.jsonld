        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 3 punktides 41 ja 42 sätestatud ülesannete täitmisel võib Kaitsevägi kasutada abivahendeid päästeseaduse §-s 25 ettenähtud alustel ja korras.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_48_1 (redaktsioon 120032013018)",
        "@language": "et"
