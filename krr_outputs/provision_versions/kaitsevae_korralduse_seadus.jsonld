      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse väejuhatus on Kaitseväe struktuuriüksus, mille ülesanne on Kaitseväele logistilise toetuse ja toetusteenuse osutamine, formeerimisülesande täitmine ning muude õigusaktidest tulenevate ülesannete täitmine.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_20_1 (redaktsioon 123042014004)",
        "@language": "et"
      },
