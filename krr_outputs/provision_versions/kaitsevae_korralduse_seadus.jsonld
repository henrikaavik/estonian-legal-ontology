      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitsevägi on sõjaväeliselt korraldatud valitsusasutus Kaitseministeeriumi valitsemisalas. (2) Kaitsevägi võib oma ülesannete täitmiseks kasutada jõudu seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "KAITSE_2_Par_2 (redaktsioon 12997721)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12997721"
    },
