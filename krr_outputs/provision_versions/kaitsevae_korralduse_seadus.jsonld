        "@value": "KAITSE_2_Par_80 (redaktsioon 13320756)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13320756"
    },
    {
      "@id": "estleg:KAITSE_2_Par_81_v12997721",
