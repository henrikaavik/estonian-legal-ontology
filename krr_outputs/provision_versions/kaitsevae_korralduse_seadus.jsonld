      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangistusseaduse (RT I 2000, 58, 376; 2008, 17, 118) § 85 lõikes 3 asendatakse sõna «garnisoni» sõnaga «väeüksuse».",
