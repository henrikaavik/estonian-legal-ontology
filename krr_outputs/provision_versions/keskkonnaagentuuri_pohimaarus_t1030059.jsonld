    {
      "@id": "estleg:Reg_1030059_Par_2_v1030059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030059_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) KAUR-il on oma eelarve, mille kinnitab, mida muudab ja mille täitmist kontrollib energeetika- ja keskkonnaminister. RT I 2025-06-13 1 113062025001 2025-06-16 KAUR-il on oma eelarve, mille kinnitab, mida muudab ja mille täitmist kontrollib energeetika- ja keskkonnaminister. 2 (2) KAUR-il on väikese riigivapi kujutisega ja oma nimega pitsat. KAUR-il on väikese riigivapi kujutisega ja oma nimega pitsat. 3 (3) KAUR-i dokumendiplankide ja pitsati kasutamise kord määratakse KAUR-i asjaajamiskorras. KAUR-i struktuuriüksustel võivad olla oma nimega pitsat ja dokumendiplangid, kui see on ettenähtud struktuuriüksuse põhimääruses. KAUR-i dokumendiplankide ja pitsati kasutamise kord määratakse KAUR-i asjaajamiskorras. KAUR-i struktuuriüksustel võivad olla oma nimega pitsat ja dokumendiplangid, kui see on ettenähtud struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1030059_Par_2 (redaktsioon 1030059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030059",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030059",
      "estleg:sourceAct": "Keskkonnaagentuuri põhimäärus",
      "estleg:provisionRef": "Reg_1030059 § 2",
