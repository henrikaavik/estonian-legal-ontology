      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus erametsaomanikust ettevõtjale on riigiabi komisjoni määruse (EL) 2022/2472, millega tunnistatakse teatavat liiki abi põllumajandus- ja metsandussektoris ja maapiirkondades Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamisel siseturuga kokkusobivaks (ELT L 327, 21.12.2022, lk 1–81), artikli 45 tähenduses (edaspidi grupierandi määrus). Toetus erametsaomanikust ettevõtjale on riigiabi komisjoni määruse (EL) 2022/2472, millega tunnistatakse teatavat liiki abi põllumajandus- ja metsandussektoris ja maapiirkondades Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamisel siseturuga kokkusobivaks (ELT L 327, 21.12.2022, lk 1–81), artikli 45 tähenduses (edaspidi grupierandi määrus).",
      "rdfs:label": {
        "@value": "Reg_1055606_Par_4 (redaktsioon 1055606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055606",
