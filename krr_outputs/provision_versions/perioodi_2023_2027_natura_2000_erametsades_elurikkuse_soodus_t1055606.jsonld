        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2023. a. Määrus jõustub 1. jaanuaril 2023. a.",
      "rdfs:label": {
        "@value": "Reg_1055606_Par_16 (redaktsioon 1055606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055606",
