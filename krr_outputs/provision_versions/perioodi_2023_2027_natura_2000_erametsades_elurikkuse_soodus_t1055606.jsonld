      "estleg:provisionRef": "Reg_1055606 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055606_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055606_Par_7_7_v1055606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
