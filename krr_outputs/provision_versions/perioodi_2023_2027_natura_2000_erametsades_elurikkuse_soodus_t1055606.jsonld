    {
      "@id": "estleg:Reg_1055606_Par_2_v1055606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055606_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetust antakse looduskaitseliste piirangute järgimise eest Natura 2000 võrgustiku alal (edaspidi Natura 2000) asuval või looduskaitseseaduse § 4 lõike 1 punktis 1 või 4 nimetatud kaitstava loodusobjekti sihtkaitsevööndis asuval või projekteeritaval alal asuval erametsamaal ühe kalendriaasta (edaspidi kohustuseaasta) jooksul. Toetust antakse looduskaitseliste piirangute järgimise eest Natura 2000 võrgustiku alal (edaspidi Natura 2000) asuval või looduskaitseseaduse § 4 lõike 1 punktis 1 või 4 nimetatud kaitstava loodusobjekti sihtkaitsevööndis asuval või projekteeritaval alal asuval erametsamaal ühe kalendriaasta (edaspidi kohustuseaasta) jooksul. 2 (2) Projekteeritavaks alaks selle määruse tähenduses loetakse Natura 2000 ala, mille suhtes on looduskaitseseaduse § 8 lõike 1 alusel esitatud loodusobjekti kaitse alla võtmise ettepanek või on looduskaitseseaduse § 9 lõike 1 alusel algatatud kaitse alla võtmise menetlus. Projekteeritavaks alaks selle määruse tähenduses loetakse Natura 2000 ala, mille suhtes on looduskaitseseaduse § 8 lõike 1 alusel esitatud loodusobjekti kaitse alla võtmise ettepanek või on looduskaitseseaduse § 9 lõike 1 alusel algatatud kaitse alla võtmise menetlus.",
      "rdfs:label": {
        "@value": "Reg_1055606_Par_2 (redaktsioon 1055606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055606",
      "estleg:sourceAct": "Perioodi 2023–2027 Natura 2000 erametsades elurikkuse soodustamise toetus",
      "estleg:provisionRef": "Reg_1055606 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055606_Map_2026"
      }
    },
