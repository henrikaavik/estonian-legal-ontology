      "estleg:provisionRef": "Reg_1055606 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055606_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055606_Par_7_v1055606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055606_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotleja täidab metsamaal, mille kohta ta toetust taotleb, oma põllumajanduslikus tegevuses ja kogu põllumajandusliku majapidamise maal maaeluministri 21. detsembri 2022. a määruse nr 68 „Maa heas põllumajandus- ja keskkonnaseisundis hoidmise nõuded, kohustuslikud majandamisnõuded ning töö- ja tööhõivetingimustega seotud nõuded ja tööandja kohustused“ §-des 2–8 sätestatud nõudeid ning sama määruse lisas 1 „Kohustuslikud majandamisnõuded“ esitatud nõudeid. RT I 2024-12-28 5 128122024005 2025-01-01 Taotleja täidab metsamaal, mille kohta ta toetust taotleb, oma põllumajanduslikus tegevuses ja kogu põllumajandusliku majapidamise maal maaeluministri 21. detsembri 2022. a määruse nr 68 „Maa heas põllumajandus- ja keskkonnaseisundis hoidmise nõuded, kohustuslikud majandamisnõuded ning töö- ja tööhõivetingimustega seotud nõuded ja tööandja kohustused“ §-des 2–8 sätestatud nõudeid ning sama määruse lisas 1 „Kohustuslikud majandamisnõuded“ esitatud nõudeid. 2 (2) Taotleja täidab lõikes 1 nimetatud nõudeid kogu kohustuseaasta jooksul. Taotleja täidab lõikes 1 nimetatud nõudeid kogu kohustuseaasta jooksul. 3 (3) Taotleja on kohustatud esitama andmed kõigi lõikes 1 nimetatud maade kohta. Taotleja on kohustatud esitama andmed kõigi lõikes 1 nimetatud maade kohta.",
      "rdfs:label": {
        "@value": "Reg_1055606_Par_7 (redaktsioon 1055606)",
        "@language": "et"
      },
