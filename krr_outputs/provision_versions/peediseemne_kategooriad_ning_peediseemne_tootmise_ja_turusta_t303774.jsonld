      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Säilitussordi seemne müügipakendi etiketi kinnitab pakendaja, arvestades § 15 lõigetes 1, 3 ja 7 sätestatud nõudeid. Pakendaja lisab etiketil ettenähtud teabele sertifitseeritud säilitussordi seemnepartii numbri. RTL 2010 12 222 13285783 2010-03-22+02:00 Säilitussordi seemne müügipakendi etiketi kinnitab pakendaja, arvestades § 15 lõigetes 1, 3 ja 7 sätestatud nõudeid. Pakendaja lisab etiketil ettenähtud teabele sertifitseeritud säilitussordi seemnepartii numbri.",
      "rdfs:label": {
        "@value": "Reg_303774_Par_15_16 (redaktsioon 303774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303774",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303774",
      "estleg:sourceAct": "Peediseemne kategooriad ning peediseemne tootmise ja turustamise nõuded",
      "estleg:provisionRef": "Reg_303774 § 15_16",
