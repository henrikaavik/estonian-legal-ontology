      "estleg:provisionRef": "Reg_303774 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303774_Map"
      }
    },
    {
      "@id": "estleg:Reg_303774_Par_23_25_v303774",
      "@type": [
