    {
      "@id": "estleg:Reg_1048906_Par_6_v1048906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048906_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskuse ingliskeelne nimetus on IT and Development Centre. Vajaduse korral võib lisada Eesti riigi nime ja kirjutada IT and Development Centre of the Ministry of the Interior of Estonia. RT I 2020-10-30 5 130102020005 2020-11-02 , rakendatakse tagasiulatuvalt alates 01.11.2020 Keskuse ingliskeelne nimetus on IT and Development Centre. Vajaduse korral võib lisada Eesti riigi nime ja kirjutada IT and Development Centre of the Ministry of the Interior of Estonia. , rakendatakse tagasiulatuvalt alates 01.11.2020",
      "rdfs:label": {
        "@value": "Reg_1048906_Par_6 (redaktsioon 1048906)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048906",
