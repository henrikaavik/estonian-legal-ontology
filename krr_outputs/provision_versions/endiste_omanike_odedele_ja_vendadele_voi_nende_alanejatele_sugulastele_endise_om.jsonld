{
  "@context": {
    "estleg": "https://w3id.org/estleg/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_endiste_omanike_odedele_ja_vendadele_voi_nende_alanejatele_sugulastele_endise_om_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Endiste omanike õdedele ja vendadele või nende alanejatele sugulastele endise omaniku maal asuvate endise omaniku hoonete ja rajatiste tagastamise seadus (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Endiste omanike õdedele ja vendadele või nende alanejatele sugulastele endise omaniku maal asuvate endise omaniku hoonete ja rajatiste tagastamise seadus"
    },
    {
      "@id": "estleg:EOHTS_Par_1_v24376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOHTS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui õigusvastaselt võõrandatud maa endine omanik on surnud ja Eesti Vabariigi omandireformi aluste seaduse (RT 1991, nr. 21, art. 257 ja nr. 45, art. 565; 1992, nr. 19, art. 275 ja nr. 33, art. 420) §-s 8 nimetatud pärijaid ei ole ning selle maa tagastamiseks on Eesti Vabariigi maareformi seaduse (RT 1991, nr. 34, art. 426; 1992, nr. 10, art. 145) § 5 1. lõike punkti 2 alusel tähtaegselt esitanud vormikohased avaldused endise omaniku õed ja vennad või nende alanejad sugulased, siis on neil õigus taotleda ka sellel maal asuvate ning maa endisele omanikule kuulunud õigusvastaselt võõrandatud hoonete ja rajatiste tagastamist.",
      "rdfs:label": {
        "@value": "EOHTS_Par_1 (redaktsioon 24376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24376"
    },
    {
      "@id": "estleg:EOHTS_Par_2_v24376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOHTS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 1 nimetatud hoonete ja rajatiste tagastamise avaldused tuleb esitada kohaliku omavalitsuse täitevorganile kolme kuu jooksul käesoleva seaduse väljakuulutamise päevast arvates.",
      "rdfs:label": {
        "@value": "EOHTS_Par_2 (redaktsioon 24376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24376"
    },
    {
      "@id": "estleg:EOHTS_Par_3_v24376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOHTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui käesoleva seaduse §-s 1 nimetatud isik on esitanud avalduse maa kompenseerimiseks või asendamiseks, on tal õigus esitada käesoleva seaduse §-s 2 mainitud avaldust ainult siis, kui ta on maa kompenseerimise või asendamise taotluse asendanud maa tagastamise taotlusega Vabariigi Valitsuse 1991. aasta 28. augusti määrusega nr. 161 kinnitatud „Õigusvastaselt võõrandatud vara tagastamise ja kompenseerimise avalduste esitamise ja läbivaatamise ning tõendite esitamise ja hindamise korra” (RT 1991, nr. 28, art. 335) punktis 30 ettenähtud korras.",
      "rdfs:label": {
        "@value": "EOHTS_Par_3 (redaktsioon 24376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24376"
    },
    {
      "@id": "estleg:EOHTS_Par_4_v24376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOHTS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hooned ja rajatised kuuluvad tagastamisele, kui puuduvad Eesti Vabariigi omandireformi aluste seaduse § 12 3. lõikes sätestatud õigusvastaselt võõrandatud vara mittetagastamise alused.",
      "rdfs:label": {
        "@value": "EOHTS_Par_4 (redaktsioon 24376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24376"
    },
    {
      "@id": "estleg:EOHTS_Par_5_v24376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOHTS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 1 nimetatud avalduste esitamine, läbivaatamine, tõendite esitamine ja hindamine, hoonete ja rajatiste tagastamise otsustamine ning tagastamine toimub vastavalt Eesti Vabariigi omandireformi aluste seadusele ja sellest tulenevatele õigusaktidele, kui käesolevast seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "EOHTS_Par_5 (redaktsioon 24376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24376"
    },
    {
      "@id": "estleg:EOHTS_Par_6_v24376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EOHTS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub väljakuulutamise päevast.",
      "rdfs:label": {
        "@value": "EOHTS_Par_6 (redaktsioon 24376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24376"
    }
  ]
}
