        "@value": "2025-02-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 26. septembri 2022. a käskkirjaga nr 1-2/22/337 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 26. septembri 2022. a käskkirjaga nr 1-2/22/337 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1060523_Par_5 (redaktsioon 1060523)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060523",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060523",
      "estleg:sourceAct": "Paralepa ja Pullapä metsa kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1060523 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060523_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1060523_Par_6_v1060523",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
