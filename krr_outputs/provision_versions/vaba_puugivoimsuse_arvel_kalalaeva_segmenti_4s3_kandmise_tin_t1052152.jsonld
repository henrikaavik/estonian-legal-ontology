      "estleg:sourceAct": "Vaba püügivõimsuse arvel kalalaeva segmenti 4S3 kandmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1052152 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052152_Map"
      }
    },
