      }
    },
    {
      "@id": "estleg:Reg_1047016_Par_5_v1047016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047016_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Otsinguvahendi loa saamiseks esitatakse Muinsuskaitseametile taotlus, milles märgitakse: 1 1) taotleja nimi ja isikukood; 2 2) elukoha aadress ja kontaktandmed; 3 3) taotluse selgelt sõnastatud sisu; 4 4) taotluse esitamise kuupäev ja taotleja allkiri. Otsinguvahendi loa saamiseks esitatakse Muinsuskaitseametile taotlus, milles märgitakse: taotleja nimi ja isikukood; elukoha aadress ja kontaktandmed; taotluse selgelt sõnastatud sisu; taotluse esitamise kuupäev ja taotleja allkiri. 2 (2) Taotlusele lisatakse: 1 1) muinsuskaitseseaduse § 29 lõikes 5 nimetatud täienduskoolituse läbimist tõendava dokumendi koopia; 2 2) andmed riigilõivu tasumise kohta. Taotlusele lisatakse: muinsuskaitseseaduse § 29 lõikes 5 nimetatud täienduskoolituse läbimist tõendava dokumendi koopia; andmed riigilõivu tasumise kohta. 3 (3) Muinsuskaitseamet annab otsinguvahendi loa või keeldub loa andmisest 30 päeva jooksul nõuetekohase taotluse saamisest arvates. Muinsuskaitseamet annab otsinguvahendi loa või keeldub loa andmisest 30 päeva jooksul nõuetekohase taotluse saamisest arvates. 4 (4) Otsinguvahendiloa vorm on toodud käesoleva määruse lisas. Otsinguvahendiloa vorm on toodud käesoleva määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1047016_Par_5 (redaktsioon 1047016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047016",
