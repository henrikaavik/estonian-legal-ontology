      },
      "estleg:versionValidTo": {
        "@value": "2002-06-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_16_v180026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaupade ja teenuste tarbijal on õigus eestikeelsele teabele ja teenindamisele vastavuses tarbijakaitseseadusega (RT I 1994, 2, 13).",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_16 (redaktsioon 180026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "180026",
      "estleg:supersededByVersion": {
