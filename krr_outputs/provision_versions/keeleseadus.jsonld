      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_18_v12796913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_18 (redaktsioon 12796913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12796913",
