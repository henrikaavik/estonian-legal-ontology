      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_3_v118032011001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti riigikeel on eesti keel. (2) Eesti viipekeel on iseseisev keel ning viibeldud eesti keel on eesti keele esinemiskuju. (3) Riik toetab eesti keele piirkondlike erikujude (edaspidi murdekeel) kaitset, kasutamist ja arendamist.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_3 (redaktsioon 118032011001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011001"
    },
    {
