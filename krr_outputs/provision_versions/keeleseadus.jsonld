      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti riigikeel on eesti keel. (2) Eesti keele ametliku kasutuse aluseks käesoleva seaduse mõttes on eesti kirjakeele norm Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_1 (redaktsioon 22321)",
        "@language": "et"
      },
