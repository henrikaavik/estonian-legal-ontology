    },
    {
      "@id": "estleg:Keeleseadus_Par_1_v22321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_1"
