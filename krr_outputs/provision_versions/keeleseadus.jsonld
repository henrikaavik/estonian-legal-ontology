      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_16_v12796913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaupade ja teenuste tarbijal on õigus eestikeelsele teabele ja teenindamisele vastavuses tarbijakaitseseadusega.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_16 (redaktsioon 12796913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12796913",
      "estleg:supersededByVersion": {
        "@id": "estleg:Keeleseadus_Par_16_v118032011001"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_16_v118032011001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikku kohta paigaldatud viidad, sildid, ettevõtte liiginimetus ja välireklaam, sealhulgas poliitilise agitatsiooni eesmärgil paigaldatud välireklaam, ning juriidilise isiku teadaanded peavad olema eestikeelsed. (2) Avalikku kohta paigaldatud viitadele, siltidele, ettevõtte liiginimetusele ja välireklaamile võib lisada teksti tõlke võõrkeelde, kusjuures eestikeelne tekst peab olema esikohal ega tohi olla halvemini vaadeldav kui võõrkeelne tekst. (3) Kaubamärgi kasutamisel isiku tegevuskoha tähisena või välireklaamis tuleb kaubamärgi võõrkeelne osa, mis sisaldab olulist teavet tegevuskoha, pakutava kauba või teenuse kohta, esitada ka eestikeelsena, kahjustamata seejuures kaubamärgi eristusvõimet ja kohaldamata käesoleva paragrahvi lõiget 2. Nimetatud teabe võib esitada ka tegevuskoha sissepääsu juures. (4) Kui Eestis registreeritud asutusel, äriühingul, mittetulundusühingul, sihtasutusel või füüsilisest isikust ettevõtjal on avalikkusele suunatud võõrkeelne veebileht, peab see sisaldama vähemalt kokkuvõtvat eestikeelset teavet tema tegevusvaldkonna või pakutavate kaupade või teenuste kohta. (5) Avalikel üritustel peab korraldaja tagama olulise võõrkeelse teabe tõlke eesti keelde.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_16 (redaktsioon 118032011001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011001"
    },
    {
      "@id": "estleg:Keeleseadus_Par_17_v22321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis registreeritud asutuste, äriühingute ja mittetulundusühingute ja sihtasutuste aruandlus toimub eesti keeles seadustega ettenähtud korras.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_17 (redaktsioon 22321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22321",
      "estleg:supersededByVersion": {
        "@id": "estleg:Keeleseadus_Par_17_v118032011001"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_17_v118032011001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaupade ja teenuste tarbijal on õigus eestikeelsele teabele ja teenindamisele tarbijakaitseseaduse alusel. (2) Isikul, kes ei ole tarbija tarbijakaitseseaduse § 2 punkti 1 tähenduses, on õigus saada kauplejalt kauba või teenuse omaduste ja kasutamistingimuste kohta eestikeelset teavet.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_17 (redaktsioon 118032011001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118032011001",
      "estleg:supersededByVersion": {
        "@id": "estleg:Keeleseadus_Par_17_v131122015022"
      },
      "estleg:versionValidTo": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Keeleseadus_Par_17_v131122015022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaupade ja teenuste tarbijal on õigus eestikeelsele teabele ja teenindamisele tarbijakaitseseaduse alusel. (2) Isikul, kes ei ole tarbija tarbijakaitseseaduse § 2 lõike 1 punkti 1 tähenduses, on õigus saada kauplejalt kauba või teenuse omaduste ja kasutamistingimuste kohta eestikeelset teavet.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_17 (redaktsioon 131122015022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015022"
    },
    {
      "@id": "estleg:Keeleseadus_Par_18_v22321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Keeleseadus_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võõrkeelte kasutamine informatsiooni edastamiseks teenuste ja kaupade tarbijatele ning tööalases suhtlemises toimub Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "Keeleseadus_Par_18 (redaktsioon 22321)",
        "@language": "et"
      },
