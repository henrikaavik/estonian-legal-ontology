    {
      "@id": "estleg:Reg_305570_Par_2_v305570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305570_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paljundusmaterjali mikropaljundamine (edaspidi mikropaljundamine) on paljundusmaterjali ja seemnekartuli taimede (edaspidi kartulitaimed) tootmine koekultuurmeetodil kiiresti suure hulga paljundusmaterjali ja kartulitaimede saamiseks. RT I 2019-03-26 1 126032019001 2019-04-01 Paljundusmaterjali mikropaljundamine (edaspidi mikropaljundamine) on paljundusmaterjali ja seemnekartuli taimede (edaspidi kartulitaimed) tootmine koekultuurmeetodil kiiresti suure hulga paljundusmaterjali ja kartulitaimede saamiseks. 2 (2) Koekultuurmeetodil tootmine on lähtepaljundusmaterjali (edaspidi lähtematerjal) saamiseks kasutatavast taimest (edaspidi emataim) eraldatud organite, koelõikude, rakkude või rakuosade kasvatamine katseklaasis steriilsetel söötmetel. RT I 2015-07-03 19 103072015019 2015-07-06 Koekultuurmeetodil tootmine on lähtepaljundusmaterjali (edaspidi lähtematerjal) saamiseks kasutatavast taimest (edaspidi emataim) eraldatud organite, koelõikude, rakkude või rakuosade kasvatamine katseklaasis steriilsetel söötmetel. 2 (2¹) Emataimeks on § 4 lõikes 3 sätestatud nõuete kohane taim, millest võetakse lähtematerjali uute taimede paljundamiseks ja mis on vastavalt tähistatud. RT I 2015-07-03 19 103072015019 2015-07-06 Emataimeks on § 4 lõikes 3 sätestatud nõuete kohane taim, millest võetakse lähtematerjali uute taimede paljundamiseks ja mis on vastavalt tähistatud. 3 (3) Mikrotaimed on paljundusmaterjal ja kartulitaimed, mis on toodetud ja mida kasvatatakse ning säilitatakse koekultuurmeetodil. Mikrotaimed on paljundusmaterjal ja kartulitaimed, mis on toodetud ja mida kasvatatakse ning säilitatakse koekultuurmeetodil. 4 (4) Mikropaljundatud paljundusmaterjal ja kartulitaimed on mikrotaimed, ning mis on katseklaasist välja istutatud ja kohandatud väliskeskkonna tingimustega. RTL 2007 45 771 12833562 2007-06-04 Mikropaljundatud paljundusmaterjal ja kartulitaimed on mikrotaimed, ning mis on katseklaasist välja istutatud ja kohandatud väliskeskkonna tingimustega.",
      "rdfs:label": {
        "@value": "Reg_305570_Par_2 (redaktsioon 305570)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305570",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305570",
      "estleg:sourceAct": "Paljundusmaterjali mikropaljundamise ja laboratooriumi nõuded",
      "estleg:provisionRef": "Reg_305570 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305570_Map"
      }
