      }
    },
    {
      "@id": "estleg:Reg_305570_Par_8_v305570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305570_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mikropaljundamiseks kasutatavas laboratooriumis peab olema: 1 1) steriilsete tingimustega ning vajalike seadmete ja töövahenditega varustatud ruum mikropaljundamise lähtematerjali paljundamiseks; RTL 2007 45 771 12833562 2007-06-04 2 2) reguleeritava temperatuuriga ning valgusriiulitega varustatud ruum mikrotaimede kasvatamiseks ja säilitamiseks. Mikropaljundamiseks kasutatavas laboratooriumis peab olema: steriilsete tingimustega ning vajalike seadmete ja töövahenditega varustatud ruum mikropaljundamise lähtematerjali paljundamiseks; reguleeritava temperatuuriga ning valgusriiulitega varustatud ruum mikrotaimede kasvatamiseks ja säilitamiseks.",
      "rdfs:label": {
        "@value": "Reg_305570_Par_8 (redaktsioon 305570)",
