    {
      "@id": "estleg:Reg_1063162_Par_12_v1063162",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1063162_Par_12"
