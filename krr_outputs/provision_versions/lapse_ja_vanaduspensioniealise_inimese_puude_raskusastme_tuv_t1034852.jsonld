    {
      "@id": "estleg:Reg_1034852_Par_2_v1034852",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034852_Par_2"
