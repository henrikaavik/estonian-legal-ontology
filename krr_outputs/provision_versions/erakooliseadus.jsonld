      }
    },
    {
      "@id": "estleg:EraKS_Par_10_v784137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi õppeasutuste õppetegevus ning välisriigi õppeasutuste ja nende filiaalide asutamine on Eesti Vabariigis lubatud vastavasisuliste riikidevaheliste kokkulepete alusel. (2) Välisriigi õppeasutused ja nende filiaalid registreeritakse Haridus- ja Teadusministeeriumis käesolevas seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "EraKS_Par_10 (redaktsioon 784137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "784137",
      "estleg:supersededByVersion": {
