      "estleg:versionRedactionId": "108112010011"
    },
    {
      "@id": "estleg:EraKS_Par_39_v13340306",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolieelsele lasteasutusele, põhikoolile ja gümnaasiumile väljastatud tähtajalised koolitusload kehtivad koolitusloas määratud tähtaja lõppemiseni. Käesoleva seaduse jõustumise hetkel tähtajalise koolitusloa alusel tegutsenud erakoolidele, kes koolitusloa kehtivuse lõppemisel soovivad tegevust jätkata ja esitavad taotluse uue koolitusloa väljastamiseks, väljastatakse tähtajaline koolitusluba vastavalt § 5 lõikele 21 samadel tingimustel nagu koolitusloa esmakordsel väljastamisel.",
      "rdfs:label": {
        "@value": "EraKS_Par_39 (redaktsioon 13340306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13340306",
