      }
    },
    {
      "@id": "estleg:EraKS_Par_21_v12851802",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu on erakooli kollegiaalne otsustuskogu, mille liikmete määramise, tagasikutsumise korra ja volituste kestuse sätestab erakooli põhikiri. (2) Nõukogusse kuuluvad: direktor; pedagoogide esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; koolieelse lasteasutuse, lasteaed-algkooli, lasteaed-põhikooli, algkooli ja põhikooli puhul lastevanemate esindajad, kes moodustavad nõukogu koosseisust vähemalt ühe viiendiku; gümnaasiumi, kutseõppeasutuse, kõrgkooli ja ülikooli puhul õpilaste esindajad, kes moodustavad nõukogu koosseisust vähemalt ühe viiendiku; erakooli pidaja esindajad; teised erakooli põhikirjas ettenähtud isikud. (3) Erakooli nõukogu: esitab erakooli pidajale kinnitamiseks erakooli põhikirja muutmisettepanekud; kuulab ära direktori iga-aastase erakooli arengukava täitmise ülevaate; kuulab ära direktori ülevaate erakooli eelarve, erakooli pidaja majandusaasta aruande ja vahearuannete kohta; annab seisukoha teistes küsimustes, mis käesoleva seaduse ja erakooli põhikirja alusel kuuluvad tema pädevusse. (4) Nõukogu kohta sätestatut ei kohaldata täiskasvanute koolitusasutuse ning huvikooli suhtes.",
      "rdfs:label": {
        "@value": "EraKS_Par_21 (redaktsioon 12851802)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12851802",
      "estleg:supersededByVersion": {
        "@id": "estleg:EraKS_Par_21_v13001161"
      },
      "estleg:versionValidTo": {
        "@value": "2008-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EraKS_Par_21_v13001161",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu on erakooli kollegiaalne otsustuskogu, mille liikmete määramise, tagasikutsumise korra ja volituste kestuse sätestab erakooli põhikiri. (2) Nõukogusse kuuluvad: direktor; pedagoogide esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; koolieelse lasteasutuse, lasteaed-algkooli, lasteaed-põhikooli, algkooli ja põhikooli puhul lastevanemate esindajad, kes moodustavad nõukogu koosseisust vähemalt ühe viiendiku; gümnaasiumi, kutseõppeasutuse, kõrgkooli ja ülikooli puhul õpilaste esindajad, kes moodustavad nõukogu koosseisust vähemalt ühe viiendiku; erakooli pidaja esindajad; teised erakooli põhikirjas ettenähtud isikud. (3) Erakooli nõukogu: esitab erakooli pidajale kinnitamiseks erakooli põhikirja muutmisettepanekud; kiidab heaks ühisõppekava enne selle kinnitamist erakooli pidaja poolt ja kiidab heaks ühisõppekava koostöölepingu sõlmimise; kuulab ära direktori iga-aastase erakooli arengukava täitmise ülevaate; kuulab ära direktori ülevaate erakooli eelarve, erakooli pidaja majandusaasta aruande ja vahearuannete kohta; annab seisukoha teistes küsimustes, mis käesoleva seaduse ja erakooli põhikirja alusel kuuluvad tema pädevusse. (4) Nõukogu kohta sätestatut ei kohaldata täiskasvanute koolitusasutuse ning huvikooli suhtes.",
      "rdfs:label": {
        "@value": "EraKS_Par_21 (redaktsioon 13001161)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13001161",
      "estleg:supersededByVersion": {
        "@id": "estleg:EraKS_Par_21_v13340306"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EraKS_Par_21_v13340306",
      "@type": [
        "owl:NamedIndividual",
