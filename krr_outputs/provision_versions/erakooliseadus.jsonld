    {
      "@id": "estleg:EraKS_Par_32_v108112010011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
