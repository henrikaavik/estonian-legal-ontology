      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erakool loetakse asutatuks tema kandmisest Haridus- ja Teadusministeeriumi õppeasutuste registrisse. [Paragrahvi 4 sõnastus alates 5. 07. 2004]",
      "rdfs:label": {
