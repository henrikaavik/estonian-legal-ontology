      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EraKS_Par_21_v111072013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
