      }
    },
    {
      "@id": "estleg:EraKS_Par_21_v747750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu on erakooli kollegiaalne otsustuskogu, mille liikmete määramise, tagasikutsumise korra ja volituste kestuse sätestab erakooli põhikiri. (2) Nõukogusse kuuluvad: direktor; pedagoogide esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; koolieelse lasteasutuse, lasteaed-algkooli, lasteaed-põhikooli, algkooli, põhikooli ja huvialakooli puhul lapsevanemate esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; gümnaasiumi, kutseõppeasutuse, kõrgkooli, ülikooli ja täiskasvanute koolitusasutuse puhul õpilaste esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; erakooli pidaja esindajad; teised erakooli põhikirjas ettenähtud isikud.",
      "rdfs:label": {
        "@value": "EraKS_Par_21 (redaktsioon 747750)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "747750",
      "estleg:supersededByVersion": {
        "@id": "estleg:EraKS_Par_21_v754356"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EraKS_Par_21_v754356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EraKS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu on erakooli kollegiaalne otsustuskogu, mille liikmete määramise, tagasikutsumise korra ja volituste kestuse sätestab erakooli põhikiri. (2) Nõukogusse kuuluvad: direktor; pedagoogide esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; koolieelse lasteasutuse, lasteaed-algkooli, lasteaed-põhikooli, algkooli, põhikooli ja huvialakooli puhul lapsevanemate esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; gümnaasiumi, kutseõppeasutuse, kõrgkooli, ülikooli ja täiskasvanute koolitusasutuse puhul õpilaste esindajad, kes moodustavad vähemalt 1/5 nõukogu koosseisust; erakooli pidaja esindajad; teised erakooli põhikirjas ettenähtud isikud. [Lõige 3 jõustub 5. 07. 2004] (3) Erakooli nõukogu: esitab erakooli pidajale kinnitamiseks erakooli põhikirja muutmisettepanekud; kuulab ära direktori iga-aastase erakooli arengukava täitmise ülevaate; kuulab ära direktori ülevaate erakooli eelarve, erakooli pidaja majandusaasta aruande ja vahearuannete kohta; annab seisukoha teistes küsimustes, mis käesoleva seaduse ja erakooli põhikirja alusel kuuluvad tema pädevusse. [Lõige 4 jõustub 5. 07. 2004] (4) Nõukogu kohta sätestatut ei kohaldata täiskasvanute koolitusasutuse ning huvialakooli suhtes.",
      "rdfs:label": {
        "@value": "EraKS_Par_21 (redaktsioon 754356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "754356",
      "estleg:supersededByVersion": {
        "@id": "estleg:EraKS_Par_21_v784137"
      },
      "estleg:versionValidTo": {
        "@value": "2004-08-31",
        "@type": "xsd:date"
      }
    },
