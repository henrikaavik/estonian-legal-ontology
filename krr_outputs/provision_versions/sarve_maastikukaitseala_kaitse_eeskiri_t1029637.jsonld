      }
    },
    {
      "@id": "estleg:Reg_1029637_Par_14_v1029637",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029637_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine ning poollooduslike koosluste kaitse. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine ning poollooduslike koosluste kaitse.",
      "rdfs:label": {
        "@value": "Reg_1029637_Par_14 (redaktsioon 1029637)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029637",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029637",
      "estleg:sourceAct": "Sarve maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1029637 § 14",
      "estleg:partOfAct": {
