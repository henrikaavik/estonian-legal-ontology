      "estleg:provisionRef": "Reg_1029637 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029637_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029637_Par_3_v1029637",
