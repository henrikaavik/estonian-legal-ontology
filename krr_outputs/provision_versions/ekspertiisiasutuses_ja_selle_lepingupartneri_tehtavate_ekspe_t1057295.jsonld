      }
    },
    {
      "@id": "estleg:Reg_1057295_Par_10_v1057295",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057295_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infotehnoloogiaekspertiisi hind kujuneb üks koht pärast koma ümardatavates terabaitides (TB) arvutatava andmemahu kindlaksmääratud hinna korrutamisel ekspertiisiülesandest tuleneva andmemahuga järgmiselt: 1 1) infotehnoloogiaekspertiis (minimaalselt 1 TB) – 930 eurot; 2 2) alaealise seksuaalse väärkohtlemisega seonduv infotehnoloogiaekspertiis (minimaalselt 1 TB) – 930 eurot. Infotehnoloogiaekspertiisi hind kujuneb üks koht pärast koma ümardatavates terabaitides (TB) arvutatava andmemahu kindlaksmääratud hinna korrutamisel ekspertiisiülesandest tuleneva andmemahuga järgmiselt: infotehnoloogiaekspertiis (minimaalselt 1 TB) – 930 eurot; alaealise seksuaalse väärkohtlemisega seonduv infotehnoloogiaekspertiis (minimaalselt 1 TB) – 930 eurot.",
      "rdfs:label": {
        "@value": "Reg_1057295_Par_10 (redaktsioon 1057295)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057295",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057295",
      "estleg:sourceAct": "Ekspertiisiasutuses ja selle lepingupartneri tehtavate ekspertiiside ja uuringute hinnad",
      "estleg:provisionRef": "Reg_1057295 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057295_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057295_Par_11_v1057295",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057295_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kujutiseekspertiisi hind ei sõltu ekspertiisiülesandest ja on kindlaks määratud järgmiselt: 1 1) kujutiseekspertiis – 930 eurot; 2 2) näoekspertiis 930 eurot. Kujutiseekspertiisi hind ei sõltu ekspertiisiülesandest ja on kindlaks määratud järgmiselt: kujutiseekspertiis – 930 eurot; näoekspertiis 930 eurot.",
      "rdfs:label": {
        "@value": "Reg_1057295_Par_11 (redaktsioon 1057295)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057295",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057295",
      "estleg:sourceAct": "Ekspertiisiasutuses ja selle lepingupartneri tehtavate ekspertiiside ja uuringute hinnad",
      "estleg:provisionRef": "Reg_1057295 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057295_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057295_Par_12_v1057295",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057295_Par_12"
