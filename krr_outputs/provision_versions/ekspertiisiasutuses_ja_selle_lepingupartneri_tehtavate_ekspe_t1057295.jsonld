      "estleg:versionValidFrom": {
        "@value": "2023-09-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lõhkeseadeldise-, plahvatuse- ja tulekahjuekspertiisi hind ei sõltu ekspertiisiülesandest ja on kindlaks määratud järgmiselt: 1 1) lõhkeseadeldise- ja plahvatuseekspertiis – 688 eurot; 2 2) tulekahjuekspertiis – 688 eurot. Lõhkeseadeldise-, plahvatuse- ja tulekahjuekspertiisi hind ei sõltu ekspertiisiülesandest ja on kindlaks määratud järgmiselt: lõhkeseadeldise- ja plahvatuseekspertiis – 688 eurot; tulekahjuekspertiis – 688 eurot.",
      "rdfs:label": {
        "@value": "Reg_1057295_Par_12 (redaktsioon 1057295)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057295",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057295",
      "estleg:sourceAct": "Ekspertiisiasutuses ja selle lepingupartneri tehtavate ekspertiiside ja uuringute hinnad",
      "estleg:provisionRef": "Reg_1057295 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057295_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057295_Par_13_v1057295",
      "@type": [
        "owl:NamedIndividual",
