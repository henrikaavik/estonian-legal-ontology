    {
      "@id": "estleg:Reg_1032938_Par_6_v1032938",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032938_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametil on väikese riigivapi kujutise ja ameti nimetusega pitsat. Ametil on väikese riigivapi kujutise ja ameti nimetusega pitsat. 2 (2) Ametil on registreeritud lipp ja embleem. Ametil on registreeritud lipp ja embleem. 3 (3) Kehtetu - RT I 2025-12-09 12 109122025012 2025-12-12 Kehtetu - 4 (4) Ametil on teenetemärgid, mida antakse välja peadirektori kinnitatud statuudi alusel. Ametil on teenetemärgid, mida antakse välja peadirektori kinnitatud statuudi alusel.",
      "rdfs:label": {
        "@value": "Reg_1032938_Par_6 (redaktsioon 1032938)",
        "@language": "et"
      },
