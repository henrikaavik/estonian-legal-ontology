    {
      "@id": "estleg:Reg_1032938_Par_1_v1032938",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032938_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Patendiamet (edaspidi amet) on intellektuaalse omandi õiguskaitse valdkonnas täidesaatvat riigivõimu teostav ja Vabariigi Valitsuse poliitikat ellu viiv Justiits- ja Digiministeeriumi (edaspidi ministeerium) valitsemisalas tegutsev valitsusasutus. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Patendiamet (edaspidi amet) on intellektuaalse omandi õiguskaitse valdkonnas täidesaatvat riigivõimu teostav ja Vabariigi Valitsuse poliitikat ellu viiv Justiits- ja Digiministeeriumi (edaspidi ministeerium) valitsemisalas tegutsev valitsusasutus. , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Ametil on juhtimisfunktsioon seaduses ettenähtud alustel ja ulatuses. Ametil on juhtimisfunktsioon seaduses ettenähtud alustel ja ulatuses.",
      "rdfs:label": {
        "@value": "Reg_1032938_Par_1 (redaktsioon 1032938)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032938",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032938",
      "estleg:sourceAct": "Patendiameti põhimäärus",
      "estleg:provisionRef": "Reg_1032938 § 1",
