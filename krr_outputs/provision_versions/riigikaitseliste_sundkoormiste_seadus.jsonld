      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_37_v13125056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veokohustuse täitmise ajal säilitab tööandja veokohustuse saanud töötajale keskmise töötasu töölepingu seaduse § 29 lõike 8 alusel kehtestatud korras. (2) Veokohustuse otsustamiseks pädev organ hüvitab tööandjale lõikes 1 nimetatud tasu.",
      "rdfs:label": {
        "@value": "RKSKS_Par_37 (redaktsioon 13125056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13125056",
