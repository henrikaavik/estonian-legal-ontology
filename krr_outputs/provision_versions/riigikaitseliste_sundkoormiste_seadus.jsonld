    },
    {
      "@id": "estleg:RKSKS_Par_9_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus: kinnitab kaitseministri ettepanekul riigikaitseliste sundkoormiste koondkava (edaspidi sundkoormiste koondkava); otsustab vara sundkasutusele võtmise käesoleva seaduse §-de 28 ja 29 järgi; suunab ja koordineerib ministeeriumide, maavanemate ning muude riigikaitselisi ülesandeid täitvate organite tegevust sundkoormiste korraldamisel koostöös valla- ja linnavalitsustega; kehtestab asutuste, ettevõtete ja isikute nimekirjad, kelle sõidukid, ujuvvahendid, õhusõidukid ja muu vara ei kuulu või kuuluvad piiratud hulgal sõjaseisukorra ajal sundvõõrandamisele või sundkasutusele võtmisele; kehtestab sundkoormiste rakendamiseks vajalikud juhendid ja dokumentide vormid; otsustab muid sundkoormistega seotud küsimusi, mis käesoleva seadusega ei ole antud teiste organite pädevusse.",
      "rdfs:label": {
        "@value": "RKSKS_Par_9 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_9_v255997"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
