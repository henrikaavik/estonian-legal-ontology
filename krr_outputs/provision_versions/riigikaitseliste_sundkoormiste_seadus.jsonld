      "estleg:provisionRef": "RKSKS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_1_v13009778",
      "@type": [
