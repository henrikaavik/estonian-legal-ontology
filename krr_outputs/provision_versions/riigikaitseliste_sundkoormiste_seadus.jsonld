      }
    },
    {
      "@id": "estleg:RKSKS_Par_36_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veokohustus peab arvestama sõiduki, ujuvvahendi või õhusõiduki otstarvet ja tehnilisi tingimusi. (2) Sõiduki, ujuvvahendi või õhusõiduki tehniline seisund peab vastama kehtivatele nõuetele sõitjate ja veoste vedudeks. (3) Juhile või meeskonnale antakse kaitseväe normide järgi toiduaineid ning nende sõidukile, ujuvvahendile või õhusõidukile võidakse anda vajalikke aineid ja materjale tasuta.",
      "rdfs:label": {
        "@value": "RKSKS_Par_36 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
