      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_8_v255997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule sundkoormisega tekitatud kahju hüvitatakse seadusega sätestatud korras. (1¹) Isikule rahuajal rakendatud sundkoormisega tekitatud kahju hüvitatakse riigivastutuse seaduse (RT I 2001, 47, 260; 2002, 62, 377) alusel. (2) Sundkoormisega tekitatud kahjuna ei käsitata vara hävimist, riknemist või vara väärtuse vähenemist sõjategevuse läbi. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "RKSKS_Par_8 (redaktsioon 255997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "255997",
      "estleg:supersededByVersion": {
