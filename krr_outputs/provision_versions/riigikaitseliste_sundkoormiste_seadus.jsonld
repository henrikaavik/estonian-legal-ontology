      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/255997",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_8_v13009778",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule sundkoormisega tekitatud kahju hüvitatakse seadusega sätestatud korras. (1¹) Isikule rahuajal rakendatud sundkoormisega tekitatud kahju hüvitatakse riigivastutuse seaduse alusel. (2) Sundkoormisega tekitatud kahjuna ei käsitata vara hävimist, riknemist või vara väärtuse vähenemist sõjategevuse läbi. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "RKSKS_Par_8 (redaktsioon 13009778)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13009778",
