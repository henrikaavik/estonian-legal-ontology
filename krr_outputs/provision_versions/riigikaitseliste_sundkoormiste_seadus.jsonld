        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_6_v116062016012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiku osalise või puuduva töövõime tuvastamise või surma korral, kui see oli tingitud sundkoormise täitmisest, makstakse hüvist või pensioni vastavalt seadusele.",
      "rdfs:label": {
        "@value": "RKSKS_Par_6 (redaktsioon 116062016012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116062016012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/116062016012",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_7_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes leiab, et sundkoormise määramisega on tema õigusi rikutud, võib pöörduda sundkoormise määranud organi või kohtu poole sundkoormise otsuse vaidlustamiseks. (2) Sundkoormise määramise otsuse vaidlustamine ei peata nimetatud otsuse täitmist sõjaseisukorra ajal.",
      "rdfs:label": {
        "@value": "RKSKS_Par_7 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
