      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiku töövõime kaotuse või surma korral, kui see oli tingitud sundkoormise täitmisest, makstakse hüvist või pensioni vastavalt seadusele.",
      "rdfs:label": {
        "@value": "RKSKS_Par_6 (redaktsioon 22323)",
