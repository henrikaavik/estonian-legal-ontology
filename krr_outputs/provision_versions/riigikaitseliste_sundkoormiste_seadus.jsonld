    {
      "@id": "estleg:RKSKS_Par_8_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule sundkoormisega tekitatud kahju hüvitatakse seadusega sätestatud korras. (2) Sundkoormisega tekitatud kahjuna ei käsitata vara hävimist, riknemist või vara väärtuse vähenemist sõjategevuse läbi. (3) Valla- ja linnavalitsustele käesoleva seaduse alusel pandud kohustuste täitmisega seotud kulud kaetakse riigieelarvest.",
      "rdfs:label": {
        "@value": "RKSKS_Par_8 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
