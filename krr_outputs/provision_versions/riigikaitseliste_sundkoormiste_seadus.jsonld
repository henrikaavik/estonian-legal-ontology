      }
    },
    {
      "@id": "estleg:RKSKS_Par_31_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahuajal isikule kätteantud sundkasutusele võtmise käsundis nimetatud vara on keelatud võõrandada alates sõjaseisukorra väljakuulutamisest. (2) Sõjaseisukorra ajal isikule kätteantud sundkasutusele võtmise käsundis nimetatud vara on keelatud võõrandada alates vastava käsundi kätteandmise ajast.",
      "rdfs:label": {
        "@value": "RKSKS_Par_31 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_31_v103042018008"
      },
      "estleg:versionValidTo": {
        "@value": "2018-04-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_31_v103042018008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahuajal isikule kätteantud sundkasutusele võtmise haldusaktis nimetatud vara on keelatud võõrandada alates sõjaseisukorra väljakuulutamisest. (2) Sõjaseisukorra ajal isikule kätteantud sundkasutusele võtmise haldusaktis nimetatud vara on keelatud võõrandada alates vastava haldusakti kätteandmise ajast.",
      "rdfs:label": {
        "@value": "RKSKS_Par_31 (redaktsioon 103042018008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103042018008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103042018008",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_32_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vara osalisel või täielikul säilimisel tagastatakse see omanikule või valdajale sõjaseisukorra lõppemisel või sõjaseisukorra ajal vara kasutamise vajaduse möödumisel Vabariigi Valitsuse poolt kehtestatud korras ja tähtajal. (2) Vara tagastamise kohta koostatakse vastava voliniku (komisjoni) ja vara omaniku või valdaja poolt vara üleandmise-vastuvõtmise akt. (3) Vara omanikul on õigus loobuda tagastatava vara vastuvõtmisest selle kasutamiskõlbmatuks muutumise tõttu või muul põhjusel. (4) Tagastatava vara vastuvõtmisest loobumisel koostatakse vastava voliniku (komisjoni) ja omaniku poolt tagastatava vara vastuvõtmisest loobumise akt.",
      "rdfs:label": {
        "@value": "RKSKS_Par_32 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_32_v103042018008"
      },
      "estleg:versionValidTo": {
        "@value": "2018-04-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_32_v103042018008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vara osalisel või täielikul säilimisel tagastatakse see omanikule või valdajale sõjaseisukorra lõppemisel või sõjaseisukorra ajal vara kasutamise vajaduse möödumisel Vabariigi Valitsuse poolt kehtestatud korras ja tähtajal. (2) Vara tagastamise kohta koostatakse vastava ametiisiku (komisjoni) ja vara omaniku või valdaja poolt vara üleandmise-vastuvõtmise akt. (3) Vara omanikul on õigus loobuda tagastatava vara vastuvõtmisest selle kasutamiskõlbmatuks muutumise tõttu või muul põhjusel. (4) Tagastatava vara vastuvõtmisest loobumisel koostatakse vastava ametiisiku (komisjoni) ja omaniku poolt tagastatava vara vastuvõtmisest loobumise akt.",
      "rdfs:label": {
        "@value": "RKSKS_Par_32 (redaktsioon 103042018008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103042018008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103042018008",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 32",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_33_v22323",
      "@type": [
