    {
      "@id": "estleg:RKSKS_Par_15_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sundvõõrandada võidakse: kütte- ja määrdeaineid; toiduaineid; ravimeid ja ravivahendeid; muud vallasvara, mis vara omadustest lähtuvalt on äratarvitatav.",
      "rdfs:label": {
        "@value": "RKSKS_Par_15 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 15",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_16_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sundvõõrandamisele ei kuulu: muuseumide ja arhiivide vara; kirikute ja koguduste, usuühingute ning nende liitude vara, mida kasutatakse riitusteenistuseks; välisriikide saatkondadele, konsulaatidele, esindustele ja neis töötavatele välisriikide kodanikele kuuluv vara, mis on ametialaseks ja isiklikuks kasutamiseks; vara, mis rahvusvaheliste kokkulepete või rahvusvahelise õiguse üldtunnustatud normide alusel ei kuulu sundvõõrandamisele; isikule kuuluv vara, mille loetelu on sätestatud tsiviilkohtupidamise seadustiku (RT I 1993, 31/32, 538; 1994, 1, 5) lisas nr. 2; käesoleva seaduse § 9 punktis 4 tähendatud isikute vara.",
      "rdfs:label": {
        "@value": "RKSKS_Par_16 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_16_v925432"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_16_v925432",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sundvõõrandamisele ei kuulu: muuseumide ja arhiivide vara; kirikute ja koguduste, usuühingute ning nende liitude vara, mida kasutatakse riitusteenistuseks; välisriikide saatkondadele, konsulaatidele, esindustele ja neis töötavatele välisriikide kodanikele kuuluv vara, mis on ametialaseks ja isiklikuks kasutamiseks; vara, mis rahvusvaheliste kokkulepete või rahvusvahelise õiguse üldtunnustatud normide alusel ei kuulu sundvõõrandamisele; isikule kuuluv vara, millele ei saa pöörata sissenõuet täitemenetluses; käesoleva seaduse § 9 punktis 4 tähendatud isikute vara.",
      "rdfs:label": {
        "@value": "RKSKS_Par_16 (redaktsioon 925432)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "925432",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_16_v103042018008"
      },
      "estleg:versionValidTo": {
        "@value": "2018-04-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/925432",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_16_v103042018008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sundvõõrandamisele ei kuulu: muuseumide ja arhiivide vara; kirikute ja koguduste, usuühingute ning nende liitude vara, mida kasutatakse riitusteenistuseks; välisriikide saatkondadele, konsulaatidele, esindustele ja neis töötavatele välisriikide kodanikele kuuluv vara, mis on ametialaseks ja isiklikuks kasutamiseks; vara, mis rahvusvaheliste kokkulepete või rahvusvahelise õiguse üldtunnustatud normide alusel ei kuulu sundvõõrandamisele; isikule kuuluv vara, millele ei saa pöörata sissenõuet täitemenetluses; käesoleva seaduse § 9 punktis 4 tähendatud isikute vara; elutähtsa teenuse osutamiseks vältimatult vajalik vara.",
      "rdfs:label": {
        "@value": "RKSKS_Par_16 (redaktsioon 103042018008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103042018008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103042018008",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 16",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_17_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikutelt vara sundvõõrandamise otsustamiseks on rahuajal pädevad: valla- ja linnavalitsused sundkoormiste koondkava alusel maavalitsuselt saadud ülesande järgi; ministeeriumid sundkoormiste koondkavas antud ülesande järgi. (2) Valla- ja linnavalitsused ning ministeeriumid: peavad sundvõõrandamiste arvestust; korraldavad sundvõõrandamise käsundite isikutele kätteandmise rahuajal ja vara sundvõõrandamise sõjaseisukorra ajal käesoleva seaduse §-s 18 märgitud korras; kontrollivad vara sundvõõrandamise otsuse täitmise võimalikkust. (3) Kaitseväe ülemjuhataja otsustab vara sundvõõrandamise sõjaseisukorra ajal, lähtudes riigikaitselistest vajadustest. Väeosa ülem võib otsustada vara sundvõõrandamise sõjaseisukorra ajal, lähtudes sõjategevuse huvidest ja teatades sellest kaitseväe ülemjuhatajale. (4) Kaitseväe ülemjuhataja käsul väeosa ülem või maakonna ja linna riigikaitse osakonna (edaspidi kohaliku riigikaitse osakonna) ülem: korraldab isikutelt vara sundvõõrandamise käesoleva seaduse § 18 2. lõikes märgitud korras; peab sundvõõrandamiste arvestust.",
      "rdfs:label": {
        "@value": "RKSKS_Par_17 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_17_v255997"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
    {
      "@id": "estleg:RKSKS_Par_17_v255997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikutelt vara sundvõõrandamise otsustamiseks on rahuajal pädevad: riigikaitseosakonnad; ministeeriumid sundkoormiste koondkavas antud ülesande järgi. (2) Riigikaitseosakonnad ning ministeeriumid: peavad sundvõõrandamiste arvestust; korraldavad sundvõõrandamise käsundite isikutele kätteandmise rahuajal; kontrollivad vara sundvõõrandamise otsuse täitmise võimalikkust. (3) Kaitseväe ülemjuhataja otsustab vara sundvõõrandamise sõjaseisukorra ajal, lähtudes riigikaitselistest vajadustest. Väeosa ülem võib otsustada vara sundvõõrandamise sõjaseisukorra ajal, lähtudes sõjategevuse huvidest ja teatades sellest kaitseväe ülemjuhatajale. [Lõike 4 sõnastus kuni 31.12.2003] (4) Kaitseväe ülemjuhataja käsul väeosa ülem või maakonna ja linna riigikaitse osakonna (edaspidi kohaliku riigikaitse osakonna) ülem: korraldab isikutelt vara sundvõõrandamise käesoleva seaduse § 18 2. lõikes märgitud korras; peab sundvõõrandamiste arvestust. [Lõike 4 sõnastus alates 01.01.2004] (4) Sundvõõrandamiseks pädev organ kannab andmed sundvõõrandamise määramise või täitmise kohta mobilisatsiooni riiklikusse keskregistrisse. , osaliselt 01.01.2004",
      "rdfs:label": {
        "@value": "RKSKS_Par_17 (redaktsioon 255997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "255997",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_17_v913296"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/255997",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
