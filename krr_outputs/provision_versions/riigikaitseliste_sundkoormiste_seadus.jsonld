      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veokohustuse täitmise ajal peatub veokohustuse saanud töötaja tööleping töölepingu seaduse § 55 punkti 5 järgi. Töötajale säilitatakse töölepingu peatumise ajaks keskmine palk vastavalt palgaseadusele.",
      "rdfs:label": {
        "@value": "RKSKS_Par_37 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
