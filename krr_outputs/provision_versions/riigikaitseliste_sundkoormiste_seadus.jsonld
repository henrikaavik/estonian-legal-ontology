        "@type": "xsd:date"
      },
      "estleg:versionText": "Veokohustus on riiklik kohustus sõiduki, ujuvvahendi või õhusõiduki omanikule või valdajale vedude teostamiseks koos juhi või meeskonnaga sõjaseisukorra ajal riigikaitselisteks vajadusteks.",
      "rdfs:label": {
        "@value": "RKSKS_Par_33 (redaktsioon 22323)",
