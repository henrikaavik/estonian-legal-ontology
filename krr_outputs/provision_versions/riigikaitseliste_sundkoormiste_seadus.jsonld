      }
    },
    {
      "@id": "estleg:RKSKS_Par_29_v22323",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKSKS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui ettevõtte omanik või valdaja ei täida või keeldub täitmast ettevõttele antud kohustuslikku riigikaitselist ülesannet, võidakse sõjaseisukorra ajal, lähtudes üldistest riigikaitselistest huvidest, ettevõte võtta ajutiselt riigi valdusesse Vabariigi Valitsuse või kaitseväe ülemjuhataja poolt. (2) Käesoleva paragrahvi 1. lõikes nimetatud ettevõtte ajutiselt riigi valdusesse võtmise korraldab vastav ministeerium või kaitseväe ülemjuhataja, kelle poolt nimetatakse sundkasutuse ajaks ettevõtte juhtkond.",
      "rdfs:label": {
        "@value": "RKSKS_Par_29 (redaktsioon 22323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22323",
      "estleg:supersededByVersion": {
        "@id": "estleg:RKSKS_Par_29_v108072011056"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22323",
      "estleg:sourceAct": "Riigikaitseliste sundkoormiste seadus",
      "estleg:provisionRef": "RKSKS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:RKSKS_Map"
      }
    },
