      "estleg:versionValidTo": {
        "@value": "2016-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_70_v105042016004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Natura 2000 ala kaitse eesmärk määratakse kindlaks, lähtudes ala tähtsusest Euroopa Parlamendi ja nõukogu direktiivi 2009/147/EÜ I lisas nimetatud linnuliikide või selles nimetamata rändlinnuliikide või nõukogu direktiivi 92/43/EMÜ I lisas nimetatud looduslike või poollooduslike elupaigatüüpide või II lisas nimetatud liikide soodsa seisundi säilitamise või taastamise jaoks, samuti lähtudes Natura 2000 võrgustiku terviklikkuse saavutamise vajadusest ning silmas pidades ala degradeerumis- ja hävimisohtu.",
      "rdfs:label": {
