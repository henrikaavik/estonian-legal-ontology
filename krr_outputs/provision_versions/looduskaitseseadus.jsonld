      }
    },
    {
      "@id": "estleg:LKS_Par_11_v13338169",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) Looduse üksikobjekti kaitse alla võtmisel määratakse: kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 13338169)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13338169",
