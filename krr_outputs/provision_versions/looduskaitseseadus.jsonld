      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v13342186",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) Looduse üksikobjekti kaitse alla võtmisel määratakse: kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 13342186)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13342186",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_v114022013005"
      },
      "estleg:versionValidTo": {
        "@value": "2013-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v114022013005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul (kaitse-eeskiri); määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) Looduse üksikobjekti kaitse alla võtmisel määratakse: kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 114022013005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114022013005",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_v118042013003"
      },
      "estleg:versionValidTo": {
        "@value": "2013-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v118042013003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul (kaitse-eeskiri); määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) Looduse üksikobjekti kaitse alla võtmisel määratakse: kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord. (4) Loodusobjekti kaitse alla võtmise otsuse seletuskirjas esitatakse: põhjendused kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; põhjendused loodusobjekti kaitse alla võtmise otstarbekuse kohta; põhjendused kaitstava loodusobjekti tüübi valiku kohta; põhjendused kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; põhjendused kaitsekorra kohta; kaitse alla võtmise menetluse kirjeldus, sealhulgas menetlusetappide kronoloogiline loetelu, ärakuulamise tulemused ja menetluse käigus tehtud ettepanekute tulemusel tehtud muudatused koos põhjendustega. (5) Käesoleva paragrahvi lõikes 4 nimetatud seletuskiri, välja arvatud kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri, avaldatakse Keskkonnaministeeriumi veebilehel. Kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri avaldatakse valla- või linnavalitsuse veebilehel. (6) Loodusobjekti kaitse alla võtmise otsus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist või otsuses sätestatud ajal.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 118042013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118042013003",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_v129062014032"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v129062014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul kehtestatakse (kaitse-eeskiri); määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) Looduse üksikobjekti kaitse alla võtmisel määratakse: kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord. (4) Loodusobjekti kaitse alla võtmise otsuse seletuskirjas esitatakse: põhjendused kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; põhjendused loodusobjekti kaitse alla võtmise otstarbekuse kohta; põhjendused kaitstava loodusobjekti tüübi valiku kohta; põhjendused kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; põhjendused kaitsekorra kohta; kaitse alla võtmise menetluse kirjeldus, sealhulgas menetlusetappide kronoloogiline loetelu, ärakuulamise tulemused ja menetluse käigus tehtud ettepanekute tulemusel tehtud muudatused koos põhjendustega. (5) Käesoleva paragrahvi lõikes 4 nimetatud seletuskiri, välja arvatud kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri, avaldatakse Keskkonnaministeeriumi veebilehel. Kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri avaldatakse valla- või linnavalitsuse veebilehel. (6) Loodusobjekti kaitse alla võtmise otsus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist või otsuses sätestatud ajal.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 129062014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014032",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_v105042016004"
      },
      "estleg:versionValidTo": {
        "@value": "2016-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v105042016004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul kehtestatakse (kaitse-eeskiri); määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (1¹) Käesoleva seaduse § 7 lõikes 2 sätestatud juhul pindalalise loodusobjekti kaitsekorra kindlaksmääramisel tuleb lähtuda kaitse eesmärgiks oleva elupaiga või liigi ökoloogilistest vajadustest. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) Looduse üksikobjekti kaitse alla võtmisel määratakse: kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord. (4) Loodusobjekti kaitse alla võtmise otsuse seletuskirjas esitatakse: põhjendused kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; põhjendused loodusobjekti kaitse alla võtmise otstarbekuse kohta; põhjendused kaitstava loodusobjekti tüübi valiku kohta; põhjendused kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; põhjendused kaitsekorra kohta; kaitse alla võtmise menetluse kirjeldus, sealhulgas menetlusetappide kronoloogiline loetelu, ärakuulamise tulemused ja menetluse käigus tehtud ettepanekute tulemusel tehtud muudatused koos põhjendustega. (5) Käesoleva paragrahvi lõikes 4 nimetatud seletuskiri, välja arvatud kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri, avaldatakse Keskkonnaministeeriumi veebilehel. Kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri avaldatakse valla- või linnavalitsuse veebilehel. (6) Loodusobjekti kaitse alla võtmise otsus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist või otsuses sätestatud ajal.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 105042016004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105042016004",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_v122022019021"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v122022019021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul kehtestatakse (kaitse-eeskiri); määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (1¹) Käesoleva seaduse § 7 lõikes 2 sätestatud juhul pindalalise loodusobjekti kaitsekorra kindlaksmääramisel tuleb lähtuda kaitse eesmärgiks oleva elupaiga või liigi ökoloogilistest vajadustest. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord. (4) Loodusobjekti kaitse alla võtmise otsuse seletuskirjas esitatakse: põhjendused kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; põhjendused loodusobjekti kaitse alla võtmise otstarbekuse kohta; põhjendused kaitstava loodusobjekti tüübi valiku kohta; põhjendused kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; põhjendused kaitsekorra kohta; kaitse alla võtmise menetluse kirjeldus, sealhulgas menetlusetappide kronoloogiline loetelu, ärakuulamise tulemused ja menetluse käigus tehtud ettepanekute tulemusel tehtud muudatused koos põhjendustega. (5) Käesoleva paragrahvi lõikes 4 nimetatud seletuskiri, välja arvatud kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri, avaldatakse Keskkonnaministeeriumi veebilehel. Kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri avaldatakse valla- või linnavalitsuse veebilehel. (6) Loodusobjekti kaitse alla võtmise otsus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist või otsuses sätestatud ajal.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 122022019021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_v130062023035"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_v130062023035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) määratakse ala kaitse alla võtmise eesmärk; käesoleva seaduse § 12 lõikes 1 sätestatud juhul kehtestatakse (kaitse-eeskiri); määratakse ala piir; nimetatakse kaitse alla võetava ala valitseja; lisatakse otsusele loodusobjekti asukoha kaart. (1¹) Käesoleva seaduse § 7 lõikes 2 sätestatud juhul pindalalise loodusobjekti kaitsekorra kindlaksmääramisel tuleb lähtuda kaitse eesmärgiks oleva elupaiga või liigi ökoloogilistest vajadustest. (2) Liigi kaitse alla võtmisel esitatakse selle kaitsekategooria liikide loetelu eesti ja ladina keeles. (3) kaitse alla võtmise eesmärk; kaitsevööndi ulatus; kaitstava looduse üksikobjekti valitseja; kaitsekord. (4) Loodusobjekti kaitse alla võtmise otsuse seletuskirjas esitatakse: põhjendused kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; põhjendused loodusobjekti kaitse alla võtmise otstarbekuse kohta; põhjendused kaitstava loodusobjekti tüübi valiku kohta; põhjendused kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; põhjendused kaitsekorra kohta; kaitse alla võtmise menetluse kirjeldus, sealhulgas menetlusetappide kronoloogiline loetelu, ärakuulamise tulemused ja menetluse käigus tehtud ettepanekute tulemusel tehtud muudatused koos põhjendustega. (5) Käesoleva paragrahvi lõikes 4 nimetatud seletuskiri, välja arvatud kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri, avaldatakse Kliimaministeeriumi veebilehel. Kohaliku omavalitsuse tasandil kaitstavate loodusobjektide kaitse alla võtmise otsuse seletuskiri avaldatakse valla- või linnavalitsuse veebilehel. (6) Loodusobjekti kaitse alla võtmise otsus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist või otsuses sätestatud ajal.",
      "rdfs:label": {
        "@value": "LKS_Par_11 (redaktsioon 130062023035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023035"
    },
    {
      "@id": "estleg:LKS_Par_11_1_v118042013003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui menetluse kestel selgub, et loodusobjekti, mille kaitse alla võtmine algatati, ei ole otstarbekas või võimalik kaitse alla võtta, keeldutakse kaitse alla võtmisest. Loodusobjekti kaitse alla võtmisest keeldumise otsustab keskkonnaminister käskkirjaga ning loodusobjekti kohaliku kaitse alla võtmisest keeldumise otsustab kaitse alla võtmise menetluse algataja. (2) Kaitse alla võtmisest keeldumise otsus jõustub selle allakirjutamisel.",
      "rdfs:label": {
        "@value": "LKS_Par_11_1 (redaktsioon 118042013003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118042013003",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_11_1_v129062014032"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_11_1_v129062014032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui menetluse kestel selgub, et loodusobjekti, mille kaitse alla võtmine algatati, ei ole otstarbekas või võimalik kaitse alla võtta, keeldutakse kaitse alla võtmisest. Loodusobjekti kaitse alla võtmisest keeldumise otsustab valdkonna eest vastutav minister käskkirjaga ning loodusobjekti kohaliku kaitse alla võtmisest keeldumise otsustab kaitse alla võtmise menetluse algataja. (2) Kaitse alla võtmisest keeldumise otsus jõustub selle allakirjutamisel.",
      "rdfs:label": {
        "@value": "LKS_Par_11_1 (redaktsioon 129062014032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014032"
