      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 71–74 sätestatud väärtegude menetlemisele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40) ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590) sätteid. (2) Käesoleva seaduse §-des 71, 72 ja 74 sätestatud väärtegude kohtuväline menetleja on Keskkonnainspektsioon. (3) Käesoleva seaduse §-des 71, 73 ja 74 sätestatud väärtegude kohtuväline menetleja on valla- või linnavalitsus.",
      "rdfs:label": {
        "@value": "LKS_Par_75 (redaktsioon 745306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745306",
