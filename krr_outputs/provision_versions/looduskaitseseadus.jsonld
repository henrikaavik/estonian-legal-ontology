      },
      "estleg:versionValidTo": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKS_Par_10_v12889994",
      "@type": [
        "owl:NamedIndividual",
