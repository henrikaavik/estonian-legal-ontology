    {
      "@id": "estleg:LKS_Par_37_v13338169",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKS_Par_37"
