        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjoni määruse (EL) nr 737/2010 artikli 9 lõikes 1 nimetatud pädev asutus on Kliimaministeerium.",
      "rdfs:label": {
        "@value": "LKS_Par_63_1 (redaktsioon 130062023035)",
        "@language": "et"
