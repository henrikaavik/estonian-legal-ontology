igi ega jahiulukite hulka ja kes põhjustab varalist kahju või tervisekahju, nagu närilised, putukad, teod ja lestad, võib surmata vara või tervise kaitseks.",
      "rdfs:label": {
        "@value": "LKS_Par_55 (redaktsioon 873613)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "873613",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKS_Par_55_v893104"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-28",
        "@type": "xsd:date"
      }
    },
