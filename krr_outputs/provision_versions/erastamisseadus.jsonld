    {
      "@id": "estleg:ErS_Par_9_v22256",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) [Kehtetu] (2) Riigivara erastamisel kuulub Vabariigi Valitsuse ainupädevusse: – 3) [Kehtetud] erastamisnimekirja kinnitatud riigivara sealt väljaarvamise otsustamine; [Kehtetu] käesoleva seaduse § 21 2. lõikes nimetatud erastamise lisatingimuste kinnitamine; erastamise õigustatud subjektidele paragrahv 3 3. lõikes nimetatud lisanõuete esitamine; [Kehtetu]; erastamisnimekirja kinnitatud ettevõtete, samuti riigi äriühingute, kelle aktsiad või osad on kinnitatud erastamisnimekirja, ümberkujundamise, likvideerimise, restruktureerimise ja saneerimise põhimõtete kinnitamine; erastamisnimekirja kinnitatud riigivara munitsipaliseerimise otsustamine, samuti muu riigivara munitsipaliseerimise otsustamine Vabariigi Valitsuse poolt kehtestatud alusel ja korras; erastamisnimekirja kinnitatud riigivara majandustegevusse paigutamise otsustamine, sealhulgas äriühingu aktsia- või osakapitali sissemaksete tegemise ning riigivara rendile või kasutusvaldusse andmise otsustamine; eelläbirääkimistega pakkumisel parima ja vajaduse korral paremuselt teise pakkumise kindlaksmääramine; [Kehtetu]",
      "rdfs:label": {
        "@value": "ErS_Par_9 (redaktsioon 22256)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22256",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErS_Par_9_v12740348"
      },
      "estleg:versionValidTo": {
        "@value": "2006-10-05",
        "@type": "xsd:date"
      }
