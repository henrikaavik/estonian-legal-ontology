    },
    {
      "@id": "estleg:ErS_Par_7_v22256",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erastamist korraldava valitsusasutuse põhiülesandeks on korraldada riigivara erastamist ning teiste omandireformist tulenevate ülesannete täitmist. Oma põhiülesande täitmiseks Erastamist korraldav valitsusasutus: [Kehtetu] korraldab riigi nimel erastamisnimekirja kinnitatud riigivara valdamist, kasutamist ja käsutamist kuni vara erastamiseni; otsustab ja korraldab erastamisnimekirja kinnitatud ettevõtete, samuti riigi äriühingute, kelle aktsiad või osad on kinnitatud erastamisnimekirja, ümberkujundamist, ühinemist, jagunemist, restruktureerimist, saneerimist või likvideerimist; peab läbirääkimisi omandireformi õigustatud subjektidega vastavalt käesoleva seaduse § 5 3. lõikele; korraldab riigivara munitsipaliseerimist ja vara taasriigistamist; korraldab erastamisnimekirja kinnitatud riigivara majandustegevusse paigutamist, sealhulgas sissemaksete tegemist äriühingu aktsia- või osakapitali ning riigivara rendile või kasutusvaldusse andmist; sõlmib riigi nimel erastatava riigivara ostu-müügilepinguid ja kontrollib nende lepingute täitmist.",
      "rdfs:label": {
        "@value": "ErS_Par_7 (redaktsioon 22256)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22256",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErS_Par_7_v12740348"
      },
      "estleg:versionValidTo": {
        "@value": "2006-10-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ErS_Par_7_v12740348",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ErS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-10-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erastamist korraldava valitsusasutuse põhiülesandeks on korraldada riigivara erastamist ning teiste omandireformist tulenevate ülesannete täitmist. Oma põhiülesande täitmiseks Erastamist korraldav valitsusasutus: kehtetu - korraldab riigi nimel erastamisnimekirja kinnitatud riigivara valdamist, kasutamist ja käsutamist kuni vara erastamiseni; otsustab ja korraldab erastamisnimekirja kinnitatud ettevõtete, samuti riigi äriühingute, kelle aktsiad või osad on kinnitatud erastamisnimekirja, ümberkujundamist, ühinemist, jagunemist, restruktureerimist, saneerimist või likvideerimist; peab läbirääkimisi omandireformi õigustatud subjektidega vastavalt käesoleva seaduse § 5 3. lõikele; korraldab riigivara munitsipaliseerimist ja vara taasriigistamist; korraldab erastamisnimekirja kinnitatud riigivara majandustegevusse paigutamist, sealhulgas sissemaksete tegemist äriühingu aktsia- või osakapitali ning riigivara rendile või kasutusvaldusse andmist; sõlmib riigi nimel erastatava riigivara ostu-müügilepinguid ja kontrollib nende lepingute täitmist.",
      "rdfs:label": {
        "@value": "ErS_Par_7 (redaktsioon 12740348)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12740348",
      "estleg:supersededByVersion": {
        "@id": "estleg:ErS_Par_7_v13238075"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
