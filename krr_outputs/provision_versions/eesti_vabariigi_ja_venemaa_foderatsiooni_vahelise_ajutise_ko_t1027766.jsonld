        "@id": "estleg:Reg_1027766_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027766_Par_3_v1027766",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027766_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kontrolljoone alguspunkt on Pedetsi jõe keskjoonel asuv Eesti Vabariigi, Venemaa Föderatsiooni ja Läti Vabariigi riigipiiride lõikumispunkt. Kontrolljoone alguspunkt on Pedetsi jõe keskjoonel asuv Eesti Vabariigi, Venemaa Föderatsiooni ja Läti Vabariigi riigipiiride lõikumispunkt. 2 (2) Kontrolljoone piirilõigud on järgmised: 1 1) piirilõik 1 – orograafiline piir, riigipiiride lõikumispunktist ligikaudu 8,8 km mööda Pedetsi jõe keskjoont vastuvoolu Kivioru-Veskini ja sealt edasi mööda nimetut oja kuni lõikumiseni piirimärke number 18-17-16 ühendava joone pikendusega; 2 2) piirilõik 2 – geomeetriline piir, piirimärgid number 17–43; 3 3) piirilõik 3 – orograafiline piir, ligikaudu 1,6 km murdjooneliselt üle Pabra järve kirde suunas, läbides järves asuvat Puusaart kuni piirimärgini number 44; 4 4) piirilõik 4 – geomeetriline piir, piirimärgid number 44–109; 5 5) piirilõik 5 – orograafiline piir, murdjooneliselt põhjakirde suunas ligikaudu 5,0 km üle Vaniku paisjärve kuni Meeksi oja väljavooluni ja sealt edasi piki oja keskjoont allavoolu kuni piirimärgini number 117; 6 6) piirilõik 6 – geomeetriline piir, piirimärgid number 117–308, sealjuures piirimärkide 180-181 vaheline geomeetriline piir kulgeb sirgelt piki kraavi telge ning 182-183 vaheline geomeetriline piir kulgeb piki kõvera kraavi telge; 7 7) piirilõik 7 – orograafiline piir, mis algab piirimärkide number 307 ja 308 vahelise piirijoone pikenduse lõikumisega Belska jõe keskjoonega ja kulgeb edasi ida suunas ligikaudu 1,0 km piki jõe keskjoont vastuvoolu kuni lõikumiseni piirimärke number 312 ja 313 ühendava sirge pikendusega; 8 8) piirilõik 8 – geomeetriline piir, piirimärgid number 312–342; 9 9) piirilõik 9 – orograafiline piir, ligikaudu 12,5 km piki Piusa jõe keskjoont allavoolu kuni piirimärgini number 358; 10 10) piirilõik 10 – geomeetriline piir, piirimärgid number 358–359; 11 11) piirilõik 11 – orograafiline piir, kõverjooneliselt kagu suunas ligikaudu 1,6 km piki Hõbeoja keskjoont kuni piirimärgini number 361 ning sealt edasi piki Hõbeoja soostunud sängi kuni piirimärgini number 366; 12 12) piirilõik 12 – geomeetriline piir, piirimärgid number 366–385; 13 13) piirilõik 13 – orograafiline piir, kõverjooneliselt ligikaudu 5,6 km piki Moložva jõe (Mustjõe) ja Pattina paisjärve keskjoont kuni piirimärgini number 403; 14 14) piirilõik 14 – geomeetriline piir, piirimärgid number 403–435; 15 15) piirilõik 15 – orograafiline piir, piki kuivenduskraavi telgjoont ja Piusa jõe keskjoonel ligikaudu 0,8 km kuni piirimärkide number 439 ja 438 läbiva suuna lõikumiseni Piusa jõe keskjoonega; 16 16) piirilõik 16 – geomeetriline piir, piirimärgid number 439–517; 17 17) piirilõik 17 – orograafiline piir, loode suunas ligikaudu 2,8 km piki Kulje jõe voolusängi keskjoont ja Kulje lahe keskjoont kuni Kulje tammi vee läbivoolu ava keskpunktini piirimärgini number 518; 18 18) piirilõik 18 – kartograafiline piir, Kulje lahel pikkusega ligikaudu 3,4 km kuni piirimärgini number 519; 19 19) piirilõik 19 – geomeetriline piir, piirimärgid number 519–538; 20 20) piirilõik 20 – kartograafiline piir, Pihkva, Lämmi- ja Peipsi järvel; 21 21) piirilõik 21 – orograafiline piir, Peipsi järve kaldajoonel ligikaudu 3,3 km kuni lõikumiseni Narva jõe pealaevatee algpunktiga risti oleva jooneni (3. muuli pikendus) ja sealt edasi piki pealaevatee keskjoont kuni Narva jõe suudmes asuvasse kontrolljoone maismaaosa lõpp-punkti, mis ühtib merealapiiride algusega. Kontrolljoone piirilõigud on järgmised: piirilõik 1 – orograafiline piir, riigipiiride lõikumispunktist ligikaudu 8,8 km mööda Pedetsi jõe keskjoont vastuvoolu Kivioru-Veskini ja sealt edasi mööda nimetut oja kuni lõikumiseni piirimärke number 18-17-16 ühendava joone pikendusega; piirilõik 2 – geomeetriline piir, piirimärgid number 17–43; piirilõik 3 – orograafiline piir, ligikaudu 1,6 km murdjooneliselt üle Pabra järve kirde suunas, läbides järves asuvat Puusaart kuni piirimärgini number 44; piirilõik 4 – geomeetriline piir, piirimärgid number 44–109; piirilõik 5 – orograafiline piir, murdjooneliselt põhjakirde suunas ligikaudu 5,0 km üle Vaniku paisjärve kuni Meeksi oja väljavooluni ja sealt edasi piki oja keskjoont allavoolu kuni piirimärgini number 117; piirilõik 6 – geomeetriline piir, piirimärgid number 117–308, sealjuures piirimärkide 180-181 vaheline geomeetriline piir kulgeb sirgelt piki kraavi telge ning 182-183 vaheline geomeetriline piir kulgeb piki kõvera kraavi telge; piirilõik 7 – orograafiline piir, mis algab piirimärkide number 307 ja 308 vahelise piirijoone pikenduse lõikumisega Belska jõe keskjoonega ja kulgeb edasi ida suunas ligikaudu 1,0 km piki jõe keskjoont vastuvoolu kuni lõikumiseni piirimärke number 312 ja 313 ühendava sirge pikendusega; piirilõik 8 – geomeetriline piir, piirimärgid number 312–342; piirilõik 9 – orograafiline piir, ligikaudu 12,5 km piki Piusa jõe keskjoont allavoolu kuni piirimärgini number 358; piirilõik 10 – geomeetriline piir, piirimärgid number 358–359; piirilõik 11 – orograafiline piir, kõverjooneliselt kagu suunas ligikaudu 1,6 km piki Hõbeoja keskjoont kuni piirimärgini number 361 ning sealt edasi piki Hõbeoja soostunud sängi kuni piirimärgini number 366; piirilõik 12 – geomeetriline piir, piirimärgid number 366–385; piirilõik 13 – orograafiline piir, kõverjooneliselt ligikaudu 5,6 km piki Moložva jõe (Mustjõe) ja Pattina paisjärve keskjoont kuni piirimärgini number 403; piirilõik 14 – geomeetriline piir, piirimärgid number 403–435; piirilõik 15 – orograafiline piir, piki kuivenduskraavi telgjoont ja Piusa jõe keskjoonel ligikaudu 0,8 km kuni piirimärkide number 439 ja 438 läbiva suuna lõikumiseni Piusa jõe keskjoonega; piirilõik 16 – geomeetriline piir, piirimärgid number 439–517; piirilõik 17 – orograafiline piir, loode suunas ligikaudu 2,8 km piki Kulje jõe voolusängi keskjoont ja Kulje lahe keskjoont kuni Kulje tammi vee läbivoolu ava keskpunktini piirimärgini number 518; piirilõik 18 – kartograafiline piir, Kulje lahel pikkusega ligikaudu 3,4 km kuni piirimärgini number 519; piirilõik 19 – geomeetriline piir, piirimärgid number 519–538; piirilõik 20 – kartograafiline piir, Pihkva, Lämmi- ja Peipsi järvel; piirilõik 21 – orograafiline piir, Peipsi järve kaldajoonel ligikaudu 3,3 km kuni lõikumiseni Narva jõe pealaevatee algpunktiga risti oleva jooneni (3. muuli pikendus) ja sealt edasi piki pealaevatee keskjoont kuni Narva jõe suudmes asuvasse kontrolljoone maismaaosa lõpp-punkti, mis ühtib merealapiiride algusega.",
      "rdfs:label": {
        "@value": "Reg_1027766_Par_3 (redaktsioon 1027766)",
        "@language": "et"
