    {
      "@id": "estleg:Reg_1027701_Par_8_v1027701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027701_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse esitavad andmeid tunnustatud loomeliidud ja Kultuuriministeerium. Andmekogusse esitavad andmeid tunnustatud loomeliidud ja Kultuuriministeerium. 2 (2) Andmeandja nimel esitavad käesoleva määruse §-s 10 sätestatud korras andmeid isikud, kellele on vajalikus ulatuses antud andmekogu kasutajaõigused vastavalt käesoleva määruse §-le 12. Andmeandja nimel esitavad käesoleva määruse §-s 10 sätestatud korras andmeid isikud, kellele on vajalikus ulatuses antud andmekogu kasutajaõigused vastavalt käesoleva määruse §-le 12.",
      "rdfs:label": {
        "@value": "Reg_1027701_Par_8 (redaktsioon 1027701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027701",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027701",
      "estleg:sourceAct": "Loomeliitude andmekogu asutamine ja põhimäärus",
      "estleg:provisionRef": "Reg_1027701 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027701_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027701_Par_9_v1027701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027701_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmete andmekogusse kandmisel esitatakse päringuid ja saadakse andmeid sellega liidestatud andmekogudest. Andmete andmekogusse kandmisel esitatakse päringuid ja saadakse andmeid sellega liidestatud andmekogudest. 2 (2) Andmevahetus teiste andmekogudega toimub infosüsteemide andmevahetuskihi kaudu. Andmevahetus teiste andmekogudega toimub infosüsteemide andmevahetuskihi kaudu.",
