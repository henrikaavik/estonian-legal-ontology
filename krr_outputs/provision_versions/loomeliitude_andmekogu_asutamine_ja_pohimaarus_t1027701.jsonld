    },
    {
      "@id": "estleg:Reg_1027701_Par_16_v1027701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027701_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet andmekogu pidamise üle teostavad andmekogu vastutav töötleja, Majandus- ja Kommunikatsiooniministeerium ning Andmekaitse Inspektsioon vastavalt oma pädevusele. Järelevalvet andmekogu pidamise üle teostavad andmekogu vastutav töötleja, Majandus- ja Kommunikatsiooniministeerium ning Andmekaitse Inspektsioon vastavalt oma pädevusele.",
      "rdfs:label": {
        "@value": "Reg_1027701_Par_16 (redaktsioon 1027701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027701",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027701",
      "estleg:sourceAct": "Loomeliitude andmekogu asutamine ja põhimäärus",
      "estleg:provisionRef": "Reg_1027701 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027701_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027701_Par_17_v1027701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027701_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu asutamine ja pidamine finantseeritakse riigieelarvest vastutavale töötlejale selleks otstarbeks eraldatud vahenditest. Andmekogu asutamine ja pidamine finantseeritakse riigieelarvest vastutavale töötlejale selleks otstarbeks eraldatud vahenditest.",
      "rdfs:label": {
        "@value": "Reg_1027701_Par_17 (redaktsioon 1027701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027701",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027701",
      "estleg:sourceAct": "Loomeliitude andmekogu asutamine ja põhimäärus",
      "estleg:provisionRef": "Reg_1027701 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027701_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027701_Par_18_v1027701",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027701_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu tegevuse lõpetamise otsustab valdkonna eest vastutav minister. Andmekogu tegevus lõpetatakse kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega. Andmekogu tegevuse lõpetamise otsustab valdkonna eest vastutav minister. Andmekogu tegevus lõpetatakse kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega.",
      "rdfs:label": {
        "@value": "Reg_1027701_Par_18 (redaktsioon 1027701)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027701",
