      "estleg:versionText": "Ahja jõe ürgoru maastikukaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 6. oktoobri 2010. a käskkirjaga nr 1420 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Ahja jõe ürgoru maastikukaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 6. oktoobri 2010. a käskkirjaga nr 1420 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1025716_Par_19 (redaktsioon 1025716)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025716",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025716",
      "estleg:sourceAct": "Ahja jõe ürgoru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1025716 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025716_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025716_Par_2_v1025716",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
