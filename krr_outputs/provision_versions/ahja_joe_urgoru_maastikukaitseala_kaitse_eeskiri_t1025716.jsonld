        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1025716_Par_3 (redaktsioon 1025716)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025716",
