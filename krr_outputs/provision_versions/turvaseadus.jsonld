      },
      "estleg:versionText": "Riiklikku järelevalvet turvaettevõtja, turvaülesannet täitva turvatöötaja, sisevalve ja sisevalvetöötaja tegevuse üle teostab Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "TurvaS_Par_56 (redaktsioon 129062014088)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014088",
