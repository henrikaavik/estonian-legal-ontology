    {
      "@id": "estleg:TurvaS_Par_26_v639392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööülesandeid täitval turvatöötajal on kaasas töötõend, millel on foto, isikukood ja turvaettevõtja ärinimi. (2) Turvaülesannet täitval füüsilisest isikust turvaettevõtjal on kaasas notariaalselt kinnitatud tegevusloakoopia või Politseiameti kinnitatud ärakiri ja isikut tõendav dokument. (3) Turvatöötaja peab isiku poole pöördudes end tutvustama ning esitama talle töötõendi.",
      "rdfs:label": {
        "@value": "TurvaS_Par_26 (redaktsioon 639392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "639392",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurvaS_Par_26_v1027771"
      },
      "estleg:versionValidTo": {
