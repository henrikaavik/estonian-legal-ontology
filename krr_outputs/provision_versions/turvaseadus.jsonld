    {
      "@id": "estleg:TurvaS_Par_42_v1027771",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_42"
      },
