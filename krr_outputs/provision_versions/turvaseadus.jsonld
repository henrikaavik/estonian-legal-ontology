    },
    {
      "@id": "estleg:TurvaS_Par_15_v104032015029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Turvaettevõtja täidab järgmisi kohustusi: teeb iga kuu Politsei- ja Piirivalveametile kirjalikult teatavaks mehitatud valve alla võetud objektid, mis on lisandunud või mille teenindamiseks sõlmitud leping on lõpetatud. Teates esitatakse objekti aadress ja objekti nimetus; selle isiku nimi, kellega on turvateenuse leping sõlmitud; lepingu sõlmimise kuupäev ja lepingu kehtivuse aeg ning täidetavate turvaülesannete loetelu; kui valvatav või kaitstav objekt on Eesti riigilippu kandev ning Eesti kohtu juures asuvasse laevakinnistusraamatusse kantud laev, esitatakse käesoleva paragrahvi punktis 1 sätestatud objekti aadressi ja nimetuse asemel Politsei- ja Piirivalveametile valvatava või kaitstava laeva nimi, laeva registrinumber, laeva omaniku nimi, isiku- või registrikood või isikukoodi puudumisel laeva omaniku sünniaeg ja aadress; teeb valveobjekti vastu toimepandud ründe viivitamata teatavaks Politsei- ja Piirivalveametile.",
      "rdfs:label": {
        "@value": "TurvaS_Par_15 (redaktsioon 104032015029)",
        "@language": "et"
      },
