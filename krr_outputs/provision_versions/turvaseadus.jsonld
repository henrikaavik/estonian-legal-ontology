        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13319792",
      "estleg:sourceAct": "Turvaseadus",
      "estleg:provisionRef": "TurvaS § 58",
      "estleg:partOfAct": {
        "@id": "estleg:TurvaS_Map_2026"
      }
    },
    {
      "@id": "estleg:TurvaS_Par_58_v129062014088",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 640 eurot.",
      "rdfs:label": {
        "@value": "TurvaS_Par_58 (redaktsioon 129062014088)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014088",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014088",
      "estleg:sourceAct": "Turvaseadus",
      "estleg:provisionRef": "TurvaS § 58",
      "estleg:partOfAct": {
        "@id": "estleg:TurvaS_Map_2026"
      }
    },
    {
      "@id": "estleg:TurvaS_Par_59_v639392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui turvaettevõtja või sisevalvega asutus ei nõustu politseiametniku ettekirjutuse või toiminguga, on tal õigus esitada kaebus politseiasutuse juhile ettekirjutuse saamisest või toimingu tegemisest alates kümne kalendripäeva jooksul. (2) Kaebuse esitamine ei võta turvaettevõtjalt või sisevalvega asutuselt kohustust täita politseiametniku ettekirjutus. (3) Politseiasutuse juht vaatab kaebuse läbi selle saamisest alates ühe kuu jooksul ning teeb ühe järgmistest otsustest: jätab ettekirjutuse või toimingu jõusse; muudab ettekirjutust, toimingut või tühistab selle. (4) Otsus antakse kaebuse esitajale kätte allkirja vastu või saadetakse posti teel tähtkirjaga otsuse tegemisest alates kümne päeva jooksul.",
      "rdfs:label": {
        "@value": "TurvaS_Par_59 (redaktsioon 639392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "639392",
      "estleg:supersededByVersion": {
        "@id": "estleg:TurvaS_Par_59_v129122011051"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/639392",
      "estleg:sourceAct": "Turvaseadus",
      "estleg:provisionRef": "TurvaS § 59",
      "estleg:partOfAct": {
        "@id": "estleg:TurvaS_Map_2026"
      }
    },
    {
      "@id": "estleg:TurvaS_Par_59_v129122011051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_59"
      },
      "estleg:versionValidFrom": {
