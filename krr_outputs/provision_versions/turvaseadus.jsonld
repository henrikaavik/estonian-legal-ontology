    {
      "@id": "estleg:TurvaS_Par_26_v13251137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TurvaS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööülesandeid täitval turvatöötajal on kaasas töötõend, millel on foto, isikukood ja turvaettevõtja ärinimi. (2) Turvaülesannet täitval füüsilisest isikust turvaettevõtjal on kaasas notariaalselt kinnitatud tegevusloakoopia või Politsei- ja Piirivalveameti kinnitatud ärakiri ja isikut tõendav dokument. (3) Turvatöötaja peab isiku poole pöördudes end tutvustama ning esitama talle töötõendi.",
      "rdfs:label": {
        "@value": "TurvaS_Par_26 (redaktsioon 13251137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13251137",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13251137",
      "estleg:sourceAct": "Turvaseadus",
      "estleg:provisionRef": "TurvaS § 26",
