    {
      "@id": "estleg:Reg_158950_Par_2_v158950",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158950_Par_2"
