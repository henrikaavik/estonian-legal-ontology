      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052275_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lõke käesoleva määruse mõistes on lahtine kontrollitud küttekoldeväline tuli. Lõke käesoleva määruse mõistes on lahtine kontrollitud küttekoldeväline tuli. 2 (2) Lõkkekoht käesoleva määruse mõistes on väljaspool hoonet asuval maa-alal paiknev lahtise tule tegemise koht. Lõkkekoht käesoleva määruse mõistes on väljaspool hoonet asuval maa-alal paiknev lahtise tule tegemise koht. 3 (3) Grillimiskoht käesoleva määruse mõistes on väljaspool hoonet asuv koht, kus kasutatakse grillseadet. Grillimiskoht käesoleva määruse mõistes on väljaspool hoonet asuv koht, kus kasutatakse grillseadet. 4 (4) Grillseade käesoleva määruse mõistes on küttepuude, puusöe või küttegaasiga köetav grill ning muu kattega seade, millel on suitsulõõr ja sädemepüüdja. Grillseade käesoleva määruse mõistes on küttepuude, puusöe või küttegaasiga köetav grill ning muu kattega seade, millel on suitsulõõr ja sädemepüüdja.",
      "rdfs:label": {
        "@value": "Reg_1052275_Par_2 (redaktsioon 1052275)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052275",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052275",
      "estleg:sourceAct": "Lõkke tegemisele ja grillimiskohale esitatavad nõuded",
      "estleg:provisionRef": "Reg_1052275 § 2",
