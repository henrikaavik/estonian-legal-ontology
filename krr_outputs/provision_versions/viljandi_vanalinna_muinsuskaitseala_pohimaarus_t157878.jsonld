      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157878_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse Viljandi vanalinna muinsuskaitseala (edaspidi muinsuskaitseala) ja selle kaitsevööndi piirid, muinsuskaitsealal ja selle kaitsevööndis kehtivad nõuded ja kitsendused ja muinsuskaitset korraldavate organite tööjaotus ning sätestatakse koostöö muinsuskaitset korraldavate organite ja kaitstavate loodusobjektide valitseja vahel. Määrusega kehtestatakse Viljandi vanalinna muinsuskaitseala (edaspidi muinsuskaitseala) ja selle kaitsevööndi piirid, muinsuskaitsealal ja selle kaitsevööndis kehtivad nõuded ja kitsendused ja muinsuskaitset korraldavate organite tööjaotus ning sätestatakse koostöö muinsuskaitset korraldavate organite ja kaitstavate loodusobjektide valitseja vahel.",
      "rdfs:label": {
        "@value": "Reg_157878_Par_1 (redaktsioon 157878)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157878",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157878",
