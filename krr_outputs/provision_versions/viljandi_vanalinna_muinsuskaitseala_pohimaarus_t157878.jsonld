      }
    },
    {
      "@id": "estleg:Reg_157878_Par_7_v157878",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157878_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muinsuskaitseameti ja Viljandi Linnavalitsuse loata on muinsuskaitsealal keelatud «Muinsuskaitseseaduse» §-s 24 sätestatud tegevused. Muinsuskaitseameti ja Viljandi Linnavalitsuse loata on muinsuskaitsealal keelatud «Muinsuskaitseseaduse» §-s 24 sätestatud tegevused. 2 (2) Muinsuskaitsealal ehitades, konserveerides ja restaureerides ning selleks ehitusmaterjale valides tuleb arvestada nii ehitise kui ka muinsuskaitseala arhitektuurilist ja ajaloolist väärtust. Muinsuskaitsealal ehitades, konserveerides ja restaureerides ning selleks ehitusmaterjale valides tuleb arvestada nii ehitise kui ka muinsuskaitseala arhitektuurilist ja ajaloolist väärtust.",
      "rdfs:label": {
        "@value": "Reg_157878_Par_7 (redaktsioon 157878)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157878",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157878",
      "estleg:sourceAct": "Viljandi vanalinna muinsuskaitseala põhimäärus",
      "estleg:provisionRef": "Reg_157878 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157878_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157878_Par_8_v157878",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157878_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muinsuskaitseala kaitsevööndi hoonestamisel tuleb vältida järske kontraste hoonestuse mastaapsuses muinsuskaitsealal ja vahetult selle piiri ääres ning tagada vanalinna silueti vaadeldavus olulistest vaatepunktidest linnas, vanalinnasuunalistelt tänavatelt ja Viljandi järvelt. Muinsuskaitseala kaitsevööndi hoonestamisel tuleb vältida järske kontraste hoonestuse mastaapsuses muinsuskaitsealal ja vahetult selle piiri ääres ning tagada vanalinna silueti vaadeldavus olulistest vaatepunktidest linnas, vanalinnasuunalistelt tänavatelt ja Viljandi järvelt. 2 (2) Muinsuskaitseameti loata on muinsuskaitseala kaitsevööndis keelatud: 1 1) püstitada välismõõtmete tõttu muinsuskaitseala oluliste vertikaalsete dominantide vaadeldavust häirivaid või olulisi kaugvaateid muinsuskaitsealale varjavaid ehitisi; 2 2) püstitada muinsuskaitseala välispiirile välismõõtmetelt või ehitusmahult muinsuskaitseala või tema välispiiriga vahetult külgneva hoonestuse suhtes mastaapidelt mittesobivaid ehitisi; 3 3) püstitada olulistele vaatesuundadele vanalinnale avanevaid vaateid katvaid või oluliselt varjavaid reklaame, tehnilisi rajatisi või muid konstruktsioone. Muinsuskaitseameti loata on muinsuskaitseala kaitsevööndis keelatud: püstitada välismõõtmete tõttu muinsuskaitseala oluliste vertikaalsete dominantide vaadeldavust häirivaid või olulisi kaugvaateid muinsuskaitsealale varjavaid ehitisi; püstitada muinsuskaitseala välispiirile välismõõtmetelt või ehitusmahult muinsuskaitseala või tema välispiiriga vahetult külgneva hoonestuse suhtes mastaapidelt mittesobivaid ehitisi; püstitada olulistele vaatesuundadele vanalinnale avanevaid vaateid katvaid või oluliselt varjavaid reklaame, tehnilisi rajatisi või muid konstruktsioone.",
      "rdfs:label": {
        "@value": "Reg_157878_Par_8 (redaktsioon 157878)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157878",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157878",
      "estleg:sourceAct": "Viljandi vanalinna muinsuskaitseala põhimäärus",
      "estleg:provisionRef": "Reg_157878 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157878_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157878_Par_9_v157878",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157878_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muinsuskaitsealal paiknevat ehitist võib konserveerida, restaureerida või remontida ainult muinsuskaitse eritingimusi järgiva projekti alusel ja erialaspetsialisti muinsuskaitselise järelevalve all «Muinsuskaitseseaduse» §-s 35 sätestatud tingimustel ja korras. Muinsuskaitsealal paiknevat ehitist võib konserveerida, restaureerida või remontida ainult muinsuskaitse eritingimusi järgiva projekti alusel ja erialaspetsialisti muinsuskaitselise järelevalve all «Muinsuskaitseseaduse» §-s 35 sätestatud tingimustel ja korras. 2 (2) Ehitus-, maaparandus- ja teetöid ning mälestist ohustada võivaid muid töid tehakse Muinsuskaitseameti loal tingimustel, mis tagavad mälestise säilimise. Ehitus-, maaparandus- ja teetöid ning mälestist ohustada võivaid muid töid tehakse Muinsuskaitseameti loal tingimustel, mis tagavad mälestise säilimise. 3 (3) Kui muinsuskaitsealal tööd tehes avastatakse inimtegevuse tagajärjel ladestunud arheoloogiline kultuurkiht, sealhulgas inimluud, või kultuuriväärtusega leid, on tööde tegija kohustatud töö seiskama, säilitama leiukoha muutumatul kujul ning viivitamatult teatama sellest Muinsuskaitseametile ja Viljandi Linnavalitsusele. Kui muinsuskaitsealal tööd tehes avastatakse inimtegevuse tagajärjel ladestunud arheoloogiline kultuurkiht, sealhulgas inimluud, või kultuuriväärtusega leid, on tööde tegija kohustatud töö seiskama, säilitama leiukoha muutumatul kujul ning viivitamatult teatama sellest Muinsuskaitseametile ja Viljandi Linnavalitsusele.",
      "rdfs:label": {
        "@value": "Reg_157878_Par_9 (redaktsioon 157878)",
        "@language": "et"
      },
