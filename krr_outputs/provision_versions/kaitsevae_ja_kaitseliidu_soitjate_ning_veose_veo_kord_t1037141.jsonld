    {
      "@id": "estleg:Reg_1037141_Par_13_v1037141",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037141_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõidukile paigutatud veose veeremise, nihkumise või ümbermineku vältimiseks tuleb veos kinnitada. Kinnitus peab tagama veo ohutuse. Sõidukile paigutatud veose veeremise, nihkumise või ümbermineku vältimiseks tuleb veos kinnitada. Kinnitus peab tagama veo ohutuse. 2 (2) Veose kinnitusvahendi vaba ots ei tohi ripneda või lehvida ega takistada juhi vaadet. Veose kinnitusvahendi vaba ots ei tohi ripneda või lehvida ega takistada juhi vaadet. 3 (3) Veos ei tohi sõidukil liikuda selliselt, et see rikuks sõiduki stabiilsust ja liikumiskindlust, kui sellele mõjuv vähim jõud vastab: 1 1) kiirendusele sõidusuunas 10 m/sek²; 2 2) kiirendusele taha- ja külgsuunas 5 m/sek². Veos ei tohi sõidukil liikuda selliselt, et see rikuks sõiduki stabiilsust ja liikumiskindlust, kui sellele mõjuv vähim jõud vastab: kiirendusele sõidusuunas 10 m/sek²; kiirendusele taha- ja külgsuunas 5 m/sek².",
      "rdfs:label": {
        "@value": "Reg_1037141_Par_13 (redaktsioon 1037141)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037141",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037141",
      "estleg:sourceAct": "Kaitseväe ja Kaitseliidu sõitjate ning veose veo kord",
      "estleg:provisionRef": "Reg_1037141 § 13",
      "estleg:partOfAct": {
