      "estleg:provisionRef": "Reg_1037141 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037141_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037141_Par_29_v1037141",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037141_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevas paragrahvis sätestatut rakendatakse sõidukite kolonnis liikumisele, kui ühtse juhtimise all toimub vähemalt viie sõiduki liiklemine samal marsruudil ja kui sõidukite liikumise ajavahe on alla 10 minuti. Käesolevas paragrahvis sätestatut rakendatakse sõidukite kolonnis liikumisele, kui ühtse juhtimise all toimub vähemalt viie sõiduki liiklemine samal marsruudil ja kui sõidukite liikumise ajavahe on alla 10 minuti. 2 (2) Sõidukite kolonnis liikumisel tuleb võimaluse korral vältida tiheda liiklusega teid tipptunni ajal. Sõidukite kolonnis liikumisel tuleb võimaluse korral vältida tiheda liiklusega teid tipptunni ajal. 3 (3) Sõidukite kolonni sattumisel tiheda liiklusega piirkonda tuleb sõidukite kolonni taha kogunenud sõidukitele võimaldada ohutu möödasõit ja võimaluse korral kasutada sõidukite kolonni liikumiseks muud marsruuti. Sõidukite kolonni sattumisel tiheda liiklusega piirkonda tuleb sõidukite kolonni taha kogunenud sõidukitele võimaldada ohutu möödasõit ja võimaluse korral kasutada sõidukite kolonni liikumiseks muud marsruuti. 4 (4) Lahingumoona veol sõidukite kolonnis peab kolonni ees ja taga sõitma saateauto. Sõidukite kolonni sidevahendid peavad tagama side nii kolonni autode kui ka lähtepunkti või sihtpunkti vahel. Lahingumoona veol sõidukite kolonnis peab kolonni ees ja taga sõitma saateauto. Sõidukite kolonni sidevahendid peavad tagama side nii kolonni autode kui ka lähtepunkti või sihtpunkti vahel.",
      "rdfs:label": {
        "@value": "Reg_1037141_Par_29 (redaktsioon 1037141)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037141",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037141",
      "estleg:sourceAct": "Kaitseväe ja Kaitseliidu sõitjate ning veose veo kord",
      "estleg:provisionRef": "Reg_1037141 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037141_Map"
      }
