    {
      "@id": "estleg:Reg_1037141_Par_10_v1037141",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037141_Par_10"
