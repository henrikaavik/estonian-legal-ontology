    {
      "@id": "estleg:Reg_1039316_Par_6_v1039316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039316_Par_6"
