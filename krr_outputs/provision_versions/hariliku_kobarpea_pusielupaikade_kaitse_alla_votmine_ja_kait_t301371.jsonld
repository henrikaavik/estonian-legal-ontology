      "estleg:provisionRef": "Reg_301371 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301371_Map"
      }
    },
    {
      "@id": "estleg:Reg_301371_Par_3_v301371",
      "@type": [
