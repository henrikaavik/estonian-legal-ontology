      }
    },
    {
      "@id": "estleg:Reg_1009671_Par_11_v1009671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009671_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandus- ja Toiduamet korraldab komisjoni asjaajamist, sealhulgas valmistab ette ja protokollib istungeid ning koostab, edastab ja säilitab komisjoni dokumente. RT I 2022-12-28 1 128122022001 2023-01-01 Põllumajandus- ja Toiduamet korraldab komisjoni asjaajamist, sealhulgas valmistab ette ja protokollib istungeid ning koostab, edastab ja säilitab komisjoni dokumente.",
      "rdfs:label": {
