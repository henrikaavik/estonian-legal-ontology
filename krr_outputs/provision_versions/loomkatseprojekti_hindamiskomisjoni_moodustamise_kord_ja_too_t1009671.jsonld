    {
      "@id": "estleg:Reg_1009671_Par_6_v1009671",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009671_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjon on otsustusvõimeline, kui kohal on vähemalt üheksa liiget või nende asendusliiget, nende hulgas komisjoni esimees või viimase äraolekul komisjoni aseesimees. RT I 2016-05-13 4 113052016004 2016-05-16 Komisjon on otsustusvõimeline, kui kohal on vähemalt üheksa liiget või nende asendusliiget, nende hulgas komisjoni esimees või viimase äraolekul komisjoni aseesimees.",
      "rdfs:label": {
        "@value": "Reg_1009671_Par_6 (redaktsioon 1009671)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009671",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009671",
      "estleg:sourceAct": "Loomkatseprojekti hindamiskomisjoni moodustamise kord ja töökord, loomkatseprojekti loataotluse, loomkatse protokolli ning loomkatse järelhindamise protokolli vormid",
      "estleg:provisionRef": "Reg_1009671 § 6",
