    {
      "@id": "estleg:Reg_1021229_Par_13_v1021229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1021229_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vandetõlgi eksami (edaspidi ka eksam) korraldab Justiits- ja Digiministeerium. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Vandetõlgi eksami (edaspidi ka eksam) korraldab Justiits- ja Digiministeerium. , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Teade vandetõlgi eksami toimumisest avaldatakse Justiits- ja Digiministeeriumi veebilehel vähemalt neli nädalat enne eksami toimumist. Teates avaldatakse vähemalt järgmised andmed: RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 1 1) vandetõlgiks saamisele esitatavad nõuded; 2 2) keel või keeled, mille kohta eksam toimub; 3 3) eksami toimumise kuupäev; 4 4) nõuded eksamil osalemise avaldusele ja lisadokumentidele; 5 5) eksamil osalemise avalduse esitamise tähtpäev. Teade vandetõlgi eksami toimumisest avaldatakse Justiits- ja Digiministeeriumi veebilehel vähemalt neli nädalat enne eksami toimumist. Teates avaldatakse vähemalt järgmised andmed: , Vabariigi Valitsuse seaduse § 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes vandetõlgiks saamisele esitatavad nõuded; keel või keeled, mille kohta eksam toimub; eksami toimumise kuupäev; nõuded eksamil osalemise avaldusele ja lisadokumentidele; eksamil osalemise avalduse esitamise tähtpäev.",
      "rdfs:label": {
        "@value": "Reg_1021229_Par_13 (redaktsioon 1021229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1021229",
