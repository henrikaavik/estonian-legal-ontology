      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vandetõlk esitab hiljemalt iga aasta 1. veebruariks justiitsministrile elektrooniliselt eelneva kalendriaasta tõlgete arvu tõlkesuundade kaupa ning ärakirja ja väljatrüki õigsuse kinnitamiste arvu. Vandetõlk esitab hiljemalt iga aasta 1. veebruariks justiitsministrile elektrooniliselt eelneva kalendriaasta tõlgete arvu tõlkesuundade kaupa ning ärakirja ja väljatrüki õigsuse kinnitamiste arvu.",
      "rdfs:label": {
        "@value": "Reg_1021229_Par_10 (redaktsioon 1021229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1021229",
