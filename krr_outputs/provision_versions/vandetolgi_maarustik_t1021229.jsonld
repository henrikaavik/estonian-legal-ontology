      }
    },
    {
      "@id": "estleg:Reg_1021229_Par_11_v1021229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1021229_Par_11"
