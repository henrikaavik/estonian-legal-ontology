      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Suurupi sihtkaitsevööndis on poollooduslike koosluste esinemisaladel vajalik nende ilme ja liigikoosseisu säilimist tagav tegevus nagu loomade karjatamine, rohu niitmine ning puu- ja põõsarinde harvendamine. Suurupi sihtkaitsevööndis on poollooduslike koosluste esinemisaladel vajalik nende ilme ja liigikoosseisu säilimist tagav tegevus nagu loomade karjatamine, rohu niitmine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_338374_Par_11 (redaktsioon 338374)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "338374",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/338374",
      "estleg:sourceAct": "Suurupi looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_338374 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_338374_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_338374_Par_12_v338374",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_338374_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala maa- ja veeala, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala maa- ja veeala, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Ninamaa piiranguvöönd. Kaitsealal on Ninamaa piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_338374_Par_12 (redaktsioon 338374)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "338374",
