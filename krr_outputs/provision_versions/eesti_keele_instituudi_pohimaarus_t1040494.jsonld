      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "EKI tegevuse korraldab ümber või lõpetab Vabariigi Valitsus valdkonna eest vastutava ministri ettepanekul, kuulanud ära Eesti keelenõukogu ning Teadus- ja Arendusnõukogu arvamuse. EKI tegevuse korraldab ümber või lõpetab Vabariigi Valitsus valdkonna eest vastutava ministri ettepanekul, kuulanud ära Eesti keelenõukogu ning Teadus- ja Arendusnõukogu arvamuse.",
      "rdfs:label": {
