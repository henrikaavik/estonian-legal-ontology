        "@type": "xsd:date"
      },
      "estleg:versionText": "EKI asub Tallinnas. EKI postiaadress on Roosikrantsi 6, 10119 Tallinn. EKI asub Tallinnas. EKI postiaadress on Roosikrantsi 6, 10119 Tallinn.",
      "rdfs:label": {
        "@value": "Reg_1040494_Par_2 (redaktsioon 1040494)",
        "@language": "et"
      },
