      "estleg:provisionRef": "Reg_1040494 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040494_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040494_Par_10_v1040494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040494_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus- ja haldusnõukogu: 1 1) kinnitab EKI üldise töökorralduse ja EKI tegevuse põhisuunad ning valvab nende täitmise järele; 2 2) kinnitab vajaduse korral EKI finantseerimistaotlused ja jätkutaotlused ning nende täitmise aruanded; 3 3) vaatab vajaduse korral läbi tegevuse ja muud aruanded, hindab ja kinnitab need; 4 4) teeb valdkonna eest vastutavale ministrile ettepanekuid EKI põhimääruse muutmiseks; 5 5) valib õigusaktides sätestatud korras EKI akadeemilised töötajad; RT I 2019-06-26 4 126062019004 2019-09-01 6 6) korraldab EKI direktori valimise konkursi; 7 7) teeb ettepanekuid direktorile EKI struktuuri muutmiseks; 8 8) korraldab teadustööde konkursse ja määrab auhindu nende tööde eest; 9 9) esitab kandidaate autasustamisteks ja Eesti Teaduste Akadeemiasse või auametisse valimiseks ning annab vastavaid soovitusi; 10 10) esitab silmapaistvamad uurimused auhindade ja preemiate taotlemiseks; 11 11) teeb ettepaneku EKI väljaannete kolleegiumi moodustamiseks; 12 12) kutsub kokku EKI rahvusvahelise nõukogu; 13 13) täidab muid talle pandud ülesandeid. Teadus- ja haldusnõukogu: kinnitab EKI üldise töökorralduse ja EKI tegevuse põhisuunad ning valvab nende täitmise järele; kinnitab vajaduse korral EKI finantseerimistaotlused ja jätkutaotlused ning nende täitmise aruanded; vaatab vajaduse korral läbi tegevuse ja muud aruanded, hindab ja kinnitab need; teeb valdkonna eest vastutavale ministrile ettepanekuid EKI põhimääruse muutmiseks; valib õigusaktides sätestatud korras EKI akadeemilised töötajad; korraldab EKI direktori valimise konkursi; teeb ettepanekuid direktorile EKI struktuuri muutmiseks; korraldab teadustööde konkursse ja määrab auhindu nende tööde eest; esitab kandidaate autasustamisteks ja Eesti Teaduste Akadeemiasse või auametisse valimiseks ning annab vastavaid soovitusi; esitab silmapaistvamad uurimused auhindade ja preemiate taotlemiseks; teeb ettepaneku EKI väljaannete kolleegiumi moodustamiseks; kutsub kokku EKI rahvusvahelise nõukogu; täidab muid talle pandud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_1040494_Par_10 (redaktsioon 1040494)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040494",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040494",
      "estleg:sourceAct": "Eesti Keele Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1040494 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040494_Map"
      }
