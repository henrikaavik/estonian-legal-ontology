      }
    },
    {
      "@id": "estleg:Reg_304794_Par_2_v304794",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304794_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Järva maakonnas Koigi vallas Koigi ja Prandi külas ning Paide vallas Nurmsi, Seinapalu ja Veskiaru külas. Kaitseala asub Järva maakonnas Koigi vallas Koigi ja Prandi külas ning Paide vallas Nurmsi, Seinapalu ja Veskiaru külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
