      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KAITSE_4_Par_6_v102072013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAITSE_4_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2013. ja 2014. aasta kutsealuste ja naissoost isikute ajateenistusse asumise tähtajad ja nende arvulise jagunemise ajateenijate väljaõppega tegelevate struktuuriüksuste vahel , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „kaitseminister“ sõnadega „valdkonna eest vastutav minister“.",
      "rdfs:label": {
        "@value": "KAITSE_4_Par_6 (redaktsioon 102072013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013008",
      "estleg:supersededByVersion": {
