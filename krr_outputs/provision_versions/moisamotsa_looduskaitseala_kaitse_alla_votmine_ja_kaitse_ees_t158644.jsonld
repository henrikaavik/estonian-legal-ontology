    {
      "@id": "estleg:Reg_158644_Par_4_v158644",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158644_Par_4"
