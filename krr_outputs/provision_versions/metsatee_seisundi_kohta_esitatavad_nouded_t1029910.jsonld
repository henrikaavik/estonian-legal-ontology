        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsatee seisundinõuetele vastavuse üle korraldab järelevalvet metsatee valdaja. Metsatee seisundinõuetele vastavuse üle korraldab järelevalvet metsatee valdaja.",
      "rdfs:label": {
        "@value": "Reg_1029910_Par_3 (redaktsioon 1029910)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029910",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029910",
      "estleg:sourceAct": "Metsatee seisundi kohta esitatavad nõuded",
      "estleg:provisionRef": "Reg_1029910 § 3",
      "estleg:partOfAct": {
