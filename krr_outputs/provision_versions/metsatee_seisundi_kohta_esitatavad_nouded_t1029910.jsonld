      },
      "estleg:versionText": "Käesolev määrus jõustub 2015. aasta 1. juulil. Käesolev määrus jõustub 2015. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "Reg_1029910_Par_10 (redaktsioon 1029910)",
        "@language": "et"
      },
