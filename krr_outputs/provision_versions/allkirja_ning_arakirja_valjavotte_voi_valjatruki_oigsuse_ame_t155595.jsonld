      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisministeeriumi struktuuriüksustena võivad Eesti Vabariigi välisesindused ametlikult kinnitada allkirja õigsust dokumendil, sõltumata sellest, millisele haldusorganile see dokument esitamisele kuulub. Välisministeeriumi struktuuriüksustena võivad Eesti Vabariigi välisesindused ametlikult kinnitada allkirja õigsust dokumendil, sõltumata sellest, millisele haldusorganile see dokument esitamisele kuulub.",
      "rdfs:label": {
        "@value": "Reg_155595_Par_2 (redaktsioon 155595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155595",
      "estleg:sourceAct": "Allkirja ning ärakirja, väljavõtte või väljatrüki õigsuse ametliku kinnitamise õigust omavate haldusorganite määramine",
      "estleg:provisionRef": "Reg_155595 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155595_Map"
      }
    },
    {
      "@id": "estleg:Reg_155595_Par_3_v155595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155595_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maanteeametil on õigus kinnitada allkirja õigsust „Liiklusseaduse“ § 88 lõikes 4 ettenähtud mootorsõiduki kasutamise kirjalikul nõusolekul. RT I 2011-06-21 2 121062011002 2011-07-01 Maanteeametil on õigus kinnitada allkirja õigsust „Liiklusseaduse“ § 88 lõikes 4 ettenähtud mootorsõiduki kasutamise kirjalikul nõusolekul.",
      "rdfs:label": {
        "@value": "Reg_155595_Par_3 (redaktsioon 155595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155595",
      "estleg:sourceAct": "Allkirja ning ärakirja, väljavõtte või väljatrüki õigsuse ametliku kinnitamise õigust omavate haldusorganite määramine",
      "estleg:provisionRef": "Reg_155595 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155595_Map"
      }
    },
    {
      "@id": "estleg:Reg_155595_Par_4_v155595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155595_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisministeeriumi struktuuriüksustena võivad Eesti Vabariigi välisesindused ametlikult kinnitada teise haldusorgani väljastatud dokumendi ärakirja või väljavõtte õigsust või teise haldusorgani peetava automatiseeritud andmekogu väljatrüki õigsust. Välisministeeriumi struktuuriüksustena võivad Eesti Vabariigi välisesindused ametlikult kinnitada teise haldusorgani väljastatud dokumendi ärakirja või väljavõtte õigsust või teise haldusorgani peetava automatiseeritud andmekogu väljatrüki õigsust.",
      "rdfs:label": {
        "@value": "Reg_155595_Par_4 (redaktsioon 155595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155595",
      "estleg:sourceAct": "Allkirja ning ärakirja, väljavõtte või väljatrüki õigsuse ametliku kinnitamise õigust omavate haldusorganite määramine",
      "estleg:provisionRef": "Reg_155595 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155595_Map"
      }
    },
    {
      "@id": "estleg:Reg_155595_Par_4_4_v155595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155595_Par_4_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahandusministeerium võib ametlikult kinnitada Justiitsministeeriumi, Majandus- ja Kommunikatsiooniministeeriumi ning Sotsiaalministeeriumi väljastatud dokumendi ärakirja või väljavõtte õigsust või nimetatud ministeeriumi peetava automatiseeritud andmekogu väljatrüki õigsust. RT I 2017-11-07 10 107112017010 2017-11-10 Rahandusministeerium võib ametlikult kinnitada Justiitsministeeriumi, Majandus- ja Kommunikatsiooniministeeriumi ning Sotsiaalministeeriumi väljastatud dokumendi ärakirja või väljavõtte õigsust või nimetatud ministeeriumi peetava automatiseeritud andmekogu väljatrüki õigsust.",
      "rdfs:label": {
        "@value": "Reg_155595_Par_4_4 (redaktsioon 155595)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155595",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155595",
      "estleg:sourceAct": "Allkirja ning ärakirja, väljavõtte või väljatrüki õigsuse ametliku kinnitamise õigust omavate haldusorganite määramine",
      "estleg:provisionRef": "Reg_155595 § 4_4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155595_Map"
      }
    },
    {
      "@id": "estleg:Reg_155595_Par_5_v155595",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
