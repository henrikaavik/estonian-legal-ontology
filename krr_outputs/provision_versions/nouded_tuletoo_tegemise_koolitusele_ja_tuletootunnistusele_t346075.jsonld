    {
      "@id": "estleg:Reg_346075_Par_9_v346075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346075_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tuletöötunnistus sisaldab järgmisi andmeid: 1 1) tuletöö tegija ees- ja perekonnanime; 2 2) tuletöö tegija isikukoodi; 3 3) tunnistuse väljaandmise kuupäeva; 4 4) tunnistuse kehtivuse kuupäeva; 5 5) tunnistuse väljaandja nimetust ja registrikoodi; RT I 2021-02-02 2 102022021002 2021-03-01 6 6) koolituse tegija nime ning tema kutsetunnistuse numbrit ja kutsetunnistuse kehtivuse aeg; RT I 2021-02-02 2 102022021002 2021-03-01 7 7) tunnistuse numbrit. Tuletöötunnistus sisaldab järgmisi andmeid: tuletöö tegija ees- ja perekonnanime; tuletöö tegija isikukoodi; tunnistuse väljaandmise kuupäeva; tunnistuse kehtivuse kuupäeva; tunnistuse väljaandja nimetust ja registrikoodi; koolituse tegija nime ning tema kutsetunnistuse numbrit ja kutsetunnistuse kehtivuse aeg; tunnistuse numbrit.",
      "rdfs:label": {
