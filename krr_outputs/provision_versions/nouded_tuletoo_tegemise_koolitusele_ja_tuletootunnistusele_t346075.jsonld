    {
      "@id": "estleg:Reg_346075_Par_7_v346075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346075_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tuletöötunnistus tõendab, et tuletöö tegija on edukalt läbinud tuletöö tegemise koolituse ning saanud ettevalmistuse ohutu tuletöö tegemiseks. Tuletöötunnistus tõendab, et tuletöö tegija on edukalt läbinud tuletöö tegemise koolituse ning saanud ettevalmistuse ohutu tuletöö tegemiseks. 2 (2) Koolituse läbinud isikule väljastab koolitaja tuletöötunnistuse. RT I 2021-02-02 2 102022021002 2021-03-01 Koolituse läbinud isikule väljastab koolitaja tuletöötunnistuse.",
      "rdfs:label": {
        "@value": "Reg_346075_Par_7 (redaktsioon 346075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346075",
