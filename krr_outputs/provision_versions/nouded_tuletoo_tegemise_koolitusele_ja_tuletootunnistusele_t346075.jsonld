      }
    },
    {
      "@id": "estleg:Reg_346075_Par_3_v346075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346075_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolitaja on isik, kes korraldab tuletöö tegijale tuletöö tegemise koolitust. RT I 2021-02-02 2 102022021002 2021-03-01 Koolitaja on isik, kes korraldab tuletöö tegijale tuletöö tegemise koolitust. 2 (2) Koolitajal peab olema: 1 1) õpperuum või selle kasutamise võimalus ning muud vahendid teoreetilise õppe läbiviimiseks; 2 2) tulekustutusvahendid või nende kasutamise võimalus praktilise kustutusharjutuse läbiviimiseks; 3 3) koolituse tegija, kellel on kutsestandardi kohaselt tuleohutusspetsialisti 5. taseme kutsetunnistus koos nõutava kompetentsiga või tuleohutuseksperdi 6. taseme kutsetunnistus koos nõutava kompetentsiga. RT I 2021-02-02 2 102022021002 2021-03-01 Koolitajal peab olema: õpperuum või selle kasutamise võimalus ning muud vahendid teoreetilise õppe läbiviimiseks; tulekustutusvahendid või nende kasutamise võimalus praktilise kustutusharjutuse läbiviimiseks; koolituse tegija, kellel on kutsestandardi kohaselt tuleohutusspetsialisti 5. taseme kutsetunnistus koos nõutava kompetentsiga või tuleohutuseksperdi 6. taseme kutsetunnistus koos nõutava kompetentsiga. 3 (3) Koolitaja peab pidama koolitatud isikute kohta arvestust ning säilitama andmeid teadmiste kontrolli tulemuste kohta tunnistuse kehtivusaja jooksul. Koolitaja peab pidama koolitatud isikute kohta arvestust ning säilitama andmeid teadmiste kontrolli tulemuste kohta tunnistuse kehtivusaja jooksul.",
      "rdfs:label": {
        "@value": "Reg_346075_Par_3 (redaktsioon 346075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346075",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346075",
      "estleg:sourceAct": "Nõuded tuletöö tegemise koolitusele ja tuletöötunnistusele",
      "estleg:provisionRef": "Reg_346075 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346075_Map_2026"
      }
