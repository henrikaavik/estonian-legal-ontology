      },
      "estleg:versionText": "Tuletöö tegemise koolituse (edaspidi koolitus) eesmärk on tagada tuletöö tegijale teadmised ja oskused ohutu tuletöö tegemiseks. Tuletöö tegemise koolituse (edaspidi koolitus) eesmärk on tagada tuletöö tegijale teadmised ja oskused ohutu tuletöö tegemiseks.",
      "rdfs:label": {
        "@value": "Reg_346075_Par_2 (redaktsioon 346075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "346075",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/346075",
      "estleg:sourceAct": "Nõuded tuletöö tegemise koolitusele ja tuletöötunnistusele",
      "estleg:provisionRef": "Reg_346075 § 2",
      "estleg:partOfAct": {
