      "estleg:sourceAct": "Nõuded tuletöö tegemise koolitusele ja tuletöötunnistusele",
      "estleg:provisionRef": "Reg_346075 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346075_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_346075_Par_8_v346075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_346075_Par_8"
