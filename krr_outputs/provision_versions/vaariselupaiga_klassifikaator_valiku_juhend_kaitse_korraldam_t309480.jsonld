    {
      "@id": "estleg:Reg_309480_Par_3_v309480",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309480_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vääriselupaigad jagunevad metsa tüübirühmaga seotud tüüpideks ja maastikuelemendiga seotud tüüpideks. Vääriselupaigad jagunevad metsa tüübirühmaga seotud tüüpideks ja maastikuelemendiga seotud tüüpideks.",
      "rdfs:label": {
        "@value": "Reg_309480_Par_3 (redaktsioon 309480)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309480",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309480",
      "estleg:sourceAct": "Vääriselupaiga klassifikaator, valiku juhend, kaitse korraldamine ning vääriselupaiga kaitseks lepingu sõlmimine ja kasutusõiguse tasu arvutamise täpsustatud alused",
