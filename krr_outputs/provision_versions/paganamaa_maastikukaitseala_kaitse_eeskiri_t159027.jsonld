    {
      "@id": "estleg:Reg_159027_Par_12_v159027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159027_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 5–8 sätestatut; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 3 3) uue maaparandussüsteemi rajamine. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 5–8 sätestatut; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_159027_Par_12 (redaktsioon 159027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159027",
      "estleg:sourceAct": "Paganamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159027 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159027_Map"
      }
    },
    {
      "@id": "estleg:Reg_159027_Par_13_v159027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159027_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 3 3) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal, metsamaal ning haritaval maal veekogule lähemal kui 25 meetrit; 4 4) puidu kokku- ja väljavedu külmumata pinnasel; 5 5) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal, metsamaal ning haritaval maal veekogule lähemal kui 25 meetrit; puidu kokku- ja väljavedu külmumata pinnasel; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus.",
      "rdfs:label": {
        "@value": "Reg_159027_Par_13 (redaktsioon 159027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159027",
      "estleg:sourceAct": "Paganamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159027 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159027_Map"
      }
    },
    {
      "@id": "estleg:Reg_159027_Par_14_v159027",
      "@type": [
        "owl:NamedIndividual",
