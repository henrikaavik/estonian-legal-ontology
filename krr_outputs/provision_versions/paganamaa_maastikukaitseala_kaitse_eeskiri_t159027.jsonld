      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_159027_Par_14 (redaktsioon 159027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159027",
      "estleg:sourceAct": "Paganamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159027 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159027_Map"
      }
    },
    {
      "@id": "estleg:Reg_159027_Par_15_v159027",
