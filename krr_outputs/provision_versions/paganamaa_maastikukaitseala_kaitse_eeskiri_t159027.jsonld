    {
      "@id": "estleg:Reg_159027_Par_10_v159027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159027_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paganamaa sihtkaitsevööndi kaitse-eesmärk on Piirioru ja selles paikneva järvedeaheliku, sulglohkude ja metsakoosluste kaitse ning elustiku mitmekesisuse ja maastikuilme säilitamine. Paganamaa sihtkaitsevööndi kaitse-eesmärk on Piirioru ja selles paikneva järvedeaheliku, sulglohkude ja metsakoosluste kaitse ning elustiku mitmekesisuse ja maastikuilme säilitamine. 2 (2) Hintsiko sihtkaitsevööndi kaitse-eesmärk on vanade lehtmetsade ja kasvukohatüübile iseloomuliku liigilise ning vanuselise koosseisu säilitamine ja taastamine. Hintsiko sihtkaitsevööndi kaitse-eesmärk on vanade lehtmetsade ja kasvukohatüübile iseloomuliku liigilise ning vanuselise koosseisu säilitamine ja taastamine.",
      "rdfs:label": {
        "@value": "Reg_159027_Par_10 (redaktsioon 159027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159027",
      "estleg:sourceAct": "Paganamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159027 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159027_Map"
      }
    },
    {
      "@id": "estleg:Reg_159027_Par_11_v159027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159027_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paganamaa piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Paganamaa piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse.",
      "rdfs:label": {
        "@value": "Reg_159027_Par_11 (redaktsioon 159027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159027",
      "estleg:sourceAct": "Paganamaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159027 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159027_Map"
