        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RMUTPPMH_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiita heaks juurdelisatud , mille on valitsustevahelise Euroopa migratsioonikomitee (organisatsiooni eelkäija) vastu võtnud 1953. aasta 19. oktoobril Brüsselis, ning põhikirja muudatused, mis on vastu võetud Rahvusvahelise Migratsiooniorganisatsiooni nõukogu 1998. aasta 24. novembri otsusega.",
      "rdfs:label": {
        "@value": "RMUTPPMH_Par_2 (redaktsioon 818344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "818344"
    },
    {
      "@id": "estleg:RMUTPPMH_Par_3_v818344",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RMUTPPMH_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi esindajad Rahvusvahelise Migratsiooniorganisatsiooni organites ning vajaduse korral nende asendusliikmed ja nõunikud määrab valdkonna eest vastutav minister. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"siseminister\" sõnadega \"valdkonna eest vastutav minister\".",
      "rdfs:label": {
        "@value": "RMUTPPMH_Par_3 (redaktsioon 818344)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "818344"
    }
  ]
