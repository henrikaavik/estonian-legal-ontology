        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda Rahvusvahelise Migratsiooniorganisatsiooniga.",
      "rdfs:label": {
        "@value": "RMUTPPMH_Par_1 (redaktsioon 818344)",
        "@language": "et"
