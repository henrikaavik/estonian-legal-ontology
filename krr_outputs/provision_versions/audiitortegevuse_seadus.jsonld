      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_207"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2010. aasta 8. märtsil. (2) Käesoleva seaduse § 20 lõigetes 2 ja 6 sätestatu jõustub 2014. aasta 1. jaanuaril. (3) Käesoleva seaduse § 75: lõigetes 1 ja 2 sätestatu jõustub 2014. aasta 1. jaanuaril; lõikes 3 sätestatu jõustub 2015. aasta 1. jaanuaril. (4) Käesoleva seaduse § 76 lõikes 4 sätestatu jõustub 2011. aasta 1. oktoobril. (5) Käesoleva seaduse § 81 lõigetes 2 ja 3 sätestatu jõustub 2011. aasta 1. jaanuaril, kehtides majandusaasta aruannete aruandeperioodide kohta, mis algavad 2012. aasta 1. jaanuaril või hiljem. (6) Käesoleva seaduse §-des 91 ja 92 sätestatu jõustub 2011. aasta 1. jaanuaril, kehtides majandusaasta aruannete aruandeperioodide kohta, mis algavad 2010. aasta 1. jaanuaril või hiljem. (7) Käesoleva seaduse § 99 lõike 1: punktis 1 sätestatud nõue jõustub 2010. aasta 1. juulil; punktis 2 sätestatud nõue jõustub 2011. aasta 1. jaanuaril. (8) Käesoleva seaduse § 100 lõikes 1 sätestatud nõue jõustub 2013. aasta 1. jaanuaril. (9) Käesoleva seaduse § 126 lõikes 3 sätestatud kohustus jõustub 2013. aasta 1. jaanuaril. (9¹) 2010. aasta 15. novembril jõustunud paragrahvi 179 redaktsiooni rakendatakse tagasiulatuvalt 2010. aasta 1. juulil alanud liikmemaksu arvestusperioodiks oleva majandusaasta ja käesoleva seaduse § 182 lõikes 1 nimetatud ajavahemikule vastava tegevusaruande perioodi suhtes. (10) Käesoleva seaduse § 191 punkt 2, § 192 punkt 2 ja § 193 punkt 2 jõustuvad 2015. aasta 1. jaanuaril. (11) Käesoleva seaduse § 531 lõikes 4 sätestatu jõustub 2017. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_207 (redaktsioon 123122014008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122014008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122014008",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 207",
