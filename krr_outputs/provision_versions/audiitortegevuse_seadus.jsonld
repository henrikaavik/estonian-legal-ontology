    {
      "@id": "estleg:AUDIIT_Par_60_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_60"
      },
      "estleg:versionValidFrom": {
