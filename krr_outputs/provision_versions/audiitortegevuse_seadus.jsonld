    {
      "@id": "estleg:AUDIIT_Par_5_v22441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Audiitorkogu vara moodustub: audiitorite kohustuslikest liikmemaksudest; distsiplinaarkaristusena laekuvatest trahvidest; audiitorkogu vahendite paigutamisest saadavast tulust; annetustest; muudest laekumistest. (2) Kohustusliku liikmemaksu määra kehtestab audiitorkogu juhatus audiitorkogu põhikirjas ettenähtud korras. (3) Audiitorkogu ei või tagada teiste isikute kohustusi ega anda laenu.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_5 (redaktsioon 22441)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22441",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_5_v13275292"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22441",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 5",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_5_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
