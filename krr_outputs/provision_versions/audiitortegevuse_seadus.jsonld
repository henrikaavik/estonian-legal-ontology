      "estleg:provisionRef": "AUDIIT § 119",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_119_v123122014008",
      "@type": [
        "owl:NamedIndividual",
