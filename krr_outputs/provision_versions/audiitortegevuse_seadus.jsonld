      "estleg:provisionRef": "AUDIIT § 72",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_73_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siseaudiitori aruanne on dokumendina vormistatud siseaudiitori kutsetegevuse aruanne, milles siseaudiitor avaldab oma kutsetegevuse objekti kohta siseaudiitori kutsetegevusega omandatud kindlust väljendava arvamuse või muu kokkuvõtte.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_73 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 73",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_74_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Siseaudiitor allkirjastab siseaudiitori kutsetegevuse lepingu teenuse osutaja poolt ja siseaudiitori aruande enda või esindatava nimel isiklikult. (2) Kutsetegevuseks käesoleva seaduse § 75 lõikes 1 nimetatud ulatuses avaliku sektori üksusega sõlmitava lepingu teenuse osutaja poolne ja siseaudiitori aruande allkirjastaja peab olema avaliku sektori üksuse siseaudiitor või atesteeritud siseaudiitor. (3) Kutsetegevuseks käesoleva seaduse § 75 lõikes 2 nimetatud ulatuses avaliku sektori üksusega sõlmitava lepingu teenuse osutaja poolne ja siseaudiitori aruande allkirjastaja peab olema avaliku sektori siseaudiitor või atesteeritud siseaudiitor. (4) Avaliku sektori üksuses töötav siseaudiitor allkirjastab siseaudiitori aruande isiklikult.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_74 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_74_v123122014008"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 74",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_74_v123122014008",
      "@type": [
