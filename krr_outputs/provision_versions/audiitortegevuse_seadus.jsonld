    {
      "@id": "estleg:AUDIIT_Par_181_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_181"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 64 lõigetes 1 ja 2 sätestatud viimase lõppenud tegevusaruande perioodina käsitatakse seaduse jõustumisel ajavahemikku 2008. aasta 1. juulist 2009. aasta 30. juunini. (2) Käesolevas seaduses sätestatud nõuetele vastavad kohustusliku kutsekindlustuse kindlustuslepingud peavad kehtima hakkama hiljemalt 2010. aasta 1. juulil. (3) Käesoleva paragrahvi lõikes 2 sätestatud kuupäevani kehtivad kohustusliku kutsekindlustuse kindlustuslepingud peavad vastama käesoleva seaduse jõustumiseni kehtinud audiitortegevuse seaduses sätestatud ja selle alusel kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_181 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
