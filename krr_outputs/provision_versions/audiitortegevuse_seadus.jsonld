      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutseeksami sooritanud füüsilisest isikust kolmanda riigi vandeaudiitori ja lepinguriigi vandeaudiitori kutse käesoleva seaduse §-s 3 sätestatuga samaväärseks tunnustamise otsustab Audiitorkogu ettepaneku alusel rahandusminister. Kutse tunnustamist kinnitav märge kantakse registrisse rahandusministri otsuse alusel. (2) Käesoleva paragrahvi lõike 1 kohaselt kutse tunnustamist taotlevale ja tunnustatud kutsega isikule kohaldatakse käesolevas seaduses vandeaudiitori kohta sätestatut. (3) Rahandusminister võib keelduda kutse tunnustamisest, kui kutse tunnustamise taotleja ei vasta käesolevas seaduses vandeaudiitori kohta sätestatud nõuetele. (4) Rahandusministeerium teatab kutse tunnustamisest või sellest keeldumisest vandeaudiitori kutse tunnustamise taotlejale viie tööpäeva jooksul rahandusministri otsuse tegemisest arvates.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_30 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_30_v129062014127"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 30",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_30_v129062014127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutseeksami sooritanud füüsilisest isikust kolmanda riigi vandeaudiitori ja lepinguriigi vandeaudiitori kutse käesoleva seaduse §-s 3 sätestatuga samaväärseks tunnustamise otsustab Audiitorkogu ettepaneku alusel valdkonna eest vastutav minister. Kutse tunnustamist kinnitav märge kantakse registrisse valdkonna eest vastutava ministri otsuse alusel. (2) Käesoleva paragrahvi lõike 1 kohaselt kutse tunnustamist taotlevale ja tunnustatud kutsega isikule kohaldatakse käesolevas seaduses vandeaudiitori kohta sätestatut. (3) Valdkonna eest vastutav minister võib keelduda kutse tunnustamisest, kui kutse tunnustamise taotleja ei vasta käesolevas seaduses vandeaudiitori kohta sätestatud nõuetele. (4) Rahandusministeerium teatab kutse tunnustamisest või sellest keeldumisest vandeaudiitori kutse tunnustamise taotlejale viie tööpäeva jooksul valdkonna eest vastutava ministri otsuse tegemisest arvates.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_30 (redaktsioon 129062014127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014127",
