      "estleg:provisionRef": "AUDIIT § 142",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_143_v13275292",
      "@type": [
