        "@type": "xsd:date"
      },
      "estleg:versionText": "-52. [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "AUDIIT_Par_50 (redaktsioon 184482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184482",
