      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Atesteeritud siseaudiitor on isik, kes on sooritanud kutseeksami siseaudiitori eriosa siseaudiitori atesteerimise alamosa ning kellele valdkonna eest vastutava ministri otsusega on antud siseaudiitori kutse.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_5 (redaktsioon 129062014127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014127",
