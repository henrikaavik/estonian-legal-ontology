      "estleg:provisionRef": "AUDIIT § 1",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_1_v184482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus määrab kindlaks nõuded audiitorile, audiitorieksami sooritamise alused, audiitori kutsetegevuse õiguslikud alused ning audiitorkogu korralduse. (2) Käesolevat seadust ei kohaldata Riigikontrolli auditeerimistegevusele ja Riigikontrolli audiitoritele. (3) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_1 (redaktsioon 184482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184482",
