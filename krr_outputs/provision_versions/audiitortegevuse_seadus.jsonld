      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Distsiplinaarmenetluses on Audiitorkogu liikme distsiplinaarkaristused: märkus; noomitus; rahatrahv või rahatrahv koos täiendavale kutseeksamile suunamisega.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_145 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
