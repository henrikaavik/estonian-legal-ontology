    },
    {
      "@id": "estleg:AUDIIT_Par_37_v22441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Audiitor on kutsetegevuses sõltumatu ja erapooletu ning juhindub üksnes seadusest, auditeerimiseeskirjast, kutse-eetika nõuetest ning audiitorkogu organite otsustest ja soovitustest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_37 (redaktsioon 22441)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22441",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_37_v12880888"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22441",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 37",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_37_v12880888",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Audiitor on kutsetegevuses sõltumatu ja erapooletu ning juhindub üksnes seadusest, auditeerimiseeskirjast, kutse–eetika nõuetest ning audiitorkogu organite otsustest ja soovitustest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_37 (redaktsioon 12880888)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12880888",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_37_v13275292"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12880888",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 37",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_37_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahandusminister võtab siseaudiitori kutse või kutsetaseme ära siseaudiitori avalduse alusel. (2) Rahandusminister otsustab siseaudiitori kutse või kutsetaseme äravõtmise: siseaudiitorile või tema kutsetegevusele käesoleva seaduse §-des 66–75 sätestatu korduva või olulise rikkumise korral; teadvalt valeandmete esitamise korral siseaudiitori kutse või kutsetaseme saamise või säilitamise eesmärgil või tunnustamisel või registrisse kande tegemisel; seadusega siseaudiitorile sätestatud nõuetele mittevastamisel; määratud ajal või ulatuses täiendava kutseeksami sooritamata jätmisel. (3) Otsus siseaudiitori kutse või kutsetaseme äravõtmise kohta peab sisaldama järgmisi andmeid: siseaudiitori nimi ja isikukood või selle puudumisel sünniaeg; siseaudiitori kutse või kutsetaseme andmise otsuse number ja aeg; otsuse tegemise kuupäev; siseaudiitori kutse või kutsetaseme äravõtmise tinginud asjaolud koos viitega käesoleva paragrahvi lõike 2 punktile, mille alusel kutse või kutsetase ära võeti. (4) Käesoleva paragrahvi lõike 2 punktis 1 sätestatud rikkumistele kohaldatakse käesoleva seaduse § 148 lõikes 2 sätestatud aegumistähtaegu. (5) Rahandusministeerium teatab käesoleva paragrahvi lõikes 2 nimetatud otsusest kirjalikult ja viivitamata isikule, kellelt siseaudiitori kutse või kutsetase ära võeti, ning teeb vastava kande registrisse. (6) Atesteeritud siseaudiitori kutse äravõtmisega loetakse selle olemasolul ka avaliku sektori üksuse või ühingu siseaudiitori kutsetase äravõetuks.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_37 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_37_v129062014127"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
