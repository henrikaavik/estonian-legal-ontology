      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Atesteeritud siseaudiitor on isik, kes on sooritanud kutseeksami siseaudiitori eriosa siseaudiitori atesteerimise alamosa ning kellele rahandusministri otsusega on antud siseaudiitori kutse.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_5 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
