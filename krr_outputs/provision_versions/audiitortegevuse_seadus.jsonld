        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse jõustumise aastal algaval liikmemaksu arvestusperioodil on: vandeaudiitori liikmemaksu suurus 64 eurot; tegevusloamaksu määr 1% vandeaudiitori audiitorteenuste summaarsest müügitulust.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_179 (redaktsioon 112112010021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010021",
