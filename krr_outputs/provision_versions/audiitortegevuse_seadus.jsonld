      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 144 lõikes 1 ning lõike 2 punktides 1–8 ja 10 nimetatud süüteo eest võib distsiplinaarkaristuse määrata kolme aasta jooksul süüteo toimepanemise päevast arvates. (2) Käesoleva seaduse § 144 lõike 2 punktis 9 nimetatud süüteo eest võib distsiplinaarkaristuse määrata ühe aasta jooksul süüteo toimepanemise päevast arvates.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_148 (redaktsioon 112112010021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010021",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_148_v130062017006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112112010021",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 148",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_148_v130062017006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § 144 lõikes 1 ning lõike 2 punktides 1–8 ja 10 nimetatud süüteo eest võib distsiplinaarkaristuse määrata kolme aasta jooksul süüteost teadasaamise päevast arvates, kuid mitte hiljem kui seitse aastat pärast süüteo toimepanemist. (2) Käesoleva seaduse § 144 lõike 2 punktis 9 nimetatud süüteo eest võib distsiplinaarkaristuse määrata kahe aasta jooksul süüteo toimepanemise päevast arvates.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_148 (redaktsioon 130062017006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062017006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062017006",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 148",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_149_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Iga süüteo eest võib määrata ainult ühe distsiplinaarkaristuse. (2) Süüteo jätkumine pärast distsiplinaarkaristuse määramist on uus süütegu ja selle eest võib Audiitorkogu liikmele määrata uue distsiplinaarkaristuse. (3) Audiitorkogu liikmele määratud karistus väär- või kuriteo eest ja tema võtmine haldus-, kriminaal- või materiaalsele vastutusele ei takista sama teo eest distsiplinaarkaristuse määramist. (4) Distsiplinaarkaristust raskendav asjaolu on distsiplinaarsüüteo toimepanemise ajal kehtiv distsiplinaarkaristus varasemalt toimepandud distsiplinaarsüüteo eest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_149 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_149_v112112010021"
      },
      "estleg:versionValidTo": {
        "@value": "2010-11-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 149",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_149_v112112010021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Iga süüteo eest võib määrata ainult ühe distsiplinaarkaristuse. (2) Süüteo jätkumine pärast distsiplinaarkaristuse määramist on uus süütegu ja selle eest võib Audiitorkogu liikmele määrata uue distsiplinaarkaristuse. (3) Audiitorkogu liikme võtmine haldus-, kriminaal- või materiaalsele vastutusele ei takista sama teo eest distsiplinaarkaristuse määramist. (4) Distsiplinaarkaristust raskendav asjaolu on distsiplinaarsüüteo toimepanemise ajal kehtiv distsiplinaarkaristus varasemalt toimepandud distsiplinaarsüüteo eest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_149 (redaktsioon 112112010021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112112010021",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 149",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_15_v22441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juhatuse liikmed valivad endi hulgast juhatuse esimehe, kes korraldab juhatuse tööd ja esindab audiitorkogu kõigis õigustoimingutes. (2) Juhatuse esimees sõlmib, muudab ja lõpetab töölepingud audiitorkogu töötajatega.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_15 (redaktsioon 22441)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22441",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_15_v13275292"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22441",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 15",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_15_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eksamikomisjon moodustatakse vähemalt viieliikmelisena. (2) Eksamikomisjoni liikmed ja esimehe nimetab ning kutsub tagasi järelevalvenõukogu. (3) Eksamikomisjoni liikme volituste tähtaeg on kolm aastat eksamikomisjoni liikmeks nimetamisest arvates. (4) Eksamikomisjoni töökord sätestatakse kutseeksami korras. (5) Eksamikomisjoni esimees korraldab eksamikomisjoni tegevust ja selle asjaajamist.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_15 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 15",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_150_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_150"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Distsiplinaarkaristus on kustunud, kui Audiitorkogu liikmele ei ole kahe aasta jooksul karistuse määramise päevast arvates määratud uut distsiplinaarkaristust.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_150 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 150",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_151_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Audiitorkogu liige võib distsiplinaarkaristuse määramise peale esitada kaebuse Tallinna Halduskohtule 30 päeva jooksul talle distsiplinaarkaristuse määramisest teatamise päevast arvates.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_151 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 151",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_152_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_152"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Register on riiklik register, mis sisaldab informatsiooni käesoleva seaduse reguleerimisalasse kuuluvate isikute ja nende tegevuse kohta. (2) Registri pidamise eesmärk ja ülesanded on: informatsiooni avalikkusele kättesaadavaks tegemine; isikute registreerimine ja arvestus, et teostada järelevalvet; info ja dokumentide elektrooniline edastamisvõimalus; eelduste ja võimaluste loomine elektrooniliseks asjaajamiseks.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_152 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 152",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_153_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri asutab ja selle põhimääruse (2) Registrit peetakse elektrooniliselt vandeaudiitorite, audiitorettevõtjate, avaliku sektori vandeaudiitorite, siseaudiitorite, käesoleva seaduse § 30 alusel tunnustatud isikute ja kolmanda riigi vandeaudiitorite kohta. (3) Registri vastutav töötleja on Rahandusministeerium, kes korraldab registri pidamist. (4) Registri volitatud töötleja on Audiitorkogu, mille juhatus ja järelevalvenõukogu teevad registritoiminguid ja kasutavad registris olevaid andmeid, lähtudes käesolevas seaduses sätestatud pädevusest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_153 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_153_v129062014127"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 153",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_153_v129062014127",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri asutab ja selle põhimääruse kehtestab määrusega. (2) Registrit peetakse elektrooniliselt vandeaudiitorite, audiitorettevõtjate, avaliku sektori vandeaudiitorite, siseaudiitorite, käesoleva seaduse § 30 alusel tunnustatud isikute ja kolmanda riigi vandeaudiitorite kohta. (3) Registri vastutav töötleja on Rahandusministeerium, kes korraldab registri pidamist. (4) Registri volitatud töötleja on Audiitorkogu, mille juhatus ja järelevalvenõukogu teevad registritoiminguid ja kasutavad registris olevaid andmeid, lähtudes käesolevas seaduses sätestatud pädevusest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_153 (redaktsioon 129062014127)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014127",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUDIIT_Par_153_v107012025013"
      },
      "estleg:versionValidTo": {
        "@value": "2025-01-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014127",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 153",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_153_v107012025013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri asutab ja selle põhimääruse kehtestab määrusega. (2) Registrit peetakse elektrooniliselt. (3) Registri vastutav töötleja on Rahandusministeerium, kes korraldab registri pidamist. (4) Registri volitatud töötleja on Audiitorkogu, mille juhatus ja järelevalvenõukogu teevad registritoiminguid ja kasutavad registris olevaid andmeid, lähtudes käesolevas seaduses sätestatud pädevusest.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_153 (redaktsioon 107012025013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107012025013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107012025013",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 153",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_154_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrikanne jõustub registrisse kandmise päeval. (2) Kanne kehtib kolmanda isiku suhtes õigena, välja arvatud juhul, kui kolmas isik teadis või pidi teadma, et kanne ei ole õige. Kannet ei peeta kehtivaks õigustoimingute suhtes, mis tehakse kümne tööpäeva jooksul pärast kande tegemist, kui kolmas isik tõendab, et ta kande sisu ei teadnud ega pidanudki teadma. (3) Kui registrisse kandmisele kuuluvaid asjaolusid ei ole registrisse kantud, on neil asjaoludel kolmanda isiku suhtes õiguslik tähendus üksnes juhul, kui kolmas isik neist teadis või pidi teadma. (4) Kohtuotsuse alusel tehtud kandes sisalduvad asjaolud omandavad õigusliku tähenduse kohtuotsuse jõustumisel.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_154 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 154",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_155_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_155"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registris olevate andmete muutumise korral on registri nimekirja kantud isik või teda esindama õigustatud isik kohustatud viivitamata esitama registri infosüsteemi vahendusel uued andmed. (2) Registrile andmete esitamiseks kohustatud isik vastutab esitatud andmete õigsuse eest. (3) Kui registrile esitatakse ebaõigeid andmeid, vastutavad esitatule alla kirjutanud isikud sellega süüliselt tekitatud kahju eest solidaarselt.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_155 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13275292",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 155",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_156_v13275292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrikaardi andmed on avalikud, välja arvatud andmed, mille avaldamisele on seadusega kehtestatud piirangud. (2) Ohu korral isiku tervisele või julgeolekule võib Rahandusministeerium registrikaardile kantud andmete kasutamisele ja avaldamisele kehtestada piiranguid. (3) Tegevusloa peatamist ja taastamist puudutavad registrikaardi andmed on avalikud kolme aasta jooksul tegevusloa taastamist kajastava kande tegemisest arvates. (4) Kehtetuks muutunud ja kehtetuks tunnistatud tegevusloaga isikute registrikaardi andmed on avalikud ühe aasta jooksul tegevusloa kehtivuse lõppemisest või kehtetuks tunnistamise otsuse jõustumisest. (5) Registrikaardi andmed käesoleva seaduse alusel määratud karistuste kohta avalikustatakse vahetult pärast seaduses sätestatud vaide, kaebuse või apellatsiooni esitamise tähtaja möödumist, kui otsust ei ole vaidlustatud. Otsuse vaidlustamise korral lähtutakse edasistest lahenditest ning nendele vaide esitamise tähtaegadest. (6) Registrikaardi andmed käesoleva seaduse alusel määratud karistuste ja tehtud ettekirjutuste kohta on registrikaardil avalikud kolme aasta jooksul vastava kande tegemisest arvates. (7) Igaühel on õigus tutvuda registri nimekirjaga ning saada registrikaardist koopiaid. (8) Registri koosseisu kuuluvad menetlustoimikud ei ole avalikud. (9) Rahandusministeeriumi poolt koopiate või tõendite väljastamise ja muude registriteenuste tasu määrad",
      "rdfs:label": {
        "@value": "AUDIIT_Par_156 (redaktsioon 13275292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13275292",
      "estleg:supersededByVersion": {
