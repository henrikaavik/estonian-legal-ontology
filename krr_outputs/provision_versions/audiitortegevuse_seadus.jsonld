    },
    {
      "@id": "estleg:AUDIIT_Par_5_v107012025013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUDIIT_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Atesteeritud siseaudiitor on isik, kes on sooritanud kutseeksami siseaudiitori eriosa siseaudiitori atesteerimise alamosa ning kellele valdkonna eest vastutava ministri või tema volitatud ministeeriumi ametniku otsusega on antud siseaudiitori kutse.",
      "rdfs:label": {
        "@value": "AUDIIT_Par_5 (redaktsioon 107012025013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107012025013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/107012025013",
      "estleg:sourceAct": "Audiitortegevuse seadus",
      "estleg:provisionRef": "AUDIIT § 5",
      "estleg:partOfAct": {
        "@id": "estleg:AUDIIT_Map"
      }
    },
    {
      "@id": "estleg:AUDIIT_Par_50_v184482",
      "@type": [
