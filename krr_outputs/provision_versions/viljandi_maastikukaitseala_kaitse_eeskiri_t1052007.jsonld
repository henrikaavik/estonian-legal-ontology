    {
      "@id": "estleg:Reg_1052007_Par_13_v1052007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052007_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 24. juuli 2019. a käskkirjaga nr 1-2/19/525 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 24. juuli 2019. a käskkirjaga nr 1-2/19/525 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1052007_Par_13 (redaktsioon 1052007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052007",
      "estleg:sourceAct": "Viljandi maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052007 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052007_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052007_Par_14_v1052007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052007_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1052007_Par_14 (redaktsioon 1052007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052007",
      "estleg:sourceAct": "Viljandi maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052007 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052007_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052007_Par_2_v1052007",
