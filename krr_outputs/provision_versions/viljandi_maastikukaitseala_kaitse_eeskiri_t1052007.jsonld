    {
      "@id": "estleg:Reg_1052007_Par_9_v1052007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052007_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Poollooduslike koosluste esinemisaladel on vajalik nende ilmet ja liigikoosseisu tagav tegevus, nagu rohu niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine või raadamine kaitseala valitsejaga kooskõlastatud ulatuses. Poollooduslike koosluste esinemisaladel on vajalik nende ilmet ja liigikoosseisu tagav tegevus, nagu rohu niitmine, loomade karjatamine, puu- ja põõsarinde kujundamine ja harvendamine või raadamine kaitseala valitsejaga kooskõlastatud ulatuses. 2 (2) Kaitsealal on maastikuvaadete avamiseks ja säilimiseks vajalik puu- ja põõsarinde kujundamine ja harvendamine või raadamine kaitseala valitsejaga kooskõlastatud ulatuses. Kaitsealal on maastikuvaadete avamiseks ja säilimiseks vajalik puu- ja põõsarinde kujundamine ja harvendamine või raadamine kaitseala valitsejaga kooskõlastatud ulatuses.",
      "rdfs:label": {
