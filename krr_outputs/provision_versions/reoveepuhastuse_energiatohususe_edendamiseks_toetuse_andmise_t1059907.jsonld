      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksuse otsuse või toimingu peale võib esitada vaide haldusmenetluse seaduses sätestatud korras. Rakendusüksuse otsuse või toimingu peale võib esitada vaide haldusmenetluse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1059907_Par_20 (redaktsioon 1059907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059907",
      "estleg:sourceAct": "Reoveepuhastuse energiatõhususe edendamiseks toetuse andmise tingimused ja kord",
