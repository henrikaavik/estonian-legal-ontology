      "estleg:provisionRef": "Reg_1059907 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059907_Map"
      }
    },
    {
      "@id": "estleg:Reg_1059907_Par_7_v1059907",
      "@type": [
        "owl:NamedIndividual",
