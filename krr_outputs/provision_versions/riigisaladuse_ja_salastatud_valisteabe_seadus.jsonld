  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_riigisaladuse_ja_salastatud_valisteabe_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigisaladuse ja salastatud välisteabe seadus (266 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigisaladuse ja salastatud välisteabe seadus"
    },
    {
      "@id": "estleg:RSV_Par_1_v12850160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RSV_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse eesmärk on tagada Eesti Vabariigi julgeolek ja välissuhtlemine, kaitstes riigisaladust ja salastatud välisteavet avalikuks tuleku ja juurdepääsuõiguseta isikule teatavaks saamise eest.",
      "rdfs:label": {
        "@value": "RSV_Par_1 (redaktsioon 12850160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850160"
    },
    {
      "@id": "estleg:RSV_Par_10_v12850160",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RSV_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infrastruktuuri ja teabe kaitse riigisaladus on: Vabariigi Presidendi Kantselei, Riigikantselei, julgeolekuasutuse, Kaitseministeeriumi, kaitseväe, Kaitseliidu, Kaitseressursside Ameti ja Välisministeeriumi, sealhulgas välisesinduste valve-, häire-, side- ja infosüsteeme käsitlev teave, välja arvatud käesoleva paragrahvi punktis 2 nimetatud teave ja teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni 30 aastaks; riigisaladuse ja salastatud välisteabe töötlussüsteemi käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse täiesti salajasel või madalamal tasemel kuni 50 aastaks; kaitseväe luure ja vastuluurega tegeleva struktuuriüksuse kasutuses olevaid hooneid ja rajatisi käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni hoone või rajatise valduse lõppemiseni; kaitseväe ja Kaitseliidu relva- ja lahingumoonaladusid käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni relva- või laskemoonalao valduse lõppemiseni; teabevaldaja salastatud teabekandjate evakueerimist käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse täiesti salajasel või madalamal tasemel kuni 20 aastaks; teabevaldaja turvaala valve- ja häiresüsteeme käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni 30 aastaks.",
      "rdfs:label": {
        "@value": "RSV_Par_10 (redaktsioon 12850160)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12850160",
      "estleg:supersededByVersion": {
        "@id": "estleg:RSV_Par_10_v13009805"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RSV_Par_10_v13009805",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RSV_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infrastruktuuri ja teabe kaitse riigisaladus on: Vabariigi Presidendi Kantselei, Riigikantselei, julgeolekuasutuse, Kaitseministeeriumi, kaitseväe, Kaitseliidu, Kaitseressursside Ameti ja Välisministeeriumi, sealhulgas välisesinduste valve-, häire-, side- ja infosüsteeme käsitlev teave, välja arvatud käesoleva paragrahvi punktis 2 nimetatud teave ja teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni 30 aastaks; riigisaladuse ja salastatud välisteabe töötlussüsteemi käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse täiesti salajasel või madalamal tasemel kuni 50 aastaks; kaitseväe korralduse seaduse § 37 lõike 1 punktides 1 ja 2 nimetatud volituste rakendamisega kaitseväeluure ülesannet täitva kaitseväe struktuuriüksuse ja kaitseväeluure ülesannet täitva Kaitseväe Peastaabi struktuuriüksuse kasutuses olevaid hooneid ja rajatisi käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni hoone või rajatise valduse lõppemiseni; kaitseväe ja Kaitseliidu relva- ja lahingumoonaladusid käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni relva- või laskemoonalao valduse lõppemiseni; teabevaldaja salastatud teabekandjate evakueerimist käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse täiesti salajasel või madalamal tasemel kuni 20 aastaks; teabevaldaja turvaala valve- ja häiresüsteeme käsitlev teave, välja arvatud teave, mille avalikuks tulek ei kahjusta Eesti Vabariigi julgeolekut. See teave salastatakse konfidentsiaalsel või madalamal tasemel kuni 30 aastaks.",
      "rdfs:label": {
        "@value": "RSV_Par_10 (redaktsioon 13009805)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13009805",
      "estleg:supersededByVersion": {
        "@id": "estleg:RSV_Par_10_v108112010017"
      },
      "estleg:versionValidTo": {
        "@value": "2010-11-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RSV_Par_10_v108112010017",
      "@type": [
