        "@id": "estleg:RPTS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lapsendamistoetusele on õigus Eestis alaliselt või tähtajalise elamisloaga elaval lapsendajal, kellest lapsendatav laps ei põlvne ja kes ei ole selle lapse võõrasvanem, kui varem ei ole sellele perele sama lapse kohta sünnitoetust makstud. [Lõike 2 sõnastus kuni 31. 12. 2005] (2) Lapsendamistoetust makstakse kahekümnekordses lapsetoetuse määras. [Lõike 2 sõnastus alates 1. 01. 2006] (2) Lapsendamistoetust makstakse 5000 krooni iga lapsendatud lapse kohta.",
      "rdfs:label": {
        "@value": "RPTS_Par_11 (redaktsioon 925534)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "925534",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPTS_Par_11_v1036413"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPTS_Par_11_v1036413",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 07. 2006] (1) Lapsendamistoetusele on õigus Eestis alaliselt või tähtajalise elamisloaga elaval lapsendajal, kellest lapsendatav laps ei põlvne ja kes ei ole selle lapse võõrasvanem, kui varem ei ole sellele perele sama lapse kohta sünnitoetust makstud. [Lõike 1 sõnastus alates 1. 08. 2006] (1) Lapsendamistoetusele on õigus Eestis alaliselt või tähtajalise elamisloaga või tähtajalise elamisõiguse alusel elaval lapsendajal, kellest lapsendatav laps ei põlvne ja kes ei ole selle lapse võõrasvanem, kui varem ei ole sellele perele sama lapse kohta sünnitoetust makstud. (2) Lapsendamistoetust makstakse 5000 krooni iga lapsendatud lapse kohta.",
      "rdfs:label": {
        "@value": "RPTS_Par_11 (redaktsioon 1036413)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036413",
