      }
    },
    {
      "@id": "estleg:RPTS_Par_11_v13317881",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lapsendamistoetusele on õigus Eestis alaliselt või tähtajalise elamisloaga või tähtajalise elamisõiguse alusel elaval lapsendajal, kellest lapsendatav laps ei põlvne ja kes ei ole selle lapse võõrasvanem, kui varem ei ole sellele perele sama lapse kohta sünnitoetust makstud. (2) Lapsendamistoetust makstakse 320 eurot iga lapsendatud lapse kohta.",
      "rdfs:label": {
        "@value": "RPTS_Par_11 (redaktsioon 13317881)",
        "@language": "et"
      },
