    {
      "@id": "estleg:RPTS_Par_9_v104122014006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_9"
      },
      "estleg:versionValidFrom": {
