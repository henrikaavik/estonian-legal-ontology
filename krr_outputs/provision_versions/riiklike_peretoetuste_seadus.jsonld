    },
    {
      "@id": "estleg:RPTS_Par_14_v27376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koolitoetust on õigus saada õppeaasta alustamiseks lapsel, kes vastab käesoleva seaduse § 5 lõikes 1 või 2 sätestatud tingimustele. (2) Koolitoetust makstakse kolmekordses lapsetoetuse määras.",
      "rdfs:label": {
        "@value": "RPTS_Par_14 (redaktsioon 27376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27376"
    },
    {
      "@id": "estleg:RPTS_Par_15_v27376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peretoetusi taotleb lapse ema, isa, eestkostja, hooldaja või: vanema asemel lapsehoolduspuhkust kasutav isik; last kasvatav võõrasvanem või kasuvanem valla- või linnavalitsuse korralduse alusel; hoolekandeasutusest õppimise tõttu eemalviibiv vähemalt 15-aastane vanemliku hoolitsuseta laps; hoolekandeasutusest või erivajadustega laste koolist uude elukohta iseseisvalt elama asunud vanemliku hoolitsuseta olnud isik.",
      "rdfs:label": {
        "@value": "RPTS_Par_15 (redaktsioon 27376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27376",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPTS_Par_15_v849541"
      },
      "estleg:versionValidTo": {
        "@value": "2005-02-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPTS_Par_15_v849541",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-02-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peretoetusi taotleb lapse ema, isa, eestkostja, hooldaja või: vanema asemel lapsehoolduspuhkust kasutav isik; last kasvatav võõrasvanem või kasuvanem valla- või linnavalitsuse korralduse alusel; hoolekandeasutusest õppimise tõttu eemalviibiv vähemalt 15-aastane vanemliku hoolitsuseta laps; hoolekandeasutusest või erivajadustega õpilaste koolist uude elukohta iseseisvalt elama asunud vanemliku hoolitsuseta olnud isik.",
      "rdfs:label": {
        "@value": "RPTS_Par_15 (redaktsioon 849541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "849541",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPTS_Par_15_v12761321"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPTS_Par_15_v12761321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peretoetusi taotleb lapse ema, isa, eestkostja, hooldaja või: vanema asemel lapsehoolduspuhkust kasutav isik; last kasvatav võõrasvanem või kasuvanem valla- või linnavalitsuse korralduse alusel; hoolekandeasutusest õppimise tõttu eemalviibiv vähemalt 15-aastane vanemliku hoolitsuseta laps; hoolekandeasutusest, erivajadustega õpilaste koolist või pärast eestkoste või perekonnas hooldamise lepingu lõppemist uude elukohta iseseisvalt elama asunud vanemliku hoolitsuseta olnud isik.",
      "rdfs:label": {
        "@value": "RPTS_Par_15 (redaktsioon 12761321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12761321",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPTS_Par_15_v122122012016"
      },
      "estleg:versionValidTo": {
        "@value": "2013-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPTS_Par_15_v122122012016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peretoetusi taotleb lapse ema, isa, eestkostja, hooldaja või: vanema asemel lapsehoolduspuhkust kasutav isik; last kasvatav vanema abikaasa või kasuvanem valla- või linnavalitsuse korralduse alusel; last kasvatav vanema abikaasa; hoolekandeasutusest õppimise tõttu eemalviibiv vähemalt 15-aastane vanemliku hoolitsuseta laps; hoolekandeasutusest, erivajadustega õpilaste koolist või pärast eestkoste või perekonnas hooldamise lepingu lõppemist uude elukohta iseseisvalt elama asunud vanemliku hoolitsuseta olnud isik.",
      "rdfs:label": {
        "@value": "RPTS_Par_15 (redaktsioon 122122012016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122012016"
    },
    {
      "@id": "estleg:RPTS_Par_16_v27376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPTS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Peretoetuste taotlemiseks esitatakse järgmised põhidokumendid: avaldus; isikut tõendavate dokumentide seaduse (RT I 1999, 25, 365; 2000, 25, 148; 26, 150; 40, 254; 86, 550; 2001, 16, 68; 31, 173; 56, 338) § 2 lõikes 2 sätestatud dokument; Eestis elav välismaalane peab esitama dokumendi, milles on märge alalise või kehtiva tähtajalise elamisloa kohta, või selle puudumise korral pädeva asutuse kirjaliku tõendi tema seadusliku viibimise kohta Eesti Vabariigis; lapse sünnitunnistus; 16-aastase või vanema õpilase õpilaspilet või õppeasutuse teatis. (2) Peretoetuste taotlemise avalduse vormi ja vajalike lisadokumentide loetelu kehtestab sotsiaalminister. (3) Vajaduse korral on pensioniametil õigus nõuda peretoetuste taotlejalt täiendavaid dokumente. (4) Peretoetuste taotlemiseks esitatakse originaaldokumendid või notariaalselt kinnitatud ärakirjad või väljavõtted. Pensioniamet kinnitab originaaldokumendi koopia, mis jäetakse pensioniametisse. Kõik originaaldokumendid tagastatakse.",
      "rdfs:label": {
        "@value": "RPTS_Par_16 (redaktsioon 27376)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27376",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPTS_Par_16_v186621"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPTS_Par_16_v186621",
