      },
      "estleg:versionText": "Toetuse vahendusasutus on Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi vahendusasutus). Toetuse vahendusasutus on Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi vahendusasutus).",
      "rdfs:label": {
        "@value": "Reg_1055108_Par_5 (redaktsioon 1055108)",
        "@language": "et"
      },
