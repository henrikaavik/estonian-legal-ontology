    {
      "@id": "estleg:Reg_1055108_Par_18_v1055108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055108_Par_18"
