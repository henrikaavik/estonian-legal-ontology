    {
      "@id": "estleg:Reg_1055108_Par_6_v1055108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055108_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vahendusasutuse toimingu või otsuse peale võib enne halduskohtusse kaebuse esitamist esitada vaide haldusmenetluse seaduses sätestatud korras. Vahendusasutuse toimingu või otsuse peale võib enne halduskohtusse kaebuse esitamist esitada vaide haldusmenetluse seaduses sätestatud korras. 2 (2) Vaide lahendab vahendusasutus. Vaide lahendab vahendusasutus. 3 (3) Vaidemenetlusega seotud teave, dokumendid ja vaideotsus toimetatakse vaide esitajale kätte elektrooniliselt. Vaidemenetlusega seotud teave, dokumendid ja vaideotsus toimetatakse vaide esitajale kätte elektrooniliselt.",
      "rdfs:label": {
        "@value": "Reg_1055108_Par_6 (redaktsioon 1055108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055108",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055108",
      "estleg:sourceAct": "Taastekava tootmisettevõtja ärimudeli muutmise toetuse tingimused ja taotlemise kord",
      "estleg:provisionRef": "Reg_1055108 § 6",
      "estleg:partOfAct": {
