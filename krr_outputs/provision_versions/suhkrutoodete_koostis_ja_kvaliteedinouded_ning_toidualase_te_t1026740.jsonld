    {
      "@id": "estleg:Reg_1026740_Par_2_v1026740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026740_Par_2"
