      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163568_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA hindab vastavaks tunnistatud taotlusi «Perioodi 2004–2006 struktuuritoetuse seaduse» § 20 lõike 3 kohaselt. RTL 2009 93 1348 13242066 2010-01-01+02:00 PRIA hindab vastavaks tunnistatud taotlusi «Perioodi 2004–2006 struktuuritoetuse seaduse» § 20 lõike 3 kohaselt. 2 (2) Taotlusi hinnatakse lisas 9 nimetatud hindamiskriteeriumite alusel. Taotlusi hinnatakse lisas 9 nimetatud hindamiskriteeriumite alusel. 3 (3) Taotluste paremusjärjestuse moodustamisel loetakse paremaks kõrgema hindepunktide summa saanud taotlus. Taotluste paremusjärjestuse moodustamisel loetakse paremaks kõrgema hindepunktide summa saanud taotlus. 4 (4) Võrdsete hindepunktidega taotluste korral loetakse paremaks ajaliselt varem esitatud taotlus. RTL 2006 43 773 1030726 2006-05-29+03:00 Võrdsete hindepunktidega taotluste korral loetakse paremaks ajaliselt varem esitatud taotlus.",
      "rdfs:label": {
        "@value": "Reg_163568_Par_17 (redaktsioon 163568)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163568",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163568",
      "estleg:sourceAct": "““Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” meetme 3.4 “Integreeritud maaparandus” tingimused",
