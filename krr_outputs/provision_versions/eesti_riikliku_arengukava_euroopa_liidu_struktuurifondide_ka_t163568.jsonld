    {
      "@id": "estleg:Reg_163568_Par_10_v163568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163568_Par_10"
