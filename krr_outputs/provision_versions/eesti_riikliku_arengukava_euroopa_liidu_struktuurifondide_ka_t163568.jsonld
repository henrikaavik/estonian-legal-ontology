    {
      "@id": "estleg:Reg_163568_Par_2_v163568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163568_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Meetme «Integreeritud maaparandus» (edaspidi meede ) üldeesmärk on luua tingimused integreeritud maa-arenduseks. Meetme «Integreeritud maaparandus» (edaspidi meede ) üldeesmärk on luua tingimused integreeritud maa-arenduseks. 2 (2) Meetme spetsiifilised eesmärgid on: 1 1) vähendada ebasoodsast veerežiimist tingitud riske põllumajandustootmisele; 2 2) suurendada erametsa tootlikkust; 3 3) luua tingimused põllumajandusmaa ja erametsa sihipäraseks kasutamiseks; 4 4) tagada maaparandussüsteemi koosseisu kuuluvate pinnaveekogude hea seisund; 5 5) parandada juurdepääsu põllumajandusmaadele. Meetme spetsiifilised eesmärgid on: vähendada ebasoodsast veerežiimist tingitud riske põllumajandustootmisele; suurendada erametsa tootlikkust; luua tingimused põllumajandusmaa ja erametsa sihipäraseks kasutamiseks; tagada maaparandussüsteemi koosseisu kuuluvate pinnaveekogude hea seisund; parandada juurdepääsu põllumajandusmaadele.",
      "rdfs:label": {
        "@value": "Reg_163568_Par_2 (redaktsioon 163568)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "163568",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/163568",
      "estleg:sourceAct": "““Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks – ühtne programmdokument 2004–2006” meetme 3.4 “Integreeritud maaparandus” tingimused",
      "estleg:provisionRef": "Reg_163568 § 2",
