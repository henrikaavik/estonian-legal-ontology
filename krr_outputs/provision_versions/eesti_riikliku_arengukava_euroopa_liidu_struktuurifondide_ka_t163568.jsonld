      "estleg:provisionRef": "Reg_163568 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_163568_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_163568_Par_7_v163568",
      "@type": [
