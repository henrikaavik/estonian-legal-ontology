        "@language": "et"
      },
      "dc:source": "Haridust tõendava dokumendi plankide ja medalite tellimise, väljastamise, tagastamise ja aruandluse kord"
    },
    {
      "@id": "estleg:Reg_1025191_Par_1_v1025191",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025191_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib üldhariduskooli, kutseõppeasutuse, rakenduskõrgkooli ja ülikooli (edaspidi õppeasutused) lõpetamist tõendavate dokumentide plankide (edaspidi plangid) ning üldhariduskooli hõbe- ja kuldmedalite (edaspidi medalid) tellimist, väljastamist, tagastamist ja aruandlust, sõltumata õppeasutuse õiguslikust vormist. Määrus reguleerib üldhariduskooli, kutseõppeasutuse, rakenduskõrgkooli ja ülikooli (edaspidi õppeasutused) lõpetamist tõendavate dokumentide plankide (edaspidi plangid) ning üldhariduskooli hõbe- ja kuldmedalite (edaspidi medalid) tellimist, väljastamist, tagastamist ja aruandlust, sõltumata õppeasutuse õiguslikust vormist.",
      "rdfs:label": {
        "@value": "Reg_1025191_Par_1 (redaktsioon 1025191)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025191",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025191",
      "estleg:sourceAct": "Haridust tõendava dokumendi plankide ja medalite tellimise, väljastamise, tagastamise ja aruandluse kord",
      "estleg:provisionRef": "Reg_1025191 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025191_Map"
      }
    },
