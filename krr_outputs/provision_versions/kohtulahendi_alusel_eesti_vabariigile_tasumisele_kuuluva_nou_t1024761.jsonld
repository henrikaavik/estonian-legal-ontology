  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kohtulahendi_alusel_eesti_vabariigile_tasumisele_kuuluva_nou_t1024761_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kohtulahendi alusel Eesti Vabariigile tasumisele kuuluva nõude täitmiseks vajalike andmete loetelu ja nende vormistamisele esitatavad tehnilised nõuded (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohtulahendi alusel Eesti Vabariigile tasumisele kuuluva nõude täitmiseks vajalike andmete loetelu ja nende vormistamisele esitatavad tehnilised nõuded"
    },
    {
      "@id": "estleg:Reg_1024761_Par_1_v1024761",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024761_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kohtulahendi alusel Eesti Vabariigile rahasummat tasuma kohustava sellise nõude täitmiseks, mis ei ole tekkinud riigi ega riigi haldusorgani osalemisest kohtus menetlusosalisena, vajalike andmete loetelu ja andmete vormistamisele esitatavad nõuded. Määrusega kehtestatakse kohtulahendi alusel Eesti Vabariigile rahasummat tasuma kohustava sellise nõude täitmiseks, mis ei ole tekkinud riigi ega riigi haldusorgani osalemisest kohtus menetlusosalisena, vajalike andmete loetelu ja andmete vormistamisele esitatavad nõuded.",
      "rdfs:label": {
        "@value": "Reg_1024761_Par_1 (redaktsioon 1024761)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024761",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024761",
      "estleg:sourceAct": "Kohtulahendi alusel Eesti Vabariigile tasumisele kuuluva nõude täitmiseks vajalike andmete loetelu ja nende vormistamisele esitatavad tehnilised nõuded",
      "estleg:provisionRef": "Reg_1024761 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024761_Map"
      }
    },
    {
      "@id": "estleg:Reg_1024761_Par_2_v1024761",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024761_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-s 1 nimetatud nõude täitmiseks on vajalikud järgmised andmed: 1 1) nõude sisu; 2 2) nõude suurus; 3 3) nõude täitmistähtaeg või -tähtajad; 4 4) viitenumber; 5 5) selgitus, mis nõudega on tegemist; 6 6) selle kohtuasja number, millest nõue tuleneb; 7 7) saaja nimi; 8 8) saaja pangakonto number. Käesoleva määruse §-s 1 nimetatud nõude täitmiseks on vajalikud järgmised andmed: nõude sisu; nõude suurus; nõude täitmistähtaeg või -tähtajad; viitenumber; selgitus, mis nõudega on tegemist; selle kohtuasja number, millest nõue tuleneb; saaja nimi; saaja pangakonto number.",
      "rdfs:label": {
        "@value": "Reg_1024761_Par_2 (redaktsioon 1024761)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024761",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024761",
      "estleg:sourceAct": "Kohtulahendi alusel Eesti Vabariigile tasumisele kuuluva nõude täitmiseks vajalike andmete loetelu ja nende vormistamisele esitatavad tehnilised nõuded",
      "estleg:provisionRef": "Reg_1024761 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024761_Map"
      }
    },
    {
      "@id": "estleg:Reg_1024761_Par_3_v1024761",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024761_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Dokumendi, mis lisatakse nõude aluseks olevale kohtulahendile ja milles sisalduvad nõude täitmiseks vajalikud andmed, loob automaatselt kohtute infosüsteem. Dokumendi, mis lisatakse nõude aluseks olevale kohtulahendile ja milles sisalduvad nõude täitmiseks vajalikud andmed, loob automaatselt kohtute infosüsteem. 2 (2) Igale isikule koostatakse temalt kohtulahendi alusel väljamõistetavate nõuete kohta eraldi dokument. Igale isikule koostatakse temalt kohtulahendi alusel väljamõistetavate nõuete kohta eraldi dokument. 3 (3) Dokument, mis lisatakse nõude aluseks olevale kohtulahendile ja milles sisalduvad nõude täitmiseks vajalikud andmed, tehakse kohtu kantselei kaudu avalikult teatavaks ja e-toimiku süsteemi kaudu kättesaadavaks koos lahendiga. Dokument, mis lisatakse nõude aluseks olevale kohtulahendile ja milles sisalduvad nõude täitmiseks vajalikud andmed, tehakse kohtu kantselei kaudu avalikult teatavaks ja e-toimiku süsteemi kaudu kättesaadavaks koos lahendiga.",
      "rdfs:label": {
        "@value": "Reg_1024761_Par_3 (redaktsioon 1024761)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024761",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024761",
      "estleg:sourceAct": "Kohtulahendi alusel Eesti Vabariigile tasumisele kuuluva nõude täitmiseks vajalike andmete loetelu ja nende vormistamisele esitatavad tehnilised nõuded",
      "estleg:provisionRef": "Reg_1024761 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024761_Map"
      }
    },
