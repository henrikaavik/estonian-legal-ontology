      "estleg:versionValidFrom": {
        "@value": "2018-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 27. oktoobri 2017. a käskkirjaga nr 1-2/17/1084 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 27. oktoobri 2017. a käskkirjaga nr 1-2/17/1084 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1045057_Par_21 (redaktsioon 1045057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045057",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045057",
      "estleg:sourceAct": "Tagamõisa looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1045057 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045057_Map"
      }
    },
    {
      "@id": "estleg:Reg_1045057_Par_22_v1045057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045057_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1045057_Par_22 (redaktsioon 1045057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045057",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045057",
      "estleg:sourceAct": "Tagamõisa looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1045057 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045057_Map"
      }
    },
    {
      "@id": "estleg:Reg_1045057_Par_3_v1045057",
      "@type": [
        "owl:NamedIndividual",
