    {
      "@id": "estleg:Reg_157500_Par_1_v157500",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157500_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asbestina käsitatakse käesolevas määruses järgmisi kiuliste silikaatide klassi kuuluvaid mineraale: 1 1) aktinoliit, CAS2 nr 77536-66-4; 2 2) amosiit, CAS nr 12172-73-5; 3 3) antofülliit, CAS nr 77536-67-5; 4 4) kroküdoliit, CAS nr 12001-28-4; 5 5) krüsotiil, CAS nr 12001-29-5; 6 6) tremoliit, CAS nr 77536-68-6. Asbestina käsitatakse käesolevas määruses järgmisi kiuliste silikaatide klassi kuuluvaid mineraale: aktinoliit, CAS2 nr 77536-66-4; amosiit, CAS nr 12172-73-5; antofülliit, CAS nr 77536-67-5; kroküdoliit, CAS nr 12001-28-4; krüsotiil, CAS nr 12001-29-5; tremoliit, CAS nr 77536-68-6. 2 (2) Asbestijäätmetena käsitatakse jäätmeseaduse § 2 lõike 5 alusel kehtestatud määruses koodinumbritega 06 07 01*, 06 13 04*, 10 13 09*, 15 01 11*, 16 01 11*, 16 02 12*, 17 06 01*, 17 06 05*, tähistatud jäätmeid ning muid nimistus nimetatud ja nimetamata jäätmeid, mis on tekkinud asbesti sisaldavatest materjalidest ja toodetest ning sisaldavad lõikes 2 nimetatud mineraale kokku üle 0,1 massiprotsendi. RT I 2015-12-19 1 119122015001 2016-01-01 Asbestijäätmetena käsitatakse jäätmeseaduse § 2 lõike 5 alusel kehtestatud määruses koodinumbritega 06 07 01*, 06 13 04*, 10 13 09*, 15 01 11*, 16 01 11*, 16 02 12*, 17 06 01*, 17 06 05*, tähistatud jäätmeid ning muid nimistus nimetatud ja nimetamata jäätmeid, mis on tekkinud asbesti sisaldavatest materjalidest ja toodetest ning sisaldavad lõikes 2 nimetatud mineraale kokku üle 0,1 massiprotsendi.",
      "rdfs:label": {
        "@value": "Reg_157500_Par_1 (redaktsioon 157500)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157500",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157500",
      "estleg:sourceAct": "Asbesti sisaldavate jäätmete käitlusnõuded",
      "estleg:provisionRef": "Reg_157500 § 1",
      "estleg:partOfAct": {
