      "estleg:sourceAct": "Asbesti sisaldavate jäätmete käitlusnõuded",
      "estleg:provisionRef": "Reg_157500 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157500_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157500_Par_8_v157500",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157500_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui tekib vajadus asbestijäätmete vaheladustamiseks enne nende lõplikku kõrvaldamist, tuleb seda teha tingimustes, mis välistavad ilmastikuoludest, mehhaanilistest ja muudest mõjuteguritest põhjustatud asbestikiu ja -tolmu eraldumise keskkonda. Kui tekib vajadus asbestijäätmete vaheladustamiseks enne nende lõplikku kõrvaldamist, tuleb seda teha tingimustes, mis välistavad ilmastikuoludest, mehhaanilistest ja muudest mõjuteguritest põhjustatud asbestikiu ja -tolmu eraldumise keskkonda.",
      "rdfs:label": {
