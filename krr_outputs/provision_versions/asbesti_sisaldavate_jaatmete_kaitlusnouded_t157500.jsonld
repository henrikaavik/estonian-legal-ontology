      }
    },
    {
      "@id": "estleg:Reg_157500_Par_10_v157500",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157500_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asbestijäätmed ladestatakse ohtlike jäätmete prügilasse, välja arvatud lõikes 2 nimetatud tingimustel. Asbestijäätmed ladestatakse ohtlike jäätmete prügilasse, välja arvatud lõikes 2 nimetatud tingimustel. 2 (2) Asbestijäätmeid võib ladestada tavajäätmete prügilasse vastavalt «Euroopa Nõukogu otsuse 2003/33/EÜ, millega kehtestatakse jäätmete prügilatesse vastuvõtmise kriteeriumid ja kord direktiivi 1999/31/EÜ artikli 16 ja II lisa kohaselt, Lisa punktile 2.3.3 (Euroopa Ühenduse Teataja L 011, 16.01.2003 lk 11–49)». Asbestijäätmeid võib ladestada tavajäätmete prügilasse vastavalt «Euroopa Nõukogu otsuse 2003/33/EÜ, millega kehtestatakse jäätmete prügilatesse vastuvõtmise kriteeriumid ja kord direktiivi 1999/31/EÜ artikli 16 ja II lisa kohaselt, Lisa punktile 2.3.3 (Euroopa Ühenduse Teataja L 011, 16.01.2003 lk 11–49)».",
      "rdfs:label": {
        "@value": "Reg_157500_Par_10 (redaktsioon 157500)",
