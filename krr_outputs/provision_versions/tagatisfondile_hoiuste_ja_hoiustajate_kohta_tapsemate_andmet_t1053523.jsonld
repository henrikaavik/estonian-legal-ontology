      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse Tagatisfondile krediidiasutuse pankroti- või moratooriumihalduri või likvideerija poolt esitatavate hoiustajate ja nende kõlblike hoiuste saldode ning sissenõutavaks muutunud kohustuste andmete täpsem loetelu ja esitamise kord. Määrusega kehtestatakse Tagatisfondile krediidiasutuse pankroti- või moratooriumihalduri või likvideerija poolt esitatavate hoiustajate ja nende kõlblike hoiuste saldode ning sissenõutavaks muutunud kohustuste andmete täpsem loetelu ja esitamise kord.",
      "rdfs:label": {
        "@value": "Reg_1053523_Par_1 (redaktsioon 1053523)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053523",
