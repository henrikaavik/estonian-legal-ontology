      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tagatisfondile hoiuste ja hoiustajate kohta täpsemate andmete esitamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tagatisfondile hoiuste ja hoiustajate kohta täpsemate andmete esitamise kord"
    },
    {
      "@id": "estleg:Reg_1053523_Par_1_v1053523",
      "@type": [
        "owl:NamedIndividual",
