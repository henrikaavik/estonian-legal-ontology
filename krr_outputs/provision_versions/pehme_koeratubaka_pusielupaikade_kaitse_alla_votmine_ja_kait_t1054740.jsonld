    {
      "@id": "estleg:Reg_1054740_Par_15_v1054740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054740_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 15. märtsi 2021. a käskkirjaga nr 1-2/21/132 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 15. märtsi 2021. a käskkirjaga nr 1-2/21/132 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1054740_Par_15 (redaktsioon 1054740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054740",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054740",
      "estleg:sourceAct": "Pehme koeratubaka püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1054740 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054740_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054740_Par_16_v1054740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054740_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1054740_Par_16 (redaktsioon 1054740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054740",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054740",
      "estleg:sourceAct": "Pehme koeratubaka püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1054740 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054740_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054740_Par_2_v1054740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054740_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tartu maakonnas võetakse kaitse alla järgmised püsielupaigad: 1 1) Aru Kastre vallas Metsanurga külas; 2 2) Arupää Tartu vallas Arupää külas; 3 3) Jahiseltsi Kambja vallas Uhti külas; 4 4) Kaagvere Kastre vallas Kaagvere külas; 5 5) Kalda tee Tartu linnas; 6 6) Kobratu Tartu vallas Kobratu külas; 7 7) Lalli Kambja vallas Lalli külas; 8 8) Lepistiku Kastre vallas Kaagvere külas; 9 9) Metsanurga Kastre vallas Metsanurga külas; 10 10) Metsaselli Kastre vallas Kaagvere külas; 11 11) Möllatsi Tartu vallas Möllatsi külas; 12 12) Nõlvaku Tartu linnas ja Luunja vallas Lohkva külas; 13 13) Porioja Kastre vallas Kaagvere ja Metsanurga külas; 14 14) Tila Tartu vallas Vahi alevikus ja Tila külas; 15 15) Vesneri Tartu vallas Vesneri külas. Tartu maakonnas võetakse kaitse alla järgmised püsielupaigad: Aru Kastre vallas Metsanurga külas; Arupää Tartu vallas Arupää külas; Jahiseltsi Kambja vallas Uhti külas; Kaagvere Kastre vallas Kaagvere külas; Kalda tee Tartu linnas; Kobratu Tartu vallas Kobratu külas; Lalli Kambja vallas Lalli külas; Lepistiku Kastre vallas Kaagvere külas; Metsanurga Kastre vallas Metsanurga külas; Metsaselli Kastre vallas Kaagvere külas; Möllatsi Tartu vallas Möllatsi külas; Nõlvaku Tartu linnas ja Luunja vallas Lohkva külas; Porioja Kastre vallas Kaagvere ja Metsanurga külas; Tila Tartu vallas Vahi alevikus ja Tila külas; Vesneri Tartu vallas Vesneri külas. 2 (2) Püsielupaikade ja nende vööndite piirid on kantud kaartidele, mis on esitatud määruse lisas1. 1 Püsielupaikade ja nende vööndite piirid on kantud kaartidele, mis on esitatud määruse lisas1.",
      "rdfs:label": {
        "@value": "Reg_1054740_Par_2 (redaktsioon 1054740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054740",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054740",
      "estleg:sourceAct": "Pehme koeratubaka püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1054740 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054740_Map_2026"
      }
    },
