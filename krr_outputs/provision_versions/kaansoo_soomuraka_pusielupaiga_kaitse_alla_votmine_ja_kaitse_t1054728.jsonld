    {
      "@id": "estleg:Reg_1054728_Par_4_v1054728",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054728_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas2 on põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiri kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas2 on põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiri kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1054728_Par_4 (redaktsioon 1054728)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054728",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054728",
      "estleg:sourceAct": "Kaansoo soomuraka püsielupaiga kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1054728 § 4",
