      "estleg:provisionRef": "Reg_1039314 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039314_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039314_Par_15_v1039314",
      "@type": [
        "owl:NamedIndividual",
