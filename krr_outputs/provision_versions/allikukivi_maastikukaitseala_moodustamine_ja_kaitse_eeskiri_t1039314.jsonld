    {
      "@id": "estleg:Reg_1039314_Par_10_v1039314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039314_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) olemasolevate maaparandussüsteemide hoiutööd ja loodusliku veerežiimi taastamine; 2 2) koosluse kujundamine vastavalt kaitse-eesmärgile; 3 3) olemasolevate ehitiste hooldustööd; 4 4) Koobaste sihtkaitsevööndis tee, tehnovõrgu rajatise või muu tootmisotstarbeta rajatise ehitamine kaitseala või kaitsealal paikneva kinnistu tarbeks; 5 5) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: olemasolevate maaparandussüsteemide hoiutööd ja loodusliku veerežiimi taastamine; koosluse kujundamine vastavalt kaitse-eesmärgile; olemasolevate ehitiste hooldustööd; Koobaste sihtkaitsevööndis tee, tehnovõrgu rajatise või muu tootmisotstarbeta rajatise ehitamine kaitseala või kaitsealal paikneva kinnistu tarbeks; kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus.",
      "rdfs:label": {
        "@value": "Reg_1039314_Par_10 (redaktsioon 1039314)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039314",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039314",
      "estleg:sourceAct": "Allikukivi maastikukaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1039314 § 10",
