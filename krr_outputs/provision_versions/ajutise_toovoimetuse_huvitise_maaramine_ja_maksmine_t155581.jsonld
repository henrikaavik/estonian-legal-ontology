    {
      "@id": "estleg:Reg_155581_Par_11_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärimistunnistusel sisalduvad andmed on kehtestatud «Pärimisseaduse» § 165 lõike 6, § 167 lõike 2 ja § 176 lõike 3 alusel justiitsministri määrusega. RT I 2024-05-07 3 107052024003 2024-05-15 Pärimistunnistusel sisalduvad andmed on kehtestatud «Pärimisseaduse» § 165 lõike 6, § 167 lõike 2 ja § 176 lõike 3 alusel justiitsministri määrusega.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_11 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155581_Par_12_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avaldus hüvitise väljamaksmiseks kindlustatud isiku surma korral sisaldab järgmisi andmeid: 1 1) avalduse esitaja ees- ja perekonnanimi; 2 2) avalduse esitaja isikukood; 3 3) avalduse esitaja elukoht; 4 4) surnud isiku ees- ja perekonnanimi; 5 5) surnud isiku isikukood; 6 6) [kehtetu] 7 7) surnud isiku surmakuupäev; 8 8) avalduse esitaja sugulussuhe surnud isikuga (abikaasa, laps, vend, õde või muu); 9 9) avalduse esitaja pangakonto number, millele hüvitis kantakse; 10 10) viide avaldusele lisatavate dokumentide kohta; 11 11) avalduse esitaja allkiri; 12 12) avalduse vormistamise kuupäev. RTL 2004 119 1845 796821 2004-09-17 Avaldus hüvitise väljamaksmiseks kindlustatud isiku surma korral sisaldab järgmisi andmeid: avalduse esitaja ees- ja perekonnanimi; avalduse esitaja isikukood; avalduse esitaja elukoht; surnud isiku ees- ja perekonnanimi; surnud isiku isikukood; [kehtetu] surnud isiku surmakuupäev; avalduse esitaja sugulussuhe surnud isikuga (abikaasa, laps, vend, õde või muu); avalduse esitaja pangakonto number, millele hüvitis kantakse; viide avaldusele lisatavate dokumentide kohta; avalduse esitaja allkiri; avalduse vormistamise kuupäev.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_12 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
