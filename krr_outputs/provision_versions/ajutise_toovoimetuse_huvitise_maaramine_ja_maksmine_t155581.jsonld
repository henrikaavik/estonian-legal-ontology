    {
      "@id": "estleg:Reg_155581_Par_21_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2010. aasta 1. jaanuarini märgitakse tööandja tõendile ja töövõimetuslehe saatekirjale tööandjana sotsiaalmaksu maksva äriühingu äriregistri kood ja nimi või riigi- ja kohaliku omavalitsuse asutuste riiklikku registrisse kantud asutuse registrikood ja nimi või mittetulundusühingute ja sihtasutuste registrisse kantud juriidilise isiku registrikood ja nimi või äriregistrisse kandmata füüsilisest isikust ettevõtja ees- ja perekonnanimi ja isikukood. RTL 2009 46 642 13188208 2009-07-01 Kuni 2010. aasta 1. jaanuarini märgitakse tööandja tõendile ja töövõimetuslehe saatekirjale tööandjana sotsiaalmaksu maksva äriühingu äriregistri kood ja nimi või riigi- ja kohaliku omavalitsuse asutuste riiklikku registrisse kantud asutuse registrikood ja nimi või mittetulundusühingute ja sihtasutuste registrisse kantud juriidilise isiku registrikood ja nimi või äriregistrisse kandmata füüsilisest isikust ettevõtja ees- ja perekonnanimi ja isikukood.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_21 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155581_Par_22_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Alates 1. jaanuarist 2015. a võib paberil haiguslehe esitada ravikindlustuse seaduse § 52 lõikes 11 sätestatud juhul. Alates 1. jaanuarist 2015. a võib paberil haiguslehe esitada ravikindlustuse seaduse § 52 lõikes 11 sätestatud juhul. 2 (2) Paberil väljakirjutatud töövõimetusleht antakse kindlustatud isikule esitamiseks tööandjale või füüsilisest isikust ettevõtjale, kui töövõimetusleht on antud füüsilisest isikust ettevõtja ettevõtte tegevuses osalevale abikaasale. RT I 2014-12-29 31 129122014031 2015-01-01 80 Paberil väljakirjutatud töövõimetusleht antakse kindlustatud isikule esitamiseks tööandjale või füüsilisest isikust ettevõtjale, kui töövõimetusleht on antud füüsilisest isikust ettevõtja ettevõtte tegevuses osalevale abikaasale.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_22 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155581_Par_3_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hüvitise määramiseks ja maksmiseks vajalikud muud dokumendid on: 1 1) Kehtetu - RT I 2024-05-07 3 107052024003 2024-05-15 2 2) Kehtetu - RT I 2014-12-29 31 129122014031 2015-01-01 80 3 3) tööandja tõend; RTL 2003 40 588 553192 2003-04-01 4 4) Kehtetu – RTL 2004 119 1845 796821 2004-09-17 5 5) Kehtetu – RTL 2009 46 642 13188208 2009-07-01 6 6) andmed tööõnnetuse või kutsehaiguse raporti kohta; RT I 2024-05-07 3 107052024003 2024-05-15 7 7) pärimistunnistus; RTL 2009 46 642 13188208 2009-07-01 8 8) avaldus hüvitise väljamaksmiseks kindlustatud isiku surma korral. 9 9) Kehtetu - RT I 2014-12-29 31 129122014031 2015-01-01 80 Hüvitise määramiseks ja maksmiseks vajalikud muud dokumendid on: Kehtetu - Kehtetu - tööandja tõend; Kehtetu – Kehtetu – andmed tööõnnetuse või kutsehaiguse raporti kohta; pärimistunnistus; avaldus hüvitise väljamaksmiseks kindlustatud isiku surma korral. Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_155581_Par_3 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155581_Par_4_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töövõimetusleht sisaldab «Ravikindlustuse seaduse» § 52 lõike 4 alusel kehtestatud korras toodud andmeid. Töövõimetusleht sisaldab «Ravikindlustuse seaduse» § 52 lõike 4 alusel kehtestatud korras toodud andmeid.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_4 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 4",
