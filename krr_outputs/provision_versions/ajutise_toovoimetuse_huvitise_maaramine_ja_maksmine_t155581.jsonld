    },
    {
      "@id": "estleg:Reg_155581_Par_5_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksu- ja Tolliamet väljastab infosüsteemide andmevahetuskihi (X-tee) liidese kaudu hüvitise määramiseks järgmisi andmeid: 1 1) Tervisekassa päringus esitatud kalendriaastal makstud ja arvestatud sotsiaalmaksu summa sotsiaalmaksu maksjate kaupa; 2 2) füüsilisest isikust ettevõtja puhul märge, kas on kohustus maksta sotsiaalmaksu avansilisi makseid Tervisekassa päringus esitatud päeval. RT I 2014-12-29 31 129122014031 2015-01-01 80 Maksu- ja Tolliamet väljastab infosüsteemide andmevahetuskihi (X-tee) liidese kaudu hüvitise määramiseks järgmisi andmeid: Tervisekassa päringus esitatud kalendriaastal makstud ja arvestatud sotsiaalmaksu summa sotsiaalmaksu maksjate kaupa; füüsilisest isikust ettevõtja puhul märge, kas on kohustus maksta sotsiaalmaksu avansilisi makseid Tervisekassa päringus esitatud päeval.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_5 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155581_Par_6_v155581",
