    },
    {
      "@id": "estleg:Reg_155581_Par_7_7_v155581",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155581_Par_7_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja tõend sisaldab järgmisi andmeid: 1 1) tööandjana sotsiaalmaksu maksva äriühingu äriregistri kood ja nimi või riigi- ja kohaliku omavalitsuse asutuste riiklikku registrisse kantud asutuse registrikood ja nimi või mittetulundusühingute ja sihtasutuste registrisse kantud juriidilise isiku registrikood ja nimi või äriregistrisse kantud füüsilisest isikust ettevõtja äriregistri kood ning notari ja kohtutäituri ees- ja perekonnanimi ja isikukood; RT I 2024-05-07 3 107052024003 2024-05-15 2 2) kindlustatud isiku ees- ja perekonnanimi; 3 3) kindlustatud isiku isikukood; 4 4) kindlustatud isiku keskmise või kokkulepitud töötasu suurus eurodes esmasele töövõimetuslehele märgitud töövabastuse alguspäevale eelnenud päeval; RT I 2025-12-20 2 120122025002 2025-12-23 5 5) fakt, kas kindlustatud isikule anti terviseseisundile vastav töö või viidi ta kergemale tööle üle, selle periood ja perioodil makstav töötasu; RT I 2024-05-07 3 107052024003 2024-05-15 5 5¹) Kehtetu – RTL 2009 46 642 13188208 2009-07-01 6 6) «Ravikindlustuse seaduse» § 60 lõikes 2 või 4 või § 61 lõikes 2 nimetatud põhjus, millest tulenevalt kindlustatud isikul puudub õigus hüvitisele ning periood; RT I 2024-05-07 3 107052024003 2024-05-15 7 7) tõendi vormistamise kuupäev; 8 8) tööandja nimi või tema määratud isiku ees- ja perekonnanimi, ametikoht ning allkiri; 9 9) koostaja ees- ja perekonnanimi ning sidevahendite numbrid. Tööandja tõend sisaldab järgmisi andmeid: tööandjana sotsiaalmaksu maksva äriühingu äriregistri kood ja nimi või riigi- ja kohaliku omavalitsuse asutuste riiklikku registrisse kantud asutuse registrikood ja nimi või mittetulundusühingute ja sihtasutuste registrisse kantud juriidilise isiku registrikood ja nimi või äriregistrisse kantud füüsilisest isikust ettevõtja äriregistri kood ning notari ja kohtutäituri ees- ja perekonnanimi ja isikukood; kindlustatud isiku ees- ja perekonnanimi; kindlustatud isiku isikukood; kindlustatud isiku keskmise või kokkulepitud töötasu suurus eurodes esmasele töövõimetuslehele märgitud töövabastuse alguspäevale eelnenud päeval; fakt, kas kindlustatud isikule anti terviseseisundile vastav töö või viidi ta kergemale tööle üle, selle periood ja perioodil makstav töötasu; Kehtetu – «Ravikindlustuse seaduse» § 60 lõikes 2 või 4 või § 61 lõikes 2 nimetatud põhjus, millest tulenevalt kindlustatud isikul puudub õigus hüvitisele ning periood; tõendi vormistamise kuupäev; tööandja nimi või tema määratud isiku ees- ja perekonnanimi, ametikoht ning allkiri; koostaja ees- ja perekonnanimi ning sidevahendite numbrid.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_7_7 (redaktsioon 155581)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155581",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155581",
      "estleg:sourceAct": "Ajutise töövõimetuse hüvitise määramine ja maksmine",
      "estleg:provisionRef": "Reg_155581 § 7_7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155581_Map_2026"
      }
    },
