        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. oktoobril 2002. a. Määrus jõustub 1. oktoobril 2002. a.",
      "rdfs:label": {
        "@value": "Reg_155581_Par_20 (redaktsioon 155581)",
