    {
      "@id": "estleg:Reg_1035770_Par_3_v1035770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035770_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitõendil on sinise ja punase värvi kombinatsioonis turvamuster, mille põhjal on värviline väikese riigivapi kujutis. Ametitõendil on sinise ja punase värvi kombinatsioonis turvamuster, mille põhjal on värviline väikese riigivapi kujutis. 2 (2) Ametitõendi tagaküljel on järgmised tekstid ja andmeväljad: 1 1) suurtähtedega tekst „POLITSEIAMETNIKU AMETITÕEND” ja „POLICE IDENTIFICATION CARD”; 2 2) ametitõendi number / Identification number; 3 3) suurtähtedega tekst „EESTI VABARIIK” ja „REPUBLIC OF ESTONIA”. Ametitõendi tagaküljel on järgmised tekstid ja andmeväljad: suurtähtedega tekst „POLITSEIAMETNIKU AMETITÕEND” ja „POLICE IDENTIFICATION CARD”; ametitõendi number / Identification number; suurtähtedega tekst „EESTI VABARIIK” ja „REPUBLIC OF ESTONIA”.",
      "rdfs:label": {
        "@value": "Reg_1035770_Par_3 (redaktsioon 1035770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035770",
      "estleg:sourceAct": "Politseiametniku ametitõendi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1035770 § 3",
      "estleg:partOfAct": {
