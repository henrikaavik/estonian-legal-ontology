      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Püsiksannika püsielupaikade kaitse alla võtmine ja kaitse-eeskiri (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "Püsiksannika püsielupaikade kaitse alla võtmine ja kaitse-eeskiri"
