    {
      "@id": "estleg:Reg_1051695_Par_18_v1051695",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051695_Par_18"
