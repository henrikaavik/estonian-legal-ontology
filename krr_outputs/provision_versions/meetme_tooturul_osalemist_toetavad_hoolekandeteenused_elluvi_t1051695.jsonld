        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksuse otsuse või toimingu vaide menetleja on rakendusüksus. Rakendusüksuse otsuse või toimingu vaide menetleja on rakendusüksus.",
      "rdfs:label": {
        "@value": "Reg_1051695_Par_4 (redaktsioon 1051695)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051695",
