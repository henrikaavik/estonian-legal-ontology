      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HALDUS_Par_27_v768417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HALDUS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "HALDUS_Par_27 (redaktsioon 768417)",
        "@language": "et"
      },
