      },
      "estleg:versionValidTo": {
        "@value": "2005-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HALDUS_Par_96_v782731",
      "@type": [
        "owl:NamedIndividual",
