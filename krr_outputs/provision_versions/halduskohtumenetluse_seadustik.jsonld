      },
      "estleg:versionValidTo": {
        "@value": "2006-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HALDUS_Par_102_v1047494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
