    {
      "@id": "estleg:HALDUS_Par_102_v22448",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HALDUS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni 2001. aasta 1. jaanuarini on halduskohtuks lisaks käesoleva seadustiku paragrahvis 2 sätestatule ka maa- ja linnakohtute juures tegutsevad halduskohtunikud. (2) Kuni 2001. aasta 1. jaanuarini ei kohaldata käesoleva seadustiku paragrahv 19 lõiget 3.",
      "rdfs:label": {
        "@value": "HALDUS_Par_102 (redaktsioon 22448)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22448",
