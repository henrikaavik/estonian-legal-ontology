      }
    },
    {
      "@id": "estleg:HALDUS_Par_102_v128122011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HALDUS_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja läbivaatamise kulud on: tunnistaja-, eksperdi- ja tõlgikulud; dokumentaalse tõendi ja asitõendi saamise kulud; vaatluse kulud, sealhulgas sellega seotud vajalikud kohtu sõidukulud; menetlusdokumentide kohtutäituri vahendusel ning välisriigis ja eksterritoriaalselt Eesti Vabariigi kodanikele kättetoimetamise ja edastamise ning menetlusdokumentide väljastamise kulud; väljaandes Ametlikud Teadaanded või muul viisil kutse või teate avaldamise kulud.",
      "rdfs:label": {
        "@value": "HALDUS_Par_102 (redaktsioon 128122011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011007"
    },
    {
      "@id": "estleg:HALDUS_Par_103_v22448",
