    {
      "@id": "estleg:Reg_340435_Par_16_v340435",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_340435_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kuni 2010. aasta 1. jaanuarini tunnistusi väljastanud asutustele võimaldatakse juurdepääs nende poolt registrisse kantud andmetele. Kuni 2010. aasta 1. jaanuarini tunnistusi väljastanud asutustele võimaldatakse juurdepääs nende poolt registrisse kantud andmetele. 2 (2) Enne 2010. aasta 1. jaanuari registrisse kantud andmete kohta esitatud päringule võib vastata registrisse andmed kandnud asutus. Enne 2010. aasta 1. jaanuari registrisse kantud andmete kohta esitatud päringule võib vastata registrisse andmed kandnud asutus.",
      "rdfs:label": {
        "@value": "Reg_340435_Par_16 (redaktsioon 340435)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "340435",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/340435",
      "estleg:sourceAct": "Tunnistuste (apostille'de) registri põhimäärus",
      "estleg:provisionRef": "Reg_340435 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_340435_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_340435_Par_2_v340435",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_340435_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri pidamise eesmärk on: 1 1) väljastatud tunnistuste (apostille’de) (edaspidi tunnistus) üle arvestuse pidamine; 2 2) tunnistusele kantud andmete säilitamine, et vajaduse korral teha kindlaks tunnistusele kantud andmete vastavus registris sisalduvatele andmetele; 3 3) tunnistuse koostamise hõlbustamine; 4 4) allkirja- ja pitserinäidiste säilitamine; 5 5) tunnistusega kinnitatud dokumentide ja e-apostille’de säilitamine; 6 6) isikul ja dokumendi väljastanud asutusel dokumendi tunnistusega kinnitamiseks esitamise võimaldamine; 7 7) väljastatud tunnistuse ja kontrollijale kättesaadavaks tehtud tunnistusega kinnitatud dokumendi kehtivuse kontrollimise võimaldamine. RT I 2017-11-28 46 128112017046 2017-12-01 Registri pidamise eesmärk on: väljastatud tunnistuste (apostille’de) (edaspidi tunnistus) üle arvestuse pidamine; tunnistusele kantud andmete säilitamine, et vajaduse korral teha kindlaks tunnistusele kantud andmete vastavus registris sisalduvatele andmetele; tunnistuse koostamise hõlbustamine; allkirja- ja pitserinäidiste säilitamine; tunnistusega kinnitatud dokumentide ja e-apostille’de säilitamine; isikul ja dokumendi väljastanud asutusel dokumendi tunnistusega kinnitamiseks esitamise võimaldamine; väljastatud tunnistuse ja kontrollijale kättesaadavaks tehtud tunnistusega kinnitatud dokumendi kehtivuse kontrollimise võimaldamine.",
      "rdfs:label": {
        "@value": "Reg_340435_Par_2 (redaktsioon 340435)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "340435",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/340435",
      "estleg:sourceAct": "Tunnistuste (apostille'de) registri põhimäärus",
      "estleg:provisionRef": "Reg_340435 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_340435_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_340435_Par_3_v340435",
