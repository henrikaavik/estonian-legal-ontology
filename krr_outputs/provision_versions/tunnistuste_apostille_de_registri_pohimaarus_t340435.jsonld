        "@value": "2017-11-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri turvaklass on K1T1S1 ja turbeaste madal (L). Registri turvaklass on K1T1S1 ja turbeaste madal (L).",
      "rdfs:label": {
        "@value": "Reg_340435_Par_5 (redaktsioon 340435)",
        "@language": "et"
      },
