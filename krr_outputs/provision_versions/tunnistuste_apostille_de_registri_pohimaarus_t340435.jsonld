        "@value": "2017-11-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Register likvideeritakse justiitsministri määrusega kooskõlas „Avaliku teabe seaduses” ja „Arhiiviseaduses” sätestatud nõuetega. Register likvideeritakse justiitsministri määrusega kooskõlas „Avaliku teabe seaduses” ja „Arhiiviseaduses” sätestatud nõuetega.",
      "rdfs:label": {
        "@value": "Reg_340435_Par_15 (redaktsioon 340435)",
        "@language": "et"
      },
