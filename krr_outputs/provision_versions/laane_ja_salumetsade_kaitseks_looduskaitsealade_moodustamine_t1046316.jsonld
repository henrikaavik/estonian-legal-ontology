        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala metsakoosluste loodusliku ilme taastamiseks on vajalik puu- ja põõsarinde kujundamine. Kaitseala metsakoosluste loodusliku ilme taastamiseks on vajalik puu- ja põõsarinde kujundamine.",
      "rdfs:label": {
        "@value": "Reg_1046316_Par_8 (redaktsioon 1046316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046316",
