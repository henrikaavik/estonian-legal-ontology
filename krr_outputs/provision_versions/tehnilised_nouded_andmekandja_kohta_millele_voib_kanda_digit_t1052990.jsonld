  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tehnilised_nouded_andmekandja_kohta_millele_voib_kanda_digit_t1052990_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tehnilised nõuded andmekandja kohta, millele võib kanda digitaalse dokumendi või dokumendi digitaalsed andmed (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tehnilised nõuded andmekandja kohta, millele võib kanda digitaalse dokumendi või dokumendi digitaalsed andmed"
    },
    {
      "@id": "estleg:Reg_1052990_Par_1_v1052990",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052990_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekandja, millele võib kanda digitaalse dokumendi või dokumendi digitaalsed andmed (edaspidi andmekandja), peab vastama järgmistele nõuetele: 1 1) andmeandja tehnilised omadused tagavad sellele kantud andmete terviklikkuse, autentsuse ja konfidentsiaalsuse; 2 2) tagab andmete säilimise vähemalt andmekandjale kantud või sellega seotud sertifikaatide kehtivusaja jooksul; 3 3) on lahutatav seadmest, kus teostatakse operatsioone digitaalse dokumendiga; 4 4) tagab piisava vastupidavuse igapäevase kasutamise juures; 5 5) omab standardiseeritud andmevahetusliidest; 6 6) võimaldab andmete lugemist ja kirjutamist krüpteeritud andmevahetuskanali kaudu; 7 7) on ühilduv ning võimaldab vastava digitaalse dokumendi kasutamist olemasolevas infrastruktuuris; 8 8) kui andmekandja tehnilised omadused võimaldavad sellele rakenduste lisamist ja kustutamist, siis toimub see digitaalse dokumendi väljaandja kontrolli all. Andmekandja, millele võib kanda digitaalse dokumendi või dokumendi digitaalsed andmed (edaspidi andmekandja), peab vastama järgmistele nõuetele: andmeandja tehnilised omadused tagavad sellele kantud andmete terviklikkuse, autentsuse ja konfidentsiaalsuse; tagab andmete säilimise vähemalt andmekandjale kantud või sellega seotud sertifikaatide kehtivusaja jooksul; on lahutatav seadmest, kus teostatakse operatsioone digitaalse dokumendiga; tagab piisava vastupidavuse igapäevase kasutamise juures; omab standardiseeritud andmevahetusliidest; võimaldab andmete lugemist ja kirjutamist krüpteeritud andmevahetuskanali kaudu; on ühilduv ning võimaldab vastava digitaalse dokumendi kasutamist olemasolevas infrastruktuuris; kui andmekandja tehnilised omadused võimaldavad sellele rakenduste lisamist ja kustutamist, siis toimub see digitaalse dokumendi väljaandja kontrolli all.",
      "rdfs:label": {
        "@value": "Reg_1052990_Par_1 (redaktsioon 1052990)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052990",
