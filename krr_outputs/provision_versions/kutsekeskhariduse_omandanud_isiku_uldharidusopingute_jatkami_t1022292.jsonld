      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kutsekeskhariduse omandanud isiku üldharidusõpingute jätkamise tingimused ja kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kutsekeskhariduse omandanud isiku üldharidusõpingute jätkamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1022292_Par_1_v1022292",
      "@type": [
