        "@value": "Sätete redaktsioonid: Päästeteenistuja ametitõendi ja päästeametniku ametimärgi kirjeldus ja vorm (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Päästeteenistuja ametitõendi ja päästeametniku ametimärgi kirjeldus ja vorm"
    },
    {
      "@id": "estleg:Reg_1040318_Par_1_v1040318",
      "@type": [
        "owl:NamedIndividual",
