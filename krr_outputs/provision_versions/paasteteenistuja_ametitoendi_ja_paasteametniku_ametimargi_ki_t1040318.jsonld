      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040318_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Päästeameti päästeteenistuja ametitõend (edaspidi ametitõend) on valge plastikust valmistatud kaart mõõtmetega 85,6 millimeetrit × 53,98 millimeetrit. RT I 2026-02-20 5 120022026005 2026-02-23 Päästeameti päästeteenistuja ametitõend (edaspidi ametitõend) on valge plastikust valmistatud kaart mõõtmetega 85,6 millimeetrit × 53,98 millimeetrit. 2 (2) Ametitõendi kujutis on esitatud määruse lisas 1. Ametitõendi kujutis on esitatud määruse lisas 1.",
      "rdfs:label": {
        "@value": "Reg_1040318_Par_1 (redaktsioon 1040318)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040318",
