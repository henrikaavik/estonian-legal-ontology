      }
    },
    {
      "@id": "estleg:Reg_1035314_Par_6_v1035314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035314_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-06-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Autoriõiguse seaduse § 7916 lõike 3 punktis 4 nimetatud eriaruanne peab sisaldama järgmist: 1 1) sotsiaal-, kultuuri- ja haridusteenuste osutamise eesmärgil majandusaasta jooksul õigustest saadavast tasust ning selle investeerimisest tekkinud tulust maha arvatud summad eesmärgiliikide kaupa ning iga eesmärgiliigi puhul teostatavate õiguste kategooriate ja kasutusliikide kaupa, sealhulgas sotsiaal-, kultuuri- ja haridusteenuste rahastamiseks mahaarvatud haldustasude summad; 2 2) sotsiaal-, kultuuri- ja haridusteenusteks kasutatud eraldi summad. Autoriõiguse seaduse § 7916 lõike 3 punktis 4 nimetatud eriaruanne peab sisaldama järgmist: sotsiaal-, kultuuri- ja haridusteenuste osutamise eesmärgil majandusaasta jooksul õigustest saadavast tasust ning selle investeerimisest tekkinud tulust maha arvatud summad eesmärgiliikide kaupa ning iga eesmärgiliigi puhul teostatavate õiguste kategooriate ja kasutusliikide kaupa, sealhulgas sotsiaal-, kultuuri- ja haridusteenuste rahastamiseks mahaarvatud haldustasude summad; sotsiaal-, kultuuri- ja haridusteenusteks kasutatud eraldi summad.",
      "rdfs:label": {
        "@value": "Reg_1035314_Par_6 (redaktsioon 1035314)",
        "@language": "et"
      },
