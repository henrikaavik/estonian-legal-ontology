      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": ", rakendatakse tagasiulatuvalt alates 1. juunist 2021. a. 1 (1) Määrus jõustub 1. juunil 2011. a. Määrus jõustub 1. juunil 2011. a. 2 (2) Määruse 2021. aasta juunis vastu võetud muudatusi rakendatakse tagasiulatuvalt alates 1. juunist 2021. a. RT I 2021-06-09 13 109062021013 2021-06-12 Määruse 2021. aasta juunis vastu võetud muudatusi rakendatakse tagasiulatuvalt alates 1. juunist 2021. a.",
      "rdfs:label": {
