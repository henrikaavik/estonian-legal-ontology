      }
    },
    {
      "@id": "estleg:Reg_1052083_Par_3_v1052083",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052083_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui taotleja jätab esitamata §-s 1 nõutud andmed või taotluses esineb muid puudusi, määrab Kliimaministeerium taotlejale esimesel võimalusel tähtaja puuduste kõrvaldamiseks. RT I 2023-07-05 7 105072023007 2023-07-08 Kui taotleja jätab esitamata §-s 1 nõutud andmed või taotluses esineb muid puudusi, määrab Kliimaministeerium taotlejale esimesel võimalusel tähtaja puuduste kõrvaldamiseks. 2 (2) Kui puudust ei kõrvaldata tähtaegselt, jätab Kliimaministeerium taotluse läbi vaatamata. RT I 2023-07-05 7 105072023007 2023-07-08 Kui puudust ei kõrvaldata tähtaegselt, jätab Kliimaministeerium taotluse läbi vaatamata.",
