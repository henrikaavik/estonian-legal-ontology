  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kriminaalhooldusametniku_taiendavate_kvalifikatsiooninouete__t157694_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kriminaalhooldusametniku täiendavate kvalifikatsiooninõuete kehtestamine ning tööülesannete loetelu, mille täitmisel ei pea ametnikul olema vastavat rakenduslikku või akadeemilist kõrgharidust (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kriminaalhooldusametniku täiendavate kvalifikatsiooninõuete kehtestamine ning tööülesannete loetelu, mille täitmisel ei pea ametnikul olema vastavat rakenduslikku või akadeemilist kõrgharidust"
    },
    {
      "@id": "estleg:Reg_157694_Par_1_v157694",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157694_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametniku, vanemkriminaalhooldusametniku ja kriminaalhooldusosakonna juhataja täiendavad kvalifikatsiooninõuded on: 1 1) nõuded haridusele; 2 2) nõuded erialasele töökogemusele; 3 3) nõuded võõrkeeleoskusele. RT I 2019-07-23 17 123072019017 2019-08-01 Kriminaalhooldusametniku, vanemkriminaalhooldusametniku ja kriminaalhooldusosakonna juhataja täiendavad kvalifikatsiooninõuded on: nõuded haridusele; nõuded erialasele töökogemusele; nõuded võõrkeeleoskusele.",
      "rdfs:label": {
        "@value": "Reg_157694_Par_1 (redaktsioon 157694)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157694",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157694",
      "estleg:sourceAct": "Kriminaalhooldusametniku täiendavate kvalifikatsiooninõuete kehtestamine ning tööülesannete loetelu, mille täitmisel ei pea ametnikul olema vastavat rakenduslikku või akadeemilist kõrgharidust",
      "estleg:provisionRef": "Reg_157694 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157694_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157694_Par_2_v157694",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157694_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõuetele vastavaks hariduseks loetakse rakenduslik või akadeemiline kõrgharidus, mis on omandatud riiklikult akrediteeritud õppekava alusel vastavalt Vabariigi Valitsuse 18. detsembri 2008. a määrusega nr 178 „Kõrgharidusstandard” kehtestatud õppekavagruppidele järgmiselt: 1 1) sisekaitse õppekavagrupi korrektsiooni ja politseiteenistuse õppekava; RT I 2023-04-06 4 106042023004 2023-04-09 2 2) sotsiaalteaduste õppekavagrupi sotsioloogia või sotsioloogia, sotsiaaltöö ja sotsiaalpoliitika õppekava; 3 3) sotsiaalteenuste õppekavagrupi õppekava, välja arvatud sotsiaalse ettevõtluse ja tervisejuhi õppekava; 4 4) psühholoogia õppegrupi õppekavad; 5 5) õpetajakoolituse ja kasvatusteaduse õppegrupi õppekavad; 6 6) õiguse õppegrupi õppekavad. RT I 2019-07-23 17 123072019017 2019-08-01 Nõuetele vastavaks hariduseks loetakse rakenduslik või akadeemiline kõrgharidus, mis on omandatud riiklikult akrediteeritud õppekava alusel vastavalt Vabariigi Valitsuse 18. detsembri 2008. a määrusega nr 178 „Kõrgharidusstandard” kehtestatud õppekavagruppidele järgmiselt: sisekaitse õppekavagrupi korrektsiooni ja politseiteenistuse õppekava; sotsiaalteaduste õppekavagrupi sotsioloogia või sotsioloogia, sotsiaaltöö ja sotsiaalpoliitika õppekava; sotsiaalteenuste õppekavagrupi õppekava, välja arvatud sotsiaalse ettevõtluse ja tervisejuhi õppekava; psühholoogia õppegrupi õppekavad; õpetajakoolituse ja kasvatusteaduse õppegrupi õppekavad; õiguse õppegrupi õppekavad. 2 (2) Kehtetu - RT I 2023-04-06 4 106042023004 2023-04-09 Kehtetu - 3 (3) Nõuetele vastavaks hariduseks loetakse iga rakenduslik või akadeemiline kõrgharidus, kui lisaks sellel erialal nõutavale õppekavale on saadud piisav töökogemus kriminaalhooldustööd toetaval alal ning isikul on kriminaalhooldusametnikule sobivad isiksuseomadused, oskused ja teadmised ning ta on valmis läbima kriminaalhooldusametniku väljaõppeprogrammi. RT I 2023-04-06 4 106042023004 2023-04-09 Nõuetele vastavaks hariduseks loetakse iga rakenduslik või akadeemiline kõrgharidus, kui lisaks sellel erialal nõutavale õppekavale on saadud piisav töökogemus kriminaalhooldustööd toetaval alal ning isikul on kriminaalhooldusametnikule sobivad isiksuseomadused, oskused ja teadmised ning ta on valmis läbima kriminaalhooldusametniku väljaõppeprogrammi. 3 (3¹) Kehtetu - RT I 2023-04-06 4 106042023004 2023-04-09 Kehtetu - 4 (4) Kehtetu - RT I 2023-04-06 4 106042023004 2023-04-09 Kehtetu - 5 (5) Kehtetu - RT I 2023-04-06 4 106042023004 2023-04-09 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_157694_Par_2 (redaktsioon 157694)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157694",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157694",
      "estleg:sourceAct": "Kriminaalhooldusametniku täiendavate kvalifikatsiooninõuete kehtestamine ning tööülesannete loetelu, mille täitmisel ei pea ametnikul olema vastavat rakenduslikku või akadeemilist kõrgharidust",
      "estleg:provisionRef": "Reg_157694 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157694_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157694_Par_3_v157694",
