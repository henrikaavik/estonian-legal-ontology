      "estleg:provisionRef": "Reg_157694 § 3_3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157694_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157694_Par_3_4_v157694",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157694_Par_3_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametniku võõrkeeleoskusele esitatavad nõuded on järgmised: 1 1) kriminaalhooldusametnikul ühe võõrkeele oskus tasemel B2; RT I 2023-04-06 4 106042023004 2023-04-09 2 2) vanemkriminaalhooldusametnikul ühe võõrkeele oskus tasemel B2; RT I 2025-06-20 1 120062025001 2025-07-01 3 3) kriminaalhooldusosakonna juhatajal ühe võõrkeele oskus tasemel B2. RT I 2025-06-20 1 120062025001 2025-07-01 Kriminaalhooldusametniku võõrkeeleoskusele esitatavad nõuded on järgmised: kriminaalhooldusametnikul ühe võõrkeele oskus tasemel B2; vanemkriminaalhooldusametnikul ühe võõrkeele oskus tasemel B2; kriminaalhooldusosakonna juhatajal ühe võõrkeele oskus tasemel B2.",
      "rdfs:label": {
