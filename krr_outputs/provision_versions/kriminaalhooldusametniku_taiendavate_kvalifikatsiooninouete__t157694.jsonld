    {
      "@id": "estleg:Reg_157694_Par_5_v157694",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157694_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusametniku tööülesanded, mida täitval ametnikul ei pea olema kriminaalhooldusseaduse § 13 lõikes 1 sätestatud rakenduslikku või akadeemilist kõrgharidust, on järgmised: 1 1) üldkasuliku töö korraldamine ja läbiviimine, järelevalve teostamine, vajalike dokumentide koostamine ja esitamine ning kriminaalhooldusseaduse § 26 lõikes 5 sätestatud registri (edaspidi register) täitmine; 2 2) alkoholi- ja narkojoobe kontrollimine, vajalike dokumentide koostamine ja esitamine ning registri täitmine; 3 3) elektroonilise järelevalve korraldamine, kohaldamine ja läbiviimine, järelevalve teostamine, vajalike dokumentide koostamine ja esitamine ning registri täitmine; 4 4) kodukülastuse ja elukoha kontrolli korraldamine ja läbiviimine, vajalike dokumentide koostamine ja esitamine. RT I 2013-09-10 4 110092013004 2013-09-13 Kriminaalhooldusametniku tööülesanded, mida täitval ametnikul ei pea olema kriminaalhooldusseaduse § 13 lõikes 1 sätestatud rakenduslikku või akadeemilist kõrgharidust, on järgmised: üldkasuliku töö korraldamine ja läbiviimine, järelevalve teostamine, vajalike dokumentide koostamine ja esitamine ning kriminaalhooldusseaduse § 26 lõikes 5 sätestatud registri (edaspidi register) täitmine; alkoholi- ja narkojoobe kontrollimine, vajalike dokumentide koostamine ja esitamine ning registri täitmine; elektroonilise järelevalve korraldamine, kohaldamine ja läbiviimine, järelevalve teostamine, vajalike dokumentide koostamine ja esitamine ning registri täitmine; kodukülastuse ja elukoha kontrolli korraldamine ja läbiviimine, vajalike dokumentide koostamine ja esitamine.",
      "rdfs:label": {
        "@value": "Reg_157694_Par_5 (redaktsioon 157694)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157694",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157694",
