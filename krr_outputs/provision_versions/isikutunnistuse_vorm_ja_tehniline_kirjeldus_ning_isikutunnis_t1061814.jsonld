      "estleg:provisionRef": "Reg_1061814 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061814_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061814_Par_4_v1061814",
