      "estleg:sourceAct": "Registreerimisele kuuluvate maastikusõidukite loetelu",
      "estleg:provisionRef": "Reg_1000726 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000726_Map_2026"
      }
    },
