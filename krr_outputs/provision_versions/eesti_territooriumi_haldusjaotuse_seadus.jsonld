    {
      "@id": "estleg:ETH_Par_7_1_v121062016013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETH_Par_7_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haldusterritoriaalse korralduse muutmise maakondade osas otsustab Riigikogu. (2) Haldusterritoriaalse korralduse muutmise valdade ja linnade osas otsustab (3) Haldusüksuse piiride muutmise otsustab . Haldusüksuse piiride korrigeerimise maakorraldus- ja ehitusplaneerimisvajadustest lähtuvalt otsustab Vabariigi Valitsuse poolt volitatud valitsusasutus. (4) Haldusüksuse nime muutmise otsustab (5) Valla või linna maakondliku kuuluvuse muutmise otsustab (6) Valla või linna haldusüksuse liigi muutmise otsustab",
      "rdfs:label": {
        "@value": "ETH_Par_7_1 (redaktsioon 121062016013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062016013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062016013",
      "estleg:sourceAct": "Eesti territooriumi haldusjaotuse seadus",
      "estleg:provisionRef": "ETH § 7_1",
      "estleg:partOfAct": {
