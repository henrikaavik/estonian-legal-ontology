      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haldusterritoriaalne korraldus on Eesti territooriumi jagunemine haldusüksusteks. (2) Haldusüksus on haldusjaotusel põhinev, seaduse ja teiste õigusaktidega kindlaks määratud staatuse, nime ja piiridega üksus, mille territooriumi ulatuses teostatakse riiklikku või omavalitsuslikku haldamist.",
      "rdfs:label": {
        "@value": "ETH_Par_2_1 (redaktsioon 22326)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22326",
