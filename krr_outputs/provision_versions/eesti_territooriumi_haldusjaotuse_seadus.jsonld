      }
    },
    {
      "@id": "estleg:ETH_Par_12_v22326",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETH_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla või linna nime muutmise taotlemiseks võtab kohaliku omavalitsusüksuse volikogu vastu motiveeritud otsuse. (2) Asjaomane volikogu esitab maavanemale: volikogu otsuse nime muutmise taotlemise kohta; seletuskirja, milles peab olema märgitud nime muutmise vajaduse põhjendus lähtuvalt kohalikest ajaloolistest, geograafilistest, looduslikest ja muudest tingimustest ning võttes arvesse vastava valla või linna elanike soovi. (3) Maavanem esitab käesoleva §i lõikes 2 nimetatud otsused ja dokumendid koos omapoolse arvamusega Siseministeeriumile ühe kuu jooksul otsuse laekumisest arvates. (4) Vallale või linnale ei või anda mõne muu valla või linna nime.",
      "rdfs:label": {
        "@value": "ETH_Par_12 (redaktsioon 22326)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22326",
      "estleg:supersededByVersion": {
        "@id": "estleg:ETH_Par_12_v782501"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22326",
      "estleg:sourceAct": "Eesti territooriumi haldusjaotuse seadus",
      "estleg:provisionRef": "ETH § 12",
      "estleg:partOfAct": {
        "@id": "estleg:ETH_Map_2026"
      }
    },
