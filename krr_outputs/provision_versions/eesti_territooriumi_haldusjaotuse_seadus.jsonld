      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032015096",
      "estleg:sourceAct": "Eesti territooriumi haldusjaotuse seadus",
      "estleg:provisionRef": "ETH § 6",
