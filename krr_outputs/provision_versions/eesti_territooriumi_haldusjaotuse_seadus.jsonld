      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi pealinn on Tallinn.",
      "rdfs:label": {
        "@value": "ETH_Par_5 (redaktsioon 22326)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22326",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22326",
      "estleg:sourceAct": "Eesti territooriumi haldusjaotuse seadus",
      "estleg:provisionRef": "ETH § 5",
      "estleg:partOfAct": {
