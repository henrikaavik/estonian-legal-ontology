      }
    },
    {
      "@id": "estleg:ETH_Par_6_v22326",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETH_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asustusüksused on asula ja asum. (2) Vald jaguneb asulateks, milleks on külad, alevikud, alevid ja vallasisesed linnad. (3) Linn haldusüksusena on samades piirides ka asula. (4) Linn võib jaguneda asumiteks. (5) Asustusüksuste liik, nimi ja lahkmejooned määratakse, lähtuvalt valla- või linnavolikogude taotlustest, Vabariigi Valitsuse poolt määratud alustel ja korras. (6) Asustusüksused on arvestuse aluseks riiklikes toimingutes, sealhulgas statistika ja aadressisüsteemi korraldamisel ning registrite ja katastrite pidamisel.",
      "rdfs:label": {
        "@value": "ETH_Par_6 (redaktsioon 22326)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22326",
      "estleg:supersededByVersion": {
        "@id": "estleg:ETH_Par_6_v782501"
      },
      "estleg:versionValidTo": {
        "@value": "2004-07-24",
