    {
      "@id": "estleg:ETH_Par_2_v22326",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETH_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti territooriumi haldusjaotus on Eesti territooriumi jaotus maakondadeks, valdadeks ja linnadeks. (2) Maakonnas teostatakse seaduse alusel riiklikku haldamist maavanema ja valitsusasutuste poolt. (3) Vallas ja linnas teostatakse omavalitsuslikku haldamist kohaliku omavalitsuse korralduse seaduse (RT I 1993, 37, 558; 1994, 12, 200; 19, 340; 72, 1263; 84, 1475; 1995, 16, 228; 17, 237; 23, 334; 26-28, 355; 59, 1006; 97, 1664; 1996, 36, 738; 37, 739; 40, 773) §-des 3 ja 4 sätestatud alustel. (4) Vallas ja linnas võib moodustada vastavalt osavaldu ja linnaosi seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "ETH_Par_2 (redaktsioon 22326)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22326",
      "estleg:supersededByVersion": {
        "@id": "estleg:ETH_Par_2_v13361777"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22326",
      "estleg:sourceAct": "Eesti territooriumi haldusjaotuse seadus",
      "estleg:provisionRef": "ETH § 2",
      "estleg:partOfAct": {
        "@id": "estleg:ETH_Map_2026"
      }
    },
    {
      "@id": "estleg:ETH_Par_2_v13361777",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETH_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti territooriumi haldusjaotus on Eesti territooriumi jaotus maakondadeks, valdadeks ja linnadeks. (2) Maakonnas teostatakse seaduse alusel riiklikku haldamist maavanema ja valitsusasutuste poolt. (3) Vallas ja linnas teostatakse omavalitsuslikku haldamist kohaliku omavalitsuse korralduse seaduse §-des 3 ja 4 sätestatud alustel. (4) Vallas ja linnas võib moodustada vastavalt osavaldu ja linnaosi seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "ETH_Par_2 (redaktsioon 13361777)",
