    {
      "@id": "estleg:ETH_Par_14_v113032014016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ETH_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Haldusüksuse piirid tähistatakse poolt kehtestatud korras. (2) Haldusüksuse piiride teetähistussüsteemi ja selle rakendamise korra kehtestab , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „majandus- ja kommunikatsiooniminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ETH_Par_14 (redaktsioon 113032014016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014016",
      "estleg:supersededByVersion": {
