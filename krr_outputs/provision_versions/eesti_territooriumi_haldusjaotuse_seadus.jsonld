      "estleg:versionValidFrom": {
        "@value": "2017-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksustele edasi antavad maksud ja riigieelarvest antavad toetused kantakse kohaliku omavalitsuse volikogu valimiste tulemuste väljakuulutamisest arvates kuni eelarveaasta lõpuni territooriumiosa oma koosseisust teise omavalitsusüksuse koosseisu üle andnud kohaliku omavalitsuse üksusele.",
      "rdfs:label": {
        "@value": "ETH_Par_14_2 (redaktsioon 104072017027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072017027",
