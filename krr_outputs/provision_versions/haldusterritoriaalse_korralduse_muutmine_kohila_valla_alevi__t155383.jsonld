    {
      "@id": "estleg:Reg_155383_Par_6_v155383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155383_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsuse 3. aprilli 1995. a määrusega nr 159 kinnitatud «Eesti territooriumi haldusüksuste nimistus» (RT I 1995, 40, 567; 53, 855; 1996, 55, 997; 76, 1346; 1997, 74, 1236; 1998, 56, 842; 96, 1516; 1999, 31, 427; 45, 522; 52, 564 ja 568; 53, 579; 57, 606; 64, 643) jäetakse Rapla maakonna valdade loetelust välja nimi «Kohila (alev)». (2) Vabariigi Valitsuse 18. detsembri 1997. a määrusega nr 244 kinnitatud «Vallasiseste linnade, alevite, alevike ja külade nimistus» (RT I 1997, 95/96, 1577; 99, 1604; 1998, 56, 842; 60, 955; 96, 1516; 112, 1853; 1999, 22, 345; 31, 427; 45, 522; 52, 564 ja 568; 53, 579; 57, 606; 2000, 91, 596; 2001, 100, 652 ja 653) tehakse järgmised muudatused: 1) loetelust jäetakse välja sõnad «KOHILA vald (alev) Alevid Kohila». 2) loetelu täiendatakse pärast sõnu «KOHILA vald» sõnadega: «Alevid Kohila».",
      "rdfs:label": {
        "@value": "Reg_155383_Par_6 (redaktsioon 155383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155383",
      "estleg:sourceAct": "Haldusterritoriaalse korralduse muutmine Kohila valla (alevi) ja Kohila valla osa",
      "estleg:provisionRef": "Reg_155383 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155383_Map"
      }
    },
    {
      "@id": "estleg:Reg_155383_Par_7_v155383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
