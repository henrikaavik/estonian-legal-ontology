    {
      "@id": "estleg:Reg_160754_Par_5_v160754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160754_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registrit peetakse ühetasandilise andmekoguna patendivolinike registreerimiseks. Registrit peetakse ühetasandilise andmekoguna patendivolinike registreerimiseks. 2 (2) Registri pidamise eesmärk on «Patendivoliniku seaduse» § 2 lõike 1 mõistes patendivolinikke puudutavate andmete töötlemine ja andmete avalikkusele kättesaadavaks tegemine «Patendivoliniku seaduse» §-s 24 sätestatud ulatuses. Registri pidamise eesmärk on «Patendivoliniku seaduse» § 2 lõike 1 mõistes patendivolinikke puudutavate andmete töötlemine ja andmete avalikkusele kättesaadavaks tegemine «Patendivoliniku seaduse» §-s 24 sätestatud ulatuses.",
      "rdfs:label": {
