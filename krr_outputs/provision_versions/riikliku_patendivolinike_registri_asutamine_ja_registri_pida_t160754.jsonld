      }
    },
    {
      "@id": "estleg:Reg_160754_Par_7_v160754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160754_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrit peetakse infotehnoloogilise andmekoguna ja registritoimikutena paberkandjal. Registrit peetakse infotehnoloogilise andmekoguna ja registritoimikutena paberkandjal.",
      "rdfs:label": {
        "@value": "Reg_160754_Par_7 (redaktsioon 160754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160754",
      "estleg:sourceAct": "Riikliku patendivolinike registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_160754 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_160754_Map"
      }
    },
    {
      "@id": "estleg:Reg_160754_Par_8_v160754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160754_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registri volitatud töötleja peab organisatsiooniliste ja tehniliste meetmetega tagama registri andmete terviklikkuse ja autentsuse, samuti andmekogu pidamise ja selles sisalduvate andmete töötlemise, kaitse, säilimise ning arhiveerimise. Registri volitatud töötleja peab organisatsiooniliste ja tehniliste meetmetega tagama registri andmete terviklikkuse ja autentsuse, samuti andmekogu pidamise ja selles sisalduvate andmete töötlemise, kaitse, säilimise ning arhiveerimise. 2 (2) Registri volitatud töötleja on kohustatud: 1 1) vältima kõrvaliste isikute ligipääsu registri andmete töötlemiseks kasutatavatele seadmetele; 2 2) takistama andmekandjate omavolilist muutmist või kaasaviimist; 3 3) takistama registri andmete omavolilist muutmist või kustutamist ning tagama, et tagantjärele oleks võimalik kindlaks teha, millal, kelle poolt ja milliseid registri andmeid muudeti; 4 4) takistama andmetöötlussüsteemi omavolilist kasutamist registri andmete ülekandmiseks andmesidevahendite abil; 5 5) tagama, et igal andmetöötlussüsteemi kasutajal oleks juurdepääs ainult temale töötlemiseks lubatud registri andmetele; 6 6) tagama, et tagantjärele oleks võimalik kindlaks teha, millal, kelle poolt ja millised registri andmed andmetöötlussüsteemi sisestati; 7 7) tagama, et registri andmete edasiandmisel andmesidevahenditega ja andmekandjate transportimisel ei toimuks registri andmete omavolilist lugemist, kopeerimist, muutmist või kustutamist; 8 8) kujundama töökorralduse niisuguseks, et see võimaldaks täita andmekaitse erinõudeid. Registri volitatud töötleja on kohustatud: vältima kõrvaliste isikute ligipääsu registri andmete töötlemiseks kasutatavatele seadmetele; takistama andmekandjate omavolilist muutmist või kaasaviimist; takistama registri andmete omavolilist muutmist või kustutamist ning tagama, et tagantjärele oleks võimalik kindlaks teha, millal, kelle poolt ja milliseid registri andmeid muudeti; takistama andmetöötlussüsteemi omavolilist kasutamist registri andmete ülekandmiseks andmesidevahendite abil; tagama, et igal andmetöötlussüsteemi kasutajal oleks juurdepääs ainult temale töötlemiseks lubatud registri andmetele; tagama, et tagantjärele oleks võimalik kindlaks teha, millal, kelle poolt ja millised registri andmed andmetöötlussüsteemi sisestati; tagama, et registri andmete edasiandmisel andmesidevahenditega ja andmekandjate transportimisel ei toimuks registri andmete omavolilist lugemist, kopeerimist, muutmist või kustutamist; kujundama töökorralduse niisuguseks, et see võimaldaks täita andmekaitse erinõudeid.",
      "rdfs:label": {
        "@value": "Reg_160754_Par_8 (redaktsioon 160754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160754",
      "estleg:sourceAct": "Riikliku patendivolinike registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_160754 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_160754_Map"
      }
    },
    {
      "@id": "estleg:Reg_160754_Par_9_v160754",
      "@type": [
        "owl:NamedIndividual",
