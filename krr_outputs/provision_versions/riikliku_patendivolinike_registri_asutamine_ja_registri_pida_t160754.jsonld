        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri koosseisu kuuluvad: 1 1) digitaalne kanderaamat; 2 2) registritoimikud. Registri koosseisu kuuluvad: digitaalne kanderaamat; registritoimikud.",
      "rdfs:label": {
        "@value": "Reg_160754_Par_10 (redaktsioon 160754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160754",
      "estleg:sourceAct": "Riikliku patendivolinike registri asutamine ja registri pidamise põhimäärus",
