      }
    },
    {
      "@id": "estleg:Reg_160754_Par_6_v160754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160754_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registri pidamine toimub vastavalt «Patendivoliniku seadusele», «Isikuandmete kaitse seadusele», käesolevale määrusele ja muudele õigusaktidele. RT I 2011-12-29 132 129122011132 2012-01-01 Registri pidamine toimub vastavalt «Patendivoliniku seadusele», «Isikuandmete kaitse seadusele», käesolevale määrusele ja muudele õigusaktidele. 2 (2) Registri volitatud töötleja peab tagama registreeringuandmete terviklikkuse ja autentsuse, samuti andmekogu pidamise ja selles sisalduvate andmete töötlemise ning kaitse. RT I 2011-12-29 132 129122011132 2012-01-01 Registri volitatud töötleja peab tagama registreeringuandmete terviklikkuse ja autentsuse, samuti andmekogu pidamise ja selles sisalduvate andmete töötlemise ning kaitse.",
      "rdfs:label": {
        "@value": "Reg_160754_Par_6 (redaktsioon 160754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160754",
      "estleg:sourceAct": "Riikliku patendivolinike registri asutamine ja registri pidamise põhimäärus",
