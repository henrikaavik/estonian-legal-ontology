      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Register on avalik. Igaühel on õigus tutvuda registrikannetega ja saada neist ärakirju. Register on avalik. Igaühel on õigus tutvuda registrikannetega ja saada neist ärakirju. 2 (2) Registrist väljastatud teabe üle peetakse arvestust. Arvestuse andmed on avalikud. Registrist väljastatud teabe üle peetakse arvestust. Arvestuse andmed on avalikud.",
      "rdfs:label": {
        "@value": "Reg_160754_Par_20 (redaktsioon 160754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160754",
      "estleg:sourceAct": "Riikliku patendivolinike registri asutamine ja registri pidamise põhimäärus",
