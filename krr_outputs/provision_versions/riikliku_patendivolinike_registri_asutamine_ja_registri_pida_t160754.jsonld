    {
      "@id": "estleg:Reg_160754_Par_14_v160754",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160754_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse esitavad andmeid: 1 1) patendivoliniku kutsekomisjon, justiitsminister või tema poolt volitatud ametnik või kohus patendivolinikule kutse andmise, äravõtmise, taastamise või peatamise korral; RT I 2011-12-29 132 129122011132 2012-01-01 2 2) asjast huvitatud isik registreeringu andmete muutmiseks või kustutamiseks. Registrisse esitavad andmeid: patendivoliniku kutsekomisjon, justiitsminister või tema poolt volitatud ametnik või kohus patendivolinikule kutse andmise, äravõtmise, taastamise või peatamise korral; asjast huvitatud isik registreeringu andmete muutmiseks või kustutamiseks.",
      "rdfs:label": {
        "@value": "Reg_160754_Par_14 (redaktsioon 160754)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160754",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160754",
      "estleg:sourceAct": "Riikliku patendivolinike registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_160754 § 14",
      "estleg:partOfAct": {
