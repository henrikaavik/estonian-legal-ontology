    {
      "@id": "estleg:Reg_332278_Par_15_v332278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_332278_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotleja nõuetele vastavust kontrollib sihtasutus. Taotleja nõuetele vastavust kontrollib sihtasutus. 2 (2) Taotleja tunnistatakse nõuetele vastavaks juhul, kui on täidetud §-s 10 taotlejale esitatud nõuded. RT I 2014-07-24 11 124072014011 2014-07-27 Taotleja tunnistatakse nõuetele vastavaks juhul, kui on täidetud §-s 10 taotlejale esitatud nõuded. 3 (3) Taotleja nõuetele vastavuse korral tunnistab sihtasutus taotleja nõuetele vastavaks. Taotleja nõuetele mittevastavaks tunnistamise korral teeb sihtasutus taotluse rahuldamata jätmise otsuse taotlust hindamata. RT I 2015-01-13 23 113012015023 2015-01-16 Taotleja nõuetele vastavuse korral tunnistab sihtasutus taotleja nõuetele vastavaks. Taotleja nõuetele mittevastavaks tunnistamise korral teeb sihtasutus taotluse rahuldamata jätmise otsuse taotlust hindamata.",
      "rdfs:label": {
        "@value": "Reg_332278_Par_15 (redaktsioon 332278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "332278",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/332278",
      "estleg:sourceAct": "Innovatsiooniosakute toetusmeetme tingimused ja kord",
      "estleg:provisionRef": "Reg_332278 § 15",
      "estleg:partOfAct": {
