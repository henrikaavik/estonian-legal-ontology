    {
      "@id": "estleg:Reg_159026_Par_4_v159026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159026_Par_4"
