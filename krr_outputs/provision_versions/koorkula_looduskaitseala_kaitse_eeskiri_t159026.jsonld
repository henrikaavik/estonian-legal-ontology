      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu säilimise tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu säilimise tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_159026_Par_15 (redaktsioon 159026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159026",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159026",
      "estleg:sourceAct": "Koorküla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159026 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159026_Map_2026"
      }
    },
    {
