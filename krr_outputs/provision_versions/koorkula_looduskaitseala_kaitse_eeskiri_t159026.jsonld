    {
      "@id": "estleg:Reg_159026_Par_10_v159026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159026_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndites lubatud: 1 1) poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 2 2) tee rajamine, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks ning olemasolevate ehitiste hooldustööd; 3 3) koosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures metsakoosluse kujundamisel on kaitseala valitsejal õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas. Kaitseala valitseja nõusolekul on sihtkaitsevööndites lubatud: poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; tee rajamine, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks ning olemasolevate ehitiste hooldustööd; koosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures metsakoosluse kujundamisel on kaitseala valitsejal õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas.",
      "rdfs:label": {
        "@value": "Reg_159026_Par_10 (redaktsioon 159026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159026",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159026",
      "estleg:sourceAct": "Koorküla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159026 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159026_Map_2026"
      }
    },
    {
