      }
    },
    {
      "@id": "estleg:Reg_159026_Par_8_v159026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159026_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Udsu sihtkaitsevööndi kaitse-eesmärk on Udsu järve ja seda ümbritsevate koosluste kaitse ja maastikuilme säilitamine. Udsu sihtkaitsevööndi kaitse-eesmärk on Udsu järve ja seda ümbritsevate koosluste kaitse ja maastikuilme säilitamine. 2 (2) Kadastiku sihtkaitsevööndi kaitse-eesmärk on sealsete järvede ja kaitsealuse linnuliigi elupaiga säilitamine. Kadastiku sihtkaitsevööndi kaitse-eesmärk on sealsete järvede ja kaitsealuse linnuliigi elupaiga säilitamine. 3 (3) Sihtkaitsevööndite metsakoosluste kaitse-eesmärk on kasvukohatüübile iseloomuliku liikide koosseisu säilitamine. Sihtkaitsevööndite metsakoosluste kaitse-eesmärk on kasvukohatüübile iseloomuliku liikide koosseisu säilitamine.",
      "rdfs:label": {
        "@value": "Reg_159026_Par_8 (redaktsioon 159026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159026",
