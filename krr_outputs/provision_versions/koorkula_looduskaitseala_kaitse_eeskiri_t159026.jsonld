      }
    },
    {
      "@id": "estleg:Reg_159026_Par_14_v159026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159026_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine; 3 3) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal, metsamaal ning haritaval maal veekogule lähemal kui 25 meetrit; 6 6) puidu kokku- ja väljavedu külmumata pinnasel; 7 7) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal, metsamaal ning haritaval maal veekogule lähemal kui 25 meetrit; puidu kokku- ja väljavedu külmumata pinnasel; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus.",
      "rdfs:label": {
        "@value": "Reg_159026_Par_14 (redaktsioon 159026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159026",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159026",
      "estleg:sourceAct": "Koorküla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159026 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159026_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_159026_Par_15_v159026",
      "@type": [
        "owl:NamedIndividual",
