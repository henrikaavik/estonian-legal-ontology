    {
      "@id": "estleg:Reg_159026_Par_13_v159026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159026_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 5–8 sätestatut. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 5–8 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_159026_Par_13 (redaktsioon 159026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159026",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159026",
      "estleg:sourceAct": "Koorküla looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159026 § 13",
      "estleg:partOfAct": {
