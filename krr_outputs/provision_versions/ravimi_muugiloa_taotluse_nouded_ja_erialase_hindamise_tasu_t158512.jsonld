      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158512_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus sätestab ravimi müügiloa taotlemisel Ravimiametile esitatava müügiloa taotluse liigid, taotluste vorminõuded, taotlusele lisatava täiendava dokumentatsiooni loetelu ja nõuded täiendavale dokumentatsioonile ning taotluse erialase hindamise tasu suuruse erinevate taotluse liikide osas ja nimetatud tasu tasumise korra. Käesolev määrus sätestab ravimi müügiloa taotlemisel Ravimiametile esitatava müügiloa taotluse liigid, taotluste vorminõuded, taotlusele lisatava täiendava dokumentatsiooni loetelu ja nõuded täiendavale dokumentatsioonile ning taotluse erialase hindamise tasu suuruse erinevate taotluse liikide osas ja nimetatud tasu tasumise korra.",
      "rdfs:label": {
        "@value": "Reg_158512_Par_1 (redaktsioon 158512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158512",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158512",
      "estleg:sourceAct": "Ravimi müügiloa taotluse nõuded ja erialase hindamise tasu",
      "estleg:provisionRef": "Reg_158512 § 1",
      "estleg:partOfAct": {
