      }
    },
    {
      "@id": "estleg:Reg_1047591_Par_10_v1047591",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047591_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevööndis on lubatud rahvaürituse korraldamine selleks kaitseala valitseja nõusolekul ette valmistatud ja tähistatud kohas ning kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas. Sihtkaitsevööndis on lubatud rahvaürituse korraldamine selleks kaitseala valitseja nõusolekul ette valmistatud ja tähistatud kohas ning kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas. 2 (2) Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) olemasolevate ehitiste hooldustööd; 2 2) tootmisotstarbeta rajatise püstitamine kaitseala ja kaitsealal paikneva kinnistu tarbeks, kusjuures tee ja tehnovõrgu rajatiste püstitamine on kaitseala valitseja nõusolekul lubatud vaid Pakri poolsaare metsade ja Pakri saarte metsade sihtkaitsevööndis; 3 3) tootmisotstarbeta ehitiste püstitamine riigikaitse tarbeks Pakri poolsaare metsade sihtkaitsevööndis; 4 4) rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas; 5 5) poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 6 6) olemasolevate maaparandussüsteemide hoiutööd; 7 7) metsakoosluste kujundamine vastavalt kaitse-eesmärgile; 8 8) roo ja adru varumine. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: olemasolevate ehitiste hooldustööd; tootmisotstarbeta rajatise püstitamine kaitseala ja kaitsealal paikneva kinnistu tarbeks, kusjuures tee ja tehnovõrgu rajatiste püstitamine on kaitseala valitseja nõusolekul lubatud vaid Pakri poolsaare metsade ja Pakri saarte metsade sihtkaitsevööndis; tootmisotstarbeta ehitiste püstitamine riigikaitse tarbeks Pakri poolsaare metsade sihtkaitsevööndis; rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas; poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; olemasolevate maaparandussüsteemide hoiutööd; metsakoosluste kujundamine vastavalt kaitse-eesmärgile; roo ja adru varumine.",
      "rdfs:label": {
        "@value": "Reg_1047591_Par_10 (redaktsioon 1047591)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047591",
