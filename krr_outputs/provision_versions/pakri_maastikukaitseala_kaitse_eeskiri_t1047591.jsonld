        "@value": "2020-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1047591_Par_3 (redaktsioon 1047591)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047591",
