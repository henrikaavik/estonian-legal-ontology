      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 21. mai 2015. a käskkirjaga nr 480 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 21. mai 2015. a käskkirjaga nr 480 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1047591_Par_22 (redaktsioon 1047591)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047591",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047591",
      "estleg:sourceAct": "Pakri maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1047591 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047591_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047591_Par_23_v1047591",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047591_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1047591_Par_23 (redaktsioon 1047591)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047591",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047591",
      "estleg:sourceAct": "Pakri maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1047591 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047591_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047591_Par_3_v1047591",
      "@type": [
        "owl:NamedIndividual",
