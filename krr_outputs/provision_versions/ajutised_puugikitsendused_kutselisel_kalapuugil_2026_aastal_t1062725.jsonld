      "estleg:versionValidFrom": {
        "@value": "2026-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lämmijärvel ja Nina külast, mida tähistatakse koordinaatidega 58º36.59'N, 27º12.15'E, lõuna poole jääval Peipsi järve osal on kaldast arvates kolme kilomeetri laiusel veealal lubatud 1. märtsist 4. maini kasutada jääalusel kalapüügil kaldavõrku. Lämmijärvel ja Nina külast, mida tähistatakse koordinaatidega 58º36.59'N, 27º12.15'E, lõuna poole jääval Peipsi järve osal on kaldast arvates kolme kilomeetri laiusel veealal lubatud 1. märtsist 4. maini kasutada jääalusel kalapüügil kaldavõrku.",
      "rdfs:label": {
        "@value": "Reg_1062725_Par_2 (redaktsioon 1062725)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062725",
