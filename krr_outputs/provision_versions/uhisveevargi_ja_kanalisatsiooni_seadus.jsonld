    {
      "@id": "estleg:UHISVE_Par_13_v13349002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISVE_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veevarustuse ja reovee ärajuhtimise teenust müüakse kliendi ja vee-ettevõtja vahel sõlmitud lepingu alusel.",
      "rdfs:label": {
        "@value": "UHISVE_Par_13 (redaktsioon 13349002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13349002",
      "estleg:supersededByVersion": {
        "@id": "estleg:UHISVE_Par_13_v127092023004"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13349002",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni seadus",
      "estleg:provisionRef": "UHISVE § 13",
      "estleg:partOfAct": {
