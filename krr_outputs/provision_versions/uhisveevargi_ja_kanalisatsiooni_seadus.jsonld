      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISVE_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üldistes huvides õiglase ja kohese hüvituse eest on omavalitsusel õigus teostada sundvaldust või -võõrandamist sundvõõrandamise seaduses sätestatud alusel sellise ehitise kasutamiseks või omandamiseks, mis on vajalik ühisveevärgi ja -kanalisatsiooni häireteta töö tagamiseks ja arenguks.",
      "rdfs:label": {
        "@value": "UHISVE_Par_12 (redaktsioon 13119422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13119422",
      "estleg:supersededByVersion": {
        "@id": "estleg:UHISVE_Par_12_v129062018055"
      },
      "estleg:versionValidTo": {
        "@value": "2018-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13119422",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni seadus",
      "estleg:provisionRef": "UHISVE § 12",
      "estleg:partOfAct": {
        "@id": "estleg:UHISVE_Map_2026"
      }
    },
    {
      "@id": "estleg:UHISVE_Par_12_v129062018055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISVE_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sellise ehitise kasutamiseks, mis on vajalik ühisveevärgi ja -kanalisatsiooni häireteta töö tagamiseks ja arenguks, on kohalikul omavalitsusel õigus kinnisasja avalikes huvides omandamise seaduses sätestatud korras seada sundvaldus või ehitis omandada, sealhulgas sundvõõrandada.",
      "rdfs:label": {
        "@value": "UHISVE_Par_12 (redaktsioon 129062018055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062018055",
      "estleg:supersededByVersion": {
        "@id": "estleg:UHISVE_Par_12_v127092023004"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062018055",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni seadus",
      "estleg:provisionRef": "UHISVE § 12",
      "estleg:partOfAct": {
        "@id": "estleg:UHISVE_Map_2026"
      }
    },
    {
      "@id": "estleg:UHISVE_Par_12_v127092023004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UHISVE_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ala, kuhu on kavas rajada ühisveevärk ja -kanalisatsioon, kavandatakse selliselt, et võimalus ühisveevärgi ja -kanalisatsiooniga liitumiseks on tagatud kõigile selle ala elanikele ning olemasolevatele ettevõtetele ja asutustele, kelle tarbimine on võrreldav elanike joogivee tarbimisega ning ärajuhitav reovesi vastab olmereovee koostisele. (2) Planeerimisel lähtutakse järgmisest: piirkonnas on ühisveevärgi ja -kanalisatsiooni teenuse osutamine tervise ja keskkonna kaitsmiseks vajalik; ühisveevärgi ja -kanalisatsiooni teenuse hind on piirkonna elanike jaoks mõistlik; ühisveevärgi ja -kanalisatsiooni teenuse osutamisele avalduvad piirkonnast tulenevad riskid on ennetatud, leevendatud või maandatud. (3) Mõistliku hinna tagamiseks ning jätkusuutliku ühisveevärgi ja -kanalisatsiooni teenuse osutamiseks võivad riik, kohaliku omavalitsuse üksus ja teised organisatsioonid toetada vee-ettevõtjat, arvestades riigiabi nõuetega.",
      "rdfs:label": {
        "@value": "UHISVE_Par_12 (redaktsioon 127092023004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127092023004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127092023004",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni seadus",
      "estleg:provisionRef": "UHISVE § 12",
      "estleg:partOfAct": {
        "@id": "estleg:UHISVE_Map_2026"
      }
    },
