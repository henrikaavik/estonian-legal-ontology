      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13119422",
      "estleg:sourceAct": "Ühisveevärgi ja -kanalisatsiooni seadus",
      "estleg:provisionRef": "UHISVE § 1",
