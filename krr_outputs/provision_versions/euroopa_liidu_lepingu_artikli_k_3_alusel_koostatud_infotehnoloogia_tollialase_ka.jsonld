  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_euroopa_liidu_lepingu_artikli_k_3_alusel_koostatud_infotehnoloogia_tollialase_ka_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Euroopa Liidu lepingu artikli K.3 alusel koostatud infotehnoloogia tollialase kasutamise konventsiooni ja selle protokollidega ühinemise seadus (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Euroopa Liidu lepingu artikli K.3 alusel koostatud infotehnoloogia tollialase kasutamise konventsiooni ja selle protokollidega ühinemise seadus"
    },
    {
      "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_1_v851134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud: Euroopa Liidu lepingu artikli K.3 alusel koostatud (edaspidiinfotehnoloogia tollialase kasutamise konventsioon), mis on koostatud 1995. aasta 26. juulil Brüsselis; Euroopa Liidu lepingu artikli K.3 alusel koostatud ja mis on koostatud 1996. aasta 29. novembril Brüsselis; Euroopa Liidu lepingu artikli K.3 alusel koostatud ning mis on koostatud 1999. aasta 12. märtsil Brüsselis; Euroopa Liidu lepingu artikli 34 kohaselt koostatud ja mis on koostatud 2003. aasta 8. mail Brüsselis.",
      "rdfs:label": {
        "@value": "euroopa_liidu_lepingu_artikli_k_3_alusel_Par_1 (redaktsioon 851134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "851134"
    },
    {
      "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_2_v851134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Protokolli, mis on koostatud Euroopa Liidu lepingu artikli K.3 alusel ja mis käsitleb infotehnoloogia tollialase kasutamise konventsiooni tõlgendamist Euroopa Ühenduste Kohtu eelotsuste abil, artikli 2 lõike 1 alusel deklareerib Eesti Vabariik, et Eesti kohus võib taotleda pooleliolevas asjas Euroopa Ühenduste Kohtu eelotsust konventsiooni tõlgendamise kohta, kui Eesti kohtu arvates on tõlgendamise küsimus vaja lahendada otsuse tegemiseks.",
      "rdfs:label": {
        "@value": "euroopa_liidu_lepingu_artikli_k_3_alusel_Par_2 (redaktsioon 851134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "851134"
    },
    {
      "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_3_v851134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrata infotehnoloogia tollialase kasutamise konventsiooni: artikli 7 lõikes 1 ja artikli 10 lõikes 1 nimetatud riigiasutuseks Maksu- ja Tolliamet; artikli 8 lõikes 2 nimetatud riigiasutusteks Kaitsepolitseiamet, Keskkriminaalpolitsei ja Piirivalveamet; artikli 17 lõikes 1 nimetatud järelevalveasutuseks ja artikli 8 lõikes 4 nimetatud teabe edastajaks Andmekaitse Inspektsioon; artikli 7 lõikes 2, artikli 8 lõikes 3, artikli 10 lõikes 3 ja artikli 12a lõikes 3 nimetatud teabe edastajaks Maksu- ja Tolliamet.",
      "rdfs:label": {
        "@value": "euroopa_liidu_lepingu_artikli_k_3_alusel_Par_3 (redaktsioon 851134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "851134",
      "estleg:supersededByVersion": {
        "@id": "estleg:euroopa_liidu_lepingu_artikli_k_3_alusel_Par_3_v13247437"
      },
      "estleg:versionValidTo": {
