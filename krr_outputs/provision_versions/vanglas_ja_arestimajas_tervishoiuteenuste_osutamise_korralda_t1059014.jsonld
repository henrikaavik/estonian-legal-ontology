      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vanglas ja arestimajas tervishoiuteenuste osutamise korraldamine (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vanglas ja arestimajas tervishoiuteenuste osutamise korraldamine"
    },
    {
      "@id": "estleg:Reg_1059014_Par_1_v1059014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059014_Par_1"
