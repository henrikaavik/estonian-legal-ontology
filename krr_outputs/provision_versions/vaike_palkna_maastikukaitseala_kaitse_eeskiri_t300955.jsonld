    {
      "@id": "estleg:Reg_300955_Par_4_v300955",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300955_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. 2 (2) Kogu kaitseala kuulub Väike-Palkna sihtkaitsevööndisse. Kogu kaitseala kuulub Väike-Palkna sihtkaitsevööndisse.",
      "rdfs:label": {
        "@value": "Reg_300955_Par_4 (redaktsioon 300955)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300955",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300955",
