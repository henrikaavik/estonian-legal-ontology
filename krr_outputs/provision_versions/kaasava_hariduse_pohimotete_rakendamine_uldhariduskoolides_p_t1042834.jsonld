    {
      "@id": "estleg:Reg_1042834_Par_20_v1042834",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042834_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-02-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlus jäetakse rahuldamata taotluste menetlemise määruse § 8 lõigetes 2 ja 3 käesoleva määruse § 15 lõikes 5 ja § 18 lõikes 6 nimetatud juhtudel. Taotlus jäetakse rahuldamata taotluste menetlemise määruse § 8 lõigetes 2 ja 3 käesoleva määruse § 15 lõikes 5 ja § 18 lõikes 6 nimetatud juhtudel. 2 (2) Taotluse rahuldamata jätmise otsuses märgitakse taotluste menetlemise määruse § 8 lõikes 5 sätestatud teave. Taotluse rahuldamata jätmise otsuses märgitakse taotluste menetlemise määruse § 8 lõikes 5 sätestatud teave. 3 (3) Taotluse rahuldamise või rahuldamata jätmise otsus edastatakse taotlejale elektrooniliselt või struktuuritoetuse registri kaudu viie tööpäeva jooksul otsuse tegemisest arvates. Taotluse rahuldamise või rahuldamata jätmise otsus edastatakse taotlejale elektrooniliselt või struktuuritoetuse registri kaudu viie tööpäeva jooksul otsuse tegemisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1042834_Par_20 (redaktsioon 1042834)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042834",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042834",
      "estleg:sourceAct": "Kaasava hariduse põhimõtete rakendamine üldhariduskoolides perioodil 2014–2020",
      "estleg:provisionRef": "Reg_1042834 § 20",
