      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061666",
      "estleg:sourceAct": "Tuberkuloosiregistri põhimäärus",
      "estleg:provisionRef": "Reg_1061666 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061666_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1061666_Par_12_v1061666",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
