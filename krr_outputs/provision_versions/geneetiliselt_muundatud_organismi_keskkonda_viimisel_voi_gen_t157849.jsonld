  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_geneetiliselt_muundatud_organismi_keskkonda_viimisel_voi_gen_t157849_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Geneetiliselt muundatud organismi keskkonda viimisel või geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisel teatavaks saanud ohu kohta esitatav ja avalikustatav teave (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Geneetiliselt muundatud organismi keskkonda viimisel või geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisel teatavaks saanud ohu kohta esitatav ja avalikustatav teave"
    },
    {
      "@id": "estleg:Reg_157849_Par_1_v157849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157849_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus sätestab geneetiliselt muundatud organismide (edaspidi GMO) keskkonda viimise loa (edaspidi luba) või geneetiliselt muundatud organisme sisaldava või neist koosneva toote (edaspidi toode) turustamisloa taotleja, loa või turustamisloa omaja Kliimaministeeriumile esitatava teabe sisu nõuded juhul, kui on teatavaks saanud uued andmed GMO keskkonda viimise või toote turustamise ohtlikkuse kohta. Määrus sätestab ka teatavaks saanud ohu korral avalikustatava teabe sisu nõuded. RT I 2023-07-13 1 113072023001 2023-07-16 Määrus sätestab geneetiliselt muundatud organismide (edaspidi GMO) keskkonda viimise loa (edaspidi luba) või geneetiliselt muundatud organisme sisaldava või neist koosneva toote (edaspidi toode) turustamisloa taotleja, loa või turustamisloa omaja Kliimaministeeriumile esitatava teabe sisu nõuded juhul, kui on teatavaks saanud uued andmed GMO keskkonda viimise või toote turustamise ohtlikkuse kohta. Määrus sätestab ka teatavaks saanud ohu korral avalikustatava teabe sisu nõuded.",
      "rdfs:label": {
        "@value": "Reg_157849_Par_1 (redaktsioon 157849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157849",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157849",
      "estleg:sourceAct": "Geneetiliselt muundatud organismi keskkonda viimisel või geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisel teatavaks saanud ohu kohta esitatav ja avalikustatav teave",
      "estleg:provisionRef": "Reg_157849 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157849_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157849_Par_2_v157849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157849_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui GMO või GMO-de kombinatsiooni keskkonda viimise ohtlikkuse kohta on teatavaks saanud uued andmed, on GMO keskkonda viimise loa taotleja või loa omaja kohustatud esitama Kliimaministeeriumile järgmise teabe: RT I 2023-07-13 1 113072023001 2023-07-16 1 1) GMO keskkonda viimise loa taotluse ja loa registreerimise number; 2 2) ohtu põhjustava GMO nimetus; 3 3) GMO keskkonda viimise korral tekkiva ohu ja võimalike tagajärgede kirjeldus, sh ohu leviku teed; 4 4) ohu ilmnemisest teatanud allikad; 5 5) teave ohustatud kohast ja mõjupiirkonnast; 6 6) ohu leviku tõkestamise või vältimise abinõud (tegevuskava); 7 7) teave, kas GMO-d on sarnasel viisil varem keskkonda viidud ja millises mahus; 8 8) ohustatud piirkonda kõrvaliste isikute juurdepääsu takistamise vajalikkus; 9 9) vajaduse korral eeldatava ohu ja tagajärgede likvideerimise tähtaeg; 10 10) teabe esitaja (nimi, kontaktandmed). Kui GMO või GMO-de kombinatsiooni keskkonda viimise ohtlikkuse kohta on teatavaks saanud uued andmed, on GMO keskkonda viimise loa taotleja või loa omaja kohustatud esitama Kliimaministeeriumile järgmise teabe: GMO keskkonda viimise loa taotluse ja loa registreerimise number; ohtu põhjustava GMO nimetus; GMO keskkonda viimise korral tekkiva ohu ja võimalike tagajärgede kirjeldus, sh ohu leviku teed; ohu ilmnemisest teatanud allikad; teave ohustatud kohast ja mõjupiirkonnast; ohu leviku tõkestamise või vältimise abinõud (tegevuskava); teave, kas GMO-d on sarnasel viisil varem keskkonda viidud ja millises mahus; ohustatud piirkonda kõrvaliste isikute juurdepääsu takistamise vajalikkus; vajaduse korral eeldatava ohu ja tagajärgede likvideerimise tähtaeg; teabe esitaja (nimi, kontaktandmed).",
      "rdfs:label": {
        "@value": "Reg_157849_Par_2 (redaktsioon 157849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157849",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157849",
      "estleg:sourceAct": "Geneetiliselt muundatud organismi keskkonda viimisel või geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisel teatavaks saanud ohu kohta esitatav ja avalikustatav teave",
      "estleg:provisionRef": "Reg_157849 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157849_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157849_Par_3_v157849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157849_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "GMO keskkonda viimisel tekkivast ohust uute andmete teatavaks saamisel avaldab Kliimaministeerium vähemalt ühes üleriigilise levikuga ajalehes järgmise teabe: RT I 2023-07-13 1 113072023001 2023-07-16 1 1) GMO keskkonda viimisega ilmnenud oht ja selle võimalikud tagajärjed; 2 2) ohu leviku teed; 3 3) teave, kas ohuga seotud GMO-d on juba keskkonda viidud; 4 4) ohustatud piirkond ja GMO keskkonda viimise koht; 5 5) ohustatud piirkonna märgistus; 6 6) inimese tervise ja keskkonna kaitseks tarvitusele võetavad abinõud; 7 7) vajaduse korral eeldatav ohu likvideerimise tähtaeg; 8 8) kontaktisik ja tema kontaktandmed. GMO keskkonda viimisel tekkivast ohust uute andmete teatavaks saamisel avaldab Kliimaministeerium vähemalt ühes üleriigilise levikuga ajalehes järgmise teabe: GMO keskkonda viimisega ilmnenud oht ja selle võimalikud tagajärjed; ohu leviku teed; teave, kas ohuga seotud GMO-d on juba keskkonda viidud; ohustatud piirkond ja GMO keskkonda viimise koht; ohustatud piirkonna märgistus; inimese tervise ja keskkonna kaitseks tarvitusele võetavad abinõud; vajaduse korral eeldatav ohu likvideerimise tähtaeg; kontaktisik ja tema kontaktandmed.",
      "rdfs:label": {
        "@value": "Reg_157849_Par_3 (redaktsioon 157849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157849",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157849",
      "estleg:sourceAct": "Geneetiliselt muundatud organismi keskkonda viimisel või geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisel teatavaks saanud ohu kohta esitatav ja avalikustatav teave",
      "estleg:provisionRef": "Reg_157849 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157849_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157849_Par_4_v157849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157849_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toote turustamisel tekkivast ohust uute andmete teatavaks saamisel tuleb toote turustamisloa taotlejal või turustamisloa omajal edastada Kliimaministeeriumile järgmine teave: RT I 2023-07-13 1 113072023001 2023-07-16 1 1) GMO turustamisloa taotluse või turustamisloa registreerimise number; 2 2) GMO, millest oht tuleneb; 3 3) toote nimetus; 4 4) ohu ja võimalike tagajärgede kirjeldus, sh ohu leviku teed; 5 5) teave, kas GMO-d või toodet on tegelikult turustatud, turustamise kogused (mahud) ja toote turult kõrvaldamise võimalikkus; 6 6) turustamise piirkond; 7 7) tarvitusele võetavad tervise- ja keskkonnakaitsemeetmed (tegevuskava); 8 8) toote turult kõrvaldamise vajalikkus; 9 9) vajadusel ohu ja tagajärgede likvideerimise tähtaeg; 10 10) ohu kohta uute andmete ilmnemise allikad; 11 11) info esitaja (nimi, kontaktandmed). Toote turustamisel tekkivast ohust uute andmete teatavaks saamisel tuleb toote turustamisloa taotlejal või turustamisloa omajal edastada Kliimaministeeriumile järgmine teave: GMO turustamisloa taotluse või turustamisloa registreerimise number; GMO, millest oht tuleneb; toote nimetus; ohu ja võimalike tagajärgede kirjeldus, sh ohu leviku teed; teave, kas GMO-d või toodet on tegelikult turustatud, turustamise kogused (mahud) ja toote turult kõrvaldamise võimalikkus; turustamise piirkond; tarvitusele võetavad tervise- ja keskkonnakaitsemeetmed (tegevuskava); toote turult kõrvaldamise vajalikkus; vajadusel ohu ja tagajärgede likvideerimise tähtaeg; ohu kohta uute andmete ilmnemise allikad; info esitaja (nimi, kontaktandmed).",
      "rdfs:label": {
        "@value": "Reg_157849_Par_4 (redaktsioon 157849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157849",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157849",
      "estleg:sourceAct": "Geneetiliselt muundatud organismi keskkonda viimisel või geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisel teatavaks saanud ohu kohta esitatav ja avalikustatav teave",
      "estleg:provisionRef": "Reg_157849 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157849_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157849_Par_5_v157849",
