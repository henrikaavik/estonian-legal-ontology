    {
      "@id": "estleg:RanKS_Par_18_v22324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RanKS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikud, kes rikuvad käesoleva seaduse või selle alusel kehtestatud õigusnorme, kannavad haldus-, kriminaal- või tsiviilvastutust seaduses ettenähtud korras.",
      "rdfs:label": {
        "@value": "RanKS_Par_18 (redaktsioon 22324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22324",
