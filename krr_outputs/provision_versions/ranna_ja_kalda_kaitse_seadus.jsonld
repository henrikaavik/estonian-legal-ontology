      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RanKS_Par_18 (redaktsioon 191806)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191806"
    },
    {
      "@id": "estleg:RanKS_Par_19_v22324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
