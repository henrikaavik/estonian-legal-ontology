      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet käesoleva seaduse täitmise üle teostavad kohalikud omavalitsusüksused ja riigiasutused Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
        "@value": "RanKS_Par_19 (redaktsioon 22324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22324",
