    {
      "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_2_v12988279",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisafondi protokolli artikli 13 lõikes 1 nimetatud andmed esitab naftareostuskahju hüvitamise rahvusvahelise lisafondi direktorile Keskkonnaministeerium 1992. aasta fondi konventsiooni artikli 15 kohaselt. (2) Lisafondi protokolli artikli 15 lõikes 1 nimetatud andmed esitab naftareostuskahju hüvitamise rahvusvahelise lisafondi direktorile ning artiklis 20 nimetatud andmed Rahvusvahelise Mereorganisatsiooni peasekretärile Keskkonnaministeerium.",
      "rdfs:label": {
        "@value": "1992_aasta_rahvusvahelise_konventsiooni__Par_2 (redaktsioon 12988279)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12988279",
      "estleg:supersededByVersion": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_2_v216012024006"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12988279",
      "estleg:sourceAct": "1992. aasta rahvusvahelise konventsiooni rahvusvahelise naftareostuskahjude hüvitamise fondi loomisest 2003. aasta protokolliga ühinemise seadus",
      "estleg:provisionRef": "1992_aasta_rahvusvahelise_konventsiooni § 2",
      "estleg:partOfAct": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Map"
      }
    },
    {
      "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_2_v216012024006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisafondi protokolli artikli 13 lõikes 1 nimetatud andmed esitab naftareostuskahju hüvitamise rahvusvahelise lisafondi direktorile Kliimaministeerium 1992. aasta fondi konventsiooni artikli 15 kohaselt. ; Vabariigi Valitsuse seaduse § 105.19 lõike 6 alusel asendatud sõna „Keskkonnaministeerium” sõnaga „Kliimaministeerium” vastavas käändes. (2) Lisafondi protokolli artikli 15 lõikes 1 nimetatud andmed esitab naftareostuskahju hüvitamise rahvusvahelise lisafondi direktorile ning artiklis 20 nimetatud andmed Rahvusvahelise Mereorganisatsiooni peasekretärile Kliimaministeerium. ; Vabariigi Valitsuse seaduse § 105.19 lõike 6 alusel asendatud sõna „Keskkonnaministeerium” sõnaga „Kliimaministeerium” vastavas käändes.",
      "rdfs:label": {
        "@value": "1992_aasta_rahvusvahelise_konventsiooni__Par_2 (redaktsioon 216012024006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "216012024006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/216012024006",
      "estleg:sourceAct": "1992. aasta rahvusvahelise konventsiooni rahvusvahelise naftareostuskahjude hüvitamise fondi loomisest 2003. aasta protokolliga ühinemise seadus",
      "estleg:provisionRef": "1992_aasta_rahvusvahelise_konventsiooni § 2",
      "estleg:partOfAct": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Map"
      }
    },
    {
      "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_3_v12988279",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisafondi protokolli artikli 14 lõikes 2 nimetatud juhul teeb sissemaksed naftareostuskahju hüvitamise rahvusvahelisse lisafondi Keskkonnaministeerium. (2) Keskkonnaministeeriumil on maksustatavat naftat vastu võtnud isikute suhtes tagasinõudeõigus käesoleva paragrahvi lõike 1 kohaselt tehtud sissemaksete summa ulatuses proportsionaalselt maksustatava nafta kogusega, mille need isikud on vaadeldaval kalendriaastal vastu võtnud lisafondi protokolli artikli 11 kohaselt.",
      "rdfs:label": {
        "@value": "1992_aasta_rahvusvahelise_konventsiooni__Par_3 (redaktsioon 12988279)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12988279",
      "estleg:supersededByVersion": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_3_v216012024006"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12988279",
      "estleg:sourceAct": "1992. aasta rahvusvahelise konventsiooni rahvusvahelise naftareostuskahjude hüvitamise fondi loomisest 2003. aasta protokolliga ühinemise seadus",
      "estleg:provisionRef": "1992_aasta_rahvusvahelise_konventsiooni § 3",
      "estleg:partOfAct": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Map"
      }
    },
    {
      "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_3_v216012024006",
      "@type": [
        "owl:NamedIndividual",
