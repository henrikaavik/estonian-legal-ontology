      }
    },
    {
      "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_4_v12988279",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioon teostab keskkonnajärelevalve seaduse kohaselt järelevalvet isikute üle, kes peavad tegema lisafondi protokolli artikli 10 alusel sissemakseid naftareostuskahju hüvitamise rahvusvahelisse lisafondi. 1 Lisafondi protokoll on avaldatud Euroopa Liidu Teatajas L 78/24, 16.03.2004, lk 101–108.",
      "rdfs:label": {
        "@value": "1992_aasta_rahvusvahelise_konventsiooni__Par_4 (redaktsioon 12988279)",
        "@language": "et"
      },
