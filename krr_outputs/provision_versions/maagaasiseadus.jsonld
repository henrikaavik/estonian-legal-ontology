      },
      "estleg:versionText": "Energiaseaduse alusel sõlmitud ettevõtja ja riigi leping kehtib turuloas märgitud tähtpäevani.",
      "rdfs:label": {
        "@value": "MGS_Par_46 (redaktsioon 12894929)",
        "@language": "et"
