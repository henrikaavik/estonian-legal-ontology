    },
    {
      "@id": "estleg:MGS_Par_37_1_v128062012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_37_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurentsiamet jälgib süsteemihalduri vastavust käesoleva seaduse §-s 291 sätestatud nõuetele ning algatab gaasi ülekande teenust osutava ettevõtja nõuetekohasuse hindamise, järgides §-des 293 ja 294 sätestatut, kui: ta on saanud käesoleva seaduse § 16 lõikes 31 nimetatud teate; talle on saanud teatavaks, et süsteemihaldurit otseselt või kaudselt kontrolliva isiku õiguste või mõju kavandatav muudatus võib kaasa tuua käesoleva seaduse §-s 291 sätestatud nõuete rikkumise või kui tal on alust arvata, et selline rikkumine on juba toimunud; talle on saanud teatavaks asjaolu, mis võimaldab Euroopa Liidu välisest riigist pärit isikul omandada kontrolli süsteemihalduri üle; Euroopa Komisjon on esitanud põhjendatud taotluse.",
      "rdfs:label": {
        "@value": "MGS_Par_37_1 (redaktsioon 128062012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062012006"
    },
    {
      "@id": "estleg:MGS_Par_37_2_v109042014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_37_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hulgimüügitoodetega kauplemisega seotud turuosalised järgivad Euroopa Parlamendi ja nõukogu määruses (EL) nr 1227/2011 energia hulgimüügituru terviklikkuse ja läbipaistvuse kohta (ELT L 326, 08.12.2011, lk 1–16) sätestatud nõudeid. (2) Konkurentsiamet teeb käesoleva paragrahvi lõikes 1 nimetatud ülesande täitmisel koostööd Euroopa Liidu liikmesriikide reguleerivate asutustega ja energeetikasektorit reguleerivate asutuste koostööametiga.",
      "rdfs:label": {
        "@value": "MGS_Par_37_2 (redaktsioon 109042014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109042014007",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_37_2_v112072014073"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_37_2_v112072014073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_37_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hulgimüügitoodetega kauplemisega seotud turuosalised järgivad Euroopa Parlamendi ja nõukogu määruses (EL) nr 1227/2011 energia hulgimüügituru terviklikkuse ja läbipaistvuse kohta (ELT L 326, 08.12.2011, lk 1–16) sätestatud nõudeid. (2) Konkurentsiamet teeb käesoleva paragrahvi lõikes 1 nimetatud ülesande täitmisel koostööd Euroopa Liidu liikmesriikide reguleerivate asutustega ja energeetikasektorit reguleerivate asutuste koostööametiga. (3) Euroopa Parlamendi ja nõukogu määruse (EL) nr 1227/2011 artikli 9 lõikes 2 nimetatud energia hulgimüügituru turuosaliste ja toimingute andmekogu pidamise põhimääruse kehtestab määrusega.",
      "rdfs:label": {
        "@value": "MGS_Par_37_2 (redaktsioon 112072014073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014073",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_37_2_v130062017026"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_37_2_v130062017026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_37_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hulgimüügitoodetega kauplemisega seotud turuosalised järgivad Euroopa Parlamendi ja nõukogu määruses (EL) nr 1227/2011 energia hulgimüügituru terviklikkuse ja läbipaistvuse kohta (ELT L 326, 08.12.2011, lk 1–16) sätestatud nõudeid. (2) Konkurentsiamet teeb käesoleva paragrahvi lõikes 1 nimetatud ülesande täitmisel koostööd Euroopa Liidu liikmesriikide reguleerivate asutustega ja energeetikasektorit reguleerivate asutuste koostööametiga. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "MGS_Par_37_2 (redaktsioon 130062017026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062017026"
    },
    {
      "@id": "estleg:MGS_Par_38_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Oma ülesannete täitmiseks on inspektsioonil õigus: saada turuosalistelt ning riigi- ja kohaliku omavalitsuse asutustelt andmeid, mis on vajalikud käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud ülesannete täitmiseks; siseneda kohapealseks kontrollimiseks turuosalise territooriumile, ruumidesse ja rajatistesse, tutvuda seal järelevalve teostamiseks vajalike dokumentide, muu teabe ja asjaoludega ning teha väljavõtteid, ärakirju ja koopiaid; kontrollida gaasiettevõtja raamatupidamist ja saada vajalikku teavet tema majandustegevuse kohta; kontrollida käesolevas seaduses sätestatud juhtudel gaasiettevõtja rakendatavat hinnakujundust; kooskõlastada gaasi piirhindu ning võrguteenuste hindu käesolevas seaduses sätestatud korras ja juhtudel; kontrollida tegevusloa eest riigilõivu tasumist; teha oma pädevuse piires ettekirjutusi ja otsuseid; kehtestada gaasi ajutine edastamis- või jaotamishind mitte kauemaks kui kaheks kuuks olukorras, kus edastamis- või jaotamishind ei ole põhjendatud ning gaasiettevõtja ei järgi inspektsiooni tehtud ettekirjutust; esindada Eestit õigusaktidega ettenähtud korras rahvusvahelistes organisatsioonides ning teha koostööd välisriikide energiaturgu reguleerivate asutustega.",
      "rdfs:label": {
        "@value": "MGS_Par_38 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_38_v965355"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_38_v965355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Oma ülesannete täitmiseks on inspektsioonil õigus: saada turuosalistelt ning riigi- ja kohaliku omavalitsuse asutustelt andmeid, mis on vajalikud käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud ülesannete täitmiseks; siseneda kohapealseks kontrollimiseks turuosalise territooriumile, ruumidesse ja rajatistesse, tutvuda seal järelevalve teostamiseks vajalike dokumentide, muu teabe ja asjaoludega ning teha väljavõtteid, ärakirju ja koopiaid; kontrollida gaasiettevõtja raamatupidamist ja saada vajalikku teavet tema majandustegevuse kohta; kontrollida käesolevas seaduses sätestatud juhtudel gaasiettevõtja rakendatavat hinnakujundust; saada andmeid varustuskindluse aruande koostamiseks; kehtetu - kontrollida tegevusloa eest riigilõivu tasumist; teha oma pädevuse piires ettekirjutusi ja otsuseid; kehtestada gaasi ajutine ülekande- või jaotamishind mitte kauemaks kui kaheks kuuks olukorras, kus ülekande- või jaotamishind ei ole põhjendatud ning gaasiettevõtja ei järgi inspektsiooni tehtud ettekirjutust; esindada Eestit õigusaktidega ettenähtud korras rahvusvahelistes organisatsioonides ning teha koostööd teiste riikide energiaturgu reguleerivate asutustega.",
      "rdfs:label": {
        "@value": "MGS_Par_38 (redaktsioon 965355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "965355",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_38_v12766569"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
