      }
    },
    {
      "@id": "estleg:MGS_Par_48_v965355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne käesoleva seaduse jõustumist energiaseaduse alusel tegutsenud gaasiettevõtja peab oma tegevuse viima vastavusse käesolevas seaduses sätestatud nõuetega ühe aasta jooksul, arvates käesoleva seaduse jõustumisest. (2) Käesoleva seaduse § 8 1 lõike 1 alusel tegutsev võrguettevõtja peab oma tegevuse käesolevas seaduses sätestatud nõuetega vastavusse viima 2006. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "MGS_Par_48 (redaktsioon 965355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "965355",
