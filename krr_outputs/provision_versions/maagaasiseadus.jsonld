    },
    {
      "@id": "estleg:MGS_Par_21_1_v12796948",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_21_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võrgu planeerimisele ja ehitamisele kohaldatakse ehitiste planeerimiseks ja ehitamiseks kehtestatud nõudeid.",
      "rdfs:label": {
        "@value": "MGS_Par_21_1 (redaktsioon 12796948)",
