    },
    {
      "@id": "estleg:MGS_Par_48_2_v13196714",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Turgu valitsev gaasiettevõtja esitab Konkurentsiametile taotluse müügimarginaali piirmäära kooskõlastamiseks 2009. aasta 1. oktoobriks. Kuni käesoleva seaduse § 10 lõikes 3 nimetatud müügimarginaali piirmäära kooskõlastamiseni kasutab turgu valitsev gaasiettevõtja Konkurentsiameti poolt eelnevalt kooskõlastatud gaasi piirhindade arvutamise aluseks olevat müügimarginaali, mille suuruse esitab Konkurentsiamet turgu valitsevale gaasiettevõtjale 2009. aasta 1. augustiks.",
      "rdfs:label": {
        "@value": "MGS_Par_48_2 (redaktsioon 13196714)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196714"
    },
    {
      "@id": "estleg:MGS_Par_48_3_v128062012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Süsteemihaldur esitab Konkurentsiametile käesoleva seaduse § 16 lõike 1 punktis 25 nimetatud investeeringu kava hiljemalt 2012. aasta 1. detsembriks. (2) Süsteemihaldur esitab Konkurentsiametile käesoleva seaduse § 212 lõikes 1 nimetatud arengukava 2013. aasta 1. jaanuariks. (3) Süsteemihaldur esitab Konkurentsiametile käesoleva seaduse § 16 lõike 1 punktis 26 nimetatud andmed 2013. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "MGS_Par_48_3 (redaktsioon 128062012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062012006"
    },
    {
      "@id": "estleg:MGS_Par_48_4_v128062012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hiljemalt 2015. aasta 1. jaanuariks viib süsteemihaldur oma tegevuse vastavusse 2015. aasta 1. jaanuarist jõustuvate süsteemihaldurile esitatavate nõuetega, mille kohaselt on süsteemihaldur võrguettevõtja, kes omab ülekandevõrku, omab või haldab mõõtesüsteeme riigipiiril ning omab käesoleva seaduse § 301 lõikes 1 nimetatud tegevusluba gaasi ülekande teenuse osutamiseks. (2) Süsteemihaldur esitab 2013. aasta 1. jaanuariks Konkurentsiametile teabe alates 2015. aasta 1. jaanuarist süsteemihaldurile kehtivate nõuetega vastavusse viimiseks teostatud ja kavandatavate tegevuste ajakava kohta. Ajakava täitmist kontrollib Konkurentsiamet. (3) Gaasi ülekandevõrgu võib võõrandada tervikliku varana käesoleva seaduse §-s 292 sätestatud eelkontrolli raames vastavaks tunnistatud ettevõtjale.",
      "rdfs:label": {
        "@value": "MGS_Par_48_4 (redaktsioon 128062012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062012006"
    },
    {
      "@id": "estleg:MGS_Par_48_5_v130062017026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süsteemihaldur loob käesoleva seaduse § 102 lõikes 1 nimetatud andmevahetusplatvormi hiljemalt 2017. aasta 1. jaanuariks ja § 103 lõikes 6 nimetatud päritolutunnistuste elektroonilise andmebaasi hiljemalt 2017. aasta 1. juuliks.",
      "rdfs:label": {
        "@value": "MGS_Par_48_5 (redaktsioon 130062017026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062017026",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_48_5_v118052022014"
      },
      "estleg:versionValidTo": {
        "@value": "2022-05-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_48_5_v118052022014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MGS_Par_48_5 (redaktsioon 118052022014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118052022014"
    },
    {
      "@id": "estleg:MGS_Par_48_6_v109082022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_48_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võrguettevõtja määratleb käesoleva seaduse § 61 lõikes 1 nimetatud tarbijarühmad andmevahetusplatvormil kahe kuu jooksul peale nimetatud sätte jõustumist.",
      "rdfs:label": {
        "@value": "MGS_Par_48_6 (redaktsioon 109082022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109082022021"
    },
    {
      "@id": "estleg:MGS_Par_49_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigilõivuseaduses (RT I 1997, 80, 1344; 2001, 53, 310; 55, 331; 56, 332; 64, 367; 65, 377; 85, 512; 88, 531; 91, 543; 93, 565; 2002, 1, 1; 18, 97; 23, 131; 24, 135; 27, 151 ja 153; 30, 178; 35, 214; 44, 281; 47, 297; 51, 316; 57, 358; 58, 361; 61, 375; 62, 377; 90, 519; 102, 599; 105, 610; 2003, 4, 20) tehakse järgmised muudatused: paragrahvi 3 lõiget 2 täiendatakse punktiga 26 4 järgmises sõnastuses: « 26 4 ) maagaasiseaduse alusel teostatavad toimingud;»; paragrahvi 7 täiendatakse lõikega 1 2 järgmises sõnastuses: « (1 2 ) Käesoleva seaduse § 188 1 lõike 1 punktides 1–4 nimetatud tegevusloa andmisel tasub selle saaja riigilõivu tegevusloa kehtivusaasta eest 10 päeva enne järgmise kehtivusaasta algust.»; seadust täiendatakse §-ga 188 1 järgmises sõnastuses: « § 188 1 . Tegevusloa andmine ja tegevusloa tingimuste muutmine (1) Maagaasiseaduse § 27 lõikes 2 nimetatud tegevuseks antava tegevusloa eest tasutakse riigilõivu järgmiselt: gaasi import – 10 000 krooni kehtivusaasta kohta; gaasi müük – 4000 krooni kehtivusaasta kohta; gaasi võrgu kaudu edastamise või jaotamise teenuse osutamine – 4000 krooni kehtivusaasta kohta; süsteemihalduri teenuste osutamine – 30 000 krooni kehtivusaasta kohta. (2) Kui maagaasiseaduse § 27 lõikes 2 nimetatud tegevusalal tegutsemiseks väljastatud tegevusloa tingimusi muudetakse tegevusloa omaja algatusel, tasub viimane riigilõivu, mille suurus on 50 protsenti käesoleva paragrahvi lõikes 1 sätestatud riigilõivu määrast.»",
      "rdfs:label": {
        "@value": "MGS_Par_49 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_49_v729554"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_49_v729554",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "MGS_Par_49 (redaktsioon 729554)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "729554",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_49_v13338073"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_49_v13338073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "MGS_Par_49 (redaktsioon 13338073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13338073"
    },
    {
      "@id": "estleg:MGS_Par_5_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi vabatarbija on tarbija või gaasiettevõtja, kelle tarbijapaigaldise kaudu tarbitakse kalendriaastas üle 200 000 m 3 gaasi. (2) Gaasi vabatarbijal on õigus osta gaasi igalt bilansihaldurilt võrgu tehniliste võimaluste piires.",
      "rdfs:label": {
        "@value": "MGS_Par_5 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_5_v965355"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_5_v965355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi vabatarbija on turuosaline, kes ei ole kodutarbija. (2) Gaasi vabatarbijal on õigus osta gaasi võrgu tehniliste võimaluste piires igalt müüjalt.",
      "rdfs:label": {
        "@value": "MGS_Par_5 (redaktsioon 965355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "965355"
    },
    {
      "@id": "estleg:MGS_Par_50_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2003. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "MGS_Par_50 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477"
    },
    {
      "@id": "estleg:MGS_Par_6_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väiketarbija on tarbija, kelle tarbijapaigaldise kaudu tarbitakse kalendriaastas kuni 200 000 m 3 (kaasa arvatud) gaasi.",
      "rdfs:label": {
        "@value": "MGS_Par_6 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_6_v965355"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_6_v965355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi kodutarbija on tarbija, kes tarbib gaasi kodumajapidamises. (2) Kuni 2007. aasta 1. juulini ostab kodutarbija gaasi võrguettevõtjalt, kelle võrguga on tema tarbijapaigaldis ühendatud, või võrguettevõtja poolt nimetatud müüjalt. (3) Alates 2007. aasta 1. juulist on kodutarbijal õigus osta gaasi võrgu tehniliste võimaluste piires igalt müüjalt.",
      "rdfs:label": {
        "@value": "MGS_Par_6 (redaktsioon 965355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "965355"
    },
    {
      "@id": "estleg:MGS_Par_6_1_v109082022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_6_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/1938, mis käsitleb gaasivarustuskindluse tagamise meetmeid ja millega tunnistatakse kehtetuks määrus (EL) nr 994/2010 (ELT L 280, 28.10.2017, lk 1–56), artiklis 11 nimetatud hädaolukorras (edaspidi hädaolukord) tagavad gaasi müüja ja jaotusvõrguettevõtja gaasitarnete säilitamise tarbijarühmadele järgmises järjestuses: kodutarbijad; muud kaitstud tarbijad käesoleva seaduse § 261 lõike 2 punkti 2 tähenduses; avariireservelektrijaam elektrituruseaduse tähenduses; ühiskonna toimimiseks vajalike teenuste osutajatest tarbijad, kelle tegevuse jätkamine sõltub gaasivarustuse olemasolust; muud tarbijad, kelle puhul eeldatav gaasivarustuse katkestamise aeg on kuni kuus tundi; muud tarbijad, kelle puhul gaasivarustuse katkestamise aeg on üle kuue tunni. (2) Tarbija käesoleva paragrahvi lõikes 1 sätestatud tarbijarühma määramine toimub käesoleva seaduse §-s 102 nimetatud andmevahetusplatvormil märke tegemisega võrguettevõtja poolt. (3) Tarbijate käesoleva paragrahvi lõikes 1 sätestatud tarbijarühmadesse määramise põhimõtted kehtestab Euroopa Parlamendi ja nõukogu määruse (EL) 2017/1938 põhimõtetest lähtudes määrusega.",
      "rdfs:label": {
        "@value": "MGS_Par_6_1 (redaktsioon 109082022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109082022021"
    },
    {
      "@id": "estleg:MGS_Par_7_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi import on gaasi toimetamine tolliterritooriumile tolliseadustiku (RT I 2001, 88, 531; 2002, 44, 284; 61, 375; 63, 387; 92, 528; 2003, 2, 17) tähenduses. (2) Gaasi edastamine käesoleva seaduse mõistes on lisaenergia abil gaasirõhu tõstmisega teostatav gaasi transportimine piirkondlike jaotustorustikeni. (3) Gaasi jaotamine käesoleva seaduse mõistes on isevoolse gaasi transportimine piirkondlike või kohalike jaotustorustike kaudu tarbijapaigaldisteni. (4) Gaasi müük käesoleva seaduse mõistes on gaasi üleandmine isikule tasu eest või tasuta.",
      "rdfs:label": {
        "@value": "MGS_Par_7 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_7_v965355"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_7_v965355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi import on gaasile vabasse ringlusse lubamise tolliprotseduuri kohaldamine EÜ Nõukogu määruse 2913/92/EMÜ, millega kehtestatakse ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1–50), tähenduses. (2) Gaasi ülekanne käesoleva seaduse tähenduses on gaasi transportimine kõrgsurvetorustiku kaudu tarbijapaigaldisteni või kokkulepitud liitumispunktini. (3) Gaasi jaotamine käesoleva seaduse tähenduses on gaasi transportimine piirkondlike või kohalike jaotustorustike kaudu tarbijapaigaldisteni või kokkulepitud liitumispunktini. (4) Gaasi müük käesoleva seaduse tähenduses on gaasi üleandmine isikule tasu eest.",
      "rdfs:label": {
        "@value": "MGS_Par_7 (redaktsioon 965355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "965355",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_7_v128062012006"
      },
      "estleg:versionValidTo": {
        "@value": "2012-07-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_7_v128062012006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi import on gaasile vabasse ringlusse lubamise tolliprotseduuri kohaldamine EÜ Nõukogu määruse 2913/92/EMÜ, millega kehtestatakse ühenduse tolliseadustik (EÜT L 302, 19.10.1992, lk 1–50), tähenduses. (2) Gaasi ülekanne käesoleva seaduse tähenduses on gaasi transportimine kõrgsurvetorustiku kaudu tarbijapaigaldisteni või kokkulepitud liitumispunktini. Gaasi ülekandeks ei peeta tootmisetapi torustiku ega kõrgsurvetorustiku osa kasutamist gaasi kohalikuks jaotamiseks. (3) Gaasi jaotamine käesoleva seaduse tähenduses on gaasi transportimine piirkondlike või jaotustorustike kaudu tarbijapaigaldisteni või kokkulepitud liitumispunktini, kaasa arvatud kõrgsurvetorustiku osa, mida kasutatakse gaasi kohalikuks jaotamiseks. (4) Gaasi müük käesoleva seaduse tähenduses on gaasi üleandmine isikule tasu eest.",
      "rdfs:label": {
        "@value": "MGS_Par_7 (redaktsioon 128062012006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062012006",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_7_v130062017025"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_7_v130062017025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi import on gaasile vabasse ringlusse lubamise tolliprotseduuri kohaldamine Euroopa Parlamendi ja nõukogu määruse (EL) nr 952/2013, millega kehtestatakse liidu tolliseadustik (ELT L 269, 10.10.2013, lk 1–101), tähenduses. (2) Gaasi ülekanne käesoleva seaduse tähenduses on gaasi transportimine kõrgsurvetorustiku kaudu tarbijapaigaldisteni või kokkulepitud liitumispunktini. Gaasi ülekandeks ei peeta tootmisetapi torustiku ega kõrgsurvetorustiku osa kasutamist gaasi kohalikuks jaotamiseks. (3) Gaasi jaotamine käesoleva seaduse tähenduses on gaasi transportimine piirkondlike või jaotustorustike kaudu tarbijapaigaldisteni või kokkulepitud liitumispunktini, kaasa arvatud kõrgsurvetorustiku osa, mida kasutatakse gaasi kohalikuks jaotamiseks. (4) Gaasi müük käesoleva seaduse tähenduses on gaasi üleandmine isikule tasu eest.",
      "rdfs:label": {
        "@value": "MGS_Par_7 (redaktsioon 130062017025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062017025",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_7_v130062017026"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_7_v130062017026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasi import on gaasile vabasse ringlusse lubamise tolliprotseduuri kohaldamine Euroopa Parlamendi ja nõukogu määruse (EL) nr 952/2013, millega kehtestatakse liidu tolliseadustik (ELT L 269, 10.10.2013, lk 1–101), tähenduses. (2) Gaasi ülekanne käesoleva seaduse tähenduses on gaasi transportimine ülekandevõrgu kaudu kokkulepitud liitumispunktini või liitumispunktist ülekandevõrguni. Gaasi ülekandeks ei peeta tootmisetapi torustiku ega ülekandevõrgu osa kasutamist gaasi kohalikuks jaotamiseks. (3) Gaasi jaotamine käesoleva seaduse tähenduses on gaasi transportimine piirkondlike või jaotustorustike kaudu tarbijapaigaldisteni, kokkulepitud liitumispunktini või liitumispunktist jaotustorustikuni, kaasa arvatud ülekandevõrgu osa, mida kasutatakse gaasi kohalikuks jaotamiseks. (4) Gaasi müük käesoleva seaduse tähenduses on gaasi üleandmine isikule tasu eest.",
      "rdfs:label": {
        "@value": "MGS_Par_7 (redaktsioon 130062017026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062017026"
    },
    {
      "@id": "estleg:MGS_Par_8_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasiettevõtja peab tagama tarbija gaasiga varustamise vastavuses käesoleva seaduse, tegevusloa tingimuste ja sõlmitud lepinguga. (2) Gaasiettevõtja peab oma raamatupidamises pidama eraldi arvestust gaasi edastamise, jaotamise, müügi ja nende tegevustega mitteseotud tegevusalade kohta. (3) Gaasiettevõtja peab lubama Energiaturu Inspektsioonil (edaspidi inspektsioon ) kontrollida oma raamatupidamist ning andma oma majandustegevuse kohta vajalikke selgitusi. (4) Gaasiettevõtja esitab gaasi müügiga seotud asjakohased andmed Statistikaametile. Andmete loetelu ja andmete esitamise korra ning andmeid sisaldava dokumendi vormi kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "MGS_Par_8 (redaktsioon 261477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "261477",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_8_v965355"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_8_v965355",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasiettevõtja peab tagama tarbija gaasiga varustamise vastavuses käesoleva seaduse, tegevusloa tingimuste ja sõlmitud lepinguga. (2) Gaasiettevõtja peab oma raamatupidamises pidama eraldi arvestust gaasi ülekande, jaotamise, müügi ja nende tegevustega mitteseotud tegevusalade kohta. (2¹) Kuni 2007. aasta 1. juulini peab gaasiettevõtja oma raamatupidamises pidama gaasi müügi arvestust eraldi kodutarbijate ja vabatarbijate kohta. (2²) Gaasiettevõtja peab kehtestama oma raamatupidamiseeskirjad varade ja kohustuste ning tulude ja kulude jaotamise osas, mida järgitakse käesoleva paragrahvi lõikes 2 nimetatud tegevusalade arvestuses. (3) Gaasiettevõtja peab lubama Energiaturu Inspektsioonil (edaspidi ka inspektsioon ) kontrollida oma raamatupidamist ning andma oma majandustegevuse kohta vajalikke selgitusi. (4) Gaasiettevõtja esitab gaasi müügiga seotud asjakohased andmed Statistikaametile. (5) Gaasiettevõtja peab avaldama kooskõlastatud piirhinnad, metoodikad ja tüüptingimused oma veebilehel või andma nende kohta teavet isikule, kes seda nõuab.",
      "rdfs:label": {
        "@value": "MGS_Par_8 (redaktsioon 965355)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "965355",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_8_v12796948"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_8_v12796948",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasiettevõtja peab tagama tarbija gaasiga varustamise vastavuses käesoleva seaduse, tegevusloa tingimuste ja sõlmitud lepinguga. (2) Gaasiettevõtja peab raamatupidamise sise-eeskirjas kehtestama põhimõtted, mille kohaselt peetakse arvestust gaasi ülekande, jaotamise, müügi ja nende tegevustega mitteseotud tegevusalade kohta nii, nagu oleksid kohustatud seda tegema nendel tegevusaladel eraldi tegutsevad ettevõtjad. (2¹) Gaasiettevõtja peab oma raamatupidamises pidama gaasi müügi arvestust eraldi kodutarbijate ja vabatarbijate kohta. (2²) Gaasiettevõtja peab kehtestama oma raamatupidamiseeskirjad varade ja kohustuste ning tulude ja kulude jaotamise osas, mida järgitakse käesoleva paragrahvi lõikes 2 nimetatud tegevusalade arvestuses. (3) Gaasiettevõtja peab lubama Energiaturu Inspektsioonil (edaspidi ka inspektsioon ) kontrollida oma raamatupidamist ning andma oma majandustegevuse kohta vajalikke selgitusi. (4) Gaasiettevõtja esitab gaasi müügiga seotud asjakohased andmed Statistikaametile. (5) Gaasiettevõtja peab avaldama kooskõlastatud piirhinnad, metoodikad ja tüüptingimused oma veebilehel või andma nende kohta teavet isikule, kes seda nõuab. (6) Gaasiettevõtja korraldab oma majandusaasta aruande koostamise, esitamise ja avalikustamise vastavalt raamatupidamise seadusele. Kui audiitorkontroll on kohustuslik, peab audiitori järeldusotsus muu hulgas sisaldama hinnangut gaasiettevõtja majandusaasta aruande ja selle lisade vastavuse kohta käesolevale seadusele.",
      "rdfs:label": {
        "@value": "MGS_Par_8 (redaktsioon 12796948)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12796948",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_8_v12894929"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_8_v12894929",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasiettevõtja peab tagama tarbija gaasiga varustamise vastavuses käesoleva seaduse, tegevusloa tingimuste ja sõlmitud lepinguga. (2) Gaasiettevõtja peab raamatupidamise sise-eeskirjas kehtestama põhimõtted, mille kohaselt peetakse arvestust gaasi ülekande, jaotamise, müügi ja nende tegevustega mitteseotud tegevusalade kohta nii, nagu oleksid kohustatud seda tegema nendel tegevusaladel eraldi tegutsevad ettevõtjad. (2¹) Gaasiettevõtja peab oma raamatupidamises pidama gaasi müügi arvestust eraldi kodutarbijate ja vabatarbijate kohta. (2²) Gaasiettevõtja peab kehtestama oma raamatupidamiseeskirjad varade ja kohustuste ning tulude ja kulude jaotamise osas, mida järgitakse käesoleva paragrahvi lõikes 2 nimetatud tegevusalade arvestuses. (3) Gaasiettevõtja peab lubama Konkurentsiametil kontrollida oma raamatupidamist ning andma oma majandustegevuse kohta vajalikke selgitusi. (4) Gaasiettevõtja esitab gaasi müügiga seotud asjakohased andmed Statistikaametile. (5) Gaasiettevõtja peab avaldama kooskõlastatud piirhinnad, metoodikad ja tüüptingimused oma veebilehel või andma nende kohta teavet isikule, kes seda nõuab. (6) Gaasiettevõtja korraldab oma majandusaasta aruande koostamise, esitamise ja avalikustamise vastavalt raamatupidamise seadusele. Kui audiitorkontroll on kohustuslik, peab audiitori järeldusotsus muu hulgas sisaldama hinnangut gaasiettevõtja majandusaasta aruande ja selle lisade vastavuse kohta käesolevale seadusele.",
      "rdfs:label": {
        "@value": "MGS_Par_8 (redaktsioon 12894929)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894929",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_8_v13196714"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_8_v13196714",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasiettevõtja peab tagama tarbija gaasiga varustamise vastavuses käesoleva seaduse, tegevusloa tingimuste ja sõlmitud lepinguga. (2) Gaasiettevõtja peab raamatupidamise sise-eeskirjas kehtestama põhimõtted, mille kohaselt peetakse arvestust gaasi ülekande, jaotamise, müügi ja nende tegevustega mitteseotud tegevusalade kohta nii, nagu oleksid kohustatud seda tegema nendel tegevusaladel eraldi tegutsevad ettevõtjad. (2¹) Gaasiettevõtja peab oma raamatupidamises pidama gaasi müügi arvestust eraldi kodutarbijate ja vabatarbijate kohta. (2²) Gaasiettevõtja peab kehtestama oma raamatupidamiseeskirjad varade ja kohustuste ning tulude ja kulude jaotamise osas, mida järgitakse käesoleva paragrahvi lõikes 2 nimetatud tegevusalade arvestuses. (3) Gaasiettevõtja peab lubama Konkurentsiametil kontrollida oma raamatupidamist ning andma oma majandustegevuse kohta vajalikke selgitusi. (4) Gaasiettevõtja esitab Statistikaametile andmed gaasi ja võrguteenuse hinna kujunemise kohta. Andmed kantakse riikliku statistika seaduse § 3 lõike 3 alusel rahandusministri kehtestatud vormidele. (5) Gaasiettevõtja peab avaldama kooskõlastatud hinnad, piirmäärad, metoodikad ja tüüptingimused oma veebilehel või andma nende kohta teavet isikule, kes seda nõuab. (6) Gaasiettevõtja korraldab oma majandusaasta aruande koostamise, esitamise ja avalikustamise vastavalt raamatupidamise seadusele. Kui audiitorkontroll on kohustuslik, peab audiitori järeldusotsus muu hulgas sisaldama hinnangut gaasiettevõtja majandusaasta aruande ja selle lisade vastavuse kohta käesolevale seadusele.",
      "rdfs:label": {
        "@value": "MGS_Par_8 (redaktsioon 13196714)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13196714",
      "estleg:supersededByVersion": {
        "@id": "estleg:MGS_Par_8_v13278705"
      },
      "estleg:versionValidTo": {
        "@value": "2010-03-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MGS_Par_8_v13278705",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Gaasiettevõtja peab tagama tarbija gaasiga varustamise vastavuses käesoleva seaduse, tegevusloa tingimuste ja sõlmitud lepinguga. (2) Gaasiettevõtja peab raamatupidamise sise-eeskirjas kehtestama põhimõtted, mille kohaselt peetakse arvestust gaasi ülekande, jaotamise, müügi ja nende tegevustega mitteseotud tegevusalade kohta nii, nagu oleksid kohustatud seda tegema nendel tegevusaladel eraldi tegutsevad ettevõtjad. (2¹) Gaasiettevõtja peab oma raamatupidamises pidama gaasi müügi arvestust eraldi kodutarbijate ja vabatarbijate kohta. (2²) Gaasiettevõtja peab kehtestama oma raamatupidamiseeskirjad varade ja kohustuste ning tulude ja kulude jaotamise osas, mida järgitakse käesoleva paragrahvi lõikes 2 nimetatud tegevusalade arvestuses. (3) Gaasiettevõtja peab lubama Konkurentsiametil kontrollida oma raamatupidamist ning andma oma majandustegevuse kohta vajalikke selgitusi. (4) Gaasiettevõtja esitab Statistikaametile andmed gaasi ja võrguteenuse hinna kujunemise kohta. Andmed kantakse riikliku statistika seaduse § 3 lõike 3 alusel rahandusministri kehtestatud vormidele. (5) Gaasiettevõtja peab avaldama kooskõlastatud hinnad, piirmäärad, metoodikad ja tüüptingimused oma veebilehel või andma nende kohta teavet isikule, kes seda nõuab. (6) Gaasiettevõtja korraldab oma majandusaasta aruande koostamise, esitamise ja avalikustamise vastavalt raamatupidamise seadusele. Kui audiitorkontroll on kohustuslik, peab vandeaudiitori aruanne muu hulgas sisaldama hinnangut gaasiettevõtja majandusaasta aruande ja selle lisade vastavuse kohta käesolevale seadusele.",
      "rdfs:label": {
        "@value": "MGS_Par_8 (redaktsioon 13278705)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13278705",
