        "@value": "MGS_Par_44_2 (redaktsioon 109042014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109042014007"
    },
    {
      "@id": "estleg:MGS_Par_44_3_v130062017026",
      "@type": [
