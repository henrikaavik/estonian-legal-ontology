      }
    },
    {
      "@id": "estleg:MGS_Par_47_v129062014036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MGS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Energiaseaduse alusel antud turuluba kehtib turuloas märgitud tähtpäevani. (2) Konkurentsiamet registreerib enne käesoleva seaduse jõustumist väljaantud kehtivad turuload majandustegevuse registris 2005. aasta 15. aprilliks. (3) Enne 2012. aasta 8. juulit antud gaasi ülekande teenuse osutamise tegevusluba kehtib kuni käesoleva seaduse § 301 lõikes 1 nimetatud tegevusloa andmiseni või 2015. aasta 1. jaanuarini.",
      "rdfs:label": {
        "@value": "MGS_Par_47 (redaktsioon 129062014036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014036"
    },
    {
      "@id": "estleg:MGS_Par_48_v261477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
