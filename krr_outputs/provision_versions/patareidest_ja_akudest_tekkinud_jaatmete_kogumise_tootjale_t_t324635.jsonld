      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Patareidest ja akudest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning sihtarvud ja sihtarvude saavutamise tähtajad (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Patareidest ja akudest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning sihtarvud ja sihtarvude saavutamise tähtajad"
    },
