      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000238",
      "estleg:sourceAct": "Krediidiasutuse kohustusliku reservi nõude arvestuse aruande kehtestamine",
      "estleg:provisionRef": "Reg_1000238 § 4",
      "estleg:partOfAct": {
