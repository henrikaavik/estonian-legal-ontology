        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet asub Tallinnas. Ameti mujal asuva struktuuriüksuse asukoht märgitakse struktuuriüksuse põhimääruses. Amet asub Tallinnas. Ameti mujal asuva struktuuriüksuse asukoht märgitakse struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1063200_Par_2 (redaktsioon 1063200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1063200",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1063200",
