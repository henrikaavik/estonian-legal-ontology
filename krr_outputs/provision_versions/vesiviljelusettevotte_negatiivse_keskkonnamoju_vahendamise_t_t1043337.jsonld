      "estleg:versionValidFrom": {
        "@value": "2023-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Euroopa Merendus- ja Kalandusfondi rakenduskava 2014–2020” (edaspidi rakenduskava) meetme „Vesiviljeluse jätkusuutlik areng” raames vesiviljelusettevõtte negatiivse keskkonnamõju vähendamise toetuse (edaspidi toetus) andmise tingimused ja kord. Määrusega kehtestatakse „Euroopa Merendus- ja Kalandusfondi rakenduskava 2014–2020” (edaspidi rakenduskava) meetme „Vesiviljeluse jätkusuutlik areng” raames vesiviljelusettevõtte negatiivse keskkonnamõju vähendamise toetuse (edaspidi toetus) andmise tingimused ja kord.",
      "rdfs:label": {
        "@value": "Reg_1043337_Par_1 (redaktsioon 1043337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043337",
