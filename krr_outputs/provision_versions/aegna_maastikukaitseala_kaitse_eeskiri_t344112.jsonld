        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_344112_Par_3 (redaktsioon 344112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344112",
