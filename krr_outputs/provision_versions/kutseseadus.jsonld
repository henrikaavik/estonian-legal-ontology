    },
    {
      "@id": "estleg:Kutseseadus_Par_23_v114032014062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Kutseseadus_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutseasutuse ning kutsenõukogude tegevuse üle käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmisel teostab haldusjärelevalvet Haridus- ja Teadusministeerium (edaspidi järelevalveorgan).",
      "rdfs:label": {
