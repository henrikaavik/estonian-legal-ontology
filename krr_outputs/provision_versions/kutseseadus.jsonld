      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutseasutuse ning kutsenõukogude tegevuse üle käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmisel teostab riiklikku järelevalvet Haridus- ja Teadusministeerium (edaspidi järelevalveorgan).",
      "rdfs:label": {
