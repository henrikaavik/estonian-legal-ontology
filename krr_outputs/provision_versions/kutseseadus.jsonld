      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Kutseseadus_Par_31 (redaktsioon 13147615)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13147615",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13147615",
      "estleg:sourceAct": "Kutseseadus",
