        "@id": "estleg:KoPS_Par_52_3_v103072017010"
      },
      "estleg:versionValidTo": {
        "@value": "2017-07-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KoPS_Par_52_3_v103072017010",
