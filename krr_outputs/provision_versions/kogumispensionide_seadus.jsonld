      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KoPS_Par_9_v742775",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Makse määr on 2% käesoleva seaduse § 7 lõikes 1 nimetatud tasudelt.",
      "rdfs:label": {
        "@value": "KoPS_Par_9 (redaktsioon 742775)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742775",
      "estleg:supersededByVersion": {
        "@id": "estleg:KoPS_Par_9_v106072023045"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KoPS_Par_9_v106072023045",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Makse määr on 2% käesoleva seaduse § 7 lõikes 1 nimetatud tasudelt, kui kohustatud isik ei ole valinud käesoleva paragrahvi lõikes 2 sätestatud muud makse määra. (2) Kohustatud isik võib valida makse määraks 4% või 6%. Valitud makse määr kehtib kohustatud isiku suhtes vähemalt kalendriaasta. (3) Käesoleva paragrahvi lõikes 2 nimetatud makse määra valimine või sellest loobumine (edaspidi makse määra muutmine) toimub käesoleva seaduse §-s 172 sätestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "KoPS_Par_9 (redaktsioon 106072023045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023045"
    }
  ]
}
