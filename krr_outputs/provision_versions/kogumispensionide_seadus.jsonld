        "@language": "et"
      },
      "estleg:versionRedactionId": "127102020010",
      "estleg:supersededByVersion": {
        "@id": "estleg:KoPS_Par_72_2_v128122020002"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KoPS_Par_72_2_v128122020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
