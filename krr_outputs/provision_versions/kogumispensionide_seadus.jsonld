      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kellel on tuvastatud täielik töövõimetus riikliku pensionikindlustuse seaduse alusel, loetakse käesoleva seaduse § 40 lõikes 11 ja § 63 lõikes 3 sätestatud puuduva töövõime tingimus täidetuks.",
      "rdfs:label": {
