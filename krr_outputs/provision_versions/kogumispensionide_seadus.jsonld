      "estleg:versionRedactionId": "13334277"
    },
    {
      "@id": "estleg:KoPS_Par_72_1_v125102012013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_72_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalkindlustusamet arvutab käesoleva seaduse § 10 lõikes 1 nimetatud Eesti keskmise sotsiaalmaksuga maksustatava ühe kalendrikuu tulu 2013. aastaks 2011. aasta sotsiaalmaksu andmete alusel sama paragrahvi lõike 2 kohaselt hiljemalt 2013. aasta 10. jaanuariks.",
      "rdfs:label": {
        "@value": "KoPS_Par_72_1 (redaktsioon 125102012013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125102012013"
    },
    {
      "@id": "estleg:KoPS_Par_72_2_v130122015081",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_72_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kellel on tuvastatud täielik töövõimetus riikliku pensionikindlustuse seaduse alusel, loetakse käesoleva seaduse § 63 lõikes 3 sätestatud puuduva töövõime tingimus täidetuks. (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
        "@value": "KoPS_Par_72_2 (redaktsioon 130122015081)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015081",
      "estleg:supersededByVersion": {
        "@id": "estleg:KoPS_Par_72_2_v127102020010"
      },
      "estleg:versionValidTo": {
        "@value": "2020-11-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KoPS_Par_72_2_v127102020010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_72_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-11-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kellel on tuvastatud täielik töövõimetus riikliku pensionikindlustuse seaduse alusel, loetakse käesoleva seaduse § 40 lõikes 1 ja § 63 lõikes 3 sätestatud puuduva töövõime tingimus täidetuks.",
      "rdfs:label": {
