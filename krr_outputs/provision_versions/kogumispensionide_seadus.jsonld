      }
    },
    {
      "@id": "estleg:KoPS_Par_72_2_v117032023073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_72_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kellel on tuvastatud täielik töövõimetus riikliku pensionikindlustuse seaduse alusel või püsiv töövõimetus 100-protsendilise töövõime kaotusega kaitseväeteenistuse seaduse alusel, loetakse käesoleva seaduse § 40 lõikes 11, § 60 lõikes 2, § 63 lõikes 3 ja § 64 lõikes 11 sätestatud puuduva töövõime tingimus täidetuks.",
      "rdfs:label": {
        "@value": "KoPS_Par_72_2 (redaktsioon 117032023073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023073",
      "estleg:supersededByVersion": {
        "@id": "estleg:KoPS_Par_72_2_v117032023074"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KoPS_Par_72_2_v117032023074",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_72_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikul, kellel on tuvastatud täielik töövõimetus riikliku pensionikindlustuse seaduse alusel või püsiv töövõimetus 100-protsendilise töövõime kaotusega kaitseväeteenistuse seaduse alusel, loetakse käesoleva seaduse § 40 lõikes 11, § 60 lõikes 2, § 63 lõikes 3, § 64 lõikes 11 ja §-s 651 sätestatud puuduva töövõime tingimus täidetuks.",
      "rdfs:label": {
        "@value": "KoPS_Par_72_2 (redaktsioon 117032023074)",
        "@language": "et"
      },
