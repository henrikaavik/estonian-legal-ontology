      }
    },
    {
      "@id": "estleg:KoPS_Par_7_v195187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 06. 2002] (1) Makset tasutakse sotsiaalmaksuseaduse § 2 lõike 1 punktides 1, 3, 4 ja 6 nimetatud tasudelt. [Lõike 1 sõnastus alates 1. 07. 2002] (1) Makset tasutakse sotsiaalmaksuseaduse § 2 lõike 1 punktides 1-4, 6 ja 8 nimetatud tasudelt. [Lõike 2 sõnastus kuni 30. 06. 2002] (2) Makset ei tasuta sotsiaalmaksuseaduse § 2 lõike 1 punktides 2, 5 ja 7 ning §-s 3 nimetatud summadelt. [Lõike 2 sõnastus alates 1. 07. 2002] Makset ei tasuta sotsiaalmaksuseaduse § 2 lõike 1 punktides 5 ja 7 ning §-s 3 nimetatud summadelt. Samuti ei tasuta makset töötuskindlustuse seaduses (RT I 2001, 59, 359; 82, 488) sätestatud töötuskindlustushüvitiselt.",
      "rdfs:label": {
