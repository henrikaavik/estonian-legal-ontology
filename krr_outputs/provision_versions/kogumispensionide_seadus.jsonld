    {
      "@id": "estleg:KoPS_Par_8_v22481",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KoPS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Makse määr on 2% käesoleva seaduse § 7 lõikes 1 nimetatud tasudelt.",
      "rdfs:label": {
        "@value": "KoPS_Par_8 (redaktsioon 22481)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22481",
      "estleg:supersededByVersion": {
        "@id": "estleg:KoPS_Par_8_v742775"
      },
