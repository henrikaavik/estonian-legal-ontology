        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. septembril 2009. aastal, välja arvatud § 8 lõige 3 ja § 11 lõige 1, mis jõustuvad 1. septembril 2019. aastal. Määrus jõustub 1. septembril 2009. aastal, välja arvatud § 8 lõige 3 ja § 11 lõige 1, mis jõustuvad 1. septembril 2019. aastal.",
      "rdfs:label": {
