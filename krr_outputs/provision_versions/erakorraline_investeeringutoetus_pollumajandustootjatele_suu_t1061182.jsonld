        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse suu- ja sõrataudi ennetamiseks erakorralise investeeringutoetuse (edaspidi toetus) andmise ja kasutamise tingimused ning kord. Määrusega kehtestatakse suu- ja sõrataudi ennetamiseks erakorralise investeeringutoetuse (edaspidi toetus) andmise ja kasutamise tingimused ning kord.",
      "rdfs:label": {
        "@value": "Reg_1061182_Par_1 (redaktsioon 1061182)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061182",
