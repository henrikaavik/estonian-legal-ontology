      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Lepinguliste kohustuste suhtes kohaldatava õiguse konventsiooniga ning selle protokollidega ühinemise konventsiooni ratifitseerimise seadus (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lepinguliste kohustuste suhtes kohaldatava õiguse konventsiooniga ning selle protokollidega ühinemise konventsiooni ratifitseerimise seadus"
    },
    {
      "@id": "estleg:lepinguliste_kohustuste_suhtes_kohaldata_Par_1_v1026913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:lepinguliste_kohustuste_suhtes_kohaldata_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida 2005. aasta 14. aprillil Luxembourgis koostatud konventsioon Tšehhi Vabariigi, Eesti Vabariigi, Küprose Vabariigi, Läti Vabariigi, Leedu Vabariigi, Ungari Vabariigi, Malta Vabariigi, Poola Vabariigi, Sloveenia Vabariigi ja Slovaki Vabariigi ühinemise kohta 19. juunil 1980. aastal Roomas allakirjutamiseks avatud lepinguliste kohustuste suhtes kohaldatava õiguse konventsiooniga ning esimese ja teise protokolliga selle Euroopa Ühenduste Kohtus tõlgendamise kohta.",
      "rdfs:label": {
        "@value": "lepinguliste_kohustuste_suhtes_kohaldata_Par_1 (redaktsioon 1026913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026913",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026913",
      "estleg:sourceAct": "Lepinguliste kohustuste suhtes kohaldatava õiguse konventsiooniga ning selle protokollidega ühinemise konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "lepinguliste_kohustuste_suhtes_kohaldata § 1",
      "estleg:partOfAct": {
        "@id": "estleg:lepinguliste_kohustuste_suhtes_kohaldata_Map_2026"
      }
    },
    {
      "@id": "estleg:lepinguliste_kohustuste_suhtes_kohaldata_Par_2_v1026913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:lepinguliste_kohustuste_suhtes_kohaldata_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "19. juunil 1980. aastal Roomas allakirjutamiseks avatud lepinguliste kohustuste suhtes kohaldatava õiguse konventsiooni esimese protokolli artikli 2 punktis a nimetatud kohtute otsuseid ja punktis b nimetatud kohtute tähtsaid otsuseid edastab Euroopa Ühenduste Kohtule Justiitsministeerium. Esimese protokolli artikli 3 lõikes 1 nimetatud pädevaks asutuseks on Justiitsministeerium ning lõikes 3 nimetatud pädevaks ametiisikuks on valdkonna eest vastutav minister. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"justiitsminister\" sõnadega \"valdkonna eest vastutav minister\".",
      "rdfs:label": {
        "@value": "lepinguliste_kohustuste_suhtes_kohaldata_Par_2 (redaktsioon 1026913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026913",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026913",
      "estleg:sourceAct": "Lepinguliste kohustuste suhtes kohaldatava õiguse konventsiooniga ning selle protokollidega ühinemise konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "lepinguliste_kohustuste_suhtes_kohaldata § 2",
      "estleg:partOfAct": {
        "@id": "estleg:lepinguliste_kohustuste_suhtes_kohaldata_Map_2026"
      }
    }
  ]
