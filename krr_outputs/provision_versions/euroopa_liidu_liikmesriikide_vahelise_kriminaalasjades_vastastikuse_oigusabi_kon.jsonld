      "estleg:versionValidFrom": {
        "@value": "2004-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 27 lõike 2 kohast teadet edastades deklareerib Eesti Vabariik: konventsiooni artikli 9 lõike 6 kohaselt, et enne vahi all viibiva isiku ajutist üleviimist käsitleva kokkuleppe sõlmimist artikli 9 lõike 1 alusel on igal juhul nõutav artikli 9 lõikes 3 nimetatud kirjalik nõusolek tema üleviimiseks; konventsiooni artikli 14 lõike 4 kohaselt, et artikkel 14 ei ole Eesti suhtes siduv.",
      "rdfs:label": {
        "@value": "ELLKVOKU_Par_3 (redaktsioon 761204)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "761204"
