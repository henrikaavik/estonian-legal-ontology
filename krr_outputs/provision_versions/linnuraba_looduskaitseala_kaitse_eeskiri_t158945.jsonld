    {
      "@id": "estleg:Reg_158945_Par_10_v158945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158945_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevööndi kaitse-eesmärk on: 1 1) Kodila ja Kustja sihtkaitsevööndis kaitsealuste looma- ja taimeliikide kaitse ning koosluste liikide mitmekesisuse säilitamine; 2 2) Linnuraba sihtkaitsevööndis Linnuraba koosluste ja maastikuilme säilitamine. Sihtkaitsevööndi kaitse-eesmärk on: Kodila ja Kustja sihtkaitsevööndis kaitsealuste looma- ja taimeliikide kaitse ning koosluste liikide mitmekesisuse säilitamine; Linnuraba sihtkaitsevööndis Linnuraba koosluste ja maastikuilme säilitamine. 2 (2) Kaitse-eesmärgi saavutamine tagatakse: 1 1) Kodila ja Kustja sihtkaitsevööndis vajaduse korral hooldustöödega; 2 2) Linnuraba sihtkaitsevööndis üksnes loodusliku protsessina. Kaitse-eesmärgi saavutamine tagatakse: Kodila ja Kustja sihtkaitsevööndis vajaduse korral hooldustöödega; Linnuraba sihtkaitsevööndis üksnes loodusliku protsessina.",
      "rdfs:label": {
        "@value": "Reg_158945_Par_10 (redaktsioon 158945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158945",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158945",
      "estleg:sourceAct": "Linnuraba looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158945 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158945_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158945_Par_11_v158945",
      "@type": [
        "owl:NamedIndividual",
