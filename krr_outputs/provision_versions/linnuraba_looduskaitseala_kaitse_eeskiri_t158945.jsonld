    {
      "@id": "estleg:Reg_158945_Par_12_v158945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158945_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) ehitiste püstitamine kaitseala ja seal paikneva kinnistu tarbeks; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 3 3) uuendusraie, kusjuures uuendusraie tegemisel turberaiena tuleb säilitada koosluse liikide ja vanuse mitmekesisus. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: ehitiste püstitamine kaitseala ja seal paikneva kinnistu tarbeks; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uuendusraie, kusjuures uuendusraie tegemisel turberaiena tuleb säilitada koosluse liikide ja vanuse mitmekesisus.",
      "rdfs:label": {
        "@value": "Reg_158945_Par_12 (redaktsioon 158945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158945",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158945",
      "estleg:sourceAct": "Linnuraba looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158945 § 12",
      "estleg:partOfAct": {
