      }
    },
    {
      "@id": "estleg:Reg_158945_Par_13_v158945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158945_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) biotsiidi ja taimekaitsevahendi kasutamine; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; biotsiidi ja taimekaitsevahendi kasutamine; puhtpuistute kujundamine ja energiapuistute rajamine.",
      "rdfs:label": {
        "@value": "Reg_158945_Par_13 (redaktsioon 158945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158945",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158945",
      "estleg:sourceAct": "Linnuraba looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158945 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158945_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158945_Par_14_v158945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158945_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste esinemisaladel nende liigikoosseisu säilitamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste esinemisaladel nende liigikoosseisu säilitamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_158945_Par_14 (redaktsioon 158945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158945",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158945",
      "estleg:sourceAct": "Linnuraba looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158945 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158945_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158945_Par_15_v158945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158945_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Linnuraba piiranguvööndi kaitse-eesmärk on kaitsealuste looma- ja taimeliikide kaitse ning soo- ja luhakoosluste säilitamine. Linnuraba piiranguvööndi kaitse-eesmärk on kaitsealuste looma- ja taimeliikide kaitse ning soo- ja luhakoosluste säilitamine.",
      "rdfs:label": {
