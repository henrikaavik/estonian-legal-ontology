    {
      "@id": "estleg:Reg_158945_Par_2_v158945",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158945_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Harju maakonnas Kernu vallas Kustja külas ning Rapla maakonnas Kohila vallas Adila külas, Märjamaa vallas Käbikülas ja Ohukotsu külas ning Rapla vallas Kelba, Kodila, Ohulepa, Palamulla ja Raka külas. Kaitseala asub Harju maakonnas Kernu vallas Kustja külas ning Rapla maakonnas Kohila vallas Adila külas, Märjamaa vallas Käbikülas ja Ohukotsu külas ning Rapla vallas Kelba, Kodila, Ohulepa, Palamulla ja Raka külas. 2 (2) Kaitseala välispiir ja vööndite piirid on kantud määruse lisas 4 esitatud kaardile. Kaitseala välispiir ja vööndite piirid on kantud määruse lisas 4 esitatud kaardile.",
      "rdfs:label": {
        "@value": "Reg_158945_Par_2 (redaktsioon 158945)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158945",
