        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud , mis on koostatud 1973. aasta 5. oktoobril Münchenis ning mille teksti on muudetud 1991. aasta 17. detsembril konventsiooni artikli 63 muutmise akti alusel ja 1978. aasta 21. detsembril, 1994. aasta 13. detsembril, 1995. aasta 20. oktoobril, 1996. aasta 5. detsembril ning 1998. aasta 10. detsembril Euroopa Patendiorganisatsiooni haldusnõukogu otsuste alusel.",
      "rdfs:label": {
        "@value": "EPVKU_Par_1 (redaktsioon 94692)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "94692",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/94692",
      "estleg:sourceAct": "Euroopa patentide väljaandmise konventsiooniga ühinemise seadus",
      "estleg:provisionRef": "EPVKU § 1",
      "estleg:partOfAct": {
        "@id": "estleg:EPVKU_Map"
      }
    },
    {
      "@id": "estleg:EPVKU_Par_2_v94692",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
