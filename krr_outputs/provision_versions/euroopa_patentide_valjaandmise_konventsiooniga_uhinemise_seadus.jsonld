      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrata konventsiooni artikli 65 lõikes 1 ja konventsiooni kohaldamismääruse reegli 99 lõikes 1 nimetatud tööstusomandi keskametiks Patendiamet (rahvusvahelises kontekstis Eesti Patendiamet).",
      "rdfs:label": {
        "@value": "EPVKU_Par_2 (redaktsioon 94692)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "94692",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/94692",
      "estleg:sourceAct": "Euroopa patentide väljaandmise konventsiooniga ühinemise seadus",
      "estleg:provisionRef": "EPVKU § 2",
      "estleg:partOfAct": {
