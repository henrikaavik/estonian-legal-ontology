    {
      "@id": "estleg:Reg_1016112_Par_5_v1016112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016112_Par_5"
