      }
    },
    {
      "@id": "estleg:Reg_1016112_Par_7_v1016112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016112_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ühisõppekaval õppivale õpilasele annab käesoleva määruse alusel õpilaspileti välja ühisõppekava koostöölepingu raames ühisõppekava hoidjana tegutsev kool. Ühisõppekaval õppivale õpilasele annab käesoleva määruse alusel õpilaspileti välja ühisõppekava koostöölepingu raames ühisõppekava hoidjana tegutsev kool. 2 (2) Määruse rakendamisel rakenduskõrgkoolis täidab käesolevas määruses direktorile pandud ülesandeid rakenduskõrgkooli rektor. Määruse rakendamisel rakenduskõrgkoolis täidab käesolevas määruses direktorile pandud ülesandeid rakenduskõrgkooli rektor.",
      "rdfs:label": {
        "@value": "Reg_1016112_Par_7 (redaktsioon 1016112)",
        "@language": "et"
      },
