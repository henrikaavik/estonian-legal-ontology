    },
    {
      "@id": "estleg:Reg_1054606_Par_1_v1054606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054606_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigi Kaitseinvesteeringute Keskus (edaspidi keskus) on Kaitseministeeriumi valitsemisalas tegutsev valitsusasutus, millel on juhtimisfunktsioon ja mis teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ettenähtud alustel ja korras. Riigi Kaitseinvesteeringute Keskus (edaspidi keskus) on Kaitseministeeriumi valitsemisalas tegutsev valitsusasutus, millel on juhtimisfunktsioon ja mis teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ettenähtud alustel ja korras. 2 (2) Ülesannete täitmisel esindab keskus riiki. Ülesannete täitmisel esindab keskus riiki. 3 (3) Keskuse ingliskeelne nimetus on Estonian Centre for Defence Investments. Keskuse ingliskeelne nimetus on Estonian Centre for Defence Investments.",
      "rdfs:label": {
        "@value": "Reg_1054606_Par_1 (redaktsioon 1054606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054606",
      "estleg:sourceAct": "Riigi Kaitseinvesteeringute Keskuse põhimäärus",
      "estleg:provisionRef": "Reg_1054606 § 1",
