      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskus on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib keskuse tegevust ning teostab keskuse üle teenistuslikku järelevalvet. Keskus on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib keskuse tegevust ning teostab keskuse üle teenistuslikku järelevalvet.",
      "rdfs:label": {
        "@value": "Reg_1054606_Par_3 (redaktsioon 1054606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054606",
      "estleg:sourceAct": "Riigi Kaitseinvesteeringute Keskuse põhimäärus",
      "estleg:provisionRef": "Reg_1054606 § 3",
      "estleg:partOfAct": {
