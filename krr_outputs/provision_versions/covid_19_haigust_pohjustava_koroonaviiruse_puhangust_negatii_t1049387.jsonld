        "@value": "2021-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse toetuse saajale 10 tööpäeva jooksul pärast taotluse rahuldamise otsuse tegemist. Toetus makstakse toetuse saajale 10 tööpäeva jooksul pärast taotluse rahuldamise otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_1049387_Par_12 (redaktsioon 1049387)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049387",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049387",
      "estleg:sourceAct": "COVID-19 haigust põhjustava koroonaviiruse puhangust negatiivselt mõjutatud väikeettevõtja kahjude osalise hüvitamise toetus",
      "estleg:provisionRef": "Reg_1049387 § 12",
