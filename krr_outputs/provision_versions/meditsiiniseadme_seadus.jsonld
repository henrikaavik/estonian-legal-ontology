      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abiseade käesoleva seaduse tähenduses on seade, mis eraldi kasutades ei ole meditsiiniseade, kuid mille tootja on spetsiaalselt ette näinud kasutamiseks koos meditsiiniseadmega, et oleks võimalik meditsiiniseadet sihtotstarbekohaselt kasutada.",
      "rdfs:label": {
