    {
      "@id": "estleg:MEDITS_Par_41_1_v115042014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_41_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2014. aasta 1. juulini võib käesoleva seaduse § 29 lõikes 3 nimetatud andmed esitada Terviseametile paberil või elektrooniliselt.",
      "rdfs:label": {
        "@value": "MEDITS_Par_41_1 (redaktsioon 115042014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115042014003"
    },
    {
      "@id": "estleg:MEDITS_Par_41_2_v122122022020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_41_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni Euroopa Parlamendi ja nõukogu määruse (EL) 2017/745 artikli 122 lõike 3 punktides d ja e ning määruse (EL) 2017/746 artikli 113 lõike 3 punktides a ja f sätestatud Euroopa meditsiiniseadmete andmebaasiga seotud kohustuste rakendamise kuupäevadeni toimub teabevahetus Terviseametiga ja andmete edastamine Terviseametile enne meditsiiniseadme seaduse käesoleva redaktsiooni jõustumist kehtinud seaduse redaktsiooni kohaselt.",
      "rdfs:label": {
        "@value": "MEDITS_Par_41_2 (redaktsioon 122122022020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122022020",
      "estleg:supersededByVersion": {
        "@id": "estleg:MEDITS_Par_41_2_v120112024002"
      },
      "estleg:versionValidTo": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_41_2_v120112024002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_41_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni Euroopa Parlamendi ja nõukogu määruse (EL) 2017/745 artikli 123 lõikes 3 ning määruse (EL) 2017/746 artikli 113 lõikes 3 sätestatud Euroopa meditsiiniseadmete andmebaasi kasutusele võtmiseni toimub teabevahetus käesoleva seaduse 2022. aasta 31. detsembrini kehtinud redaktsiooni ja selle alusel kehtestatud määruste kohaselt, arvestades et pädev asutus on Ravimiamet.",
      "rdfs:label": {
        "@value": "MEDITS_Par_41_2 (redaktsioon 120112024002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120112024002"
    },
    {
      "@id": "estleg:MEDITS_Par_42_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektriohutusseaduses (RT I 2002, 49, 310; 110, 659; 2004, 18, 131; 30, 208) tehakse järgmised muudatused: paragrahvi 8 lõike 2 punkt 2 muudetakse ja sõnastatakse järgmiselt: « 2) meditsiiniseadme seadusega (RT I 2004, 75, 520) reguleeritud seadmele;»; paragrahvi 10 lõiget 3 täiendatakse punktiga 4 järgmises sõnastuses: « 4) meditsiiniseadme seadusega (RT I 2004, 75, 520) reguleeritud seadmele.»",
      "rdfs:label": {
        "@value": "MEDITS_Par_42 (redaktsioon 813527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "813527"
    },
    {
      "@id": "estleg:MEDITS_Par_46_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reklaamiseadust (RT I 1997, 52, 835; 1999, 27, 388; 30, 415; 2001, 23, 127; 50, 284; 2002, 53, 336; 61, 375; 63, 387; 2004, 27, 177; 45, 315) täiendatakse §-ga 14 2 järgmises sõnastuses: « § 14 2 . Meditsiiniseadme reklaam Meditsiiniseadme reklaam esitatakse selliselt, et oleks arusaadav, et reklaamitakse meditsiiniseadet. Selline reklaam peab sisaldama üleskutset lugeda tähelepanelikult kasutusjuhendit ja vajaduse korral konsulteerida arstiga. Ainult professionaalseks kasutamiseks mõeldud meditsiiniseadme reklaam peab sisaldama sellekohast märget.»",
      "rdfs:label": {
        "@value": "MEDITS_Par_46 (redaktsioon 813527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "813527",
      "estleg:supersededByVersion": {
        "@id": "estleg:MEDITS_Par_46_v13328470"
      },
      "estleg:versionValidTo": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_46_v13328470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "MEDITS_Par_46 (redaktsioon 13328470)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13328470"
    },
    {
      "@id": "estleg:MEDITS_Par_47_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2004. aasta 1. detsembril.",
      "rdfs:label": {
        "@value": "MEDITS_Par_47 (redaktsioon 813527)",
        "@language": "et"
      },
