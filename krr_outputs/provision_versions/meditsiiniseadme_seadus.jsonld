      "estleg:versionRedactionId": "122122022020"
    },
    {
      "@id": "estleg:MEDITS_Par_24_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_24"
      },
      "estleg:versionValidFrom": {
