    },
    {
      "@id": "estleg:MEDITS_Par_38_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise isiku poolt meditsiiniseadmete ja nende turule laskjate ning ohujuhtumite andmekogu volitatud töötlejale valeandmete esitamise eest või andmete muutumisest teatamata jätmise või andmete esitamata jätmise eest – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "MEDITS_Par_38 (redaktsioon 813527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "813527",
      "estleg:supersededByVersion": {
        "@id": "estleg:MEDITS_Par_38_v130112010017"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_38_v130112010017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise isiku poolt meditsiiniseadmete kohta andmete esitamata jätmise, andmete muutumisest teatamata jätmise või valeandmete esitamise eest karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "MEDITS_Par_38 (redaktsioon 130112010017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112010017",
      "estleg:supersededByVersion": {
        "@id": "estleg:MEDITS_Par_38_v130112010019"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_38_v130112010019",
