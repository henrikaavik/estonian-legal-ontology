    {
      "@id": "estleg:MEDITS_Par_4_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abiseade käesoleva seaduse tähenduses on seade, mis eraldi kasutades ei ole meditsiiniseade, kuid mille tootja on spetsiaalselt ette näinud kasutamiseks koos meditsiiniseadmega, et oleks võimalik meditsiiniseadet otstarbekohaselt kasutada.",
      "rdfs:label": {
        "@value": "MEDITS_Par_4 (redaktsioon 813527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "813527",
      "estleg:supersededByVersion": {
