        "@language": "et"
      },
      "estleg:versionRedactionId": "122122022020"
    },
    {
      "@id": "estleg:MEDITS_Par_8_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tellimusmeditsiiniseade on igasugune professionaalse kasutaja tellimuse kohaselt konkreetsele patsiendile valmistatud meditsiiniseade. (2) Masstootmises valmistatud seadet, mida on vaja kohandada professionaalse kasutaja tellimuse järgi, ei loeta tellimusmeditsiiniseadmeks.",
      "rdfs:label": {
        "@value": "MEDITS_Par_8 (redaktsioon 813527)",
