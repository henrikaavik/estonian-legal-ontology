        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_4_v130112010017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
