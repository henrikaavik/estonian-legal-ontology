      "estleg:versionValidFrom": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktiivne meditsiiniseade on meditsiiniseade, mille talitlus sõltub elektrienergiast või mingit muud liiki energiast, välja arvatud otseselt inimkeha genereeritavast või gravitatsioonienergiast.",
      "rdfs:label": {
        "@value": "MEDITS_Par_4_1 (redaktsioon 130112010017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112010017",
