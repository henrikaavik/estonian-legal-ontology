      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enesetestimise meditsiiniseade on in vitro diagnostikameditsiiniseade, mis on ette nähtud kasutamiseks tavakasutajale.",
      "rdfs:label": {
