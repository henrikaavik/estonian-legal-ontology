    {
      "@id": "estleg:MEDITS_Par_36_v115042014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral võib korrakaitseorgan rakendada sunnivahendit asendustäitmise ja sunniraha seaduses ettenähtud korras. Sunniraha ülemmäär on 3200 eurot.",
      "rdfs:label": {
        "@value": "MEDITS_Par_36 (redaktsioon 115042014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115042014004",
      "estleg:supersededByVersion": {
