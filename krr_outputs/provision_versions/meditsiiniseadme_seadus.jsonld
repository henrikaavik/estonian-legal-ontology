      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 38 ja 39 nimetatud väärtegude puhul kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40; 46, 329; 54, 387; 56, 401) üldosa ja väärteomenetluse seadustikku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590; 2004, 46, 329; 54, 387 ja 390; 56, 403; RT III 2004, 9, 96). (2) Käesoleva seaduse §-des 38 ja 39 nimetatud väärtegude kohtuväline menetleja on Ravimiamet.",
      "rdfs:label": {
        "@value": "MEDITS_Par_40 (redaktsioon 813527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "813527",
