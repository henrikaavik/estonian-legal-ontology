    },
    {
      "@id": "estleg:MEDITS_Par_5_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktiivne siirdatav meditsiiniseade on meditsiiniseade, mille talitlus sõltub elektrienergiast või mõnest muust energialiigist, välja arvatud inimkeha poolt otseselt genereeritavast või gravitatsioonienergiast, ning mis on ette nähtud kirurgilisel teel osaliselt või täielikult inimese organismi viimiseks või meditsiinilise protseduuri abil loomulikku kehaavasse viimiseks ja mis jääb sinna ka pärast protseduuri lõppu.",
      "rdfs:label": {
        "@value": "MEDITS_Par_5 (redaktsioon 813527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "813527",
      "estleg:supersededByVersion": {
        "@id": "estleg:MEDITS_Par_5_v130112010017"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_5_v130112010017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktiivne siirdatav meditsiiniseade on aktiivne meditsiiniseade, mis on ette nähtud kirurgilisel teel osaliselt või täielikult inimese organismi viimiseks või meditsiinilise protseduuri abil loomulikku kehaavasse viimiseks ja mis jääb sinna ka pärast protseduuri lõppu.",
      "rdfs:label": {
        "@value": "MEDITS_Par_5 (redaktsioon 130112010017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112010017",
      "estleg:supersededByVersion": {
        "@id": "estleg:MEDITS_Par_5_v117052020006"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_5_v117052020006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
