      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MEDITS_Par_6_1 (redaktsioon 122122022020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122022020"
    },
    {
      "@id": "estleg:MEDITS_Par_7_v813527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
