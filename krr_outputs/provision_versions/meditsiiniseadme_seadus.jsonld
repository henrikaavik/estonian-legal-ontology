        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEDITS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise isiku poolt meditsiiniseadmete kohta andmete esitamata jätmise, andmete muutumisest teatamata jätmise või valeandmete esitamise eest karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
