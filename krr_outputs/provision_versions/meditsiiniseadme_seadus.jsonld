      },
      "estleg:versionValidTo": {
        "@value": "2010-12-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MEDITS_Par_39_v130112010017",
      "@type": [
        "owl:NamedIndividual",
