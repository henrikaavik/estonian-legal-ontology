    {
      "@id": "estleg:Reg_1057508_Par_12_v1057508",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057508_Par_12"
