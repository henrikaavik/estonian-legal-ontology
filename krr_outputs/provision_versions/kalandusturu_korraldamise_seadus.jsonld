        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_1_v105122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatakse kalandusturu korraldamise abinõud, nende rakendamise alused ja kord, riikliku ja haldusjärelevalve teostamise alused ja ulatus ning vastutus käesoleva seaduse rikkumise eest. (2) Euroopa Liidu õigusaktides ning käesolevas seaduses ja selle alusel kehtestatud õigusaktides ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse sätteid, arvestades Euroopa Liidu õigusaktide ja käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "KALAND_Par_1 (redaktsioon 105122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014001"
    },
    {
      "@id": "estleg:KALAND_Par_10_v690859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tootjate ühendus käesoleva seaduse tähenduses on tulundusühistu, kuhu kuuluvad kalapüüdjad või kalakasvatajad. Käesolevas seaduses sätestatud tootjate ühenduse õigused ja kohustused on üksnes tunnustatud tootjate ühendusel.",
      "rdfs:label": {
        "@value": "KALAND_Par_10 (redaktsioon 690859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690859",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_10_v751770"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_10_v751770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tootjaorganisatsioon käesoleva seaduse tähenduses on tulundusühistu, kuhu kuuluvad kalandustoodete tootjad . Käesolevas seaduses sätestatud tootjaorganisatsiooni õigused ja kohustused on üksnes tunnustatud tootjaorganisatsioonil.",
      "rdfs:label": {
        "@value": "KALAND_Par_10 (redaktsioon 751770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751770",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_10_v922142"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_10_v922142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tootjaorganisatsioon käesoleva seaduse tähenduses on tulundusühistu, kuhu kuuluvad kalandustoodete tootjad. Käesolevas seaduses sätestatud tootjaorganisatsiooni õigused ja kohustused on üksnes tunnustatud tootjaorganisatsioonil.",
      "rdfs:label": {
        "@value": "KALAND_Par_10 (redaktsioon 922142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "922142",
