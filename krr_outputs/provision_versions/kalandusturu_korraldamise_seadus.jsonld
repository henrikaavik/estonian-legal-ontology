      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Komisjoni määruse 2814/2000 artikli 7 lõikes 2 nimetatud pädeva asutuse ülesandeid täidab Põllumajandusministeerium. (2) Ülekandetoetuse taotluses esitatavate andmete loetelu kehtestab põllumajandusminister.",
      "rdfs:label": {
        "@value": "KALAND_Par_61 (redaktsioon 690859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690859",
      "estleg:supersededByVersion": {
