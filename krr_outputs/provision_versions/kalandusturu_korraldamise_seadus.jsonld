    {
      "@id": "estleg:KALAND_Par_37_v110112017008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_37"
      },
      "estleg:versionValidFrom": {
