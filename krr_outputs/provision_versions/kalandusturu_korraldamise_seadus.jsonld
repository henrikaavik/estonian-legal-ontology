      },
      "estleg:versionText": "(1) Kehtetu - (2) EL Nõukogu määruse 104/2000/EÜ artikli 19 lõikes 1 nimetatud hindadest teavitab Euroopa Komisjoni Põllumajandusministeerium.",
      "rdfs:label": {
        "@value": "KALAND_Par_56 (redaktsioon 13315792)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315792",
      "estleg:supersededByVersion": {
