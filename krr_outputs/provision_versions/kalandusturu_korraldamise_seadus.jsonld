      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_22_v114032014039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Intressimäära, millest alates intressitoetust antakse, kehtestab valdkonna eest vastutav minister. (2) Intressitoetust antakse kuni kümme intressimäära protsendipunkti.",
      "rdfs:label": {
        "@value": "KALAND_Par_22 (redaktsioon 114032014039)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014039",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_22_v105122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
