        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurentsiseaduses tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "KALAND_Par_92 (redaktsioon 123112022001)",
        "@language": "et"
