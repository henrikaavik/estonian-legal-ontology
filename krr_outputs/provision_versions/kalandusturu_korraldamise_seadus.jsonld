        "@id": "estleg:KALAND_Par_37_v751770"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_37_v751770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Praktikatoetust on õigus taotleda kalandustoodete tootjal, kes viib oma ettevõttes läbi õppepraktika.",
      "rdfs:label": {
        "@value": "KALAND_Par_37 (redaktsioon 751770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751770",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_37_v12803787"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_37_v12803787",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Praktikatoetust on õigus taotleda kalandustoodete tootjal või töötlejal, kes viib oma ettevõttes läbi õppepraktika.",
      "rdfs:label": {
        "@value": "KALAND_Par_37 (redaktsioon 12803787)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12803787",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_37_v105122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_37_v105122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel võivad kalamajanduslikku riigiabi anda riik ja maapiirkonna ettevõtluse toetamiseks asutatud riigi sihtasutus (edaspidi sihtasutus) otseselt või kaudselt riigi rahalisi vahendeid kasutades. (2) Kalamajanduslikku riigiabi võib anda, kui: Euroopa Komisjon on teinud talle kooskõlas Euroopa Liidu kalamajandusliku riigiabi suunistega (edaspidi riigiabi suunised) esitatud kalamajandusliku riigiabi teatise kohta lubava otsuse; Euroopa Komisjonile on esitatud nõukogu määruse (EÜ) nr 994/98, milles käsitletakse Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamist teatavate horisontaalse riigiabi liikide suhtes (EÜT L 142, 14.05.1998, lk 1–4), artikli 1 alusel kehtestatud kalamajandusliku riigiabi grupierandi määruses (edaspidi kalamajandusliku riigiabi grupierandi määrus) sätestatud kokkuvõtlik teabeleht (edaspidi kalamajandusliku grupierandi teatis); kalamajanduslik riigiabi vastab nõukogu määruse (EÜ) nr 659/1999, millega kehtestatakse üksikasjalikud eeskirjad Euroopa Liidu toimimise lepingu artikli 108 kohaldamiseks (EÜT L 83, 27.03.1999, lk 1–9), artikli 4 lõikes 6 sätestatud tingimustele. (3) Kalamajanduslikku riigiabi võib anda muu seaduse alusel ja korras, kui selleks on Põllumajandusministeeriumi kaudu esitatud kalamajandusliku riigiabi teatis, mille kohta Euroopa Komisjon on teinud lubava otsuse, või kalamajandusliku grupierandi teatis või kui kalamajanduslik riigiabi vastab nõukogu määruse (EÜ) nr 659/1999 artikli 4 lõikes 6 sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "KALAND_Par_37 (redaktsioon 105122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_37_v101092015008"
      },
      "estleg:versionValidTo": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_37_v101092015008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel võivad kalamajanduslikku riigiabi anda riik ja maapiirkonna ettevõtluse toetamiseks asutatud riigi sihtasutus (edaspidi sihtasutus) otseselt või kaudselt riigi rahalisi vahendeid kasutades. (2) Kalamajanduslikku riigiabi võib anda, kui: Euroopa Komisjon on teinud talle kooskõlas Euroopa Liidu kalamajandusliku riigiabi suunistega (edaspidi riigiabi suunised) esitatud kalamajandusliku riigiabi teatise kohta lubava otsuse; Euroopa Komisjonile on esitatud nõukogu määruse (EÜ) nr 994/98, milles käsitletakse Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamist teatavate horisontaalse riigiabi liikide suhtes (EÜT L 142, 14.05.1998, lk 1–4), artikli 1 alusel kehtestatud kalamajandusliku riigiabi grupierandi määruses (edaspidi kalamajandusliku riigiabi grupierandi määrus) sätestatud kokkuvõtlik teabeleht (edaspidi kalamajandusliku grupierandi teatis); kalamajanduslik riigiabi vastab nõukogu määruse (EÜ) nr 659/1999, millega kehtestatakse üksikasjalikud eeskirjad Euroopa Liidu toimimise lepingu artikli 108 kohaldamiseks (EÜT L 83, 27.03.1999, lk 1–9), artikli 4 lõikes 6 sätestatud tingimustele. (3) Kalamajanduslikku riigiabi võib anda muu seaduse alusel ja korras, kui selleks on Maaeluministeeriumi kaudu esitatud kalamajandusliku riigiabi teatis, mille kohta Euroopa Komisjon on teinud lubava otsuse, või kalamajandusliku grupierandi teatis või kui kalamajanduslik riigiabi vastab nõukogu määruse (EÜ) nr 659/1999 artikli 4 lõikes 6 sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "KALAND_Par_37 (redaktsioon 101092015008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101092015008",
