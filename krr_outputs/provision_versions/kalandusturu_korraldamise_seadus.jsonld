      "estleg:versionRedactionId": "126092023002"
    },
    {
      "@id": "estleg:KALAND_Par_39_v690859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
