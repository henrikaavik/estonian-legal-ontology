        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_7_v988427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "KALAND_Par_7 (redaktsioon 988427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "988427",
