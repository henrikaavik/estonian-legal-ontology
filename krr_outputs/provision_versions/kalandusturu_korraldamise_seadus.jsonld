      }
    },
    {
      "@id": "estleg:KALAND_Par_73_v13315792",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kalandusturu korraldamise abinõude rakendamiseks vajalike andmete esitamata jätmise eest –karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 2000 eurot.",
      "rdfs:label": {
        "@value": "KALAND_Par_73 (redaktsioon 13315792)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315792",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_73_v105122014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
