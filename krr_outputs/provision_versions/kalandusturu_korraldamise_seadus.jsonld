        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Parlamendi ja nõukogu määruse (EL) 2021/1060 artiklis 38 nimetatud EMKVF-i seirekomisjoni moodustab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KALAND_Par_39 (redaktsioon 123112022001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123112022001"
    },
    {
      "@id": "estleg:KALAND_Par_4_v690859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kala käesoleva seaduse tähenduses on toiduks mõeldud algse kuju ja tavapäraste omadustega elus-, värske ning esmatöödeldud kala, jõesilm, vähk või muu veeselgrootu.",
      "rdfs:label": {
        "@value": "KALAND_Par_4 (redaktsioon 690859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690859",
