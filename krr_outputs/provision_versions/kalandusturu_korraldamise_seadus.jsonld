      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnustamisest keeldutakse, kui ühendus on esitanud teadvalt valeandmeid või kui ühendus ei vasta käesoleva seaduse § 11 lõikes 1 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "KALAND_Par_18 (redaktsioon 690859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690859",
      "estleg:supersededByVersion": {
