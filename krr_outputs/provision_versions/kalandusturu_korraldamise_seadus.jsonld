      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Komisjoni määruse 2509/2000 (EÜT L 289, 16/11/2000, lk 11–15) artikli 3 lõigetes 1 ja 2, artikli 5 lõikes 2 ja artiklis 7 nimetatud pädeva asutuse ülesandeid täidab Põllumajandusministeerium. (2) Kõrvaldamistoetuse taotluses esitatavate andmete loetelu kehtestab põllumajandusminister.",
      "rdfs:label": {
        "@value": "KALAND_Par_60 (redaktsioon 690859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690859",
