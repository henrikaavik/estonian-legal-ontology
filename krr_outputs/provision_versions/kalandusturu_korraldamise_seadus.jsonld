    },
    {
      "@id": "estleg:KALAND_Par_16_v105122014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 artikli 17 lõikes 1 nimetatud rakenduskava (edaspidi rakenduskava) koostab Põllumajandusministeerium. (2) Rakenduskava kavandi kiidab heaks Vabariigi Valitsus korraldusega. (3) Kui Euroopa Liidu õigusakt näeb rakenduskava meetme rakendamiseks ette riigisisese valdkondliku kava, koostab nimetatud kava Põllumajandusministeerium ja selle kinnitab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KALAND_Par_16 (redaktsioon 105122014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAND_Par_16_v101092015008"
      },
      "estleg:versionValidTo": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_16_v101092015008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 artikli 17 lõikes 1 nimetatud rakenduskava (edaspidi rakenduskava) koostab Maaeluministeerium. (2) Rakenduskava kavandi kiidab heaks Vabariigi Valitsus korraldusega. (3) Kui Euroopa Liidu õigusakt näeb rakenduskava meetme rakendamiseks ette riigisisese valdkondliku kava, koostab nimetatud kava Maaeluministeerium ja selle kinnitab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
