      },
      "estleg:versionValidTo": {
        "@value": "2011-03-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAND_Par_18_v116032011004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAND_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnustamisest keeldutakse, kui ühendus on esitanud teadvalt valeandmeid või kui ühendus ei vasta käesoleva seaduse § 11 lõigetes 1 ja 11 sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "KALAND_Par_18 (redaktsioon 116032011004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "116032011004",
