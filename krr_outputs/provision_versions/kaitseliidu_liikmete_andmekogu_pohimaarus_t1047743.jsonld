    {
      "@id": "estleg:Reg_1047743_Par_10_v1047743",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047743_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Isikuandmete töötlemine andmekogus toimub Kaitseliidu seaduse § 81 lõike 1 ja § 801 alusel. Isikuandmete töötlemine andmekogus toimub Kaitseliidu seaduse § 81 lõike 1 ja § 801 alusel. 2 (2) Isikuandmete kogumist andmekogusse alustatakse andmesubjekti Kaitseliidu liikmeks astumise avalduse alusel. Isikuandmete kogumist andmekogusse alustatakse andmesubjekti Kaitseliidu liikmeks astumise avalduse alusel.",
      "rdfs:label": {
        "@value": "Reg_1047743_Par_10 (redaktsioon 1047743)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047743",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047743",
      "estleg:sourceAct": "Kaitseliidu liikmete andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1047743 § 10",
