    },
    {
      "@id": "estleg:Reg_1047743_Par_8_v1047743",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047743_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse esitab andmeid: 1 1) Kaitseliidu liikmeks astuda sooviv isik; 2 2) Kaitseliidu liige; 3 3) Kaitseliidu struktuuriüksus ja selle allüksus. Andmekogusse esitab andmeid: Kaitseliidu liikmeks astuda sooviv isik; Kaitseliidu liige; Kaitseliidu struktuuriüksus ja selle allüksus. 2 (2) Andmekogu vahetab andmeid järgmiste andmekogudega: 1 1) kaitseväekohustuslaste register; 2 2) karistusregister; 3 3) liiklusregister; 4 4) rahvastikuregister. Andmekogu vahetab andmeid järgmiste andmekogudega: kaitseväekohustuslaste register; karistusregister; liiklusregister; rahvastikuregister.",
      "rdfs:label": {
        "@value": "Reg_1047743_Par_8 (redaktsioon 1047743)",
        "@language": "et"
      },
