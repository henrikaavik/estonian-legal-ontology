        "@value": "2020-06-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu likvideerimise otsustab valdkonna eest vastutav minister. Andmekogu likvideerimise otsustab valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "Reg_1047743_Par_23 (redaktsioon 1047743)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047743",
