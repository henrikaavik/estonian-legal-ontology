      }
    },
    {
      "@id": "estleg:Reg_301280_Par_10_v301280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301280_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul tootmisotstarbeta ehitise või rajatise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks Jäärja, Kabja, Kodaja, Rakste, Rongu, Ruunasoo ja Sandre sihtkaitsevööndis; 4 4) inimeste viibimine Jäärja, Kodaja, Rongu, Rootsimäe, Sandre ja Sookuninga sihtkaitsevööndis 1. veebruarist 31. juulini ning Raessaare sihtkaitsevööndis 1. augustist 15. septembrini, välja arvatud üldkasutatavatel teedel, järelevalve- ja päästetöödel, kaitseala valitseja nõusolekul teostatavatel teadustöödel ning kaitseala valitsemisega seotud tegevuses. Sihtkaitsevööndis on keelatud: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul tootmisotstarbeta ehitise või rajatise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks Jäärja, Kabja, Kodaja, Rakste, Rongu, Ruunasoo ja Sandre sihtkaitsevööndis; inimeste viibimine Jäärja, Kodaja, Rongu, Rootsimäe, Sandre ja Sookuninga sihtkaitsevööndis 1. veebruarist 31. juulini ning Raessaare sihtkaitsevööndis 1. augustist 15. septembrini, välja arvatud üldkasutatavatel teedel, järelevalve- ja päästetöödel, kaitseala valitseja nõusolekul teostatavatel teadustöödel ning kaitseala valitsemisega seotud tegevuses.",
      "rdfs:label": {
        "@value": "Reg_301280_Par_10 (redaktsioon 301280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301280",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301280",
      "estleg:sourceAct": "Sookuninga looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301280 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301280_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_301280_Par_11_v301280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301280_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kabja, Rongu, Ruunasoo ja Sandre sihtkaitsevööndis on poollooduslike koosluste ilme ja liigikoosseisu ning kaitsealuste liikide elutingimuste säilitamiseks ja taastamiseks vajalik tegevus, nagu heina niitmine, loomade karjatamine ning koosluste kujundamine vastavalt kaitse-eesmärgile. Kabja, Rongu, Ruunasoo ja Sandre sihtkaitsevööndis on poollooduslike koosluste ilme ja liigikoosseisu ning kaitsealuste liikide elutingimuste säilitamiseks ja taastamiseks vajalik tegevus, nagu heina niitmine, loomade karjatamine ning koosluste kujundamine vastavalt kaitse-eesmärgile.",
      "rdfs:label": {
        "@value": "Reg_301280_Par_11 (redaktsioon 301280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301280",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301280",
      "estleg:sourceAct": "Sookuninga looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301280 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301280_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_301280_Par_12_v301280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301280_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Sookuninga piiranguvöönd. Kaitsealal on Sookuninga piiranguvöönd.",
      "rdfs:label": {
