      }
    },
    {
      "@id": "estleg:Reg_301280_Par_13_v301280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301280_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi metsa kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine ning taastamine. Piiranguvööndi metsa kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine ning taastamine.",
      "rdfs:label": {
        "@value": "Reg_301280_Par_13 (redaktsioon 301280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301280",
