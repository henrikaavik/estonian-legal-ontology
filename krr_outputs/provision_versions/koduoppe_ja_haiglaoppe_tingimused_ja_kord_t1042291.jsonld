      "estleg:sourceAct": "Koduõppe ja haiglaõppe tingimused ja kord",
      "estleg:provisionRef": "Reg_1042291 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042291_Map_2026"
      }
    },
