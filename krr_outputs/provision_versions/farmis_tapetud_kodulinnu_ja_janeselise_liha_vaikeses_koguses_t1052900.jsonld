    {
      "@id": "estleg:Reg_1052900_Par_3_v1052900",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052900_Par_3"
