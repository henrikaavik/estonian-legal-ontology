      "estleg:provisionRef": "Reg_1046428 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046428_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046428_Par_28_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
