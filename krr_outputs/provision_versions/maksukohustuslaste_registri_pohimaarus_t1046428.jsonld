      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sularaha deklaratsiooni süsteemi ametlik lühend on SDS. Sularaha deklaratsiooni süsteemi ametlik lühend on SDS. 2 (2) Sularaha deklaratsiooni süsteemi kantakse andmed, mis on ette nähtud komisjoni rakendusmäärusega (EL) 2021/776, millega kehtestatakse teatavate vormide näidised ning tehnilised normid tõhusaks teabevahetuseks vastavalt Euroopa Parlamendi ja nõukogu määrusele (EL) 2018/1672, mis käsitleb liitu toodava või liidust välja viidava sularaha kontrolli (ELT L 167, 12.5.2021, lk 6–38). RT I 2021-06-26 1 126062021001 2021-07-01 Sularaha deklaratsiooni süsteemi kantakse andmed, mis on ette nähtud komisjoni rakendusmäärusega (EL) 2021/776, millega kehtestatakse teatavate vormide näidised ning tehnilised normid tõhusaks teabevahetuseks vastavalt Euroopa Parlamendi ja nõukogu määrusele (EL) 2018/1672, mis käsitleb liitu toodava või liidust välja viidava sularaha kontrolli (ELT L 167, 12.5.2021, lk 6–38).",
      "rdfs:label": {
        "@value": "Reg_1046428_Par_44 (redaktsioon 1046428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046428",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046428",
      "estleg:sourceAct": "Maksukohustuslaste registri põhimäärus",
      "estleg:provisionRef": "Reg_1046428 § 44",
