      "estleg:provisionRef": "Reg_1046428 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046428_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046428_Par_16_18_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
