      }
    },
    {
      "@id": "estleg:Reg_1046428_Par_45_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046428_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sularahamakse registreerimise ja kaardimakse teostamise rakenduse ametlik lühend on MTA KASSA. Sularahamakse registreerimise ja kaardimakse teostamise rakenduse ametlik lühend on MTA KASSA. 2 (2) Sularahamakse registreerimise ja kaardimakse teostamise rakendusse kantakse Maksu- ja Tolliameti teeninduskohas vormistatud sularahamakse või kaardimakse kohta järgmised andmed: 1 1) juriidilisest isikust kliendi puhul – ärinimi, aadress, registrikood ning kassatehingu vahetult sooritanud isiku nimi ja tema isikukood või mitteresidendi kood; 2 2) füüsilisest isikust kliendi puhul – nimi, aadress ja isikukood või mitteresidendi kood; 3 3) kassatehingu vormistanud ametniku nimi ja isikukood; 4 4) kassatehingu liik, sooritamise aeg, kviitungi number, makse viitenumber, selgitus ja summa. RT I 2025-08-12 1 112082025001 2025-08-15 Sularahamakse registreerimise ja kaardimakse teostamise rakendusse kantakse Maksu- ja Tolliameti teeninduskohas vormistatud sularahamakse või kaardimakse kohta järgmised andmed: juriidilisest isikust kliendi puhul – ärinimi, aadress, registrikood ning kassatehingu vahetult sooritanud isiku nimi ja tema isikukood või mitteresidendi kood; füüsilisest isikust kliendi puhul – nimi, aadress ja isikukood või mitteresidendi kood; kassatehingu vormistanud ametniku nimi ja isikukood; kassatehingu liik, sooritamise aeg, kviitungi number, makse viitenumber, selgitus ja summa.",
      "rdfs:label": {
        "@value": "Reg_1046428_Par_45 (redaktsioon 1046428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046428",
