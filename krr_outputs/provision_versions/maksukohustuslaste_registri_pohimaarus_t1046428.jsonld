    {
      "@id": "estleg:Reg_1046428_Par_32_39_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046428_Par_32_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maamaksu määramise rakenduse ametlik lühend on MAAIS. Maamaksu määramise rakenduse ametlik lühend on MAAIS. 2 (2) Maamaksu määramise rakendusse kantakse: 1 1) maamaksu arvutamisega seotud andmed (maa nimetus, maa tunnus, kirje identifikaator, omandiosa suurus, maksumäärad, maa pindala ja hind, soodustuste summad, maamaksu summa); 2 2) maksumaksja andmed (nimi, isiku- või registrikood, kontaktandmed); 3 3) maksuteate andmed (maksuteate number ja koostamise kuupäev, maksumaksja personaalne viitenumber, võimalike osamaksete summad ja tasumise tähtajad, teave maksuteate kättetoimetamise kohta); 4 4) maa väärtuse andmed (maaüksuse nimetus, katastritunnus, aadress, pindala, sihtotstarbed, kõlvikud, maksustamishind, maa omaniku või maa kasutaja nimi ja isiku- või registrikood, omandiosa suurus, kuvatõmmis maaüksuse asukohast kaardil). RT I 2023-12-29 7 129122023007 2024-01-01 Maamaksu määramise rakendusse kantakse: maamaksu arvutamisega seotud andmed (maa nimetus, maa tunnus, kirje identifikaator, omandiosa suurus, maksumäärad, maa pindala ja hind, soodustuste summad, maamaksu summa); maksumaksja andmed (nimi, isiku- või registrikood, kontaktandmed); maksuteate andmed (maksuteate number ja koostamise kuupäev, maksumaksja personaalne viitenumber, võimalike osamaksete summad ja tasumise tähtajad, teave maksuteate kättetoimetamise kohta); maa väärtuse andmed (maaüksuse nimetus, katastritunnus, aadress, pindala, sihtotstarbed, kõlvikud, maksustamishind, maa omaniku või maa kasutaja nimi ja isiku- või registrikood, omandiosa suurus, kuvatõmmis maaüksuse asukohast kaardil).",
      "rdfs:label": {
        "@value": "Reg_1046428_Par_32_39 (redaktsioon 1046428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046428",
