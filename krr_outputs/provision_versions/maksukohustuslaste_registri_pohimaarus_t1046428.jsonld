    {
      "@id": "estleg:Reg_1046428_Par_47_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046428_Par_47"
