      "estleg:provisionRef": "Reg_1046428 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046428_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046428_Par_26_v1046428",
      "@type": [
