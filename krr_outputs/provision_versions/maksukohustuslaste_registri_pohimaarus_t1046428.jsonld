    {
      "@id": "estleg:Reg_1046428_Par_9_10_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046428_Par_9_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Automaatse ekspordisüsteemi ametlik lühend on AES. Automaatse ekspordisüsteemi ametlik lühend on AES. 2 (2) Automaatsesse ekspordisüsteemi kantakse: 1 1) komisjoni delegeeritud määruse (EL) nr 2015/2446, millega täiendatakse Euroopa Parlamendi ja nõukogu määrust (EL) nr 952/2013 seoses liidu tolliseadustiku teatavaid sätteid täpsustavate üksikasjalike eeskirjadega (ELT L 343, 29.12.2015, lk 1–557), lisa B veergudes A1–C2 nimetatud andmed; 2 2) tolliseaduse § 27 lõike 1 alusel valdkonna eest vastutava ministri määrusega ette nähtud andmed, mis kantakse tollideklaratsioonile ekspordi, välistöötlemise ja liidu kauba tolliladustamise tolliprotseduuril, reekspordil ning kauba lähetamisel erikorraga maksustamisterritooriumile. RT I 2023-06-01 1 101062023001 2023-10-01 Automaatsesse ekspordisüsteemi kantakse: komisjoni delegeeritud määruse (EL) nr 2015/2446, millega täiendatakse Euroopa Parlamendi ja nõukogu määrust (EL) nr 952/2013 seoses liidu tolliseadustiku teatavaid sätteid täpsustavate üksikasjalike eeskirjadega (ELT L 343, 29.12.2015, lk 1–557), lisa B veergudes A1–C2 nimetatud andmed; tolliseaduse § 27 lõike 1 alusel valdkonna eest vastutava ministri määrusega ette nähtud andmed, mis kantakse tollideklaratsioonile ekspordi, välistöötlemise ja liidu kauba tolliladustamise tolliprotseduuril, reekspordil ning kauba lähetamisel erikorraga maksustamisterritooriumile.",
      "rdfs:label": {
        "@value": "Reg_1046428_Par_9_10 (redaktsioon 1046428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046428",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046428",
      "estleg:sourceAct": "Maksukohustuslaste registri põhimäärus",
      "estleg:provisionRef": "Reg_1046428 § 9_10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046428_Map_2026"
      }
