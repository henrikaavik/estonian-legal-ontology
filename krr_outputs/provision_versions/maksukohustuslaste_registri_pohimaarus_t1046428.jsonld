    {
      "@id": "estleg:Reg_1046428_Par_2_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046428_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Register koosneb §-s 4 nimetatud üldandmetest ja 2. peatüki 2. jaos nimetatud alamregistritesse koondatud andmetest. Alamregistri koosseisu võivad kuuluda selle alamregistri alamregistrid. Register koosneb §-s 4 nimetatud üldandmetest ja 2. peatüki 2. jaos nimetatud alamregistritesse koondatud andmetest. Alamregistri koosseisu võivad kuuluda selle alamregistri alamregistrid. 2 (2) Kehtetu - RT I 2023-06-01 1 101062023001 2023-07-01 Kehtetu - 3 (3) Registrisse kantud andmetel on informatiivne tähendus. Registri andmetel on õiguslik tähendus seaduses ette nähtud juhul. Registrisse kantud andmetel on informatiivne tähendus. Registri andmetel on õiguslik tähendus seaduses ette nähtud juhul.",
      "rdfs:label": {
        "@value": "Reg_1046428_Par_2 (redaktsioon 1046428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046428",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046428",
      "estleg:sourceAct": "Maksukohustuslaste registri põhimäärus",
      "estleg:provisionRef": "Reg_1046428 § 2",
