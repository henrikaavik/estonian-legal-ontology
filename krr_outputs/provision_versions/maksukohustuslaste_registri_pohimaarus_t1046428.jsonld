    {
      "@id": "estleg:Reg_1046428_Par_5_v1046428",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046428_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 91, 11, 14, 16, 22–222, 31, 36, 40, 421, 44, 46, 47 ja 49–51 nimetatud alamregistreid käsitatakse kogumis e-tolli andmekoguna tolliseaduse § 13 tähenduses. RT I 2025-08-12 1 112082025001 2025-08-15 Paragrahvides 91, 11, 14, 16, 22–222, 31, 36, 40, 421, 44, 46, 47 ja 49–51 nimetatud alamregistreid käsitatakse kogumis e-tolli andmekoguna tolliseaduse § 13 tähenduses.",
      "rdfs:label": {
        "@value": "Reg_1046428_Par_5 (redaktsioon 1046428)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046428",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046428",
