      }
    },
    {
      "@id": "estleg:VHS_Par_5_v106122012022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VHS_Par_5"
      },
      "estleg:versionValidFrom": {
