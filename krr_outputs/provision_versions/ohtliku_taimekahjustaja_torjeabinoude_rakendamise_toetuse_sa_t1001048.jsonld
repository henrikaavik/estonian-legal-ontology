        "@value": "Sätete redaktsioonid: Ohtliku taimekahjustaja tõrjeabinõude rakendamise toetuse saamiseks esitatavad nõuded ning toetuse taotluse esitamise ja taotluse menetlemise kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ohtliku taimekahjustaja tõrjeabinõude rakendamise toetuse saamiseks esitatavad nõuded ning toetuse taotluse esitamise ja taotluse menetlemise kord"
    },
    {
      "@id": "estleg:Reg_1001048_Par_1_v1001048",
      "@type": [
