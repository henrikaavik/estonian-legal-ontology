      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001048_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse alusel antav toetus on riigiabi komisjoni määruse (EL) 2022/2472, millega tunnistatakse teatavat liiki abi põllumajandus- ja metsandussektoris ja maapiirkondades Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamisel siseturuga kokkusobivaks (ELT L 327, 21.12.2022, lk 1–81), artikli 26 tähenduses. RT I 2023-07-07 3 107072023003 2023-07-10 Määruse alusel antav toetus on riigiabi komisjoni määruse (EL) 2022/2472, millega tunnistatakse teatavat liiki abi põllumajandus- ja metsandussektoris ja maapiirkondades Euroopa Liidu toimimise lepingu artiklite 107 ja 108 kohaldamisel siseturuga kokkusobivaks (ELT L 327, 21.12.2022, lk 1–81), artikli 26 tähenduses.",
      "rdfs:label": {
        "@value": "Reg_1001048_Par_2 (redaktsioon 1001048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001048",
