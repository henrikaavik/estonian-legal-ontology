      "estleg:provisionRef": "Reg_1001048 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001048_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001048_Par_4_v1001048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001048_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse abikõlblikud kulud on: 1 1) Põllumajandus- ja Toiduameti ettekirjutuse alusel hävitatud puuviljakultuuri istutusmaterjali, dekoratiivkultuuri istutusmaterjali või kartuli, sealhulgas seemnekartuli, väärtus; RT I 2020-11-04 1 104112020001 2021-01-01 2 2) tootmisistandikul kasvanud Põllumajandus- ja Toiduameti ettekirjutuse alusel hävitatud taimede väärtus. RT I 2020-11-04 1 104112020001 2021-01-01 Toetuse abikõlblikud kulud on: Põllumajandus- ja Toiduameti ettekirjutuse alusel hävitatud puuviljakultuuri istutusmaterjali, dekoratiivkultuuri istutusmaterjali või kartuli, sealhulgas seemnekartuli, väärtus; tootmisistandikul kasvanud Põllumajandus- ja Toiduameti ettekirjutuse alusel hävitatud taimede väärtus.",
      "rdfs:label": {
        "@value": "Reg_1001048_Par_4 (redaktsioon 1001048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001048",
