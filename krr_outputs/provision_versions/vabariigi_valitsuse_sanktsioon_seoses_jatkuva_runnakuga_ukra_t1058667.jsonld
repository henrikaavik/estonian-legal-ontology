        "@value": "Sätete redaktsioonid: Vabariigi Valitsuse sanktsioon seoses jätkuva rünnakuga Ukraina suveräänsuse ja territoriaalse terviklikkuse vastu (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vabariigi Valitsuse sanktsioon seoses jätkuva rünnakuga Ukraina suveräänsuse ja territoriaalse terviklikkuse vastu"
    },
    {
      "@id": "estleg:Reg_1058667_Par_1_v1058667",
      "@type": [
