      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1055097_Par_3 (redaktsioon 1055097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055097",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055097",
      "estleg:sourceAct": "Kuulmajärve looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055097 § 3",
      "estleg:partOfAct": {
