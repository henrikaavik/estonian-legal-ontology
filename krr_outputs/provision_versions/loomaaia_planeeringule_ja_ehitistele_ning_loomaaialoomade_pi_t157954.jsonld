    {
      "@id": "estleg:Reg_157954_Par_4_v157954",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157954_Par_4"
