      "estleg:sourceAct": "Kutselise kalapüügi püügivõimaluse enampakkumise toimumise kord",
      "estleg:provisionRef": "Reg_1038989 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038989_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038989_Par_4_v1038989",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038989_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Põllumajandus- ja Toiduamet määrab enampakkumise minimaalse ja maksimaalse sammu suuruse, mille võrra on võimalik enampakkumise käigus pakkumisi teha. RT I 2020-11-06 1 106112020001 2021-01-01 Põllumajandus- ja Toiduamet määrab enampakkumise minimaalse ja maksimaalse sammu suuruse, mille võrra on võimalik enampakkumise käigus pakkumisi teha. 2 (2) Enampakkumise maksimaalne samm ei või olla suurem kui kümnekordne minimaalne samm. Enampakkumise maksimaalne samm ei või olla suurem kui kümnekordne minimaalne samm.",
      "rdfs:label": {
