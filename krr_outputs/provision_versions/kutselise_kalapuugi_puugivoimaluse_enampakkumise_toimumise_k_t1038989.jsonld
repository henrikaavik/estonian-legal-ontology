      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kutselise kalapüügi püügivõimaluse enampakkumise toimumise kord (13 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kutselise kalapüügi püügivõimaluse enampakkumise toimumise kord"
    },
    {
      "@id": "estleg:Reg_1038989_Par_1_v1038989",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038989_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Püügivõimalused kaluri kalapüügiloa alusel ja püügivõimalused kalalaeva kalapüügiloa alusel (edaspidi koos püügivõimalused) müüakse enampakkumisel, kui: 1 1) esmakordselt kehtestatud lubatud püügivõimalused ei võimalda kalapüügilubade taotlusi täies ulatuses rahuldada; 2 2) esmakordselt uuel viisil kehtestatud lubatud püügivõimalused ei võimalda kalapüügilubade taotlusi täies ulatuses rahuldada ning varem püügivõimalusi kasutanud isikud püügivõimalusi ei taotle. Püügivõimalused kaluri kalapüügiloa alusel ja püügivõimalused kalalaeva kalapüügiloa alusel (edaspidi koos püügivõimalused) müüakse enampakkumisel, kui: esmakordselt kehtestatud lubatud püügivõimalused ei võimalda kalapüügilubade taotlusi täies ulatuses rahuldada; esmakordselt uuel viisil kehtestatud lubatud püügivõimalused ei võimalda kalapüügilubade taotlusi täies ulatuses rahuldada ning varem püügivõimalusi kasutanud isikud püügivõimalusi ei taotle. 2 (2) Püügivõimalused müüakse suulisel enampakkumisel, kus püügivõimaluse alghinnaks on kalapüügiõiguse tasu määr. Püügivõimalused müüakse suulisel enampakkumisel, kus püügivõimaluse alghinnaks on kalapüügiõiguse tasu määr.",
      "rdfs:label": {
        "@value": "Reg_1038989_Par_1 (redaktsioon 1038989)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038989",
