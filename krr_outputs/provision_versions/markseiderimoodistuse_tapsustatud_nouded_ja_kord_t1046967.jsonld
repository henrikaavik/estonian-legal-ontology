      "estleg:provisionRef": "Reg_1046967 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046967_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046967_Par_6_v1046967",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046967_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Markšeideridokumentatsioon koosneb seletuskirjast, mõõdistuste tulemustest, arvutustest ja graafilisest osast. Markšeideridokumentatsioon koosneb seletuskirjast, mõõdistuste tulemustest, arvutustest ja graafilisest osast. 2 (2) Digitaalsete lisadena esitatakse mõõdistuse tärkandmed, kõik arvutustes kasutatud pinnamudelid ning graafiline osa töödeldavas CAD või GIS formaadis. Digitaalsete lisadena esitatakse mõõdistuse tärkandmed, kõik arvutustes kasutatud pinnamudelid ning graafiline osa töödeldavas CAD või GIS formaadis.",
      "rdfs:label": {
