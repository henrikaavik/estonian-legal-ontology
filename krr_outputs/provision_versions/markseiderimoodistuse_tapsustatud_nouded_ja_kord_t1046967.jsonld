      }
    },
    {
      "@id": "estleg:Reg_1046967_Par_11_v1046967",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046967_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Allmaa-markšeiderivõrku tuleb täiendada vastavalt kaeveõõnte edasiliikumisele. Allmaa-markšeiderivõrgu käikude punktid ei tohi kaeveõõnte etest maha jääda rohkem kui 800 m. Üleujutatud või gaasistunud kaeveõõnest 50 meetri kaugusel ei tohi markšeiderivõrgu punktide omavaheline kaugus ohtlikule alale lähenevas kaeveõõnes ületada 30 meetrit. Allmaa-markšeiderivõrku tuleb täiendada vastavalt kaeveõõnte edasiliikumisele. Allmaa-markšeiderivõrgu käikude punktid ei tohi kaeveõõnte etest maha jääda rohkem kui 800 m. Üleujutatud või gaasistunud kaeveõõnest 50 meetri kaugusel ei tohi markšeiderivõrgu punktide omavaheline kaugus ohtlikule alale lähenevas kaeveõõnes ületada 30 meetrit. 2 (2) Allmaa-markšeiderivõrgud orienteeritakse vähemalt kaks korda. Ühe ja sama joone orienteerimistulemuste erinevus ei tohi ületada kolme minutit. Direktsiooninurga lõppsuuruseks võetakse nurkade kaalutud keskmine väärtus. Allmaa-markšeiderivõrgud orienteeritakse vähemalt kaks korda. Ühe ja sama joone orienteerimistulemuste erinevus ei tohi ületada kolme minutit. Direktsiooninurga lõppsuuruseks võetakse nurkade kaalutud keskmine väärtus. 3 (3) Allmaa-mõõdistamisvõrgud koosnevad ettevalmistuskaeveõõnte mõõdistamiseks rajatud käikudest. Allmaa-mõõdistamisvõrgud koosnevad ettevalmistuskaeveõõnte mõõdistamiseks rajatud käikudest.",
      "rdfs:label": {
        "@value": "Reg_1046967_Par_11 (redaktsioon 1046967)",
        "@language": "et"
      },
