    {
      "@id": "estleg:Reg_1042865_Par_6_v1042865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042865_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjoni esimees juhib komisjoni tööd ja vajaduse korral esindab komisjoni. Komisjoni esimees juhib komisjoni tööd ja vajaduse korral esindab komisjoni. 2 (2) Komisjoni esimehe äraolekul või tema ülesandel täidab esimehe ülesandeid komisjoni aseesimees või tema puudumisel esimehe määratud komisjoni liige. Komisjoni esimehe äraolekul või tema ülesandel täidab esimehe ülesandeid komisjoni aseesimees või tema puudumisel esimehe määratud komisjoni liige. 3 (3) Komisjon kinnitab protokollilise otsusega kodukorra ja juhendid, samuti kõik komisjoni nimel esitatavad arvamused, ettepanekud, avaldused, aruanded ja töörühmade koosseisud ning vajaduse korral nende tasustamise korra. Komisjon kinnitab protokollilise otsusega kodukorra ja juhendid, samuti kõik komisjoni nimel esitatavad arvamused, ettepanekud, avaldused, aruanded ja töörühmade koosseisud ning vajaduse korral nende tasustamise korra.",
      "rdfs:label": {
        "@value": "Reg_1042865_Par_6 (redaktsioon 1042865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042865",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042865",
      "estleg:sourceAct": "Rahapesu ja terrorismi rahastamise tõkestamise komisjoni liikmete arv ja töökord",
      "estleg:provisionRef": "Reg_1042865 § 6",
