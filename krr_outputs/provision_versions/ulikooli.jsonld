    {
      "@id": "estleg:UKS_Par_22_v108112010008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:UKS_Par_22"
