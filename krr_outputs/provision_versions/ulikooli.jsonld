      },
      "estleg:versionValidTo": {
        "@value": "2010-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:UKS_Par_14_v108112010005",
      "@type": [
        "owl:NamedIndividual",
