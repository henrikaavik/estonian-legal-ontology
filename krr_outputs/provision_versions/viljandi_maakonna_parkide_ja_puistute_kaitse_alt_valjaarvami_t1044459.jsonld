    {
      "@id": "estleg:Reg_1044459_Par_5_v1044459",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044459_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 26. oktoobri 2017. a käskkirjaga nr 1-2/17/1078 „Viljandimaa parkide ja puistute kaitse alt väljaarvamine” algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 26. oktoobri 2017. a käskkirjaga nr 1-2/17/1078 „Viljandimaa parkide ja puistute kaitse alt väljaarvamine” algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1044459_Par_5 (redaktsioon 1044459)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044459",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044459",
      "estleg:sourceAct": "Viljandi maakonna parkide ja puistute kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1044459 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044459_Map"
      }
    },
    {
      "@id": "estleg:Reg_1044459_Par_6_v1044459",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044459_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1044459_Par_6 (redaktsioon 1044459)",
        "@language": "et"
      },
