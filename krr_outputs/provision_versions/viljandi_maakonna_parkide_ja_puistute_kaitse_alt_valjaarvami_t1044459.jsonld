      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Viljandi maakonna parkide ja puistute kaitse alt väljaarvamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Viljandi maakonna parkide ja puistute kaitse alt väljaarvamine"
    },
    {
      "@id": "estleg:Reg_1044459_Par_1_v1044459",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044459_Par_1"
