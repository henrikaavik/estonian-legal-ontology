      },
      "estleg:versionText": "Püsivate üldkulude arvutamisel lähtutakse investeerimisfondide seaduse §-s 335 sätestatud alustest. Püsivate üldkulude arvutamisel lähtutakse investeerimisfondide seaduse §-s 335 sätestatud alustest.",
      "rdfs:label": {
        "@value": "Reg_1037787_Par_6 (redaktsioon 1037787)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037787",
