    {
      "@id": "estleg:Reg_1037787_Par_2_v1037787",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037787_Par_2"
