      }
    },
    {
      "@id": "estleg:Reg_1002185_Par_24_v1002185",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002185_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Leht ilmub iga kuu 15. kuupäeval. Kui lehe ilmumise päev ei ole tööpäev, ilmub leht nimetatud kuupäevale järgneval esimesel tööpäeval. Leht ilmub iga kuu 15. kuupäeval. Kui lehe ilmumise päev ei ole tööpäev, ilmub leht nimetatud kuupäevale järgneval esimesel tööpäeval. 2 (2) Leht avaldatakse lõikes 1 nimetatud tähtpäeval PDF-vormingus Patendiameti veebilehel. RT I 2014-08-19 2 119082014002 2014-12-01 Leht avaldatakse lõikes 1 nimetatud tähtpäeval PDF-vormingus Patendiameti veebilehel.",
      "rdfs:label": {
