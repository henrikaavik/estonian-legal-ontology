        "@type": "xsd:date"
      },
      "estleg:versionText": "Osas avaldatakse teated, mis ei kuulu avaldamisele teistes osades. Osas avaldatakse teated, mis ei kuulu avaldamisele teistes osades.",
      "rdfs:label": {
        "@value": "Reg_1002185_Par_19 (redaktsioon 1002185)",
        "@language": "et"
      },
