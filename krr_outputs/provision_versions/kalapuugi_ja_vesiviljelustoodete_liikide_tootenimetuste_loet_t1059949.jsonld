    {
      "@id": "estleg:Reg_1059949_Par_2_v1059949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059949_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist kehtinud põllumajandusministri 14. jaanuari 2015. a määruse nr 5 „Kalapüügi- ja vesiviljelustoodete liikide tootenimetuste loetelu” lisas „Kalapüügi- ja vesiviljelustoodete liikide tootenimetuste loetelu” nimetatud kalapüügi- ja vesiviljelustoodete liikide tootenimetusi võib turustamisel kasutada enne käesoleva määruse jõustumist toodetud või kalapüügi tulemusel saadud kalapüügi- ja vesiviljelustoodete puhul kuni sellise märgistusega toodete lõppemiseni. Enne käesoleva määruse jõustumist kehtinud põllumajandusministri 14. jaanuari 2015. a määruse nr 5 „Kalapüügi- ja vesiviljelustoodete liikide tootenimetuste loetelu” lisas „Kalapüügi- ja vesiviljelustoodete liikide tootenimetuste loetelu” nimetatud kalapüügi- ja vesiviljelustoodete liikide tootenimetusi võib turustamisel kasutada enne käesoleva määruse jõustumist toodetud või kalapüügi tulemusel saadud kalapüügi- ja vesiviljelustoodete puhul kuni sellise märgistusega toodete lõppemiseni.",
