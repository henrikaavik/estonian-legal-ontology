      "estleg:sourceAct": "Lüsingu maastikukaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_307395 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_307395_Map"
      }
    },
    {
      "@id": "estleg:Reg_307395_Par_7_v307395",
