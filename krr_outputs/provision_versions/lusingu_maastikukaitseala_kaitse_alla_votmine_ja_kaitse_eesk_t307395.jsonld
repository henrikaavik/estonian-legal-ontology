    {
      "@id": "estleg:Reg_307395_Par_15_v307395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307395_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavarade kaevandamine; 3 3) energiapuistute rajamine; 4 4) uuendusraie, välja arvatud turberaie raielangi suurusega kuni 2 ha, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 5 5) biotsiidi ja taimekaitsevahendi kasutamine, välja arvatud põllu- ja õuemaal; 6 6) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavarade kaevandamine; energiapuistute rajamine; uuendusraie, välja arvatud turberaie raielangi suurusega kuni 2 ha, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; biotsiidi ja taimekaitsevahendi kasutamine, välja arvatud põllu- ja õuemaal; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine.",
      "rdfs:label": {
        "@value": "Reg_307395_Par_15 (redaktsioon 307395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "307395",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/307395",
      "estleg:sourceAct": "Lüsingu maastikukaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_307395 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_307395_Map"
      }
    },
    {
      "@id": "estleg:Reg_307395_Par_2_v307395",
      "@type": [
        "owl:NamedIndividual",
