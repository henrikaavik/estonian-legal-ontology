    {
      "@id": "estleg:Reg_307395_Par_14_v307395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_307395_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) ehitise püstitamine; 2 2) puhtpuistute kujundamine. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: ehitise püstitamine; puhtpuistute kujundamine.",
      "rdfs:label": {
