    {
      "@id": "estleg:Reg_325497_Par_13_14_v325497",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325497_Par_13_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Harvikhaigused, mille puhul makstakse puuetega inimeste sotsiaaltoetuste seaduse § 6 lõikes 11 sätestatud juhul puudega lapse toetust, on järgmised: 1 1) fenüülketonuuria; 2 2) galaktoseemia; 3 3) vahtrasiirupi tõbi; 4 4) püridoksiinsõltuv epilepsia; RT I 2020-05-08 2 108052020002 2020-05-11 5 5) homotsüstinuuria; RT I 2021-04-16 3 116042021003 2021-05-01 6 6) lüsinuuriline valgutalumatus; RT I 2021-04-16 3 116042021003 2021-05-01 7 7) glükoosi transporteri defekt; RT I 2021-04-16 3 116042021003 2021-05-01 8 8) fruktoseemia; RT I 2021-04-16 3 116042021003 2021-05-01 9 9) glutaaratsiduuria (tüüp 1 ja 2); RT I 2021-04-16 3 116042021003 2021-05-01 10 10) tsüstiline fibroos. RT I 2021-04-16 3 116042021003 2021-05-01 Harvikhaigused, mille puhul makstakse puuetega inimeste sotsiaaltoetuste seaduse § 6 lõikes 11 sätestatud juhul puudega lapse toetust, on järgmised: fenüülketonuuria; galaktoseemia; vahtrasiirupi tõbi; püridoksiinsõltuv epilepsia; homotsüstinuuria; lüsinuuriline valgutalumatus; glükoosi transporteri defekt; fruktoseemia; glutaaratsiduuria (tüüp 1 ja 2); tsüstiline fibroos.",
      "rdfs:label": {
        "@value": "Reg_325497_Par_13_14 (redaktsioon 325497)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325497",
