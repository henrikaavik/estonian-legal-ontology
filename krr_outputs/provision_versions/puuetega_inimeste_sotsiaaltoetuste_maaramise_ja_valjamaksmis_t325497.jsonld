    },
    {
      "@id": "estleg:Reg_325497_Par_9_v325497",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325497_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaaltoetuste maksmine peatatakse: 1 1) toetuse saaja, tema seadusliku esindaja, eestkosteasutuse või hoolekandeasutuse teatise põhjal; 2 2) kehtetu - RT I 2016-01-05 9 105012016009 2017-01-01 3 3) kui posti teel makstud sotsiaaltoetused on välja võtmata vähemalt kaks kuud; RT I 2016-01-05 9 105012016009 2017-01-01 4 4) valla- või linnavalitsuse korralduse alusel, kui lapsevanem ei täida «Perekonnaseadusest» tulenevat kohustust puudega last kasvatada ja tema eest hoolitseda; 5 5) süüdimõistetud toetusesaaja vanglas või arestimajas vangistuse kandmise ajaks, välja arvatud juhul, kui isik vajab oma puude tõttu individuaalset abivahendit. Sotsiaaltoetuste maksmine peatatakse: toetuse saaja, tema seadusliku esindaja, eestkosteasutuse või hoolekandeasutuse teatise põhjal; kehtetu - kui posti teel makstud sotsiaaltoetused on välja võtmata vähemalt kaks kuud; valla- või linnavalitsuse korralduse alusel, kui lapsevanem ei täida «Perekonnaseadusest» tulenevat kohustust puudega last kasvatada ja tema eest hoolitseda; süüdimõistetud toetusesaaja vanglas või arestimajas vangistuse kandmise ajaks, välja arvatud juhul, kui isik vajab oma puude tõttu individuaalset abivahendit.",
      "rdfs:label": {
        "@value": "Reg_325497_Par_9 (redaktsioon 325497)",
        "@language": "et"
      },
