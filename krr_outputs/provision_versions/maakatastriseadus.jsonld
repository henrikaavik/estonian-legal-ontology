    {
      "@id": "estleg:MaaKatS_Par_6_v129062018026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaKatS_Par_6"
