    {
      "@id": "estleg:MaaKatS_Par_14_v110032022031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaKatS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa kvaliteedi kaardile kantakse maismaa mulla viljakust kajastavad andmed. (1¹) Maa hindamise kaart kajastab 2001. aasta maa korralise hindamise tulemusi. (2) Kehtetu - (3) Maa kvaliteedi ja hindamise kaart koostatakse poolt kehtestatud korras.",
      "rdfs:label": {
        "@value": "MaaKatS_Par_14 (redaktsioon 110032022031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110032022031"
    },
    {
      "@id": "estleg:MaaKatS_Par_14_1_v22302",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaKatS_Par_14_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Katastri aluskaardid on Eesti põhikaart, ortofotod ning asulaplaanid. (2) Eesti põhikaardi mõõtkava on 1:10 000. Ortofotode mõõtkava on asulates 1:2000 ja hajaasustusega aladel 1:10 000. (3) Tiheasustusega aladel kasutatakse katastri aluskaardina asulaplaane mõõtkavas 1:500 või 1:2000.",
      "rdfs:label": {
        "@value": "MaaKatS_Par_14_1 (redaktsioon 22302)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22302",
      "estleg:supersededByVersion": {
