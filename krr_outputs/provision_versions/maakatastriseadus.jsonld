        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Katastri aluskaardid on Eesti põhikaart ja ortofotod. (2) Eesti põhikaardi mõõtkava on 1:10 000. Ortofotode mõõtkava on asulates 1:2000 ja hajaasustusega aladel 1:10 000. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "MaaKatS_Par_14_1 (redaktsioon 129062018026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062018026",
