      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Rahvastikuregistri andmetel välisriigis elavale ajateenijale ning reservteenistuses ja reservasendusteenistuses osalenud reservis olevale isikule sõidukulu hüvitamise tingimused, ulatus ja kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Rahvastikuregistri andmetel välisriigis elavale ajateenijale ning reservteenistuses ja reservasendusteenistuses osalenud reservis olevale isikule sõidukulu hüvitamise tingimused, ulatus ja kord"
    },
    {
      "@id": "estleg:Reg_1010630_Par_1_v1010630",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010630_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rahvastikuregistri andmetel välisriigis elavale ajateenijale hüvitatakse sõidukulu piirmäära ulatuses üks kord sõiduks puhkusele ja tagasi ajateenistuskohta. RT I 2026-02-20 19 120022026019 2026-02-23 Rahvastikuregistri andmetel välisriigis elavale ajateenijale hüvitatakse sõidukulu piirmäära ulatuses üks kord sõiduks puhkusele ja tagasi ajateenistuskohta. 2 (2) Kehtetu - RT I 2026-02-20 19 120022026019 2026-02-23 Kehtetu - 3 (3) Kehtetu - RT I 2022-04-27 11 127042022011 2022-05-01 Kehtetu - 4 (4) Rahvastikuregistri andmetel välisriigis elavale ajateenijale makstakse sõidukulu hüvitist 200 eurot. RT I 2026-02-20 19 120022026019 2026-02-23 Rahvastikuregistri andmetel välisriigis elavale ajateenijale makstakse sõidukulu hüvitist 200 eurot. 5 (5) Sõidukulu hüvitamist taotleb ajateenija seitsme päeva jooksul puhkuselt ajateenistuskohta jõudmisest arvates. RT I 2022-04-27 11 127042022011 2022-05-01 Sõidukulu hüvitamist taotleb ajateenija seitsme päeva jooksul puhkuselt ajateenistuskohta jõudmisest arvates. 6 (6) Rahvastikuregistri andmetel välisriigis elavale ajateenijale hüvitatakse sõidukulu 14 päeva jooksul nõuetekohase taotluse esitamisest arvates. Hüvitis kantakse ajateenija esitatud arvelduskontole. RT I 2026-02-20 19 120022026019 2026-02-23 Rahvastikuregistri andmetel välisriigis elavale ajateenijale hüvitatakse sõidukulu 14 päeva jooksul nõuetekohase taotluse esitamisest arvates. Hüvitis kantakse ajateenija esitatud arvelduskontole.",
      "rdfs:label": {
        "@value": "Reg_1010630_Par_1 (redaktsioon 1010630)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010630",
