      }
    },
    {
      "@id": "estleg:Reg_155124_Par_3_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava ja ehitusprojekti meditsiinitehnoloogia osa vormistamise nõuded kehtestatakse kasutamiseks haigla ümberprofileerimise, renoveerimise ja uusehituste kavandamisel. Nõudeid kohaldatakse ka ambulatoorse eriarstiabi osutamiseks kasutatavate ruumide meditsiinitehnoloogia osa projektide eelprojekti ja põhiprojekti staadiumidele.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_3 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_4_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla ehituslik projekteerimine toimub «Planeerimisseaduses» ja «Ehitusseaduses» kehtestatud nõuete alusel.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_4 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_5_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava läbivaatamiseks ning selle kohta arvamuse koostamiseks moodustatakse sotsiaalministri käskkirjaga komisjon. Komisjoni ettepaneku põhjal kinnitab sotsiaalminister haigla funktsionaalse arengukava.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_5 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_6_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Reg_155124_Par_6 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_7_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava koosseisus esitatakse: 1 1) haigla vastutuspiirkonda iseloomustavad andmed: vastutuspiirkonna suurus, rahvaarv, vanuseline koosseis, asustustihedus ja muud rahvastikunäitajad; 2 2) renoveeritava või ümberprofileeritava haigla olemasoleva funktsionaalse struktuuri analüüs ja vastavus kavandatava haigla liigile; 3 3) renoveeritava või ümberprofileeritava haigla osutatavate tervishoiuteenuste analüüs: tervishoiuteenuste loetelu, uuringute arv, voodifondi kasutus ja muud iseloomulikud näitajad; 4 4) ülevaade renoveeritava või ümberprofileeritava haigla olemasolevatest hoonetest: kasuliku pindala näitajad, tehnilise seisukorra hinnang, tehnovõrkude olemasolu ja seisukorra iseloomustus, varasemate projektide ja ehitustööde loetelu; 5 5) haigla tervishoiuteenuste analüüsist tulenevad planeeritavad ambulatoorsete külastuste ning voodite vajaduse näitajad erialade kaupa. Analüüs peab arvestama tervishoiupoliitika arengusuundi ja vastutuspiirkonna rahvastikunäitajaid, viimaste aastate tervishoiustatistikat ning tervishoiuteenuste osutamist reguleerivaid õigusakte; 6 6) planeeritava haigla ruumide jaotus funktsionaalseteks valdkondadeks ja osakondadeks või üksusteks käesoleva määruse lisa 1 järgi; 7 7) teave haigla planeerimisel kasutatavate standardite kohta, oluliste töökorralduse viiside või planeerimismudelite kohta; 8 8) tervishoiuteenuste analüüsi põhjal tuletatud haigla palatiosakondade jaotus ja voodite arv, eriarstide ambulatoorse vastuvõtu ning ravi- ja diagnostikaruumide vajadus; 9 9) tervishoiutöötajate vajadus haiglas; 10 10) haigla funktsionaalne programm: iga osakonna või struktuuriüksuse lühikirjeldus, kaasa arvatud põhiruumide vajalik koosseis ja osakonna või struktuuriüksuse kasuliku pindala ligikaudne hinnang m2-tes; üldnõuded tähtsamate osakondadevaheliste ühenduste ja liikumisteede kohta lähtudes töökorralduslikust, meditsiinilisest või tehnilisest seisukohast. Kirjeldus võib sisaldada ka teavet mõne eraldi ruumi või seadme kohta, mis on oluline projekteerimise selles staadiumis meditsiinilisest või tehnilisest seisukohast; 11 11) pindala tabel, mis sisaldab iga planeeritava struktuuriüksuse kasulikku pindala, renoveeritava või ümberprofileeritava haigla puhul ka pindala olemasolevaid näitajaid ning planeeritava brutopindala hinnangulist näitajat; 12 12) hinnanguline ehitusmaksumus; 13 13) arhitektuurne plaanilahendus (M 1:500), mis näitab hoone planeeritavat põhimõttelist funktsionaalset struktuuri: struktuuriüksuste asukohad hoones, liftid, trepid, koridorid. RTL 2003 48 708 562979 2003-04-19 Haigla funktsionaalse arengukava koosseisus esitatakse: haigla vastutuspiirkonda iseloomustavad andmed: vastutuspiirkonna suurus, rahvaarv, vanuseline koosseis, asustustihedus ja muud rahvastikunäitajad; renoveeritava või ümberprofileeritava haigla olemasoleva funktsionaalse struktuuri analüüs ja vastavus kavandatava haigla liigile; renoveeritava või ümberprofileeritava haigla osutatavate tervishoiuteenuste analüüs: tervishoiuteenuste loetelu, uuringute arv, voodifondi kasutus ja muud iseloomulikud näitajad; ülevaade renoveeritava või ümberprofileeritava haigla olemasolevatest hoonetest: kasuliku pindala näitajad, tehnilise seisukorra hinnang, tehnovõrkude olemasolu ja seisukorra iseloomustus, varasemate projektide ja ehitustööde loetelu; haigla tervishoiuteenuste analüüsist tulenevad planeeritavad ambulatoorsete külastuste ning voodite vajaduse näitajad erialade kaupa. Analüüs peab arvestama tervishoiupoliitika arengusuundi ja vastutuspiirkonna rahvastikunäitajaid, viimaste aastate tervishoiustatistikat ning tervishoiuteenuste osutamist reguleerivaid õigusakte; planeeritava haigla ruumide jaotus funktsionaalseteks valdkondadeks ja osakondadeks või üksusteks käesoleva määruse lisa 1 järgi; teave haigla planeerimisel kasutatavate standardite kohta, oluliste töökorralduse viiside või planeerimismudelite kohta; tervishoiuteenuste analüüsi põhjal tuletatud haigla palatiosakondade jaotus ja voodite arv, eriarstide ambulatoorse vastuvõtu ning ravi- ja diagnostikaruumide vajadus; tervishoiutöötajate vajadus haiglas; haigla funktsionaalne programm: iga osakonna või struktuuriüksuse lühikirjeldus, kaasa arvatud põhiruumide vajalik koosseis ja osakonna või struktuuriüksuse kasuliku pindala ligikaudne hinnang m2-tes; üldnõuded tähtsamate osakondadevaheliste ühenduste ja liikumisteede kohta lähtudes töökorralduslikust, meditsiinilisest või tehnilisest seisukohast. Kirjeldus võib sisaldada ka teavet mõne eraldi ruumi või seadme kohta, mis on oluline projekteerimise selles staadiumis meditsiinilisest või tehnilisest seisukohast; pindala tabel, mis sisaldab iga planeeritava struktuuriüksuse kasulikku pindala, renoveeritava või ümberprofileeritava haigla puhul ka pindala olemasolevaid näitajaid ning planeeritava brutopindala hinnangulist näitajat; hinnanguline ehitusmaksumus; arhitektuurne plaanilahendus (M 1:500), mis näitab hoone planeeritavat põhimõttelist funktsionaalset struktuuri: struktuuriüksuste asukohad hoones, liftid, trepid, koridorid.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_7 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_8_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eelprojekti meditsiinitehnoloogia osas koostatakse kogu haigla või eraldi käsitlemist võimaldavate üksuste kohta funktsionaalne programm ja ruumiprogramm ning põhimõtteline tehnoloogiline plaanilahendus.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_8 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_9_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osakonna või muu struktuuriüksuse funktsionaalne programm peab kirjeldama osakonda või struktuuriüksust tulevases hoones ja sisaldama: 1 1) kasutusotstarbe määratlust, kasutatavate ravi- või uuringumeetodite lühikirjeldust planeerimiseks vajaliku teabe ulatuses; 2 2) osakonnasiseste seoste ja teiste osakondadega vajalike ühenduste kirjeldust; 3 3) osakonnas toimuva tegevuse kirjeldust projekteerimiseks vajaliku teabe ulatuses, personali koosseisu ja arvu; 4 4) töökorralduse põhimõtteid ja vajadusi varustamiseks, steriliseerimiseks, desinfektsiooniks, koristamiseks ja jäätmekäitluseks; 5 5) meditsiinitehnoloogiast tulenevaid erinõudeid ruumidele, seadmetele ja tehnilistele kommunikatsioonidele; 6 6) ruumide planeerimist ja kommunikatsioonide projekteerimist mõjutavaid haiglanakkustõrje põhimõtteid; 7 7) erivajaduste kirjeldust: radiatsioonikaitse, turvameetmed, akustika ja muud. Osakonna või muu struktuuriüksuse funktsionaalne programm peab kirjeldama osakonda või struktuuriüksust tulevases hoones ja sisaldama: kasutusotstarbe määratlust, kasutatavate ravi- või uuringumeetodite lühikirjeldust planeerimiseks vajaliku teabe ulatuses; osakonnasiseste seoste ja teiste osakondadega vajalike ühenduste kirjeldust; osakonnas toimuva tegevuse kirjeldust projekteerimiseks vajaliku teabe ulatuses, personali koosseisu ja arvu; töökorralduse põhimõtteid ja vajadusi varustamiseks, steriliseerimiseks, desinfektsiooniks, koristamiseks ja jäätmekäitluseks; meditsiinitehnoloogiast tulenevaid erinõudeid ruumidele, seadmetele ja tehnilistele kommunikatsioonidele; ruumide planeerimist ja kommunikatsioonide projekteerimist mõjutavaid haiglanakkustõrje põhimõtteid; erivajaduste kirjeldust: radiatsioonikaitse, turvameetmed, akustika ja muud.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_9 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
