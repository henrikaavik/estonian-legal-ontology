  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_nouded_haigla_funktsionaalsele_arengukavale_ja_ehitusprojekt_t155124_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord (30 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord"
    },
    {
      "@id": "estleg:Reg_155124_Par_1_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus kehtestab haigla funktsionaalse arengukava kinnitamise korra ning nõuded haigla funktsionaalsele arengukavale ja meditsiinitehnoloogia osale ehitusprojekti eri staadiumides.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_1 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_10_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla osakonna või muu struktuuriüksuse ruumiprogramm koosneb tehnoloogiliseks otstarbeks kasutatavate ruumide loetelust ja nende pindala suurusest. Ruumiprogrammi koostamisel lähtutakse tervishoiuteenuse osutamist reguleerivatest õigusaktidest, teiste Euroopa riikide publitseeritud standarditest, ruumi kasutusotstarbest ja muudest teguritest. Ruumiprogramm esitatakse tabelina käesoleva määruse lisa 2 põhjal, kus on liigitatud struktuuriüksuses tervishoiuteenuse osutamiseks ja muuks tegevuseks vajalikud ruumid (põhiruumid, abiruumid, personali ruumid). Projektis esitatakse ka ruumiprogrammi ja hoones ehituslikult realiseeritava kasuliku pindala võrdlustabel.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_10 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_11_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meditsiiniseadmete loetelu esitatakse ruumide kaupa, vajadusel eraldi uued ja olemasolevad. Sisseseade ja seadmete kohta, mis vajavad tehnilisi kommunikatsioone, antakse põhiandmed (mõõtmed, mass, kommunikatsiooni vajadus, olulised paigaldusandmed).",
      "rdfs:label": {
        "@value": "Reg_155124_Par_11 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_12_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tehnoloogiline plaanilahendus, mis sisaldab korruste plaane kohtkindlate seadmete ja põhisisustuse paigutusega. Samaotstarbeliste ruumide (palatid, raviotstarbelised ruumid, tualettruumid ja teised) kohta antakse ühe ruumi üksikasjalise plaanilahenduse näide.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_12 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_13_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pakkumisdokumentatsioon sisaldab täpsustatud tehniliste andmetega seadmete nimekirja, mis võimaldab selgitada seadmete tarnijaid.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_13 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_14_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla põhiprojektis koostatakse iga ruumi kohta tehnoloogiline projekt, mis vormistatakse eraldi dokumendina käesoleva määruse lisas 3 toodud näidise järgi. Põhiruumide kohta koostatud tehnoloogiline projekt on ühtlasi dokument, mis esitatakse «Tervishoiuteenuste korraldamise seaduse» § 41 punkti 9 alusel tegevusloa taotlemisel. Põhiprojektide dokumendina esitatakse ka meditsiiniseadmete koondnimekiri.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_14 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_15_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ruumi tehnoloogia projekt peab sisaldama järgmist: 1 1) projekti ja ruumi asukoha identifitseerivaid andmeid, ruumi nimetust, pindala ja muid koostaja poolt vajalikuks peetavaid andmeid; 2 2) ruumis toimuva tööprotsessi lühikirjeldust või tegevuste loetelu, vajalikke ühendusi teiste ruumidega, inimeste arvu, nõudeid ruumile keskkonna, hügieeni või tööohutuse seisukohast; 3 3) tehnoloogiast tulenevaid erinõudeid ehituslikule osale või tehnilistele kommunikatsioonidele; 4 4) erivajaduste kirjeldust radiatsioonikaitse, elektriseadmete kaitsemaanduse, turvameetmete vajaduse, akustika või muudest olulistest nõuetest lähtudes; 5 5) ruumi sisustuse plaani M 1:50 või M 1:100, vajaduse korral vaateid, lõikeid; 6 6) sisutoetuste loetelu. Ruumi tehnoloogia projekt peab sisaldama järgmist: projekti ja ruumi asukoha identifitseerivaid andmeid, ruumi nimetust, pindala ja muid koostaja poolt vajalikuks peetavaid andmeid; ruumis toimuva tööprotsessi lühikirjeldust või tegevuste loetelu, vajalikke ühendusi teiste ruumidega, inimeste arvu, nõudeid ruumile keskkonna, hügieeni või tööohutuse seisukohast; tehnoloogiast tulenevaid erinõudeid ehituslikule osale või tehnilistele kommunikatsioonidele; erivajaduste kirjeldust radiatsioonikaitse, elektriseadmete kaitsemaanduse, turvameetmete vajaduse, akustika või muudest olulistest nõuetest lähtudes; ruumi sisustuse plaani M 1:50 või M 1:100, vajaduse korral vaateid, lõikeid; sisutoetuste loetelu.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_15 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_16_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Reg_155124_Par_16 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_17_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava läbivaatamiseks moodustatava komisjoni koosseisu ja töökorra kinnitab sotsiaalminister käskkirjaga.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_17 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_17_18_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_17_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalne arengukava esitatakse komisjonile läbivaatamiseks kahes etapis, esimene etapp peab sisaldama määruse § 7 punktides 1, 3, 5, 9 nimetatud andmeid ning teine etapp punktides 2, 4 ja 6-8 ja 10-13 nimetatud andmeid.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_17_18 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 17_18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_18_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitusprojekti tellija või tema volitatud isik esitab komisjonile taotluse haigla funktsionaalse arengukava etapi läbivaatamiseks ning läbivaatamisele kuuluva materjali elektrooniliselt ja vähemalt ühes eksemplaris paberkandjal.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_18 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_19_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjon teeb sotsiaalministrile ettepaneku haigla funktsionaalse arengukava etapi kinnitamiseks või tagasilükkamiseks 45 tööpäeva jooksul taotluse registreerimisest Sotsiaalministeeriumi kantseleis, lisades §-des 23 ja 231 nimetatud kirjaliku arvamuse.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_19 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_19_21_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_19_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjon võib teha haiglale ettepaneku arengukava etapi korrigeerimiseks 45 tööpäeva jooksul ja korrigeeritud arengukava etapi esitamiseks komisjonile läbivaatamiseks.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_19_21 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 19_21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_1_1_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitusprojekti staadiumid käesoleva määruse tähenduses on eelprojekt ja põhiprojekt.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_1_1 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 1_1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_2_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalne arengukava on haigla vastutuspiirkonna ravivajaduste analüüsi, osutatavate tervishoiuteenuste mahtu ja haigla ruumivajadust ning põhimõttelist tervishoiuteenuse osutamise funktsionaalset lahendust sisaldav dokument.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_2 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_20_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Komisjon võib teha sotsiaalministrile ettepaneku kinnitada haigla funktsionaalse arengukava etapp tingimustega, mis tuleb täita projekteerimise järgmises etapis.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_20 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_21_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava etapi, mis oluliste puuduste esinemisel tagasi lükatakse, võib ehitusprojekti tellija või tema volitatud isik esitada komisjonile uueks läbivaatamiseks parandatult või vaidlustada komisjoni arvamuses esitatud seisukohti.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_21 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_22_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalminister kinnitab haigla funktsionaalse arengukava etapi või lükkab tagasi viieteistkümne tööpäeva jooksul pärast komisjonilt ettepaneku saamist ja teavitab taotlejat kirjalikult, lisades §-des 23 ja 231 nimetatud kirjaliku arvamuse.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_22 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_23_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava esimese etapi läbivaatamise kohta annab komisjon arvamuse, milles käsitleb: 1 1) arengukava vastavust haiglavõrgu arengukavale; 2 2) haigla kavandatava töömahu vastavust haigla liigile ja vastutuspiirkonna ravivajadustele; 3 3) kehtetu - RTL 2003 48 708 562979 2003-04-19 4 4) planeeritava meditsiinitehnoloogia ja töökorralduse vastavust meditsiini uutele arengusuundadele; 5 5) kehtetu - RTL 2003 48 708 562979 2003-04-19 6 6) kehtetu - RTL 2003 48 708 562979 2003-04-19 7 7) kehtetu - RTL 2003 48 708 562979 2003-04-19 Haigla funktsionaalse arengukava esimese etapi läbivaatamise kohta annab komisjon arvamuse, milles käsitleb: arengukava vastavust haiglavõrgu arengukavale; haigla kavandatava töömahu vastavust haigla liigile ja vastutuspiirkonna ravivajadustele; kehtetu - planeeritava meditsiinitehnoloogia ja töökorralduse vastavust meditsiini uutele arengusuundadele; kehtetu - kehtetu - kehtetu -",
      "rdfs:label": {
        "@value": "Reg_155124_Par_23 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_23_26_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_23_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haigla funktsionaalse arengukava teise etapi läbivaatamise kohta annab komisjon arvamuse, milles käsitleb: 1 1) ruumivajaduse määratlemiseks kasutatud standardeid, 2 2) hinnangulise bruto- ja kasuliku pindala näitajaid võrreldes analoogiliste projektidega, 3 3) haigla arhitektuurse eskiislahenduse sobivust haigla funktsioonide täitmiseks, 4 4) hinnangulist ehitusmaksumust. RTL 2003 48 708 562979 2003-04-19 Haigla funktsionaalse arengukava teise etapi läbivaatamise kohta annab komisjon arvamuse, milles käsitleb: ruumivajaduse määratlemiseks kasutatud standardeid, hinnangulise bruto- ja kasuliku pindala näitajaid võrreldes analoogiliste projektidega, haigla arhitektuurse eskiislahenduse sobivust haigla funktsioonide täitmiseks, hinnangulist ehitusmaksumust.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_23_26 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 23_26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
    {
      "@id": "estleg:Reg_155124_Par_24_v155124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155124_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnitatud haigla funktsionaalne arengukava on ehitusprojekti eelprojekti meditsiinitehnoloogia osa lähteülesande aluseks. Juhul kui ehitusliku projekteerimise jätkamisel tehnoloogia lähteandmetes on vajalik teha muudatusi käesoleva määruse § 23 punktides 1–2 ja § 231 punktis 1 sätestatud andmetes, tuleb tellijal või tema volitatud isikul esitada komisjonile läbivaatamiseks haigla funktsionaalse arengukava etappide korrektuurid või väiksemate muudatuste korral kinnitamise taotlus koos seletuskirjaga, milles selgitatakse muudatuste sisu.",
      "rdfs:label": {
        "@value": "Reg_155124_Par_24 (redaktsioon 155124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155124",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155124",
      "estleg:sourceAct": "Nõuded haigla funktsionaalsele arengukavale ja ehitusprojekti meditsiinitehnoloogia osale ning haigla funktsionaalse arengukava kinnitamise kord",
      "estleg:provisionRef": "Reg_155124 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155124_Map"
      }
    },
