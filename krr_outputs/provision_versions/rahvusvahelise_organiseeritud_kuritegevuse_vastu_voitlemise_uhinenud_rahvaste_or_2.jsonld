      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Rahvusvahelise organiseeritud kuritegevuse vastu võitlemise Ühinenud Rahvaste Organisatsiooni konventsiooni ratifitseerimise seadus (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Rahvusvahelise organiseeritud kuritegevuse vastu võitlemise Ühinenud Rahvaste Organisatsiooni konventsiooni ratifitseerimise seadus"
    },
    {
      "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_1_v236606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
