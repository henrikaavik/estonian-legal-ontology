        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 18 lõike 14 alusel deklareerib Eesti Vabariik, et talle vastuvõetavateks keelteks on eesti ja inglise keel.",
