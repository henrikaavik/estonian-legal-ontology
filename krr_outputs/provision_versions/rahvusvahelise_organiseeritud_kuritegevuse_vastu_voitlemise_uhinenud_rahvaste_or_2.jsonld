      "estleg:partOfAct": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Map"
      }
    },
    {
      "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_5_v236606",
