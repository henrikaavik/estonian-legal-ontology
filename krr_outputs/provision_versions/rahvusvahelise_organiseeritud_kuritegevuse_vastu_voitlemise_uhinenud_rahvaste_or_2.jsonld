        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on ÜRO Peaassamblee poolt vastu võetud 2000. aasta 12. detsembril Itaalias Palermos ja millele Eesti Vabariik on alla kirjutanud 2000. aasta 14. detsembril Itaalias Palermos.",
      "rdfs:label": {
        "@value": "rahvusvahelise_organiseeritud_kuritegevu_Par_1 (redaktsioon 236606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "236606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/236606",
      "estleg:sourceAct": "Rahvusvahelise organiseeritud kuritegevuse vastu võitlemise Ühinenud Rahvaste Organisatsiooni konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "rahvusvahelise_organiseeritud_kuritegevu § 1",
      "estleg:partOfAct": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Map"
      }
    },
    {
      "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_2_v236606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 5 lõike 3 alusel deklareerib Eesti Vabariik, et ta käsitab oma seaduste kohaselt kuriteona artikli 5 lõike 1 punkti a alapunktis i nimetatud tegu.",
      "rdfs:label": {
        "@value": "rahvusvahelise_organiseeritud_kuritegevu_Par_2 (redaktsioon 236606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "236606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/236606",
      "estleg:sourceAct": "Rahvusvahelise organiseeritud kuritegevuse vastu võitlemise Ühinenud Rahvaste Organisatsiooni konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "rahvusvahelise_organiseeritud_kuritegevu § 2",
      "estleg:partOfAct": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Map"
      }
    },
    {
      "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_3_v236606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 16 lõike 5 alusel deklareerib Eesti Vabariik, et ta käsitab konventsiooni isiku väljaandmiseks teiste osalisriikidega tehtava koostöö õigusliku alusena.",
      "rdfs:label": {
        "@value": "rahvusvahelise_organiseeritud_kuritegevu_Par_3 (redaktsioon 236606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "236606",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/236606",
      "estleg:sourceAct": "Rahvusvahelise organiseeritud kuritegevuse vastu võitlemise Ühinenud Rahvaste Organisatsiooni konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "rahvusvahelise_organiseeritud_kuritegevu § 3",
      "estleg:partOfAct": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Map"
      }
    },
    {
      "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_4_v236606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:rahvusvahelise_organiseeritud_kuritegevu_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konventsiooni artikli 18 lõike 13 alusel määrab Eesti Vabariik õigusabitaotluste vastuvõtmise keskasutuseks Justiitsministeeriumi.",
      "rdfs:label": {
        "@value": "rahvusvahelise_organiseeritud_kuritegevu_Par_4 (redaktsioon 236606)",
