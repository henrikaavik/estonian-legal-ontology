      }
    },
    {
      "@id": "estleg:Reg_1017965_Par_2_v1017965",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017965_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konkursi läbiviimiseks moodustab haridus- ja teadusminister komisjoni ning nimetab komisjoni liikmete hulgast esimehe ja sekretäri. Konkursi läbiviimiseks moodustab haridus- ja teadusminister komisjoni ning nimetab komisjoni liikmete hulgast esimehe ja sekretäri. 2 (2) Komisjon on vähemalt kolmeliikmeline ning selle koosseisu kuuluvad: 1 1) esindajad Haridus- ja Teadusministeeriumist; 2 2) esindaja kooli nõunike kogust või hoolekogust; 3 3) vajadusel esindaja või esindajad muudest asutustest, ettevõtetest ja organisatsioonidest. Komisjon on vähemalt kolmeliikmeline ning selle koosseisu kuuluvad: esindajad Haridus- ja Teadusministeeriumist; esindaja kooli nõunike kogust või hoolekogust; vajadusel esindaja või esindajad muudest asutustest, ettevõtetest ja organisatsioonidest. 3 (3) Haridus- ja teadusministeeriumi esindajad moodustavad enamuse komisjoni koosseisust. Haridus- ja teadusministeeriumi esindajad moodustavad enamuse komisjoni koosseisust.",
      "rdfs:label": {
        "@value": "Reg_1017965_Par_2 (redaktsioon 1017965)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017965",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017965",
      "estleg:sourceAct": "Riigi kutseõppeasutuse ja riigi üldhariduskooli direktori vaba ametikoha täitmiseks korraldatava konkursi läbiviimise kord",
      "estleg:provisionRef": "Reg_1017965 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1017965_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1017965_Par_3_v1017965",
      "@type": [
        "owl:NamedIndividual",
