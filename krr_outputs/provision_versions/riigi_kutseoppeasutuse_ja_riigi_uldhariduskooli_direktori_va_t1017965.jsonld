      "estleg:versionValidFrom": {
        "@value": "2013-11-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haridus- ja teadusministri 22. novembri 2010. a määrus nr 68 „Riigi üldhariduskooli direktori vaba ametikoha täitmiseks korraldatava konkursi läbiviimise kord” tunnistatakse kehtetuks. Haridus- ja teadusministri 22. novembri 2010. a määrus nr 68 „Riigi üldhariduskooli direktori vaba ametikoha täitmiseks korraldatava konkursi läbiviimise kord” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1017965_Par_18 (redaktsioon 1017965)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017965",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017965",
      "estleg:sourceAct": "Riigi kutseõppeasutuse ja riigi üldhariduskooli direktori vaba ametikoha täitmiseks korraldatava konkursi läbiviimise kord",
