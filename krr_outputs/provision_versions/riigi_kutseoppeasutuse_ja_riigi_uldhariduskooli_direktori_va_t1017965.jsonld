      "estleg:versionValidFrom": {
        "@value": "2013-11-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjoni töövorm on koosolek. Komisjoni töövorm on koosolek. 2 (2) Komisjoni koosolekut juhatab komisjoni esimees ning protokollib komisjoni sekretär. Protokollile kirjutavad alla komisjoni esimees ja sekretär. Komisjoni koosolekut juhatab komisjoni esimees ning protokollib komisjoni sekretär. Protokollile kirjutavad alla komisjoni esimees ja sekretär. 3 (3) Komisjon võib kasutada kandidaatide hindamisel eksperte. Komisjon võib kasutada kandidaatide hindamisel eksperte. 4 (4) Komisjoni koosolekud võivad toimuda side- ja infotehnoloogiliste vahendite teel. Komisjoni koosolekud võivad toimuda side- ja infotehnoloogiliste vahendite teel.",
      "rdfs:label": {
        "@value": "Reg_1017965_Par_3 (redaktsioon 1017965)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1017965",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1017965",
