    {
      "@id": "estleg:Reg_1017965_Par_13_v1017965",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017965_Par_13"
