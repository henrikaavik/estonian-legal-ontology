      }
    },
    {
      "@id": "estleg:Reg_153056_Par_5_v153056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153056_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenistusjuurdluse kokkuvõttes esitatakse motiveeritud seisukoht taotluse põhjendatuse kohta. Teenistusjuurdluse kokkuvõttes esitatakse motiveeritud seisukoht taotluse põhjendatuse kohta. 2 (2) Teenistusjuurdluse kokkuvõtte kinnitab asutuse juht. RT I 2003 30 186 551503 2003-04-01+03:00 Teenistusjuurdluse kokkuvõtte kinnitab asutuse juht.",
