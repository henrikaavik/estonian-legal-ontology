    {
      "@id": "estleg:Reg_1061171_Par_20_v1061171",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061171_Par_20"
