      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruses kasutatakse termineid järgmises tähenduses: 1 1) sihtturg on riik või geograafiline piirkond, kuhu projekti tegevused suunatakse; 2 2) kasusaaja on toetatavasse tegevusse kaasatud ja seeläbi mitterahalist abi saav äriühing. Määruses kasutatakse termineid järgmises tähenduses: sihtturg on riik või geograafiline piirkond, kuhu projekti tegevused suunatakse; kasusaaja on toetatavasse tegevusse kaasatud ja seeläbi mitterahalist abi saav äriühing.",
      "rdfs:label": {
        "@value": "Reg_1061171_Par_4 (redaktsioon 1061171)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061171",
