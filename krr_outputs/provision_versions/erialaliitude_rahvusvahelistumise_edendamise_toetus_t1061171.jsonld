    {
      "@id": "estleg:Reg_1061171_Par_25_v1061171",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061171_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksuse toimingu või otsuse peale esitatakse enne halduskohtule kaebuse esitamist vaie rakendusüksusele vastavalt ÜSS2021_2027 §-le 31. Rakendusüksuse toimingu või otsuse peale esitatakse enne halduskohtule kaebuse esitamist vaie rakendusüksusele vastavalt ÜSS2021_2027 §-le 31. 2 (2) Vaide lahendab rakendusüksus haldusmenetluse seaduses sätestatud korras. Vaide lahendab rakendusüksus haldusmenetluse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1061171_Par_25 (redaktsioon 1061171)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061171",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061171",
