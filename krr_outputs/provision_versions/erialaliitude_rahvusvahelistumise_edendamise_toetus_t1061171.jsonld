      }
    },
    {
      "@id": "estleg:Reg_1061171_Par_5_v1061171",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061171_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium. Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium. 2 (2) Rakendusüksus on Ettevõtluse ja Innovatsiooni Sihtasutus. Rakendusüksus on Ettevõtluse ja Innovatsiooni Sihtasutus.",
      "rdfs:label": {
        "@value": "Reg_1061171_Par_5 (redaktsioon 1061171)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061171",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061171",
      "estleg:sourceAct": "Erialaliitude rahvusvahelistumise edendamise toetus",
      "estleg:provisionRef": "Reg_1061171 § 5",
      "estleg:partOfAct": {
