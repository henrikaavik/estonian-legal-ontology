  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_riigi_ja_tugietalonide_valiku_kinnitamise_sailitamise_ja_kas_t1046846_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigi- ja tugietalonide valiku, kinnitamise, säilitamise ja kasutamise kord, nende säilitamiseks, arendamiseks, kalibreerimiseks ja rahvusvaheliseks võrdlemiseks tehtavate põhjendatud kulutuste loetelu ning riigi- ja tugietalonide nimistu (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigi- ja tugietalonide valiku, kinnitamise, säilitamise ja kasutamise kord, nende säilitamiseks, arendamiseks, kalibreerimiseks ja rahvusvaheliseks võrdlemiseks tehtavate põhjendatud kulutuste loetelu ning riigi- ja tugietalonide nimistu"
    },
    {
      "@id": "estleg:Reg_1046846_Par_1_v1046846",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046846_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigi- ja tugietaloni nimistusse kinnitamise valiku aluseks on: 1 1) majanduselu vajadus; 2 2) avaliku halduse vajadus; 3 3) teadus- ja uurimistegevuse vajadus; 4 4) rahvusvahelisest lepingust tulenev kohustus. Riigi- ja tugietaloni nimistusse kinnitamise valiku aluseks on: majanduselu vajadus; avaliku halduse vajadus; teadus- ja uurimistegevuse vajadus; rahvusvahelisest lepingust tulenev kohustus. 2 (2) Riigi- ja tugietalon kehastab vastavalt mõõtühiku definitsioonile füüsikalist suurust ja on seostatud asjakohase mõõtühikuga kas kokkuleppeliselt valitud füüsilise esemena, esmase tugiprotseduuri alusel või teiste riikide tõendatud jälgitavusega etalonide kaudu. Riigi- ja tugietalon kehastab vastavalt mõõtühiku definitsioonile füüsikalist suurust ja on seostatud asjakohase mõõtühikuga kas kokkuleppeliselt valitud füüsilise esemena, esmase tugiprotseduuri alusel või teiste riikide tõendatud jälgitavusega etalonide kaudu. 3 (3) Etaloni kinnitamiseks riigi- või tugietaloniks esitab labor Majandus- ja Kommunikatsiooniministeeriumile etaloni vajadus- ja tasuvusanalüüsi ning etaloni omaduste säilitamise ja kasutamise tagamise kohta järgmised andmed: 1 1) teave etaloni koosseisu kuuluvate mõõte- ja abivahendite olemasolu kohta; 2 2) teave etaloni säilitamiseks ja kasutamiseks ruumi ning personali olemasolu kohta; 3 3) etaloni metroloogilisi omadusi tõendavad dokumendid. Etaloni kinnitamiseks riigi- või tugietaloniks esitab labor Majandus- ja Kommunikatsiooniministeeriumile etaloni vajadus- ja tasuvusanalüüsi ning etaloni omaduste säilitamise ja kasutamise tagamise kohta järgmised andmed: teave etaloni koosseisu kuuluvate mõõte- ja abivahendite olemasolu kohta; teave etaloni säilitamiseks ja kasutamiseks ruumi ning personali olemasolu kohta; etaloni metroloogilisi omadusi tõendavad dokumendid. 4 (4) Etaloni vajadusanalüüsist peab selguma lõikes 1 nimetatud valiku aluse seos sihtgrupiga ja tasuvusanalüüsist ajaperiood, millal etaloni kasutamisest saadav tulu katab kaasnevad kulutused. Etaloni vajadusanalüüsist peab selguma lõikes 1 nimetatud valiku aluse seos sihtgrupiga ja tasuvusanalüüsist ajaperiood, millal etaloni kasutamisest saadav tulu katab kaasnevad kulutused. 5 (5) Riigi- ja tugietaloni kinnitab valdkonna eest vastutav minister käskkirjaga. Riigi- ja tugietaloni kinnitab valdkonna eest vastutav minister käskkirjaga. 6 (6) Riigi- ja tugietalonide nimistu moodustub lõike 5 kohaselt kinnitatud riigi- ja tugietalonidest. Riigi- ja tugietalonide nimistu avaldatakse Majandus- ja Kommunikatsiooniministeeriumi veebilehel. Riigi- ja tugietalonide nimistu moodustub lõike 5 kohaselt kinnitatud riigi- ja tugietalonidest. Riigi- ja tugietalonide nimistu avaldatakse Majandus- ja Kommunikatsiooniministeeriumi veebilehel.",
      "rdfs:label": {
        "@value": "Reg_1046846_Par_1 (redaktsioon 1046846)",
        "@language": "et"
      },
