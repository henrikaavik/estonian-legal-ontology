    {
      "@id": "estleg:Reg_1046846_Par_3_v1046846",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046846_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tugietalone säilitatakse mõõteseaduse § 20 nõuetele vastavas laboris. Tugietalone säilitatakse mõõteseaduse § 20 nõuetele vastavas laboris. 2 (2) Tugietaloni labor kasutab tugietaloni § 2 lõikes 2 nimetatud eesmärgil. Tugietaloni labor kasutab tugietaloni § 2 lõikes 2 nimetatud eesmärgil. 3 (3) Tugietalonide säilitamist ja kasutamist kajastavaid dokumente säilitatakse tugietaloni laboris tähtajatult. Tugietalonide säilitamist ja kasutamist kajastavaid dokumente säilitatakse tugietaloni laboris tähtajatult. 4 (4) Tugietaloni labor teavitab esimesel võimalusel Majandus- ja Kommunikatsiooniministeeriumi tugietaloni metroloogiliste omaduste muutusest tasemele, mis on madalam, kui § 1 lõike 5 alusel ministri käskkirjaga kinnitatud tugietalonil. Tugietaloni labor teavitab esimesel võimalusel Majandus- ja Kommunikatsiooniministeeriumi tugietaloni metroloogiliste omaduste muutusest tasemele, mis on madalam, kui § 1 lõike 5 alusel ministri käskkirjaga kinnitatud tugietalonil.",
      "rdfs:label": {
        "@value": "Reg_1046846_Par_3 (redaktsioon 1046846)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046846",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046846",
      "estleg:sourceAct": "Riigi- ja tugietalonide valiku, kinnitamise, säilitamise ja kasutamise kord, nende säilitamiseks, arendamiseks, kalibreerimiseks ja rahvusvaheliseks võrdlemiseks tehtavate põhjendatud kulutuste loetelu ning riigi- ja tugietalonide nimistu",
      "estleg:provisionRef": "Reg_1046846 § 3",
