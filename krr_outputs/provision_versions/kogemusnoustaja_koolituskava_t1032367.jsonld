      },
      "estleg:versionText": "Käesoleva määrusega sätestatakse kogemusnõustaja koolituse täpsustatud maht ja koolituse sisu. Käesoleva määrusega sätestatakse kogemusnõustaja koolituse täpsustatud maht ja koolituse sisu.",
      "rdfs:label": {
        "@value": "Reg_1032367_Par_1 (redaktsioon 1032367)",
        "@language": "et"
      },
