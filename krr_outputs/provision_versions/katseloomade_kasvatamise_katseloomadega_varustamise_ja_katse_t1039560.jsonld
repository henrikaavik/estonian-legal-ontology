    {
      "@id": "estleg:Reg_1039560_Par_12_v1039560",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039560_Par_12"
