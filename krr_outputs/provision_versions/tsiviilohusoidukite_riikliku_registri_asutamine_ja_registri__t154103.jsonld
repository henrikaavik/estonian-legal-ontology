    {
      "@id": "estleg:Reg_154103_Par_8_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 1) registri elektrooniline kanderaamat (edaspidi kanderaamat); 2 2) objekti toimikud (edaspidi toimik); 3 3) infotehnoloogiline andmebaas; 4 4) registri lisa; 5 5) registri arhiiv. registri elektrooniline kanderaamat (edaspidi kanderaamat); objekti toimikud (edaspidi toimik); infotehnoloogiline andmebaas; registri lisa; registri arhiiv.",
      "rdfs:label": {
