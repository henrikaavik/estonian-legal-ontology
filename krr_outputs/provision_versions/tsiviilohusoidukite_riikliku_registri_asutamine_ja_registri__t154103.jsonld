      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154103_Par_14_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluse esitajalt nõutavad andmed kantakse registrisse käesoleva põhimääruse paragrahvis 10 loetletud dokumentide alusel. Taotluse esitajalt nõutavad andmed kantakse registrisse käesoleva põhimääruse paragrahvis 10 loetletud dokumentide alusel.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_14 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154103_Par_15_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutav töötleja registreerib käesoleva põhimääruse paragrahvis 9 loetletud andmed kanderaamatus. RT I 2023-07-05 2 105072023002 2023-07-08 Vastutav töötleja registreerib käesoleva põhimääruse paragrahvis 9 loetletud andmed kanderaamatus.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_15 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154103_Par_16_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast õhusõiduki kandmist registrisse väljastab Transpordiamet õhusõiduki omanikule või tema poolt kirjalikult volitatud isikule registreerimissertifikaadi ning registri lisasse kandmise korral ajutise registreerimissertifikaadi. RT I 2023-07-05 2 105072023002 2023-07-08 Pärast õhusõiduki kandmist registrisse väljastab Transpordiamet õhusõiduki omanikule või tema poolt kirjalikult volitatud isikule registreerimissertifikaadi ning registri lisasse kandmise korral ajutise registreerimissertifikaadi.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_16 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154103_Par_17_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui andmete esitaja on avastanud ebaõiged andmed, on ta kohustatud esitama registri vastutavale töötlejale viivitamata õiged andmed, lisades neid tõendava dokumendi kinnitatud koopia. Registri vastutav töötleja registreerib saadud teate ning teeb viivitamata paranduse registris. RT I 2023-07-05 2 105072023002 2023-07-08 Kui andmete esitaja on avastanud ebaõiged andmed, on ta kohustatud esitama registri vastutavale töötlejale viivitamata õiged andmed, lisades neid tõendava dokumendi kinnitatud koopia. Registri vastutav töötleja registreerib saadud teate ning teeb viivitamata paranduse registris.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_17 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154103_Par_18_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduki omanik või käitaja on kohustatud registri vastutavale töötlejale viivitamata teatama registrisse kantud andmete muutumisest. RT I 2023-07-05 2 105072023002 2023-07-08 Õhusõiduki omanik või käitaja on kohustatud registri vastutavale töötlejale viivitamata teatama registrisse kantud andmete muutumisest.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_18 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154103_Par_19_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduki omaniku vahetumise korral peavad nii uus kui endine omanik teatama sellest Transpordiametile kümne päeva jooksul. Teatele peavad olema lisatud uue omaniku omandiõigust tõendavad dokumendid koos riigilõivu tasumist tõendava dokumendiga. RT I 2023-07-05 2 105072023002 2023-07-08 Õhusõiduki omaniku vahetumise korral peavad nii uus kui endine omanik teatama sellest Transpordiametile kümne päeva jooksul. Teatele peavad olema lisatud uue omaniku omandiõigust tõendavad dokumendid koos riigilõivu tasumist tõendava dokumendiga.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_19 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
      "estleg:sourceAct": "Tsiviilõhusõidukite riikliku registri asutamine ja registri pidamise põhimäärus",
      "estleg:provisionRef": "Reg_154103 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154103_Map_2026"
      }
    },
