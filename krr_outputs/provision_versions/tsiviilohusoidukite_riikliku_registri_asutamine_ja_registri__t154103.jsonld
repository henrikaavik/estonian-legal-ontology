      }
    },
    {
      "@id": "estleg:Reg_154103_Par_9_v154103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154103_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduki kohta märgitakse kanderaamatusse järgmised andmed: 1 1) õhusõiduki registreerimisnumber; 2 2) õhusõiduki riiklik registreerimistunnus; 3 3) registreerimise kuupäev; 4 4) õhusõiduki omaniku või tema poolt kirjalikult volitatud isiku andmed; 5 5) andmed õhusõiduki käitaja kohta; 6 6) andmed muudatuste kohta. Õhusõiduki kohta märgitakse kanderaamatusse järgmised andmed: õhusõiduki registreerimisnumber; õhusõiduki riiklik registreerimistunnus; registreerimise kuupäev; õhusõiduki omaniku või tema poolt kirjalikult volitatud isiku andmed; andmed õhusõiduki käitaja kohta; andmed muudatuste kohta.",
      "rdfs:label": {
        "@value": "Reg_154103_Par_9 (redaktsioon 154103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154103",
