    },
    {
      "@id": "estleg:RTerS_Par_21_v22335",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTerS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tervisekaitse riikliku järelevalve asutuste tegevust finantseeritakse riigieelarvest. (2) Tervisekaitse, haiguste ennetamise ja tervise edendamisega seotud riiklikke programme finantseeritakse riigieelarvest. (3) Tervisekaitse, haiguste ennetamise ja tervise edendamisega seotud kohalikke programme võib osaliselt või täielikult finantseerida riigieelarvest. (4) Tervisekaitse, haiguste ennetamise ja tervise edendamisega seotud programme võib osaliselt või täielikult finantseerida ravikindlustuse eelarvest. (5) Riiklikud tervisekaitse asutused osutavad tasulisi tervisekaitsealaseid teenuseid Sotsiaalministeeriumi kehtestatud korra ja hinnakirja kohaselt. (6) Avalik- ja eraõiguslikud juriidilised isikud ning füüsilised isikud kannavad käesoleva seadusega neile pandud ülesannete ja kohustuste täitmise kulud.",
      "rdfs:label": {
        "@value": "RTerS_Par_21 (redaktsioon 22335)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22335",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTerS_Par_21_v899010"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
