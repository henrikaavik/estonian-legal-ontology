      }
    },
    {
      "@id": "estleg:RTerS_Par_15_v13342016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTerS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku järelevalvet asjakohastes Euroopa Liidu õigusaktides, käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle, samuti kosmeetikatoodete käitlemise, teabe esitamise ja terviseohutuse üle ning toote nõuetele vastavuse seaduse § 6 lõikes 3 ja tarbijakaitseseaduse § 91 lõikes 1 nimetatud juhtudel terviseohutuse üle teostab Terviseamet käesolevas seaduses sätestatud pädevuse piires.",
      "rdfs:label": {
        "@value": "RTerS_Par_15 (redaktsioon 13342016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13342016",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTerS_Par_15_v120112013002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-11-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RTerS_Par_15_v120112013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTerS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet asjakohastes Euroopa Liidu õigusaktides, käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle ning toote nõuetele vastavuse seaduse § 6 lõikes 3 ja tarbijakaitseseaduse § 91 lõikes 1 nimetatud juhtudel terviseohutuse üle teeb Terviseamet käesolevas seaduses sätestatud pädevuse piires. (2) Riiklikku järelevalvet käesolevas seaduses kosmeetikatoodete kättesaadavaks tegemisele kehtestatud nõuete ja kosmeetikamääruse artiklis 25 loetletud nõuete täitmise üle artikli 22 kohaselt teevad Terviseamet ja Tarbijakaitseamet oma pädevuse piires.",
      "rdfs:label": {
        "@value": "RTerS_Par_15 (redaktsioon 120112013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120112013002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RTerS_Par_15_v115032014043"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RTerS_Par_15_v115032014043",
