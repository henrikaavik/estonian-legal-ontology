    {
      "@id": "estleg:Reg_300909_Par_6_v300909",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300909_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-02-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Auditi, välja arvatud lisaauditi, läbiviimise eelduseks on reederi poolt kaldastruktuurides ning laevades eelnevalt siseauditi läbiviimine vähemalt kord 12 kuu jooksul. RT I 2011-09-21 2 121092011002 2011-09-24 Auditi, välja arvatud lisaauditi, läbiviimise eelduseks on reederi poolt kaldastruktuurides ning laevades eelnevalt siseauditi läbiviimine vähemalt kord 12 kuu jooksul.",
      "rdfs:label": {
        "@value": "Reg_300909_Par_6 (redaktsioon 300909)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300909",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300909",
      "estleg:sourceAct": "Reederi ja tema laeva meresõiduohutusalane auditeerimise kord ja auditeerimise tunnistuste vormid",
      "estleg:provisionRef": "Reg_300909 § 6",
