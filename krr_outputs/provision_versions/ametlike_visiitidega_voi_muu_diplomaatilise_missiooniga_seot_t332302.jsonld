    {
      "@id": "estleg:Reg_332302_Par_4_v332302",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_332302_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuloa taotlemisel kasutatakse käesoleva määruse lisaga kinnitatud vormi. Lennuloa taotlemisel kasutatakse käesoleva määruse lisaga kinnitatud vormi.",
      "rdfs:label": {
        "@value": "Reg_332302_Par_4 (redaktsioon 332302)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "332302",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/332302",
      "estleg:sourceAct": "Ametlike visiitidega või muu diplomaatilise missiooniga seotud välisriigi õhusõidukile lennuloa andmise kord",
      "estleg:provisionRef": "Reg_332302 § 4",
      "estleg:partOfAct": {
