        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse ning maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse ning maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_312291_Par_13 (redaktsioon 312291)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312291",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312291",
      "estleg:sourceAct": "Mõdriku-Roela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312291 § 13",
