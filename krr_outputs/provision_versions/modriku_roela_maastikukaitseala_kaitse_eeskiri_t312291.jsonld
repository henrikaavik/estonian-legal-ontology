      }
    },
    {
      "@id": "estleg:Reg_312291_Par_5_v312291",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312291_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekuta on keelatud: 1 1) muuta katastriüksuse kõlvikute piire ja sihtotstarvet; 2 2) koostada maakorralduskava ja teostada maakorraldustoiminguid; 3 3) väljastada metsamajandamiskava; 4 4) kehtestada detailplaneeringut ja üldplaneeringut; 5 5) anda nõusolekut väikeehitise, sealhulgas lautri või paadisilla ehitamiseks; 6 6) anda projekteerimistingimusi; 7 7) anda ehitusluba; 8 8) rajada uut veekogu, mille pindala on suurem kui viis ruutmeetrit, kui selleks ei ole vaja anda vee-erikasutusluba või ehitusluba või nõusolekut väikeehitise ehitamiseks. Kaitseala valitseja nõusolekuta on keelatud: muuta katastriüksuse kõlvikute piire ja sihtotstarvet; koostada maakorralduskava ja teostada maakorraldustoiminguid; väljastada metsamajandamiskava; kehtestada detailplaneeringut ja üldplaneeringut; anda nõusolekut väikeehitise, sealhulgas lautri või paadisilla ehitamiseks; anda projekteerimistingimusi; anda ehitusluba; rajada uut veekogu, mille pindala on suurem kui viis ruutmeetrit, kui selleks ei ole vaja anda vee-erikasutusluba või ehitusluba või nõusolekut väikeehitise ehitamiseks.",
      "rdfs:label": {
        "@value": "Reg_312291_Par_5 (redaktsioon 312291)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312291",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312291",
      "estleg:sourceAct": "Mõdriku-Roela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312291 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312291_Map"
      }
    },
    {
      "@id": "estleg:Reg_312291_Par_6_v312291",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312291_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitsealal on vajalik: 1 1) sinilillekuusikutes ja -männikutes loodusliku metsakoosluse taastamiseks häilude rajamine ja maapinna mineraliseerimine, vältides erosiooniohtu nõlvadel; 2 2) poollooduslike koosluste esinemisaladel on vajalik nende ilme ja liigikoosseisu säilimise tagamiseks loomade karjatamine, rohu niitmine ning puu- ja põõsarinde harvendamine. Kaitsealal on vajalik: sinilillekuusikutes ja -männikutes loodusliku metsakoosluse taastamiseks häilude rajamine ja maapinna mineraliseerimine, vältides erosiooniohtu nõlvadel; poollooduslike koosluste esinemisaladel on vajalik nende ilme ja liigikoosseisu säilimise tagamiseks loomade karjatamine, rohu niitmine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_312291_Par_6 (redaktsioon 312291)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312291",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312291",
      "estleg:sourceAct": "Mõdriku-Roela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312291 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312291_Map"
      }
    },
    {
      "@id": "estleg:Reg_312291_Par_7_v312291",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312291_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala valitseja ei kooskõlasta tegevust, mis vajab kaitse-eeskirja kohaselt kaitseala valitseja nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või seisundit. Kaitseala valitseja ei kooskõlasta tegevust, mis vajab kaitse-eeskirja kohaselt kaitseala valitseja nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või seisundit. 2 (2) Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuses ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmisel tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt «Haldusmenetluse seadusele» õiguspärast ootust sellise tegevuse õiguspärasuse osas. Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuses ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmisel tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt «Haldusmenetluse seadusele» õiguspärast ootust sellise tegevuse õiguspärasuse osas. 3 (3) Kehtetu - RT I 2023-07-05 1 105072023001 2023-07-08 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_312291_Par_7 (redaktsioon 312291)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312291",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312291",
      "estleg:sourceAct": "Mõdriku-Roela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312291 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312291_Map"
      }
    },
    {
      "@id": "estleg:Reg_312291_Par_8_v312291",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312291_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. 2 (2) Kaitsealal on viis sihtkaitsevööndit: 1 1) Kantküla sihtkaitsevöönd; 2 2) Roela sihtkaitsevöönd; 3 3) Sooaluse sihtkaitsevöönd; 4 4) Udujärve-Mustjärve sihtkaitsevöönd; 5 5) Vabatküla sihtkaitsevöönd. Kaitsealal on viis sihtkaitsevööndit: Kantküla sihtkaitsevöönd; Roela sihtkaitsevöönd; Sooaluse sihtkaitsevöönd; Udujärve-Mustjärve sihtkaitsevöönd; Vabatküla sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_312291_Par_8 (redaktsioon 312291)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312291",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312291",
      "estleg:sourceAct": "Mõdriku-Roela maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312291 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312291_Map"
      }
