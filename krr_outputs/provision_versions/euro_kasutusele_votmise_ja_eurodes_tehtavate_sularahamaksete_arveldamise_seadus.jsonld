        "@type": "xsd:date"
      },
      "estleg:versionText": "Euro kasutusele võtmise seadus reguleerib Eesti Vabariigi rahaseaduse alusel emiteeritud Eesti krooni (edaspidi käesolevas peatükis kroon) eurodeks vahetamist, krooni käibelt kõrvaldamist, krooni ja euro paralleelkäivet ning eurodes tehtavate sularahamaksete arveldamist.",
      "rdfs:label": {
        "@value": "EKVS_Par_1 (redaktsioon 130052024016)",
        "@language": "et"
      },
