    {
      "@id": "estleg:EKVS_Par_2_v130052024016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKVS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Pank ja Eestis tegutsevad krediidiasutused on kohustatud euro münte ja pangatähti vastu võtma piiranguteta. (2) Käesoleva paragrahvi lõikes 1 nimetamata isikud on kohustatud vastu võtma korraga kuni 50 kehtivat euro münti sõltumata nende väärtusest, pangatähti aga piiranguteta, kui ei ole muu makseviisi kasutamise kokkulepet. (3) Vastutus käesolevas paragrahvis ja käesoleva seaduse § 3 lõikes 2 sätestatud kohustuse rikkumise eest sätestatakse tarbijakaitseseaduses.",
      "rdfs:label": {
        "@value": "EKVS_Par_2 (redaktsioon 130052024016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130052024016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130052024016",
      "estleg:sourceAct": "Euro kasutusele võtmise ja eurodes tehtavate sularahamaksete arveldamise seadus",
      "estleg:provisionRef": "EKVS § 2",
      "estleg:partOfAct": {
        "@id": "estleg:EKVS_Map_2026"
      }
    },
    {
      "@id": "estleg:EKVS_Par_230_v130052024016",
