      }
    },
    {
      "@id": "estleg:Reg_1024829_Par_2_v1024829",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024829_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isiku kinnipidamise protokollis dokumenteeritakse vähemalt järgmised andmed: 1 1) asutuse nimetus ja isiku kinni pidanud ametniku ametinimetus, ees- ja perekonnanimi ning allkiri; 2 2) kinnipeetud isiku ees- ja perekonnanimi, isikukood, selle puudumisel sünniaeg ja -koht; 3 3) kinnipidamise õiguslik ja faktiline alus ja kaalutlused; 4 4) kinnipidamise kuupäev, kellaaeg ja koht; 5 5) kinnipeetud isikule tema õiguste selgitamine; 6 6) teave selle kohta, kas alaealise või piiratud teovõimega isiku seaduslik esindaja on teadlik alaealise või piiratud teovõimega isiku kinnipidamisest, ja selgitus, millal ja kuidas teda teavitati. Juhul, kui teavitamine ei olnud võimalik, siis põhjus, miks seaduslikku esindajat ei teavitatud; 7 7) kinnipeetud isikult turvakontrolli käigus hoiulevõetud esemete loetelu, hoiulevõtmise põhjus ja koht, kus hoiulevõetud esemed asuvad; 8 8) kinnipeetud isiku avaldused ja taotlused; 9 9) protokolli koostanud ametniku allkiri; 10 10) isiku vabastamise kuupäev ja kellaaeg; 11 11) isiku vabastanud ametniku ametinimetus, ees- ja perekonnanimi ning allkiri; 12 12) märge selle kohta, kas isik tuvastati dokumendi alusel, sealhulgas märgitakse isikut tõendava dokumendi nimetus, number, selle väljaandnud asutuse nimetus ja väljaandmise aeg, või isiku enda või tunnistajate ütluste põhjal või muul viisil; 13 13) vahetu sunni kohaldamine, vahetu sunni vahend, selle kasutamise põhjus ja kestus ning selle ametniku andmed, kes vahetut sundi kohaldas. Isiku kinnipidamise protokollis dokumenteeritakse vähemalt järgmised andmed: asutuse nimetus ja isiku kinni pidanud ametniku ametinimetus, ees- ja perekonnanimi ning allkiri; kinnipeetud isiku ees- ja perekonnanimi, isikukood, selle puudumisel sünniaeg ja -koht; kinnipidamise õiguslik ja faktiline alus ja kaalutlused; kinnipidamise kuupäev, kellaaeg ja koht; kinnipeetud isikule tema õiguste selgitamine; teave selle kohta, kas alaealise või piiratud teovõimega isiku seaduslik esindaja on teadlik alaealise või piiratud teovõimega isiku kinnipidamisest, ja selgitus, millal ja kuidas teda teavitati. Juhul, kui teavitamine ei olnud võimalik, siis põhjus, miks seaduslikku esindajat ei teavitatud; kinnipeetud isikult turvakontrolli käigus hoiulevõetud esemete loetelu, hoiulevõtmise põhjus ja koht, kus hoiulevõetud esemed asuvad; kinnipeetud isiku avaldused ja taotlused; protokolli koostanud ametniku allkiri; isiku vabastamise kuupäev ja kellaaeg; isiku vabastanud ametniku ametinimetus, ees- ja perekonnanimi ning allkiri; märge selle kohta, kas isik tuvastati dokumendi alusel, sealhulgas märgitakse isikut tõendava dokumendi nimetus, number, selle väljaandnud asutuse nimetus ja väljaandmise aeg, või isiku enda või tunnistajate ütluste põhjal või muul viisil; vahetu sunni kohaldamine, vahetu sunni vahend, selle kasutamise põhjus ja kestus ning selle ametniku andmed, kes vahetut sundi kohaldas.",
      "rdfs:label": {
        "@value": "Reg_1024829_Par_2 (redaktsioon 1024829)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024829",
