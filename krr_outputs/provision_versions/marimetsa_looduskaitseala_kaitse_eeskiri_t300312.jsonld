      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvöödis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu säilimise tagamiseks vajalik loomade karjatamine, niitmine ning puu- ja põõsarinde harvendamine. Piiranguvöödis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu säilimise tagamiseks vajalik loomade karjatamine, niitmine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_300312_Par_15 (redaktsioon 300312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300312",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300312",
      "estleg:sourceAct": "Marimetsa looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_300312 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300312_Map_2026"
      }
    },
