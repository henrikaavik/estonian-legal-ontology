      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060791_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse toetuse saajale välja ettemaksena toetuse rahuldamise otsuses sätestatud tingimustel viie tööpäeva jooksul. Toetus makstakse toetuse saajale välja ettemaksena toetuse rahuldamise otsuses sätestatud tingimustel viie tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "Reg_1060791_Par_18 (redaktsioon 1060791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060791",
      "estleg:sourceAct": "Korteriühistule kriisivalmiduse suurendamiseks toetuse andmise ning selle kasutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1060791 § 18",
