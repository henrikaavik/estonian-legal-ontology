        "@language": "et"
      },
      "dc:source": "Keskvalitsuse juriidilise isiku finantsplaanile esitatavad nõuded, finantsplaani esitamise kord ning põhitegevuse tulude, põhitegevuse kulude, võlakohustuste ja likviidsete varade arvestusmetoodika"
    },
    {
      "@id": "estleg:Reg_1053842_Par_1_v1053842",
