    {
      "@id": "estleg:Reg_1002217_Par_1_v1002217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002217_Par_1"
