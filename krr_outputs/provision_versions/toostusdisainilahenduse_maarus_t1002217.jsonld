        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1002217_Par_5 (redaktsioon 1002217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002217",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002217",
      "estleg:sourceAct": "Tööstusdisainilahenduse määrus",
      "estleg:provisionRef": "Reg_1002217 § 5",
