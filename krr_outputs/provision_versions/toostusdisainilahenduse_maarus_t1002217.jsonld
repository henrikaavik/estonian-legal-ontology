      }
    },
    {
      "@id": "estleg:Reg_1002217_Par_50_v1002217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002217_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) „Eesti Tööstusdisainilahenduse Leht” (edaspidi leht) on Patendiameti ametlik perioodiline väljaanne, mida antakse välja „Tööstusdisaini kaitse seaduse” § 55 lõikes 2, § 551 lõikes 7, § 73 lõikes 7, § 761 lõikes 3 ja § 874 lõikes 3 sätestatu kohaselt avalikkuse teavitamiseks tööstusdisainilahenduse registreeringu andmetest, muudest registrikannetest ja tööstusdisainilahenduse rahvusvahelistest registreeringutest. RT I 2019-04-12 1 112042019001 2019-04-15 „Eesti Tööstusdisainilahenduse Leht” (edaspidi leht) on Patendiameti ametlik perioodiline väljaanne, mida antakse välja „Tööstusdisaini kaitse seaduse” § 55 lõikes 2, § 551 lõikes 7, § 73 lõikes 7, § 761 lõikes 3 ja § 874 lõikes 3 sätestatu kohaselt avalikkuse teavitamiseks tööstusdisainilahenduse registreeringu andmetest, muudest registrikannetest ja tööstusdisainilahenduse rahvusvahelistest registreeringutest. 2 (2) Lehes avaldatakse ka Patendiameti ametlikke teateid, tööstusdisainilahenduste õiguskaitset puudutavaid õigusakte, rahvusvaheliste kokkulepete mitteametlikke tõlkeid ja muud üldistes huvides vajalikku teavet. Lehes avaldatakse ka Patendiameti ametlikke teateid, tööstusdisainilahenduste õiguskaitset puudutavaid õigusakte, rahvusvaheliste kokkulepete mitteametlikke tõlkeid ja muud üldistes huvides vajalikku teavet.",
      "rdfs:label": {
        "@value": "Reg_1002217_Par_50 (redaktsioon 1002217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002217",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002217",
      "estleg:sourceAct": "Tööstusdisainilahenduse määrus",
      "estleg:provisionRef": "Reg_1002217 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002217_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1002217_Par_51_v1002217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002217_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lehes kasutatakse bibliograafiliste andmete tähistamiseks koode vastavalt WIPO standardile ST. 80 „Soovitused tööstusdisainilahendusi puudutavate bibliograafiliste andmete kohta (identifitseerimine ja miinimumnõuded) (edaspidi INID-koodid)”. Lehes kasutatakse bibliograafiliste andmete tähistamiseks koode vastavalt WIPO standardile ST. 80 „Soovitused tööstusdisainilahendusi puudutavate bibliograafiliste andmete kohta (identifitseerimine ja miinimumnõuded) (edaspidi INID-koodid)”.",
      "rdfs:label": {
        "@value": "Reg_1002217_Par_51 (redaktsioon 1002217)",
        "@language": "et"
