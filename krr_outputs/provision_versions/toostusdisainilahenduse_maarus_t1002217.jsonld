        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui registreerimiseks esitatakse tööstusdisainilahenduse variandid, tuleb avaldusele märkida, mitu tööstusdisainilahenduse varianti registreerimistaotluses sisaldub. Kui registreerimiseks esitatakse tööstusdisainilahenduse variandid, tuleb avaldusele märkida, mitu tööstusdisainilahenduse varianti registreerimistaotluses sisaldub.",
      "rdfs:label": {
        "@value": "Reg_1002217_Par_16 (redaktsioon 1002217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002217",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002217",
      "estleg:sourceAct": "Tööstusdisainilahenduse määrus",
      "estleg:provisionRef": "Reg_1002217 § 16",
