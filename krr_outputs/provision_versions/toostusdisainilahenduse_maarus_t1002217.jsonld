    {
      "@id": "estleg:Reg_1002217_Par_26_v1002217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002217_Par_26"
