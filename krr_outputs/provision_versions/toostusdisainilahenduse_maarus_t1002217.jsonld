      "estleg:provisionRef": "Reg_1002217 § 56",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002217_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1002217_Par_57_v1002217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
