      "@id": "estleg:Reg_1038496_Par_16_v1038496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038496_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas määruses käsitletavad allmaakaevandamise viisid on järgmised: 1 1) kamberkaevandamine lae hoidmisega, mille oluliseks tunnuseks on maapinna vajumise puudumine, kusjuures maapõue häiritusest või ettenägematutest asjaoludest tingitud vajumid ilmnevad vaid erandjuhtudel; 2 2) kaevandamine lae langetamisega, mille juures vajumite sügavus, kuju ja nõlvanurk sõltuvad maavara looduslikust seisundist eemaldamise tehnoloogiast ja kaevandamiskoha mäendustingimustest. Käesolevas määruses käsitletavad allmaakaevandamise viisid on järgmised: kamberkaevandamine lae hoidmisega, mille oluliseks tunnuseks on maapinna vajumise puudumine, kusjuures maapõue häiritusest või ettenägematutest asjaoludest tingitud vajumid ilmnevad vaid erandjuhtudel; kaevandamine lae langetamisega, mille juures vajumite sügavus, kuju ja nõlvanurk sõltuvad maavara looduslikust seisundist eemaldamise tehnoloogiast ja kaevandamiskoha mäendustingimustest.",
      "rdfs:label": {
        "@value": "Reg_1038496_Par_16 (redaktsioon 1038496)",
        "@language": "et"
      },
