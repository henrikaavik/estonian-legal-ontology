      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Uuritud ning kaevandatud maa korrastamise täpsustatud nõuded ja kord, kaevandatud maa korrastamise projekti sisu kohta esitatavad nõuded ning maa korrastamise akti sisu ja vorm (24 versiooni)",
        "@language": "et"
      },
      "dc:source": "Uuritud ning kaevandatud maa korrastamise täpsustatud nõuded ja kord, kaevandatud maa korrastamise projekti sisu kohta esitatavad nõuded ning maa korrastamise akti sisu ja vorm"
    },
    {
      "@id": "estleg:Reg_1038496_Par_1_v1038496",
      "@type": [
