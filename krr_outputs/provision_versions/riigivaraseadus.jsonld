        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_58_v13236837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lähtudes riigivara kasutamiseks andmise või müügi otsusest ning kasutamiseks andmise või müügi korraldaja (edaspidi käesolevas peatükis korraldaja ) määratud avaliku enampakkumise või valikpakkumise tingimustest, avaldatakse väljaandes Ametlikud Teadaanded avaliku enampakkumise või valikpakkumise kohta teade vähemalt kaks nädalat enne kirjaliku enampakkumise või valikpakkumise esitamise tähtpäeva ja muudel juhtudel enne enampakkumise toimumist. (2) Teates esitatakse olulised andmed võõrandatava või kasutamiseks antava vara kohta, sealhulgas andmed lepingu projekti ja enampakkumise tingimuste kättesaadavuse kohta. (3) Tähtaeg, mille jooksul saab teha avalikku enampakkumist või valikpakkumist, ning koht, kuhu nimetatud avalik enampakkumine või valikpakkumine esitatakse, peavad tagama riigile parima pakkumistulemuse. (4) Avaliku enampakkumise või valikpakkumise teateid ja kuulutusi võib levitada lisaks ka muul viisil. Käesoleva seaduse § 66 lõigetes 6 ja 7 nimetatud juhul avaldatakse avaliku enampakkumise teade vähemalt ühes üleriigilise levikuga ajalehes ning õigustatud isikule edastatakse teade lihtkirjalikult tema kohta rahvastiku- või äriregistrisse kantud elukoha või asukoha aadressil.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_58 (redaktsioon 13236837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236837",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIV_Par_58_v13334930"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236837",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 58",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_58_v13334930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lähtudes riigivara kasutamiseks andmise või müügi otsusest ning kasutamiseks andmise või müügi korraldaja (edaspidi käesolevas peatükis korraldaja) määratud avaliku enampakkumise või valikpakkumise tingimustest, avaldatakse väljaandes Ametlikud Teadaanded avaliku enampakkumise või valikpakkumise kohta teade vähemalt kaks nädalat enne kirjaliku enampakkumise või valikpakkumise esitamise tähtpäeva ja muudel juhtudel enne enampakkumise toimumist. (2) Teates esitatakse olulised andmed võõrandatava või kasutamiseks antava vara kohta, sealhulgas andmed lepingu projekti ja enampakkumise tingimuste kättesaadavuse kohta. (3) Tähtaeg, mille jooksul saab teha avalikku enampakkumist või valikpakkumist, ning koht, kuhu nimetatud avalik enampakkumine või valikpakkumine esitatakse, peavad tagama riigile parima pakkumistulemuse. (4) Avaliku enampakkumise või valikpakkumise teateid ja kuulutusi võib levitada lisaks ka muul viisil. Käesoleva seaduse § 66 lõigetes 6 ja 7 nimetatud juhul avaldatakse avaliku enampakkumise teade vähemalt ühes üleriigilise levikuga ajalehes ning õigustatud isikule edastatakse teade lihtkirjalikult tema kohta rahvastiku- või äriregistrisse kantud elukoha või asukoha aadressil.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_58 (redaktsioon 13334930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13334930",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 58",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_59_v13236837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast avaliku enampakkumise või valikpakkumise teate avaldamist võivad kõik asjast huvitatud isikud tutvuda korraldaja eelnevalt määratud ajal ja kohas kasutamiseks antava või võõrandatava riigivaraga ning pakkumise ja lepingu oluliste tingimustega.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_59 (redaktsioon 13236837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236837",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236837",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 59",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_6_v22319",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigitulundusasutus on riigiasutus, mis võib oma põhimääruses sätestatud piires osutada tasulisi teenuseid ja saada selle eest tulu. Riigitulundusasutuste valduses oleva riigivara valitsemise kord sätestatakse eraldi seadusega. (2) Riigi poolt äriühingute ja teiste eraõiguslike juriidiliste isikute asutamine ja nendes osalemine ning riigivara üleandmine eraõiguslikule juriidilisele isikule sätestatakse riigi poolt eraõiguslike juriidiliste isikute asutamise ja nendes osalemise seadusega.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_6 (redaktsioon 22319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22319",
      "estleg:supersededByVersion": {
