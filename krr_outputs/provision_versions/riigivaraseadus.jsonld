      "estleg:provisionRef": "RIIGIV § 68",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_68_v117032023066",
      "@type": [
