    {
      "@id": "estleg:RIIGIV_Par_17_v13236837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigivara antakse kasutamiseks järgmisel viisil: avalikul enampakkumisel; valikpakkumisel; ilma avaliku enampakkumiseta või valikpakkumiseta, sealhulgas tasuta või harilikust väärtusest madalama tasu eest (edaspidi otsustuskorras ). (2) Põhiseaduslik institutsioon võib kinnisasja anda kasutamiseks üksnes avalikul enampakkumisel või valikpakkumisel.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_17 (redaktsioon 13236837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236837",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIV_Par_17_v13334930"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236837",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 17",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_17_v13334930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_17"
      },
      "estleg:versionValidFrom": {
