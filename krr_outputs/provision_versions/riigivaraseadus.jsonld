      }
    },
    {
      "@id": "estleg:RIIGIV_Par_17_v128062016011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigivara antakse kasutamiseks järgmisel viisil: avalikul enampakkumisel; valikpakkumisel; otsustuskorras avalikku enampakkumist või valikpakkumist korraldamata (edaspidi otsustuskorras). (2) Põhiseaduslik institutsioon võib kinnisasja anda kasutamiseks üksnes avalikul enampakkumisel või valikpakkumisel.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_17 (redaktsioon 128062016011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016011",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 17",
      "estleg:partOfAct": {
