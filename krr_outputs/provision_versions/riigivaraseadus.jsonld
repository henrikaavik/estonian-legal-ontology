      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIV_Par_74_3 (redaktsioon 117032023066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023066",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032023066",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 74_3",
      "estleg:partOfAct": {
