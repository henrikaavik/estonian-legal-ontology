      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22319",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 1",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_1_v13236837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib riigivara valitsemist. (2) Riigivara valitsemine on menetlus vara Eesti Vabariigile (edaspidi riik ) omandamisel, riigivara valdamisel, kasutamisel ja käsutamisel ning riigi osalemisel aktsionäri, osaniku, asutaja või liikmena Eestis registrisse kantud aktsiaseltsis, osaühingus, sihtasutuses, mittetulundusühingus, hooneühistus, korteriomanike ühisuses, kaaspärijate ühisuses ja käesolevas seaduses sätestatud juhtudel välismaises eraõiguslikus juriidilises isikus. (3) Riigivara on riigile kuuluvate rahaliselt hinnatavate õiguste ja kohustuste kogum.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_1 (redaktsioon 13236837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236837",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIV_Par_1_v13334930"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236837",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 1",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_1_v13334930",
      "@type": [
        "owl:NamedIndividual",
