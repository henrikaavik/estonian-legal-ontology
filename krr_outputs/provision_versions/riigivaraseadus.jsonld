      "estleg:provisionRef": "RIIGIV § 9",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_9_v925481",
      "@type": [
        "owl:NamedIndividual",
