        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/256045",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 36",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_36_v13236837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivara võib omandada igaüks, kui seadus ei sätesta vara omandamisel kitsendusi.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_36 (redaktsioon 13236837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236837",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236837",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 36",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_37_v22319",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisel loetakse riigivara valitseja valitsemisel või volitatud asutuse valduses olevaks varaks see osa Eesti riigi varast, mida vastav riigivara valitseja või volitatud asutus käesoleva seaduse jõustumise ajal tegelikult valdas. (2) Eesti Pank valdab, kasutab ja käsutab avalik-õigusliku juriidilise isikuna tema valduses olevat riigivara Eesti Panga seaduse (RT I 1993, 28, 498; 1994, 30, 463) ja kinnisvara osas käesoleva seaduse alusel.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_37 (redaktsioon 22319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22319",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIV_Par_37_v13178406"
      },
      "estleg:versionValidTo": {
        "@value": "2009-05-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22319",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 37",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_37_v13178406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-05-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse jõustumisel loetakse riigivara valitseja valitsemisel või volitatud asutuse valduses olevaks varaks see osa Eesti riigi varast, mida vastav riigivara valitseja või volitatud asutus käesoleva seaduse jõustumise ajal tegelikult valdas. (2) Eesti Pank valdab, kasutab ja käsutab avalik-õigusliku juriidilise isikuna tema valduses olevat riigivara Eesti Panga seaduse ja kinnisvara osas käesoleva seaduse alusel.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_37 (redaktsioon 13178406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13178406",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIV_Par_37_v13236837"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13178406",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 37",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_37_v13236837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigivara võõrandamise otsustab riigivara valitseja. (2) Üksnes Vabariigi Valitsuse nõusolekul võib minister või riigisekretär otsustada kinnisasja või piiratud asjaõiguse võõrandamise järgmistel juhtudel: otsustuskorras või valikpakkumisel; üleandmise teel mitterahalise sissemaksena eraõiguslikule juriidilisele isikule; kui Rahandusministeerium käesoleva seaduse §-s 101 sätestatud korras ei anna kooskõlastust või peab tehingu olulisuse tõttu vajalikuks pöörduda Vabariigi Valitsuse poole. (3) Üksnes Vabariigi Valitsuse nõusolekul võib minister või riigisekretär otsustada vallasasja võõrandamise järgmistel juhtudel: väärtpaberi võõrandamine; otsustuskorras nõuete võõrandamine summas 10 000 eurot või rohkem; üleandmise teel mitterahalise sissemaksena eraõiguslikule juriidilisele isikule; kui Rahandusministeerium käesoleva seaduse §-s 101 sätestatud korras ei anna kooskõlastust või peab tehingu olulisuse tõttu vajalikuks pöörduda Vabariigi Valitsuse poole. (4) Vabariigi Valitsuse nõusolekut ei pea taotlema, kui: võõrandatav riigi osalus äriühingus on väiksem kui 10 protsenti äriühingu aktsia- või osakapitalist ja selle osaluse suurus nimiväärtuses on väiksem kui 1 000 000 eurot; riigivara antakse üle mitterahalise sissemaksena riigi äriühingule kalendriaasta jooksul kokku harilikus väärtuses, mis ei ületa 10 protsenti aktsia- või osakapitalist nimiväärtuses, või selle harilik väärtus on alla 10 000 euro; võõrandatakse reaalservituut, ostueesõigus või reaalkoormatis; antakse üle riigi kasuks seatud hüpoteek, millega tagatud kohustus on täidetud. (5) Vabariigi Valitsusel on õigus määrata sellise valitsusasutuste valitsemisel oleva riigivara liigid või väärtus, mille võõrandamise otsustab igal üksikjuhul Vabariigi Valitsus. (6) Vallasasja hariliku väärtusega alla 10 000 euro võib käesoleva paragrahvi lõigetes 3–5 nimetamata juhul võõrandada riigivara valitseja kehtestatud korras, arvestades käesoleva seaduse §-s 8 sätestatud põhimõtteid. (7) Äri-, tootmis-, transpordi- ja sotsiaalmaad sisaldava kinnisasja, mis moodustab territoriaalse terviku ning mis on vajalik riigi ja kohaliku omavalitsuse ettevõtluskeskkonna arendamiseks, otsustuskorras võõrandamisel kohalikule omavalitsusele või ettevõtjale lähtub Vabariigi Valitsus nõusoleku andmisel ja riigivara valitseja otsuse tegemisel kehtestatud korrast.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_37 (redaktsioon 13236837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13236837",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIV_Par_37_v13333979"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13236837",
      "estleg:sourceAct": "Riigivaraseadus",
      "estleg:provisionRef": "RIIGIV § 37",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIV_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIV_Par_37_v13333979",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIV_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigivara võõrandamise otsustab riigivara valitseja. (2) Üksnes Vabariigi Valitsuse nõusolekul võib minister või riigisekretär otsustada kinnisasja või piiratud asjaõiguse võõrandamise järgmistel juhtudel: otsustuskorras või valikpakkumisel; üleandmise teel mitterahalise sissemaksena eraõiguslikule juriidilisele isikule; kui Rahandusministeerium käesoleva seaduse §-s 101 sätestatud korras ei anna kooskõlastust või peab tehingu olulisuse tõttu vajalikuks pöörduda Vabariigi Valitsuse poole. (3) Üksnes Vabariigi Valitsuse nõusolekul võib minister või riigisekretär otsustada vallasasja võõrandamise järgmistel juhtudel: väärtpaberi võõrandamine; otsustuskorras nõuete võõrandamine summas 10 000 eurot või rohkem; üleandmise teel mitterahalise sissemaksena eraõiguslikule juriidilisele isikule; kui Rahandusministeerium käesoleva seaduse §-s 101 sätestatud korras ei anna kooskõlastust või peab tehingu olulisuse tõttu vajalikuks pöörduda Vabariigi Valitsuse poole. (4) Vabariigi Valitsuse nõusolekut ei pea taotlema, kui: võõrandatav riigi osalus äriühingus on väiksem kui 10 protsenti äriühingu aktsia- või osakapitalist ja selle osaluse suurus nimiväärtuses on väiksem kui 1 000 000 eurot; riigivara antakse üle mitterahalise sissemaksena riigi äriühingule kalendriaasta jooksul kokku harilikus väärtuses, mis ei ületa 10 protsenti aktsia- või osakapitalist nimiväärtuses, või selle harilik väärtus on alla 10 000 euro; võõrandatakse reaalservituut, ostueesõigus või reaalkoormatis; antakse üle riigi kasuks seatud hüpoteek, millega tagatud kohustus on täidetud. (5) Vabariigi Valitsusel on õigus määrata sellise valitsusasutuste valitsemisel oleva riigivara liigid või väärtus, mille võõrandamise otsustab igal üksikjuhul Vabariigi Valitsus. (6) Vallasasja hariliku väärtusega alla 10 000 euro võib käesoleva paragrahvi lõigetes 3–5 nimetamata juhul võõrandada korras, arvestades käesoleva seaduse §-s 8 sätestatud põhimõtteid. (7) Äri-, tootmis-, transpordi- ja sotsiaalmaad sisaldava kinnisasja, mis moodustab territoriaalse terviku ning mis on vajalik riigi ja kohaliku omavalitsuse ettevõtluskeskkonna arendamiseks, otsustuskorras võõrandamisel kohalikule omavalitsusele või ettevõtjale lähtub Vabariigi Valitsus nõusoleku andmisel ja riigivara valitseja otsuse tegemisel kehtestatud korrast.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_37 (redaktsioon 13333979)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13333979",
