        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivaraseadus määrab kindlaks riigi omandis oleva vara (edaspidi riigivara) valitsejad ning riigivara valitsemise alused.",
      "rdfs:label": {
        "@value": "RIIGIV_Par_1 (redaktsioon 22319)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22319",
      "estleg:supersededByVersion": {
