        "@value": "Sätete redaktsioonid: Kriisiinfo teenuse kaudu arvatava kannatanu kohta päringu teinud isiku tuvastamise ja arvatava kannatanuga seose kontrollimise alused (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kriisiinfo teenuse kaudu arvatava kannatanu kohta päringu teinud isiku tuvastamise ja arvatava kannatanuga seose kontrollimise alused"
    },
    {
      "@id": "estleg:Reg_1049900_Par_1_v1049900",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049900_Par_1"
