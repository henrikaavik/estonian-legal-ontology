      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Töötaja asbestiga kokkupuute päevane piirnorm on 0,01 kiudu sissehingatava õhu ühes kuupsentimeetris, mis on mõõdetud või arvutatud kaheksatunnise kokkupuuteaja kaalutud keskmisena. RT I 2026-01-22 1 122012026001 2026-01-25 Töötaja asbestiga kokkupuute päevane piirnorm on 0,01 kiudu sissehingatava õhu ühes kuupsentimeetris, mis on mõõdetud või arvutatud kaheksatunnise kokkupuuteaja kaalutud keskmisena. 2 (2) Kehtetu - RT I 2026-01-22 1 122012026001 2026-01-25 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_315551_Par_2 (redaktsioon 315551)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315551",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315551",
      "estleg:sourceAct": "Asbestitööle esitatavad töötervishoiu ja tööohutuse nõuded",
      "estleg:provisionRef": "Reg_315551 § 2",
      "estleg:partOfAct": {
