    {
      "@id": "estleg:Reg_315551_Par_10_v315551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315551_Par_10"
