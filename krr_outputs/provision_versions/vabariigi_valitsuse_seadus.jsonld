    {
      "@id": "estleg:VABARI_Par_45_v130122024004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_45"
