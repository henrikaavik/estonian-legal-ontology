      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VABARI_Par_108 (redaktsioon 13312691)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13312691"
    },
    {
      "@id": "estleg:VABARI_Par_109_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1996. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "VABARI_Par_109 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347",
      "estleg:supersededByVersion": {
        "@id": "estleg:VABARI_Par_109_v13119258"
      },
