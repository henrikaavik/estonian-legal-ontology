      },
      "estleg:versionText": "(1) Vabariigi Valitsus võib oma korraldusega moodustada: ministrite komisjone; ministeeriumidevahelisi komisjone; asjatundjate komisjone.",
      "rdfs:label": {
        "@value": "VABARI_Par_21 (redaktsioon 913255)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "913255",
