  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vabariigi_valitsuse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vabariigi Valitsuse seadus (581 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vabariigi Valitsuse seadus"
    },
    {
      "@id": "estleg:VABARI_Par_1_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus teostab täidesaatvat riigivõimu Eesti Vabariigi põhiseaduse ja seaduste alusel. (2) Vabariigi Valitsus teostab täidesaatvat riigivõimu vahetult või valitsusasutuste kaudu.",
      "rdfs:label": {
        "@value": "VABARI_Par_1 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347"
    },
    {
      "@id": "estleg:VABARI_Par_10_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsuse tagasiastumisest teatab Vabariigi Presidendile: käesoleva seaduse paragrahv 8 punktis 1 nimetatud juhul - peaminister Riigikogu uue koosseisu esimesel istungil; käesoleva seaduse paragrahv 8 punktis 2 nimetatud juhul - peaminister viivitamata; käesoleva seaduse paragrahv 8 punktis 3 nimetatud juhul - peaministrit kooskõlas käesoleva seaduse paragrahv 13 alusel asendav minister viivitamata pärast tema surmast teadasaamist; käesoleva seaduse paragrahv 8 punktis 4 nimetatud juhul - Riigikogu esimees hiljemalt järgmisel päeval pärast seda, kui Riigikogu on Vabariigi Valitsusele või peaministrile umbusaldust avaldanud; käesoleva seaduse paragrahv 8 punktis 5 nimetatud juhul - Riigikogu esimees viivitamata. (2) Käesoleva paragrahvi 1. lõike punktides 2, 3, 4 ja 5 nimetatud juhtudel esitatakse teade kirjalikult. (3) Käesoleva paragrahvi 1. lõike punktide 2 ja 3 alusel Vabariigi Valitsuse tagasiastumisest teatanud isik teeb seda ka Riigikogus. (4) Kui Vabariigi Valitsus astub tagasi peaministri kohta tehtud süüdimõistva kohtuotsuse jõustumise tõttu, teeb selle Riigikogule teatavaks Vabariigi President järgmisel päeval pärast kohtult teate saamist. (5) Uue valitsuse ametisse astumise korral vabastab Vabariigi President tagasiastunud Vabariigi Valitsuse oma otsusega, mis avaldatakse Riigi Teatajas.",
      "rdfs:label": {
        "@value": "VABARI_Par_10 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347",
      "estleg:supersededByVersion": {
        "@id": "estleg:VABARI_Par_10_v209791"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-22",
        "@type": "xsd:date"
      }
    },
