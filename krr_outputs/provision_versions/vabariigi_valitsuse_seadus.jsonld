      "rdfs:label": {
        "@value": "VABARI_Par_6 (redaktsioon 209791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "209791",
      "estleg:supersededByVersion": {
        "@id": "estleg:VABARI_Par_6_v224384"
      },
      "estleg:versionValidTo": {
