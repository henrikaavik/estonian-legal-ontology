    {
      "@id": "estleg:VABARI_Par_91_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maasekretär: juhib maavalitsuse kantselei tööd maavalitsuse kantselei põhimääruses ettenähtud korras; esitab maavanemale ettepanekuid maavalitsuse kantselei struktuuri ja töökorralduse kohta; korraldab maavanema korralduste andmist ja nende teatavakstegemist ja kontrollib nende eelnõude vastavust põhiseadusele ja teistele õigusaktidele; korraldab maavanema tegevuse avalikustamist; hoiab maavalitsuse riigivapi kujutisega pitsatit; täidab muid talle seaduse või teiste õigusaktidega pandud ülesandeid.",
      "rdfs:label": {
        "@value": "VABARI_Par_91 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347",
      "estleg:supersededByVersion": {
        "@id": "estleg:VABARI_Par_91_v128122017019"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VABARI_Par_91_v128122017019",
      "@type": [
        "owl:NamedIndividual",
