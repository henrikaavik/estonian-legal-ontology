      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VABARI_Par_59_v129122011148",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) on õigusloome koordineerimine, õigusaktide süstematiseerimine ja Riigi Teataja väljaandmine, esimese ja teise astme kohtute, prokuratuuri, kohtuekspertiisi, vanglate, notarite ametitegevuse ja õigusteenuse korraldamine, samuti välisriigi kodaniku või kodakondsuseta isiku välisriigile väljaandmise otsustamine, intellektuaalse omandi valdkonna koordineerimine ja andmekaitsealased küsimused ning õigusloome ministeeriumi pädevuse kohaselt. (2) Kehtetu - (3) Justiitsministeeriumi valitsemisalas on järgmised ametid ja inspektsioonid: Andmekaitse Inspektsioon; Patendiamet.",
      "rdfs:label": {
        "@value": "VABARI_Par_59 (redaktsioon 129122011148)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011148",
      "estleg:supersededByVersion": {
