    {
      "@id": "estleg:VABARI_Par_39_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valitsusasutused on riigi eelarvest finantseeritavad asutused, millele seadusega või seaduse alusel antud põhiülesandeks on täidesaatva riigivõimu teostamine. (2) Valitsusasutused on ametiasutusteks avaliku teenistuse seaduse paragrahv 2 tähenduses. (3) Valitsusasutused on ministeeriumid, Riigikantselei ja maavalitsused, samuti ametid ja inspektsioonid ning nende kohalikud täidesaatva riigivõimu volitusi omavad asutused. Seadusega võib ette näha ka teisi valitsusasutusi.",
      "rdfs:label": {
        "@value": "VABARI_Par_39 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347",
      "estleg:supersededByVersion": {
