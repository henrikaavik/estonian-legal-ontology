    {
      "@id": "estleg:VABARI_Par_69_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisministeeriumi valitsemisalas on ettepanekute tegemine riigi välispoliitika kavandamiseks, välislepingute ja välismajandusega seotud küsimuste lahendamine, Eesti Vabariigi suhtlemise korraldamine välisriikide ja rahvusvaheliste organisatsioonidega, sise- ja välisprotokolli korraldamine riiklike tähtpäevade tähistamisel ning riiklike välisvisiitide läbiviimisel ja külaliste vastuvõtmisel, Eesti riigi ja kodanike huvide kaitsmine välisriikides ning vastavate õigusaktide eelnõude koostamine. (2) [kehtetu]",
      "rdfs:label": {
        "@value": "VABARI_Par_69 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347",
      "estleg:supersededByVersion": {
        "@id": "estleg:VABARI_Par_69_v263093"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VABARI_Par_69_v263093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
