      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VABARI_Par_92_v1011049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maasekretäri nimetab ametisse ja vabastab ametist maavanem. (2) Maasekretäriks võib olla üksnes juriidilise kõrgharidusega isik. (3) Maasekretäri ajutise asendamise kord sätestatakse maavalitsuse kantselei põhimääruses. Ajutise asendaja määrab maavanem.",
      "rdfs:label": {
        "@value": "VABARI_Par_92 (redaktsioon 1011049)",
