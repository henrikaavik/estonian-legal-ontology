        "@id": "estleg:VABARI_Par_21_v1011049"
      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VABARI_Par_21_v1011049",
