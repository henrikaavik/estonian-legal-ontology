        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VABARI_Par_91 (redaktsioon 128122017019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017019"
    },
    {
      "@id": "estleg:VABARI_Par_92_v22347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maasekretäri nimetab ametisse ja vabastab ametist maavanem, ära kuulanud riigisekretäri arvamuse. (2) Maasekretäriks võib olla üksnes juriidilise kõrgharidusega isik. (3) Maasekretäri ajutise asendamise kord sätestatakse maavalitsuse kantselei põhimääruses. Ajutise asendaja määrab maavanem.",
      "rdfs:label": {
        "@value": "VABARI_Par_92 (redaktsioon 22347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22347",
      "estleg:supersededByVersion": {
