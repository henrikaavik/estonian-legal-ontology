      ],
      "estleg:versionOf": {
        "@id": "estleg:VABARI_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) on õigusloome koordineerimine, õigusaktide süstematiseerimine, esimese ja teise astme kohtute, prokuratuuri, kohtuekspertiisi, vanglate, notarite ametitegevuse ja õigusteenuse korraldamine ning õigusloome ministeeriumi pädevuse kohaselt, samuti välisriigi kodaniku või kodakondsuseta isiku välisriigile väljaandmise otsustamine ja andmekaitsealased küsimused. (2) Kehtetu - (3) Justiitsministeeriumi valitsemisalas on Andmekaitse Inspektsioon.",
      "rdfs:label": {
        "@value": "VABARI_Par_59 (redaktsioon 112112010005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010005",
      "estleg:supersededByVersion": {
