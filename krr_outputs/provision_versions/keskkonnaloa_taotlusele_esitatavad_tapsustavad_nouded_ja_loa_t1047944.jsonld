    {
      "@id": "estleg:Reg_1047944_Par_40_40_v1047944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047944_Par_40_40"
