    {
      "@id": "estleg:Reg_1047944_Par_21_v1047944",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047944_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "LHK projekti sissejuhatuses esitatakse: 1 1) põhjendus, miks LHK projekt on koostatud; 2 2) viited õigusaktidele ja juhendmaterjalidele, kasutatud kirjandusele, muu hulgas rahvusvahelised mõõtmis- ja arvutusmetoodikad ning andmed tehnoloogiliste kaartide kohta; 3 3) lähteandmed, mille alusel on esitatud tootmismaht, kütusekulu ja muud andmed. LHK projekti sissejuhatuses esitatakse: põhjendus, miks LHK projekt on koostatud; viited õigusaktidele ja juhendmaterjalidele, kasutatud kirjandusele, muu hulgas rahvusvahelised mõõtmis- ja arvutusmetoodikad ning andmed tehnoloogiliste kaartide kohta; lähteandmed, mille alusel on esitatud tootmismaht, kütusekulu ja muud andmed.",
      "rdfs:label": {
        "@value": "Reg_1047944_Par_21 (redaktsioon 1047944)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047944",
