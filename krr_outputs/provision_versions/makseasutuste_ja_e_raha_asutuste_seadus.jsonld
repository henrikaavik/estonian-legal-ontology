        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses välisriigi makseasutuse või e-raha asutuse tegevuse suhtes kehtestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_116 (redaktsioon 13331230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331230",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_116_v117032023018"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_116_v117032023018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi makseasutuse või välisriigi e-raha asutuse teenuse osutamise eest Eestis ilma Finantsinspektsiooni teavitamata või käesolevas seaduses välisriigi makseasutuse või välisriigi e-raha asutuse tegevuse suhtes kehtestatud nõuete rikkumise eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni 10 protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "MERA_Par_116 (redaktsioon 117032023018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023018"
    },
    {
      "@id": "estleg:MERA_Par_116_1_v112072014095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevast seadusest tulenevate piirangute rikkumise eest vara investeerimisel – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_116_1 (redaktsioon 112072014095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014095",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_116_1_v119032015052"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_116_1_v119032015052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevast seadusest tulenevate piirangute rikkumise eest vara investeerimisel –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_116_1 (redaktsioon 119032015052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015052",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_116_1_v117032023018"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_116_1_v117032023018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MERA_Par_116_1 (redaktsioon 117032023018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023018"
    },
    {
      "@id": "estleg:MERA_Par_116_2_v117032023018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud juriidilise isiku käive on aastane netokäive, sealhulgas brutotulu, mis kooskõlas Euroopa Parlamendi ja nõukogu määrusega (EL) nr 575/2013 koosneb komisjoni- ja teenustasudest ning intressi- ja muudest sellesarnastest tuludest või kuni kahekordsele rikkumise tulemusel teenitud kasule või ära hoitud kahjule vastav summa. Kui juriidiline isik on emaettevõtja tütarettevõtja, on esimeses lauses nimetatud brutotuluks kogutulu eelmise majandusaasta konsolideeritud aastaaruande järgi.",
      "rdfs:label": {
        "@value": "MERA_Par_116_2 (redaktsioon 117032023018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023018"
    },
    {
      "@id": "estleg:MERA_Par_116_3_v117032023018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_116_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud väärtegude aegumistähtaeg on kolm aastat.",
      "rdfs:label": {
        "@value": "MERA_Par_116_3 (redaktsioon 117032023018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023018"
    },
    {
      "@id": "estleg:MERA_Par_117_v13256098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas peatükis sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Finantsinspektsioon.",
      "rdfs:label": {
        "@value": "MERA_Par_117 (redaktsioon 13256098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13256098",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_117_v112072014095"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_117_v112072014095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Finantsinspektsioon.",
      "rdfs:label": {
        "@value": "MERA_Par_117 (redaktsioon 112072014095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014095"
    },
    {
      "@id": "estleg:MERA_Par_118_v13256098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsiooni seaduses (RT I 2001, 48, 267; 2009, 5, 35) tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "MERA_Par_118 (redaktsioon 13256098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13256098"
    },
    {
      "@id": "estleg:MERA_Par_12_v13256098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriühing, kelle väljastatud e-raha seadmele salvestatav maksimaalne summa on 150 eurot, võib mitte järgida ja tema tegevuse suhtes ei kohaldata käesoleva seaduse 2.–10. peatükis sätestatud nõudeid, välja arvatud käesoleva seaduse §-des 46–49 äriühingu juhtide ja töötajate ning § 82 lõigetes 5 ja 6 aruandluse kohta sätestatut, kui on täidetud vähemalt üks järgmistest tingimustest: tema väljastatud e-raha aktsepteerivad maksevahendina ainult tema tütarettevõtjad, emaettevõtja ja emaettevõtja tütarettevõtjad või mõni nendest; tema väljastatavat e-raha aktsepteerib maksevahendina ainult piiratud arv ettevõtjaid, kelle tegevuskoht on samas tööruumis või piiritletud territooriumil, näiteks kaubanduskeskuses, lennu-, bussi- või raudteejaamas või muus seesuguses kohas, või kes turustavad oma tooteid või teenuseid ühiselt temaga; äriühingu juhte või äritegevuse juhtimise eest vastutavaid isikuid ei ole mõistetud süüdi majandusalase, ametialase, varavastase või avaliku usalduse vastase süüteo eest ega terrorikuriteo või selle toimepanemisele suunatud tegevuse rahastamise või toetamise eest või vastavad karistusandmed on karistusregistri seaduse kohaselt karistusregistrist kustutatud. (2) Käesoleva paragrahvi lõikes 1 nimetatud äriühingu asukoht ja peamine tegevuskoht peab asuma Eestis. (3) Äriühing, kes kasutab käesoleva paragrahvi lõikes 1 sätestatud õigust, ei või vastavalt käesoleva seaduse 3. peatükis sätestatule asutada lepinguriigis filiaali ega osutada piiriüleseid teenuseid.",
      "rdfs:label": {
        "@value": "MERA_Par_12 (redaktsioon 13256098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13256098",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_12_v13331113"
      },
      "estleg:versionValidTo": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_12_v13331113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriühing, kelle väljastatud e-raha seadmele salvestatav maksimaalne summa on 150 eurot, võib mitte järgida ja tema tegevuse suhtes ei kohaldata käesoleva seaduse 2.–10. peatükis sätestatud nõudeid, välja arvatud käesoleva seaduse §-des 46–49 äriühingu juhtide ja töötajate ning § 82 lõigetes 3 ja 5 aruandluse kohta sätestatut, kui on täidetud vähemalt üks järgmistest tingimustest: tema väljastatud e-raha aktsepteerivad maksevahendina ainult tema tütarettevõtjad, emaettevõtja ja emaettevõtja tütarettevõtjad või mõni nendest; tema väljastatavat e-raha aktsepteerib maksevahendina ainult piiratud arv ettevõtjaid, kelle tegevuskoht on samas tööruumis või piiritletud territooriumil, näiteks kaubanduskeskuses, lennu-, bussi- või raudteejaamas või muus seesuguses kohas, või kes turustavad oma tooteid või teenuseid ühiselt temaga; äriühingu juhte või äritegevuse juhtimise eest vastutavaid isikuid ei ole mõistetud süüdi majandusalase, ametialase, varavastase või avaliku usalduse vastase süüteo eest ega terrorikuriteo või selle toimepanemisele suunatud tegevuse rahastamise või toetamise eest või vastavad karistusandmed on karistusregistri seaduse kohaselt karistusregistrist kustutatud. (2) Käesoleva paragrahvi lõikes 1 nimetatud äriühingu asukoht ja peamine tegevuskoht peab asuma Eestis. (3) Äriühing, kes kasutab käesoleva paragrahvi lõikes 1 sätestatud õigust, ei või vastavalt käesoleva seaduse 3. peatükis sätestatule asutada lepinguriigis filiaali ega osutada piiriüleseid teenuseid.",
      "rdfs:label": {
        "@value": "MERA_Par_12 (redaktsioon 13331113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331113",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_12_v108072011020"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_12_v108072011020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Äriühing, kelle väljastatav e-raha vastab võlaõigusseaduse § 73312 lõikes 1 sätestatud väikemaksevahendi määratlusele, võib mitte järgida ja tema tegevuse suhtes ei kohaldata käesoleva seaduse 2.–10. peatükis sätestatud nõudeid, välja arvatud käesoleva seaduse §-des 47–49 äriühingu juhtide ja töötajate ning § 82 lõigetes 1 ja 3 aruandluse kohta sätestatut, kui on täidetud järgmised tingimused: keskmine väljastatud e-raha maht ei ole suurem kui 500 000 eurot arvestatuna vastavalt käesoleva paragrahvi lõikele 5; äriühingu juhte või äritegevuse juhtimise eest vastutavaid isikuid ei ole mõistetud süüdi majandusalase, ametialase, varavastase või avaliku usalduse vastase süüteo eest ega terrorikuriteo või selle toimepanemisele suunatud tegevuse rahastamise või toetamise eest või vastavad karistusandmed on karistusregistri seaduse kohaselt karistusregistrist kustutatud. (2) Käesoleva paragrahvi lõikes 1 nimetatud äriühingu asukoht ja peamine tegevuskoht peavad asuma Eestis. (3) Käesoleva paragrahvi lõikes 1 sätestatud õigust kasutav äriühing ei või vastavalt käesoleva seaduse 3. peatükis sätestatule asutada lepinguriigis filiaali, osutada piiriüleseid teenuseid ega levitada teises lepinguriigis e-raha edasimüüja kaudu. (4) Käesoleva paragrahvi lõikes 1 sätestatud õigust kasutav äriühing võib pakkuda makseteenust, kui ta vastab käesoleva seaduse § 11 lõikes 1 sätestatud tingimustele. (5) Keskmise väljastatud e-raha mahuna käsitatakse käesoleva seaduse tähenduses väljastatud e-rahaga seotud rahaliste kohustuste keskmist üldsummat iga kalendripäeva lõpus eelneva kuue kalendrikuu jooksul. Keskmist väljastatud e-raha mahtu arvestatakse iga kalendrikuu esimesel kalendripäeval ja seda kohaldatakse kõnealusel kalendrikuul.",
      "rdfs:label": {
        "@value": "MERA_Par_12 (redaktsioon 108072011020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072011020",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_12_v107122017002"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_12_v107122017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) E-raha asutusele, kelle väljastatav e-raha vastab võlaõigusseaduse § 73312 lõikes 1 sätestatud väikemaksevahendi määratlusele, ei kohaldata Finantsinspektsiooni otsuse alusel käesoleva seaduse peatükkides 3, 4, 6 ja 8 sätestatut, kui tema keskmine väljastatud e-raha maht ei ole suurem kui 500 000 eurot arvestatuna käesoleva paragrahvi lõike 2 kohaselt. Finantsinspektsioon otsustab käesolevas lõikes nimetatud erandi kohaldamise tegevusloa andmise otsuses. (2) Keskmise väljastatud e-raha mahuna käsitatakse käesoleva seaduse tähenduses väljastatud e-rahaga seotud rahaliste kohustuste keskmist üldsummat iga kalendripäeva lõpus eelneva kuue kalendrikuu jooksul. Keskmist väljastatud e-raha mahtu arvestatakse iga kalendrikuu esimesel kalendripäeval ja seda kohaldatakse kõnealusel kalendrikuul. (3) E-raha asutus, kellele kohaldatakse käesoleva paragrahvi lõikes 1 sätestatud erandit, ei või vastavalt käesoleva seaduse 3. peatükis sätestatule asutada lepinguriigis filiaali, osutada piiriüleseid teenuseid ega levitada teises lepinguriigis e-raha edasimüüja kaudu. (4) E-raha asutus, kellele kohaldatakse käesoleva paragrahvi lõikes 1 sätestatud erandit, võib pakkuda makseteenuseid, kui ta täidab käesoleva seaduse § 11 lõikes 1 või 2 sätestatud tingimusi.",
      "rdfs:label": {
        "@value": "MERA_Par_12 (redaktsioon 107122017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107122017002"
    },
    {
      "@id": "estleg:MERA_Par_127_v13256098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
