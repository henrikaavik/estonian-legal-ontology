      }
    },
    {
      "@id": "estleg:MERA_Par_110_v13331230",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_110"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Makseasutuse või e-raha asutuse poolt kliendile teabe ja selgituste andmise kohta ning makseteenusega või e-raha teenusega seotud tegevuse edasiandmise kohta käesolevas seaduses sätestatud kohustuste rikkumise eest –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_110 (redaktsioon 13331230)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331230",
      "estleg:supersededByVersion": {
        "@id": "estleg:MERA_Par_110_v117032023018"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MERA_Par_110_v117032023018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_110"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Makseteenusega või e-raha teenusega seotud tegevuse edasiandmise kohta käesoleva seaduse §-s 62 kehtestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni 10 protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "MERA_Par_110 (redaktsioon 117032023018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023018"
    },
    {
      "@id": "estleg:MERA_Par_110_1_v117032023018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_110_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 637 sätestatud vastutuskindlustuse või garantiilepingu sõlmimise kohustuse rikkumise, sealhulgas vastutuskindlustuse või garantiilepingu tingimuste kohta sätestatud nõuete rikkumise eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_110_1 (redaktsioon 117032023018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023018"
    },
    {
      "@id": "estleg:MERA_Par_110_2_v108072025033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_110_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlaõigusseaduse §-s 7101 sätestatud põhimakseteenuse lepingu sõlmimisele või §-s 7201 sätestatud põhimakseteenuse lepingu ülesütlemisele esitatud nõuete rikkumise eest, sealhulgas põhimakseteenuse lepingu sõlmimiseks või ülesütlemiseks vajalike meetmete, protsesside või sise-eeskirjade kehtestamise nõude või rakendamise kohustuse rikkumise eest, – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_110_2 (redaktsioon 108072025033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025033"
    },
    {
      "@id": "estleg:MERA_Par_110_3_v108072025033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_110_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlaõigusseaduse §-s 7113, 7116 või 7181 sätestatud maksekontoga seotud tasude läbipaistvusele ja võrreldavusele esitatud nõuete rikkumise eest, sealhulgas maksekontoga seotud tasude esitamise, läbipaistvuse ja võrreldavuse tagamiseks vajalike meetmete, protsesside või sise-eeskirjade kehtestamise nõude või rakendamise kohustuse rikkumise eest, – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_110_3 (redaktsioon 108072025033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025033"
    },
    {
      "@id": "estleg:MERA_Par_110_4_v108072025033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_110_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlaõigusseaduse §-s 7115, 7211–7214 või § 7215 lõikes 1 sätestatud makseteenuse üleviimisele esitatud nõuete rikkumise eest, sealhulgas makseteenuse üleviimise tagamiseks vajalike meetmete, protsesside või sise-eeskirjade kehtestamise nõude või rakendamise kohustuse rikkumise eest, – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 400 000 eurot.",
      "rdfs:label": {
        "@value": "MERA_Par_110_4 (redaktsioon 108072025033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025033"
    },
