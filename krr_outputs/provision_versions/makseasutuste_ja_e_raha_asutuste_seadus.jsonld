      }
    },
    {
      "@id": "estleg:MERA_Par_36_v107122017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MERA_Par_36"
      },
      "estleg:versionValidFrom": {
