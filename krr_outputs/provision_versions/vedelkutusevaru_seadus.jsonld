      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 20 ja 21 sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40; 46, 329; 54, 387; 56, 401; 88, 600) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590; 593; 2004, 46, 329; 54, 387; 390; 56, 403) sätteid. (2) Käesoleva seaduse §-des 20 ja 21 sätestatud väärtegude kohtuväline menetleja on Majandus- ja Kommunikatsiooniministeerium.",
      "rdfs:label": {
        "@value": "VKVS_Par_22 (redaktsioon 860541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860541",
