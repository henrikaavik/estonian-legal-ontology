    },
    {
      "@id": "estleg:VKVS_Par_22_v130062023099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_22"
      },
