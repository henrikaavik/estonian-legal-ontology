    {
      "@id": "estleg:VKVS_Par_23_1_v131102013006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_23_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 7 lõiget 8 rakendatakse, kui on jõustunud otsus Eesti Vabariigi ühinemise kohta Rahvusvahelise Energiaagentuuriga.",
      "rdfs:label": {
        "@value": "VKVS_Par_23_1 (redaktsioon 131102013006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131102013006"
    },
    {
      "@id": "estleg:VKVS_Par_24_v860541",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vedelkütuse miinimumvaru seadus (RT I 2001, 36, 202; 88, 531; 2002, 63, 387; 2003, 81, 548; 88, 594; 2004, 53, 365) tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "VKVS_Par_24 (redaktsioon 860541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860541"
    },
    {
      "@id": "estleg:VKVS_Par_26_v860541",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maksukorralduse seaduses (RT I 2002, 26, 150; 57, 358; 63, 387; 99, 581; 110, 660; 111, 662; 2003, 2, 17; 48, 341; 71, 472; 82, 554; 88, 591; 2004, 2, 7; 28, 188 ja 189; 30, 208; 45, 319; 56, 403; 84, 568 ja 569) tehakse järgmised muudatused: paragrahvi 29 punkt 20 muudetakse ja sõnastatakse järgmiselt: «20) Majandus- ja Kommunikatsiooniministeeriumile, dumpingunõukogule ja Vabariigi Valitsusele dumpinguvastase uurimismenetluse läbiviimiseks ning dumpinguvastaste meetmete rakendamise otsustamiseks.»; paragrahvi 29 täiendatakse punktiga 29 järgmises sõnastuses: «29) vedelkütusevaru moodustamise ja haldamise eesmärgil asutatud riigi äriühingule importijate turuosa määramiseks, varu kasutuselevõtu valmisoleku tagamiseks ning varumakse tasumise kontrollimiseks vedelkütusevaru seaduse alusel.»",
      "rdfs:label": {
        "@value": "VKVS_Par_26 (redaktsioon 860541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860541",
      "estleg:supersededByVersion": {
        "@id": "estleg:VKVS_Par_26_v13238509"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VKVS_Par_26_v13238509",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VKVS_Par_26 (redaktsioon 13238509)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13238509"
    },
    {
      "@id": "estleg:VKVS_Par_27_v860541",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub Riigi Teatajas avaldamisele järgneval päeval. (2) Käesoleva seaduse § 3 lõige 4 jõustub 2006. aasta 1. jaanuaril. (3) Käesoleva seaduse § 5 lõige 9 jõustub 2010. aasta 1. jaanuaril. 1 EÜ Nõukogu direktiiv 68/414/EMÜ, millega EMÜ liikmesriike kohustatakse säilitama toornafta ja/või naftatoodete miinimumvarusid (EÜT L 308, 23.12.1968, lk 14–16), muudetud EL Nõukogu direktiiviga 98/93/EÜ; EÜ Nõukogu direktiiv 73/238/EMÜ toornafta ja naftatoodete tarneraskuste mõju leevendamise meetmete kohta (EÜT L 228, 16.08.1973, lk 1–2).",
      "rdfs:label": {
        "@value": "VKVS_Par_27 (redaktsioon 860541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "860541",
