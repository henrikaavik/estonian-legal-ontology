    },
    {
      "@id": "estleg:VKVS_Par_22_v112072014153",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VKVS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Majandus- ja Kommunikatsiooniministeerium.",
      "rdfs:label": {
