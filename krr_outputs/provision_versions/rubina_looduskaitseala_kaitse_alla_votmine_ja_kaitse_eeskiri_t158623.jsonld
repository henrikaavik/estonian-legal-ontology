    {
      "@id": "estleg:Reg_158623_Par_2_v158623",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158623_Par_2"
      },
