      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekuta on kaitsealal keelatud: 1 1) muuta katastriüksuse kõlvikute piire ja kõlvikute sihtotstarvet; 2 2) koostada maakorralduskava ja teostada maakorraldustoiminguid; 3 3) väljastada metsamajandamiskava; 4 4) kinnitada metsateatist; 5 5) kehtestada detailplaneeringut ja üldplaneeringut; 6 6) anda nõusolekut väikeehitise, sealhulgas lautri või paadisilla ehitamiseks; 7 7) anda projekteerimistingimusi; 8 8) anda ehitusluba. Kaitseala valitseja nõusolekuta on kaitsealal keelatud: muuta katastriüksuse kõlvikute piire ja kõlvikute sihtotstarvet; koostada maakorralduskava ja teostada maakorraldustoiminguid; väljastada metsamajandamiskava; kinnitada metsateatist; kehtestada detailplaneeringut ja üldplaneeringut; anda nõusolekut väikeehitise, sealhulgas lautri või paadisilla ehitamiseks; anda projekteerimistingimusi; anda ehitusluba.",
      "rdfs:label": {
        "@value": "Reg_158623_Par_5 (redaktsioon 158623)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158623",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158623",
      "estleg:sourceAct": "Rubina looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158623 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158623_Map"
      }
    },
