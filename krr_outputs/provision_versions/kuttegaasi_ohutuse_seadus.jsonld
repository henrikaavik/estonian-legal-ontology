        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KGOS_Par_18_v129062014026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
