      }
    },
    {
      "@id": "estleg:KGOS_Par_28_v129062014026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KGOS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse ning selle alusel kehtestatud õigusaktide nõuete täitmise üle teostab riiklikku järelevalvet Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "KGOS_Par_28 (redaktsioon 129062014026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014026"
    },
    {
      "@id": "estleg:KGOS_Par_29_v171159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KGOS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsiooni pädevusse kuulub: järelevalve turule lastud gaasi- või abiseadme ja küttegaasi käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele vastavuse üle (turujärelevalve); järelevalve gaasipaigaldise ehitamise, kasutusele võtmise ja kasutamise ning gaasitööde ja tehnilise kontrolli käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele vastavuse üle; järelevalve teavitatud asutuse, tehnilise kontrolli teostaja ja isiku nõuetele vastavuse hindaja ja tõendaja suhtes käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete järgimise üle; gaasiseadme või gaasipaigaldisega toimunud avarii ja õnnetuse tekkepõhjuste väljaselgitamine; gaasi- või abiseadme turule laskmise või kasutamise keelamine ajaks, mis on vajalik selle nõuetele vastavuse kontrollimiseks, ja nõuetele mittevastava gaasi- või abiseadme turult eemaldamise või selle kasutamise lõpetamise nõudmine; järelevalve käigus ettekirjutuste ja otsuste tegemine.",
      "rdfs:label": {
        "@value": "KGOS_Par_29 (redaktsioon 171159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171159",
      "estleg:supersededByVersion": {
        "@id": "estleg:KGOS_Par_29_v729164"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KGOS_Par_29_v729164",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KGOS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsiooni pädevusse kuulub: järelevalve turule lastud gaasi- või abiseadme ja küttegaasi käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele vastavuse üle (turujärelevalve); järelevalve gaasipaigaldise ehitamise, kasutusele võtmise ja kasutamise ning gaasitööde ja tehnilise kontrolli käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele vastavuse üle; järelevalve teavitatud asutuse, tehnilise kontrolli teostaja ja isiku nõuetele vastavuse hindaja ja tõendaja suhtes käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete järgimise üle; gaasiseadme või gaasipaigaldisega toimunud avarii ja õnnetuse tekkepõhjuste väljaselgitamine; gaasi- või abiseadme turule laskmise või kasutamise keelamine ajaks, mis on vajalik selle nõuetele vastavuse kontrollimiseks, ja nõuetele mittevastava gaasi- või abiseadme turult eemaldamise või selle kasutamise lõpetamise nõudmine; järelevalve käigus ettekirjutuste ja otsuste tegemine; registriandmete kontroll.",
      "rdfs:label": {
        "@value": "KGOS_Par_29 (redaktsioon 729164)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "729164",
      "estleg:supersededByVersion": {
        "@id": "estleg:KGOS_Par_29_v749120"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KGOS_Par_29_v749120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KGOS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Inspektsiooni pädevusse kuulub: järelevalve turule lastud küttegaasi, turule lastud, kasutusele võetud või kasutatava gaasi- või abiseadme, samuti nende kasutamise vastavuse üle käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele (turujärelevalve); järelevalve gaasipaigaldise ehitamise, kasutusele võtmise ja kasutamise ning gaasitööde ja tehnilise kontrolli käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele vastavuse üle; järelevalve teavitatud asutuse, tehnilise kontrolli teostaja ja isiku nõuetele vastavuse hindaja ja tõendaja suhtes käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete järgimise üle; gaasiseadme või gaasipaigaldisega toimunud avarii ja õnnetuse tekkepõhjuste väljaselgitamine; nõuetele mittevastava gaasi- või abiseadme turult eemaldamise nõudmine või nende kasutamise keelamine, samuti nõuetele mittevastava gaasipaigaldise kasutamise keelamine, kohaldades nende eesmärkide saavutamiseks vajaduse korral asendustäitmist asendustäitmise ja sunniraha seaduses (RT I 2001, 50, 283; 94, 580) sätestatud korras; järelevalve käigus ettekirjutuste ja otsuste tegemine; registriandmete kontroll.",
      "rdfs:label": {
        "@value": "KGOS_Par_29 (redaktsioon 749120)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749120",
      "estleg:supersededByVersion": {
        "@id": "estleg:KGOS_Par_29_v12894881"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KGOS_Par_29_v12894881",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KGOS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti pädevusse kuulub: järelevalve turule lastud küttegaasi, turule lastud, kasutusele võetud või kasutatava gaasi- või abiseadme, samuti nende kasutamise vastavuse üle käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele (turujärelevalve); järelevalve gaasipaigaldise ehitamise, kasutusele võtmise ja kasutamise ning gaasitööde ja tehnilise kontrolli käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele vastavuse üle; järelevalve teavitatud asutuse, tehnilise kontrolli teostaja ja isiku nõuetele vastavuse hindaja ja tõendaja suhtes käesolevas seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuete järgimise üle; gaasiseadme või gaasipaigaldisega toimunud avarii ja õnnetuse tekkepõhjuste väljaselgitamine; nõuetele mittevastava gaasi- või abiseadme turult eemaldamise nõudmine või nende kasutamise keelamine, samuti nõuetele mittevastava gaasipaigaldise kasutamise keelamine, kohaldades nende eesmärkide saavutamiseks vajaduse korral asendustäitmist asendustäitmise ja sunniraha seaduses sätestatud korras; järelevalve käigus ettekirjutuste ja otsuste tegemine; registriandmete kontroll.",
      "rdfs:label": {
        "@value": "KGOS_Par_29 (redaktsioon 12894881)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894881",
      "estleg:supersededByVersion": {
        "@id": "estleg:KGOS_Par_29_v12971186"
      },
      "estleg:versionValidTo": {
        "@value": "2008-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KGOS_Par_29_v12971186",
      "@type": [
