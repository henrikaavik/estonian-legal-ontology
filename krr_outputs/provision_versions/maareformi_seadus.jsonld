      },
      "estleg:versionValidTo": {
        "@value": "2008-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/993297",
      "estleg:sourceAct": "Maareformi seadus",
      "estleg:provisionRef": "MaaRS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:MaaRS_Map"
      }
    },
    {
      "@id": "estleg:MaaRS_Par_21_v13001375",
      "@type": [
        "owl:NamedIndividual",
