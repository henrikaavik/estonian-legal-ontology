      "estleg:provisionRef": "MaaRS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:MaaRS_Map"
      }
    },
    {
      "@id": "estleg:MaaRS_Par_38_1_v104072017046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaRS_Par_38_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maareformi käigus vastu võetud haldusakt või muu dokument toimetatakse menetlusosalisele kätte haldusmenetluse seaduses ettenähtud viisil. Haldusmenetluse seaduse § 31 lõikes 1 sätestatud juhul võib maareformi käigus vastu võetud haldusakti või muu dokumendi avaldada väljaandes Ametlikud Teadaanded.",
      "rdfs:label": {
        "@value": "MaaRS_Par_38_1 (redaktsioon 104072017046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017046",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072017046",
