      "estleg:provisionRef": "MaaRS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:MaaRS_Map"
      }
    },
    {
      "@id": "estleg:MaaRS_Par_6_v170215",
      "@type": [
        "owl:NamedIndividual",
