      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MaaRS_Par_30 (redaktsioon 128062016014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016014",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016014",
      "estleg:sourceAct": "Maareformi seadus",
      "estleg:provisionRef": "MaaRS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:MaaRS_Map"
      }
    },
    {
      "@id": "estleg:MaaRS_Par_31_v22212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaRS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi omandisse jäetakse: riigi omandisse jäävate hoonete ja rajatiste alune ning neid teenindav maa; riikliku kaitse all olev ja riikliku kaitse all olevate objektide juurde kuuluv maa, kui kehtestatud kaitserežiim teeb võimatuks maa kasutamise teise isiku poolt; riigi omandisse jäävate veekogude alune maa; sotsiaalmaa; riigikaitsemaa; riigimetsamaa; riigi äriühingute ja riigiasutuste põllumajandusmaa; riigi maareserv; üleriigilise tähtsusega maardlate maa olemasoleva mäeeraldise piirides, välja arvatud kehtestatud korras rekultiveeritud maa, mille tagastamist taotletakse; teise isiku ehitise teenindamiseks vajalik maa, millele seatakse hoonestusõigus; [kehtetu] maa, millele seatakse kasutusvaldus vastavalt käesoleva seaduse §-le 341; maa, mis antakse välisriigi omandisse, valdusse või kasutusse või mille üleandmises on valitsusdelegatsioonid kirjalikult kokku leppinud. (2) Maa, mida ei tagastata, erastata ega anta munitsipaalomandisse või mis ei ole jäetud riigi omandisse käesoleva paragrahvi 1. lõike alusel, on samuti riigi omandis. (3) Riigi omandisse jäetud maa võõrandamine toimub riigivaraseaduses (RT I 1995, 22, 327; 1996, 36, 738; 40, 773; 48, 942; 81, 1446; 1997, 45, 724; 1998, 30, 409; 1999, 10, 155; 16, 271; 2000, 39, 239; 49, 306; 51, 319; 2001, 7, 17) sätestatud korras, kui seadusega ei sätestata teisiti.",
      "rdfs:label": {
        "@value": "MaaRS_Par_31 (redaktsioon 22212)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22212",
      "estleg:supersededByVersion": {
        "@id": "estleg:MaaRS_Par_31_v961451"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22212",
      "estleg:sourceAct": "Maareformi seadus",
      "estleg:provisionRef": "MaaRS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:MaaRS_Map"
      }
    },
