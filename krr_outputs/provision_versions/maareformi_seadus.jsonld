        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/543698",
      "estleg:sourceAct": "Maareformi seadus",
      "estleg:provisionRef": "MaaRS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:MaaRS_Map"
