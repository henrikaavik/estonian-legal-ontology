      "rdfs:label": {
        "@value": "MaaRS_Par_34 (redaktsioon 128062016014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016014",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016014",
      "estleg:sourceAct": "Maareformi seadus",
      "estleg:provisionRef": "MaaRS § 34",
