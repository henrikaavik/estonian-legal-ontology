      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitise omaniku kasuks, kes ei soovi või kellel ei ole õigust maad omandada, võib riigimaale seada hoonestusõiguse Vabariigi Valitsuse kehtestatud korras.",
      "rdfs:label": {
