    {
      "@id": "estleg:MaaRS_Par_19_2_v115032013032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MaaRS_Par_19_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-03-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kehtetu - (4) Kui maa tagastamise nõudeõigus on päritud ja pärandaja kuulus käesoleva seaduse § 15 2. lõike teises lauses nimetatud isikute ringi, kellele maa tagastatakse riigi kulul, on ka nõudeõiguse pärinud isikul õigus maa tagastamisele riigi kulul.",
      "rdfs:label": {
        "@value": "MaaRS_Par_19_2 (redaktsioon 115032013032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032013032",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032013032",
      "estleg:sourceAct": "Maareformi seadus",
      "estleg:provisionRef": "MaaRS § 19_2",
      "estleg:partOfAct": {
