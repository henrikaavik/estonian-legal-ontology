    {
      "@id": "estleg:KarSRS_Par_33_v177120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KarSRS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 1, 2 ja 5 sätestatud alustel karistusest vabastamise taotlused esitab prokurör või haldusõiguserikkumise eest karistuse määranud või protokolli koostanud asutuse ametnik maa- või linnakohtule nelja kuu jooksul, arvates karistusseadustiku jõustumisest. (2) Maa või linnakohus vaatab esitatud taotlused läbi kuue kuu jooksul, arvates karistusseadustiku jõustumisest.",
      "rdfs:label": {
        "@value": "KarSRS_Par_33 (redaktsioon 177120)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "177120",
      "estleg:supersededByVersion": {
        "@id": "estleg:KarSRS_Par_33_v12744446"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KarSRS_Par_33_v12744446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KarSRS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 1, 2 ja 5 sätestatud alustel karistusest vabastamise taotlused esitab prokurör või haldusõiguserikkumise eest karistuse määranud või protokolli koostanud asutuse ametnik maa- või linnakohtule nelja kuu jooksul, arvates karistusseadustiku jõustumisest. (2) Maa või linnakohus vaatab esitatud taotlused läbi kuue kuu jooksul, arvates karistusseadustiku jõustumisest. [Paragrahv 331 jõustub 1. 01. 2007]",
      "rdfs:label": {
        "@value": "KarSRS_Par_33 (redaktsioon 12744446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12744446",
      "estleg:supersededByVersion": {
        "@id": "estleg:KarSRS_Par_33_v12791906"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KarSRS_Par_33_v12791906",
      "@type": [
        "owl:NamedIndividual",
