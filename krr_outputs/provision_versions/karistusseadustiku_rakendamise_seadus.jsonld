      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korruptsioonivastases seaduses kehtestatud toimingupiirangute rikkumise ulatust hinnatakse suureks, kui tehtavate tehingute või otsuste maht ületab kehtivat palga alammäära ühes kuus sajakordselt.",
      "rdfs:label": {
        "@value": "KarSRS_Par_8_2 (redaktsioon 12791906)",
