    {
      "@id": "estleg:Reg_312612_Par_4_v312612",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312612_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on kaks sihtkaitsevööndit: 1 1) Saapasoo sihtkaitsevöönd; 2 2) Lepiku sihtkaitsevöönd. Kaitsealal on kaks sihtkaitsevööndit: Saapasoo sihtkaitsevöönd; Lepiku sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_312612_Par_4 (redaktsioon 312612)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312612",
