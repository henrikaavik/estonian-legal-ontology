      }
    },
    {
      "@id": "estleg:Reg_312612_Par_5_v312612",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312612_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saapasoo sihtkaitsevööndi kaitse-eesmärk on metsaökosüsteemi arengu tagamine üksnes loodusliku protsessina. Saapasoo sihtkaitsevööndi kaitse-eesmärk on metsaökosüsteemi arengu tagamine üksnes loodusliku protsessina. 2 (2) Lepiku sihtkaitsevööndi kaitse-eesmärk on elustiku mitmekesisuse ja ala ökoloogilise stabiilsuse tagamine. Lepiku sihtkaitsevööndi kaitse-eesmärk on elustiku mitmekesisuse ja ala ökoloogilise stabiilsuse tagamine.",
      "rdfs:label": {
        "@value": "Reg_312612_Par_5 (redaktsioon 312612)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312612",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312612",
      "estleg:sourceAct": "Kergu looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_312612 § 5",
