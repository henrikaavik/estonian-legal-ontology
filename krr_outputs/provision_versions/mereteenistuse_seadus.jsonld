    {
      "@id": "estleg:mereteenistuse_seadus_Par_23_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teadetetahvel laeva töökorraldusega paigutatakse kergesti ligipääsetavasse kohta ja sellel peab olema: iga teenistuskoha kohta vähemalt töötamise ajakava merel ja sadamas; maksimaalne tööaeg ja minimaalne puhkeaeg vastavalt seadusele, muule õigusaktile või kollektiivlepingule; meretöölepingu vorm; koopiad töö- ja puhkeaega reguleerivatest seadustest, muudest õigusaktidest ning vastavad kollektiivlepingud. (2) Käesoleva paragrahvi lõikes 1 nimetatud teadetetahvlil peab informatsioon olema eesti ja inglise keeles. Teadetetahvel koostatakse standardformaadis.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_23 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_24_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder tagab oma kulul laevapere liikmele töö tegemiseks vajaliku töö- ja eririietuse ning kaitsevahendid.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_24 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_25_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva juhtkonna liikmel on kohustus kanda ametiriietust. Laeva juhtkonna liikme ametiriietuse ja ametialase eraldusmärkide kirjelduse kehtestab teede- ja sideminister.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_25 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_25_v695849"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_25_v695849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva juhtkonna liikmel on kohustus kanda ametiriietust. Laeva juhtkonna liikme ametiriietuse ja ametialase eraldusmärkide kirjelduse kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_25 (redaktsioon 695849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695849",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_25_v738309"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-24",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_25_v738309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laeva juhtkonna liikmel on töökohustuste täitmise ajal kohustus kanda ametiriietust. (2) Laeva juhtkonna liikme ametiriietuse ja ametialaste eraldusmärkide kirjelduse kehtestab majandus- ja kommunikatsiooniminister. Laeva juhtkonna liikme ametialased eraldusmärgid võivad ühtida meresõiduohutuse seaduse § 76 lõike 9 alusel kehtestatud Veeteede Ameti ametniku eraldusmärkidega.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_25 (redaktsioon 738309)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738309",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_25_v908871"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-02",
        "@type": "xsd:date"
      }
    },
