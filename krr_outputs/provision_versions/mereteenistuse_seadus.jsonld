      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liikmel on laevaloleku ajal õigus nõuetele vastavale majutusele. Nõuded laevapere liikme laeval majutamise tingimustele (2) Laevapere liikmel on kohustus hoida tema kasutusse antud ruume korras.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_27 (redaktsioon 102072013048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013048"
