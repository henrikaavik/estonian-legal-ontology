        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_21_v13124337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töötasu arvestamise kohustus tekib alates laevapere liikme tööle asumise päevast. (2) Kui laev, millel laevapere liige tööle asub või töö lõpetab, ei asu meretöölepingu sõlmimise kohas, arvestab reeder töötasu laevale või laevalt sõidu alustamise hetkest, kui meretöölepingus ei ole kokku lepitud teisiti.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_21 (redaktsioon 13124337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124337"
    },
