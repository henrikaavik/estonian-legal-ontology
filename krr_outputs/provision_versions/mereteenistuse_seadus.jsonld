    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_29_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reeder või kapten korraldab merereisi ajal haigestunud või vigastatud laevapere liikmele meditsiiniabi andmist ja laevapere liikme ravi laeval või maal. (2) Laevapere liikmele merereisi ajal meditsiiniabi osutamisega seotud kulud ja laevapere liikme vajalikud ravikulud kannab reeder.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_29 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_3_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liikmeks käesoleva seaduse tähenduses on iga laeval töötav isik, kellega on sõlmitud meretööleping. (2) Laev mehitatakse meresõiduohutuse seadusega (RT I 1998, 2, 47; 1999, 95, 843; 2000, 29, 171) kehtestatud korras laeva käitamiseks ja ohutuks kasutamiseks vajalike töötajatega ning vajaduse korral abitöödeks ja teenuste osutamiseks teiste töötajatega, kelle ettevalmistus peab vastama nende tööülesannetele. [Lõike 3 sõnastus kuni 31.12.2002] (3) Laevapere liikmed kantakse munsterrolli, mille vormi ja täitmise korra kehtestab teede- ja sideminister. [Lõike 3 sõnastus alates 1.01.2003] (3) Laevapere liikmed kantakse munsterrolli, mille vormi kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_3 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_3_v695849"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_3_v695849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liikmeks käesoleva seaduse tähenduses on iga laeval töötav isik, kellega on sõlmitud meretööleping. (2) Laev mehitatakse meresõiduohutuse seadusega(RT I 1998, 2, 47; 1999,. 95, 843; 2000, 29, 171) kehtestatud korras laeva käitamiseks ja ohutuks kasutamiseks vajalike töötajatega ning vajaduse korral abitöödeks ja teenuste osutamiseks teiste töötajatega, kelle ettevalmistus peab vastama nende tööülesannetele. (3) Laevapere liikmed kantakse munsterrolli, mille vormi kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_3 (redaktsioon 695849)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695849",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_3_v738309"
      },
      "estleg:versionValidTo": {
