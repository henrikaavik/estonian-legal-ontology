        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mereteenistuse seadus (127 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mereteenistuse seadus"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_1_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatakse Eesti laevakinnistusraamatusse või laevapereta prahitud laevade registrisse kantud laevadel (edaspidi Eestis registreeritud laevad ) töötavate isikute töösuhtega seonduvad erisused. (2) Käesolevat seadust kohaldatakse § 3 lõikes 1 sätestatud laevapere liikmele. Muu isiku töösuhtele kohaldatakse käesolevat seadust seadusega ettenähtud juhtudel.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_1 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_1_v102072013048"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_1_v102072013048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatakse Eesti laevakinnistusraamatusse või laevapereta prahitud laevade registrisse kantud laevadel (edaspidi Eestis registreeritud laevad) töötavate isikute töösuhtega seonduvad erisused. (2) Käesolevat seadust kohaldatakse § 3 lõikes 1 sätestatud laevapere liikmele. Muu isiku töösuhtele kohaldatakse käesolevat seadust seadusega ettenähtud juhtudel.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_1 (redaktsioon 102072013048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013048"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_10_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder või muu tööandja võib meretöölepingu sõlmimiseks laevapere liikmelt nõuda järgmisi dokumente: isikut tõendav dokument; tööraamat; teenistusraamat või meresõidutunnistus; meresõidudiplom või kutsetunnistus nõutava kvalifikatsiooni ja hariduse kohta; tervisetõend; välismaalase puhul elamis- või tööluba; muud Veeteede Ameti poolt nõutavad kvalifikatsiooni tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_10 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_10_v13124337"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_10_v13124337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder või muu tööandja võib meretöölepingu sõlmimiseks laevapere liikmelt nõuda järgmisi dokumente: isikut tõendav dokument; Kehtetu – teenistusraamat või meresõidutunnistus; meresõidudiplom või kutsetunnistus nõutava kvalifikatsiooni ja hariduse kohta; tervisetõend; välismaalase puhul elamis- või tööluba; muud Veeteede Ameti poolt nõutavad kvalifikatsiooni tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_10 (redaktsioon 13124337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124337",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_10_v102072013048"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_10_v102072013048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder või muu tööandja võib meretöölepingu sõlmimiseks laevapere liikmelt nõuda järgmisi dokumente: isikut tõendav dokument; kehtetu - teenistusraamat või meresõidutunnistus; meresõidudiplom või kutsetunnistus nõutava kvalifikatsiooni ja hariduse kohta; tervisetõend; välismaalase puhul elamisluba; muud Veeteede Ameti poolt nõutavad kvalifikatsiooni tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_10 (redaktsioon 102072013048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013048"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_11_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui laevapere liige peab tööle asuma laeval, mis ei asu meretöölepingu sõlmimise kohas, peab reeder korraldama oma kulul laevapere liikme sõidu laeva asukohta ning tagama talle toidu ja majutuse kohalesõidu ajal.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_11 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_11_v13124337"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_11_v13124337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui laevapere liige asub tööle või lõpetab töö laeval, mis ei asu meretöölepingu sõlmimise kohas, peab reeder korraldama oma kulul laevapere liikme sõidu laeva asukohta või meretöölepingu sõlmimise kohta ning tagama talle toitlustamise ja majutuse laevale või laevalt sõidu ajal. (2) Käesoleva paragrahvi lõikes 1 nimetatud aja eest maksab reeder laevapere liikmele keskmist töötasu.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_11 (redaktsioon 13124337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124337"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_12_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liige on kohustatud: tegema meretöölepingus ja ametijuhendis ettenähtud tööd; osalema pääste- ja tuletõrjeharjutustes; täitma ilma erikorralduseta ülesandeid, mis tulenevad töö iseloomust või töö üldisest käigust; hoidma laeva ja sellel olevat vara; kandma tööajal reederi määratud töö- ja eririietust. (2) Laevapere liige peab täitma õigeaegselt ja täpselt kapteni või muu pädeva isiku seaduslikke korraldusi. (3) Laevapere liige peab täitma tööülesandeid meretöölepingus ettenähtud mahus ning järgima kehtestatud sisekorraeeskirju ja tööaega.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_12 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_13_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks käesoleva seaduse §-s 12 nimetatule on laevapere liige kohustatud järgima kapteni või muu pädeva isiku korraldusi, mis on vajalikud: laeval olevaid või teisi isikuid ähvardava ohu vältimiseks; laeva ohutuse tagamiseks; lasti riknemise või hävimise vältimiseks; teisi laevu ähvardava ohu vältimiseks. (2) Laevahuku korral on laevapere liige kohustatud osalema laeval olevate isikute ja laeva lasti päästmisel.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_13 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_14_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevapere liikmed käituvad üksteise suhtes usalduslikult ja vajaliku viisakusega, edendavad koostööd ning tagavad laeval korra ja ohutuse.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_14 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_15_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui meretöölepingus ei ole kokku lepitud teisiti, on laevapere liige kohustatud töötama üksnes lepingus märgitud laeval. (2) Laeva juhtkonda kuuluva isiku võib reeder oma ettevõtte piires ümber paigutada teisele laevale, säilitades talle vähemalt senised meretöölepinguga määratud töötingimused, kui ümberpaigutamine on ettevõtte töökorraldust arvestades vajalik ja meretöölepingus ei ole kokku lepitud teisiti.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_15 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_16_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ähvardava laevahuku või muu laeval olevaid isikuid ähvardava otsese ohu korral ei lahku laevapere liige laevalt ilma kapteni või teda asendava isiku loata.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_16 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_17_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liikmel on laeva sadamas või reidil seismise ajal õigus väljaspool oma tööaega kapteni või teda asendava isiku loal maale minna. Loa andmisest võib keelduda, kui kapteni või teda asendava isiku arvates on laevapere liikme laevale jäämine vajalik laeva, laeval oleva isiku või lasti ohutuse tagamiseks või laeva eelseisva väljumisega seotud töökohustuste täitmiseks. (2) Vajaduse korral peab kapten korraldama laevapere liikmete maalemineku viisil, mis ei takista tööd laeval ega ole seotud ebamõistlike kulutustega.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_17 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_18_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liige võib lahkuda laevalt ja nõuda reederilt töökoha muutmist, kui: laev, millel laevapere liige on kohustatud töötama, ei ole merekõlblik ja kapten ei täida oma kohustust kontrollida laeva merekõlblikkust vastavalt käesoleva seaduse §-s 33 sätestatule ning kavatseb väljuda sadamast; laevapere elamistingimused laeval ohustavad laevapere liikme elu või tervist ning reeder ei rakenda olukorra parandamiseks vajalikke abinõusid; laevapere liiget on laeval väärkoheldud ja kaptenil ei ole õnnestunud pakkuda talle kaitset, kuigi kaptenile on vastavatest asjaoludest teatatud; laev kaotab õiguse sõita Eesti lipu all; meretööleping on sõlmitud kindlaksmääratud reisiks ja laeva sõidu sihtkohta muudetakse; pärast töö alustamist laeval selgub, et laev võib sattuda võõrvõimu kontrolli alla või saada vigastada sõjapiirkonnas või et nimetatud oht on märgatavalt suurenenud; pärast töö alustamist laeval selgub, et sadam, kuhu on kavas suunduda, on kuulutatud epideemiapiirkonnaks. (2) Käesoleva paragrahvi lõikes 1 sätestatud juhtudel on laevapere liikmel õigus laevalt lahkuda enne sõidu algust või esimeses sadamas, kus laev sildub pärast nimetatud asjaoludest teadasaamist. (3) Kui laevapere liige käesoleva paragrahvi lõikes 1 sätestatud juhtudel lahkub laevalt, on reeder kohustatud korraldama oma kulul laevapere liikme kojusõidu vastavalt käesoleva seaduse §-s 57 sätestatule või paigutama laevapere liikme tööle muule laevale oma ettevõttes. Kui laevapere liige asub tööle muul laeval, hüvitab reeder laevapere liikmele laeva vahetamisega seotud kulud.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_18 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_19_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liige vastutab meretöölepingu rikkumise korral reederile süüliselt tekitatud kahju eest. (2) Laevapere liige, kes tööülesannete täitmisel on kerge hooletusega tekitanud reederile kahju, vastutab reederile tekitatud kahju eest kuni oma keskmise kuupalga ulatuses. (3) Laevapere liige, kes tööülesannete täitmisel on raske hooletusega tekitanud reederile kahju, vastutab reederile tekitatud kahju eest kuni oma kaheteistkümne keskmise kuupalga ulatuses. (4) Kui laevapere liige on tööülesannete täitmisel tekitanud reederile tahtlikult kahju, on ta kohustatud hüvitama reederile tekitatud kahju täies ulatuses. (5) Laevapere liikme süü tõendamise kohustus lasub reederil. Kui kahju tekkimises on süüdi nii reeder kui ka laevapere liige, vastutavad nad proportsionaalselt oma süü astmele.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_19 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_2_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Töösuhet reguleerivaid seadusi kohaldatakse käesoleva seaduse § 1 lõikes 2 nimetatud isikutele käesolevas seaduses sätestatud erisustega.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_2 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_20_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder on kohustatud: tagama kaptenile vajalike vahendite olemasolu seadusega ettenähtud kohustuste täitmiseks; tagama laevapere liikmele kokkulepitud töö ning andma selgelt ja õigeaegselt vajalikke korraldusi; maksma töö eest tasu meretöölepinguga kindlaksmääratud tingimustel ja ajal; tagama laeval ohutud töö- ja elamistingimused; tutvustama töölevõtmisel ja töötamise ajal laevapere liikmetele sisekorra-, tööohutus-, töötervishoiu-, keskkonna- ja tuleohutusnõudeid laeval ning töökeskkonna ohtlike ja kahjulike mõjurite taset töö- ja olmeruumides; andma ettenähtud puhkust ja maksma puhkusetasu; tagama töö- ja puhkeaja režiimi; täitma teisi seaduse, muu õigusakti ning kollektiivlepinguga ettenähtud kohustusi.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_20 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_20_v958309"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_20_v958309",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder on kohustatud: tagama kaptenile vajalike vahendite olemasolu seadusega ettenähtud kohustuste täitmiseks; [Punkti 2 sõnastus kuni 31.12. 2005] tagama laevapere liikmele kokkulepitud töö ning andma selgelt ja õigeaegselt vajalikke korraldusi; [Punkti 2 sõnastus alates 1. 01. 2006] tagama laevapere liikmele kokkulepitud töö ning laeval vajalike korralduste selge ja õigeaegse andmise; maksma töö eest tasu meretöölepinguga kindlaksmääratud tingimustel ja ajal; [Punkti 4 sõnastus kuni 31. 12. 2005] tagama laeval ohutud töö- ja elamistingimused; [Punkti 4 sõnastus alates 1. 01. 2006] tagama ohutud töö- ja elamistingimused ning tervisekaitsenõuete järgimise laeval; tutvustama töölevõtmisel ja töötamise ajal laevapere liikmetele sisekorra-, tööohutus-, töötervishoiu-, keskkonna- ja tuleohutusnõudeid laeval ning töökeskkonna ohtlike ja kahjulike mõjurite taset töö- ja olmeruumides; andma ettenähtud puhkust ja maksma puhkusetasu; [Punkti 7 sõnastus kuni 31. 12. 2005] tagama töö- ja puhkeaja režiimi; [Punkti 7 sõnastus alates 1. 01. 2006] tagama töö- ja puhkeaja korralduse nõuete järgimise laeval ning Tööinspektsiooni kohaliku asutuse juhatajale või tööinspektorile tema nõudmisel laevapere liikmete töö- ja puhkeaja arvestuse esitamise; täitma teisi seaduse, muu õigusakti ning kollektiivlepinguga ettenähtud kohustusi.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_20 (redaktsioon 958309)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "958309",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_20_v13124337"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_20_v13124337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder on kohustatud: tagama kaptenile vajalike vahendite olemasolu seadusega ettenähtud kohustuste täitmiseks; tagama laevapere liikmele kokkulepitud töö ning laeval vajalike korralduste selge ja õigeaegse andmise; maksma töö eest tasu meretöölepinguga kindlaksmääratud tingimustel ja ajal; tagama ohutud töö- ja elamistingimused ning tervisekaitsenõuete järgimise laeval; tutvustama töölevõtmisel ja töötamise ajal laevapere liikmetele sisekorra-, tööohutus-, töötervishoiu-, keskkonna- ja tuleohutusnõudeid laeval ning töökeskkonna ohtlike ja kahjulike mõjurite taset töö- ja olmeruumides; andma ettenähtud puhkust ja maksma puhkusetasu; tagama töö- ja puhkeaja korralduse nõuete järgimise laeval ning Tööinspektsiooni kohaliku asutuse juhatajale või tööinspektorile tema nõudmisel laevapere liikmete töö- ja puhkeaja arvestuse esitamise; täitma teisi seaduse, muu õigusakti ning kollektiivlepinguga ettenähtud kohustusi.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_20 (redaktsioon 13124337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13124337"
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_21_v26864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:mereteenistuse_seadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Töötasu arvestamise kohustus tekib alates laevapere liikme tööle asumise päevast. (2) Kui laev, millel laevapere liige peab tööle asuma, asub välisriigis ja meretöölepingu sõlmimine ei toimu laeva asukohas, tekib töötasu arvestamise kohustus laevale kohalesõidu alustamise hetkest, kui meretöölepingus ei ole kokku lepitud teisiti. § 22. Töötasu maksmise aja ja viisiga seonduvad erisused (1) Töötasu makstakse laevapere liikmele iga kuu lõpus, kui töötasu maksmiseks ei ole kokku lepitud lühemat tähtaega või muud tähtpäeva või kui muu tähtpäev ei ole määratud seaduse, meretöö- või kollektiivlepinguga . Töötasu maksmist sularahas võib laevapere liige nõuda üksnes laeva sadamas või reidil seismise ajal. (2) Laevapere liikme avalduse alusel kantakse töötasu üle laevapere liikme määratud pangaarvele. (3) Laevapere liikme nõusolekul võib töötasu maksta riigi valuutas, mille territoriaalvetes laev töötasunõude tekkimise ajal asub, või muus vabalt konverteeritavas valuutas. (4) Töötasu maksmisega seotud kulud kannab reeder. (5) Kui laevapere liikmete arv ettenägematu sündmuse tõttu reisi kestel väheneb ja seetõttu suureneb laevapere liikmete töökoormus, makstakse neile lisatasu laevapere vähenemise tõttu reederi poolt väljamaksmata töötasude arvel säästetud summa ulatuses.",
      "rdfs:label": {
        "@value": "mereteenistuse_seadus_Par_21 (redaktsioon 26864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26864",
      "estleg:supersededByVersion": {
        "@id": "estleg:mereteenistuse_seadus_Par_21_v695849"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:mereteenistuse_seadus_Par_21_v695849",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
