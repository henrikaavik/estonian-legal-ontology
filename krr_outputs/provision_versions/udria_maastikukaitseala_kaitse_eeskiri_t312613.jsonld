    },
    {
      "@id": "estleg:Reg_312613_Par_15_v312613",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312613_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liigiline ja vanuseline mitmekesisus; 2 2) puhtpuistute kujundamine ja energiapuistute rajamine; 3 3) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine metsamaal ja looduslikul rohumaal. Piiranguvööndis on keelatud: uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liigiline ja vanuseline mitmekesisus; puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine metsamaal ja looduslikul rohumaal.",
      "rdfs:label": {
        "@value": "Reg_312613_Par_15 (redaktsioon 312613)",
        "@language": "et"
      },
