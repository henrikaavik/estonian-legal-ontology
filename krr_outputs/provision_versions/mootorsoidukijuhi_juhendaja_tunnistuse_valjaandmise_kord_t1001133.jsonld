      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mootorsõidukijuhi juhendaja tunnistuse väljaandmise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mootorsõidukijuhi juhendaja tunnistuse väljaandmise kord"
    },
    {
      "@id": "estleg:Reg_1001133_Par_1_v1001133",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001133_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Mootorsõidukijuhi (edaspidi juht) juhendaja tunnistuse (edaspidi juhendaja tunnistus) taotleja peab esitama Maanteeametile juhendaja tunnistuse väljastamiseks: 1 1) isikut tõendava dokumendi; 2 2) juhiloa, kui liiklusregistris puuduvad andmed kehtiva juhiloa kohta; 3 3) juhi kehtiva tervisetõendi, välja arvatud kui juhi tervisetõendi andmed liiklusregistris on kehtivad ja juhi terviseseisund ei ole muutunud või kui tervisetõendi väljastaja on andmed esitanud elektrooniliselt liiklusregistrisse. RT I 2015-05-20 1 120052015001 2015-05-23 Mootorsõidukijuhi (edaspidi juht) juhendaja tunnistuse (edaspidi juhendaja tunnistus) taotleja peab esitama Maanteeametile juhendaja tunnistuse väljastamiseks: isikut tõendava dokumendi; juhiloa, kui liiklusregistris puuduvad andmed kehtiva juhiloa kohta; juhi kehtiva tervisetõendi, välja arvatud kui juhi tervisetõendi andmed liiklusregistris on kehtivad ja juhi terviseseisund ei ole muutunud või kui tervisetõendi väljastaja on andmed esitanud elektrooniliselt liiklusregistrisse. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud dokumendid võib esitada Maanteeameti e-teenuste infosüsteemi kaudu. RT I 2015-05-20 1 120052015001 2015-05-23 Käesoleva paragrahvi lõikes 1 nimetatud dokumendid võib esitada Maanteeameti e-teenuste infosüsteemi kaudu.",
      "rdfs:label": {
        "@value": "Reg_1001133_Par_1 (redaktsioon 1001133)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001133",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001133",
      "estleg:sourceAct": "Mootorsõidukijuhi juhendaja tunnistuse väljaandmise kord",
      "estleg:provisionRef": "Reg_1001133 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001133_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001133_Par_2_v1001133",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001133_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui taotleja vastab „Liiklusseaduse” § 109 lõike 2 punktides 1 ja 2 sätestatud tingimustele, väljastab Maanteeamet taotlejale juhendaja tunnistuse. Juhendaja tunnistus on määruse lisa kohane dokument. RT I 2015-04-22 1 122042015001 2015-04-25 Kui taotleja vastab „Liiklusseaduse” § 109 lõike 2 punktides 1 ja 2 sätestatud tingimustele, väljastab Maanteeamet taotlejale juhendaja tunnistuse. Juhendaja tunnistus on määruse lisa kohane dokument. 2 (2) Maanteeamet väljastab juhendaja tunnistuse või teatab taotleja nõuetele mittevastavusest ühe tööpäeva jooksul arvates §-s 1 sätestatud dokumentide ja andmete esitamise päevast. RT I 2015-04-22 1 122042015001 2015-04-25 Maanteeamet väljastab juhendaja tunnistuse või teatab taotleja nõuetele mittevastavusest ühe tööpäeva jooksul arvates §-s 1 sätestatud dokumentide ja andmete esitamise päevast. 3 (3) Kehtetu - RT I 2015-05-20 1 120052015001 2015-05-23 Kehtetu - 4 (4) Juhendaja tunnistus antakse välja kehtivusega üks aasta. Juhendaja tunnistus antakse välja kehtivusega üks aasta. 5 (5) Juhendaja tunnistusele kantakse kuni kolme juhendatava nimed. Juhendaja tunnistusele kantakse kuni kolme juhendatava nimed.",
      "rdfs:label": {
        "@value": "Reg_1001133_Par_2 (redaktsioon 1001133)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001133",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001133",
      "estleg:sourceAct": "Mootorsõidukijuhi juhendaja tunnistuse väljaandmise kord",
      "estleg:provisionRef": "Reg_1001133 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001133_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001133_Par_3_v1001133",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001133_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maanteeamet tunnistab juhendaja tunnistuse kehtetuks, kui selle andmise alus on ära langenud, tunnistus on antud alusetult, tunnistus või selles sisalduv kanne või andmed on võltsitud või on väljastatud uus juhendaja tunnistus. RT I 2015-04-22 1 122042015001 2015-04-25 Maanteeamet tunnistab juhendaja tunnistuse kehtetuks, kui selle andmise alus on ära langenud, tunnistus on antud alusetult, tunnistus või selles sisalduv kanne või andmed on võltsitud või on väljastatud uus juhendaja tunnistus.",
      "rdfs:label": {
        "@value": "Reg_1001133_Par_3 (redaktsioon 1001133)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001133",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001133",
      "estleg:sourceAct": "Mootorsõidukijuhi juhendaja tunnistuse väljaandmise kord",
      "estleg:provisionRef": "Reg_1001133 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001133_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001133_Par_4_v1001133",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001133_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhendaja tunnistusele kantakse järgmised andmed: 1 1) juhendaja kohta: juhendaja ees- ja perekonnanimi, juhendaja isikukood; 2 2) tunnistuse väljastamise kohta: tunnistust väljaandev asutus, väljaandeaeg, tunnistuse kehtivusaeg, lubatud mootorsõiduki kategooria; 3 3) juhendatava kohta: juhendatava nimi. RT I 2015-05-20 1 120052015001 2015-05-23 Juhendaja tunnistusele kantakse järgmised andmed: juhendaja kohta: juhendaja ees- ja perekonnanimi, juhendaja isikukood; tunnistuse väljastamise kohta: tunnistust väljaandev asutus, väljaandeaeg, tunnistuse kehtivusaeg, lubatud mootorsõiduki kategooria; juhendatava kohta: juhendatava nimi.",
      "rdfs:label": {
        "@value": "Reg_1001133_Par_4 (redaktsioon 1001133)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001133",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001133",
      "estleg:sourceAct": "Mootorsõidukijuhi juhendaja tunnistuse väljaandmise kord",
      "estleg:provisionRef": "Reg_1001133 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001133_Map_2026"
      }
    },
