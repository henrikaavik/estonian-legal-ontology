        "@value": "Sätete redaktsioonid: Liikumispuudega või pimedat inimest teenindava sõiduki parkimiskaardi vorm ja väljaandmise tingimused (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Liikumispuudega või pimedat inimest teenindava sõiduki parkimiskaardi vorm ja väljaandmise tingimused"
    },
    {
      "@id": "estleg:Reg_1000541_Par_1_v1000541",
