        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186729",
      "estleg:sourceAct": "Telekommunikatsiooniseadus",
      "estleg:provisionRef": "TeleKS § 17",
      "estleg:partOfAct": {
        "@id": "estleg:TeleKS_Map"
      }
    },
    {
      "@id": "estleg:TeleKS_Par_17_v193308",
      "@type": [
        "owl:NamedIndividual",
