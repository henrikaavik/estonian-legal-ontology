    {
      "@id": "estleg:TeleKS_Par_58_v782466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeleKS_Par_58"
      },
      "estleg:versionValidFrom": {
