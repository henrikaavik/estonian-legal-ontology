    {
      "@id": "estleg:TeleKS_Par_8_v28616",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeleKS_Par_8"
      },
      "estleg:versionValidFrom": {
