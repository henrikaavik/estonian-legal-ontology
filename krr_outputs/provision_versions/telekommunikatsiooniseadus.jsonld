    {
      "@id": "estleg:TeleKS_Par_61_v28616",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeleKS_Par_61"
      },
      "estleg:versionValidFrom": {
