      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liinirajatise planeerimine, projekteerimine, ehitamine ja hooldamine toimub planeerimis- ja ehitusseaduses ( RT I 1995, 59, 1006; 1996, 36, 738; 49, 953; 1999, 27, 380; 29, 398 ja 399; 95, 843) ning asjaõigusseaduses ( RT I 1993, 39, 590; 1999, 44, 509) sätestatud tingimustel ja korras. (2) Liinirajatise projekteerimisel ja ehitamisel on keelatud olemasolevale paralleelse liinirajatise loomine, välja arvatud juhul, kui olemasoleva maht on ammendatud ja seda ei ole tehniliselt võimalik vajaliku mahuni laiendada või tehnilistel põhjustel ei ole selle soovitud viisil kasutamine võimalik.",
      "rdfs:label": {
        "@value": "TeleKS_Par_90 (redaktsioon 28616)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "28616",
