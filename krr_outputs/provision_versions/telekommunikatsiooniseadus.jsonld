    },
    {
      "@id": "estleg:TeleKS_Par_72_v28616",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeleKS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Häirekaitsegarantii käesoleva seaduse mõistes on tehniliste nõuete kogum, millega tagatakse isikule võimalus konkreetse raadiovastuvõtuseadmega teatud raadiosignaali häireteta vastu võtta, kui on täidetud garantii andmise aluseks olnud tingimused. (2) Häirekaitsegarantiiga määratakse isiku poolt kasutatava raadiovastuvõtuseadme kohta vähemalt järgmised andmed: tehnilised näitajad; kasutuspiirkond või -koht; kasutusviis ja -otstarve; kasutusre¿iim; kasutatav raadiosageduskanal; raadiosageduse kasutamise tingimused; vajaduse korral kasutatava raadiovastuvõtuseadme tüüp. (3) Sideamet väljastab häirekaitsegarantii, pikendab seda ja muudab selle tingimusi ning tunnistab häirekaitsegarantii kehtetuks raadiosaateseadme paigaldamise loaga samadel alustel, tingimustel ja korras.",
      "rdfs:label": {
        "@value": "TeleKS_Par_72 (redaktsioon 28616)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "28616",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeleKS_Par_72_v186729"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/28616",
