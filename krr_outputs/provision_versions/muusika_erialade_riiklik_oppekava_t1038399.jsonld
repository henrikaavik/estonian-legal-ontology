      }
    },
    {
      "@id": "estleg:Reg_1038399_Par_21_v1038399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038399_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määruse § 20 lõike 2 punktides 1 ja 3–6 nimetatud moodulite õpiväljundite saavutamisel omandatakse kutsele „Rütmimuusik, tase 4” vastavad kompetentsid spetsialiseerumisega akordioni, viiuli, vioola, tšello, kontrabassi, kitarri, klaveri, löökpillide, trompeti, trombooni, klarneti, flöödi, saksofoni, oboe, fagoti või tuuba erialale. Käesoleva määruse § 20 lõike 2 punktides 1 ja 3–6 nimetatud moodulite õpiväljundite saavutamisel omandatakse kutsele „Rütmimuusik, tase 4” vastavad kompetentsid spetsialiseerumisega akordioni, viiuli, vioola, tšello, kontrabassi, kitarri, klaveri, löökpillide, trompeti, trombooni, klarneti, flöödi, saksofoni, oboe, fagoti või tuuba erialale. 2 (2) Käesoleva määruse § 20 lõike 2 punktides 2–6 nimetatud moodulite õpiväljundite saavutamisel omandatakse kutsele „Rütmimuusik, tase 4” vastavad kompetentsid spetsialiseerumisega laulu erialale. Käesoleva määruse § 20 lõike 2 punktides 2–6 nimetatud moodulite õpiväljundite saavutamisel omandatakse kutsele „Rütmimuusik, tase 4” vastavad kompetentsid spetsialiseerumisega laulu erialale.",
      "rdfs:label": {
        "@value": "Reg_1038399_Par_21 (redaktsioon 1038399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038399",
