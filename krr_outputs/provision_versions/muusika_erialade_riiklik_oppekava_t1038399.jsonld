    {
      "@id": "estleg:Reg_1038399_Par_17_v1038399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038399_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muusikateoreetiku eriala õppekava õppemaht on 240 EKAPd, mis jaguneb järgmiselt: 1 1) üldõpingud 30 EKAPd; 2 2) põhiõpingud 173 EKAPd, sealhulgas lõimitud võtmepädevuste õpe 30 EKAPd ja praktika 37 EKAPd; RT I 2020-04-30 1 130042020001 2020-05-03 3 3) valikõpingud 37 EKAPd. RT I 2020-04-30 1 130042020001 2020-05-03 Muusikateoreetiku eriala õppekava õppemaht on 240 EKAPd, mis jaguneb järgmiselt: üldõpingud 30 EKAPd; põhiõpingud 173 EKAPd, sealhulgas lõimitud võtmepädevuste õpe 30 EKAPd ja praktika 37 EKAPd; valikõpingud 37 EKAPd. 2 (2) Eriala põhiõpingute moodulid ja õppemaht on järgmine: 1 1) muusikateadus 45 EKAPd; 2 2) praktiline musitseerimine 18 EKAPd; 3 3) muusikateooria 35 EKAPd; 4 4) erialane muusikateooria 22 EKAPd; 5 5) muusika- ja kultuurilugu 30 EKAPd; 6 6) erialane keeleõpe 18 EKAPd; 7 7) õpitee ja töö muutuvas keskkonnas 5 EKAPd. RT I 2020-04-30 1 130042020001 2020-05-03 Eriala põhiõpingute moodulid ja õppemaht on järgmine: muusikateadus 45 EKAPd; praktiline musitseerimine 18 EKAPd; muusikateooria 35 EKAPd; erialane muusikateooria 22 EKAPd; muusika- ja kultuurilugu 30 EKAPd; erialane keeleõpe 18 EKAPd; õpitee ja töö muutuvas keskkonnas 5 EKAPd.",
      "rdfs:label": {
        "@value": "Reg_1038399_Par_17 (redaktsioon 1038399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038399",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038399",
      "estleg:sourceAct": "Muusika erialade riiklik õppekava",
      "estleg:provisionRef": "Reg_1038399 § 17",
