      "estleg:provisionRef": "EMHÜS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:EMHUS_Map"
      }
    },
    {
      "@id": "estleg:EMHUS_Par_4_v121062014022",
      "@type": [
        "owl:NamedIndividual",
