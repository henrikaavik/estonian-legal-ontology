{
  "@context": {
    "estleg": "https://data.riik.ee/ontology/estleg#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_vabariigi_pohiseadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti Vabariigi põhiseadus (180 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti Vabariigi põhiseadus"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_1_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti on iseseisev ja sõltumatu demokraatlik vabariik, kus kõrgeima riigivõimu kandja on rahvas. Eesti iseseisvus ja sõltumatus on aegumatu ning võõrandamatu.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_1 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_10_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis loetletud õigused, vabadused ja kohustused ei välista muid õigusi, vabadusi ega kohustusi, mis tulenevad põhiseaduse mõttest või on sellega kooskõlas ja vastavad inimväärikuse ning sotsiaalse ja demokraatliku õigusriigi põhimõtetele.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_10 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_100_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_100"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse liikmed võivad sõnaõigusega osaleda Riigikogu ja tema komisjonide istungitel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_100 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_101_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_101"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse liiget saab kriminaalvastutusele võtta ainult õiguskantsleri ettepanekul Riigikogu koosseisu enamuse nõusolekul. Valitsuse liiget süüdi mõistva kohtuotsuse jõustumisega lõpevad tema volitused.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_101 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_102_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_102"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusi võetakse vastu kooskõlas põhiseadusega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_102 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_103_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduste algatamise õigus on: Riigikogu liikmel; Riigikogu fraktsioonil; Riigikogu komisjonil; Vabariigi Valitsusel; Vabariigi Presidendil põhiseaduse muutmiseks. Riigikogul on õigus koosseisu häälteenamusega tehtud otsuse alusel pöörduda Vabariigi Valitsuse poole ettepanekuga algatada Riigikogu poolt soovitav eelnõu.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_103 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_104_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduste vastuvõtmise korra sätestab Riigikogu kodukorra seadus. Ainult Riigikogu koosseisu häälteenamusega saab vastu võtta ja muuta järgmisi seadusi: kodakondsuse seadus; Riigikogu valimise seadus; Vabariigi Presidendi valimise seadus; kohaliku omavalitsuse valimise seadus; rahvahääletuse seadus; Riigikogu kodukorra seadus ja Riigikogu töökorra seadus; Vabariigi Presidendi ja Riigikogu liikmete tasu seadus; Vabariigi Valitsuse seadus; Vabariigi Presidendi ja Vabariigi Valitsuse liikmete kohtulikule vastutusele võtmise seadus; vähemusrahvuste kultuurautonoomia seadus; riigieelarve seadus; Eesti Panga seadus; riigikontrolli seadus; kohtukorralduse seadus ja kohtumenetluse seadused; välis- ja siselaenudesse ning riigi varalistesse kohustustesse puutuvad seadused; erakorralise seisukorra seadus; rahuaja riigikaitse seadus ja sõjaaja riigikaitse seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_104 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_105_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogul on õigus panna seaduseelnõu või muu riigielu küsimus rahvahääletusele. Rahva otsus tehakse hääletamisest osavõtnute häälteenamusega. Rahvahääletusel vastuvõetud seaduse kuulutab Vabariigi President viivitamatult välja. Rahvahääletuse otsus on riigiorganitele kohustuslik. Kui rahvahääletusele pandud seaduseelnõu ei saa poolthäälte enamust, kuulutab Vabariigi President välja Riigikogu erakorralised valimised.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_105 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_106_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_106"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvahääletusele ei saa panna eelarve, maksude, riigi rahaliste kohustuste, välislepingute ratifitseerimise ja denonsseerimise, erakorralise seisukorra kehtestamise ja lõpetamise ning riigikaitse küsimusi. Rahvahääletuse korra sätestab rahvahääletuse seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_106 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_107_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadused kuulutab välja Vabariigi President. Vabariigi President võib jätta Riigikogu poolt vastuvõetud seaduse välja kuulutamata ja saata selle koos motiveeritud otsusega neljateistkümne päeva jooksul, arvates saamise päevast, Riigikogule uueks arutamiseks ja otsustamiseks. Kui Riigikogu võtab Vabariigi Presidendi poolt tagasi saadetud seaduse muutmata kujul uuesti vastu, kuulutab Vabariigi President seaduse välja või pöördub Riigikohtu poole ettepanekuga tunnistada seadus põhiseadusega vastuolus olevaks. Kui Riigikohus tunnistab seaduse põhiseadusega kooskõlas olevaks, kuulutab Vabariigi President seaduse välja.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_107 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_108_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist, kui seaduses eneses ei sätestata teist tähtaega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_108 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_109_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Riigikogu ei saa kokku tulla, võib Vabariigi President edasilükkamatute riiklike vajaduste korral anda seaduse jõuga seadlusi, mis kannavad Riigikogu esimehe ja peaministri kaasallkirja. Kui Riigikogu on kokku tulnud, esitab Vabariigi President seadlused Riigikogule, kes võtab viivitamatult vastu nende kinnitamise või tühistamise seaduse.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_109 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_11_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigusi ja vabadusi tohib piirata ainult kooskõlas põhiseadusega. Need piirangud peavad olema demokraatlikus ühiskonnas vajalikud ega tohi moonutada piiratavate õiguste ja vabaduste olemust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_11 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_110_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_110"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi seadlusega ei saa kehtestada, muuta ega tühistada põhiseadust ega põhiseaduse §-s 104 loetletud seadusi, riiklikke makse kehtestavaid seadusi ega riigieelarvet.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_110 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_111_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti raha emissiooni ainuõigus on Eesti Pangal. Eesti Pank korraldab raharinglust ja seisab hea riigi vääringu stabiilsuse eest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_111 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_112_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Pank tegutseb seaduse alusel ja annab aru Riigikogule.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_112 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_113_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikud maksud, koormised, lõivud, trahvid ja sundkindlustuse maksed sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_113 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_114_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi vara valdamise, kasutamise ja käsutamise korra sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_114 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_115_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_115"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Iga aasta kohta võtab Riigikogu seadusena vastu riigi kõigi tulude ja kulude eelarve. Vabariigi Valitsus esitab riigieelarve eelnõu Riigikogule hiljemalt kolm kuud enne eelarveaasta algust. Valitsuse ettepanekul võib Riigikogu eelarveaasta kestel vastu võtta lisaeelarve.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_115 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_116_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarve või selle eelnõu muutmise ettepanekule, mis tingib nendes ettenähtud tulude vähendamise, kulude suurendamise või kulude ümberjaotamise, tuleb algatajal lisada rahalised arvestused, mis näitavad ära kulude katteks vajalikud tuluallikad. Riigikogu ei tohi kustutada ega vähendada riigieelarvesse või selle eelnõusse võetud kulusid, mis on ette nähtud muude seadustega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_116 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_117_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigieelarve koostamise ja vastuvõtmise korra sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_117 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_118_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu poolt vastuvõetud riigieelarve jõustub eelarveaasta algusest. Kui Riigikogu ei võta riigieelarvet eelarveaasta alguseks vastu, võib iga kuu teha kulutusi ühe kaheteistkümnendikuni eelmise eelarveaasta kulutustest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_118 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_119_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Riigikogu ei ole riigieelarvet vastu võtnud kahe kuu jooksul pärast eelarveaasta algust, kuulutab Vabariigi President välja Riigikogu erakorralised valimised.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_119 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_12_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõik on seaduse ees võrdsed. Kedagi ei tohi diskrimineerida rahvuse, rassi, nahavärvuse, soo, keele, päritolu, usutunnistuse, poliitiliste või muude veendumuste, samuti varalise ja sotsiaalse seisundi või muude asjaolude tõttu. Rahvusliku, rassilise, usulise või poliitilise vihkamise, vägivalla ja diskrimineerimise õhutamine on seadusega keelatud ja karistatav. Samuti on seadusega keelatud ja karistatav õhutada vihkamist, vägivalda ja diskrimineerimist ühiskonnakihtide vahel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_12 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_120_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_120"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi suhtlemise korra teiste riikide ja rahvusvaheliste organisatsioonidega sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_120 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_121_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu ratifitseerib ja denonsseerib Eesti Vabariigi lepingud: mis muudavad riigipiire; mille rakendamiseks on tarvis Eesti seaduste vastuvõtmist, muutmist või tühistamist; mille kohaselt Eesti Vabariik ühineb rahvusvaheliste organisatsioonide või liitudega; millega Eesti Vabariik võtab endale sõjalisi või varalisi kohustusi; milles ratifitseerimine on ette nähtud.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_121 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_122_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti maismaapiir on määratud 1920. aasta 2. veebruari Tartu rahulepinguga ja teiste riikidevaheliste piirilepingutega. Eesti mere- ja õhupiir määratakse rahvusvaheliste konventsioonide alusel. Eesti riigipiire muutvate lepingute ratifitseerimiseks on nõutav Riigikogu koosseisu kahekolmandikuline häälteenamus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_122 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_123_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariik ei sõlmi välislepinguid, mis on vastuolus põhiseadusega. Kui Eesti seadused või muud aktid on vastuolus Riigikogu poolt ratifitseeritud välislepingutega, kohaldatakse välislepingu sätteid.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_123 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_124_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_124"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti kodanikud on kohustatud osa võtma riigikaitsest seaduse sätestatud alustel ja korras. Usulistel või kõlbelistel põhjustel kaitseväeteenistusest keelduja on kohustatud läbi tegema asendusteenistuse seaduses ettenähtud korras. Kui seadus ei näe teenistuse erilaadi huvides ette teisiti, on kaitseväes ja asendusteenistuses olevatel isikutel kõik põhiseaduslikud õigused, vabadused ja kohustused. Piirata ei tohi põhiseaduse §-des 8 lõiked 3 ja 4, 11-18, 20 lõige 3, 21-28, 32, 33, 36-43, 44 lõiked 1 ja 2 ning 49-51 ettenähtud õigusi ja vabadusi. Kaitseväes ja asendusteenistuses olevate isikute õigusliku seisundi sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_124 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_125_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_125"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevteenistuses olev isik ei tohi olla muus valitavas ega nimetatavas ametis ega osa võtta ühegi erakonna tegevusest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_125 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_126_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_126"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikaitse korralduse sätestavad rahuaja riigikaitse seadus ja sõjaaja riigikaitse seadus. Eesti kaitseväe ja riigikaitseorganisatsioonide korralduse sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_126 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_127_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_127"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikaitse kõrgeimaks juhiks on Vabariigi President. Vabariigi Presidendi juures on nõuandva organina Riigikaitse Nõukogu, kelle koosseisu ja ülesandeid sätestab seadus. Eesti kaitseväge ja riigikaitseorganisatsioone juhib rahuajal kaitseväe juhataja, sõjaajal kaitseväe ülemjuhataja. Kaitseväe juhataja ja ülemjuhataja nimetab ametisse ning vabastab ametist Riigikogu Vabariigi Presidendi ettepanekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_127 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_127_v127042011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_127_v127042011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_127"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikaitse kõrgeimaks juhiks on Vabariigi President. Vabariigi Presidendi juures on nõuandva organina Riigikaitse Nõukogu, kelle koosseisu ja ülesandeid sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_127 (redaktsioon 127042011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127042011002"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_128_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu kuulutab Vabariigi Presidendi ettepanekul välja sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning otsustab kaitseväe kasutamise Eesti riigi rahvusvaheliste kohustuste täitmisel. Eesti Vabariigi vastu suunatud agressiooni korral kuulutab Vabariigi President välja sõjaseisukorra ja mobilisatsiooni ning nimetab kaitseväe ülemjuhataja, ootamata ära Riigikogu otsust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_128 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_128_v127042011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_128_v127042011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_128"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu kuulutab Vabariigi Presidendi ettepanekul välja sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning otsustab kaitseväe kasutamise Eesti riigi rahvusvaheliste kohustuste täitmisel. Eesti Vabariigi vastu suunatud agressiooni korral kuulutab Vabariigi President välja sõjaseisukorra ja mobilisatsiooni, ootamata ära Riigikogu otsust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_128 (redaktsioon 127042011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127042011002"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_129_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_129"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti põhiseaduslikku korda ähvardava ohu puhul võib Riigikogu Vabariigi Presidendi või Vabariigi Valitsuse ettepanekul oma koosseisu häälteenamusega välja kuulutada erakorralise seisukorra kogu riigis, kuid kõige kauem kolmeks kuuks. Erakorralise seisukorra korralduse sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_129 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_13_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus riigi ja seaduse kaitsele. Eesti riik kaitseb oma kodanikku ka välisriikides. Seadus kaitseb igaühte riigivõimu omavoli eest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_13 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_130_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_130"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erakorralise või sõjaseisukorra ajal võib riigi julgeoleku ja avaliku korra huvides seadusega ettenähtud juhtudel ja korras piirata isikute õigusi ja vabadusi ning panna neile kohustusi. Piirata ei tohi õigusi ja vabadusi, mis on sätestatud põhiseaduse §-des 8, 11-18, 20 lõige 3, 22, 23, 24 lõiked 2 ja 4, 25, 27, 28, 36 lõige 2, 40, 41, 49 ja 51 lõige 1.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_130 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_131_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_131"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erakorralise või sõjaseisukorra ajal ei valita Riigikogu, Vabariigi Presidenti ega kohalike omavalitsuste esinduskogusid ega lõpetata ka nende volitusi. Riigikogu, Vabariigi Presidendi ja kohaliku omavalitsuse esinduskogude volitused pikenevad, kui nad lõpeksid erakorralise või sõjaseisukorra ajal või kolme kuu jooksul, arvates erakorralise või sõjaseisukorra lõppemisest. Nendel juhtudel kuulutatakse välja uued valimised kolme kuu jooksul, arvates erakorralise või sõjaseisukorra lõppemisest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_131 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_132_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_132"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontroll on oma tegevuses sõltumatu majanduskontrolli teostav riigiorgan.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_132 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_133_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontroll kontrollib: riigiasutuste, riigiettevõtete ja muude riiklike organisatsioonide majandustegevust; riigi vara kasutamist ja säilimist; kohalike omavalitsuste valdusse antud riigivara kasutamist ja käsutamist; nende ettevõtete majandustegevust, kus riigil on üle poole osakute või aktsiatega määratud häältest või kelle laene või lepinguliste kohustuste täitmist tagab riik.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_133 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_134_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolli juhib riigikontrolör, kelle nimetab ametisse ja vabastab ametist Riigikogu Vabariigi Presidendi ettepanekul. Riigikontrolöri volituste kestus on viis aastat.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_134 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_135_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_135"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolör esitab Riigikogule ülevaate riigi vara kasutamise ja säilimise kohta eelmisel eelarveaastal üheaegselt riigieelarve täitmise aruande arutamisega Riigikogus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_135 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_136_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_136"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolör võib oma ülesannetesse kuuluvais asjus võtta sõnaõigusega osa Vabariigi Valitsuse istungitest. Riigikontrolöril on oma ametkonna juhina samad õigused, mis on seadusega antud ministrile ministeeriumi juhina.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_136 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_137_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_137"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolli korralduse sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_137 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_138_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_138"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikontrolöri saab kriminaalvastutusele võtta ainult õiguskantsleri ettepanekul Riigikogu koosseisu enamuse nõusolekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_138 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_139_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_139"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsler on oma tegevuses sõltumatu ametiisik, kes teostab järelevalvet seadusandliku ja täidesaatva riigivõimu ning kohaliku omavalitsuse õigustloovate aktide põhiseadusele ja seadustele vastavuse üle. Õiguskantsler analüüsib seaduste muutmise, uute seaduste vastuvõtmise ja riigiasutuste töö kohta talle tehtud ettepanekuid ning esitab vajaduse korral Riigikogule ettekande. Õiguskantsler teeb Riigikogule põhiseaduse §-des 76, 85, 101, 138, 153 ettenähtud juhtudel ettepaneku Riigikogu liikme, Vabariigi Presidendi, Vabariigi Valitsuse liikme, riigikontrolöri, Riigikohtu esimehe või Riigikohtu liikme kriminaalvastutusele võtmiseks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_139 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_14_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguste ja vabaduste tagamine on seadusandliku, täidesaatva ja kohtuvõimu ning kohalike omavalitsuste kohustus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_14 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_140_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsleri nimetab ametisse Riigikogu Vabariigi Presidendi ettepanekul seitsmeks aastaks. Õiguskantslerit saab ametist tagandada üksnes kohtuotsusega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_140 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_141_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsleril on oma kantselei juhtimisel samad õigused, mis on seadusega antud ministrile ministeeriumi juhtimiseks. Õiguskantsler võib sõnaõigusega osa võtta Riigikogu ja Vabariigi Valitsuse istungitest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_141 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_142_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui õiguskantsler leiab, et seadusandliku või täidesaatva riigivõimu või kohaliku omavalitsuse õigustloov akt on põhiseaduse või seadusega vastuolus, teeb ta akti vastuvõtnud organile ettepaneku viia see kahekümne päeva jooksul põhiseaduse või seadusega kooskõlla. Kui akt ei ole kahekümne päeva jooksul põhiseaduse või seadusega kooskõlla viidud, teeb õiguskantsler Riigikohtule ettepaneku tunnistada see akt kehtetuks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_142 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_143_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_143"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsler esitab kord aastas Riigikogule ülevaate seadusandliku ja täidesaatva riigivõimu ning kohalike omavalitsuste õigustloovate aktide kooskõlast põhiseaduse ja seadustega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_143 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_144_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsleri õigusliku seisundi ja tema kantselei töökorralduse sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_144 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_145_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantslerit saab kriminaalvastutusele võtta ainult Vabariigi Presidendi ettepanekul Riigikogu koosseisu enamuse nõusolekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_145 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_146_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigust mõistab ainult kohus. Kohus on oma tegevuses sõltumatu ja mõistab õigust kooskõlas põhiseaduse ja seadustega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_146 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_147_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikud nimetatakse ametisse eluaegsetena. Kohtunike ametist vabastamise alused ja korra sätestab seadus. Kohtunikku saab ametist tagandada üksnes kohtuotsusega. Kohtunikud ei tohi peale seaduses ettenähtud juhtude olla üheski muus valitavas ega nimetatavas ametis. Kohtunike sõltumatuse tagatised ja õigusliku seisundi sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_147 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_148_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtusüsteem koosneb: maa- ja linnakohtutest ning halduskohtutest; ringkonnakohtutest; Riigikohtust. Erikohtute loomise mõnda liiki kohtuasjade jaoks sätestab seadus. Erakorraliste kohtute moodustamine on keelatud.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_148 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_149_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maa- ja linnakohtud ning halduskohtud on esimese astme kohtud. Ringkonnakohtud on teise astme kohtud ning nad vaatavad apellatsiooni korras läbi esimese astme kohtu lahendeid. Riigikohus on riigi kõrgeim kohus, kes vaatab kohtulahendeid läbi kassatsiooni korras. Riigikohus on ühtlasi põhiseadusliku järelevalve kohus. Kohtukorralduse ja kohtumenetluse korra sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_149 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_15_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus pöörduda oma õiguste ja vabaduste rikkumise korral kohtusse. Igaüks võib oma kohtuasja läbivaatamisel nõuda mis tahes asjassepuutuva seaduse, muu õigusakti või toimingu põhiseadusevastaseks tunnistamist. Kohus järgib põhiseadust ja tunnistab põhiseadusevastaseks mis tahes seaduse, muu õigusakti või toimingu, mis rikub põhiseaduses sätestatud õigusi ja vabadusi või on muul viisil põhiseadusega vastuolus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_15 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_150_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_150"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikohtu esimehe nimetab ametisse Riigikogu Vabariigi Presidendi ettepanekul. Riigikohtu liikmed nimetab ametisse Riigikogu Riigikohtu esimehe ettepanekul. Muud kohtunikud nimetab ametisse Vabariigi President Riigikohtu ettepanekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_150 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_151_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Esinduse, kaitse, riikliku süüdistuse ja seaduslikkuse järelevalve korralduse kohtumenetluses sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_151 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_152_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_152"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus jätab kohtuasja lahendamisel kohaldamata mis tahes seaduse või muu õigusakti, kui see on vastuolus põhiseadusega. Riigikohus tunnistab kehtetuks mis tahes seaduse või muu õigusakti, kui see on vastuolus põhiseaduse sätte ja mõttega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_152 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_153_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_153"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunikku saab ametisoleku ajal kriminaalvastutusele võtta ainult Riigikohtu ettepanekul Vabariigi Presidendi nõusolekul. Riigikohtu esimeest ja liikmeid saab kriminaalvastutusele võtta ainult õiguskantsleri ettepanekul Riigikogu koosseisu enamuse nõusolekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_153 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_154_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõiki kohaliku elu küsimusi otsustavad ja korraldavad kohalikud omavalitsused, kes tegutsevad seaduste alusel iseseisvalt. Kohalikule omavalitsusele võib panna kohustusi ainult seaduse alusel või kokkuleppel kohaliku omavalitsusega. Seadusega kohalikule omavalitsusele pandud riiklike kohustustega seotud kulud kaetakse riigieelarvest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_154 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_155_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_155"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksused on vallad ja linnad. Muid kohaliku omavalitsuse üksusi võib moodustada seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_155 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse esinduskoguks on volikogu, kes valitakse vabadel valimistel kolmeks aastaks. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Kohaliku omavalitsuse volikogu valimistel on seaduses ettenähtud tingimustel hääleõiguslikud selle omavalitsuse maa-alal püsivalt elavad isikud, kes on vähemalt kaheksateist aastat vanad.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_156 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v633949"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v633949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Paragrahvi 156 lõike 1 sõnastus kuni 16.10.2005] Kohaliku omavalitsuse esinduskoguks on volikogu, kes valitakse vabadel valimistel kolmeks aastaks. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. [Lõike 1 sõnastus alates 17.10.2005]Kohaliku omavalitsuse esinduskogu on volikogu, kes valitakse vabadel valimistel neljaks aastaks. Seadusega võib volikogu volituste perioodi lühendada seoses kohaliku omavalitsuse üksuste ühinemise või jagunemisega või volikogu tegutsemisvõimetusega. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Kohaliku omavalitsuse volikogu valimistel on seaduses ettenähtud tingimustel hääleõiguslikud selle omavalitsuse maa-alal püsivalt elavad isikud, kes on vähemalt kaheksateist aastat vanad.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_156 (redaktsioon 633949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "633949",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v12846827"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v12846827",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse esinduskogu on volikogu, kes valitakse vabadel valimistel neljaks aastaks. Seadusega võib volikogu volituste perioodi lühendada seoses kohaliku omavalitsuse üksuste ühinemise või jagunemisega või volikogu tegutsemisvõimetusega. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Kohaliku omavalitsuse volikogu valimistel on seaduses ettenähtud tingimustel hääleõiguslikud selle omavalitsuse maa-alal püsivalt elavad isikud, kes on vähemalt kaheksateist aastat vanad.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_156 (redaktsioon 12846827)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12846827",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v115052015002"
      },
      "estleg:versionValidTo": {
        "@value": "2015-08-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v115052015002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse esinduskogu on volikogu, kes valitakse vabadel valimistel neljaks aastaks. Seadusega võib volikogu volituste perioodi lühendada seoses kohaliku omavalitsuse üksuste ühinemise või jagunemisega või volikogu tegutsemisvõimetusega. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Kohaliku omavalitsuse volikogu valimistel on seaduses ettenähtud tingimustel hääleõiguslikud selle omavalitsuse maa-alal püsivalt elavad isikud, kes on vähemalt kuusteist aastat vanad.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_156 (redaktsioon 115052015002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115052015002",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v111042025002"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v111042025002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse esinduskogu on volikogu, kes valitakse vabadel valimistel neljaks aastaks. Seadusega võib volikogu volituste perioodi lühendada seoses kohaliku omavalitsuse üksuste ühinemise või jagunemisega või volikogu tegutsemisvõimetusega. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Kohaliku omavalitsuse volikogu valimistel on seaduses ettenähtud tingimustel hääleõiguslikud selle omavalitsuse maa-alal püsivalt elavad Eesti kodanikud ja kodakondsuseta isikud, kes on vähemalt kuusteist aastat vanad.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_156 (redaktsioon 111042025002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111042025002",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v111042025003"
      },
      "estleg:versionValidTo": {
        "@value": "2026-03-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156_v111042025003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_156"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse esinduskogu on volikogu, kes valitakse vabadel valimistel neljaks aastaks. Seadusega võib volikogu volituste perioodi lühendada seoses kohaliku omavalitsuse üksuste ühinemise või jagunemisega või volikogu tegutsemisvõimetusega. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Kohaliku omavalitsuse volikogu valimistel on seaduses ettenähtud tingimustel hääleõiguslikud selle omavalitsuse maa-alal püsivalt elavad Eesti kodanikud, kes on vähemalt kuusteist aastat vanad.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_156 (redaktsioon 111042025003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111042025003"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_157_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_157"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalikul omavalitsusel on iseseisev eelarve, mille kujundamise alused ja korra sätestab seadus. Kohalikul omavalitsusel on seaduse alusel õigus kehtestada ja koguda makse ning panna peale koormisi.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_157 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_158_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_158"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksuste piire ei tohi muuta vastavate omavalitsuste arvamust ära kuulamata.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_158 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_159_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_159"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalikul omavalitsusel on õigus moodustada teiste kohalike omavalitsustega liite ja ühisasutusi.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_159 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_16_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus elule. Seda õigust kaitseb seadus. Meelevaldselt ei tohi kelleltki elu võtta.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_16 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_160_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_160"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalike omavalitsuste korralduse ja järelevalve nende tegevuse üle sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_160 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_161_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_161"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus algatada põhiseaduse muutmist on vähemalt viiendikul Riigikogu koosseisust ja Vabariigi Presidendil. Põhiseaduse muutmist ei saa algatada ega põhiseadust muuta erakorralise seisukorra ega sõjaseisukorra ajal.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_161 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_162_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_162"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse I peatükki \"Üldsätted\" ja XV peatükki \"Põhiseaduse muutmine\" saab muuta ainult rahvahääletusega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_162 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_163_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_163"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseadust saab muuta seadusega, mis on vastu võetud: rahvahääletusel; Riigikogu kahe järjestikuse koosseisu poolt; Riigikogu poolt kiireloomulisena. Põhiseaduse muutmise seaduse eelnõu arutatakse Riigikogus kolmel lugemisel, kusjuures esimese ja teise lugemise vahet on vähemalt kolm kuud ning teise ja kolmanda lugemise vahet vähemalt üks kuu. Põhiseaduse muutmise viis otsustatakse kolmandal lugemisel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_163 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_164_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_164"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmise seaduse eelnõu rahvahääletusele panekuks on nõutav Riigikogu koosseisu kolmeviiendikuline häälteenamus. Rahvahääletus toimub kõige varem kolme kuu pärast, arvates sellekohase otsuse vastuvõtmisest Riigikogus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_164 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_165_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_165"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmiseks Riigikogu kahe järjestikuse koosseisu poolt peab põhiseaduse muutmise seaduse eelnõu saama Riigikogu koosseisu enamuse toetuse. Kui Riigikogu järgmine koosseis võtab esimesel lugemisel oma koosseisu kolmeviiendikulise häälteenamusega muutmatult vastu põhiseaduse muutmise seaduse eelnõu, mis sai eelmise koosseisu enamuse toetuse, siis on põhiseaduse muutmise seadus vastu võetud.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_165 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_166_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_166"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Otsus põhiseaduse muutmise seaduse eelnõu käsitlemiseks kiireloomulisena võetakse vastu Riigikogu neljaviiendikulise häälteenamusega. Põhiseaduse muutmise seadus võetakse sel juhul vastu Riigikogu koosseisu kahekolmandikulise häälteenamusega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_166 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_167_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_167"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmise seaduse kuulutab välja Vabariigi President ja see jõustub seaduses eneses määratud tähtajal, kuid mitte varem kui kolm kuud pärast väljakuulutamist.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_167 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmist ei saa samas küsimuses algatada ühe aasta jooksul, arvates vastava eelnõu tagasilükkamisest rahvahääletusel või Riigikogus. Õiend 25.06.2007 17:40 Käesolev tekst vastab 28. mail 1992. aastal rahvahääletusele pandud ja ajalehes «Rahva Hääl» avaldatud Eesti Vabariigi põhiseaduse eelnõu tekstile. Vastavalt riigisekretäri 19. juuni 2007. a resolutsioonile nr 07-02990 on parandatud vead seni elektroonilises Riigi Teatajas avaldatud Eesti Vabariigi põhiseaduse tekstides. «Rahva Hääles» avaldatud tekstiga võrreldes on parandatud viis ilmset trükiviga. Paragrahvis 53 on välja jäetud sõnade kordus «keskkonnale tekitatud», § 60 lõikes 5 on sõna «Riigikoguvalimise» lahku kirjutatud ning erinevalt «Rahva Hääles» ilmunud tekstist on § 64 lõikes 3 ja §-s 70 Riigikogu kirjutatud suure algustähega ja § 78 punktis 3 põhiseadus kirjutatud väikese algustähega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_168 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168_v633949"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168_v633949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmist ei saa samas küsimuses algatada ühe aasta jooksul, arvates vastava eelnõu tagasilükkamisest rahvahääletusel või Riigikogus. Õiend 25.06.2007 18:00 Käesolev tekst vastab 28. mail 1992. aastal rahvahääletusele pandud ja ajalehes «Rahva Hääl» avaldatud Eesti Vabariigi põhiseaduse eelnõu tekstile. Vastavalt riigisekretäri 19. juuni 2007. a resolutsioonile nr 07-02990 on parandatud vead seni elektroonilises Riigi Teatajas avaldatud Eesti Vabariigi põhiseaduse tekstides. «Rahva Hääles» avaldatud tekstiga võrreldes on parandatud viis ilmset trükiviga. Paragrahvis 53 on välja jäetud sõnade kordus «keskkonnale tekitatud», § 60 lõikes 5 on sõna «Riigikoguvalimise» lahku kirjutatud ning erinevalt «Rahva Hääles» ilmunud tekstist on § 64 lõikes 3 ja §-s 70 Riigikogu kirjutatud suure algustähega ja § 78 punktis 3 põhiseadus kirjutatud väikese algustähega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_168 (redaktsioon 633949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "633949",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168_v12846827"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168_v12846827",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduse muutmist ei saa samas küsimuses algatada ühe aasta jooksul, arvates vastava eelnõu tagasilükkamisest rahvahääletusel või Riigikogus. Õiend Käesolev tekst vastab 28. mail 1992. aastal rahvahääletusele pandud ja ajalehes «Rahva Hääl» avaldatud Eesti Vabariigi põhiseaduse eelnõu tekstile. Vastavalt riigisekretäri 19. juuni 2007. a resolutsioonile nr 07-02990 on parandatud vead seni elektroonilises Riigi Teatajas avaldatud Eesti Vabariigi põhiseaduse tekstides. «Rahva Hääles» avaldatud tekstiga võrreldes on parandatud viis ilmset trükiviga. Paragrahvis 53 on välja jäetud sõnade kordus «keskkonnale tekitatud», § 60 lõikes 5 on sõna «Riigikoguvalimise» lahku kirjutatud ning erinevalt «Rahva Hääles» ilmunud tekstist on § 64 lõikes 3 ja §-s 70 Riigikogu kirjutatud suure algustähega ja § 78 punktis 3 põhiseadus kirjutatud väikese algustähega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_168 (redaktsioon 12846827)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12846827"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_17_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kellegi au ega head nime ei tohi teotada.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_17 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_18_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kedagi ei tohi piinata, julmalt või väärikust alandavalt kohelda ega karistada. Kedagi ei tohi tema vaba tahte vastaselt allutada meditsiini- ega teaduskatsetele.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_18 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_19_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus vabale eneseteostusele. Igaüks peab oma õiguste ja vabaduste kasutamisel ning kohustuste täitmisel austama ja arvestama teiste inimeste õigusi ja vabadusi ning järgima seadust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_19 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_2_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti riigi maa-ala, territoriaalveed ja õhuruum on lahutamatu ja jagamatu tervik. Eesti on riiklikult korralduselt ühtne riik, mille territooriumi haldusjaotuse sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_2 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_20_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus vabadusele ja isikupuutumatusele. Vabaduse võib võtta ainult seaduses sätestatud juhtudel ja korras: süüdimõistva kohtuotsuse või kohtu poolt määratud aresti täitmiseks; kohtu korralduse täitmata jätmise korral või seadusega sätestatud kohustuse täitmise tagamiseks; kuriteo või haldusõiguserikkumise ärahoidmiseks, sellises õiguserikkumises põhjendatult kahtlustatava toimetamiseks pädeva riigiorgani ette või tema pakkumineku vältimiseks; alaealise üle kasvatusliku järelevalve sisseseadmiseks või tema toimetamiseks pädeva riigiorgani ette, et otsustada sellise järelevalve sisseseadmine; nakkushaige, vaimuhaige, alkohooliku või narkomaani kinnipidamiseks, kui ta on endale või teistele ohtlik; ebaseadusliku Eestisse asumise tõkestamiseks ning Eestist väljasaatmiseks või välisriigile väljaandmiseks. Kelleltki ei tohi võtta vabadust üksnes sel põhjusel, et ta ei ole suuteline täitma mingit lepingulist kohustust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_20 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_21_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühele, kellelt on võetud vabadus, teatatakse viivitamatult talle arusaadavas keeles ja viisil vabaduse võtmise põhjus ja tema õigused ning antakse võimalus teatada vabaduse võtmisest oma lähedastele. Kuriteos kahtlustatavale antakse viivitamatult ka võimalus valida endale kaitsja ja kohtuda temaga. Kuriteos kahtlustatava õigust teatada vabaduse võtmisest oma lähedastele võib piirata ainult seaduses sätestatud juhtudel ja korras kuriteo tõkestamiseks või kriminaalmenetluses tõe väljaselgitamise huvides. Kedagi ei tohi vahi all pidada üle neljakümne kaheksa tunni ilma kohtu sellekohase loata. Kohtu otsus teatatakse vahistatule viivitamatult talle arusaadavas keeles ja viisil.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_21 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_22_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kedagi ei tohi käsitada kuriteos süüdi olevana enne, kui tema kohta on jõustunud süüdimõistev kohtuotsus. Keegi ei ole kriminaalmenetluses kohustatud oma süütust tõendama. Kedagi ei tohi sundida tunnistama iseenda või oma lähedaste vastu.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_22 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_23_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kedagi ei tohi süüdi mõista teo eest, kui seda tegu ei tunnista kuriteoks seadus, mis oli jõus teo toimepanemise ajal. Kellelegi ei tohi mõista raskemat karistust kui see, mida võinuks talle mõista õiguserikkumise toimepanemise ajal. Kui seadus sätestab pärast õiguserikkumise toimepanemist kergema karistuse, kohaldatakse kergemat karistust. Kedagi ei tohi teist korda kohtu alla anda ega karistada teo eest, milles teda vastavalt seadusele on mõistetud lõplikult süüdi või õigeks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_23 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_24_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kedagi ei tohi tema vaba tahte vastaselt üle viia seadusega määratud kohtu alluvusest teise kohtu alluvusse. Igaühel on õigus olla oma kohtuasja arutamise juures. Kohtuistungid on avalikud. Kohus võib seaduses sätestatud juhtudel ja korras oma istungi või osa sellest kuulutada kinniseks riigi- või ärisaladuse, kõlbluse või inimeste perekonna- ja eraelu kaitseks või kui seda nõuavad alaealise, kannatanu või õigusemõistmise huvid. Kohtuotsus kuulutatakse avalikult, välja arvatud juhud, kui alaealise, abielupoole või kannatanu huvid nõuavad teisiti. Igaühel on õigus tema kohta tehtud kohtu otsuse peale seadusega sätestatud korras edasi kaevata kõrgemalseisvale kohtule.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_24 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_25_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus talle ükskõik kelle poolt õigusvastaselt tekitatud moraalse ja materiaalse kahju hüvitamisele.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_25 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_26_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus perekonna- ja eraelu puutumatusele. Riigiasutused, kohalikud omavalitsused ja nende ametiisikud ei tohi kellegi perekonna- ega eraellu sekkuda muidu, kui seaduses sätestatud juhtudel ja korras tervise, kõlbluse, avaliku korra või teiste inimeste õiguste ja vabaduste kaitseks, kuriteo tõkestamiseks või kurjategija tabamiseks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_26 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_27_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Perekond rahva püsimise ja kasvamise ning ühiskonna alusena on riigi kaitse all. Abikaasad on võrdõiguslikud. Vanematel on õigus ja kohustus kasvatada oma lapsi ja hoolitseda nende eest. Seadus sätestab vanemate ja laste kaitse. Perekond on kohustatud hoolitsema oma abivajavate liikmete eest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_27 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_28_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus tervise kaitsele. Eesti kodanikul on õigus riigi abile vanaduse, töövõimetuse, toitjakaotuse ja puuduse korral. Abi liigid, ulatuse ning saamise tingimused ja korra sätestab seadus. Kui seadus ei sätesta teisiti, siis on see õigus võrdselt Eesti kodanikuga ka Eestis viibival välisriigi kodanikul ja kodakondsuseta isikul. Riik soodustab vabatahtlikku ja omavalitsuse hoolekannet. Lasterikkad pered ja puuetega inimesed on riigi ja kohalike omavalitsuste erilise hoole all.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_28 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_29_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti kodanikul on õigus vabalt valida tegevusala, elukutset ja töökohta. Seadus võib sätestada selle õiguse kasutamise tingimused ja korra. Kui seadus ei sätesta teisiti, siis on see õigus võrdselt Eesti kodanikuga ka Eestis viibival välisriigi kodanikul ja kodakondsuseta isikul. Kedagi ei tohi sundida tema vaba tahte vastaselt tööle ega teenistusse, välja arvatud kaitseväeteenistus või selle asendusteenistus, tööd nakkushaiguse leviku tõkestamisel, loodusõnnetuse ja katastroofi korral ning töö, mida seaduse alusel ja korras peab tegema süüdimõistetu. Riik korraldab kutseõpet ja abistab tööotsijaid töö leidmisel. Töötingimused on riigi kontrolli all. Töötajate ja tööandjate ühingutesse ja liitudesse kuulumine on vaba. Töötajate ja tööandjate ühingud ja liidud võivad oma õiguste ja seaduslike huvide eest seista vahenditega, mida seadus ei keela. Streigiõiguse kasutamise tingimused ja korra sätestab seadus. Töövaidluste lahendamise korra sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_29 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_3_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivõimu teostatakse üksnes põhiseaduse ja sellega kooskõlas olevate seaduste alusel. Rahvusvahelise õiguse üldtunnustatud põhimõtted ja normid on Eesti õigussüsteemi lahutamatu osa. Seadused avaldatakse ettenähtud korras. Täitmiseks kohustuslikud saavad olla üksnes avaldatud seadused.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_3 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_30_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametikohad riigiasutustes ja kohalikes omavalitsustes täidetakse seaduse alusel ja korras Eesti kodanikega. Kooskõlas seadusega võib neid ametikohti erandkorras täita ka välisriigi kodanike ja kodakondsuseta isikutega. Seadus võib piirata mõne kategooria riigiteenistujate õigust tegelda ettevõtlusega ja koonduda tulundusühendustesse (§ 31) ning õigust kuuluda erakondadesse ja mõnda liiki mittetulundusühendustesse (§ 48).",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_30 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_31_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti kodanikel on õigus tegelda ettevõtlusega ning koonduda tulundusühingutesse ja -liitudesse. Seadus võib sätestada selle õiguse kasutamise tingimused ja korra. Kui seadus ei sätesta teisiti, siis on see õigus võrdselt Eesti kodanikega ka Eestis viibivatel välisriikide kodanikel ja kodakondsuseta isikutel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_31 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_32_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühe omand on puutumatu ja võrdselt kaitstud. Omandit võib omaniku nõusolekuta võõrandada ainult seaduses sätestatud juhtudel ja korras üldistes huvides õiglase ja kohese hüvituse eest. Igaühel, kelle vara on tema nõusolekuta võõrandatud, on õigus pöörduda kohtusse ning vaidlustada vara võõrandamine, hüvitus või selle suurus. Igaühel on õigus enda omandit vabalt vallata, kasutada ja käsutada. Kitsendused sätestab seadus. Omandit ei tohi kasutada üldiste huvide vastaselt. Seadus võib üldistes huvides sätestada vara liigid, mida tohivad Eestis omandada ainult Eesti kodanikud, mõnda liiki juriidilised isikud, kohalikud omavalitsused või Eesti riik. Pärimisõigus on tagatud.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_32 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_33_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kodu on puutumatu. Ei tohi tungida kellegi eluruumi, valdusse ega töökohta ega neid ka läbi otsida, välja arvatud seadusega sätestatud juhtudel ja korras avaliku korra, tervise või teiste inimeste õiguste ja vabaduste kaitseks, kuriteo tõkestamiseks, kurjategija tabamiseks või tõe väljaselgitamiseks kriminaalmenetluses.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_33 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_34_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel, kes viibib seaduslikult Eestis, on õigus vabalt liikuda ja elukohta valida. Õigust vabalt liikuda võib seaduses sätestatud juhtudel ja korras piirata teiste inimeste õiguste ja vabaduste kaitseks, riigikaitse huvides, loodusõnnetuse ja katastroofi korral, nakkushaiguse leviku tõkestamiseks, looduskeskkonna kaitseks, alaealise või vaimuhaige järelevalvetuse ärahoidmiseks ja kriminaalasja menetluse tagamiseks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_34 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_35_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus lahkuda Eestist. Seda õigust võib seaduses sätestatud juhtudel ja korras piirata kohtu- ning kohtueelse menetluse tagamiseks ja kohtuotsuse täitmiseks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_35 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_36_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühtki Eesti kodanikku ei tohi Eestist välja saata ega takistada Eestisse asumast. Ühtki Eesti kodanikku ei tohi välisriigile välja anda muidu, kui välislepingus ettenähtud juhtudel ning vastavas lepingus ja seaduses sätestatud korras. Väljaandmise otsustab Vabariigi Valitsus. Igal väljaantaval on õigus vaidlustada väljaandmine Eesti kohtus. Igal eestlasel on õigus asuda Eestisse.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_36 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_37_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus haridusele. Õppimine on kooliealistel lastel seadusega määratud ulatuses kohustuslik ning riigi ja kohalike omavalitsuste üldhariduskoolides õppemaksuta. Et teha haridus kättesaadavaks, peavad riik ja kohalikud omavalitsused ülal vajalikul arvul õppeasutusi. Seaduse alusel võib avada ja pidada ka muid õppeasutusi, sealhulgas erakoole. Laste hariduse valikul on otsustav sõna vanematel. Igaühel on õigus saada eestikeelset õpetust. Õppekeele vähemusrahvuse õppeasutuses valib õppeasutus. Hariduse andmine on riigi järelevalve all.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_37 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_38_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadus ja kunst ning nende õpetused on vabad. Ülikoolid ja teadusasutused on seaduses ettenähtud piires autonoomsed.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_38 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_39_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Autoril on võõrandamatu õigus oma loomingule. Riik kaitseb autori õigusi.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_39 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_4_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse ja kohtute tegevus on korraldatud võimude lahususe ja tasakaalustatuse põhimõttel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_4 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_40_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on südametunnistuse-, usu- ja mõttevabadus. Kuulumine kirikutesse ja usuühingutesse on vaba. Riigikirikut ei ole. Igaühel on vabadus nii üksinda kui ka koos teistega, avalikult või eraviisiliselt täita usutalitusi, kui see ei kahjusta avalikku korda, tervist ega kõlblust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_40 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_41_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus jääda truuks oma arvamustele ja veendumustele. Kedagi ei tohi sundida neid muutma. Veendumustega ei saa vabandada õiguserikkumist. Kedagi ei saa veendumuste pärast võtta õiguslikule vastutusele.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_41 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_42_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigiasutused, kohalikud omavalitsused ja nende ametiisikud ei tohi Eesti kodaniku vaba tahte vastaselt koguda ega talletada andmeid tema veendumuste kohta.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_42 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_43_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus tema poolt või temale posti, telegraafi, telefoni või muul üldkasutataval teel edastatavate sõnumite saladusele. Erandeid võib kohtu loal teha kuriteo tõkestamiseks või kriminaalmenetluses tõe väljaselgitamiseks seadusega sätestatud juhtudel ja korras.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_43 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_44_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus vabalt saada üldiseks kasutamiseks levitatavat informatsiooni. Kõik riigiasutused, kohalikud omavalitsused ja nende ametiisikud on kohustatud seaduses sätestatud korras andma Eesti kodanikule tema nõudel informatsiooni oma tegevuse kohta, välja arvatud andmed, mille väljaandmine on seadusega keelatud, ja eranditult asutusesiseseks kasutamiseks mõeldud andmed. Eesti kodanikul on õigus seaduses sätestatud korras tutvuda tema kohta riigiasutustes ja kohalikes omavalitsustes ning riigi ja kohalike omavalitsuste arhiivides hoitavate andmetega. Seaduse alusel võib seda õigust piirata teiste inimeste õiguste ja vabaduste ning lapse põlvnemise saladuse kaitseks, samuti kuriteo tõkestamise, kurjategija tabamise või kriminaalmenetluses tõe väljaselgitamise huvides. Kui seadus ei sätesta teisiti, siis on käesoleva paragrahvi lõigetes kaks ja kolm nimetatud õigused võrdselt Eesti kodanikuga ka Eestis viibival välisriigi kodanikul ja kodakondsuseta isikul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_44 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_45_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus vabalt levitada ideid, arvamusi, veendumusi ja muud informatsiooni sõnas, trükis, pildis või muul viisil. Seda õigust võib seadus piirata avaliku korra, kõlbluse, teiste inimeste õiguste ja vabaduste, tervise, au ning hea nime kaitseks. Seadus võib seda õigust piirata ka riigi ja kohalike omavalitsuste teenistujatel neile ameti tõttu teatavaks saanud riigi- või ärisaladuse või konfidentsiaalsena saadud informatsiooni ning teiste inimeste perekonna- ja eraelu kaitseks, samuti õigusemõistmise huvides. Tsensuuri ei ole.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_45 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_46_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus pöörduda märgukirjade ja avaldustega riigiasutuste, kohalike omavalitsuste ja nende ametiisikute poole. Vastamise korra sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_46 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_47_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõigil on õigus ilma eelneva loata rahumeelselt koguneda ja koosolekuid pidada. Seda õigust võib seaduses sätestatud juhtudel ja korras piirata riigi julgeoleku, avaliku korra, kõlbluse, liiklusohutuse ja koosolekust osavõtjate ohutuse tagamiseks ning nakkushaiguse leviku tõkestamiseks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_47 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_48_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus koonduda mittetulundusühingutesse ja -liitudesse. Erakondadesse võivad kuuluda ainult Eesti kodanikud. Relvi valdavate, samuti sõjaväeliselt korraldatud või sõjalisi harjutusi harrastavate ühingute ja liitude loomiseks on nõutav eelnev luba, mille andmise tingimused ja korra sätestab seadus. Keelatud on ühingud, liidud ja erakonnad, kelle eesmärgid või tegevus on suunatud Eesti põhiseadusliku korra vägivaldsele muutmisele või on muul viisil vastuolus kriminaalvastutust sätestava seadusega. Ainult kohus võib õiguserikkumise eest ühingu, liidu või erakonna tegevuse lõpetada või peatada, samuti teda trahvida.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_48 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_49_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus säilitada oma rahvuskuuluvus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_49 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_5_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti loodusvarad ja loodusressursid on rahvuslik rikkus, mida tuleb kasutada säästlikult.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_5 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_50_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvustel on õigus luua rahvuskultuuri huvides omavalitsusasutusi vähemusrahvuste kultuurautonoomia seaduses sätestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_50 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_51_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus pöörduda riigiasutuste, kohalike omavalitsuste ja nende ametiisikute poole eesti keeles ja saada eestikeelseid vastuseid. Paikkondades, kus vähemalt pooled püsielanikest on vähemusrahvusest, on igaühel õigus saada riigiasutustelt ja kohalikelt omavalitsustelt ning nende ametiisikutelt vastuseid ka selle vähemusrahvuse keeles.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_51 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_52_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigiasutuste ja kohalike omavalitsuste asjaajamiskeel on eesti keel. Paikkondades, kus elanike enamiku keel ei ole eesti keel, võivad kohalikud omavalitsused seaduses sätestatud ulatuses ja korras kasutada sisemise asjaajamiskeelena selle paikkonna püsielanike enamiku keelt. Võõrkeelte, sealhulgas vähemusrahvuste keelte kasutamise riigiasutuses ning kohtu- ja kohtueelses menetluses sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_52 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_53_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaüks on kohustatud säästma elu- ja looduskeskkonda ning hüvitama kahju, mis ta on keskkonnale tekitanud. Hüvitamise korra sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_53 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_54_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti kodaniku kohus on olla ustav põhiseaduslikule korrale ning kaitsta Eesti iseseisvust. Kui muid vahendeid ei leidu, on igal Eesti kodanikul õigus osutada põhiseadusliku korra vägivaldsele muutmisele omaalgatuslikku vastupanu.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_54 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_55_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis viibivad teiste riikide kodanikud ja kodakondsuseta isikud on kohustatud järgima Eesti põhiseaduslikku korda.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_55 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_56_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõrgeimat riigivõimu teostab rahvas hääleõiguslike kodanike kaudu: Riigikogu valimisega; rahvahääletusega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_56 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_57_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hääleõiguslik on Eesti kodanik, kes on saanud kaheksateist aastat vanaks. Hääleõiguslik ei ole Eesti kodanik, kes on kohtu poolt tunnistatud teovõimetuks.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_57 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_58_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusega võib piirata nende Eesti kodanike osavõttu hääletamisest, kes on kohtu poolt süüdi mõistetud ja kannavad karistust kinnipidamiskohtades.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_58 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_59_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusandlik võim kuulub Riigikogule.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_59 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_6_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti riigikeel on eesti keel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_6 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_60_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogul on sada üks liiget. Riigikogu liikmed valitakse vabadel valimistel proportsionaalsuse põhimõtte alusel. Valimised on üldised, ühetaolised ja otsesed. Hääletamine on salajane. Riigikogusse võib kandideerida iga vähemalt kahekümne ühe aastane hääleõiguslik Eesti kodanik. Riigikogu korralised valimised toimuvad märtsikuu esimesel pühapäeval neljandal aastal, mis järgneb Riigikogu eelmiste valimiste aastale. Riigikogu erakorralised valimised toimuvad põhiseaduse §-des 89, 97, 105 ja 119 ettenähtud juhtudel varemalt kakskümmend ja hiljemalt nelikümmend päeva pärast valimiste väljakuulutamist. Riigikogu valimise korra sätestab Riigikogu valimise seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_60 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_61_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikmete volitused algavad valimistulemuste väljakuulutamise päevast. Samast päevast lõpevad Riigikogu eelmise koosseisu liikmete volitused. Riigikogu liige annab enne oma kohustuste täitmisele asumist ametivande jääda ustavaks Eesti Vabariigile ja tema põhiseaduslikule korrale.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_61 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_62_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_62"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige ei ole seotud mandaadiga ega kanna õiguslikku vastutust hääletamise ja poliitiliste avalduste eest Riigikogus või selle organites.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_62 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_63_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_63"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige ei tohi olla üheski muus riigiametis. Riigikogu liige on oma volituste ajaks vabastatud kaitseväeteenistuse kohustusest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_63 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_64_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikme volitused peatuvad tema nimetamisel Vabariigi Valitsuse liikmeks ja taastuvad tema vabastamisel valitsuse liikme kohustustest. Riigikogu liikme volitused lõpevad enne tähtaega: tema asumisega mõnda teise riigiametisse; teda süüdi mõistva kohtuotsuse jõustumisel; tema tagasiastumisega seaduses sätestatud korras; kui Riigikohus on otsustanud, et ta on kestvalt võimetu oma ülesandeid täitma; tema surma korral. Riigikogu liikme volituste peatumisel või ennetähtaegsel lõppemisel astub seaduses sätestatud korras tema asemele asendusliige. Asendusliikmel on kõik Riigikogu liikme õigused ja kohustused. Riigikogu liikme volituste taastumisel lõpevad asendusliikme volitused.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_64 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_65_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu: võtab vastu seadusi ja otsuseid; otsustab rahvahääletuse korraldamise; valib Vabariigi Presidendi vastavalt põhiseaduse §-le 79; ratifitseerib ja denonsseerib välislepinguid vastavalt põhiseaduse §-le 121; annab peaministrikandidaadile volitused Vabariigi Valitsuse moodustamiseks; võtab vastu riigieelarve ja kinnitab selle täitmise aruande; nimetab Vabariigi Presidendi ettepanekul ametisse Riigikohtu esimehe, Eesti Panga nõukogu esimehe, riigikontrolöri, õiguskantsleri ja kaitseväe juhataja või ülemjuhataja; nimetab Riigikohtu esimehe ettepanekul ametisse Riigikohtu liikmed; nimetab Eesti Panga nõukogu liikmed; otsustab Vabariigi Valitsuse ettepanekul riigilaenude tegemise ja riigile muude varaliste kohustuste võtmise; esineb avalduste ja deklaratsioonidega ning pöördumistega Eesti rahva, teiste riikide ning rahvusvaheliste organisatsioonide poole; kehtestab riiklikud autasud, sõjaväelised ja diplomaatilised auastmed; otsustab umbusalduse avaldamise Vabariigi Valitsusele, peaministrile või ministrile; kuulutab riigis välja erakorralise seisukorra vastavalt põhiseaduse §-le 129; kuulutab Vabariigi Presidendi ettepanekul välja sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni; lahendab muid riigielu küsimusi, mis ei ole põhiseadusega antud Vabariigi Presidendi, Vabariigi Valitsuse, teiste riigiorganite või kohalike omavalitsuste otsustada.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_65 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_65_v127042011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_65_v127042011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu: võtab vastu seadusi ja otsuseid; otsustab rahvahääletuse korraldamise; valib Vabariigi Presidendi vastavalt põhiseaduse §-le 79; ratifitseerib ja denonsseerib välislepinguid vastavalt põhiseaduse §-le 121; annab peaministrikandidaadile volitused Vabariigi Valitsuse moodustamiseks; võtab vastu riigieelarve ja kinnitab selle täitmise aruande; nimetab Vabariigi Presidendi ettepanekul ametisse Riigikohtu esimehe, Eesti Panga nõukogu esimehe, riigikontrolöri ja õiguskantsleri; nimetab Riigikohtu esimehe ettepanekul ametisse Riigikohtu liikmed; nimetab Eesti Panga nõukogu liikmed; otsustab Vabariigi Valitsuse ettepanekul riigilaenude tegemise ja riigile muude varaliste kohustuste võtmise; esineb avalduste ja deklaratsioonidega ning pöördumistega Eesti rahva, teiste riikide ning rahvusvaheliste organisatsioonide poole; kehtestab riiklikud autasud, sõjaväelised ja diplomaatilised auastmed; otsustab umbusalduse avaldamise Vabariigi Valitsusele, peaministrile või ministrile; kuulutab riigis välja erakorralise seisukorra vastavalt põhiseaduse §-le 129; kuulutab Vabariigi Presidendi ettepanekul välja sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni; lahendab muid riigielu küsimusi, mis ei ole põhiseadusega antud Vabariigi Presidendi, Vabariigi Valitsuse, teiste riigiorganite või kohalike omavalitsuste otsustada.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_65 (redaktsioon 127042011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127042011002"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_66_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu uue koosseisu esimene istung toimub kümne päeva jooksul arvates Riigikogu valimise tulemuste väljakuulutamisest. Esimeseks istungiks kutsub Riigikogu kokku Vabariigi President.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_66 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_67_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_67"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu korralised istungjärgud toimuvad jaanuarikuu teisest esmaspäevast juunikuu kolmanda neljapäevani ning septembrikuu teisest esmaspäevast detsembrikuu kolmanda neljapäevani.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_67 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_68_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu erakorralised istungjärgud kutsub kokku Riigikogu esimees Vabariigi Presidendi, Vabariigi Valitsuse või vähemalt viiendiku Riigikogu koosseisu ettepanekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_68 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_69_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu valib oma liikmete hulgast Riigikogu esimehe ja kaks aseesimeest, kes korraldavad Riigikogu tööd vastavalt Riigikogu kodukorra seadusele ja Riigikogu töökorra seadusele.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_69 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_7_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti riigivärvid on sinine, must ja valge. Riigilipu ja riigivapi kuju sätestab seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_7 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_70_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu otsustusvõimelisuse sätestab Riigikogu kodukorra seadus. Erakorralisel istungjärgul on Riigikogu otsustusvõimeline, kui kohal on üle poole Riigikogu koosseisust.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_70 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_71_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu moodustab komisjone. Riigikogu liikmetel on õigus ühineda fraktsioonidesse. Komisjonide ja fraktsioonide moodustamise korra ning õigused sätestab Riigikogu kodukorra seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_71 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_72_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu istungid on avalikud, kui Riigikogu ei otsusta kahekolmandikulise häälteenamusega teisiti. Hääletamine Riigikogus on avalik. Salajast hääletamist korraldatakse põhiseaduses või Riigikogu kodukorra seaduses ettenähtud juhtudel ainult ametiisikute valimisel või nimetamisel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_72 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_73_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu aktid võetakse vastu poolthäälte enamusega, kui põhiseadus ei näe ette teisiti.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_73 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_74_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikmel on õigus pöörduda arupärimisega Vabariigi Valitsuse ja tema liikmete, Eesti Panga nõukogu esimehe, Eesti Panga presidendi, riigikontrolöri, õiguskantsleri ja kaitseväe juhataja või ülemjuhataja poole. Arupärimisele tuleb vastata Riigikogu istungil kahekümne istungipäeva jooksul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_74 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_74_v127042011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_74_v127042011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikmel on õigus pöörduda arupärimisega Vabariigi Valitsuse ja tema liikmete, Eesti Panga nõukogu esimehe, Eesti Panga presidendi, riigikontrolöri ja õiguskantsleri poole. Arupärimisele tuleb vastata Riigikogu istungil kahekümne istungipäeva jooksul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_74 (redaktsioon 127042011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127042011002"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_75_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liikme tasu ning piirangud muu töötulu saamisel sätestab seadus, mida tohib muuta Riigikogu järgmise koosseisu kohta.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_75 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_76_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu liige on puutumatu. Teda saab kriminaalvastutusele võtta ainult õiguskantsleri ettepanekul Riigikogu koosseisu enamuse nõusolekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_76 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_77_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President on Eesti riigipea.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_77 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_78_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President: esindab Eesti Vabariiki rahvusvahelises suhtlemises; nimetab ja kutsub tagasi Vabariigi Valitsuse ettepanekul Eesti Vabariigi diplomaatilised esindajad ning võtab vastu Eestisse akrediteeritud diplomaatiliste esindajate volikirjad; kuulutab välja Riigikogu korralised valimised ja vastavalt põhiseaduse §-dele 89, 97, 105 ja 119 Riigikogu erakorralised valimised; kutsub kokku Riigikogu uue koosseisu vastavalt põhiseaduse §-le 66 ja avab selle esimese istungi; teeb Riigikogu esimehele ettepaneku Riigikogu erakorralise istungjärgu kokkukutsumiseks vastavalt põhiseaduse §-le 68; kuulutab välja seadused vastavalt põhiseaduse §-dele 105 ja 107 ning kirjutab alla ratifitseerimiskirjadele; annab seadlusi vastavalt põhiseaduse §-dele 109 ja 110; algatab põhiseaduse muutmist; määrab peaministrikandidaadi vastavalt põhiseaduse §-le 89; nimetab ametisse ja vabastab ametist valitsuse liikmed vastavalt põhiseaduse §-dele 89, 90 ja 92; teeb Riigikogule ettepaneku Riigikohtu esimehe, Eesti Panga nõukogu esimehe, riigikontrolöri, õiguskantsleri ning kaitseväe juhataja või ülemjuhataja ametissenimetamiseks; nimetab Eesti Panga nõukogu ettepanekul ametisse Eesti Panga presidendi; nimetab Riigikohtu ettepanekul kohtunikud; nimetab ja vabastab ametist Vabariigi Valitsuse ja kaitseväe juhataja ettepanekul kaitseväe juhtkonna; annab riiklikke autasusid, sõjaväelisi ja diplomaatilisi auastmeid; on Eesti riigikaitse kõrgeim juht; teeb Riigikogule ettepanekud sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning vastavalt põhiseaduse §-le 129 erakorralise seisukorra väljakuulutamiseks; kuulutab Eesti vastu suunatud agressiooni korral välja sõjaseisukorra ja mobilisatsiooni ning nimetab ametisse kaitseväe ülemjuhataja vastavalt põhiseaduse §-le 128; vabastab süüdimõistetuid nende palvel armuandmise korras karistuse kandmisest või kergendab karistust; algatab õiguskantsleri kriminaalvastutusele võtmise vastavalt põhiseaduse §-le 145.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_78 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304",
      "estleg:supersededByVersion": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_78_v127042011002"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_78_v127042011002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President: esindab Eesti Vabariiki rahvusvahelises suhtlemises; nimetab ja kutsub tagasi Vabariigi Valitsuse ettepanekul Eesti Vabariigi diplomaatilised esindajad ning võtab vastu Eestisse akrediteeritud diplomaatiliste esindajate volikirjad; kuulutab välja Riigikogu korralised valimised ja vastavalt põhiseaduse §-dele 89, 97, 105 ja 119 Riigikogu erakorralised valimised; kutsub kokku Riigikogu uue koosseisu vastavalt põhiseaduse §-le 66 ja avab selle esimese istungi; teeb Riigikogu esimehele ettepaneku Riigikogu erakorralise istungjärgu kokkukutsumiseks vastavalt põhiseaduse §-le 68; kuulutab välja seadused vastavalt põhiseaduse §-dele 105 ja 107 ning kirjutab alla ratifitseerimiskirjadele; annab seadlusi vastavalt põhiseaduse §-dele 109 ja 110; algatab põhiseaduse muutmist; määrab peaministrikandidaadi vastavalt põhiseaduse §-le 89; nimetab ametisse ja vabastab ametist valitsuse liikmed vastavalt põhiseaduse §-dele 89, 90 ja 92; teeb Riigikogule ettepaneku Riigikohtu esimehe, Eesti Panga nõukogu esimehe, riigikontrolöri ja õiguskantsleri ametissenimetamiseks; nimetab Eesti Panga nõukogu ettepanekul ametisse Eesti Panga presidendi; nimetab Riigikohtu ettepanekul kohtunikud; Kehtetu - annab riiklikke autasusid, sõjaväelisi ja diplomaatilisi auastmeid; on Eesti riigikaitse kõrgeim juht; teeb Riigikogule ettepanekud sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ning vastavalt põhiseaduse §-le 129 erakorralise seisukorra väljakuulutamiseks; kuulutab Eesti vastu suunatud agressiooni korral välja sõjaseisukorra ja mobilisatsiooni vastavalt põhiseaduse §-le 128; vabastab süüdimõistetuid nende palvel armuandmise korras karistuse kandmisest või kergendab karistust; algatab õiguskantsleri kriminaalvastutusele võtmise vastavalt põhiseaduse §-le 145.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_78 (redaktsioon 127042011002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127042011002"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_79_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi valib Riigikogu või käesoleva paragrahvi neljandas lõikes sätestatud juhul valimiskogu. Vabariigi Presidendi kandidaadi ülesseadmise õigus on vähemalt viiendikul Riigikogu koosseisust. Vabariigi Presidendi kandidaadiks võib seada sünnilt Eesti kodaniku, kes on vähemalt nelikümmend aastat vana. Vabariigi President valitakse salajasel hääletusel. Igal Riigikogu liikmel on üks hääl. Valituks tunnistatakse kandidaat, kelle poolt hääletab Riigikogu koosseisu kahekolmandikuline enamus. Kui ükski kandidaat ei saa nõutavat häälteenamust, siis korraldatakse järgmisel päeval uus hääletusvoor. Enne teist hääletusvooru toimub uus kandidaatide ülesseadmine. Kui teises hääletusvoorus ei saa ükski kandidaat nõutavat häälteenamust, siis korraldatakse kahe teises voorus enim hääli saanud kandidaadi vahel samal päeval kolmas hääletusvoor. Kui Vabariigi Presidenti ei valita ka kolmandas hääletusvoorus, kutsub Riigikogu esimees ühe kuu jooksul Vabariigi Presidendi valimiseks kokku valimiskogu. Valimiskogu koosneb Riigikogu liikmetest ja kohalike omavalitsuste volikogude esindajatest. Iga kohaliku omavalitsuse volikogu valib valimiskogusse vähemalt ühe esindaja, kes peab olema Eesti kodanik. Riigikogu esitab valimiskogule presidendikandidaadiks kaks Riigikogus enim hääli saanud kandidaati. Presidendikandidaadi ülesseadmise õigus on ka vähemalt kahekümne ühel valimiskogu liikmel. Valimiskogu valib Vabariigi Presidendi hääletamisest osavõtnud valimiskogu liikmete häälteenamusega. Kui esimeses voorus ükski kandidaat ei osutu valituks, korraldatakse samal päeval kahe enim hääli saanud kandidaadi vahel teine hääletusvoor. Vabariigi Presidendi valimise täpsema korra sätestab Vabariigi Presidendi valimise seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_79 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_8_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igal lapsel, kelle vanematest üks on Eesti kodanik, on õigus Eesti kodakondsusele sünnilt. Igaühel, kes on alaealisena kaotanud Eesti kodakondsuse, on õigus selle taastamisele. Kelleltki ei tohi võtta sünniga omandatud Eesti kodakondsust. Kelleltki ei tohi veendumuste pärast võtta Eesti kodakondsust. Eesti kodakondsuse saamise, kaotamise ja taastamise tingimused ning korra sätestab kodakondsuse seadus.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_8 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_80_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President valitakse ametisse viieks aastaks. Kedagi ei tohi valida Vabariigi Presidendiks rohkem kui kaheks ametiajaks järjestikku. Vabariigi Presidendi korralised valimised toimuvad varemalt kuuskümmend ja hiljemalt kümme päeva enne Vabariigi Presidendi ametiaja lõppemist.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_80 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_81_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President astub ametisse järgmise ametivande andmisega Eesti rahvale Riigikogu ees: \"Astudes Vabariigi Presidendi ametisse, annan mina, (ees- ja perekonnanimi), pühaliku tõotuse kaitsta vankumata Eesti Vabariigi põhiseadust ja seadusi, õiglaselt ja erapooletult kasutada minule antud võimu ning täita ustavalt oma kohuseid kõigi oma võimete ja parima arusaamisega Eesti rahva ja Vabariigi kasuks.\"",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_81 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_82_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidendi volitused lõpevad: ametist tagasiastumisega; teda süüdi mõistva kohtuotsuse jõustumisega; tema surma korral; uue Vabariigi Presidendi ametisseastumisega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_82 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_83_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Vabariigi President on Riigikohtu otsusel kestvalt võimetu oma ülesandeid täitma või ei saa ta neid seaduses nimetatud juhtudel ajutiselt täita või on tema volitused enne tähtaega lõppenud, lähevad tema ülesanded ajutiselt üle Riigikogu esimehele. Ajaks, mil Riigikogu esimees täidab Vabariigi Presidendi ülesandeid, peatuvad tema volitused Riigikogu liikmena. Riigikogu esimehel Vabariigi Presidendi ülesannetes ei ole õigust Riigikohtu nõusolekuta välja kuulutada Riigikogu erakorralisi valimisi ega keelduda seadusi välja kuulutamast. Kui Vabariigi President ei saa oma ametikohustusi täita üle kolme kuu järjest või kui tema volitused on enne tähtaega lõppenud, valib Riigikogu neljateistkümne päeva jooksul uue Vabariigi Presidendi vastavalt põhiseaduse §-le 79.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_83 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_84_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametisseastumisega lõpevad Vabariigi Presidendi volitused ja ülesanded kõigis valitavates ja nimetatavates ametites ning ta peatab ametisoleku ajaks oma erakondliku kuuluvuse.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_84 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_85_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Presidenti saab kriminaalvastutusele võtta ainult õiguskantsleri ettepanekul Riigikogu koosseisu enamuse nõusolekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_85 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_86_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täidesaatev riigivõim kuulub Vabariigi Valitsusele.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_86 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_87_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus: viib ellu riigi sise- ja välispoliitikat; suunab ja koordineerib valitsusasutuste tegevust; korraldab seaduste, Riigikogu otsuste ja Vabariigi Presidendi aktide täitmist; esitab Riigikogule seaduseelnõusid ning ratifitseerimiseks ja denonsseerimiseks välislepinguid; koostab riigieelarve eelnõu ja esitab selle Riigikogule, korraldab riigieelarve täitmist ning esitab Riigikogule riigieelarve täitmise aruande; annab seaduse alusel ja täitmiseks määrusi ja korraldusi; korraldab suhtlemist teiste riikidega; kuulutab loodusõnnetuse ja katastroofi korral või nakkushaiguse leviku tõkestamiseks välja eriolukorra riigis või selle osas; täidab muid ülesandeid, mis põhiseaduse ja seadustega on antud Vabariigi Valitsuse otsustada.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_87 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_88_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsusse kuuluvad peaminister ja ministrid.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_88 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_89_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi President määrab neljateistkümne päeva jooksul Vabariigi Valitsuse tagasiastumisest peaministrikandidaadi, kellele teeb ülesandeks uue valitsuse moodustamise. Peaministrikandidaat esitab neljateistkümne päeva jooksul, arvates valitsuse moodustamise ülesande saamisest, Riigikogule ettekande tulevase valitsuse moodustamise aluste kohta, mille järel Riigikogu otsustab läbirääkimisteta avalikul hääletusel peaministrikandidaadile volituste andmise valitsuse moodustamiseks. Riigikogult valitsuse moodustamiseks volitused saanud peaministrikandidaat esitab seitsme päeva jooksul valitsuse koosseisu Vabariigi Presidendile, kes nimetab kolme päeva jooksul valitsuse ametisse. Kui Vabariigi Presidendi määratud peaministrikandidaat ei saa Riigikogu poolthäälte enamust või ei suuda valitsust moodustada või loobub selle moodustamisest, on Vabariigi Presidendil õigus seitsme päeva jooksul esitada teine peaministrikandidaat. Kui Vabariigi President ei esita seitsme päeva jooksul teist peaministrikandidaati või loobub selle esitamisest või kui teine kandidaat käesoleva paragrahvi lõigete kaks ja kolm tingimustel ja tähtaegadel ei saa Riigikogult volitusi või ei suuda valitsust moodustada või loobub selle moodustamisest, läheb peaministrikandidaadi ülesseadmise õigus üle Riigikogule. Riigikogu seab üles peaministrikandidaadi, kes esitab valitsuse koosseisu Vabariigi Presidendile. Kui neljateistkümne päeva jooksul, arvates peaministrikandidaadi ülesseadmise õiguse üleminekust Riigikogule, on valitsuse koosseis Vabariigi Presidendile esitamata, kuulutab Vabariigi President välja Riigikogu erakorralised valimised.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_89 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_9_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhiseaduses loetletud kõigi ja igaühe õigused, vabadused ja kohustused on võrdselt nii Eesti kodanikel kui ka Eestis viibivatel välisriikide kodanikel ja kodakondsuseta isikutel. Põhiseaduses loetletud õigused, vabadused ja kohustused laienevad juriidilistele isikutele niivõrd, kui see on kooskõlas juriidiliste isikute üldiste eesmärkide ja selliste õiguste, vabaduste ja kohustuste olemusega.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_9 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_90_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muudatusi ametisse nimetatud Vabariigi Valitsuse koosseisus teeb Vabariigi President peaministri ettepanekul.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_90 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_91_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valitsus astub ametisse ametivande andmisega Riigikogu ees.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_91 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_92_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus astub tagasi: Riigikogu uue koosseisu kokkuastumisel; peaministri tagasiastumise või surma korral; kui Riigikogu avaldab Vabariigi Valitsusele või peaministrile umbusaldust. Vabariigi President vabastab Vabariigi Valitsuse ametist uue valitsuse ametisseastumisel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_92 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_93_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peaminister esindab Vabariigi Valitsust ja juhib selle tegevust. Peaminister nimetab kaks ministrit, kellel on õigus asendada peaministrit tema äraolekul. Asendamise korra määrab peaminister.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_93 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_94_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valitsemisalade korraldamiseks moodustatakse seaduse alusel vastavad ministeeriumid. Minister juhib ministeeriumi, korraldab ministeeriumi valitsemisalasse kuuluvaid küsimusi, annab seaduse alusel ja täitmiseks määrusi ja käskkirju ning täidab muid ülesandeid, mis talle on pandud seadusega sätestatud alustel ja korras. Kui minister ei saa haiguse või muude takistuste tõttu ajutiselt oma ülesandeid täita, paneb peaminister tema ülesanded selleks ajaks mõnele teisele ministrile. Vabariigi President võib peaministri ettepanekul nimetada ametisse ministreid, kes ei juhi ministeeriumi.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_94 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_95_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse juures on riigikantselei, mida juhib riigisekretär. Riigisekretäri nimetab ametisse ja vabastab ametist peaminister. Riigisekretär võtab sõnaõigusega osa valitsuse istungitest. Riigisekretäril on riigikantselei juhina samad õigused, mis on seadusega antud ministrile ministeeriumi juhtimisel.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_95 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_96_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse istungid on kinnised, kui valitsus ei otsusta teisiti. Valitsus teeb oma otsused peaministri või asjaomase ministri ettepanekul. Valitsuse määrused kehtivad, kui nad kannavad peaministri, asjaomase ministri ja riigisekretäri allkirja.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_96 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_97_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigikogu võib avaldada Vabariigi Valitsusele, peaministrile või ministrile umbusaldust otsusega, mille poolt hääletab Riigikogu koosseisu enamus. Umbusalduse avaldamise võib algatada vähemalt viiendik Riigikogu koosseisust kirjaliku nõude esitamisega Riigikogu istungil. Umbusalduse avaldamine võib tulla otsustamisele kõige varem ülejärgmisel päeval pärast selle algatamist, kui valitsus ei nõua kiiremat otsustamist. Valitsusele või peaministrile umbusalduse avaldamise korral võib Vabariigi President kolme päeva jooksul valitsuse ettepanekul välja kuulutada Riigikogu erakorralised valimised. Ministrile umbusalduse avaldamise korral teatab Riigikogu esimees sellest Vabariigi Presidendile, kes vabastab ministri ametist. Umbusalduse avaldamist võib samal alusel uuesti algatada kõige varem kolme kuu möödumisel eelmisest umbusaldushääletamisest.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_97 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_98_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus võib siduda tema poolt Riigikogule esitatud eelnõu vastuvõtmise usaldusküsimusega. Hääletamine ei saa toimuda varem kui ülejärgmisel päeval pärast eelnõu sidumist usaldusküsimusega. Kui Riigikogu ei võta eelnõu vastu, astub valitsus tagasi.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_98 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    },
    {
      "@id": "estleg:eesti_vabariigi_pohiseadus_Par_99_v24304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:eesti_vabariigi_pohiseadus_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse liikmed ei tohi olla üheski muus riigiametis ega kuuluda tulundusettevõtte juhatusse või nõukogusse.",
      "rdfs:label": {
        "@value": "eesti_vabariigi_pohiseadus_Par_99 (redaktsioon 24304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24304"
    }
  ]
}
