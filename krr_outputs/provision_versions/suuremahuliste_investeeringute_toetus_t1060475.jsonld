    {
      "@id": "estleg:Reg_1060475_Par_23_v1060475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060475_Par_23"
