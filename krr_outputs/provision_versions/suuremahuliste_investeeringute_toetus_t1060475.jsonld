      "estleg:versionValidFrom": {
        "@value": "2025-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse taotlusi menetleb, taotluste rahuldamise, rahuldamata jätmise ning muutmise otsuseid ja toetuse makseid teeb, toetuse kasutamist kontrollib ning toetuse tagasinõudmise otsuseid teeb Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi EIS). Toetuse taotlusi menetleb, taotluste rahuldamise, rahuldamata jätmise ning muutmise otsuseid ja toetuse makseid teeb, toetuse kasutamist kontrollib ning toetuse tagasinõudmise otsuseid teeb Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi EIS).",
      "rdfs:label": {
        "@value": "Reg_1060475_Par_5 (redaktsioon 1060475)",
        "@language": "et"
      },
