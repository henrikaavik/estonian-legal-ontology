      }
    },
    {
      "@id": "estleg:Reg_317593_Par_106_118_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_106_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Töötlussüsteemi kasutaja võib olla teise töötleva üksuse juurdepääsuõiguse ja teadmisvajadusega töötaja või ametnik, kui see on vajalik teise töötleva üksuse ülesannete täitmiseks. Töötlussüsteemi kasutaja võib olla teise töötleva üksuse juurdepääsuõiguse ja teadmisvajadusega töötaja või ametnik, kui see on vajalik teise töötleva üksuse ülesannete täitmiseks. 2 (2) Töötlussüsteemi osad võivad asuda teise töötleva üksuse otseses valduses ning töötlussüsteemi eest vastutav eriõigustega kasutaja võib olla teise töötleva üksuse töötaja või ametnik, kui on tagatud § 106 lõikes 2 ja lisas 14 sätestatud nõuete täitmine. RT I 2023-12-29 8 129122023008 2024-01-01 Töötlussüsteemi osad võivad asuda teise töötleva üksuse otseses valduses ning töötlussüsteemi eest vastutav eriõigustega kasutaja võib olla teise töötleva üksuse töötaja või ametnik, kui on tagatud § 106 lõikes 2 ja lisas 14 sätestatud nõuete täitmine.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_106_118 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
