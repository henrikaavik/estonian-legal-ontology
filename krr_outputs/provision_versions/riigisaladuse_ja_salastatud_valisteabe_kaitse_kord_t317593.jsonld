      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 113",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_317593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_317593_Par_114_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Salastatud välisteabe töötlemisele kohaldatakse välislepingust tulenevaid või rahvusvahelise organisatsiooni või rahvusvahelise kokkuleppega loodud institutsiooni salastatud teabe kaitse nõudeid, arvestades käesolevas jaos sätestatut. Käesolevas jaos sätestatud töötlemisnõudeid ei kohaldata Välisluureametis arvele võetud krüptomaterjalile ning «Riigisaladuse ja salastatud välisteabe seaduse» § 52 lõikes 3 nimetatud teabele. RT I 2023-05-31 3 131052023003 2023-06-05 Salastatud välisteabe töötlemisele kohaldatakse välislepingust tulenevaid või rahvusvahelise organisatsiooni või rahvusvahelise kokkuleppega loodud institutsiooni salastatud teabe kaitse nõudeid, arvestades käesolevas jaos sätestatut. Käesolevas jaos sätestatud töötlemisnõudeid ei kohaldata Välisluureametis arvele võetud krüptomaterjalile ning «Riigisaladuse ja salastatud välisteabe seaduse» § 52 lõikes 3 nimetatud teabele.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_114 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 114",
      "estleg:partOfAct": {
