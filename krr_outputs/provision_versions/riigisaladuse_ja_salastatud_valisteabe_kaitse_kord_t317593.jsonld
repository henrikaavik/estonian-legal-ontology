      "estleg:provisionRef": "Reg_317593 § 54",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_317593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_317593_Par_54_62_v317593",
      "@type": [
