      "estleg:provisionRef": "Reg_317593 § 90",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_317593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_317593_Par_91_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
