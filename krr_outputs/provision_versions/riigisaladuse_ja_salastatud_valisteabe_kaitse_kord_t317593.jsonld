      "estleg:partOfAct": {
        "@id": "estleg:Reg_317593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_317593_Par_50_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registrit peetakse elektrooniliselt või vajaduse korral paberil. RT I 2023-05-31 3 131052023003 2023-06-05 Registrit peetakse elektrooniliselt või vajaduse korral paberil. 2 (2) Registrikanne ise ei tohi võimaluse korral sisaldada salastatud teavet. Registrikanne ise ei tohi võimaluse korral sisaldada salastatud teavet. 3 (3) Töötlev üksus peab tagama registriandmete alalise säilimise. RT I 2016-10-26 2 126102016002 2016-10-29 Töötlev üksus peab tagama registriandmete alalise säilimise.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_50 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 50",
