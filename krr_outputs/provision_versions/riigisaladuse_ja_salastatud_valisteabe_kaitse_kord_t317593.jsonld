    {
      "@id": "estleg:Reg_317593_Par_76_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tööajal võib seifi võti asuda seifi kasutaja käes. RT I 2023-05-31 3 131052023003 2023-06-05 Tööajal võib seifi võti asuda seifi kasutaja käes. 2 (2) Kui konfidentsiaalsel ja kõrgemal tasemel salastatud teabekandjate hoiustamiseks kasutataval seifil on lisaks koodlukule ka võti ning seifi kasutaja lahkub turvaalalt või seda ümbritsevalt administratiivalalt avalikku ruumi, tuleb seifi võti lukustada võtmete kappi. RT I 2023-05-31 3 131052023003 2023-06-05 Kui konfidentsiaalsel ja kõrgemal tasemel salastatud teabekandjate hoiustamiseks kasutataval seifil on lisaks koodlukule ka võti ning seifi kasutaja lahkub turvaalalt või seda ümbritsevalt administratiivalalt avalikku ruumi, tuleb seifi võti lukustada võtmete kappi. 3 (3) Seifi lukud tuleb vahetada, kui on põhjust arvata, et seifi võti on sattunud kõrvalise isiku kätte. Seifi lukud tuleb vahetada, kui on põhjust arvata, et seifi võti on sattunud kõrvalise isiku kätte.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_76 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 76",
