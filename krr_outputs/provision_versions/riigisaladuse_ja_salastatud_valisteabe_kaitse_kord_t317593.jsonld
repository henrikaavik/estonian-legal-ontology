    {
      "@id": "estleg:Reg_317593_Par_134_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_134"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juurdepääsu- või töötlemissertifikaat tunnistatakse kehtetuks: 1 1) isiku juurdepääsuvajaduse äralangemisel; 2 2) uue juurdepääsu- või töötlemissertifikaadi väljastamisel enne eelmise juurdepääsu- või töötlemissertifikaadi kehtivusaja lõppu; 3 3) juurdepääsu- või töötlemissertifikaadile kantud isikuandmete muutumisel; 4 4) kui väljastatud juurdepääsu- või töötlemissertifikaadi kehtivusajal ilmneb mõni selle väljastamist välistav asjaolu. RT I 2023-05-31 3 131052023003 2023-06-05 Juurdepääsu- või töötlemissertifikaat tunnistatakse kehtetuks: isiku juurdepääsuvajaduse äralangemisel; uue juurdepääsu- või töötlemissertifikaadi väljastamisel enne eelmise juurdepääsu- või töötlemissertifikaadi kehtivusaja lõppu; juurdepääsu- või töötlemissertifikaadile kantud isikuandmete muutumisel; kui väljastatud juurdepääsu- või töötlemissertifikaadi kehtivusajal ilmneb mõni selle väljastamist välistav asjaolu.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_134 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 134",
