      }
    },
    {
      "@id": "estleg:Reg_317593_Par_65_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui dokumendi tekstiosadel või illustratsioonidel on erinev juurdepääsupiirangu tase või erinevad salastatud välisteabe avaldajad, võib dokumendi märgistada tekstiosade või illustratsioonide kaupa. Kui dokumendi tekstiosadel või illustratsioonidel on erinev juurdepääsupiirangu tase või erinevad salastatud välisteabe avaldajad, võib dokumendi märgistada tekstiosade või illustratsioonide kaupa. 2 (2) Lõikes 1 nimetatud märgistus tehakse sulgudes suurtähtedega asjaomase lõigu algusesse või illustratsiooni ette või peale ning vajaduse korral ka lõigu lõppu või illustratsiooni järele või alla. Lõikes 1 nimetatud märgistus tehakse sulgudes suurtähtedega asjaomase lõigu algusesse või illustratsiooni ette või peale ning vajaduse korral ka lõigu lõppu või illustratsiooni järele või alla. 3 (3) Tekstiosa või illustratsiooni juurdepääsupiirangu taseme märke võib esitada sulgudes lühendina, kasutades riigisaladuse puhul märkeid „P“, „K“, „S“ või „TS“. RT I 2023-05-31 3 131052023003 2023-06-05 Tekstiosa või illustratsiooni juurdepääsupiirangu taseme märke võib esitada sulgudes lühendina, kasutades riigisaladuse puhul märkeid „P“, „K“, „S“ või „TS“.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_65 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
