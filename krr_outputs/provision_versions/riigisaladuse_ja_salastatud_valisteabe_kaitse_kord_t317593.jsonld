    {
      "@id": "estleg:Reg_317593_Par_97_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konfidentsiaalsel ja madalamal tasemel salastatud teabekandjat võib avaliku ruumi kaudu vedada üks kuller. Konfidentsiaalsel ja madalamal tasemel salastatud teabekandjat võib avaliku ruumi kaudu vedada üks kuller. 2 (2) Salajasel ja kõrgemal tasemel salastatud teabekandjat peab avaliku ruumi kaudu vedama vähemalt kaks kullerit. Kaitsepolitseiameti, Kaitseväe, riigi julgeoleku volitatud esindaja või Välisluureameti loal võib seda teha üks kuller. RT I 2023-05-31 3 131052023003 2023-06-05 Salajasel ja kõrgemal tasemel salastatud teabekandjat peab avaliku ruumi kaudu vedama vähemalt kaks kullerit. Kaitsepolitseiameti, Kaitseväe, riigi julgeoleku volitatud esindaja või Välisluureameti loal võib seda teha üks kuller.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_97 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 97",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_317593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_317593_Par_98_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Salajasel ja kõrgemal tasemel salastatud teabekandjat veetakse üldjuhul autoga. Salajasel ja kõrgemal tasemel salastatud teabekandjat veetakse üldjuhul autoga. 2 (2) Auto aknad hoitakse suletud ja uksed lukustatud ning autojuht peab olema riigi ametiasutusega või saatva või vastuvõtva töötleva üksusega töö- või teenistussuhtes. RT I 2023-05-31 3 131052023003 2023-06-05 Auto aknad hoitakse suletud ja uksed lukustatud ning autojuht peab olema riigi ametiasutusega või saatva või vastuvõtva töötleva üksusega töö- või teenistussuhtes.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_98 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 98",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_317593_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_317593_Par_99_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vähemalt üks täiesti salajasel tasemel salastatud teabekandjat vedav kuller peab kandma ametirelva. Kaitsepolitseiameti, Kaitseväe, riigi julgeoleku volitatud esindaja või Välisluureameti loal võib täiesti salajasel tasemel salastatud teabekandjat vedada ametirelva kandmata. Vähemalt üks täiesti salajasel tasemel salastatud teabekandjat vedav kuller peab kandma ametirelva. Kaitsepolitseiameti, Kaitseväe, riigi julgeoleku volitatud esindaja või Välisluureameti loal võib täiesti salajasel tasemel salastatud teabekandjat vedada ametirelva kandmata. 2 (2) Ainsana ametirelva kandev kuller ei või teabekandja vedamise ajal juhtida sõidukit. RT I 2023-05-31 3 131052023003 2023-06-05 Ainsana ametirelva kandev kuller ei või teabekandja vedamise ajal juhtida sõidukit.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_99 (redaktsioon 317593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "317593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/317593",
      "estleg:sourceAct": "Riigisaladuse ja salastatud välisteabe kaitse kord",
      "estleg:provisionRef": "Reg_317593 § 99",
      "estleg:partOfAct": {
