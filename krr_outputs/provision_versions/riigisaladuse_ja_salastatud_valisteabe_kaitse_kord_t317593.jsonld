      }
    },
    {
      "@id": "estleg:Reg_317593_Par_77_v317593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_317593_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Võtmete kapp peab olema metallist, lukustatav ja asuma pideva valve all. Võtmete kapp peab olema metallist, lukustatav ja asuma pideva valve all. 2 (2) Kui võtmete kappi kasutab mitu isikut, peab olema tagatud, et kasutaja saab võtta ainult talle vajaliku võtme. Kui võtmete kappi kasutab mitu isikut, peab olema tagatud, et kasutaja saab võtta ainult talle vajaliku võtme.",
      "rdfs:label": {
        "@value": "Reg_317593_Par_77 (redaktsioon 317593)",
