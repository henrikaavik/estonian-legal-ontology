    {
      "@id": "estleg:Reg_1032726_Par_12_v1032726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032726_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigitee andmeandjaks on Maanteeamet. Riigitee andmeandjaks on Maanteeamet. 2 (2) Kohaliku tee andmeandjaks on kohaliku omavalitsuse üksus. Kohaliku tee andmeandjaks on kohaliku omavalitsuse üksus. 3 (3) Paragrahvi 7 lõike 1 punktides 1–3 toodud tee andmeandjaks on tee omanik. Tee omaniku nõusolekul võib andmeandjaks olla ka kohaliku omavalitsuse üksus. Paragrahvi 7 lõike 1 punktides 1–3 toodud tee andmeandjaks on tee omanik. Tee omaniku nõusolekul võib andmeandjaks olla ka kohaliku omavalitsuse üksus.",
      "rdfs:label": {
        "@value": "Reg_1032726_Par_12 (redaktsioon 1032726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032726",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032726",
      "estleg:sourceAct": "Teeregistri põhimäärus",
      "estleg:provisionRef": "Reg_1032726 § 12",
