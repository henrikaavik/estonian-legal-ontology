    {
      "@id": "estleg:Reg_1032726_Par_15_v1032726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032726_Par_15"
