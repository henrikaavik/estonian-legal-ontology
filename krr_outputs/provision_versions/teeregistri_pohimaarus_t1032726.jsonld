        "@value": "2016-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teeregistri andmetel on informatiivne tähendus. Teeregistri andmetel on informatiivne tähendus.",
      "rdfs:label": {
        "@value": "Reg_1032726_Par_4 (redaktsioon 1032726)",
        "@language": "et"
      },
