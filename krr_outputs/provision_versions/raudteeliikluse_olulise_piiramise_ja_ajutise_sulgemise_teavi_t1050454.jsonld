      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Raudteeliikluse olulise piiramise ja ajutise sulgemise teavitamise ja kooskõlastamise kord ning esitatavate dokumentide ja andmete loetelu (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Raudteeliikluse olulise piiramise ja ajutise sulgemise teavitamise ja kooskõlastamise kord ning esitatavate dokumentide ja andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1050454_Par_1_v1050454",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
