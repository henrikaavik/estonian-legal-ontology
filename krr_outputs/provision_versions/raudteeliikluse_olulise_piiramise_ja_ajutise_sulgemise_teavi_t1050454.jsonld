      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avalikku raudteed (edaspidi raudtee) majandav raudteeinfrastruktuuriettevõtja peab raudteeliikluse olulisel piiramisel või ajutisel sulgemisel (edaspidi koos raudteeliikluse piiramisel) raudteeseaduse § 44 lõike 2 tähenduses järgima käesolevas määruses sätestatud korda. Avalikku raudteed (edaspidi raudtee) majandav raudteeinfrastruktuuriettevõtja peab raudteeliikluse olulisel piiramisel või ajutisel sulgemisel (edaspidi koos raudteeliikluse piiramisel) raudteeseaduse § 44 lõike 2 tähenduses järgima käesolevas määruses sätestatud korda.",
      "rdfs:label": {
        "@value": "Reg_1050454_Par_1 (redaktsioon 1050454)",
        "@language": "et"
      },
