        "@language": "et"
      },
      "dc:source": "Patsiendiohutusjuhtumite asutusesisene dokumenteerimine ja andmete esitamine patsiendiohutuse andmekogusse"
    },
    {
      "@id": "estleg:Reg_1059781_Par_1_v1059781",
