      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse julgeolekukomisjon (edaspidi komisjon) täidab talle riigikaitseseaduse, julgeolekuasutuste seaduse ja teiste seadustega pandud ning Vabariigi Valitsuse antud ülesandeid. Vabariigi Valitsuse julgeolekukomisjon (edaspidi komisjon) täidab talle riigikaitseseaduse, julgeolekuasutuste seaduse ja teiste seadustega pandud ning Vabariigi Valitsuse antud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_1032038_Par_1 (redaktsioon 1032038)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032038",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032038",
