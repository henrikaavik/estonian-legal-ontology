      "estleg:versionValidFrom": {
        "@value": "2023-02-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 03.06.2021. a käskkirjaga nr 1-2/21/268 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 03.06.2021. a käskkirjaga nr 1-2/21/268 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1055956_Par_5 (redaktsioon 1055956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055956",
