      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Viljandi maakonna kaitsealuste looduse üksikobjektide kaitse alt väljaarvamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Viljandi maakonna kaitsealuste looduse üksikobjektide kaitse alt väljaarvamine"
    },
    {
      "@id": "estleg:Reg_1055956_Par_1_v1055956",
      "@type": [
