      }
    },
    {
      "@id": "estleg:PandiKS_Par_75_v104122019012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PandiKS_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "PandiKS_Par_75 (redaktsioon 104122019012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122019012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104122019012",
      "estleg:sourceAct": "Pandikirjaseadus",
      "estleg:provisionRef": "PandiKS § 75",
