      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Hiiumaa valla piiriks on senise Emmaste valla, Hiiu valla, Käina valla ja Pühalepa valla piir, välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Hiiumaa valla piiriks on senise Emmaste valla, Hiiu valla, Käina valla ja Pühalepa valla piir, välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Hiiumaa valla piiri riigi maakatastri kaardile. Maa-amet kannab Hiiumaa valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1039323_Par_2 (redaktsioon 1039323)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039323",
