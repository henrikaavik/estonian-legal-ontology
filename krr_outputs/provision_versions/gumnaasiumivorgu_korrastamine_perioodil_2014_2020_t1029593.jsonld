      "estleg:provisionRef": "Reg_1029593 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029593_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029593_Par_27_v1029593",
