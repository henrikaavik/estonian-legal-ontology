    {
      "@id": "estleg:Reg_1029593_Par_9_v1029593",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029593_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Projektile antakse toetust kuni 100% projekti abikõlblikest kuludest. Projektile antakse toetust kuni 100% projekti abikõlblikest kuludest. 2 (2) Projektile antava toetuse suurim summa ja protsendimäär abikõlblikest kuludest kehtestatakse toetuse taotluse rahuldamise otsuses. Minimaalne toetuse summa on 200 000 eurot. Projektile antava toetuse suurim summa ja protsendimäär abikõlblikest kuludest kehtestatakse toetuse taotluse rahuldamise otsuses. Minimaalne toetuse summa on 200 000 eurot.",
      "rdfs:label": {
        "@value": "Reg_1029593_Par_9 (redaktsioon 1029593)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029593",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029593",
      "estleg:sourceAct": "Gümnaasiumivõrgu korrastamine perioodil 2014-2020",
      "estleg:provisionRef": "Reg_1029593 § 9",
