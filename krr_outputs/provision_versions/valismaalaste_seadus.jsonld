      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiripunktis erandina viisa andmise või andmisest keeldumise otsustab Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "VALISM_Par_83 (redaktsioon 13331195)",
