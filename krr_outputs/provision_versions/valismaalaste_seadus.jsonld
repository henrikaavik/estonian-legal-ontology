      },
      "estleg:versionText": "Välismaalase seadusliku aluseta Eestis viibimise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "VALISM_Par_298 (redaktsioon 121032011053)",
        "@language": "et"
      },
