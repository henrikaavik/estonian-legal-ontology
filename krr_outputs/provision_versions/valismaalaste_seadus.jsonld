      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avalduse esitamine ei ole aluseks välismaalase Schengeni konventsiooni liikmesriikide territooriumile saabumiseks, jätkuvaks Schengeni konventsiooni liikmesriikide territooriumil viibimiseks ega lükka välismaalase Schengeni konventsiooni liikmesriikide territooriumilt lahkumise kohustuse täitmist edasi.",
      "rdfs:label": {
        "@value": "VALISM_Par_100_11 (redaktsioon 121032011053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032011053",
