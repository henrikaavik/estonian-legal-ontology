        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_253 (redaktsioon 103012017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017004"
    },
    {
      "@id": "estleg:VALISM_Par_253_1_v129062012050",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_253_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet võib keelduda välismaalase Eestist eemalviibimise registreerimisest, kui: välismaalase kavandatav Eestist eemalviibimine ei ole põhjendatud või välismaalase kavandatav Eestist eemalviibimine ei võimalda täita elamisloa andmise eesmärki.",
      "rdfs:label": {
        "@value": "VALISM_Par_253_1 (redaktsioon 129062012050)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062012050",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_253_1_v103012017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_253_1_v103012017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_253_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_253_1 (redaktsioon 103012017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017004"
    },
    {
      "@id": "estleg:VALISM_Par_254_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_254"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui välismaalane on Eestist eemalviibimise registreerinud, loetakse tema Eestist eemalviibitud aeg püsivalt Eestis elatud aja hulka.",
      "rdfs:label": {
        "@value": "VALISM_Par_254 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_254_v103012017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_254_v103012017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_254"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_254 (redaktsioon 103012017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017004"
    },
    {
      "@id": "estleg:VALISM_Par_255_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_255"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalane võib Eestist eemalviibimise registreerida kuni kaheks aastaks korraga.",
      "rdfs:label": {
        "@value": "VALISM_Par_255 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
