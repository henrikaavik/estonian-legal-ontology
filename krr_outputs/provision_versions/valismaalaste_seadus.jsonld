    {
      "@id": "estleg:VALISM_Par_100_12_v121032011053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_100_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avaldus esitatakse isiklikult, posti teel või esindaja kaudu. (2) Avaldus esitatakse kirjalikult.",
      "rdfs:label": {
        "@value": "VALISM_Par_100_12 (redaktsioon 121032011053)",
