      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pikaajalise viisa võib anda välismaalasele ühe- või mitmekordseks ajutiseks Eestis viibimiseks. (2) Pikaajalise viisa võib anda kehtivusajaga kuni 12 kuud. (3) Pikaajalise viisa võib anda kuni kuuekuulise viibimisajaga kaheteistkümne järjestikuse kuu jooksul, kui välisleping ei sätesta teisiti. (4) Kehtetu - (5) Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_60 (redaktsioon 102072013066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013066",
      "estleg:supersededByVersion": {
