      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "VALISM_Par_307 (redaktsioon 112072014157)",
        "@language": "et"
