    },
    {
      "@id": "estleg:VALISM_Par_169_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalane, kellel on Euroopa Liidu liikmesriigi pikaajalise elaniku elamisluba ning kes taotleb tähtajalist elamisluba õppimiseks, peab täiendavalt tõendama Euroopa Liidu pikaajalise elaniku elamisloa olemasolu.",
      "rdfs:label": {
        "@value": "VALISM_Par_169 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195"
    },
    {
      "@id": "estleg:VALISM_Par_17_v22260",
