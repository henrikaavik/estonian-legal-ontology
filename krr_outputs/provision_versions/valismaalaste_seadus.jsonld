        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus võib välisriikidega sõlmida viisaküsimustes Eesti Vabariigi esindamisega seotud kokkuleppeid.",
      "rdfs:label": {
        "@value": "VALISM_Par_88 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195"
    },
    {
      "@id": "estleg:VALISM_Par_89_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välismaalane esitab viisa saamiseks viisataotluse. (2) Vähemalt 15-aastane alaliselt välisriigis elav alaealine võib esitada viisataotluse iseseisvalt. Viisataotluse iseseisval esitamisel võib haldusorgan nõuda seadusliku esindaja notariaalselt kinnitatud nõusolekut.",
      "rdfs:label": {
        "@value": "VALISM_Par_89 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195"
