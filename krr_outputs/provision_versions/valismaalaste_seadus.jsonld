      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Viisa andmine vormistatakse viisakleebise kandmisega välismaalase reisidokumenti või reisidokumendi vahelehele. (2) Viisa andmine vormistatakse reisidokumendi vahelehele juhul, kui Eesti seda reisidokumenti ei tunnusta.",
      "rdfs:label": {
        "@value": "VALISM_Par_98 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195"
    },
    {
      "@id": "estleg:VALISM_Par_99_v13331195",
