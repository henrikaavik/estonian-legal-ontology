      "estleg:versionRedactionId": "13331195"
    },
    {
      "@id": "estleg:VALISM_Par_99_1_v103012017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
