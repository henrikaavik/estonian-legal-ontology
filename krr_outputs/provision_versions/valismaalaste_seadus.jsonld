      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pikaajalise elaniku elamisloa alast teabevahetust Euroopa Liidu liikmesriikidega korraldab Siseministeerium või siseministri määratud Siseministeeriumi valitsemisala asutus.",
      "rdfs:label": {
        "@value": "VALISM_Par_251 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
