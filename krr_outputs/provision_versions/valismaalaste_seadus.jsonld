      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Viibimisaja pikendamise või pikendamisest keeldumise otsustab Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "VALISM_Par_84 (redaktsioon 13331195)",
        "@language": "et"
