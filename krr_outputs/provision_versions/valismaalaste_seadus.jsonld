    {
      "@id": "estleg:VALISM_Par_258_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_258"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestist eemalviibimise registreerimise korra, tähtajad, taotluses esitatavate andmete ja taotlusele lisatavate tõendite loetelu. (2) Eestist eemalviibimise registreerimise taotluse vormi.",
      "rdfs:label": {
        "@value": "VALISM_Par_258 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_258_v112072014157"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_258_v112072014157",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_258"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) kehtestab määrusega Eestist eemalviibimise registreerimise korra, tähtajad, taotluses esitatavate andmete ja taotlusele lisatavate tõendite loetelu. (2) võib kehtestada määrusega Eestist eemalviibimise registreerimise taotluse vormi.",
      "rdfs:label": {
        "@value": "VALISM_Par_258 (redaktsioon 112072014157)",
        "@language": "et"
      },
