      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_269"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_269 (redaktsioon 102072013066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013066",
