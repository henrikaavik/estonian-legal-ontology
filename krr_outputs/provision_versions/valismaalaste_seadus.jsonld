      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_251_v115032014092",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_251"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pikaajalise elaniku elamisloa alast teabevahetust Euroopa Liidu liikmesriikidega korraldab Siseministeerium või valdkonna eest vastutava ministri määratud Siseministeeriumi valitsemisala asutus.",
      "rdfs:label": {
        "@value": "VALISM_Par_251 (redaktsioon 115032014092)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014092"
    },
    {
      "@id": "estleg:VALISM_Par_252_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_252"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui elamisluba omav välismaalane soovib Eestist eemal viibida rohkem kui 183 päeva aasta jooksul, peab ta registreerima Eestist eemalviibimise Politsei- ja Piirivalveametis. (2) Eemalviibimist on võimalik registreerida vaid edasiulatuvalt.",
      "rdfs:label": {
        "@value": "VALISM_Par_252 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_252_v103012017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_252_v103012017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_252"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_252 (redaktsioon 103012017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017004"
    },
    {
      "@id": "estleg:VALISM_Par_253_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_253"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet võib välismaalase Eestist eemalviibimise registreerida, kui välismaalane kavatseb viibida ajutiselt välisriigis järgmisel eesmärgil: õppimine; töötamine; välisriigi relvajõududes ajateenistuses viibimine või muu ajutise iseloomuga põhjus, mis eeldab välismaalase Eestist eemalviibimist.",
      "rdfs:label": {
        "@value": "VALISM_Par_253 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_253_v117122015014"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_253_v117122015014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_253"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet võib välismaalase Eestist eemalviibimise registreerida, kui välismaalane kavatseb viibida ajutiselt välisriigis järgmisel eesmärgil: õppimine; töötamine; ettevõtlus; välisriigi relvajõududes ajateenistuses viibimine või muu ajutise iseloomuga põhjus, mis eeldab välismaalase Eestist eemalviibimist.",
      "rdfs:label": {
        "@value": "VALISM_Par_253 (redaktsioon 117122015014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015014",
