      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_93_v117062020005",
      "@type": [
        "owl:NamedIndividual",
