      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalasele, kellele on antud elamisluba, antakse Vabariigi Valitsuse volitatud valitsusasutuse poolt isikukood .",
      "rdfs:label": {
