      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_109_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalase lühiajalise Eestis töötamise registreering lõpeb ajutise viibimisaluse lõppemisel või elamisloa andmisel.",
      "rdfs:label": {
