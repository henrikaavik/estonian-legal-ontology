      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalasele, kellele on antud elamisluba, antakse Vabariigi Valitsuse volitatud valitsusasutuse poolt isikukood. [Paragrahvi 17 sõnastus alates 01.05.2003]",
      "rdfs:label": {
        "@value": "VALISM_Par_17 (redaktsioon 684564)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "684564",
