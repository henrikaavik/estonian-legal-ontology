    {
      "@id": "estleg:VALISM_Par_106_v106052020046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_106"
