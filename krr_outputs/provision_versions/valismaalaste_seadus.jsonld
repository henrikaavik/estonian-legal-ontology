        "@id": "estleg:VALISM_Par_269_v102072013066"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_269_v102072013066",
      "@type": [
        "owl:NamedIndividual",
