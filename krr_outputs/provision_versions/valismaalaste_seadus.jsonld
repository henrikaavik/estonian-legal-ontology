    },
    {
      "@id": "estleg:VALISM_Par_87_v117042025013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus võib korraldusega otsustada erandi tegemise viisanõudest ja viisanõudest loobumisest kooskõlas Euroopa Parlamendi ja nõukogu määrusega (EL) 2018/1806, milles loetletakse kolmandad riigid, kelle kodanikel peab välispiiride ületamisel olema viisa, ja need kolmandad riigid, kelle kodanikud on sellest nõudest vabastatud (ELT L 303, 28.11.2018, lk 39–58).",
