      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_246"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pikaajalise elaniku elamisloa taastamiseks esitab välismaalane pikaajalise elaniku elamisloa taastamise taotluse Politsei- ja Piirivalveametile.",
      "rdfs:label": {
        "@value": "VALISM_Par_246 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_246_v109122010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_246_v109122010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_246"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipidamisasutuses viibiva kinnipeetava, vahistatu või arestialuse pikaajalise elaniku elamisloa taotluse või pikaajalise elaniku elamisloa taastamise vormikohase taotluse edastab välismaalase poolt selleks volitatud kinnipidamisasutuse töötaja. Kinnipidamisasutuse töötaja esitab nimetatud toimingute sooritamisel lisaks kinnipeetava volikirjale oma ametitõendi. (2) Kinnipidamisasutuses viibiv kinnipeetav, vahistatu või arestialune võib käesoleva paragrahvi lõikes 1 nimetatud taotluse esitada posti teel kinnipidamisasutuse kaudu kinnipidamisasutuse kaaskirjaga, mis kinnitab, et kinnipidamisasutuse teenistuja on kontrollinud taotleja isikusamasust.",
      "rdfs:label": {
        "@value": "VALISM_Par_246 (redaktsioon 109122010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010009",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_246_v119032015072"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_246_v119032015072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_246"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kinnipidamisasutuses viibiva kinnipeetava, vahistatu või arestialuse pikaajalise elaniku elamisloa taotluse või pikaajalise elaniku elamisloa taastamise vormikohase taotluse edastab välismaalase poolt selleks volitatud kinnipidamisasutuse ametnik või töötaja. Kinnipidamisasutuse ametnik või töötaja esitab nimetatud toimingute sooritamisel lisaks kinnipeetava volikirjale oma ametitõendi. (2) Kinnipidamisasutuses viibiv kinnipeetav, vahistatu või arestialune võib käesoleva paragrahvi lõikes 1 nimetatud taotluse esitada posti teel kinnipidamisasutuse kaudu kinnipidamisasutuse kaaskirjaga, mis kinnitab, et kinnipidamisasutuse ametnik või töötaja on kontrollinud taotleja isikusamasust.",
      "rdfs:label": {
        "@value": "VALISM_Par_246 (redaktsioon 119032015072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015072",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_246_v103012017004"
      },
