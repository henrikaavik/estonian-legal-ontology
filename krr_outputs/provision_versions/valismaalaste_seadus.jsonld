        "@id": "estleg:VALISM_Par_255_v103012017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_255_v103012017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_255"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_255 (redaktsioon 103012017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017004"
    },
    {
      "@id": "estleg:VALISM_Par_256_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_256"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui välismaalane viibis Eestist eemal rohkem kui 183 päeva aasta jooksul, kuid tal ei olnud mõjuval põhjusel võimalik oma eemalviibimist registreerida, võib Politsei- ja Piirivalveamet lugeda välismaalase Eestist eemalviibitud aja püsivalt Eestis elatud aja hulka.",
      "rdfs:label": {
        "@value": "VALISM_Par_256 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALISM_Par_256_v103012017004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALISM_Par_256_v103012017004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_256"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALISM_Par_256 (redaktsioon 103012017004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017004"
    },
    {
      "@id": "estleg:VALISM_Par_257_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_257"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalane peab Eestist eemalviibimise registreerimisel või taotluse esitamisel eemalviibimise põhjendatuks lugemiseks tõendama eemalviibimise põhjust ja asjaolusid.",
      "rdfs:label": {
        "@value": "VALISM_Par_257 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
