    },
    {
      "@id": "estleg:VALISM_Par_85_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Viisa tühistamise otsustab Välisministeerium, Politsei- ja Piirivalveamet või Kaitsepolitseiamet. (2) Eesti riigipiirile, transiiditsooni või ajutisele kontrolljoonele saabunud välismaalase viisa tühistamise otsustab Politsei- ja Piirivalveamet.",
      "rdfs:label": {
        "@value": "VALISM_Par_85 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195"
    },
    {
      "@id": "estleg:VALISM_Par_86_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Viisa tunnistab kehtetuks Välisministeerium, Politsei- ja Piirivalveamet või Kaitsepolitseiamet.",
      "rdfs:label": {
        "@value": "VALISM_Par_86 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195"
    },
    {
      "@id": "estleg:VALISM_Par_87_v13331195",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALISM_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus võib otsustada viisanõudest loobumise kooskõlas nõukogu määrusega (EÜ) nr 539/2001, milles loetletakse kolmandad riigid, kelle kodanikel peab välispiiride ületamisel olema viisa, ja need kolmandad riigid, kelle kodanikud on sellest nõudest vabastatud (EÜT L 81, 21.03.2001, lk 1–7).",
      "rdfs:label": {
        "@value": "VALISM_Par_87 (redaktsioon 13331195)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13331195",
      "estleg:supersededByVersion": {
