      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_158713_Par_20 (redaktsioon 158713)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158713",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158713",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete nimekirjad ning nende ainete meditsiinilisel ja teaduslikul eesmärgil käitlemine",
      "estleg:provisionRef": "Reg_158713 § 20",
