      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet geoportaali pidamise seaduslikkuse üle teostab avaliku teabe seaduse § 531 lõikes 1 sätestatud asutus seaduses sätestatud korras. Järelevalvet geoportaali pidamise seaduslikkuse üle teostab avaliku teabe seaduse § 531 lõikes 1 sätestatud asutus seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1016079_Par_12 (redaktsioon 1016079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016079",
