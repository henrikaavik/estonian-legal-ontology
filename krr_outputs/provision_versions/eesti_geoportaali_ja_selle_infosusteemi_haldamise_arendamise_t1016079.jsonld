        "@id": "estleg:Reg_1016079_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1016079_Par_10_v1016079",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016079_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geoportaali kasutaja on iga isik, kes kasutab geoportaalis pakutavaid teenuseid ja ruumiandmetega seotud teavet vastavalt oma vajadusele geoportaalis lubatud õiguste kohaselt. Geoportaali kasutaja on iga isik, kes kasutab geoportaalis pakutavaid teenuseid ja ruumiandmetega seotud teavet vastavalt oma vajadusele geoportaalis lubatud õiguste kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1016079_Par_10 (redaktsioon 1016079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016079",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1016079",
      "estleg:sourceAct": "Eesti geoportaali ja selle infosüsteemi haldamise, arendamise, kasutamise ning selle kaudu teabe kättesaadavaks tegemise nõuded ja kord",
      "estleg:provisionRef": "Reg_1016079 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1016079_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1016079_Par_11_v1016079",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
