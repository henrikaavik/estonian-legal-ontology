      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infosüsteemi hooldus- ja arendustöid ning pidamist rahastatakse riigieelarvest vastutavale ja volitatud töötlejale selleks otstarbeks eraldatud vahenditest. RT I 2018-01-09 9 109012018009 2018-02-01 Infosüsteemi hooldus- ja arendustöid ning pidamist rahastatakse riigieelarvest vastutavale ja volitatud töötlejale selleks otstarbeks eraldatud vahenditest.",
      "rdfs:label": {
        "@value": "Reg_1016079_Par_11 (redaktsioon 1016079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016079",
