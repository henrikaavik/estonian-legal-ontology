      "estleg:provisionRef": "Reg_1016079 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1016079_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1016079_Par_8_v1016079",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1016079_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geoportaali teenuste kaudu avalikustatavatel andmetel on õiguslik tähendus ulatuses, mis on neile õigusaktiga antud. Geoportaali teenuste kaudu avalikustatavatel andmetel on õiguslik tähendus ulatuses, mis on neile õigusaktiga antud.",
      "rdfs:label": {
        "@value": "Reg_1016079_Par_8 (redaktsioon 1016079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1016079",
