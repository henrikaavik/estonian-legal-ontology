      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062524_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062524_Par_2_v1062524",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062524_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õpilaste teadustööde riikliku konkursi kuulutab igal aastal hiljemalt 31. detsembriks ja õpilasleiutajate riikliku konkursi hiljemalt 30. juuniks välja Haridus- ja Teaduministeeriumi (edaspidi ministeerium) kantsler käskkirjadega. Õpilaste teadustööde riikliku konkursi kuulutab igal aastal hiljemalt 31. detsembriks ja õpilasleiutajate riikliku konkursi hiljemalt 30. juuniks välja Haridus- ja Teaduministeeriumi (edaspidi ministeerium) kantsler käskkirjadega. 2 (2) Käskkirjades märgitakse konkursside eelarve, auhindade arv ja suurus, konkursside kategooriad, konkursitöödele esitatavad nõuded, konkursitööde esitamise koht ja tähtaeg, esitatavate dokumentide loetelu ning konkursside tulemuste avalikustamisel avaldatavate andmete koosseis. Käskkirjades märgitakse konkursside eelarve, auhindade arv ja suurus, konkursside kategooriad, konkursitöödele esitatavad nõuded, konkursitööde esitamise koht ja tähtaeg, esitatavate dokumentide loetelu ning konkursside tulemuste avalikustamisel avaldatavate andmete koosseis. 3 (3) Teated konkursside väljakuulutamise ja konkursitingimuste ning konkursitöödele esitatavate nõuete kohta avaldatakse Sihtasutuse Eesti Teadusagentuur (edaspidi rakendusüksus) ametlikes infokanalites. Teated konkursside väljakuulutamise ja konkursitingimuste ning konkursitöödele esitatavate nõuete kohta avaldatakse Sihtasutuse Eesti Teadusagentuur (edaspidi rakendusüksus) ametlikes infokanalites.",
      "rdfs:label": {
        "@value": "Reg_1062524_Par_2 (redaktsioon 1062524)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062524",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062524",
