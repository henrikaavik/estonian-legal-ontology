      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062524_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkursid loetakse luhtunuks, kui konkurssidel osalemiseks ei esitatud ühtegi konkursitööd või ükski konkursitöö ei vastanud esitatud nõuetele. Konkursside luhtumisel otsustab ministeerium uute konkursside korraldamise. Konkursid loetakse luhtunuks, kui konkurssidel osalemiseks ei esitatud ühtegi konkursitööd või ükski konkursitöö ei vastanud esitatud nõuetele. Konkursside luhtumisel otsustab ministeerium uute konkursside korraldamise.",
      "rdfs:label": {
        "@value": "Reg_1062524_Par_10 (redaktsioon 1062524)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062524",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062524",
      "estleg:sourceAct": "Õpilaste teadustööde riikliku konkursi ja õpilasleiutajate riikliku konkursi läbiviimise tingimused ja kord",
