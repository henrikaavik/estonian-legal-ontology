      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetust antakse kuni 70 protsenti kindlustusperioodil tasutud kindlustusmaksetest. Toetust antakse kuni 70 protsenti kindlustusperioodil tasutud kindlustusmaksetest.",
      "rdfs:label": {
        "@value": "Reg_1046948_Par_5 (redaktsioon 1046948)",
        "@language": "et"
      },
