      },
      "estleg:versionValidFrom": {
        "@value": "2021-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustuslepingu võib sõlmida Eestis kindlustustegevuseks õigust omava kindlustusandjaga. Kindlustuslepingu võib sõlmida Eestis kindlustustegevuseks õigust omava kindlustusandjaga.",
      "rdfs:label": {
        "@value": "Reg_1046948_Par_4 (redaktsioon 1046948)",
