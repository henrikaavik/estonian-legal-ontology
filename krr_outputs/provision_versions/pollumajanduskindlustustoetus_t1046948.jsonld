        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA kontrollib taotluse vastuvõtmisel nõutavate dokumentide olemasolu. PRIA kontrollib taotluse vastuvõtmisel nõutavate dokumentide olemasolu.",
      "rdfs:label": {
        "@value": "Reg_1046948_Par_8 (redaktsioon 1046948)",
        "@language": "et"
