      }
    },
    {
      "@id": "estleg:Psteseadus_Par_33_v13314868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabatahtlikuks päästjaks võib võtta vähemalt 18-aastaseks saanud isiku, kes vastab vabatahtliku päästja kutsesobivuse nõuetele. (2) Vabatahtliku päästja kutsesobivuse ja füüsilise ettevalmistuse nõuded",
      "rdfs:label": {
        "@value": "Psteseadus_Par_33 (redaktsioon 13314868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314868",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_33_v131122014020"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_33_v131122014020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabatahtlikuks päästjaks võib võtta vähemalt 18-aastaseks saanud isiku, kes vastab vabatahtliku päästja kutsesobivuse nõuetele. (2) Vabatahtliku päästja kutsesobivuse ja füüsilise ettevalmistuse nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_33 (redaktsioon 131122014020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122014020",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_33_v130122015037"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-17",
