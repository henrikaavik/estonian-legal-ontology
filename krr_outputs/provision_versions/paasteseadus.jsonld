        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Psteseadus_Par_63 (redaktsioon 130122010005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122010005"
    },
    {
      "@id": "estleg:Psteseadus_Par_64_v13314868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2010. aasta 1. septembril. (2) Käesoleva seaduse §-d 50 ja 58 jõustuvad üldises korras.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_64 (redaktsioon 13314868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314868"
    },
    {
      "@id": "estleg:Psteseadus_Par_7_v22278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui maavanem või kohalik omavalitsus on sõlminud ettevõtjaga tulekustutus- ja päästetööde tegemise lepingu, laienevad lepingus ettenähtud ulatuses maavalitsuse hallatava päästeasutuse või kohaliku omavalitsuse päästeasutuse kohustused ja õigused tulekustutus- ja päästetöid tegevale ettevõtte päästeallüksusele. (2) Nimetatud lepingu alusel laienevad paragrahvides 34 ja 35 ettenähtud tagatised tulekustutus- ja päästetöid tegevatele ja korraldavatele töötajatele.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_7 (redaktsioon 22278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22278",
      "estleg:supersededByVersion": {
