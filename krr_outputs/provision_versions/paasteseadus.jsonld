      }
    },
    {
      "@id": "estleg:Psteseadus_Par_33_v130122015037",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabatahtlikuks päästjaks võib võtta vähemalt 18-aastaseks saanud isiku, kes vastab vabatahtliku päästja kutsesobivuse nõuetele. (2) Vabatahtliku päästja kutsesobivuse ja füüsilise ettevalmistuse nõuded kehtestab määrusega. (3) Vabatahtlikuks päästjaks võib võtta ka välisriigi kutsekvalifikatsiooni omandanud isiku, kui tema kutsekvalifikatsiooni on tunnustatud välisriigi kutsekvalifikatsiooni tunnustamise seaduse kohaselt. Välisriigi kutsekvalifikatsiooni tunnustamise seaduse § 7 lõikes 2 sätestatud pädev asutus on Päästeamet.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_33 (redaktsioon 130122015037)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015037",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_33_v113032019123"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_33_v113032019123",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabatahtlikuks päästjaks võib võtta vähemalt 18-aastaseks saanud isiku, kes vastab vabatahtliku päästja kutsesobivuse nõuetele. (2) Vabatahtliku päästja kutsesobivuse ja füüsilise ettevalmistuse nõuded ning vabatahtliku päästja kohta kogutud isikuandmete säilitamise tähtaja kehtestab määrusega. (3) Vabatahtlikuks päästjaks võib võtta ka välisriigi kutsekvalifikatsiooni omandanud isiku, kui tema kutsekvalifikatsiooni on tunnustatud välisriigi kutsekvalifikatsiooni tunnustamise seaduse kohaselt. Välisriigi kutsekvalifikatsiooni tunnustamise seaduse § 7 lõikes 2 sätestatud pädev asutus on Päästeamet.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_33 (redaktsioon 113032019123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019123",
