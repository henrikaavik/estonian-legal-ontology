        "@language": "et"
      },
      "estleg:versionRedactionId": "131122014020"
    },
    {
      "@id": "estleg:Psteseadus_Par_45_v780606",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avaliku konkursita teenistusse võetud ametnik, kelle ametikoht on avaliku teenistuse seaduse kohaselt konkursi korras täidetav, võib töötada niisugusel ametikohal kuni atesteerimiseni. (2) Kui käesoleva paragrahvi lõikes 1 nimetatud ametnik tunnistatakse atesteerimisel ametikohale vastavaks, võrdsustatakse atesteerimistulemused konkursitulemustega.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_45 (redaktsioon 780606)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780606",
      "estleg:supersededByVersion": {
