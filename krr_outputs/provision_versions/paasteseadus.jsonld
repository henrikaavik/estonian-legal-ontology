      },
      "estleg:versionText": "Päästeseadus (RT I 1994, 28, 424; 2009, 62, 405) tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_63 (redaktsioon 13314868)",
        "@language": "et"
      },
