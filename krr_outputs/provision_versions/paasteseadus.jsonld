      },
      "estleg:versionRedactionId": "115032014039"
    },
    {
      "@id": "estleg:Psteseadus_Par_15_v22278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tulekustutus- ja päästetööde juht on isik, kellele alluvad kõik õnnetuskohale saabunud tulekustutus- ja päästemeeskonnad ning lisajõud. Tulekustutus- ja päästetööde juhi määramise kord sätestatakse tulekustutus- ja päästetööde eeskirjades. (2) Tulekustutus- ja päästetööde juhi seaduslikke korraldusi (paragrahv 16) ei ole kellelgi õigus muuta.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_15 (redaktsioon 22278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22278",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_15_v186434"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_15_v186434",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tulekustutus- ja päästetööde juht on isik, kellele alluvad kõik õnnetuskohale saabunud tulekustutus- ja päästemeeskonnad ning lisajõud. Tulekustutus- ja päästetööde juhi määramise kord sätestatakse tulekustutus- ja päästetööde eeskirjades. (2) Tulekustutus- ja päästetööde juhi seaduslikke korraldusi (§ 16) ei ole kellelgi õigus muuta.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_15 (redaktsioon 186434)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186434",
