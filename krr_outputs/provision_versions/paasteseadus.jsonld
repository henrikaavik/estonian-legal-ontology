      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Psteseadus_Par_17 (redaktsioon 1011009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011009",
      "estleg:supersededByVersion": {
