    },
    {
      "@id": "estleg:Psteseadus_Par_13_v22278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi päästeasutuste struktuurile, varustatusele, dokumentatsioonile ja töökorraldusele esitatavad nõuded kehtestab Vabariigi Valitsus määrusega. (2) Siseminister kehtestab määrusega: tulekustutus- ja päästetööde eeskirjad; tulekustutus- ja päästemeeskondade sündmuskohale väljasõitude ja sündmuste arvestuse korra; päästeasutuste tulekustutus- ja päästemeeskondade valveteenistuse korraldusele esitatavad nõuded; riigi päästeasutuste struktuuriüksuste paiknemise; kohaliku omavalitsuse päästeasutusele, ettevõtte päästeallüksusele ning tulekustutus- ja päästetöid tegevale mittetulundusühingule esitatavad nõuded käesoleva seaduse §-des 6, 7 ja 8 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_13 (redaktsioon 22278)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22278",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_13_v780606"
      },
      "estleg:versionValidTo": {
        "@value": "2004-06-30",
        "@type": "xsd:date"
      }
    },
