      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Häirekeskus on valmis osutama kriisiinfo teenust Siseministeeriumi valitsemisala asutustele alates 2020. aasta 15. juulist. (2) Häirekeskus on valmis osutama kriisiinfo teenust riigiasutustele ja kohaliku omavalitsuse üksustele alates 2021. aasta 1. jaanuarist.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_49_2 (redaktsioon 103072020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103072020002"
    },
