      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_46_v13314868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ulatuslikul või pikaajalisel päästetööl osalevale vabatahtlikule päästjale ja § 19 alusel päästetööle rakendatud füüsilisele isikule makstakse Vabariigi Valitsuse reservist päästetööl osaletud aja eest tasu. (2) Vabatahtlikule päästjale ja päästetööle rakendatud füüsilisele isikule ulatuslikul või pikaajalisel päästetööl osaletud aja eest tasu maksmise ulatuse ja korra",
      "rdfs:label": {
        "@value": "Psteseadus_Par_46 (redaktsioon 13314868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314868",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_46_v131122014020"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_46_v131122014020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ulatuslikul või pikaajalisel päästetööl osalevale vabatahtlikule päästjale ja § 19 alusel päästetööle rakendatud füüsilisele isikule makstakse Vabariigi Valitsuse reservist päästetööl osaletud aja eest tasu. (2) Vabatahtlikule päästjale ja päästetööle rakendatud füüsilisele isikule ulatuslikul või pikaajalisel päästetööl osaletud aja eest tasu maksmise ulatuse ja korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_46 (redaktsioon 131122014020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122014020",
