      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Psteseadus_Par_9 (redaktsioon 1011009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011009",
      "estleg:supersededByVersion": {
