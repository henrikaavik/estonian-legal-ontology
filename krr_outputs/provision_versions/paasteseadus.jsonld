        "@id": "estleg:Psteseadus_Par_10_v13201949"
      },
      "estleg:versionValidTo": {
        "@value": "2009-07-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_10_v13201949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siseministeerium päästeala korraldamisel suunab, koordineerib ja korraldab: suurõnnetuste kohta teabe kogumist, töötlemist ja analüüsimist nende prognoosimiseks, ennetamiseks ja likvideerimiseks; päästeala üleriigiliste arengukontseptsioonide ja -programmide väljatöötamist; päästeala häire-, side- ja mõõtesüsteemide kavandamist ja väljaarendamist. Kehtetu –",
      "rdfs:label": {
        "@value": "Psteseadus_Par_10 (redaktsioon 13201949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201949",
      "estleg:supersededByVersion": {
