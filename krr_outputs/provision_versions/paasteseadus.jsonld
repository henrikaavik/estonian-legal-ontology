      },
      "estleg:versionText": "Tulekustutus- ja päästetöid allmaarajatistes korraldab mäepäästeteenistus Vabariigi Valitsuse poolt määratud korras. [Paragrahvi 20 sõnastus alates 1. 05. 2003]",
      "rdfs:label": {
        "@value": "Psteseadus_Par_20 (redaktsioon 264688)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264688",
