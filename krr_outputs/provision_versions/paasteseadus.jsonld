      }
    },
    {
      "@id": "estleg:Psteseadus_Par_10_v13314868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeinfosüsteemi vastutav töötleja on Päästeamet. (2) Päästeinfosüsteemi volitatud töötlejad on päästekeskus ja Häirekeskus.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_10 (redaktsioon 13314868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314868",
