        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_22_v115032014039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_22"
      },
      "estleg:versionValidFrom": {
