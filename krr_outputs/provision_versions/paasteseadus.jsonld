      },
      "estleg:versionValidFrom": {
        "@value": "2008-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siseminister ja päästeasutuse juht võivad päästetöödel rakendatud isikutele ja päästeala töödel silma paistnud isikutele avaldada tänu. Inimeste või vara päästmisel vaprust ilmutanud, samuti päästeala arendamisel eriti silma paistnud isikutele võib siseminister määrata autasuks päästeteenistuse aumärgi.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_38 (redaktsioon 12924861)",
        "@language": "et"
      },
