      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päästeasutus võib töödelda oma ülesannete täitmiseks isikuandmeid isikuandmete kaitse seaduses sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_7 (redaktsioon 13314868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314868"
    },
    {
      "@id": "estleg:Psteseadus_Par_8_v22278",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
