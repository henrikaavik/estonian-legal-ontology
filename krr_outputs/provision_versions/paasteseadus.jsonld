      }
    },
    {
      "@id": "estleg:Psteseadus_Par_14_v13314868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeasutusel on õigus teha toiminguid (teadaanded, soovitused, hoiatused), millega teavitatakse avalikkust või isikut päästesündmusest või sellega seotud ohust. (2) Isikuandmete avalikustamine on lubatud vaid sellisel juhul ja sellises ulatuses, kui see on vältimatult vajalik ohust või päästesündmusest teavitamiseks. (3) Kui päästeasutus teavitab avalikkust või isikut ohust ning see ei osutu põhjendatuks, on päästeasutus kohustatud avaldama samas vormis ja mahus teate ohu puudumise kohta, kui seda nõuab isik, kelle õigusi teavitamisega kahjustati või kui selleks on kaalukas avalik huvi.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_14 (redaktsioon 13314868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314868",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_14_v129122011206"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_14_v129122011206",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Psteseadus_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Päästeametil on õigus teha toiminguid (teadaanded, soovitused, hoiatused), millega teavitatakse avalikkust või isikut päästesündmusest või sellega seotud ohust. (2) Isikuandmete avalikustamine on lubatud vaid sellisel juhul ja sellises ulatuses, kui see on vältimatult vajalik ohust või päästesündmusest teavitamiseks. (3) Kui Päästeamet teavitab avalikkust või isikut ohust ning see ei osutu põhjendatuks, on Päästeamet kohustatud avaldama samas vormis ja mahus teate ohu puudumise kohta, kui seda nõuab isik, kelle õigusi teavitamisega kahjustati või kui selleks on kaalukas avalik huvi.",
      "rdfs:label": {
        "@value": "Psteseadus_Par_14 (redaktsioon 129122011206)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011206",
      "estleg:supersededByVersion": {
        "@id": "estleg:Psteseadus_Par_14_v115032014039"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Psteseadus_Par_14_v115032014039",
