    {
      "@id": "estleg:Reg_1024833_Par_18_v1024833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024833_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siimusti-Kurista maastikukaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi ametlikus väljaandes Ametlikud Teadaanded 12. septembril 2006. a avaldatud teatega algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas3. Siimusti-Kurista maastikukaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi ametlikus väljaandes Ametlikud Teadaanded 12. septembril 2006. a avaldatud teatega algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas3.",
      "rdfs:label": {
        "@value": "Reg_1024833_Par_18 (redaktsioon 1024833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024833",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024833",
      "estleg:sourceAct": "Siimusti-Kurista maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1024833 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024833_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024833_Par_19_v1024833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024833_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1024833_Par_19 (redaktsioon 1024833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024833",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024833",
      "estleg:sourceAct": "Siimusti-Kurista maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1024833 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024833_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024833_Par_2_v1024833",
