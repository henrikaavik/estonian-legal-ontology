    {
      "@id": "estleg:Reg_1024833_Par_15_v1024833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024833_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puidu kokku- ja väljavedu külmumata pinnaselt, välja arvatud kaitseala valitseja nõusolekul juhul, kui pinnas seda võimaldab; 2 2) puhtpuistute kujundamine ja energiapuistute rajamine; 3 3) maavara kaevandamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine. Piiranguvööndis on keelatud: puidu kokku- ja väljavedu külmumata pinnaselt, välja arvatud kaitseala valitseja nõusolekul juhul, kui pinnas seda võimaldab; puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; uue maaparandussüsteemi rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine.",
      "rdfs:label": {
        "@value": "Reg_1024833_Par_15 (redaktsioon 1024833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024833",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024833",
      "estleg:sourceAct": "Siimusti-Kurista maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1024833 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024833_Map_2026"
      }
    },
