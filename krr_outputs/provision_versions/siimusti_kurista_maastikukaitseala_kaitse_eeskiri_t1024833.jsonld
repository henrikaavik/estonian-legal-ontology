    {
      "@id": "estleg:Reg_1024833_Par_1_v1024833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024833_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Siimusti-Kurista maastikukaitseala1 (edaspidi kaitseala) kaitse-eesmärk on kaitsta: 1 1) vaheldusrikka oosi- ja mõhnastikureljeefiga loodus- ning pärandkultuurmaastikku; 2 2) sürja- ja laanemetsa kooslusi; 3 3) kaitsealuseid liike kahelehist käokeelt (Platanthera bifolia), pruunikat pesajuurt (Neottia nidus-avis) ja suurt käopõlle (Listera ovata). Siimusti-Kurista maastikukaitseala1 (edaspidi kaitseala) kaitse-eesmärk on kaitsta: vaheldusrikka oosi- ja mõhnastikureljeefiga loodus- ning pärandkultuurmaastikku; sürja- ja laanemetsa kooslusi; kaitsealuseid liike kahelehist käokeelt (Platanthera bifolia), pruunikat pesajuurt (Neottia nidus-avis) ja suurt käopõlle (Listera ovata). 2 (2) Kaitseala maa-ala jaguneb vastavalt kaitsekorra eripärale ja majandustegevuse piiramise astmele üheks sihtkaitsevööndiks ja üheks piiranguvööndiks. Kaitseala maa-ala jaguneb vastavalt kaitsekorra eripärale ja majandustegevuse piiramise astmele üheks sihtkaitsevööndiks ja üheks piiranguvööndiks. 3 (3) Kaitsealal tuleb arvestada looduskaitseseaduses sätestatud piiranguid käesolevas määruses sätestatud erisustega. Kaitsealal tuleb arvestada looduskaitseseaduses sätestatud piiranguid käesolevas määruses sätestatud erisustega.",
      "rdfs:label": {
        "@value": "Reg_1024833_Par_1 (redaktsioon 1024833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024833",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024833",
      "estleg:sourceAct": "Siimusti-Kurista maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1024833 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024833_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024833_Par_10_v1024833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024833_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) metsakoosluste kujundamine vastavalt kaitse-eesmärgile; 2 2) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 3 3) olemasolevate ehitiste hooldustööd; 4 4) olemasolevate maaparandussüsteemide hoiutööd. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: metsakoosluste kujundamine vastavalt kaitse-eesmärgile; kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; olemasolevate ehitiste hooldustööd; olemasolevate maaparandussüsteemide hoiutööd.",
      "rdfs:label": {
        "@value": "Reg_1024833_Par_10 (redaktsioon 1024833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024833",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024833",
      "estleg:sourceAct": "Siimusti-Kurista maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1024833 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024833_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024833_Par_11_v1024833",
      "@type": [
        "owl:NamedIndividual",
