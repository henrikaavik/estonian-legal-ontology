      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, kooskõlas käesoleva määrusega sätestatud erisustega: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatiste püstitamine kaitseala tarbeks. Sihtkaitsevööndis on keelatud, kooskõlas käesoleva määrusega sätestatud erisustega: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatiste püstitamine kaitseala tarbeks.",
      "rdfs:label": {
        "@value": "Reg_1024833_Par_11 (redaktsioon 1024833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024833",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024833",
      "estleg:sourceAct": "Siimusti-Kurista maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1024833 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024833_Map_2026"
      }
    },
    {
