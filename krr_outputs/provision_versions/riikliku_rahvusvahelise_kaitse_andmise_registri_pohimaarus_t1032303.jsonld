      "estleg:sourceAct": "Riikliku rahvusvahelise kaitse andmise registri põhimäärus",
      "estleg:provisionRef": "Reg_1032303 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032303_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032303_Par_6_v1032303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
