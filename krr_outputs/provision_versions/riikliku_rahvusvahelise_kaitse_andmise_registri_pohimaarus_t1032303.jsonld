      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja kohta kogutud andmete edastamine välisriigile on lubatud välislepingust või Euroopa Liidu õigusest tuleneva kohustuse täitmiseks, tagades, et teavet ei anta üle nimetatud välismaalase päritoluriigile, kus teda ähvardab välismaalasele rahvusvahelise kaitse andmise seaduse §-s 4 või § 5 lõikes 2 nimetatud tagajärg. Taotleja kohta kogutud andmete edastamine välisriigile on lubatud välislepingust või Euroopa Liidu õigusest tuleneva kohustuse täitmiseks, tagades, et teavet ei anta üle nimetatud välismaalase päritoluriigile, kus teda ähvardab välismaalasele rahvusvahelise kaitse andmise seaduse §-s 4 või § 5 lõikes 2 nimetatud tagajärg.",
      "rdfs:label": {
        "@value": "Reg_1032303_Par_24 (redaktsioon 1032303)",
        "@language": "et"
      },
