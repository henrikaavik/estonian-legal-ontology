  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_investorile_ja_tagatisfondile_esitatavate_andmete_loetelu_ja_t155482_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Investorile ja Tagatisfondile esitatavate andmete loetelu ja esitamise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Investorile ja Tagatisfondile esitatavate andmete loetelu ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_155482_Par_1_v155482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155482_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Investeerimisasutuse juhatuse liige, pankroti- või moratooriumihaldur või likvideerija (edaspidi haldur) esitab igale investorile tema investeeringu kohta järgmised andmed: 1) investori nimi või ärinimi; 2) investori isiku- või registrikood, isikukoodi puudumisel sünniaeg; 3) «Tagatisfondi seaduse» § 55 lõikes 1 nimetatud hüvitamispäev (edaspidi hüvitamispäev); 4) investeeringu väärtus või ühisinvesteeringu korral investorile kuuluva osa suurus ühisinvesteeringus ning selle väärtus hüvitamispäeva seisuga; 5) investeeringu valuuta; 6) hüvitamisele kuuluv investeeringu väärtus; 7) juhul kui investeering ei kuulu Tagatisfondi (edaspidi Fond) poolt tagamisele või hüvitamisele, viide «Tagatisfondi seaduse» sättele, mille alusel investeeringut ei tagata ega hüvitata; 8) investeerimisasutusele teadaolev investori pangakonto number ja selle muutmise või esitamise tähtaeg; 9) «Tagatisfondi seaduse» § 57 lõikes 3 nimetatud investori seisukoha esitamise tähtaeg.",
      "rdfs:label": {
        "@value": "Reg_155482_Par_1 (redaktsioon 155482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155482",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155482",
      "estleg:sourceAct": "Investorile ja Tagatisfondile esitatavate andmete loetelu ja esitamise kord",
      "estleg:provisionRef": "Reg_155482 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155482_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155482_Par_2_v155482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155482_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldur esitab Fondile investeerimisasutuse iga investori ja tema investeeringu kohta järgmised andmed: 1) investori nimi või ärinimi; 2) investori isiku- või registrikood, isikukoodi puudumisel sünniaeg; 3) investeerimisasutusele teadaolev investori kontaktaadress; 4) hüvitamispäev; 5) investeeringu väärtus või ühisinvesteeringu korral investorile kuuluva osa suurus ühisinvesteeringus ning selle väärtus hüvitamispäeva seisuga; 6) investeeringu valuuta; 7) hüvitamisele kuuluv investeeringu väärtus; 8) juhul kui investeering ei kuulu Fondi poolt tagamisele või hüvitamisele, viide «Tagatisfondi seaduse» sättele, mille alusel investeeringut ei tagata ega hüvitata; 9) investeerimisasutusele teadaolev investori pangakonto number ja selle muutmise või esitamise tähtaeg.",
      "rdfs:label": {
        "@value": "Reg_155482_Par_2 (redaktsioon 155482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155482",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155482",
      "estleg:sourceAct": "Investorile ja Tagatisfondile esitatavate andmete loetelu ja esitamise kord",
      "estleg:provisionRef": "Reg_155482 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155482_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155482_Par_3_v155482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155482_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hiljemalt 45 päeva möödumisel hüvitamispäevast saadab haldur §-s 1 nimetatud andmed investorile posti või e-posti teel investeerimisasutusele teadaoleval investori kontaktaadressil. (2) Hiljemalt 45 päeva möödumisel hüvitamispäevast esitab haldur §-s 2 nimetatud andmed Fondile kirjalikult ja kirjalikku taasesitamist võimaldaval viisil. Minister Harri ÕUNAPUU Kantsler Aare JÄRVAN",
      "rdfs:label": {
        "@value": "Reg_155482_Par_3 (redaktsioon 155482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155482",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155482",
      "estleg:sourceAct": "Investorile ja Tagatisfondile esitatavate andmete loetelu ja esitamise kord",
      "estleg:provisionRef": "Reg_155482 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155482_Map_2026"
      }
    },
    {
