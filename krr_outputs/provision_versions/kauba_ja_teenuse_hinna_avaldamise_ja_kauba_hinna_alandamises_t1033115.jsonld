      }
    },
    {
      "@id": "estleg:Reg_1033115_Par_5_5_v1033115",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033115_Par_5_5"
