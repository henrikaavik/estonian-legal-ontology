      "estleg:versionOf": {
        "@id": "estleg:Reg_1055605_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA teeb taotluse osalise või täieliku rahuldamise või rahuldamata jätmise otsuse kohustuseaastale järgneva kalendriaasta 10. veebruariks. PRIA teeb taotluse osalise või täieliku rahuldamise või rahuldamata jätmise otsuse kohustuseaastale järgneva kalendriaasta 10. veebruariks. 2 (2) PRIA teeb taotluse rahuldamata jätmise otsuse Euroopa Liidu õigusaktides ning Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 28 lõikes 3 sätestatud alustel. PRIA teeb taotluse rahuldamata jätmise otsuse Euroopa Liidu õigusaktides ning Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduse § 28 lõikes 3 sätestatud alustel.",
      "rdfs:label": {
        "@value": "Reg_1055605_Par_12 (redaktsioon 1055605)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055605",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055605",
      "estleg:sourceAct": "Perioodi 2023–2027 loomade tervist edendavate kõrgemate majandamisnõuete toetus",
      "estleg:provisionRef": "Reg_1055605 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055605_Map_2026"
      }
    },
    {
