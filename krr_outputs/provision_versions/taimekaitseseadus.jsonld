    {
      "@id": "estleg:TaimKS_Par_87_10_v130062020012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_87_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklik referentlabor käesoleva seaduse tähenduses on Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artiklis 100 sätestatud labor, kes täidab referentlabori ülesandeid taimetervise valdkonnas. (2) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/625 artikli 93 lõikes 1 viidatud iga Euroopa Liidu taimetervisealase referentlabori kohta määratakse riiklik referentlabor valdkonna eest vastutava ministri käskkirjaga, milles kirjeldatakse riikliku referentlaborina tegutsemise õiguse ulatust.",
      "rdfs:label": {
        "@value": "TaimKS_Par_87_10 (redaktsioon 130062020012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020012"
    },
    {
      "@id": "estleg:TaimKS_Par_87_2_v12975238",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_87_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taimekaitseseadme tehnilise kontrolli tegemise õigust taotlev isik või tema töötaja peab: olema põllumajandus- või tehnilise kutseharidusega; olema läbinud käesoleva seaduse § 87 lõikes 3 nimetatud taimekaitseseadme tehnilise kontrolli tegemiseks vajaliku tööalase koolituse; omama taimekaitseseadme tehnilise kontrolli tegemiseks vajalikke seadmeid ja mõõteriistu; olema võimeline tegutsema erapooletult ja andma taimekaitseseadme tegeliku olukorra kohta asjakohase hinnangu.",
      "rdfs:label": {
        "@value": "TaimKS_Par_87_2 (redaktsioon 12975238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12975238",
      "estleg:supersededByVersion": {
        "@id": "estleg:TaimKS_Par_87_2_v123032015271"
      },
      "estleg:versionValidTo": {
        "@value": "2015-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_87_2_v123032015271",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_87_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taimekaitseseadme tehnilise kontrolli tegemise õigust taotlev isik või tema töötaja peab: olema põllumajandus- või tehnilise kutseharidusega; olema läbinud käesoleva seaduse § 87 lõikes 3 nimetatud taimekaitseseadme tehnilise kontrolli tegemiseks vajaliku täienduskoolituse; omama taimekaitseseadme tehnilise kontrolli tegemiseks vajalikke seadmeid ja mõõteriistu; olema võimeline tegutsema erapooletult ja andma taimekaitseseadme tegeliku olukorra kohta asjakohase hinnangu.",
      "rdfs:label": {
        "@value": "TaimKS_Par_87_2 (redaktsioon 123032015271)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015271"
    },
    {
      "@id": "estleg:TaimKS_Par_87_3_v12975238",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_87_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taimekaitseseadme tehnilise kontrolli tegemiseks volituse saamiseks esitab isik Taimetoodangu Inspektsioonile: avalduse; käesoleva seaduse § 87 lõikes 3 nimetatud tööalase koolituse läbinud töötajate nimekirja ja koolituse läbimist tõendava dokumendi või selle koopia; taimekaitseseadme tehnilise kontrolli tegemiseks vajalike seadmete ja mõõteriistade loetelu; taimekaitseseadme tehnilise kontrolli tegemiseks volitust taotleva isiku või tema töötaja kutseharidust tõendava dokumendi koopia.",
      "rdfs:label": {
        "@value": "TaimKS_Par_87_3 (redaktsioon 12975238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12975238",
      "estleg:supersededByVersion": {
        "@id": "estleg:TaimKS_Par_87_3_v13225437"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_87_3_v13225437",
      "@type": [
        "owl:NamedIndividual",
