        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taimetoodangu Inspektsioon või kohus võib kohaldada käesoleva seaduse §-s 99 sätestatud väärteo toimepanemise vahetuks objektiks olnud taimekaitsevahendi konfiskeerimist vastavalt karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40) §-le 83.",
      "rdfs:label": {
        "@value": "TaimKS_Par_101 (redaktsioon 745187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745187",
      "estleg:supersededByVersion": {
