    {
      "@id": "estleg:TaimKS_Par_103_v26295",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse jõustumisel kasutusel olevate taimekaitseseadmete puhul arvutatakse § 68 kohast ülevaatuse aega viimasest testimisest arvates, mis viidi läbi kehtetuks tunnistatava taimekaitseseaduse (RT I 1994, 28, 427; 1996, 49, 953; 1998, 13, 163; 97, 1519; 1999, 95, 843) alusel.",
      "rdfs:label": {
        "@value": "TaimKS_Par_103 (redaktsioon 26295)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26295",
      "estleg:supersededByVersion": {
        "@id": "estleg:TaimKS_Par_103_v745187"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_103_v745187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 30 lõikes 1 nimetatud taimetervise registrina käsitatakse enne käesoleva seaduse jõustumist kehtinud taimekaitseseaduse (RT I 2000, 29, 169; 2001, 88, 531; 2002, 53, 336; 61, 375; 63, 387; 2003, 88, 591; 2004, 12, 81) § 46 lõike 2 alusel asutatud taimetervise registrit.",
      "rdfs:label": {
        "@value": "TaimKS_Par_103 (redaktsioon 745187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745187",
      "estleg:supersededByVersion": {
        "@id": "estleg:TaimKS_Par_103_v12975238"
      },
      "estleg:versionValidTo": {
        "@value": "2007-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_103_v12975238",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 30 lõikes 1 nimetatud taimetervise registrina käsitatakse enne käesoleva seaduse jõustumist kehtinud taimekaitseseaduse § 46 lõike 2 alusel asutatud taimetervise registrit.",
      "rdfs:label": {
        "@value": "TaimKS_Par_103 (redaktsioon 12975238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12975238",
      "estleg:supersededByVersion": {
        "@id": "estleg:TaimKS_Par_103_v130062020012"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_103_v130062020012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_103"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Taimetervise registrit käsitatakse ettevõtjate ametliku registrina ja tema andmeid ettevõtjate ametliku registri andmetena Euroopa Parlamendi ja nõukogu määruse (EL) 2016/2031 artikli 65 tähenduses. (2) Enne 2020. aasta 1. juulit kehtinud käesoleva seaduse § 31 lõigete 1 ja 2 alusel esitatud majandustegevusteate menetlemist jätkatakse käesoleva seaduse 2020. aasta 1. juulil jõustunud redaktsiooni kohaselt.",
      "rdfs:label": {
        "@value": "TaimKS_Par_103 (redaktsioon 130062020012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020012"
    },
    {
      "@id": "estleg:TaimKS_Par_104_v26295",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetuks tunnistatava taimekaitseseaduse alusel taimekaitsevahendite registrisse kantud taimekaitsevahend viiakse järelejäänud registreerimistähtajaks ilma täiendava taotluseta üle käesoleva seaduse alusel asutatavasse taimekaitsevahendite registrisse.",
      "rdfs:label": {
        "@value": "TaimKS_Par_104 (redaktsioon 26295)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26295",
      "estleg:supersededByVersion": {
        "@id": "estleg:TaimKS_Par_104_v745187"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_104_v745187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
