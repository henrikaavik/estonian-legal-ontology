      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 80 lõikes 2 nimetatud taimekaitsevahendite registrina käsitatakse enne käesoleva seaduse jõustumist kehtinud taimekaitseseaduse § 69 lõike 2 alusel asutatud taimekaitsevahendite registrit.",
      "rdfs:label": {
        "@value": "TaimKS_Par_104 (redaktsioon 745187)",
        "@language": "et"
