      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist kehtinud taimekaitseseaduse § 70 lõike 1 alusel esitatud taimekaitsevahendi registreerimise taotluste menetlemist ja taimekaitsevahendi katsete korraldamist jätkatakse käesolevas seaduses kehtestatud korras.",
      "rdfs:label": {
        "@value": "TaimKS_Par_105 (redaktsioon 745187)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745187"
    },
    {
      "@id": "estleg:TaimKS_Par_106_v745187",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_106"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist kehtinud taimekaitseseaduse § 68 alusel taimekaitseseadme ülevaatust korraldanud asutused võivad käesoleva seaduse alusel läbi viia taimekaitseseadme tehnilise kontrolli kuni 2005. aasta 1. jaanuarini.",
      "rdfs:label": {
