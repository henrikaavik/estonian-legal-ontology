        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_27_v130062020012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
