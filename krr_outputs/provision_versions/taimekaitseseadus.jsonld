      }
    },
    {
      "@id": "estleg:TaimKS_Par_84_v1040631",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Taimekaitseseade ei tohi nõuetekohasel kasutamisel, puhastamisel, hooldamisel ja hoidmisel ohustada inimese tervist ega keskkonda.",
      "rdfs:label": {
        "@value": "TaimKS_Par_84 (redaktsioon 1040631)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040631",
