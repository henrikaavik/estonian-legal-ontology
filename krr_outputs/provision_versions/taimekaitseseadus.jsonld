    {
      "@id": "estleg:TaimKS_Par_12_v128122017028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TaimKS_Par_12"
      },
      "estleg:versionValidFrom": {
