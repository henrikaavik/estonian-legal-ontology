      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TaimKS_Par_30_v13225437",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
