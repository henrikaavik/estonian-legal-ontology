      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Hoone ruumiõhu radoonisisalduse ja hoone tarindi ehitusmaterjalidest siseruumidesse emiteeritavast gammakiirgusest saadava efektiivdoosi viitetase (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Hoone ruumiõhu radoonisisalduse ja hoone tarindi ehitusmaterjalidest siseruumidesse emiteeritavast gammakiirgusest saadava efektiivdoosi viitetase"
    },
    {
      "@id": "estleg:Reg_1046377_Par_1_v1046377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
