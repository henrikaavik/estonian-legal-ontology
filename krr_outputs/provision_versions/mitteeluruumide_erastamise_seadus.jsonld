    {
      "@id": "estleg:MEES_Par_3_v22334",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MEES_Par_3"
      },
