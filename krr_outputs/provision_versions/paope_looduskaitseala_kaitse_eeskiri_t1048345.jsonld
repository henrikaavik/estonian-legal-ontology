      "estleg:sourceAct": "Paope looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048345 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048345_Map_2026"
      }
    },
