      }
    },
    {
      "@id": "estleg:MPK_Par_44_v102062021020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduslik riigiabi ning käesoleva seaduse alusel ja korras antud muu riigiabi, mille on riigiabi andja, Euroopa Komisjon või Euroopa Liidu Kohus tunnistanud ebaseaduslikuks või väärkasutatud riigiabiks nõukogu määruse (EL) 2015/1589 tähenduses, nõutakse tagasi konkurentsiseaduse §-s 42 sätestatud alusel ja korras ning sellisel juhul tagasinõudmise suhtes käesoleva seaduse §-e 42 ja 43 ei kohaldata.",
      "rdfs:label": {
        "@value": "MPK_Par_44 (redaktsioon 102062021020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102062021020"
    },
    {
      "@id": "estleg:MPK_Par_45_v22468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Intressitoetus on rahaline abi, millega osaliselt hüvitatakse põllumajandustootja põllumajandussaaduste tootmise või kalakasvataja kalakasvatuse arendamise investeeringuks krediidi- või finantseerimisasutuselt võetud pikaajalise (tagastamise tähtajaga üle ühe aasta) laenu intressid või kapitalirendi tasu (edaspidi intress), mis põllumajandustootja või kalakasvataja on tasunud intressitoetuse taotlemisele eelnenud kalendriaastal.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 22468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22468",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_v696436"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_v696436",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Intressitoetus on rahaline abi, millega osaliselt hüvitatakse põllumajandustootja põllumajandussaaduste tootmise, kalakasvataja kalakasvatuse või kutselise kaluri kalapüügi arendamise investeeringuks krediidi- või finantseerimisasutuselt võetud pikaajalise (tagastamise tähtajaga üle ühe aasta) laenu intressid või kapitalirendi makse osana tasutavad intressid (edaspidi intress), mis põllumajandustootja, kalakasvataja või kutseline kalur on tasunud intressitoetuse taotlemisele eelnenud kalendriaastal.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 696436)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696436",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_v696901"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_v696901",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Intressitoetus on rahaline abi, millega osaliselt hüvitatakse põllumajandustootja põllumajandussaaduste tootmise arendamise investeeringuks krediidi- või finantseerimisasutuselt võetud pikaajalise (tagastamise tähtajaga üle ühe aasta) laenu intressid või kapitalirendi makse osana tasutavad intressid (edaspidi intress), mis põllumajandustootja on tasunud intressitoetuse taotlemisele eelnenud kalendriaastal.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 696901)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696901",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_v745253"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_v745253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusloomade aretustoetust võib anda taotlejale, kes tegutseb järgmistes põllumajandusloomade aretusvaldkondades: tõuraamatu või aretusregistri pidamine; jõudluskontrolli läbiviimine või geneetilise väärtuse hindamine; ohustatud tõu säilitamine. (2) Põllumajandusminister võib määrata, millise loomaliigi puhul käesoleva paragrahvi lõikes 1 nimetatud aretusvaldkondades aretustoetust ei anta. (3) Nõuded põllumajandusloomade aretustoetuse saamiseks kehtestab põllumajandusminister. Nimetatud nõuetes nähakse ette taotleja poolt põllumajandusloomade arvu kohta esitatud andmete ja tegelike andmete erinevuse suurus, mille puhul põllumajandusloomade aretustoetust vähendatakse, ja toetuse vähendamise määr. Nõuetes sätestatakse ka toetuse suuruse arvutamisel aluseks võetavate põllumajandusloomade arvestamise alused ja kord. Nõuded võib kehtestada käesoleva paragrahvi lõikes 1 nimetatud aretusvaldkondade ja loomaliikide kaupa.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 745253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745253",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_v952865"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_v952865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
