        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_29_v114032017003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
