      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_46_v13332775",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) PRIA esitab andmed eelmisel kalendriaastal makstud põllumajandusliku vähese tähtsusega abi saajate ja neile antud abi suuruse kohta abiliikide kaupa Põllumajandusministeeriumile 1. aprilliks.",
      "rdfs:label": {
        "@value": "MPK_Par_46 (redaktsioon 13332775)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13332775",
