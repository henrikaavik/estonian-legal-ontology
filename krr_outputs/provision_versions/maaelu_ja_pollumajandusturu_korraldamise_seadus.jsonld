    },
    {
      "@id": "estleg:MPK_Par_50_v12997647",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 48 ja 49 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesoleva seaduse §-s 48 sätestatud väärtegude kohtuväline menetleja on Taimetoodangu Inspektsioon. (3) Käesoleva seaduse §-s 49 sätestatud väärtegude kohtuväline menetleja on Veterinaar- ja Toiduamet.",
      "rdfs:label": {
        "@value": "MPK_Par_50 (redaktsioon 12997647)",
        "@language": "et"
