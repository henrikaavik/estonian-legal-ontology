      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Käesoleva seaduse §-s 49 sätestatud väärtegude kohtuväline menetleja on Põllumajandus- ja Toiduamet.",
      "rdfs:label": {
        "@value": "MPK_Par_50 (redaktsioon 101072020007)",
        "@language": "et"
