      }
    },
    {
      "@id": "estleg:MPK_Par_30_v745253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turuarendustoetus on rahaline abi, millega osaliselt või täielikult hüvitatakse mittetulundusühingu sellise tegevuse kulud: mille eesmärk on suurendada põllumajandussaaduste või -toodete turustamisvõimalusi või juurutada teadus- ja arendussaavutusi põllumajandustootmisse või põllumajandussaaduste töötlemisse või mille tulemusel paraneb põllumajandussaaduste tootmine või töötlemine. (2) Turuarendustoetust antakse: turu-uuringuteks; turuinformatsiooni kogumiseks, analüüsimiseks ja levitamiseks; tootearenduseks; põllumajandussaaduste, -toodete ja töödeldud toodete tutvustamiseks; võistlustel, messidel ja näitustel osalemiseks ning nende korraldamisteks; liikmete koolituseks; kvaliteedimärkide väljaandmiseks ja tutvustamiseks; kvaliteedijuhtimissüsteemide ja kvaliteedimärkide süsteemide rakendamiseks ja kontrolliks. (3) Nende kulude loetelu, mille hüvitamiseks toetust antakse, kehtestab põllumajandusminister.",
      "rdfs:label": {
        "@value": "MPK_Par_30 (redaktsioon 745253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745253",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_30_v952889"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_30_v952889",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Turuarendustoetus on rahaline abi, millega osaliselt või täielikult hüvitatakse mittetulundusühingu sellise tegevuse kulud: mille eesmärk on suurendada põllumajandussaaduste või -toodete turustamisvõimalusi või juurutada teadus- ja arendussaavutusi põllumajandustootmisse või põllumajandussaaduste töötlemisse või mille tulemusel paraneb põllumajandussaaduste tootmine või töötlemine. (2) Turuarendustoetust antakse: turu-uuringuteks; turuinformatsiooni kogumiseks, analüüsimiseks ja levitamiseks; tootearenduseks; põllumajandussaaduste, -toodete ja töödeldud toodete tutvustamiseks; võistlustel, messidel ja näitustel osalemiseks ning nende korraldamisteks; liikmete koolituseks; kvaliteedimärkide väljaandmiseks ja tutvustamiseks; kvaliteedijuhtimissüsteemide ja kvaliteedimärkide süsteemide rakendamiseks ja kontrolliks.",
      "rdfs:label": {
        "@value": "MPK_Par_30 (redaktsioon 952889)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "952889",
      "estleg:supersededByVersion": {
