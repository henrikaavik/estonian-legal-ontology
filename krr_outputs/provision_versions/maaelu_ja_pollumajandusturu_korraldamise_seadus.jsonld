    {
      "@id": "estleg:MPK_Par_5_v22468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_5"
      },
      "estleg:versionValidFrom": {
