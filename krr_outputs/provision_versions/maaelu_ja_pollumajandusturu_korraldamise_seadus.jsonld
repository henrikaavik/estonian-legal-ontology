        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduskindlustustoetust antakse kuni 40 protsenti kindlustustoetuse perioodil tasutud kindlustusmaksetest.",
      "rdfs:label": {
        "@value": "MPK_Par_50 (redaktsioon 22468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22468",
