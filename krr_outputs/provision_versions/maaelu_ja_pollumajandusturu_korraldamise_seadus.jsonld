      }
    },
    {
      "@id": "estleg:MPK_Par_45_v12997647",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusministeerium koostab Euroopa Komisjoni saadetud eeltäidetud põllumajandusliku riigiabi aruandetabeli alusel eelmisel kalendriaastal antud riigiabi aastaaruande ning edastab selle elektrooniliselt Eesti Vabariigi Alalisele Esindusele Euroopa Liidu juures, kes edastab aruande Euroopa Komisjonile hiljemalt 30. juuniks või Euroopa Komisjoni poolt kehtestatud tähtpäevaks. (2) Põllumajandusministeeriumil on õigus käesoleva paragrahvi lõikes 1 sätestatud aruande koostamiseks küsida andmeid riigiabi andjalt.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 12997647)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12997647",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_v101092015021"
      },
      "estleg:versionValidTo": {
        "@value": "2015-09-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_v101092015021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maaeluministeerium koostab Euroopa Komisjoni saadetud eeltäidetud põllumajandusliku riigiabi aruandetabeli alusel eelmisel kalendriaastal antud riigiabi aastaaruande ning edastab selle elektrooniliselt Eesti Vabariigi Alalisele Esindusele Euroopa Liidu juures, kes edastab aruande Euroopa Komisjonile hiljemalt 30. juuniks või Euroopa Komisjoni poolt kehtestatud tähtpäevaks. (2) Maaeluministeeriumil on õigus käesoleva paragrahvi lõikes 1 sätestatud aruande koostamiseks küsida andmeid riigiabi andjalt.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 101092015021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101092015021",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_v126092023001"
      },
      "estleg:versionValidTo": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_v126092023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Regionaal- ja Põllumajandusministeerium koostab Euroopa Komisjoni saadetud eeltäidetud põllumajandusliku riigiabi aruandetabeli alusel eelmisel kalendriaastal antud riigiabi aastaaruande ning edastab selle elektrooniliselt Eesti Vabariigi Alalisele Esindusele Euroopa Liidu juures, kes edastab aruande Euroopa Komisjonile hiljemalt 30. juuniks või Euroopa Komisjoni poolt kehtestatud tähtpäevaks. (2) Regionaal- ja Põllumajandusministeeriumil on õigus käesoleva paragrahvi lõikes 1 sätestatud aruande koostamiseks küsida andmeid riigiabi andjalt.",
      "rdfs:label": {
        "@value": "MPK_Par_45 (redaktsioon 126092023001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126092023001"
    },
    {
      "@id": "estleg:MPK_Par_45_1_v114032017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Komisjoni määruse (EL) nr 702/2014 artikli 9 lõike 2 punktis c ja lõikes 3 ning riigiabi suuniste punkti 128 alapunktis c ja punktis 129 nimetatud summat ületava üksikabi andmise korral sisestab riigiabi andja komisjoni määruse (EL) nr 702/2014 III lisas ning riigiabi suuniste punkti 128 alapunktides b ja c nimetatud andmed Euroopa Komisjoni asjaomasele veebilehele nelja kalendrikuu jooksul abi andmisest arvates ning maksusoodustuse vormis abi andmise korral kümne kalendrikuu jooksul maksudeklaratsiooni esitamise tähtpäevast arvates. Riigiabi andja teavitab sellest viivitamata kirjalikult Maaeluministeeriumi. (2) Maaeluministeerium kontrollib riigiabi andja sisestatud andmeid ning teeb need Euroopa Komisjoni asjaomasel veebilehel avalikkusele kättesaadavaks komisjoni määruses (EL) nr 702/2014 või riigiabi suunistes sätestatud tähtpäevaks. (3) Maaeluministeeriumil on õigus nõuda riigiabi andjalt lisaandmete esitamist.",
      "rdfs:label": {
        "@value": "MPK_Par_45_1 (redaktsioon 114032017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032017002",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_45_1_v111032023048"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_45_1_v111032023048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_45_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Komisjoni määruse (EL) 2022/2472 artikli 9 lõike 1 punktis c ja lõikes 2 ning riigiabi suuniste punkti 112 alapunktis c ja punktis 113 nimetatud summat ületava üksikabi andmise korral sisestab riigiabi andja komisjoni määruse (EL) 2022/2472 III lisas ning riigiabi suuniste punkti 112 alapunktides b ja c nimetatud andmed Euroopa Komisjoni asjaomasele veebilehele nelja kalendrikuu jooksul abi andmisest arvates ning maksusoodustuse vormis abi andmise korral kümne kalendrikuu jooksul maksudeklaratsiooni esitamise tähtpäevast arvates. Riigiabi andja teavitab sellest viivitamata kirjalikult Maaeluministeeriumi. , rakendatakse tagasiulatuvalt alates 2023. aasta 1. jaanuarist (2) Maaeluministeerium kontrollib riigiabi andja sisestatud andmeid ning teeb need Euroopa Komisjoni asjaomasel veebilehel avalikkusele kättesaadavaks komisjoni määruses (EL) 2022/2472 või riigiabi suunistes sätestatud tähtpäevaks. , rakendatakse tagasiulatuvalt alates 2023. aasta 1. jaanuarist (3) Maaeluministeeriumil on õigus nõuda riigiabi andjalt lisaandmete esitamist.",
      "rdfs:label": {
        "@value": "MPK_Par_45_1 (redaktsioon 111032023048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023048",
