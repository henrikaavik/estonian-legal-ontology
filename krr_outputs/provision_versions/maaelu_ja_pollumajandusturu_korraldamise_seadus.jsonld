      }
    },
    {
      "@id": "estleg:MPK_Par_8_v114032017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtasutus võib anda põllumajandustootjale, põllumajandus- ja mittepõllumajandustoodete töötlemise ja turustamisega ning maamajandustegevusega tegelevale ettevõtjale, metsandussektoris tegutsevale isikule ning neid esindavale mittetulundusühingule riigiabi toetuse, laenu või tagatisena või muus vormis Maaeluministeeriumi ja sihtasutuse vahel sõlmitud halduslepingus toodud alusel ja korras. Sihtasutus ei või anda riigiabina toetust, mida annab riik Maaeluministeeriumi või PRIA kaudu.",
      "rdfs:label": {
        "@value": "MPK_Par_8 (redaktsioon 114032017002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032017002",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_8_v126092023001"
      },
      "estleg:versionValidTo": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_8_v126092023001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtasutus võib anda põllumajandustootjale, põllumajandus- ja mittepõllumajandustoodete töötlemise ja turustamisega ning maamajandustegevusega tegelevale ettevõtjale, metsandussektoris tegutsevale isikule ning neid esindavale mittetulundusühingule riigiabi toetuse, laenu või tagatisena või muus vormis Regionaal- ja Põllumajandusministeeriumi ja sihtasutuse vahel sõlmitud halduslepingus toodud alusel ja korras. Sihtasutus ei või anda riigiabina toetust, mida annab riik Regionaal- ja Põllumajandusministeeriumi või PRIA kaudu.",
      "rdfs:label": {
        "@value": "MPK_Par_8 (redaktsioon 126092023001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126092023001"
    },
    {
      "@id": "estleg:MPK_Par_9_v22468",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arengutoetus on sihipäraseks kasutamiseks ettenähtud rahaline abi, mida antakse põllumajandussaaduste tootmise ja muu maamajandustegevuse, põllumajandussaaduste töötlemise ja põllumajandustoodete turustamise ning maapiirkonna infrastruktuuri ja elukeskkonna arendamiseks ning käesolevas seaduses ettenähtud juhtudel maamajandustegevuse alustamiseks või enne toetuse maksmist maamajandustegevuse arendamiseks tehtud kulutuste hüvitamiseks.",
      "rdfs:label": {
        "@value": "MPK_Par_9 (redaktsioon 22468)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22468",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_9_v745253"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_9_v745253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Intressitoetus on rahaline abi, millega osaliselt hüvitatakse põllumajandustootja põllumajandussaaduste tootmise arendamise investeeringuks krediidi- või finantseerimisasutuselt võetud pikaajalise (üle üheaastase tagastamistähtajaga) laenu intressid või kapitalirendi makse osana tasutavad intressid (edaspidi intress), mis põllumajandustootja on tasunud intressitoetuse taotlemisele eelnenud kalendriaastal.",
      "rdfs:label": {
        "@value": "MPK_Par_9 (redaktsioon 745253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745253",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_9_v952865"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_9_v952865",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Intressitoetus on rahaline abi, millega osaliselt hüvitatakse põllumajandustootja põllumajandussaaduste tootmise arendamise investeeringuks krediidi- või finantseerimisasutuselt võetud pikaajalise (üle üheaastase tagastamistähtajaga) laenu intressid või kapitalirendi makse osana tasutavad intressid (edaspidi intress ), mis põllumajandustootja on tasunud intressitoetuse taotlemisele eelnenud kalendriaastal.",
      "rdfs:label": {
        "@value": "MPK_Par_9 (redaktsioon 952865)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "952865",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_9_v12760424"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_9_v12760424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Intressitoetus on rahaline abi, millega osaliselt hüvitatakse põllumajandustootja põllumajandussaaduste tootmise arendamise investeeringuks krediidi- või finantseerimisasutuselt võetud pikaajalise (üle üheaastase tagastamistähtajaga) laenu intressid või kapitalirendi makse osana tasutavad intressid (edaspidi intress), mis põllumajandustootja on tasunud intressitoetuse taotlemisele eelnenud kalendriaastal.",
      "rdfs:label": {
        "@value": "MPK_Par_9 (redaktsioon 12760424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12760424",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_9_v12997647"
      },
      "estleg:versionValidTo": {
        "@value": "2008-08-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_9_v12997647",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui riigiabi annab riik Põllumajandusministeeriumi või PRIA kaudu, koostab põllumajandusliku riigiabi teatise Põllumajandusministeerium komisjoni määruse (EÜ) nr 794/2004, millega rakendatakse nõukogu määrust (EÜ) nr 659/1999, millega kehtestatakse üksikasjalikud eeskirjad EÜ asutamislepingu artikli 93 kohaldamiseks (ELT L 140, 30.04.2004, lk 1–134), kohaselt ja kooskõlas ühenduse suunistega. (2) Põllumajandusministeerium esitab põllumajandusliku riigiabi teatise koos vajaliku teabega Euroopa Komisjoni poolt ettenähtud veebirakenduse kaudu elektrooniliselt Eesti Vabariigi Alalisele Esindusele Euroopa Liidu juures, kes edastab selle Euroopa Komisjonile. (3) Kui põllumajanduslikku riigiabi annab sihtasutus või seda antakse muu seaduse alusel ja korras, esitab riigiabi andja komisjoni määruse (EÜ) nr 794/2004 kohaselt ja kooskõlas ühenduse suunistega põllumajandusliku riigiabi teatise koos vajaliku teabega kirjalikult ja Euroopa Komisjoni poolt ettenähtud veebirakenduse kaudu Põllumajandusministeeriumile läbivaatamiseks. (4) Kui põllumajandusliku riigiabi teatis vastab nõuetele, edastab Põllumajandusministeerium selle koos vajaliku teabega Euroopa Komisjoni poolt ettenähtud veebirakenduse kaudu elektrooniliselt Eesti Vabariigi Alalisele Esindusele Euroopa Liidu juures, kes edastab selle Euroopa Komisjonile. (5) Kui käesoleva paragrahvi lõikes 3 nimetatud riigiabi andja jätab riigiabi teatises nõutud andmed esitamata, teatis ei vasta nõuetele või teatises või koos sellega esitatud teabes esineb puudusi, on Põllumajandusministeeriumil 20 tööpäeva jooksul teatise kättesaamisest arvates õigus küsida riigiabi andjalt lisateavet või teha talle ettepanek teatist täiendada. (6) Põllumajandusliku riigiabi teatise menetlemise käigus Euroopa Komisjoni nõutud lisateabe esitab riigiabi andja Põllumajandusministeeriumi kaudu elektrooniliselt Eesti Vabariigi Alalisele Esindusele Euroopa Liidu juures, kes edastab selle Euroopa Komisjonile.",
      "rdfs:label": {
        "@value": "MPK_Par_9 (redaktsioon 12997647)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12997647",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_9_v130122014016"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MPK_Par_9_v130122014016",
