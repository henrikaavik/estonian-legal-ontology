      }
    },
    {
      "@id": "estleg:MPK_Par_50_v745253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MPK_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Looduskahjutoetus on rahaline abi, millega osaliselt või täielikult hüvitatakse põllumajandustootjale loodusõnnetuse või ebasoodsate ilmastikutingimuste tagajärjel tekkinud kahju. (2) Looduskahjutoetust võib anda kahju tekkimisest arvates kolme aasta jooksul. Looduskahjutoetust võib anda üksnes Euroopa Ühenduse põllumajandusliku riigiabi suunistes (EÜT C 028, 01.02.2000, lk 2–22) sätestatud alustel ja tingimustel. (3) Looduskahjutoetuse määra ning toetuse andmise tingimused ja korra kehtestab põllumajandusminister.",
      "rdfs:label": {
        "@value": "MPK_Par_50 (redaktsioon 745253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "745253",
      "estleg:supersededByVersion": {
        "@id": "estleg:MPK_Par_50_v952889"
      },
      "estleg:versionValidTo": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      }
    },
    {
