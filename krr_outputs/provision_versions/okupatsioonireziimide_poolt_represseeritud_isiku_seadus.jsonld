    {
      "@id": "estleg:ReprS_Par_11_v690831",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud pensioniõigused ei laiene represseerituga võrdsustatud isikule, välja arvatud juhul, kui isik vastab käesolevas peatükis sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "ReprS_Par_11 (redaktsioon 690831)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690831",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/690831",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
    {
      "@id": "estleg:ReprS_Par_11_1_v128122017061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatud pensionile kohaldatakse riikliku pensionikindlustuse seaduse sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "ReprS_Par_11_1 (redaktsioon 128122017061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017061",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122017061",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 11_1",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
    {
      "@id": "estleg:ReprS_Par_12_v690831",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus soodustingimustel vanaduspensionile riikliku pensionikindlustuse seaduse mõistes on: represseeritul, kellel on olemas vanaduspensioni määramiseks nõutav pensionistaaž ning kes õigusvastaselt represseerituna on viibinud kinnipidamiskohas või asumisel, samuti käesoleva seaduse § 2 lõikes 2 nimetatud isikul – üks aasta enne vanaduspensioniikka jõudmist iga kinnipidamiskohas või asumisel viibitud täisaasta kohta, ent mitte varem kui viis aastat enne vanaduspensioniikka jõudmist; isikul, kes võttis osa Tšernobõli aatomielektrijaama avarii tagajärgede likvideerimisest, – viis aastat enne vanaduspensioniikka jõudmist.",
      "rdfs:label": {
        "@value": "ReprS_Par_12 (redaktsioon 690831)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690831",
      "estleg:supersededByVersion": {
        "@id": "estleg:ReprS_Par_12_v111032023056"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/690831",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
    {
      "@id": "estleg:ReprS_Par_12_v111032023056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigus soodustingimustel vanaduspensionile riikliku pensionikindlustuse seaduse mõistes on: represseeritul, kellel on olemas vanaduspensioni määramiseks nõutav pensionistaaž ning kes õigusvastaselt represseerituna on viibinud kinnipidamiskohas või asumisel, samuti käesoleva seaduse § 2 lõike 2 punktides 1 ja 2 nimetatud isikul – üks aasta enne vanaduspensioniikka jõudmist iga kinnipidamiskohas või asumisel viibitud täisaasta kohta, ent mitte varem kui viis aastat enne vanaduspensioniikka jõudmist; isikul, kes võttis osa Tšernobõli aatomielektrijaama avarii tagajärgede likvideerimisest, – viis aastat enne vanaduspensioniikka jõudmist.",
      "rdfs:label": {
        "@value": "ReprS_Par_12 (redaktsioon 111032023056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023056",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023056",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
    {
      "@id": "estleg:ReprS_Par_13_v690831",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pensioniõigusliku staaži hulka arvatakse: Eesti Vabariigi territooriumil võõrriikide okupatsiooni vastases relvastatud vabadusvõitluses osalenud või ennast õigusvastaste repressioonide eest varjanud isiku vabadusvõitluses osalemise või enese varjamise aeg ühekordselt; represseeritu õigusvastaselt vahi all, kinnipidamiskohas või asumisel oleku, sealhulgas põgenemise ja hilisema vahistamise vaheline aeg kolmekordselt; sõjavangis, II maailmasõja ajal koonduslaagris, getos, samuti aastatel 1941–1942 töö- ja ehituspataljonis või töö- ja ehituskolonnis viibimise aeg kolmekordselt; represseeritud isiku puhul vahi alt, kinnipidamiskohast või asumiselt vabanemisele järgnenud aeg kuni Eestisse elama asumise õiguse andmiseni, kui isikult oli õigusvastaselt võetud õigus asuda elama Eestisse, poolteisekordselt; paragrahvi 2 lõikes 2 nimetatud isiku vanema asumisel või kinnipidamiskohas oleku aeg kuni ajani, mil § 2 lõikes 2 nimetatud isikule anti luba ja reaalne võimalus Eestisse naasmiseks, kolmekordselt. (2) Pensioniõiguslikku staaži arvestatakse ja tõendatakse riikliku pensionikindlustuse seaduses ja selle alusel antud õigusaktides kehtestatud korras.",
      "rdfs:label": {
        "@value": "ReprS_Par_13 (redaktsioon 690831)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690831",
      "estleg:supersededByVersion": {
        "@id": "estleg:ReprS_Par_13_v898499"
      },
      "estleg:versionValidTo": {
        "@value": "2005-05-19",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/690831",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
