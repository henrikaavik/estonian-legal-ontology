      }
    },
    {
      "@id": "estleg:ReprS_Par_10_v690831",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_10"
      },
