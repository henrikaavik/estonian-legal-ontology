  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_okupatsioonireziimide_poolt_represseeritud_isiku_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Okupatsioonirežiimide poolt represseeritud isiku seadus (75 versiooni)",
        "@language": "et"
      },
      "dc:source": "Okupatsioonirežiimide poolt represseeritud isiku seadus"
    },
    {
      "@id": "estleg:ReprS_Par_1_v690831",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse eesmärk on leevendada Eestit okupeerinud riikide poolt 1940. aasta 16. juunist kuni 1991. aasta 20. augustini õigusvastastelt represseeritud isikutele tekitatud ülekohut. (2) Käesoleva seadusega sätestatakse õigusvastaselt represseeritud isiku mõiste, õigusvastaselt represseeritud isikutele laienevad soodustused ja toetused ning pensioniõigused. Käesoleva seaduse reguleerimisalasse ei kuulu vara õigusvastane võõrandamine ega sellega kaasnenud tagajärgede leevendamine. Õigusvastaselt represseeritud isiku mõiste käesolevas seaduses on määratletud rahvusvahelise õiguse alusel koos kõigi sellest tulenevate järeldustega. (3) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354; 53, 336; 2002, 61, 375; 2003, 20, 117) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "ReprS_Par_1 (redaktsioon 690831)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690831",
      "estleg:supersededByVersion": {
        "@id": "estleg:ReprS_Par_1_v12907100"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/690831",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
    {
      "@id": "estleg:ReprS_Par_1_v12907100",
