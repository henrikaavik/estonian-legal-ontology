    {
      "@id": "estleg:ReprS_Par_5_v690831",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus: asutab represseerituid ja represseeritutega võrdsustatud isikuid kaasates koostööfoorumina justiitsministri juhitava valitsuskomisjoni, mille ülesanne on teha vajalike õigusaktide ettevalmistamiseks ettepanekuid ning korraldada koostööd valitsus- ja omavalitsusstruktuuridega, ühiskondlike organisatsioonidega ja mittetulundusühingutega; korraldab represseeritute ja represseeritutega võrdsustatud isikute mälestuse jäädvustamist ning okupantriikide repressiivpoliitika uurimist; korraldab represseerituid abistava sihtasutuse asutamist.",
      "rdfs:label": {
        "@value": "ReprS_Par_5 (redaktsioon 690831)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "690831",
      "estleg:supersededByVersion": {
        "@id": "estleg:ReprS_Par_5_v1010997"
      },
      "estleg:versionValidTo": {
        "@value": "2006-04-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/690831",
      "estleg:sourceAct": "Okupatsioonirežiimide poolt represseeritud isiku seadus",
      "estleg:provisionRef": "ReprS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:ReprS_Map_2026"
      }
    },
    {
      "@id": "estleg:ReprS_Par_5_v1010997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ReprS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsus: asutab represseerituid ja represseeritutega võrdsustatud isikuid kaasates koostööfoorumina valitsuskomisjoni, mille ülesanne on teha vajalike õigusaktide ettevalmistamiseks ettepanekuid ning korraldada koostööd valitsus- ja omavalitsusstruktuuridega, ühiskondlike organisatsioonidega ja mittetulundusühingutega; korraldab represseeritute ja represseeritutega võrdsustatud isikute mälestuse jäädvustamist ning okupantriikide repressiivpoliitika uurimist; korraldab represseerituid abistava sihtasutuse asutamist.",
