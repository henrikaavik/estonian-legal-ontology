      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse vastavalt toetuse saaja soovile tema arvelduskontole või tema Sotsiaalkindlustusametis vormistatud kirjaliku taotluse, digitaalselt allkirjastatud elektroonilise või notariaalselt tõestatud taotluse alusel teise isiku arvelduskontole Eestis või toetuse saaja arvelduskontole välisriigis, kusjuures viimasel juhul toimub see toetuse saaja kulul.",
      "rdfs:label": {
        "@value": "ReprS_Par_7_1 (redaktsioon 117122015058)",
        "@language": "et"
      },
