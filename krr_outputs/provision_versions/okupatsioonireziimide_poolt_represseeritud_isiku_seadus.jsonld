      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 12 punktis 1, § 13 lõike 1 punktis 2, § 13 lõike 1 punktis 4, § 13 lõikes 2 ja § 14 lõigetes 1 ja 3 sätestatu laieneb ka rehabiliteeritud isikule. (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
