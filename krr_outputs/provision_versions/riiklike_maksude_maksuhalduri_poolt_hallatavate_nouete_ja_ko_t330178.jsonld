  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_riiklike_maksude_maksuhalduri_poolt_hallatavate_nouete_ja_ko_t330178_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord (20 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord"
    },
    {
      "@id": "estleg:Reg_330178_Par_1_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevat korda rakendatakse Maksu- ja Tolliametile maksukohustuslase poolt deklareerimisel või muudel alustel tekkiva maksukohustuse või muude kohustuste (trahvid jms) ning tagastusnõuete arvestusse kandmisel, võlgnikule kohustuste summast teatamisel, kohustuse summa tasumisel ja arvestusse kantud kohustuse summa tasutuks märkimisel ning tagastusnõude täitmisel. RT I 2014-03-20 1 120032014001 2014-04-01 Käesolevat korda rakendatakse Maksu- ja Tolliametile maksukohustuslase poolt deklareerimisel või muudel alustel tekkiva maksukohustuse või muude kohustuste (trahvid jms) ning tagastusnõuete arvestusse kandmisel, võlgnikule kohustuste summast teatamisel, kohustuse summa tasumisel ja arvestusse kantud kohustuse summa tasutuks märkimisel ning tagastusnõude täitmisel. 2 (2) Maksukorralduse seaduse § 1 lõikes 6 nimetatud avalik-õigusliku rahalise kohustuse arvestusse kandmisel, kohustuse summa tasumisel, arvestusse kantud kohustuse summa tasutuks märkimisel ja tagastusnõude täitmisel rakendatakse käesolevat korda seaduses sätestatud erisustega. RT I 2014-03-20 1 120032014001 2014-04-01 Maksukorralduse seaduse § 1 lõikes 6 nimetatud avalik-õigusliku rahalise kohustuse arvestusse kandmisel, kohustuse summa tasumisel, arvestusse kantud kohustuse summa tasutuks märkimisel ja tagastusnõude täitmisel rakendatakse käesolevat korda seaduses sätestatud erisustega. 3 (3) Käesolevas paragrahvis nimetatud nõuete ja kohustuste üle peetakse arvestust maksukohustuslaste registris. 2014-03-14 RT I 2014-03-20 1 120032014001 2014-04-01 Käesolevas paragrahvis nimetatud nõuete ja kohustuste üle peetakse arvestust maksukohustuslaste registris.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_1 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_10_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui isiku nimel teeb makse kolmas isik, loeb maksuhaldur kolmanda isiku tegutsevaks esindatava isiku teadmisel ja nõusolekul ning maksuhalduril ei teki kohustusi kolmanda isiku suhtes. RT I 2014-03-20 1 120032014001 2014-04-01 Kui isiku nimel teeb makse kolmas isik, loeb maksuhaldur kolmanda isiku tegutsevaks esindatava isiku teadmisel ja nõusolekul ning maksuhalduril ei teki kohustusi kolmanda isiku suhtes. 2 (2) Esindatava isiku nimel makse tegemisel märgitakse maksekorraldusele esindatava isiku ettemaksukonto viitenumber või makse alusdokumendil olev viitenumber. RT I 2014-03-20 1 120032014001 2014-04-01 Esindatava isiku nimel makse tegemisel märgitakse maksekorraldusele esindatava isiku ettemaksukonto viitenumber või makse alusdokumendil olev viitenumber.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_10 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_11_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Arvestusse kantud kohustused täidetakse ettemaksukontolt kohustuse täitmise tähtpäeva lõpu seisuga arvestades maksukorralduse seaduse §-s 105 sätestatut. RT I 2014-03-20 1 120032014001 2014-04-01 Arvestusse kantud kohustused täidetakse ettemaksukontolt kohustuse täitmise tähtpäeva lõpu seisuga arvestades maksukorralduse seaduse §-s 105 sätestatut. 2 (2) Täitmist alustatakse varaseima tasumise tähtpäevaga kohustustest. Täitmist alustatakse varaseima tasumise tähtpäevaga kohustustest. 3 (3) Kui alusdokumendile on väljastatud viitenumber, on võimalik kohustuse eest tasuda enne kohustuse täitmise tähtpäeva, märkides maksekorraldusele väljastatud viitenumbri. RT I 2014-03-20 1 120032014001 2014-04-01 Kui alusdokumendile on väljastatud viitenumber, on võimalik kohustuse eest tasuda enne kohustuse täitmise tähtpäeva, märkides maksekorraldusele väljastatud viitenumbri. 4 (4) Maksuhaldur väljastab dokumendikohase viitenumbri oma haldusaktiga määratud või tollideklaratsiooni alusel määratud summade tasumiseks ning maksuvõla täitetoiminguga seotud summade tasumiseks. RT I 2014-03-20 1 120032014001 2014-04-01 Maksuhaldur väljastab dokumendikohase viitenumbri oma haldusaktiga määratud või tollideklaratsiooni alusel määratud summade tasumiseks ning maksuvõla täitetoiminguga seotud summade tasumiseks. 4 (4¹) Maksukorralduse seaduse § 1 lõikes 6 nimetatud avalik-õigusliku rahalise kohustuse tasumiseks vajaliku viitenumbri väljastab kohus või prokuratuur oma lahendiga või Kaitseressursside Amet oma otsusega. RT I 2024-07-13 3 113072024003 2024-07-16 , rakendatakse 2024. aasta 1. maist Maksukorralduse seaduse § 1 lõikes 6 nimetatud avalik-õigusliku rahalise kohustuse tasumiseks vajaliku viitenumbri väljastab kohus või prokuratuur oma lahendiga või Kaitseressursside Amet oma otsusega. , rakendatakse 2024. aasta 1. maist 5 (5) Kui isik kannab ettemaksukontole alusdokumendi viitenumbriga määratud summast suurema summa, siis jääb enammakstud summa ettemaksukontole. Kui isik kannab ettemaksukontole alusdokumendi viitenumbriga määratud summast suurema summa, siis jääb enammakstud summa ettemaksukontole. 6 (6) Kohustust ei saa täita enne kohustuse arvestusse kandmise kuupäeva. Kohustust ei saa täita enne kohustuse arvestusse kandmise kuupäeva. 7 (7) Kui kohustuse täitmise eest vastutab solidaarselt mitu isikut, siis on maksuhalduril õigus kohustuse täitmiseks kasutada kõigi isikute ettemaksukonto vahendeid täitmise tähtpäevale järgnevast päevast arvates. Kui kohustuse täitmise eest vastutab solidaarselt mitu isikut, siis on maksuhalduril õigus kohustuse täitmiseks kasutada kõigi isikute ettemaksukonto vahendeid täitmise tähtpäevale järgnevast päevast arvates.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_11 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_12_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tagastusnõue saab tekkida: 1 1) deklaratsiooni esitamisel või parandamisel; 2 2) haldusakti esitamisel või parandamisel; 3 3) ettemaksukontole sissemakse tegemisel. Tagastusnõue saab tekkida: deklaratsiooni esitamisel või parandamisel; haldusakti esitamisel või parandamisel; ettemaksukontole sissemakse tegemisel.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_12 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_13_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruse § 12 punktides 1 ja 2 nimetatud tagastusnõudest tekkinud enammakse kantakse isiku ettemaksukontole pärast seda, kui maksuhaldur on tagastusnõude aktsepteerinud. Määruse § 12 punktides 1 ja 2 nimetatud tagastusnõudest tekkinud enammakse kantakse isiku ettemaksukontole pärast seda, kui maksuhaldur on tagastusnõude aktsepteerinud. 2 (2) Maksuhalduril on õigus isiku tagastusnõuded tasaarveldada rahaliste kohustustega ilma isikut sellest eraldi teavitamata. Maksuhalduril on õigus isiku tagastusnõuded tasaarveldada rahaliste kohustustega ilma isikut sellest eraldi teavitamata.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_13 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_14_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tagastusnõude täitmiseks esitab isik maksuhaldurile taotluse, milles on märgitud taotluse esitaja andmed (nimi, registrikood või isikukood), tagastatava summa saaja andmed (nimi, registrikood või isikukood, pangakonto number) ja tagastatava summa suurus. Tagastusnõude täitmiseks esitab isik maksuhaldurile taotluse, milles on märgitud taotluse esitaja andmed (nimi, registrikood või isikukood), tagastatava summa saaja andmed (nimi, registrikood või isikukood, pangakonto number) ja tagastatava summa suurus. 2 (2) Isik võib taotleda tagastatava summa kandmist pangakontole või teise isiku ettemaksukontole. Isik võib taotleda tagastatava summa kandmist pangakontole või teise isiku ettemaksukontole. 3 (3) Tagastusnõude osalise rahuldamise või rahuldamata jätmise korral väljastatakse isikule kirjalik motiveeritud otsus. Tagastusnõude osalise rahuldamise või rahuldamata jätmise korral väljastatakse isikule kirjalik motiveeritud otsus. 4 (4) Maksukorralduse seaduse § 1 lõikes 6 nimetatud riigilõivu, kohtu ja prokuratuuri tagatiste või Kaitseressursside Ameti otsusest tulenevate avalik-õiguslike rahaliste kohustuste, samuti kautsjoni ja oportuniteeditasu maksmiseks määratud kontodele sissemakse tegemisel tekkinud tagastusnõude täitmise taotlus esitatakse kohustuse pannud asutusele. RT I 2024-07-13 3 113072024003 2024-07-16 , rakendatakse 2024. aasta 1. maist Maksukorralduse seaduse § 1 lõikes 6 nimetatud riigilõivu, kohtu ja prokuratuuri tagatiste või Kaitseressursside Ameti otsusest tulenevate avalik-õiguslike rahaliste kohustuste, samuti kautsjoni ja oportuniteeditasu maksmiseks määratud kontodele sissemakse tegemisel tekkinud tagastusnõude täitmise taotlus esitatakse kohustuse pannud asutusele. , rakendatakse 2024. aasta 1. maist",
      "rdfs:label": {
        "@value": "Reg_330178_Par_14 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_15_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kooskõlas Euroopa Parlamendi ja nõukogu määrusega (EL) nr 952/2013, millega kehtestatakse liidu tolliseadustik (ELT L 269, 10.10.2013; edaspidi tolliseadustik) võib isik taotleda tollideklaratsioonil määratud maksusumma tasumise edasilükkamist. RT I 2017-09-29 1 129092017001 2017-10-02 Kooskõlas Euroopa Parlamendi ja nõukogu määrusega (EL) nr 952/2013, millega kehtestatakse liidu tolliseadustik (ELT L 269, 10.10.2013; edaspidi tolliseadustik) võib isik taotleda tollideklaratsioonil määratud maksusumma tasumise edasilükkamist.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_15 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_16_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toll väljastab maksusumma tasumise edasilükkamise loa järgides tolliseadustikus tolli otsuste kohta sätestatut. RT I 2017-09-29 1 129092017001 2017-10-02 Toll väljastab maksusumma tasumise edasilükkamise loa järgides tolliseadustikus tolli otsuste kohta sätestatut.",
      "rdfs:label": {
        "@value": "Reg_330178_Par_16 (redaktsioon 330178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "330178",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/330178",
      "estleg:sourceAct": "Riiklike maksude maksuhalduri poolt hallatavate nõuete ja kohustuste arvestusse kandmise, tasumise ja tagastamise kord",
      "estleg:provisionRef": "Reg_330178 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_17_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui §-s 16 nimetatud loa alusel on maksusumma tasumine edasi lükatud, kuid tähtpäevaks tasumata, peatab toll maksusumma tasumise tähtaja edasilükkamise loa kehtivuse alates maksusumma tasumise tähtpäevale järgnevast päevast kuni maksuvõla tasumiseni. RT I 2017-09-29 1 129092017001 2017-10-02 Kui §-s 16 nimetatud loa alusel on maksusumma tasumine edasi lükatud, kuid tähtpäevaks tasumata, peatab toll maksusumma tasumise tähtaja edasilükkamise loa kehtivuse alates maksusumma tasumise tähtpäevale järgnevast päevast kuni maksuvõla tasumiseni.",
      "rdfs:label": {
