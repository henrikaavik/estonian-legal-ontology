      "estleg:partOfAct": {
        "@id": "estleg:Reg_330178_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_330178_Par_19_v330178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_330178_Par_19"
      },
