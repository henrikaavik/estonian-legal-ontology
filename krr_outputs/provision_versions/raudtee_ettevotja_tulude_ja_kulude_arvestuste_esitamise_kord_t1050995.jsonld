  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_raudtee_ettevotja_tulude_ja_kulude_arvestuste_esitamise_kord_t1050995_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Raudtee-ettevõtja tulude ja kulude arvestuste esitamise kord ja tähtajad ning raamatupidamisandmete loetelu (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Raudtee-ettevõtja tulude ja kulude arvestuste esitamise kord ja tähtajad ning raamatupidamisandmete loetelu"
    },
    {
      "@id": "estleg:Reg_1050995_Par_1_v1050995",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050995_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Raudtee-ettevõtja esitab Konkurentsiametile eelneva majandusaasta kohta 30. juuniks: 1 1) tulude ja kulude arvestuse lisas 1 toodud vormil; 2 2) riigi või kohaliku omavalitsuse üksuse poolt raudteeinfrastruktuuri majandamiseks või avaliku reisijateveoga tegelemiseks antud toetuse kasutamise kohta sihtfinantseerimise kasutamise aruande lisas 2 toodud vormil; 3 3) juurdepääsu tagavate põhiteenuste ja lisateenuste, juurdepääsu abiteenuste, sihtotstarbelise ühekordse läbilaskevõimeosa ja teenindusrajatise tulude ja kulude arvestuse raudteeseaduse § 98 lõike 7 alusel kehtestatud raudteeinfrastruktuuri kasutustasu arvutamise metoodika lisades toodud vormidel. Raudtee-ettevõtja esitab Konkurentsiametile eelneva majandusaasta kohta 30. juuniks: tulude ja kulude arvestuse lisas 1 toodud vormil; riigi või kohaliku omavalitsuse üksuse poolt raudteeinfrastruktuuri majandamiseks või avaliku reisijateveoga tegelemiseks antud toetuse kasutamise kohta sihtfinantseerimise kasutamise aruande lisas 2 toodud vormil; juurdepääsu tagavate põhiteenuste ja lisateenuste, juurdepääsu abiteenuste, sihtotstarbelise ühekordse läbilaskevõimeosa ja teenindusrajatise tulude ja kulude arvestuse raudteeseaduse § 98 lõike 7 alusel kehtestatud raudteeinfrastruktuuri kasutustasu arvutamise metoodika lisades toodud vormidel. 2 (2) Lõikes 1 nimetatule lisab raudtee-ettevõtja oma raamatupidamise sise-eeskirja ja struktuuriüksuste skeemi, kui neid pole varem Konkurentsiametile esitatud või need on viimasest esitamisest arvates muutunud. Lõikes 1 nimetatule lisab raudtee-ettevõtja oma raamatupidamise sise-eeskirja ja struktuuriüksuste skeemi, kui neid pole varem Konkurentsiametile esitatud või need on viimasest esitamisest arvates muutunud.",
      "rdfs:label": {
        "@value": "Reg_1050995_Par_1 (redaktsioon 1050995)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050995",
