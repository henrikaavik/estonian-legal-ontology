      "estleg:sourceAct": "Raudtee-ettevõtja tulude ja kulude arvestuste esitamise kord ja tähtajad ning raamatupidamisandmete loetelu",
      "estleg:provisionRef": "Reg_1050995 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050995_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050995_Par_4_v1050995",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050995_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvi 1 lõikes 1 sätestatud tulude ja kulude arvestuses esitatakse üldkuludena järgmised kulud: 1 1) administratsiooni tööjõukulu; 2 2) kinnisvarakulu, sealhulgas majandamise, kommunaal- ja rendikulud ning maamaks; 3 3) õigusabikulud; 4 4) infotehnoloogiakulu; 5 5) otsekuludes mittekajastatud kulum; 6 6) muud administratsiooni kulud; 7 7) muud põhjendatud kulud. Paragrahvi 1 lõikes 1 sätestatud tulude ja kulude arvestuses esitatakse üldkuludena järgmised kulud: administratsiooni tööjõukulu; kinnisvarakulu, sealhulgas majandamise, kommunaal- ja rendikulud ning maamaks; õigusabikulud; infotehnoloogiakulu; otsekuludes mittekajastatud kulum; muud administratsiooni kulud; muud põhjendatud kulud.",
      "rdfs:label": {
        "@value": "Reg_1050995_Par_4 (redaktsioon 1050995)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050995",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050995",
      "estleg:sourceAct": "Raudtee-ettevõtja tulude ja kulude arvestuste esitamise kord ja tähtajad ning raamatupidamisandmete loetelu",
      "estleg:provisionRef": "Reg_1050995 § 4",
