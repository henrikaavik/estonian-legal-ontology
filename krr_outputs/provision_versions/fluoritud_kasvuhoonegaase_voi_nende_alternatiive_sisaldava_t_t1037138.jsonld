      "estleg:versionValidFrom": {
        "@value": "2026-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fluoritud kasvuhoonegaase või nende alternatiive sisaldava toote, seadme ja süsteemi käitlemise luba (edaspidi käitlemisluba) on kohustuslik atmosfääriõhu kaitse seaduse §-s 197 nimetatud juhtudel. RT I 2026-04-17 10 117042026010 2026-04-20 Fluoritud kasvuhoonegaase või nende alternatiive sisaldava toote, seadme ja süsteemi käitlemise luba (edaspidi käitlemisluba) on kohustuslik atmosfääriõhu kaitse seaduse §-s 197 nimetatud juhtudel.",
      "rdfs:label": {
        "@value": "Reg_1037138_Par_1 (redaktsioon 1037138)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037138",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037138",
      "estleg:sourceAct": "Fluoritud kasvuhoonegaase või nende alternatiive sisaldava toote, seadme ja süsteemi käitlemisloa taotlemise ja muutmise täpsustatud kord, käitlemisloa taotluse ja käitlemisloa täpsustatud nõuded ning andmekoosseis",
      "estleg:provisionRef": "Reg_1037138 § 1",
