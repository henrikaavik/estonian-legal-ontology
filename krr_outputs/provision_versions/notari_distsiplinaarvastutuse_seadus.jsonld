      },
      "estleg:versionValidTo": {
        "@value": "2009-08-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_16_v13185602",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "NotDVS_Par_16 (redaktsioon 13185602)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185602",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_16_v122122020042"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_16_v122122020042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "NotDVS_Par_16 (redaktsioon 122122020042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122020042"
    },
    {
      "@id": "estleg:NotDVS_Par_17_v22338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui notarit on karistatud ebaseaduslikult või karistus ei vasta süüteo raskusele ja selle toimepanemise asjaoludele või süüteole eelnevale notari käitumisele, tühistab kohus määratud distsiplinaarkaristuse. (2) Kui kohus on tühistanud notari ametist tagandamise kui toimepandud distsiplinaarsüüteo raskusele mittevastava, ei ole notaril õigust nõuda hüvitist saamata jäänud sissetuleku eest.",
      "rdfs:label": {
        "@value": "NotDVS_Par_17 (redaktsioon 22338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22338"
    },
    {
      "@id": "estleg:NotDVS_Par_18_v22338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui notari suhtes on alustatud distsiplinaarmenetlus, ei vabastata teda omal soovil ametist enne, kui distsiplinaarmenetlus on lõpetatud.",
      "rdfs:label": {
        "@value": "NotDVS_Par_18 (redaktsioon 22338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22338",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_18_v122122020042"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_18_v122122020042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui notari suhtes on algatatud distsiplinaarmenetlus või aukohtumenetlus, ei vabastata teda omal soovil ametist enne, kui distsiplinaarmenetlus on lõpetatud.",
      "rdfs:label": {
        "@value": "NotDVS_Par_18 (redaktsioon 122122020042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122020042"
    },
    {
      "@id": "estleg:NotDVS_Par_19_v22338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notar, kes on nimetatud teise notari asendajaks, vastutab asendajana toimepandud distsiplinaarsüüteo eest käesoleva seaduse paragrahvides 2-18 sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "NotDVS_Par_19 (redaktsioon 22338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22338",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_19_v977169"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_19_v977169",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notar, kes on nimetatud teise notari asendajaks, vastutab asendajana toimepandud distsiplinaarsüüteo eest käesoleva seaduse §-des 2-18 sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "NotDVS_Par_19 (redaktsioon 977169)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977169",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_19_v13185124"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_19_v13185124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notariaadiseaduse § 21 lõikes 1 nimetatud isikud vastutavad asendajana toimepandud distsiplinaarsüüteo eest käesoleva seaduse §-des 2–18 sätestatud alusel ja korras. (2) Notariaadiseaduse § 21 lõikes 1 nimetatud isikute suhtes käesoleva seaduse § 3 punktis 3 ja §-s 10 nimetatud distsiplinaarkaristuse kohaldamisel kaotab isik õiguse olla notari asendaja.",
      "rdfs:label": {
        "@value": "NotDVS_Par_19 (redaktsioon 13185124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185124",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_19_v13334392"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_19_v13334392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notariaadiseaduse § 21 lõigetes 1 ja 2 nimetatud isikud vastutavad asendajana toimepandud distsiplinaarsüüteo eest käesoleva seaduse §-des 2–18 sätestatud alusel ja korras. (2) Notariaadiseaduse § 21 lõigetes 1 ja 2 nimetatud isikute suhtes käesoleva seaduse § 3 punktis 3 ja §-s 10 nimetatud distsiplinaarkaristuse kohaldamisel kaotab isik õiguse olla notari asendaja.",
      "rdfs:label": {
        "@value": "NotDVS_Par_19 (redaktsioon 13334392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13334392",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_19_v122122020042"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_19_v122122020042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notariaadiseaduse § 21 lõigetes 1 ja 2 nimetatud isikud vastutavad asendajana toimepandud distsiplinaarsüüteo eest käesoleva seaduse §-des 2–18 sätestatud alusel ja korras. (2) Notariaadiseaduse § 21 lõigetes 1 ja 2 nimetatud isikute suhtes käesoleva seaduse § 3 punktis 3 ja §-s 10 nimetatud distsiplinaarkaristuse kohaldamisel kaotab isik õiguse olla notari asendaja. (3) Notariaadiseaduse § 21 lõigetes 1 ja 2 nimetatud isikutele määrab käesoleva seaduse § 3 punktis 3 ja §-s 10 nimetatud distsiplinaarkaristuse Notarite Koda.",
      "rdfs:label": {
        "@value": "NotDVS_Par_19 (redaktsioon 122122020042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122020042"
    },
    {
      "@id": "estleg:NotDVS_Par_2_v22338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notari distsiplinaarsüüteod on: ametikohustuste süüline täitmata jätmine või mittenõuetekohane täitmine, sealhulgas eksimine selgelt sätestatud ja üheselt mõistetava õigusnormi vastu seaduse rakendamisel või omakasu ajendil notari tasumääradele mittevastava tasu võtmine; vääritu tegu, s.o. süüline tegu, mis on vastuolus üldtunnustatud kõlblusnormidega või diskrediteerib notariametit, sõltumata sellest, kas niisugune tegu pandi toime ametikohustuste täitmisel või mitte.",
      "rdfs:label": {
        "@value": "NotDVS_Par_2 (redaktsioon 22338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22338",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_2_v13185124"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_2_v13185124",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Notari distsiplinaarsüüteod on: ametikohustuste süüline täitmata jätmine või mittenõuetekohane täitmine, sealhulgas eksimine selgelt sätestatud ja üheselt mõistetava õigusnormi vastu seaduse rakendamisel või notari tasumääradele mittevastava tasu võtmine; vääritu tegu, s.o. süüline tegu, mis on vastuolus üldtunnustatud kõlblusnormidega või diskrediteerib notariametit, sõltumata sellest, kas niisugune tegu pandi toime ametikohustuste täitmisel või mitte.",
      "rdfs:label": {
        "@value": "NotDVS_Par_2 (redaktsioon 13185124)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185124",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_2_v13185602"
      },
      "estleg:versionValidTo": {
        "@value": "2009-08-29",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:NotDVS_Par_2_v13185602",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notari distsiplinaarsüüteod on: ametikohustuste süüline täitmata jätmine või mittenõuetekohane täitmine, sealhulgas eksimine selgelt sätestatud ja üheselt mõistetava õigusnormi vastu seaduse rakendamisel või notari tasumääradele mittevastava tasu võtmine; vääritu tegu, s.o. süüline tegu, mis on vastuolus üldtunnustatud kõlblusnormidega või diskrediteerib notariametit, sõltumata sellest, kas niisugune tegu pandi toime ametikohustuste täitmisel või mitte. (2) Notari suhtes ei saa algatada distsiplinaarmenetlust seoses tema tegutsemisega vahekohtunikuna, välja arvatud käesoleva paragrahvi lõike 1 punktis 2 sätestatud juhul.",
      "rdfs:label": {
        "@value": "NotDVS_Par_2 (redaktsioon 13185602)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13185602"
    },
    {
      "@id": "estleg:NotDVS_Par_20_v22338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NotDVS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notarikandidaat, kes on nimetatud notari asendajaks, vastutab notari asendajana toimepandud distsiplinaarsüüteo eest käesoleva seaduse paragrahvides 2, 4-7, 11-17 sätestatud alusel ja korras. (2) Notarit asendavale notarikandidaadile võib määrata notari asendajana toimepandud distsiplinaarsüüteo eest ühe käesoleva seaduse paragrahvis 22 näidatud distsiplinaarkaristuse.",
