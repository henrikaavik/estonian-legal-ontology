      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Notarikandidaadi distsiplinaarvastutusele võtmisel kohaldatakse töötajate distsiplinaarvastutuse seaduse (RT I 1993, 26, 441) § 6 1. ja 2. lõiget, § 7 1. ja 3. lõiget, § 8 1. lõiget, §-e 9-15, § 17 1. ja 2. ning 4.-6. lõiget ning §-e 18 ja 23. (2) Käesoleva paragrahvi 1. lõikes nimetatud sätete kohaldamisel kuuluvad tööandja õigused kandidaaditeenistuse lõpetamise korral justiitsministrile ning muudel juhtudel Notarite Kojale.",
      "rdfs:label": {
        "@value": "NotDVS_Par_24 (redaktsioon 977169)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977169",
      "estleg:supersededByVersion": {
        "@id": "estleg:NotDVS_Par_24_v13110981"
      },
      "estleg:versionValidTo": {
