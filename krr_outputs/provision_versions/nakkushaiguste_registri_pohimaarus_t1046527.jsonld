    {
      "@id": "estleg:Reg_1046527_Par_11_v1046527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046527_Par_11"
