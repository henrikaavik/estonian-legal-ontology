        "@value": "2022-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri andmetel on informatiivne tähendus. Registri andmetel on informatiivne tähendus.",
      "rdfs:label": {
        "@value": "Reg_1046527_Par_6 (redaktsioon 1046527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046527",
