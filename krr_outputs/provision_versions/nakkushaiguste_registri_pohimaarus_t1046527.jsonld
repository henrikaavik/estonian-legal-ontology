      "estleg:provisionRef": "Reg_1046527 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046527_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046527_Par_4_v1046527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046527_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Register koosneb elektroonsest andmebaasist ja arhiveeritud registriandmetest. Register koosneb elektroonsest andmebaasist ja arhiveeritud registriandmetest. 2 (2) Registri alusandmed on elektroonsed või paberil. Paberil esitatud andmed kantakse registrisse elektroonselt. Registri alusandmed on elektroonsed või paberil. Paberil esitatud andmed kantakse registrisse elektroonselt.",
      "rdfs:label": {
        "@value": "Reg_1046527_Par_4 (redaktsioon 1046527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046527",
