      }
    },
    {
      "@id": "estleg:Reg_1046527_Par_5_v1046527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046527_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registri andmete kaitse tagatakse käideldavuse, tervikluse ja konfidentsiaalsuse parameetrite hindamise kaudu vastavalt riigi infosüsteemide turvameetmete süsteemi nõuetele. Registri andmete kaitse tagatakse käideldavuse, tervikluse ja konfidentsiaalsuse parameetrite hindamise kaudu vastavalt riigi infosüsteemide turvameetmete süsteemi nõuetele. 2 (2) Registrisse kantud andmete käideldavuse (K), tervikluse (T) ja konfidentsiaalsuse (S) tagamiseks rakendatakse organisatsioonilisi, füüsilisi ja infotehnoloogilisi turvameetmeid. Registrisse kantud andmete käideldavuse (K), tervikluse (T) ja konfidentsiaalsuse (S) tagamiseks rakendatakse organisatsioonilisi, füüsilisi ja infotehnoloogilisi turvameetmeid. 3 (3) Registri turvaklass on K2T2S2. Registri turvaklass on K2T2S2. 4 (4) Registri turbeaste on keskmine (M). Registri turbeaste on keskmine (M).",
      "rdfs:label": {
        "@value": "Reg_1046527_Par_5 (redaktsioon 1046527)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046527",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046527",
      "estleg:sourceAct": "Nakkushaiguste registri põhimäärus",
      "estleg:provisionRef": "Reg_1046527 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046527_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046527_Par_6_v1046527",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046527_Par_6"
      },
