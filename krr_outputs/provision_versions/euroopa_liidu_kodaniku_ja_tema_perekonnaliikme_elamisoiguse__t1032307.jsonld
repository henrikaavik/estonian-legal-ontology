        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_24_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui tähtajalise elamisõiguse, tähtajalise elamisõiguse pikendamise või alalise elamisõiguse registreerimise taotlemisel ei ole perekonnaliikmelt terviseseisundi tõttu ajutiselt võimalik üheltki sõrmelt sõrmejälge võtta või kui perekonnaliikme püsiv terviseseisund ei võimalda sõrmejälgede võtmist, peab ta lisama taotlusele selle kohta oma raviarsti väljastatud isikut tõendavate dokumentide seaduse alusel valdkonna eest vastutava ministri määrusega kehtestatud vormikohase tõendi taotleja terviseseisundist tingitud sõrmejälgede võtmise võimatuse kohta. Eesti välisesinduses esitatud taotluse puhul võib perekonnaliige lisada vormikohase tõendi asemel välisriigi arsti asjaomase tõendi. Ajutist sõrmejälgede võtmise võimatust tõendav tõend kehtib kuni 6 kuud ja püsivat sõrmejälgede võtmise võimatust tõendav tõend kuni 5 aastat. Kui tähtajalise elamisõiguse, tähtajalise elamisõiguse pikendamise või alalise elamisõiguse registreerimise taotlemisel ei ole perekonnaliikmelt terviseseisundi tõttu ajutiselt võimalik üheltki sõrmelt sõrmejälge võtta või kui perekonnaliikme püsiv terviseseisund ei võimalda sõrmejälgede võtmist, peab ta lisama taotlusele selle kohta oma raviarsti väljastatud isikut tõendavate dokumentide seaduse alusel valdkonna eest vastutava ministri määrusega kehtestatud vormikohase tõendi taotleja terviseseisundist tingitud sõrmejälgede võtmise võimatuse kohta. Eesti välisesinduses esitatud taotluse puhul võib perekonnaliige lisada vormikohase tõendi asemel välisriigi arsti asjaomase tõendi. Ajutist sõrmejälgede võtmise võimatust tõendav tõend kehtib kuni 6 kuud ja püsivat sõrmejälgede võtmise võimatust tõendav tõend kuni 5 aastat. 2 (2) Kui perekonnaliikmelt ei saa ühelt või mõlemalt käelt sõrmejälge võtta sõrme esimese lüli puudumise tõttu, siis ei ole lõikes 1 nimetatud tõendi lisamine vajalik. Sõrme esimese lüli puudumise tuvastab ametnik. Kui perekonnaliikmelt ei saa ühelt või mõlemalt käelt sõrmejälge võtta sõrme esimese lüli puudumise tõttu, siis ei ole lõikes 1 nimetatud tõendi lisamine vajalik. Sõrme esimese lüli puudumise tuvastab ametnik.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_24 (redaktsioon 1032307)",
        "@language": "et"
      },
