      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas määruses sätestatud menetlusele laieneb haldusmenetluse seadus Euroopa Liidu kodaniku seaduses sätestatud erisustega. Käesolevas määruses sätestatud menetlusele laieneb haldusmenetluse seadus Euroopa Liidu kodaniku seaduses sätestatud erisustega.",
      "rdfs:label": {
