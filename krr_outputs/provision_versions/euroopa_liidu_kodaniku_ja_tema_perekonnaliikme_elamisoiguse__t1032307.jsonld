      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_33_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist esitatud tähtajalise elamisõiguse taotlused, tähtajalise elamisõiguse pikendamise taotlused ja alalise elamisõiguse registreerimise taotlused vaadatakse läbi taotluse esitamise ajal kehtinud tingimustel ja korras. Enne käesoleva määruse jõustumist esitatud tähtajalise elamisõiguse taotlused, tähtajalise elamisõiguse pikendamise taotlused ja alalise elamisõiguse registreerimise taotlused vaadatakse läbi taotluse esitamise ajal kehtinud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_33 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_34_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus jõustub 1. jaanuaril 2016. aastal. Määrus jõustub 1. jaanuaril 2016. aastal. 2 (2) Käesoleva määruse § 22 lõige 3 jõustub 2016. aasta 1. juulil. Käesoleva määruse § 22 lõige 3 jõustub 2016. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_34 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_4_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevas määruses sätestatud toimingute sooritamisel kontrollitakse Euroopa Liidu kodaniku ja perekonnaliikme isikusamasust isikut tõendavate dokumentide seaduse § 2 lõikes 2 sätestatud dokumendi alusel või tema isik tuvastatakse Euroopa Liidu liikmesriigi väljaantud isikut tõendava dokumendi või välisriigi reisidokumendi alusel. Käesolevas määruses sätestatud toimingute sooritamisel kontrollitakse Euroopa Liidu kodaniku ja perekonnaliikme isikusamasust isikut tõendavate dokumentide seaduse § 2 lõikes 2 sätestatud dokumendi alusel või tema isik tuvastatakse Euroopa Liidu liikmesriigi väljaantud isikut tõendava dokumendi või välisriigi reisidokumendi alusel. 2 (2) Alla 15-aastase Euroopa Liidu kodaniku ja perekonnaliikme, kellele ei ole välja antud lõikes 1 nimetatud dokumenti, isik tuvastatakse sünnitunnistuse ja seadusliku esindaja ütluste alusel. Alla 15-aastase Euroopa Liidu kodaniku ja perekonnaliikme, kellele ei ole välja antud lõikes 1 nimetatud dokumenti, isik tuvastatakse sünnitunnistuse ja seadusliku esindaja ütluste alusel. 3 (3) Euroopa Liidu kodaniku ja perekonnaliikme isik tuvastatakse või isikusamasust kontrollitakse, kui isikul ei ole lõigetes 1 ja 2 nimetatud dokumenti, muu dokumentaalse tõendi alusel. Euroopa Liidu kodaniku ja perekonnaliikme isik tuvastatakse või isikusamasust kontrollitakse, kui isikul ei ole lõigetes 1 ja 2 nimetatud dokumenti, muu dokumentaalse tõendi alusel.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_4 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_5_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tähtajalist elamisõigust taotlev perekonnaliige peab tähtajalise elamisõiguse taotluse esitamiseks ilmuma isiklikult Eesti välisesindusse või Politsei- ja Piirivalveametisse. Eesti välisesindus edastab talle esitatud tähtajalise elamisõiguse taotluse pärast isiku tuvastamist või isikusamasuse kontrollimist ja biomeetriliste andmete võtmist, kui see on nõutav, menetlemiseks Politsei- ja Piirivalveametile. Tähtajalist elamisõigust taotlev perekonnaliige peab tähtajalise elamisõiguse taotluse esitamiseks ilmuma isiklikult Eesti välisesindusse või Politsei- ja Piirivalveametisse. Eesti välisesindus edastab talle esitatud tähtajalise elamisõiguse taotluse pärast isiku tuvastamist või isikusamasuse kontrollimist ja biomeetriliste andmete võtmist, kui see on nõutav, menetlemiseks Politsei- ja Piirivalveametile. 2 (2) Tähtajalise elamisõiguse pikendamist taotlev perekonnaliige peab tähtajalise elamisõiguse pikendamise taotluse esitamiseks ilmuma isiklikult Politsei- ja Piirivalveametisse. Posti teel võib Politsei- ja Piirivalveametile taotluse esitada perekonnaliige juhul, kui taotleja suhtes esineb välismaalaste seaduse §-s 277 sätestatud asjaolu, ja juhul, kui taotleja viimasest elamisloa või tööloa menetluses, elamisõiguse menetluses või isikut tõendava dokumendi väljaandmise menetluses võetud sõrmejäljed võimaldavad isiku tuvastada ja vastavad isikut tõendavate dokumentide seaduse § 15 lõike 6 ning välismaalase seaduse § 224 lõike 1 punktide 4 ja 5 ning § 250 lõike 2 punktide 7 ja 8 alusel kehtestatud nõuetele, ning taotleja biomeetrilised andmed ei ole muutunud. RT I 2017-01-14 1 112012017001 2017-01-18 Tähtajalise elamisõiguse pikendamist taotlev perekonnaliige peab tähtajalise elamisõiguse pikendamise taotluse esitamiseks ilmuma isiklikult Politsei- ja Piirivalveametisse. Posti teel võib Politsei- ja Piirivalveametile taotluse esitada perekonnaliige juhul, kui taotleja suhtes esineb välismaalaste seaduse §-s 277 sätestatud asjaolu, ja juhul, kui taotleja viimasest elamisloa või tööloa menetluses, elamisõiguse menetluses või isikut tõendava dokumendi väljaandmise menetluses võetud sõrmejäljed võimaldavad isiku tuvastada ja vastavad isikut tõendavate dokumentide seaduse § 15 lõike 6 ning välismaalase seaduse § 224 lõike 1 punktide 4 ja 5 ning § 250 lõike 2 punktide 7 ja 8 alusel kehtestatud nõuetele, ning taotleja biomeetrilised andmed ei ole muutunud. 3 (3) Tähtajalise elamisõiguse taotlemiseks või tähtajalise elamisõiguse pikendamise taotlemiseks esitab perekonnaliige taotluse, millele on lisatud määruses ettenähtud dokumendid. RT I 2017-01-14 1 112012017001 2017-01-18 Tähtajalise elamisõiguse taotlemiseks või tähtajalise elamisõiguse pikendamise taotlemiseks esitab perekonnaliige taotluse, millele on lisatud määruses ettenähtud dokumendid.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_5 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_6_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Alalise elamisõiguse registreerimise taotluse esitab Euroopa Liidu kodanik Politsei- ja Piirivalveametile. Alalise elamisõiguse registreerimise taotluse võib Euroopa Liidu kodanik esitada posti teel. Alalise elamisõiguse registreerimise taotluse esitab Euroopa Liidu kodanik Politsei- ja Piirivalveametile. Alalise elamisõiguse registreerimise taotluse võib Euroopa Liidu kodanik esitada posti teel. 2 (2) Alalise elamisõiguse registreerimist taotlev perekonnaliige peab alalise elamisõiguse registreerimise taotluse esitamiseks ilmuma isiklikult Politsei- ja Piirivalveametisse. Posti teel võib Politsei- ja Piirivalveametile taotluse esitada perekonnaliige juhul, kui taotleja suhtes esineb välismaalaste seaduse §-s 277 sätestatud asjaolu, ja juhul, kui taotleja viimasest elamisloa või tööloa menetluses, elamisõiguse menetluses või isikut tõendava dokumendi väljaandmise menetluses võetud sõrmejäljed võimaldavad isiku tuvastada ja vastavad isikut tõendavate dokumentide seaduse § 15 lõike 6 ning välismaalase seaduse § 224 lõike 1 punktide 4 ja 5 ning § 250 lõike 2 punktide 7 ja 8 alusel kehtestatud nõuetele, ning taotleja biomeetrilised andmed ei ole muutunud. RT I 2017-01-14 1 112012017001 2017-01-18 Alalise elamisõiguse registreerimist taotlev perekonnaliige peab alalise elamisõiguse registreerimise taotluse esitamiseks ilmuma isiklikult Politsei- ja Piirivalveametisse. Posti teel võib Politsei- ja Piirivalveametile taotluse esitada perekonnaliige juhul, kui taotleja suhtes esineb välismaalaste seaduse §-s 277 sätestatud asjaolu, ja juhul, kui taotleja viimasest elamisloa või tööloa menetluses, elamisõiguse menetluses või isikut tõendava dokumendi väljaandmise menetluses võetud sõrmejäljed võimaldavad isiku tuvastada ja vastavad isikut tõendavate dokumentide seaduse § 15 lõike 6 ning välismaalase seaduse § 224 lõike 1 punktide 4 ja 5 ning § 250 lõike 2 punktide 7 ja 8 alusel kehtestatud nõuetele, ning taotleja biomeetrilised andmed ei ole muutunud. 3 (3) Kehtetu - RT I 2017-10-10 3 110102017003 2017-10-13 Kehtetu - 4 (4) Alalise elamisõiguse registreerimiseks esitab taotleja taotluse, millele on lisatud määruses ettenähtud dokumendid. RT I 2017-01-14 1 112012017001 2017-01-18 Alalise elamisõiguse registreerimiseks esitab taotleja taotluse, millele on lisatud määruses ettenähtud dokumendid.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_6 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_7_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eestis kinnipidamisasutuses viibiva Euroopa Liidu kodaniku perekonnaliikme elamisõiguse taotluse edastab perekonnaliikme poolt selleks volitatud kinnipidamisasutuse ametnik või töötaja. Kinnipidamisasutuse ametnik või töötaja esitab nimetatud toimingute sooritamisel lisaks kinnipeetava volikirjale oma ametitõendi. Eestis kinnipidamisasutuses viibiva Euroopa Liidu kodaniku perekonnaliikme elamisõiguse taotluse edastab perekonnaliikme poolt selleks volitatud kinnipidamisasutuse ametnik või töötaja. Kinnipidamisasutuse ametnik või töötaja esitab nimetatud toimingute sooritamisel lisaks kinnipeetava volikirjale oma ametitõendi. 2 (2) Eestis kinnipidamisasutuses viibiv Euroopa Liidu kodaniku perekonnaliige võib lõikes 1 nimetatud taotluse esitada posti teel kinnipidamisasutuse kaudu kinnipidamisasutuse kaaskirjaga, mis kinnitab, et kinnipidamisasutuse ametnik või töötaja on kontrollinud taotleja isikusamasust. Eestis kinnipidamisasutuses viibiv Euroopa Liidu kodaniku perekonnaliige võib lõikes 1 nimetatud taotluse esitada posti teel kinnipidamisasutuse kaudu kinnipidamisasutuse kaaskirjaga, mis kinnitab, et kinnipidamisasutuse ametnik või töötaja on kontrollinud taotleja isikusamasust. 3 (3) Kui Eestis viibiva Euroopa Liidu kodaniku perekonnaliikme terviseseisund püsivalt ei võimalda tal Politsei- ja Piirivalveametisse ilmuda ja isiklik ilmumine on nõutav, võib võimaluse korral tuvastada isiku, kontrollida isikusamasust, võtta isikult biomeetrilisi andmeid ja teha muid menetlustoiminguid perekonnaliikme elukohas ja viibimiskohas Eestis. Kui Eestis viibiva Euroopa Liidu kodaniku perekonnaliikme terviseseisund püsivalt ei võimalda tal Politsei- ja Piirivalveametisse ilmuda ja isiklik ilmumine on nõutav, võib võimaluse korral tuvastada isiku, kontrollida isikusamasust, võtta isikult biomeetrilisi andmeid ja teha muid menetlustoiminguid perekonnaliikme elukohas ja viibimiskohas Eestis.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_7 (redaktsioon 1032307)",
        "@language": "et"
      },
