      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_20_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tähtajalise elamisõiguse ja tähtajalise elamisõiguse pikendamise taotlemisel esitatakse järgmised dokumendid: 1 1) taotlus; RT I 2017-01-14 1 112012017001 2017-01-18 2 2) Euroopa Liidu kodaniku kinnitus; 3 3) taotleja isikut tõendav dokument; 4 4) foto; 5 5) dokument, mis tõendab, et taotleja on perekonnaliige Euroopa Liidu kodaniku seaduse § 3 kohaselt; 6 6) riigilõivu tasumist tõendav dokument, v.a juhul, kui taotleja esitab kirjalikult §-s 19 nimetatud andmed. Tähtajalise elamisõiguse ja tähtajalise elamisõiguse pikendamise taotlemisel esitatakse järgmised dokumendid: taotlus; Euroopa Liidu kodaniku kinnitus; taotleja isikut tõendav dokument; foto; dokument, mis tõendab, et taotleja on perekonnaliige Euroopa Liidu kodaniku seaduse § 3 kohaselt; riigilõivu tasumist tõendav dokument, v.a juhul, kui taotleja esitab kirjalikult §-s 19 nimetatud andmed.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_20 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_20_20_v1032307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032307_Par_20_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa Liidu kodaniku seaduse § 131, § 20 lõike 2 või § 593 alusel Euroopa Liidu kodaniku või tema perekonnaliikme alaealisele lapsele tähtajalise elamisõiguse saamiseks, kui lapse sünd on registreeritud välisriigis, peab lapse sünd olema kantud Eesti rahvastikuregistrisse. RT I 2017-10-10 3 110102017003 2017-10-13 Euroopa Liidu kodaniku seaduse § 131, § 20 lõike 2 või § 593 alusel Euroopa Liidu kodaniku või tema perekonnaliikme alaealisele lapsele tähtajalise elamisõiguse saamiseks, kui lapse sünd on registreeritud välisriigis, peab lapse sünd olema kantud Eesti rahvastikuregistrisse.",
      "rdfs:label": {
        "@value": "Reg_1032307_Par_20_20 (redaktsioon 1032307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032307",
      "estleg:sourceAct": "Euroopa Liidu kodaniku ja tema perekonnaliikme elamisõiguse taotlemise, andmise ning selle pikendamise ja lõpetamise kord",
      "estleg:provisionRef": "Reg_1032307 § 20_20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032307_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032307_Par_21_v1032307",
      "@type": [
