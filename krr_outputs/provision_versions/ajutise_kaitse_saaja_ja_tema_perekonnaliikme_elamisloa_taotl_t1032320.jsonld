      }
    },
    {
      "@id": "estleg:Reg_1032320_Par_2_v1032320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032320_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevas määruses sätestatud toimingute sooritamisel kontrollitakse taotleja isikusamasust isikut tõendavate dokumentide seaduse § 2 lõikes 2 sätestatud dokumendi alusel või tuvastatakse isik välisriigi reisidokumendi alusel. Käesolevas määruses sätestatud toimingute sooritamisel kontrollitakse taotleja isikusamasust isikut tõendavate dokumentide seaduse § 2 lõikes 2 sätestatud dokumendi alusel või tuvastatakse isik välisriigi reisidokumendi alusel. 2 (2) Kui alla 15-aastasele taotlejale ja saatjata alaealisele ei ole välja antud käesoleva paragrahvi lõikes 1 nimetatud dokumenti, tuvastatakse tema isik sünnitunnistuse ja seadusliku esindaja ütluste alusel. Kui alla 15-aastasele taotlejale ja saatjata alaealisele ei ole välja antud käesoleva paragrahvi lõikes 1 nimetatud dokumenti, tuvastatakse tema isik sünnitunnistuse ja seadusliku esindaja ütluste alusel. 3 (3) Kui elamisloa taotluse esitab isik, kellel ei ole käesoleva paragrahvi lõigetes 1 ja 2 nimetatud dokumente, tuvastatakse tema isik või kontrollitakse isikusamasust muu dokumentaalse tõendi alusel. Tõendi puudumise korral tuvastatakse isik tema või tema seadusliku esindaja ütluste alusel ning taotlust vastuvõttev ametnik teeb taotlusele vastava märke. Kui elamisloa taotluse esitab isik, kellel ei ole käesoleva paragrahvi lõigetes 1 ja 2 nimetatud dokumente, tuvastatakse tema isik või kontrollitakse isikusamasust muu dokumentaalse tõendi alusel. Tõendi puudumise korral tuvastatakse isik tema või tema seadusliku esindaja ütluste alusel ning taotlust vastuvõttev ametnik teeb taotlusele vastava märke.",
      "rdfs:label": {
        "@value": "Reg_1032320_Par_2 (redaktsioon 1032320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032320",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032320",
      "estleg:sourceAct": "Ajutise kaitse saaja ja tema perekonnaliikme elamisloa taotlemise, andmise, pikendamise ja kehtetuks tunnistamise kord ning elamisloa taotlemisel esitatavate tõendite ja andmete loetelu",
      "estleg:provisionRef": "Reg_1032320 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032320_Map_2026"
      }
    },
