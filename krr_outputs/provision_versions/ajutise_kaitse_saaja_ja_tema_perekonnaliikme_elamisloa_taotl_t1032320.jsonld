  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_ajutise_kaitse_saaja_ja_tema_perekonnaliikme_elamisloa_taotl_t1032320_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ajutise kaitse saaja ja tema perekonnaliikme elamisloa taotlemise, andmise, pikendamise ja kehtetuks tunnistamise kord ning elamisloa taotlemisel esitatavate tõendite ja andmete loetelu (15 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ajutise kaitse saaja ja tema perekonnaliikme elamisloa taotlemise, andmise, pikendamise ja kehtetuks tunnistamise kord ning elamisloa taotlemisel esitatavate tõendite ja andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1032320_Par_1_v1032320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032320_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevas määruses sätestatud toimingud sooritab ajutise kaitse saaja või ajutise kaitse alusel elamisloa pikendamise taotleja ning nende perekonnaliige (edaspidi taotleja) isiklikult või seadusliku esindaja kaudu. Need käesolevas määruses sätestatud toimingud, mille nende olemuse tõttu peab sooritama isiklikult, sooritab taotleja isiklikult. Käesolevas määruses sätestatud toimingud sooritab ajutise kaitse saaja või ajutise kaitse alusel elamisloa pikendamise taotleja ning nende perekonnaliige (edaspidi taotleja) isiklikult või seadusliku esindaja kaudu. Need käesolevas määruses sätestatud toimingud, mille nende olemuse tõttu peab sooritama isiklikult, sooritab taotleja isiklikult. 2 (2) Alaealise või piiratud teovõimega täisealise taotleja eest sooritab käesolevas määruses sätestatud toimingud tema seaduslik esindaja, kui nad viibivad Eestis ja see ei ole vastuolus taotleja õiguste ega huvidega. Alaealise või piiratud teovõimega täisealise taotleja eest sooritab käesolevas määruses sätestatud toimingud tema seaduslik esindaja, kui nad viibivad Eestis ja see ei ole vastuolus taotleja õiguste ega huvidega. 3 (3) Saatjata alaealise eest sooritab käesolevas määruses sätestatud toimingud tema esindaja välismaalasele rahvusvahelise kaitse andmise seaduses sätestatud korras. Saatjata alaealise eest sooritab käesolevas määruses sätestatud toimingud tema esindaja välismaalasele rahvusvahelise kaitse andmise seaduses sätestatud korras. 4 (4) Toimingu sooritamisel esitab seaduslik esindaja isikut ja esindusõigust tõendava dokumendi. Toimingu sooritamisel esitab seaduslik esindaja isikut ja esindusõigust tõendava dokumendi.",
      "rdfs:label": {
        "@value": "Reg_1032320_Par_1 (redaktsioon 1032320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032320",
