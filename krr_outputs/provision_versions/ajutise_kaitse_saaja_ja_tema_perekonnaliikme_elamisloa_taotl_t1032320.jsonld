      "estleg:provisionRef": "Reg_1032320 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032320_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1032320_Par_11_v1032320",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032320_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elamisloa pikendamise taotlemisel esitab taotleja järgmised dokumendid: 1 1) taotlus; RT I 2017-01-14 1 114012017001 2017-01-17 2 2) taotleja isikut tõendav dokument; 3 3) foto. Elamisloa pikendamise taotlemisel esitab taotleja järgmised dokumendid: taotlus; taotleja isikut tõendav dokument; foto.",
      "rdfs:label": {
        "@value": "Reg_1032320_Par_11 (redaktsioon 1032320)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032320",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032320",
      "estleg:sourceAct": "Ajutise kaitse saaja ja tema perekonnaliikme elamisloa taotlemise, andmise, pikendamise ja kehtetuks tunnistamise kord ning elamisloa taotlemisel esitatavate tõendite ja andmete loetelu",
      "estleg:provisionRef": "Reg_1032320 § 11",
