    },
    {
      "@id": "estleg:Reg_1059243_Par_7_v1059243",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059243_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvide 2 ja 4–6 kohaselt esitatud teadetes nimetatud hinnangulisi kalakoguseid võrreldakse lossitava või inspekteeritava kala kogustega nõukogu määruse (EÜ) nr 1224/2009 artikli 14 lõikes 3 sätestatud kala kaalu lubatud kõikumise tingimusi kohaldades. Paragrahvide 2 ja 4–6 kohaselt esitatud teadetes nimetatud hinnangulisi kalakoguseid võrreldakse lossitava või inspekteeritava kala kogustega nõukogu määruse (EÜ) nr 1224/2009 artikli 14 lõikes 3 sätestatud kala kaalu lubatud kõikumise tingimusi kohaldades. 2 (2) Sorteerimata kujul räime ja kilu püügi korral peab §-de 4–6 kohaselt esitatud teadetes nimetatud hinnanguliste koguste ja lossitava või inspekteeritava saagi kaalu lubatud kõikumine vastama Euroopa Parlamendi ja nõukogu määruse (EL) 2016/1139 artikli 13 lõikes 1 nimetatud määrale. Sorteerimata kujul räime ja kilu püügi korral peab §-de 4–6 kohaselt esitatud teadetes nimetatud hinnanguliste koguste ja lossitava või inspekteeritava saagi kaalu lubatud kõikumine vastama Euroopa Parlamendi ja nõukogu määruse (EL) 2016/1139 artikli 13 lõikes 1 nimetatud määrale.",
      "rdfs:label": {
        "@value": "Reg_1059243_Par_7 (redaktsioon 1059243)",
        "@language": "et"
      },
