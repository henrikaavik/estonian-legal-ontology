      },
      "estleg:versionText": "Töövõimetoetust rahastatakse riigieelarvest Sotsiaalministeeriumi eelarve kaudu.",
      "rdfs:label": {
        "@value": "TOOVOI_Par_4 (redaktsioon 130122015103)",
        "@language": "et"
      },
