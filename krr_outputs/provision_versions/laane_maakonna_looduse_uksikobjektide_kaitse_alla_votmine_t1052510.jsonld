    {
      "@id": "estleg:Reg_1052510_Par_5_v1052510",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052510_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas2 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti piiranguvööndi piiri kulgemise kohta. Määruse seletuskirjas2 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti piiranguvööndi piiri kulgemise kohta.",
      "rdfs:label": {
        "@value": "Reg_1052510_Par_5 (redaktsioon 1052510)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052510",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052510",
      "estleg:sourceAct": "Lääne maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1052510 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052510_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052510_Par_6_v1052510",
      "@type": [
        "owl:NamedIndividual",
