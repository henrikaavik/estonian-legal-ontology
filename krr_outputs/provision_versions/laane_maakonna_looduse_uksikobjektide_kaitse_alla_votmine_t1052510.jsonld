    },
    {
      "@id": "estleg:Reg_1052510_Par_7_v1052510",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052510_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 16. mai 2019. a käskkirjaga nr 1-2/18/681 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 16. mai 2019. a käskkirjaga nr 1-2/18/681 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1052510_Par_7 (redaktsioon 1052510)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052510",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052510",
      "estleg:sourceAct": "Lääne maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1052510 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052510_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052510_Par_8_v1052510",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052510_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1052510_Par_8 (redaktsioon 1052510)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052510",
