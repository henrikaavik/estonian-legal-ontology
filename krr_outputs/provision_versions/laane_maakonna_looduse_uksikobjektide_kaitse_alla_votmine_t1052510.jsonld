      "estleg:sourceAct": "Lääne maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1052510 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052510_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052510_Par_3_v1052510",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052510_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitstavate looduse üksikobjektide kaitsekord on kehtestatud keskkonnaministri 1. märtsi 2023. a määrusega nr 10 „Kaitstavate looduse üksikobjektide kaitse-eeskiri”. RT I 2023-03-14 1 114032023001 2023-03-20 Kaitstavate looduse üksikobjektide kaitsekord on kehtestatud keskkonnaministri 1. märtsi 2023. a määrusega nr 10 „Kaitstavate looduse üksikobjektide kaitse-eeskiri”. 2 (2) Kaitstava looduse üksikobjekti paiknemisel kaitsealal või hoiualal tuleb tegevuste kavandamisel lähtuda ka vastavas kaitseala kaitse-eeskirjas või looduskaitseseaduses sätestatust. Kaitstava looduse üksikobjekti paiknemisel kaitsealal või hoiualal tuleb tegevuste kavandamisel lähtuda ka vastavas kaitseala kaitse-eeskirjas või looduskaitseseaduses sätestatust.",
      "rdfs:label": {
        "@value": "Reg_1052510_Par_3 (redaktsioon 1052510)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052510",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052510",
      "estleg:sourceAct": "Lääne maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1052510 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052510_Map"
      }
    },
