      "estleg:sourceAct": "Lääne maakonna looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1052510 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052510_Map"
      }
