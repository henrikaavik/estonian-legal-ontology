      },
      "estleg:versionText": "Kaitse alla võtmise eesmärk on tagada Lääne maakonnas asuvate esinduslike põlispuude ja geoloogiliste üksikobjektide säilimine. Kaitse alla võtmise eesmärk on tagada Lääne maakonnas asuvate esinduslike põlispuude ja geoloogiliste üksikobjektide säilimine.",
      "rdfs:label": {
        "@value": "Reg_1052510_Par_1 (redaktsioon 1052510)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052510",
