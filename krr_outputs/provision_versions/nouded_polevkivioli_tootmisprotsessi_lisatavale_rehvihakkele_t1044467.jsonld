    },
    {
      "@id": "estleg:Reg_1044467_Par_1_v1044467",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044467_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse nõuded põlevkiviõli tootmisprotsessi lisatavale rehvihakkele ja kasutamisele viisil, mille tulemusena lakkab rehvihake olemast jääde. Määrusega kehtestatakse nõuded põlevkiviõli tootmisprotsessi lisatavale rehvihakkele ja kasutamisele viisil, mille tulemusena lakkab rehvihake olemast jääde. 2 (2) Rehvihaket võib tootena turule lasta ja lisada põlevkiviõli tootmisprotsessi tööstusheite seaduse 4. peatükki kohaldamata, kui rehvihake ja selle tootmine vastavad käesoleva määruse nõuetele. Rehvihaket võib tootena turule lasta ja lisada põlevkiviõli tootmisprotsessi tööstusheite seaduse 4. peatükki kohaldamata, kui rehvihake ja selle tootmine vastavad käesoleva määruse nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1044467_Par_1 (redaktsioon 1044467)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044467",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044467",
      "estleg:sourceAct": "Nõuded põlevkiviõli tootmisprotsessi lisatavale rehvihakkele",
      "estleg:provisionRef": "Reg_1044467 § 1",
      "estleg:partOfAct": {
