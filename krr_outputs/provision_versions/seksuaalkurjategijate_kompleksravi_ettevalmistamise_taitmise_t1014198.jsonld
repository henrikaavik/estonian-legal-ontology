    },
    {
      "@id": "estleg:Reg_1014198_Par_8_v1014198",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014198_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Esimesel kohtumisel peab kriminaalhooldusametnik: 1 1) veenduma, et kriminaalhooldusalune on jätkuvalt nõus seksuaalkurjategijate kompleksravile alluma; 2 2) selgitama kriminaalhooldusalusele kompleksravi eesmärki ja tingimusi; 3 3) vajadusel tutvustama kriminaalhooldusalusele kompleksravi kohaldajat ja sealseid tingimusi; RT I 2024-05-10 3 110052024003 2024-05-13 4 4) selgitama, kes ja kuidas peab kompleksravile allumise arvestust; 5 5) teavitama, kuidas kontakteeruda kompleksravi kohaldaja ja kriminaalhooldajaga; 6 6) selgitama kriminaalhooldusalusele tema õigusi ja kohustusi kompleksravile allumisel; RT I 2024-05-10 3 110052024003 2024-05-13 7 7) selgitama kompleksravile allumist takistavatest asjaoludest teavitamise korda; 8 8) tegema kriminaalhooldusalusele teatavaks kompleksravile allumise kohustuste täitmata jätmise tagajärjed; 9 9) selgitama kriminaalhooldusalusele kontrollnõuete ja talle pandud kohustuste sisu; 10 10) tegema kriminaalhooldusalusele teatavaks kontrollnõuete ja kohustuste täitmata jätmise tagajärjed. Esimesel kohtumisel peab kriminaalhooldusametnik: veenduma, et kriminaalhooldusalune on jätkuvalt nõus seksuaalkurjategijate kompleksravile alluma; selgitama kriminaalhooldusalusele kompleksravi eesmärki ja tingimusi; vajadusel tutvustama kriminaalhooldusalusele kompleksravi kohaldajat ja sealseid tingimusi; selgitama, kes ja kuidas peab kompleksravile allumise arvestust; teavitama, kuidas kontakteeruda kompleksravi kohaldaja ja kriminaalhooldajaga; selgitama kriminaalhooldusalusele tema õigusi ja kohustusi kompleksravile allumisel; selgitama kompleksravile allumist takistavatest asjaoludest teavitamise korda; tegema kriminaalhooldusalusele teatavaks kompleksravile allumise kohustuste täitmata jätmise tagajärjed; selgitama kriminaalhooldusalusele kontrollnõuete ja talle pandud kohustuste sisu; tegema kriminaalhooldusalusele teatavaks kontrollnõuete ja kohustuste täitmata jätmise tagajärjed.",
      "rdfs:label": {
        "@value": "Reg_1014198_Par_8 (redaktsioon 1014198)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014198",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014198",
      "estleg:sourceAct": "Seksuaalkurjategijate kompleksravi ettevalmistamise, täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1014198 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014198_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014198_Par_9_v1014198",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014198_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalhooldusalune teeb pärast seksuaalkurjategijate kompleksravi kohaldajaga kompleksravi esmase vastuvõtu koha ja aja kokkuleppimist need viivitamata teatavaks kriminaalhooldusametnikule. RT I 2024-05-10 3 110052024003 2024-05-13 Kriminaalhooldusalune teeb pärast seksuaalkurjategijate kompleksravi kohaldajaga kompleksravi esmase vastuvõtu koha ja aja kokkuleppimist need viivitamata teatavaks kriminaalhooldusametnikule.",
      "rdfs:label": {
        "@value": "Reg_1014198_Par_9 (redaktsioon 1014198)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014198",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014198",
      "estleg:sourceAct": "Seksuaalkurjategijate kompleksravi ettevalmistamise, täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1014198 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014198_Map_2026"
      }
    },
