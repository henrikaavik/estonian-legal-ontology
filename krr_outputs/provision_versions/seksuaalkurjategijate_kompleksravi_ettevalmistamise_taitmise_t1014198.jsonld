        "@id": "estleg:Reg_1014198_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seksuaalkurjategijate kompleksravi kohaldaja valib kriminaalhooldusametnik. Kompleksravi koht valitakse, arvestades võimaluse korral kompleksravi kohaldaja asukoha paiknemist kriminaalhooldusaluse elukoha suhtes. Seksuaalkurjategijate kompleksravi kohaldaja valib kriminaalhooldusametnik. Kompleksravi koht valitakse, arvestades võimaluse korral kompleksravi kohaldaja asukoha paiknemist kriminaalhooldusaluse elukoha suhtes.",
      "rdfs:label": {
        "@value": "Reg_1014198_Par_5 (redaktsioon 1014198)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014198",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014198",
      "estleg:sourceAct": "Seksuaalkurjategijate kompleksravi ettevalmistamise, täitmise ja järelevalve kord",
      "estleg:provisionRef": "Reg_1014198 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014198_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1014198_Par_6_v1014198",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014198_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2024-05-10 3 110052024003 2024-05-13 Kehtetu - 2 (2) Kehtetu - RT I 2024-05-10 3 110052024003 2024-05-13 Kehtetu - 3 (3) Seksuaalkurjategijate kompleksravi kohaldaja võib pöörduda ekspertiisiakti koostanud kohtupsühhiaatriaeksperdi poole ja saada ekspertiisiaktist koopia. Seksuaalkurjategijate kompleksravi kohaldaja võib pöörduda ekspertiisiakti koostanud kohtupsühhiaatriaeksperdi poole ja saada ekspertiisiaktist koopia.",
      "rdfs:label": {
        "@value": "Reg_1014198_Par_6 (redaktsioon 1014198)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014198",
