      }
    },
    {
      "@id": "estleg:Reg_1012496_Par_4_v1012496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012496_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Amet asub Tallinnas. RT I 2018-10-19 1 119102018001 2018-10-22 Amet asub Tallinnas. 2 (2) Ameti mujal asuva struktuuriüksuse asukoht ja postiaadress tuuakse ära struktuuriüksuse põhimääruses. Ameti mujal asuva struktuuriüksuse asukoht ja postiaadress tuuakse ära struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1012496_Par_4 (redaktsioon 1012496)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012496",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012496",
      "estleg:sourceAct": "Kaitseressursside Ameti põhimäärus",
      "estleg:provisionRef": "Reg_1012496 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012496_Map"
      }
    },
    {
      "@id": "estleg:Reg_1012496_Par_5_v1012496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012496_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ingliskeelne nimetus on Defence Resources Agency. Ameti ingliskeelne nimetus on Defence Resources Agency.",
      "rdfs:label": {
        "@value": "Reg_1012496_Par_5 (redaktsioon 1012496)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012496",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012496",
      "estleg:sourceAct": "Kaitseressursside Ameti põhimäärus",
      "estleg:provisionRef": "Reg_1012496 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012496_Map"
      }
    },
    {
      "@id": "estleg:Reg_1012496_Par_6_v1012496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012496_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti tegevusvaldkonnad on riigikaitselise inimvara planeerimine, kaitseväekohustuse täitmise toetamine ning kaitseväeteenistuse ja Kaitseministeeriumi valitsemisala asutustes personalialase tegevuse korraldamine. RT I 2022-12-17 16 117122022016 2023-01-01 Ameti tegevusvaldkonnad on riigikaitselise inimvara planeerimine, kaitseväekohustuse täitmise toetamine ning kaitseväeteenistuse ja Kaitseministeeriumi valitsemisala asutustes personalialase tegevuse korraldamine.",
      "rdfs:label": {
        "@value": "Reg_1012496_Par_6 (redaktsioon 1012496)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012496",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012496",
      "estleg:sourceAct": "Kaitseressursside Ameti põhimäärus",
      "estleg:provisionRef": "Reg_1012496 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012496_Map"
      }
    },
    {
      "@id": "estleg:Reg_1012496_Par_7_v1012496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012496_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ülesanded on: 1 1) riigikaitse eesmärkide saavutamiseks inimvaraga seotud vajaduste analüüsimine ja personali planeerimine; 2 2) kaitseväeteenistuse ning kaitseväekohustuse täitmise toetamise korraldamine ja analüüsimine; 3 3) kaitseväekohustuslike Eesti kodanike üle arvestuse pidamine ja kaitseväekohustuslaste registri volitatud töötleja ülesannete täitmine; 4 4) riikliku järelevalve teostamine kaitseväekohustuse täitmise üle, väärteomenetluse läbiviimine ning kaitseväekohustuslasele riikliku sunni kohaldamine seaduses sätestatud alustel ja korras; 5 5) personalipoliitika väljatöötamine ja elluviimine ning tervikliku personaliteenuse osutamine Kaitseministeeriumi valitsemisala asutustele ja kokkuleppel teistele asutustele; 6 6) Kaitseväe, Kaitseministeeriumi ja Riigi Kaitseinvesteeringute Keskuse ametnikele ja töötajatele riigisaladusele juurdepääsu lubade ning salastatud välisteabele juurdepääsu võimaldavate sertifikaatide taotlemise korraldamine; RT I 2023-03-29 24 129032023024 2023-04-01 7 7) riigikaitses osalemise populariseerimine ja kaitseväekohustuse võtmise korraldamine; 8 8) riigikaitseõpetusega seotud tegevuste koordineerimine; 9 9) Kaitseministeeriumi valitsemisalas terviseseisundi hindamise ja teenistusalaste tagatistega seotud tegevuste koordineerimine; 9 9¹) terviseseisundi hindamisega seotud vaiete menetlemiseks vajalike toimingute koordineerimine; RT I 2023-03-29 24 129032023024 2023-04-01 10 10) kutsealuse, reservis oleva isiku, asendusteenistuja ja kaitseväekohustust võtta sooviva isiku terviseseisundi hindamise korraldamine; 11 11) elutähtsa teenuse osutamise toimepidevuse riskianalüüside kooskõlastamine; 12 12) ettepanekute tegemine ameti tegevusvaldkonda reguleerivate õigusaktide väljatöötamiseks või muutmiseks, arvamuse andmine ameti tegevusvaldkonda puudutavate õigusaktide eelnõude kohta ning osalemine nende väljatöötamisel; 13 13) ameti ülesannete täitmisega seotud andmete ja tõendite kogumine ning töötlemine; 14 14) ameti tegevusvaldkonnaga seotud koostöö arendamine ja teavitustegevuse korraldamine; 15 15) muude seadusega või seaduse alusel ametile pandud ülesannete täitmine. RT I 2022-12-17 16 117122022016 2023-01-01 Ameti ülesanded on: riigikaitse eesmärkide saavutamiseks inimvaraga seotud vajaduste analüüsimine ja personali planeerimine; kaitseväeteenistuse ning kaitseväekohustuse täitmise toetamise korraldamine ja analüüsimine; kaitseväekohustuslike Eesti kodanike üle arvestuse pidamine ja kaitseväekohustuslaste registri volitatud töötleja ülesannete täitmine; riikliku järelevalve teostamine kaitseväekohustuse täitmise üle, väärteomenetluse läbiviimine ning kaitseväekohustuslasele riikliku sunni kohaldamine seaduses sätestatud alustel ja korras; personalipoliitika väljatöötamine ja elluviimine ning tervikliku personaliteenuse osutamine Kaitseministeeriumi valitsemisala asutustele ja kokkuleppel teistele asutustele; Kaitseväe, Kaitseministeeriumi ja Riigi Kaitseinvesteeringute Keskuse ametnikele ja töötajatele riigisaladusele juurdepääsu lubade ning salastatud välisteabele juurdepääsu võimaldavate sertifikaatide taotlemise korraldamine; riigikaitses osalemise populariseerimine ja kaitseväekohustuse võtmise korraldamine; riigikaitseõpetusega seotud tegevuste koordineerimine; Kaitseministeeriumi valitsemisalas terviseseisundi hindamise ja teenistusalaste tagatistega seotud tegevuste koordineerimine; terviseseisundi hindamisega seotud vaiete menetlemiseks vajalike toimingute koordineerimine; kutsealuse, reservis oleva isiku, asendusteenistuja ja kaitseväekohustust võtta sooviva isiku terviseseisundi hindamise korraldamine; elutähtsa teenuse osutamise toimepidevuse riskianalüüside kooskõlastamine; ettepanekute tegemine ameti tegevusvaldkonda reguleerivate õigusaktide väljatöötamiseks või muutmiseks, arvamuse andmine ameti tegevusvaldkonda puudutavate õigusaktide eelnõude kohta ning osalemine nende väljatöötamisel; ameti ülesannete täitmisega seotud andmete ja tõendite kogumine ning töötlemine; ameti tegevusvaldkonnaga seotud koostöö arendamine ja teavitustegevuse korraldamine; muude seadusega või seaduse alusel ametile pandud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "Reg_1012496_Par_7 (redaktsioon 1012496)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012496",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012496",
      "estleg:sourceAct": "Kaitseressursside Ameti põhimäärus",
      "estleg:provisionRef": "Reg_1012496 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012496_Map"
      }
    },
    {
      "@id": "estleg:Reg_1012496_Par_8_v1012496",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012496_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ameti struktuuriüksuseks on osakond. Ameti struktuuriüksuseks on osakond. 2 (2) Ameti osakonnad ja nende põhiülesanded on järgmised: 1 1) analüüsi- ja planeerimisosakond, mille põhiülesanne on analüüsida riigikaitselise inimvaraga seotud vajadusi ning planeerida personali; 2 2) karjääriosakond, mille põhiülesanne on arendada ja ellu rakendada karjäärisüsteemi Kaitseministeeriumi valitsemisalas ning korraldada teenistus- ja töösuhteid; 3 3) strateegilise personalijuhtimise osakond, mille põhiülesanne on töötada välja ja viia ellu personalipoliitikat Kaitseministeeriumi valitsemisalas; 4 4) värbamisosakond, mille põhiülesanne on korraldada Kaitseministeeriumi valitsemisalas personali värbamist, aja- ja asendusteenistusse kutsumist ning ameti tegevusvaldkonnaga seotud kommunikatsiooni- ja turundustegevusi; 5 5) üldosakond, mille põhiülesanne on toetada ameti juhtkonda ja osakondi nende ülesannete täitmisel. RT I 2024-05-10 17 110052024017 2024-05-13 Ameti osakonnad ja nende põhiülesanded on järgmised: analüüsi- ja planeerimisosakond, mille põhiülesanne on analüüsida riigikaitselise inimvaraga seotud vajadusi ning planeerida personali; karjääriosakond, mille põhiülesanne on arendada ja ellu rakendada karjäärisüsteemi Kaitseministeeriumi valitsemisalas ning korraldada teenistus- ja töösuhteid; strateegilise personalijuhtimise osakond, mille põhiülesanne on töötada välja ja viia ellu personalipoliitikat Kaitseministeeriumi valitsemisalas; värbamisosakond, mille põhiülesanne on korraldada Kaitseministeeriumi valitsemisalas personali värbamist, aja- ja asendusteenistusse kutsumist ning ameti tegevusvaldkonnaga seotud kommunikatsiooni- ja turundustegevusi; üldosakond, mille põhiülesanne on toetada ameti juhtkonda ja osakondi nende ülesannete täitmisel. 3 (3) Osakondadel võivad olla allstruktuuriüksused, kui need on ameti peadirektori (edaspidi peadirektor) poolt kinnitatud osakonna põhimääruses ette nähtud. Osakondadel võivad olla allstruktuuriüksused, kui need on ameti peadirektori (edaspidi peadirektor) poolt kinnitatud osakonna põhimääruses ette nähtud. 4 (4) Osakonna ülesanded ja pädevus täpsustatakse peadirektori kinnitatavas osakonna põhimääruses. Kui osakonna koosseisus on allstruktuuriüksus, kehtestatakse selle ülesanded ja pädevus osakonna põhimääruses. Osakonna ülesanded ja pädevus täpsustatakse peadirektori kinnitatavas osakonna põhimääruses. Kui osakonna koosseisus on allstruktuuriüksus, kehtestatakse selle ülesanded ja pädevus osakonna põhimääruses. 5 (5) Ameti teenistuskohtade koosseisu kehtestab valdkonna eest vastutav minister või tema volitusel ameti peadirektor. RT I 2020-11-11 1 111112020001 2021-01-01 Ameti teenistuskohtade koosseisu kehtestab valdkonna eest vastutav minister või tema volitusel ameti peadirektor.",
