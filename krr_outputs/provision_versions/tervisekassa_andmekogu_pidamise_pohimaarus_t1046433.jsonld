      },
      "estleg:versionText": "Vastutav töötleja tagab infotehnoloogiliste vahenditega andmekogus tehtud logid andmete töötlemise kohta. Vastutav töötleja tagab infotehnoloogiliste vahenditega andmekogus tehtud logid andmete töötlemise kohta.",
      "rdfs:label": {
        "@value": "Reg_1046433_Par_10 (redaktsioon 1046433)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046433",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046433",
      "estleg:sourceAct": "Tervisekassa andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1046433 § 10",
