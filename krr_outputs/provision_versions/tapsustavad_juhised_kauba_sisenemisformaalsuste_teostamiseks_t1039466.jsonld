    {
      "@id": "estleg:Reg_1039466_Par_15_18_v1039466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039466_Par_15_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kauba toimetamisel teisest liidu liikmesriigist õhutranspordivahendiga Eestisse kohaldatakse käesoleva määruse 2. peatüki 1. jaotise 2. jao sätteid. Kuni 4. maini 2025. a võib 2. peatüki 1. jaotise 2. jao sätete asemel kohaldada 2. peatüki 1. jaotise 1. jao sätteid. Kauba toimetamisel teisest liidu liikmesriigist õhutranspordivahendiga Eestisse kohaldatakse käesoleva määruse 2. peatüki 1. jaotise 2. jao sätteid. Kuni 4. maini 2025. a võib 2. peatüki 1. jaotise 2. jao sätete asemel kohaldada 2. peatüki 1. jaotise 1. jao sätteid. 2 (2) Kui kauba toimetamisel teisest liidu liikmesriigist meretranspordivahendiga Eestisse ei esitata tollile andmeid meresõiduohutuse seaduse §-s 751 nimetatud elektroonilise mereinfosüsteemi kaudu, kohaldatakse käesoleva määruse 2. peatüki 1. jaotise 2. jao sätteid. Kuni 4. maini 2025. a võib 2. peatüki 1. jaotise 2. jao sätete asemel kohaldada 2. peatüki 1. jaotise 1. jao sätteid. RT I 2024-11-05 1 105112024001 2024-11-08 Kui kauba toimetamisel teisest liidu liikmesriigist meretranspordivahendiga Eestisse ei esitata tollile andmeid meresõiduohutuse seaduse §-s 751 nimetatud elektroonilise mereinfosüsteemi kaudu, kohaldatakse käesoleva määruse 2. peatüki 1. jaotise 2. jao sätteid. Kuni 4. maini 2025. a võib 2. peatüki 1. jaotise 2. jao sätete asemel kohaldada 2. peatüki 1. jaotise 1. jao sätteid.",
      "rdfs:label": {
        "@value": "Reg_1039466_Par_15_18 (redaktsioon 1039466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039466",
      "estleg:sourceAct": "Täpsustavad juhised kauba sisenemisformaalsuste teostamiseks",
      "estleg:provisionRef": "Reg_1039466 § 15_18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039466_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039466_Par_16_v1039466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039466_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust rakendatakse tagasiulatuvalt alates 2017. aasta 1. juulist. Määrust rakendatakse tagasiulatuvalt alates 2017. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "Reg_1039466_Par_16 (redaktsioon 1039466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039466",
      "estleg:sourceAct": "Täpsustavad juhised kauba sisenemisformaalsuste teostamiseks",
      "estleg:provisionRef": "Reg_1039466 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039466_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039466_Par_2_v1039466",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039466_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolevas määruses sätestatud sisenemisformaalsustega seotud andmed esitatakse selle sadama või lennujaama piirkonnas asuvale tolliasutusele, mille kaudu toimetatakse kaup Eestisse. Teabevahetus isiku ja tolli vahel toimub tolli elektroonilises andmetöötlussüsteemis. RT I 2024-11-05 1 105112024001 2024-11-08 Käesolevas määruses sätestatud sisenemisformaalsustega seotud andmed esitatakse selle sadama või lennujaama piirkonnas asuvale tolliasutusele, mille kaudu toimetatakse kaup Eestisse. Teabevahetus isiku ja tolli vahel toimub tolli elektroonilises andmetöötlussüsteemis. 2 (2) Meretranspordi puhul võib sisenemisformaalsuste teostamisel kauba ja transpordivahendiga seotud andmed esitada tollile meresõiduohutuse seaduse §-s 751 nimetatud elektroonilise mereinfosüsteemi kaudu. RT I 2024-11-05 1 105112024001 2024-11-08 Meretranspordi puhul võib sisenemisformaalsuste teostamisel kauba ja transpordivahendiga seotud andmed esitada tollile meresõiduohutuse seaduse §-s 751 nimetatud elektroonilise mereinfosüsteemi kaudu. 3 (3) Andmed mere- ja õhutranspordivahendiga veetava kauba kohta võib esitada inglise keeles. Andmed mere- ja õhutranspordivahendiga veetava kauba kohta võib esitada inglise keeles.",
      "rdfs:label": {
        "@value": "Reg_1039466_Par_2 (redaktsioon 1039466)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039466",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039466",
      "estleg:sourceAct": "Täpsustavad juhised kauba sisenemisformaalsuste teostamiseks",
      "estleg:provisionRef": "Reg_1039466 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039466_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039466_Par_3_v1039466",
      "@type": [
