      "estleg:sourceAct": "Vardi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313093 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313093_Map"
      }
    },
    {
      "@id": "estleg:Reg_313093_Par_2_v313093",
