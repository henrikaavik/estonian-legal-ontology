      }
    },
    {
      "@id": "estleg:Reg_313093_Par_13_v313093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313093_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on lubatud: 1 1) kaitse-eeskirjaga kooskõlas olev majandustegevus; 2 2) väetiste kasutamine; 3 3) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas on lubatud üksnes kaitseala valitseja nõusolekul. RT I 2009 7 48 13125268 2009-02-01+02:00 Piiranguvööndis on lubatud: kaitse-eeskirjaga kooskõlas olev majandustegevus; väetiste kasutamine; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas on lubatud üksnes kaitseala valitseja nõusolekul.",
      "rdfs:label": {
        "@value": "Reg_313093_Par_13 (redaktsioon 313093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313093",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313093",
      "estleg:sourceAct": "Vardi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313093 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313093_Map"
      }
    },
    {
      "@id": "estleg:Reg_313093_Par_14_v313093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313093_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) veekogude veetaseme ja kaldajoone muutmine; 2 2) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 3 3) puidu kokku- ja väljavedu külmumata pinnasel. Kui pinnas seda võimaldab, võib kaitseala valitseja lubada puidu kokku- ja väljavedu külmumata pinnasel kuiva ilmaga; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine; 5 5) maavara kaevandamine; 6 6) biotsiidi ja taimekaitsevahendi kasutamine; 7 7) uue maaparandussüsteemi rajamine. Piiranguvööndis on keelatud: veekogude veetaseme ja kaldajoone muutmine; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel. Kui pinnas seda võimaldab, võib kaitseala valitseja lubada puidu kokku- ja väljavedu külmumata pinnasel kuiva ilmaga; puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; biotsiidi ja taimekaitsevahendi kasutamine; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_313093_Par_14 (redaktsioon 313093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313093",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313093",
      "estleg:sourceAct": "Vardi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313093 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_313093_Map"
      }
    },
    {
      "@id": "estleg:Reg_313093_Par_15_v313093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313093_Par_15"
