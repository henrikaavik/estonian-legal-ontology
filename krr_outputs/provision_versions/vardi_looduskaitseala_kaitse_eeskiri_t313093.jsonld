    },
    {
      "@id": "estleg:Reg_313093_Par_12_v313093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313093_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse, ökoloogilise stabiilsuse ja maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse, ökoloogilise stabiilsuse ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_313093_Par_12 (redaktsioon 313093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313093",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313093",
      "estleg:sourceAct": "Vardi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_313093 § 12",
      "estleg:partOfAct": {
