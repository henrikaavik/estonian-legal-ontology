      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PatVS_Par_11 (redaktsioon 101032023013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101032023013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/101032023013",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 11",
