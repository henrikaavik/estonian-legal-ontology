      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kojal on Eesti riigivapi kujutisega pitsat. Eesti riigivapi kujutisega pitserit kasutatakse riigivapi seadusega kehtestatud korras.",
      "rdfs:label": {
        "@value": "PatVS_Par_20_9 (redaktsioon 131052018031)",
        "@language": "et"
      },
