      }
    },
    {
      "@id": "estleg:PatVS_Par_11_v131052018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 10 nimetatud kahju hüvitamise tagamiseks on patendivolinik või patendivoliniku äriühing kohustatud sõlmima lepingu patendivoliniku vastutuse kindlustamiseks. (1¹) Kindlustusjuhtum on patendivoliniku äriühingu või patendivoliniku poolt õigusteenuse osutamisega seoses otsese varalise kahju tekitamine sõltumata õigusteenuse osutamise kohast. Kutsekohustuse tahtlikust rikkumisest tekkivat vastutust kindlustama ei pea. (2) Kindlustussumma alammäär on 63 910 eurot. (3) Kindlustusandjal on tagasinõudeõigus füüsilisest isikust ettevõtjana tegutseva patendivoliniku ja patendivoliniku äriühingu või patendivoliniku vastu, kui kindlustushüvitis on välja makstud patendivoliniku tahtliku teo tagajärjel tekkinud kahju hüvitamiseks.",
      "rdfs:label": {
        "@value": "PatVS_Par_11 (redaktsioon 131052018031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018031",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_11_v101032023013"
      },
      "estleg:versionValidTo": {
        "@value": "2023-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052018031",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
