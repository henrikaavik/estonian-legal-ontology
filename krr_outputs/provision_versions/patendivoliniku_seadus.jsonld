      }
    },
    {
      "@id": "estleg:PatVS_Par_12_v22477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patendivolinikul ja patendivoliniku äriühingul on keelatud ennast ja oma tegevust reklaamida. (2) Reklaamiks käesoleva seaduse tähenduses ei loeta teavet patendivoliniku ja patendivoliniku äriühingu nime, kutsetegevuse valdkondade, kontaktandmete ega patendivoliniku äriühingu töötajate kohta. (3) Teave kõikide patendivolinike ja patendivoliniku äriühingute nimede, tegevusvaldkondade ning kontaktandmete kohta avaldab Patendiamet oma ametlikus väljaandes ja registri Interneti-lehel.",
      "rdfs:label": {
        "@value": "PatVS_Par_12 (redaktsioon 22477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22477",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_12_v12992025"
      },
      "estleg:versionValidTo": {
        "@value": "2008-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22477",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_12_v12992025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teabe kõikide patendivolinike ja patendivoliniku äriühingute nimede, tegevusvaldkondade ning kontaktandmete kohta avaldab Patendiamet oma ametlikus väljaandes ja veebilehel.",
      "rdfs:label": {
        "@value": "PatVS_Par_12 (redaktsioon 12992025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12992025",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12992025",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_13_v22477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet patendivoliniku kutsetegevuse üle teostab majandusminister või tema volitatud ametnik. (2) Patendivolinik, kelle kutsetegevuse üle riiklikku järelevalvet teostatakse, on majandusministri või tema volitatud ametniku nõudel kohustatud: ilmuma Majandusministeeriumi; esitama majandusministrile või tema volitatud ametnikule patendivoliniku kutsetegevusega, samuti sellega seonduva patendivoliniku äriühingu asjaajamisega seotud dokumendid; andma selgitusi patendivoliniku kutsetegevuse kohta. (3) Majandusminister või tema volitatud ametnik võib: teha patendivolinikule hoiatuse ja nõuda, et patendivolinik kõrvaldaks kutsetegevuses ilmnenud puudused majandusministri või tema volitatud ametniku määratud tähtaja jooksul; peatada patendivoliniku kutsetegevuse käesoleva seaduse §-s 19 sätestatud juhtudel; teha patendivoliniku kutse äravõtmise otsuse käesoleva seaduse §-s 20 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PatVS_Par_13 (redaktsioon 22477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22477",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_13_v695911"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22477",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_13_v695911",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet patendivoliniku kutsetegevuse üle teostab majandus- ja kommunikatsiooniminister või tema volitatud ametnik. (2) Patendivolinik, kelle kutsetegevuse üle riiklikku järelevalvet teostatakse, on majandus- ja kommunikatsiooniministri või tema volitatud ametniku nõudel kohustatud: ilmuma Majandus- ja Kommunikatsiooniministeeriumi; esitama majandus- ja kommunikatsiooniministrile või tema volitatud ametnikule patendivoliniku kutsetegevusega, samuti sellega seonduva patendivoliniku äriühingu asjaajamisega seotud dokumendid; andma selgitusi patendivoliniku kutsetegevuse kohta. (3) Majandus- ja kommunikatsiooniminister või tema volitatud ametnik võib: teha patendivolinikule hoiatuse ja nõuda, et patendivolinik kõrvaldaks kutsetegevuses ilmnenud puudused majandus- ja kommunikatsiooniministri või tema volitatud ametniku määratud tähtaja jooksul; peatada patendivoliniku kutsetegevuse käesoleva seaduse §-s 19 sätestatud juhtudel; teha patendivoliniku kutse äravõtmise otsuse käesoleva seaduse §-s 20 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PatVS_Par_13 (redaktsioon 695911)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695911",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_13_v128122011014"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/695911",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 13",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_13_v128122011014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riiklikku järelevalvet patendivoliniku kutsetegevuse üle teostab justiitsminister või tema volitatud ametnik. (2) Patendivolinik, kelle kutsetegevuse üle riiklikku järelevalvet teostatakse, on justiitsministri või tema volitatud ametniku nõudel kohustatud: ilmuma Justiitsministeeriumi; esitama justiitsministrile või tema volitatud ametnikule patendivoliniku kutsetegevusega, samuti sellega seonduva patendivoliniku äriühingu asjaajamisega seotud dokumendid; andma selgitusi patendivoliniku kutsetegevuse kohta. (3) Justiitsminister või tema volitatud ametnik võib: teha patendivolinikule hoiatuse ja nõuda, et patendivolinik kõrvaldaks kutsetegevuses ilmnenud puudused justiitsministri või tema volitatud ametniku määratud tähtaja jooksul; peatada patendivoliniku kutsetegevuse käesoleva seaduse §-s 19 sätestatud juhtudel; teha patendivoliniku kutse äravõtmise otsuse käesoleva seaduse §-s 20 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PatVS_Par_13 (redaktsioon 128122011014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011014",
      "estleg:supersededByVersion": {
