    },
    {
      "@id": "estleg:PatVS_Par_13_2_v115032014026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_13_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdkonna eest vastutav minister või tema volitatud ametnik võib: teha patendivolinikule hoiatuse ja nõuda, et patendivolinik kõrvaldaks kutsetegevuses ilmnenud puudused valdkonna eest vastutava ministri või tema volitatud ametniku määratud tähtaja jooksul; peatada patendivoliniku kutsetegevuse käesoleva seaduse §-s 19 sätestatud juhtudel; teha patendivoliniku kutse äravõtmise otsuse käesoleva seaduse §-s 20 sätestatud juhtudel.",
      "rdfs:label": {
        "@value": "PatVS_Par_13_2 (redaktsioon 115032014026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014026",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_13_2_v131052018031"
      },
      "estleg:versionValidTo": {
        "@value": "2018-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014026",
