      }
    },
    {
      "@id": "estleg:PatVS_Par_3_v22477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui seadusega on ette nähtud, et patendivolinik võib esitada volikirja pärast toimingu tegemist, loetakse volituse andmise päevaks toimingu tegemise päev, sõltumata volikirja allakirjutamise päevast. (2) Volitus lõpeb: kui patendivolinik loobub isiku esindamisest käesoleva seaduse § 5 lõikes 4 nimetatud juhtudel; kui patendivoliniku kohta tehtud registreeringu andmed kustutatakse riiklikust patendivolinike registrist (edaspidi register ); patendivoliniku kutsetegevuse peatamise korral; muudel seadusega ettenähtud juhtudel. (3) Käesoleva paragrahvi lõikes 2 nimetatud juhtudel peab patendivolinik teda volitanud isikut juhtunust viivitamata teavitama. (4) Patendivoliniku surma või tema teovõimetuks tunnistamise või teovõime piiramise korral peab patendivoliniku pärija või eestkostja, samuti patendivoliniku äriühing viivitamata teavitama juhtunust majandusministrit või tema volitatud ametnikku.",
      "rdfs:label": {
        "@value": "PatVS_Par_3 (redaktsioon 22477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22477",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_3_v178626"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22477",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
