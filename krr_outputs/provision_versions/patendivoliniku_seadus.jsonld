      }
    },
    {
      "@id": "estleg:PatVS_Par_20_6_v131052018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_20_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koja majandusaasta on kalendriaasta.",
      "rdfs:label": {
        "@value": "PatVS_Par_20_6 (redaktsioon 131052018031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052018031",
