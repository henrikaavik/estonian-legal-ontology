      "estleg:provisionRef": "PatVS § 20_3",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_20_4_v131052018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
