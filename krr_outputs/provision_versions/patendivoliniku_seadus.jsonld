    {
      "@id": "estleg:PatVS_Par_20_5_v131052018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_20_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koja eelarveaasta on kalendriaasta. Koja eelarve kinnitab juhatus hiljemalt eelarveaastale eelneva aasta detsembris.",
      "rdfs:label": {
        "@value": "PatVS_Par_20_5 (redaktsioon 131052018031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018031",
