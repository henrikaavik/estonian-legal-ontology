        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab patendivoliniku tegevuse õiguslikud alused.",
      "rdfs:label": {
        "@value": "PatVS_Par_1 (redaktsioon 22477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22477",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22477",
