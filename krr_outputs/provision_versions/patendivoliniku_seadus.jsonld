      }
    },
    {
      "@id": "estleg:PatVS_Par_20_7_v131052018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_20_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koja liikmemaksu miinimummäära kehtestab koja koosolek. (2) Patendivoliniku liikmemaksu suuruse ja selle arvestamise alused kehtestab koja juhatus, arvestades liikmemaksu miinimummäära. Liikmemaks tuleb kehtestada suuruses, mis tagab koja piisava rahastatuse õigusaktidega seatud eesmärkide saavutamiseks ning ülesannete täitmiseks. (3) Põhjendatud taotluse alusel võib koja juhatus vabastada patendivoliniku liikmemaksu tasumise kohustusest või vähendada liikmemaksu suurust. Liikmemaksu tasumisest võib vabastada või seda vähendada kuni kolmeks aastaks.",
      "rdfs:label": {
        "@value": "PatVS_Par_20_7 (redaktsioon 131052018031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052018031",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 20_7",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_20_8_v131052018031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_20_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koja koosolek kehtestab hea kutsetava, mis on patendivolinikele kohustuslik.",
      "rdfs:label": {
        "@value": "PatVS_Par_20_8 (redaktsioon 131052018031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052018031",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131052018031",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 20_8",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_20_9_v131052018031",
