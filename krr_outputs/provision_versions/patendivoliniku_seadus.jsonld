      }
    },
    {
      "@id": "estleg:PatVS_Par_10_v22477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õigusteenuse osutamise korral vastutab patendivolinik süüliselt tekitatud varalise kahju eest. (2) Kui patendivolinik osutab õigusteenust patendivoliniku äriühingu kaudu, vastutavad patendivolinik ja äriühing käesoleva paragrahvi lõikes 1 nimetatud kahju eest solidaarselt.",
      "rdfs:label": {
        "@value": "PatVS_Par_10 (redaktsioon 22477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22477",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22477",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_11_v22477",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 10 nimetatud kahju hüvitamise tagamiseks on patendivolinik või patendivoliniku äriühing kohustatud sõlmima lepingu patendivoliniku vastutuse kindlustamiseks. (2) Kindlustussumma alammäär on üks miljon krooni. (3) Kindlustusandjal on tagasinõudeõigus füüsilisest isikust ettevõtjana tegutseva patendivoliniku ja patendivoliniku äriühingu või patendivoliniku vastu, kui kindlustushüvitis on välja makstud patendivoliniku tahtliku teo tagajärjel tekkinud kahju hüvitamiseks.",
      "rdfs:label": {
        "@value": "PatVS_Par_11 (redaktsioon 22477)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22477",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatVS_Par_11_v13317103"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22477",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:PatVS_Map_2026"
      }
    },
    {
      "@id": "estleg:PatVS_Par_11_v13317103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 10 nimetatud kahju hüvitamise tagamiseks on patendivolinik või patendivoliniku äriühing kohustatud sõlmima lepingu patendivoliniku vastutuse kindlustamiseks. (2) Kindlustussumma alammäär on 63 910 eurot. (3) Kindlustusandjal on tagasinõudeõigus füüsilisest isikust ettevõtjana tegutseva patendivoliniku ja patendivoliniku äriühingu või patendivoliniku vastu, kui kindlustushüvitis on välja makstud patendivoliniku tahtliku teo tagajärjel tekkinud kahju hüvitamiseks.",
      "rdfs:label": {
        "@value": "PatVS_Par_11 (redaktsioon 13317103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13317103",
