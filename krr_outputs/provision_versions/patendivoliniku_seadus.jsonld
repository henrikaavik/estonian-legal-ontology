    {
      "@id": "estleg:PatVS_Par_26_v12766639",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatVS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud toimingute sooritamise eest tasutakse riigilõiv riigilõivuseaduses sätestatud määra järgi.",
      "rdfs:label": {
        "@value": "PatVS_Par_26 (redaktsioon 12766639)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12766639",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12766639",
      "estleg:sourceAct": "Patendivoliniku seadus",
      "estleg:provisionRef": "PatVS § 26",
      "estleg:partOfAct": {
