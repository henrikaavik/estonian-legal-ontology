    {
      "@id": "estleg:Reg_1057204_Par_3_v1057204",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057204_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksus on Riigi Tugiteenuste Keskus (edaspidi rakendusüksus). Rakendusüksus on Riigi Tugiteenuste Keskus (edaspidi rakendusüksus). 2 (2) Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium (edaspidi rakendusasutus). Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium (edaspidi rakendusasutus).",
      "rdfs:label": {
        "@value": "Reg_1057204_Par_3 (redaktsioon 1057204)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057204",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057204",
      "estleg:sourceAct": "Tööalase konkurentsivõime toetamine",
      "estleg:provisionRef": "Reg_1057204 § 3",
      "estleg:partOfAct": {
