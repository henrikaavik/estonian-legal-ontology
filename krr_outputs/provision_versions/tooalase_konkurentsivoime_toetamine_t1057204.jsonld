    {
      "@id": "estleg:Reg_1057204_Par_13_v1057204",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057204_Par_13"
