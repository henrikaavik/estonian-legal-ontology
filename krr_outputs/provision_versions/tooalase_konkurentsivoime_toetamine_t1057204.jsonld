      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksuse toimingu või otsuse peale tuleb enne halduskohtusse kaebuse esitamist esitada vaie rakendusüksusele vastavalt ÜSS2021_2027 §-des 31 ja 32 sätestatule. Auditi aruande alusel tehtud otsuse peale võib esitada vaide rakendusüksusele vastavalt ÜSS2021_2027 §-s 31 sätestatule. Rakendusüksuse toimingu või otsuse peale tuleb enne halduskohtusse kaebuse esitamist esitada vaie rakendusüksusele vastavalt ÜSS2021_2027 §-des 31 ja 32 sätestatule. Auditi aruande alusel tehtud otsuse peale võib esitada vaide rakendusüksusele vastavalt ÜSS2021_2027 §-s 31 sätestatule.",
      "rdfs:label": {
        "@value": "Reg_1057204_Par_29 (redaktsioon 1057204)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057204",
