        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlejale kohalduvad ühendmääruse § 2 lõikes 3 sätestatud kohustused. Taotlejale kohalduvad ühendmääruse § 2 lõikes 3 sätestatud kohustused.",
      "rdfs:label": {
        "@value": "Reg_1057204_Par_11 (redaktsioon 1057204)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057204",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057204",
