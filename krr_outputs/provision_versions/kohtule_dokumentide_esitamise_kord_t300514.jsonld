    {
      "@id": "estleg:Reg_300514_Par_11_20_v300514",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300514_Par_11_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osa- või aktsiakapitali sissemakse kohta esitatavaks krediidiasutuse või makseasutuse teatiseks loetakse ka krediidi- või makseasutuse poolt digitaalselt allkirjastatud või digitaalse templiga varustatud konto väljavõte või maksekorraldus, kui konto väljavõttel või maksekorraldusel on kapitali sissemaksmist tõendav selgitus. RT I 2019-01-11 3 111012019003 2019-01-14 Osa- või aktsiakapitali sissemakse kohta esitatavaks krediidiasutuse või makseasutuse teatiseks loetakse ka krediidi- või makseasutuse poolt digitaalselt allkirjastatud või digitaalse templiga varustatud konto väljavõte või maksekorraldus, kui konto väljavõttel või maksekorraldusel on kapitali sissemaksmist tõendav selgitus.",
      "rdfs:label": {
        "@value": "Reg_300514_Par_11_20 (redaktsioon 300514)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300514",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300514",
      "estleg:sourceAct": "Kohtule dokumentide esitamise kord",
      "estleg:provisionRef": "Reg_300514 § 11_20",
