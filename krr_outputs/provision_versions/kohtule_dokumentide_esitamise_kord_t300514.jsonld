    {
      "@id": "estleg:Reg_300514_Par_20_37_v300514",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300514_Par_20_37"
