    {
      "@id": "estleg:Reg_1056921_Par_3_v1056921",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056921_Par_3"
