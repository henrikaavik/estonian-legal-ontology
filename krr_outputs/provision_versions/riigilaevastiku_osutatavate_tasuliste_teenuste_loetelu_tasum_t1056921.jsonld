      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigilaevastiku osutatavate tasuliste teenuste loetelu, tasumäärad, tasude arvestamise ja tasuliste teenuste osutamise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigilaevastiku osutatavate tasuliste teenuste loetelu, tasumäärad, tasude arvestamise ja tasuliste teenuste osutamise kord"
    },
    {
      "@id": "estleg:Reg_1056921_Par_1_v1056921",
      "@type": [
        "owl:NamedIndividual",
