    {
      "@id": "estleg:Reg_1051405_Par_18_v1051405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051405_Par_18"
