    {
      "@id": "estleg:Reg_1051405_Par_19_v1051405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051405_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Otsuse taotluse rahuldamata jätmise kohta teeb KIK ja teeb selle taotlejale teatavaks E-toetuse keskkonna vahendusel. Otsuse taotluse rahuldamata jätmise kohta teeb KIK ja teeb selle taotlejale teatavaks E-toetuse keskkonna vahendusel. 2 (2) KIK teeb taotluse rahuldamata jätmise otsuse, kui taotleja või taotlus ei vasta käesoleva määruse nõuetele või taotlusekohane projekt ei mahu pärast eelistuskriteeriumite alusel hindamist ja pingerea koostamist projektide rahastamise eelarvesse. KIK teeb taotluse rahuldamata jätmise otsuse, kui taotleja või taotlus ei vasta käesoleva määruse nõuetele või taotlusekohane projekt ei mahu pärast eelistuskriteeriumite alusel hindamist ja pingerea koostamist projektide rahastamise eelarvesse. 3 (3) Taotluse rahuldamata jätmise otsuses märgitakse vähemalt: 1 1) otsuse tegija; 2 2) otsuse tegemise kuupäev ja otsuse number; 3 3) toetuse taotleja andmed; 4 4) otsuse tegemise õiguslikud ja faktilised alused; 5 5) taotluse rahuldamata jätmise põhjendus; 6 6) otsuse vaidlustamise kord. Taotluse rahuldamata jätmise otsuses märgitakse vähemalt: otsuse tegija; otsuse tegemise kuupäev ja otsuse number; toetuse taotleja andmed; otsuse tegemise õiguslikud ja faktilised alused; taotluse rahuldamata jätmise põhjendus; otsuse vaidlustamise kord.",
      "rdfs:label": {
        "@value": "Reg_1051405_Par_19 (redaktsioon 1051405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051405",
      "estleg:sourceAct": "Rohetehnoloogia ettevõtluse arendamise programmide ja üldhariduskoolide õpilaste ning koolieelsete lasteasutuste laste teadlikkuse suurendamise projektide toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1051405 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051405_Map_2026"
      }
