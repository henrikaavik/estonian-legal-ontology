    {
      "@id": "estleg:Reg_1043914_Par_8_v1043914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043914_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja teavitab käesoleva määruse § 4 lõikes 1 nimetatud tööruumis töötavat töötajat radooni pikaajalise mõjuga seonduvast terviseriskist, radoonisisalduse mõõtmiste tulemustest ning rakendatavatest abinõudest, mille eesmärk on vähendada töötaja kokkupuudet radooniga. Tööandja teavitab käesoleva määruse § 4 lõikes 1 nimetatud tööruumis töötavat töötajat radooni pikaajalise mõjuga seonduvast terviseriskist, radoonisisalduse mõõtmiste tulemustest ning rakendatavatest abinõudest, mille eesmärk on vähendada töötaja kokkupuudet radooniga.",
      "rdfs:label": {
        "@value": "Reg_1043914_Par_8 (redaktsioon 1043914)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043914",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043914",
      "estleg:sourceAct": "Tööruumide õhu radoonisisalduse viitetase, õhu radoonisisalduse mõõtmise kord ja tööandja kohustused kõrgendatud radooniriskiga töökohtadel",
      "estleg:provisionRef": "Reg_1043914 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043914_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043914_Par_9_v1043914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043914_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õhu radoonisisalduse mõõtetulemused peavad olema jälgitavad mõõteseaduses sätestatud korras. Õhu radoonisisalduse mõõtetulemused peavad olema jälgitavad mõõteseaduses sätestatud korras. 2 (2) Kui õhu radoonisisalduse aasta keskväärtuse määramiseks kasutatava mõõtemeetodika valikul on lähtutud standarditest EVS-ISO 11665-4 ja EVS-ISO 11665-8 või Kliimaministeeriumi veebilehel avaldatud juhendmaterjalist „Radooni aktiivsuskontsentratsiooni mõõtmine (RAM 2016)”, eeldatakse, et saadud mõõtetulemused on kasutatavad õhu radoonisisalduse viitetasemele vastavuse hindamiseks käesoleva määruse § 3 lõike 2 kohaselt. RT I 2023-07-13 1 113072023001 2023-07-16 Kui õhu radoonisisalduse aasta keskväärtuse määramiseks kasutatava mõõtemeetodika valikul on lähtutud standarditest EVS-ISO 11665-4 ja EVS-ISO 11665-8 või Kliimaministeeriumi veebilehel avaldatud juhendmaterjalist „Radooni aktiivsuskontsentratsiooni mõõtmine (RAM 2016)”, eeldatakse, et saadud mõõtetulemused on kasutatavad õhu radoonisisalduse viitetasemele vastavuse hindamiseks käesoleva määruse § 3 lõike 2 kohaselt. 3 (3) Kui õhu radoonisisalduse ööpäevase muutumise pidevmõõtmise meetodi valikul on lähtutud standardist EVS-EN ISO 11665-5 või Kliimaministeeriumi veebilehel avaldatud juhendmaterjalist „Radooni aktiivsuskontsentratsiooni mõõtmine (RAM 2016)”, eeldatakse, et saadud mõõtetulemused on kasutatavad õhu radoonisisalduse viitetasemele vastavuse hindamiseks käesoleva määruse § 3 lõike 3 kohaselt. RT I 2024-07-26 2 126072024002 2024-07-29 Kui õhu radoonisisalduse ööpäevase muutumise pidevmõõtmise meetodi valikul on lähtutud standardist EVS-EN ISO 11665-5 või Kliimaministeeriumi veebilehel avaldatud juhendmaterjalist „Radooni aktiivsuskontsentratsiooni mõõtmine (RAM 2016)”, eeldatakse, et saadud mõõtetulemused on kasutatavad õhu radoonisisalduse viitetasemele vastavuse hindamiseks käesoleva määruse § 3 lõike 3 kohaselt.",
      "rdfs:label": {
