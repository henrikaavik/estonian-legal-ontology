      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus reguleerib üürikomisjoni liikme eksami korraldamist. Määrus reguleerib üürikomisjoni liikme eksami korraldamist. 2 (2) Üürikomisjoni liikme eksami eesmärgiks on hinnata üürikomisjoni liikmena tegutseda sooviva isiku (edaspidi kandidaat) teadmiste sobivust tööks üürikomisjoni liikmena. RTL 2006 25 455 1006305 2006-03-25+02:00 Üürikomisjoni liikme eksami eesmärgiks on hinnata üürikomisjoni liikmena tegutseda sooviva isiku (edaspidi kandidaat) teadmiste sobivust tööks üürikomisjoni liikmena.",
      "rdfs:label": {
        "@value": "Reg_156294_Par_1 (redaktsioon 156294)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156294",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156294",
      "estleg:sourceAct": "Üürikomisjoni liikme eksami sooritamise kord",
      "estleg:provisionRef": "Reg_156294 § 1",
