    {
      "@id": "estleg:Reg_1061325_Par_4_v1061325",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061325_Par_4"
