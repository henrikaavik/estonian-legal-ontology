      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Lastehoiu ja lasteaia õpi- ja kasvukeskkonna nõuded (20 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lastehoiu ja lasteaia õpi- ja kasvukeskkonna nõuded"
    },
    {
      "@id": "estleg:Reg_1061325_Par_1_v1061325",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061325_Par_1"
