    {
      "@id": "estleg:Reg_313095_Par_10_v313095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313095_Par_10"
