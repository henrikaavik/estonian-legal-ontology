        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) väetiste kasutamine. Piiranguvööndis on lubatud: majandustegevus; väetiste kasutamine.",
      "rdfs:label": {
        "@value": "Reg_313095_Par_14 (redaktsioon 313095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313095",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/313095",
