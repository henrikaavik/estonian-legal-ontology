    {
      "@id": "estleg:Reg_1035155_Par_11_v1035155",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035155_Par_11"
