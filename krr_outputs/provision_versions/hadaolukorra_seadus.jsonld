        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitusseadustiku § 97 täiendatakse lõigetega 7–9 järgmises sõnastuses:",
      "rdfs:label": {
        "@value": "HADAOL_Par_54 (redaktsioon 103032017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032017001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103032017001",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 54",
