    },
    {
      "@id": "estleg:HADAOL_Par_79_v13201475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennundusseadust (RT I 1999, 26, 376; 2009, 5, 35) täiendatakse §-ga 591 järgmises sõnastuses: «§ 591. Elutähtsa teenuse osutaja Lennuvälja käitaja, kelle poolt käideldav lennuväli on avatud rahvusvaheliseks regulaarseks lennuliikluseks, samuti Tallinna lennuinfopiirkonnas lennuliikluse teenindamist tagav aeronavigatsiooniteenuse osutaja on hädaolukorra seaduse § 34 lõike 2 punktides 4 ja 5 nimetatud elutähtsa teenuse osutaja.»",
      "rdfs:label": {
        "@value": "HADAOL_Par_79 (redaktsioon 13201475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201475",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_79_v103032017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13201475",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 79",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_79_v103032017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühisveevärgi ja -kanalisatsiooni seaduse § 7 lõige 11 muudetakse ja sõnastatakse järgmiselt: „(11) Vee-ettevõtja, kes osutab teenust vähemalt 10 000 elanikuga kohaliku omavalitsuse üksuses ning kes osutab teenust ühisveevärgi- ja kanalisatsioonisüsteemi kaudu, millega on ühendatud vähemalt 10 000 elanikku, on hädaolukorra seaduse § 36 lõike 4 punktis 3 nimetatud elutähtsa teenuse osutaja.”.",
      "rdfs:label": {
        "@value": "HADAOL_Par_79 (redaktsioon 103032017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_79_v128122017049"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103032017001",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 79",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_79_v128122017049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "HADAOL_Par_79 (redaktsioon 128122017049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017049",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128122017049",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 79",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_8_v13201475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õppus käesoleva seaduse mõistes on ühe või enama hädaolukorra lahendamise protseduuride ja võimekuse kontrolli eesmärgil korraldatud, kõiki pädevaid asutusi hõlmav, staabi- ning välikomponendist koosnev kriisireguleerimisõppus. (2) Üleriigiline hädaolukorra lahendamise õppus korraldatakse vähemalt üks kord nelja aasta jooksul. (3) Üleriigilise hädaolukorra lahendamise õppuse aja, korraldaja ning hädaolukorrad, mille lahendamise protseduure ja võimekusi kontrollitakse, kinnitab Vabariigi Valitsuse kriisikomisjon kooskõlastatult õppuse korraldajaks kavandatud asutusega. (4) Regionaalse hädaolukorra lahendamise õppuse aja, korraldaja ning hädaolukorrad, mille lahendamise protseduure ja võimekusi kontrollitakse, kinnitab regionaalne kriisikomisjon kooskõlastatult õppuse korraldajaks kavandatud asutusega. (5) Kohaliku omavalitsuse hädaolukorra lahendamise õppuse aja, korraldaja ning hädaolukorrad, mille lahendamise protseduure ja võimekusi kontrollitakse, kinnitab kohaliku omavalitsuse kriisikomisjon kooskõlastatult õppuse korraldajaks kavandatud asutusega. (6) õppuse sisule ning regionaalse ja kohaliku omavalitsuse õppuse korraldamise sagedusele esitatavad nõuded. (7) Õppuse korraldamisega seotud kulud kaetakse õppust korraldava asutuse eelarvest. (8) Õppusele kaasatud asutuste õppusel osalemise kulud kaetakse nende omavahenditest.",
      "rdfs:label": {
        "@value": "HADAOL_Par_8 (redaktsioon 13201475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201475",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_8_v13320720"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13201475",
