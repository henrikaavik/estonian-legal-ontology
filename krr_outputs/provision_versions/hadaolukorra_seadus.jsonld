      }
    },
    {
      "@id": "estleg:HADAOL_Par_41_v103032017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elutähtsa teenuse osutaja on kohustatud tagama elutähtsa teenuse osutamiseks kasutatavate infosüsteemide ja nendega seotud infovara turvameetmete alalise rakendamise. (2) Kui elutähtsa teenuse toimimist tagavad infosüsteemid asuvad välisriigis, tagab elutähtsa teenuse osutaja elutähtsa teenuse toimepidevuse ka viisil ja vahenditega, mis ei sõltu välisriikides asuvatest infosüsteemidest. (3) Elutähtsa teenuse osutamiseks kasutatavate infosüsteemide ja nendega seotud infovara turvameetmed kehtestab määrusega. (4) Nende riigi osutatavate teenuste ning avaliku võimu ülesannete loetelu, millele laienevad käesoleva paragrahvi ja selle alusel kehtestatud nõuded, kehtestab määrusega.",
      "rdfs:label": {
        "@value": "HADAOL_Par_41 (redaktsioon 103032017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_41_v122052018004"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103032017001",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 41",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_41_v122052018004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elutähtsa teenuse osutaja peab elutähtsa teenuse osutamiseks kasutatava võrgu- ja infosüsteemi turvalisuse tagamiseks täitma küberturvalisuse seaduse §-dega 7 ja 8 ning nende alusel kehtestatud nõudeid. (2) Kui elutähtsa teenuse toimimist tagavad infosüsteemid asuvad välisriigis, tagab elutähtsa teenuse osutaja elutähtsa teenuse toimepidevuse ka viisil ja vahenditega, mis ei sõltu välisriikides asuvatest infosüsteemidest. (3) Kehtetu - (4) Nende riigi osutatavate teenuste ning avaliku võimu ülesannete loetelu, millele laienevad käesoleva paragrahvi ja selle alusel kehtestatud nõuded, kehtestab määrusega.",
      "rdfs:label": {
        "@value": "HADAOL_Par_41 (redaktsioon 122052018004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122052018004",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_41_v122052018006"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122052018004",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 41",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
