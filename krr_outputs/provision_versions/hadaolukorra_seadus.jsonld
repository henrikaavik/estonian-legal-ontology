    {
      "@id": "estleg:HADAOL_Par_1_v117122015036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_1"
