      }
    },
    {
      "@id": "estleg:HADAOL_Par_40_v13201475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elutähtsa teenuse osutaja on kohustatud tagama elutähtsa teenuse osutamiseks kasutatavate infosüsteemide ning nendega seotud infovarade turvameetmete alalise rakendamise. (2) Elutähtsa teenuse infosüsteemide ning nendega seotud infovarade turvameetmed",
      "rdfs:label": {
        "@value": "HADAOL_Par_40 (redaktsioon 13201475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201475",
