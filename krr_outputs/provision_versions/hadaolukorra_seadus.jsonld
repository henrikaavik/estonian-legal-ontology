      },
      "estleg:versionText": "Elutähtsa teenuse osutamisega seotud riigikaitseobjekti kaitse sätestatakse riigikaitseseaduses.",
      "rdfs:label": {
        "@value": "HADAOL_Par_41 (redaktsioon 117122015036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015036",
      "estleg:supersededByVersion": {
