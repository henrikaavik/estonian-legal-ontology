      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "HADAOL_Par_11 (redaktsioon 117122015036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015036",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_11_v103032017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117122015036",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 11",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_11_v103032017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi tegevusvaru moodustatakse hädaolukorra lahendamiseks hädaolukorra riskianalüüsist ja hädaolukorra lahendamise plaanist lähtudes. (2) Riigi tegevusvaru käesoleva seaduse tähenduses on riigi omandis olev või lepingutega tagatud ressurss hädaolukorra lahendamiseks. (3) Riigi tegevusvaru moodustamise, varu moodustaja, varu moodustamise eesmärgi, viisi ja rahastamise ning varu hoidmise, kasutamise ja uuendamise üle järelevalve tegija otsustab Vabariigi Valitsus korraldusega. (4) Riigi tegevusvaru moodustaja vastutab varu hoidmise, kasutamise, kontrollimise, uuendamise, sealhulgas täiendamise ja aruandluse korraldamise eest.",
      "rdfs:label": {
        "@value": "HADAOL_Par_11 (redaktsioon 103032017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_11_v118062021002"
      },
      "estleg:versionValidTo": {
        "@value": "2021-06-27",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103032017001",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 11",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_11_v118062021002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
