      }
    },
    {
      "@id": "estleg:HADAOL_Par_12_v13201475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hädaolukorra lahendamist juhib hädaolukorra lahendamise plaanis määratud täidesaatva riigivõimu asutus või ametiisik. (2) Hädaolukorra lahendamist juhtival asutusel või isikul on õigus saada muudelt täidesaatva riigivõimu asutustelt ja ametiisikutelt abi hädaolukorra lahendamiseks hädaolukorra lahendamise plaanis määratud alustel ja korras.",
      "rdfs:label": {
        "@value": "HADAOL_Par_12 (redaktsioon 13201475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201475",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_12_v103032017001"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13201475",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 12",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_12_v103032017001",
      "@type": [
