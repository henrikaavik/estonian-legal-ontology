      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi kriisireguleerimispoliitika väljatöötamist ja selle elluviimist juhib Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "HADAOL_Par_4 (redaktsioon 118062021003)",
        "@language": "et"
