  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_hadaolukorra_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Hädaolukorra seadus (261 versiooni)",
        "@language": "et"
      },
      "dc:source": "Hädaolukorra seadus"
    },
    {
      "@id": "estleg:HADAOL_Par_1_v13201475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus sätestab kriisireguleerimise, sealhulgas hädaolukorraks valmistumise ja hädaolukorra lahendamise ning elutähtsate teenuste toimepidevuse tagamise õiguslikud alused. Käesolev seadus reguleerib ka eriolukorra väljakuulutamist, lahendamist ja lõpetamist ning kaitseväe ja Kaitseliidu kasutamist hädaolukorra lahendamisel, päästetöö tegemisel ja turvalisuse tagamisel. (2) Käesolevat seadust kohaldatakse erakorralise seisukorra ja sõjaseisukorra ajal niivõrd, kuivõrd erakorralise seisukorra seadus ja sõjaaja riigikaitse seadus ei sätesta teisiti. (3) Käesolev seadus ei reguleeri sõjalisest ohust tingitud hädaolukorraks valmistumist ja hädaolukorra lahendamist. (4) Teistes õigusaktides sätestatud riigi ja kohaliku omavalitsuse asutuste (edaspidi asutus) ja isikute pädevused ja volitused kehtivad ka hädaolukorraks valmistumisel ja hädaolukorra lahendamisel, kui käesolev seadus ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "HADAOL_Par_1 (redaktsioon 13201475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201475",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_1_v130102012003"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13201475",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 1",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_1_v130102012003",
      "@type": [
