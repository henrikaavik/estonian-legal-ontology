        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13201475",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 44",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
