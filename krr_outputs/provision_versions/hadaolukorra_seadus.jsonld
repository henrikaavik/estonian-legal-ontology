    {
      "@id": "estleg:HADAOL_Par_7_v103032017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriisireguleerimisvaldkonna koordineerimiseks Siseministeerium: töötab välja riigi kriisireguleerimispoliitika ja kavandab selle elluviimist; nõustab asutusi ja suunab nende tegevust kriisireguleerimise korraldamisel; teeb käesoleva seadusega asutustele pandud ülesannete täitmise üle järelevalvet käesoleva seaduse §-s 45 sätestatu kohaselt ning koostab ja esitab Vabariigi Valitsusele ülevaateid ülesannete täitmise seisust; korraldab Vabariigi Valitsuse kriisikomisjoni tööd; täidab muid õigusaktidest tulenevaid kriisireguleerimisülesandeid.",
      "rdfs:label": {
        "@value": "HADAOL_Par_7 (redaktsioon 103032017001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032017001",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_7_v118062021003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103032017001",
