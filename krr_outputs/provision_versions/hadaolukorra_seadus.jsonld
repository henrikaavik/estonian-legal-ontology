      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "HADAOL_Par_11 (redaktsioon 118062021002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118062021002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118062021002",
