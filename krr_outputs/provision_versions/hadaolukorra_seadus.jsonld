    {
      "@id": "estleg:HADAOL_Par_41_v13201475",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HADAOL_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Suure rünnakuriskiga objekt on elutähtsa teenuse osutamiseks kasutatav territoorium, ehitis või seade, mille füüsiline kahjustamine või hävitamine häirib oluliselt kogu elutähtsa teenuse toimepidevust ning mille ründamiseks on seetõttu suur tõenäosus. (2) Suure rünnakuriskiga objektide loetelu kehtestab Vabariigi Valitsus korraldusega. (3) Suure rünnakuriskiga objekti valdaja on kohustatud: tagama füüsilise kaitse meetmete alalise rakendamise objektil; kajastama toimepidevuse riskianalüüsis objekti füüsilise rünnaku ohtu; arvestama toimepidevuse plaanis objekti füüsilise kaitse meetmetega; teavitama politseid viivitamata asjaoludest objektil või selle lähiümbruses, mis võivad viidata füüsilise rünnaku ohule. (4) Suure rünnakuriskiga objekti füüsilise kaitse meetmed",
      "rdfs:label": {
        "@value": "HADAOL_Par_41 (redaktsioon 13201475)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13201475",
      "estleg:supersededByVersion": {
        "@id": "estleg:HADAOL_Par_41_v116122014013"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13201475",
      "estleg:sourceAct": "Hädaolukorra seadus",
      "estleg:provisionRef": "HADAOL § 41",
      "estleg:partOfAct": {
        "@id": "estleg:HADAOL_Map"
      }
    },
    {
      "@id": "estleg:HADAOL_Par_41_v116122014013",
