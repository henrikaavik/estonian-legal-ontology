      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium korraldab kriisireguleerimist oma valitsemisalas.",
      "rdfs:label": {
        "@value": "HADAOL_Par_8 (redaktsioon 103032017001)",
        "@language": "et"
