      },
      "dc:source": "Sundvõõrandamisele kuuluva relva ja laskemoona eest väljamakstava hüvitise arvestamise ning maksmise kord"
    },
    {
      "@id": "estleg:Reg_160761_Par_1_v160761",
      "@type": [
        "owl:NamedIndividual",
