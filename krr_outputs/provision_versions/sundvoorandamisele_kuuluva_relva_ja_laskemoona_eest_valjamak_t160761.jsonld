      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160761_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib «Relvaseaduse» alusel sundvõõrandamisele kuuluva relva ja laskemoona eest väljamakstava hüvitise arvestamist ning maksmist. Määrus reguleerib «Relvaseaduse» alusel sundvõõrandamisele kuuluva relva ja laskemoona eest väljamakstava hüvitise arvestamist ning maksmist.",
      "rdfs:label": {
        "@value": "Reg_160761_Par_1 (redaktsioon 160761)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160761",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160761",
      "estleg:sourceAct": "Sundvõõrandamisele kuuluva relva ja laskemoona eest väljamakstava hüvitise arvestamise ning maksmise kord",
      "estleg:provisionRef": "Reg_160761 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_160761_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_160761_Par_2_v160761",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160761_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hüvitise arvestamiseks määrab Politsei- ja Piirivalveamet temale hoiule antud sundvõõrandamisele kuuluva relva või laskemoona hariliku väärtuse „Tsiviilseadustiku üldosa seaduse” § 65 tähenduses. RT I 2011-12-29 138 129122011138 2012-01-01 Hüvitise arvestamiseks määrab Politsei- ja Piirivalveamet temale hoiule antud sundvõõrandamisele kuuluva relva või laskemoona hariliku väärtuse „Tsiviilseadustiku üldosa seaduse” § 65 tähenduses. 2 (2) Relva ja laskemoona hariliku väärtuse määramisel on aluseks riigis kujunenud relva ja laskemoona keskmine müügihind. Relva ja laskemoona hariliku väärtuse määramisel on aluseks riigis kujunenud relva ja laskemoona keskmine müügihind. 3 (3) Kunsti- või ajaloolist väärtust või konstruktsioonilist eripära omava relva väärtuse määrab Politsei- ja Piirivalveameti moodustatud ekspertkomisjon. RT I 2009 65 448 13249695 2010-01-01+02:00 Kunsti- või ajaloolist väärtust või konstruktsioonilist eripära omava relva väärtuse määrab Politsei- ja Piirivalveameti moodustatud ekspertkomisjon. 4 (4) Hüvitise suuruseks on käesoleva paragrahvi lõigete 1 kuni 3 alusel määratud sundvõõrandamisele kuuluva relva ja laskemoona väärtus. Hüvitise suuruseks on käesoleva paragrahvi lõigete 1 kuni 3 alusel määratud sundvõõrandamisele kuuluva relva ja laskemoona väärtus.",
      "rdfs:label": {
        "@value": "Reg_160761_Par_2 (redaktsioon 160761)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "160761",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/160761",
      "estleg:sourceAct": "Sundvõõrandamisele kuuluva relva ja laskemoona eest väljamakstava hüvitise arvestamise ning maksmise kord",
      "estleg:provisionRef": "Reg_160761 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_160761_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_160761_Par_3_v160761",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160761_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sundvõõrandamisele kuuluva relva ja laskemoona eest hüvitise maksmine toimub relva omanikule Politsei- ja Piirivalveameti peadirektori või tema volitatud ametniku sundvõõrandamise otsuses näidatud, § 2 alusel arvutatud summas. RT I 2011-12-29 138 129122011138 2012-01-01 Sundvõõrandamisele kuuluva relva ja laskemoona eest hüvitise maksmine toimub relva omanikule Politsei- ja Piirivalveameti peadirektori või tema volitatud ametniku sundvõõrandamise otsuses näidatud, § 2 alusel arvutatud summas. 2 (2) Sundvõõrandatud relva ja laskemoona eest hüvitise maksmine toimub Politsei- ja Piirivalveameti eelarvest. Siseministeeriumi taotluse alusel hüvitatakse Vabariigi Valitsuse reservist Politsei- ja Piirivalveametile tema poolt kantud kulud üks kord kolme kuu jooksul. Sundvõõrandatud relva ja laskemoona eest hüvitise maksmine toimub Politsei- ja Piirivalveameti eelarvest. Siseministeeriumi taotluse alusel hüvitatakse Vabariigi Valitsuse reservist Politsei- ja Piirivalveametile tema poolt kantud kulud üks kord kolme kuu jooksul. 3 (3) Kui hüvitise saaja vaidlustab sundvõõrandamise otsuses näidatud hüvitise suuruse, antakse relv hindamiseks § 2 lõikes 3 nimetatud ekspertkomisjonile. Ekspertkomisjoni otsusega määratud hüvitise suurus tehakse hüvitise saajale kirjalikult teatavaks. RT I 2011-12-29 138 129122011138 2012-01-01 Kui hüvitise saaja vaidlustab sundvõõrandamise otsuses näidatud hüvitise suuruse, antakse relv hindamiseks § 2 lõikes 3 nimetatud ekspertkomisjonile. Ekspertkomisjoni otsusega määratud hüvitise suurus tehakse hüvitise saajale kirjalikult teatavaks.",
      "rdfs:label": {
        "@value": "Reg_160761_Par_3 (redaktsioon 160761)",
        "@language": "et"
      },
