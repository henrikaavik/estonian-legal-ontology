      }
    },
    {
      "@id": "estleg:Reg_1031395_Par_2_v1031395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031395_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 1 nimetatud kaitsealade kaitse alt väljaarvamise tõttu tunnistatakse kehtetuks järgmised kaitse alla võtmise otsused: 1 1) Rakvere Rajooni Töörahva Saadikute Nõukogu Täitevkomitee 27. novembri 1958. a otsuse nr 300 „Looduskaitse organiseerimisest Rakvere rajoonis” lisa 1 „Looduskaitse alla võetavate objektide nimekiri Rakvere Rajoonis” punktid 14 ja 15; 2 2) Rakvere Rajooni Rahvasaadikute Nõukogu Täitevkomitee 11. detsembri 1978. a otsuse nr 198 „Kohaliku tähtsusega looduskaitse alla kuuluvate parkide ja botaaniliste üksikobjektide nimekirjade muutmise kohta” lisa 4 „Rakvere rajoonis looduskaitse alla kuuluvate kohaliku tähtsusega geoloogiliste ja maastikuliste üksikobjektide nimekiri” punktid 3 ja 5. Paragrahvis 1 nimetatud kaitsealade kaitse alt väljaarvamise tõttu tunnistatakse kehtetuks järgmised kaitse alla võtmise otsused: Rakvere Rajooni Töörahva Saadikute Nõukogu Täitevkomitee 27. novembri 1958. a otsuse nr 300 „Looduskaitse organiseerimisest Rakvere rajoonis” lisa 1 „Looduskaitse alla võetavate objektide nimekiri Rakvere Rajoonis” punktid 14 ja 15; Rakvere Rajooni Rahvasaadikute Nõukogu Täitevkomitee 11. detsembri 1978. a otsuse nr 198 „Kohaliku tähtsusega looduskaitse alla kuuluvate parkide ja botaaniliste üksikobjektide nimekirjade muutmise kohta” lisa 4 „Rakvere rajoonis looduskaitse alla kuuluvate kohaliku tähtsusega geoloogiliste ja maastikuliste üksikobjektide nimekiri” punktid 3 ja 5.",
      "rdfs:label": {
