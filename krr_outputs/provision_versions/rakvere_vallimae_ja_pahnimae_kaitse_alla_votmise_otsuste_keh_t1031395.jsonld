      "estleg:versionValidFrom": {
        "@value": "2015-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loodusobjektide loodusväärtuse puudumise tõttu arvatakse kaitse alt välja järgmised Lääne-Viru maakonnas asuvad kaitsealad: 1 1) Rakvere Vallimägi (KLO1000114); 2 2) Pahnimägi (KLO1000562). Loodusobjektide loodusväärtuse puudumise tõttu arvatakse kaitse alt välja järgmised Lääne-Viru maakonnas asuvad kaitsealad: Rakvere Vallimägi (KLO1000114); Pahnimägi (KLO1000562).",
      "rdfs:label": {
        "@value": "Reg_1031395_Par_1 (redaktsioon 1031395)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031395",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031395",
