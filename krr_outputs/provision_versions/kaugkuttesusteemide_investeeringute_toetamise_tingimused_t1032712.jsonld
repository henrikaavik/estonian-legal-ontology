    {
      "@id": "estleg:Reg_1032712_Par_5_v1032712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032712_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksuse toimingu või otsuse peale tuleb enne halduskohtusse kaebuse esitamist esitada vaie rakendusüksusele. Rakendusüksuse toimingu või otsuse peale tuleb enne halduskohtusse kaebuse esitamist esitada vaie rakendusüksusele. 2 (2) Rakendusüksus vaatab vaide läbi haldusmenetluse seaduses sätestatud korras ja struktuuritoetuse seaduse § 51 lõikes 3 sätestatud tähtaja jooksul. Rakendusüksus vaatab vaide läbi haldusmenetluse seaduses sätestatud korras ja struktuuritoetuse seaduse § 51 lõikes 3 sätestatud tähtaja jooksul. 3 (3) Vaideotsus toimetatakse vaide esitajale tema nõusolekul kätte elektrooniliselt. Vaideotsus toimetatakse vaide esitajale tema nõusolekul kätte elektrooniliselt.",
      "rdfs:label": {
        "@value": "Reg_1032712_Par_5 (redaktsioon 1032712)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032712",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032712",
      "estleg:sourceAct": "Kaugküttesüsteemide investeeringute toetamise tingimused",
      "estleg:provisionRef": "Reg_1032712 § 5",
