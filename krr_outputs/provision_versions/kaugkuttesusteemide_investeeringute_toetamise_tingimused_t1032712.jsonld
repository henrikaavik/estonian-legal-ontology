    {
      "@id": "estleg:Reg_1032712_Par_24_v1032712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032712_Par_24"
