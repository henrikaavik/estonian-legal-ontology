      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057239_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksus säilitab toetuse andmisega seotud dokumente kümme aastat viimasest taotluse rahuldamise otsuse tegemisest. Rakendusüksus säilitab toetuse andmisega seotud dokumente kümme aastat viimasest taotluse rahuldamise otsuse tegemisest.",
      "rdfs:label": {
        "@value": "Reg_1057239_Par_22 (redaktsioon 1057239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057239",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057239",
      "estleg:sourceAct": "Kaugküttesüsteemide investeeringute toetuse andmise tingimused ja kord",
