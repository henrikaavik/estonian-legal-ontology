      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse menetlemise tähtaeg on kuni 65 tööpäeva taotluste esitamise tähtpäevast arvates. Taotluse menetlemise tähtaeg on kuni 65 tööpäeva taotluste esitamise tähtpäevast arvates. 2 (2) Taotluse menetlemise tähtaega võib põhjendatud juhtudel pikendada ühendmääruse § 6 lõikes 2 sätestatud juhul kuni kümne tööpäeva võrra. Taotluse menetlemise tähtaega võib põhjendatud juhtudel pikendada ühendmääruse § 6 lõikes 2 sätestatud juhul kuni kümne tööpäeva võrra.",
      "rdfs:label": {
        "@value": "Reg_1057239_Par_14 (redaktsioon 1057239)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057239",
