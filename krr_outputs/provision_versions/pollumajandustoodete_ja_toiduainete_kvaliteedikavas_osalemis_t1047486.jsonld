    {
      "@id": "estleg:Reg_1047486_Par_10_10_v1047486",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047486_Par_10_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA hindab nõuetele vastavaid taotlusi nende § 5 lõikes 11 nimetatud loomade arvu alusel, keda taotleja pidas taotluse esitamise tähtpäeva seisuga. PRIA hindab nõuetele vastavaid taotlusi nende § 5 lõikes 11 nimetatud loomade arvu alusel, keda taotleja pidas taotluse esitamise tähtpäeva seisuga. 2 (2) Taotlus vastab hindamiskriteeriumite miinimumnõuetele, kui taotleja peab vähemalt: 1 1) viit lihatõugu ammlehma; 2 2) viit vähemalt kaheksa kuu vanust lihatõugu lehmmullikat või 3 3) kümmet vähemalt kümne kuu vanust utte. Taotlus vastab hindamiskriteeriumite miinimumnõuetele, kui taotleja peab vähemalt: viit lihatõugu ammlehma; viit vähemalt kaheksa kuu vanust lihatõugu lehmmullikat või kümmet vähemalt kümne kuu vanust utte. 3 (3) PRIA koostab hindamistulemuste põhjal taotluste paremusjärjestuse, võttes aluseks lõikes 1 nimetatud hindamiskriteeriumi. Taotluste paremusjärjestuse koostamisel loetakse paremaks selle taotleja taotlus, kelle peetavate § 5 lõikes 11 nimetatud loomade arv on suurem. RT I 2023-02-28 1 128022023001 2023-03-03 PRIA koostab hindamistulemuste põhjal taotluste paremusjärjestuse, võttes aluseks lõikes 1 nimetatud hindamiskriteeriumi. Taotluste paremusjärjestuse koostamisel loetakse paremaks selle taotleja taotlus, kelle peetavate § 5 lõikes 11 nimetatud loomade arv on suurem.",
      "rdfs:label": {
        "@value": "Reg_1047486_Par_10_10 (redaktsioon 1047486)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047486",
