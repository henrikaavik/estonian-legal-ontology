    },
    {
      "@id": "estleg:KasMS_Par_39_1_v130032023006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KasMS_Par_39_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud juhtudel tasutakse registreerimistaotluse läbivaatamise, teabe väljastamise ja muude toimingute tegemise eest riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "KasMS_Par_39_1 (redaktsioon 130032023006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130032023006"
    },
    {
      "@id": "estleg:KasMS_Par_39_2_v130032023006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
