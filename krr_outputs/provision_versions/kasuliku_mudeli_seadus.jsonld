      }
    },
    {
      "@id": "estleg:KasMS_Par_2_v730978",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KasMS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Kehtetu]",
      "rdfs:label": {
        "@value": "KasMS_Par_2 (redaktsioon 730978)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "730978",
      "estleg:supersededByVersion": {
