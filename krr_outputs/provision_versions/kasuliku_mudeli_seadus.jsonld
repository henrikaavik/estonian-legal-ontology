      },
      "estleg:versionValidFrom": {
        "@value": "2023-08-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui sama toimingu eest on ekslikult tasutud rohkem kui ühel korral või seda on teinud erinevad isikud, võetakse riigilõivu tasumise aluseks esimesena esitatud andmed õiges summas tasutud riigilõivu kohta.",
      "rdfs:label": {
        "@value": "KasMS_Par_34_1 (redaktsioon 130032023006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130032023006"
    },
    {
