      }
    },
    {
      "@id": "estleg:Reg_1055808_Par_2_v1055808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055808_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Saare maakonnas Saaremaa vallas Rannaküla, Nässuma, Sandla, Iilaste, Tõlluste, Metsaküla, Matsiranna, Väljaküla, Väljamõisa, Oessaare, Siiksaare ja Turja külas. Kaitseala asub Saare maakonnas Saaremaa vallas Rannaküla, Nässuma, Sandla, Iilaste, Tõlluste, Metsaküla, Matsiranna, Väljaküla, Väljamõisa, Oessaare, Siiksaare ja Turja külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1055808_Par_2 (redaktsioon 1055808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055808",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055808",
      "estleg:sourceAct": "Laidevahe looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055808 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055808_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055808_Par_20_v1055808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055808_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 17. aprilli 2020. a käskkirjaga nr 7-4/20/6200 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 17. aprilli 2020. a käskkirjaga nr 7-4/20/6200 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1055808_Par_20 (redaktsioon 1055808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055808",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055808",
      "estleg:sourceAct": "Laidevahe looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055808 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055808_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055808_Par_21_v1055808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055808_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1055808_Par_21 (redaktsioon 1055808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055808",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055808",
      "estleg:sourceAct": "Laidevahe looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055808 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055808_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055808_Par_3_v1055808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055808_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1055808_Par_3 (redaktsioon 1055808)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055808",
