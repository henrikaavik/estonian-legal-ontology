      "estleg:provisionRef": "Reg_1055808 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055808_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055808_Par_12_v1055808",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055808_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) inimeste viibimine Rukla sihtkaitsevööndis 15. veebruarist kuni 31. juulini ning Laidevahe ja Põldealuse sihtkaitsevööndi laidudel 1. aprillist kuni 31. augustini; 4 4) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul tee, tehnovõrgu rajatise või tootmisotstarbeta rajatise püstitamine kaitsealal paikneva kinnistu tarbeks ning tootmisotstarbeta ehitise püstitamine kaitseala tarbeks, kusjuures kaitseala tarbeks ehitise püstitamisel ehituskeeluvööndisse ei laiene ehitisele ranna ja kalda ehituskeeluvööndi ehituskeeld. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; inimeste viibimine Rukla sihtkaitsevööndis 15. veebruarist kuni 31. juulini ning Laidevahe ja Põldealuse sihtkaitsevööndi laidudel 1. aprillist kuni 31. augustini; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul tee, tehnovõrgu rajatise või tootmisotstarbeta rajatise püstitamine kaitsealal paikneva kinnistu tarbeks ning tootmisotstarbeta ehitise püstitamine kaitseala tarbeks, kusjuures kaitseala tarbeks ehitise püstitamisel ehituskeeluvööndisse ei laiene ehitisele ranna ja kalda ehituskeeluvööndi ehituskeeld.",
      "rdfs:label": {
        "@value": "Reg_1055808_Par_12 (redaktsioon 1055808)",
        "@language": "et"
      },
