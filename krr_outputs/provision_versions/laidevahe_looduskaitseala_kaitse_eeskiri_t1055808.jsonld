      "estleg:versionValidFrom": {
        "@value": "2023-02-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 27. juuli 2006. a määruse nr 176 „Hoiualade kaitse alla võtmine Saare maakonnas” § 1 lõike 1 punkt 57 ja määruse lisas esitatud kaart „Siiksaare-Oessaare” tunnistatakse kehtetuks. Vabariigi Valitsuse 27. juuli 2006. a määruse nr 176 „Hoiualade kaitse alla võtmine Saare maakonnas” § 1 lõike 1 punkt 57 ja määruse lisas esitatud kaart „Siiksaare-Oessaare” tunnistatakse kehtetuks.",
      "rdfs:label": {
