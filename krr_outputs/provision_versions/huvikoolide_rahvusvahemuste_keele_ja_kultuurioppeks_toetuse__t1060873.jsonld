      }
    },
    {
      "@id": "estleg:Reg_1060873_Par_22_v1060873",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060873_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erandina § 4 lõikes 4 sätestatust võetakse 2025. aastal huvikoolide toetuse eraldamisel arvesse EHISe andmed 1. mai seisuga. Erandina § 4 lõikes 4 sätestatust võetakse 2025. aastal huvikoolide toetuse eraldamisel arvesse EHISe andmed 1. mai seisuga.",
      "rdfs:label": {
