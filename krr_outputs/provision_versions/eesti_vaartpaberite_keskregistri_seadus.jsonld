    },
    {
      "@id": "estleg:EVKS_Par_18_v129062011019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_18"
      },
      "estleg:versionValidFrom": {
