      },
      "estleg:versionText": "Registris registreeritakse Eesti erastamisväärtpaberite keskregistris depooarvele laekunud erastamisväärtpaberi nimiväärtus. 2--4. jagu [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "EVKS_Par_56 (redaktsioon 609108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "609108",
      "estleg:supersededByVersion": {
