    {
      "@id": "estleg:EVKS_Par_1_v13164296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti väärtpaberite keskregister (edaspidi register) on register aktsiate, võlakohustuste ja muude käesoleva seaduse §-s 2 nimetatud õiguste (edaspidi väärtpaberid) ja nende õigustega tehtavate toimingute registreerimiseks. (2) Registrile ja selle pidamisele ei kohaldata andmekogude seadust (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155), kui käesolevast seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "EVKS_Par_1 (redaktsioon 13164296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13164296",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVKS_Par_1_v864994"
      },
      "estleg:versionValidTo": {
        "@value": "2005-03-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13164296",
      "estleg:sourceAct": "Eesti väärtpaberite keskregistri seadus",
      "estleg:provisionRef": "EVKS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:EVKS_Map"
      }
    },
