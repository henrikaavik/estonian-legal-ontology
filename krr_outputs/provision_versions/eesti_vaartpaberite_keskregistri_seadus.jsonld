    {
      "@id": "estleg:EVKS_Par_39_v129062011019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalve teostaja: kontrollib registripidaja, kontohalduri, kindlustusandja ja esindajakonto omajategevuse vastavust käesolevale seadusele ja muudele nende tegevust reguleerivatele õigusaktidele; annab seadusega ettenähtud heakskiite ja kooskõlastusi; teeb vajaduse korral käesolevast seadusest ja teistest õigusaktidest tulenevate nõuete rikkumise lõpetamiseks registripidajale, kontohaldurile, kindlustusandjale ja esindajakonto omajale täitmiseks kohustuslikke ettekirjutusi; koostab protokollid käesoleva seaduse ja sellest tulenevate õigusaktide rikkumise kohta; täidab muid seadustest ja teistest õigusaktidest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "EVKS_Par_39 (redaktsioon 129062011019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062011019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062011019",
      "estleg:sourceAct": "Eesti väärtpaberite keskregistri seadus",
      "estleg:provisionRef": "EVKS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:EVKS_Map"
      }
    },
    {
      "@id": "estleg:EVKS_Par_4_v13164296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Emitendi ja tema emiteeritud väärtpaberite kohta kantakse registrisse järgmised andmed: emitendi nimi, asukoht ja võimaluse korral registrikood; väärtpaberite liik, nimiväärtus (koos vääringuga) ja kogus; väärtpaberi omanike nimed, aadressid ja isiku- või registrikoodid, isikukoodi puudumisel sünniaeg ning iga väärtpaberiomanike nimekirja kantud isiku nimel avatud väärtpaberikontol registreeritud vastavate väärtpaberite arv; andmed väärtpaberite pantimise kohta.",
      "rdfs:label": {
        "@value": "EVKS_Par_4 (redaktsioon 13164296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13164296",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVKS_Par_4_v12760427"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13164296",
      "estleg:sourceAct": "Eesti väärtpaberite keskregistri seadus",
      "estleg:provisionRef": "EVKS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:EVKS_Map"
      }
    },
    {
      "@id": "estleg:EVKS_Par_4_v12760427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Emitendi ja tema emiteeritud väärtpaberite kohta kantakse registrisse järgmised andmed: emitendi nimi, asukoht ja võimaluse korral registrikood; väärtpaberite liik, olemasolul nimiväärtus (koos vääringuga) ja arv; väärtpaberi omanike nimed, aadressid ja isiku- või registrikoodid, isikukoodi puudumisel sünniaeg ning iga väärtpaberiomanike nimekirja kantud isiku nimel avatud väärtpaberikontol registreeritud vastavate väärtpaberite arv; andmed väärtpaberite pantimise kohta.",
      "rdfs:label": {
