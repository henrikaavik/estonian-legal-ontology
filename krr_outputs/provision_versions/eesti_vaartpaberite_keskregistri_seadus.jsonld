        "@id": "estleg:EVKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet registripidaja, kontohalduri, kindlustusandja ja esindajakonto omaniku üle teostab Finantsinspektsioon (edaspidi järelevalve teostaja) käesolevas seaduses, väärtpaberituru seaduses, kogumispensionide seaduses, kindlustustegevuse seaduses ja krediidiasutuste seaduses sätestatud korras ja ulatuses, tehes välisriigi kontohalduri või esindajakonto omaniku puhul koostööd lepinguriigi ja vastava kokkuleppe korral ka kolmanda riigi kontohalduri või esindajakonto omaniku üle järelevalvet teostava asutusega. (2) Järelevalvet krediidiasutustest kontohaldurite tegevuse üle teostab Finantsinspektsioon (edaspidi järelevalve teostaja) krediidiasutuste seaduses, käesolevas seaduses ja nendest tulenevates õigusaktides sätestatud korras. (3) Vajaduse korral kaasatakse järelevalve teostamiseks sõltumatuid eksperte ning tehakse koostööd teiste Eesti ja välismaiste järelevalveorganitega.",
      "rdfs:label": {
        "@value": "EVKS_Par_38 (redaktsioon 13064937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13064937",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVKS_Par_38_v129062011019"
      },
      "estleg:versionValidTo": {
        "@value": "2011-07-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13064937",
      "estleg:sourceAct": "Eesti väärtpaberite keskregistri seadus",
      "estleg:provisionRef": "EVKS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:EVKS_Map"
      }
    },
    {
      "@id": "estleg:EVKS_Par_38_v129062011019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet registripidaja, kontohalduri, kindlustusandja ja esindajakonto omaja üle teostab Finantsinspektsioon (edaspidi järelevalve teostaja) käesolevas seaduses, väärtpaberituru seaduses, kogumispensionide seaduses, kindlustustegevuse seaduses ning krediidiasutuste seaduses sätestatud korras ja ulatuses. Järelevalve teostajal on õigus teha järelevalve teostamiseks välisriigi kontohalduri või esindajakonto omaja puhul koostööd lepinguriigi ja vastava kokkuleppe korral ka kolmanda riigi kontohalduri või esindajakonto omaja üle järelevalvet teostava asutusega. (2) Järelevalvet krediidiasutustest kontohaldurite tegevuse üle teostab Finantsinspektsioon (edaspidi järelevalve teostaja) krediidiasutuste seaduses, käesolevas seaduses ja nendest tulenevates õigusaktides sätestatud korras. (3) Vajaduse korral kaasatakse järelevalve teostamiseks sõltumatuid eksperte ning tehakse koostööd teiste Eesti ja välismaiste järelevalveorganitega.",
      "rdfs:label": {
        "@value": "EVKS_Par_38 (redaktsioon 129062011019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062011019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062011019",
      "estleg:sourceAct": "Eesti väärtpaberite keskregistri seadus",
      "estleg:provisionRef": "EVKS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:EVKS_Map"
      }
    },
    {
      "@id": "estleg:EVKS_Par_39_v13164296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalve teostaja: kontrollib registripidaja ja kontohalduri tegevuse vastavust seadustele; annab seadusega ettenähtud heakskiite ja kooskõlastusi; teeb vajaduse korral käesolevast seadusest tulenevate nõuete rikkumise lõpetamiseks registripidajale või kontohaldurile täitmiseks kohustuslikke ettekirjutusi; koostab protokollid käesoleva seaduse ja sellest tulenevate õigusaktide rikkumise kohta; täidab muid seadustest ja teistest õigusaktidest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "EVKS_Par_39 (redaktsioon 13164296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13164296",
      "estleg:supersededByVersion": {
        "@id": "estleg:EVKS_Par_39_v12760427"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13164296",
      "estleg:sourceAct": "Eesti väärtpaberite keskregistri seadus",
      "estleg:provisionRef": "EVKS § 39",
      "estleg:partOfAct": {
        "@id": "estleg:EVKS_Map"
      }
    },
    {
      "@id": "estleg:EVKS_Par_39_v12760427",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVKS_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalve teostaja: kontrollib registripidaja, kontohalduri ja esindajakonto omanikutegevuse vastavust käesolevale seadusele ja muudele nende tegevust reguleerivatele õigusaktidele; annab seadusega ettenähtud heakskiite ja kooskõlastusi; teeb vajaduse korral käesolevast seadusest ja teistest õigusaktidest tulenevate nõuete rikkumise lõpetamiseks registripidajale, kontohaldurile ja esindajakonto omanikule täitmiseks kohustuslikke ettekirjutusi; koostab protokollid käesoleva seaduse ja sellest tulenevate õigusaktide rikkumise kohta; täidab muid seadustest ja teistest õigusaktidest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "EVKS_Par_39 (redaktsioon 12760427)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12760427",
      "estleg:supersededByVersion": {
