        "@id": "estleg:Reg_1034926_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1034926_Par_2_v1034926",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034926_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitõendi esiküljel on sinise ja punase värviga turvamuster, mille põhjal on sinist värvi väikese riigivapi kujutis. Ametitõendi esiküljel on sinise ja punase värviga turvamuster, mille põhjal on sinist värvi väikese riigivapi kujutis. 2 (2) Ametitõendi esikülje ülaservas on suurtähtedega tekst „KAITSEPOLITSEIAMET“ ja tekst „Estonian Internal Security Service“. Ametitõendi esikülje ülaservas on suurtähtedega tekst „KAITSEPOLITSEIAMET“ ja tekst „Estonian Internal Security Service“. 3 (3) Ametitõendi esiküljel on järgmised andmeväljad: 1 1) ametniku ees- ja perekonnanimi; 2 2) ametniku isikukood; 3 3) ametitõendi number; 4 4) kehtivuse lõppkuupäev. Ametitõendi esiküljel on järgmised andmeväljad: ametniku ees- ja perekonnanimi; ametniku isikukood; ametitõendi number; kehtivuse lõppkuupäev. 4 (4) Ametitõendi esikülje parema serva alanurgas on ametniku värvitrükis foto. Ametitõendi esikülje parema serva alanurgas on ametniku värvitrükis foto.",
      "rdfs:label": {
        "@value": "Reg_1034926_Par_2 (redaktsioon 1034926)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034926",
