      "estleg:versionValidFrom": {
        "@value": "2016-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitsepolitseiameti ametniku ametitõend (edaspidi ametitõend) on plastikust valmistatud kaart mõõtmetega 85,5 millimeetrit × 54 millimeetrit, mis vastab standardile ISO 7810, CR-80. Kaitsepolitseiameti ametniku ametitõend (edaspidi ametitõend) on plastikust valmistatud kaart mõõtmetega 85,5 millimeetrit × 54 millimeetrit, mis vastab standardile ISO 7810, CR-80. 2 (2) Ametitõendi kujutis on esitatud määruse lisas 1. Ametitõendi kujutis on esitatud määruse lisas 1.",
      "rdfs:label": {
        "@value": "Reg_1034926_Par_1 (redaktsioon 1034926)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034926",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034926",
      "estleg:sourceAct": "Kaitsepolitseiameti ametniku ametitõendi ja politseiametniku ametimärgi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1034926 § 1",
