        "@value": "Sätete redaktsioonid: Kaitsepolitseiameti ametniku ametitõendi ja politseiametniku ametimärgi kirjeldus ja vorm (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kaitsepolitseiameti ametniku ametitõendi ja politseiametniku ametimärgi kirjeldus ja vorm"
    },
    {
      "@id": "estleg:Reg_1034926_Par_1_v1034926",
      "@type": [
