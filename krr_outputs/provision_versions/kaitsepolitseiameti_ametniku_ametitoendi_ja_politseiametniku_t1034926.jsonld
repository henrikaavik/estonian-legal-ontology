      "estleg:sourceAct": "Kaitsepolitseiameti ametniku ametitõendi ja politseiametniku ametimärgi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1034926 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034926_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1034926_Par_3_v1034926",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034926_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitõendi tagaküljel on sinise ja punase värviga turvamuster, mille põhjal on värviline väikese riigivapi kujutis. Ametitõendi tagaküljel on sinise ja punase värviga turvamuster, mille põhjal on värviline väikese riigivapi kujutis. 2 (2) Ametitõendi tagaküljel on järgmised andmeväljad: 1 1) õigused; 2 2) tekst „EESTI VABARIIK / REPUBLIC OF ESTONIA“. Ametitõendi tagaküljel on järgmised andmeväljad: õigused; tekst „EESTI VABARIIK / REPUBLIC OF ESTONIA“.",
      "rdfs:label": {
        "@value": "Reg_1034926_Par_3 (redaktsioon 1034926)",
        "@language": "et"
      },
