        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotletava toetuse maksimaalne summa on 15 000 eurot taotluse kohta. Taotletava toetuse maksimaalne summa on 15 000 eurot taotluse kohta.",
      "rdfs:label": {
        "@value": "Reg_1055403_Par_10 (redaktsioon 1055403)",
