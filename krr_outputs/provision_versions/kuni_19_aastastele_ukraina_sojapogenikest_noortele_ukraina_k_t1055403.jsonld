      "estleg:provisionRef": "Reg_1055403 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055403_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055403_Par_21_v1055403",
      "@type": [
