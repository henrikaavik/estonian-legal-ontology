      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "Reg_301342_Par_20 (redaktsioon 301342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301342",
