      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301342",
      "estleg:sourceAct": "Nigula looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301342 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301342_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_301342_Par_14_v301342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301342_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järve, Kolbergi, Kuuselohu ja Strupa sihtkaitsevööndis on poollooduslike koosluste ilme ja liigikoosseisu ning kaitsealuste liikide elutingimuste säilitamiseks ja taastamiseks vajalik tegevus, nagu heina niitmine, loomade karjatamine ning koosluste kujundamine vastavalt kaitse-eesmärgile. Järve, Kolbergi, Kuuselohu ja Strupa sihtkaitsevööndis on poollooduslike koosluste ilme ja liigikoosseisu ning kaitsealuste liikide elutingimuste säilitamiseks ja taastamiseks vajalik tegevus, nagu heina niitmine, loomade karjatamine ning koosluste kujundamine vastavalt kaitse-eesmärgile.",
      "rdfs:label": {
        "@value": "Reg_301342_Par_14 (redaktsioon 301342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301342",
      "estleg:sourceAct": "Nigula looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301342 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301342_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_301342_Par_15_v301342",
