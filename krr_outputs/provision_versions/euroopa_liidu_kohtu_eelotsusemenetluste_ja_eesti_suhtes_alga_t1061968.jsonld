    },
    {
      "@id": "estleg:Reg_1061968_Par_7_v1061968",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061968_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse kannab uusi andmeid ja vastutab muudatuste sisestamise eest andmekogu vastutav töötleja. Andmekogusse kannab uusi andmeid ja vastutab muudatuste sisestamise eest andmekogu vastutav töötleja. 2 (2) Kui andmekogusse kantud andmed muutuvad, teeb andmekogu vastutav töötleja andmekogus asjakohase muudatuse. Kui andmekogusse kantud andmed muutuvad, teeb andmekogu vastutav töötleja andmekogus asjakohase muudatuse. 3 (3) Andmekogusse kantud andmete õigsuse eest vastutab andmekogu vastutav töötleja. Andmekogusse kantud andmete õigsuse eest vastutab andmekogu vastutav töötleja.",
      "rdfs:label": {
        "@value": "Reg_1061968_Par_7 (redaktsioon 1061968)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061968",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061968",
      "estleg:sourceAct": "Euroopa Liidu Kohtu eelotsusemenetluste ja Eesti suhtes algatatud rikkumismenetluste andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1061968 § 7",
      "estleg:partOfAct": {
