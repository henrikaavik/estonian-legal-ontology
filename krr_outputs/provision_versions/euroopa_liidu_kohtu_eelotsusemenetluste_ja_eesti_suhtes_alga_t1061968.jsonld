      }
    },
    {
      "@id": "estleg:Reg_1061968_Par_2_v1061968",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061968_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise eesmärk on hallata Euroopa Liidu Kohtu eelotsusemenetluste kohta saadetud informatsiooni, jälgida menetluste käiku ning teavitada sellest asjaomaseid ametiasutusi. Samuti hallatakse andmekogus teavet Euroopa Komisjoni algatatud rikkumismenetluste kohta. Andmekogu pidamise eesmärk on hallata Euroopa Liidu Kohtu eelotsusemenetluste kohta saadetud informatsiooni, jälgida menetluste käiku ning teavitada sellest asjaomaseid ametiasutusi. Samuti hallatakse andmekogus teavet Euroopa Komisjoni algatatud rikkumismenetluste kohta.",
      "rdfs:label": {
        "@value": "Reg_1061968_Par_2 (redaktsioon 1061968)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061968",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061968",
      "estleg:sourceAct": "Euroopa Liidu Kohtu eelotsusemenetluste ja Eesti suhtes algatatud rikkumismenetluste andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1061968 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061968_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061968_Par_3_v1061968",
      "@type": [
