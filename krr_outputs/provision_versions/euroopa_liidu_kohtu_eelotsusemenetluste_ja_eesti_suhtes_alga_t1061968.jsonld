        "@value": "2025-10-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu vastutav töötleja on Välisministeerium. Andmekogu vastutav töötleja on Välisministeerium.",
      "rdfs:label": {
        "@value": "Reg_1061968_Par_3 (redaktsioon 1061968)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061968",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061968",
      "estleg:sourceAct": "Euroopa Liidu Kohtu eelotsusemenetluste ja Eesti suhtes algatatud rikkumismenetluste andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1061968 § 3",
      "estleg:partOfAct": {
