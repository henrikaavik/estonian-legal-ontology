      "estleg:provisionRef": "Reg_156962 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156962_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156962_Par_3_v156962",
      "@type": [
        "owl:NamedIndividual",
