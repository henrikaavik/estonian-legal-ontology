    {
      "@id": "estleg:Reg_156962_Par_5_v156962",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156962_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjoni väljastatavatele dokumentidele kirjutab alla komisjoni esimees või tema volitusel aseesimees. Komisjoni väljastatavatele dokumentidele kirjutab alla komisjoni esimees või tema volitusel aseesimees. 2 (2) Komisjoni ettepanekud ja seisukohad esitab Vabariigi Valitsusele ja ministeeriumidele ning teistele asutustele ja organisatsioonidele komisjoni esimees. Komisjoni ettepanekud ja seisukohad esitab Vabariigi Valitsusele ja ministeeriumidele ning teistele asutustele ja organisatsioonidele komisjoni esimees.",
      "rdfs:label": {
        "@value": "Reg_156962_Par_5 (redaktsioon 156962)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156962",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156962",
      "estleg:sourceAct": "Väikesaarte komisjoni põhimäärus",
      "estleg:provisionRef": "Reg_156962 § 5",
