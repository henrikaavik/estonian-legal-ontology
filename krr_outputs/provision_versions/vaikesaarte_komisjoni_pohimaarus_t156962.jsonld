    {
      "@id": "estleg:Reg_156962_Par_4_v156962",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156962_Par_4"
