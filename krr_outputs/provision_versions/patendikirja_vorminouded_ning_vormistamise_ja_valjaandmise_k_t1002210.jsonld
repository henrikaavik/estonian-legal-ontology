        "@type": "xsd:date"
      },
      "estleg:versionText": "Patendikiri on dokument, mis tõendab leiutise registreerimist patendiregistris (edaspidi register) ja patendiomaniku ainuõigust patendikirjelduses toodud leiutisele. Patendikiri on dokument, mis tõendab leiutise registreerimist patendiregistris (edaspidi register) ja patendiomaniku ainuõigust patendikirjelduses toodud leiutisele.",
      "rdfs:label": {
        "@value": "Reg_1002210_Par_1 (redaktsioon 1002210)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002210",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002210",
      "estleg:sourceAct": "Patendikirja vorminõuded ning vormistamise ja väljaandmise kord",
