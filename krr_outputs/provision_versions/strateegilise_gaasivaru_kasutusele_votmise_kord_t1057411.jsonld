      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Strateegilise gaasivaru kasutusele võtmise kord (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Strateegilise gaasivaru kasutusele võtmise kord"
    },
    {
      "@id": "estleg:Reg_1057411_Par_1_v1057411",
      "@type": [
        "owl:NamedIndividual",
