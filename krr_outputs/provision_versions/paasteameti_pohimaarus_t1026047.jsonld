    {
      "@id": "estleg:Reg_1026047_Par_16_v1026047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026047_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohutusjärelevalve osakonna põhiülesanded on: 1 1) osakonna teenuste arendamine ning teenuste nõuetele vastavuse ja mõju hindamine; 2 2) ohutegurite analüüs ja sellest tulenevalt ohutusjärelevalve valdkonna teenuste planeerimine; 3 3) varjumise korraldamine ja koordineerimine ning järelevalve tegemine valdkonda reguleerivates õigusaktides sätestatud ulatuses; 4 4) järelevalve tegemine toodete ja teenuste tuleohutusnõuetele vastavuse üle; 5 5) tule- ja kemikaaliohutuse korraldamine ning koordineerimine tuleohutuse seaduses ja kemikaaliseaduses ning teistes valdkonda reguleerivates õigusaktides sätestatud ulatuses; 6 6) oma ülesannete täitmiseks vajaliku koostöö tegemine teiste riigiasutuste, kohaliku omavalitsuse üksuste, eraõiguslike juriidiliste isikute, välisriikide asjaomaste ametiasutuste ja rahvusvaheliste organisatsioonidega oma pädevuse piires. RT I 2025-06-05 2 105062025002 2025-06-08 Ohutusjärelevalve osakonna põhiülesanded on: osakonna teenuste arendamine ning teenuste nõuetele vastavuse ja mõju hindamine; ohutegurite analüüs ja sellest tulenevalt ohutusjärelevalve valdkonna teenuste planeerimine; varjumise korraldamine ja koordineerimine ning järelevalve tegemine valdkonda reguleerivates õigusaktides sätestatud ulatuses; järelevalve tegemine toodete ja teenuste tuleohutusnõuetele vastavuse üle; tule- ja kemikaaliohutuse korraldamine ning koordineerimine tuleohutuse seaduses ja kemikaaliseaduses ning teistes valdkonda reguleerivates õigusaktides sätestatud ulatuses; oma ülesannete täitmiseks vajaliku koostöö tegemine teiste riigiasutuste, kohaliku omavalitsuse üksuste, eraõiguslike juriidiliste isikute, välisriikide asjaomaste ametiasutuste ja rahvusvaheliste organisatsioonidega oma pädevuse piires.",
      "rdfs:label": {
        "@value": "Reg_1026047_Par_16 (redaktsioon 1026047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026047",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026047",
      "estleg:sourceAct": "Päästeameti põhimäärus",
      "estleg:provisionRef": "Reg_1026047 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026047_Map"
      }
    },
    {
      "@id": "estleg:Reg_1026047_Par_17_v1026047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
