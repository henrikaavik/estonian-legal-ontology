      "estleg:provisionRef": "Reg_1026047 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026047_Map"
      }
    },
    {
      "@id": "estleg:Reg_1026047_Par_29_v1026047",
