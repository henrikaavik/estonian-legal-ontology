      "dc:source": "Kohtus riigi esindamise ja kohtumenetlusega riigile kaasnevate kulude kandmise kord"
    },
    {
      "@id": "estleg:Reg_1004359_Par_1_v1004359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1004359_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse tsiviilkohtumenetluses riigi kui menetlusosalise esindamise ja kriminaalasja kohtumenetluses riigi kui kannatanu või tsiviilkostja esindamise ning halduskohtumenetluses valitsusasutuse või valitsusasutuse hallatava riigiasutuse (edaspidi asutus) või selle ametniku esindamise (edaspidi kõik koos riigi esindamine) ja kohtumenetlusega riigile kaasnevate kulude kandmise kord. Määrusega kehtestatakse tsiviilkohtumenetluses riigi kui menetlusosalise esindamise ja kriminaalasja kohtumenetluses riigi kui kannatanu või tsiviilkostja esindamise ning halduskohtumenetluses valitsusasutuse või valitsusasutuse hallatava riigiasutuse (edaspidi asutus) või selle ametniku esindamise (edaspidi kõik koos riigi esindamine) ja kohtumenetlusega riigile kaasnevate kulude kandmise kord.",
      "rdfs:label": {
        "@value": "Reg_1004359_Par_1 (redaktsioon 1004359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1004359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1004359",
      "estleg:sourceAct": "Kohtus riigi esindamise ja kohtumenetlusega riigile kaasnevate kulude kandmise kord",
      "estleg:provisionRef": "Reg_1004359 § 1",
