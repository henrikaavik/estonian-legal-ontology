      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud « », mis on alla kirjutatud 1994. aasta 26. juulil Moskvas.",
      "rdfs:label": {
        "@value": "EVVFLVFRVEVT_Par_1 (redaktsioon 25041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25041"
    },
    {
      "@id": "estleg:EVVFLVFRVEVT_Par_2_v25041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVVFLVFRVEVT_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Deklareerida, et käesoleva seaduse paragrahvis 1 nimetatud Lepingu sõlmimine ei ole tõlgendatav õigusliku aluse loomisena NSV Liidu ja Vene Föderatsiooni relvajõudude viibimisele Eestis ning käsitleb üksnes vägede väljaviimist ajavahemikul 1994. aasta 26. juulist kuni 1994. aasta 31. augustini; käesoleva seaduse paragrahvis 1 nimetatud Lepingut rakendatakse 1994. aasta 26. juulil Eesti Vabariigi jurisdiktsioonile allunud territooriumil; relvajõudude väljaviimist mõistab Eesti Vabariik selliselt, et Vene Föderatsioon viib käesoleva seaduse paragrahvis 1 nimetatud Lepingus käsitletud territooriumilt välja kõik tema relvajõud ja nende koosseisu 1994. aasta 26. juuli seisuga kuulunud isikud ja nende perekonnaliikmed vastavalt Lepingu artikli 2 punktile 1, samuti isikud, kes viibisid Eestis hiljem Lepingu artikli 3 punkti 2 alapunktide 2.2 ja 2.3 alusel; Eesti Vabariigi jurisdiktsioonile alluvale territooriumile ei laiene Euroopa tavarelvastuse lepingust (CFE) tulenevad muude riikide õigused ja kohustused.",
      "rdfs:label": {
        "@value": "EVVFLVFRVEVT_Par_2 (redaktsioon 25041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25041"
    },
    {
      "@id": "estleg:EVVFLVFRVEVT_Par_3_v25041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVVFLVFRVEVT_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud « », mis on alla kirjutatud 1994. aasta 26. juulil Moskvas.",
      "rdfs:label": {
        "@value": "EVVFLVFRVEVT_Par_3 (redaktsioon 25041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25041"
    },
    {
      "@id": "estleg:EVVFLVFRVEVT_Par_4_v25041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EVVFLVFRVEVT_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Deklareerida, et sõjaväepensionäridena mõistab Eesti Vabariik isikuid, kes viibisid Eesti Vabariigi territooriumil, olid erru arvatud ning said pensioni ja toetust Vene Föderatsiooni vahendite arvelt enne käesoleva seaduse paragrahvis 3 nimetatud Kokkuleppe sõlmimist, s.o enne 1994. aasta 26. juulit ega pidanud Eestist lahkuma vastavalt Lepingule; sõjaväepensionäride, toitja kaotanud isikute ja perekonnaliikmete nimekirja iga-aastast täpsustamist mõistab Eesti Vabariik kui aasta jooksul Eestist lahkunud või surnud isikute väljaarvamist nimekirjast; käesoleva seaduse paragrahvis 3 nimetatud Kokkuleppe artiklis 6 sätestatud tsiviil- ja poliitilised õigused ning vabadused, samuti sotsiaalsed, majanduslikud ja kultuurilised õigused tagatakse kooskõlas inimõigusi käsitlevate rahvusvahelise õiguse üldtunnustatud normide ja Eesti Vabariigi põhiseadusega; käesoleva seaduse paragrahvis 3 nimetatud Kokkuleppe artikli 7 ja artikli 8 punkti 1 ellurakendamisel järgib Eesti Vabariik seadusi, mis kehtivad Eesti Vabariigi kodanike ja Eestis elavate välismaalaste suhtes.",
      "rdfs:label": {
        "@value": "EVVFLVFRVEVT_Par_4 (redaktsioon 25041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25041"
    }
  ]
}
