      },
      "estleg:versionValidTo": {
        "@value": "2022-11-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAPU_Par_76_v111112022002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAPU_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) GPS- või muu satelliitjälgimissüsteemi või videovalvesüsteemi paigaldamise või andmete esitamise korra rikkumise eest laeval nõutava GPS- või muu satelliitjälgimissüsteemi või videovalvesüsteemi puudumise või selle töö häirimise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "KALAPU_Par_76 (redaktsioon 111112022002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111112022002"
    },
    {
