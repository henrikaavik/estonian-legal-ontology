      },
      "estleg:versionText": "Käesolev seadus reguleerib suhteid kalapüügil ja veetaimede kogumisel. [Paragrahvi 1 sõnastus alates 1. 03. 2004]",
      "rdfs:label": {
        "@value": "KALAPU_Par_1 (redaktsioon 697899)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "697899",
