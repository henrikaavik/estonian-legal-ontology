    {
      "@id": "estleg:KALAPU_Par_62_v117032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAPU_Par_62"
