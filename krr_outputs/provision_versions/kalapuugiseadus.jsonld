      }
    },
    {
      "@id": "estleg:KALAPU_Par_22_v13118418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAPU_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eestis looduslikult mitteesinevate liikide eluskala või muid veeorganismide liike või nende viljastatud marja tohib maale tuua ainult Keskkonnaameti loal. (2) Kalade veekogudesse asustamise korra",
      "rdfs:label": {
        "@value": "KALAPU_Par_22 (redaktsioon 13118418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118418",
