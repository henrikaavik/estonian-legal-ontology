    {
      "@id": "estleg:KALAPU_Par_89_v117032015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAPU_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud väärtegude kohtuväline menetleja on Keskkonnainspektsioon. (2) Käesoleva seaduse §-des 74, 75, 78–82, 84 ja 85 nimetatud väärteo kohtuväline menetleja on ka politseiasutus. (3) Kohtuväline menetleja või kohus võib kohaldada käesoleva seaduse §-des 74, 75, 81–83, 85, 86 ja 88 sätestatud väärtegude toimepanemise vahendi ning väärteo vahetuks objektiks olnud eseme konfiskeerimist vastavalt karistusseadustiku §-le 83.",
      "rdfs:label": {
        "@value": "KALAPU_Par_89 (redaktsioon 117032015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KALAPU_Par_89_v110072020095"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KALAPU_Par_89_v110072020095",
