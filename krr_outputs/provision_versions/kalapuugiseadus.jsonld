    {
      "@id": "estleg:KALAPU_Par_20_v12769321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KALAPU_Par_20"
