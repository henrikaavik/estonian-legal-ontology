        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud järgima struktuuritoetuse seaduse § 21 lõikes 2 sätestatut. Taotleja on kohustatud järgima struktuuritoetuse seaduse § 21 lõikes 2 sätestatut.",
      "rdfs:label": {
        "@value": "Reg_1038922_Par_12 (redaktsioon 1038922)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038922",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038922",
      "estleg:sourceAct": "Turismiettevõtte uue ärimudeli rakendamise toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1038922 § 12",
