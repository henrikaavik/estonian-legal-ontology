    {
      "@id": "estleg:Reg_1038922_Par_8_v1038922",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038922_Par_8"
