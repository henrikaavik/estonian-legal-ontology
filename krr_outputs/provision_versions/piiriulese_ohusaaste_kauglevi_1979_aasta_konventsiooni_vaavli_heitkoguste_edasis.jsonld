      "estleg:versionValidFrom": {
        "@value": "2003-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühinemisel teatada, et vastavalt piiriülese õhusaaste kauglevi 1979. aasta konventsiooni väävli heitkoguste edasise vähendamise protokolli artikli 2 lõikele 2 võtab Eesti Vabariik kohustuse vähendada väävli heitkoguseid 2005. aastaks 35% võrra ja 2010. aastaks 40% võrra, võttes aluseks 1980. aasta taseme.",
      "rdfs:label": {
        "@value": "POKKVHEV1979_Par_2 (redaktsioon 603414)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "603414",
