        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_7_v754369",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
