  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_koolieelse_lasteasutuse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Koolieelse lasteasutuse seadus (212 versiooni)",
        "@language": "et"
      },
      "dc:source": "Koolieelse lasteasutuse seadus"
    },
    {
      "@id": "estleg:KELS_Par_1_v22444",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Koolieelne lasteasutus (edaspidi lasteasutus) on koolieast noorematele lastele hoidu ja alushariduse omandamist võimaldav õppeasutus. (2) Lasteasutus toetab lapse perekonda, soodustades lapse kasvamist ja arenemist ning tema individuaalsuse arvestamist.",
      "rdfs:label": {
        "@value": "KELS_Par_1 (redaktsioon 22444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22444"
    },
    {
      "@id": "estleg:KELS_Par_10_v22444",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valla- või linnavalitsus loob kõigile oma haldusterritooriumil elavatele lastele võimaluse käia teeninduspiirkonna järgses lasteasutuses. [Paragrahv 10 sõnastus alates 1. 07. 2002]",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 22444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22444",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v185456"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v185456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valla- või linnavalitsus loob kõigile oma haldusterritooriumil alaliselt elavatele lastele, kelle vanemad seda soovivad, võimaluse käia teeninduspiirkonna lasteasutuses.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 185456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185456",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v12744434"
      },
      "estleg:versionValidTo": {
        "@value": "2006-11-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v12744434",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-11-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus loob kõigile ühe- kuni seitsmeaastastele lastele, kelle elukoht on antud valla või linna haldusterritooriumil ning kelle vanemad seda soovivad, võimaluse käia teeninduspiirkonna lasteasutuses. (2) Käesolevas seaduses ja selle alusel antud määrustes käsitletakse isiku elukohana rahvastikuregistrisse kantud elukoha aadressi. Kui isikul ei ole registrijärgset elukohta, määratleb isik oma elukoha ise.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 12744434)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12744434",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v13153228"
      },
      "estleg:versionValidTo": {
        "@value": "2009-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v13153228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus loob kõigile pooleteise- kuni seitsmeaastastele lastele, kelle elukoht on antud valla või linna haldusterritooriumil ning kelle vanemad seda soovivad, võimaluse käia teeninduspiirkonna lasteasutuses. (2) Käesolevas seaduses ja selle alusel antud määrustes käsitletakse isiku elukohana rahvastikuregistrisse kantud elukoha aadressi. Kui isikul ei ole registrijärgset elukohta, määratleb isik oma elukoha ise.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 13153228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13153228",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v114032011006"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v114032011006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus loob kõigile pooleteise- kuni seitsmeaastastele lastele, kelle elukoht on antud valla või linna haldusterritooriumil ning kelle vanemad seda soovivad, võimaluse käia teeninduspiirkonna lasteasutuses. (2) Käesolevas seaduses ja selle alusel antud määrustes käsitletakse rahvastikuregistri objektiks oleva isiku elukohana rahvastikuregistrisse kantud elukoha aadressi. Kui isik ei ole rahvastikuregistri objekt, määratleb ta oma elukoha ise.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 114032011006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032011006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v120112014011"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v120112014011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus loob vanemate soovil kõigile pooleteise- kuni seitsmeaastastele lastele, kelle elukoht on selle valla või linna territooriumil ning ühtib vähemalt ühe vanema elukohaga, võimaluse käia teeninduspiirkonna lasteasutuses. Pooleteise- kuni kolmeaastase lapse lasteaiakoha võib valla- või linnavalitsus vanema nõusolekul asendada lapsehoiuteenusega, mille rahastamisele kohaldatakse käesoleva seaduse § 27 lõigetes 3 ja 4 sätestatut. (2) Valla- või linnavalitsus loob lapsele, kelle koolikohustuse täitmise alustamine on põhikooli- ja gümnaasiumiseaduse § 9 lõikes 3 nimetatud nõustamiskomisjoni soovitusel ühe õppeaasta võrra edasi lükatud, võimaluse käia lasteasutuses rühmas, mis on sätestatud käesoleva seaduse § 6 lõike 3 punktis 2 või lõikes 4, ning erivajadustega lapsele võimaluse käia lasteasutuses rühmas, mis on sätestatud käesoleva seaduse § 6 lõikes 6. (3) Käesolevas seaduses käsitatakse isiku elukohana Eesti rahvastikuregistrisse kantud elukoha aadressi. Asenduskodus või perekonnas hooldamisel viibiva lapse elukohaks loetakse asenduskodu või perekonna, kelle hooldamisel laps on, aadress.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 120112014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120112014011",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v128112017016"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v128112017016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus loob vanemate soovil kõigile pooleteise- kuni seitsmeaastastele lastele, kelle elukoht on selle valla või linna territooriumil ning ühtib vähemalt ühe vanema elukohaga, võimaluse käia teeninduspiirkonna lasteasutuses. Pooleteise- kuni kolmeaastase lapse lasteaiakoha võib valla- või linnavalitsus vanema nõusolekul asendada lapsehoiuteenusega, mille rahastamisele kohaldatakse käesoleva seaduse § 27 lõigetes 3 ja 4 sätestatut. (2) Valla- või linnavalitsus loob lapsele, kelle koolikohustuse täitmise alustamine on põhikooli- ja gümnaasiumiseaduse § 9 lõikes 3 nimetatud nõustamiskomisjoni soovitusel ühe õppeaasta võrra edasi lükatud, võimaluse käia lasteasutuses rühmas, mis on sätestatud käesoleva seaduse § 6 lõike 3 punktis 2 või lõikes 4, ning erivajadustega lapsele võimaluse käia lasteasutuses rühmas, mis on sätestatud käesoleva seaduse § 6 lõikes 6. (3) Käesolevas seaduses käsitatakse isiku elukohana Eesti rahvastikuregistrisse kantud elukoha aadressi. Asendushooldusel viibiva lapse elukohaks loetakse hoolduspere elukoht või perekodu või asenduskodu tegevuskoht.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 128112017016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128112017016",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_10_v122012018006"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_10_v122012018006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valla- või linnavalitsus loob vanemate soovil kõigile pooleteise- kuni seitsmeaastastele lastele, kelle elukoht on selle valla või linna territooriumil ning ühtib vähemalt ühe vanema elukohaga, võimaluse käia teeninduspiirkonna lasteasutuses. Pooleteise- kuni kolmeaastase lapse lasteaiakoha võib valla- või linnavalitsus vanema nõusolekul asendada lapsehoiuteenusega, mille rahastamisele kohaldatakse käesoleva seaduse § 27 lõigetes 3 ja 4 sätestatut. (2) Valla- või linnavalitsus loob lapsele, kelle koolikohustuse täitmise alustamine on põhikooli- ja gümnaasiumiseaduse § 9 lõikes 3 nimetatud koolivälise nõustamismeeskonna soovitusel ühe õppeaasta võrra edasi lükatud, võimaluse käia lasteasutuses rühmas, mis on sätestatud käesoleva seaduse § 6 lõike 3 punktis 2 või lõikes 4, ning erivajadustega lapsele võimaluse käia lasteasutuses rühmas, mis on sätestatud käesoleva seaduse § 6 lõikes 6. (3) Käesolevas seaduses käsitatakse isiku elukohana Eesti rahvastikuregistrisse kantud elukoha aadressi. Asendushooldusel viibiva lapse elukohaks loetakse hoolduspere elukoht või perekodu või asenduskodu tegevuskoht.",
      "rdfs:label": {
        "@value": "KELS_Par_10 (redaktsioon 122012018006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122012018006"
    },
    {
      "@id": "estleg:KELS_Par_11_v22444",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lasteasutuse asutab valla- või linnavalitsus kohaliku omavalitsuse volikogu otsusel ja haridusministri antud koolitusloa alusel. (2) Lasteasutuse asutamiseks ja tegevuseks on vajalikud: pedagoogid, kes vastavad haridusministri määrusega kehtestatud lasteasutuse pedagoogide kvalifikatsiooninõuetele; ruumid (hooned) ja maa-ala, mis on laste arenguks ja mänguks sobiva sisustusega ja vastavad sotsiaalministri kehtestatud tervisekaitse nõuetele ning õigusaktidega kehtestatud tuleohutuse ja päästealade nõuetele; lasteasutuse õppekava, mis vastab Vabariigi Valitsuse määrusega kinnitatud alushariduse raamõppekavale.",
      "rdfs:label": {
        "@value": "KELS_Par_11 (redaktsioon 22444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22444",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_11_v215578"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_11_v215578",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 12. 2002] (1) Lasteasutuse asutab valla- või linnavalitsus kohaliku omavalitsuse volikogu otsusel ja haridusministri antud koolitusloa alusel. [Lõike 1 sõnastus alates 1. 01. 2003] (1) Lasteasutuse asutab valla- või linnavalitsus kohaliku omavalitsuse volikogu otsusel ja haridus- ja teadusministri antud koolitusloa alusel. (2) Lasteasutuse asutamiseks ja tegevuseks on vajalikud: [Punkti 1 sõnastus kuni 31. 12. 2002] pedagoogid, kes vastavad haridusministri määrusega kehtestatud lasteasutuse pedagoogide kvalifikatsiooninõuetele; [Punkti 1 sõnastus alates 1. 01. 2003] pedagoogid, kes vastavad haridus- ja teadusministri määrusega kehtestatud lasteasutuse pedagoogide kvalifikatsiooninõuetele; ruumid (hooned) ja maa-ala, mis on laste arenguks ja mänguks sobiva sisustusega ja vastavad sotsiaalministri kehtestatud tervisekaitse nõuetele ning õigusaktidega kehtestatud tuleohutuse ja päästealade nõuetele; lasteasutuse õppekava, mis vastab Vabariigi Valitsuse määrusega kinnitatud alushariduse raamõppekavale.",
      "rdfs:label": {
        "@value": "KELS_Par_11 (redaktsioon 215578)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215578",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_11_v260170"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_11_v260170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_11"
      },
      "estleg:versionValidFrom": {
