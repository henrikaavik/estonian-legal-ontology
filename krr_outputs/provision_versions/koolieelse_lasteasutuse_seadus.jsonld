    },
    {
      "@id": "estleg:KELS_Par_23_v13343125",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lasteasutuse tervishoiutöötaja: jälgib laste tervist, lähtudes ja Vabariigi Valitsuse määrusega kehtestatud laste tervisekaitse ja tervise edendamise nõuetest ning informeerib lapse tervisehäiretest vanemaid ja lapse arsti; koostab lasteasutuse päevakavale kehtestatud nõuetele vastava lasteasutuse päevakava, mille kinnitab direktor; kontrollib laste toitlustamise vastavust sotsiaalministri määrusega kehtestatud laste toitlustamise nõuetele; nõustab vanemaid ja pedagooge lapse tervisega seotud küsimustes. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "KELS_Par_23 (redaktsioon 13343125)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13343125",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_23_v114032014056"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
