        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_31_v260170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riikliku järelevalve tulemused vormistatakse kontrollakti või õiendiga. Riikliku järelevalveorgani ettekirjutused on juhatajale täitmiseks kohustuslikud. (2) Kui juhataja ei nõustu riikliku järelevalveorgani tehtud ettekirjutusega, on tal õigus esitada vaie Haridus- ja Teadusministeeriumile kümne tööpäeva jooksul, arvates ettekirjutuse juhatajale teatavakstegemisest.",
      "rdfs:label": {
        "@value": "KELS_Par_31 (redaktsioon 260170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "260170",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_31_v1048191"
      },
      "estleg:versionValidTo": {
