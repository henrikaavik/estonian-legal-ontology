    {
      "@id": "estleg:KELS_Par_4_v22444",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lasteasutused jagunevad munitsipaal- ja eralasteasutusteks. (2) Käesolev seadus reguleerib munitsipaallasteasutuste tegevust. (3) Käesolevat seadust kohaldatakse eralasteasutustele ja eralasteaed-algkoolidele niivõrd, kuivõrd erakooliseadus (RT I 1998, 57, 859) ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "KELS_Par_4 (redaktsioon 22444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22444",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_4_v185456"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_4_v185456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KELS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lasteasutused jagunevad munitsipaal- ja eralasteasutusteks. (2) Käesolev seadus reguleerib munitsipaallasteasutuste tegevust. (3) Käesolevat seadust kohaldatakse eralasteasutustele ja eralasteaed-algkoolidele niivõrd, kuivõrd erakooliseadus (RT I 1998, 57, 859) ei sätesta teisiti. (4) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "KELS_Par_4 (redaktsioon 185456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185456",
      "estleg:supersededByVersion": {
        "@id": "estleg:KELS_Par_4_v12904181"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KELS_Par_4_v12904181",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
