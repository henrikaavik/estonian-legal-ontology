  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_osoonikihti_kahandavaid_aineid_sisaldavate_voi_nendel_ainete_t1036052_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevusnõuded (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevusnõuded"
    },
    {
      "@id": "estleg:Reg_1036052_Par_1_v1036052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036052_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevat määrust kohaldatakse osoonikihti kahandavaid aineid sisaldavate paiksete jahutus- ja kliimaseadmete, soojuspumpade või osoonikihti kahandavaid aineid sisaldavate mahutite (edaspidi mahutid) käitlemisega tegelevale isikule, ühtlasi sätestatakse pädevusnõuetele vastavust tõendavad dokumendid. Käesolevat määrust kohaldatakse osoonikihti kahandavaid aineid sisaldavate paiksete jahutus- ja kliimaseadmete, soojuspumpade või osoonikihti kahandavaid aineid sisaldavate mahutite (edaspidi mahutid) käitlemisega tegelevale isikule, ühtlasi sätestatakse pädevusnõuetele vastavust tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_1036052_Par_1 (redaktsioon 1036052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036052",
      "estleg:sourceAct": "Osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevusnõuded",
      "estleg:provisionRef": "Reg_1036052 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036052_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036052_Par_2_v1036052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036052_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käitlemine käesoleva määruse tähenduses on osoonikihti kahandavate ainete kogumine paiksetest jahutus- ja kliimaseadmetest, soojuspumpadest või mahutitest hooldus- ja remonditööde käigus või enne seadme kõrvaldamist ning külmaaine säilitamine mahutis. Käitlemine käesoleva määruse tähenduses on osoonikihti kahandavate ainete kogumine paiksetest jahutus- ja kliimaseadmetest, soojuspumpadest või mahutitest hooldus- ja remonditööde käigus või enne seadme kõrvaldamist ning külmaaine säilitamine mahutis. 2 (2) Lisaks käesoleva paragrahvi lõikes 1 sätestatule loetakse käitlemiseks osoonikihti kahandavaid aineid sisaldavate paiksete jahutus- ja kliimaseadmete või soojuspumpade: 1 1) jahutuskontuuri avamist, eelkõige süsteemi täitmist puhastatud või taastatud osoonikihti kahandava ainega seadme hooldus- või remonditööde käigus; 2 2) ühe või enama kontuuri või seadme osa eemaldamist; 3 3) kontrollimist, hooldamist ja remonti; 4 4) lekkekontrolli ja lekke kõrvaldamist. Lisaks käesoleva paragrahvi lõikes 1 sätestatule loetakse käitlemiseks osoonikihti kahandavaid aineid sisaldavate paiksete jahutus- ja kliimaseadmete või soojuspumpade: jahutuskontuuri avamist, eelkõige süsteemi täitmist puhastatud või taastatud osoonikihti kahandava ainega seadme hooldus- või remonditööde käigus; ühe või enama kontuuri või seadme osa eemaldamist; kontrollimist, hooldamist ja remonti; lekkekontrolli ja lekke kõrvaldamist.",
      "rdfs:label": {
        "@value": "Reg_1036052_Par_2 (redaktsioon 1036052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036052",
      "estleg:sourceAct": "Osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevusnõuded",
      "estleg:provisionRef": "Reg_1036052 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036052_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036052_Par_3_v1036052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036052_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Alla kolme kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid või soojuspumpasid tohib käidelda isik, kes on vähemalt: 1 1) põhiharidusega ja saanud jahutus- ning kliimaseadmete või soojuspumpade käitlemise ja lekete vältimise koolituse või 2 2) põhiharidusega ja omandanud alla kolme kilogrammi osoonikihti kahandavaid aineid sisaldavate seadmete käitlemise vähemalt aastase töökogemuse. Alla kolme kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid või soojuspumpasid tohib käidelda isik, kes on vähemalt: põhiharidusega ja saanud jahutus- ning kliimaseadmete või soojuspumpade käitlemise ja lekete vältimise koolituse või põhiharidusega ja omandanud alla kolme kilogrammi osoonikihti kahandavaid aineid sisaldavate seadmete käitlemise vähemalt aastase töökogemuse. 2 (2) Kolm või enam kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid, soojuspumpasid või mahuteid tohib käidelda isik, kes on: 1 1) lõpetanud kõrgkooli, rakenduskõrgkooli või kutsekooli külmaerialal või 2 2) lõpetanud kõrgkooli soojusenergeetika või elektroenergeetika erialal või 3 3) vähemalt põhiharidusega, kuid saanud jahutus- ja kliimaseadmete või soojuspumpade käitlemise ja lekete vältimise koolituse ning omandanud kolm või enam kilogrammi osoonikihti kahandavaid aineid sisaldavate jahutus- ja kliimaseadmete, soojuspumpade või mahutite käitlemise vähemalt aastase töökogemuse. Kolm või enam kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid, soojuspumpasid või mahuteid tohib käidelda isik, kes on: lõpetanud kõrgkooli, rakenduskõrgkooli või kutsekooli külmaerialal või lõpetanud kõrgkooli soojusenergeetika või elektroenergeetika erialal või vähemalt põhiharidusega, kuid saanud jahutus- ja kliimaseadmete või soojuspumpade käitlemise ja lekete vältimise koolituse ning omandanud kolm või enam kilogrammi osoonikihti kahandavaid aineid sisaldavate jahutus- ja kliimaseadmete, soojuspumpade või mahutite käitlemise vähemalt aastase töökogemuse.",
      "rdfs:label": {
        "@value": "Reg_1036052_Par_3 (redaktsioon 1036052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1036052",
      "estleg:sourceAct": "Osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevusnõuded",
      "estleg:provisionRef": "Reg_1036052 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1036052_Map"
      }
    },
    {
      "@id": "estleg:Reg_1036052_Par_4_v1036052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036052_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Alla kolme kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid või soojuspumpasid käitlev isik tõendab oma vastavust pädevusnõuetele seadme valdaja või omaniku nõudmisel, esitades käesoleva paragrahvi lõigetes 3 ja 4 nimetatud dokumendid. Alla kolme kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid või soojuspumpasid käitlev isik tõendab oma vastavust pädevusnõuetele seadme valdaja või omaniku nõudmisel, esitades käesoleva paragrahvi lõigetes 3 ja 4 nimetatud dokumendid. 2 (2) Kolm või enam kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid, soojuspumpasid või mahuteid käitlev isik tõendab oma vastavust pädevusnõuetele käesoleva paragrahvi lõigetes 5 ja 6 nimetatud dokumentide alusel. Kolm või enam kilogrammi osoonikihti kahandavaid aineid sisaldavaid paikseid jahutus- ja kliimaseadmeid, soojuspumpasid või mahuteid käitlev isik tõendab oma vastavust pädevusnõuetele käesoleva paragrahvi lõigetes 5 ja 6 nimetatud dokumentide alusel. 3 (3) Käesoleva määruse § 3 lõike 1 punktis 1 nimetatud juhul on pädevust tõendavateks dokumentideks põhiharidust ning asjaomast koolitust kinnitavad dokumendid. Käesoleva määruse § 3 lõike 1 punktis 1 nimetatud juhul on pädevust tõendavateks dokumentideks põhiharidust ning asjaomast koolitust kinnitavad dokumendid. 4 (4) Käesoleva määruse § 3 lõike 1 punktis 2 nimetatud juhul on pädevust tõendavateks dokumentideks põhiharidust ning erialast töökogemust kinnitavad dokumendid. Käesoleva määruse § 3 lõike 1 punktis 2 nimetatud juhul on pädevust tõendavateks dokumentideks põhiharidust ning erialast töökogemust kinnitavad dokumendid. 5 (5) Käesoleva määruse § 3 lõike 2 punktides 1 ja 2 nimetatud juhul on pädevust tõendavaks dokumendiks kõrgkooli, rakenduskõrgkooli või kutsekooli diplom. Käesoleva määruse § 3 lõike 2 punktides 1 ja 2 nimetatud juhul on pädevust tõendavaks dokumendiks kõrgkooli, rakenduskõrgkooli või kutsekooli diplom. 6 (6) Käesoleva määruse § 3 lõike 2 punktis 3 nimetatud juhul on pädevust tõendavateks dokumentideks põhiharidust, asjaomast koolitust ning erialast töökogemust kinnitavad dokumendid. Käesoleva määruse § 3 lõike 2 punktis 3 nimetatud juhul on pädevust tõendavateks dokumentideks põhiharidust, asjaomast koolitust ning erialast töökogemust kinnitavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_1036052_Par_4 (redaktsioon 1036052)",
        "@language": "et"
      },
