      }
    },
    {
      "@id": "estleg:VäetS_Par_36_v13329572",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VäetS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui käitleja ei nõustu järelevalveametniku ettekirjutuse, otsuse või toiminguga, võib ta esitada vaide järelevalveasutuse juhile või vaidlustada ettekirjutuse, otsuse või toimingu halduskohtus halduskohtumenetluse seadustikuga sätestatud tingimustel ja korras. (2) Ettekirjutuse vaidlustamine ei vabasta käitlejat ettekirjutuses esitatud nõuete täitmisest. (3) Ettekirjutuse täitmise tagamiseks võib järelevalveasutus rakendada sunniraha asendustäitmise ja sunniraha seaduses sätestatud korras. Sunniraha ülemmäär on 640 eurot.",
      "rdfs:label": {
        "@value": "VäetS_Par_36 (redaktsioon 13329572)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329572",
      "estleg:supersededByVersion": {
        "@id": "estleg:VäetS_Par_36_v129062014092"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VäetS_Par_36_v129062014092",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
