    },
    {
      "@id": "estleg:VäetS_Par_29_v22392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VäetS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vastavalt haldusõiguserikkumiste seadustikule on haldusõiguserikkumise protokolli koostamise ja halduskaristuse kohaldamise õigus Taimetoodangu Inspektsiooni peadirektoril, tema asetäitjal ning riiklikul inspektoril. (2) Käesoleva paragrahvi lõikes 1 nimetatud ametnikud võivad määrata rahatrahvi kuni 10 000 krooni. (3) Halduskohtunik võib määrata rahatrahvi käesoleva seaduse paragrahvis 30 ettenähtud ulatuses. (4) Menetlus haldusõiguserikkumise asjas toimub haldusõiguserikkumiste seadustikus sätestatud korras, kui käesolevast seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "VäetS_Par_29 (redaktsioon 22392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22392",
      "estleg:supersededByVersion": {
        "@id": "estleg:VäetS_Par_29_v606815"
      },
      "estleg:versionValidTo": {
        "@value": "2003-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VäetS_Par_29_v606815",
