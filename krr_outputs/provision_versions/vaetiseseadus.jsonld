        "@language": "et"
      },
      "estleg:versionRedactionId": "13329572"
    },
    {
      "@id": "estleg:VäetS_Par_47_v606815",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VäetS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2003. aasta 1. septembril. (2) Käesoleva seaduse § 21 lõige 2 jõustub Eesti liitumisel Euroopa Liiduga.",
      "rdfs:label": {
        "@value": "VäetS_Par_47 (redaktsioon 606815)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "606815"
    },
    {
      "@id": "estleg:VäetS_Par_5_v22392",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VäetS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kandmise ja registrikannete muutmise, samuti registrikannetest tehtavate väljavõtete eest tasutakse riigilõivu riigilõivuseaduses ( ) sätestatud ulatuses ja korras.",
      "rdfs:label": {
        "@value": "VäetS_Par_5 (redaktsioon 22392)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22392",
      "estleg:supersededByVersion": {
        "@id": "estleg:VäetS_Par_5_v191887"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VäetS_Par_5_v191887",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VäetS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kandmise ja registrikannete muutmise, samuti registrikannetest tehtavate väljavõtete eest tasutakse riigilõivu riigilõivuseaduses ( RT I 1997, 80, 1344) sätestatud ulatuses ja korras.",
      "rdfs:label": {
        "@value": "VäetS_Par_5 (redaktsioon 191887)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191887",
      "estleg:supersededByVersion": {
        "@id": "estleg:VäetS_Par_5_v606815"
      },
      "estleg:versionValidTo": {
        "@value": "2003-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VäetS_Par_5_v606815",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VäetS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väetise turustamine käesoleva seaduse tähenduses on nii väetise müügiks pakkumine, müümine kui ka muul viisil tasuta või tasu eest tarbijale või teisele käitlejale üleandmine.",
      "rdfs:label": {
        "@value": "VäetS_Par_5 (redaktsioon 606815)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "606815"
    },
    {
