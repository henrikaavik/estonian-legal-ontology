      "estleg:provisionRef": "Reg_1043281 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043281_Par_11_v1043281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043281_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui isik on läbinud täienduskoolituse enne käesoleva määruse jõustumist ja esitab eksami sooritamise taotluse pärast käesoleva määruse jõustumist, peab koolitaja esitama Maanteeametile andmed läbitud koolituse liigi kohta. Kui isik on läbinud täienduskoolituse enne käesoleva määruse jõustumist ja esitab eksami sooritamise taotluse pärast käesoleva määruse jõustumist, peab koolitaja esitama Maanteeametile andmed läbitud koolituse liigi kohta.",
