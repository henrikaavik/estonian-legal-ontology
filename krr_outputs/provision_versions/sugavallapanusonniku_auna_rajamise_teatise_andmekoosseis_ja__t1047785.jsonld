    {
      "@id": "estleg:Reg_1047785_Par_4_v1047785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047785_Par_4"
