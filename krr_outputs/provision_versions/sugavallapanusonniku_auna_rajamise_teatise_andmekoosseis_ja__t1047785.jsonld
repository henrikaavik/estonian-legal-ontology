    {
      "@id": "estleg:Reg_1047785_Par_6_v1047785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047785_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni veeseaduse § 165 lõikes 3 ja § 166 lõikes 4 nimetatud infosüsteemi valmimiseni teavitatakse Keskkonnaametit sügavallapanusõnniku auna rajamisest kirjalikus vormis. Kuni veeseaduse § 165 lõikes 3 ja § 166 lõikes 4 nimetatud infosüsteemi valmimiseni teavitatakse Keskkonnaametit sügavallapanusõnniku auna rajamisest kirjalikus vormis.",
      "rdfs:label": {
        "@value": "Reg_1047785_Par_6 (redaktsioon 1047785)",
        "@language": "et"
      },
