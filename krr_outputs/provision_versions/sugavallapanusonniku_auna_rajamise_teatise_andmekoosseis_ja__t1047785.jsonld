      },
      "dc:source": "Sügavallapanusõnniku auna rajamise teatise andmekoosseis ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_1047785_Par_1_v1047785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047785_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse sügavallapanusõnniku hoidmiseks või kompostimiseks auna rajamise ja nende asukoha teatise esitamise kord. RT I 2022-01-21 10 121012022010 2022-01-24 Määrusega kehtestatakse sügavallapanusõnniku hoidmiseks või kompostimiseks auna rajamise ja nende asukoha teatise esitamise kord.",
      "rdfs:label": {
        "@value": "Reg_1047785_Par_1 (redaktsioon 1047785)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047785",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047785",
      "estleg:sourceAct": "Sügavallapanusõnniku auna rajamise teatise andmekoosseis ja esitamise kord",
      "estleg:provisionRef": "Reg_1047785 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047785_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047785_Par_2_v1047785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047785_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veeseaduse § 165 lõike 3 alusel sügavallapanusõnniku auna rajamisest ja selle asukohast ning veeseaduse § 166 lõike 4 alusel sügavallapanusõnniku kompostimiseks auna rajamisest ja selle asukohast tuleb teavitada Keskkonnaametit, esitades teatise enne aunastamise alustamist keskkonnaotsuste infosüsteemi kaudu. RT I 2025-09-05 16 105092025016 2025-09-08 Veeseaduse § 165 lõike 3 alusel sügavallapanusõnniku auna rajamisest ja selle asukohast ning veeseaduse § 166 lõike 4 alusel sügavallapanusõnniku kompostimiseks auna rajamisest ja selle asukohast tuleb teavitada Keskkonnaametit, esitades teatise enne aunastamise alustamist keskkonnaotsuste infosüsteemi kaudu. 2 (2) Sügavallapanusõnniku hoidmiseks ja kompostimiseks auna rajamise teatises esitatakse järgmised andmed: 1 1) sõnniku aunas hoidmist või kompostimist kavandava isiku nimi ja registrikood või isikukood; 2 2) sõnniku aunas hoidmist või kompostimist kavandava isiku asukoha või elukoha aadress, e-posti aadress ja telefoninumber; 3 3) põllumassiivi tunnus, kuhu sügavallapanusõnniku põlluaun kavandatakse; 4 4) auna või komposti veetava sügavallapanusõnniku kavandatav kogus; 5 5) sügavallapanusõnniku auna moodustamise kavandatav alguskuupäev; 6 6) sügavallapanusõnniku kavandatav laotusaeg; 7 7) kavandatava sügavallapanusõnniku auna asukoht Eesti põhikaardil, sealhulgas auna keskpunkti koordinaadid; 8 8) kompostitavast sügavallapanusõnnikust võetud proovi kuivainesisaldus lähtuvalt veeseaduse § 166 lõikes 3 sätestatust; 9 9) teatise esitamise kuupäev. Sügavallapanusõnniku hoidmiseks ja kompostimiseks auna rajamise teatises esitatakse järgmised andmed: sõnniku aunas hoidmist või kompostimist kavandava isiku nimi ja registrikood või isikukood; sõnniku aunas hoidmist või kompostimist kavandava isiku asukoha või elukoha aadress, e-posti aadress ja telefoninumber; põllumassiivi tunnus, kuhu sügavallapanusõnniku põlluaun kavandatakse; auna või komposti veetava sügavallapanusõnniku kavandatav kogus; sügavallapanusõnniku auna moodustamise kavandatav alguskuupäev; sügavallapanusõnniku kavandatav laotusaeg; kavandatava sügavallapanusõnniku auna asukoht Eesti põhikaardil, sealhulgas auna keskpunkti koordinaadid; kompostitavast sügavallapanusõnnikust võetud proovi kuivainesisaldus lähtuvalt veeseaduse § 166 lõikes 3 sätestatust; teatise esitamise kuupäev.",
      "rdfs:label": {
        "@value": "Reg_1047785_Par_2 (redaktsioon 1047785)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047785",
