      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Finantsinspektsioonile esitatavate krediidiinkasso ning välisriigi krediidiinkasso filiaali aruannete vormid, koostamise metoodika ja esitamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Finantsinspektsioonile esitatavate krediidiinkasso ning välisriigi krediidiinkasso filiaali aruannete vormid, koostamise metoodika ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_1060528_Par_1_v1060528",
      "@type": [
