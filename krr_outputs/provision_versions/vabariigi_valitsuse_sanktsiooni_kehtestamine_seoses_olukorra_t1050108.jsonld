    },
    {
      "@id": "estleg:Reg_1050108_Par_2_v1050108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050108_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sissesõidukeeldu kohaldatakse rahvusvahelise sanktsiooni seaduse § 27 lõike 2 alusel antud välisministri käskkirjas loetletud isikute suhtes, kelle kohta on andmeid või on põhjendatud alust arvata, et nad vastutavad valimistulemuste võltsimise, vägivalla või inimõiguste rikkumise eest Valgevenes või on aidanud sellele kaasa. Sissesõidukeeldu kohaldatakse rahvusvahelise sanktsiooni seaduse § 27 lõike 2 alusel antud välisministri käskkirjas loetletud isikute suhtes, kelle kohta on andmeid või on põhjendatud alust arvata, et nad vastutavad valimistulemuste võltsimise, vägivalla või inimõiguste rikkumise eest Valgevenes või on aidanud sellele kaasa.",
      "rdfs:label": {
        "@value": "Reg_1050108_Par_2 (redaktsioon 1050108)",
        "@language": "et"
      },
