    {
      "@id": "estleg:Reg_1002201_Par_15_v1002201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002201_Par_15"
      },
