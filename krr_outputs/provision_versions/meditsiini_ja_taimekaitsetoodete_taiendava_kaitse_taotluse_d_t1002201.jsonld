      "estleg:provisionRef": "Reg_1002201 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002201_Map"
      }
    },
    {
      "@id": "estleg:Reg_1002201_Par_7_v1002201",
      "@type": [
