        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_10_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei I klassi teeneterist koosneb rinnalindist ja 40-millimeetrise läbimõõduga ristist. Kullatud äärisega valgel emailitud ristil on hõbedane politsei vapilõvi 14-millimeetrise läbimõõduga kullatud äärisega valgel litril. Teeneteristi kujutis on esitatud käesoleva määruse lisas 1. Politsei I klassi teeneterist koosneb rinnalindist ja 40-millimeetrise läbimõõduga ristist. Kullatud äärisega valgel emailitud ristil on hõbedane politsei vapilõvi 14-millimeetrise läbimõõduga kullatud äärisega valgel litril. Teeneteristi kujutis on esitatud käesoleva määruse lisas 1. 2 (2) Politsei teeneteristi rinnalint on 35 millimeetri laiune sinine muareelint hõbedaste niitidega koos kahe 3 millimeetri laiuse hõbedase teibaga. Lindile on paigutatud 22-millimeetrise läbimõõduga kuldne rullmärk. Politsei teeneteristi rinnalint on 35 millimeetri laiune sinine muareelint hõbedaste niitidega koos kahe 3 millimeetri laiuse hõbedase teibaga. Lindile on paigutatud 22-millimeetrise läbimõõduga kuldne rullmärk.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_10 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
