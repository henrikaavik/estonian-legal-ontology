    {
      "@id": "estleg:Reg_1031488_Par_23_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei teenetemärgi lindilõige on vastava teenetemärgi 11 millimeetri kõrgune lindi osa, millele võib kinnitada rullmärgi, naastu või mõõgad. Lindilõike kujutis on esitatud käesoleva määruse lisas 5. RT I 2017-10-10 4 110102017004 2017-10-13 , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal. Politsei teenetemärgi lindilõige on vastava teenetemärgi 11 millimeetri kõrgune lindi osa, millele võib kinnitada rullmärgi, naastu või mõõgad. Lindilõike kujutis on esitatud käesoleva määruse lisas 5. , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal. 2 (2) Politsei teeneteristi I klassi lindilõikel on kuldne, II klassi lindilõikel on hõbedane ning kuldmedali lindilõikel on sinine rullmärk. Politsei teeneteristi I klassi lindilõikel on kuldne, II klassi lindilõikel on hõbedane ning kuldmedali lindilõikel on sinine rullmärk. 3 (3) Erilise vapruse ja ennastsalgavuse tunnustamiseks antavale teeneteristi lindilõikele lisatakse kaks ristuvat hõbemõõka. Erilise vapruse ja ennastsalgavuse tunnustamiseks antavale teeneteristi lindilõikele lisatakse kaks ristuvat hõbemõõka.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_23 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 23",
