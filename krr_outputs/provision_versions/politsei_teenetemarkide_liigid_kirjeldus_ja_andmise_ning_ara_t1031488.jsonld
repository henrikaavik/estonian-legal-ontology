    {
      "@id": "estleg:Reg_1031488_Par_24_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei teeneteristiga autasustatakse politseiametnikku teenistusülesannete silmapaistvalt hea täitmise eest, sealhulgas erilise vapruse eest teenistuskohustuste täitmisel. Politsei teeneteristiga autasustatakse politseiametnikku teenistusülesannete silmapaistvalt hea täitmise eest, sealhulgas erilise vapruse eest teenistuskohustuste täitmisel. 2 (2) Iga klassi teeneterist antakse ühel korral. Iga klassi teeneterist antakse ühel korral. 3 (3) Isikut, keda on autasustatud politsei teeneteristiga, võidakse samalaadsete teenete eest esitada politsei teeneteristiga autasustamiseks üldjuhul pärast viie aasta möödumist ning erilaadsete teenete eest pärast kolme aasta möödumist eelmisest politsei teeneteristiga autasustamisest arvates. Isikut, keda on autasustatud politsei teeneteristiga, võidakse samalaadsete teenete eest esitada politsei teeneteristiga autasustamiseks üldjuhul pärast viie aasta möödumist ning erilaadsete teenete eest pärast kolme aasta möödumist eelmisest politsei teeneteristiga autasustamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_24 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_25_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveameti, Põhja prefektuuri, Ida prefektuuri, Lõuna prefektuuri ja Lääne prefektuuri teenetemärgiga autasustatakse: 1 1) inimeste ja vara suurema turvalisuse ning riigi suurema julgeoleku tagamise, keskkonnakahjuga seotud õnnetustele reageerimise või selleks võimekuse loomise, kodakondsus- ja migratsioonipoliitika arendamise, samuti organisatsiooni arendamise eest; 2 2) olulise panuse eest politsei arendamisel, politsei maine tõstmisel, politsei põhiväärtuste edendamisel, politseitöö tõhususe tõstmisel või oskusliku tegutsemise eest kriisi- või ootamatus ja eriti ohtlikus olukorras. Politsei- ja Piirivalveameti, Põhja prefektuuri, Ida prefektuuri, Lõuna prefektuuri ja Lääne prefektuuri teenetemärgiga autasustatakse: inimeste ja vara suurema turvalisuse ning riigi suurema julgeoleku tagamise, keskkonnakahjuga seotud õnnetustele reageerimise või selleks võimekuse loomise, kodakondsus- ja migratsioonipoliitika arendamise, samuti organisatsiooni arendamise eest; olulise panuse eest politsei arendamisel, politsei maine tõstmisel, politsei põhiväärtuste edendamisel, politseitöö tõhususe tõstmisel või oskusliku tegutsemise eest kriisi- või ootamatus ja eriti ohtlikus olukorras.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_25 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_26_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) 10-aastase teenistuse eest, 20-aastase teenistuse eest või 30-aastase teenistuse eest antakse politsei teenistusrist politseiametnikule, kes on olnud teenistuses politseis, piirivalves, Sisekaitseakadeemias, Kaitsepolitseiametis, Kodakondsus- ja Migratsiooniametis või Eesti Vabariigi Kohtueelse Uurimise Ametis kalendriaasta 1. jaanuariks vastavalt 10, 20 või 30 aastat. RT I 2017-10-10 4 110102017004 2017-10-13 , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal. 10-aastase teenistuse eest, 20-aastase teenistuse eest või 30-aastase teenistuse eest antakse politsei teenistusrist politseiametnikule, kes on olnud teenistuses politseis, piirivalves, Sisekaitseakadeemias, Kaitsepolitseiametis, Kodakondsus- ja Migratsiooniametis või Eesti Vabariigi Kohtueelse Uurimise Ametis kalendriaasta 1. jaanuariks vastavalt 10, 20 või 30 aastat. , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal. 1 (1¹) Käesoleva paragrahvi lõikes 1 sätestatud 10-aastase teenistuse, 20-aastase teenistuse või 30-aastase teenistuse tähtaega võib erandkorras arvestada ka käesoleva paragrahvi lõikes 1 nimetatust erineva seisuga. RT I 2021-02-17 1 117022021001 2021-03-01 Käesoleva paragrahvi lõikes 1 sätestatud 10-aastase teenistuse, 20-aastase teenistuse või 30-aastase teenistuse tähtaega võib erandkorras arvestada ka käesoleva paragrahvi lõikes 1 nimetatust erineva seisuga. 2 (2) Politsei teenistusrist antakse teenistuses olevale politseiametnikule. Politsei teenistusrist antakse teenistuses olevale politseiametnikule.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_26 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 26",
