    {
      "@id": "estleg:Reg_1031488_Par_14_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erilise vapruse ja ennastsalgavuse tunnustamiseks antavale politsei teeneteristile lisatakse kaks ristatud tõstetud kullatud või hõbetatud mõõka. Erilise vapruse ja ennastsalgavuse tunnustamiseks antavale politsei teeneteristile lisatakse kaks ristatud tõstetud kullatud või hõbetatud mõõka. 2 (2) I ja II klassi teeneteristi mõõga pikkus koos käepidemega on teeneteristil 23 millimeetrit ning kuld- ja hõbemedalil 20 millimeetrit. I ja II klassi teeneteristi mõõga pikkus koos käepidemega on teeneteristil 23 millimeetrit ning kuld- ja hõbemedalil 20 millimeetrit.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_14 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_15_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei- ja Piirivalveameti teenetemärk koosneb rinnalindist ja 40-millimeetrise läbimõõduga käppristist. Kullatud äärisega valgel emailitud käppristil on 15 millimeetri kõrgune tasapinnaline politseivapp. Ristiharude vahel on kuldsed kiirtekimbud. Teenetemärgi revers on kuldne ja sellele graveeritakse teenetemärgi number. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 2. Politsei- ja Piirivalveameti teenetemärk koosneb rinnalindist ja 40-millimeetrise läbimõõduga käppristist. Kullatud äärisega valgel emailitud käppristil on 15 millimeetri kõrgune tasapinnaline politseivapp. Ristiharude vahel on kuldsed kiirtekimbud. Teenetemärgi revers on kuldne ja sellele graveeritakse teenetemärgi number. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 2. 2 (2) Rinnalint on 35 millimeetri laiune sinine muareelint kahe 8 millimeetri laiuse halli teiba ja 22-millimeetrise läbimõõduga sinise rullmärgiga. Rinnalint on 35 millimeetri laiune sinine muareelint kahe 8 millimeetri laiuse halli teiba ja 22-millimeetrise läbimõõduga sinise rullmärgiga.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_15 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_16_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Põhja prefektuuri teenetemärk koosneb ristist ja rinnalindist. Rist on samasugune kui Politsei- ja Piirivalveameti teenetemärgi rist. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 2. Põhja prefektuuri teenetemärk koosneb ristist ja rinnalindist. Rist on samasugune kui Politsei- ja Piirivalveameti teenetemärgi rist. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 2. 2 (2) Rinnalint on 35 millimeetri laiune hall muareelint kahe 8 millimeetri laiuse musta teibaga. Rinnalint on 35 millimeetri laiune hall muareelint kahe 8 millimeetri laiuse musta teibaga.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_16 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_17_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ida prefektuuri teenetemärk koosneb rinnalindist ja ristist. Rist on samasugune nagu Politsei- ja Piirivalveameti teenetemärgi rist. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 2. Ida prefektuuri teenetemärk koosneb rinnalindist ja ristist. Rist on samasugune nagu Politsei- ja Piirivalveameti teenetemärgi rist. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 2. 2 (2) Rinnalint on 35 millimeetri laiune hall muareelint kahe 8 millimeetri laiuse sinise teibaga. Rinnalint on 35 millimeetri laiune hall muareelint kahe 8 millimeetri laiuse sinise teibaga.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_17 (redaktsioon 1031488)",
        "@language": "et"
      },
