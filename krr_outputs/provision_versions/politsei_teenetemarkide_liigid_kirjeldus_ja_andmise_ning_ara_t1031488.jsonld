    {
      "@id": "estleg:Reg_1031488_Par_22_24_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_22_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Abipolitseiniku teenetemärk koosneb rinnalindist ja sõõrikujulisest 35-millimeetrise läbimõõduga punasest vasest medalist. Medali keskel on käpprist, millel 12-millimeetri kõrgune tasapinnaline politseivapp. Käppristi ümbritseb 5-millimeetrine sõõr, millel on kaks loorberioksa ja tähed AP. Teenetemärgi tagaküljele graveeritakse teenetemärgi number. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 4. Abipolitseiniku teenetemärk koosneb rinnalindist ja sõõrikujulisest 35-millimeetrise läbimõõduga punasest vasest medalist. Medali keskel on käpprist, millel 12-millimeetri kõrgune tasapinnaline politseivapp. Käppristi ümbritseb 5-millimeetrine sõõr, millel on kaks loorberioksa ja tähed AP. Teenetemärgi tagaküljele graveeritakse teenetemärgi number. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 4. 2 (2) Abipolitseiniku teenetemärgi rinnalint on 35-millimeetri laiune hall muareelint kahe 11,5-millimeetri laiuse oranži triibuga. RT I 2017-10-10 4 110102017004 2017-10-13 , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal. Abipolitseiniku teenetemärgi rinnalint on 35-millimeetri laiune hall muareelint kahe 11,5-millimeetri laiuse oranži triibuga. , rakendatakse tagasiulatuvalt alates 1. oktoobrist 2017. aastal.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_22_24 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031488",
      "estleg:sourceAct": "Politsei teenetemärkide liigid, kirjeldus ja andmise ning äravõtmise kord",
      "estleg:provisionRef": "Reg_1031488 § 22_24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031488_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031488_Par_22_25_v1031488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031488_Par_22_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) 5-aastase tegevuse eest antav abipolitseiniku teenistusrist koosneb rinnalindist ja 40 millimeetrise läbimõõduga raudjast ristist. Ristil on 14 millimeetri kõrgune tasapinnaline politseivapp. Teenistusristi kujutis on esitatud käesoleva määruse lisas 6. 5-aastase tegevuse eest antav abipolitseiniku teenistusrist koosneb rinnalindist ja 40 millimeetrise läbimõõduga raudjast ristist. Ristil on 14 millimeetri kõrgune tasapinnaline politseivapp. Teenistusristi kujutis on esitatud käesoleva määruse lisas 6. 2 (2) 5-aastase tegevuse eest antava abipolitseiniku teenistusristi rinnalint on 35 millimeetri laiune sinine muareelint ühe 2 millimeetri laiuse halli vardaga. RT I 2024-04-10 1 110042024001 2024-04-13 5-aastase tegevuse eest antava abipolitseiniku teenistusristi rinnalint on 35 millimeetri laiune sinine muareelint ühe 2 millimeetri laiuse halli vardaga.",
      "rdfs:label": {
        "@value": "Reg_1031488_Par_22_25 (redaktsioon 1031488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031488",
