    {
      "@id": "estleg:Reg_157742_Par_6_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi aadress on Islandi väljak 1, 15049 Tallinn. Kui ministeeriumi struktuuriüksus ei asu Tallinnas, märgitakse struktuuriüksuse asukoht struktuuriüksuse põhimääruses. RT I 2016-11-17 1 117112016001 2016-12-01 Ministeeriumi aadress on Islandi väljak 1, 15049 Tallinn. Kui ministeeriumi struktuuriüksus ei asu Tallinnas, märgitakse struktuuriüksuse asukoht struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_6 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_7_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumi valitsemisalas on ettepanekute tegemine riigi välispoliitika kavandamiseks, välislepingute ja välismajandusega seotud küsimuste lahendamine, Eesti seisukohtade kaitsmise tagamine Euroopa Liidu üldasjade nõukogus ja välisasjade nõukogus ning Euroopa Liidu Nõukogu alaliste esindajate komitees, Eesti esindamise korraldamine Euroopa Inimõiguste Kohtus, Euroopa Liidu Kohtus, Euroopa Vabakaubandusühenduse Kohtus ja teistes vaidluste lahendamise rahvusvahelistes institutsioonides, Eesti suhtlemise korraldamine välisriikide ja rahvusvaheliste organisatsioonidega, rahvusvahelistel tsiviilmissioonidel osalemise koordineerimine, sise- ja välisprotokolli korraldamine riiklike tähtpäevade tähistamisel ning riiklikult oluliste välisvisiitide läbiviimisel ja kõrgete külaliste vastuvõtmisel, Eesti riigi ja kodanike huvide kaitsmine välisriikides, üleilmsete eesti kogukondade kaasamine, rahvusvahelise arengu- ja humanitaarabi andmise korraldamine, rahvusvahelise koostöö arendamine küberturvalisuse valdkonnas, Eesti tutvustamine ning asjaomaste õigusaktide eelnõude koostamine. Ministeeriumi välissuhtlemispädevus on sätestatud välissuhtlemisseaduses. RT I 2021-02-26 10 126022021010 2021-03-01 Ministeeriumi valitsemisalas on ettepanekute tegemine riigi välispoliitika kavandamiseks, välislepingute ja välismajandusega seotud küsimuste lahendamine, Eesti seisukohtade kaitsmise tagamine Euroopa Liidu üldasjade nõukogus ja välisasjade nõukogus ning Euroopa Liidu Nõukogu alaliste esindajate komitees, Eesti esindamise korraldamine Euroopa Inimõiguste Kohtus, Euroopa Liidu Kohtus, Euroopa Vabakaubandusühenduse Kohtus ja teistes vaidluste lahendamise rahvusvahelistes institutsioonides, Eesti suhtlemise korraldamine välisriikide ja rahvusvaheliste organisatsioonidega, rahvusvahelistel tsiviilmissioonidel osalemise koordineerimine, sise- ja välisprotokolli korraldamine riiklike tähtpäevade tähistamisel ning riiklikult oluliste välisvisiitide läbiviimisel ja kõrgete külaliste vastuvõtmisel, Eesti riigi ja kodanike huvide kaitsmine välisriikides, üleilmsete eesti kogukondade kaasamine, rahvusvahelise arengu- ja humanitaarabi andmise korraldamine, rahvusvahelise koostöö arendamine küberturvalisuse valdkonnas, Eesti tutvustamine ning asjaomaste õigusaktide eelnõude koostamine. Ministeeriumi välissuhtlemispädevus on sätestatud välissuhtlemisseaduses.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_7 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_8_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium oma pädevuse piires: 1 1) kavandab ja teostab välispoliitikat ning korraldab ja koordineerib välissuhtlemist; RT I 2016-11-17 1 117112016001 2016-12-01 2 2) töötab koos asjaomaste ministeeriumidega välja julgeoleku- ja välismajanduspoliitika põhisuundi ja teostab neid; 3 3) koostab välissuhtlemist käsitlevate avalduste, deklaratsioonide ja pöördumiste eelnõud; 4 4) teeb Vabariigi Valitsusele ettepanekuid rakendada rahvusvahelist sanktsiooni ning koostab vajalikud eelnõud; 5 5) teeb Vabariigi Valitsusele ettepanekuid Eesti diplomaatiliste esinduste asutamise ja sulgemise kohta, avab ja sulgeb Eesti konsulaarasutusi. Ministeerium oma pädevuse piires: kavandab ja teostab välispoliitikat ning korraldab ja koordineerib välissuhtlemist; töötab koos asjaomaste ministeeriumidega välja julgeoleku- ja välismajanduspoliitika põhisuundi ja teostab neid; koostab välissuhtlemist käsitlevate avalduste, deklaratsioonide ja pöördumiste eelnõud; teeb Vabariigi Valitsusele ettepanekuid rakendada rahvusvahelist sanktsiooni ning koostab vajalikud eelnõud; teeb Vabariigi Valitsusele ettepanekuid Eesti diplomaatiliste esinduste asutamise ja sulgemise kohta, avab ja sulgeb Eesti konsulaarasutusi.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_8 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_9_v157742",
      "@type": [
        "owl:NamedIndividual",
