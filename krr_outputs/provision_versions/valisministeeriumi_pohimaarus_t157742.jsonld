    {
      "@id": "estleg:Reg_157742_Par_22_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministrit asendatakse Vabariigi Valitsuse seaduse kohaselt. RT I 2016-11-17 1 117112016001 2016-12-01 Ministrit asendatakse Vabariigi Valitsuse seaduse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_22 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_23_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kantsler juhib ministeeriumi struktuuriüksuste tööd, välja arvatud siseauditi osakond, ning korraldab ministeeriumi asjaajamist. RT I 2016-11-17 1 117112016001 2016-12-01 Kantsler juhib ministeeriumi struktuuriüksuste tööd, välja arvatud siseauditi osakond, ning korraldab ministeeriumi asjaajamist.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_23 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_24_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kantsler: 1 1) esindab ministeeriumi oma teenistuskohustuste täitmisega seotud, ministrilt saadud või seadusega antud volituste piires või volitab oma pädevuse piires ministeeriumi teenistujaid esindama ministeeriumi; RT I 2016-11-17 1 117112016001 2016-12-01 2 2) juhib asekantslereid, välisesinduste juhte, talle vahetult alluvaid peadirektoreid ja nõunikke ning asekantslerite ja peadirektorite kaudu osakondi; RT I 2016-11-17 1 117112016001 2016-12-01 3 3) tagab töödistsipliini ning ministeeriumi ülesannete õigeaegse ja majanduslikult säästliku lahendamise; 4 4) koordineerib ministeeriumi aastaeelarve eelnõu ja vajaduse korral lisaeelarve eelnõu koostamist; 5 5) korraldab ministeeriumi eelarvevahendite sihipärast jaotamist ja kasutamist; 6 6) korraldab riigivara säilimist ja kasutamist ministrilt saadud volituste piires riigivaraseaduse kohaselt ning teeb ministrile ettepanekuid riigivara käsutamise kohta; RT I 2016-11-17 1 117112016001 2016-12-01 7 7) tagab ministeeriumi tegevuseks vajalikud organisatsioonilised ja majanduslikud tingimused; 8 8) koordineerib vajaduse korral suhtlemist teiste valitsusasutustega, et täita ministeeriumi ülesandeid; 9 9) kehtetu - RT I 2016-11-17 1 117112016001 2016-12-01 10 10) kehtetu - RT I 2016-11-17 1 117112016001 2016-12-01 11 11) nimetab ametikohale ja vabastab ametikohalt ministeeriumi ametnikud, kui ametniku ametikohale nimetamine ei ole ministri pädevuses; RT I 2016-11-17 1 117112016001 2016-12-01 12 12) sõlmib, muudab ja lõpetab töölepingud ministeeriumi töötajatega, kui töötajaga töölepingu sõlmimine ei ole ministri pädevuses; RT I 2016-11-17 1 117112016001 2016-12-01 13 13) kinnitab punktides 11 ja 12 nimetatud teenistujate ametijuhendid või volitab nende kinnitamise ministeeriumi teenistujale, kui seaduses ei ole sätestatud teisiti; RT I 2016-11-17 1 117112016001 2016-12-01 14 14) määrab punktides 11 ja 12 nimetatud teenistujate palga ministeeriumi palgajuhendis sätestatud korras; RT I 2016-11-17 1 117112016001 2016-12-01 15 15) lähetab oma pädevuse piires välisesindusse ja kutsub sealt tagasi punktides 11 ja 12 nimetatud teenistujaid; RT I 2016-11-17 1 117112016001 2016-12-01 15 15¹) lähetab oma pädevuse piires missioonile ja kutsub sealt tagasi eksperte; RT I 2016-11-17 1 117112016001 2016-12-01 16 16) kehtetu - RT I 2008 4 28 12910901 2008-01-25 17 17) kinnitab ministeeriumi teenistujate puhkuste ajakava või volitab selle kinnitamise ministeeriumi teenistujale; RT I 2016-11-17 1 117112016001 2016-12-01 18 18) on ministeeriumi atesteerimiskomisjoni esimees; RT I 2008 4 28 12910901 2008-01-25 19 19) annab kaasallkirja ministri määrustele ja muudele dokumentidele õigusaktidega kehtestatud juhtudel ja korras; RT I 2016-11-17 1 117112016001 2016-12-01 20 20) kehtetu - RT I 2008 4 28 12910901 2008-01-25 21 21) sõlmib ministeeriumi nimel lepinguid või volitab oma pädevuse piires selleks ministeeriumi teenistujat; 22 22) kehtetu - RT I 2009 50 340 13229603 2009-11-02 23 23) kehtetu - RT I 2016-11-17 1 117112016001 2016-12-01 24 24) kehtetu - RT I 2016-11-17 1 117112016001 2016-12-01 25 25) valvab ministeeriumi teenistujate teenistuskohustuste täitmise järele ja lahendab ministeeriumi struktuuriüksuste vahelised vaidlused; RT I 2008 4 28 12910901 2008-01-25 26 26) annab ministrile aru ministeeriumi struktuuriüksuste tegevuse kohta; 27 27) täidab muid õigusaktidega talle pandud ülesandeid või volitab oma pädevuse piires selleks ministeeriumi teenistujat ning täidab ministri antud ülesandeid. RT I 2011-11-01 1 101112011001 2012-02-01 Kantsler: esindab ministeeriumi oma teenistuskohustuste täitmisega seotud, ministrilt saadud või seadusega antud volituste piires või volitab oma pädevuse piires ministeeriumi teenistujaid esindama ministeeriumi; juhib asekantslereid, välisesinduste juhte, talle vahetult alluvaid peadirektoreid ja nõunikke ning asekantslerite ja peadirektorite kaudu osakondi; tagab töödistsipliini ning ministeeriumi ülesannete õigeaegse ja majanduslikult säästliku lahendamise; koordineerib ministeeriumi aastaeelarve eelnõu ja vajaduse korral lisaeelarve eelnõu koostamist; korraldab ministeeriumi eelarvevahendite sihipärast jaotamist ja kasutamist; korraldab riigivara säilimist ja kasutamist ministrilt saadud volituste piires riigivaraseaduse kohaselt ning teeb ministrile ettepanekuid riigivara käsutamise kohta; tagab ministeeriumi tegevuseks vajalikud organisatsioonilised ja majanduslikud tingimused; koordineerib vajaduse korral suhtlemist teiste valitsusasutustega, et täita ministeeriumi ülesandeid; kehtetu - kehtetu - nimetab ametikohale ja vabastab ametikohalt ministeeriumi ametnikud, kui ametniku ametikohale nimetamine ei ole ministri pädevuses; sõlmib, muudab ja lõpetab töölepingud ministeeriumi töötajatega, kui töötajaga töölepingu sõlmimine ei ole ministri pädevuses; kinnitab punktides 11 ja 12 nimetatud teenistujate ametijuhendid või volitab nende kinnitamise ministeeriumi teenistujale, kui seaduses ei ole sätestatud teisiti; määrab punktides 11 ja 12 nimetatud teenistujate palga ministeeriumi palgajuhendis sätestatud korras; lähetab oma pädevuse piires välisesindusse ja kutsub sealt tagasi punktides 11 ja 12 nimetatud teenistujaid; lähetab oma pädevuse piires missioonile ja kutsub sealt tagasi eksperte; kehtetu - kinnitab ministeeriumi teenistujate puhkuste ajakava või volitab selle kinnitamise ministeeriumi teenistujale; on ministeeriumi atesteerimiskomisjoni esimees; annab kaasallkirja ministri määrustele ja muudele dokumentidele õigusaktidega kehtestatud juhtudel ja korras; kehtetu - sõlmib ministeeriumi nimel lepinguid või volitab oma pädevuse piires selleks ministeeriumi teenistujat; kehtetu - kehtetu - kehtetu - valvab ministeeriumi teenistujate teenistuskohustuste täitmise järele ja lahendab ministeeriumi struktuuriüksuste vahelised vaidlused; annab ministrile aru ministeeriumi struktuuriüksuste tegevuse kohta; täidab muid õigusaktidega talle pandud ülesandeid või volitab oma pädevuse piires selleks ministeeriumi teenistujat ning täidab ministri antud ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_24 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_25_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kantsler annab seaduses ja ministeeriumi põhimääruses ettenähtud pädevuse piires käskkirju, muu hulgas ministeeriumi teenistujate teenistusse võtmise ja teenistusest vabastamise, struktuuriüksuste töö juhtimise ja koordineerimise ning ministeeriumi asjaajamise korraldamise kohta. Kantsler annab seaduses ja ministeeriumi põhimääruses ettenähtud pädevuse piires käskkirju, muu hulgas ministeeriumi teenistujate teenistusse võtmise ja teenistusest vabastamise, struktuuriüksuste töö juhtimise ja koordineerimise ning ministeeriumi asjaajamise korraldamise kohta. 2 (2) Kantsler annab ministeeriumi teenistujatele suulisi ja kirjalikke korraldusi. RT I 2008 4 28 12910901 2008-01-25 Kantsler annab ministeeriumi teenistujatele suulisi ja kirjalikke korraldusi.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_25 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_26_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kantsleri äraolekul asendab teda üks asekantsleritest. RT I 2016-11-17 1 117112016001 2016-12-01 Kantsleri äraolekul asendab teda üks asekantsleritest. 2 (2) Kantsleri asendaja määrab minister käskkirjaga. Kantsleri asendaja määrab minister käskkirjaga.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_26 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_27_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumis on poliitikaküsimuste asekantsler, välismajanduse ja arengukoostööküsimuste asekantsler, juriidiliste ja konsulaarküsimuste asekantsler, haldusküsimuste asekantsler ning globaalküsimuste asekantsler. RT I 2021-12-23 8 123122021008 2022-08-01 Ministeeriumis on poliitikaküsimuste asekantsler, välismajanduse ja arengukoostööküsimuste asekantsler, juriidiliste ja konsulaarküsimuste asekantsler, haldusküsimuste asekantsler ning globaalküsimuste asekantsler.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_27 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_28_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asekantsler: 1 1) tagab oma pädevuse piires ministeeriumi ülesannete täitmise ministeeriumi valitsemisalasse kuuluvate valdkondade strateegiate väljatöötamise, nende omavahelise seostamise ning tervikliku arendamise kaudu; 2 2) esindab ministeeriumi seaduse ja selle alusel antud volituste piires; 3 3) nõustab ministeeriumi juhtkonda; RT I 2016-11-17 1 117112016001 2016-12-01 4 4) kontrollib talle alluvate osakondade ülesannete täitmist; RT I 2016-11-17 1 117112016001 2016-12-01 5 5) suunab talle alluvate osakondade tööd ja tagab oma valdkonna ülesannete täitmise; RT I 2016-11-17 1 117112016001 2016-12-01 6 6) teeb kantslerile ettepanekuid ministeeriumi eelarve koostamise ja kasutamise kohta oma valdkonnast lähtudes; 7 7) kooskõlastab talle vahetult alluvate teenistujate avaldusi ning teeb või kooskõlastab esildisi teenistusküsimustes; RT I 2016-11-17 1 117112016001 2016-12-01 8 8) vajaduse korral koordineerib oma pädevuse piires suhtlemist teiste valitsusasutustega, et lahendada ministeeriumi ülesandeid; 9 9) vajaduse korral kooskõlastab ministeeriumis koostatud ja oma valdkonda kuuluvaid ministeeriumile kooskõlastamiseks esitatud õigusaktide eelnõusid ja muid dokumente; 10 10) allkirjastab või kooskõlastab ministeeriumis koostatud dokumente kooskõlas õigusaktide ja talle antud volitustega; RT I 2016-11-17 1 117112016001 2016-12-01 11 11) täidab muid seadusega ning Vabariigi Valitsuse määruse ja korraldusega talle pandud ning ministri või kantsleri antud ülesandeid; 12 12) peab talle vahetult alluvate teenistujatega arenguvestlusi. RT I 2016-11-17 1 117112016001 2016-12-01 Asekantsler: tagab oma pädevuse piires ministeeriumi ülesannete täitmise ministeeriumi valitsemisalasse kuuluvate valdkondade strateegiate väljatöötamise, nende omavahelise seostamise ning tervikliku arendamise kaudu; esindab ministeeriumi seaduse ja selle alusel antud volituste piires; nõustab ministeeriumi juhtkonda; kontrollib talle alluvate osakondade ülesannete täitmist; suunab talle alluvate osakondade tööd ja tagab oma valdkonna ülesannete täitmise; teeb kantslerile ettepanekuid ministeeriumi eelarve koostamise ja kasutamise kohta oma valdkonnast lähtudes; kooskõlastab talle vahetult alluvate teenistujate avaldusi ning teeb või kooskõlastab esildisi teenistusküsimustes; vajaduse korral koordineerib oma pädevuse piires suhtlemist teiste valitsusasutustega, et lahendada ministeeriumi ülesandeid; vajaduse korral kooskõlastab ministeeriumis koostatud ja oma valdkonda kuuluvaid ministeeriumile kooskõlastamiseks esitatud õigusaktide eelnõusid ja muid dokumente; allkirjastab või kooskõlastab ministeeriumis koostatud dokumente kooskõlas õigusaktide ja talle antud volitustega; täidab muid seadusega ning Vabariigi Valitsuse määruse ja korraldusega talle pandud ning ministri või kantsleri antud ülesandeid; peab talle vahetult alluvate teenistujatega arenguvestlusi. 2 (2) Asekantsleri täpsed teenistuskohustused sätestatakse vajaduse korral ametijuhendis. RT I 2009 50 340 13229603 2009-11-02 Asekantsleri täpsed teenistuskohustused sätestatakse vajaduse korral ametijuhendis.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_28 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_28_30_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_28_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Poliitikaküsimuste asekantsler: 1 1) suunab NATO ja Atlandi-üleste suhete osakonna, Euroopa osakonna, Ida-Euroopa ja Kesk-Aasia osakonna ning Aasia, Vaikse ookeani piirkonna, Lähis-Ida ja Aafrika osakonna tööd; RT I 2023-07-14 1 114072023001 2023-08-01 2 2) nõustab ministeeriumi juhtkonda ning struktuuriüksusi rahvusvahelise julgeoleku, Eesti julgeolekupoliitika ja välissuhete ning Euroopa Liidu küsimustes; RT I 2021-12-23 8 123122021008 2022-08-01 3 3) koordineerib ministeeriumi Euroopa Liidu alast suhtlemist teiste valitsusasutustega ja Riigikogu Euroopa Liidu asjade komisjoniga ning vajaduse korral esindab ministeeriumi sellealastel kohtumistel. RT I 2021-12-23 8 123122021008 2022-08-01 Poliitikaküsimuste asekantsler: suunab NATO ja Atlandi-üleste suhete osakonna, Euroopa osakonna, Ida-Euroopa ja Kesk-Aasia osakonna ning Aasia, Vaikse ookeani piirkonna, Lähis-Ida ja Aafrika osakonna tööd; nõustab ministeeriumi juhtkonda ning struktuuriüksusi rahvusvahelise julgeoleku, Eesti julgeolekupoliitika ja välissuhete ning Euroopa Liidu küsimustes; koordineerib ministeeriumi Euroopa Liidu alast suhtlemist teiste valitsusasutustega ja Riigikogu Euroopa Liidu asjade komisjoniga ning vajaduse korral esindab ministeeriumi sellealastel kohtumistel.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_28_30 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 28_30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_29_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
