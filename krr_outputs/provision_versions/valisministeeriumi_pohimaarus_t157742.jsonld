      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeeriumil on sõõrikujuline 50 mm läbimõõduga pitsat, mille keskel on väike riigivapp ning ülemises ääres sõna «VÄLISMINISTEERIUM». Ministeeriumil on sõõrikujuline 50 mm läbimõõduga pitsat, mille keskel on väike riigivapp ning ülemises ääres sõna «VÄLISMINISTEERIUM».",
      "rdfs:label": {
        "@value": "Reg_157742_Par_50 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
