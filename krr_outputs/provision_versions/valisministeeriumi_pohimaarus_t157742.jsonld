      }
    },
    {
      "@id": "estleg:Reg_157742_Par_3_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ja teostab tema üle teenistuslikku järelevalvet. Ministeerium on aruandekohustuslik Vabariigi Valitsuse ees, kes suunab ja koordineerib tema tegevust ja teostab tema üle teenistuslikku järelevalvet.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_3 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_30_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
