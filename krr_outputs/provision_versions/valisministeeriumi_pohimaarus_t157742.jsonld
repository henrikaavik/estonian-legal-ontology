      "estleg:provisionRef": "Reg_157742 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_157742_Par_21_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
