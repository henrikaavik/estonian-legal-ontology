    {
      "@id": "estleg:Reg_157742_Par_51_v157742",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157742_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Välislepingute lakipitsat on sõõrikujuline 50 mm läbimõõduga pitsat, mille keskel on väike riigivapp ning ülemises ääres sõna «VÄLISMINISTEERIUM». RT I 2009 50 340 13229603 2009-11-02 Välislepingute lakipitsat on sõõrikujuline 50 mm läbimõõduga pitsat, mille keskel on väike riigivapp ning ülemises ääres sõna «VÄLISMINISTEERIUM». 2 (2) Ministeeriumi struktuuriüksusel võib olla oma pitsat, kui see on sätestatud struktuuriüksuse põhimääruses. Ministeeriumi struktuuriüksusel võib olla oma pitsat, kui see on sätestatud struktuuriüksuse põhimääruses. 3 (3) Mitteresideerival erakorralisel ja täievolilisel suursaadikul, kes resideerib Eestis või välisriigis, välja arvatud riigis, kuhu ta on akrediteeritud, on oma pitsat riigivapi seaduse kohaselt. RT I 2016-11-17 1 117112016001 2016-12-01 Mitteresideerival erakorralisel ja täievolilisel suursaadikul, kes resideerib Eestis või välisriigis, välja arvatud riigis, kuhu ta on akrediteeritud, on oma pitsat riigivapi seaduse kohaselt.",
      "rdfs:label": {
        "@value": "Reg_157742_Par_51 (redaktsioon 157742)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157742",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157742",
      "estleg:sourceAct": "Välisministeeriumi põhimäärus",
      "estleg:provisionRef": "Reg_157742 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157742_Map_2026"
      }
    },
