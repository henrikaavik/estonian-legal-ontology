      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Minister annab seaduse alusel määrusi ja käskkirju ning ministeeriumi teenistujatele suulisi ja kirjalikke korraldusi. RT I 2008 4 28 12910901 2008-01-25 Minister annab seaduse alusel määrusi ja käskkirju ning ministeeriumi teenistujatele suulisi ja kirjalikke korraldusi.",
      "rdfs:label": {
