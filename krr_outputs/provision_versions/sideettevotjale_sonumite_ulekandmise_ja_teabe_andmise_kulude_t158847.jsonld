      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord"
    },
    {
      "@id": "estleg:Reg_158847_Par_1_v158847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158847_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõnumi tsentraalsesse jälgimisseadmesse ülekandmiseks vajaliku sõnumit jaotava liidese ning vastava riist- ja tarkvara maksumus ning nende hoolduskulud hüvitatakse sideettevõtjale teenustasuna riigieelarvest Justiits- ja Digiministeeriumi eelarve kaudu. Nimetatud teenustasu makstakse fikseeritud maksetena üks kord aastas ajatatuna ühe soetatud eseme kohta mitte pikemale perioodile kui 10 aastat. Teenustasu makstakse vastavalt Justiits- ja Digiministeeriumi ning sideettevõtja vahel sõlmitud lepingule. RT I 2024-12-29 1 129122024001 2025-01-01 Sõnumi tsentraalsesse jälgimisseadmesse ülekandmiseks vajaliku sõnumit jaotava liidese ning vastava riist- ja tarkvara maksumus ning nende hoolduskulud hüvitatakse sideettevõtjale teenustasuna riigieelarvest Justiits- ja Digiministeeriumi eelarve kaudu. Nimetatud teenustasu makstakse fikseeritud maksetena üks kord aastas ajatatuna ühe soetatud eseme kohta mitte pikemale perioodile kui 10 aastat. Teenustasu makstakse vastavalt Justiits- ja Digiministeeriumi ning sideettevõtja vahel sõlmitud lepingule. 2 (2) Riist- ja tarkvara soetamise või väljavahetamise vajadus, soetamise viis ning soetamis- ja hoolduskulud kooskõlastatakse Justiits- ja Digiministeeriumiga enne riist- või tarkvara soetamist või väljavahetamist. RT I 2024-12-29 1 129122024001 2025-01-01 Riist- ja tarkvara soetamise või väljavahetamise vajadus, soetamise viis ning soetamis- ja hoolduskulud kooskõlastatakse Justiits- ja Digiministeeriumiga enne riist- või tarkvara soetamist või väljavahetamist. 3 (3) Riist- ja tarkvara kohta esitab sideettevõtja Justiits- ja Digiministeeriumile kooskõlastamiseks vähemalt järgmised andmed ning dokumendid: RT I 2024-12-29 1 129122024001 2025-01-01 1 1) tarnija pakkumise riist- ja tarkvara funktsionaalsuse, koguse, maksumuse ning tarnetähtaja kohta; 2 2) jälitus- või julgeolekuasutuse kinnituse riist- ja tarkvara sobivuse kohta «Elektroonilise side seaduse» §-des 112 ja 113 sätestatud kohustuste täitmiseks; 3 3) riist- ja tarkvara hoolduskulude eelarve. Riist- ja tarkvara kohta esitab sideettevõtja Justiits- ja Digiministeeriumile kooskõlastamiseks vähemalt järgmised andmed ning dokumendid: tarnija pakkumise riist- ja tarkvara funktsionaalsuse, koguse, maksumuse ning tarnetähtaja kohta; jälitus- või julgeolekuasutuse kinnituse riist- ja tarkvara sobivuse kohta «Elektroonilise side seaduse» §-des 112 ja 113 sätestatud kohustuste täitmiseks; riist- ja tarkvara hoolduskulude eelarve.",
      "rdfs:label": {
        "@value": "Reg_158847_Par_1 (redaktsioon 158847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158847",
      "estleg:sourceAct": "Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_158847 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158847_Map"
      }
    },
    {
      "@id": "estleg:Reg_158847_Par_2_v158847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158847_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Jälitus- või julgeolekuasutus hüvitab sideettevõtjale «Elektroonilise side seaduse» § 112 lõikes 1 nimetatud andmete kättesaadavuse tagamiseks loodud elektroonilise ühenduse eest jälitus- või julgeolekuasutuse ja sideettevõtja vahel sõlmitud lepingus üheks kalendrikuuks kindlaksmääratud summa, sõltumata järelepärimiste arvust või kättesaadavate andmete liigist ja mahust. Jälitus- või julgeolekuasutus hüvitab sideettevõtjale «Elektroonilise side seaduse» § 112 lõikes 1 nimetatud andmete kättesaadavuse tagamiseks loodud elektroonilise ühenduse eest jälitus- või julgeolekuasutuse ja sideettevõtja vahel sõlmitud lepingus üheks kalendrikuuks kindlaksmääratud summa, sõltumata järelepärimiste arvust või kättesaadavate andmete liigist ja mahust. 2 (2) «Elektroonilise side seaduse» § 112 lõikes 1 ettenähtud andmete kättesaadavuse tagamiseks vajaliku elektroonilise ühenduse loomise kulud nähakse ette jälitus- või julgeolekuasutuse eelarves. «Elektroonilise side seaduse» § 112 lõikes 1 ettenähtud andmete kättesaadavuse tagamiseks vajaliku elektroonilise ühenduse loomise kulud nähakse ette jälitus- või julgeolekuasutuse eelarves.",
      "rdfs:label": {
        "@value": "Reg_158847_Par_2 (redaktsioon 158847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158847",
      "estleg:sourceAct": "Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_158847 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158847_Map"
      }
    },
    {
      "@id": "estleg:Reg_158847_Par_3_v158847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158847_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvis 2 nimetatud elektroonilise ühenduse puudumise korral suuliste või kirjalike järelepärimiste esitamisel hüvitab jälitus- või julgeolekuasutus sideettevõtjale kulud vastavalt temaga sõlmitud lepingule. Paragrahvis 2 nimetatud elektroonilise ühenduse puudumise korral suuliste või kirjalike järelepärimiste esitamisel hüvitab jälitus- või julgeolekuasutus sideettevõtjale kulud vastavalt temaga sõlmitud lepingule. 2 (2) Üks järelepärimine hõlmab teavet: 1 1) liitumislepingus sisalduvate sõnumi edastaja ja vastuvõtja isikuandmete kohta; 2 2) sõnumi edastaja ja vastuvõtja asukoha kohta; 3 3) sõnumi edastamise fakti, kestuse, viisi ja vormi kohta; 4 4) sõnumite edastamise protsessis moodustuvate sõnumite edastamist kirjeldavate andmekogude ja nendes sisalduvate andmete kohta. Üks järelepärimine hõlmab teavet: liitumislepingus sisalduvate sõnumi edastaja ja vastuvõtja isikuandmete kohta; sõnumi edastaja ja vastuvõtja asukoha kohta; sõnumi edastamise fakti, kestuse, viisi ja vormi kohta; sõnumite edastamise protsessis moodustuvate sõnumite edastamist kirjeldavate andmekogude ja nendes sisalduvate andmete kohta.",
      "rdfs:label": {
        "@value": "Reg_158847_Par_3 (redaktsioon 158847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158847",
      "estleg:sourceAct": "Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_158847 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158847_Map"
      }
    },
    {
      "@id": "estleg:Reg_158847_Par_4_v158847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158847_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jälitus- või julgeolekuasutus hüvitab ühes kalendrikuus kulud «Elektroonilise side seaduse» § 113 lõikes 3 nimetatud juurdepääsu kasutamise ja sõnumite ülekandmise eest sideettevõtjaga sõlmitud lepingus kindlaksmääratud summas, olenemata edastatavate sõnumite ja nende saladuse õiguse piiramise mahust. Jälitus- või julgeolekuasutus hüvitab ühes kalendrikuus kulud «Elektroonilise side seaduse» § 113 lõikes 3 nimetatud juurdepääsu kasutamise ja sõnumite ülekandmise eest sideettevõtjaga sõlmitud lepingus kindlaksmääratud summas, olenemata edastatavate sõnumite ja nende saladuse õiguse piiramise mahust.",
      "rdfs:label": {
        "@value": "Reg_158847_Par_4 (redaktsioon 158847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158847",
      "estleg:sourceAct": "Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_158847 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158847_Map"
      }
    },
    {
      "@id": "estleg:Reg_158847_Par_5_v158847",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158847_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiits- ja Digiministeeriumi või jälitus- või julgeolekuasutuse ja sideettevõtja vahel käesolevas määruses ettenähtud hüvitise suuruse osas kokkuleppele mittejõudmine ei saa olla «Elektroonilise side seaduse» § 112 lõikes 1 sätestatud teabe edastamisest või § 113 lõikes 3 nimetatud sõnumite ülekandmise keeldumise aluseks. RT I 2024-12-29 1 129122024001 2025-01-01 Justiits- ja Digiministeeriumi või jälitus- või julgeolekuasutuse ja sideettevõtja vahel käesolevas määruses ettenähtud hüvitise suuruse osas kokkuleppele mittejõudmine ei saa olla «Elektroonilise side seaduse» § 112 lõikes 1 sätestatud teabe edastamisest või § 113 lõikes 3 nimetatud sõnumite ülekandmise keeldumise aluseks.",
      "rdfs:label": {
        "@value": "Reg_158847_Par_5 (redaktsioon 158847)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158847",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158847",
      "estleg:sourceAct": "Sideettevõtjale sõnumite ülekandmise ja teabe andmise kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_158847 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158847_Map"
      }
    },
