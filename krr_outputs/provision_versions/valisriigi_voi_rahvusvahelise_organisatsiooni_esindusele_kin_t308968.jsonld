      "estleg:provisionRef": "Reg_308968 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308968_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308968_Par_2_v308968",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308968_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi esindus teavitab Välisministeeriumi kirjalikult kinnisasja, selle mõttelise osa või hoonestusõiguse omandamise, kasutusvalduse või hoonestusõiguse seadmise, üürimise või tasuta kasutusse võtmise kavatsusest ning kinnisasja asukohast ja üleandjast. Välisriigi esindus teavitab Välisministeeriumi kirjalikult kinnisasja, selle mõttelise osa või hoonestusõiguse omandamise, kasutusvalduse või hoonestusõiguse seadmise, üürimise või tasuta kasutusse võtmise kavatsusest ning kinnisasja asukohast ja üleandjast.",
      "rdfs:label": {
        "@value": "Reg_308968_Par_2 (redaktsioon 308968)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308968",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308968",
      "estleg:sourceAct": "Välisriigi või rahvusvahelise organisatsiooni esindusele kinnisomandi ja kinnisasja valduse üleandmise tingimused ja kord ning taotluse vorm",
      "estleg:provisionRef": "Reg_308968 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308968_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308968_Par_3_v308968",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308968_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Välisministeerium teavitab pärast §-s 2 nimetatud teabe saamist välisriigi esindust ja kinnisasja üleandjat kirjalikult kinnisasja üleandmise loa taotlemise vajadusest. Välisministeerium teavitab pärast §-s 2 nimetatud teabe saamist välisriigi esindust ja kinnisasja üleandjat kirjalikult kinnisasja üleandmise loa taotlemise vajadusest. 2(2)Määruse lisas kehtestatud vormi kohase kinnisasja üleandmise loa taotluse esitab Välisministeeriumile kinnisasja üleandja. Määruse lisas kehtestatud vormi kohase kinnisasja üleandmise loa taotluse esitab Välisministeeriumile kinnisasja üleandja. 3(3)Välisministeerium vaatab kinnisasja üleandmise loa taotluse läbi 30 kalendripäeva jooksul alates taotluse registreerimise päevast. Taotluse läbivaatamise käigus esitab Välisministeerium vajaduse korral asjakohase päringu kinnisasja asukohajärgsele valla- või linnavalitsusele seisukoha võtmiseks. Välisministeerium vaatab kinnisasja üleandmise loa taotluse läbi 30 kalendripäeva jooksul alates taotluse registreerimise päevast. Taotluse läbivaatamise käigus esitab Välisministeerium vajaduse korral asjakohase päringu kinnisasja asukohajärgsele valla- või linnavalitsusele seisukoha võtmiseks. 4(4)Kinnisasja üleandmise loa taotluse vorm avaldatakse Välisministeeriumi veebilehel. Kinnisasja üleandmise loa taotluse vorm avaldatakse Välisministeeriumi veebilehel.",
      "rdfs:label": {
        "@value": "Reg_308968_Par_3 (redaktsioon 308968)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308968",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308968",
      "estleg:sourceAct": "Välisriigi või rahvusvahelise organisatsiooni esindusele kinnisomandi ja kinnisasja valduse üleandmise tingimused ja kord ning taotluse vorm",
      "estleg:provisionRef": "Reg_308968 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308968_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_308968_Par_4_v308968",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_308968_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Luba välisriigi esindusele kinnisasja üleandmiseks antakse haldusmenetluse korras, välisministri käskkirjaga. Luba välisriigi esindusele kinnisasja üleandmiseks antakse haldusmenetluse korras, välisministri käskkirjaga. 2(2)Kinnisasja välisriigi esindusele üleandmise loa andmisel arvestatakse «Kinnisasja omandamise kitsendamise seaduse» § 3 lõikes 1 sätestatud riigikaitselisi kitsendusi. Kinnisasja välisriigi esindusele üleandmise loa andmisel arvestatakse «Kinnisasja omandamise kitsendamise seaduse» § 3 lõikes 1 sätestatud riigikaitselisi kitsendusi. 3(3)Välisminister võib kinnisasja üleandmise loa andmisest keelduda, kui see:11)võib ohustada riigi julgeolekut;22)on vastuolus rahvusvahelise tavast tuleneva vastastikkuse põhimõttega;33)võib sattuda vastuollu avaliku huviga. Välisminister võib kinnisasja üleandmise loa andmisest keelduda, kui see: võib ohustada riigi julgeolekut; on vastuolus rahvusvahelise tavast tuleneva vastastikkuse põhimõttega; võib sattuda vastuollu avaliku huviga. 4(4)Välisministeerium teavitab välisriigi esindust kirjalikult kinnisasjaüleandjale antud loast või loa andmisest keeldumisest 5 tööpäeva jooksul pärast loa andmist või selle andmisest keeldumist. Välisministeerium teavitab välisriigi esindust kirjalikult kinnisasjaüleandjale antud loast või loa andmisest keeldumisest 5 tööpäeva jooksul pärast loa andmist või selle andmisest keeldumist.",
      "rdfs:label": {
        "@value": "Reg_308968_Par_4 (redaktsioon 308968)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "308968",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/308968",
