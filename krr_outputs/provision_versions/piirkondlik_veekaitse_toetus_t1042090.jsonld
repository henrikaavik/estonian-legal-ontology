      "estleg:provisionRef": "Reg_1042090 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042090_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042090_Par_23_v1042090",
      "@type": [
        "owl:NamedIndividual",
