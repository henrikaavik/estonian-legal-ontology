      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eestis looduslikult esineva kala või viljastatud marja veekogusse asustamise taotluse kohta esitatavad nõuded, asustamisloa andmise ja asustamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eestis looduslikult esineva kala või viljastatud marja veekogusse asustamise taotluse kohta esitatavad nõuded, asustamisloa andmise ja asustamise kord"
    },
    {
      "@id": "estleg:Reg_1030053_Par_1_v1030053",
