      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega reguleeritakse Eestis looduslikult esineva kala või viljastatud marja (edaspidi kala) veekogusse asustamist. Käesoleva määrusega reguleeritakse Eestis looduslikult esineva kala või viljastatud marja (edaspidi kala) veekogusse asustamist.",
      "rdfs:label": {
        "@value": "Reg_1030053_Par_1 (redaktsioon 1030053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030053",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030053",
      "estleg:sourceAct": "Eestis looduslikult esineva kala või viljastatud marja veekogusse asustamise taotluse kohta esitatavad nõuded, asustamisloa andmise ja asustamise kord",
      "estleg:provisionRef": "Reg_1030053 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030053_Map"
      }
    },
    {
      "@id": "estleg:Reg_1030053_Par_2_v1030053",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030053_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asustamisloa saamiseks esitab isik kirjaliku taotluse Keskkonnaametile (edaspidi loa andja). Asustamisloa saamiseks esitab isik kirjaliku taotluse Keskkonnaametile (edaspidi loa andja). 2 (2) Asustamisloa taotlusele peab olema lisatud või selles märgitud: 1 1) veterinaarkorralduse seadusest ja loomatauditõrje seadusest tulenevalt veterinaartõend(id) asustamise lubatavuse kohta seoses asustatava kala ja asustamisveekoguga; 2 2) asustatava kala päritolu (riik, halduspiirkond, veekogu/kasvandus); 3 3) asustatava kala liik, asurkond, vanus, isendite kogus ning isendi keskmine kaal; 4 4) asustamise eesmärk; 5 5) väljavõte majandamiskavast, tegevuskavast või võimaluse korral asustamise teadussoovitusest; 6 6) asustamisveekogu, selle asukoht (küla, vald) ja asustamiseaeg; 7 7) veekogu omaniku nõusolek, kui asustamine toimub eraomandis olevasse veekogusse, mis ei ole määratud avalikult kasutatavaks. Asustamisloa taotlusele peab olema lisatud või selles märgitud: veterinaarkorralduse seadusest ja loomatauditõrje seadusest tulenevalt veterinaartõend(id) asustamise lubatavuse kohta seoses asustatava kala ja asustamisveekoguga; asustatava kala päritolu (riik, halduspiirkond, veekogu/kasvandus); asustatava kala liik, asurkond, vanus, isendite kogus ning isendi keskmine kaal; asustamise eesmärk; väljavõte majandamiskavast, tegevuskavast või võimaluse korral asustamise teadussoovitusest; asustamisveekogu, selle asukoht (küla, vald) ja asustamiseaeg; veekogu omaniku nõusolek, kui asustamine toimub eraomandis olevasse veekogusse, mis ei ole määratud avalikult kasutatavaks.",
      "rdfs:label": {
        "@value": "Reg_1030053_Par_2 (redaktsioon 1030053)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030053",
