      }
    },
    {
      "@id": "estleg:Reg_158134_Par_5_5_v158134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158134_Par_5_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "EQUALi korraldusasutuse ülesanded on: 1 1) programmi elluviimise tagamine; 2 2) rakendusüksuse nõustamine; 3 3) seire ja hindamise korraldamine; 4 4) programmi tulemuste süvalaiendamise korraldamine; 5 5) avalikkuse teavitamine programmi tulemustest; 6 6) Euroopa Komisjonile teabe edastamine; 7 7) muud õigusaktidest tulenevad ülesanded. RT I 2007 25 135 12802251 2007-03-25+02:00 EQUALi korraldusasutuse ülesanded on: programmi elluviimise tagamine; rakendusüksuse nõustamine; seire ja hindamise korraldamine; programmi tulemuste süvalaiendamise korraldamine; avalikkuse teavitamine programmi tulemustest; Euroopa Komisjonile teabe edastamine; muud õigusaktidest tulenevad ülesanded.",
      "rdfs:label": {
        "@value": "Reg_158134_Par_5_5 (redaktsioon 158134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158134",
