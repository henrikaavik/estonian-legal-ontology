      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse saaja on kohustatud säilitama taotluse ning projekti elluviimisega ja toetuse kasutamisega seotud dokumentatsiooni vähemalt 31. detsembrini 2015. a. Toetuse saaja on kohustatud säilitama taotluse ning projekti elluviimisega ja toetuse kasutamisega seotud dokumentatsiooni vähemalt 31. detsembrini 2015. a.",
      "rdfs:label": {
