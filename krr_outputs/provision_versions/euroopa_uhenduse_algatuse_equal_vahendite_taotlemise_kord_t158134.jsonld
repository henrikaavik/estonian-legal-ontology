      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158134_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus sätestab «Perioodi 2004–2006 struktuuritoetuse seaduse» § 2 lõike 2 punktide 3 ja 4 alusel» kehtestatud «Euroopa Ühenduse algatuse EQUAL vahendite kasutamise programmi» (edaspidi programm) vahendite taotlemise korra. RT I 2007 25 135 12802251 2007-03-25+02:00 Määrus sätestab «Perioodi 2004–2006 struktuuritoetuse seaduse» § 2 lõike 2 punktide 3 ja 4 alusel» kehtestatud «Euroopa Ühenduse algatuse EQUAL vahendite kasutamise programmi» (edaspidi programm) vahendite taotlemise korra. 2 (2) Määrusele kohaldatakse «Haldusmenetluse seaduse» sätteid, arvestades käesoleva määruse erisusi. Määrusele kohaldatakse «Haldusmenetluse seaduse» sätteid, arvestades käesoleva määruse erisusi.",
      "rdfs:label": {
        "@value": "Reg_158134_Par_1 (redaktsioon 158134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158134",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158134",
      "estleg:sourceAct": "Euroopa Ühenduse algatuse EQUAL vahendite taotlemise kord",
      "estleg:provisionRef": "Reg_158134 § 1",
      "estleg:partOfAct": {
