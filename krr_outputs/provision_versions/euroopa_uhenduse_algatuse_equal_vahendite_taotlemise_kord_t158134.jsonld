    {
      "@id": "estleg:Reg_158134_Par_16_v158134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158134_Par_16"
