        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 4",
