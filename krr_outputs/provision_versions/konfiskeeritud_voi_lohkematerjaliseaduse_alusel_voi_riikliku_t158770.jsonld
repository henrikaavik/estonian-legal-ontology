      }
    },
    {
      "@id": "estleg:Reg_158770_Par_5_v158770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158770_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lõhkematerjal ja pürotehniline toode antakse üle üleandmis-vastuvõtmisakti alusel, mille üks eksemplar jääb üleandjale ja teine vastuvõtjale. Lõhkematerjal ja pürotehniline toode antakse üle üleandmis-vastuvõtmisakti alusel, mille üks eksemplar jääb üleandjale ja teine vastuvõtjale. 2 (2) Üleandmis-vastuvõtmisakti märgitakse: 1 1) lõhkematerjali või pürotehnilise toote nimetus ja kogus; 2 2) viide üleandmise õiguslikule alusele; 3 3) üleandmise koht ja aeg; 4 4) üleandja ja vastuvõtja ametinimetused, nimed ja allkirjad. Üleandmis-vastuvõtmisakti märgitakse: lõhkematerjali või pürotehnilise toote nimetus ja kogus; viide üleandmise õiguslikule alusele; üleandmise koht ja aeg; üleandja ja vastuvõtja ametinimetused, nimed ja allkirjad.",
      "rdfs:label": {
        "@value": "Reg_158770_Par_5 (redaktsioon 158770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158770_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158770_Par_6_v158770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158770_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üleantud lõhkematerjali või pürotehnilise toote valitseja võib vara võõrandada «Riigivaraseaduses» ja selle alusel kehtestatud õigusaktides sätestatud korras, arvestades järgmiste erisustega: 1 1) tsiviilkäibesse võib võõrandada üksnes õigusaktides sätestatud nõuetele vastavat lõhkematerjali ja pürotehnilist toodet; RT I 2017-07-29 4 129072017004 2017-08-01 2 2) lõhkematerjali ja pürotehnilist toodet võib võõrandada üksnes nende omamise õigust omavale isikule. Üleantud lõhkematerjali või pürotehnilise toote valitseja võib vara võõrandada «Riigivaraseaduses» ja selle alusel kehtestatud õigusaktides sätestatud korras, arvestades järgmiste erisustega: tsiviilkäibesse võib võõrandada üksnes õigusaktides sätestatud nõuetele vastavat lõhkematerjali ja pürotehnilist toodet; lõhkematerjali ja pürotehnilist toodet võib võõrandada üksnes nende omamise õigust omavale isikule.",
      "rdfs:label": {
        "@value": "Reg_158770_Par_6 (redaktsioon 158770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158770_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158770_Par_7_v158770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158770_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hävitada tuleb lõhkematerjal ja pürotehniline toode: 1 1) mis ei vasta nõuetele; 2 2) mille hoidmine või nõuetele vastavuse tuvastamine oleks kulukam kui nende võõrandamisest saadav tulu; 3 3) mida ei ole suudetud mõistliku aja jooksul võõrandada või mille võõrandamine oleks ebatõenäoline; 4 4) mis on määratud hävitamisele menetleva organi või kohtu poolt. Hävitada tuleb lõhkematerjal ja pürotehniline toode: mis ei vasta nõuetele; mille hoidmine või nõuetele vastavuse tuvastamine oleks kulukam kui nende võõrandamisest saadav tulu; mida ei ole suudetud mõistliku aja jooksul võõrandada või mille võõrandamine oleks ebatõenäoline; mis on määratud hävitamisele menetleva organi või kohtu poolt. 2 (2) Lõhkematerjali ja pürotehnilist toodet võib hävitada üksnes selleks erialast ettevalmistust omav isik, järgides lõhkematerjali ja pürotehnilise toote hävitamist reguleerivate õigusaktide nõudeid. Lõhkematerjali ja pürotehnilist toodet võib hävitada üksnes selleks erialast ettevalmistust omav isik, järgides lõhkematerjali ja pürotehnilise toote hävitamist reguleerivate õigusaktide nõudeid. 3 (3) Juhul kui käesoleva määruse § 2 lõike 3 alusel ei ole määratud kriminaal- või väärteoasjas konfiskeeritud või asitõendiks oleva lõhkematerjali ja pürotehnilise toote hävitamise tähtaega, toimub hävitamine pärast süüteo aegumist või kohtulahendi jõustumist menetluse läbiviinud uurimisasutuse või kohtuvälise menetleja otsusel. RT I 2010 32 159 13324924 2010-06-18 Juhul kui käesoleva määruse § 2 lõike 3 alusel ei ole määratud kriminaal- või väärteoasjas konfiskeeritud või asitõendiks oleva lõhkematerjali ja pürotehnilise toote hävitamise tähtaega, toimub hävitamine pärast süüteo aegumist või kohtulahendi jõustumist menetluse läbiviinud uurimisasutuse või kohtuvälise menetleja otsusel.",
      "rdfs:label": {
        "@value": "Reg_158770_Par_7 (redaktsioon 158770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158770_Map_2026"
      }
    },
