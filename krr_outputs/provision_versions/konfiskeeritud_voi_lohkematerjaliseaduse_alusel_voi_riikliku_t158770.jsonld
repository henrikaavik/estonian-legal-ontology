  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_konfiskeeritud_voi_lohkematerjaliseaduse_alusel_voi_riikliku_t158770_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord"
    },
    {
      "@id": "estleg:Reg_158770_Par_1_v158770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158770_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas määruses sätestatut kohaldatakse lõhkematerjali ja pürotehnilise toote suhtes, mis on: 1 1) konfiskeeritud kriminaal- või väärteoasjas või on asitõend; 2 2) üle antud või ära võetud riikliku järelevalve teostamise käigus; 3 3) üle antud Tarbijakaitse ja Tehnilise Järelevalve Ametile lõhkematerjaliseaduse §-de 9–11 alusel. RT I 2019-04-10 1 110042019001 2019-04-13 Käesolevas määruses sätestatut kohaldatakse lõhkematerjali ja pürotehnilise toote suhtes, mis on: konfiskeeritud kriminaal- või väärteoasjas või on asitõend; üle antud või ära võetud riikliku järelevalve teostamise käigus; üle antud Tarbijakaitse ja Tehnilise Järelevalve Ametile lõhkematerjaliseaduse §-de 9–11 alusel.",
      "rdfs:label": {
        "@value": "Reg_158770_Par_1 (redaktsioon 158770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158770_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158770_Par_2_v158770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158770_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kriminaal- või väärteoasjas konfiskeeritud või asitõendiks oleva lõhkematerjali või pürotehnilise toote (edaspidi konfiskeeritud vara) puhul kohaldatakse Vabariigi Valitsuse 30. juuli 2004. a määruses nr 263 «Konfiskeeritud vara võõrandamise, üleandmise ja hävitamise, vara võõrandamisest saadud raha eelarvest seaduslikule valdajale tagastamise, asitõendite arvelevõtmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord» sätestatut käesolevast määrusest tulenevate erisustega. Kriminaal- või väärteoasjas konfiskeeritud või asitõendiks oleva lõhkematerjali või pürotehnilise toote (edaspidi konfiskeeritud vara) puhul kohaldatakse Vabariigi Valitsuse 30. juuli 2004. a määruses nr 263 «Konfiskeeritud vara võõrandamise, üleandmise ja hävitamise, vara võõrandamisest saadud raha eelarvest seaduslikule valdajale tagastamise, asitõendite arvelevõtmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord» sätestatut käesolevast määrusest tulenevate erisustega. 2 (2) Konfiskeeritud vara valitseja peab korraldama lõhkematerjali või pürotehnilise toote hoidmise, hävitamise, tagastamise või võõrandamise kooskõlas lõhkematerjali käitlemist reguleerivate õigusaktidega. Konfiskeeritud vara valitseja peab korraldama lõhkematerjali või pürotehnilise toote hoidmise, hävitamise, tagastamise või võõrandamise kooskõlas lõhkematerjali käitlemist reguleerivate õigusaktidega. 3 (3) Konfiskeeritud vara tuleb hoida kuni konfiskeerimist kohaldanud menetleja määruses või otsuses sätestatud tähtajani. Konfiskeeritud vara tuleb hoida kuni konfiskeerimist kohaldanud menetleja määruses või otsuses sätestatud tähtajani.",
      "rdfs:label": {
        "@value": "Reg_158770_Par_2 (redaktsioon 158770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158770_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158770_Par_3_v158770",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158770_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riikliku järelevalve käigus üle antud või ära võetud lõhkematerjali või pürotehnilise toote valitsejaks on riiklikku järelevalvet teostanud asutus. Riikliku järelevalve käigus üle antud või ära võetud lõhkematerjali või pürotehnilise toote valitsejaks on riiklikku järelevalvet teostanud asutus. 2 (2) Riikliku järelevalve käigus üle antud või ära võetud lõhkematerjali või pürotehnilise toote hoidmine või hävitamine toimub kooskõlas lõhkematerjali käitlemist reguleerivate õigusaktidega. Riikliku järelevalve käigus üle antud või ära võetud lõhkematerjali või pürotehnilise toote hoidmine või hävitamine toimub kooskõlas lõhkematerjali käitlemist reguleerivate õigusaktidega.",
      "rdfs:label": {
        "@value": "Reg_158770_Par_3 (redaktsioon 158770)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158770",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158770",
      "estleg:sourceAct": "Konfiskeeritud või «Lõhkematerjaliseaduse» alusel või riikliku järelevalve käigus üleantud lõhkematerjali ja pürotehnilise toote hoidmise, võõrandamise ja hävitamiseks üleandmise kord",
      "estleg:provisionRef": "Reg_158770 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158770_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158770_Par_4_v158770",
