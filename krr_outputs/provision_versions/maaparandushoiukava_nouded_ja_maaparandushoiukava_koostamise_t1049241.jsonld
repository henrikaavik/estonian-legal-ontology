    {
      "@id": "estleg:Reg_1049241_Par_2_v1049241",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049241_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maaparandushoiukava (edaspidi hoiukava) koostatakse veeseaduse §-s 27 nimetatud iga vesikonna kohta. Maaparandushoiukava (edaspidi hoiukava) koostatakse veeseaduse §-s 27 nimetatud iga vesikonna kohta. 2 (2) Paragrahvi 6 lõikes 2 nimetatud asjakohased andmed ja teave esitatakse määruse lisas 1 nimetatud hoiukava piirkondade (edaspidi piirkond) kaupa. Paragrahvi 6 lõikes 2 nimetatud asjakohased andmed ja teave esitatakse määruse lisas 1 nimetatud hoiukava piirkondade (edaspidi piirkond) kaupa.",
      "rdfs:label": {
