    {
      "@id": "estleg:Reg_1055321_Par_11_v1055321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055321_Par_11"
