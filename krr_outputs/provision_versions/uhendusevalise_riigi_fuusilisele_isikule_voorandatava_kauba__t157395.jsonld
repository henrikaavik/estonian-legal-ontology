    {
      "@id": "estleg:Reg_157395_Par_3_v157395",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157395_Par_3"
