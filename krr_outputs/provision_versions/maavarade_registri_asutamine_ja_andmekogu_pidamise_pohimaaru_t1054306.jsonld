      "estleg:sourceAct": "Maavarade registri asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1054306 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054306_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054306_Par_16_v1054306",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054306_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu hooldus- ja arendustöid ning pidamist rahastatakse riigieelarvest vastutavale ja volitatud töötlejale selleks eraldatud vahenditest. Andmekogu hooldus- ja arendustöid ning pidamist rahastatakse riigieelarvest vastutavale ja volitatud töötlejale selleks eraldatud vahenditest.",
      "rdfs:label": {
        "@value": "Reg_1054306_Par_16 (redaktsioon 1054306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054306",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054306",
      "estleg:sourceAct": "Maavarade registri asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1054306 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054306_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054306_Par_17_v1054306",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054306_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaregistri seaduse alusel kogutud maardlate nimistu andmed viiakse üle maavarade registrisse ja loetakse maavarade registri andmeteks alates käesoleva määruse jõustumisest. Keskkonnaregistri seaduse alusel kogutud maardlate nimistu andmed viiakse üle maavarade registrisse ja loetakse maavarade registri andmeteks alates käesoleva määruse jõustumisest.",
      "rdfs:label": {
        "@value": "Reg_1054306_Par_17 (redaktsioon 1054306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054306",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054306",
      "estleg:sourceAct": "Maavarade registri asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1054306 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054306_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054306_Par_2_v1054306",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054306_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu eesmärk on geoloogilise uuringuga, maavara kaevandamise mahu aruannetega ning Keskkonnaameti nõusolekul markšeiderimõõdistusega saadud geoloogilise teabe kogumine ja kättesaadavuse tagamine. Andmekogu eesmärk on geoloogilise uuringuga, maavara kaevandamise mahu aruannetega ning Keskkonnaameti nõusolekul markšeiderimõõdistusega saadud geoloogilise teabe kogumine ja kättesaadavuse tagamine.",
      "rdfs:label": {
        "@value": "Reg_1054306_Par_2 (redaktsioon 1054306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054306",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054306",
      "estleg:sourceAct": "Maavarade registri asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1054306 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054306_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054306_Par_3_v1054306",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054306_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu vastutav töötleja on Eesti Geoloogiateenistus. RT I 2024-12-29 6 129122024006 2025-01-01 Andmekogu vastutav töötleja on Eesti Geoloogiateenistus. 2 (2) Andmekogu vastutav töötleja: 1 1) tagab andmekogu pidamise õigusaktides sätestatud nõuete järgi; 2 2) tagab andmekogu arendamise, haldamise ja pidamise finantseerimise; 3 3) juhib andmekogu arendustöid; 4 4) määrab andmekogu käideldavuse, tervikluse ja konfidentsiaalsuse tagamiseks andmekogu turvameetmed ja korraldab nende rakendamise; 5 5) sisestab, töötleb ja väljastab andmeid esitatud dokumentide põhjal; 6 6) koostab maavarade koondbilansi; 7 7) tagab andmekogusse kantud andmete kättesaadavuse ja asjakohasuse; 8 8) tagab andmekogu teenuste kasutajatoe; 9 9) informeerib volitatud töötlejat aegsasti kavandatavatest muudatustest andmekogu pidamisel ning olulistest takistustest ja probleemidest andmekoguga seotud kohustuste täitmisel; 10 10) teeb oma pädevuse piires järelevalvet andmekogu pidamise üle. Andmekogu vastutav töötleja: tagab andmekogu pidamise õigusaktides sätestatud nõuete järgi; tagab andmekogu arendamise, haldamise ja pidamise finantseerimise; juhib andmekogu arendustöid; määrab andmekogu käideldavuse, tervikluse ja konfidentsiaalsuse tagamiseks andmekogu turvameetmed ja korraldab nende rakendamise; sisestab, töötleb ja väljastab andmeid esitatud dokumentide põhjal; koostab maavarade koondbilansi; tagab andmekogusse kantud andmete kättesaadavuse ja asjakohasuse; tagab andmekogu teenuste kasutajatoe; informeerib volitatud töötlejat aegsasti kavandatavatest muudatustest andmekogu pidamisel ning olulistest takistustest ja probleemidest andmekoguga seotud kohustuste täitmisel; teeb oma pädevuse piires järelevalvet andmekogu pidamise üle.",
      "rdfs:label": {
        "@value": "Reg_1054306_Par_3 (redaktsioon 1054306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054306",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054306",
      "estleg:sourceAct": "Maavarade registri asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1054306 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054306_Map"
      }
    },
