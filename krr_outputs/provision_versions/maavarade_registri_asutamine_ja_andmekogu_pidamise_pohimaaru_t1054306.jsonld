    {
      "@id": "estleg:Reg_1054306_Par_10_v1054306",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054306_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogus säilitatakse andmeid alaliselt. Andmekogus säilitatakse andmeid alaliselt. 2 (2) Andmekogusse kantud andmete alusdokumente säilitatakse asjakohasel juhul kooskõlas maapõueseadusega ja vastutava töötleja asjaajamiskorras ette nähtud säilitustähtaegadega, mille lõppemise järel antakse need arhiiviseaduse ja muude seaduste ning nende alusel kehtestatud õigusaktide kohaselt avalikku arhiivi või otsustatakse nende hävitamine. Andmekogusse kantud andmete alusdokumente säilitatakse asjakohasel juhul kooskõlas maapõueseadusega ja vastutava töötleja asjaajamiskorras ette nähtud säilitustähtaegadega, mille lõppemise järel antakse need arhiiviseaduse ja muude seaduste ning nende alusel kehtestatud õigusaktide kohaselt avalikku arhiivi või otsustatakse nende hävitamine.",
      "rdfs:label": {
        "@value": "Reg_1054306_Par_10 (redaktsioon 1054306)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054306",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054306",
      "estleg:sourceAct": "Maavarade registri asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1054306 § 10",
      "estleg:partOfAct": {
