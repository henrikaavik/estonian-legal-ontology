    {
      "@id": "estleg:Reg_304798_Par_9_v304798",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304798_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud:11)poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus;22)koosluse kujundamine vastavalt kaitse-eesmärgile;33)olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine;44)olemasolevate teede ja ehitiste hooldustööd;55)pilliroo ja adru varumine. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: poollooduslike koosluste ilme ja liigikoosseisu tagamiseks ning kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; koosluse kujundamine vastavalt kaitse-eesmärgile; olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine; olemasolevate teede ja ehitiste hooldustööd; pilliroo ja adru varumine.",
      "rdfs:label": {
        "@value": "Reg_304798_Par_9 (redaktsioon 304798)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "304798",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/304798",
      "estleg:sourceAct": "Manija maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_304798 § 9",
