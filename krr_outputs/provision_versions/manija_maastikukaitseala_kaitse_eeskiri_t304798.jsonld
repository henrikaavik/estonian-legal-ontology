      "estleg:versionValidFrom": {
        "@value": "2010-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Anilaiu sihtkaitsevööndi kaitse-eesmärk on laiu maastikukompleksi ja haruldaste liikide kaitse. Anilaiu sihtkaitsevööndi kaitse-eesmärk on laiu maastikukompleksi ja haruldaste liikide kaitse.",
      "rdfs:label": {
        "@value": "Reg_304798_Par_8 (redaktsioon 304798)",
