    },
    {
      "@id": "estleg:Reg_304798_Par_8_v304798",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304798_Par_8"
