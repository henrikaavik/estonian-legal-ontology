    {
      "@id": "estleg:Reg_314550_Par_10_v314550",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_314550_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui kaitseminister on otsustanud sõjahaua kandmise nimekirja «Sõjahaudade kaitse seaduse» § 5 lõike 1 alusel enne käesoleva määruse jõustumist, peetakse nende sõjahaudade arvestust käesoleva määrusega sätestatud korras. Kui kaitseminister on otsustanud sõjahaua kandmise nimekirja «Sõjahaudade kaitse seaduse» § 5 lõike 1 alusel enne käesoleva määruse jõustumist, peetakse nende sõjahaudade arvestust käesoleva määrusega sätestatud korras. 2 (2) Kui vastava sõjahaua kohta puuduvad käesoleva määruse §-s 7 märgitud andmed, siis korraldab kaitseminister puuduolevate andmete lisamise ühe aasta jooksul käesoleva määruse jõustumisest. Kui vastava sõjahaua kohta puuduvad käesoleva määruse §-s 7 märgitud andmed, siis korraldab kaitseminister puuduolevate andmete lisamise ühe aasta jooksul käesoleva määruse jõustumisest.",
      "rdfs:label": {
        "@value": "Reg_314550_Par_10 (redaktsioon 314550)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "314550",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/314550",
      "estleg:sourceAct": "Sõjahaudade nimekirja pidamise kord",
      "estleg:provisionRef": "Reg_314550 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_314550_Map"
      }
    },
    {
      "@id": "estleg:Reg_314550_Par_2_v314550",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_314550_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nimekirjas peetakse Eestis asuvate sõjahaudade arvestust. Nimekirja pidamise eesmärk on sõjahaudade kohta andmete kogumine ja säilitamine sõjahaudade kaitse seadusest, teistest õigusaktidest ja rahvusvahelistest konventsioonidest tulenevate ülesannete täitmiseks. Nimekirjas peetakse Eestis asuvate sõjahaudade arvestust. Nimekirja pidamise eesmärk on sõjahaudade kohta andmete kogumine ja säilitamine sõjahaudade kaitse seadusest, teistest õigusaktidest ja rahvusvahelistest konventsioonidest tulenevate ülesannete täitmiseks.",
      "rdfs:label": {
        "@value": "Reg_314550_Par_2 (redaktsioon 314550)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "314550",
