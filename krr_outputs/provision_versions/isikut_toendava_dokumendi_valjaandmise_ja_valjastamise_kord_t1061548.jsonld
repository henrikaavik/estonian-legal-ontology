    {
      "@id": "estleg:Reg_1061548_Par_33_v1061548",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061548_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet teeb isikut tõendavate dokumentide seaduse § 115 lõikes 1 nimetatud toimingud kahe kuu jooksul pärast taotleja sooviavalduse saamist. Politsei- ja Piirivalveamet teeb isikut tõendavate dokumentide seaduse § 115 lõikes 1 nimetatud toimingud kahe kuu jooksul pärast taotleja sooviavalduse saamist.",
      "rdfs:label": {
        "@value": "Reg_1061548_Par_33 (redaktsioon 1061548)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061548",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061548",
      "estleg:sourceAct": "Isikut tõendava dokumendi väljaandmise ja väljastamise kord",
      "estleg:provisionRef": "Reg_1061548 § 33",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061548_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061548_Par_34_v1061548",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061548_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei- ja Piirivalveamet annab dokumendi välja või keeldub sellest 30 päeva jooksul pärast puudusteta taotluse menetlusse võtmist. Politsei- ja Piirivalveamet annab dokumendi välja või keeldub sellest 30 päeva jooksul pärast puudusteta taotluse menetlusse võtmist. 2 (2) Kui välismaalase passi taotleja esitab taotluse esitamise või menetlemise ajal elamisloa või elamisõiguse või selle pikendamise taotluse, antakse pass välja või keeldutakse sellest 30 päeva jooksul pärast elamisloa või elamisõiguse andmist või selle pikendamist või sellest keeldumist. Kui välismaalase passi taotleja esitab taotluse esitamise või menetlemise ajal elamisloa või elamisõiguse või selle pikendamise taotluse, antakse pass välja või keeldutakse sellest 30 päeva jooksul pärast elamisloa või elamisõiguse andmist või selle pikendamist või sellest keeldumist. 3 (3) Kui pagulase reisidokumendi taotleja esitab taotluse esitamise või menetlemise ajal rahvusvahelise kaitse ja elamisloa või selle pikendamise taotluse, antakse reisidokument välja või keeldutakse sellest 30 päeva jooksul pärast elamisloa andmist või selle pikendamist või sellest keeldumist. Kui pagulase reisidokumendi taotleja esitab taotluse esitamise või menetlemise ajal rahvusvahelise kaitse ja elamisloa või selle pikendamise taotluse, antakse reisidokument välja või keeldutakse sellest 30 päeva jooksul pärast elamisloa andmist või selle pikendamist või sellest keeldumist. 4 (4) Kui e-residendi digitaalne isikutunnistus antakse välja kaaluka avaliku huvi korral, antakse isikutunnistus välja või keeldutakse sellest 30 päeva jooksul pärast isikut tõendavate dokumentide seaduse § 2011 lõike 4 alusel otsuse tegemist. Kui e-residendi digitaalne isikutunnistus antakse välja kaaluka avaliku huvi korral, antakse isikutunnistus välja või keeldutakse sellest 30 päeva jooksul pärast isikut tõendavate dokumentide seaduse § 2011 lõike 4 alusel otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_1061548_Par_34 (redaktsioon 1061548)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061548",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061548",
      "estleg:sourceAct": "Isikut tõendava dokumendi väljaandmise ja väljastamise kord",
      "estleg:provisionRef": "Reg_1061548 § 34",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061548_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061548_Par_35_v1061548",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061548_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet teavitab taotlejat dokumendi väljaandmisest keeldumisest ja selle põhjusest kirjalikult seitsme tööpäeva jooksul pärast otsuse tegemist, kasutades taotluses või ettepanekus esitatud kontaktandmeid. Politsei- ja Piirivalveamet teavitab taotlejat dokumendi väljaandmisest keeldumisest ja selle põhjusest kirjalikult seitsme tööpäeva jooksul pärast otsuse tegemist, kasutades taotluses või ettepanekus esitatud kontaktandmeid.",
      "rdfs:label": {
        "@value": "Reg_1061548_Par_35 (redaktsioon 1061548)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061548",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061548",
      "estleg:sourceAct": "Isikut tõendava dokumendi väljaandmise ja väljastamise kord",
      "estleg:provisionRef": "Reg_1061548 § 35",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061548_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061548_Par_36_v1061548",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061548_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Dokumendi väljaandmise tähtaega võib pikendada, kui selle jooksul ei ole võimalik: 1 1) kontrollida dokumendi väljaandmise või sellest keeldumise aluse olemasolu või 2 2) tuvastada taotleja isikut või kontrollida tema isikusamasust. Dokumendi väljaandmise tähtaega võib pikendada, kui selle jooksul ei ole võimalik: kontrollida dokumendi väljaandmise või sellest keeldumise aluse olemasolu või tuvastada taotleja isikut või kontrollida tema isikusamasust. 2 (2) Dokumendi väljaandmise tähtaega võib pikendada korduvalt kuni 30 päeva kaupa. Dokumendi väljaandmise tähtaega võib pikendada korduvalt kuni 30 päeva kaupa. 3 (3) Politsei- ja Piirivalveamet teavitab taotlejat dokumendi väljaandmise tähtaja pikendamisest ja selle põhjusest ning uuest tähtajast kirjalikult viivitamata, kasutades taotluses või ettepanekus esitatud kontaktandmeid. Politsei- ja Piirivalveamet teavitab taotlejat dokumendi väljaandmise tähtaja pikendamisest ja selle põhjusest ning uuest tähtajast kirjalikult viivitamata, kasutades taotluses või ettepanekus esitatud kontaktandmeid.",
      "rdfs:label": {
        "@value": "Reg_1061548_Par_36 (redaktsioon 1061548)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061548",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061548",
      "estleg:sourceAct": "Isikut tõendava dokumendi väljaandmise ja väljastamise kord",
      "estleg:provisionRef": "Reg_1061548 § 36",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061548_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061548_Par_37_v1061548",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061548_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist esitatud taotlust menetletakse selle esitamise ajal kehtinud tingimustel ja korras. Enne käesoleva määruse jõustumist esitatud taotlust menetletakse selle esitamise ajal kehtinud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "Reg_1061548_Par_37 (redaktsioon 1061548)",
        "@language": "et"
      },
