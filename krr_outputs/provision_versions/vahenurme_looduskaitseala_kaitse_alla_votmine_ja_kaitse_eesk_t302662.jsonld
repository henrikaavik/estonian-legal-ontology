      "estleg:provisionRef": "Reg_302662 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302662_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_302662_Par_9_v302662",
      "@type": [
        "owl:NamedIndividual",
