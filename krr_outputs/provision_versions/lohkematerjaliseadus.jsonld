    },
    {
      "@id": "estleg:LOHKEM_Par_27_v1011026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOHKEM_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lõhkematerjalitehase projekteerimisel järgitakse planeerimisseaduse (RT I 2002, 99, 579) ja ehitusseaduse nõudeid ning arvestatakse tervisekaitse-, keskkonnakaitse- ja tuleohutusnõudeid. (2) Lõhkematerjalitehase projekteerimisel tuleb: selgitada abinõud, mis võimaldavad lõhkematerjali valmistamise ajal vältida plahvatust ja leevendada võimaliku õnnetuse tagajärgi; arvestada, et tehase asukoha valik ja ehitiste paigutus oleks kooskõlas ohutusnõuetega; arvestada, et tehase territooriumi ja ehitiste paigutus võimaldaks avarii korral vältida ohtlike ainete sattumist keskkonda; lähtuda käesoleva seaduse ja ehitusloa taotlemisel ehitusprojektile esitatavatest nõuetest.",
      "rdfs:label": {
        "@value": "LOHKEM_Par_27 (redaktsioon 1011026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1011026",
