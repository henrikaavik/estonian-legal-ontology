      }
    },
    {
      "@id": "estleg:LOHKEM_Par_23_v13261212",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOHKEM_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "LOHKEM_Par_23 (redaktsioon 13261212)",
        "@language": "et"
      },
