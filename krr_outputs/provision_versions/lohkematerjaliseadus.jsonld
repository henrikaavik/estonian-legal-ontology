      }
    },
    {
      "@id": "estleg:LOHKEM_Par_19_v121062017001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LOHKEM_Par_19"
      },
      "estleg:versionValidFrom": {
