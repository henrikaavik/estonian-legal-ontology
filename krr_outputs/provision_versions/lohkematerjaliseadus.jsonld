      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "LOHKEM_Par_52 (redaktsioon 13329263)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329263",
      "estleg:supersededByVersion": {
        "@id": "estleg:LOHKEM_Par_52_v121062017001"
      },
      "estleg:versionValidTo": {
