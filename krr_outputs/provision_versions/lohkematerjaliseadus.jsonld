        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "LOHKEM_Par_27 (redaktsioon 123032015123)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015123",
