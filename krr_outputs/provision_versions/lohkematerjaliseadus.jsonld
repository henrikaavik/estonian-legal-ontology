      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "LOHKEM_Par_23 (redaktsioon 13329263)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329263",
      "estleg:supersededByVersion": {
