      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302741_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavarade kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) uuendusraie, välja arvatud turberaie raielangi suurusega kuni 2 ha, kusjuures raie tegemisel tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 5 5) biotsiidi ja taimekaitsevahendi kasutamine väljaspool õuemaad. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavarade kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; uuendusraie, välja arvatud turberaie raielangi suurusega kuni 2 ha, kusjuures raie tegemisel tuleb säilitada koosluse liikide ja vanuse mitmekesisus; biotsiidi ja taimekaitsevahendi kasutamine väljaspool õuemaad.",
      "rdfs:label": {
        "@value": "Reg_302741_Par_15 (redaktsioon 302741)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302741",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302741",
      "estleg:sourceAct": "Esna maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_302741 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302741_Map"
      }
    },
    {
      "@id": "estleg:Reg_302741_Par_2_v302741",
      "@type": [
        "owl:NamedIndividual",
