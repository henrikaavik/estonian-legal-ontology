    {
      "@id": "estleg:Reg_312121_Par_5_v312121",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312121_Par_5"
