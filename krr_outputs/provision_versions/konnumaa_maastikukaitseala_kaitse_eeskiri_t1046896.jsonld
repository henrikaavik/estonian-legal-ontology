        "@value": "2019-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1046896_Par_3 (redaktsioon 1046896)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046896",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046896",
