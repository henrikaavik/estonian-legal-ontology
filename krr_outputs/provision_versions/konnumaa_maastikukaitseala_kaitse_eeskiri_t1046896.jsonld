      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 25. septembri 2015. a käskkirjaga nr 840 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 25. septembri 2015. a käskkirjaga nr 840 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1046896_Par_21 (redaktsioon 1046896)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046896",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046896",
      "estleg:sourceAct": "Kõnnumaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1046896 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046896_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046896_Par_22_v1046896",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046896_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1046896_Par_22 (redaktsioon 1046896)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046896",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046896",
      "estleg:sourceAct": "Kõnnumaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1046896 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046896_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046896_Par_3_v1046896",
      "@type": [
        "owl:NamedIndividual",
