    {
      "@id": "estleg:Reg_1046896_Par_20_v1046896",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046896_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 27. juuli 2006. a määruse nr 175 „Hoiualade kaitse alla võtmine Rapla maakonnas” § 1 lõike 1 punkt 91 ja määruse lisas esitatud kaart „Kõrgemäe” tunnistatakse kehtetuks. Vabariigi Valitsuse 27. juuli 2006. a määruse nr 175 „Hoiualade kaitse alla võtmine Rapla maakonnas” § 1 lõike 1 punkt 91 ja määruse lisas esitatud kaart „Kõrgemäe” tunnistatakse kehtetuks.",
      "rdfs:label": {
