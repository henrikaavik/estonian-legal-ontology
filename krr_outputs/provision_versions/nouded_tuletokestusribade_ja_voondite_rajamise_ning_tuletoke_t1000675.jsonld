      }
    },
    {
      "@id": "estleg:Reg_1000675_Par_6_v1000675",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000675_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tuletõkestusribalt tuleb eemaldada sinna langenud puud ja oksad ning tuletõkestusriba rohtumise vältimiseks tuleb seda perioodiliselt mineraliseerida. Tuletõkestusribalt tuleb eemaldada sinna langenud puud ja oksad ning tuletõkestusriba rohtumise vältimiseks tuleb seda perioodiliselt mineraliseerida. 2 (2) Tulekaitsevööndi hooldamisel tuleb tagada vööndis lehtpuuenamus või tulekaitsevööndi vastavus määruse § 4 lõike 3 nõuetele. Tulekaitsevööndi hooldamisel tuleb tagada vööndis lehtpuuenamus või tulekaitsevööndi vastavus määruse § 4 lõike 3 nõuetele.",
