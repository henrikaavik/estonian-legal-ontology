    },
    {
      "@id": "estleg:Reg_1030329_Par_28_v1030329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030329_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tee omanik tagab nõutava talvise seisunditaseme järgmiselt: 1 1) kergliiklusteel, 1. seisunditasemega teel, 4. seisunditasemega tänaval ja kõikidel maanteedel – igal ajal; 2 2) 3. seisunditasemega tänaval – ajavahemikus kell 6.00–22.00, muul ajal on lubatav 2. seisunditase; 3 3) 2. seisunditasemega tänaval – ajavahemikus kell 7.00–21.00, muul ajal on lubatav 1. seisunditase. RT I 2018-11-02 2 102112018002 2018-11-05 Tee omanik tagab nõutava talvise seisunditaseme järgmiselt: kergliiklusteel, 1. seisunditasemega teel, 4. seisunditasemega tänaval ja kõikidel maanteedel – igal ajal; 3. seisunditasemega tänaval – ajavahemikus kell 6.00–22.00, muul ajal on lubatav 2. seisunditase; 2. seisunditasemega tänaval – ajavahemikus kell 7.00–21.00, muul ajal on lubatav 1. seisunditase.",
      "rdfs:label": {
        "@value": "Reg_1030329_Par_28 (redaktsioon 1030329)",
        "@language": "et"
      },
