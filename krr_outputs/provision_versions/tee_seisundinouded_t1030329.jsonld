      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Talvise seisunditaseme muutus teel võib toimuda ristmikel, asula piiril või kattega tee üleminekul kruusateeks, kuid mitte ohtlikes kohtades või teelõikudel. Talvise seisunditaseme muutus teel võib toimuda ristmikel, asula piiril või kattega tee üleminekul kruusateeks, kuid mitte ohtlikes kohtades või teelõikudel.",
      "rdfs:label": {
        "@value": "Reg_1030329_Par_24 (redaktsioon 1030329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030329",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030329",
      "estleg:sourceAct": "Tee seisundinõuded",
      "estleg:provisionRef": "Reg_1030329 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030329_Map"
      }
    },
    {
      "@id": "estleg:Reg_1030329_Par_25_v1030329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030329_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ristmiku, silla, väljaku ja ühissõiduki peatuskoha, sealhulgas bussiooteplatvormi talvine seisundtase peab olema vähemalt samaväärne tee seisunditasemega, kus rajatis asub. Ristmiku, silla, väljaku ja ühissõiduki peatuskoha, sealhulgas bussiooteplatvormi talvine seisundtase peab olema vähemalt samaväärne tee seisunditasemega, kus rajatis asub. 2 (2) Parkla talvine seisund peab vastama vähemalt käesoleva määruse lisadega kehtestatud 1. seisunditasemele. Parkla talvine seisund peab vastama vähemalt käesoleva määruse lisadega kehtestatud 1. seisunditasemele. 3 (3) Kasutuses olevate mahasõitude talvine seisund peab teemaa ulatuses vastama vähemalt käesoleva määruse lisadega kehtestatud 1. seisunditasemele. Kasutuses olevate mahasõitude talvine seisund peab teemaa ulatuses vastama vähemalt käesoleva määruse lisadega kehtestatud 1. seisunditasemele.",
      "rdfs:label": {
        "@value": "Reg_1030329_Par_25 (redaktsioon 1030329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030329",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030329",
