      }
    },
    {
      "@id": "estleg:Reg_1030329_Par_4_v1030329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030329_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-29",
