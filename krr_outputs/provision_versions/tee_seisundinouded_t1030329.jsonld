      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Reg_1030329_Par_29 (redaktsioon 1030329)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030329",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030329",
