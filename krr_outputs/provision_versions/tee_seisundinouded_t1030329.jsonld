    {
      "@id": "estleg:Reg_1030329_Par_15_15_v1030329",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030329_Par_15_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kergliiklustee on kõnni-, jalg-, jalgratta- ja jalg- või jalgrattatee. Kergliiklustee on kõnni-, jalg-, jalgratta- ja jalg- või jalgrattatee. 2 (2) Jalgrattarajale kohaldatakse sõidutee kohta esitatud nõudeid. Jalgrattarajale kohaldatakse sõidutee kohta esitatud nõudeid. 3 (3) Kergliiklustee seisundinõuded on esitatud lisas 10. RT I 2018-11-02 2 102112018002 2018-11-05 Kergliiklustee seisundinõuded on esitatud lisas 10.",
      "rdfs:label": {
