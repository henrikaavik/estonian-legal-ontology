    {
      "@id": "estleg:Reg_322057_Par_2_v322057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_322057_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kooskõlastuse andmisega kinnitab ICAO sageduste koordinaator Eestis (edaspidi koordinaator), et lennuliikluse teenindamiseks ettenähtud raadioside-, navigatsiooni- või jälgimisseadmetele on tagatud häirevaba töö. Kooskõlastuse andmisega kinnitab ICAO sageduste koordinaator Eestis (edaspidi koordinaator), et lennuliikluse teenindamiseks ettenähtud raadioside-, navigatsiooni- või jälgimisseadmetele on tagatud häirevaba töö.",
      "rdfs:label": {
        "@value": "Reg_322057_Par_2 (redaktsioon 322057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "322057",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/322057",
      "estleg:sourceAct": "Sagedusloa tingimuste ja raadiosaateseadme paigaldamise tingimuste kooskõlastamise kord ning kooskõlastamisele kuuluvad lennuliikluse teenindamiseks ettenähtud sagedusalad",
      "estleg:provisionRef": "Reg_322057 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_322057_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_322057_Par_3_v322057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_322057_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavalt Eesti raadiosagedusplaanile kuuluvad enne sagedusloa andmist koordinaatoriga kooskõlastamisele järgmised raadiosideteenistuste poolt kasutatavad raadiosagedusalad: 1 1) liikuv lennuside lennutrassidel (R), lennuraadionavigatsioon või raadiolokatsioon; 2 2) liikuv lennuside väljapool lennutrasse (OR) juhul, kui kasutatavad raadiosagedused kattuvad punktis 1 ettenähtud raadiosagedusaladega. Vastavalt Eesti raadiosagedusplaanile kuuluvad enne sagedusloa andmist koordinaatoriga kooskõlastamisele järgmised raadiosideteenistuste poolt kasutatavad raadiosagedusalad: liikuv lennuside lennutrassidel (R), lennuraadionavigatsioon või raadiolokatsioon; liikuv lennuside väljapool lennutrasse (OR) juhul, kui kasutatavad raadiosagedused kattuvad punktis 1 ettenähtud raadiosagedusaladega.",
      "rdfs:label": {
        "@value": "Reg_322057_Par_3 (redaktsioon 322057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "322057",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/322057",
      "estleg:sourceAct": "Sagedusloa tingimuste ja raadiosaateseadme paigaldamise tingimuste kooskõlastamise kord ning kooskõlastamisele kuuluvad lennuliikluse teenindamiseks ettenähtud sagedusalad",
      "estleg:provisionRef": "Reg_322057 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_322057_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_322057_Par_4_v322057",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_322057_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tehnilise Järelevalve Amet esitab kolme tööpäeva jooksul pärast sagedusloa taotluse või sagedusloa tingimuste muutmise taotluse saamist või puudustega esitatud taotluses puuduste kõrvaldamist sagedusloa tingimused koordinaatorile kooskõlastamiseks kirjalikult posti või e-posti teel. Tehnilise Järelevalve Amet esitab kolme tööpäeva jooksul pärast sagedusloa taotluse või sagedusloa tingimuste muutmise taotluse saamist või puudustega esitatud taotluses puuduste kõrvaldamist sagedusloa tingimused koordinaatorile kooskõlastamiseks kirjalikult posti või e-posti teel. 2 (2) Koordinaator võib vajadusel nõuda Tehnilise Järelevalve Ametilt sagedusloa tingimuste kohta täpsustavat teavet ja lisadokumente. Koordinaator võib vajadusel nõuda Tehnilise Järelevalve Ametilt sagedusloa tingimuste kohta täpsustavat teavet ja lisadokumente. 3 (3) Koordinaator teavitab Tehnilise Järelevalve Ametit kirjalikult posti või e-posti teel rahvusvahelise koordineerimise menetluse algatamisest ühe kuu jooksul arvates sagedusloa tingimuste saamisest. Tehnilise Järelevalve Amet teavitab sagedusloa taotlejat rahvusvahelise koordineerimise menetluse algatamisest kümne päeva jooksul pärast teate saamist kirjalikult või e-posti teel. Koordinaator teavitab Tehnilise Järelevalve Ametit kirjalikult posti või e-posti teel rahvusvahelise koordineerimise menetluse algatamisest ühe kuu jooksul arvates sagedusloa tingimuste saamisest. Tehnilise Järelevalve Amet teavitab sagedusloa taotlejat rahvusvahelise koordineerimise menetluse algatamisest kümne päeva jooksul pärast teate saamist kirjalikult või e-posti teel. 4 (4) Koordinaator väljastab sagedusloa tingimuste kooskõlastuse või põhjendatud kooskõlastusest keeldumise Tehnilise Järelevalve Ametile kirjalikult posti või digitaalallkirjaga allkirjastatult e-posti teel: 1 1) viie nädala jooksul sagedusloa tingimuste esitamisest koordinaatorile, kui raadiosageduste kasutamine ei vaja rahvusvahelist koordineerimist; 2 2) kümne kuu jooksul sagedusloa tingimuste esitamisest koordinaatorile, kui raadiosageduste kasutamine vajab rahvusvahelist koordineerimist. Koordinaator väljastab sagedusloa tingimuste kooskõlastuse või põhjendatud kooskõlastusest keeldumise Tehnilise Järelevalve Ametile kirjalikult posti või digitaalallkirjaga allkirjastatult e-posti teel: viie nädala jooksul sagedusloa tingimuste esitamisest koordinaatorile, kui raadiosageduste kasutamine ei vaja rahvusvahelist koordineerimist; kümne kuu jooksul sagedusloa tingimuste esitamisest koordinaatorile, kui raadiosageduste kasutamine vajab rahvusvahelist koordineerimist. 5 (5) Koordinaator teavitab ICAO-d Eestis kasutusele võetud lennuliiklusteenistuse raadioseadmete raadiosagedustest ametlikuks avaldamiseks. Koordinaator teavitab ICAO-d Eestis kasutusele võetud lennuliiklusteenistuse raadioseadmete raadiosagedustest ametlikuks avaldamiseks.",
      "rdfs:label": {
        "@value": "Reg_322057_Par_4 (redaktsioon 322057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "322057",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/322057",
      "estleg:sourceAct": "Sagedusloa tingimuste ja raadiosaateseadme paigaldamise tingimuste kooskõlastamise kord ning kooskõlastamisele kuuluvad lennuliikluse teenindamiseks ettenähtud sagedusalad",
      "estleg:provisionRef": "Reg_322057 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_322057_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_322057_Par_5_v322057",
      "@type": [
