    },
    {
      "@id": "estleg:Reg_1043937_Par_19_v1043937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043937_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registri tegevuse lõpetamise otsustab Vabariigi Valitsus. Registri tegevuse lõpetamise otsustab Vabariigi Valitsus. 2 (2) Registri lõpetamine toimub kooskõlas arhiiviseaduse ja avaliku teabe seaduse nõuetega. Registri lõpetamine toimub kooskõlas arhiiviseaduse ja avaliku teabe seaduse nõuetega.",
      "rdfs:label": {
        "@value": "Reg_1043937_Par_19 (redaktsioon 1043937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043937",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043937",
