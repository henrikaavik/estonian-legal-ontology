        "@language": "et"
      },
      "estleg:versionRedactionId": "1043937",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043937",
      "estleg:sourceAct": "Pakendiregistri põhimäärus",
      "estleg:provisionRef": "Reg_1043937 § 10",
