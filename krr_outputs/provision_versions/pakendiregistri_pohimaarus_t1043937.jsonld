      "estleg:provisionRef": "Reg_1043937 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043937_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043937_Par_2_v1043937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043937_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registri eesmärk on turule lastud kauba pakendite, Eestis tekkinud pakendijäätmete, pakendi korduskasutuse, pakendijäätmete taaskasutamise, taaskasutamise sihtarvude täitmise ja ühekordselt kasutatavate plastpakendite üle arvestuse pidamine pakendiseadusest ja pakendiaktsiisi seadusest tulenevate ülesannete täitmiseks, järelevalve teostamiseks ja Euroopa Komisjonile pakendijäätmete, õhukeste ja eriti õhukeste plastkandekottide tarbimise ning ühekordselt kasutatavate plastpakendite kohta teabe esitamiseks. RT I 2023-11-24 6 124112023006 2025-01-01 Registri eesmärk on turule lastud kauba pakendite, Eestis tekkinud pakendijäätmete, pakendi korduskasutuse, pakendijäätmete taaskasutamise, taaskasutamise sihtarvude täitmise ja ühekordselt kasutatavate plastpakendite üle arvestuse pidamine pakendiseadusest ja pakendiaktsiisi seadusest tulenevate ülesannete täitmiseks, järelevalve teostamiseks ja Euroopa Komisjonile pakendijäätmete, õhukeste ja eriti õhukeste plastkandekottide tarbimise ning ühekordselt kasutatavate plastpakendite kohta teabe esitamiseks.",
      "rdfs:label": {
        "@value": "Reg_1043937_Par_2 (redaktsioon 1043937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043937",
