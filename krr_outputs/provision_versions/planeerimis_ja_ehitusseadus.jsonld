        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/178637",
      "estleg:sourceAct": "Planeerimis- ja ehitusseadus",
      "estleg:provisionRef": "PLANEE § 54",
      "estleg:partOfAct": {
        "@id": "estleg:PLANEE_Map_2026"
      }
    },
    {
      "@id": "estleg:PLANEE_Par_54_v193813",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PLANEE_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ehitusluba ei anta, kui: ehitusprojekt ei vasta kehtestatud detailplaneeringule ja projekteerimistingimustele; ehitusprojekti ei ole koostanud või kontrollinud kõrgharidusega arhitekt ja vastava ehituseriala kõrgharidusega insener; projekteeritud ehitis kahjustab asjaõigusseaduse (RT I 1993, 39, 590; 1995, 26-28, 355) §-des 143-154 sätestatud naabrusõigusi ja naabriga ei ole saavutatud kokkulepet; ehitusprojekt ei vasta ehitusnormidele ja teistele õigusaktidele.",
      "rdfs:label": {
