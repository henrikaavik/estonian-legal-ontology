      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PLANEE_Par_67 (redaktsioon 193813)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193813",
