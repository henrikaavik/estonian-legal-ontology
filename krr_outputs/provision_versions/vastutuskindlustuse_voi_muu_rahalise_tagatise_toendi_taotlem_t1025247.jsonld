      "dc:source": "Vastutuskindlustuse või muu rahalise tagatise tõendi taotlemise, andmise, kehtetuks tunnistamise ja hoidmise kord"
    },
    {
      "@id": "estleg:Reg_1025247_Par_1_v1025247",
