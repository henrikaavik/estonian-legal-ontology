    {
      "@id": "estleg:Reg_1052298_Par_11_v1052298",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052298_Par_11"
