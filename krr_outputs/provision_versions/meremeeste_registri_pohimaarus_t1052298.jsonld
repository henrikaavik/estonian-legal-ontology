    {
      "@id": "estleg:Reg_1052298_Par_14_v1052298",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052298_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmete andmekogusse kandmine, muutmine, kustutamine, andmete vaatamine ja nende väljastamine logitakse. Andmete andmekogusse kandmine, muutmine, kustutamine, andmete vaatamine ja nende väljastamine logitakse. 2 (2) Andmete andmekogusse kandmise, muutmise ja kustutamise kannete kohta säilitatakse logis kande sisu, kuupäev, kellaaeg ja kande tegija nimi. Andmete andmekogusse kandmise, muutmise ja kustutamise kannete kohta säilitatakse logis kande sisu, kuupäev, kellaaeg ja kande tegija nimi. 3 (3) Andmete vaatamise kohta säilitatakse logis andmete vaatamise kuupäev, kellaaeg ja andmeid vaadanud isiku nimi. Andmete vaatamise kohta säilitatakse logis andmete vaatamise kuupäev, kellaaeg ja andmeid vaadanud isiku nimi. 4 (4) Andmete andmekogust väljastamise kohta säilitatakse logis andmete väljastamise kuupäev, kellaaeg, andmeid väljastanud isiku nimi ja andmete saaja nimi. Andmete andmekogust väljastamise kohta säilitatakse logis andmete väljastamise kuupäev, kellaaeg, andmeid väljastanud isiku nimi ja andmete saaja nimi.",
      "rdfs:label": {
        "@value": "Reg_1052298_Par_14 (redaktsioon 1052298)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052298",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052298",
