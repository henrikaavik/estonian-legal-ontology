    {
      "@id": "estleg:Reg_1052298_Par_12_v1052298",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052298_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-07-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu vastutaval töötlejal on õigusaktiga talle pandud ülesannete täitmiseks õigus esitada päringuid ja saada andmeid teisest riigi andmekogust riigi infosüsteemide andmevahetuskihi kaudu järgmiselt: 1 1) rahvastikuregistrist füüsilise isiku nimi, isikukood ja kodakondsuse andmed; 2 2) äriregistrist juriidilise isiku nimi ja registrikood ning seadusjärgse esindaja nimi ja esindusõiguse ulatus; 3 3) isikut tõendavate dokumentide andmekogust näokujutis ja allkirjakujutis; 4 4) Eesti hariduse infosüsteemist haridust tõendavate dokumentide andmed. Andmekogu vastutaval töötlejal on õigusaktiga talle pandud ülesannete täitmiseks õigus esitada päringuid ja saada andmeid teisest riigi andmekogust riigi infosüsteemide andmevahetuskihi kaudu järgmiselt: rahvastikuregistrist füüsilise isiku nimi, isikukood ja kodakondsuse andmed; äriregistrist juriidilise isiku nimi ja registrikood ning seadusjärgse esindaja nimi ja esindusõiguse ulatus; isikut tõendavate dokumentide andmekogust näokujutis ja allkirjakujutis; Eesti hariduse infosüsteemist haridust tõendavate dokumentide andmed.",
      "rdfs:label": {
        "@value": "Reg_1052298_Par_12 (redaktsioon 1052298)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052298",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052298",
      "estleg:sourceAct": "Meremeeste registri põhimäärus",
