        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TÕAS_Par_59_v106012023036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TÕAS_Par_59"
      },
      "estleg:versionValidFrom": {
