        "@type": "xsd:date"
      },
      "estleg:versionText": "Apellatsioonikomisjonile esitatavatele tõenditele kohaldatakse haldusmenetluse seaduse §-s 38 sätestatut.",
      "rdfs:label": {
        "@value": "TÕAS_Par_60 (redaktsioon 13122234)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13122234",
      "estleg:supersededByVersion": {
        "@id": "estleg:TÕAS_Par_60_v119032019063"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-31",
