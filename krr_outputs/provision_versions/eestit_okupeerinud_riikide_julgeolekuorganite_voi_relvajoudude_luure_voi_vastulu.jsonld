    {
      "@id": "estleg:OkupS_Par_3_v184536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OkupS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Julgeoleku- või luureorgani teenistuses olnud või sellega koostööd teinud isik on käesoleva seaduse mõistes: Eesti Vabariigi kodanik, kes oli julgeoleku- või luureorgani teenistuses või tegi sellega koostööd ajavahemikus 1940. aasta 17. juunist kuni 1991. aasta 31. detsembrini ja elab Eesti Vabariigi jurisdiktsioonile alluval territooriumil; välismaalane või kodakondsuseta isik, kes oli julgeoleku- või luureorgani teenistuses või tegi sellega koostööd ajavahemikus 1940. aasta 17. juunist kuni 1991. aasta 31. detsembrini ja elab Eesti Vabariigi jurisdiktsioonile alluval territooriumil.",
      "rdfs:label": {
        "@value": "OkupS_Par_3 (redaktsioon 184536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184536",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/184536",
