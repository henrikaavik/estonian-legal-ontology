      "estleg:versionOf": {
        "@id": "estleg:Reg_1038400_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib Justiits- ja Digiministeeriumi poolt vangla üle teenistusliku järelevalve korras teenistusvalve tegemist. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Määrus reguleerib Justiits- ja Digiministeeriumi poolt vangla üle teenistusliku järelevalve korras teenistusvalve tegemist. , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_1038400_Par_1 (redaktsioon 1038400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038400",
      "estleg:sourceAct": "Vangla teenistusvalve kord",
      "estleg:provisionRef": "Reg_1038400 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038400_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038400_Par_2_v1038400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038400_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenistusvalvet vanglas teeb Justiits- ja Digiministeeriumi vanglate osakond. Teenistusvalvet teevad Justiits- ja Digiministeeriumi vanglate osakonna teenistujad, kellele on see ülesanne pandud, ja teenistusvalve tegemisse kaasatud muud isikud. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Teenistusvalvet vanglas teeb Justiits- ja Digiministeeriumi vanglate osakond. Teenistusvalvet teevad Justiits- ja Digiministeeriumi vanglate osakonna teenistujad, kellele on see ülesanne pandud, ja teenistusvalve tegemisse kaasatud muud isikud. , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 2 (2) Teenistusvalve tegemisse võib vajaduse korral kaasata muid vanglateenistuses olevaid ametnikke ja töötajaid, samuti teisi asjatundjaid nii ministeeriumist ja selle valitsemisalast kui ka väljastpoolt, kui neil on teadmisi või oskusi, mis aitavad kaasa teenistusvalve eesmärgi saavutamisele. Teenistusvalve tegemisse võib vajaduse korral kaasata muid vanglateenistuses olevaid ametnikke ja töötajaid, samuti teisi asjatundjaid nii ministeeriumist ja selle valitsemisalast kui ka väljastpoolt, kui neil on teadmisi või oskusi, mis aitavad kaasa teenistusvalve eesmärgi saavutamisele.",
      "rdfs:label": {
        "@value": "Reg_1038400_Par_2 (redaktsioon 1038400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038400",
      "estleg:sourceAct": "Vangla teenistusvalve kord",
      "estleg:provisionRef": "Reg_1038400 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038400_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038400_Par_3_v1038400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038400_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenistusvalve vangla tegevuse üle toimub korralise teenistusvalve, erakorralise teenistusvalve ja teenistusvalve järelkontrollina. Teenistusvalve vangla tegevuse üle toimub korralise teenistusvalve, erakorralise teenistusvalve ja teenistusvalve järelkontrollina. 2 (2) Korralist teenistusvalvet tehakse Justiits- ja Digiministeeriumi tööplaani alusel. Selle käigus kontrollitakse vangla struktuuriüksuse ja teenistujate tegevuse ning aktide ja toimingute seaduslikkust, vanglas toimuva protsessi otstarbekust ja vastavust vanglale antud juhistele, tegevuse aluseks olevatele põhimõtetele ja hea halduse tavale. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Korralist teenistusvalvet tehakse Justiits- ja Digiministeeriumi tööplaani alusel. Selle käigus kontrollitakse vangla struktuuriüksuse ja teenistujate tegevuse ning aktide ja toimingute seaduslikkust, vanglas toimuva protsessi otstarbekust ja vastavust vanglale antud juhistele, tegevuse aluseks olevatele põhimõtetele ja hea halduse tavale. , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes 3 (3) Erakorralist teenistusvalvet tehakse põhjendatud juhtudel, kui on alust arvata, et vangla tegevuses esineb kiiret kõrvaldamist vajavaid olulisi puudusi. Erakorralise teenistusvalve tegemise otsustab justiitsminister. Erakorralist teenistusvalvet tehakse põhjendatud juhtudel, kui on alust arvata, et vangla tegevuses esineb kiiret kõrvaldamist vajavaid olulisi puudusi. Erakorralise teenistusvalve tegemise otsustab justiitsminister. 4 (4) Ettekirjutuse nõuetekohase täitmise kontrollimiseks tehakse vajaduse korral teenistusvalve järelkontroll. Järelkontrolli tehakse Justiits- ja Digiministeeriumi tööplaani alusel või ministri käskkirja alusel. RT I 2024-12-30 1 130122024001 2025-01-01 , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes Ettekirjutuse nõuetekohase täitmise kontrollimiseks tehakse vajaduse korral teenistusvalve järelkontroll. Järelkontrolli tehakse Justiits- ja Digiministeeriumi tööplaani alusel või ministri käskkirja alusel. , Vabariigi Valitsuse seaduse paragrahvi 105.19 lõike 12 alusel asendatud sõna „Justiitsministeerium” sõnadega „Justiits- ja Digiministeerium” vastavas käändes",
      "rdfs:label": {
        "@value": "Reg_1038400_Par_3 (redaktsioon 1038400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038400",
      "estleg:sourceAct": "Vangla teenistusvalve kord",
      "estleg:provisionRef": "Reg_1038400 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038400_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038400_Par_4_v1038400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038400_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenistusvalve käigus vesteldakse vangla teenistujatega, nõutakse vajaduse korral välja ja analüüsitakse akte ja muid asjakohaseid materjale, jälgitakse kontrollitavaid protsesse, vaadeldakse territooriumi, ruume ja muud vara, tehakse päringuid registritesse ning kasutatakse muid meetodeid, mis on asjakohased teenistusvalve eesmärgi saavutamiseks. Teenistusvalve käigus vesteldakse vangla teenistujatega, nõutakse vajaduse korral välja ja analüüsitakse akte ja muid asjakohaseid materjale, jälgitakse kontrollitavaid protsesse, vaadeldakse territooriumi, ruume ja muud vara, tehakse päringuid registritesse ning kasutatakse muid meetodeid, mis on asjakohased teenistusvalve eesmärgi saavutamiseks. 2 (2) Vajalikud toimingud ja nende tegemise viisi ning ulatuse valivad ja planeerivad teenistusvalve tegijad. Vajalikud toimingud ja nende tegemise viisi ning ulatuse valivad ja planeerivad teenistusvalve tegijad.",
      "rdfs:label": {
        "@value": "Reg_1038400_Par_4 (redaktsioon 1038400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038400",
      "estleg:sourceAct": "Vangla teenistusvalve kord",
      "estleg:provisionRef": "Reg_1038400 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038400_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038400_Par_5_v1038400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038400_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vanglat teavitatakse teenistusvalve toimingute ajast ette vähemalt kaks nädalat, välja arvatud juhul, kui see ei ole otstarbekas lähtuvalt teenistusvalve eesmärgist või käesolevast määrusest ei tulene teisiti. Vanglat teavitatakse teenistusvalve toimingute ajast ette vähemalt kaks nädalat, välja arvatud juhul, kui see ei ole otstarbekas lähtuvalt teenistusvalve eesmärgist või käesolevast määrusest ei tulene teisiti. 2 (2) Erakorralisest teenistusvalvest ja järelkontrollist ei pea ette teatama. Erakorralisest teenistusvalvest ja järelkontrollist ei pea ette teatama. 3 (3) Teenistusvalve toimumise kohta edastatakse vanglale teade, milles märgitakse vähemalt järgmised andmed: 1 1) viide ministeeriumi tööplaani vastavale punktile või käskkirjale või muule dokumendile, mis on teenistusvalve aluseks; 2 2) teenistusvalve kontrollobjekt; 3 3) teenistusvalve toimingute aeg; 4 4) teenistusvalve meeskonda kuuluvate isikute nimed, nende roll ja kontaktandmed; 5 5) järelkontrolli korral viide teenistusvalve aruandele. Teenistusvalve toimumise kohta edastatakse vanglale teade, milles märgitakse vähemalt järgmised andmed: viide ministeeriumi tööplaani vastavale punktile või käskkirjale või muule dokumendile, mis on teenistusvalve aluseks; teenistusvalve kontrollobjekt; teenistusvalve toimingute aeg; teenistusvalve meeskonda kuuluvate isikute nimed, nende roll ja kontaktandmed; järelkontrolli korral viide teenistusvalve aruandele.",
      "rdfs:label": {
        "@value": "Reg_1038400_Par_5 (redaktsioon 1038400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038400",
      "estleg:sourceAct": "Vangla teenistusvalve kord",
      "estleg:provisionRef": "Reg_1038400 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038400_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038400_Par_6_v1038400",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038400_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenistusvalve käigu ja tulemuste kohta koostatakse teenistusvalve vahearuanne. Teenistusvalve vahearuanne esitatakse vanglale tutvumiseks ja vastamiseks. Vanglale määratakse tähtaeg vahearuandele vastamiseks. Teenistusvalve käigu ja tulemuste kohta koostatakse teenistusvalve vahearuanne. Teenistusvalve vahearuanne esitatakse vanglale tutvumiseks ja vastamiseks. Vanglale määratakse tähtaeg vahearuandele vastamiseks. 2 (2) Teenistusvalve vahearuande ja sellele saadud vangla vastuse põhjal koostatakse teenistusvalve aruanne. Teenistusvalve aruandes määratakse vajaduse korral vanglale tähtaeg, mille jooksul peab ta esitama aruande ettekirjutuste täitmise ja soovituste arvestamise kohta. Teenistusvalve vahearuande ja sellele saadud vangla vastuse põhjal koostatakse teenistusvalve aruanne. Teenistusvalve aruandes määratakse vajaduse korral vanglale tähtaeg, mille jooksul peab ta esitama aruande ettekirjutuste täitmise ja soovituste arvestamise kohta. 3 (3) Teenistusvalve järelkontrolli aruanne koostatakse teenistusvalve aruande, teenistusvalve ettekirjutuste täitmise aruande ning järelkontrolli tulemuste põhjal. Teenistusvalve järelkontrolli aruanne koostatakse teenistusvalve aruande, teenistusvalve ettekirjutuste täitmise aruande ning järelkontrolli tulemuste põhjal.",
      "rdfs:label": {
        "@value": "Reg_1038400_Par_6 (redaktsioon 1038400)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038400",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038400",
      "estleg:sourceAct": "Vangla teenistusvalve kord",
      "estleg:provisionRef": "Reg_1038400 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038400_Map"
      }
    },
