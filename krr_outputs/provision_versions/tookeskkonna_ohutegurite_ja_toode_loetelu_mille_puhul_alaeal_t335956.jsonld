  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tookeskkonna_ohutegurite_ja_toode_loetelu_mille_puhul_alaeal_t335956_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud"
    },
    {
      "@id": "estleg:Reg_335956_Par_1_v335956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335956_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist eelkõige järgmiste töökeskkonnas toimivate füüsikaliste ohutegurite tõttu: 1 1) kahjustav kiirgus; 2 2) kahjustav vibratsioon; 3 3) müratase üle 80 dB; 4 4) kõrgrõhutingimused, näiteks töö kessoonis, barokambris või tuukrina; 5 5) pidev madal õhutemperatuur (kerge füüsiline töö ruumis temperatuuril alla +19 °C, keskmise raskusega füüsiline töö ruumis temperatuuril alla +16 °C); 6 6) pidev kõrge õhutemperatuur (kerge füüsiline töö ruumis temperatuuril üle +26 °C, keskmise raskusega füüsiline töö ruumis temperatuuril üle +24 °C). Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist eelkõige järgmiste töökeskkonnas toimivate füüsikaliste ohutegurite tõttu: kahjustav kiirgus; kahjustav vibratsioon; müratase üle 80 dB; kõrgrõhutingimused, näiteks töö kessoonis, barokambris või tuukrina; pidev madal õhutemperatuur (kerge füüsiline töö ruumis temperatuuril alla +19 °C, keskmise raskusega füüsiline töö ruumis temperatuuril alla +16 °C); pidev kõrge õhutemperatuur (kerge füüsiline töö ruumis temperatuuril üle +26 °C, keskmise raskusega füüsiline töö ruumis temperatuuril üle +24 °C).",
      "rdfs:label": {
        "@value": "Reg_335956_Par_1 (redaktsioon 335956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335956",
      "estleg:sourceAct": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud",
      "estleg:provisionRef": "Reg_335956 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_335956_Par_2_v335956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335956_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist eelkõige järgmiste töökeskkonnas toimivate keemiliste ohutegurite tõttu, mis Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1272/2008, mis käsitleb ainete ja segude klassifitseerimist, märgistamist ja pakendamist ning millega muudetakse direktiive 67/548/EMÜ ja 1999/45/EÜ ja tunnistatakse need kehtetuks ning muudetakse määrust (EÜ) nr 1907/2006 (ELT L 353, 31.12.2008, lk 1–1355), kohaselt vastavad ühe või mitme ohulausega ühe või mitme järgmise ohuklassi ja ohukategooria kriteeriumidele: 1 1) äge mürgisus, kategooria 1, 2 või 3 (H300, H310, H330, H301, H311, H331); 2 2) nahasöövitus, kategooria 1A, 1B või 1C (H314); 3 3) tuleohtlik gaas, kategooria 1 või 2 (H220, H221); 4 4) tuleohtlikud aerosoolid, kategooria 1 (H222); 5 5) tuleohtlik vedelik, kategooria 1 või 2 (H224, H225); 6 6) lõhkeained, kategooria mittepüsivad lõhkeained või alamklassidesse 1.1–1.5 kuuluvad lõhkeained (H200, H201, H202, H203, H204, H205); 7 7) isereageerivad ained ja segud, tüüp A, B, C või D (H240, H241, H242); 8 8) orgaanilised peroksiidid, tüüp A või B (H240, H241); 9 9) mürgisus sihtelundi suhtes – ühekordne kokkupuude, kategooria 1 või 2 (H370, H371); 10 10) mürgisus sihtelundi suhtes – korduv kokkupuude, kategooria 1 või 2 (H372, H373); 11 11) hingamiselundite sensibiliseerimine, kategooria 1A või 1B (H334); 12 12) naha sensibiliseerimine, kategooria 1A või 1B (H317); 13 13) kantserogeensus, kategooria 1A, 1B või 2 (H350, H350i, H351); 14 14) mutageensus sugurakkudele, kategooria 1A, 1B või 2 (H340, H341); 15 15) reproduktiivtoksilisus, kategooria 1A või 1B (H360, H360F, H360FD, H360Fd, H360D, H360Df). Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist eelkõige järgmiste töökeskkonnas toimivate keemiliste ohutegurite tõttu, mis Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 1272/2008, mis käsitleb ainete ja segude klassifitseerimist, märgistamist ja pakendamist ning millega muudetakse direktiive 67/548/EMÜ ja 1999/45/EÜ ja tunnistatakse need kehtetuks ning muudetakse määrust (EÜ) nr 1907/2006 (ELT L 353, 31.12.2008, lk 1–1355), kohaselt vastavad ühe või mitme ohulausega ühe või mitme järgmise ohuklassi ja ohukategooria kriteeriumidele: äge mürgisus, kategooria 1, 2 või 3 (H300, H310, H330, H301, H311, H331); nahasöövitus, kategooria 1A, 1B või 1C (H314); tuleohtlik gaas, kategooria 1 või 2 (H220, H221); tuleohtlikud aerosoolid, kategooria 1 (H222); tuleohtlik vedelik, kategooria 1 või 2 (H224, H225); lõhkeained, kategooria mittepüsivad lõhkeained või alamklassidesse 1.1–1.5 kuuluvad lõhkeained (H200, H201, H202, H203, H204, H205); isereageerivad ained ja segud, tüüp A, B, C või D (H240, H241, H242); orgaanilised peroksiidid, tüüp A või B (H240, H241); mürgisus sihtelundi suhtes – ühekordne kokkupuude, kategooria 1 või 2 (H370, H371); mürgisus sihtelundi suhtes – korduv kokkupuude, kategooria 1 või 2 (H372, H373); hingamiselundite sensibiliseerimine, kategooria 1A või 1B (H334); naha sensibiliseerimine, kategooria 1A või 1B (H317); kantserogeensus, kategooria 1A, 1B või 2 (H350, H350i, H351); mutageensus sugurakkudele, kategooria 1A, 1B või 2 (H340, H341); reproduktiivtoksilisus, kategooria 1A või 1B (H360, H360F, H360FD, H360Fd, H360D, H360Df). 2 (2) Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist plii või selle ühendi või asbesti tõttu. RT I 2015-03-26 5 126032015005 2015-06-01 Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist plii või selle ühendi või asbesti tõttu.",
      "rdfs:label": {
        "@value": "Reg_335956_Par_2 (redaktsioon 335956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335956",
      "estleg:sourceAct": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud",
      "estleg:provisionRef": "Reg_335956 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_335956_Par_3_v335956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335956_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist eelkõige Vabariigi Valitsuse 5. mai 2000. a määruses nr 144 „Bioloogilistest ohuteguritest mõjutatud töökeskkonna töötervishoiu ja tööohutuse nõuded” esitatud 3. ja 4. ohurühma bioloogiliste ohutegurite tõttu. RT I 2015-03-26 5 126032015005 2015-06-01 Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist eelkõige Vabariigi Valitsuse 5. mai 2000. a määruses nr 144 „Bioloogilistest ohuteguritest mõjutatud töökeskkonna töötervishoiu ja tööohutuse nõuded” esitatud 3. ja 4. ohurühma bioloogiliste ohutegurite tõttu.",
      "rdfs:label": {
        "@value": "Reg_335956_Par_3 (redaktsioon 335956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335956",
      "estleg:sourceAct": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud",
      "estleg:provisionRef": "Reg_335956 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_335956_Par_4_v335956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335956_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist Vabariigi Valitsuse 15. detsembri 2005. a määruse nr 308 „Kantserogeensete ja mutageensete kemikaalide käitlemisele esitatavad töötervishoiu ja tööohutuse nõuded” §-s 2 loetletud kantserogeenset ohtu põhjustavate tööprotsesside ja neis vabanevate ainete või segude tõttu. RT I 2015-03-26 5 126032015005 2015-06-01 Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda tööle, mis ohustab alaealise tervist Vabariigi Valitsuse 15. detsembri 2005. a määruse nr 308 „Kantserogeensete ja mutageensete kemikaalide käitlemisele esitatavad töötervishoiu ja tööohutuse nõuded” §-s 2 loetletud kantserogeenset ohtu põhjustavate tööprotsesside ja neis vabanevate ainete või segude tõttu.",
      "rdfs:label": {
        "@value": "Reg_335956_Par_4 (redaktsioon 335956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335956",
      "estleg:sourceAct": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud",
      "estleg:provisionRef": "Reg_335956 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_335956_Par_5_v335956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335956_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda eelkõige järgmisele tööle, mis ohustab alaealise tervist: 1 1) töö seadmega, mille abil toodetakse, säilitatakse või kasutatakse suru-, veeldatud või lahustatud gaasi; 2 2) töö §-s 2 nimetatud ainet või valmistist sisaldava anuma, pudeli või muu mahutiga; 3 3) lõhkematerjali või pürotehnilise toote käitlemine; 4 4) töö metsikute või mürkloomadega; 5 5) kõrge psüühilise koormusega seotud töö, näiteks töö, mis on seotud psühhiaatria eriala tervishoiuteenuse osutamisega, töö vanglas, arestimajas, lahkamiskambris või kohtades, kus tapetakse või hävitatakse loomi või linde; 6 6) töö, mis on seotud varisemisohuga, näiteks lammutustöö, töö kaevandis; 7 7) töö, mis on seotud kõrgusest kukkumise ohuga; 8 8) raskuste käsitsi teisaldamine vastavalt töötervishoiu ja tööohutuse seaduse § 9 lõike 3 alusel kehtestatud nõuetele; RT I 2019-10-17 1 117102019001 2020-01-17 9 9) töö kõrgpingestatud elektriseadmetega; 10 10) lifti remondi- või hooldustööd; 11 11) töö, mille tempo määravad masinad ja mille eest tasustatakse vastavalt töötulemustele; 12 12) töö mehaanilise lõikuri, ketas- või lintsae, metallifreesi, keevitusseadme või suruõhu abil töötava seadmega; 13 13) töö masinal, mis on varustatud vintsi või muu sarnase jõuseadmega; 14 14) allmaatöö. Tööandja ei tohi alaealisega töölepingut sõlmida ega lubada teda eelkõige järgmisele tööle, mis ohustab alaealise tervist: töö seadmega, mille abil toodetakse, säilitatakse või kasutatakse suru-, veeldatud või lahustatud gaasi; töö §-s 2 nimetatud ainet või valmistist sisaldava anuma, pudeli või muu mahutiga; lõhkematerjali või pürotehnilise toote käitlemine; töö metsikute või mürkloomadega; kõrge psüühilise koormusega seotud töö, näiteks töö, mis on seotud psühhiaatria eriala tervishoiuteenuse osutamisega, töö vanglas, arestimajas, lahkamiskambris või kohtades, kus tapetakse või hävitatakse loomi või linde; töö, mis on seotud varisemisohuga, näiteks lammutustöö, töö kaevandis; töö, mis on seotud kõrgusest kukkumise ohuga; raskuste käsitsi teisaldamine vastavalt töötervishoiu ja tööohutuse seaduse § 9 lõike 3 alusel kehtestatud nõuetele; töö kõrgpingestatud elektriseadmetega; lifti remondi- või hooldustööd; töö, mille tempo määravad masinad ja mille eest tasustatakse vastavalt töötulemustele; töö mehaanilise lõikuri, ketas- või lintsae, metallifreesi, keevitusseadme või suruõhu abil töötava seadmega; töö masinal, mis on varustatud vintsi või muu sarnase jõuseadmega; allmaatöö.",
      "rdfs:label": {
        "@value": "Reg_335956_Par_5 (redaktsioon 335956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335956",
      "estleg:sourceAct": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud",
      "estleg:provisionRef": "Reg_335956 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_335956_Par_6_v335956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335956_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alaealise töölepingu sõlmimisel ja tema tööle lubamisel võib teha erandeid määruse §-des 1–5 sätestatust, kui alaealine töötab kutseõppe õppekava alusel läbiviidava praktika raames ja tingimusel, et tööd tehakse praktika juhendaja või töökeskkonnaspetsialisti järelevalve all ning alaealise tervise ja ohutuse tagamiseks on rakendatud vajalikke meetmeid. Alaealise töölepingu sõlmimisel ja tema tööle lubamisel võib teha erandeid määruse §-des 1–5 sätestatust, kui alaealine töötab kutseõppe õppekava alusel läbiviidava praktika raames ja tingimusel, et tööd tehakse praktika juhendaja või töökeskkonnaspetsialisti järelevalve all ning alaealise tervise ja ohutuse tagamiseks on rakendatud vajalikke meetmeid.",
      "rdfs:label": {
        "@value": "Reg_335956_Par_6 (redaktsioon 335956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335956",
      "estleg:sourceAct": "Töökeskkonna ohutegurite ja tööde loetelu, mille puhul alaealise töötamine on keelatud",
      "estleg:provisionRef": "Reg_335956 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335956_Map_2026"
      }
    },
