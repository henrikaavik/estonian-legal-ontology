    {
      "@id": "estleg:Reg_311340_Par_2_v311340",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_311340_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Rapla maakonnas Kaiu vallas Kuimetsa ja Vaopere külas. Kaitseala asub Rapla maakonnas Kaiu vallas Kuimetsa ja Vaopere külas. 2 (2) Kaitseala välispiir on esitatud kaardil määruse lisas4. Kaitseala välispiir on esitatud kaardil määruse lisas4.",
