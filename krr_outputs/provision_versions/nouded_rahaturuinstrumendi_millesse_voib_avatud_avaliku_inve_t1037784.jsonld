      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse nõuded rahaturuinstrumendi, millesse võib investeerimisfondi vara investeerida, emitendile. Käesoleva määrusega kehtestatakse nõuded rahaturuinstrumendi, millesse võib investeerimisfondi vara investeerida, emitendile.",
      "rdfs:label": {
        "@value": "Reg_1037784_Par_1 (redaktsioon 1037784)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037784",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037784",
      "estleg:sourceAct": "Nõuded rahaturuinstrumendi, millesse võib avatud avaliku investeerimisfondi vara investeerida, emitendile",
      "estleg:provisionRef": "Reg_1037784 § 1",
