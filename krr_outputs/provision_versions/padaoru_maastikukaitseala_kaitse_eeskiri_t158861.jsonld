    {
      "@id": "estleg:Reg_158861_Par_4_v158861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158861_Par_4"
