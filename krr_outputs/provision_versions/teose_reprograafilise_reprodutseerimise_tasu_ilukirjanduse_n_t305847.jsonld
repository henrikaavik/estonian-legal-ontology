      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teose reprograafilise reprodutseerimise tasu ilukirjanduse ning teadus- ja õppekirjanduse autorite ja kirjastajate vahel jaotamise määrad ning tasu maksmise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teose reprograafilise reprodutseerimise tasu ilukirjanduse ning teadus- ja õppekirjanduse autorite ja kirjastajate vahel jaotamise määrad ning tasu maksmise kord"
    },
