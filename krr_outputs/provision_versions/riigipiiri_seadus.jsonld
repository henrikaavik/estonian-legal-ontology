    {
      "@id": "estleg:RIIGIP_Par_6_v22296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIP_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Piiririba on maismaal kuni 10 meetri laiune riigipiiriga paralleelselt kulgev maa-ala piirijoonest sisemaa poole. (2) Linnas või muus asulas piiririba ei kehtestata. (3) Piiririba konkreetne laius ja hooldamise kord kehtestatakse riikidevaheliste lepingutega. (4) Piiririba maa-ala on riigi omand. (5) Piiriribal on keelatud igasugune tegevus, mis ei ole seotud piirimärkide ja piiririba korrashoidmise ja kontrollimise ning riigipiiri valvamisega.",
      "rdfs:label": {
        "@value": "RIIGIP_Par_6 (redaktsioon 22296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22296",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIP_Par_6_v608669"
      },
      "estleg:versionValidTo": {
        "@value": "2003-07-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22296",
      "estleg:sourceAct": "Riigipiiri seadus",
      "estleg:provisionRef": "RIIGIP § 6",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
    {
