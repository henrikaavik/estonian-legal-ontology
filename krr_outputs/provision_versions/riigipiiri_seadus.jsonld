      "estleg:provisionRef": "RIIGIP § 8_6",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIP_Par_8_6_v130122011027",
      "@type": [
