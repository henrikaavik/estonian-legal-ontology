        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIP_Par_11_1_v13250455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
