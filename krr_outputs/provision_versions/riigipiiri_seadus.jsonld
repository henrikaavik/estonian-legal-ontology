      "estleg:partOfAct": {
        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIP_Par_22_1_v108072020007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIP_Par_22_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni piiririba laiuse määramiseni käesoleva seaduse § 6 lõike 3 alusel on piiririba maismaal kuni kümne meetri laiune riigipiiriga paralleelne maa-ala piirijoonest sisemaa poole. Looduslikul piirijoonel moodustab piiririba maa-ala piirijõe, -oja või -tee sisemaasuunalisi lookeid ühendava sirge lähtejooneni ja sellega paralleelne kuni kümne meetri laiune maariba sisemaa poole.",
      "rdfs:label": {
        "@value": "RIIGIP_Par_22_1 (redaktsioon 108072020007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072020007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072020007",
      "estleg:sourceAct": "Riigipiiri seadus",
      "estleg:provisionRef": "RIIGIP § 22_1",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
