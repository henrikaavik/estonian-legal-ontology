    {
      "@id": "estleg:RIIGIP_Par_2_v22296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIP_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti riigipiir (edaspidi riigipiir) on katkematu ja suletud mõtteline joon ning seda mööda kulgev vertikaalpind, millega piiritletakse Eesti maa-ala, territoriaalmeri, piiriveekogude Eestile kuuluvad osad, maapõu ja õhuruum. (2) Eesti maismaapiir on määratud 1920. aasta 2. veebruari Tartu rahulepinguga ja teiste riikidevaheliste piirilepingutega. (3) Eesti õhu- ja merepiir määratakse rahvusvaheliste konventsioonide alusel Eesti Vabariigi seaduste ning riikidevaheliste piirilepingutega. (4) Eesti merepiiriks on Eesti territoriaalmere välispiir.",
      "rdfs:label": {
        "@value": "RIIGIP_Par_2 (redaktsioon 22296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22296",
      "estleg:supersededByVersion": {
        "@id": "estleg:RIIGIP_Par_2_v693446"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22296",
      "estleg:sourceAct": "Riigipiiri seadus",
      "estleg:provisionRef": "RIIGIP § 2",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIP_Par_2_v693446",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIP_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti riigipiir (edaspidi riigipiir) on katkematu ja suletud mõtteline joon ning seda mööda kulgev vertikaalpind, millega piiritletakse Eesti maa-ala, territoriaalmeri, piiriveekogude Eestile kuuluvad osad, maapõu ja õhuruum. (2) Eesti maismaapiir on määratud 1920. aasta 2. veebruari Tartu rahulepinguga ja teisteriikidevahelistepiirilepingutega. (3) Eesti õhu- ja merepiir määratakse rahvusvaheliste konventsioonide alusel Eesti Vabariigi seaduste ning riikidevaheliste piirilepingutega. (4) Eesti merepiiriks on Eesti territoriaalmerevälispiir.",
      "rdfs:label": {
        "@value": "RIIGIP_Par_2 (redaktsioon 693446)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693446",
