      "estleg:provisionRef": "RIIGIP § 8_2",
      "estleg:partOfAct": {
        "@id": "estleg:RIIGIP_Map_2026"
      }
    },
    {
      "@id": "estleg:RIIGIP_Par_8_2_v108072020007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RIIGIP_Par_8_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RIIGIP_Par_8_2 (redaktsioon 108072020007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072020007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072020007",
      "estleg:sourceAct": "Riigipiiri seadus",
      "estleg:provisionRef": "RIIGIP § 8_2",
