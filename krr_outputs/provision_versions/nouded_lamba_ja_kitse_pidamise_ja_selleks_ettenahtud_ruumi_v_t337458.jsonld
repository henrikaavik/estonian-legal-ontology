    {
      "@id": "estleg:Reg_337458_Par_11_v337458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337458_Par_11"
