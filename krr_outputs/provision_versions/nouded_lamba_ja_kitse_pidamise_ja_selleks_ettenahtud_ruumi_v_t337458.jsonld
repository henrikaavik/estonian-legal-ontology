    {
      "@id": "estleg:Reg_337458_Par_14_v337458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337458_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. septembril 2009. aastal, välja arvatud § 4 lõige 5, mis jõustub 1. septembril 2019. aastal. Määrus jõustub 1. septembril 2009. aastal, välja arvatud § 4 lõige 5, mis jõustub 1. septembril 2019. aastal.",
      "rdfs:label": {
        "@value": "Reg_337458_Par_14 (redaktsioon 337458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337458",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337458",
      "estleg:sourceAct": "Nõuded lamba ja kitse pidamise ja selleks ettenähtud ruumi või ehitise kohta",
      "estleg:provisionRef": "Reg_337458 § 14",
