    {
      "@id": "estleg:Reg_312072_Par_3_v312072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312072_Par_3"
