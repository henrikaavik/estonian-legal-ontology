        "@type": "xsd:date"
      },
      "estleg:versionText": "Digitaalallkirja seadus tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "EUTS_Par_26 (redaktsioon 125102016001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125102016001"
    },
    {
      "@id": "estleg:EUTS_Par_3_v125102016001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EUTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) nr 910/2014 artikli 22 kohast usaldusnimekirja (edaspidi usaldusnimekiri) peab pädev asutus. (2) Pädev asutus või infoturbe pädev asutus võib korraldada usaldusteenuse infrastruktuuri loomise, haldamise ja ajakohastamise vastavalt Euroopa Parlamendi ja nõukogu määruse (EL) nr 910/2014 artikli 17 lõikele 5. (3) Usaldusteenuse infrastruktuuri loomise, haldamise ja ajakohastamise nõuded ning korra võib kehtestada määrusega.",
      "rdfs:label": {
        "@value": "EUTS_Par_3 (redaktsioon 125102016001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125102016001",
      "estleg:supersededByVersion": {
