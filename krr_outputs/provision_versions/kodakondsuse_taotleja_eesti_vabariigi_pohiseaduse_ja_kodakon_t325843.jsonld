      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kodakondsuse taotleja Eesti Vabariigi põhiseaduse ja „Kodakondsuse seaduse” tundmise eksami läbiviimise kord (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kodakondsuse taotleja Eesti Vabariigi põhiseaduse ja „Kodakondsuse seaduse” tundmise eksami läbiviimise kord"
    },
    {
      "@id": "estleg:Reg_325843_Par_1_v325843",
