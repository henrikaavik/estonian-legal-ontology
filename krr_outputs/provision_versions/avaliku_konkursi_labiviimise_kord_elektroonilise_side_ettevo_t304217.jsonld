      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Avaliku konkursi läbiviimise kord elektroonilise side ettevõtja leidmiseks lairibatehnoloogial põhineval sidevõrgul võrguteenuste osutamiseks sagedusalas 450 MHz (12 versiooni)",
        "@language": "et"
      },
      "dc:source": "Avaliku konkursi läbiviimise kord elektroonilise side ettevõtja leidmiseks lairibatehnoloogial põhineval sidevõrgul võrguteenuste osutamiseks sagedusalas 450 MHz"
    },
    {
      "@id": "estleg:Reg_304217_Par_1_v304217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304217_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse avaliku konkursi läbiviimise kord elektroonilise side ettevõtja leidmiseks lairibatehnoloogial põhineval sidevõrgul võrguteenuse osutamiseks sagedusalas 453,000–457,475 MHz / 463,000–467,475 MHz (edaspidi konkurss) ja sagedusloa andmiseks. Määrusega kehtestatakse avaliku konkursi läbiviimise kord elektroonilise side ettevõtja leidmiseks lairibatehnoloogial põhineval sidevõrgul võrguteenuse osutamiseks sagedusalas 453,000–457,475 MHz / 463,000–467,475 MHz (edaspidi konkurss) ja sagedusloa andmiseks. 2 (2) Konkursi korraldab ja sagedusloa annab Tarbijakaitse ja Tehnilise Järelevalve Amet. RT I 2019-02-26 1 126022019001 2019-03-01 Konkursi korraldab ja sagedusloa annab Tarbijakaitse ja Tehnilise Järelevalve Amet.",
      "rdfs:label": {
        "@value": "Reg_304217_Par_1 (redaktsioon 304217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "304217",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/304217",
