      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pakkuja võib oma pakkumist muuta, täiendada või pakkumise tagasi võtta või esitada uue pakkumise enne pakkumiste esitamise tähtpäeva. Pakkuja võib oma pakkumist muuta, täiendada või pakkumise tagasi võtta või esitada uue pakkumise enne pakkumiste esitamise tähtpäeva.",
      "rdfs:label": {
