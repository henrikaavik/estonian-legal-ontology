    {
      "@id": "estleg:Reg_1034866_Par_2_v1034866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034866_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pärnu maakonnas võetakse kaitse alla järgmised niidurüdi püsielupaigad: 1 1) Elbu Põhja-Pärnumaa vallas Pitsalu ja Tarva külas; 2 2) Kõrsa Pärnu linnas Põlendmaa ja Seljametsa külas ning Tori vallas Urumarja, Kõrsa ja Kildemaa külas. Pärnu maakonnas võetakse kaitse alla järgmised niidurüdi püsielupaigad: Elbu Põhja-Pärnumaa vallas Pitsalu ja Tarva külas; Kõrsa Pärnu linnas Põlendmaa ja Seljametsa külas ning Tori vallas Urumarja, Kõrsa ja Kildemaa külas. 2 (2) Püsielupaikade ja nende vööndi piirid on kantud kaartidele, mis on esitatud määruse lisas1. RT I 2023-01-20 1 120012023001 2023-01-30 Püsielupaikade ja nende vööndi piirid on kantud kaartidele, mis on esitatud määruse lisas1.",
      "rdfs:label": {
        "@value": "Reg_1034866_Par_2 (redaktsioon 1034866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034866",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034866",
      "estleg:sourceAct": "Niidurüdi püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1034866 § 2",
