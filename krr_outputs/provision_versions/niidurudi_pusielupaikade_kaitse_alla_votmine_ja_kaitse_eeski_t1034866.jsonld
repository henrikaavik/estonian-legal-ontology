        "@type": "xsd:date"
      },
      "estleg:versionText": "Püsielupaiga valitseja on Keskkonnaamet. Püsielupaiga valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1034866_Par_3 (redaktsioon 1034866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034866",
