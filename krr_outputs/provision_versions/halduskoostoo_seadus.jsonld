        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise või füüsilise isiku riigi haldusülesande täitmiseks volitamise otsuses esitatakse järgmised andmed: volitatava kohaliku omavalitsuse üksuse või muu avalik-õigusliku juriidilise isiku nimi või andmed selle kohta, kas haldusülesannet volitatakse täitma füüsilist või eraõiguslikku juriidilist isikut; volitus pädevale ametiisikule halduslepingu sõlmimiseks, kui haldusülesande täitmiseks volitamise otsustab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "HKTS_Par_7 (redaktsioon 260785)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "260785",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/260785",
      "estleg:sourceAct": "Halduskoostöö seadus",
      "estleg:provisionRef": "HKTS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:HKTS_Map_2026"
      }
    },
    {
      "@id": "estleg:HKTS_Par_8_v260785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HKTS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise või füüsilise isiku riigi haldusülesande täitmiseks volitamise halduslepingu sõlmib valitsusasutuse juht, kelle pädevuses on otsustada haldusülesande täitmiseks volitamine või keda on selleks volitanud Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "HKTS_Par_8 (redaktsioon 260785)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "260785",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/260785",
      "estleg:sourceAct": "Halduskoostöö seadus",
      "estleg:provisionRef": "HKTS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:HKTS_Map_2026"
      }
    },
    {
      "@id": "estleg:HKTS_Par_9_v260785",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HKTS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse haldusülesande täitmiseks volitamise otsustab volikogu, kes volitab halduslepingut sõlmima valla- või linnavalitsuse.",
      "rdfs:label": {
        "@value": "HKTS_Par_9 (redaktsioon 260785)",
        "@language": "et"
      },
