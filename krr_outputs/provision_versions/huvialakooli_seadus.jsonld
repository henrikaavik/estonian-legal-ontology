      }
    },
    {
      "@id": "estleg:HUVIAL_Par_15_v22331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HUVIAL_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Huvialakooli ühinemise, jagunemise või tegevuse lõpetamise otsustab huvialakooli asutaja. (2) Huvialakooli ühinemine seisneb huvialakoolide ühendamises või liitmises, huvialakooli jagunemine seisneb huvialakooli jagamises või eraldamises. (3) Huvialakooli tegevuse lõpetamine toimub huvialakooli põhikirjas kehtestatud korras. Tegevuse lõpetanud huvialakooli õigused ja kohustused lähevad üle huvialakooli asutajale või tema määratud asutusele. (4) Huvialakooli ühinemisest, jagunemisest või tegevuse lõpetamisest teatatakse õpilastele, vanematele ja personalile, munitsipaalhuvialakooli puhul ka Haridusministeeriumile, neli kuud ette.",
      "rdfs:label": {
        "@value": "HUVIAL_Par_15 (redaktsioon 22331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22331",
      "estleg:supersededByVersion": {
        "@id": "estleg:HUVIAL_Par_15_v215106"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22331",
      "estleg:sourceAct": "Huvialakooli seadus",
      "estleg:provisionRef": "HUVIAL § 15",
      "estleg:partOfAct": {
        "@id": "estleg:HUVIAL_Map_2026"
      }
    },
    {
