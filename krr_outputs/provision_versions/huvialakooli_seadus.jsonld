      }
    },
    {
      "@id": "estleg:HUVIAL_Par_16_v22331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HUVIAL_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Huvialakoolid viivad kolme kuu jooksul, arvates käesoleva seaduse jõustumisest, oma põhikirjad vastavusse seaduse nõuetega ja esitavad need kinnitamiseks vastavalt Kultuuri- ja Haridusministeeriumile või valla- või linnavalitsusele. Põhikirjad registreeritakse seaduses kehtestatud korras.",
      "rdfs:label": {
        "@value": "HUVIAL_Par_16 (redaktsioon 22331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22331",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22331",
      "estleg:sourceAct": "Huvialakooli seadus",
      "estleg:provisionRef": "HUVIAL § 16",
      "estleg:partOfAct": {
        "@id": "estleg:HUVIAL_Map_2026"
      }
    },
    {
      "@id": "estleg:HUVIAL_Par_2_v22331",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HUVIAL_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigihuvialakool on Haridusministeeriumi valitsemisalas tegutsev asutus, munitsipaalhuvialakool on kohaliku omavalitsuse asutus. (2) Riigi- ja munitsipaalhuvialakool juhindub käesolevast seadusest, muudest õigusaktidest ja oma põhikirjast. (3) Käesolevat seadust kohaldatakse erahuvialakoolile niivõrd, kuivõrd erakooliseadus ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "HUVIAL_Par_2 (redaktsioon 22331)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22331",
      "estleg:supersededByVersion": {
        "@id": "estleg:HUVIAL_Par_2_v215106"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22331",
      "estleg:sourceAct": "Huvialakooli seadus",
      "estleg:provisionRef": "HUVIAL § 2",
      "estleg:partOfAct": {
        "@id": "estleg:HUVIAL_Map_2026"
      }
    },
    {
      "@id": "estleg:HUVIAL_Par_2_v215106",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HUVIAL_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 12. 2002] (1) Riigihuvialakool on Haridusministeeriumi valitsemisalas tegutsev asutus, munitsipaalhuvialakool on kohaliku omavalitsuse asutus. [Lõike 1 sõnastus alates 1. 01. 2003] (1) Riigihuvialakool on Haridus- ja Teadusministeeriumi valitsemisalas tegutsev asutus, munitsipaalhuvialakool on kohaliku omavalitsuse asutus. (2) Riigi- ja munitsipaalhuvialakool juhindub käesolevast seadusest, muudest õigusaktidest ja oma põhikirjast. (3) Käesolevat seadust kohaldatakse erahuvialakoolile niivõrd, kuivõrd erakooliseadus ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "HUVIAL_Par_2 (redaktsioon 215106)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215106",
      "estleg:supersededByVersion": {
