        "@value": "2004-07-04",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/215106",
      "estleg:sourceAct": "Huvialakooli seadus",
      "estleg:provisionRef": "HUVIAL § 3",
