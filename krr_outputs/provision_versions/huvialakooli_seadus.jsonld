      },
      "estleg:versionValidTo": {
        "@value": "2004-07-04",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/215106",
      "estleg:sourceAct": "Huvialakooli seadus",
      "estleg:provisionRef": "HUVIAL § 2",
      "estleg:partOfAct": {
        "@id": "estleg:HUVIAL_Map_2026"
      }
    },
    {
      "@id": "estleg:HUVIAL_Par_2_v754307",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HUVIAL_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigihuvialakool on Haridus- ja Teadusministeeriumi valitsemisalas tegutsev asutus, munitsipaalhuvialakool on kohaliku omavalitsuse asutus. (2) Riigi- ja munitsipaalhuvialakool juhindub käesolevast seadusest, muudest õigusaktidest ja oma põhikirjast. (3) Käesolevat seadust kohaldatakse erahuvialakoolile niivõrd, kuivõrd erakooliseadus ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "HUVIAL_Par_2 (redaktsioon 754307)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "754307",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/754307",
      "estleg:sourceAct": "Huvialakooli seadus",
      "estleg:provisionRef": "HUVIAL § 2",
      "estleg:partOfAct": {
