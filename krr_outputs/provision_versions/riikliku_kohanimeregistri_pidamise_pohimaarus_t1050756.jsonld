      },
      "estleg:versionText": "Registri ametlik nimetus on riiklik kohanimeregister (edaspidi register), inglise keeles National Place Names Register. Registri ametlik lühend on KNR. Registri ametlik nimetus on riiklik kohanimeregister (edaspidi register), inglise keeles National Place Names Register. Registri ametlik lühend on KNR.",
      "rdfs:label": {
        "@value": "Reg_1050756_Par_1 (redaktsioon 1050756)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050756",
