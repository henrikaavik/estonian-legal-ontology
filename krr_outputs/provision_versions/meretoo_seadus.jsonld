      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mereteenistuse seadus tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_84 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108",
      "estleg:supersededByVersion": {
        "@id": "estleg:Meret_seadus_Par_84_v101032017006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Meret_seadus_Par_84_v101032017006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_84 (redaktsioon 101032017006)",
        "@language": "et"
