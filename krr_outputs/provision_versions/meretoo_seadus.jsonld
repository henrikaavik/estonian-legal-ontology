  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_meretoo_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Meretöö seadus (138 versiooni)",
        "@language": "et"
      },
      "dc:source": "Meretöö seadus"
    },
    {
      "@id": "estleg:Meret_seadus_Par_1_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus reguleerib töötamist laeval, meretöösuhteid, laeval töötavate isikute töövahendust, riigi ülesandeid meretöö valdkonna korraldamisel, järelevalvet meretöösuhete üle ja vastutust seaduse nõuete rikkumise eest.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_1 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108",
      "estleg:supersededByVersion": {
        "@id": "estleg:Meret_seadus_Par_1_v101032017006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Meret_seadus_Par_1_v101032017006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus reguleerib töötamist laeval, meretöösuhteid, laeval töötavate isikute töövahendust, riigi ülesandeid meretöö valdkonna korraldamisel, järelevalvet meretöösuhete üle, töötamist laevatatavatel sisevetel ärilisel eesmärgil kaupa või reisijaid vedaval siseveetranspordivahendil (edaspidi siseveetranspordivahend) ja vastutust seaduse nõuete rikkumise eest.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_1 (redaktsioon 101032017006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101032017006"
    },
    {
      "@id": "estleg:Meret_seadus_Par_10_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kalalaeval töötava laevapere liikme meretöölepingu kirjalikus dokumendis peavad lisaks töölepingu seaduse §-s 5 ja käesoleva seaduse §-s 9 sätestatule sisalduma andmed eelseisva püügireisi kohta, kui see on võimalik meretöölepingu sõlmimisel kindlaks määrata. (2) Kalalaeval töötava laevapere liikme meretöölepingu kirjalikus dokumendis ei pea sisalduma andmeid tööle asumise aja ja koha kohta, kui neid ei ole võimalik enne kindlaks määrata.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_10 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_11_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tähtajalise meretöölepingu kirjalikus dokumendis peavad lisaks töölepingu seaduse §-s 5 ja § 6 lõikes 2 sätestatule sisalduma käesoleva seaduse §-des 9 ja 10 sätestatud andmed. (2) Üheks merereisiks sõlmitud tähtajalise meretöölepingu kirjalikus dokumendis tuleb märkida ka sihtsadam ja sadamasse saabumise aeg, mille möödumisel laevapere liikme meretööleping lõpeb. (3) Kalalaeval töötava laevapere liikme meretöölepingu kirjalikus dokumendis ei pea sisalduma käesoleva paragrahvi lõikes 2 nimetatud andmeid, kui sihtsadamat ja sadamasse saabumise aega ei ole võimalik enne kindlaks määrata.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_11 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_12_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reeder ei tohi meretöölepingut sõlmida alla 16-aastase alaealisega ega teda tööle lubada.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_12 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_13_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tähtajalise meretöölepingu võib sõlmida kuni viieks aastaks, kui seda õigustavad töö ajutisest tähtajalisest iseloomust tulenevad mõjuvad põhjused, eelkõige kindlaksmääratud reis või reisid, töömahu ajutine suurenemine või navigatsiooniperiood. (2) Tähtajalise meretöölepingu võib kapten reederi nõusolekul sõlmida kuni neljaks kuuks, kui see on vajalik ohutu meresõidu tagamiseks. (3) Käesoleva paragrahvi lõikes 2 sätestatud tingimuste järgimata jätmine ei too kaasa meretöölepingu tühisust.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_13 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_14_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui seadusest, kollektiiv- või meretöölepingust ei tulene teisiti, täidab laevapere liige lisaks töölepingu seaduse §-s 15 sätestatule eelkõige järgmisi kohustusi: täidab õigel ajal ja täpselt reederi, kapteni ja muu pädeva isiku seaduslikke korraldusi; järgib laeval kehtestatud korra- ja ohutusnõudeid; osaleb pääste- ja tuletõrjeõppustes; hoiab laeva ja sellel olevat vara; kasutab töö ajal reederi määratud töö-, eri- või ametiriietust ja isikukaitsevahendeid; teavitab viivitamata kaptenit või muud pädevat isikut töötakistusest või selle tekkimise ohust ning võimaluse korral kõrvaldab erikorralduseta takistuse või selle tekkimise ohu; täidab muid seaduses, kollektiiv- või töölepingus ettenähtud kohustusi.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_14 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_15_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lisaks käesoleva seaduse §-s 14 sätestatule järgib laevapere liige kapteni või muu pädeva isiku korraldusi, mis on vajalikud: laeval olevaid või teisi isikuid ähvardava ohu vältimiseks; laeva ohutuse tagamiseks; lasti riknemise või hävimise vältimiseks; teisi laevu ähvardava ohu vältimiseks. (2) Ähvardava laevahuku või muu laeval olevaid isikuid ähvardava otsese ohu korral ei lahku laevapere liige laevalt ilma kapteni või muu pädeva isiku loata. (3) Laevahuku korral osaleb laevapere liige laeval olevate isikute ja laeva lasti päästmisel. (4) Korralduste andmisel käesoleva paragrahvi lõigetes 1–3 nimetatud juhtudel jälgib kapten või muu pädev isik, et laevapere liikme elu ja tervis ei ole ohustatud.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_15 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_16_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liige töötab meretöölepingus nimetatud laeval, kui ei ole kokku lepitud teisiti. (2) Reeder võib laeva juhtkonda kuuluva isiku ümber paigutada teisele laevale, säilitades talle senised meretöölepinguga kokkulepitud töötingimused, kui ümberpaigutamine on töökorraldust arvestades vajalik ja meretöölepingus ei ole kokku lepitud teisiti.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_16 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_17_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liikmel on laeva sadamas või reidil seismise ajal õigus väljaspool oma tööaega kapteni või muu pädeva isiku loal maale minna. Loa andmisest võib keelduda, kui kapteni või muu pädeva isiku arvates on laevapere liikme laevale jäämine vajalik laeva, laeval olevate isikute või laeva lasti ohutuse tagamiseks või laeva eelseisva väljumisega seotud tööülesannete täitmiseks. (2) Kui keelduti laevapere liikmele maalemineku loa andmisest käesoleva paragrahvi lõikes 1 sätestatud juhul ning ta ei täida tööülesandeid, loetakse see aeg valveajaks ja tasustatakse vastavalt. (3) Kapten peab korraldama laevapere liikme maalemineku viisil, mis ei takista tööd laeval ega ole seotud ebamõistlike kulutustega.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_17 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_18_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liige võib laevalt lahkuda ja nõuda reederilt töökoha muutmist, kui: laev, millel laevapere liige on kohustatud töötama, ei ole merekõlblik ning kapten ei täida oma kohustust kontrollida laeva merekõlblikkust käesoleva seaduse §-s 31 sätestatu kohaselt ja kavatseb sadamast väljuda; laevapere liikme elamis- ja töötingimused laeval ohustavad laevapere liikme elu ja tervist ning reeder ei rakenda olukorra parandamiseks vajalikke abinõusid; laevapere liiget on laeval väärkoheldud ja kaptenil ei ole õnnestunud talle kaitset pakkuda, kuigi kaptenit on väärkohtlemisest teavitatud; laev kaotab õiguse sõita Eesti lipu all; meretööleping on sõlmitud kindlaksmääratud reisiks ja reisi sihtkohta muudetakse; pärast töö alustamist laeval selgub, et laev võib sattuda võõrvõimu kontrolli alla või saada vigastada sõja- või piraatluspiirkonnas või et nimetatud oht on märgatavalt suurenenud; pärast töö alustamist laeval selgub, et sadam, kuhu on kavas suunduda, on kuulutatud epideemiapiirkonnaks. (2) Käesoleva paragrahvi lõikes 1 sätestatud alusel on laevapere liikmel õigus laevalt lahkuda enne meresõidu algust või pärast laevalt lahkumise õigust andvast asjaolust teadasaamist esimeses sadamas, kus laev sildub. (3) Kui laevapere liige lahkub laevalt käesoleva paragrahvi lõikes 1 sätestatud alusel, on reeder kohustatud korraldama omal kulul laevapere liikme kojusõidu käesoleva peatüki 6. jaos sätestatu kohaselt või paigutama laevapere liikme tööle teisele laevale. Kui laevapere liige asub tööle teisel laeval, hüvitab reeder laevapere liikmele laeva vahetamisega seotud kulud.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_18 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_19_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laevapere liige ei või ilma kapteni või muu pädeva isiku loata tuua laevale kõrvalisi isikuid. (2) Kapten või muu pädev isik ei või keelduda käesoleva paragrahvi lõikes 1 nimetatud loa andmisest laeva sadamasoleku ajaks, kui kõrvalise isiku laeval viibimine ei takista tööd laeval ning laeva ohutus on tagatud.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_19 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_2_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevat seadust kohaldatakse töötamisele Eesti laevakinnistusraamatusse või laevapereta prahitud laevade registrisse kantud laeval (edaspidi laev). (2) Käesolevat seadust kohaldatakse tööülesannete täitmisele renditööna ka käesoleva paragrahvi lõikes 1 nimetamata laeval, kui tööandja on Eestis registreeritud juriidiline isik ning laevapere liige on Eesti rahvastikuregistri objekt. (3) Käesolevat seadust ei kohaldata töötamisele alla 24 meetri pikkusel kalalaeval. (4) Käesoleva seaduse § 18 lõike 1 punkti 5, § 26 lõike 1 punkti 4, § 34 lõiget 3 ja § 62 ei kohaldata töötamisele üle 24 meetri pikkusel kalalaeval. (5) Vaidluse, kas laeva suhtes kohaldatakse käesolevat seadust, lahendab kohtuväliselt Veeteede Amet, konsulteerides reederite ja laevapere liikmete esindusorganisatsioonidega. (6) Käesoleva seaduse § 32 lõiget 7 kohaldatakse kõigile merel viibivatele laevadele, sõltumata käesoleva paragrahvi lõikes 1 nimetatud laeva registreeringust või laeva lipuriigist. (7) Käesoleva seaduse §-e 19, 28 ja 29 ei kohaldata töötamisele laeval, mida kasutatakse lootsiteenuse osutamiseks.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_2 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108",
      "estleg:supersededByVersion": {
        "@id": "estleg:Meret_seadus_Par_2_v101032017006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Meret_seadus_Par_2_v101032017006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevat seadust kohaldatakse töötamisele Eesti laevakinnistusraamatusse või laevapereta prahitud laevade registrisse kantud laeval (edaspidi laev). (2) Käesolevat seadust kohaldatakse tööülesannete täitmisele renditööna ka käesoleva paragrahvi lõikes 1 nimetamata laeval, kui tööandja on Eestis registreeritud juriidiline isik ning laevapere liige on Eesti rahvastikuregistri objekt. (3) Käesolevat seadust ei kohaldata töötamisele alla 24 meetri pikkusel kalalaeval. (4) Käesoleva seaduse § 18 lõike 1 punkti 5, § 26 lõike 1 punkti 4, § 34 lõiget 3 ja § 62 ei kohaldata töötamisele üle 24 meetri pikkusel kalalaeval. (5) Vaidluse, kas laeva suhtes kohaldatakse käesolevat seadust, lahendab kohtuväliselt Veeteede Amet, konsulteerides reederite ja laevapere liikmete esindusorganisatsioonidega. (6) Käesoleva seaduse § 32 lõiget 7 kohaldatakse kõigile merel viibivatele laevadele, sõltumata käesoleva paragrahvi lõikes 1 nimetatud laeva registreeringust või laeva lipuriigist. (7) Käesoleva seaduse §-e 19, 28 ja 29 ei kohaldata töötamisele laeval, mida kasutatakse lootsiteenuse osutamiseks. (8) Käesoleva seaduse 51. peatükki kohaldatakse töölepingu ja meretöölepingu alusel töötamisele siseveetranspordivahendil. Käesoleva seaduse 51. peatükki ei kohaldata Pärnu ja Pirita jõe suuet külastavatele merelaevadele.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_2 (redaktsioon 101032017006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101032017006",
      "estleg:supersededByVersion": {
        "@id": "estleg:Meret_seadus_Par_2_v128122017040"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Meret_seadus_Par_2_v128122017040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevat seadust kohaldatakse töötamisele Eesti laevakinnistusraamatusse või laevapereta prahitud laevade registrisse kantud laeval (edaspidi laev). (2) Käesolevat seadust kohaldatakse tööülesannete täitmisele renditööna ka käesoleva paragrahvi lõikes 1 nimetamata laeval, kui tööandja on Eestis registreeritud juriidiline isik ning laevapere liige on Eesti rahvastikuregistri andmesubjekt. (3) Käesolevat seadust ei kohaldata töötamisele alla 24 meetri pikkusel kalalaeval. (4) Käesoleva seaduse § 18 lõike 1 punkti 5, § 26 lõike 1 punkti 4, § 34 lõiget 3 ja § 62 ei kohaldata töötamisele üle 24 meetri pikkusel kalalaeval. (5) Vaidluse, kas laeva suhtes kohaldatakse käesolevat seadust, lahendab kohtuväliselt Veeteede Amet, konsulteerides reederite ja laevapere liikmete esindusorganisatsioonidega. (6) Käesoleva seaduse § 32 lõiget 7 kohaldatakse kõigile merel viibivatele laevadele, sõltumata käesoleva paragrahvi lõikes 1 nimetatud laeva registreeringust või laeva lipuriigist. (7) Käesoleva seaduse §-e 19, 28 ja 29 ei kohaldata töötamisele laeval, mida kasutatakse lootsiteenuse osutamiseks. (8) Käesoleva seaduse 51. peatükki kohaldatakse töölepingu ja meretöölepingu alusel töötamisele siseveetranspordivahendil. Käesoleva seaduse 51. peatükki ei kohaldata Pärnu ja Pirita jõe suuet külastavatele merelaevadele.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_2 (redaktsioon 128122017040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017040",
      "estleg:supersededByVersion": {
        "@id": "estleg:Meret_seadus_Par_2_v103012020006"
      },
      "estleg:versionValidTo": {
        "@value": "2020-01-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Meret_seadus_Par_2_v103012020006",
