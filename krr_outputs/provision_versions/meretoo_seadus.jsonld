    {
      "@id": "estleg:Meret_seadus_Par_74_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgani kohaliku asutuse juhatajal ja järelevalvet tegeval ametnikul on õigus keelata laeva ruumide, seadmete ja töövahendite kasutamine, kui nende seisund ohustab laevapere liikmete ning reisijate elu ja tervist.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_74 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108",
      "estleg:supersededByVersion": {
        "@id": "estleg:Meret_seadus_Par_74_v101032017006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-03-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Meret_seadus_Par_74_v101032017006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalveorgani kohaliku asutuse juhatajal ja järelevalvet tegeval ametnikul on õigus keelata laeva ruumide, seadmete ja töövahendite kasutamine, kui nende seisund ohustab laevapere liikmete ning reisijate elu ja tervist.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_74 (redaktsioon 101032017006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101032017006"
    },
    {
      "@id": "estleg:Meret_seadus_Par_75_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_75"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Andmete esitamata jätmise eest reederi poolt vastavalt käesoleva seaduse §-le 9 –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 1300 eurot.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_75 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108",
      "estleg:supersededByVersion": {
