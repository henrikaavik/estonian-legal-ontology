    {
      "@id": "estleg:Meret_seadus_Par_85_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2014. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_85 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    },
    {
      "@id": "estleg:Meret_seadus_Par_9_v129062014108",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Meret_seadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meretöölepingu kirjalikus dokumendis peavad lisaks töölepingu seaduse §-s 5 sätestatule sisalduma vähemalt järgmised andmed: laevapere liikme sünnikoht; laevapere liikme tööle asumise koht; laev või laevad, kus tööle asutakse, ja laeva registrinumber; viide reederi pakutavatele tervise- ja sotsiaalkaitse tagatistele, sealhulgas hüvitistele seoses tööga seotud haiguse, tööõnnetusest põhjustatud vigastuse või surmaga; viide laevapere liikme kojusõidu korraldusele; viide meretöölepingu ülesütlemise tingimustele ja korrale, sealhulgas meretöölepingu ülesütlemise etteteatamise tähtaegadele.",
      "rdfs:label": {
        "@value": "Meret_seadus_Par_9 (redaktsioon 129062014108)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014108"
    }
  ]
}
