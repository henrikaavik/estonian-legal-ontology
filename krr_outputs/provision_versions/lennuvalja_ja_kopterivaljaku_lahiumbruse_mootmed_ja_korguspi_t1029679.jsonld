        "@value": "Sätete redaktsioonid: Lennuvälja ja kopteriväljaku lähiümbruse mõõtmed ja kõrguspiirangute miinimum- ja maksimummõõtmed ning lähiümbruse mõõtmete ja kõrguspiirangute miinimumnõuded (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lennuvälja ja kopteriväljaku lähiümbruse mõõtmed ja kõrguspiirangute miinimum- ja maksimummõõtmed ning lähiümbruse mõõtmete ja kõrguspiirangute miinimumnõuded"
    },
    {
      "@id": "estleg:Reg_1029679_Par_1_v1029679",
