    {
      "@id": "estleg:Reg_156607_Par_2_v156607",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156607_Par_2"
