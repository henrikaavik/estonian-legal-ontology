      }
    },
    {
      "@id": "estleg:Reg_1025356_Par_2_v1025356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025356_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsakorraldustööde tehnilised vahendid on metsakorraldustöödeks vajalik infotehnoloogia tarkvara ning tehniline dokumentatsioon. Metsakorraldustööde tehnilised vahendid on metsakorraldustöödeks vajalik infotehnoloogia tarkvara ning tehniline dokumentatsioon.",
      "rdfs:label": {
        "@value": "Reg_1025356_Par_2 (redaktsioon 1025356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025356",
      "estleg:sourceAct": "Metsakorraldustööde tehniliste vahendite kohta esitatavad nõuded",
      "estleg:provisionRef": "Reg_1025356 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025356_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025356_Par_3_v1025356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025356_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Metsakorraldustöödeks vajalik infotehnoloogia tarkvara peab võimaldama: 1 1) vektorkaardi joonestamist ja teemakaartide koostamist; 2 2) metsamajandamiskava koostamist vastavalt keskkonnaministri 16. jaanuari 2009. a määruse nr 2 „Metsa korraldamise juhend” peatükis 6 esitatud nõuetele; 3 3) Vabariigi Valitsuse 16. augusti 2007. a määruse nr 209 „Metsaressursi arvestuse riikliku registri põhimäärus” §-s 6 esitatud nõuetele vastavate korrektsete metsainventeerimisandmete esitamist metsaressursi arvestuse riiklikusse registrisse (edaspidi metsaregister). Metsakorraldustöödeks vajalik infotehnoloogia tarkvara peab võimaldama: vektorkaardi joonestamist ja teemakaartide koostamist; metsamajandamiskava koostamist vastavalt keskkonnaministri 16. jaanuari 2009. a määruse nr 2 „Metsa korraldamise juhend” peatükis 6 esitatud nõuetele; Vabariigi Valitsuse 16. augusti 2007. a määruse nr 209 „Metsaressursi arvestuse riikliku registri põhimäärus” §-s 6 esitatud nõuetele vastavate korrektsete metsainventeerimisandmete esitamist metsaressursi arvestuse riiklikusse registrisse (edaspidi metsaregister).",
      "rdfs:label": {
        "@value": "Reg_1025356_Par_3 (redaktsioon 1025356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025356",
      "estleg:sourceAct": "Metsakorraldustööde tehniliste vahendite kohta esitatavad nõuded",
      "estleg:provisionRef": "Reg_1025356 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025356_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025356_Par_4_v1025356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025356_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Metsakorraldustööde tehniline dokumentatsioon peab sisaldama vähemalt: 1 1) välitööde juhendit koos selles viidatud tabelite, blankettide ja muude abimaterjalidega; 2 2) metsamajandamiskava näidist või asjaomaseid infotehnoloogilisi rakendusi, mis vastavad § 3 punktis 2 viidatud nõuetele. Metsakorraldustööde tehniline dokumentatsioon peab sisaldama vähemalt: välitööde juhendit koos selles viidatud tabelite, blankettide ja muude abimaterjalidega; metsamajandamiskava näidist või asjaomaseid infotehnoloogilisi rakendusi, mis vastavad § 3 punktis 2 viidatud nõuetele. 2 (2) Metsamajandamiskava näidis esitatakse paberil või digitaalkujul. Digitaalkujul esitatavad metsainventeerimisandmed peavad vastama Keskkonnaagentuuri direktori käskkirjaga kehtestatud ning Keskkonnaagentuuri veebilehel avaldatud metsaregistri andmeformaadile. Metsamajandamiskava näidis esitatakse paberil või digitaalkujul. Digitaalkujul esitatavad metsainventeerimisandmed peavad vastama Keskkonnaagentuuri direktori käskkirjaga kehtestatud ning Keskkonnaagentuuri veebilehel avaldatud metsaregistri andmeformaadile.",
      "rdfs:label": {
        "@value": "Reg_1025356_Par_4 (redaktsioon 1025356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025356",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025356",
      "estleg:sourceAct": "Metsakorraldustööde tehniliste vahendite kohta esitatavad nõuded",
      "estleg:provisionRef": "Reg_1025356 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025356_Map"
      }
    },
    {
      "@id": "estleg:Reg_1025356_Par_5_v1025356",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025356_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loa taotleja on kohustatud tõendama tehniliste vahendite omandi- või kasutusõigust ning vastavust käesolevas määruses esitatud nõuetele. Loa taotleja on kohustatud tõendama tehniliste vahendite omandi- või kasutusõigust ning vastavust käesolevas määruses esitatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1025356_Par_5 (redaktsioon 1025356)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025356",
