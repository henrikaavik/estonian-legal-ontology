      "estleg:sourceAct": "Metsakorraldustööde tehniliste vahendite kohta esitatavad nõuded",
      "estleg:provisionRef": "Reg_1025356 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025356_Map"
      }
    },
