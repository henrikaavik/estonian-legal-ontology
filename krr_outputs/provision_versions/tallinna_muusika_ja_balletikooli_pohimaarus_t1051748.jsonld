    {
      "@id": "estleg:Reg_1051748_Par_5_v1051748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051748_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolil on oma nimega ja väikese riigivapi kujutisega pitsat ning oma sümboolika. Koolil on oma nimega ja väikese riigivapi kujutisega pitsat ning oma sümboolika.",
      "rdfs:label": {
        "@value": "Reg_1051748_Par_5 (redaktsioon 1051748)",
