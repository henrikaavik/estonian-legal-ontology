      }
    },
    {
      "@id": "estleg:Reg_1051748_Par_22_v1051748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051748_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õpilasesindus valitakse õpilaskonna põhikirjas sätestatud korras. Õpilasesindus valitakse õpilaskonna põhikirjas sätestatud korras. 2 (2) Õpilasesinduse liikmed valitakse vabadel, üldistel, ühetaolistel, salajastel ja otsestel valimistel. Õpilasesinduse liikmed valitakse vabadel, üldistel, ühetaolistel, salajastel ja otsestel valimistel. 3 (3) Esimese õpilasesinduse valimised kuulutab välja kooli direktor, teavitades kandidaatide esitamise tähtaegadest ning valimise toimumise ajast ning korrast vähemalt kaks nädalat ette kooli infotahvlil või muul õpilaskonnale kõige enam kättesaadaval viisil. Esimese õpilasesinduse valimised kuulutab välja kooli direktor, teavitades kandidaatide esitamise tähtaegadest ning valimise toimumise ajast ning korrast vähemalt kaks nädalat ette kooli infotahvlil või muul õpilaskonnale kõige enam kättesaadaval viisil.",
      "rdfs:label": {
