    {
      "@id": "estleg:Reg_1051748_Par_4_v1051748",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051748_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kooli asjaajamise keel on eesti keel. Kooli asjaajamise keel on eesti keel. 2 (2) Põhikooli- ja gümnaasiumiõppe õppekeel on eesti keel. Põhikooli- ja gümnaasiumiõppe õppekeel on eesti keel. 3 (3) Kutseõppe tasemeõppe õppekeeled on eesti ja inglise keel. Tasemeõppe läbiviimise muudes keeltes otsustab Haridus- ja Teadusministeerium. Kutseõppe tasemeõppe õppekeeled on eesti ja inglise keel. Tasemeõppe läbiviimise muudes keeltes otsustab Haridus- ja Teadusministeerium.",
      "rdfs:label": {
        "@value": "Reg_1051748_Par_4 (redaktsioon 1051748)",
