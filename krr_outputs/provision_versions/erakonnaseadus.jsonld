    {
      "@id": "estleg:ERAKON_Par_14_v231064",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ERAKON_Par_14"
