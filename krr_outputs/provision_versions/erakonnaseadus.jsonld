    {
      "@id": "estleg:ERAKON_Par_7_v22282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ERAKON_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erakonna tegevuse aluseks on põhikiri. (2) Erakonna põhikirjale kohaldatakse mittetulundusühingute seaduses põhikirjale sätestatud nõudeid. (3) Erakonna poliitilise tegevuse aluseks on programm. Selle kinnitamise ja muutmise kord sätestatakse erakonna põhikirjas.",
      "rdfs:label": {
        "@value": "ERAKON_Par_7 (redaktsioon 22282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22282",
