      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1041145_Par_3 (redaktsioon 1041145)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041145",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041145",
