      },
      "estleg:versionText": "Ratifitseerida juurdelisatud (edaspidi konventsioon), millele on alla kirjutatud 2018. aasta 29. juunil Pariisis.",
      "rdfs:label": {
        "@value": "MKKUEMSMMKR_Par_1 (redaktsioon 218122019001)",
        "@language": "et"
      },
