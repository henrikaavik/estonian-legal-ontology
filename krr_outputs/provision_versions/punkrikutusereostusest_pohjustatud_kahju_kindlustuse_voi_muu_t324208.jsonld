    },
    {
      "@id": "estleg:Reg_324208_Par_5_v324208",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324208_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõend tunnistatakse kehtetuks: 1 1) kindlustuslepingu või muu rahalise tagatise kehtivuse lõppemisel, kui see on lühem tõendi kehtivusajast; 2 2) kui ilmneb, et laevaomaniku, laevapereta prahtija või nende esindaja poolt on esitatud valeandmeid tõendi taotlemisel. Tõend tunnistatakse kehtetuks: kindlustuslepingu või muu rahalise tagatise kehtivuse lõppemisel, kui see on lühem tõendi kehtivusajast; kui ilmneb, et laevaomaniku, laevapereta prahtija või nende esindaja poolt on esitatud valeandmeid tõendi taotlemisel.",
      "rdfs:label": {
