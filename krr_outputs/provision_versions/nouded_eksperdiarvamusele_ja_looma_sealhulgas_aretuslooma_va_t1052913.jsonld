      }
    },
    {
      "@id": "estleg:Reg_1052913_Par_2_v1052913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052913_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eksperdiarvamus (edaspidi arvamus) vormistatakse kirjalikult. Eksperdiarvamus (edaspidi arvamus) vormistatakse kirjalikult. 2 (2) Arvamus sisaldab vähemalt: 1 1) turuanalüüsi, mille käigus hinnatakse üldist majandussituatsiooni ja asjaomase loomaliigi loomade üldist hinnataset ning nõudluse-pakkumise vahekorra võrdlust; 2 2) analüüsi ja hinnangut looma saavutatud toodangunäitajate kohta, mis mõjutavad looma turuväärtust, ning looma tõuomaduste ja järglaste arvu kohta; 3 3) aretuslooma väärtuse suuruse arvutamisel kasutatud metoodika kirjeldust ja kasutatava meetodi valiku põhjendust; 4 4) ettepanekut looma väärtuse suuruse kohta, näidates ära, kuidas see väärtus on kujunenud, võttes muu hulgas arvesse looma vanust, sugu ja soetusväärtust ning tuues välja asjaolud, mis võivad looma väärtust muuta; 5 5) viited hindamisel kasutatud teoreetilistele materjalidele ja andmeallikatele. Arvamus sisaldab vähemalt: turuanalüüsi, mille käigus hinnatakse üldist majandussituatsiooni ja asjaomase loomaliigi loomade üldist hinnataset ning nõudluse-pakkumise vahekorra võrdlust; analüüsi ja hinnangut looma saavutatud toodangunäitajate kohta, mis mõjutavad looma turuväärtust, ning looma tõuomaduste ja järglaste arvu kohta; aretuslooma väärtuse suuruse arvutamisel kasutatud metoodika kirjeldust ja kasutatava meetodi valiku põhjendust; ettepanekut looma väärtuse suuruse kohta, näidates ära, kuidas see väärtus on kujunenud, võttes muu hulgas arvesse looma vanust, sugu ja soetusväärtust ning tuues välja asjaolud, mis võivad looma väärtust muuta; viited hindamisel kasutatud teoreetilistele materjalidele ja andmeallikatele.",
      "rdfs:label": {
        "@value": "Reg_1052913_Par_2 (redaktsioon 1052913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052913",
