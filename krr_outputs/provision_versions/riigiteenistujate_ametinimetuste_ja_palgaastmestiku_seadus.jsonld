        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898520",
      "estleg:sourceAct": "Riigiteenistujate ametinimetuste ja palgaastmestiku seadus",
      "estleg:provisionRef": "RAPS § 9",
      "estleg:partOfAct": {
