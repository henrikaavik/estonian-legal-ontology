      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elektri- ja elektroonikaseadmetest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning sihtarvud ja sihtarvude saavutamise tähtajad (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elektri- ja elektroonikaseadmetest tekkinud jäätmete kogumise, tootjale tagastamise ning taaskasutamise või kõrvaldamise nõuded ja kord ning sihtarvud ja sihtarvude saavutamise tähtajad"
