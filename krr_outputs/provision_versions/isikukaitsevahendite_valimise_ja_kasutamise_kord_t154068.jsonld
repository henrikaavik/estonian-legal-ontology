    {
      "@id": "estleg:Reg_154068_Par_2_v154068",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154068_Par_2"
