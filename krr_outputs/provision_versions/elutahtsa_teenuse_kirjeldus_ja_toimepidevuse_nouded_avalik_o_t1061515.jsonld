    },
    {
      "@id": "estleg:Reg_1061515_Par_2_v1061515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061515_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Rahvusringhääling peab elutähtsat teenust planeerima, tootma ja üldsusele suunama nii, et teenus oleks häiriva teguri esinemisel minimaalselt häiritud. Eesti Rahvusringhääling peab elutähtsat teenust planeerima, tootma ja üldsusele suunama nii, et teenus oleks häiriva teguri esinemisel minimaalselt häiritud. 2 (2) Ringhäälinguvõrgu teenuse osutaja peab elutähtsat teenust planeerima, projekteerima, ehitama, hooldama ja kasutama nii, et teenus oleks sidevõrku ja sideteenust häiriva teguri esinemisel minimaalselt häiritud. Ringhäälinguvõrgu teenuse osutaja peab elutähtsat teenust planeerima, projekteerima, ehitama, hooldama ja kasutama nii, et teenus oleks sidevõrku ja sideteenust häiriva teguri esinemisel minimaalselt häiritud.",
      "rdfs:label": {
        "@value": "Reg_1061515_Par_2 (redaktsioon 1061515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061515",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061515",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded avalik-õigusliku meediateenuse ja selle osutamiseks vajaliku ringhäälinguvõrgu teenuse toimimise tagamisel",
      "estleg:provisionRef": "Reg_1061515 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061515_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061515_Par_3_v1061515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061515_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Rahvusringhääling tagab vähemalt ühe eestikeelse ja ühe venekeelse raadioprogrammi tootmise ning sellekohasele signaalile ligipääsu ringhäälinguvõrgu teenuse osutajale katkestuse tekkest mitte hiljem kui 6 tunni jooksul. Raadioprogrammi taastamise hetkest tagab Eesti Rahvusringhääling raadiouudiste tootmise sagedusega vähemalt 12 korda ööpäevas. Eesti Rahvusringhääling tagab vähemalt ühe eestikeelse ja ühe venekeelse raadioprogrammi tootmise ning sellekohasele signaalile ligipääsu ringhäälinguvõrgu teenuse osutajale katkestuse tekkest mitte hiljem kui 6 tunni jooksul. Raadioprogrammi taastamise hetkest tagab Eesti Rahvusringhääling raadiouudiste tootmise sagedusega vähemalt 12 korda ööpäevas. 2 (2) Eesti Rahvusringhääling tagab vähemalt ühe eestikeelse ja ühe venekeelse teleprogrammi tootmise ja sellekohasele signaalile ligipääsu ringhäälinguvõrgu teenuse osutajale katkestuse tekkest mitte hiljem kui 24 tunni jooksul. Teleprogrammi taastamise hetkest tagab Eesti Rahvusringhääling teleuudiste tootmise sagedusega vähemalt 3 korda ööpäevas. Eesti Rahvusringhääling tagab vähemalt ühe eestikeelse ja ühe venekeelse teleprogrammi tootmise ja sellekohasele signaalile ligipääsu ringhäälinguvõrgu teenuse osutajale katkestuse tekkest mitte hiljem kui 24 tunni jooksul. Teleprogrammi taastamise hetkest tagab Eesti Rahvusringhääling teleuudiste tootmise sagedusega vähemalt 3 korda ööpäevas. 3 (3) Eesti Rahvusringhääling tagab eesti- ja venekeelsete veebipõhiste uudiste ööpäevaringse tootmise ja sellekohasele signaalile ligipääsu sideettevõtjale katkestuse tekkest mitte hiljem kui 8 tunni jooksul. Veebiuudiste taastamise hetkest tagab Eesti Rahvusringhääling veebiuudiste tootmise vähemalt 18 tunnil päevas, 7 päeval nädalas. Eesti Rahvusringhääling tagab eesti- ja venekeelsete veebipõhiste uudiste ööpäevaringse tootmise ja sellekohasele signaalile ligipääsu sideettevõtjale katkestuse tekkest mitte hiljem kui 8 tunni jooksul. Veebiuudiste taastamise hetkest tagab Eesti Rahvusringhääling veebiuudiste tootmise vähemalt 18 tunnil päevas, 7 päeval nädalas. 4 (4) Ringhäälinguvõrgu teenuse osutaja tagab: 1 1) pidevalt käesoleva paragrahvi lõikes 1 nimetatud raadioprogrammide edastamise kriisivalmidusega saatejaamadest kuni 1-minutilise katkestusega ümberlülitamise hetkel; 2 2) käesoleva paragrahvi lõikes 2 nimetatud teleprogrammide puhul varuühendustele ümberlülituse kuni 24 tunni jooksul katkestuse hetkest. Ringhäälinguvõrgu teenuse osutaja tagab: pidevalt käesoleva paragrahvi lõikes 1 nimetatud raadioprogrammide edastamise kriisivalmidusega saatejaamadest kuni 1-minutilise katkestusega ümberlülitamise hetkel; käesoleva paragrahvi lõikes 2 nimetatud teleprogrammide puhul varuühendustele ümberlülituse kuni 24 tunni jooksul katkestuse hetkest.",
      "rdfs:label": {
        "@value": "Reg_1061515_Par_3 (redaktsioon 1061515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061515",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061515",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded avalik-õigusliku meediateenuse ja selle osutamiseks vajaliku ringhäälinguvõrgu teenuse toimimise tagamisel",
      "estleg:provisionRef": "Reg_1061515 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061515_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061515_Par_4_v1061515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061515_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti Rahvusringhääling ja ringhäälinguvõrgu teenuse osutaja kirjeldavad elutähtsa teenuse toimepidevuse riskianalüüsis teenuse toimepidevuse tagamisega kaasnevaid ohte, sh ristsõltuvusi teistest elutähtsatest teenustest ja nendega seotud ohtusid ja katkestusi ning hädaolukorra seaduse § 91 kohases üleriigilises riskianalüüsis analüüsitud hädaolukordi või muid sarnaseid olukordi põhjustada võivaid ohte ning arvestab nendega toimepidevuse plaani koostamisel. Eesti Rahvusringhääling ja ringhäälinguvõrgu teenuse osutaja kirjeldavad elutähtsa teenuse toimepidevuse riskianalüüsis teenuse toimepidevuse tagamisega kaasnevaid ohte, sh ristsõltuvusi teistest elutähtsatest teenustest ja nendega seotud ohtusid ja katkestusi ning hädaolukorra seaduse § 91 kohases üleriigilises riskianalüüsis analüüsitud hädaolukordi või muid sarnaseid olukordi põhjustada võivaid ohte ning arvestab nendega toimepidevuse plaani koostamisel. 2 (2) Eesti Rahvusringhääling ja ringhäälinguvõrgu teenuse osutaja: 1 1) määratlevad oma taristu, mis enim mõjutab tema elutähtsa teenuse toimepidevust (edaspidi kriitiline taristu); 2 2) tagavad oma objekti ja kriitilise taristu kaitse ja rakendavad turvalisuse tagamise meetmed vastavalt riskianalüüsi tulemustele ja elutähtsa teenuse toimepidevust korraldava asutuse korraldustele; 3 3) regulaarselt analüüsivad ja hindavad küberohte ning rakendavad maandavaid meetmeid vastavalt küberturvalisuse seadusele ja elutähtsa teenuse toimepidevust korraldava asutuse korraldustele; 4 4) sõlmivad töötajatega ja alltöövõtjatega lepingud, mis tagavad elutähtsa teenuse toimepidevuse tagamisega seotud ülesannete täitmise ka töövälisel ajal; 5 5) vähendavad sõltuvust teistest elutähtsatest teenustest, sh omavad alternatiivseid sidepidamise lahendusi ning tagavad autonoomse elektritoite vastavalt käesoleva paragrahvi lõigetele 3 ja 4. Eesti Rahvusringhääling ja ringhäälinguvõrgu teenuse osutaja: määratlevad oma taristu, mis enim mõjutab tema elutähtsa teenuse toimepidevust (edaspidi kriitiline taristu); tagavad oma objekti ja kriitilise taristu kaitse ja rakendavad turvalisuse tagamise meetmed vastavalt riskianalüüsi tulemustele ja elutähtsa teenuse toimepidevust korraldava asutuse korraldustele; regulaarselt analüüsivad ja hindavad küberohte ning rakendavad maandavaid meetmeid vastavalt küberturvalisuse seadusele ja elutähtsa teenuse toimepidevust korraldava asutuse korraldustele; sõlmivad töötajatega ja alltöövõtjatega lepingud, mis tagavad elutähtsa teenuse toimepidevuse tagamisega seotud ülesannete täitmise ka töövälisel ajal; vähendavad sõltuvust teistest elutähtsatest teenustest, sh omavad alternatiivseid sidepidamise lahendusi ning tagavad autonoomse elektritoite vastavalt käesoleva paragrahvi lõigetele 3 ja 4. 3 (3) Eesti Rahvusringhääling tagab avalik-õigusliku meediateenuse toimepidevuse tagamiseks elektrienergiaga varustamise teenuse katkestuse korral autonoomse elektritoite vähemalt 12 tunniks avalik-õigusliku meediateenuse toimimiseks. Eesti Rahvusringhääling tagab avalik-õigusliku meediateenuse toimepidevuse tagamiseks elektrienergiaga varustamise teenuse katkestuse korral autonoomse elektritoite vähemalt 12 tunniks avalik-õigusliku meediateenuse toimimiseks. 4 (4) Ringhäälinguvõrgu teenuse toimepidevuse tagamiseks elektrienergiaga varustamise teenuse katkestuse korral tagab ringhäälinguvõrgu teenuse osutaja autonoomse elektritoite oma ringhäälinguvõrgu piires vähemalt 72 tunniks ringhäälinguvõrgu osale, mille toimepidevusest sõltub avalik-õigusliku meediateenuse kättesaadavus. Ringhäälinguvõrgu teenuse toimepidevuse tagamiseks elektrienergiaga varustamise teenuse katkestuse korral tagab ringhäälinguvõrgu teenuse osutaja autonoomse elektritoite oma ringhäälinguvõrgu piires vähemalt 72 tunniks ringhäälinguvõrgu osale, mille toimepidevusest sõltub avalik-õigusliku meediateenuse kättesaadavus.",
      "rdfs:label": {
        "@value": "Reg_1061515_Par_4 (redaktsioon 1061515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061515",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061515",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded avalik-õigusliku meediateenuse ja selle osutamiseks vajaliku ringhäälinguvõrgu teenuse toimimise tagamisel",
      "estleg:provisionRef": "Reg_1061515 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061515_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061515_Par_5_v1061515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061515_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avalik-õigusliku meediateenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga on tegemist juhul, kui esineb vähemalt üks järgmistest tingimustest: 1 1) Eesti Rahvusringhääling ei suuda taastada teenust käesoleva määruse § 3 lõigetes 1–3 sätestatud aja jooksul; 2 2) avalik-õigusliku meediateenuse katkestus põhjustab teise elutähtsa teenuse katkestuse, mis toob kaasa hädaolukorra. Avalik-õigusliku meediateenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga on tegemist juhul, kui esineb vähemalt üks järgmistest tingimustest: Eesti Rahvusringhääling ei suuda taastada teenust käesoleva määruse § 3 lõigetes 1–3 sätestatud aja jooksul; avalik-õigusliku meediateenuse katkestus põhjustab teise elutähtsa teenuse katkestuse, mis toob kaasa hädaolukorra. 2 (2) Ringhäälinguvõrgu teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga on tegemist juhul, kui esineb vähemalt üks järgmistest tingimustest: 1 1) ringhäälinguvõrgu teenuse osutaja ei suuda taastada teenust käesoleva määruse § 3 lõikes 4 sätestatud aja jooksul; 2 2) ringhäälinguvõrgu teenuse katkestus põhjustab teise elutähtsa teenuse katkestusest tuleneva hädaolukorra. Ringhäälinguvõrgu teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga on tegemist juhul, kui esineb vähemalt üks järgmistest tingimustest: ringhäälinguvõrgu teenuse osutaja ei suuda taastada teenust käesoleva määruse § 3 lõikes 4 sätestatud aja jooksul; ringhäälinguvõrgu teenuse katkestus põhjustab teise elutähtsa teenuse katkestusest tuleneva hädaolukorra.",
      "rdfs:label": {
        "@value": "Reg_1061515_Par_5 (redaktsioon 1061515)",
        "@language": "et"
      },
