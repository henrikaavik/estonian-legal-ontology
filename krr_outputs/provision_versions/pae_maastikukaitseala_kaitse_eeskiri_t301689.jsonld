      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301689",
      "estleg:sourceAct": "Pae maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301689 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301689_Map_2026"
      }
    },
