      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kasvava metsa raieõiguse ja metsamaterjali müügi vastavust käesolevale määrusele kontrollivad riigivara valitseja ja Riigikontroll. Kasvava metsa raieõiguse ja metsamaterjali müügi vastavust käesolevale määrusele kontrollivad riigivara valitseja ja Riigikontroll.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_24 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
