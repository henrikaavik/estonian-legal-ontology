      }
    },
    {
      "@id": "estleg:Reg_309424_Par_3_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kasvava metsa raieõiguse alghind määratakse, korrutades raielangilt saadava metsamaterjali koguse vastava metsamaterjali hariliku väärtusega ning lahutades korrutisest võimalikud raie-, kokkuveo-, ladustamis- ja langi puhastamise kulud ning transpordi- ja laadimiskulud. RT I 2023-09-28 2 128092023002 2023-10-01 Kasvava metsa raieõiguse alghind määratakse, korrutades raielangilt saadava metsamaterjali koguse vastava metsamaterjali hariliku väärtusega ning lahutades korrutisest võimalikud raie-, kokkuveo-, ladustamis- ja langi puhastamise kulud ning transpordi- ja laadimiskulud. 2 (2) Metsamaterjali alghind metsamaterjali müüja vahelaos määratakse, lähtudes metsamaterjali harilikust väärtusest. Alghinna määramisel teistes tarnekohtades tehakse alghinna ümberarvutus lähtuvalt tarnega seotud võimalikest transpordi-, laadimis-, ladustamis-, kindlustus- ja muudest kuludest. Metsamaterjali alghind metsamaterjali müüja vahelaos määratakse, lähtudes metsamaterjali harilikust väärtusest. Alghinna määramisel teistes tarnekohtades tehakse alghinna ümberarvutus lähtuvalt tarnega seotud võimalikest transpordi-, laadimis-, ladustamis-, kindlustus- ja muudest kuludest. 3 (3) Avalikul enampakkumisel ja eelläbirääkimistega pakkumisel ei tohi kasvava metsa raieõiguse ja metsamaterjali müügihind olla madalam käesoleva paragrahvi lõigetes 1 ja 2 määratud alghinnast. Avalikul enampakkumisel ja eelläbirääkimistega pakkumisel ei tohi kasvava metsa raieõiguse ja metsamaterjali müügihind olla madalam käesoleva paragrahvi lõigetes 1 ja 2 määratud alghinnast.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_3 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309424_Map"
      }
    },
    {
      "@id": "estleg:Reg_309424_Par_4_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kasvava metsa raieõiguse ja metsamaterjali müügiviisid on: 1 1) avalik enampakkumine (suuline, kirjalik, kombineeritud ja elektrooniline); 2 2) eelläbirääkimistega pakkumine; 3 3) müük kokkuleppehinnaga. Kasvava metsa raieõiguse ja metsamaterjali müügiviisid on: avalik enampakkumine (suuline, kirjalik, kombineeritud ja elektrooniline); eelläbirääkimistega pakkumine; müük kokkuleppehinnaga. 2 (2) Müügiviisi valib müügi korraldaja, lähtudes käesoleva määruse §-des 5, 6 ja 7 sätestatust. Müügiviisi valib müügi korraldaja, lähtudes käesoleva määruse §-des 5, 6 ja 7 sätestatust.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_4 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309424_Map"
      }
    },
    {
      "@id": "estleg:Reg_309424_Par_5_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avalikul enampakkumisel müüakse: 1 1) raieõigust kasvava metsa uuendusraieks; 2 2) metsamaterjali, mille efektiivne müümine ei eelda eelnevat kokkulepet müügiobjekti spetsifikatsiooni ja tarnetingimuste suhtes ning mille müük käesoleva määruse § 7 punktide 1 ja 2 kohaselt ei ole põhjendatud. Avalikul enampakkumisel müüakse: raieõigust kasvava metsa uuendusraieks; metsamaterjali, mille efektiivne müümine ei eelda eelnevat kokkulepet müügiobjekti spetsifikatsiooni ja tarnetingimuste suhtes ning mille müük käesoleva määruse § 7 punktide 1 ja 2 kohaselt ei ole põhjendatud.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_5 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309424_Map"
      }
    },
    {
      "@id": "estleg:Reg_309424_Par_6_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eelläbirääkimistega pakkumisel müüakse: 1 1) raieõigust kasvava metsa hooldusraieks; RT I 2014-08-19 18 119082014018 2014-08-22 2 2) metsamaterjali, mille efektiivne müümine eeldab eelnevat kokkulepet müügiobjekti spetsifikatsiooni ja tarnetingimuste suhtes ning mille müük käesoleva määruse § 7 punktide 1 ja 2 kohaselt ei ole põhjendatud. Eelläbirääkimistega pakkumisel müüakse: raieõigust kasvava metsa hooldusraieks; metsamaterjali, mille efektiivne müümine eeldab eelnevat kokkulepet müügiobjekti spetsifikatsiooni ja tarnetingimuste suhtes ning mille müük käesoleva määruse § 7 punktide 1 ja 2 kohaselt ei ole põhjendatud.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_6 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309424_Map"
      }
    },
    {
      "@id": "estleg:Reg_309424_Par_7_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kokkuleppehinnaga müüakse: 1 1) metsamaterjali müügi kestvuslepingute alusel, mille tähtaeg on pikem kui 12 kuud; RT I 2014-08-19 18 119082014018 2014-08-22 2 2) metsamaterjali väikeseid (kuni 50 m3 suurusi) koguseid ning kasvava metsa hooldusraie õigust, millest saadakse kuni 300 m3 metsamaterjali aastas ühe ostja kohta; 3 3) küttepuid; 4 4) kiiresti riknevat metsamaterjali; 5 5) kasvava metsa raieõigust loodusõnnetuse korral; 6 6) metsamaterjali proovipartiisid; 7 7) raieõigust kasvava metsa trassiraieks, kujundusraieks ja raadamiseks. RT I 2014-08-19 18 119082014018 2014-08-22 Kokkuleppehinnaga müüakse: metsamaterjali müügi kestvuslepingute alusel, mille tähtaeg on pikem kui 12 kuud; metsamaterjali väikeseid (kuni 50 m3 suurusi) koguseid ning kasvava metsa hooldusraie õigust, millest saadakse kuni 300 m3 metsamaterjali aastas ühe ostja kohta; küttepuid; kiiresti riknevat metsamaterjali; kasvava metsa raieõigust loodusõnnetuse korral; metsamaterjali proovipartiisid; raieõigust kasvava metsa trassiraieks, kujundusraieks ja raadamiseks.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_7 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309424_Map"
      }
    },
    {
      "@id": "estleg:Reg_309424_Par_8_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pakkumise ettevalmistamise käigus müügi korraldaja: 1 1) määrab isiku või moodustab komisjoni (edaspidi enampakkumise läbiviija), kes valmistab pakkumise ette ja viib selle läbi; 2 2) otsustab, kas viia avalik enampakkumine läbi suuliselt, kirjalikult, kombineeritult või elektrooniliselt; 3 3) otsustab avaliku kirjaliku, kombineeritud ja elektroonilise enampakkumise ning eelläbirääkimistega pakkumise korral alghinna avaldamise vajaduse; 4 4) otsustab pakkumise lisatingimused nagu langi ülestöötamise ja väljaveo tähtajad ning tingimused, maksetingimused, samuti tehnika ja tehnoloogia, metsamaterjali ladustamise, tuleohutuse ning loodusobjektide kaitse ja keskkonnakaitse suhtes esitatavad nõuded. Pakkumise ettevalmistamise käigus müügi korraldaja: määrab isiku või moodustab komisjoni (edaspidi enampakkumise läbiviija), kes valmistab pakkumise ette ja viib selle läbi; otsustab, kas viia avalik enampakkumine läbi suuliselt, kirjalikult, kombineeritult või elektrooniliselt; otsustab avaliku kirjaliku, kombineeritud ja elektroonilise enampakkumise ning eelläbirääkimistega pakkumise korral alghinna avaldamise vajaduse; otsustab pakkumise lisatingimused nagu langi ülestöötamise ja väljaveo tähtajad ning tingimused, maksetingimused, samuti tehnika ja tehnoloogia, metsamaterjali ladustamise, tuleohutuse ning loodusobjektide kaitse ja keskkonnakaitse suhtes esitatavad nõuded. 2 (2) Müügi korraldaja võib sõlmida kolmandate isikutega lepinguid konkreetsete pakkumistega seotud toimingute läbiviimiseks. Müügi korraldaja võib sõlmida kolmandate isikutega lepinguid konkreetsete pakkumistega seotud toimingute läbiviimiseks.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_8 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_309424_Map"
      }
    },
    {
      "@id": "estleg:Reg_309424_Par_9_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Müügi korraldaja avaldab väljaandes Ametlikud Teadaanded ja oma veebilehel teate avaliku elektroonilise enampakkumise kohta vähemalt üks nädal enne pakkumise toimumist, avaliku suulise enampakkumise kohta vähemalt kaks nädalat enne pakkumise toimumist, avaliku kirjaliku ja kombineeritud enampakkumise ning eelläbirääkimistega pakkumise kohta vähemalt kaks nädalat enne pakkumiste esitamise tähtpäeva või käesoleva määruse § 7 punkti 1 kohase kokkuleppehinnaga müügi kohta vähemalt kolm nädalat enne läbirääkimiste algust. RT I 2014-08-19 18 119082014018 2014-08-22 Müügi korraldaja avaldab väljaandes Ametlikud Teadaanded ja oma veebilehel teate avaliku elektroonilise enampakkumise kohta vähemalt üks nädal enne pakkumise toimumist, avaliku suulise enampakkumise kohta vähemalt kaks nädalat enne pakkumise toimumist, avaliku kirjaliku ja kombineeritud enampakkumise ning eelläbirääkimistega pakkumise kohta vähemalt kaks nädalat enne pakkumiste esitamise tähtpäeva või käesoleva määruse § 7 punkti 1 kohase kokkuleppehinnaga müügi kohta vähemalt kolm nädalat enne läbirääkimiste algust.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_9 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
