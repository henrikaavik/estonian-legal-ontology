      }
    },
    {
      "@id": "estleg:Reg_309424_Par_25_v309424",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_309424_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust rakendatakse tagasiulatuvalt 1. jaanuarist 2007. a. Määrust rakendatakse tagasiulatuvalt 1. jaanuarist 2007. a.",
      "rdfs:label": {
        "@value": "Reg_309424_Par_25 (redaktsioon 309424)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "309424",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/309424",
      "estleg:sourceAct": "Riigimetsas kasvava metsa raieõiguse ja metsamaterjali müügi kord",
      "estleg:provisionRef": "Reg_309424 § 25",
      "estleg:partOfAct": {
