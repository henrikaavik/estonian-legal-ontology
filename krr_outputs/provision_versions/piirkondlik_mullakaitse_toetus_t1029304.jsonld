      "estleg:provisionRef": "Reg_1029304 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029304_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029304_Par_12_v1029304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029304_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohustusealuse maa pindala võib vähendada kooskõlas Euroopa Parlamendi ja nõukogu määruse (EL) nr 1305/2013 Euroopa Maaelu Arengu Põllumajandusfondist (EAFRD) antavate maaelu arengu toetuste kohta ja millega tunnistatakse kehtetuks nõukogu määrus (EÜ) nr 1698/2005 (ELT L 347, 20.12.2013, lk 487–548) artikli 47 lõigetega 2–4. RT I 2016-04-26 5 126042016005 2016-04-29 Kohustusealuse maa pindala võib vähendada kooskõlas Euroopa Parlamendi ja nõukogu määruse (EL) nr 1305/2013 Euroopa Maaelu Arengu Põllumajandusfondist (EAFRD) antavate maaelu arengu toetuste kohta ja millega tunnistatakse kehtetuks nõukogu määrus (EÜ) nr 1698/2005 (ELT L 347, 20.12.2013, lk 487–548) artikli 47 lõigetega 2–4. 2 (2) Kehtetu - RT I 2018-01-04 1 104012018001 2018-01-07 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1029304_Par_12 (redaktsioon 1029304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029304",
      "estleg:sourceAct": "Piirkondlik mullakaitse toetus",
      "estleg:provisionRef": "Reg_1029304 § 12",
