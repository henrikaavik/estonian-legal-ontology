    {
      "@id": "estleg:Reg_1029304_Par_18_v1029304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029304_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA teeb toetuse maksmise otsuse või toetuse maksmisest keeldumise otsuse sellise tähtaja jooksul, et toetusraha oleks võimalik kanda toetuse saaja arvelduskontole kohustuseaastale järgneva aasta 30. juuniks. PRIA teeb toetuse maksmise otsuse või toetuse maksmisest keeldumise otsuse sellise tähtaja jooksul, et toetusraha oleks võimalik kanda toetuse saaja arvelduskontole kohustuseaastale järgneva aasta 30. juuniks.",
      "rdfs:label": {
        "@value": "Reg_1029304_Par_18 (redaktsioon 1029304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029304",
      "estleg:sourceAct": "Piirkondlik mullakaitse toetus",
      "estleg:provisionRef": "Reg_1029304 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029304_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029304_Par_18_18_v1029304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029304_Par_18_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Euroopa Parlamendi ja nõukogu määruse (EL) nr 1305/2013 artiklis 48 nimetatud kohustuste kohandamine ei ole toetuse saajale vastuvõetav, siis kohustus lõppeb ja kohustuse kehtivusaja eest toetust tagasi ei nõuta. RT I 2018-01-04 1 104012018001 2018-01-07 Kui Euroopa Parlamendi ja nõukogu määruse (EL) nr 1305/2013 artiklis 48 nimetatud kohustuste kohandamine ei ole toetuse saajale vastuvõetav, siis kohustus lõppeb ja kohustuse kehtivusaja eest toetust tagasi ei nõuta.",
      "rdfs:label": {
        "@value": "Reg_1029304_Par_18_18 (redaktsioon 1029304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029304",
      "estleg:sourceAct": "Piirkondlik mullakaitse toetus",
      "estleg:provisionRef": "Reg_1029304 § 18_18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029304_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1029304_Par_18_19_v1029304",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029304_Par_18_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA teavitab toetuse saajat tema andmete avalikustamisest Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artiklite 111 ja 112 kohaselt ning nende töötlemisest Euroopa Liidu finantshuvide tagamise eesmärgil sama määruse artikli 113 kohaselt. RT I 2018-01-04 1 104012018001 2018-01-07 PRIA teavitab toetuse saajat tema andmete avalikustamisest Euroopa Parlamendi ja nõukogu määruse (EL) nr 1306/2013 artiklite 111 ja 112 kohaselt ning nende töötlemisest Euroopa Liidu finantshuvide tagamise eesmärgil sama määruse artikli 113 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1029304_Par_18_19 (redaktsioon 1029304)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029304",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029304",
