    {
      "@id": "estleg:Reg_1003285_Par_3_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registriandmete esitaja on abi andja, kellega Rahandusministeerium sõlmib vastava lepingu. Registriandmete esitaja on abi andja, kellega Rahandusministeerium sõlmib vastava lepingu. 2 (2) Põllumajandusliku ja kalamajandusliku vähese tähtsusega abi andmiseks teeb kavandatava abi summa broneeringu (edaspidi ka riigi limiidi broneering) ning vajaduse korral ühele tootesektorile kavandatava abi summa broneeringu (edaspidi ka tootesektori broneering) registris Regionaal- ja Põllumajandusministeerium. RT I 2023-07-05 4 105072023004 2023-07-08 Põllumajandusliku ja kalamajandusliku vähese tähtsusega abi andmiseks teeb kavandatava abi summa broneeringu (edaspidi ka riigi limiidi broneering) ning vajaduse korral ühele tootesektorile kavandatava abi summa broneeringu (edaspidi ka tootesektori broneering) registris Regionaal- ja Põllumajandusministeerium.",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_3 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
      "estleg:sourceAct": "Riigiabi ja vähese tähtsusega abi registri põhimäärus",
      "estleg:provisionRef": "Reg_1003285 § 3",
