      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigiabi ja vähese tähtsusega abi registri põhimäärus (25 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigiabi ja vähese tähtsusega abi registri põhimäärus"
    },
    {
      "@id": "estleg:Reg_1003285_Par_1_v1003285",
      "@type": [
        "owl:NamedIndividual",
