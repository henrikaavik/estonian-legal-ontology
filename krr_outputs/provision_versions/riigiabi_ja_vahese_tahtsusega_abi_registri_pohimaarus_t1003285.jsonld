      }
    },
    {
      "@id": "estleg:Reg_1003285_Par_4_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registrisse kantud andmetel on informatiivne tähendus. RT I 2015-02-10 7 110022015007 2015-02-13 Registrisse kantud andmetel on informatiivne tähendus. 2 (2) Seaduses sätestatud juhul on registrisse kantud andmetel õiguslik tähendus. RT I 2015-02-10 7 110022015007 2015-02-13 Seaduses sätestatud juhul on registrisse kantud andmetel õiguslik tähendus.",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_4 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
      "estleg:sourceAct": "Riigiabi ja vähese tähtsusega abi registri põhimäärus",
      "estleg:provisionRef": "Reg_1003285 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1003285_Map"
      }
    },
    {
      "@id": "estleg:Reg_1003285_Par_5_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete esitaja vastutab registrile esitatud andmete õigsuse eest andmete esitamise ajal. Andmete registrisse kandja vastutab registrisse kantud andmete vastavuse eest andmete esitaja poolt registrisse esitatud andmetele. Andmete esitaja vastutab registrile esitatud andmete õigsuse eest andmete esitamise ajal. Andmete registrisse kandja vastutab registrisse kantud andmete vastavuse eest andmete esitaja poolt registrisse esitatud andmetele.",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_5 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
      "estleg:sourceAct": "Riigiabi ja vähese tähtsusega abi registri põhimäärus",
      "estleg:provisionRef": "Reg_1003285 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1003285_Map"
      }
    },
    {
      "@id": "estleg:Reg_1003285_Par_6_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrit peetakse ühetasandilise infotehnoloogilise andmekoguna, mille koosseisu kuuluvad digitaalsed registriandmed. Registrit peetakse ühetasandilise infotehnoloogilise andmekoguna, mille koosseisu kuuluvad digitaalsed registriandmed.",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_6 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
      "estleg:sourceAct": "Riigiabi ja vähese tähtsusega abi registri põhimäärus",
      "estleg:provisionRef": "Reg_1003285 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1003285_Map"
      }
    },
    {
      "@id": "estleg:Reg_1003285_Par_7_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alusdokumendid on: 1 1) Euroopa Komisjoni otsus; 2 2) grupierandiga hõlmatud riigiabi teatis; 3 3) abimeetme riigisisene õiguslik alus; 4 4) abi andmise otsus või leping abi andmise kohta; 5 5) väljamaksekorraldused; 6 6) muud abi andmisega seotud dokumendid. Alusdokumendid on: Euroopa Komisjoni otsus; grupierandiga hõlmatud riigiabi teatis; abimeetme riigisisene õiguslik alus; abi andmise otsus või leping abi andmise kohta; väljamaksekorraldused; muud abi andmisega seotud dokumendid.",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_7 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
      "estleg:sourceAct": "Riigiabi ja vähese tähtsusega abi registri põhimäärus",
      "estleg:provisionRef": "Reg_1003285 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1003285_Map"
      }
    },
    {
      "@id": "estleg:Reg_1003285_Par_8_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastutav töötleja tagab registriandmete andmeturbe, sealhulgas nende tervikluse, käideldavuse ja konfidentsiaalsuse, samuti registri pidamise ja registrisse kantud andmete töötlemise, kaitse, säilimise ja arhiveerimise füüsiliste, organisatsiooniliste ja infotehnoloogiliste meetmetega ning rakendab neid järjepidevalt. Vastutav töötleja tagab registriandmete andmeturbe, sealhulgas nende tervikluse, käideldavuse ja konfidentsiaalsuse, samuti registri pidamise ja registrisse kantud andmete töötlemise, kaitse, säilimise ja arhiveerimise füüsiliste, organisatsiooniliste ja infotehnoloogiliste meetmetega ning rakendab neid järjepidevalt. 2 (2) Registriandmete turbeaste on keskmine (M) ja registri turvaklass on K2T2S1. Registriandmete turbeaste on keskmine (M) ja registri turvaklass on K2T2S1.",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_8 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
      "estleg:sourceAct": "Riigiabi ja vähese tähtsusega abi registri põhimäärus",
      "estleg:provisionRef": "Reg_1003285 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1003285_Map"
      }
    },
    {
      "@id": "estleg:Reg_1003285_Par_9_v1003285",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1003285_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abi andja kohta kantakse registrisse järgmised andmed: 1 1) nimi; 2 2) registrikood; 3 3) postiaadress; 4 4) kontaktandmed (telefon, e-posti aadress). Abi andja kohta kantakse registrisse järgmised andmed: nimi; registrikood; postiaadress; kontaktandmed (telefon, e-posti aadress).",
      "rdfs:label": {
        "@value": "Reg_1003285_Par_9 (redaktsioon 1003285)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1003285",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1003285",
