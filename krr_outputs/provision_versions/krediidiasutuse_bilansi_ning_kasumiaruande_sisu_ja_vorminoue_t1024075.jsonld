        "@id": "estleg:Reg_1024075_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1024075_Par_4_v1024075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024075_Par_4"
