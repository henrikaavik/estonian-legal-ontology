      "estleg:provisionRef": "Reg_1034955 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034955_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1034955_Par_16_v1034955",
      "@type": [
