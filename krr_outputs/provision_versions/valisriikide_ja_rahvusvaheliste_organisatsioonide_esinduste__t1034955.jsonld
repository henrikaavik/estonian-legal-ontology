      },
      "estleg:versionText": "Andmekogu turvaklass on K2T1S2 ning turbeaste on keskmine. Andmekogu turvaklass on K2T1S2 ning turbeaste on keskmine.",
      "rdfs:label": {
        "@value": "Reg_1034955_Par_12 (redaktsioon 1034955)",
        "@language": "et"
      },
