      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "TDVS_Par_27 (redaktsioon 13315807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315807"
    },
    {
      "@id": "estleg:TDVS_Par_28_v13315807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "käesoleva seaduse § 3 punkti 2 alusel määratava rahatrahvi sotsiaalfondi kandmise kord.",
      "rdfs:label": {
        "@value": "TDVS_Par_28 (redaktsioon 13315807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315807"
    },
    {
      "@id": "estleg:TDVS_Par_29_v22242",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1993.aasta 1.septembrist.",
      "rdfs:label": {
        "@value": "TDVS_Par_29 (redaktsioon 22242)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22242",
      "estleg:supersededByVersion": {
        "@id": "estleg:TDVS_Par_29_v13315807"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TDVS_Par_29_v13315807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1993. aasta 1. septembrist.",
      "rdfs:label": {
        "@value": "TDVS_Par_29 (redaktsioon 13315807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315807"
    },
    {
      "@id": "estleg:TDVS_Par_5_v22242",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusega võib mõne kategooria töötajate, samuti mõne kategooria tööandjate jaoks kehtestada teistsugused eeskirjad kui need, mis sisalduvad käesolevas seaduses.",
      "rdfs:label": {
        "@value": "TDVS_Par_5 (redaktsioon 22242)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22242",
      "estleg:supersededByVersion": {
        "@id": "estleg:TDVS_Par_5_v13315807"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TDVS_Par_5_v13315807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "TDVS_Par_5 (redaktsioon 13315807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315807"
    },
    {
      "@id": "estleg:TDVS_Par_6_v22242",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarkaristuse võib määrata kuue kuu jooksul, arvates süüteo toimepanemise päevast, kuid seejuures hiljemalt ühe kuu jooksul, arvates päevast, mil süüteost sai teada mis tahes isik, kellele süüdlane tööalaselt allub. (2) Inventuuri, revisjoni, audiitorkontrolli jmt. tulemustega tõendatud süüteo eest võib distsiplinaarkaristuse määrata aasta jooksul, arvates süüteo toimepanemise päevast, kuid seejuures hiljemalt ühe kuu jooksul, arvates inventuuri, revisjoni, audiitorkontrolli jmt. tulemuste vormistamise päevast. (3) Käesoleva paragrahvi 1. ja 2. lõikega ettenähtud ühekuuse tähtaja hulka ei arvata aega, mil tööleping oli töölepingu seaduse § 55 punktide 1-6, 9, 11 ja 12 alusel peatunud, välja arvatud puhkepäevade ja riiklike pühade aeg.",
      "rdfs:label": {
        "@value": "TDVS_Par_6 (redaktsioon 22242)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22242",
      "estleg:supersededByVersion": {
        "@id": "estleg:TDVS_Par_6_v13315807"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TDVS_Par_6_v13315807",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarkaristuse võib määrata kuue kuu jooksul, arvates süüteo toimepanemise päevast, kuid seejuures hiljemalt ühe kuu jooksul, arvates päevast, mil süüteost sai teada mis tahes isik, kellele süüdlane tööalaselt allub. (2) Inventuuri, revisjoni, audiitorkontrolli jmt. tulemustega tõendatud süüteo eest võib distsiplinaarkaristuse määrata aasta jooksul, arvates süüteo toimepanemise päevast, kuid seejuures hiljemalt ühe kuu jooksul, arvates inventuuri, revisjoni, audiitorkontrolli jmt. tulemuste vormistamise päevast. (3) Käesoleva paragrahvi 1. ja 2. lõikega ettenähtud ühekuuse tähtaja hulka ei arvata aega, mil tööleping oli töölepingu seaduse § 55 punktide 1–6, 9, 11 ja 12 alusel peatunud, välja arvatud puhkepäevade ja riiklike pühade aeg.",
      "rdfs:label": {
        "@value": "TDVS_Par_6 (redaktsioon 13315807)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315807"
    },
    {
      "@id": "estleg:TDVS_Par_7_v22242",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööandjal on õigus nõuda süüdlaselt kirjalikku seletust süüteo kohta. Seletuse andmisest keeldumine, samuti seletuses valeandmete esitamine ei ole distsiplinaarkaristuse määramise iseseisvaks aluseks. (2) Tööandjal on õigus nõuda oma töötajalt, kes oli süüteo tunnistajaks, kirjalikku seletust süüteo kohta ja tunnistaja on kohustatud andma niisuguse seletuse. Seletuse andmisest keeldumise, samuti seletuses teadvalt valeandmete esitamise eest võib tunnistajale määrata distsiplinaarkaristuse. Seletuse andmisest keeldumise eest ei saa distsiplinaarkaristust määrata töötajale, kes oli selle töötaja, kelle teo kohta talt seletust nõuti, lähedane sugulane (vanem, vend, õde, laps) või hõimlane (abikaasa, abikaasa vanem, vend, õde, laps). (3) Distsiplinaarkaristuse võib määrata seletust nõudmata, kui süütegu on tõendatud muude tõenditega.",
      "rdfs:label": {
        "@value": "TDVS_Par_7 (redaktsioon 22242)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22242",
      "estleg:supersededByVersion": {
        "@id": "estleg:TDVS_Par_7_v106072023109"
      },
      "estleg:versionValidTo": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TDVS_Par_7_v106072023109",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööandjal on õigus nõuda süüdlaselt kirjalikku seletust süüteo kohta. Seletuse andmisest keeldumine, samuti seletuses valeandmete esitamine ei ole distsiplinaarkaristuse määramise iseseisvaks aluseks. (2) Tööandjal on õigus nõuda oma töötajalt, kes oli süüteo tunnistajaks, kirjalikku seletust süüteo kohta ja tunnistaja on kohustatud andma niisuguse seletuse. Seletuse andmisest keeldumise, samuti seletuses teadvalt valeandmete esitamise eest võib tunnistajale määrata distsiplinaarkaristuse. Seletuse andmisest keeldumise eest ei saa distsiplinaarkaristust määrata töötajale, kes oli selle töötaja, kelle teo kohta temalt seletust nõuti, lähedane sugulane (vanem, vend, õde, laps) või hõimlane (abikaasa, registreeritud elukaaslane, abikaasa või registreeritud elukaaslase vanem, vend, õde, laps). (3) Distsiplinaarkaristuse võib määrata seletust nõudmata, kui süütegu on tõendatud muude tõenditega.",
      "rdfs:label": {
        "@value": "TDVS_Par_7 (redaktsioon 106072023109)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023109"
    },
    {
      "@id": "estleg:TDVS_Par_8_v22242",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Distsiplinaarkaristus ei tohi olla ilmses vastuolus süüteo raskuse, selle toimepanemise asjaolude ning töötaja eelneva käitumisega. (2) Tööandja ei ole distsiplinaarkaristuse valikul seotud käesoleva seaduse §-s 3 sisalduva karistuste loetlemise järjekorraga.",
      "rdfs:label": {
        "@value": "TDVS_Par_8 (redaktsioon 22242)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22242"
    },
    {
      "@id": "estleg:TDVS_Par_9_v22242",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TDVS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Iga süüteo eest võib määrata ainult ühe distsiplinaarkaristuse. (2) Süüteo jätkumine pärast distsiplinaarkaristuse määramist on uus süütegu ja selle eest võib töötajale määrata distsiplinaarkaristuse.",
      "rdfs:label": {
        "@value": "TDVS_Par_9 (redaktsioon 22242)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22242"
    }
  ]
}
