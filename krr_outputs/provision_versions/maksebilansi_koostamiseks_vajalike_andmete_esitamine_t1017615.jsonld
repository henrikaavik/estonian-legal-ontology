    },
    {
      "@id": "estleg:Reg_1017615_Par_1_v1017615",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1017615_Par_1"
