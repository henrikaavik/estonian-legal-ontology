      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055298_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vahendusasutus on Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi KIK). Vahendusasutus on Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi KIK). 2 (2) KIK avaldab äriplaani ja finantsanalüüsi koostamise juhendi, „ei kahjusta oluliselt” põhimõttele vastavuse hindamise juhendi, taotluses esitatavate projekti saavutatavate näitajate ning taotluste hindamise juhendi hiljemalt taotlusvooru väljakuulutamise päeval KIKi kodulehel. KIK avaldab äriplaani ja finantsanalüüsi koostamise juhendi, „ei kahjusta oluliselt” põhimõttele vastavuse hindamise juhendi, taotluses esitatavate projekti saavutatavate näitajate ning taotluste hindamise juhendi hiljemalt taotlusvooru väljakuulutamise päeval KIKi kodulehel.",
      "rdfs:label": {
        "@value": "Reg_1055298_Par_4 (redaktsioon 1055298)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055298",
