      "rdfs:label": {
        "@value": "TMS_Par_62 (redaktsioon 992311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992311",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_62_v12769829"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/992311",
