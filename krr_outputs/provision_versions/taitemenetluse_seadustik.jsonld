    {
      "@id": "estleg:TMS_Par_208_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Füüsilise isiku surma või juriidilise isiku lõppemise korral ei pöörata sissenõuet füüsilise isiku pärija või juriidilise isiku õigusjärglase varale ja täitemenetlus lõpetatakse.",
      "rdfs:label": {
        "@value": "TMS_Par_208 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_208_v111032023013"
      },
      "estleg:versionValidTo": {
        "@value": "2023-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 208",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_208_v111032023013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Füüsilise isiku surma korral ei pöörata sissenõuet füüsilise isiku pärija varale ja täitemenetlus lõpetatakse.",
      "rdfs:label": {
        "@value": "TMS_Par_208 (redaktsioon 111032023013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/111032023013",
