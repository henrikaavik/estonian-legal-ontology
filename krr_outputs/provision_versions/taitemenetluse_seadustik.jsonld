    {
      "@id": "estleg:TMS_Par_121_v12769829",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_121"
