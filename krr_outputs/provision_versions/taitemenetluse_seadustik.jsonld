      }
    },
    {
      "@id": "estleg:TMS_Par_75_v113032014105",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_75"
      },
      "estleg:versionValidFrom": {
