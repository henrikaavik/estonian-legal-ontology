      }
    },
    {
      "@id": "estleg:TMS_Par_212_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_212"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isik võib edastada oma tahteavalduse või dokumendi teisele isikule ka kohtutäituri vahendusel, esitades kohtutäiturile avalduse ja dokumendi.",
      "rdfs:label": {
        "@value": "TMS_Par_212 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 212",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_213_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_213"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tahteavalduse kättetoimetamisele kohtutäituri vahendusel kohaldatakse tsiviilkohtumenetluse seadustikus menetlusdokumendi kättetoimetamise kohta sätestatut, kui seadusest ei tulene teisiti. Kohtutäitur võib kasutada kõiki kohtule dokumendi kättetoimetamiseks lubatud viise.",
      "rdfs:label": {
        "@value": "TMS_Par_213 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 213",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_214_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_214"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tahteavalduse avaliku kättetoimetamise võib korraldada kohtu määruse alusel, kui muul viisil ei ole ilmselt võimalik tahteavaldust edastada ja kui tahteavaldus tuleb edastada avalikkusele või teadmata isikule.",
      "rdfs:label": {
        "@value": "TMS_Par_214 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 214",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_215_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_215"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtutäituri tasu tahteavalduse edastamise eest sätestatakse kohtutäituri seaduses.",
      "rdfs:label": {
        "@value": "TMS_Par_215 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 215",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_216_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) . Akti üks eksemplar väljastatakse dokumendi saatjale ja see tõendab dokumendi edastamist. (2) Kättetoimetamisteatises ja -aktis märgitakse muu hulgas selle isiku nimi, kelle avalduse alusel dokument kätte toimetati.",
      "rdfs:label": {
        "@value": "TMS_Par_216 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_216_v13335451"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 216",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_216_v13335451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtutäitur koostab dokumendi kättetoimetamise kohta akti vormis. Akti üks eksemplar väljastatakse dokumendi saatjale ja see tõendab dokumendi edastamist. (2) Kättetoimetamisteatises ja -aktis märgitakse muu hulgas selle isiku nimi, kelle avalduse alusel dokument kätte toimetati.",
      "rdfs:label": {
        "@value": "TMS_Par_216 (redaktsioon 13335451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335451",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_216_v113032014105"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13335451",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 216",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_216_v113032014105",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_216"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtutäitur koostab dokumendi kättetoimetamise kohta akti vormis. Akti üks eksemplar väljastatakse dokumendi saatjale ja see tõendab dokumendi edastamist. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"justiitsministri\" sõnadega \"valdkonna eest vastutava ministri\". (2) Kättetoimetamisteatises ja -aktis märgitakse muu hulgas selle isiku nimi, kelle avalduse alusel dokument kätte toimetati.",
      "rdfs:label": {
        "@value": "TMS_Par_216 (redaktsioon 113032014105)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014105",
      "estleg:supersededByVersion": {
