    },
    {
      "@id": "estleg:TMS_Par_122_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlgnikule kuuluva vallasasja valduse või omandiõiguse üleandmise nõude arestimise puhul tuleb asi välja anda kohtutäiturile. (2) Asja väljaandmisega kohtutäiturile tekib sissenõudja kasuks arestipandiõigus asjale. (3) Kui vallasasja valduse või omandiõiguse üleandmise nõue on arestitud mitme sissenõudja kasuks, on võlgniku suhtes kohustatud kolmandal isikul õigus asi kohtutäiturile välja anda. Iga sissenõudja nõudel, kelle kasuks nõue on arestitud, peab kolmas isik asja kohtutäiturile välja andma. (4) Väljaantud asja müügile ja müügist saadud tulemi jaotamisele kohaldatakse arestitud asja müügi kohta kehtivaid sätteid.",
      "rdfs:label": {
        "@value": "TMS_Par_122 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_122_v992311"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 122",
      "estleg:partOfAct": {
