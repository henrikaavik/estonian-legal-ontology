        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_185"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui võlgnikku on kohustatud omandi üleandmiseks või vallasasjale õiguse seadmiseks, loetakse asja üleandmine toimunuks, kui kohtutäitur asja sissenõudjale andmise eesmärgil ära võtab. Asi loetakse üleantuks tehingu alusel.",
      "rdfs:label": {
        "@value": "TMS_Par_185 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 185",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_186_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_186"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kohtulahendiga on ette nähtud rahaline hüvitis kohustuse rikkumise eest, kuid kostja kohtulahendit ei täida, võib sissenõudja täitemenetluses nõuda üksnes rahalise hüvitise maksmist. (2) Käesolevas osas sätestatu ei välista ega piira sissenõudja õigust nõuda võlgnikult täitedokumendi täitmata jätmisega tekitatud kahju hüvitamist.",
      "rdfs:label": {
        "@value": "TMS_Par_186 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 186",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_186_1_v131122024049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_186_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kohustatud isik takistab rikkumise lõpetamise või edasise rikkumise keelamise kohta tehtud kollektiivse esindushagi asjas tehtud kohtulahendi, sealhulgas esialgse õiguskaitse kohaldamise kohta tehtud kohtulahendi sundtäitmist, teeb kohtutäitur sissenõudja avalduse alusel kohtule ettepaneku kohustatud isiku trahvimiseks. (2) Hagita menetluses on avaldajaks pädev üksus või tarbija või andmesubjekt, kui teda ei esinda täitemenetluses pädev üksus, ja puudutatud isik, kelle rikkumisest tulenevalt kollektiivne esindushagi esitati. (3) Kohustatud isikule võib trahvi määrata üksnes siis, kui talle on tehtud trahvihoiatus, välja arvatud juhul, kui eelnev hoiatamine ei olnud võimalik või mõistlik. (4) Trahvisumma määramisel lähtutakse tsiviilkohtumenetluse seadustiku §-st 49722. (5) Kohustuse rikkumise eest isikule määratud trahv ei vabasta teda kohustuse täitmisest. Kui kohustust pärast trahvi määramist ei täideta, võib määrata uue trahvi. (6) Trahv nõutakse sisse riigieelarvesse.",
      "rdfs:label": {
        "@value": "TMS_Par_186_1 (redaktsioon 131122024049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122024049",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122024049",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 186_1",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_187_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_187"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sissenõudja võib esitada hagi võlgniku ja tehingu teise poole vastu ning nõuda, et kohus tunnistaks käesolevas osas sätestatud alusel ja korras kehtetuks tehingu, mis kahjustab sissenõudjate huvisid (edaspidi tagasivõitmine ). Tehinguks loetakse käesoleva osa tähenduses ka eseme käsutamist täitemenetluses. (2) Sissenõudja võib tagasivõitmist nõuda, kui tal on täitedokument ja tema nõue on muutunud sissenõutavaks ning sissenõude pööramisega võlgniku varale ei ole kaasnenud tema nõude täielikku rahuldamist või on alust eeldada, et sissenõude pööramine ei vii nõude rahuldamiseni.",
      "rdfs:label": {
        "@value": "TMS_Par_187 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_187_v992311"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 187",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_187_v992311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_187"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sissenõudja võib esitada hagi võlgniku ja tehingu teise poole vastu ning nõuda, et kohus tunnistaks käesolevas osas sätestatud alusel ja korras kehtetuks tehingu, mis kahjustab sissenõudjate huvisid (edaspidi tagasivõitmine ). Tehinguks loetakse käesoleva osa tähenduses ka eseme käsutamist täitemenetluses. (2) Sissenõudja võib tagasivõitmist nõuda, kui tal on täitedokument ja tema nõue on muutunud sissenõutavaks ning sissenõude pööramisega võlgniku varale ei ole kaasnenud tema nõude täielikku rahuldamist või on alust eeldada, et sissenõude pööramine ei vii nõude rahuldamiseni.",
      "rdfs:label": {
        "@value": "TMS_Par_187 (redaktsioon 992311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992311",
