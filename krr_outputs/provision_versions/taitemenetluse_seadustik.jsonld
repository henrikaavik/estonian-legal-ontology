      }
    },
    {
      "@id": "estleg:TMS_Par_63_1_v123032017011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_63_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline arestimissüsteem on täitemenetlusregistri, maksukohustuslaste registri ja krediidiasutuse infosüsteemi vahel loodud infokanal, mille eesmärk on tagada võlgniku konto arestimise ja arestide haldamisega seotud toimingute kohta elektrooniliselt taotluse edastamine krediidiasutusele, võimaldada päringute tegemist krediidiasutuse valduses olevate andmete kohta ning tagada osapoolte tahteavalduste viivitamatu ja turvaline edastamine. (2) Elektroonilise arestimissüsteemi asutab ja selle põhimääruse kehtestab (3) Elektroonilise arestimissüsteemi vastutav töötleja on Justiitsministeerium. Elektroonilise arestimissüsteemi volitatud töötleja on valdkonna eest vastutava ministri poolt määratud isik. (4) kehtestab määrusega konto avamise elektroonilise kontrollimise korra ja tehnilised nõuded ning elektroonilise arestimissüsteemi andmetöötluse ja andmete väljastamise korra.",
      "rdfs:label": {
        "@value": "TMS_Par_63_1 (redaktsioon 123032017011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032017011",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_63_1_v130122017019"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123032017011",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 63_1",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_63_1_v130122017019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_63_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline arestimissüsteem on täitemenetlusregistri, maksukohustuslaste registri ja krediidiasutuse infosüsteemi vahel loodud infokanal, mille eesmärk on tagada võlgniku konto arestimise ja arestide haldamisega seotud toimingute kohta elektrooniliselt taotluse edastamine krediidiasutusele, võimaldada päringute tegemist krediidiasutuse valduses olevate andmete kohta ning tagada osapoolte tahteavalduste viivitamatu ja turvaline edastamine. (1¹) Valitsusasutus ja selle valitsemisalasse kuuluv asutus, kes vajab elektroonilise arestimissüsteemi kasutamist seadusest tuleneva ülesande täitmiseks, võib süsteemiga liituda juhul, kui selleks on olemas tehniline võimekus. (2) Elektroonilise arestimissüsteemi asutab ja selle põhimääruse kehtestab (3) Elektroonilise arestimissüsteemi vastutav töötleja on Justiitsministeerium. Elektroonilise arestimissüsteemi volitatud töötleja on valdkonna eest vastutava ministri poolt määratud isik. (4) kehtestab määrusega konto avamise elektroonilise kontrollimise korra ja tehnilised nõuded ning elektroonilise arestimissüsteemi andmetöötluse ja andmete väljastamise korra.",
      "rdfs:label": {
        "@value": "TMS_Par_63_1 (redaktsioon 130122017019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017019",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_63_1_v106072023106"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122017019",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 63_1",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
