    {
      "@id": "estleg:TMS_Par_211_v131122014014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_211"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalasjas kohaldatud rahalise karistuse, varalise karistuse, kriminaalmenetluse kulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra, halduskohtumenetluses kohtuotsuse või määrusega kohaldatud rahatrahvi, menetluskulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra ning väärteoasjas kohaldatud rahatrahvi, hoiatustrahvi, menetluskulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra kehtestab",
      "rdfs:label": {
        "@value": "TMS_Par_211 (redaktsioon 131122014014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122014014",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122014014",
