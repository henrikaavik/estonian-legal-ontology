      }
    },
    {
      "@id": "estleg:TMS_Par_174_v108072016036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_174"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtutäitur jaotab kinnisasja müügist ja sundvalitsemisest saadud tulemi sissenõudjate ja muude tulemi jaotamises osalema õigustatud isikute vahel õiguste kinnistusraamatust nähtuvate järjekohtade alusel ja arestimise järjekorras või sissenõudjate kokkuleppe alusel. Ühel ajal toimunud arestimisega saavad sissenõudjad tulemi jaotamisel sama järjekoha. (2) Täitekulud arvatakse jaotuskava kohaselt jagatavast tulemist maha. (3) Nõuded rahuldatakse tulemist ja neid arvestatakse jaotuskavas järgmises järjekorras, sama järjekoha puhul võrdeliselt nõuete summadega: sundenampakkumisele eelneva sundvalitsemise korral sissenõudja nõue ettemaksuna kinnisasja korrashoiuks ja vajalikeks parendusteks tehtud kulutuste hüvitamiseks, kui kulutusi ei saa katta kinnisasjast saadud kasu arvelt; kinnistusraamatusse kantud õigustest tulenevad nõuded vastavalt õiguse järjekohale kinnistusraamatus ja nende kõrvalnõuded seaduses sätestatud ulatuses; kehtetu - sissenõudjate nõuded, mille tagamiseks on toimunud kinnisasja arestimine või on ühinetud sundtäitmisega ja mida ei rahuldata käesoleva lõike punktide 1–21 kohaselt; ülejäänud nõuded. (4) Käesoleva paragrahvi lõike 3 punktis 3 nimetatud nõuete puhul on mitme sissenõudja korral eesõigus sellel, kelle kasuks toimus arestimine varem või kes ühines sundtäitmisega.",
      "rdfs:label": {
        "@value": "TMS_Par_174 (redaktsioon 108072016036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072016036",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_174_v122122020048"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072016036",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 174",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_174_v122122020048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
