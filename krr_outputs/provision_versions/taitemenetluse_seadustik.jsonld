      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "TMS_Par_79 (redaktsioon 13335451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335451",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13335451",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 79",
      "estleg:partOfAct": {
