      "estleg:provisionRef": "TMS § 34",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_34_v113032014105",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
