      }
    },
    {
      "@id": "estleg:TMS_Par_30_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puhkepäeval, riigipühal ja öisel ajal kella 22-st kuni kella 6-ni tehakse täitetoiminguid ainult edasilükkamatutel asjaoludel.",
      "rdfs:label": {
        "@value": "TMS_Par_30 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
