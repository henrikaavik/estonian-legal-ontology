      "estleg:provisionRef": "TMS § 208",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_209_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_209"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuotsuse või -määrusega või kohtuvälise menetleja otsuse või määrusega kohaldatud väärteomenetluse kulude ja muude avalik-õiguslike rahaliste sissenõuete täitmisele kohaldatakse käesoleva seadustiku § 199 lõigetes 2–4, § 200 lõikes 1 ning §-des 202 ja 203 sätestatut.",
      "rdfs:label": {
        "@value": "TMS_Par_209 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 209",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_21_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui täitedokumendi täitmine sõltub sissenõudja kohustuse samaaegsest täitmisest võlgnikule, ei või kohtutäitur täitemenetlust alustada enne, kui sissenõudja kohustus on täidetud või kui sissenõudja või kohtutäitur on võlgnikule pakkunud sissenõudja kohustuse täitmist ja võlgnik on alusetult keeldunud täitmist vastu võtmast või muul põhjusel täitmise vastuvõtmisega viivitanud. (2) Käesoleva paragrahvi lõikes 1 nimetatud pakkumist ei ole vaja teha, kui sissenõudja esitab kirjaliku dokumendi selle kohta, et sissenõudja kohustus on täidetud või et võlgnik täitmise vastuvõtmisega viivitab, ja dokumendi ärakiri on võlgnikule edastatud või edastatakse koos täitmisteatega.",
      "rdfs:label": {
        "@value": "TMS_Par_21 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 21",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_210_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuotsuse või -määrusega kohaldatud kriminaalmenetluse kulude ja kriminaalasjas muude avalik-õiguslike rahaliste sissenõuete täitmisele kohaldatakse käesoleva seadustiku § 204 lõikes 2, § 205 lõikes 1 ning §-des 207 ja 208 sätestatut.",
      "rdfs:label": {
        "@value": "TMS_Par_210 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 210",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_211_v13335451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_211"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalasjas kohaldatud rahalise karistuse, varalise karistuse, kriminaalmenetluse kulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra, halduskohtumenetluses kohtuotsuse või määrusega kohaldatud rahatrahvi, menetluskulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra ning väärteoasjas kohaldatud rahatrahvi, hoiatustrahvi, menetluskulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra",
      "rdfs:label": {
        "@value": "TMS_Par_211 (redaktsioon 13335451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335451",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_211_v113032014105"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13335451",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 211",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_211_v113032014105",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_211"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalasjas kohaldatud rahalise karistuse, varalise karistuse, kriminaalmenetluse kulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra, halduskohtumenetluses kohtuotsuse või määrusega kohaldatud rahatrahvi, menetluskulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra ning väärteoasjas kohaldatud rahatrahvi, hoiatustrahvi, menetluskulude ja muude avalik-õiguslike rahaliste sissenõuete riigieelarvesse laekumise korra , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"rahandusminister\" sõnadega \"valdkonna eest vastutav minister\".",
