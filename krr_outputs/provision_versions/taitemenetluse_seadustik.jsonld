      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22259",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 180",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_180_v181346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_180"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kahju, mis on isikule tekitatud alusetult süüdimõistmise, kriminaalvastutusele võtmise, vahi all pidamise või väärteokaristuse kohaldamisega, hüvitatakse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "TMS_Par_180 (redaktsioon 181346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "181346",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_180_v898126"
      },
      "estleg:versionValidTo": {
