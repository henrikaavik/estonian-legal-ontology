      }
    },
    {
      "@id": "estleg:TMS_Par_8_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtutäitur on kohustatud tarvitusele võtma kõik seadusega lubatud abinõud täitedokumendi täitmiseks, koguma täitemenetluseks vajalikku teavet ning selgitama täitemenetluse osalistele nende õigusi ja kohustusi.",
      "rdfs:label": {
        "@value": "TMS_Par_8 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_8_v13260763"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_8_v13260763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtutäitur on kohustatud viivitamata tarvitusele võtma kõik seadusega lubatud abinõud täitedokumendi täitmiseks, koguma täitemenetluseks vajalikku teavet ning selgitama täitemenetluse osalistele nende õigusi ja kohustusi.",
      "rdfs:label": {
        "@value": "TMS_Par_8 (redaktsioon 13260763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260763",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_8_v130122017019"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260763",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_8_v130122017019",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtutäitur on kohustatud viivitamata tarvitusele võtma kõik seadusega lubatud abinõud täitedokumendi täitmiseks, koguma täitemenetluseks vajalikku teavet ning selgitama täitemenetluse osalistele nende õigusi ja kohustusi. (2) Kohtutäitur täidab rahalisi nõudeid, välja arvatud lapse elatisnõuded, nende täitmisele esitamise järjekorras.",
      "rdfs:label": {
        "@value": "TMS_Par_8 (redaktsioon 130122017019)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017019",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122017019",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_80_v22259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahatrahvi määratud tähtajaks mittetasumisel või trahvi osalisel tasumisel pöörab kohtutäitur sissenõude võlgniku varale käesoleva seadustiku §-des 49-64 sätestatud korras.",
      "rdfs:label": {
        "@value": "TMS_Par_80 (redaktsioon 22259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22259",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_80_v898126"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22259",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 80",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_80_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enampakkumise aja määrab kohtutäitur. (2) Kohtutäitur ei või enampakkumist korraldada enne kümne päeva möödumist asja arestimisest, kui sissenõudja ja võlgnik ei lepi kokku varasemas ajas. (3) Kohtutäitur võib enampakkumise korraldada enne kümne päeva möödumist arestimisest, kui tähtaja järgimisel väheneks enampakkumisele pandava asja väärtus ilmselt oluliselt või kui asja hoidmisega kaasnevad ebamõistlikult suured hoiukulud.",
      "rdfs:label": {
        "@value": "TMS_Par_80 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 80",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_81_v22259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erikonfiskeerimise otsus täidetakse käesoleva seadustiku §-s 72 sätestatud korras.",
      "rdfs:label": {
        "@value": "TMS_Par_81 (redaktsioon 22259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22259",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_81_v898126"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22259",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_81_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enampakkumise koha määrab kohtutäitur, arvestades asja müümise võimalusi ja enampakkumise kulusid.",
      "rdfs:label": {
        "@value": "TMS_Par_81 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_81_v13260763"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_81_v13260763",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline enampakkumine toimub veebikeskkonnas avanevas elektroonilises oksjonikeskkonnas (edaspidi oksjonikeskkond ). (2) Kui kohtutäitur korraldab avaliku suulise enampakkumise, määrab ta suulise enampakkumise koha, arvestades asja müümise võimalusi ja enampakkumise kulusid.",
      "rdfs:label": {
        "@value": "TMS_Par_81 (redaktsioon 13260763)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260763",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_81_v13335451"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260763",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_81_v13335451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrooniline enampakkumine toimub veebikeskkonnas avanevas elektroonilises oksjonikeskkonnas (edaspidi oksjonikeskkond). (2) Kui kohtutäitur korraldab avaliku suulise enampakkumise, määrab ta suulise enampakkumise koha, arvestades asja müümise võimalusi ja enampakkumise kulusid.",
      "rdfs:label": {
        "@value": "TMS_Par_81 (redaktsioon 13335451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335451",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13335451",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 81",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_82_v22259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eriõiguste äravõtmise otsus kuulub täitmisele kohtutäituri vahenduseta. (2) Otsuse mittetäitmise eest kannab süüdlane kriminaalvastutust.",
      "rdfs:label": {
        "@value": "TMS_Par_82 (redaktsioon 22259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22259",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_82_v898126"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22259",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_82_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asja alghind enampakkumisel on hindamise tulemusena saadud ja arestimisakti märgitud hind. (2) Kohtutäituril on õigus muuta alghinda pärast enampakkumise kuulutuse ilmumist esitatud õiguste avaldamise ja põhistamise alusel, kui arestimisaktis märgitud hind ilmselt erineb turuhinnast. Alghinna määramisel ei arvestata õigust, millest pärast enampakkumise kuulutuse avaldamist ei teatata või mida ei põhistata. (3) Enne alghinna muutmist küsib kohtutäitur sissenõudja ja võlgniku seisukohta selle suhtes.",
      "rdfs:label": {
        "@value": "TMS_Par_82 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 82",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_83_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enampakkumisel osaleda sooviv isik peab tasuma tagatisraha, mille suurus on 10 protsenti alghinnast. (2) Tagatisraha võib maksta kohtutäituri määratud kontole enne enampakkumise päeva või tasuda enampakkumise päeval enne konkreetse pakkumise tegemist sularahas, maksekaardiga või elektroonilise rahavahendiga või muu raha kohest laekumist kontrollida võimaldava vahendi abil. (3) Kohtutäitur võib tagatisrahana aktsepteerida ka tagatisraha suuruses antud Eesti või muu Euroopa Liidu liikmesriigi krediidiasutuse tähtajatut, tagasivõtmatut ja tingimusteta maksegarantiid. (4) Tagatisraha ei pea maksma: riik ja kohaliku omavalitsuse üksus ning Eesti Pank; sissenõudja ja pandipidaja, kui nende nõue katab nõutava tagatisraha. (5) Ostja makstud tagatisraha arvatakse ostuhinna sisse, teistele enampakkumisest osavõtnutele tagastatakse see enampakkumise päevale järgneval tööpäeval.",
      "rdfs:label": {
        "@value": "TMS_Par_83 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_83_v992311"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 83",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_83_v992311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enampakkumisel osaleda sooviv isik peab tasuma tagatisraha, mille suurus on 10 protsenti alghinnast. (2) Tagatisraha võib maksta kohtutäituri määratud kontole enne enampakkumise päeva või tasuda enampakkumise päeval enne konkreetse pakkumise tegemist sularahas või elektroonilise rahavahendiga või muu raha kohest laekumist kontrollida võimaldava vahendi abil. Sularahas võib tagatisraha tasuda, kui tagatisraha suurus ei ületa 10 000 krooni. (3) Kohtutäitur võib tagatisrahana aktsepteerida ka tagatisraha suuruses antud Eesti või muu Euroopa Liidu liikmesriigi krediidiasutuse tähtajatut, tagasivõtmatut ja tingimusteta maksegarantiid. (4) Tagatisraha ei pea maksma: riik ja kohaliku omavalitsuse üksus ning Eesti Pank; sissenõudja ja pandipidaja, kui nende nõue katab nõutava tagatisraha. (5) Ostja makstud tagatisraha arvatakse ostuhinna sisse, teistele enampakkumisest osavõtnutele tagastatakse see enampakkumise päevale järgneval tööpäeval.",
      "rdfs:label": {
        "@value": "TMS_Par_83 (redaktsioon 992311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992311",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_83_v12769829"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
