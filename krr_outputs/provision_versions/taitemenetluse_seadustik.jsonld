      },
      "estleg:versionRedactionId": "112032015087",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_174_v108072016036"
      },
      "estleg:versionValidTo": {
        "@value": "2016-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015087",
