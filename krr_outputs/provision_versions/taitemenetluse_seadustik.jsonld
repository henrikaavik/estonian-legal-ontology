tutäitur selle alusel täitemenetluse ja järgib käesoleva paragrahvi 4. lõikes sätestatut. Võlgnik võib esitada vastuväite 4. lõikes ettenähtud korras. Täitemenetluse algatamisele ei kohaldata 2.-3. lõikes sätestatut. [14. 04. 2003. a Riigikohtu põhiseaduslikkuse järelevalve kolleegiumi kohtuotsus nr 3-4-1-4-03 - - jõust. 14. 04. 2003]",
      "rdfs:label": {
        "@value": "TMS_Par_23 (redaktsioon 179966)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179966",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_23_v181346"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/179966",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 23",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_23_v181346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_23"
