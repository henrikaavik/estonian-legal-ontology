      },
      "estleg:versionValidFrom": {
        "@value": "2021-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koda peab kohtutäiturite tööks vajalikku infosüsteemi, mis võimaldab digitaalset andmevahetust teiste andmekogudega.",
      "rdfs:label": {
        "@value": "TMS_Par_63_2 (redaktsioon 109042021003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109042021003",
