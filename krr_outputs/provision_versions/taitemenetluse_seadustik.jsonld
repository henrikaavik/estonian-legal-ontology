    {
      "@id": "estleg:TMS_Par_43_v109042021003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_43"
      },
      "estleg:versionValidFrom": {
