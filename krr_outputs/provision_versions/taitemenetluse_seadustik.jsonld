    {
      "@id": "estleg:TMS_Par_90_v13335451",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Suulist enampakkumist jätkatakse kuni kohtutäituri pakkumiste esitamise ettepaneku peale ei esitata enam ühtegi ülepakkumist. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "TMS_Par_90 (redaktsioon 13335451)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13335451",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13335451",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 90",
