      }
    },
    {
      "@id": "estleg:TMS_Par_31_v22259",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täitmisele kuuluva täitedokumendi ebaselguse korral on kohtutäitur kohustatud selgituse saamiseks pöörduma täitedokumendi teinud organi (ametiisiku) poole. Täitedokumendi selgitamine toimub seadusega sätestatud korras.",
      "rdfs:label": {
        "@value": "TMS_Par_31 (redaktsioon 22259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22259",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_31_v898126"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22259",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_31_v898126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TMS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vangla kannab kinnipeetava töötasust või muust kinnipeetavale laekuvast rahast kinnipeetud osa igas kuus selle kohtutäituri ametialasele arvelduskontole, kes on rahalise nõude täitmiseks saatnud. Kinnipeetav osa arvutatakse vastavalt vangistusseaduse (RT I 2000, 58, 376; 2002, 84, 492; 90, 521; 2003, 4, 20; 20, 116; 26, 157; 58, 387; 78, 524) §-le 44. (2) Kinnipeetavalt kinnipeetud raha jaotamiseks koostab kohtutäitur arvestuse ja kannab raha sissenõudjale üle.",
      "rdfs:label": {
        "@value": "TMS_Par_31 (redaktsioon 898126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "898126",
      "estleg:supersededByVersion": {
        "@id": "estleg:TMS_Par_31_v992311"
      },
      "estleg:versionValidTo": {
        "@value": "2006-02-03",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/898126",
      "estleg:sourceAct": "Täitemenetluse seadustik",
      "estleg:provisionRef": "TMS § 31",
      "estleg:partOfAct": {
        "@id": "estleg:TMS_Map_2026"
      }
    },
    {
      "@id": "estleg:TMS_Par_31_v992311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
