      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kindlustusandja ja teise lepinguriigi kindlustusandja Eesti filiaali kindlustusmaksete, nõuete ning kulude aruande sisu, vorm ja esitamise kord (6 versiooni)",
        "@language": "et"
