    {
      "@id": "estleg:Reg_1058175_Par_3_v1058175",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058175_Par_3"
