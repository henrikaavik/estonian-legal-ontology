      "dc:source": "Kindlustusandja ja teise lepinguriigi kindlustusandja Eesti filiaali kindlustusmaksete, nõuete ning kulude aruande sisu, vorm ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_1058175_Par_1_v1058175",
