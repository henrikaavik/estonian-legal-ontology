      "estleg:versionValidFrom": {
        "@value": "2024-01-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruandeperiood on ajavahemik majandusaasta algusest kuni aruandekuupäevani. Aruandeperiood on ajavahemik majandusaasta algusest kuni aruandekuupäevani. 2 (2) Aruandekuupäevad on 31. märts, 30. juuni, 30. september ja 31. detsember. Aruandekuupäevad on 31. märts, 30. juuni, 30. september ja 31. detsember.",
      "rdfs:label": {
        "@value": "Reg_1058175_Par_3 (redaktsioon 1058175)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058175",
