    {
      "@id": "estleg:Reg_1037786_Par_6_v1037786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037786_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sularaha võetakse arvesse selle nominaalväärtuses. Sularaha võetakse arvesse selle nominaalväärtuses. 2 (2) Hoiused võetakse arvesse nende nominaalväärtuses, millele lisatakse hindamispäeva seisuga arvutatud tekkepõhine intress. Hoiused võetakse arvesse nende nominaalväärtuses, millele lisatakse hindamispäeva seisuga arvutatud tekkepõhine intress.",
      "rdfs:label": {
        "@value": "Reg_1037786_Par_6 (redaktsioon 1037786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037786",
      "estleg:sourceAct": "Investeerimisfondi vara puhasväärtuse määramise kord",
      "estleg:provisionRef": "Reg_1037786 § 6",
