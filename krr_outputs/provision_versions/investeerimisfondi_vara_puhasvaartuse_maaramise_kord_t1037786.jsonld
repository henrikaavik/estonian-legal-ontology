      }
    },
    {
      "@id": "estleg:Reg_1037786_Par_11_v1037786",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037786_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 6–10 nimetamata varade väärtuse määramisel võetakse aluseks nende õiglane väärtus. Kui see pole võimalik või asjakohane, siis võib kasutada teisi üldtunnustatud meetodeid, lähtudes eelkõige IFRS-s sätestatud hindamismeetoditest. Paragrahvides 6–10 nimetamata varade väärtuse määramisel võetakse aluseks nende õiglane väärtus. Kui see pole võimalik või asjakohane, siis võib kasutada teisi üldtunnustatud meetodeid, lähtudes eelkõige IFRS-s sätestatud hindamismeetoditest.",
