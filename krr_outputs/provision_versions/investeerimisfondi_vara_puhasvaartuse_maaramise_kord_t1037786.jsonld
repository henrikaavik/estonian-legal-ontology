        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse avaliku lepingulise investeerimisfondi ja aktsiaseltsina asutatud investeerimisfondi (edaspidi fond) vara puhasväärtuse määramise kord. Käesoleva määrusega kehtestatakse avaliku lepingulise investeerimisfondi ja aktsiaseltsina asutatud investeerimisfondi (edaspidi fond) vara puhasväärtuse määramise kord.",
      "rdfs:label": {
        "@value": "Reg_1037786_Par_1 (redaktsioon 1037786)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037786",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037786",
      "estleg:sourceAct": "Investeerimisfondi vara puhasväärtuse määramise kord",
      "estleg:provisionRef": "Reg_1037786 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037786_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037786_Par_10_v1037786",
      "@type": [
