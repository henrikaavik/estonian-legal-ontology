  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_aktsiisi_tagatissumma_maaramise_alused_ja_tagatissumma_minim_t345357_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad"
    },
    {
      "@id": "estleg:Reg_345357_Par_1_v345357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345357_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aktsiisi maksmise tagatissumma määramisel võtab maksuhaldur arvesse järgmist: 1 1) tekkida võiva või tekkinud maksukohustuse suurus ja selle arvutamise aluseks olevad andmed; 2 2) aktsiisikauba liik, millelt tagatissumma määratakse; 3 3) eksporditava aktsiisikauba ning õhusõiduki ja laeva pardale toimetatava aktsiisivabastuses oleva aktsiisikauba osatähtsus aktsiisilaos ladustatava aktsiisikauba koguses 12 kalendrikuu jooksul; 4 4) aktsiisiga maksustamata aktsiisikauba säilimise turvalisus tagatise esitaja tegevuskohas, kus ladustatakse ja kasutatakse aktsiisiga maksustamata aktsiisikaupa; 5 5) maksevõimelisus ja maksude tasumise tähtajast kinnipidamine; 6 6) maksuseaduste ja tollieeskirjade rikkumise juhtumid; 7 7) varasem aktsiisikauba tootmise ja ladustamise kogemus või aktsiisivabastuses oleva aktsiisikauba kasutamise kogemus; 8 8) äripartnerid ja aktsiisikaupa vedavad ettevõtjad. Aktsiisi maksmise tagatissumma määramisel võtab maksuhaldur arvesse järgmist: tekkida võiva või tekkinud maksukohustuse suurus ja selle arvutamise aluseks olevad andmed; aktsiisikauba liik, millelt tagatissumma määratakse; eksporditava aktsiisikauba ning õhusõiduki ja laeva pardale toimetatava aktsiisivabastuses oleva aktsiisikauba osatähtsus aktsiisilaos ladustatava aktsiisikauba koguses 12 kalendrikuu jooksul; aktsiisiga maksustamata aktsiisikauba säilimise turvalisus tagatise esitaja tegevuskohas, kus ladustatakse ja kasutatakse aktsiisiga maksustamata aktsiisikaupa; maksevõimelisus ja maksude tasumise tähtajast kinnipidamine; maksuseaduste ja tollieeskirjade rikkumise juhtumid; varasem aktsiisikauba tootmise ja ladustamise kogemus või aktsiisivabastuses oleva aktsiisikauba kasutamise kogemus; äripartnerid ja aktsiisikaupa vedavad ettevõtjad.",
      "rdfs:label": {
        "@value": "Reg_345357_Par_1 (redaktsioon 345357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345357",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345357",
      "estleg:sourceAct": "Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad",
      "estleg:provisionRef": "Reg_345357 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345357_Map"
      }
    },
    {
      "@id": "estleg:Reg_345357_Par_2_v345357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345357_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tagatissumma määramisel tekkida võivast või tekkinud maksukohustuse suurusest väiksemana arvestatakse aktsiisi maksmata jätmise riski käesoleva määruse §-s 1 nimetatud andmete alusel. Tagatissumma määramisel tekkida võivast või tekkinud maksukohustuse suurusest väiksemana arvestatakse aktsiisi maksmata jätmise riski käesoleva määruse §-s 1 nimetatud andmete alusel. 2 (2) Tagatissumma peab moodustama vähemalt ühe protsendi tekkida võivast või tekkinud maksukohustuse suurusest. Tagatissumma peab moodustama vähemalt ühe protsendi tekkida võivast või tekkinud maksukohustuse suurusest. 3 (3) Registreeritud kaubasaatja, juhuti aktsiisikaupa vastu võtva registreeritud kaubasaaja ja sertifitseeritud kaubasaaja puhul määrab maksuhaldur tagatissummaks summa, mis on tekkida võiva maksukohustuse suurusega võrdne. RT I 2023-02-10 37 110022023037 2023-02-13 Registreeritud kaubasaatja, juhuti aktsiisikaupa vastu võtva registreeritud kaubasaaja ja sertifitseeritud kaubasaaja puhul määrab maksuhaldur tagatissummaks summa, mis on tekkida võiva maksukohustuse suurusega võrdne.",
      "rdfs:label": {
        "@value": "Reg_345357_Par_2 (redaktsioon 345357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345357",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345357",
      "estleg:sourceAct": "Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad",
      "estleg:provisionRef": "Reg_345357 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345357_Map"
      }
    },
    {
      "@id": "estleg:Reg_345357_Par_3_v345357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345357_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maksuhaldur võib määrata tagatissummast, mis määrati tekkida võivast või tekkinud maksukohustuse suurusest väiksemana, suurema tagatissumma, kui: 1 1) tagatise esitaja on rikkunud «Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadust», mille tulemusena jäi aktsiis osaliselt või täies ulatuses tähtaegselt maksmata, või kui ta kasutas aktsiisivabastuses olevat aktsiisikaupa mitte-eesmärgipäraselt; 2 2) tegelike andmete alusel on tekkida võiv või tekkinud maksukohustuse suurus olnud kolme järjestikuse kalendrikuu jooksul vähemalt kümme protsenti suurem tagatissumma määramiseks maksuhaldurile esitatud tekkida võivast või tekkinud maksukohustuse suurusest; 3 3) aktsiisi maksmata jätmise risk on suurenenud; 4 4) andmed ladustatava aktsiisikauba koguse suurendamise kohta on esitatud või muudel «Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduses» sätestatud juhtudel. Maksuhaldur võib määrata tagatissummast, mis määrati tekkida võivast või tekkinud maksukohustuse suurusest väiksemana, suurema tagatissumma, kui: tagatise esitaja on rikkunud «Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seadust», mille tulemusena jäi aktsiis osaliselt või täies ulatuses tähtaegselt maksmata, või kui ta kasutas aktsiisivabastuses olevat aktsiisikaupa mitte-eesmärgipäraselt; tegelike andmete alusel on tekkida võiv või tekkinud maksukohustuse suurus olnud kolme järjestikuse kalendrikuu jooksul vähemalt kümme protsenti suurem tagatissumma määramiseks maksuhaldurile esitatud tekkida võivast või tekkinud maksukohustuse suurusest; aktsiisi maksmata jätmise risk on suurenenud; andmed ladustatava aktsiisikauba koguse suurendamise kohta on esitatud või muudel «Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduses» sätestatud juhtudel. 2 (2) Tagatissumma suurendamise korral võib maksuhaldur nõuda uue tekkida võiva või tekkinud maksukohustuse suuruse arvutuse esitamist. Tagatissumma suurendamise korral võib maksuhaldur nõuda uue tekkida võiva või tekkinud maksukohustuse suuruse arvutuse esitamist.",
      "rdfs:label": {
        "@value": "Reg_345357_Par_3 (redaktsioon 345357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345357",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345357",
      "estleg:sourceAct": "Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad",
      "estleg:provisionRef": "Reg_345357 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345357_Map"
      }
    },
    {
      "@id": "estleg:Reg_345357_Par_4_v345357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345357_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tagatise esitaja kirjaliku taotluse alusel võib maksuhaldur määrata varem määratud tagatissummast väiksema tagatissumma, arvestades käesoleva määruse §-s 2 nimetatud nõudeid, kui tagatise esitajal ei ole olnud «Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse» rikkumisi taotluse esitamisele eelnenud 360 päeva jooksul. Tagatise esitaja kirjaliku taotluse alusel võib maksuhaldur määrata varem määratud tagatissummast väiksema tagatissumma, arvestades käesoleva määruse §-s 2 nimetatud nõudeid, kui tagatise esitajal ei ole olnud «Alkoholi-, tubaka-, kütuse- ja elektriaktsiisi seaduse» rikkumisi taotluse esitamisele eelnenud 360 päeva jooksul.",
      "rdfs:label": {
        "@value": "Reg_345357_Par_4 (redaktsioon 345357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345357",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345357",
      "estleg:sourceAct": "Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad",
      "estleg:provisionRef": "Reg_345357 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345357_Map"
      }
    },
    {
      "@id": "estleg:Reg_345357_Par_5_v345357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345357_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tagatise esitaja taotluses esitatud mõjuvatel põhjustel võib maksuhaldur määrata väiksema tagatissumma tagatise esitaja esitatud tekkida võiva või tekkinud maksukohustuse suuruse uue arvutuse alusel, arvestades käesoleva määruse §-des 1 ja 2 sätestatut. Tekkida võiva või tekkinud maksukohustuse suuruse arvutamise aluseks olevate tegelike andmete alusel saadud tulemust võib tagatise esitaja korrigeerida andmetega, mis tulenevad tagatissumma muutmise taotluses esitatud põhjustest. Tagatise esitaja taotluses esitatud mõjuvatel põhjustel võib maksuhaldur määrata väiksema tagatissumma tagatise esitaja esitatud tekkida võiva või tekkinud maksukohustuse suuruse uue arvutuse alusel, arvestades käesoleva määruse §-des 1 ja 2 sätestatut. Tekkida võiva või tekkinud maksukohustuse suuruse arvutamise aluseks olevate tegelike andmete alusel saadud tulemust võib tagatise esitaja korrigeerida andmetega, mis tulenevad tagatissumma muutmise taotluses esitatud põhjustest.",
      "rdfs:label": {
        "@value": "Reg_345357_Par_5 (redaktsioon 345357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345357",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345357",
      "estleg:sourceAct": "Aktsiisi tagatissumma määramise alused ja tagatissumma minimaalsed määrad",
      "estleg:provisionRef": "Reg_345357 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345357_Map"
      }
    },
