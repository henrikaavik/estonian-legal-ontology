      "estleg:provisionRef": "Reg_1046126 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046126_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046126_Par_3_v1046126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046126_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) SI tuletatud ühikud moodustatakse SI põhiühikutest vastava füüsikalise suuruse dimensiooniavaldise alusel põhiühikute astmete korrutisena arvteguriga üks. SI tuletatud ühikud moodustatakse SI põhiühikutest vastava füüsikalise suuruse dimensiooniavaldise alusel põhiühikute astmete korrutisena arvteguriga üks. 2 (2) SI tuletatud ühikutele antud erinimetused ja tähised on toodud lisa 2 tabelis 3. Lisaks SI põhiühikutele võib ka neid ühikuid kasutada tuletatud ühikute moodustamiseks lõikes 1 toodud reegli järgi. SI tuletatud ühikutele antud erinimetused ja tähised on toodud lisa 2 tabelis 3. Lisaks SI põhiühikutele võib ka neid ühikuid kasutada tuletatud ühikute moodustamiseks lõikes 1 toodud reegli järgi. 3 (3) Tuletatud ühikuid võib väljendada nii SI põhiühikute kui ka erinimetustega SI ühikute kaudu. Tuletatud ühikuid võib väljendada nii SI põhiühikute kui ka erinimetustega SI ühikute kaudu. 4 (4) Määruse lisades toodud ühikute kombineerimisel saadakse liitühikud. Määruse lisades toodud ühikute kombineerimisel saadakse liitühikud.",
      "rdfs:label": {
        "@value": "Reg_1046126_Par_3 (redaktsioon 1046126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046126",
