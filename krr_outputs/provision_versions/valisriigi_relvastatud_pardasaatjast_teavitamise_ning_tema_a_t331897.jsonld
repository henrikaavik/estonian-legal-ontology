      "dc:source": "Välisriigi relvastatud pardasaatjast teavitamise ning tema ametirelva ja selle laskemoona hoiuleandmise ja tagastamise kord"
    },
    {
      "@id": "estleg:Reg_331897_Par_1_v331897",
