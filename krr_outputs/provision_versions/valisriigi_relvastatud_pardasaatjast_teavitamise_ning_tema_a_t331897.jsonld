    {
      "@id": "estleg:Reg_331897_Par_2_v331897",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_331897_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-04-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saadud teatisest, millega Prümi lepingu osalise pädev asutus teavitab Politsei- ja Piirivalveametit välisriigi relvastatud pardasaatja määramisest õhusõidukisse, teavitab Politsei- ja Piirivalveamet viivitamata Kaitsepolitseiametit ning edastab talle teatise andmed. RT I 2022-04-21 1 121042022001 2022-04-24 Saadud teatisest, millega Prümi lepingu osalise pädev asutus teavitab Politsei- ja Piirivalveametit välisriigi relvastatud pardasaatja määramisest õhusõidukisse, teavitab Politsei- ja Piirivalveamet viivitamata Kaitsepolitseiametit ning edastab talle teatise andmed. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud teatise saamisest teavitab Politsei- ja Piirivalveamet Transpordiametit ning AS-i Tallinna Lennujaam. RT I 2022-04-21 1 121042022001 2022-04-24 Käesoleva paragrahvi lõikes 1 nimetatud teatise saamisest teavitab Politsei- ja Piirivalveamet Transpordiametit ning AS-i Tallinna Lennujaam.",
      "rdfs:label": {
        "@value": "Reg_331897_Par_2 (redaktsioon 331897)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "331897",
