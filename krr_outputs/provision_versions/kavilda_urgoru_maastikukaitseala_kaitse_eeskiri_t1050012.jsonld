      }
    },
    {
      "@id": "estleg:Reg_1050012_Par_11_v1050012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050012_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 27. märtsi 2019. a käskkirjaga nr 1-2/19/267 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 27. märtsi 2019. a käskkirjaga nr 1-2/19/267 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1050012_Par_11 (redaktsioon 1050012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050012",
      "estleg:sourceAct": "Kavilda ürgoru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1050012 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050012_Map"
      }
    },
    {
      "@id": "estleg:Reg_1050012_Par_12_v1050012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050012_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1050012_Par_12 (redaktsioon 1050012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050012",
