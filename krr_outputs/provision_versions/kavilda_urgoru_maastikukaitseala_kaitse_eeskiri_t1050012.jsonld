      "estleg:sourceAct": "Kavilda ürgoru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1050012 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050012_Map"
      }
    },
    {
      "@id": "estleg:Reg_1050012_Par_2_v1050012",
      "@type": [
        "owl:NamedIndividual",
