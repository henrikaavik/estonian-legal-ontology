      "estleg:versionValidFrom": {
        "@value": "2020-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tartu Rajooni TSN Täitevkomitee 9. septembri 1964. a otsuse nr 99 „Looduse kaitsest Tartu rajoonis” lisa nr 1 „Riikliku kaitse alla võetud kohaliku tähtsusega loodusobjektide loetelu” alajaotise I „Maastiku üksikelemendid” punkt 15, millega võeti kaitse alla Kavilda ürgorg, tunnistatakse kehtetuks. Tartu Rajooni TSN Täitevkomitee 9. septembri 1964. a otsuse nr 99 „Looduse kaitsest Tartu rajoonis” lisa nr 1 „Riikliku kaitse alla võetud kohaliku tähtsusega loodusobjektide loetelu” alajaotise I „Maastiku üksikelemendid” punkt 15, millega võeti kaitse alla Kavilda ürgorg, tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1050012_Par_10 (redaktsioon 1050012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050012",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050012",
      "estleg:sourceAct": "Kavilda ürgoru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1050012 § 10",
