      }
    },
    {
      "@id": "estleg:Reg_1013314_Par_5_6_v1013314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013314_Par_5_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Valveaja eest makstava lisatasu arvutamise alus on ametniku ametikoha madalaimast palgamäärast arvutatud tunnipalk. Tunnipalk arvutatakse kalendrikuu normtöötundide alusel. RT I 2013-12-29 36 129122013036 2014-01-01 Valveaja eest makstava lisatasu arvutamise alus on ametniku ametikoha madalaimast palgamäärast arvutatud tunnipalk. Tunnipalk arvutatakse kalendrikuu normtöötundide alusel. 2 (2) Vanglaametnikule, kelle tööülesandeks on määratud vanglaväline saatmine ja kes on määratud ametiabi andjaks avaliku korra tagamist nõudvates ülesannetes, valveaja eest makstava lisatasu arvutamise alus on ametniku ametipalgast arvutatud tunnipalk. RT I 2024-06-22 14 122062024014 2024-07-01 Vanglaametnikule, kelle tööülesandeks on määratud vanglaväline saatmine ja kes on määratud ametiabi andjaks avaliku korra tagamist nõudvates ülesannetes, valveaja eest makstava lisatasu arvutamise alus on ametniku ametipalgast arvutatud tunnipalk.",
      "rdfs:label": {
        "@value": "Reg_1013314_Par_5_6 (redaktsioon 1013314)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013314",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013314",
