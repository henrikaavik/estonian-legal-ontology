    {
      "@id": "estleg:Reg_1013314_Par_5_5_v1013314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013314_Par_5_5"
