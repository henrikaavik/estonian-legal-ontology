    {
      "@id": "estleg:Reg_1013314_Par_5_7_v1013314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013314_Par_5_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisatasu suurus ühe valveaja tunni eest on: 1 1) 10% §-s 52 sätestatud korras arvutatud tunnipalgast, kui vanglaametnikul on kohustus jõuda kokkulepitud kohta ühe tunni jooksul; 2 2) 5% §-s 52 sätestatud korras arvutatud tunnipalgast, kui vanglaametnik võib jõuda kokkulepitud kohta pikema aja kui ühe tunni jooksul või kui tal puudub kohustus kohale minna. RT I 2013-12-29 36 129122013036 2014-01-01 Lisatasu suurus ühe valveaja tunni eest on: 10% §-s 52 sätestatud korras arvutatud tunnipalgast, kui vanglaametnikul on kohustus jõuda kokkulepitud kohta ühe tunni jooksul; 5% §-s 52 sätestatud korras arvutatud tunnipalgast, kui vanglaametnik võib jõuda kokkulepitud kohta pikema aja kui ühe tunni jooksul või kui tal puudub kohustus kohale minna.",
      "rdfs:label": {
        "@value": "Reg_1013314_Par_5_7 (redaktsioon 1013314)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013314",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013314",
      "estleg:sourceAct": "Vanglaametnike ja vanglas töötavate riigiametnike töötasustamine",
      "estleg:provisionRef": "Reg_1013314 § 5_7",
      "estleg:partOfAct": {
