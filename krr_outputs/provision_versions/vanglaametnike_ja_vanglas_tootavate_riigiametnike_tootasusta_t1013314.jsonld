      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangla võib käesoleva määruse alusel kuni 2024. aasta 30 juunini määratud kõrgendatud põhipalga maksmist jätkata kuni teenistusliku vajaduse äralangemiseni. RT I 2024-06-22 14 122062024014 2024-07-01 Vangla võib käesoleva määruse alusel kuni 2024. aasta 30 juunini määratud kõrgendatud põhipalga maksmist jätkata kuni teenistusliku vajaduse äralangemiseni.",
      "rdfs:label": {
