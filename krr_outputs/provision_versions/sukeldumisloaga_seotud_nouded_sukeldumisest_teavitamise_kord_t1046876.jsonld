      "estleg:provisionRef": "Reg_1046876 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046876_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046876_Par_3_v1046876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046876_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muinsuskaitseamet tunnistab sukeldumisloa kehtetuks, kui: 1 1) loa taotlemisel on esitatud teadlikult valeandmeid; 2 2) loa saanud isik ei täida muinsuskaitseseadusest ja käesolevast määrusest tulenevaid nõudeid. Muinsuskaitseamet tunnistab sukeldumisloa kehtetuks, kui: loa taotlemisel on esitatud teadlikult valeandmeid; loa saanud isik ei täida muinsuskaitseseadusest ja käesolevast määrusest tulenevaid nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1046876_Par_3 (redaktsioon 1046876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046876",
