        "@language": "et"
      },
      "estleg:versionRedactionId": "117112021015"
    },
    {
      "@id": "estleg:MAHEPO_Par_16_1_v130062020014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_16_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajanduslikku toodet on liiduvälisest riigist lubatud Eestisse toimetada toiduseaduses, söödaseaduses, taimekaitseseaduses või loomade ja loomsete saadustega kauplemise ning nende impordi ja ekspordi seaduses sätestatud korras määratud piiripunkti kaudu vastavalt sellele, millisesse looma- või kaubakategooriasse mahepõllumajanduslik toode kuulub.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_16_1 (redaktsioon 130062020014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062020014",
      "estleg:supersededByVersion": {
