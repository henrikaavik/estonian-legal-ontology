      }
    },
    {
      "@id": "estleg:MAHEPO_Par_15_v117112021015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_15"
      },
      "estleg:versionValidFrom": {
