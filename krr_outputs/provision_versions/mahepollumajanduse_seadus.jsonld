      }
    },
    {
      "@id": "estleg:MAHEPO_Par_25_v107062013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "MAHEPO_Par_25 (redaktsioon 107062013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107062013008"
    },
    {
      "@id": "estleg:MAHEPO_Par_26_v72913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandussaaduse või -toote mahepõllumajandusele viitava märgistamise eest juriidilise isiku poolt, kellel ei ole sellekohast õigust – määratakse rahatrahv kuni 100 000 krooni.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_26 (redaktsioon 72913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "72913",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_26_v185982"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_26_v185982",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandussaaduse või -toote mahepõllumajandusele viitava märgistamise eest juriidilise isiku poolt, kellel ei ole sellekohast õigust - määratakse rahatrahv kuni 100 000 krooni.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_26 (redaktsioon 185982)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "185982",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_26_v704876"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_26_v704876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalveametnikul on õigus: tootja, käitleja või tema esindaja juuresolekul takistamatult kontrollida käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete järgimist ettevõtte ning tootjale või käitlejale teenust osutava ettevõtte territooriumil ja ruumides; saada tootjalt või käitlejalt vajalikku teavet, ärakirju ja väljavõtteid asjakohastest raamatupidamis- ja muudest dokumentidest ning jäädvustada tootja või käitleja teadmisel ettevõttes kontrollimise ajal valitsev olukord foto- või videotehnika abil; peatada käesoleva seaduse nõuete rikkumise kahtluse korral märgistatud põllumajandussaaduse ja -toote käitlemine ning turustamine; võtta nõuete rikkumise kahtluse korral tasuta kontrollproove, tellida ekspertiisi ja teha muid vajalikke toiminguid. (2) Järelevalveametnik on kohustatud: hoidma talle teatavaks saanud ärisaladust; kandma järelevalvetoimingute tegemise ajal kaitse-, eri- või ametiriietust.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_26 (redaktsioon 704876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "704876",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_26_v12740010"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_26_v12740010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2007. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_26 (redaktsioon 12740010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12740010"
    },
    {
      "@id": "estleg:MAHEPO_Par_3_v72913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandussaadus käesoleva seaduse tähenduses on töötlemata või esmatöödeldud taime- või loomakasvatussaadus, mida kasutatakse naturaalselt või põllumajandustoote valmistamiseks. (2) Taimekasvatussaadus käesoleva seaduse tähenduses on taimsete saaduste tootmise eesmärgil kasvatatav taim, seen või nende saadus, samuti loodusest korjatud taim, seen või nende saadus. (3) Loomakasvatussaadus käesoleva seaduse tähenduses on loomsete saaduste tootmise eesmärgil peetav loom või loomne saadus. Vabalt looduses kasvanud loomade seast kütitud või püütud looma või selle saadust ei loeta loomakasvatussaaduseks. (4) Põllumajandustootja (edaspidi tootja) käesoleva seaduse tähenduses on isik, kes tegeleb põllumajandussaaduste tootmisega ja samas ettevõttes või selle osas (edaspidi ettevõte) toodetud põllumajandussaaduste esmatöötlemise ja turustamisega. (5) Saaduse esmatöötlemine käesoleva seaduse tähenduses on saaduse puhastamine, sorteerimine, tükeldamine, kuivatamine, jahutamine, jahvatamine, pakendamine, märgistamine või muu sarnasel viisil töötlemine.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_3 (redaktsioon 72913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "72913",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_3_v704876"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_3_v704876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandussaadus käesoleva seaduse tähenduses on töötlemata või esmaselt töödeldud taime- või loomakasvatussaadus, mida kasutatakse naturaalselt või põllumajandustoote valmistamiseks. (2) Taimekasvatussaadus käesoleva seaduse tähenduses on taimsete saaduste tootmiseks kasvatatav taim, seen või nende saadus, samuti loodusest korjatud taim, seen või nende saadus. (3) Loomakasvatussaadus käesoleva seaduse tähenduses on loomsete saaduste tootmiseks peetav loom või tema saadus. Vabalt looduses kasvanud loomade seast kütitud või püütud looma või tema saadust ei loeta loomakasvatussaaduseks. (4) Põllumajandustootja (edaspidi tootja) käesoleva seaduse tähenduses on isik, kes tegeleb põllumajandussaaduse tootmisega ning samas ettevõttes või selle osas (edaspidi ettevõte ) toodetud põllumajandussaaduse esmase töötlemise, ladustamise ning turustamisega. (5) Põllumajandussaaduse esmane töötlemine käesoleva seaduse tähenduses on põllumajandussaaduse puhastamine, sorteerimine, koorimine, tükeldamine, kuivatamine, jahutamine, jahvatamine, pakendamine, märgistamine ning muu samasugusel viisil töötlemine. (6) Mahepõllumajandusele viitavalt märgistatud põllumajandussaaduse ja -toote turustamine käesoleva seaduse tähenduses on märgistatud põllumajandussaaduse ja -toote vedu, müügiks pakkumine, müümine ning muul viisil tasuta või tasu eest üleandmine. (7) Töötlemine on protsess, mille tulemusena põllumajandussaadusest valmib põllumajandustoode. Töötlemisena käsitatakse ka teise isiku toodetud põllumajandussaaduse esmast töötlemist.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_3 (redaktsioon 704876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "704876",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_3_v12740010"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_3_v12740010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajanduse valdkonnas tegutsev isik (edaspidi isik ) käesoleva seaduse tähenduses on nõukogu määruse (EMÜ) nr 2092/91 artikli 4 lõikes 5 nimetatud isik.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_3 (redaktsioon 12740010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12740010",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_3_v13148816"
      },
      "estleg:versionValidTo": {
        "@value": "2009-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_3_v13148816",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajanduse valdkonnas tegutsev isik (edaspidi isik ) käesoleva seaduse tähenduses on nõukogu määruse (EÜ) nr 834/2007 artikli 2 punktis d nimetatud isik.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_3 (redaktsioon 13148816)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13148816",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_3_v115032014007"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_3_v115032014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajanduse valdkonnas tegutsev isik (edaspidi isik) käesoleva seaduse tähenduses on nõukogu määruse (EÜ) nr 834/2007 artikli 2 punktis d nimetatud isik.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_3 (redaktsioon 115032014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014007",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_3_v117112021015"
      },
      "estleg:versionValidTo": {
        "@value": "2021-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_3_v117112021015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mahepõllumajanduse valdkonnas tegutsev isik (edaspidi isik) käesoleva seaduse tähenduses on Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artikli 3 punktis 13 nimetatud isik.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_3 (redaktsioon 117112021015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112021015"
    },
    {
      "@id": "estleg:MAHEPO_Par_4_v72913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandustoode käesoleva seaduse tähenduses on põllumajandussaaduse või -toote töötlemise tulemusena valminud toit või sööt. (2) Käitleja käesoleva seaduse tähenduses on isik, kes tegeleb põllumajandussaaduste või -toodete töötlemise ja turustamisega. (3) Käitlejaks käesoleva seaduse tähenduses ei loeta: tootjat; isikut, kes tegeleb mahepõllumajandusele viitavalt märgistatud müügipakendis põllumajandussaaduste või -toodete turustamisega.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4 (redaktsioon 72913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "72913",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_v704876"
      },
      "estleg:versionValidTo": {
        "@value": "2004-02-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_v704876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandustoode käesoleva seaduse tähenduses on põllumajandussaaduse või -toote töötlemise tulemusena valminud toit või sööt. (2) Käitleja käesoleva seaduse tähenduses on isik, kes tegeleb põllumajandussaaduse või -toote pakendamise, ladustamise, töötlemise, Eestisse sisse- ning Eestist väljaveoga.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4 (redaktsioon 704876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "704876",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_v749997"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_v749997",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandustoode käesoleva seaduse tähenduses on põllumajandussaaduse või -toote töötlemise tulemusena valminud toit või sööt. (2) Käitleja käesoleva seaduse tähenduses on isik, kes tegeleb põllumajandussaaduse või -toote pakendamise, ladustamise, töötlemise, Eestisse impordi- ning Eestist ekspordiga.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4 (redaktsioon 749997)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749997",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_v12740010"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_v12740010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse alusel tehtud isiku õigusi piirava otsuse postiga kättetoimetamise korral saadetakse otsus isikule väljastusteatega tähtkirjaga, muu otsuse võib isikule saata lihtkirjaga.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4 (redaktsioon 12740010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12740010",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_v128122017026"
      },
      "estleg:versionValidTo": {
        "@value": "2018-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_v128122017026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui käesoleva seaduse alusel tehtud otsus toimetatakse kätte posti teel, võib selle kätte toimetada lihtkirjaga, tähtkirjaga või väljastusteatega tähtkirjaga.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4 (redaktsioon 128122017026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017026"
    },
    {
      "@id": "estleg:MAHEPO_Par_4_1_v107062013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegeleda toitlustusettevõttes mahepõllumajandusliku toote ettevalmistamise ja turuleviimisega, esitab enne tegevuse alustamist Veterinaar- ja Toiduametile kirjaliku teavitamise avalduse. (2) Teavitamise avaldus sisaldab järgmisi andmeid: isiku nimi, isiku- või registrikood ning sidevahendite numbrid; isiku aadress; ettevõtte asukoht ja aadress.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4_1 (redaktsioon 107062013008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107062013008",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_1_v124112016002"
      },
      "estleg:versionValidTo": {
        "@value": "2017-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_1_v124112016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegeleda toitlustusettevõttes mahepõllumajandusliku toidu või mahepõllumajanduslikke koostisosi sisaldava toidu valmistamise ja turuleviimisega, esitab Veterinaar- ja Toiduametile sellekohase teabe koos toiduseaduse alusel toitlustusettevõttes toidu käitlemiseks esitatava majandustegevusteate või tegevusloa taotlusega. (2) Isik, kes on toiduseaduse alusel esitanud toitlustusettevõttes toidu käitlemiseks majandustegevusteate või kes omab tegevusluba, esitab käesoleva paragrahvi lõikes 1 nimetatud teabe Veterinaar- ja Toiduametile enne toitlustusettevõttes lõikes 1 nimetatud tegevusega alustamist. (3) Isik, kes loobub toitlustusettevõttes mahepõllumajandusliku toidu või mahepõllumajanduslikke koostisosi sisaldava toidu valmistamisest ja turuleviimisest, esitab Veterinaar- ja Toiduametile sellekohase teabe 30 tööpäeva jooksul loobumisest arvates.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4_1 (redaktsioon 124112016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124112016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_1_v108122020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_1_v108122020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegeleda toitlustusettevõttes mahepõllumajandusliku toidu või mahepõllumajanduslikke koostisosi sisaldava toidu valmistamise ja turuleviimisega, esitab Põllumajandus- ja Toiduametile sellekohase teabe koos toiduseaduse alusel toitlustusettevõttes toidu käitlemiseks esitatava majandustegevusteate või tegevusloa taotlusega. (2) Isik, kes on toiduseaduse alusel esitanud toitlustusettevõttes toidu käitlemiseks majandustegevusteate või kes omab tegevusluba, esitab käesoleva paragrahvi lõikes 1 nimetatud teabe Põllumajandus- ja Toiduametile enne toitlustusettevõttes lõikes 1 nimetatud tegevusega alustamist. (3) Isik, kes loobub toitlustusettevõttes mahepõllumajandusliku toidu või mahepõllumajanduslikke koostisosi sisaldava toidu valmistamisest ja turuleviimisest, esitab Põllumajandus- ja Toiduametile sellekohase teabe 30 tööpäeva jooksul loobumisest arvates.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4_1 (redaktsioon 108122020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108122020002",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_4_1_v117112021015"
      },
      "estleg:versionValidTo": {
        "@value": "2021-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_4_1_v117112021015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegeleda toitlustusettevõttes mahepõllumajandusliku toidu või mahepõllumajanduslikke koostisosi sisaldava toidu valmistamise ja turuleviimisega, esitab Põllumajandus- ja Toiduametile sellekohase teabe koos toiduseaduse alusel toitlustusettevõttes toidu käitlemiseks esitatava majandustegevusteate või tegevusloa taotlusega. (2) Isik, kes on toiduseaduse alusel esitanud toitlustusettevõttes toidu käitlemiseks majandustegevusteate või kes omab tegevusluba, esitab käesoleva paragrahvi lõikes 1 nimetatud teabe Põllumajandus- ja Toiduametile enne toitlustusettevõttes lõikes 1 nimetatud tegevusega alustamist. (3) Isik, kes loobub toitlustusettevõttes mahepõllumajandusliku toidu või mahepõllumajanduslikke koostisosi sisaldava toidu valmistamisest ja turuleviimisest, esitab Põllumajandus- ja Toiduametile sellekohase teabe 30 tööpäeva jooksul loobumisest arvates. (4) Käesolevas paragrahvis nimetatud andmed kantakse käesoleva seaduse § 11 lõike 1 alusel asutatud mahepõllumajanduse registrisse.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4_1 (redaktsioon 117112021015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112021015"
    },
    {
      "@id": "estleg:MAHEPO_Par_4_2_v117112021015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_4_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2018/848 artikli 35 lõikes 8 nimetatud isik esitab enne tegevuse alustamist Põllumajandus- ja Toiduametile sellekohase teabe koos järgmiste andmetega: isiku nimi, registri- või isikukood, isikukoodi puudumise korral sünniaeg; isiku elu- või asukoha ja tegevuskoha andmed ning kontaktandmed; isiku esindaja olemasolu korral tema nimi ja kontaktandmed. (2) Käesoleva paragrahvi lõikes 1 nimetatud isik, kes lõpetab mahepõllumajanduse valdkonnas tegutsemise, esitab Põllumajandus- ja Toiduametile sellekohase teabe 30 tööpäeva jooksul tegevuse lõpetamisest arvates. (3) Käesolevas paragrahvis nimetatud andmed kantakse käesoleva seaduse § 11 lõike 1 alusel asutatud mahepõllumajanduse registrisse.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_4_2 (redaktsioon 117112021015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117112021015"
    },
    {
      "@id": "estleg:MAHEPO_Par_5_v72913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mahepõllumajandusele viitav märgistamine on põllumajandussaaduse või -toote tähistamine käesoleva seaduse alusel kehtestatud mahepõllumajandusele viitava märgiga (edaspidi mahemärk) või sõnaga põllumajandussaaduse või -toote pinnal, pakendil, etiketil, saatedokumendil või mujal, samuti tarbija muul viisil teavitamine sellest, et põllumajandussaaduse tootmine ning põllumajandussaaduse ja -toote käitlemine vastab käesoleva seaduse nõuetele. (2) Sõnaga «mahe» või liitsõnaga, mille esimene osa on «mahe», ei tohi märgistada põllumajandussaadusi ega -tooteid, mis on toodetud või töödeldud ettevõttes, mis ei vasta käesoleva seaduse nõuetele, välja arvatud juhul, kui sõna «mahe» kirjeldab põllumajandussaaduse või -toote maitse- või muid sarnaseid omadusi ning on selgelt arusaadav, et sõna «mahe» ei osuta põllumajandussaaduse mahepõllumajanduslikule tootmisele ega töötlemisele. (3) Mahepõllumajandusele viitavalt märgistada kavatsetava või märgistatud põllumajandussaaduse ja -toote tootmisel, veol ja turustamisel tuleb ära hoida selle segunemine mittemahepõllumajandusliku saaduse ja tootega ning tagada nende eristatavus.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_5 (redaktsioon 72913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "72913",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAHEPO_Par_5_v27009"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_5_v27009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
