        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAHEPO_Par_15_v13197656",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Komisjoni määruse (EÜ) nr 889/2008 artikli 45 lõike 1 punktis b nimetatud loa annab Põllumajandusamet. (2) Komisjoni määruse (EÜ) nr 889/2008 artiklis 48 nimetatud andmekogu haldaja on Põllumajandusamet. (3) Komisjoni määruse (EÜ) nr 889/2008 artiklis 55 nimetatud aruande koostab ja edastab Euroopa Komisjonile, teistele liikmesriikidele ja Põllumajandusministeeriumile Põllumajandusamet.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_15 (redaktsioon 13197656)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13197656",
