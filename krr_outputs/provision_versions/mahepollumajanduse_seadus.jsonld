    {
      "@id": "estleg:MAHEPO_Par_15_v108122020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Komisjoni määruse (EÜ) nr 889/2008 artikli 45 lõike 1 punktis b nimetatud loa annab Põllumajandus- ja Toiduamet. (2) Komisjoni määruse (EÜ) nr 889/2008 artiklis 48 nimetatud andmekogu haldaja on Põllumajandus- ja Toiduamet. (3) Komisjoni määruse (EÜ) nr 889/2008 artiklis 55 nimetatud aruande koostab ja edastab Euroopa Komisjonile, teistele liikmesriikidele ja Maaeluministeeriumile Põllumajandus- ja Toiduamet.",
      "rdfs:label": {
