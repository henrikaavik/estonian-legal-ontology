      }
    },
    {
      "@id": "estleg:MAHEPO_Par_22_v13148816",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "MAHEPO_Par_22 (redaktsioon 13148816)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13148816",
