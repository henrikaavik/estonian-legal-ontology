    {
      "@id": "estleg:MAHEPO_Par_25_v72913",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAHEPO_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilised isikud vastutavad käesoleva seaduse ja selle alusel kehtestatud õigusaktide rikkumise eest haldusõiguserikkumiste seadustiku (RT 1992, 29, 396; RT I 1999, 41, 496; 45, õiend; 58, 608; 60, 616; 87, 792; 92, 825; 95, 843; 2000, 10, 58; 25, 141; 28, 167; 29, 169; 40, 247; 49, 301 ja 305; 51, 321; 54, 346, 348 ja 351; 55, 361; 58, 376; 84, 533; 86, 544 ja 548; 89, 578; 95, 609 ja 613; 2001, 3, 5; 17, 76; 18, 87; 21, 115 ja 116; 31, 174) alusel. (2) Juriidilised isikud vastutavad käesoleva seaduse kohaselt. (3) Kui õiguserikkuja on juriidilise isiku ametiisik, võib selle rikkumise asjas määrata karistuse samaaegselt füüsilisele isikule ja juriidilisele isikule seadusega ettenähtud korras.",
      "rdfs:label": {
        "@value": "MAHEPO_Par_25 (redaktsioon 72913)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "72913",
