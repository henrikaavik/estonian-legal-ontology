      "estleg:versionText": "Eesti Muusika- ja Teatriakadeemia seaduse § 5 lõike 1 punkt 2 tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "TAIKS_Par_39 (redaktsioon 112072025001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072025001",
