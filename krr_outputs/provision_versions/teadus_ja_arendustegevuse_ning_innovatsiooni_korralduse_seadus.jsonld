        "@type": "xsd:date"
      },
      "estleg:versionText": "Looduskaitseseaduse § 683 punkt 1 tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "TAIKS_Par_44 (redaktsioon 112072025001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072025001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072025001",
      "estleg:sourceAct": "Teadus- ja arendustegevuse ning innovatsiooni korralduse seadus",
      "estleg:provisionRef": "TAIKS § 44",
      "estleg:partOfAct": {
