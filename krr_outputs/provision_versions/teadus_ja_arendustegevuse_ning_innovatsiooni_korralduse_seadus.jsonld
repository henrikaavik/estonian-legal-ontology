      "estleg:provisionRef": "TAIKS § 42",
      "estleg:partOfAct": {
        "@id": "estleg:TAIKS_Map"
      }
    },
    {
      "@id": "estleg:TAIKS_Par_44_v112072025001",
      "@type": [
        "owl:NamedIndividual",
