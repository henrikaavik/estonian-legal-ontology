    {
      "@id": "estleg:Reg_1052936_Par_1_v1052936",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052936_Par_1"
