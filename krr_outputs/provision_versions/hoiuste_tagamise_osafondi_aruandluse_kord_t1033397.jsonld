    {
      "@id": "estleg:Reg_1033397_Par_6_v1033397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033397_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruannete esitamisel seisuga 31. märts 2016; 30. juuni 2016 ja 30. september 2016 võib kasutada vahekontodel olevate summade korral järgmisi identifikaatoreid: 1 1) Kliendi identifikaator „Määramata” koodiga 11, kui klienti ei ole võimalik identifitseerida; 2 2) Hoiuse suuruse vahemiku identifikaator „Määramata” koodiga 9, kui summade suuruste vahemikud ei ole identifitseeritavad. Aruannete esitamisel seisuga 31. märts 2016; 30. juuni 2016 ja 30. september 2016 võib kasutada vahekontodel olevate summade korral järgmisi identifikaatoreid: Kliendi identifikaator „Määramata” koodiga 11, kui klienti ei ole võimalik identifitseerida; Hoiuse suuruse vahemiku identifikaator „Määramata” koodiga 9, kui summade suuruste vahemikud ei ole identifitseeritavad. 2 (2) Lõikes 1 nimetatud identifikaatorite kasutamisel tuleb kogu aruandereal olev summa näidata „Aruandereal esitatud kõlblike hoiuste tagatud osa” väljal. Lõikes 1 nimetatud identifikaatorite kasutamisel tuleb kogu aruandereal olev summa näidata „Aruandereal esitatud kõlblike hoiuste tagatud osa” väljal.",
      "rdfs:label": {
