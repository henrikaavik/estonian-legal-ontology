      }
    },
    {
      "@id": "estleg:Reg_1033397_Par_2_v1033397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033397_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruande on kohustatud koostama ja esitama kõik Eestis tegutsevad krediidiasutused ja need krediidiasutuse filiaalid, mille asukohariigi hoiuste tagamisskeemi haldava üksuse kohaselt tagatakse hoiused Tagatisfondi seadusega sätestatud määradest väiksemas ulatuses (edaspidi krediidiasutus). Aruande on kohustatud koostama ja esitama kõik Eestis tegutsevad krediidiasutused ja need krediidiasutuse filiaalid, mille asukohariigi hoiuste tagamisskeemi haldava üksuse kohaselt tagatakse hoiused Tagatisfondi seadusega sätestatud määradest väiksemas ulatuses (edaspidi krediidiasutus). 2 (2) Finantsinspektsioon esitab kõlblike hoiuste andmed Tagatisfondile omavahel kokkulepitud vormis. Finantsinspektsioon esitab kõlblike hoiuste andmed Tagatisfondile omavahel kokkulepitud vormis.",
      "rdfs:label": {
        "@value": "Reg_1033397_Par_2 (redaktsioon 1033397)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033397",
