    {
      "@id": "estleg:Reg_1033397_Par_4_v1033397",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033397_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-04-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aruande aruandeperioodiks on kvartal. Aruande aruandeperioodiks on kvartal. 2 (2) Andmed esitatakse aruandeperioodi kvartali lõpu seisuga. Andmed esitatakse aruandeperioodi kvartali lõpu seisuga. 3 (3) Aruande Finantsinspektsioonile esitamise tähtaeg on aruandeperioodile järgneva kuu kümnes pangapäev. Aruande Finantsinspektsioonile esitamise tähtaeg on aruandeperioodile järgneva kuu kümnes pangapäev. 4 (4) Finantsinspektsioon edastab laekunud aruannete andmed Tagatisfondile hiljemalt iga kvartali teise kuu esimeseks päevaks. Finantsinspektsioon edastab laekunud aruannete andmed Tagatisfondile hiljemalt iga kvartali teise kuu esimeseks päevaks. 5 (5) Juhul kui kvartali teise kuu esimene päev on puhkepäev, edastatakse laekunud aruannete andmed hiljemalt puhkepäevale järgneval esimesel tööpäeval. Juhul kui kvartali teise kuu esimene päev on puhkepäev, edastatakse laekunud aruannete andmed hiljemalt puhkepäevale järgneval esimesel tööpäeval.",
      "rdfs:label": {
        "@value": "Reg_1033397_Par_4 (redaktsioon 1033397)",
        "@language": "et"
      },
