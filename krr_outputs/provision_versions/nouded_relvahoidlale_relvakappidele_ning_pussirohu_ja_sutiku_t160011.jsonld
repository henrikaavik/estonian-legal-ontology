    {
      "@id": "estleg:Reg_160011_Par_2_v160011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_160011_Par_2"
