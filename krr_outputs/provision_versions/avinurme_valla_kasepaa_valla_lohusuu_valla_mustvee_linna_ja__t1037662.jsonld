    {
      "@id": "estleg:Reg_1037662_Par_4_v1037662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037662_Par_4"
