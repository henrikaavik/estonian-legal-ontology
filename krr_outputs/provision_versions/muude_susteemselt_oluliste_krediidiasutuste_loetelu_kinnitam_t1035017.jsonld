      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Muude süsteemselt oluliste krediidiasutuste loetelu kinnitamine ja muu süsteemselt olulise krediidiasutuse puhvri nõude kehtestamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Muude süsteemselt oluliste krediidiasutuste loetelu kinnitamine ja muu süsteemselt olulise krediidiasutuse puhvri nõude kehtestamine"
    },
    {
      "@id": "estleg:Reg_1035017_Par_1_v1035017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035017_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis tegutsevad muud süsteemselt olulised krediidiasutused krediidiasustuste seaduse § 8648 tähenduses on: 1 1) Swedbank AS 2 2) AS SEB Pank 3 3) AS LHV Pank RT I 2017-12-05 12 105122017012 2018-01-01 4 4) Luminor Bank AS RT I 2018-05-22 17 122052018017 2018-07-01 5 5) Coop Pank AS 6 6) Bigbank AS RT I 2024-12-06 1 106122024001 2025-01-01 Eestis tegutsevad muud süsteemselt olulised krediidiasutused krediidiasustuste seaduse § 8648 tähenduses on: Swedbank AS AS SEB Pank AS LHV Pank Luminor Bank AS Coop Pank AS Bigbank AS",
      "rdfs:label": {
        "@value": "Reg_1035017_Par_1 (redaktsioon 1035017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035017",
      "estleg:sourceAct": "Muude süsteemselt oluliste krediidiasutuste loetelu kinnitamine ja muu süsteemselt olulise krediidiasutuse puhvri nõude kehtestamine",
      "estleg:provisionRef": "Reg_1035017 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035017_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035017_Par_2_v1035017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035017_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 1 nimetatud krediidiasutused on kohustatud hoidma muu süsteemselt olulise krediidiasutuse puhvrit järgmise määraga: 1 1) Swedbank AS: 2% 2 2) AS SEB Pank: 2% 3 3) AS LHV Pank: 2% RT I 2022-11-29 5 129112022005 2023-01-01 4 4) Luminor Bank AS: 2% RT I 2018-05-22 17 122052018017 2018-07-01 5 5) Coop Pank AS: 0,5% 6 6) Bigbank AS: 0,5% RT I 2024-12-06 1 106122024001 2025-01-01 Paragrahvis 1 nimetatud krediidiasutused on kohustatud hoidma muu süsteemselt olulise krediidiasutuse puhvrit järgmise määraga: Swedbank AS: 2% AS SEB Pank: 2% AS LHV Pank: 2% Luminor Bank AS: 2% Coop Pank AS: 0,5% Bigbank AS: 0,5%",
      "rdfs:label": {
        "@value": "Reg_1035017_Par_2 (redaktsioon 1035017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035017",
      "estleg:sourceAct": "Muude süsteemselt oluliste krediidiasutuste loetelu kinnitamine ja muu süsteemselt olulise krediidiasutuse puhvri nõude kehtestamine",
      "estleg:provisionRef": "Reg_1035017 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035017_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035017_Par_3_v1035017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035017_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muu süsteemselt olulise krediidiasutuse puhvri nõuet kohaldatakse Euroopa Parlamendi ja nõukogu määruse (EL) nr 575/2013 krediidiasutuste ja investeerimisühingute suhtes kohaldatavate usaldatavusnõuete kohta ja määruse (EL) nr 648/2012 muutmise kohta (ELT L 176, 27.06.2013, lk 1–337) artikli 92 lõike 3 kohaselt arvutatud koguriskipositsiooni suhtes.",
      "rdfs:label": {
        "@value": "Reg_1035017_Par_3 (redaktsioon 1035017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035017",
      "estleg:sourceAct": "Muude süsteemselt oluliste krediidiasutuste loetelu kinnitamine ja muu süsteemselt olulise krediidiasutuse puhvri nõude kehtestamine",
      "estleg:provisionRef": "Reg_1035017 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035017_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035017_Par_4_v1035017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035017_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muu süsteemselt olulise krediidiasutuse puhvri nõuet tuleb täita nii individuaalselt kui ka konsolideeritud alusel. Kui krediidiasutus kuulub konsolideerimisgruppi, tuleb konsolideeritud alusel täitmisele kuuluvat nõuet täita selle konsolideerimisgrupi Eesti kõrgeimal konsolideerimistasemel.",
      "rdfs:label": {
        "@value": "Reg_1035017_Par_4 (redaktsioon 1035017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035017",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035017",
      "estleg:sourceAct": "Muude süsteemselt oluliste krediidiasutuste loetelu kinnitamine ja muu süsteemselt olulise krediidiasutuse puhvri nõude kehtestamine",
      "estleg:provisionRef": "Reg_1035017 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035017_Map_2026"
      }
    },
