      }
    },
    {
      "@id": "estleg:Reg_1029857_Par_8_v1029857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029857_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse esitab andmeid aukonsuliks kandideerija, aukonsul ja andmekogu vastutav töötleja. Andmekogusse esitab andmeid aukonsuliks kandideerija, aukonsul ja andmekogu vastutav töötleja. 2 (2) Andmekogusse kannab andmed vastutava töötleja teenistuja. Andmekogusse kannab andmed vastutava töötleja teenistuja. 3 (3) Andmete esitaja vastutab esitatud andmete ning alusdokumentidel olevate andmete õigsuse eest. Andmekogu vastutava töötleja teenistuja vastutab andmekogusse kantavate ja sealt väljastatavate andmete vastavuse eest andmekogusse esitatud andmetele. Andmete esitaja vastutab esitatud andmete ning alusdokumentidel olevate andmete õigsuse eest. Andmekogu vastutava töötleja teenistuja vastutab andmekogusse kantavate ja sealt väljastatavate andmete vastavuse eest andmekogusse esitatud andmetele.",
      "rdfs:label": {
        "@value": "Reg_1029857_Par_8 (redaktsioon 1029857)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029857",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029857",
      "estleg:sourceAct": "Aukonsulite andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1029857 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029857_Par_9_v1029857",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029857_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Välisministeerium teeb oma veebilehel avaandmetena kättesaadavaks järgmised andmed: 1 1) aukonsuli ees- ja perekonnanimi; 2 2) ametikoha nimetus eesti ja inglise keeles; 3 3) tiitel; 4 4) aukonsuli äraoleku alguse ja lõpu kuupäev; 5 5) konsulaarasutuse asukoht ja riik; 6 6) konsulaarpiirkond eesti ja inglise keeles; 7 7) konsulaarasutuse avalikud kontaktandmed. Välisministeerium teeb oma veebilehel avaandmetena kättesaadavaks järgmised andmed: aukonsuli ees- ja perekonnanimi; ametikoha nimetus eesti ja inglise keeles; tiitel; aukonsuli äraoleku alguse ja lõpu kuupäev; konsulaarasutuse asukoht ja riik; konsulaarpiirkond eesti ja inglise keeles; konsulaarasutuse avalikud kontaktandmed. 2 (2) Andmekogusse kantud käesoleva paragrahvi lõikes 1 nimetamata andmed on juurdepääsupiiranguga avaliku teabe seaduse ja isikuandmete kaitse seaduse kohaselt ning neid ei avalikustata. Andmekogusse kantud käesoleva paragrahvi lõikes 1 nimetamata andmed on juurdepääsupiiranguga avaliku teabe seaduse ja isikuandmete kaitse seaduse kohaselt ning neid ei avalikustata. 3 (3) Juurdepääs andmekogusse kantud juurdepääsupiiranguga andmetele on vastutava töötleja teenistujal teenistuskohustuste täitmiseks määratud ulatuses ning järelevalve- ja julgeolekuasutusel seadusest tulenevate ülesannete täitmiseks. Juurdepääs andmekogusse kantud juurdepääsupiiranguga andmetele on vastutava töötleja teenistujal teenistuskohustuste täitmiseks määratud ulatuses ning järelevalve- ja julgeolekuasutusel seadusest tulenevate ülesannete täitmiseks.",
      "rdfs:label": {
