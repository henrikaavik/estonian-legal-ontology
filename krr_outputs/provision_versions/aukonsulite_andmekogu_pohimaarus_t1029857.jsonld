      "estleg:provisionRef": "Reg_1029857 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029857_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029857_Par_12_v1029857",
      "@type": [
        "owl:NamedIndividual",
