      },
      "estleg:versionText": "Käesoleva seaduse ja selle alusel kehtestatud õigusaktide nõuete täitmise üle teostavad riiklikku järelevalvet Tööinspektsioon ja Keskkonnaamet.",
      "rdfs:label": {
        "@value": "GMMOKS_Par_18 (redaktsioon 110072020044)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020044"
    },
    {
      "@id": "estleg:GMMOKS_Par_18_1_v114032014024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_18_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 49, 50 ja 51 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "GMMOKS_Par_18_1 (redaktsioon 114032014024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014024"
    },
    {
      "@id": "estleg:GMMOKS_Par_18_2_v114032014024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_18_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnainspektsioonil on lubatud kasutada füüsilist jõudu korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "GMMOKS_Par_18_2 (redaktsioon 114032014024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014024",
      "estleg:supersededByVersion": {
