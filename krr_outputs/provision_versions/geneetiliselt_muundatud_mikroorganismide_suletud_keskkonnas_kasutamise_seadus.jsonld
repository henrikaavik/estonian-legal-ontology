    },
    {
      "@id": "estleg:GMMOKS_Par_23_v27407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geneetiliselt muundatud mikroorganismide suletud keskkonnas kasutaja peab esitama Tööinspektsioonile suletud keskkonna ohuklassi järgiva taotluse hiljemalt 2002. aasta 1. juuliks.",
      "rdfs:label": {
        "@value": "GMMOKS_Par_23 (redaktsioon 27407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27407"
    },
    {
      "@id": "estleg:GMMOKS_Par_24_v27407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. jaanuaril, välja arvatud käesoleva paragrahvi lõikes 2 nimetatud juhul. (2) Käesoleva seaduse §-d 19-21 jõustuvad 2003. aasta 1. jaanuaril. Riigikogu aseesimees Tunne KELAM",
      "rdfs:label": {
        "@value": "GMMOKS_Par_24 (redaktsioon 27407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27407",
      "estleg:supersededByVersion": {
        "@id": "estleg:GMMOKS_Par_24_v184895"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:GMMOKS_Par_24_v184895",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. jaanuaril, välja arvatud käesoleva paragrahvi lõikes 2 nimetatud juhul. (2) Käesoleva seaduse §-d 19-21 jõustuvad 2003. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "GMMOKS_Par_24 (redaktsioon 184895)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184895",
