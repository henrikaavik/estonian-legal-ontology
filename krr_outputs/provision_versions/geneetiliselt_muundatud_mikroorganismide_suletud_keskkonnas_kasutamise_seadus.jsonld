    {
      "@id": "estleg:GMMOKS_Par_22_v27407",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geneetiliselt muundatud organismide keskkonda viimise seaduse (RT I 1999, 10, 151; 2001, 23, 130) § 5: lõike 2 punktid 3 ja 4 muudetakse ning sõnastatakse järgmiselt: « 3) vaadata läbi geneetiliselt muundatud organismi keskkonda viimise ja turustamise taotlused ning geneetiliselt muundatud mikroorganismide suletud keskkonnas kasutamise taotlused; anda hinnang geneetiliselt muundatud organismi keskkonda viimise ja turustamise taotluse ning geneetiliselt muundatud mikroorganismide suletud keskkonnas kasutamise taotluse kohta;» lõiget 2 täiendatakse punktiga 6 järgmises sõnastuses: « 6) nõustada Tööinspektsiooni geneetiliselt muundatud mikroorganismide suletud keskkonnas kasutamisega seotud küsimustes.»",
      "rdfs:label": {
        "@value": "GMMOKS_Par_22 (redaktsioon 27407)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27407",
      "estleg:supersededByVersion": {
        "@id": "estleg:GMMOKS_Par_22_v184895"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:GMMOKS_Par_22_v184895",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
