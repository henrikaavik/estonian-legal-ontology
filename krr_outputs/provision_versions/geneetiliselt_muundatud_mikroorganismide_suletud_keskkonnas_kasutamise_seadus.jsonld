      }
    },
    {
      "@id": "estleg:GMMOKS_Par_19_v13328626",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMMOKS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Geneetiliselt muundatud mikroorganismide suletud keskkonnas kasutamise eest loata või ohuklassile kohaldatud nõuete rikkumise eest –karistatakse kuni 300 trahviühiku suuruse rahatrahviga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse kuni 3200-eurose rahatrahviga.",
      "rdfs:label": {
        "@value": "GMMOKS_Par_19 (redaktsioon 13328626)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13328626",
      "estleg:supersededByVersion": {
