    {
      "@id": "estleg:Reg_1059149_Par_17_v1059149",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1059149_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetus makstakse välja lepingu kohaselt kahes osas järgnevalt: 1 1) esimese osana 97 protsenti toetuse summast 14 päeva jooksul pärast lepingu jõustumist; 2 2) teise osana 3 protsenti toetuse summast 14 päeva jooksul pärast aruande saamist tingimusel, et kõik toetuse kasutamisega seotud kohustused on täidetud. Toetus makstakse välja lepingu kohaselt kahes osas järgnevalt: esimese osana 97 protsenti toetuse summast 14 päeva jooksul pärast lepingu jõustumist; teise osana 3 protsenti toetuse summast 14 päeva jooksul pärast aruande saamist tingimusel, et kõik toetuse kasutamisega seotud kohustused on täidetud. 2 (2) Stipendium makstakse välja ühes osas lepingu kohaselt. Stipendium makstakse välja ühes osas lepingu kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1059149_Par_17 (redaktsioon 1059149)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1059149",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1059149",
      "estleg:sourceAct": "Välispoliitika valdkonna tegevuste toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1059149 § 17",
      "estleg:partOfAct": {
