      },
      "estleg:versionValidTo": {
        "@value": "2022-05-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PISTS_Par_2_1_v128042022006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
