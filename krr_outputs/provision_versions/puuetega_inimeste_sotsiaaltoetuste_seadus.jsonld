      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PISTS_Par_9_v128112017025",
      "@type": [
        "owl:NamedIndividual",
