        "@id": "estleg:Reg_1056383_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056383_Par_12_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
