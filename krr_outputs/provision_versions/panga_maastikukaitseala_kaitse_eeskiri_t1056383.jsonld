    },
    {
      "@id": "estleg:Reg_1056383_Par_13_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056383_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on säilitada maastikuilmet, sealhulgas säilitada avatud vaated merele ja hoida põllumaad avatud, ning kaitsta metsakoosluste elustiku mitmekesisust, kaitsealuseid liike ja nende elupaiku. Piiranguvööndi kaitse-eesmärk on säilitada maastikuilmet, sealhulgas säilitada avatud vaated merele ja hoida põllumaad avatud, ning kaitsta metsakoosluste elustiku mitmekesisust, kaitsealuseid liike ja nende elupaiku.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_13 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
      "estleg:sourceAct": "Panga maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056383 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056383_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056383_Par_14_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056383_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus, arvestades käesoleva määrusega sätestatud erisusi; 2 2) kuni 50 osalejaga rahvaürituse korraldamine kohas, mis ei ole selleks kaitseala valitseja nõusolekul ette valmistatud ega tähistatud. Piiranguvööndis on lubatud: majandustegevus, arvestades käesoleva määrusega sätestatud erisusi; kuni 50 osalejaga rahvaürituse korraldamine kohas, mis ei ole selleks kaitseala valitseja nõusolekul ette valmistatud ega tähistatud. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) rohkem kui 50 osalejaga rahvaürituse korraldamine kohas, mis ei ole selleks kaitseala valitseja nõusolekul ette valmistatud ega tähistatud; 2 2) veekogu veetaseme ja kaldajoone muutmine; 3 3) häil- ja aegjärkne raie kuni 1 hektari suuruse langina; 4 4) ehitise, kaasa arvatud ajutise ehitise püstitamine. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: rohkem kui 50 osalejaga rahvaürituse korraldamine kohas, mis ei ole selleks kaitseala valitseja nõusolekul ette valmistatud ega tähistatud; veekogu veetaseme ja kaldajoone muutmine; häil- ja aegjärkne raie kuni 1 hektari suuruse langina; ehitise, kaasa arvatud ajutise ehitise püstitamine. 3 (3) Raie tegemisel elustiku mitmekesisuse säilitamiseks tuleb säilikpuudena jätta raielangile alles puid tüvepuidu kogumahuga vähemalt 20 tm ha kohta esimese rinde suurima diameetriga puude hulgast. Raie tegemisel elustiku mitmekesisuse säilitamiseks tuleb säilikpuudena jätta raielangile alles puid tüvepuidu kogumahuga vähemalt 20 tm ha kohta esimese rinde suurima diameetriga puude hulgast.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_14 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
      "estleg:sourceAct": "Panga maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056383 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056383_Map_2026"
      }
