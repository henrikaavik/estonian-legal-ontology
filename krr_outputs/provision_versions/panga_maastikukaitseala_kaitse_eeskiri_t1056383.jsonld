    {
      "@id": "estleg:Reg_1056383_Par_15_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056383_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õuemaal. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õuemaal. 2 (2) Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab. Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_15 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
      "estleg:sourceAct": "Panga maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056383 § 15",
      "estleg:partOfAct": {
