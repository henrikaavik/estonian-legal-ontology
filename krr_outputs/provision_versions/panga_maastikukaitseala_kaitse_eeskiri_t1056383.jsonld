    {
      "@id": "estleg:Reg_1056383_Par_20_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056383_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_20 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
      "estleg:sourceAct": "Panga maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056383 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056383_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056383_Par_3_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056383_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_3 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
