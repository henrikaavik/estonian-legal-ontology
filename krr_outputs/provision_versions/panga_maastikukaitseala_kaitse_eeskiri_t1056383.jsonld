    {
      "@id": "estleg:Reg_1056383_Par_2_v1056383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056383_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Saare maakonnas Saaremaa vallas Panga külas. Kaitseala asub Saare maakonnas Saaremaa vallas Panga külas. 2 (2) Kaitseala välis- ja vööndite piirid on esitatud kaardil määruse lisas 14. Kaitseala välis- ja vööndite piirid on esitatud kaardil määruse lisas 14.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_2 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
