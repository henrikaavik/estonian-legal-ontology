        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Panga piiranguvöönd. Kaitsealal on Panga piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1056383_Par_12 (redaktsioon 1056383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056383",
      "estleg:sourceAct": "Panga maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056383 § 12",
