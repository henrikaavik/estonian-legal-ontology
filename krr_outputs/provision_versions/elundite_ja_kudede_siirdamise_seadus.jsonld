    {
      "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_13_v27764",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui surnud isikult eemaldatud elundile või koele pole Eestist võimalik leida sobivat retsipienti, võib seda kasutada elundite ja kudede rahvusvahelise vahetuse raames.",
      "rdfs:label": {
        "@value": "elundite_ja_kudede_siirdamise_seadus_Par_13 (redaktsioon 27764)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27764",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27764",
      "estleg:sourceAct": "Elundite ja kudede siirdamise seadus",
      "estleg:provisionRef": "elundite_ja_kudede_siirdamise_seadus § 13",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_Map"
      }
    },
    {
      "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_14_v27764",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siirdamist rahastab retsipient, kui ravikulude hüvitamise kohustust ei võta üle Eesti Haigekassa.",
      "rdfs:label": {
        "@value": "elundite_ja_kudede_siirdamise_seadus_Par_14 (redaktsioon 27764)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27764",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27764",
      "estleg:sourceAct": "Elundite ja kudede siirdamise seadus",
      "estleg:provisionRef": "elundite_ja_kudede_siirdamise_seadus § 14",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_Map"
      }
    },
    {
      "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_15_v27764",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Haigekassa võtab üle kohustuse hüvitada tervishoiuteenuse osutajale ravikulud, mis on tekkinud seoses elundi või koe siirdamisega ravikindlustusega hõlmatud retsipiendile, sealhulgas doonorilt või surnud isikult elundi või koe eemaldamise kulud. (2) Eesti Haigekassa maksab ravikindlustusega hõlmatud doonorile ja retsipiendile ajutise töövõimetuse hüvitist Eesti Vabariigi ravikindlustusseaduses (RT 1991, 23, 272; RT I 1999, 7, 113; 29, 397; 2000, 57, 374; 84, 536; 102, 675; 2001, 42, 233; 47, 260) sätestatud korras.",
      "rdfs:label": {
        "@value": "elundite_ja_kudede_siirdamise_seadus_Par_15 (redaktsioon 27764)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27764",
      "estleg:supersededByVersion": {
        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_15_v235078"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27764",
      "estleg:sourceAct": "Elundite ja kudede siirdamise seadus",
      "estleg:provisionRef": "elundite_ja_kudede_siirdamise_seadus § 15",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_Map"
      }
    },
