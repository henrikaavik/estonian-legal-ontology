      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist, välja arvatud §-d 3 ja 17, mis jõustuvad samaaegselt karistusseadustikuga.",
      "rdfs:label": {
        "@value": "elundite_ja_kudede_siirdamise_seadus_Par_18 (redaktsioon 27764)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27764",
