        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elundeid ja kudesid tohib siirata eriarstiabi osutaja, kellele on tervishoiuteenuste korraldamise seaduse (RT I 2001, 50, 284) alusel väljastatud vastav tegevusluba.",
      "rdfs:label": {
        "@value": "elundite_ja_kudede_siirdamise_seadus_Par_4 (redaktsioon 27764)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27764",
      "estleg:supersededByVersion": {
        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_4_v12911570"
      },
      "estleg:versionValidTo": {
        "@value": "2008-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/27764",
      "estleg:sourceAct": "Elundite ja kudede siirdamise seadus",
      "estleg:provisionRef": "elundite_ja_kudede_siirdamise_seadus § 4",
      "estleg:partOfAct": {
        "@id": "estleg:EKSS_Map"
      }
    },
    {
      "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_4_v12911570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:elundite_ja_kudede_siirdamise_seadus_Par_4"
      },
      "estleg:versionValidFrom": {
