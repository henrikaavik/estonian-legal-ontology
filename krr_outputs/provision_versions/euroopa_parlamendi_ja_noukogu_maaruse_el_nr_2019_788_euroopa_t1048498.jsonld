      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetusavalduste kontrollimise tulemusel annab Siseministeerium kolme kuu jooksul alates taotluse kättesaamisest korraldajatele kodanikualgatuse määruse artikli 12 lõike 5 alusel VI lisas esitatud näidisele vastava tõendi, millega tõendatakse kehtivate toetusavalduste arvu. Toetusavalduste kontrollimise tulemusel annab Siseministeerium kolme kuu jooksul alates taotluse kättesaamisest korraldajatele kodanikualgatuse määruse artikli 12 lõike 5 alusel VI lisas esitatud näidisele vastava tõendi, millega tõendatakse kehtivate toetusavalduste arvu.",
      "rdfs:label": {
        "@value": "Reg_1048498_Par_4 (redaktsioon 1048498)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048498",
