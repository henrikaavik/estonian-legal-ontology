      }
    },
    {
      "@id": "estleg:Reg_1018088_Par_13_v1018088",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018088_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse säilitamine ja tutvustamine. Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse säilitamine ja tutvustamine.",
      "rdfs:label": {
        "@value": "Reg_1018088_Par_13 (redaktsioon 1018088)",
