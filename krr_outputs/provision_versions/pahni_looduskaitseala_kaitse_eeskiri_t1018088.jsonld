      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1018088_Par_3 (redaktsioon 1018088)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018088",
