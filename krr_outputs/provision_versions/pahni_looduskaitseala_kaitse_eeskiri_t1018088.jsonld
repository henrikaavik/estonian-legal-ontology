    {
      "@id": "estleg:Reg_1018088_Par_18_v1018088",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1018088_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pähni looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 3. märtsi 2009. a käskkirjaga nr 318 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Pähni looduskaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 3. märtsi 2009. a käskkirjaga nr 318 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1018088_Par_18 (redaktsioon 1018088)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1018088",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1018088",
      "estleg:sourceAct": "Pähni looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1018088 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018088_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1018088_Par_19_v1018088",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
