      }
    },
    {
      "@id": "estleg:Reg_1054649_Par_19_v1054649",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054649_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse kõrvaltingimusega rahuldamise korral ei teki toetuse saajal õigust toetuse maksetele. Taotluse kõrvaltingimusega rahuldamise korral ei teki toetuse saajal õigust toetuse maksetele. 2 (2) Õigus toetusega seotud maksetele tekib toetuse saajal pärast rakendusüksuse poolt tingimuse saabumise või täitmise tuvastamist toetuse saaja esitatud teabe põhjal, välja arvatud kui teavet on võimalik rakendusüksusel tuvastada infosüsteemist, muust registrist või andmeallikast. Õigus toetusega seotud maksetele tekib toetuse saajal pärast rakendusüksuse poolt tingimuse saabumise või täitmise tuvastamist toetuse saaja esitatud teabe põhjal, välja arvatud kui teavet on võimalik rakendusüksusel tuvastada infosüsteemist, muust registrist või andmeallikast.",
      "rdfs:label": {
        "@value": "Reg_1054649_Par_19 (redaktsioon 1054649)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054649",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054649",
      "estleg:sourceAct": "Transpordi infrastruktuuri arendamiseks toetuse andmise tingimused perioodil 2021–2027",
      "estleg:provisionRef": "Reg_1054649 § 19",
