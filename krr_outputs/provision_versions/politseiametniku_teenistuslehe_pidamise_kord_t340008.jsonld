      }
    },
    {
      "@id": "estleg:Reg_340008_Par_3_v340008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_340008_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistuslehele kantakse järgmised andmed:11)ees- ja perekonnanimi;22)isikukood;33)sünniaeg ja -koht;44)haridus ja eriala;55)kutsekvalifikatsioon;66)ametivande andmise kuupäev ja koht;77)politseiteenistuse staaž;88)teenistusastme andmine ja muutmine;99)teenistuskäik, sealhulgas ametikohalt vabastamise aluse formuleering viitega seaduse paragrahvile, lõikele ja punktile;1010)ergutused, sealhulgas andmed riiklike teenetemärkide andmise kohta;1111)distsiplinaarkaristused ja nende kustutamine. Teenistuslehele kantakse järgmised andmed: ees- ja perekonnanimi; isikukood; sünniaeg ja -koht; haridus ja eriala; kutsekvalifikatsioon; ametivande andmise kuupäev ja koht; politseiteenistuse staaž; teenistusastme andmine ja muutmine; teenistuskäik, sealhulgas ametikohalt vabastamise aluse formuleering viitega seaduse paragrahvile, lõikele ja punktile; ergutused, sealhulgas andmed riiklike teenetemärkide andmise kohta; distsiplinaarkaristused ja nende kustutamine.",
      "rdfs:label": {
        "@value": "Reg_340008_Par_3 (redaktsioon 340008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "340008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/340008",
      "estleg:sourceAct": "Politseiametniku teenistuslehe pidamise kord",
      "estleg:provisionRef": "Reg_340008 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_340008_Map"
      }
    },
    {
      "@id": "estleg:Reg_340008_Par_4_v340008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_340008_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Teenistusest vabastamisel vormistatakse teenistuslehe väljatrükk, mis kinnitatakse volitatud isiku poolt vastavalt asutuse dokumendihalduskorras sätestatud vorminõuetele. Teenistusest vabastamisel vormistatakse teenistuslehe väljatrükk, mis kinnitatakse volitatud isiku poolt vastavalt asutuse dokumendihalduskorras sätestatud vorminõuetele. 2(2)Teenistusest vabastamise korral arvestatakse ja kantakse teenistuslehele politseiteenistuse staaž «Politsei ja piirivalve seaduse» § 108 alusel politseiteenistusest vabastamise kuupäeva seisuga. Teenistusest vabastamise korral arvestatakse ja kantakse teenistuslehele politseiteenistuse staaž «Politsei ja piirivalve seaduse» § 108 alusel politseiteenistusest vabastamise kuupäeva seisuga. 3(3)Lõpetatud ja paberkandjale trükitud teenistuslehte säilitatakse vastavalt Politsei- ja Piirivalveameti või Kaitsepolitseiameti arhiivis.RTL201019344133020372010-04-17+03:00 Lõpetatud ja paberkandjale trükitud teenistuslehte säilitatakse vastavalt Politsei- ja Piirivalveameti või Kaitsepolitseiameti arhiivis. 4(4)Lõpetatud ja paberkandjale trükitud teenistuslehte säilitatakse 75 aastat. Lõpetatud ja paberkandjale trükitud teenistuslehte säilitatakse 75 aastat. 5(5)Teenistusest vabastamise korral antakse politseiametnikule tema soovil teenistuslehe kinnitatud koopia. Kui politseiametniku teenistusleht sisaldab «Riigisaladuse ja salastatud välisteabe seaduse» mõistes salajast teavet, antakse politseiametnikule tema soovil teenistuslehe mittesalajane väljavõte.RTL201019344133020372010-04-17+03:00 Teenistusest vabastamise korral antakse politseiametnikule tema soovil teenistuslehe kinnitatud koopia. Kui politseiametniku teenistusleht sisaldab «Riigisaladuse ja salastatud välisteabe seaduse» mõistes salajast teavet, antakse politseiametnikule tema soovil teenistuslehe mittesalajane väljavõte.",
      "rdfs:label": {
        "@value": "Reg_340008_Par_4 (redaktsioon 340008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "340008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/340008",
      "estleg:sourceAct": "Politseiametniku teenistuslehe pidamise kord",
      "estleg:provisionRef": "Reg_340008 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_340008_Map"
      }
    },
    {
      "@id": "estleg:Reg_340008_Par_5_v340008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_340008_Par_5"
