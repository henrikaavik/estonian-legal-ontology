      "estleg:provisionRef": "Reg_158078 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158078_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158078_Par_6_v158078",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158078_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kliimaministeerium esitab Euroopa Komisjonile iga kolme aasta tagant möödunud perioodi aruande Euroopa Parlamendi ja EL nõukogu direktiivi 2001/18/EÜ sätete rakendamiseks võetud meetmetest, sealhulgas aruande GMO-de toodetena või toodete koostises turustamisel saadud kogemuste kohta. Kliimaministeerium esitab Euroopa Komisjonile iga kolme aasta tagant möödunud perioodi aruande Euroopa Parlamendi ja EL nõukogu direktiivi 2001/18/EÜ sätete rakendamiseks võetud meetmetest, sealhulgas aruande GMO-de toodetena või toodete koostises turustamisel saadud kogemuste kohta.",
      "rdfs:label": {
        "@value": "Reg_158078_Par_6 (redaktsioon 158078)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158078",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158078",
      "estleg:sourceAct": "Teabevahetus ja konsulteerimine Euroopa Komisjoniga geneetiliselt muundatud organismide keskkonda viimise ja geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisega seotud küsimustes",
      "estleg:provisionRef": "Reg_158078 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158078_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158078_Par_7_v158078",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158078_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kliimaministeerium konsulteerib Euroopa Komisjoniga kõikides GMO-de keskkonda viimise ja toodete turule lubamise valdkonnas esile kerkinud küsimustes, eriti seoses: 1 1) GMO keskkonda viimise või toote turustamisloa andmisega või pikendamisega ja hindamisaruandega seotud küsimustega; 2 2) GMO-de inimese tervist või keskkonda ohustava mõju kohta uute andmete teatavaks saamisega. Kliimaministeerium konsulteerib Euroopa Komisjoniga kõikides GMO-de keskkonda viimise ja toodete turule lubamise valdkonnas esile kerkinud küsimustes, eriti seoses: GMO keskkonda viimise või toote turustamisloa andmisega või pikendamisega ja hindamisaruandega seotud küsimustega; GMO-de inimese tervist või keskkonda ohustava mõju kohta uute andmete teatavaks saamisega.",
      "rdfs:label": {
        "@value": "Reg_158078_Par_7 (redaktsioon 158078)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158078",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158078",
      "estleg:sourceAct": "Teabevahetus ja konsulteerimine Euroopa Komisjoniga geneetiliselt muundatud organismide keskkonda viimise ja geneetiliselt muundatud organisme sisaldava või neist koosneva toote turustamisega seotud küsimustes",
      "estleg:provisionRef": "Reg_158078 § 7",
      "estleg:partOfAct": {
