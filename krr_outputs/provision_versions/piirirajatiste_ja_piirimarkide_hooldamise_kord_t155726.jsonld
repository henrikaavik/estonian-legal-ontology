        "@value": "2009-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piirirajatiste ja piirimärkide hooldamist korraldab Politsei- ja Piirivalveamet vastavalt käesolevale määrusele oma jõududega või sõlmib vastavate tööde tegemiseks sellekohased lepingud.RT I200965448132496952010-01-01+02:00 Piirirajatiste ja piirimärkide hooldamist korraldab Politsei- ja Piirivalveamet vastavalt käesolevale määrusele oma jõududega või sõlmib vastavate tööde tegemiseks sellekohased lepingud.",
      "rdfs:label": {
        "@value": "Reg_155726_Par_3 (redaktsioon 155726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155726",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155726",
      "estleg:sourceAct": "Piirirajatiste ja piirimärkide hooldamise kord",
      "estleg:provisionRef": "Reg_155726 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155726_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155726_Par_4_v155726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155726_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet on kohustatud:RT I200965448132496952010-01-01+02:0011)korraldama riigipiiri, piirirajatiste ja piirimärkide riikidevaheliste lepingutega fikseeritud seisukorras hoidmiseks vajalike tööde teostamise;22)võtma tarvitusele abinõud piiririba, piirimärkide, piirirajatiste, suunaviitade ja siltide rikkumisega kahju tekitaja väljaselgitamiseks ja kahjude hüvitamiseks tekitaja poolt (välja arvatud vääramatu jõu mõjul toimunud kahjustuste puhul). Politsei- ja Piirivalveamet on kohustatud: korraldama riigipiiri, piirirajatiste ja piirimärkide riikidevaheliste lepingutega fikseeritud seisukorras hoidmiseks vajalike tööde teostamise; võtma tarvitusele abinõud piiririba, piirimärkide, piirirajatiste, suunaviitade ja siltide rikkumisega kahju tekitaja väljaselgitamiseks ja kahjude hüvitamiseks tekitaja poolt (välja arvatud vääramatu jõu mõjul toimunud kahjustuste puhul).",
      "rdfs:label": {
        "@value": "Reg_155726_Par_4 (redaktsioon 155726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155726",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155726",
      "estleg:sourceAct": "Piirirajatiste ja piirimärkide hooldamise kord",
      "estleg:provisionRef": "Reg_155726 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155726_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155726_Par_5_v155726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
