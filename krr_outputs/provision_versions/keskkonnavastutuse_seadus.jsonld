        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KeVS_Par_34 (redaktsioon 114032014051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014051"
    },
    {
      "@id": "estleg:KeVS_Par_35_v12888473",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeVS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnateenistuse ametiisikul on õigus siseneda kahju tekitaja või eeldatava kahju tekitaja territooriumile või ehitisse, et kohapeal kontrollida ja koguda keskkonnakahjuga või kahju ohuga või kahju tekitaja tuvastamisega seonduvaid või järelevalve teostamiseks vajalikke andmeid ning teha dokumentidest väljavõtteid, ärakirju ja koopiaid.",
      "rdfs:label": {
        "@value": "KeVS_Par_35 (redaktsioon 12888473)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12888473",
      "estleg:supersededByVersion": {
        "@id": "estleg:KeVS_Par_35_v13118456"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KeVS_Par_35_v13118456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeVS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ametiisikul on õigus siseneda kahju tekitaja või eeldatava kahju tekitaja territooriumile või ehitisse, et kohapeal kontrollida ja koguda keskkonnakahjuga või kahju ohuga või kahju tekitaja tuvastamisega seonduvaid või järelevalve teostamiseks vajalikke andmeid ning teha dokumentidest väljavõtteid, ärakirju ja koopiaid.",
      "rdfs:label": {
        "@value": "KeVS_Par_35 (redaktsioon 13118456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118456",
      "estleg:supersededByVersion": {
        "@id": "estleg:KeVS_Par_35_v114032014051"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KeVS_Par_35_v114032014051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KeVS_Par_35"
      },
      "estleg:versionValidFrom": {
