    },
    {
      "@id": "estleg:KIIRGU_Par_54_v109112011006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sekkumisel tagatakse vastavalt tekkinud avarii- või püsikiirituse olukorrale järgmiste kaitsemeetmete rakendamine: suurenenud kiiritusega ala väljaselgitamine ja sellel alal kiirgusseire korraldamine; suurenenud kiiritusega ala märgistamine ja sellele juurdepääsu piiramine; suurenenud kiiritusega ala puhastamine; elanike kaitse, sealhulgas elanike varjumise, evakueerimise ja teavitamise korraldamine. (2) Sekkumises osalevad vähemalt Keskkonnaamet, päästeasutus, politsei ja sekkumises osalev radioaktiivsete jäätmete käitleja. (3) Sekkumises osaleva radioaktiivsete jäätmete käitleja nimetab majandus- ja kommunikatsiooniminister käskkirjaga. (4) Sekkumise korralduse, sekkumisel osalevate asutuste ja isikute ülesanded avarii- ja püsikiirituse olukorras ning sellega kaasnevate kulude hüvitamise korra",
      "rdfs:label": {
        "@value": "KIIRGU_Par_54 (redaktsioon 109112011006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_54_v113032014041"
      },
      "estleg:versionValidTo": {
