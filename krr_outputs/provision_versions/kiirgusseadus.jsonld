      }
    },
    {
      "@id": "estleg:KIIRGU_Par_15_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustöötajate saadud kutsekiirituse dooside kohta peab doosiregistrit Kiirguskeskus. (2) Doosiregister on riiklik register, mille asutab ja põhimääruse kinnitab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_15 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
