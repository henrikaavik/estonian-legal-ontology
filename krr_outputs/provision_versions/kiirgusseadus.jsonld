      }
    },
    {
      "@id": "estleg:KIIRGU_Par_36_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirguskeskus annab välja juhendmaterjale kiirgustegevusloa omaja nõustamiseks, et tagada käesoleva seaduse nõuete täitmine hea praktika võtete, protseduuride ja muude meetmete rakendamisega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_36 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_36_v13118460"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 36",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_36_v13118460",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet annab välja juhendmaterjale kiirgustegevusloa omaja nõustamiseks, et tagada käesoleva seaduse nõuete täitmine hea praktika võtete, protseduuride ja muude meetmete rakendamisega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_36 (redaktsioon 13118460)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118460",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_36_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13118460",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 36",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_36_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgusallikat võib paigaldada, remontida ja hooldada ainult isik, kellele on nimetatud tegevuseks antud kiirgustegevusluba. (2) Käesoleva paragrahvi lõikes 1 sätestatut ei kohaldata kiirgusallika remondi- ja hooldustöödele, mis ei ole seotud kiirgusallika kiirgust tekitavate osadega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_36 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_36_v108072025022"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 36",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_36_v108072025022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KIIRGU_Par_36 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025022",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 36",
      "estleg:partOfAct": {
