      },
      "estleg:versionText": "Kiirgustegevusloa ja kiirgustegevuse registreeringu annab Keskkonnaamet (edaspidi loa andja või registreeringu andja).",
      "rdfs:label": {
        "@value": "KIIRGU_Par_69 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025022",
