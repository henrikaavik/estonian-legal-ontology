      }
    },
    {
      "@id": "estleg:KIIRGU_Par_37_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgusallikate ja tuumamaterjali registrid on riigiasutuse andmekogud andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61, 375; 63, 387; 2003, 18, 107; 26, 158) tähenduses. (2) Kiirguskeskus peab kiirgusallikate ja tuumamaterjali registreid. (3) Kiirguskeskus kannab andmed olemasolevate ja Eesti Vabariiki sisseveetud kiirgusallikate kohta kiirgusallikate registrisse. Registrikanne tehakse kas kiirgusallika sissevedamiseks või kiirgusallika kasutamiseks antud kiirgustegevusloas sisalduvate andmete alusel. (4) Kiirguskeskus teeb kande tuumamaterjali registrisse tuumamaterjali omava isiku poolt esitatavate andmete põhjal.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_37 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_37_v1032872"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 37",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_37_v1032872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgusallikate ja tuumamaterjali registrid on riigiasutuse andmekogud andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61, 375; 63, 387; 2003, 18, 107; 26, 158) tähenduses. (2) Kiirguskeskus peab kiirgusallikate ja tuumamaterjali registreid. (3) Kiirguskeskus kannab andmed olemasolevate ja Eesti Vabariiki sisseveetud kiirgusallikate kohta kiirgusallikate registrisse. Registrikanne tehakse kas kiirgusallika hoidmiseks, kiirgusallika kasutamiseks, radioaktiivsete jäätmete käitlemiseks või kiirgusallika sissevedamiseks antud kiirgustegevusloas sisalduvate andmete alusel. (4) Kiirguskeskus teeb kande tuumamaterjali registrisse tuumamaterjali omava isiku poolt esitatavate andmete põhjal. (5) Inimese ja keskkonna kaitsmise ning kiirgusallika ohutuse ja füüsilise kaitse eesmärgil on kiirgusallikate ja tuumamaterjali registrites olev teave mõeldud asutusesiseseks kasutamiseks.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_37 (redaktsioon 1032872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032872",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_37_v12825077"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032872",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 37",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_37_v12825077",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgusallikate ja tuumamaterjali registrid on riigiasutuse andmekogud avaliku teabe seaduse tähenduses. (2) Kiirguskeskus peab kiirgusallikate ja tuumamaterjali registreid. (3) Kiirguskeskus kannab andmed olemasolevate ja Eesti Vabariiki sisseveetud kiirgusallikate kohta kiirgusallikate registrisse. Registrikanne tehakse kas kiirgusallika hoidmiseks, kiirgusallika kasutamiseks, radioaktiivsete jäätmete käitlemiseks või kiirgusallika sissevedamiseks antud kiirgustegevusloas sisalduvate andmete alusel. (4) Kiirguskeskus teeb kande tuumamaterjali registrisse tuumamaterjali omava isiku poolt esitatavate andmete põhjal. (5) Inimese ja keskkonna kaitsmise ning kiirgusallika ohutuse ja füüsilise kaitse eesmärgil on kiirgusallikate ja tuumamaterjali registrites olev teave mõeldud asutusesiseseks kasutamiseks.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_37 (redaktsioon 12825077)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825077",
      "estleg:supersededByVersion": {
