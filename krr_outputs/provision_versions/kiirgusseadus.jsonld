        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011006",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 52",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_52_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja tagab välistöötajale kiirgustöötajaga võrdse kiirgusohutuse ning tema töö iseloomu ja töökoha tingimusi arvestava väljaõppe ja kiirgusohutusalase juhendamise. (2) Välistöötaja doosikaardile kantavad andmed ja doosikaardi vormistamise korra ning doosikaardi vormi kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_52 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_52_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 52",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_52_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja tagab välistöötajale kiirgustöötajaga võrdse kiirgusohutuse ning tema töö iseloomu ja töökoha tingimusi arvestava väljaõppe ja kiirgusohutusalase juhendamise. (1¹) Enne välistöötaja tööle lubamist kontrollib kiirgustegevusloa omaja doosikaardile kantud andmete põhjal, et välistöötaja: sobib kiirgustööle tervisekontrolli andmete alusel; eelmise ja planeeritava kiirgustegevuse oodatavate kutsekiirituse dooside suurus ei ületa doosi kehtivaid piirmäärasid; on läbinud kiirgusohutuskoolituse. (2) Välistöötaja doosikaardile kantavad andmed ja doosikaardi vormistamise korra ning doosikaardi vormi kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_52 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_52_v108072025022"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 52",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_52_v108072025022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
