        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 54",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_54_v13118460",
      "@type": [
        "owl:NamedIndividual",
