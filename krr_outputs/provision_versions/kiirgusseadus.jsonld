      }
    },
    {
      "@id": "estleg:KIIRGU_Par_15_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Potentsiaalne kiiritus on kiiritus, mille saamine ei ole kindel, kuid mille esinemise tõenäosust saab eelnevalt hinnata.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_15 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_15_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 15",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_15_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kavandatav kiiritusolukord on kiirgusallika plaanikohase käitamise või kiiritusradu muutva inimtegevuse tõttu tekkiv kiiritusolukord, mis põhjustab või võib põhjustada inimese või keskkonna kiiritamist. Kavandatav kiiritusolukord hõlmab nii normaal- kui ka potentsiaalkiiritust. (2) Normaalkiiritus on rajatise käitamise või tegevuse käigus, sealhulgas hooldamisel, ülevaatamisel ja dekomissioneerimisel, normaalsete töötingimuste rakendamisel oodatav kiiritus, mis hõlmab ka väiksemaid vahejuhtumeid, mis suudetakse hoida kontrolli all. (3) Potentsiaalne kiiritus on kiiritus, mille saamine ei ole kindel, kuid mille esinemise tõenäosust saab eelnevalt hinnata.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_15 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 15",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_16_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alalisele kiirgustööle võib lubada isiku alates 18. eluaastast. (2) Kutsealase väljaõppe eesmärgil võib kiirgustööle lubada isiku alates 16. eluaastast, kuid mitte kauemaks kui kuueks kuuks.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_16 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_16_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 16",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_16_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevuse alustamine või tegutsemine käesoleva seaduse alusel kiirgustegevusluba nõudval kiirgustööl ilma kiirgustegevusloata on keelatud. (2) Kiirgustegevusluba peab taotlema kiirgustegevuseks, sealhulgas: tuumakütusetsükli mis tahes rajatise ekspluateerimiseks, sulgemiseks ja dekomisjoneerimiseks; radioaktiivse aine tahtlikuks lisamiseks meditsiinitoodete valmistamisel ja tootmisel ning selliste kaupade sisse- ja väljaveoks; radioaktiivse aine tahtlikuks lisamiseks tarbekaupade valmistamisel ja tootmisel ning radioaktiivse aine sisaldusega kaupade sisse- ja väljaveoks; kiirgusallika kasutamiseks ning radioaktiivse aine manustamiseks inimesele ja loomale nende terviseseisundi hindamise, diagnostika, ravi ja teadusuuringu eesmärgil; röntgenseadme või radioaktiivse aine kasutamiseks tööstuslikus radiograafias ja röntgenograafias, toodete töötlemisel, teadusuuringutel ning kiirendite kasutamiseks, välja arvatud elektronmikroskoopide kasutamiseks; suurenenud looduskiiritusega seotud tegevuseks, mille korral looduslikest radionukliididest põhjustatud kiirgus on kiirgusohutuse seisukohalt oluline; radioaktiivsete jäätmete käitlemiseks.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_16 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_16_v13223570"
      },
      "estleg:versionValidTo": {
        "@value": "2009-10-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 16",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_16_v13223570",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
