      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KIIRGU_Par_124_1 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
