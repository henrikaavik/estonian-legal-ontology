      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgusohutusnõuded meditsiiniradioloogia protseduuride teostamisel ja meditsiinikiiritust saavate isikute kaitse nõuded kehtestab sotsiaalminister määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_51 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
