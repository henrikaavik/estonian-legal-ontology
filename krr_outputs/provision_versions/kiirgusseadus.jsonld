    },
    {
      "@id": "estleg:KIIRGU_Par_61_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivsete jäätmete ladustuskoht on spetsiaalselt radioaktiivsete jäätmete vahe- või lõppladustamiseks ettenähtud rajatis. (2) Vaheladustamine on radioaktiivsete jäätmete paigutamine selleks tehniliselt varustatud rajatisse, et tagada nende isoleerimine, kavatsusega radioaktiivsed jäätmed rajatisest edaspidi välja võtta kas vabastamiseks, töötlemiseks ja konditsioneerimiseks või lõppladustamiseks. (3) Lõppladustamine on radioaktiivsete jäätmete paigutamine teatud tingimustele vastavasse ladustuskohta või selleks ettevalmistatud kohta väljavõtmise kavatsuseta. (4) Radioaktiivsete jäätmete vahe- ja lõppladustamist korraldab Majandus- ja Kommunikatsiooniministeerium.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_61 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_61_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 61",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
