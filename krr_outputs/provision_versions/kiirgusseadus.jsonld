      }
    },
    {
      "@id": "estleg:KIIRGU_Par_32_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja koostab kiirgusohutuse kvaliteedisüsteemi, mis kindlustab käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete ning kiirgustegevusloaga seatud tingimuste täitmise. (2) Kiirgusohutuse kvaliteedisüsteem peab sisaldama: kavandatud ja süstemaatilist tegevust, mille eesmärk on kiirgusohutuse tagamine; tööülesannete analüüsi ja kiirgusallika kasutamiseks vajalike oskuste nõudeid; kiirgusohutusnõuete kontrollimise süsteemi; materjalide hankimise ja kasutamise ning kiirgusohutuse järelevalve ja ohutussüsteemide töö kontrollimise protseduuride kirjeldusi.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_32 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_32_v109112011006"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 32",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_32_v109112011006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja koostab kiirgusohutuse kvaliteedisüsteemi, mis kindlustab käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete ning kiirgustegevusloaga seatud tingimuste täitmise. (2) Kiirgusohutuse kvaliteedisüsteem peab sisaldama: kavandatud ja süstemaatilist tegevust, mille eesmärk on kiirgusohutuse tagamine; tööülesannete analüüsi ja kiirgusallika kasutamiseks vajalike oskuste nõudeid; kiirgusohutusnõuete kontrollimise süsteemi; materjalide hankimise ja kasutamise ning kiirgusohutuse järelevalve ja ohutussüsteemide töö kontrollimise protseduuride kirjeldusi. (3) Tuumakäitise kiirgusohutuse kvaliteedisüsteem sisaldab lisaks käesoleva paragrahvi lõikes 2 sätestatule: tuumaohutust tagavate toimingute kirjeldust; tuumaohutust tagavate toimingute järgimise kontrollsüsteemi kirjeldust; töötajate tööülesannete analüüsi; töötajatele esitatavaid nõudeid; töötajate koolituse ja instrueerimise kavasid; seadmete ja materjalide hankimise, kasutamise ning kasutusest kõrvaldamise protseduuri kirjeldust.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_32 (redaktsioon 109112011006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_32_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011006",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 32",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_32_v128062016002",
      "@type": [
