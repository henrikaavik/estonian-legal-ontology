        "@id": "estleg:KIIRGU_Par_107_v108072025022"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110072020052",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 107",
