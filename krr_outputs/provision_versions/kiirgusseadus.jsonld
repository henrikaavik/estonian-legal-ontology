      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "KIIRGU_Par_74 (redaktsioon 13316051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13316051",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_74_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13316051",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 74",
      "estleg:partOfAct": {
