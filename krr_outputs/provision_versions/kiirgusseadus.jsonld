        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast radioaktiivsete jäätmete ladustuskoha sulgemist Keskkonnaamet: säilitab dokumendid radioaktiivsete jäätmete ladustuskoha asukoha, selle projekteerimise ja radioaktiivsete jäätmete inventuuri kohta tähtajatult; korraldab vajaduse korral kiirgusseiret ja ligipääsu piirangu kontrollimist; korraldab sekkumist, kui seireandmete põhjal või kontrollimisel tuvastatakse radioaktiivsete ainete sattumine keskkonda.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_67 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 67",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
