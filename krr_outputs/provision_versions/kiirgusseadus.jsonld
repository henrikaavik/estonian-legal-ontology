    {
      "@id": "estleg:KIIRGU_Par_65_v13316051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivsete ainete lisamise eest toiduainetele, mänguasjadele, ehetele ja kosmeetikakaupadele nende valmistamisel ning selliste kaupade sisse- või väljaveo eest –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_65 (redaktsioon 13316051)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13316051",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_65_v112072014064"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13316051",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 65",
