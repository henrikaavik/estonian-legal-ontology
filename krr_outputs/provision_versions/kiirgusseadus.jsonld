      }
    },
    {
      "@id": "estleg:KIIRGU_Par_51_v113032014041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgusohutusnõuded meditsiiniradioloogia protseduuride teostamisel ja meditsiinikiiritust saavate isikute kaitse nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_51 (redaktsioon 113032014041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014041",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_51_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014041",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 51",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_51_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välistöötaja on kiirgustöötaja, kaasa arvatud praktikant ja üliõpilane, kes ajutiselt või alaliselt töötab teises ettevõttes käesoleva seaduse § 53 lõike 1 punktis 1 nimetatud kontrollialal, sealhulgas remondib või hooldab kiirgusallika kiirgust tekitavaid osi.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_51 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_51_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 51",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_51_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välistöötaja on kiirgustöötaja, kaasa arvatud praktikant ja üliõpilane, keda ei ole tööle võtnud jälgimisala või kontrolliala eest vastutav isik, kuid kes täidab neil aladel tööülesandeid.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_51 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 51",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_52_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgushädaolukorras ja püsikiirituse korral rakendatakse kaitsemeetmeid, kui kahjustuse vähenemine on piisav kaitsemeetmete rakendamisel tekkiva kahju ja kulutuste õigustamiseks. (2) Kaitsemeetmete viis, ulatus ja kestus tuleb planeerida selliselt, et inimese tervisekahjustuse vähenemisest tekkiv kasu oleks sekkumisest põhjustatud kahjudega võrreldes maksimaalne.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_52 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_52_v109112011006"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 52",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_52_v109112011006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avarii- ja püsikiirituse olukorras rakendatakse kaitsemeetmeid, kui kahjustuse vähenemine on piisav kaitsemeetmete rakendamisel tekkiva kahju ja kulutuste õigustamiseks. (2) Kaitsemeetmete viis, ulatus ja kestus tuleb planeerida selliselt, et inimese tervisekahjustuse vähenemisest tekkiv kasu oleks sekkumisest põhjustatud kahjudega võrreldes maksimaalne.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_52 (redaktsioon 109112011006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011006",
