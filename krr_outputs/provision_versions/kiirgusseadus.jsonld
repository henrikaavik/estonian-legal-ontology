        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Radioaktiivsete jäätmete veoks kiirgustegevusloa (edaspidi veoluba) taotlemisele kohaldatakse käesoleva seaduse 4. peatüki 1. jagu, arvestades käesolevas jaos sätestatut erisusi.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_81 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_81_v126062018008"
      },
      "estleg:versionValidTo": {
