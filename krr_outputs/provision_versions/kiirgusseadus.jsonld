      "estleg:versionText": "Keskkonnaamet tagab piiriülesest kiirgusohust varase hoiatamise süsteemi töö.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_57 (redaktsioon 13118460)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118460",
