      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja on kohustatud tagama kiirgustöötajale töö iseloomu ja töökoha tingimusi arvestava kiirgusohutusalase koolituse ning juhendamise. (2) Kiirgustöötaja kiirgusohutusalase koolitamise nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_48 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
