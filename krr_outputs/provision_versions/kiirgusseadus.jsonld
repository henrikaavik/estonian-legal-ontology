      },
      "estleg:versionText": "Kiirgusohutusalast tegevust korraldab oma pädevuse piires Keskkonnaministeerium Keskkonnainspektsiooni ja Keskkonnaameti kaudu.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_25 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
