      }
    },
    {
      "@id": "estleg:KIIRGU_Par_22_v1032872",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaministeerium keeldub kiirgustegevusloa andmisest, kui: tegevusega, milleks kiirgustegevusluba taotletakse, kaasneb või võib kaasneda oht riigisisesele või rahvusvahelisele julgeolekule; tegevus, milleks kiirgustegevusluba taotletakse, ei vasta õigusaktidega sätestatud nõuetele; kiirgustegevusloa taotluses on esitatud valeandmeid; kiirgustegevusloa taotlejal puuduvad nõutava erialase ettevalmistusega kiirgustöötajad; kiirgustegevuseks taotletav koht ja muud tingimused ei võimalda kiirgusohutusnõuete täitmist.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_22 (redaktsioon 1032872)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032872",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_22_v13118460"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032872",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_22_v13118460",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet keeldub kiirgustegevusloa andmisest, kui: tegevusega, milleks kiirgustegevusluba taotletakse, kaasneb või võib kaasneda oht riigisisesele või rahvusvahelisele julgeolekule; tegevus, milleks kiirgustegevusluba taotletakse, ei vasta õigusaktidega sätestatud nõuetele; kiirgustegevusloa taotluses on esitatud valeandmeid; kiirgustegevusloa taotlejal puuduvad nõutava erialase ettevalmistusega kiirgustöötajad; kiirgustegevuseks taotletav koht ja muud tingimused ei võimalda kiirgusohutusnõuete täitmist.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_22 (redaktsioon 13118460)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118460",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_22_v109112011006"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13118460",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_22_v109112011006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaamet keeldub kiirgustegevusloa andmisest, kui: tegevusega, milleks kiirgustegevusluba taotletakse, kaasneb või võib kaasneda oht riigisisesele või rahvusvahelisele julgeolekule; tegevus, milleks kiirgustegevusluba taotletakse, ei vasta õigusaktidega sätestatud nõuetele; kiirgustegevusloa taotluses on esitatud valeandmeid; kiirgustegevusloa taotlejal puuduvad nõutava erialase ettevalmistusega kiirgustöötajad; kiirgustegevuseks taotletav koht ja muud tingimused ei võimalda kiirgusohutusnõuete täitmist; kiirgustegevusloa taotleja ei tõenda käesoleva seaduse § 181 lõikes 1 sätestatud tagatise olemasolu kiirgustegevusloa andja määratud suuruses ja tingimustel.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_22 (redaktsioon 109112011006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_22_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011006",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_22_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Iga kiiritus tuleb hoida nii väikesena kui majandus- ja sotsiaaltegureid mõistlikult arvesse võttes on võimalik.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_22 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 22",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_23_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgusallika asukohaks olevate ruumide ja ehitiste ning nende konstruktsioonielementide ja kiirgusallika ohutu kasutamise nõuded kehtestatakse keskkonnaministri määrusega. (2) Kiirgusallika valdaja on kiirgusallika ekspluatatsiooni lõpetamisel kohustatud muutma kiirgusallika kiirgusohutuks. (3) Kiirgusallika valdaja on kohustatud vastavaid volitusi omava riigiasutuse nõudmisel tõendama radioaktiivse aine või radioaktiivset ainet sisaldava kiirgusseadme valdamise seaduslikkust.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_23 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_23_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 23",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_23_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusluba kehtib kuni viis aastat.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_23 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_23_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 23",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_23_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiiritusel saadavate dooside summa ei tohi ületada käesoleva seaduse § 50 lõike 6 alusel kehtestatud piirmäärasid. Seda nõuet ei kohaldata meditsiinikiirituse suhtes. (2) Efektiivdoos on inimkeha kudede ja elundite erinevat kiirgustundlikkust iseloomustavate koefaktoritega korrutatud ekvivalentdooside summa. (3) Ekvivalentdoos on inimkeha koe või elundi neeldumisdoosi ja toimiva kiirguse kiirgusfaktori korrutis. (4) Neeldumisdoos käesoleva seaduse tähenduses on inimkeha koe või elundi keskmine doos neeldunud ioniseeriva kiirguse energia aine massiühiku kohta. (5) Kiirgusfaktor on kiirguseliikide erinevat tervisekahjustusvõimet arvestav dimensioonitu tegur, millega korrutatakse neeldumisdoos. (6) Koefaktor on inimkeha kudede ja elundite erinevat kiiritustundlikkust arvestav dimensioonitu tegur, millega korrutatakse koe või elundi ekvivalentdoos. (7) Doosikiirus on doosi kasv ajaühikus. (8) Doosi piirmäärad on kiirgustöötajatele ja elanikele põhjustatavate kiirgusdooside maksimumväärtused, mida kohaldatakse piiritletud ajavahemiku kestel väliskiiritusest ja radionukliidide sissevõtust saadud dooside summa suhtes. Aasta kestel radionukliidide sissevõtust tekitatav doos summeeritakse 50 aasta (lastel kuni 70 aasta) kestel. (9) Sissevõtt on radionukliidide sisenemine kehasse hingamisteede, seedekulgla või naha kaudu.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_23 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_23_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 23",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_23_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiiritusel saadavate dooside summa ei tohi ületada käesoleva seaduse § 50 lõike 6 alusel kehtestatud piirmäärasid. Seda nõuet ei kohaldata meditsiinikiirituse ja avariikutsekiirituse suhtes. (2) Efektiivdoos on inimkeha kudede ja elundite erinevat kiirgustundlikkust iseloomustavate koefaktoritega korrutatud ekvivalentdooside summa. (3) Ekvivalentdoos on inimkeha koe või elundi neeldumisdoosi ja toimiva kiirguse kiirgusfaktori korrutis. (4) Neeldumisdoos käesoleva seaduse tähenduses on inimkeha koe või elundi keskmine doos neeldunud ioniseeriva kiirguse energia aine massiühiku kohta. (5) Kiirgusfaktor on kiirguseliikide erinevat tervisekahjustusvõimet arvestav dimensioonitu tegur. (6) Koefaktor on inimkeha kudede ja elundite erinevat kiiritustundlikkust arvestav dimensioonitu tegur. (7) Doosikiirus on doosi kasv ajaühikus. (8) Doosi piirmäärad on kiirgustöötajatele ja elanikele põhjustatavate kiirgusdooside maksimumväärtused, mida kohaldatakse piiritletud ajavahemiku kestel väliskiiritusest ja radionukliidide sissevõtust saadud dooside summa suhtes. Aasta kestel radionukliidide sissevõtust tekitatav doos summeeritakse 50 aasta (lastel kuni 70 aasta) kestel. (8¹) Doosipiirang on isiku oodatava doosi ülempiirile seatud piirang, mis põhineb kavandatavas kiirgustegevuses kindla kiirgusallika kasutamise optimeerimisel vaadeldavate võimaluste väljaselgitamisel. (9) Sissevõtt on radionukliidide sisenemine kehasse hingamisteede, seedekulgla või naha kaudu.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_23 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 23",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_24_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pakend, märgistus ja kaitsevahendid peavad tagama kiirgusallika ohutuse. Kiirgusallika pakendamise, märgistamise ja kaitsevahenditega varustamise nõuded kehtestatakse Vabariigi Valitsuse määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_24 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_24_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_24_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusloa omaja teatab eelnevalt Keskkonnaministeeriumile, kui ta kavatseb: kasutusele võtta uue või täiendava kiirgusallika; lõpetada kiirgustegevusloas märgitud kiirgusallika kasutamise; anda kiirgusallika üle teisele isikule või ladustada radioaktiivse jäätmena; muuta kiirgustegevusloaga määratud kiirgustegevust, tekkivate radioaktiivsete jäätmete käitlemise viise, piirkoguseid või käitluskohta; muuta kiirgustegevuse toimumise kohta, rajatisi või ruume; võtta tööle uue kiirgusohutuse spetsialisti; muuta muul viisil oluliselt loas kirjeldatud kiirgustegevust.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_24 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_24_v13118460"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_24_v13118460",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusloa omaja teatab eelnevalt Keskkonnaametile, kui ta kavatseb: kasutusele võtta uue või täiendava kiirgusallika; lõpetada kiirgustegevusloas märgitud kiirgusallika kasutamise; anda kiirgusallika üle teisele isikule või ladustada radioaktiivse jäätmena; muuta kiirgustegevusloaga määratud kiirgustegevust, tekkivate radioaktiivsete jäätmete käitlemise viise, piirkoguseid või käitluskohta; muuta kiirgustegevuse toimumise kohta, rajatisi või ruume; võtta tööle uue kiirgusohutuse spetsialisti; muuta muul viisil oluliselt loas kirjeldatud kiirgustegevust.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_24 (redaktsioon 13118460)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118460",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_24_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13118460",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_24_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Radioaktiivsete ainete tahtlik lisamine toiduainetele, mänguasjadele, ehetele ja kosmeetikakaupadele nende valmistamisel ning selliste radioaktiivseid aineid sisaldavate kaupade sisse- ja väljavedu on keelatud.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_24 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_24_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_24_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivsete ainete tahtlik lisamine toiduainetele, loomasöödale, mänguasjadele, ehetele ja kosmeetikatoodetele nende valmistamisel ning selliste radioaktiivseid aineid sisaldavate kaupade sisse- ja väljavedu on keelatud. (2) Mänguasjades ja ehetes kasutatavate materjalide aktiveerimine nende valmistamisel ning selliste radioaktiivseid aineid sisaldavate toodete ja materjalide sisse- ja väljavedu on keelatud. (3) Aktiveerimine on protsess, mille käigus stabiilne nukliid muudetakse radionukliidiks, kiiritades seda sisaldavat materjali osakestega või suure energiaga footonitega. (4) Tarbekaup käesoleva seaduse tähenduses on toode, millesse on tahtlikult sisestatud üks või mitu radionukliidi või milles need on loodud aktiveerimise teel või mis tekitab ioniseerivat kiirgust ning mille saab müüa või elanikele kättesaadavaks teha ilma müügijärgse järelevalve või reguleeriva kontrollita. (5) Keskkonnaamet teavitab Euroopa Liidu liikmesriikide pädevaid asutusi käesoleva paragrahvi lõikes 4 nimetatud tarbekaupade tootmise ja sisseveo lubamisest või keelamisest.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_24 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 24",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_24_1_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_24_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusloa omaja vastutab kiirgusseaduses ja loa tingimustes sätestatud kohustuste täitmise eest, et tagada kiirgusohutus ning töötajate kaitse mis tahes loa omaja valduses oleva kiirgusallika või tegevusega seotud kiirgusolukorras.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_24_1 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
