      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgusohutustegevust korraldab oma pädevuse piires Keskkonnaministeerium Keskkonnainspektsiooni ja Keskkonnaameti kaudu, kaasates selleks teisi asjaomaseid asutusi ning võttes muu hulgas arvesse valdkonnapõhiseid käitamiskogemusi, otsustusprotsessi tulemusi, asjaomase tehnoloogia arengut ja teadusuuringuid.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_25 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
