      "estleg:provisionRef": "KIIRGU § 3",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_3_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
