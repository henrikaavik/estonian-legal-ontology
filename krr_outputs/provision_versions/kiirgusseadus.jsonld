      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirguskeskus tagab piiriülesest kiirgusohust varase hoiatamise süsteemi töö.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_57 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
