      }
    },
    {
      "@id": "estleg:KIIRGU_Par_66_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja kogub ja analüüsib andmeid radioaktiivsete jäätmete ladustuskoha kasutamise kohta ja edastab need säilitamiseks Keskkonnaametile. (2) Keskkonnaamet võib käesoleva paragrahvi lõikes 1 nimetatud andmete alusel kohustada kiirgustegevusloa omajat esitama uue kiirgustegevusloa taotluse ladustuskoha sulgemiseks. (3) Ladustuskoha sulgemise tingimused määratakse kiirgustegevusloaga.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_66 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_66_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 66",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_66_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgustegevusloa omaja kogub ja analüüsib andmeid radioaktiivsete jäätmete ladustuskoha kasutamise kohta ja edastab need säilitamiseks Keskkonnaametile. (2) Keskkonnaamet võib käesoleva paragrahvi lõikes 1 nimetatud andmete alusel kohustada kiirgustegevusloa omajat esitama uue kiirgustegevusloa taotluse ladustuskoha sulgemiseks. (2¹) Ladustuskoha sulgemine on igasuguse tegevuse lõpetamine pärast kasutatud tuumkütuse või radioaktiivsete jäätmete paigutamist lõppladustamiseks ettenähtud rajatisse, kaasa arvatud lõplikud insenertehnilised või muud tööd, et rajatis saavutaks pikaajalise ohutuse seisundi. (3) Ladustuskoha sulgemise tingimused määratakse kiirgustegevusloaga.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_66 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
