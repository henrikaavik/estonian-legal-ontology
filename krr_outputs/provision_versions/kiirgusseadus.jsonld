      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusloa annab Keskkonnaamet.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_15 (redaktsioon 13118460)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13118460",
