      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kiirgustegevusest põhjustatud kiiritus elanikule võib ületada käesoleva seaduse § 50 lõike 6 alusel kehtestatud elaniku doosipiirmäära ühte kümnendikku aastas, konsulteerib kiirgustegevuse tegija kiirgusohutuse tagamiseks võimalike lisameetmete rakendamise vajalikkuse asjus kiirguseksperdiga.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_55 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
