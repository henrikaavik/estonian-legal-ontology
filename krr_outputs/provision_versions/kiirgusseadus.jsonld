        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusloa annab Keskkonnaministeerium.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_15 (redaktsioon 735303)",
        "@language": "et"
