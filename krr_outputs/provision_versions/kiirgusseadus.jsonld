        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaametil on lubatud kasutada füüsilist jõudu korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_114 (redaktsioon 110072020052)",
