        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus ja keskkonnaseadustiku üldosa seaduse viies peatükk jõustuvad 2016. aasta 1. novembril.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_127 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 127",
      "estleg:partOfAct": {
