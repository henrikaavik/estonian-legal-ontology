      }
    },
    {
      "@id": "estleg:KIIRGU_Par_44_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Meditsiiniradioloogia protseduuride optimeerimisel kasutatakse diagnostilisi referentsväärtusi. Nende ületamisel tuleb kaaluda meetmeid patsiendikiirituse vähendamiseks. (2) Diagnostiline referentsväärtus on diagnostilise meditsiiniradioloogia protseduuriga kaasneva doosi või radiofarmatseutilise ravimi aktiivsuse võrdlustase standardsuurusega, mida kasutatakse patsiendidoosi optimeerimise eesmärgil. (3) Diagnostilised referentsväärtused kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_44 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_44_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 44",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_44_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Diagnostilisi referentsväärtusi kasutatakse meditsiinikiirituse protseduuride optimeerimisel. Nende ületamisel tuleb kaaluda asjakohaseid meetmeid patsiendidoosi vähendamiseks. (2) Diagnostiline referentsväärtus on meditsiinikiirituse protseduuriga kaasneva kiirgusdoosi või radiofarmatseutilise ravimi aktiivsuse võrdlustase standardsuurusega patsiendi jaoks. (2¹) Diagnostiliste referentsväärtuste määramise tagab Terviseamet. (3) Diagnostilised referentsväärtused ja diagnostiliste referentsväärtuste määramise nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_44 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 44",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_45_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kvalifitseeritud kiirguseksperdina tohib tegutseda vastavat kvalifitseeritud kiirguseksperdi tegevuslitsentsi (edaspidi tegevuslitsents) omav füüsiline isik. (2) Keskkonnaministeerium annab tegevuslitsentsi litsentsitaotleja avalduse alusel. (3) Tegevuslitsentsi võib taotleda füüsiline isik, kes: on omandanud kõrghariduse kõrgkoolis või ülikoolis, millel on Haridus- ja Teadusministeeriumi antud koolitusluba või mille antud haridust tõendav dokument on Eesti Vabariigis tunnustatud; on vähemalt viieaastase töökogemusega kiirgusohutuse alal; tunneb kiirgusohutuse teostamise korda ning Eesti Vabariigi ja rahvusvahelisi kiirgusalaseid õigusakte. (4) Tegevuslitsents antakse viieks aastaks. (5) Tegevuslitsentsi andmisest keeldutakse, kui taotleja: ei oma nõutud kvalifikatsiooni; on kolme aasta jooksul enne litsentsitaotluse esitamist oma varasema majandustegevusega rikkunud oluliselt õigusaktidega kehtestatud nõudeid; varasem tegevuslitsents on kehtetuks tunnistatud kolme aasta jooksul enne litsentsitaotluse esitamist. (6) Keskkonnaministeerium peatab tegevuslitsentsi kehtivuse või tunnistab tegevuslitsentsi kehtetuks, sellest litsentsi omajat eelnevalt kirjalikult teavitades, kui: tegevuslitsentsi taotleja on esitanud tegelikkusele mittevastavaid andmeid; tegevuslitsentsi saanud isik ei täida dooside hindamise ja kiirgusohutuse nõudeid; ilmnevad käesoleva paragrahvi lõikes 5 nimetatud asjaolud. (7) Kvalifitseeritud kiirguseksperdi tegevuslitsentsi ja selle taotluse vormi ning tegevuslitsentsi andmise, pikendamise, peatamise ja kehtetuks tunnistamise korra kehtestab keskkonnaminister määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_45 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_45_v873609"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-02",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 45",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
