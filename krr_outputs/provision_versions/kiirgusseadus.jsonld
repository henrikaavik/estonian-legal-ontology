      }
    },
    {
      "@id": "estleg:KIIRGU_Par_26_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnaseadustiku üldosa seaduse §-s 1 sätestatud eesmärgi ja §-des 8–13 sätestatud põhimõtete ning käesolevas seaduses sätestatud kiirgusohutuse põhimõtete elluviimise riiklik kavandamine toimub Keskkonnaministeeriumi koostatud kiirgusohutuse riikliku arengukava (edaspidi arengukava) kaudu. (2) Arengukavas analüüsitakse kiirgusohutuse olukorda riigis, määratakse meetmed kiirgusohutuse tõhustamiseks ning antakse hinnang, kuidas arengukava aitab ellu viia käesoleva paragrahvi lõikes 1 viidatud eesmärki ja põhimõtteid. (3) Arengukava kinnitab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_26 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_26_v130062023026"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 26",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_26_v130062023026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnaseadustiku üldosa seaduse §-s 1 sätestatud eesmärgi ja §-des 8–13 sätestatud põhimõtete ning käesolevas seaduses sätestatud kiirgusohutuse põhimõtete elluviimise riiklik kavandamine toimub Kliimaministeeriumi koostatud kiirgusohutuse riikliku arengukava (edaspidi arengukava) kaudu. (2) Arengukavas analüüsitakse kiirgusohutuse olukorda riigis, määratakse meetmed kiirgusohutuse tõhustamiseks ning antakse hinnang, kuidas arengukava aitab ellu viia käesoleva paragrahvi lõikes 1 viidatud eesmärki ja põhimõtteid. (3) Arengukava kinnitab valdkonna eest vastutav minister käskkirjaga.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_26 (redaktsioon 130062023026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023026",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130062023026",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 26",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_27_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivsete ainete, radioaktiivseid aineid sisaldavate kiirgusallikate ja radioaktiivsete jäätmete vedu tohib korraldada ainult kiirgustegevusloa alusel. (2) Radioaktiivsete ainete konteinerid tuleb veol, ekspordil ja impordil, müügil või üleandmisel märgistada ohumärgisega ning varustada kiirgusohutusalase dokumentatsiooniga. (3) Kehtetu -- (4) Radioaktiivsete ainete pakendamise ja ohumärgisega varustamise kord ning lisatava kiirgusohutusalase dokumentatsiooni nõuded kehtestatakse Vabariigi Valitsuse määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_27 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_27_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_27_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kiirgustegevuse käigus tuvastatakse kehtestatud piirmääradest suurema kiirgusdoosi saamine, seiskab kiirgustegevusloa omaja kiirgustegevuse seniks, kuni kiirituse põhjused on välja selgitatud ja kõrvaldatud.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_27 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_27_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_27_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arengukavas käsitletavad valdkonnad on eelkõige kiirguskaitse tagamine, radioaktiivsete jäätmete käitlemine, avarii- ja püsikiirituse olukordade lahendamine, kiirgusteadlikkuse tõstmine ning loodus- ja meditsiinikiiritusega seotud probleemid.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_27 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_27_v103072017018"
      },
      "estleg:versionValidTo": {
        "@value": "2017-08-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_27_v103072017018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Arengukavas käsitletavad valdkonnad on eelkõige kiirguskaitse ja tuumaohutuse tagamine, radioaktiivsete jäätmete käitlemine, avarii- ja püsikiirituse olukordade lahendamine, kiirgusteadlikkuse suurendamine ning loodus- ja meditsiinikiiritusega seotud probleemid.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_27 (redaktsioon 103072017018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103072017018",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/103072017018",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 27",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_28_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Radioaktiivsed jäätmed on: radioaktiivseid aineid sisaldavad või nendega saastunud ained ja esemed, milles radioaktiivse aine hulk on suurem käesoleva seaduse paragrahvis 6 kehtestatud piirmääradest ja mida ei kavatseta tulevikus kasutada; radioaktiivsed ained või radioaktiivseid aineid sisaldavad kiirgusseadmed, mille omanikku ei õnnestu tuvastada; tuumarajatistes tekkinud radioaktiivsed ained või radioaktiivsete ainetega saastunud materjalid ning kasutusest lõplikult välja viidud tuumarajatiste radioaktiivsed koostisosad.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_28 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_28_v193824"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 28",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_28_v193824",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Radioaktiivsed jäätmed on: radioaktiivseid aineid sisaldavad või nendega saastunud ained ja esemed, milles radioaktiivse aine hulk on suurem käesoleva seaduse §-s 6 kehtestatud piirmääradest ja mida ei kavatseta tulevikus kasutada; radioaktiivsed ained või radioaktiivseid aineid sisaldavad kiirgusseadmed, mille omanikku ei õnnestu tuvastada; tuumarajatistes tekkinud radioaktiivsed ained või radioaktiivsete ainetega saastunud materjalid ning kasutusest lõplikult välja viidud tuumarajatiste radioaktiivsed koostisosad.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_28 (redaktsioon 193824)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193824",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_28_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/193824",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 28",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_28_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgustegevusloa andmise, muutmise ja kehtetuks tunnistamise menetluse tähtajad ning kiirgustegevusloa taotluse täpsustatud nõuded, taotluse vormid ja kiirgustegevusloa vormid kehtestab keskkonnaminister määrusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_28 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_28_v13316051"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
