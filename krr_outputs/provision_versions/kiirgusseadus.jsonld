    },
    {
      "@id": "estleg:KIIRGU_Par_115_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_115"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 32 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_115 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 115",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_116_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelistel inspektoritel, kes kontrollivad Eesti Vabariigi suhtes jõustunud välislepingute tingimuste täitmist, on juurdepääs kõikidele nende välislepingute reguleerimisalasse kuuluvatele objektidele ja asjaomastele andmetele ning õigus võtta proove.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_116 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 116",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_117_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_117"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegutsemise eest kiirgustegevusloata, kui luba oli nõutav, või loa nõudeid rikkudes –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 20 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_117 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 117",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_117_1_v108072025022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_117_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegutsemise eest kiirgustegevuse registreeringuta, kui registreering oli nõutav, või registreeringu nõudeid rikkudes –karistatakse rahatrahviga kuni 150 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 10 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_117_1 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025022",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 117_1",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_118_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud kiirgustegevusloa omaja kohustuste rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 20 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_118 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_118_v108072025022"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 118",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_118_v108072025022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_118"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud kiirgustegevuse tegija kohustuste rikkumise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 20 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_118 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025022",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 118",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_119_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toiduaine, mänguasja, ehte või kosmeetikakauba valmistamisel sellele radioaktiivse aine lisamise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_119 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_119_v126062018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 119",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_119_v126062018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_119"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toiduaine, loomasööda, mänguasja või ehte valmistamisel sellele radioaktiivse aine lisamise või mänguasja või ehet valmistades selles kasutatava materjali aktiveerimise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_119 (redaktsioon 126062018009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018009",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018009",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 119",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_12_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kutsekiiritus on see osa kiiritusest, mida saab kiirgustöötaja käesoleva seaduse nõuete kohaselt registreeritud kiirgusallikatelt nendega töötamisel. (2) Kiirgustöötaja on isik, kes oma tööülesandeid täidab kiirgusallika mõjupiirkonnas. Kiirgustöötaja tohib kiirgustegevuse käigus saada elanikukiirituse lubatud piirmäära ületavat kiiritust.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_12 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_12_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 12",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_12_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnaministeerium korraldab kiirgusohutuse riikliku arengukava eelnõu avaliku väljapaneku kestel ning avalikul istungil esitatud ettepanekute ja vastuväidete läbivaatamise ning vajadusel arengukava eelnõu muutmise. (2) Arvestamata ettepanekutele ja vastuväidetele vastab Keskkonnaministeerium kahe kuu jooksul avaliku väljapaneku lõppemisest või avalikust istungist arvates.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_12 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_12_v128062016002"
      },
      "estleg:versionValidTo": {
        "@value": "2016-10-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 12",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_12_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avariikiirituse olukord on tuuma- või kiirgusavarii, kuriteo või muu ootamatu sündmuse tagajärjel kujunenud kiiritusolukord, mille kontrolli all hoidmine nõuab inimese elu ja tervise, vara või keskkonna kaitsmiseks edasilükkamatute kaitsemeetmete rakendamist. (2) Püsikiirituse olukord on tavapärasest kiirgustasemest suurem looduslik kiiritus või minevikus toimunud kiirgustegevuse või avariikiirituse olukorra tagajärjel tekkinud kiiritus või muu mittetavapärane kiiritusolukord, mis ei nõua või enam ei nõua edasilükkamatute kaitsemeetmete rakendamist. (3) Kiirgushädaolukord on avariikiirituse olukord, millega kaasneb või võib kaasneda käesoleva seaduse § 105 lõike 3 alusel kehtestatud sekkumistasemete ületamine.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_12 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 12",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_120_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_120"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivset ainet sisaldava kiirgusallika, radioaktiivsete jäätmete või §-s 119 loetletud kauba veo eest üle riigipiiri sellekohase loata –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 20 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_120 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 120",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_121_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivset ainet sisaldava kiirgusallika või radioaktiivsete jäätmete üleandmise eest kiirgustegevusloata isikule –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 20 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_121 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_121_v108072025022"
      },
      "estleg:versionValidTo": {
        "@value": "2025-07-17",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 121",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_121_v108072025022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_121"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Radioaktiivset ainet sisaldava kiirgusallika või radioaktiivsete jäätmete üleandmise eest kiirgustegevusloata või kiirgustegevuse registreeringuta isikule –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 20 000 eurot.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_121 (redaktsioon 108072025022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072025022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108072025022",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 121",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_122_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Keskkonnainspektsioon.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_122 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_122_v110072020052"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_122_v110072020052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud väärtegude kohtuväline menetleja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_122 (redaktsioon 110072020052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110072020052",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 122",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_123_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist antud tähtajalised väikese ohuga kiirgustegevuse load kehtivad kuni nendes märgitud kehtivusaja lõpuni.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_123 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 123",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_124_v128062016002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_124"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist algatatud väikese ohuga kiirgustegevuse loa andmise menetlus viiakse lõpule keskkonnaseadustiku üldosa seaduse ja käesoleva seaduse kohaselt.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_124 (redaktsioon 128062016002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128062016002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/128062016002",
      "estleg:sourceAct": "Kiirgusseadus",
