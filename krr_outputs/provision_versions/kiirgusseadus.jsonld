      }
    },
    {
      "@id": "estleg:KIIRGU_Par_13_v22377",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aastane efektiivdoos ei tohi ületada: viie järjestikuse aasta kutsekiirituse keskmisena 20 millisiivertit; ühelgi käesoleva lõike punktis 1 nimetatud aastatest 50 millisiivertit; kutsealases väljaõppes osalevatele 16 kuni 18 aasta vanustele isikutele kuus millisiivertit. (2) Elundi aastane ekvivalentdoos ei tohi ületada: kiirgustöötaja silmaläätses 150 millisiivertit; kiirgustöötaja nahas ja jäsemetes 500 millisiivertit; rasedate naistöötajate alakehas raseduse kestel ühte millisiivertit tingimusel, et rasedate naiste kiirgustöö korraldus raseduse kestel välistaks loote kiirguskahjustuse; kutsealases väljaõppes osalevate 16 kuni 18 aasta vanuste isikute silmaläätses 50 millisiivertit; kutsealases väljaõppes osalevate 16 kuni 18 aasta vanuste isikute nahas ja jäsemetes 150 millisiivertit. (3) Vabariigi Valitsusel on õigus kehtestada täiendavaid normatiive ja nende rakendamise korda, et tagada käesolevas paragrahvis nimetatud kutsekiirituse piirmääradest kinnipidamine.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_13 (redaktsioon 22377)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22377",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_13_v735303"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22377",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 13",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_13_v735303",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirgusohutuse riikliku arengukava kinnitab Vabariigi Valitsus korraldusega.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_13 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_13_v109112011006"
      },
      "estleg:versionValidTo": {
        "@value": "2011-11-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/735303",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 13",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_13_v109112011006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KIIRGU_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirgusohutuse riikliku arengukava kinnitab Vabariigi Valitsus korraldusega. (2) Tegevuskavad kiirgusohutuse riiklikus arengukavas kavandatavate eesmärkide saavutamiseks kinnitab keskkonnaminister käskkirjaga.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_13 (redaktsioon 109112011006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109112011006",
      "estleg:supersededByVersion": {
        "@id": "estleg:KIIRGU_Par_13_v113032014040"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109112011006",
      "estleg:sourceAct": "Kiirgusseadus",
      "estleg:provisionRef": "KIIRGU § 13",
      "estleg:partOfAct": {
        "@id": "estleg:KIIRGU_Map"
      }
    },
    {
      "@id": "estleg:KIIRGU_Par_13_v113032014040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
