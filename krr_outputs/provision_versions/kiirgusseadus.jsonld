      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirguskeskus korraldab kiirgushädaolukorras võimaliku radioaktiivse aine ajalise ja ruumilise laialikandumise ning võimaliku saadava kiirituse hindamist ja nõustab kiirgushädaolukorra lahendamist juhtivaid struktuuriüksusi kiirgushädaolukorra ulatusest sõltuvalt.",
      "rdfs:label": {
        "@value": "KIIRGU_Par_55 (redaktsioon 735303)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "735303",
