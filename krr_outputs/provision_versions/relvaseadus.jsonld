      }
    },
    {
      "@id": "estleg:RelvS_Par_58_v119032015018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Relva ja selle laskemoona kommertseesmärgil kasutatava õhusõiduki reisijatesalongi kaasavõtmise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "RelvS_Par_58 (redaktsioon 119032015018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015018"
    },
    {
      "@id": "estleg:RelvS_Par_59_v27150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses mõistetakse relvade ja laskemoona üle tollipiiri toimetamise all relvade ja laskemoona sisse- ja väljavedu, transiiti ning sissetoomist ja väljaviimist. [Lõike 2 sõnastus kuni 30. 06. 2002] (2) Relvade ja laskemoona üle tollipiiri toimetamine toimub käesoleva seaduse, tolliseaduse (RT I 1998, 3, 54; 1999, 86, 782; 90, õiend; 97, 895; 102, 907; 2000, 95, 608) ja strateegilise kauba sisse- ja väljaveo ning transiidi seaduse (RT I 1999, 57, 597) ning nende alusel antud õigusaktidega kehtestatud korras. [Lõike 2 sõnastus alates 1. 07. 2002] (2) Relvade ja laskemoona üle tollipiiri toimetamine toimub käesoleva seaduse, tolliseadustiku ning strateegilise kauba sisse- ja väljaveo ning transiidi seaduse (RT I 1999, 57, 597) ja nende alusel antud õigusaktidega kehtestatud korras. (3) Relvade ja laskemoona üle tollipiiri toimetamine võib käesoleva seaduse kohaselt toimuda üksnes Politseiameti ühekordse eriloa alusel. (4) Eriloa väljastamise ja vormistamise korra, eriloa alusel üle tollipiiri toimetatavate relvade, tulirelva oluliste osade, lisaseadiste ja laskemoona nomenklatuuri ning eriloa vormi kehtestab siseminister määrusega.",
      "rdfs:label": {
        "@value": "RelvS_Par_59 (redaktsioon 27150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27150",
      "estleg:supersededByVersion": {
        "@id": "estleg:RelvS_Par_59_v178731"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RelvS_Par_59_v178731",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_59"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses mõistetakse relvade ja laskemoona üle tollipiiri toimetamise all relvade ja laskemoona sisse- ja väljavedu, transiiti ning sissetoomist ja väljaviimist. (2) Relvade ja laskemoona üle tollipiiri toimetamine toimub käesoleva seaduse, tolliseadustiku ning strateegilise kauba sisse- ja väljaveo ning transiidi seaduse (RT I 1999, 57, 597) ja nende alusel antud õigusaktidega kehtestatud korras. (3) Relvade ja laskemoona üle tollipiiri toimetamine võib käesoleva seaduse kohaselt toimuda üksnes Politseiameti ühekordse eriloa alusel. (4) Eriloa väljastamise ja vormistamise korra, eriloa alusel üle tollipiiri toimetatavate relvade, tulirelva oluliste osade, lisaseadiste ja laskemoona nomenklatuuri ning eriloa vormi kehtestab siseminister määrusega.",
      "rdfs:label": {
        "@value": "RelvS_Par_59 (redaktsioon 178731)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "178731",
