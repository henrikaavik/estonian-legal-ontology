      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulirelva laskemoonaks olevate kuni 12,7 mm kaliibriliste padrunite ebaolulises koguses ebaseadusliku käitlemise eest, tingimusel et käitlejal puudus juurdepääs nende padrunite kasutamiseks ettenähtud tulirelvale ja käideldud laskemoon ei olnud lõhke- või süütekuuliga, või gaasirelvapadrunite ebaseadusliku käitlemise eest – karistatakse rahatrahviga kuni kolmsada trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "RelvS_Par_89_13 (redaktsioon 12791954)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12791954",
      "estleg:supersededByVersion": {
        "@id": "estleg:RelvS_Par_89_13_v13122531"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RelvS_Par_89_13_v13122531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_89_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulirelva laskemoonaks olevate sileraudse tulirelva padrunite ja kuni 12,7 mm kaliibriliste vintraudse tulirelva padrunite ebaolulises koguses ebaseadusliku käitlemise eest, tingimusel et käitlejal puudus juurdepääs nende padrunite kasutamiseks ettenähtud tulirelvale ja käideldud laskemoon ei olnud lõhke- või süütekuuliga, või gaasirelvapadrunite ebaseadusliku käitlemise eest – karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "RelvS_Par_89_13 (redaktsioon 13122531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13122531",
      "estleg:supersededByVersion": {
        "@id": "estleg:RelvS_Par_89_13_v127122010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
