    {
      "@id": "estleg:RelvS_Par_89_2_v27150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_89_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidilise isiku poolt elektrišokirelva või tsiviilkäibes keelatud külmrelva valmistamise, soetamise, omamise, hoidmise, müümise, edasitoimetamise, vedamise või muu ebaseadusliku käitlemise eest - karistatakse kuni 50 000-kroonise rahatrahviga.",
      "rdfs:label": {
        "@value": "RelvS_Par_89_2 (redaktsioon 27150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27150",
      "estleg:supersededByVersion": {
        "@id": "estleg:RelvS_Par_89_2_v193886"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RelvS_Par_89_2_v193886",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_89_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektrišokirelva või tsiviilkäibes keelatud külmrelva valmistamise, soetamise, omamise, hoidmise, müümise, kandmise, edasitoimetamise, vedamise või muu ebaseadusliku käitlemise eest – karistatakse rahatrahviga kuni 200 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "RelvS_Par_89_2 (redaktsioon 193886)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "193886",
