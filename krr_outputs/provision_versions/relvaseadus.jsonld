      }
    },
    {
      "@id": "estleg:RelvS_Par_88_v127122010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet tsiviilkäibes olevate relvade, tulirelva osade ja laskemoona käitlemise üle teostavad politseiasutused ning relvade ja laskemoona sisseveo, väljaveo ja edasitoimetamise seaduslikkuse üle Maksu- ja Tolliamet. (2) Järelevalvet sõjaväerelvade ja teenistusrelvade käitlemise üle teostavad (3) Järelevalvet käesoleva seaduse ja selle alusel antud õigusaktide täitmise üle asutuste poolt teostavad ka nende kõrgemalseisvad asutused.",
      "rdfs:label": {
        "@value": "RelvS_Par_88 (redaktsioon 127122010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127122010009",
