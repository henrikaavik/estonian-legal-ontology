        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib kohaldada käesoleva seaduse §-des 89 1 -89 4 sätestatud haldusõiguserikkumiste vahetuks objektiks olnud aine või eseme erikonfiskeerimist.",
      "rdfs:label": {
        "@value": "RelvS_Par_89_7 (redaktsioon 27150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27150",
      "estleg:supersededByVersion": {
