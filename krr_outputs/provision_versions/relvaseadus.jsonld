      }
    },
    {
      "@id": "estleg:RelvS_Par_88_v13338488",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalvet tsiviilkäibes olevate relvade, tulirelva osade ja laskemoona käitlemise üle teostavad politseiasutused ning relvade ja laskemoona sisseveo, väljaveo ja edasitoimetamise seaduslikkuse üle Maksu- ja Tolliamet. (3) Järelevalvet käesoleva seaduse ja selle alusel antud õigusaktide täitmise üle asutuste poolt teostavad ka nende kõrgemalseisvad asutused.",
      "rdfs:label": {
        "@value": "RelvS_Par_88 (redaktsioon 13338488)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13338488",
