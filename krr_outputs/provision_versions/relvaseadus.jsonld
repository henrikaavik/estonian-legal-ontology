      "rdfs:label": {
        "@value": "RelvS_Par_80 (redaktsioon 186504)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186504",
      "estleg:supersededByVersion": {
        "@id": "estleg:RelvS_Par_80_v780438"
      },
