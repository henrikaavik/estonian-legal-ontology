        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulirelva laskemoona ebaolulises koguses ebaseadusliku käitlemise eest või gaasirelvapadrunite ebaseadusliku käitlemise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "RelvS_Par_89_13 (redaktsioon 112072014121)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014121"
    },
