      }
    },
    {
      "@id": "estleg:RelvS_Par_73_v780438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RelvS_Par_73"
      },
      "estleg:versionValidFrom": {
