      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saastetasu rakendatakse, kui välisõhku viiakse: vääveldioksiidi (SO2) või muid anorgaanilisi väävliühendeid; süsinikmonooksiidi (CO); süsinikdioksiidi (CO2); tahkeid osakesi; lämmastikoksiide või muid anorgaanilisi lämmastikuühendeid; lenduvaid orgaanilisi ühendeid; raskmetalle või nende ühendeid.",
      "rdfs:label": {
