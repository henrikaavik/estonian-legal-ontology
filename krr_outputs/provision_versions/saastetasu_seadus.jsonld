    },
    {
      "@id": "estleg:SaasteTS_Par_25_v22442",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SaasteTS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteainete või jäätmete keskkonda viimisel kemikaalide või jäätmete transportimise käigus maksab saastetasu transporditavate kemikaalide või jäätmete keskkonda sattumise põhjustanud transpordivahendi valdaja. (2) Saasteainete või jäätmete keskkonda viimisel kemikaalide või jäätmete transportimise käigus rakendatakse käesoleva seaduse paragrahvis 24 sätestatud saastetasu määrasid.",
      "rdfs:label": {
        "@value": "SaasteTS_Par_25 (redaktsioon 22442)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22442",
      "estleg:supersededByVersion": {
        "@id": "estleg:SaasteTS_Par_25_v186684"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22442",
      "estleg:sourceAct": "Saastetasu seadus",
      "estleg:provisionRef": "SaasteTS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:SaasteTS_Map"
      }
    },
    {
      "@id": "estleg:SaasteTS_Par_25_v186684",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SaasteTS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteainete või jäätmete keskkonda viimisel kemikaalide või jäätmete transportimise käigus maksab saastetasu transporditavate kemikaalide või jäätmete keskkonda sattumise põhjustanud transpordivahendi valdaja. (2) Saasteainete või jäätmete keskkonda viimisel kemikaalide või jäätmete transportimise käigus rakendatakse käesoleva seaduse §-s 24 sätestatud saastetasu määrasid.",
      "rdfs:label": {
        "@value": "SaasteTS_Par_25 (redaktsioon 186684)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186684",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186684",
      "estleg:sourceAct": "Saastetasu seadus",
      "estleg:provisionRef": "SaasteTS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:SaasteTS_Map"
      }
    },
    {
      "@id": "estleg:SaasteTS_Par_26_v22442",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SaasteTS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteainete või jäätmete merevette viimisel ujuvvahendilt või naftaterminalist maksab saastetasu ujuvvahendi või naftaterminali valdaja. (2) Nafta, naftasaaduste, mineraalõli ning tahke kütuse ja muu orgaanilise aine termilise töötlemise vedelproduktide merevette viimisel ujuvvahendilt või naftaterminalist rakendatakse käesoleva seaduse paragrahv 9 lõike 1 punktis 7 sätestatud saastetasu 50-kordset määra. (3) Jäätmete merevette viimisel ujuvvahendilt või naftaterminalist rakendatakse käesoleva seaduse Paragrahv 24 lõikes 4 sätestatud saastetasu määrasid. (4) Käesolevas seaduses on naftat, naftasaadusi, mineraalõli ning tahke kütuse ja muu orgaanilise aine termilise töötlemise vedelprodukte sisaldav ballastvesi ja pilsivesi võrdsustatud paragrahv 9 lõike 1 punktis 7 nimetatud saasteainetega.",
      "rdfs:label": {
        "@value": "SaasteTS_Par_26 (redaktsioon 22442)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22442",
      "estleg:supersededByVersion": {
        "@id": "estleg:SaasteTS_Par_26_v186684"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22442",
      "estleg:sourceAct": "Saastetasu seadus",
      "estleg:provisionRef": "SaasteTS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:SaasteTS_Map"
      }
    },
    {
      "@id": "estleg:SaasteTS_Par_26_v186684",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SaasteTS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saasteainete või jäätmete merevette viimisel ujuvvahendilt või naftaterminalist maksab saastetasu ujuvvahendi või naftaterminali valdaja. (2) Nafta, naftasaaduste, mineraalõli ning tahke kütuse ja muu orgaanilise aine termilise töötlemise vedelproduktide merevette viimisel ujuvvahendilt või naftaterminalist rakendatakse käesoleva seaduse § 9 lõike 1 punktis 7 sätestatud saastetasu 50-kordset määra. (3) Jäätmete merevette viimisel ujuvvahendilt või naftaterminalist rakendatakse käesoleva seaduse § 24 lõikes 4 sätestatud saastetasu määrasid. (4) Käesolevas seaduses on naftat, naftasaadusi, mineraalõli ning tahke kütuse ja muu orgaanilise aine termilise töötlemise vedelprodukte sisaldav ballastvesi ja pilsivesi võrdsustatud § 9 lõike 1 punktis 7 nimetatud saasteainetega.",
      "rdfs:label": {
        "@value": "SaasteTS_Par_26 (redaktsioon 186684)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186684",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/186684",
      "estleg:sourceAct": "Saastetasu seadus",
      "estleg:provisionRef": "SaasteTS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:SaasteTS_Map"
      }
    },
    {
      "@id": "estleg:SaasteTS_Par_27_v22442",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SaasteTS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saastetasu selle kõrgendatud määra järgi arvutatakse saasteainete või jäätmete tegelikult mõõdetud või dokumentaalselt tõendatud koguste kohta. (2) Kui keskkonda viidud saasteaineid või jäätmeid ei ole võimalik mõõta ega nende kogust dokumentaalselt tõendada, arvutatakse kogused keskkonnaministri kinnitatud metoodika alusel. (3) Saastetasu selle kõrgendatud määra järgi arvutab keskkonnateenistus või tema nõusolekul saastaja. (4) Kõrgendatud määra järgi arvutatud saastetasu nõutakse sisse käesoleva seaduse paragrahvis 22 sätestatud korras, kui saastaja ja keskkonnateenistus ei ole kirjalikult kokku leppinud maksmise teistsugustes tähtaegades ja viisis.",
      "rdfs:label": {
        "@value": "SaasteTS_Par_27 (redaktsioon 22442)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22442",
      "estleg:supersededByVersion": {
        "@id": "estleg:SaasteTS_Par_27_v186684"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22442",
      "estleg:sourceAct": "Saastetasu seadus",
      "estleg:provisionRef": "SaasteTS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:SaasteTS_Map"
      }
    },
