      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13149444",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 69",
      "estleg:partOfAct": {
        "@id": "estleg:MTUS_Map"
      }
    },
    {
      "@id": "estleg:MTUS_Par_69_v13278757",
      "@type": [
        "owl:NamedIndividual",
