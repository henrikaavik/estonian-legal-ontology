      }
    },
    {
      "@id": "estleg:MTUS_Par_89_1_v12769860",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_89_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtunik ega kohtunikuabi ei või läbi vaadata mittetulundusühingu ega sihtasutuse registriasja, kui: mittetulundusühingu või sihtasutuse asutajaks või juhatuse liikmeks või sihtasutuse nõukogu liikmeks või sihtasutuse audiitoriks on kandemääruse tegemiseks pädev isik või tema abikaasa või elukaaslane või muu tsiviilkohtumenetluse seadustiku § 23 punktides 2 ja 3 nimetatud isik; muud asjaolud tekitavad kahtlusi tema erapooletuses.",
      "rdfs:label": {
        "@value": "MTÜS_Par_89_1 (redaktsioon 12769860)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769860",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTUS_Par_89_1_v123122022015"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12769860",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 89_1",
      "estleg:partOfAct": {
