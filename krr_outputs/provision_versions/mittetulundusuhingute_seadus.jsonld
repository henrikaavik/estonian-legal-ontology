    {
      "@id": "estleg:MTUS_Par_89_v109052017021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_89"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühingu registrikaardile kantakse tema kohta järgmised andmed: registrikood ja registrikannete järjekorranumbrid; nimi; asukoht ja aadress; juhatuse liikme andmed; äriseadustiku §-s 631 nimetatud kontaktisiku nimi või ärinimi, isiku- või registrikood ning mittetulundusühingule suunatud tahteavalduste ja mittetulundusühingu menetlusdokumentide kättetoimetamise aadress; pankrotihalduri andmed; likvideerija andmed; juhatuse liikmete ja likvideerijate esindusõiguse kord, kui see erineb seaduses ettenähtud üldreeglist; põhikirja kinnitamise aeg; majandusaasta algus ja lõpp; tegutsemistähtaeg, kui mittetulundusühing on asutatud tähtajaliselt; lõpetamine; ühinemine ja jagunemine; pankroti väljakuulutamine ning pankrotimenetluse lõppemine; registrist kustutamine; likvideeritud ühingu dokumentide hoidja andmed; kande kuupäev; viited varasematele ja hilisematele kannetele ning märkused.",
      "rdfs:label": {
        "@value": "MTÜS_Par_89 (redaktsioon 109052017021)",
        "@language": "et"
      },
