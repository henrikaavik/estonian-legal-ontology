    },
    {
      "@id": "estleg:MTUS_Par_111_1_v12985059",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_111_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 36 lõiget 5 kohaldatakse majandusaasta aruandele, mis on koostatud aruandeperioodi kohta, mis algab 2009. aasta 1. jaanuaril või hiljem. Majandusaasta aruanded varasemate aruandeperioodide kohta esitatakse Maksu- ja Tolliameti piirkondlikule struktuuriüksusele, lähtudes tulumaksuseaduse §-st 55.",
      "rdfs:label": {
        "@value": "MTÜS_Par_111_1 (redaktsioon 12985059)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12985059",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12985059",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 111_1",
      "estleg:partOfAct": {
        "@id": "estleg:MTUS_Map"
      }
    },
    {
      "@id": "estleg:MTUS_Par_111_2_v118122012030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_111_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registris olevate mittetulundusühingute majandusaasta alguse ja lõpu kannab registripidaja registrisse põhikirja järgi ilma kandeavalduse ja kandemääruseta. Kandele ei kohaldata äriseadustiku § 61 ega tsiviilkohtumenetluse seadustiku § 599 teist lauset ning selle eest ei võeta riigilõivu.",
      "rdfs:label": {
        "@value": "MTÜS_Par_111_2 (redaktsioon 118122012030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012030",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTUS_Par_111_2_v121032014026"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118122012030",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 111_2",
      "estleg:partOfAct": {
        "@id": "estleg:MTUS_Map"
      }
    },
    {
      "@id": "estleg:MTUS_Par_111_2_v121032014026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
