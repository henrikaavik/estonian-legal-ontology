      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registris olevate mittetulundusühingute majandusaasta alguse ja lõpu kannab registripidaja registrisse põhikirja järgi ilma kandeavalduse ja kandemääruseta. Kandele ei kohaldata käesoleva seaduse § 82 ega tsiviilkohtumenetluse seadustiku § 599 teist lauset ning selle eest ei võeta riigilõivu.",
      "rdfs:label": {
        "@value": "MTÜS_Par_111_2 (redaktsioon 121032014026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032014026",
