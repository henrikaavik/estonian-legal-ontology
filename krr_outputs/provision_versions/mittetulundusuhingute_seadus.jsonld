      }
    },
    {
      "@id": "estleg:MTUS_Par_90_v22358",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrikaarte hoitakse vastavalt registrikoodidele. (2) Ühe mittetulundusühingu registrikaarte tuleb hoida koos. (3) Registrist kustutatud mittetulundusühingute registrikaardid tuleb registrikartoteegist eraldada ja hoida lahus.",
      "rdfs:label": {
        "@value": "MTÜS_Par_90 (redaktsioon 22358)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22358",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTUS_Par_90_v118122012030"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22358",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 90",
      "estleg:partOfAct": {
        "@id": "estleg:MTUS_Map"
      }
    },
    {
      "@id": "estleg:MTUS_Par_90_v118122012030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
