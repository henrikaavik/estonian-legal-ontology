    },
    {
      "@id": "estleg:MTUS_Par_89_1_v22358",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_89_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrissekandmise otsustamiseks pädev isik ei või osa võtta kandeavalduse menetlemisest ega teha kandeotsust või kohtumäärust, kui: ta ise või tema sugulane või hõimlane tsiviilkohtupidamise seadustiku (RT I 1993, 31/32, 538; 1994, 1, 5; 1995, 29, 358; 1996, 3, 57; 42, 811; 1997, 87, 1466; 1998, 43-45, 666) paragrahv 18 lõike 1 punktis 2 nimetatud ulatuses on mittetulundusühingu või sihtasutuse asutaja või juhatuse liige või sihtasutuse nõukogu liige või sihtasutuse audiitor; muud asjaolud tekitavad kahtlusi tema erapooletuses.",
      "rdfs:label": {
        "@value": "MTÜS_Par_89_1 (redaktsioon 22358)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22358",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTUS_Par_89_1_v693592"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22358",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 89_1",
      "estleg:partOfAct": {
        "@id": "estleg:MTUS_Map"
      }
    },
    {
      "@id": "estleg:MTUS_Par_89_1_v693592",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
