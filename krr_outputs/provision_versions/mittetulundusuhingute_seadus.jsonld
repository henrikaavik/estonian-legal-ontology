      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MTÜS_Par_78_1 (redaktsioon 123122022015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122022015",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 78_1",
      "estleg:partOfAct": {
