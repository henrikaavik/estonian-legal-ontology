      },
      "estleg:versionValidTo": {
        "@value": "2010-03-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13149444",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:MTUS_Map"
      }
    },
    {
      "@id": "estleg:MTUS_Par_40_v13278757",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mittetulundusühing lõpetatakse kohtumäärusega siseministri või muu huvitatud isiku nõudel: kui mittetulundusühingu tegevus ei vasta tema põhikirjalistele eesmärkidele; kui mittetulundusühingu põhitegevuseks saab majandustegevus; muudel tsiviilseadustiku üldosa seaduse §-s 40 sätestatud alustel. (2) Kehtetu - (3) Kohus võib sundlõpetamise otsustada ka omal algatusel, kui seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "MTÜS_Par_40 (redaktsioon 13278757)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13278757",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTUS_Par_40_v121032014027"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13278757",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 40",
      "estleg:partOfAct": {
