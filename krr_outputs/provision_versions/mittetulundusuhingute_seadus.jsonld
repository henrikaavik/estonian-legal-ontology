    {
      "@id": "estleg:MTUS_Par_41_v13149444",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mittetulundusühingu lõpetamisel peab juhatus esitama avalduse lõpetamise kandmiseks registrisse. (2) Kui lõpetamise aluseks on üldkoosoleku otsus, lisatakse avaldusele üldkoosoleku otsus ja üldkoosoleku protokoll. (3) Kui mittetulundusühing lõpetatakse kohtumääruse alusel, saadab kohus määruse registripidajale kande tegemiseks. (4) Mittetulundusühing loetakse lõpetatuks alates lõpetamise kande tegemisest registrisse. Sundlõpetamine jõustub kohtumääruse jõustumisega.",
      "rdfs:label": {
        "@value": "MTÜS_Par_41 (redaktsioon 13149444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13149444",
      "estleg:supersededByVersion": {
        "@id": "estleg:MTUS_Par_41_v123122022015"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13149444",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 41",
      "estleg:partOfAct": {
