      "estleg:versionText": "Juhatus korraldab mittetulundusühingu raamatupidamise vastavalt raamatupidamise seadusele (RT I 1994, 48, 790; 1995, 26-28, 355; 92, 1604; 1996, 40, 773).",
      "rdfs:label": {
        "@value": "MTÜS_Par_35 (redaktsioon 22358)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22358",
