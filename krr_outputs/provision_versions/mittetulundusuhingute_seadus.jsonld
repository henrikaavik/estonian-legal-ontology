      }
    },
    {
      "@id": "estleg:MTUS_Par_41_v123122022015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mittetulundusühingu lõpetamisel peab juhatus esitama avalduse lõpetamise kandmiseks registrisse. (2) Kui lõpetamise aluseks on üldkoosoleku otsus, lisatakse avaldusele üldkoosoleku otsus ja üldkoosoleku protokoll. (3) Kui mittetulundusühing lõpetatakse kohtumääruse alusel, saadab kohus määruse registripidajale kande tegemiseks. (4) Kehtetu -",
      "rdfs:label": {
        "@value": "MTÜS_Par_41 (redaktsioon 123122022015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122022015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/123122022015",
      "estleg:sourceAct": "Mittetulundusühingute seadus",
      "estleg:provisionRef": "MTÜS § 41",
      "estleg:partOfAct": {
