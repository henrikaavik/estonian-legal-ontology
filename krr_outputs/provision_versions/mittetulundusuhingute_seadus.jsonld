      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus võib kooskõlas käesoleva seadusega anda määrusi käesoleva seaduse rakendamiseks. (2) võib anda määrusi registriosakondade tegevuse korraldamiseks. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „Justiitsminister“ sõnadega „Valdkonna eest vastutav minister“.",
      "rdfs:label": {
