        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mittetulundusühing lõpetatakse: üldkoosoleku otsusega; mittetulundusühingu pankroti väljakuulutamisega või pankrotimenetluse raugemisega enne pankroti väljakuulutamist; mittetulundusühingu liikmete arvu vähenemisel alla kahe või muu seaduses või põhikirjas sätestatud suuruse; üldkoosoleku võimetuse korral määrata seaduses või põhikirjaga ettenähtud organite liikmed; tähtaja möödumisel, kui mittetulundusühing oli tähtajaline; muul seaduses või põhikirjaga ettenähtud alusel.",
