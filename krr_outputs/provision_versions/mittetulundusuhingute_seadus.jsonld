    {
      "@id": "estleg:MTUS_Par_45_v22358",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MTUS_Par_45"
      },
      "estleg:versionValidFrom": {
