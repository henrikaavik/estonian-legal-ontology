      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus võib kooskõlas käesoleva seadusega anda määrusi käesoleva seaduse rakendamiseks. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "MTÜS_Par_111 (redaktsioon 121062014042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014042",
