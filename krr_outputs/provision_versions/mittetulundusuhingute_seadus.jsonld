      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhatus korraldab mittetulundusühingu raamatupidamise vastavalt raamatupidamise seadusele.",
      "rdfs:label": {
        "@value": "MTÜS_Par_35 (redaktsioon 928241)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928241",
