      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ravimialase arvestuse eeskirjad tervishoiuteenuse või veterinaarteenuse osutamisel ning hoolekandeasutuses (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ravimialase arvestuse eeskirjad tervishoiuteenuse või veterinaarteenuse osutamisel ning hoolekandeasutuses"
    },
    {
      "@id": "estleg:Reg_158495_Par_1_v158495",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
