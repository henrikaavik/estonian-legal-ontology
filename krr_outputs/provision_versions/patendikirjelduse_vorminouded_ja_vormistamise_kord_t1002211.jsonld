    {
      "@id": "estleg:Reg_1002211_Par_8_v1002211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002211_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Patendikirjeldusest tehakse vähemalt kaks ärakirja, millest üht kasutatakse patendikirja koostamiseks ja teine edastatakse avalikustamiseks juriidilisele isikule, kellega riik on sõlminud vastava lepingu. RT I 2013-05-31 2 131052013002 2013-06-03 Patendikirjeldusest tehakse vähemalt kaks ärakirja, millest üht kasutatakse patendikirja koostamiseks ja teine edastatakse avalikustamiseks juriidilisele isikule, kellega riik on sõlminud vastava lepingu. 2 (2) Patendiamet võib valmistada patendikirjeldusest seoses registrist teabe väljastamisega piiranguteta vajaliku arvu ärakirju ja levitada ärakirja avalikes digitaalsetes andmebaasides. Patendiamet võib valmistada patendikirjeldusest seoses registrist teabe väljastamisega piiranguteta vajaliku arvu ärakirju ja levitada ärakirja avalikes digitaalsetes andmebaasides.",
      "rdfs:label": {
        "@value": "Reg_1002211_Par_8 (redaktsioon 1002211)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002211",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002211",
      "estleg:sourceAct": "Patendikirjelduse vorminõuded ja vormistamise kord",
      "estleg:provisionRef": "Reg_1002211 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002211_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1002211_Par_9_v1002211",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002211_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Patendikirjeldus avaldatakse patendi väljaandmise teate Eesti Patendilehes avaldamise päeval. Patendikirjeldus avaldatakse patendi väljaandmise teate Eesti Patendilehes avaldamise päeval. 2 (2) Juriidiline isik, kellega riik on sõlminud vastava lepingu, paneb patendi väljaandmise teate Eesti Patendilehes avaldamise päeval avalikuks tutvumiseks välja vähemalt ühe eksemplari patendikirjelduse ärakirja. RT I 2013-05-31 2 131052013002 2013-06-03 Juriidiline isik, kellega riik on sõlminud vastava lepingu, paneb patendi väljaandmise teate Eesti Patendilehes avaldamise päeval avalikuks tutvumiseks välja vähemalt ühe eksemplari patendikirjelduse ärakirja.",
      "rdfs:label": {
