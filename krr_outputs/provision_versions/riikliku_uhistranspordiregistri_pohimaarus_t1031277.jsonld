      "estleg:provisionRef": "Reg_1031277 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031277_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031277_Par_3_v1031277",
      "@type": [
        "owl:NamedIndividual",
