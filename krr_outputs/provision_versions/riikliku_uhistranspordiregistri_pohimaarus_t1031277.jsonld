    {
      "@id": "estleg:Reg_1031277_Par_8_v1031277",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031277_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriandmetel on informatiivne ja statistiline tähendus. Andmete registrisse kandmine ei too endaga kaasa õiguslikke tagajärgi, kui seaduses ei ole sätestatud teisiti. Registriandmetel on informatiivne ja statistiline tähendus. Andmete registrisse kandmine ei too endaga kaasa õiguslikke tagajärgi, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "Reg_1031277_Par_8 (redaktsioon 1031277)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031277",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031277",
      "estleg:sourceAct": "Riikliku ühistranspordiregistri põhimäärus",
