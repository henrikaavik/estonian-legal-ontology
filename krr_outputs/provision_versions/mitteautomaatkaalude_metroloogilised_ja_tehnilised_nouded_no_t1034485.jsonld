      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mitteautomaatkaalude metroloogilised ja tehnilised nõuded, nõuded projekteerimisele, konstruktsioonile, märgistusele, vastavushindamisele ja tõendamisele (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mitteautomaatkaalude metroloogilised ja tehnilised nõuded, nõuded projekteerimisele, konstruktsioonile, märgistusele, vastavushindamisele ja tõendamisele"
    },
    {
      "@id": "estleg:Reg_1034485_Par_1_v1034485",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
