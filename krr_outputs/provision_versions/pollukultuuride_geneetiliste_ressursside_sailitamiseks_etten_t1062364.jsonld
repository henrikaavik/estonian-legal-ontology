      "estleg:provisionRef": "Reg_1062364 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062364_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062364_Par_3_v1062364",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062364_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandusministri 24. märtsi 2006. a määruse nr 38 „Sordi sordilehte võtmise kord ning sordilehte võetavate taimeliikide loetelu, põllu- ja köögiviljakultuuri liigi kontrollimisel minimaalselt hõlmatavad tunnused ning järelevalve käigus sordi säilimise kontrollimise nõuded” normitehnilist märkust täiendatakse läbivalt pärast tekstiosa „(EL) 2024/2963 (ELT L, 2024/2963, 02.12.2024)” tekstiosaga „, (EL) 2025/1079 (ELT L, 2025/1079, 03.06.2025)”. Põllumajandusministri 24. märtsi 2006. a määruse nr 38 „Sordi sordilehte võtmise kord ning sordilehte võetavate taimeliikide loetelu, põllu- ja köögiviljakultuuri liigi kontrollimisel minimaalselt hõlmatavad tunnused ning järelevalve käigus sordi säilimise kontrollimise nõuded” normitehnilist märkust täiendatakse läbivalt pärast tekstiosa „(EL) 2024/2963 (ELT L, 2024/2963, 02.12.2024)” tekstiosaga „, (EL) 2025/1079 (ELT L, 2025/1079, 03.06.2025)”.",
      "rdfs:label": {
