    {
      "@id": "estleg:Reg_303772_Par_13_v303772",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303772_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud 1 1) majandustegevus; 2 2) telkimine ja lõkke tegemine ainult kohtades, mille kaitseala valitseja on selleks ette valmistanud ja tähistanud; 3 3) kuni 40 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Piiranguvööndis on lubatud majandustegevus; telkimine ja lõkke tegemine ainult kohtades, mille kaitseala valitseja on selleks ette valmistanud ja tähistanud; kuni 40 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) ehitise, kaasa arvatud ajutise ehitise püstitamine; 2 2) rohkem kui 40 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: ehitise, kaasa arvatud ajutise ehitise püstitamine; rohkem kui 40 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas.",
      "rdfs:label": {
        "@value": "Reg_303772_Par_13 (redaktsioon 303772)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303772",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303772",
      "estleg:sourceAct": "Järvselja looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_303772 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_303772_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_303772_Par_14_v303772",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303772_Par_14"
