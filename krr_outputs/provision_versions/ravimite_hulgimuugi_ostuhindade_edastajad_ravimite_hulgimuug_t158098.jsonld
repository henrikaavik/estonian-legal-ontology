      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ravimite hulgimüügi ostuhindade edastajad, ravimite hulgimüügi ostuhindade edastamise tingimused ja kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ravimite hulgimüügi ostuhindade edastajad, ravimite hulgimüügi ostuhindade edastamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_158098_Par_1_v158098",
      "@type": [
        "owl:NamedIndividual",
