    {
      "@id": "estleg:Reg_336150_Par_2_v336150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336150_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahalist abi antakse üksnes sihtotstarbega katta täielikult või osaliselt hädasolija asukohariigist Eestisse tagasipöördumise sõidukulud või muud tagasipöördumisega seotud vältimatud kulutused. Rahalist abi antakse üksnes sihtotstarbega katta täielikult või osaliselt hädasolija asukohariigist Eestisse tagasipöördumise sõidukulud või muud tagasipöördumisega seotud vältimatud kulutused.",
      "rdfs:label": {
        "@value": "Reg_336150_Par_2 (redaktsioon 336150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336150",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336150",
      "estleg:sourceAct": "Konsulaarabi andmise kulude tagasimaksmise kord, tagatiseta rahalise abi taotluse vorm ning konsulaarkaitse kulude tagasimaksmise kohustuse vorm",
      "estleg:provisionRef": "Reg_336150 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336150_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336150_Par_3_v336150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336150_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnik registreerib rahalise abi andmise konsulaarametniku ametitoimingute raamatus välisministri 8. juuni 2009. a määruse nr 5 «Konsulaarametniku ametitoimingute andmekogu asutamise ja pidamise kord» §-de 6 ja 18 kohaselt. Konsulaarametnik registreerib rahalise abi andmise konsulaarametniku ametitoimingute raamatus välisministri 8. juuni 2009. a määruse nr 5 «Konsulaarametniku ametitoimingute andmekogu asutamise ja pidamise kord» §-de 6 ja 18 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_336150_Par_3 (redaktsioon 336150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336150",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336150",
      "estleg:sourceAct": "Konsulaarabi andmise kulude tagasimaksmise kord, tagatiseta rahalise abi taotluse vorm ning konsulaarkaitse kulude tagasimaksmise kohustuse vorm",
      "estleg:provisionRef": "Reg_336150 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336150_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_336150_Par_4_v336150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336150_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konsulaarametnik või aukonsul korraldab hädasolijale tema kirjaliku avalduse alusel ja tagatise olemasolu korral tagatise ulatuses rahalise abi andmise. Konsulaarametnik või aukonsul korraldab hädasolijale tema kirjaliku avalduse alusel ja tagatise olemasolu korral tagatise ulatuses rahalise abi andmise. 2 (2) Tagatiseks loetakse hädasolija volitatud isikult Välisministeeriumi või aukonsuli juhitava konsulaarasutuse arvelduskontole laekunud summat. Tagatiseks loetakse hädasolija volitatud isikult Välisministeeriumi või aukonsuli juhitava konsulaarasutuse arvelduskontole laekunud summat.",
      "rdfs:label": {
        "@value": "Reg_336150_Par_4 (redaktsioon 336150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336150",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336150",
