    {
      "@id": "estleg:Reg_336150_Par_7_v336150",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336150_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tagatiseta rahaline abi makstakse hädasolijale välja sularahas taotluse rahuldamise otsusest teavitamise päeval. Erandjuhul võib rahalise abi kanda hädasolija osutatud pangaarvele. Tagatiseta rahaline abi makstakse hädasolijale välja sularahas taotluse rahuldamise otsusest teavitamise päeval. Erandjuhul võib rahalise abi kanda hädasolija osutatud pangaarvele. 2 (2) Konsulaarametnik võib hädasolijale tagatiseta rahalist abi anda ka muul moel (lennu- või laevapileti arvete tasumine jms). Konsulaarametnik võib hädasolijale tagatiseta rahalist abi anda ka muul moel (lennu- või laevapileti arvete tasumine jms).",
      "rdfs:label": {
        "@value": "Reg_336150_Par_7 (redaktsioon 336150)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336150",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336150",
      "estleg:sourceAct": "Konsulaarabi andmise kulude tagasimaksmise kord, tagatiseta rahalise abi taotluse vorm ning konsulaarkaitse kulude tagasimaksmise kohustuse vorm",
      "estleg:provisionRef": "Reg_336150 § 7",
      "estleg:partOfAct": {
