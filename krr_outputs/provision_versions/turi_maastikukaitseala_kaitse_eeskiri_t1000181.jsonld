      "estleg:provisionRef": "Reg_1000181 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000181_Map"
      }
    },
    {
      "@id": "estleg:Reg_1000181_Par_6_v1000181",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000181_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitsealal on poollooduslike koosluste esinemisaladel vajalik rohu niitmine või loomade karjatamine ning puu- ja põõsarinde harvendamine. Kaitsealal on poollooduslike koosluste esinemisaladel vajalik rohu niitmine või loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_1000181_Par_6 (redaktsioon 1000181)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000181",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000181",
      "estleg:sourceAct": "Türi maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1000181 § 6",
