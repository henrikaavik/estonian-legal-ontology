  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_sotsiaaltoetus_valisriigist_eestisse_elama_asunud_eesti_koda_t1032966_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sotsiaaltoetus välisriigist Eestisse elama asunud Eesti kodanikule või eesti rahvusest isikule ning tema abikaasale, registreeritud elukaaslasele, lastele ja vanematele (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sotsiaaltoetus välisriigist Eestisse elama asunud Eesti kodanikule või eesti rahvusest isikule ning tema abikaasale, registreeritud elukaaslasele, lastele ja vanematele"
    },
    {
      "@id": "estleg:Reg_1032966_Par_1_v1032966",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032966_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse riikliku pensionikindlustuse seaduse §-s 7 sätestatud vanaduspensionikka jõudnud, välisriigist Eestisse elama asunud Eesti kodaniku või eesti rahvusest isiku ning temaga koos Eestisse elama asunud abikaasa, registreeritud elukaaslase, lapse ja vanema sotsiaaltoetuse (edaspidi sotsiaaltoetus) taotluse andmete ja vajalike dokumentide loetelu. RT I 2023-12-13 6 113122023006 2024-01-01 Määrusega kehtestatakse riikliku pensionikindlustuse seaduse §-s 7 sätestatud vanaduspensionikka jõudnud, välisriigist Eestisse elama asunud Eesti kodaniku või eesti rahvusest isiku ning temaga koos Eestisse elama asunud abikaasa, registreeritud elukaaslase, lapse ja vanema sotsiaaltoetuse (edaspidi sotsiaaltoetus) taotluse andmete ja vajalike dokumentide loetelu.",
      "rdfs:label": {
        "@value": "Reg_1032966_Par_1 (redaktsioon 1032966)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032966",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032966",
      "estleg:sourceAct": "Sotsiaaltoetus välisriigist Eestisse elama asunud Eesti kodanikule või eesti rahvusest isikule ning tema abikaasale, registreeritud elukaaslasele, lastele ja vanematele",
      "estleg:provisionRef": "Reg_1032966 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032966_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032966_Par_2_v1032966",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032966_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluses märgitakse järgmised andmed: 1 1) taotleja ees- ja perekonnanimi, isikukood, kontaktandmed; 2 2) arvelduskonto number; 3 3) märge, mil viisil ja mis aadressil soovitakse Sotsiaalkindlustusametilt dokumente ja teateid saada; 4 4) kinnitus selle kohta, et taotleja kuusissetulek on alla rahvapensioni määra. Taotluses märgitakse järgmised andmed: taotleja ees- ja perekonnanimi, isikukood, kontaktandmed; arvelduskonto number; märge, mil viisil ja mis aadressil soovitakse Sotsiaalkindlustusametilt dokumente ja teateid saada; kinnitus selle kohta, et taotleja kuusissetulek on alla rahvapensioni määra.",
      "rdfs:label": {
        "@value": "Reg_1032966_Par_2 (redaktsioon 1032966)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032966",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032966",
      "estleg:sourceAct": "Sotsiaaltoetus välisriigist Eestisse elama asunud Eesti kodanikule või eesti rahvusest isikule ning tema abikaasale, registreeritud elukaaslasele, lastele ja vanematele",
      "estleg:provisionRef": "Reg_1032966 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032966_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032966_Par_3_v1032966",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032966_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eesti kodanik või eesti rahvusest isik esitab toetuse taotlemisel: 1 1) isikut tõendavate dokumentide seaduse § 2 lõikes 2 või §-s 4 sätestatud dokumendi; 2 2) kodakondsust tõendava dokumendi või 3 3) eesti rahvust tõendava dokumendi. Eesti kodanik või eesti rahvusest isik esitab toetuse taotlemisel: isikut tõendavate dokumentide seaduse § 2 lõikes 2 või §-s 4 sätestatud dokumendi; kodakondsust tõendava dokumendi või eesti rahvust tõendava dokumendi. 2 (2) Välismaalane, kes kuulub eesti rahvusesse, esitab dokumendi, milles on märge kehtiva elamisloa või elamisõiguse kohta, või selle puudumisel pädeva ametiasutuse kirjaliku tõendi oma seadusliku elamise kohta Eesti Vabariigis. Välismaalane, kes kuulub eesti rahvusesse, esitab dokumendi, milles on märge kehtiva elamisloa või elamisõiguse kohta, või selle puudumisel pädeva ametiasutuse kirjaliku tõendi oma seadusliku elamise kohta Eesti Vabariigis. 3 (3) Eesti kodaniku või eesti rahvusest isiku abikaasa või registreeritud elukaaslane esitab toetuse taotlemisel: 1 1) abielu tõendava dokumendi või kooselulepingu; 2 2) abikaasa või registreeritud elukaaslase kodakondsust või rahvust tõendava dokumendi. RT I 2023-12-13 6 113122023006 2024-01-01 Eesti kodaniku või eesti rahvusest isiku abikaasa või registreeritud elukaaslane esitab toetuse taotlemisel: abielu tõendava dokumendi või kooselulepingu; abikaasa või registreeritud elukaaslase kodakondsust või rahvust tõendava dokumendi. 4 (4) Isik, kelle vanem on Eesti kodanik või eesti rahvusest välismaalane esitab toetuse taotlemisel: 1 1) sündi tõendava dokumendi; RT I 2023-12-13 6 113122023006 2024-01-01 2 2) vanema kodakondsust või rahvust tõendava dokumendi. Isik, kelle vanem on Eesti kodanik või eesti rahvusest välismaalane esitab toetuse taotlemisel: sündi tõendava dokumendi; vanema kodakondsust või rahvust tõendava dokumendi. 5 (5) Eesti kodaniku või eesti rahvusest isiku vanem esitab toetuse taotlemisel: 1 1) lapse sündi tõendava dokumendi; RT I 2023-12-13 6 113122023006 2024-01-01 2 2) lapse kodakondsust või rahvust tõendava dokumendi. Eesti kodaniku või eesti rahvusest isiku vanem esitab toetuse taotlemisel: lapse sündi tõendava dokumendi; lapse kodakondsust või rahvust tõendava dokumendi.",
      "rdfs:label": {
        "@value": "Reg_1032966_Par_3 (redaktsioon 1032966)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032966",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032966",
      "estleg:sourceAct": "Sotsiaaltoetus välisriigist Eestisse elama asunud Eesti kodanikule või eesti rahvusest isikule ning tema abikaasale, registreeritud elukaaslasele, lastele ja vanematele",
      "estleg:provisionRef": "Reg_1032966 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032966_Map"
      }
    },
    {
      "@id": "estleg:Reg_1032966_Par_3_3_v1032966",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032966_Par_3_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaaltoetuse taotlejal ei ole vaja esitada käesolevas määruses loeteletud dokumente, mille kohta on kantud andmed rahvastikuregistrisse. RT I 2023-12-13 6 113122023006 2024-01-01 Sotsiaaltoetuse taotlejal ei ole vaja esitada käesolevas määruses loeteletud dokumente, mille kohta on kantud andmed rahvastikuregistrisse.",
      "rdfs:label": {
        "@value": "Reg_1032966_Par_3_3 (redaktsioon 1032966)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032966",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032966",
      "estleg:sourceAct": "Sotsiaaltoetus välisriigist Eestisse elama asunud Eesti kodanikule või eesti rahvusest isikule ning tema abikaasale, registreeritud elukaaslasele, lastele ja vanematele",
      "estleg:provisionRef": "Reg_1032966 § 3_3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032966_Map"
      }
    },
