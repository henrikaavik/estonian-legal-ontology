  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_astangu_nahkhiirte_rohe_raunjala_pustkiviriku_ja_pruuni_raun_t1052099_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Astangu nahkhiirte, rohe-raunjala, püstkiviriku ja pruuni raunjala püsielupaiga kaitse alla võtmine ja kaitse-eeskiri (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "Astangu nahkhiirte, rohe-raunjala, püstkiviriku ja pruuni raunjala püsielupaiga kaitse alla võtmine ja kaitse-eeskiri"
    },
    {
      "@id": "estleg:Reg_1052099_Par_1_v1052099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052099_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega võetakse kaitse alla Vabariigi Valitsuse 20. mai 2004. a määruse nr 195 „I ja II kaitsekategooriana kaitse alla võetavate liikide loeteluˮ § 1 lõike 1 punkti 2 ja lõike 2 punkti 20 ning § 5 lõike 1 punkti 2 kohaselt I ja II kaitsekategooriasse kuuluvate taimeliikide kasvukohad ning § 8 lõike 2 punktide 41, 42, 43, 44, 46 ja 51 kohaselt II kaitsekategooriasse kuuluvate loomaliikide elupaigad, mis asuvad väljaspool kaitsealasid ja hoiualasid ning mida tuleb kaitsta nende liikide soodsa seisundi tagamiseks. Need liigid on rohe-raunjalg (Asplenium viride), püstkivirik (Saxifraga adscendens), pruun raunjalg (Asplenium trichomanes), veelendlane (Myotis daubentoni), tiigilendlane (Myotis dasycneme), tõmmulendlane (Myotis brandtii), habelendlane (Myotis mystacinus), suurkõrv (Plecotus auritus) ja põhja-nahkhiir (Eptesicus nilssonii). Määrusega võetakse kaitse alla Vabariigi Valitsuse 20. mai 2004. a määruse nr 195 „I ja II kaitsekategooriana kaitse alla võetavate liikide loeteluˮ § 1 lõike 1 punkti 2 ja lõike 2 punkti 20 ning § 5 lõike 1 punkti 2 kohaselt I ja II kaitsekategooriasse kuuluvate taimeliikide kasvukohad ning § 8 lõike 2 punktide 41, 42, 43, 44, 46 ja 51 kohaselt II kaitsekategooriasse kuuluvate loomaliikide elupaigad, mis asuvad väljaspool kaitsealasid ja hoiualasid ning mida tuleb kaitsta nende liikide soodsa seisundi tagamiseks. Need liigid on rohe-raunjalg (Asplenium viride), püstkivirik (Saxifraga adscendens), pruun raunjalg (Asplenium trichomanes), veelendlane (Myotis daubentoni), tiigilendlane (Myotis dasycneme), tõmmulendlane (Myotis brandtii), habelendlane (Myotis mystacinus), suurkõrv (Plecotus auritus) ja põhja-nahkhiir (Eptesicus nilssonii). 2 (2) Astangu nahkhiirte, rohe-raunjala, püstkiviriku ja pruuni raunjala püsielupaiga (edaspidi püsielupaik) maa-ala kuulub Astangu sihtkaitsevööndisse ning Moonalao ja Astangu piiranguvööndisse. Astangu nahkhiirte, rohe-raunjala, püstkiviriku ja pruuni raunjala püsielupaiga (edaspidi püsielupaik) maa-ala kuulub Astangu sihtkaitsevööndisse ning Moonalao ja Astangu piiranguvööndisse. 3 (3) Püsielupaigas tuleb arvestada looduskaitseseaduses sätestatud piiranguid käesolevas määruses ettenähtud erisustega. Püsielupaigas tuleb arvestada looduskaitseseaduses sätestatud piiranguid käesolevas määruses ettenähtud erisustega.",
      "rdfs:label": {
        "@value": "Reg_1052099_Par_1 (redaktsioon 1052099)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052099",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052099",
      "estleg:sourceAct": "Astangu nahkhiirte, rohe-raunjala, püstkiviriku ja pruuni raunjala püsielupaiga kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052099 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052099_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052099_Par_10_v1052099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052099_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) telkimine ja lõkke tegemine; 4 4) uute ehitiste püstitamine, välja arvatud püsielupaiga valitseja nõusolekul rajatise püstitamine püsielupaiga tarbeks ning tee või tehnovõrgu rajatise püstitamine püsielupaigas paikneva kinnistu tarbeks; 5 5) inimeste viibimine ehitismälestise „Peeter Suure Merekindluse laskemoonalaod” tunnelladudes 1. septembrist 30. aprillini, välja arvatud järelevalve- ja päästetöödel, püsielupaiga valitsemise või kaitse korraldamisega seotud tegevusel, püsielupaiga valitseja nõusolekul teostataval teadustegevusel ning ehitismälestise tunnelladudes number 1 ja 3. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; telkimine ja lõkke tegemine; uute ehitiste püstitamine, välja arvatud püsielupaiga valitseja nõusolekul rajatise püstitamine püsielupaiga tarbeks ning tee või tehnovõrgu rajatise püstitamine püsielupaigas paikneva kinnistu tarbeks; inimeste viibimine ehitismälestise „Peeter Suure Merekindluse laskemoonalaod” tunnelladudes 1. septembrist 30. aprillini, välja arvatud järelevalve- ja päästetöödel, püsielupaiga valitsemise või kaitse korraldamisega seotud tegevusel, püsielupaiga valitseja nõusolekul teostataval teadustegevusel ning ehitismälestise tunnelladudes number 1 ja 3.",
      "rdfs:label": {
        "@value": "Reg_1052099_Par_10 (redaktsioon 1052099)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052099",
