    {
      "@id": "estleg:Reg_1052099_Par_16_v1052099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052099_Par_16"
      },
