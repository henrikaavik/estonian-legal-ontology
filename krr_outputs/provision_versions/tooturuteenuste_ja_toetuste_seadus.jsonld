    {
      "@id": "estleg:TTTS_Par_44_v948762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikute suhtes, kes on õppeasutusse vastu võetud enne 2003/2004. õppeaastat, loetakse käesoleva seaduse § 6 lõike 5 punktis 6, § 26 lõike 3 punktis 4 ja § 29 lõikes 3 sätestatud täiskoormusega õppe nõue täidetuks, kui nad õpivad statsionaarses õppevormis.",
      "rdfs:label": {
        "@value": "TTTS_Par_44 (redaktsioon 948762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "948762"
    },
    {
      "@id": "estleg:TTTS_Par_45_v948762",
      "@type": [
