    },
    {
      "@id": "estleg:TTTS_Par_35_v121122011023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kehtetu - (3¹) Stipendiumi arvutatakse tööturuteenuse läbiviija esitatud andmete põhjal käesoleva seaduse §-s 34 nimetatud tööturuteenusel osaletud iga päeva eest stipendiumi päevamäära alusel. (4) Stipendiumi arvutab Eesti Töötukassa. (5) Stipendium makstakse kord kuus töötu pangakontole maksja kulul. (6) Stipendiumi päevamäär kehtestatakse igaks eelarveaastaks riigieelarvega. Stipendiumi uus päevamäär ei või olla kehtivast määrast väiksem.",
      "rdfs:label": {
        "@value": "TTTS_Par_35 (redaktsioon 121122011023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122011023",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTTS_Par_35_v124042014003"
      },
      "estleg:versionValidTo": {
