    {
      "@id": "estleg:TTTS_Par_3_v1036282",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud tööturuteenustele ja -toetustele on õigus: Eesti alalisel elanikul; [Punkti 2 sõnastus kuni 31. 07. 2006] tähtajalise elamisloa alusel Eestis viibival välismaalasel; [Punkti 2 sõnastus alates 1. 08. 2006] tähtajalise elamisloa või tähtajalise elamisõiguse alusel Eestis elaval välismaalasel; Eestis viibival Euroopa Liidu, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodanikul; [Punkti 4 sõnastus kuni 30. 06. 2006] Eestis viibival pagulasel; [Punkti 4 sõnastus alates 1. 07. 2006] Eestis viibival rahvusvahelise kaitse saajal või Eestis viibival varjupaigataotlejal välismaalasele rahvusvahelise kaitse andmise seaduses sätestatud tingimustel; tööandjal.",
      "rdfs:label": {
        "@value": "TTTS_Par_3 (redaktsioon 1036282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036282",
