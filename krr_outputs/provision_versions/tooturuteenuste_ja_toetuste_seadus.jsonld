    },
    {
      "@id": "estleg:TTTS_Par_3_v948762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud tööturuteenustele ja -toetustele on õigus: Eesti alalisel elanikul; tähtajalise elamisloa alusel Eestis viibival välismaalasel; Eestis viibival Euroopa Liidu, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodanikul; Eestis viibival pagulasel; tööandjal.",
      "rdfs:label": {
        "@value": "TTTS_Par_3 (redaktsioon 948762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "948762",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTTS_Par_3_v980333"
      },
      "estleg:versionValidTo": {
        "@value": "2006-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTTS_Par_3_v980333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ettenähtud tööturuteenustele ja -toetustele on õigus: Eesti alalisel elanikul; tähtajalise elamisloa alusel Eestis viibival välismaalasel; Eestis viibival Euroopa Liidu, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodanikul; [Punkti 4 sõnastus kuni 30. 06. 2006] Eestis viibival pagulasel; [Punkti 4 sõnastus alates 1. 07. 2006] Eestis viibival rahvusvahelise kaitse saajal või Eestis viibival varjupaigataotlejal välismaalasele rahvusvahelise kaitse andmise seaduses sätestatud tingimustel; tööandjal.",
      "rdfs:label": {
        "@value": "TTTS_Par_3 (redaktsioon 980333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "980333",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTTS_Par_3_v1036282"
      },
