      "estleg:versionRedactionId": "130062023089"
    },
    {
      "@id": "estleg:TTTS_Par_41_v948762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööturuamet esitab käesolevas seaduses sätestatud tööturutoetuse või käesoleva seaduse § 9 lõike 1 punktides 3, 5 ja 7–13 nimetatud tööturuteenuse saaja poolt teadliku valeandmete esitamise või tööturutoetuse või -teenuse saamist mõjutavatest asjaoludest teatamata jätmise korral või käesoleva seaduse § 18 lõikes 6, § 19 lõikes 8 ning § 20 lõikes 5 nimetatud juhtudel tööturutoetusteks alusetult makstud või tööturuteenuste osutamiseks kulunud summade tagastamiseks isikule nõude riigivastutuse seaduse § 22 lõike 3 alusel.",
      "rdfs:label": {
        "@value": "TTTS_Par_41 (redaktsioon 948762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "948762",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTTS_Par_41_v13064976"
      },
      "estleg:versionValidTo": {
        "@value": "2008-11-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTTS_Par_41_v13064976",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööturuamet nõuab käesolevas seaduses sätestatud tööturutoetuse või käesoleva seaduse § 9 lõike 1 punktides 3, 5 ja 7–13 nimetatud tööturuteenuse saaja poolt teadliku valeandmete esitamise või tööturutoetuse või -teenuse saamist mõjutavatest asjaoludest teatamata jätmise korral või käesoleva seaduse § 18 lõikes 7, § 19 lõikes 8 ning § 20 lõikes 5 nimetatud juhtudel tööturutoetusteks alusetult makstud või tööturuteenuste osutamiseks kulunud summad tagasi. (2) Kui isik ei maksa alusetult makstud summasid tagasi, tehakse nende tagasinõudmiseks ettekirjutus koos hoiatusega. Hoiatuses märgitud tähtaja jooksul ettekirjutuse täitmata jätmise korral on Tööturuameti piirkondlikul struktuuriüksusel õigus anda ettekirjutus sundtäitmiseks täitemenetluse seadustikus sätestatud korras.",
      "rdfs:label": {
        "@value": "TTTS_Par_41 (redaktsioon 13064976)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13064976",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTTS_Par_41_v13198033"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTTS_Par_41_v13198033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTTS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Töötukassa nõuab käesolevas seaduses sätestatud tööturutoetuse või käesoleva seaduse § 9 lõike 1 punktides 3, 5 ja 7–13 nimetatud tööturuteenuse saaja poolt teadliku valeandmete esitamise või tööturutoetuse või -teenuse saamist mõjutavatest asjaoludest teatamata jätmise korral või käesoleva seaduse § 18 lõikes 7, § 19 lõikes 8 ning § 20 lõikes 5 nimetatud juhtudel tööturutoetusteks alusetult makstud või tööturuteenuste osutamiseks kulunud summad tagasi. (2) Kui isik ei maksa alusetult makstud summasid tagasi, tehakse nende tagasinõudmiseks ettekirjutus koos hoiatusega. Hoiatuses märgitud tähtaja jooksul ettekirjutuse täitmata jätmise korral on Eesti Töötukassal õigus anda ettekirjutus sundtäitmiseks täitemenetluse seadustikus sätestatud korras.",
      "rdfs:label": {
        "@value": "TTTS_Par_41 (redaktsioon 13198033)",
        "@language": "et"
