      "rdfs:label": {
        "@value": "TTTS_Par_6 (redaktsioon 980333)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "980333",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTTS_Par_6_v1037461"
