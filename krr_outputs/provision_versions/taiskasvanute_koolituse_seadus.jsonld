        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täienduskoolitusasutuse pidaja on kohustatud pidama täienduskoolituse teabe avalikustamiseks veebilehte.",
      "rdfs:label": {
        "@value": "TAISKA_Par_5 (redaktsioon 110062015010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110062015010",
      "estleg:supersededByVersion": {
