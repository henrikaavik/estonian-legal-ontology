      },
      "estleg:versionText": "Seadus sätestab täiskasvanute koolituse alused ja õiguslikud tagatised täiskasvanutele nende soovi kohaseks õppeks kogu eluea jooksul.",
      "rdfs:label": {
        "@value": "TAISKA_Par_1 (redaktsioon 262138)",
        "@language": "et"
      },
