        "@id": "estleg:TAISKA_Par_4_v262138"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TAISKA_Par_4_v262138",
      "@type": [
        "owl:NamedIndividual",
