        "@type": "xsd:date"
      },
      "estleg:versionText": "Täiskasvanute koolituse üldist koordineerimist korraldab Haridusministeerium. [Paragrahvi 10 sõnastus alates1. 01. 2003]",
      "rdfs:label": {
        "@value": "TAISKA_Par_10 (redaktsioon 214564)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "214564",
