    {
      "@id": "estleg:TAISKA_Par_16_v214564",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TAISKA_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 7 punkt 1 ja § 13 5.lõige jõustuvad 1995.aasta 1.jaanuaril.",
      "rdfs:label": {
        "@value": "TAISKA_Par_16 (redaktsioon 214564)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "214564",
      "estleg:supersededByVersion": {
