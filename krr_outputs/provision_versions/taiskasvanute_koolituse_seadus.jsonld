      "rdfs:label": {
        "@value": "TAISKA_Par_17 (redaktsioon 13197371)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13197371",
      "estleg:supersededByVersion": {
        "@id": "estleg:TAISKA_Par_17_v110062015010"
      },
      "estleg:versionValidTo": {
