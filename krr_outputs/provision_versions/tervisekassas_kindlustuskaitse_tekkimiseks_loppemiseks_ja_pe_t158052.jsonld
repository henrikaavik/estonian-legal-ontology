  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_tervisekassas_kindlustuskaitse_tekkimiseks_loppemiseks_ja_pe_t158052_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tervisekassas kindlustuskaitse tekkimiseks, lõppemiseks ja peatumiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseis (18 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tervisekassas kindlustuskaitse tekkimiseks, lõppemiseks ja peatumiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseis"
    },
    {
      "@id": "estleg:Reg_158052_Par_1_v158052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158052_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolev määrus kehtestab Tervisekassas kindlustuskaitse tekkimiseks, peatumiseks või lõppemiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseisu. RT I 2023-05-23 1 123052023001 2023-05-26 Käesolev määrus kehtestab Tervisekassas kindlustuskaitse tekkimiseks, peatumiseks või lõppemiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseisu. 2 (2) Kindlustuskaitse tekkimiseks, peatumiseks või lõppemiseks vajalikud dokumendid esitatakse Tervisekassale. RT I 2023-05-23 1 123052023001 2023-05-26 Kindlustuskaitse tekkimiseks, peatumiseks või lõppemiseks vajalikud dokumendid esitatakse Tervisekassale. 3 (3) Ravikindlustuse seaduse § 5 lõike 2 punktides 1 ja 2 ning maksukorralduse seaduse § 251 lõike 4 punktis 16 nimetatud isikute kindlustuskaitse tekkimiseks, peatumiseks, peatumise lõppemiseks või kindlustuskaitse lõppemiseks vajalikud andmed esitavad andmete esitamiseks kohustatud isikud maksukorralduse seaduse §-s 251 sätestatud töötamise registrile (edaspidi töötamise register), mis edastab need Tervisekassale. RT I 2023-05-23 1 123052023001 2023-05-26 Ravikindlustuse seaduse § 5 lõike 2 punktides 1 ja 2 ning maksukorralduse seaduse § 251 lõike 4 punktis 16 nimetatud isikute kindlustuskaitse tekkimiseks, peatumiseks, peatumise lõppemiseks või kindlustuskaitse lõppemiseks vajalikud andmed esitavad andmete esitamiseks kohustatud isikud maksukorralduse seaduse §-s 251 sätestatud töötamise registrile (edaspidi töötamise register), mis edastab need Tervisekassale. 4 (4) Ravikindlustuse seaduse § 5 lõike 2 punktides 4–51 nimetatud isikute kindlustuskaitse tekkimiseks, peatumiseks ja peatumise lõppemiseks esitab Tervisekassale andmed Maksu- ja Tolliamet. RT I 2023-05-23 1 123052023001 2023-05-26 Ravikindlustuse seaduse § 5 lõike 2 punktides 4–51 nimetatud isikute kindlustuskaitse tekkimiseks, peatumiseks ja peatumise lõppemiseks esitab Tervisekassale andmed Maksu- ja Tolliamet. 5 (5) Ravikindlustuse seaduse § 5 lõike 4 punktis 6 nimetatud isikute kindlustuskaitse tekkimiseks, peatumiseks ja peatumise lõppemiseks esitab Tervisekassale andmed usuliste ühenduste registrisse kantud klooster, kelle liikmeskonda isik kuulub. RT I 2023-05-23 1 123052023001 2023-05-26 Ravikindlustuse seaduse § 5 lõike 4 punktis 6 nimetatud isikute kindlustuskaitse tekkimiseks, peatumiseks ja peatumise lõppemiseks esitab Tervisekassale andmed usuliste ühenduste registrisse kantud klooster, kelle liikmeskonda isik kuulub.",
      "rdfs:label": {
        "@value": "Reg_158052_Par_1 (redaktsioon 158052)",
        "@language": "et"
      },
