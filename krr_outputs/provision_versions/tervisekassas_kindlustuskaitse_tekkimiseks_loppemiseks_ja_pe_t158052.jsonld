      "estleg:provisionRef": "Reg_158052 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158052_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158052_Par_4_v158052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158052_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravikindlustuse seaduse § 5 lõike 2 punktides 3 ja 6 ning lõikes 31 nimetatud isikute, välja arvatud maksukorralduse seaduse § 251 lõike 4 punktis 16 nimetatud isiku, kindlustuskaitse tekkimiseks, peatumiseks, peatumise lõpetamiseks ja kindlustuskaitse lõpetamiseks esitatav dokument on kindlustatavate isikute nimekiri. RT I 2014-06-28 8 128062014008 2014-07-01 34 Ravikindlustuse seaduse § 5 lõike 2 punktides 3 ja 6 ning lõikes 31 nimetatud isikute, välja arvatud maksukorralduse seaduse § 251 lõike 4 punktis 16 nimetatud isiku, kindlustuskaitse tekkimiseks, peatumiseks, peatumise lõpetamiseks ja kindlustuskaitse lõpetamiseks esitatav dokument on kindlustatavate isikute nimekiri.",
      "rdfs:label": {
        "@value": "Reg_158052_Par_4 (redaktsioon 158052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158052",
      "estleg:sourceAct": "Tervisekassas kindlustuskaitse tekkimiseks, lõppemiseks ja peatumiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseis",
      "estleg:provisionRef": "Reg_158052 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158052_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158052_Par_5_v158052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158052_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "«Ravikindlustuse seaduse» § 5 lõikes 3 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri. RTL 2006 77 1442 12747616 2006-11-11+02:00 «Ravikindlustuse seaduse» § 5 lõikes 3 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri.",
      "rdfs:label": {
        "@value": "Reg_158052_Par_5 (redaktsioon 158052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158052",
      "estleg:sourceAct": "Tervisekassas kindlustuskaitse tekkimiseks, lõppemiseks ja peatumiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseis",
      "estleg:provisionRef": "Reg_158052 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158052_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158052_Par_6_v158052",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158052_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-05-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) «Ravikindlustuse seaduse» § 5 lõike 4 punktis 1 nimetatud isiku kindlustuskaitse tekkimiseks esitatavad dokumendid on: 1 1) isikut tõendav dokument; 2 2) arsti või ämmaemanda tõend. RT I 2014-06-28 8 128062014008 2014-07-01 34 «Ravikindlustuse seaduse» § 5 lõike 4 punktis 1 nimetatud isiku kindlustuskaitse tekkimiseks esitatavad dokumendid on: isikut tõendav dokument; arsti või ämmaemanda tõend. 2 (2) «Ravikindlustuse seaduse» § 5 lõike 4 punktis 2 nimetatud isiku kindlustuskaitse tekkimiseks saab Tervisekassa andmed X-tee päringu kaudu Eesti rahvastikuregistrist teatisena (edaspidi teatis). RT I 2023-05-23 1 123052023001 2023-05-26 «Ravikindlustuse seaduse» § 5 lõike 4 punktis 2 nimetatud isiku kindlustuskaitse tekkimiseks saab Tervisekassa andmed X-tee päringu kaudu Eesti rahvastikuregistrist teatisena (edaspidi teatis). 3 (3) «Ravikindlustuse seaduse» § 5 lõike 4 punktis 3 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri. «Ravikindlustuse seaduse» § 5 lõike 4 punktis 3 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri. 3 (3¹) Ravikindlustuse seaduse § 5 lõike 4 punktis 31 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri. RT I 2015-12-22 20 122122015020 2016-07-01 64 Ravikindlustuse seaduse § 5 lõike 4 punktis 31 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri. 4 (4) «Ravikindlustuse seaduse» § 5 lõike 4 punktis 4 nimetatud isiku kindlustuskaitse tekkimiseks esitatavad dokumendid on: 1 1) isikut tõendav dokument; 2 2) avaldus. «Ravikindlustuse seaduse» § 5 lõike 4 punktis 4 nimetatud isiku kindlustuskaitse tekkimiseks esitatavad dokumendid on: isikut tõendav dokument; avaldus. 5 (5) «Ravikindlustuse seaduse» § 5 lõike 4 punktis 5 nimetatud: 1 1) õigusaktide alusel asutatud ja tegutsevas Eesti õppeasutuses õppiva isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri; 2 2) välisriigi samaväärses õppeasutuses õppiva isiku kindlustuskaitse tekkimiseks esitatav dokument iga õppeaasta alguses on välisriigi õppeasutuses õppimist tõendav dokument. RTL 2006 77 1442 12747616 2006-11-11+02:00 «Ravikindlustuse seaduse» § 5 lõike 4 punktis 5 nimetatud: õigusaktide alusel asutatud ja tegutsevas Eesti õppeasutuses õppiva isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri; välisriigi samaväärses õppeasutuses õppiva isiku kindlustuskaitse tekkimiseks esitatav dokument iga õppeaasta alguses on välisriigi õppeasutuses õppimist tõendav dokument. 6 (6) Ravikindlustuse seaduse § 5 lõike 4 punktis 6 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri. RT I 2017-12-29 1 129122017001 2018-01-01 61 Ravikindlustuse seaduse § 5 lõike 4 punktis 6 nimetatud isiku kindlustuskaitse tekkimiseks esitatav dokument on kindlustatavate isikute nimekiri.",
      "rdfs:label": {
        "@value": "Reg_158052_Par_6 (redaktsioon 158052)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158052",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158052",
      "estleg:sourceAct": "Tervisekassas kindlustuskaitse tekkimiseks, lõppemiseks ja peatumiseks vajalike dokumentide loetelu ning nendes sisalduvate andmete koosseis",
      "estleg:provisionRef": "Reg_158052 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158052_Map_2026"
      }
    },
    {
