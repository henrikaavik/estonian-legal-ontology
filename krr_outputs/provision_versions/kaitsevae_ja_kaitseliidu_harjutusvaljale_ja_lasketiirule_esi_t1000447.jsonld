      }
    },
    {
      "@id": "estleg:Reg_1000447_Par_16_v1000447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000447_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ohuala ohutuslindi värvid on kollane ja must, mis asetsevad lindil vaheldumisi. Ohuala ohutuslindi värvid on kollane ja must, mis asetsevad lindil vaheldumisi. 2 (2) Ohuala ohutuslinti võib kasutada ohuala või muu liikumiseks keelatud ala tähistamiseks harjutusvälja või lasketiiru kasutamise ajal. Harjutusvälja või lasketiiru kasutamise lõppemisel eemaldatakse paigaldatud ohutuslint. Ohuala ohutuslinti võib kasutada ohuala või muu liikumiseks keelatud ala tähistamiseks harjutusvälja või lasketiiru kasutamise ajal. Harjutusvälja või lasketiiru kasutamise lõppemisel eemaldatakse paigaldatud ohutuslint.",
      "rdfs:label": {
