    {
      "@id": "estleg:Reg_1000447_Par_12_v1000447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000447_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ohuala piirimärgilt peab nähtuma teave ohuala olemasolust ning asutuse või organisatsiooni kontaktandmed, millelt on võimalik saada teavet ohualasse sisenemise lubatavuse kohta. Ohuala piirimärgilt peab nähtuma teave ohuala olemasolust ning asutuse või organisatsiooni kontaktandmed, millelt on võimalik saada teavet ohualasse sisenemise lubatavuse kohta. 2 (2) Ohuala piirimärgi: 1 1) vähimad mõõtmed on 20×17 sentimeetrit; 2 2) geomeetrilise keelumärgi kujundi vähim läbimõõt on 12 sentimeetrit; 3 3) musta värvi kirje kollasel taustal oleva tähe vähim kõrgus on 0,8 sentimeetrit; 4 4) musta värvi kirje „ELUOHTLIK!” ühe tähe vähim kõrgus on 1 sentimeeter; 5 5) kirjete kirjastiiliks on „Arial”; 6 6) mõõtmete suurendamisel suurendatakse kõiki mõõtmeid proportsionaalselt. Ohuala piirimärgi: vähimad mõõtmed on 20×17 sentimeetrit; geomeetrilise keelumärgi kujundi vähim läbimõõt on 12 sentimeetrit; musta värvi kirje kollasel taustal oleva tähe vähim kõrgus on 0,8 sentimeetrit; musta värvi kirje „ELUOHTLIK!” ühe tähe vähim kõrgus on 1 sentimeeter; kirjete kirjastiiliks on „Arial”; mõõtmete suurendamisel suurendatakse kõiki mõõtmeid proportsionaalselt. 3 (3) Ohuala piirimärk on toodud käesoleva määruse lisas 4. Ohuala piirimärk on toodud käesoleva määruse lisas 4.",
      "rdfs:label": {
        "@value": "Reg_1000447_Par_12 (redaktsioon 1000447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000447",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000447",
      "estleg:sourceAct": "Kaitseväe ja Kaitseliidu harjutusväljale ja lasketiirule esitatavad nõuded ja kasutamise kord",
      "estleg:provisionRef": "Reg_1000447 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000447_Map"
      }
    },
    {
      "@id": "estleg:Reg_1000447_Par_13_v1000447",
      "@type": [
        "owl:NamedIndividual",
