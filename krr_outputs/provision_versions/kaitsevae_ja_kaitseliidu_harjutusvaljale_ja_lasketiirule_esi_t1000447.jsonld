    {
      "@id": "estleg:Reg_1000447_Par_15_v1000447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000447_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ohuala piiritähis tuleb paigaldada ohuala välispiirile vastavalt käesoleva määruse §-s 8 toodud harjutusvälja ja lasketiiru piiritähise paigaldamise nõuetele. Ohuala piiritähis tuleb paigaldada ohuala välispiirile vastavalt käesoleva määruse §-s 8 toodud harjutusvälja ja lasketiiru piiritähise paigaldamise nõuetele. 2 (2) Ohuala piiritähise paigaldamise näited on toodud käesoleva määruse lisas 5. Ohuala piiritähise paigaldamise näited on toodud käesoleva määruse lisas 5.",
