      "estleg:versionValidFrom": {
        "@value": "2023-11-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse tähenduses on aur naftasaadusest või põlevkiviõlist aurustuvad lenduvad ühendid, sh lenduvad orgaanilised ühendid. RT I 2023-11-17 1 117112023001 2024-06-01 Käesoleva määruse tähenduses on aur naftasaadusest või põlevkiviõlist aurustuvad lenduvad ühendid, sh lenduvad orgaanilised ühendid.",
      "rdfs:label": {
        "@value": "Reg_1049648_Par_1_1 (redaktsioon 1049648)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049648",
