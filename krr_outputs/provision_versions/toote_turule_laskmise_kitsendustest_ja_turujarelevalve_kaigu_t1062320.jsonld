      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Toote turule laskmise kitsendustest ja turujärelevalve käigus kogutud teabest Euroopa Komisjoni teavitamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Toote turule laskmise kitsendustest ja turujärelevalve käigus kogutud teabest Euroopa Komisjoni teavitamise kord"
    },
    {
      "@id": "estleg:Reg_1062320_Par_1_v1062320",
      "@type": [
