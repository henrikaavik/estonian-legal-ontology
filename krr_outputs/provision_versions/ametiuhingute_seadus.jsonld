        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja poolt informeerimise või konsulteerimise kohustuse nõude rikkumise eest – karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_3 (redaktsioon 191347)",
        "@language": "et"
      },
