    {
      "@id": "estleg:AUS_Par_26_1_v191347",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja poolt kollektiiv- või muu lepingu sõlmimise või muutmise läbirääkimistesse mitteasumise, samuti ametiühingu organi töös või koolituses osalemise mittevõimaldamise eest või töötaja õiguste piiramise eest sõltuvalt tema kuulumisest ametiühingusse või tegutsemisest ametiühingu valitud esindajana – karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_1 (redaktsioon 191347)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191347",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUS_Par_26_1_v13235586"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/191347",
      "estleg:sourceAct": "Ametiühingute seadus",
      "estleg:provisionRef": "AÜS § 26_1",
      "estleg:partOfAct": {
        "@id": "estleg:AUS_Map"
      }
    },
    {
      "@id": "estleg:AUS_Par_26_1_v13235586",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööandja poolt kollektiiv- või muu lepingu sõlmimise või muutmise läbirääkimistesse mitteasumise, samuti ametiühingu organi töös või koolituses osalemise mittevõimaldamise eest või töötaja õiguste piiramise eest sõltuvalt tema kuulumisest ametiühingusse või tegutsemisest ametiühingu valitud esindajana –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_1 (redaktsioon 13235586)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13235586",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUS_Par_26_1_v126062018020"
      },
      "estleg:versionValidTo": {
        "@value": "2018-07-05",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13235586",
      "estleg:sourceAct": "Ametiühingute seadus",
      "estleg:provisionRef": "AÜS § 26_1",
      "estleg:partOfAct": {
        "@id": "estleg:AUS_Map"
      }
    },
    {
      "@id": "estleg:AUS_Par_26_1_v126062018020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kollektiiv- või muu lepingu sõlmimise või muutmise läbirääkimistesse asumata jätmise, samuti ametiühingu organi töös või koolituses osalemise võimaldamata jätmise eest või töötaja õiguste piiramise eest sõltuvalt tema kuulumisest ametiühingusse või tegutsemisest ametiühingu valitud esindajana –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_1 (redaktsioon 126062018020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126062018020",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUS_Par_26_1_v109072020002"
      },
      "estleg:versionValidTo": {
        "@value": "2020-07-29",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126062018020",
      "estleg:sourceAct": "Ametiühingute seadus",
      "estleg:provisionRef": "AÜS § 26_1",
      "estleg:partOfAct": {
        "@id": "estleg:AUS_Map"
      }
    },
    {
      "@id": "estleg:AUS_Par_26_1_v109072020002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kollektiiv- või muu lepingu sõlmimise või muutmise läbirääkimistesse asumata jätmise eest, samuti ametiühingu organi töös või koolituses osalemise võimaldamata jätmise eest, töötaja ametiühingusse kuulumise või ametiühingu valitud esindajana tegutsemise tõttu tema õiguste piiramise eest tööandja, tema juhatuse liikme või muu esindaja poolt, kellele oli käesolevas seaduses sätestatud tööandja kohustuse täitmise tagamine delegeeritud, –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_1 (redaktsioon 109072020002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109072020002",
      "estleg:supersededByVersion": {
        "@id": "estleg:AUS_Par_26_1_v129122020017"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109072020002",
      "estleg:sourceAct": "Ametiühingute seadus",
      "estleg:provisionRef": "AÜS § 26_1",
      "estleg:partOfAct": {
        "@id": "estleg:AUS_Map"
      }
    },
    {
      "@id": "estleg:AUS_Par_26_1_v129122020017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AUS_Par_26_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kollektiiv- või muu lepingu sõlmimise või muutmise läbirääkimistesse asumata jätmise eest, samuti ametiühingu organi töös või koolituses osalemise võimaldamata jätmise eest, töötaja ametiühingusse kuulumise või ametiühingu valitud esindajana tegutsemise tõttu tema õiguste piiramise eest tööandja, tema juhatuse liikme või muu esindaja poolt, kellele oli käesolevas seaduses sätestatud tööandja kohustuse täitmise tagamine delegeeritud, –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 32 000 eurot.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_1 (redaktsioon 129122020017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122020017",
