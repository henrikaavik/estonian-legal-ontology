      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Informeerimise või konsulteerimise kohustuse täitmata jätmise või valeandmete esitamise eest tööandja poolt karistatakse töötajate usaldusisiku seaduse §-des 24 ja 26 ette nähtud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "AÜS_Par_26_3 (redaktsioon 12775000)",
