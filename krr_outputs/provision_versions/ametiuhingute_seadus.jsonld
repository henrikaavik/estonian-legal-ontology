      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13107279",
      "estleg:sourceAct": "Ametiühingute seadus",
      "estleg:provisionRef": "AÜS § 14",
      "estleg:partOfAct": {
        "@id": "estleg:AUS_Map"
      }
    },
