      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Loetelu tasemeõppe ja täiendkoolituse õppekavadest, mille alusel omandatud kvalifikatsiooni eest võib maksta toetust, ning toetuse maksmise tingimused ja ulatus ning toetuse taotlemise ja maksmise kord (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Loetelu tasemeõppe ja täiendkoolituse õppekavadest, mille alusel omandatud kvalifikatsiooni eest võib maksta toetust, ning toetuse maksmise tingimused ja ulatus ning toetuse taotlemise ja maksmise kord"
    },
