    {
      "@id": "estleg:SOS_Par_56_v171122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. juulil, välja arvatud: käesoleva seaduse § 4 lõike 1 punktid 13 ja 14 ning § 12 lõike 1 punkt 2, mis jõustuvad vastavasisulise välislepingu jõustumisel või Eesti ühinemisel Euroopa Liiduga olenevalt sellest, kumb tähtpäev saabub varem; käesoleva seaduse 10. peatükk, mis jõustub samaaegselt karistusseadustikuga. (2) Käesoleva seaduse §-d 52 ja 53 kehtivad kuni karistusseadustiku jõustumiseni.",
      "rdfs:label": {
        "@value": "SOS_Par_56 (redaktsioon 171122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171122",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_56_v697061"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_56_v697061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. juulil, välja arvatud: käesoleva seaduse § 3 lõike 1 punkt 4, § 4 lõiked 10 ja 11, § 8 lõige 3 ning § 12 lõike 1 punkt 2, samuti § 3 lõige 2 ja § 5 2003. aasta 17. detsembril vastuvõetud redaktsioonis, mis jõustuvad Eesti ühinemisel Euroopa Liiduga või Euroopa ühenduste ja nende liikmesriikide ning Eesti Vabariigi vahelise assotsieerumislepingu (Euroopa lepingu) tööstustoodete vastavushindamise ja tunnustamise protokolli (PECA) (RT II 2003, 17, 87) jõustumisel surveseadmete osas, olenevalt sellest, kumb tähtpäev saabub varem ; käesoleva seaduse 10. peatükk, mis jõustub samaaegselt karistusseadustikuga. (2) Käesoleva seaduse §-d 52 ja 53 kehtivad kuni karistusseadustiku jõustumiseni.",
      "rdfs:label": {
        "@value": "SOS_Par_56 (redaktsioon 697061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "697061",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_56_v748803"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_56_v748803",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. juulil, välja arvatud: käesoleva seaduse § 5 2003. aasta 17. detsembril vastuvõetud redaktsioonis ( ), § 8 lõige 3, § 12 lõike 1 punkt 2 jõustuvad Eesti ühinemisel Euroopa Liiduga; käesoleva seaduse 10. peatükk, mis jõustub samaaegselt karistusseadustikuga. (2) Käesoleva seaduse §-d 52 ja 53 kehtivad kuni karistusseadustiku jõustumiseni.",
      "rdfs:label": {
        "@value": "SOS_Par_56 (redaktsioon 748803)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "748803",
      "estleg:supersededByVersion": {
