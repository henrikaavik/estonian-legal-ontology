    {
      "@id": "estleg:SOS_Par_17_v12895152",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_17"
      },
      "estleg:versionValidFrom": {
