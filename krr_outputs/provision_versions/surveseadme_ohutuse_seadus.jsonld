    {
      "@id": "estleg:SOS_Par_5_v171122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Surveseadmed ja surveseadmestikud (edaspidi surveseade ) jaotatakse käesolevas seaduses järgmistesse liikidesse: I liik – surveseadmed, milles on ette nähtud suurema kui 0,5-baarise rõhu tekkimine; II liik – seeriaviisiliselt valmistatavad lihtsad surveanumad, välja arvatud tulekustutid; III liik – transporditavad surveseadmed, välja arvatud aerosooliballoonid ja hingamisaparaatide gaasiballoonid; IV liik – aerosooliballoonid, välja arvatud aerosooliballoonid, mille maht on väiksem kui 50 milliliitrit, metallist aerosooliballoonid, mille maht on suurem kui 1000 milliliitrit, kaitsva kattega klaasist või mittekillustuvast plastist aerosooliballoonid, mille maht on suurem kui 220 milliliitrit, ja kaitsva katteta klaasist või killustuvast plastist aerosooliballoonid, mille maht on suurem kui 150 milliliitrit; V liik – plahvatus- või tuleohtliku, väga tuleohtliku, eriti tuleohtliku, mürgise või väga mürgise vedeliku (edaspidi ohtlik vedelik ) anumad ja torustikud, milles rõhu tekitab vedelikusamba kõrgus või hüdrauliline löök, samuti muud surveseadmed, mis ei kuulu I–IV liiki. (2) III liigi surveseadmete loetelu kehtestab teede- ja sideminister.",
      "rdfs:label": {
        "@value": "SOS_Par_5 (redaktsioon 171122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171122",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_5_v696432"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_5_v696432",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Surveseadmed ja surveseadmestikud (edaspidi surveseade ) jaotatakse käesolevas seaduses järgmistesse liikidesse: I liik – surveseadmed, milles on ette nähtud suurema kui 0,5-baarise rõhu tekkimine; II liik – seeriaviisiliselt valmistatavad lihtsad surveanumad, välja arvatud tulekustutid; III liik – transporditavad surveseadmed, välja arvatud aerosooliballoonid ja hingamisaparaatide gaasiballoonid; IV liik – aerosooliballoonid, välja arvatud aerosooliballoonid, mille maht on väiksem kui 50 milliliitrit, metallist aerosooliballoonid, mille maht on suurem kui 1000 milliliitrit, kaitsva kattega klaasist või mittekillustuvast plastist aerosooliballoonid, mille maht on suurem kui 220 milliliitrit, ja kaitsva katteta klaasist või killustuvast plastist aerosooliballoonid, mille maht on suurem kui 150 milliliitrit; V liik – plahvatus- või tuleohtliku, väga tuleohtliku, eriti tuleohtliku, mürgise või väga mürgise vedeliku (edaspidi ohtlik vedelik ) anumad ja torustikud, milles rõhu tekitab vedelikusamba kõrgus või hüdrauliline löök, samuti muud surveseadmed, mis ei kuulu I–IV liiki. (2) III liigi surveseadmete loetelu kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "SOS_Par_5 (redaktsioon 696432)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696432",
      "estleg:supersededByVersion": {
