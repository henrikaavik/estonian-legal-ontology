        "@id": "estleg:SOS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine käesoleva seaduse tähenduses on menetlus, mille käigus äriregistris registreeritud ettevõtja või muu juriidiline isik (edaspidi isiku nõuetele vastavuse hindaja ja tõendaja ) hindab ja tõendab kirjalikult surveseadme kasutamise järelevaataja ja surveseadmetöid juhtiva isiku nõuetele vastavust. (2) Isiku nõuetele vastavuse hindamise ja tõendamise korra kehtestab majandusminister.",
      "rdfs:label": {
        "@value": "SOS_Par_30 (redaktsioon 171122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171122",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_30_v696432"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_30_v696432",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine käesoleva seaduse tähenduses on menetlus, mille käigus äriregistris registreeritud ettevõtja või muu juriidiline isik (edaspidi isiku nõuetele vastavuse hindaja ja tõendaja ) hindab ja tõendab kirjalikult surveseadme kasutamise järelevaataja ja surveseadmetöid juhtiva isiku nõuetele vastavust. (2) Isiku nõuetele vastavuse hindamise ja tõendamise korra kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "SOS_Par_30 (redaktsioon 696432)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696432",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_30_v748803"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_30_v748803",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine käesoleva seaduse tähenduses on menetlus, mille käigus äriregistris registreeritud ettevõtja või muu juriidiline isik (edaspidi isiku nõuetele vastavuse hindaja ja tõendaja ) hindab ja tõendab kirjalikult surveseadme kasutamise järelevaataja ja surveseadmetöid juhtiva isiku nõuetele vastavust.",
      "rdfs:label": {
        "@value": "SOS_Par_30 (redaktsioon 748803)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "748803",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_30_v12971159"
      },
      "estleg:versionValidTo": {
        "@value": "2008-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_30_v12971159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine käesoleva seaduse tähenduses on menetlus, mille käigus isiku nõuetele vastavuse hindaja ja tõendaja hindab surveseadme kasutamise järelevaataja ja surveseadmetöid juhtiva isiku nõuetele vastavust ning tõendab seda pädevustunnistuse andmisega. (2) Pädevustunnistus antakse, kui isiku erialane ettevalmistus ja töökogemus vastavad käesolevast seadusest tulenevatele nõuetele ning isik sooritab pädevuseksami positiivselt. (3) Isik, kellele pädevustunnistus on antud, peab võimaldama isiku nõuetele vastavuse hindajal ja tõendajal kontrollida enda jätkuvat vastavust nõuetele. (4) Kui käesoleva paragrahvi alusel teostatava kontrolli käigus tuvastatakse isiku mittevastavus nõuetele, võib isiku nõuetele vastavuse hindaja ja tõendaja asjaolude kaalukust arvestades pädevustunnistuse kehtetuks tunnistada või sellel märgitud pädevuse ulatust piirata. (5) Isiku nõuetele vastavuse hindaja ja tõendaja tunnistab pädevustunnistuse kehtetuks, kui: tuvastatakse, et pädevustunnistus on saadud seoses pettuse, võltsingu või ebaõigete andmete esitamisega; vastavalt käesoleva seaduse § 39 lõikele 2 on pädevustunnistuse kehtivus peatatud ning isik ei ole oma pädevuse uuesti hindamiseks sooritanud pädevuseksamit kolme kuu jooksul pädevustunnistuse kehtivuse peatamise tähtaja lõppemisest arvates; pädevuse uuesti hindamisel selgub isiku mittevastavus pädevustunnistuse saamise eelduseks olevatele nõuetele; isik ei ole isiku nõuetele vastavuse hindaja ja tõendaja kontrolli käigus esitatud nõudeid täitnud kolme kuu jooksul nende esitamisest arvates. (6) Isiku nõuetele vastavuse hindamise ja tõendamise ning välisriigis omandatud pädevuse tunnustamise korra",
      "rdfs:label": {
        "@value": "SOS_Par_30 (redaktsioon 12971159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12971159",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_30_v13328490"
      },
      "estleg:versionValidTo": {
        "@value": "2010-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_30_v13328490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine käesoleva seaduse tähenduses on menetlus, mille käigus isiku nõuetele vastavuse hindaja ja tõendaja hindab surveseadme kasutamise järelevaataja ja surveseadmetöid juhtiva isiku ning surveseadme tehnilist kontrolli teostava töötaja nõuetele vastavust ning tõendab seda pädevustunnistuse andmisega. (2) Pädevustunnistus antakse, kui isiku erialane ettevalmistus ja töökogemus vastavad käesolevast seadusest tulenevatele nõuetele ning isik sooritab pädevuseksami positiivselt. (3) Isik, kellele pädevustunnistus on antud, peab võimaldama isiku nõuetele vastavuse hindajal ja tõendajal kontrollida enda jätkuvat vastavust nõuetele. (4) Kui käesoleva paragrahvi alusel teostatava kontrolli käigus tuvastatakse isiku mittevastavus nõuetele, võib isiku nõuetele vastavuse hindaja ja tõendaja asjaolude kaalukust arvestades pädevustunnistuse kehtetuks tunnistada või sellel märgitud pädevuse ulatust piirata. (5) Isiku nõuetele vastavuse hindaja ja tõendaja tunnistab pädevustunnistuse kehtetuks, kui: tuvastatakse, et pädevustunnistus on saadud seoses pettuse, võltsingu või ebaõigete andmete esitamisega; vastavalt käesoleva seaduse § 39 lõikele 2 on pädevustunnistuse kehtivus peatatud ning isik ei ole oma pädevuse uuesti hindamiseks sooritanud pädevuseksamit kolme kuu jooksul pädevustunnistuse kehtivuse peatamise tähtaja lõppemisest arvates; pädevuse uuesti hindamisel selgub isiku mittevastavus pädevustunnistuse saamise eelduseks olevatele nõuetele; isik ei ole isiku nõuetele vastavuse hindaja ja tõendaja kontrolli käigus esitatud nõudeid täitnud kolme kuu jooksul nende esitamisest arvates. (6) Isiku nõuetele vastavuse hindamise ja tõendamise ning välisriigis omandatud pädevuse tunnustamise korra",
      "rdfs:label": {
        "@value": "SOS_Par_30 (redaktsioon 13328490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13328490"
    },
    {
      "@id": "estleg:SOS_Par_31_v171122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 32 nimetatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 37 sätestatud tingimustele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud. (3) Isiku nõuetele vastavuse hindaja ja tõendaja akrediteerijale kohaldatakse toote nõuetele vastavuse tõendamise seaduse §-s 14 1 sätestatut.",
      "rdfs:label": {
        "@value": "SOS_Par_31 (redaktsioon 171122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171122",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_31_v12971159"
      },
      "estleg:versionValidTo": {
        "@value": "2008-06-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_31_v12971159",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 32 nimetatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 37 sätestatud tingimustele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Isiku nõuetele vastavuse hindaja ja tõendaja akrediteerijale kohaldatakse toote nõuetele vastavuse tõendamise seaduse §-s 14 1 sätestatut. (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "SOS_Par_31 (redaktsioon 12971159)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12971159",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_31_v13328490"
      },
      "estleg:versionValidTo": {
        "@value": "2010-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_31_v13328490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 32 nimetatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 37 sätestatud tingimustele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Kehtetu – (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "SOS_Par_31 (redaktsioon 13328490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13328490",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_31_v13329412"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_31_v13329412",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 32 nimetatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 37 sätestatud tingimustele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Kehtetu - (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "SOS_Par_31 (redaktsioon 13329412)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329412",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_31_v129062014073"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_31_v129062014073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; kehtetu - olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Kehtetu - (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "SOS_Par_31 (redaktsioon 129062014073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014073"
    },
    {
      "@id": "estleg:SOS_Par_32_v171122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegutseda surveseadmetööde tegijana või isiku nõuetele vastavuse hindaja ja tõendajana (edaspidi ettevõtja ), esitab riikliku erinõuetega tegevusaladel tegutsevate ettevõtjate registri (edaspidi register ) volitatud töötlejale registreerimistaotluse. (2) Registreerimistaotluses peavad sisalduma: ettevõtja nimi, aadress ja muud kontaktandmed, registrikood või isikukood või viimase puudumisel sünniaeg; tegevusala (surveseadmetööde tegemine või isiku nõuetele vastavuse hindamine ja tõendamine), millel soovitakse tegutseda; surveseadmetööde tegijana tegutsemise soovi korral töid juhtiva isiku nimi, isikukood või selle puudumisel sünniaeg, kontaktandmed ning nõuetele vastavust tõendava dokumendi number, väljaandmise kuupäev, väljaandja nimi ja kontaktandmed; isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise soovi korral vastutuskindlustuse suurus ja kehtivusaeg ning kindlustust tõendava dokumendi väljastanud kindlustusandja nimi, registrikood, aadress ja muud kontaktandmed; akrediteeringu olemasolu korral teave, milliste toimingute tegemiseks ja kelle poolt ettevõtja on akrediteeritud ning akrediteeringut tõendava dokumendi number, väljaandja nimi ja kontaktandmed; registreerimistaotlusele allakirjutanud isiku nimi, ametinimetus ja kontaktandmed. (3) Registreerimistaotluse esitaja vastutab tema poolt registrile esitatud andmete õigsuse eest. (4) Ettevõtja võib registreerimistaotluses esitada lisaks käesoleva paragrahvi lõikes 2 nimetatud andmetele täpsustatud andmed tegevusala kohta, millel ta soovib tegutseda. (5) Registreerimistaotluse ja registreeringuandmete muutmise taotluse vorminõuded ja esitamise korra kehtestab majandusminister.",
      "rdfs:label": {
        "@value": "SOS_Par_32 (redaktsioon 171122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171122",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_32_v696432"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_32_v696432",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegutseda surveseadmetööde tegijana või isiku nõuetele vastavuse hindaja ja tõendajana (edaspidi ettevõtja ), esitab riikliku erinõuetega tegevusaladel tegutsevate ettevõtjate registri (edaspidi register ) volitatud töötlejale registreerimistaotluse. (2) Registreerimistaotluses peavad sisalduma: ettevõtja nimi, aadress ja muud kontaktandmed, registrikood või isikukood või viimase puudumisel sünniaeg; tegevusala (surveseadmetööde tegemine või isiku nõuetele vastavuse hindamine ja tõendamine), millel soovitakse tegutseda; surveseadmetööde tegijana tegutsemise soovi korral töid juhtiva isiku nimi, isikukood või selle puudumisel sünniaeg, kontaktandmed ning nõuetele vastavust tõendava dokumendi number, väljaandmise kuupäev, väljaandja nimi ja kontaktandmed; isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise soovi korral vastutuskindlustuse suurus ja kehtivusaeg ning kindlustust tõendava dokumendi väljastanud kindlustusandja nimi, registrikood, aadress ja muud kontaktandmed; akrediteeringu olemasolu korral teave, milliste toimingute tegemiseks ja kelle poolt ettevõtja on akrediteeritud ning akrediteeringut tõendava dokumendi number, väljaandja nimi ja kontaktandmed; registreerimistaotlusele allakirjutanud isiku nimi, ametinimetus ja kontaktandmed. (3) Registreerimistaotluse esitaja vastutab tema poolt registrile esitatud andmete õigsuse eest. (4) Ettevõtja võib registreerimistaotluses esitada lisaks käesoleva paragrahvi lõikes 2 nimetatud andmetele täpsustatud andmed tegevusala kohta, millel ta soovib tegutseda. (5) Registreerimistaotluse ja registreeringuandmete muutmise taotluse vorminõuded ja esitamise korra kehtestab majandus- ja kommunikatsiooniminister.",
      "rdfs:label": {
        "@value": "SOS_Par_32 (redaktsioon 696432)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696432",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_32_v729024"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_32_v729024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik, kes soovib tegutseda surveseadmetööde tegijana või isiku nõuetele vastavuse hindaja ja tõendajana (edaspidi ettevõtja ), esitab registreerimistaotluse majandustegevuse registri (edaspidi register ) registripidajale. (2) Registreerimistaotluses peavad sisalduma: ettevõtja nimi, aadress ja muud kontaktandmed, registrikood või isikukood või viimase puudumisel sünniaeg; tegevusala (surveseadmetööde tegemine või isiku nõuetele vastavuse hindamine ja tõendamine), millel soovitakse tegutseda; surveseadmetööde tegijana tegutsemise soovi korral töid juhtiva isiku nimi, isikukood või selle puudumisel sünniaeg, pädevuse ulatus, kontaktandmed ning nõuetele vastavust tõendava dokumendi number, väljaandmise kuupäev, väljaandja nimi ja kontaktandmed; isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise soovi korral vastutuskindlustuse suurus ja kehtivusaeg ning kindlustust tõendava dokumendi väljastanud kindlustusandja nimi, registrikood, aadress ja muud kontaktandmed; akrediteeringu olemasolu korral teave, milliste toimingute tegemiseks ja kelle poolt ettevõtja on akrediteeritud ning akrediteeringut tõendava dokumendi number, väljaandja nimi ja kontaktandmed; registreerimistaotlusele allakirjutanud isiku nimi, ametinimetus ja kontaktandmed. (3) --(5) Kehtetud -",
      "rdfs:label": {
        "@value": "SOS_Par_32 (redaktsioon 729024)",
        "@language": "et"
      },
