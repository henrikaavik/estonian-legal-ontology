      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_38_v129062014073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses ja selle alusel kehtestatud õigusaktides sätestatud nõuete täitmise üle teostab riiklikku järelevalvet Tehnilise Järelevalve Amet (edaspidi korrakaitseorgan). (2) Korrakaitseorgani pädevusse kuulub: järelevalve turule lastud surveseadme nõuetele vastavuse üle (turujärelevalve); järelevalve surveseadme kasutamise ja surveseadmetööde tegemise vastavuse üle käesoleva seadusega ja selle alusel kehtestatud nõuetele; järelevalve tunnustatud asutuse, tunnustatud erapooletu asutuse, tehnilise kontrolli teostaja ja ettevõtja suhtes käesoleva seadusega ja selle alusel kehtestatud nõuete järgimise üle; surveseadmega toimunud avarii ja õnnetuse tekkepõhjuste väljaselgitamine; järelevalve käigus ettekirjutuste ja otsuste tegemine.",
      "rdfs:label": {
        "@value": "SOS_Par_38 (redaktsioon 129062014073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014073"
    },
    {
      "@id": "estleg:SOS_Par_39_v171122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
