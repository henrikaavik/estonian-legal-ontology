        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_35_v129062014073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
