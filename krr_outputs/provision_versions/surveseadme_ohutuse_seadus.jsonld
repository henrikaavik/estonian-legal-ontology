      }
    },
    {
      "@id": "estleg:SOS_Par_18_v697061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Surveseadme kaitsevöönd on surveseadet, kui see on iseseisev ehitis, ümbritsev maa-ala, õhuruum või veekogu, kus ohutuse tagamise vajadusest lähtudes kitsendatakse kinnisasja kasutamist. (2) Surveseadme kaitsevööndis peab hoiduma tegevustest, mis võivad kahjustada surveseadet, sealhulgas ei tohi: tõkestada juurdepääsu surveseadmele, ladustada jäätmeid, kemikaale või väetisi, istutada puid ja põõsaid; surveseadme omaniku loata ehitada, teha lõhkamis-, puurimis- ja kaevetöid, samuti üleujutus-, niisutus- ja maaparandustöid, ladustada ja teisaldada raskusi ning organiseerida ülesõite või teha muid surveseadme ohutust mõjutada võivaid töid ; kehtetu - (3) Surveseadme kaitsevööndi ulatuse kehtestab Vabariigi Valitsus tulenevalt surveseadme ohutasemest, survest ja asukohast.",
      "rdfs:label": {
        "@value": "SOS_Par_18 (redaktsioon 697061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "697061",
      "estleg:supersededByVersion": {
        "@id": "estleg:SOS_Par_18_v748803"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_18_v748803",
      "@type": [
        "owl:NamedIndividual",
