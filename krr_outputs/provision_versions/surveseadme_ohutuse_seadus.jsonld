        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SOS_Par_43_v748803",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SOS_Par_43"
