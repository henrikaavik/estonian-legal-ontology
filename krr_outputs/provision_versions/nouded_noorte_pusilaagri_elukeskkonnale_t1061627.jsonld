    {
      "@id": "estleg:Reg_1061627_Par_6_v1061627",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061627_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ruumide sisustus peab vastama noorte vanusele ja arvule laagris ning olema kergesti puhastatav ja vajaduse korral desinfitseeritav. Ruumide sisustus peab vastama noorte vanusele ja arvule laagris ning olema kergesti puhastatav ja vajaduse korral desinfitseeritav. 2 (2) Igal noorel peab olema isiklik magamiskoht. Igal noorel peab olema isiklik magamiskoht. 3 (3) Tagatud peab olema võimalus riiete ja jalanõude kuivatamiseks. Tagatud peab olema võimalus riiete ja jalanõude kuivatamiseks. 4 (4) Esmaabivahendid peavad olema noortele kättesaadavas kohas. Esmaabivahendid peavad olema noortele kättesaadavas kohas. 5 (5) Eluruumis peab olema võimalus paigutada isiklikke riideid ja tarbeesemeid lahti pakituna, sealhulgas vähemalt osa neist privaatselt. Eluruumis peab olema võimalus paigutada isiklikke riideid ja tarbeesemeid lahti pakituna, sealhulgas vähemalt osa neist privaatselt.",
      "rdfs:label": {
        "@value": "Reg_1061627_Par_6 (redaktsioon 1061627)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061627",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061627",
