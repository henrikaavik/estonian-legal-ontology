      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061627_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Noorte püsilaagril peab olema omaette ja heakorrastatud maa-ala. Noorte püsilaagril peab olema omaette ja heakorrastatud maa-ala. 2 (2) Pimedal ajal tuleb tagada laagri õueala valgustatus. Pimedal ajal tuleb tagada laagri õueala valgustatus. 3 (3) Laagri maa-alal välitingimustes peab olema varjus viibimise võimalus. Laagri maa-alal välitingimustes peab olema varjus viibimise võimalus. 4 (4) Spordiväljaku mängu- ja võimlemisvahendid, nende konstruktsioon, mõõtmed ja pindade viimistlus peavad olema ohutud ning võimaldama noortele eakohaseid, mitmekesiseid ja arendavaid tegevusi. Spordiväljaku mängu- ja võimlemisvahendid, nende konstruktsioon, mõõtmed ja pindade viimistlus peavad olema ohutud ning võimaldama noortele eakohaseid, mitmekesiseid ja arendavaid tegevusi. 5 (5) Kasutatav supluskoht peab vastama veeseaduse alusel suplusveele ja supelrannale kehtestatud nõuetele. Kasutatav supluskoht peab vastama veeseaduse alusel suplusveele ja supelrannale kehtestatud nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1061627_Par_2 (redaktsioon 1061627)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061627",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061627",
      "estleg:sourceAct": "Nõuded noorte püsilaagri elukeskkonnale",
      "estleg:provisionRef": "Reg_1061627 § 2",
      "estleg:partOfAct": {
