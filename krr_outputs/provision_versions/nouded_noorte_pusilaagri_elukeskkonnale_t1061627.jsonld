      "estleg:sourceAct": "Nõuded noorte püsilaagri elukeskkonnale",
      "estleg:provisionRef": "Reg_1061627 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061627_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061627_Par_4_v1061627",
      "@type": [
