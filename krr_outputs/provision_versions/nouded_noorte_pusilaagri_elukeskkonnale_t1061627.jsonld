    {
      "@id": "estleg:Reg_1061627_Par_3_v1061627",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061627_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ruumid peavad vastama ehitusseadustiku § 11 lõike 4 alusel kehtestatud majandus- ja taristuministri 2. juuli 2015. a määruse nr 85 „Eluruumile esitatavad nõuded” § 2 lõike 1 punktis 1, § 3 lõikes 1 ning § 4 lõigetes 3, 4 ja 6 sätestatud nõuetele. Ruumid peavad vastama ehitusseadustiku § 11 lõike 4 alusel kehtestatud majandus- ja taristuministri 2. juuli 2015. a määruse nr 85 „Eluruumile esitatavad nõuded” § 2 lõike 1 punktis 1, § 3 lõikes 1 ning § 4 lõigetes 3, 4 ja 6 sätestatud nõuetele. 2 (2) Eluruumide minimaalne pindala on 4 m² noore kohta. Põhjendatud juhtudel võib noore kohta arvestatav pindala olla nimetatust kuni 10% väiksem, kui see on sobiv ja turvaline. Eluruumide minimaalne pindala on 4 m² noore kohta. Põhjendatud juhtudel võib noore kohta arvestatav pindala olla nimetatust kuni 10% väiksem, kui see on sobiv ja turvaline. 3 (3) Eluruumid peavad olema köetavad. Mistahes kütusel töötava ahju, kamina, pliidi või muu kütteseadmega köetavas hoones peab küttekolle asuma väljaspool eluruume. Eluruumid peavad olema köetavad. Mistahes kütusel töötava ahju, kamina, pliidi või muu kütteseadmega köetavas hoones peab küttekolle asuma väljaspool eluruume.",
      "rdfs:label": {
        "@value": "Reg_1061627_Par_3 (redaktsioon 1061627)",
        "@language": "et"
      },
