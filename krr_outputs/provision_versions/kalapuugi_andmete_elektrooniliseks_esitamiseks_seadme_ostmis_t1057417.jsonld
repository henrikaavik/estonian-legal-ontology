    {
      "@id": "estleg:Reg_1057417_Par_3_v1057417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057417_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Omafinantseeringu minimaalne määr on 10 protsenti abikõlblike kulude maksumusest. Omafinantseeringu minimaalne määr on 10 protsenti abikõlblike kulude maksumusest. 2 (2) Toetuse maksimaalne suurus ühe seadme kohta on 300 eurot. Toetuse maksimaalne suurus ühe seadme kohta on 300 eurot. 3 (3) Maksimaalne seadmete arv taotleja kohta on üks seade iga talle antud kaluri kalapüügiloa kohta, mis on kehtiv toetuse taotlemise hetkel. Maksimaalne seadmete arv taotleja kohta on üks seade iga talle antud kaluri kalapüügiloa kohta, mis on kehtiv toetuse taotlemise hetkel.",
      "rdfs:label": {
        "@value": "Reg_1057417_Par_3 (redaktsioon 1057417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057417",
