    {
      "@id": "estleg:Reg_1058321_Par_6_v1058321",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058321_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Nõuetekohase taotluse rahuldamise otsuse teeb PRIA kalandusturu korraldamise seaduse § 45 lõike 2 punkti 3 alusel. Nõuetekohase taotluse rahuldamise otsuse teeb PRIA kalandusturu korraldamise seaduse § 45 lõike 2 punkti 3 alusel. 2 (2) Taotluse rahuldamata jätmise otsuse teeb PRIA kalandusturu korraldamise seaduse § 45 lõikes 6 sätestatud alustel. Taotluse rahuldamata jätmise otsuse teeb PRIA kalandusturu korraldamise seaduse § 45 lõikes 6 sätestatud alustel. 3 (3) Taotluse rahuldamise või rahuldamata jätmise otsuse teeb PRIA 30 tööpäeva jooksul arvates taotluse esitamisest. Taotluse rahuldamise või rahuldamata jätmise otsuse teeb PRIA 30 tööpäeva jooksul arvates taotluse esitamisest.",
      "rdfs:label": {
        "@value": "Reg_1058321_Par_6 (redaktsioon 1058321)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058321",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058321",
      "estleg:sourceAct": "Perioodi 2021–2027 kalanduse kontrolli ja järelevalve toetus",
      "estleg:provisionRef": "Reg_1058321 § 6",
