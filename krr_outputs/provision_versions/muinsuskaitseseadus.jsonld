      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MUINSU_Par_44 (redaktsioon 129062014042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014042",
