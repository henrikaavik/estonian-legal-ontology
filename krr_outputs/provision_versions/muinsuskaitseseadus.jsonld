      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Amet nõustab mälestise või muinsuskaitsealal asuva ehitise omanikku või valdajat mälestise või ehitise hooldamise, remondi, ehitamise, konserveerimise ja restaureerimise küsimustes, annab juhiseid ning väljastab vajaduse korral hoolduskava.",
      "rdfs:label": {
        "@value": "MUINSU_Par_44 (redaktsioon 119032019013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019013"
    },
