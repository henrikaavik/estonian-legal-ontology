        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "MUINSU_Par_48 (redaktsioon 112072014100)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014100",
