      }
    },
    {
      "@id": "estleg:Reg_1052910_Par_2_v1052910",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052910_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Veterinaararsti sobivustesti (edaspidi sobivustest) koostab Eesti Maaülikooli veterinaarmeditsiini ja loomakasvatuse instituut. Veterinaararsti sobivustesti (edaspidi sobivustest) koostab Eesti Maaülikooli veterinaarmeditsiini ja loomakasvatuse instituut. 2 (2) Sobivustest peab võimaldama kontrollida ja hinnata taotleja kutse-, eri- ja ametialaseid teadmisi ning oskusi ja vilumust, mis on vajalikud Eestis veterinaarteenuse osutamiseks. Sobivustest peab võimaldama kontrollida ja hinnata taotleja kutse-, eri- ja ametialaseid teadmisi ning oskusi ja vilumust, mis on vajalikud Eestis veterinaarteenuse osutamiseks. 3 (3) Sobivustest peab lisaks lõikes 2 nimetatule võimaldama kontrollida ja hinnata vähemalt: 1 1) teadmisi Eestis veterinaarkorraldust, loomatervist, toiduohutust ja -hügieeni, loomade ravimist ja söötmist reguleerivatest õigusaktidest ning riikliku veterinaarjärelevalve ja veterinaarkontrolli toimimisest; 2 2) teadmisi veterinaararsti kutse-eetikast ja heast veterinaarsest tavast. Sobivustest peab lisaks lõikes 2 nimetatule võimaldama kontrollida ja hinnata vähemalt: teadmisi Eestis veterinaarkorraldust, loomatervist, toiduohutust ja -hügieeni, loomade ravimist ja söötmist reguleerivatest õigusaktidest ning riikliku veterinaarjärelevalve ja veterinaarkontrolli toimimisest; teadmisi veterinaararsti kutse-eetikast ja heast veterinaarsest tavast.",
      "rdfs:label": {
        "@value": "Reg_1052910_Par_2 (redaktsioon 1052910)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052910",
