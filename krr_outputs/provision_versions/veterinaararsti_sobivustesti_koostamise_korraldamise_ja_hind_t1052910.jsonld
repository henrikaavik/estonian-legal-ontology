        "@value": "Sätete redaktsioonid: Veterinaararsti sobivustesti koostamise, korraldamise ja hindamise ning sobivustesti tulemustest teatamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Veterinaararsti sobivustesti koostamise, korraldamise ja hindamise ning sobivustesti tulemustest teatamise kord"
    },
    {
      "@id": "estleg:Reg_1052910_Par_1_v1052910",
      "@type": [
