    {
      "@id": "estleg:Reg_302337_Par_4_v302337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302337_Par_4"
