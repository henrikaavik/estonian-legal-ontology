      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Erakorraline toetus põllumajandustootjale loodusõnnetusest põhjustatud kahju hüvitamiseks (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Erakorraline toetus põllumajandustootjale loodusõnnetusest põhjustatud kahju hüvitamiseks"
    },
    {
      "@id": "estleg:Reg_1060809_Par_1_v1060809",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060809_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 23 „Erakorraline ajutine toetus loodusõnnetustest eriti mõjutatud põllumajandustootjatele” raames põllumajandustootjale loodusõnnetusest põhjustatud kahju hüvitamiseks erakorralise toetuse (edaspidi toetus) andmise ja kasutamise tingimused ning kord. Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 23 „Erakorraline ajutine toetus loodusõnnetustest eriti mõjutatud põllumajandustootjatele” raames põllumajandustootjale loodusõnnetusest põhjustatud kahju hüvitamiseks erakorralise toetuse (edaspidi toetus) andmise ja kasutamise tingimused ning kord.",
      "rdfs:label": {
        "@value": "Reg_1060809_Par_1 (redaktsioon 1060809)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060809",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060809",
      "estleg:sourceAct": "Erakorraline toetus põllumajandustootjale loodusõnnetusest põhjustatud kahju hüvitamiseks",
      "estleg:provisionRef": "Reg_1060809 § 1",
      "estleg:partOfAct": {
