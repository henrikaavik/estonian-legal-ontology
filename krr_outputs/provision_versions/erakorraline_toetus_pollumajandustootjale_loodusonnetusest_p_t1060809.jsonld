      }
    },
    {
      "@id": "estleg:Reg_1060809_Par_6_v1060809",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060809_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluses esitatud andmete õigsust ning taotleja, taotluse ja toetatava tegevuse toetuse saamise nõuetele vastavust kontrollib PRIA. Taotluses esitatud andmete õigsust ning taotleja, taotluse ja toetatava tegevuse toetuse saamise nõuetele vastavust kontrollib PRIA.",
      "rdfs:label": {
        "@value": "Reg_1060809_Par_6 (redaktsioon 1060809)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060809",
