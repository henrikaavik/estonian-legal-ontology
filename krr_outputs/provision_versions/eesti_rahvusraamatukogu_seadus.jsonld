      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EESTI_3_Par_4_v12825129",
      "@type": [
        "owl:NamedIndividual",
