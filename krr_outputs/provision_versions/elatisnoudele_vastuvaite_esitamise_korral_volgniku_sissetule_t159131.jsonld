  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_elatisnoudele_vastuvaite_esitamise_korral_volgniku_sissetule_t159131_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine"
    },
    {
      "@id": "estleg:Reg_159131_Par_1_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastuväite esitaja (edaspidi võlgnik) kasutab oma sissetuleku, vara ja majandusliku seisundi kohta andmete esitamiseks andmete loetelu vormi (lisa). Vastuväite esitaja (edaspidi võlgnik) kasutab oma sissetuleku, vara ja majandusliku seisundi kohta andmete esitamiseks andmete loetelu vormi (lisa). 2 (2) Võlgnik esitab andmed võimalikult lühidalt ja täpselt. Võlgnik esitab andmed võimalikult lühidalt ja täpselt. 3 (3) Võlgnik lisab andmete loetelule esitatud andmeid tõendavad dokumendid. Võlgnik lisab andmete loetelule esitatud andmeid tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "Reg_159131_Par_1 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
    {
      "@id": "estleg:Reg_159131_Par_2_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgnik märgib enda kohta järgmised andmed: 1 1) ees- ja perekonnanimi; 2 2) isikukood või selle puudumisel sünniaeg; 3 3) perekonnaseis; 4 4) elukutse; 5 5) töökohad. Võlgnik märgib enda kohta järgmised andmed: ees- ja perekonnanimi; isikukood või selle puudumisel sünniaeg; perekonnaseis; elukutse; töökohad.",
      "rdfs:label": {
        "@value": "Reg_159131_Par_2 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
    {
      "@id": "estleg:Reg_159131_Par_3_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgnik märgib oma ülalpeetavate kohta järgmised andmed: 1 1) ülalpeetavate ees- ja perekonnanimed, elukoht, sugulussuhe võlgnikuga; 2 2) ülalpeetavate netosissetulekud; 3 3) ülalpidamiskohustusest tuleneva igakuise elatusraha suurus juhul, kui see on kindlaks määratud. Võlgnik märgib oma ülalpeetavate kohta järgmised andmed: ülalpeetavate ees- ja perekonnanimed, elukoht, sugulussuhe võlgnikuga; ülalpeetavate netosissetulekud; ülalpidamiskohustusest tuleneva igakuise elatusraha suurus juhul, kui see on kindlaks määratud.",
      "rdfs:label": {
        "@value": "Reg_159131_Par_3 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
    {
      "@id": "estleg:Reg_159131_Par_4_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgnik märgib enda ja temaga koos elavate perekonnaliikmete ühe kuu netosissetuleku ning sellelt tehtavate mahaarvamiste kohta järgmised andmed: 1 1) töölepingu, töövõtu-, käsundus- või muu teenuse osutamiseks sõlmitud võlaõigusliku lepingu alusel või avalikust teenistusest saadud sissetulek; 2 2) ettevõtlusest saadud sissetulek; 3 3) üüri- ja renditulud; 4 4) tulud kapitalilt; 5 5) saadud ülalpidamismaksed; 6 6) sotsiaaltoetused riigilt ja kohalikult omavalitsuselt; 7 7) muud tulud; 8 8) kindlustusmaksed; 9 9) ettevõtlusega kaasnevad kulutused; 10 10) muud koormatised ja mahaarvamised saadud sissetulekutelt. Võlgnik märgib enda ja temaga koos elavate perekonnaliikmete ühe kuu netosissetuleku ning sellelt tehtavate mahaarvamiste kohta järgmised andmed: töölepingu, töövõtu-, käsundus- või muu teenuse osutamiseks sõlmitud võlaõigusliku lepingu alusel või avalikust teenistusest saadud sissetulek; ettevõtlusest saadud sissetulek; üüri- ja renditulud; tulud kapitalilt; saadud ülalpidamismaksed; sotsiaaltoetused riigilt ja kohalikult omavalitsuselt; muud tulud; kindlustusmaksed; ettevõtlusega kaasnevad kulutused; muud koormatised ja mahaarvamised saadud sissetulekutelt.",
      "rdfs:label": {
        "@value": "Reg_159131_Par_4 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
    {
      "@id": "estleg:Reg_159131_Par_5_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgnik märgib enda ja temaga koos elavatele perekonnaliikmetele kuuluva vara kohta järgmised andmed: 1 1) andmed kinnisvara kohta (asukoht, suurus, kasutusviis, seisukord, ehitise kasutuselevõtu aasta) ja selle väärtus eurodes; 2 2) pangaarved (sh pank, kus arve asub) ja pangaarvel hoiustatu väärtus eurodes; 3 3) väärtpaberid (sh liik, emitent) ja nende väärtus eurodes; 4 4) mootorsõidukid (sh liik ja registreerimistähis, esmase registreerimise aasta) ja nende väärtus eurodes; 5 5) muu oluline vara (sh kollektsioonid, kunstiesemed, väärtasjad) ja selle väärtus eurodes. RT I 2010-12-29 166 129122010166 2011-01-01 Võlgnik märgib enda ja temaga koos elavatele perekonnaliikmetele kuuluva vara kohta järgmised andmed: andmed kinnisvara kohta (asukoht, suurus, kasutusviis, seisukord, ehitise kasutuselevõtu aasta) ja selle väärtus eurodes; pangaarved (sh pank, kus arve asub) ja pangaarvel hoiustatu väärtus eurodes; väärtpaberid (sh liik, emitent) ja nende väärtus eurodes; mootorsõidukid (sh liik ja registreerimistähis, esmase registreerimise aasta) ja nende väärtus eurodes; muu oluline vara (sh kollektsioonid, kunstiesemed, väärtasjad) ja selle väärtus eurodes.",
      "rdfs:label": {
        "@value": "Reg_159131_Par_5 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
    {
      "@id": "estleg:Reg_159131_Par_6_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgnik märgib enda ja temaga koos elavate perekonnaliikmete varaliselt hinnatavate kohustuste kohta järgmised andmed: 1 1) kohustused krediidiasutustele (krediidiasutuse nimi, kohustuse liik, kohustuse lõpptähtaeg, kohustuse jääk/limiit eurodes, igakuise makse suurus); RT I 2010-12-29 166 129122010166 2011-01-01 2 2) kohustused teistele võlausaldajatele (võlausaldaja nimi, kohustuse ja kohustuse jäägi suurus eurodes, kohustuse lõpptähtaeg, igakuise makse suurus). 2011-01-03 12:54:11 Veaparandus – asendatud sõna \"kroonides\" sõnaga \"eurodes\" ja lisatud muutmismärge. RT I 2010-12-29 166 129122010166 2011-01-01 Võlgnik märgib enda ja temaga koos elavate perekonnaliikmete varaliselt hinnatavate kohustuste kohta järgmised andmed: kohustused krediidiasutustele (krediidiasutuse nimi, kohustuse liik, kohustuse lõpptähtaeg, kohustuse jääk/limiit eurodes, igakuise makse suurus); kohustused teistele võlausaldajatele (võlausaldaja nimi, kohustuse ja kohustuse jäägi suurus eurodes, kohustuse lõpptähtaeg, igakuise makse suurus).",
      "rdfs:label": {
        "@value": "Reg_159131_Par_6 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
    {
      "@id": "estleg:Reg_159131_Par_7_v159131",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159131_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlgnik märgib enda ja temaga koos elavate perekonnaliikmete ühe kuu vältimatute püsikulutuste kohta järgmised andmed: 1 1) eluasemekulud; 2 2) kulutused toidule; 3 3) kulutused transpordile; 4 4) sidekulud; 5 5) kulutused tervishoiule; 6 6) kulutused laste koolikohustuse täitmisele; 7 7) muud vältimatud püsikulutused. Võlgnik märgib enda ja temaga koos elavate perekonnaliikmete ühe kuu vältimatute püsikulutuste kohta järgmised andmed: eluasemekulud; kulutused toidule; kulutused transpordile; sidekulud; kulutused tervishoiule; kulutused laste koolikohustuse täitmisele; muud vältimatud püsikulutused.",
      "rdfs:label": {
        "@value": "Reg_159131_Par_7 (redaktsioon 159131)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159131",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159131",
      "estleg:sourceAct": "Elatisnõudele vastuväite esitamise korral võlgniku sissetuleku, vara ja majandusliku seisundi kohta andmete esitamise vormi kehtestamine",
      "estleg:provisionRef": "Reg_159131 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159131_Map"
      }
    },
