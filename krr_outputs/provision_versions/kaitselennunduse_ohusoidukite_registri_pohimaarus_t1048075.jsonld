    {
      "@id": "estleg:Reg_1048075_Par_14_v1048075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048075_Par_14"
      },
