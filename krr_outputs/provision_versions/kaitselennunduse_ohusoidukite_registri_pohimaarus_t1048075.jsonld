    {
      "@id": "estleg:Reg_1048075_Par_13_v1048075",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048075_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-10-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registritoimingu alusdokument on õhusõidukit iseloomustav ja selle käitamist kajastav kirjalik dokument. Registritoimingu alusdokument on õhusõidukit iseloomustav ja selle käitamist kajastav kirjalik dokument. 2 (2) Registritoimingute alusdokumentide üle peetakse arvestust registri volitatud töötleja dokumendihaldussüsteemis või registris. Registritoimingute alusdokumentide üle peetakse arvestust registri volitatud töötleja dokumendihaldussüsteemis või registris.",
      "rdfs:label": {
        "@value": "Reg_1048075_Par_13 (redaktsioon 1048075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048075",
