        "@value": "2026-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ööpäevaringse erihooldusteenuse osutamiseks kasutatav eraldusruum peab vastama §-s 7 sätestatud nõuetele, mida kohaldatakse vastavalt teenusesaaja abivajadusele ja eale. Ööpäevaringse erihooldusteenuse osutamiseks kasutatav eraldusruum peab vastama §-s 7 sätestatud nõuetele, mida kohaldatakse vastavalt teenusesaaja abivajadusele ja eale.",
      "rdfs:label": {
        "@value": "Reg_1062302_Par_10 (redaktsioon 1062302)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062302",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062302",
      "estleg:sourceAct": "Nõuded elukeskkonnale sotsiaalteenuste osutamisel",
      "estleg:provisionRef": "Reg_1062302 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062302_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062302_Par_11_v1062302",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062302_Par_11"
      },
