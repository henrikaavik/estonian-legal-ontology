    },
    {
      "@id": "estleg:Reg_1062302_Par_1_v1062302",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062302_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse nõuded elukeskkonnale, kus osutatakse sotsiaalteenust, ning terviseriskide ohjamisele ja riskitegurite vähendamisele selles keskkonnas järgmiste sotsiaalhoolekande seaduses või selle alusel kehtestatud määrustes nimetatud teenuste osutamisel: 1 1) väljaspool kodu osutatav üldhooldusteenus; 2 2) turvakoduteenus; 3 3) suure hooldus- ja abivajadusega lapse hoiu teenus; 4 4) asendushooldusteenus asendus- ja perekodus (edaspidi asendushooldusteenus); 5 5) järelhooldusteenus; 6 6) erihoolekandeteenused, kui teenust osutatakse teenuseosutaja omandis olevates või temale kasutamiseks antud ruumides; 7 7) kinnise lasteasutuse teenus; 8 8) eluruumi tagamise teenus; 9 9) varjupaigateenus. Määrusega kehtestatakse nõuded elukeskkonnale, kus osutatakse sotsiaalteenust, ning terviseriskide ohjamisele ja riskitegurite vähendamisele selles keskkonnas järgmiste sotsiaalhoolekande seaduses või selle alusel kehtestatud määrustes nimetatud teenuste osutamisel: väljaspool kodu osutatav üldhooldusteenus; turvakoduteenus; suure hooldus- ja abivajadusega lapse hoiu teenus; asendushooldusteenus asendus- ja perekodus (edaspidi asendushooldusteenus); järelhooldusteenus; erihoolekandeteenused, kui teenust osutatakse teenuseosutaja omandis olevates või temale kasutamiseks antud ruumides; kinnise lasteasutuse teenus; eluruumi tagamise teenus; varjupaigateenus.",
      "rdfs:label": {
        "@value": "Reg_1062302_Par_1 (redaktsioon 1062302)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062302",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062302",
      "estleg:sourceAct": "Nõuded elukeskkonnale sotsiaalteenuste osutamisel",
      "estleg:provisionRef": "Reg_1062302 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062302_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062302_Par_10_v1062302",
      "@type": [
