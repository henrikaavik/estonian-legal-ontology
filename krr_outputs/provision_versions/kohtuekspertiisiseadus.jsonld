        "@value": "2023-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisriigi ekspertiisiasutusele või muule välisriigi isikule ekspertiisi või uuringu tegemisele kohaldatakse tasulise ekspertiisi kohta sätestatut, kui riikidevahelistest või rahvusvahelistest kokkulepetest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "KOHTUE_Par_15 (redaktsioon 103022023001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103022023001"
    },
    {
      "@id": "estleg:KOHTUE_Par_16_v27097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KOHTUE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Justiitsministeerium tagab nimekirja kättesaadavuse kohtutele ja Politseiametile. (2) Kohus võimaldab kohtu ruumides nimekirjaga tutvuda kõigil soovijatel.",
      "rdfs:label": {
        "@value": "KOHTUE_Par_16 (redaktsioon 27097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27097",
