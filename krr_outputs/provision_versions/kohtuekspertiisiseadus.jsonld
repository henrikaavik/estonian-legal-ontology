        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuekspertiisiseaduses sätestatakse kohtueksperdi, riikliku ekspertiisiasutuse ja riiklikult tunnustatud eksperdi õiguslik seisund ning eksperdi õiguste ja kohustuste tekke alused kriminaalmenetluses, tsiviil- ja halduskohtumenetluses ning haldusõiguserikkumise asja menetluses (edaspidi menetlusasi).",
      "rdfs:label": {
        "@value": "KOHTUE_Par_1 (redaktsioon 27097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27097",
      "estleg:supersededByVersion": {
        "@id": "estleg:KOHTUE_Par_1_v185326"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
