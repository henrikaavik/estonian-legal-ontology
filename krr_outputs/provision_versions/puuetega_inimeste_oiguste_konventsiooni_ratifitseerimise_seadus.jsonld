      "estleg:versionValidFrom": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on Ühinenud Rahvaste Organisatsiooni (edaspidi ÜRO) Peaassamblee poolt vastu võetud 2006. aasta 13. detsembril New Yorgis ja millele Eesti Vabariik kirjutas alla 2007. aasta 25. septembril.",
      "rdfs:label": {
        "@value": "puuetega_inimeste_oiguste_konventsiooni__Par_1 (redaktsioon 204042012005)",
        "@language": "et"
      },
