      "estleg:sourceAct": "Puuetega inimeste õiguste konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "puuetega_inimeste_oiguste_konventsiooni § 1",
      "estleg:partOfAct": {
        "@id": "estleg:puuetega_inimeste_oiguste_konventsiooni_Map_2026"
      }
    },
    {
      "@id": "estleg:puuetega_inimeste_oiguste_konventsiooni_Par_2_v204042012005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:puuetega_inimeste_oiguste_konventsiooni_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimiskirja hoiule andes teha deklaratsioon, mille kohaselt Eesti Vabariik tõlgendab konventsiooni artiklit 12 selliselt, et see ei keela pidamast isikut piiratud teovõimega isikuks, kui selline vajadus tuleneb isiku võimetusest oma tegudest aru saada või neid juhtida. Piiratud teovõimega isiku õiguste kitsendamisel lähtub Eesti enda riigisisesest õigusest.",
      "rdfs:label": {
        "@value": "puuetega_inimeste_oiguste_konventsiooni__Par_2 (redaktsioon 204042012005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "204042012005",
