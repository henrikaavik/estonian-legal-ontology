      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Avaliku teenindamise lepingu alusel teostataval liiniveol sõitja kõrgeim piletihind, sõiduki ja selle haagise piletihinnad ning sõidusoodustused Kuivastu-Virtsu, Rohuküla-Heltermaa ja Sõru-Triigi parvlaevaliinidel (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Avaliku teenindamise lepingu alusel teostataval liiniveol sõitja kõrgeim piletihind, sõiduki ja selle haagise piletihinnad ning sõidusoodustused Kuivastu-Virtsu, Rohuküla-Heltermaa ja Sõru-Triigi parvlaevaliinidel"
    },
    {
      "@id": "estleg:Reg_1030861_Par_1_v1030861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030861_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse sõitja kõrgeim piletihind ning sõiduki ja selle haagise piletihind ning sõidusoodustused avaliku teenindamise lepingu alusel teostataval liiniveol Kuivastu-Virtsu, Rohuküla-Heltermaa ja Sõru-Triigi parvlaevaliinidel (edaspidi koos parvlaevaliinidel). RT I 2019-01-08 1 108012019001 2019-05-01 Määrusega kehtestatakse sõitja kõrgeim piletihind ning sõiduki ja selle haagise piletihind ning sõidusoodustused avaliku teenindamise lepingu alusel teostataval liiniveol Kuivastu-Virtsu, Rohuküla-Heltermaa ja Sõru-Triigi parvlaevaliinidel (edaspidi koos parvlaevaliinidel).",
      "rdfs:label": {
        "@value": "Reg_1030861_Par_1 (redaktsioon 1030861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030861",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030861",
      "estleg:sourceAct": "Avaliku teenindamise lepingu alusel teostataval liiniveol sõitja kõrgeim piletihind, sõiduki ja selle haagise piletihinnad ning sõidusoodustused Kuivastu-Virtsu, Rohuküla-Heltermaa ja Sõru-Triigi parvlaevaliinidel",
      "estleg:provisionRef": "Reg_1030861 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030861_Map"
      }
    },
    {
      "@id": "estleg:Reg_1030861_Par_2_v1030861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030861_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Parvlaevadega korraldatava avaliku liiniveo sõitja kõrgeim piletihind ning sõiduki ja selle haagise piletihind kehtestatakse vastavalt määruse lisale. Parvlaevadega korraldatava avaliku liiniveo sõitja kõrgeim piletihind ning sõiduki ja selle haagise piletihind kehtestatakse vastavalt määruse lisale. 2 (2) Veo eest võib tasu küsida üksnes lähtudes käesoleva määrusega ja ühistranspordiseaduse § 31 lõike 4 alusel kehtestatud hindadest. RT I 2019-01-08 1 108012019001 2019-05-01 Veo eest võib tasu küsida üksnes lähtudes käesoleva määrusega ja ühistranspordiseaduse § 31 lõike 4 alusel kehtestatud hindadest.",
      "rdfs:label": {
        "@value": "Reg_1030861_Par_2 (redaktsioon 1030861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030861",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030861",
      "estleg:sourceAct": "Avaliku teenindamise lepingu alusel teostataval liiniveol sõitja kõrgeim piletihind, sõiduki ja selle haagise piletihinnad ning sõidusoodustused Kuivastu-Virtsu, Rohuküla-Heltermaa ja Sõru-Triigi parvlaevaliinidel",
      "estleg:provisionRef": "Reg_1030861 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030861_Map"
      }
    },
    {
