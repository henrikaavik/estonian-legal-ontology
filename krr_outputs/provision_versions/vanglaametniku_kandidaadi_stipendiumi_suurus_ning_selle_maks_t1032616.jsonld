    {
      "@id": "estleg:Reg_1032616_Par_2_v1032616",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032616_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ettevalmistusteenistuse teoreetilise ja praktilise väljaõppe ajal makstakse vanglaametniku kandidaadile stipendiumi. Ettevalmistusteenistuse teoreetilise ja praktilise väljaõppe ajal makstakse vanglaametniku kandidaadile stipendiumi. 2 (2) Stipendiumi ei maksta vanglaametniku kandidaadile: 1 1) ajal, mil tema ettevalmistusteenistus on peatatud; 2 2) vangistusseaduse § 117 lõikes 3 nimetatud õppetööst vabal ajal. Stipendiumi ei maksta vanglaametniku kandidaadile: ajal, mil tema ettevalmistusteenistus on peatatud; vangistusseaduse § 117 lõikes 3 nimetatud õppetööst vabal ajal.",
      "rdfs:label": {
        "@value": "Reg_1032616_Par_2 (redaktsioon 1032616)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032616",
