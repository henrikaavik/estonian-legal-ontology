        "@value": "Sätete redaktsioonid: Vanglaametniku kandidaadi stipendiumi suurus ning selle maksmise tingimused ja kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vanglaametniku kandidaadi stipendiumi suurus ning selle maksmise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1032616_Par_1_v1032616",
      "@type": [
