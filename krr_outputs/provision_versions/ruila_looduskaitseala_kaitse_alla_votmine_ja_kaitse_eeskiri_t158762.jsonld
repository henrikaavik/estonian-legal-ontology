      }
    },
    {
      "@id": "estleg:Reg_158762_Par_9_v158762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158762_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) tehispesade rajamine I kategooria kaitsealustele liikidele ning olemasolevate tehispesade korrashoid; 2 2) teaduslikult põhjendatud tööd loodusliku veerežiimi taastamiseks; 3 3) puu- ja põõsarinde harvendamine siirde- ja madalsookoosluste taastamiseks ja säilitamiseks, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: tehispesade rajamine I kategooria kaitsealustele liikidele ning olemasolevate tehispesade korrashoid; teaduslikult põhjendatud tööd loodusliku veerežiimi taastamiseks; puu- ja põõsarinde harvendamine siirde- ja madalsookoosluste taastamiseks ja säilitamiseks, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas.",
      "rdfs:label": {
        "@value": "Reg_158762_Par_9 (redaktsioon 158762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158762",
