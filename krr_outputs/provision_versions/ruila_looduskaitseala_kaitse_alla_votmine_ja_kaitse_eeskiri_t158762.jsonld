    {
      "@id": "estleg:Reg_158762_Par_4_v158762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158762_Par_4"
