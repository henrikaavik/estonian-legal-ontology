      "estleg:sourceAct": "Ruila looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158762 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158762_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158762_Par_8_v158762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158762_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) ehitiste püstitamine. Sihtkaitsevööndis on keelatud: majandustegevus; loodusvarade kasutamine; ehitiste püstitamine.",
      "rdfs:label": {
        "@value": "Reg_158762_Par_8 (redaktsioon 158762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158762",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158762",
      "estleg:sourceAct": "Ruila looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158762 § 8",
