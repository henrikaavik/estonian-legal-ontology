  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_ehitamise_dokumenteerimisele_ehitusdokumentide_sailitamisele_t1048898_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ehitamise dokumenteerimisele, ehitusdokumentide säilitamisele ja üleandmisele esitatavad nõuded ning hooldusjuhendile, selle hoidmisele ja üleandmisele esitatavad nõuded (16 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ehitamise dokumenteerimisele, ehitusdokumentide säilitamisele ja üleandmisele esitatavad nõuded ning hooldusjuhendile, selle hoidmisele ja üleandmisele esitatavad nõuded"
    },
    {
      "@id": "estleg:Reg_1048898_Par_1_v1048898",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048898_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega nähakse ette ehitamist kajastavate dokumentide (edaspidi ehitusdokumendid) koostamise, säilitamise ja üleandmise minimaalsed nõuded ning nõuded ehitise kasutus- ja hooldusjuhendile, selle hoidmisele ja üleandmisele. Määrusega nähakse ette ehitamist kajastavate dokumentide (edaspidi ehitusdokumendid) koostamise, säilitamise ja üleandmise minimaalsed nõuded ning nõuded ehitise kasutus- ja hooldusjuhendile, selle hoidmisele ja üleandmisele. 2 (2) Ehitamine dokumenteeritakse kui: 1 1) ehitamiseks on nõutud ehitusluba; 2 2) ehitamiseks tuleb ehitusseadustiku lisas 1 nimetatud juhtudel koos ehitusteatisega esitada ehitusprojekt; 3 3) ehitise kasutamiseks on nõutud kasutusluba; 4 4) ehitise kasutamiseks tuleb ehitusseadustiku lisas 2 nimetatud juhtudel koos kasutusteatisega esitada ehitusprojekt. Ehitamine dokumenteeritakse kui: ehitamiseks on nõutud ehitusluba; ehitamiseks tuleb ehitusseadustiku lisas 1 nimetatud juhtudel koos ehitusteatisega esitada ehitusprojekt; ehitise kasutamiseks on nõutud kasutusluba; ehitise kasutamiseks tuleb ehitusseadustiku lisas 2 nimetatud juhtudel koos kasutusteatisega esitada ehitusprojekt. 3 (3) Lammutamine ja lõikes 2 nimetamata ehitamine dokumenteeritakse üksnes mahus, mis võimaldab vajadusel ehitise ja ehitamise nõuetele vastavust tuvastada mõistliku pingutuse ja kuluga. Lammutamine ja lõikes 2 nimetamata ehitamine dokumenteeritakse üksnes mahus, mis võimaldab vajadusel ehitise ja ehitamise nõuetele vastavust tuvastada mõistliku pingutuse ja kuluga. 4 (4) Ehitustöö kohta, mida ei tehta, ehitusdokumenti ei koostata. Ehitustöö kohta, mida ei tehta, ehitusdokumenti ei koostata. 5 (5) Käesolevat määrust ei kohaldata riigikaitselise ja julgeolekuasutuse ehitise ehitamise dokumenteerimisele. Käesolevat määrust ei kohaldata riigikaitselise ja julgeolekuasutuse ehitise ehitamise dokumenteerimisele.",
      "rdfs:label": {
        "@value": "Reg_1048898_Par_1 (redaktsioon 1048898)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048898",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048898",
