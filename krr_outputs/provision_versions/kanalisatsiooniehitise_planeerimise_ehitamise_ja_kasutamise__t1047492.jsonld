  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kanalisatsiooniehitise_planeerimise_ehitamise_ja_kasutamise__t1047492_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus (26 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus"
    },
    {
      "@id": "estleg:Reg_1047492_Par_1_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määrusega kehtestatakse reovee kogumiseks, puhastamiseks või heitvee suublasse juhtimiseks rajatud kanalisatsioonitorustiku, reoveepuhasti, pumpla või muu reovee kogumise, puhastamise ja heitvee suublasse juhtimisega seotud hoone või rajatise (edaspidi kanalisatsiooniehitis) planeerimise, ehitamise ja kasutamise nõuded. Käesoleva määrusega kehtestatakse reovee kogumiseks, puhastamiseks või heitvee suublasse juhtimiseks rajatud kanalisatsioonitorustiku, reoveepuhasti, pumpla või muu reovee kogumise, puhastamise ja heitvee suublasse juhtimisega seotud hoone või rajatise (edaspidi kanalisatsiooniehitis) planeerimise, ehitamise ja kasutamise nõuded. 2 (2) Käesoleva määrusega ei kehtestata nõudeid sademevee kanalisatsiooniehitistele ega ühiskanalisatsiooni juhitava reovee eelpuhastile, välja arvatud purgimissõlme puhasti. Käesoleva määrusega ei kehtestata nõudeid sademevee kanalisatsiooniehitistele ega ühiskanalisatsiooni juhitava reovee eelpuhastile, välja arvatud purgimissõlme puhasti.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_1 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_10_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kanalisatsiooniehitise ehitamiseks vajaliku projekti koostamisel tuleb arvestada: 1 1) parimat võimalikku tehnikat; 2 2) reovee tegelikku ja prognoositavat arvutushulka ning reostusnäitajaid; 3 3) vajadust piirata saastunud sademevee juhtimist veekogusse; 4 4) vajadust tagada uue reoveepuhasti ehitamise ajal vana reoveepuhasti häireteta töö või reovee puhastamine mingil muul viisil. Kanalisatsiooniehitise ehitamiseks vajaliku projekti koostamisel tuleb arvestada: parimat võimalikku tehnikat; reovee tegelikku ja prognoositavat arvutushulka ning reostusnäitajaid; vajadust piirata saastunud sademevee juhtimist veekogusse; vajadust tagada uue reoveepuhasti ehitamise ajal vana reoveepuhasti häireteta töö või reovee puhastamine mingil muul viisil.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_10 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_11_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kanalisatsiooniehitis tuleb projekteerida ja ehitada nii, et see tagaks keskkonnakaitseloa nõuete täitmise. Kanalisatsiooniehitis tuleb projekteerida ja ehitada nii, et see tagaks keskkonnakaitseloa nõuete täitmise. 2 (2) Keskkonnakaitseluba käesoleva määruse tähenduses on keskkonnaluba ja keskkonnakompleksluba. Keskkonnakaitseluba käesoleva määruse tähenduses on keskkonnaluba ja keskkonnakompleksluba. 3 (3) Saastatuse vältimiseks peavad kanalisatsioonitorustikud olema veetihedad. Kasutusele võetavate kanalisatsioonitorustike veetiheduse hindamiseks kasutatakse Eesti standardit EVS-EN 1610:2015 „Äravoolu- ja kanalisatsioonitorustike ehitamine ja katsetamine” või muud samaväärset rahvusvaheliselt tunnustatud metoodikat. Saastatuse vältimiseks peavad kanalisatsioonitorustikud olema veetihedad. Kasutusele võetavate kanalisatsioonitorustike veetiheduse hindamiseks kasutatakse Eesti standardit EVS-EN 1610:2015 „Äravoolu- ja kanalisatsioonitorustike ehitamine ja katsetamine” või muud samaväärset rahvusvaheliselt tunnustatud metoodikat. 4 (4) Suurpuhastitel peab olema pidev elektritoide. Suurpuhastitel peab olema pidev elektritoide.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_11 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_12_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Reoveepuhastitest, välja arvatud süsteemid, mida kasutatakse alla 5 m³ heitvee immutamiseks ööpäevas, peab olema võimalik võtta proove nii juurdevoolavast reoveest kui ka väljuvast heitveest. Reoveepuhastitest, välja arvatud süsteemid, mida kasutatakse alla 5 m³ heitvee immutamiseks ööpäevas, peab olema võimalik võtta proove nii juurdevoolavast reoveest kui ka väljuvast heitveest. 2 (2) Süsteemist, mida kasutatakse alla 5 m³ heitvee immutamiseks ööpäevas, peab olema võimalik võtta proove juurdevoolavast reoveest. Süsteemist, mida kasutatakse alla 5 m³ heitvee immutamiseks ööpäevas, peab olema võimalik võtta proove juurdevoolavast reoveest.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_12 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_13_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reoveepuhasti tuleb ehitada nii, et väikepuhastil oleks toimimisaeg vähemalt 30 aastat, suurpuhastil vähemalt 50 aastat ning pinnaspuhastil, tehismärgalal, taimestikpuhastil või biotiigil vähemalt 15 aastat. Reoveepuhasti tuleb ehitada nii, et väikepuhastil oleks toimimisaeg vähemalt 30 aastat, suurpuhastil vähemalt 50 aastat ning pinnaspuhastil, tehismärgalal, taimestikpuhastil või biotiigil vähemalt 15 aastat.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_13 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_14_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Reoveepuhasti veealused metallosad tuleb valmistada happekindlast terasest või muust korrosioonikindlast materjalist. Veepealsed mustmetallosad tuleb kuumtsinkida või katta korrosioonikindla värv-, plast- või muu kattega. Reoveepuhasti veealused metallosad tuleb valmistada happekindlast terasest või muust korrosioonikindlast materjalist. Veepealsed mustmetallosad tuleb kuumtsinkida või katta korrosioonikindla värv-, plast- või muu kattega. 2 (2) Reoveepuhastite külmumisohtlikud osad tuleb soojustada. Reoveepuhastite külmumisohtlikud osad tuleb soojustada. 3 (3) Biotiikide põhja ja põhjavee kõrgeima taseme vahe peab olema vähemalt 1,2 meetrit. Kui põhjavesi on ohustatud, tuleb pinnasfiltrid, tehismärgalad ja taimestikpuhastid ning biotiigid vooderdada geomembraaniga. Biotiikide põhja ja põhjavee kõrgeima taseme vahe peab olema vähemalt 1,2 meetrit. Kui põhjavesi on ohustatud, tuleb pinnasfiltrid, tehismärgalad ja taimestikpuhastid ning biotiigid vooderdada geomembraaniga. 4 (4) Reoveepuhasti heitvett peab olema võimalik desinfitseerida kas statsionaarsete või selleks otstarbeks paigaldatavate seadmetega. Reoveepuhasti heitvett peab olema võimalik desinfitseerida kas statsionaarsete või selleks otstarbeks paigaldatavate seadmetega. 5 (5) Suurpuhastil peavad olema reoveesette käitlusseadmed. Suurpuhastil peavad olema reoveesette käitlusseadmed. 6 (6) Reoveesette tahendusväljakute äravooluvesi ning settekompostimisväljakutel kogunev sademevesi tuleb puhastada reoveepuhastis. Reoveesette tahendusväljakute äravooluvesi ning settekompostimisväljakutel kogunev sademevesi tuleb puhastada reoveepuhastis.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_14 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_15_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Purgimisteenuse osutamiseks peab reoveepuhastil olema välja ehitatud purgimissõlm. Purgimisteenuse osutamiseks peab reoveepuhastil olema välja ehitatud purgimissõlm. 2 (2) Purgimissõlm ehitatakse soovitavalt reoveepuhasti territooriumile ning selles peab toimuma reovee mehhaaniline puhastus tasemel, mis tagab purgitava reovee takistusteta juhtimise reoveepuhastisse ning puhastusprotsessi töörežiimi häireteta töö. Kui reovesi juhitakse väikepuhastisse, peab purgimissõlmel olema ka vooluhulgaühtlusti. Purgimissõlm ehitatakse soovitavalt reoveepuhasti territooriumile ning selles peab toimuma reovee mehhaaniline puhastus tasemel, mis tagab purgitava reovee takistusteta juhtimise reoveepuhastisse ning puhastusprotsessi töörežiimi häireteta töö. Kui reovesi juhitakse väikepuhastisse, peab purgimissõlmel olema ka vooluhulgaühtlusti. 3 (3) Purgimissõlme täpne asukoht määratakse ühisveevärgi ja -kanalisatsiooni arendamise kavaga, arvestades käesolevas määruses sätestatut. Purgimissõlme täpne asukoht määratakse ühisveevärgi ja -kanalisatsiooni arendamise kavaga, arvestades käesolevas määruses sätestatut. 4 (4) Reovett võib reoveepuhastisse purgida sellistes kogustes, mis on ette nähtud reoveepuhasti projektdokumentatsioonis ja vastab summaarselt reoveepuhasti projekteeritud võimsusele. Reovett võib reoveepuhastisse purgida sellistes kogustes, mis on ette nähtud reoveepuhasti projektdokumentatsioonis ja vastab summaarselt reoveepuhasti projekteeritud võimsusele.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_15 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_16_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reoveepuhasti tuleb ümber ehitada, kui reovee koostis või kogus on muutunud ning keskkonnakaitseloa nõudeid ei ole enam võimalik täita. Reoveepuhasti tuleb ümber ehitada, kui reovee koostis või kogus on muutunud ning keskkonnakaitseloa nõudeid ei ole enam võimalik täita.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_16 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_17_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väike- ja suurpuhasti peab olema ümbritsetud piirdega, millel peab olema teave reoveepuhasti valdaja ja reoveepuhasti töö eest vastutava isiku nime ja kontaktandmetega. Väike- ja suurpuhasti peab olema ümbritsetud piirdega, millel peab olema teave reoveepuhasti valdaja ja reoveepuhasti töö eest vastutava isiku nime ja kontaktandmetega.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_17 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_18_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kanalisatsioonisüsteeme tuleb perioodiliselt hooldada nii, et oleks tagatud süsteemide nõuetekohane toimimine ning biotiikide kaldad peavad olema niidetud ja võsast vabad. Kanalisatsioonisüsteeme tuleb perioodiliselt hooldada nii, et oleks tagatud süsteemide nõuetekohane toimimine ning biotiikide kaldad peavad olema niidetud ja võsast vabad.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_18 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_19_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Suurpuhastil projekteeritud reostuskoormusega üle 10 000 ie peab puhastusprotsessi kontrollimiseks ja juhtimiseks olema laboratoorium või peab igapäevane laboratoorne kontroll olema tagatud muul viisil. Suurpuhastil projekteeritud reostuskoormusega üle 10 000 ie peab puhastusprotsessi kontrollimiseks ja juhtimiseks olema laboratoorium või peab igapäevane laboratoorne kontroll olema tagatud muul viisil. 2 (2) Suurpuhastil peab olema vooluhulgamõõtur ja muud puhastusprotsessi jälgimiseks ja juhtimiseks vajalikud mõõteriistad ning automaatse proovivõtu võimalus. Suurpuhastil peab olema vooluhulgamõõtur ja muud puhastusprotsessi jälgimiseks ja juhtimiseks vajalikud mõõteriistad ning automaatse proovivõtu võimalus. 3 (3) Suurpuhastil peab tehnoloogilise põhiseadmestiku avariist teavitamiseks olema avariisignalisatsioon. Suurpuhastil peab tehnoloogilise põhiseadmestiku avariist teavitamiseks olema avariisignalisatsioon.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_19 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_2_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Reoveepuhastis kõrvaldatakse saasteained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega. Reoveepuhastis kõrvaldatakse saasteained ja ebasoovitavad organismid reoveest mehaaniliste, bioloogiliste või füüsikalis-keemiliste võtetega. 2 (2) Reoveepuhastid jagunevad: 1 1) suurteks reoveepuhastiteks ehk suurpuhastiteks, mille projekteeritud reostuskoormus on 2000 inimekvivalenti (edaspidi ie) või suurem; 2 2) väikesteks reoveepuhastiteks ehk väikepuhastiteks, mille projekteeritud reostuskoormus on 50–1999 ie; 3 3) omapuhastiteks ehk kohtpuhastiteks, mille projekteeritud reostuskoormus on kuni 49 ie; 4 4) eelpuhastiteks, milleks on muda-, liiva-, rasva- ja õlipüünised ning nende kombinatsioonid ja muud reovee osalise puhastamise tehnoloogilised seadmed, mille läbimise järel reovesi juhitakse ühiskanalisatsiooni; 5 5) tööstusreoveepuhastiteks, mis puhastavad vaid tööstuses või muu tootmise käigus tekkinud reovett ja kust heitvesi juhitakse otse suublasse. Reoveepuhastid jagunevad: suurteks reoveepuhastiteks ehk suurpuhastiteks, mille projekteeritud reostuskoormus on 2000 inimekvivalenti (edaspidi ie) või suurem; väikesteks reoveepuhastiteks ehk väikepuhastiteks, mille projekteeritud reostuskoormus on 50–1999 ie; omapuhastiteks ehk kohtpuhastiteks, mille projekteeritud reostuskoormus on kuni 49 ie; eelpuhastiteks, milleks on muda-, liiva-, rasva- ja õlipüünised ning nende kombinatsioonid ja muud reovee osalise puhastamise tehnoloogilised seadmed, mille läbimise järel reovesi juhitakse ühiskanalisatsiooni; tööstusreoveepuhastiteks, mis puhastavad vaid tööstuses või muu tootmise käigus tekkinud reovett ja kust heitvesi juhitakse otse suublasse. 3 (3) Projekteeritud reostuskoormus käesoleva määruse tähenduses on koormus, mida mõõdetakse inimekvivalentides ja mis näitab reovee hulka, mida reoveepuhasti suudab ööpäevas maksimaalselt puhastada. Projekteeritud reostuskoormus käesoleva määruse tähenduses on koormus, mida mõõdetakse inimekvivalentides ja mis näitab reovee hulka, mida reoveepuhasti suudab ööpäevas maksimaalselt puhastada.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_2 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_20_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui väike- või suurpuhasti puhastusprotsess lakkab, peab sellest kohe, seejuures ühe ööpäeva jooksul ka kirjalikult, teatama keskkonnakaitseloa andjale ja keskkonnajärelevalve asutusele. Kui väike- või suurpuhasti puhastusprotsess lakkab, peab sellest kohe, seejuures ühe ööpäeva jooksul ka kirjalikult, teatama keskkonnakaitseloa andjale ja keskkonnajärelevalve asutusele.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_20 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_21_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tarnija või ehitaja peab reoveepuhasti kasutusloa saamisel reoveepuhasti valdajale üle andma reoveepuhasti tehnilise dokumentatsiooni, mis peab sisaldama andmeid: 1 1) reoveepuhasti projekteerija või tarnija kohta (kontaktandmed); 2 2) kasutatavate reoveepuhastusviiside ja reoveepuhasti projekteeritud reostuskoormuse kohta; 3 3) reoveepuhasti tähtsamate tehniliste näitajate ja reovee puhastamisel kasutatavate tehnoloogiaseadmete kohta; 4 4) reoveesette käitlusviisi kohta; 5 5) tööohutusnõuete kohta; 6 6) hooldusnõuete kohta. Tarnija või ehitaja peab reoveepuhasti kasutusloa saamisel reoveepuhasti valdajale üle andma reoveepuhasti tehnilise dokumentatsiooni, mis peab sisaldama andmeid: reoveepuhasti projekteerija või tarnija kohta (kontaktandmed); kasutatavate reoveepuhastusviiside ja reoveepuhasti projekteeritud reostuskoormuse kohta; reoveepuhasti tähtsamate tehniliste näitajate ja reovee puhastamisel kasutatavate tehnoloogiaseadmete kohta; reoveesette käitlusviisi kohta; tööohutusnõuete kohta; hooldusnõuete kohta. 2 (2) Olemasoleva reoveepuhasti tehnilise dokumentatsiooni olemasolu peab tagama valdaja. Olemasoleva reoveepuhasti tehnilise dokumentatsiooni olemasolu peab tagama valdaja.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_21 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_22_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väike- ja suurpuhasti valdaja on kohustatud pidama reoveepuhasti hoolduspäevikut, kuhu kantakse: 1 1) reoveepuhasti hooldusnõuete täitmiseks tehtud hooldetööd, sealhulgas reoveepuhasti sõlmede vahetuse või rikete kõrvaldamise tulemused; 2 2) andmed reovee puhastamisel eemaldatud võreprahi, liiva ja sette ning kasutatud kemikaalide kohta; 3 3) andmed keskkonnakaitseloaga määratud reostusnäitajate analüüsitulemuste ja reovee mõõdetud vooluhulga kohta. Väike- ja suurpuhasti valdaja on kohustatud pidama reoveepuhasti hoolduspäevikut, kuhu kantakse: reoveepuhasti hooldusnõuete täitmiseks tehtud hooldetööd, sealhulgas reoveepuhasti sõlmede vahetuse või rikete kõrvaldamise tulemused; andmed reovee puhastamisel eemaldatud võreprahi, liiva ja sette ning kasutatud kemikaalide kohta; andmed keskkonnakaitseloaga määratud reostusnäitajate analüüsitulemuste ja reovee mõõdetud vooluhulga kohta. 2 (2) Reoveepuhasti valdaja peab säilitama hoolduspäevikut vähemalt viis aastat. Reoveepuhasti valdaja peab säilitama hoolduspäevikut vähemalt viis aastat.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_22 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_23_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kanalisatsiooniehitise seisundi kontrolli peab selle valdaja korraldama vähemalt üks kord viie aasta jooksul, mille kohta tuleb koostada akt, mida valdaja säilitab vähemalt kümme aastat. Kanalisatsiooniehitise seisundi kontrolli peab selle valdaja korraldama vähemalt üks kord viie aasta jooksul, mille kohta tuleb koostada akt, mida valdaja säilitab vähemalt kümme aastat.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_23 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_24_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määruse §-des 4–8 sätestatud kuja ulatust kohaldatakse üld- ja detailplaneeringu kehtestamise ajal kehtinud määruse redaktsioonis. Käesoleva määruse §-des 4–8 sätestatud kuja ulatust kohaldatakse üld- ja detailplaneeringu kehtestamise ajal kehtinud määruse redaktsioonis. 2 (2) Kuja ulatust ei kohaldata enne 1. jaanuari 2002. a ehitatud kanalisatsiooniehitistele juhul, kui kuja ulatust ei ole võimalik tagada kuja piires asuvate olemasolevate hoonete, joogivee salv- või puurkaevude või muuks kui joogiveeotstarbeks kasutatavate puurkaevude tõttu eeldusel, et kanalisatsiooniehitisest lähtuv keskkonnaoht ei ulatu kujast kaugemale. Kuja ulatust ei kohaldata enne 1. jaanuari 2002. a ehitatud kanalisatsiooniehitistele juhul, kui kuja ulatust ei ole võimalik tagada kuja piires asuvate olemasolevate hoonete, joogivee salv- või puurkaevude või muuks kui joogiveeotstarbeks kasutatavate puurkaevude tõttu eeldusel, et kanalisatsiooniehitisest lähtuv keskkonnaoht ei ulatu kujast kaugemale.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_24 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_25_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas määruses esitatud kanalisatsiooniehitise planeerimisnõuded, välja arvatud kujad, kehtivad alates 1. jaanuarist 2002. a rajatud kanalisatsiooniehitistele. Käesolevas määruses esitatud kanalisatsiooniehitise planeerimisnõuded, välja arvatud kujad, kehtivad alates 1. jaanuarist 2002. a rajatud kanalisatsiooniehitistele.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_25 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_26_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2019. aasta 1. oktoobril. Määrus jõustub 2019. aasta 1. oktoobril.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_26 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_3_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reoveepuhasti asukohaks tuleb valida ala, mis vastab kõigile järgmistele tingimustele: 1 1) reoveepuhasti paikneb kohas, kus reoveepuhasti avarii korral reovesi ei ohusta põhjavett; 2 2) reoveepuhasti jääb asulast valdavate tuulte suhtes allatuult, välja arvatud kinniste süsteemide ja maa-aluste omapuhastite korral; 3 3) reoveepuhasti paikneb kohas, mida ei ohusta üleujutused; 4 4) tuleb arvestada olemasolevat kanalisatsiooni ja selle seisundit; 5 5) tuleb arvestada maa-ala ehitus- ja hüdrogeoloogilisi tingimusi; 6 6) tuleb arvestada käesoleva määruse §-des 4–8 kujade kohta sätestatud nõudeid. Reoveepuhasti asukohaks tuleb valida ala, mis vastab kõigile järgmistele tingimustele: reoveepuhasti paikneb kohas, kus reoveepuhasti avarii korral reovesi ei ohusta põhjavett; reoveepuhasti jääb asulast valdavate tuulte suhtes allatuult, välja arvatud kinniste süsteemide ja maa-aluste omapuhastite korral; reoveepuhasti paikneb kohas, mida ei ohusta üleujutused; tuleb arvestada olemasolevat kanalisatsiooni ja selle seisundit; tuleb arvestada maa-ala ehitus- ja hüdrogeoloogilisi tingimusi; tuleb arvestada käesoleva määruse §-des 4–8 kujade kohta sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_3 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_4_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väike- ja suurpuhastite nõutavad kujad sõltuvalt reovee puhastamiseks kasutatavast tehnoloogiast ja reoveesette töötlemise viisist ning reoveepuhasti projekteeritud reostuskoormusest on esitatud järgmises tabelis: <table class=\"data\"> <tr> <td rowspan=\"3\"><p align=\"center\"><b>Reovee puhastamise või reoveesette töötlemisprotsessi tehnoloogiline&#160;viis</b></p></td> <td colspan=\"5\"><p align=\"center\"><b>Kuja, meetrites</b></p></td></tr> <tr> <td colspan=\"2\"><p align=\"center\"><b>Väikepuhasti projekteeritud reostuskoormus, ie</b></p></td> <td colspan=\"3\"><p align=\"center\"><b>Suurpuhasti projekteeritud reostuskoormus, ie</b></p></td></tr> <tr> <td width=\"10%\"><p align=\"center\">50–299</p></td> <td width=\"10%\"><p align=\"center\">300–1999</p></td> <td width=\"10%\"><p align=\"center\">2000–9999</p></td> <td width=\"13%\"><p align=\"center\">10&#160;000–99&#160;000</p></td> <td width=\"13%\"><p align=\"center\">100&#160;000 ja enam</p></td></tr> <tr> <td><p>Avatud mahutid ning hoonevälised reovee puhastusseadmed</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td> <td><p align=\"center\">200</p></td> <td><p align=\"center\">300</p></td></tr> <tr> <td><p>Maa-alused või pealt kinnised mahutid ning kinnises hoones paiknevad reovee puhastusseadmed</p></td> <td><p align=\"center\">25</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td> <td><p align=\"center\">200</p></td></tr> <tr> <td><p>Maa-alused või pealt kinnised mahutid ning kinnises hoones paiknevad reovee puhastusseadmed, kus kogu ventilatsiooniõhk puhastatakse atmosfääriõhu kaitse seaduses sätestatud õhukvaliteedi piir- ja sihtväärtustele vastavaks</p></td> <td><p align=\"center\">20</p></td> <td><p align=\"center\">35</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td></tr> <tr> <td><p>Kinnises mahutis või hoones toimuv settekäitlus</p></td> <td><p align=\"center\">25</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td> <td><p align=\"center\">200</p></td></tr> <tr> <td><p>Reoveepuhasti juures või eraldi paiknevad reoveesettebasseinid või reoveesette tahendus- või kompostimisväljakud</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td> <td><p align=\"center\">200</p></td> <td><p align=\"center\">300</p></td></tr> <tr> <td><p>Kinnises mahutis või hoones toimuv settekäitlus, kus kogu ventilatsiooniõhk puhastatakse atmosfääriõhu kaitse seaduses sätestatud õhukvaliteedi piir- ja sihtväärtustele vastavaks ning sette laadimine ja juurde- ja äravedu toimub kinniselt</p></td> <td><p align=\"center\">20</p></td> <td><p align=\"center\">35</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td></tr> <tr> <td><p>Pinnasfiltersüsteemid</p></td> <td><p align=\"center\">25</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">150</p></td> <td><p align=\"center\">200</p></td></tr> <tr> <td><p>Põhipuhastina kasutatavad biotiigid, tehis- ja avaveelised märgalad, taimestikpuhastid</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">100</p></td> <td><p align=\"center\">200</p></td> <td><p align=\"center\">500</p></td> <td><p align=\"center\"></p></td></tr> </table> Väike- ja suurpuhastite nõutavad kujad sõltuvalt reovee puhastamiseks kasutatavast tehnoloogiast ja reoveesette töötlemise viisist ning reoveepuhasti projekteeritud reostuskoormusest on esitatud järgmises tabelis:",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_4 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_5_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Omapuhasti rajamisel peab arvestama, et: 1 1) selle kuja on vähemalt 10 m, välja arvatud septiku või muu pealt kinnise või maa-aluse omapuhasti korral; 2 2) septiku või muu pealt kinnise või maa-aluse omapuhasti kuja on vähemalt 5 m; 3 3) omapuhastit tohib ehitada alla 2000 ie reostuskoormusega reoveekogumisalale, kus puudub ühiskanalisatsioon, ning väljapoole reoveekogumisala; 4 4) see peab paiknema joogiveekaevude suhtes allanõlva ning põhjavee liikumissuuna suhtes allavoolu. Omapuhasti rajamisel peab arvestama, et: selle kuja on vähemalt 10 m, välja arvatud septiku või muu pealt kinnise või maa-aluse omapuhasti korral; septiku või muu pealt kinnise või maa-aluse omapuhasti kuja on vähemalt 5 m; omapuhastit tohib ehitada alla 2000 ie reostuskoormusega reoveekogumisalale, kus puudub ühiskanalisatsioon, ning väljapoole reoveekogumisala; see peab paiknema joogiveekaevude suhtes allanõlva ning põhjavee liikumissuuna suhtes allavoolu. 2 (2) Septik on pealt kinnine väljavooluga reovee mehhaaniline puhasti, millesse sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt. Septik on pealt kinnine väljavooluga reovee mehhaaniline puhasti, millesse sadenenud, läbivoolava reoveega kokku puutuva sette orgaaniline aine laguneb anaeroobselt.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_5 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_6_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omapuhastiks oleva imbsüsteemi ja salvkaevu vaheline kaugus sõltub suublaks olevast pinnasest ja selle omadustest, maapinna langusest ning ei tohi olla väiksem järgmises tabelis esitatud kujast: <table class=\"data\"> <tr> <td rowspan=\"3\"><p align=\"center\"><b>Maapinna&#160;lang,<br/>%</b></p></td> <td colspan=\"3\"><p align=\"center\"><b>Kuja, meetrites</b></p></td></tr> <tr> <td colspan=\"3\"><p align=\"center\"><b>Suublaks olev pinnas ja selle omadused</b></p></td></tr> <tr> <td><p align=\"center\">Keskliivast peenem liiv ja muu peenterine pinnas, mille d<sub>10</sub>¹ &lt; 0,1mm</p></td> <td><p align=\"center\">Peenliivast jämedam liiv ja muu keskterine pinnas, mille d<sub>10</sub>¹ &gt; 0,1mm</p></td> <td><p align=\"center\">Moreen</p></td></tr> <tr> <td><p align=\"center\">&lt; 5</p></td> <td><p align=\"center\">30</p></td> <td><p align=\"center\">50</p></td> <td><p align=\"center\">30</p></td></tr> <tr> <td><p align=\"center\">5–15</p></td> <td><p align=\"center\">20</p></td> <td><p align=\"center\">30</p></td> <td><p align=\"center\">20</p></td></tr> </table> <div>¹ d<sub>10</sub> – tera läbimõõt, millest väiksemaid osakesi on pinnases 10 %.</div> Omapuhastiks oleva imbsüsteemi ja salvkaevu vaheline kaugus sõltub suublaks olevast pinnasest ja selle omadustest, maapinna langusest ning ei tohi olla väiksem järgmises tabelis esitatud kujast:",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_6 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_7_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ühiskanalisatsiooni reoveepumpla kuja ulatus sõltub reoveepumplasse juhitava reovee vooluhulgast järgmiselt: 1 1) kui vooluhulk on kuni 10 m³/d, peab kuja olema 10 meetrit; 2 2) kui vooluhulk on üle 10 m³/d, peab kuja olema 20 meetrit. Ühiskanalisatsiooni reoveepumpla kuja ulatus sõltub reoveepumplasse juhitava reovee vooluhulgast järgmiselt: kui vooluhulk on kuni 10 m³/d, peab kuja olema 10 meetrit; kui vooluhulk on üle 10 m³/d, peab kuja olema 20 meetrit. 2 (2) Kui ei ole võimalik täita käesoleva paragrahvi lõikes 1 kuja kohta esitatud nõudeid, võib kuja piiresse jääda hoone, kui ühiskanalisatsiooni omanik või valdaja on hoone omanikult saanud sellekohase kirjaliku nõusoleku. Kui ei ole võimalik täita käesoleva paragrahvi lõikes 1 kuja kohta esitatud nõudeid, võib kuja piiresse jääda hoone, kui ühiskanalisatsiooni omanik või valdaja on hoone omanikult saanud sellekohase kirjaliku nõusoleku.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_7 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_8_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Purgimissõlme kuja peab olema 30 meetrit. Purgimissõlme kuja peab olema 30 meetrit. 2 (2) Purgimissõlm on reovee tekkekohas kogutud reovee ja fekaalide ühiskanalisatsiooni juhtimise koht. Purgimissõlm on reovee tekkekohas kogutud reovee ja fekaalide ühiskanalisatsiooni juhtimise koht.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_8 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047492_Par_9_v1047492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047492_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Reoveepuhasti valikul tuleb arvestada: 1 1) heitvee kohta kehtestatud nõudeid; 2 2) reovee füüsikalisi ja keemilisi omadusi; 3 3) reovee tekkimise ja selle omaduste muutumise dünaamikat ajas; 4 4) reoveepuhastisse suunatava reovee reostus- ja hüdraulilise koormuse muutumist tulevikus; 5 5) reoveepuhasti maksumust selle toimimise kestel; 6 6) reoveepuhasti rajamise ja kasutamise majanduslikku otstarbekust; 7 7) heitvee pinnasesse immutamise korral põhjavee kaitstust; 8 8) heitvee suublaks oleva veekogu kvantitatiivseid ja kvalitatiivseid näitajaid. Reoveepuhasti valikul tuleb arvestada: heitvee kohta kehtestatud nõudeid; reovee füüsikalisi ja keemilisi omadusi; reovee tekkimise ja selle omaduste muutumise dünaamikat ajas; reoveepuhastisse suunatava reovee reostus- ja hüdraulilise koormuse muutumist tulevikus; reoveepuhasti maksumust selle toimimise kestel; reoveepuhasti rajamise ja kasutamise majanduslikku otstarbekust; heitvee pinnasesse immutamise korral põhjavee kaitstust; heitvee suublaks oleva veekogu kvantitatiivseid ja kvalitatiivseid näitajaid.",
      "rdfs:label": {
        "@value": "Reg_1047492_Par_9 (redaktsioon 1047492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047492",
      "estleg:sourceAct": "Kanalisatsiooniehitise planeerimise, ehitamise ja kasutamise nõuded ning kanalisatsiooniehitise kuja täpsustatud ulatus",
      "estleg:provisionRef": "Reg_1047492 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047492_Map"
      }
    },
