      }
    },
    {
      "@id": "estleg:PatS_Par_35_3_v128122011013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_35_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PatS_Par_35_3 (redaktsioon 128122011013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122011013"
    },
    {
      "@id": "estleg:PatS_Par_35_4_v22276",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_35_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patendikirjelduses sisalduvad leiutiskirjeldus, patendinõudlus, joonis või muu illustreeriv materjal, leiutise olemuse lühikokkuvõte ning järgmised andmed: patendikirjelduse väljaandnud asutuse nimetus; dokumendi nimetus ja dokumendi number; leiutise nimetus; rahvusvahelise patendiklassifikatsiooni indeks; leiutise autori ees- ja perekonnanimi ja aadress; patendiomaniku ees- ja perekonnanimi, tema elukoha või ettevõtte asukoha aadress ja riigi kood, juriidilise isiku korral nimi, asukoha aadress ja riigi kood; patendivoliniku korral ees- ja perekonnanimi ja aadress; ühise esindaja korral ees- ja perekonnanimi, juriidilisest isikust ühise esindaja korral nimi; patenditaotluse number ja esitamise kuupäev; prioriteediandmed; rahvusvahelise patenditaotluse andmed; bioloogilise aine, sealhulgas mikroorganismi tüve deponeerimise andmed; patenditaotluse avaldamise kuupäev; patendikirjelduse avaldamise kuupäev; patendi kehtivuse alguse kuupäev. (2) Pärast registreeringu andmete kandmist registrisse koostab Patendiamet patendikirjelduse. (3) Patendikirjeldust hoitakse registritoimikus. (4) Patendikirjeldus avaldatakse patendi väljaandmise teate avaldamise päeval. (5) Patendikirjelduse vorminõuded ja vormistamise korra kehtestab Vabariigi Valitsus või tema poolt volitatud minister.",
      "rdfs:label": {
        "@value": "PatS_Par_35_4 (redaktsioon 22276)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22276",
      "estleg:supersededByVersion": {
        "@id": "estleg:PatS_Par_35_4_v671215"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PatS_Par_35_4_v671215",
