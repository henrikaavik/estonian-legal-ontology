      },
      "estleg:versionValidTo": {
        "@value": "2023-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PatS_Par_36_3_v130032023007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_36_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euroopa patentide väljaandmise konventsiooni ning Euroopa Parlamendi ja nõukogu määruse (EL) nr 1257/2012 kohaldamise seaduse § 17 punktides 2–7 sätestatud kannete suhtes kohaldatakse patendiregistri vastavaid sätteid. Vastuolu korral Euroopa patendikonventsioonis sätestatuga kohaldatakse Euroopa patendikonventsiooni sätteid. - jõustub samal ajal ühtset patendikohut käsitleva lepingu ning ühtse patendikohtu Põhjamaade ja Balti riikide piirkondliku talituse asutamise kokkuleppe jõustumisega Eesti suhtes [Välisministeeriumi teadaanded RT II, 04.03.2023, 3 ja RT II, 04.03.2023, 4]",
      "rdfs:label": {
        "@value": "PatS_Par_36_3 (redaktsioon 130032023007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130032023007"
    },
    {
      "@id": "estleg:PatS_Par_37_v22276",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patent kehtib 20 aastat patenditaotluse esitamise kuupäevast arvates. (2) Patenditaotluse ja patendi jõushoidmiseks tuleb tasuda riigilõiv iga kehtivusaasta eest. Kehtivusaasta alguseks loetakse patenditaotluse esitamise kuupäev.",
      "rdfs:label": {
        "@value": "PatS_Par_37 (redaktsioon 22276)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22276",
      "estleg:supersededByVersion": {
