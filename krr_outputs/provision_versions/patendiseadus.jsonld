      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastutava töötleja õigusvastase tegevuse tagajärjel tekkinud kahju hüvitab riik.",
      "rdfs:label": {
        "@value": "PatS_Par_35_3 (redaktsioon 22276)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22276",
