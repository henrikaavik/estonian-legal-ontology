    {
      "@id": "estleg:PatS_Par_45_v13122214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_45"
      },
      "estleg:versionValidFrom": {
