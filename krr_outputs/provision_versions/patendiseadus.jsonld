    {
      "@id": "estleg:PatS_Par_27_v130032023008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_27"
      },
      "estleg:versionValidFrom": {
