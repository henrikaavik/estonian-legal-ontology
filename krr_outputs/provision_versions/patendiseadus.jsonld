      }
    },
    {
      "@id": "estleg:PatS_Par_37_v730956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patent kehtib 20 aastat patenditaotluse esitamise kuupäevast arvates. (2) Patenditaotluse ja patendi jõushoidmiseks tuleb tasuda riigilõiv iga kehtivusaasta eest. Kehtivusaasta alguskuupäevaks loetakse patenditaotluse esitamise kuupäev.",
      "rdfs:label": {
        "@value": "PatS_Par_37 (redaktsioon 730956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "730956"
    },
    {
      "@id": "estleg:PatS_Par_38_v22276",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Patent kaotab kehtivuse ennetähtaegselt, kui: kehtivusaasta riigilõiv on jäetud tasumata; patendiomanik esitab patendi kehtivuse lõpetamise nõude; patendiomanikuks olev juriidiline isik likvideeritakse või selle tegevus lõpetatakse ja patendiõigused ei ole üle läinud. (2) Patendiamet teeb patendi kehtivuse ennetähtaegse lõppemise kohta kande registrisse ja teatab sellest oma ametlikus väljaandes.",
      "rdfs:label": {
        "@value": "PatS_Par_38 (redaktsioon 22276)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22276"
    },
    {
