      }
    },
    {
      "@id": "estleg:PatS_Par_39_6_v13122214",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PatS_Par_39_6"
