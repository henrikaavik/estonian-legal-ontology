        "@type": "xsd:date"
      },
      "estleg:versionText": "Täiendava kaitse jõustamiseks ja kehtivuse pikendamiseks tuleb tasuda riigilõiv vastavalt käesoleva seaduse § 42 6.-8. lõikele.",
      "rdfs:label": {
        "@value": "PatS_Par_39_6 (redaktsioon 730956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "730956",
