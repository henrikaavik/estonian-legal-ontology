      "estleg:provisionRef": "Reg_1050892 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050892_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050892_Par_20_v1050892",
      "@type": [
