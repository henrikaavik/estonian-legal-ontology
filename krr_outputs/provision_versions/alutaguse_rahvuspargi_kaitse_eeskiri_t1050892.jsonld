      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 15. juuni 2020. a käskkirjaga nr 1-2/20/265 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 15. juuni 2020. a käskkirjaga nr 1-2/20/265 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1050892_Par_22 (redaktsioon 1050892)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050892",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050892",
      "estleg:sourceAct": "Alutaguse rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1050892 § 22",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050892_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050892_Par_23_v1050892",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050892_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1050892_Par_23 (redaktsioon 1050892)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050892",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050892",
      "estleg:sourceAct": "Alutaguse rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1050892 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1050892_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1050892_Par_3_v1050892",
