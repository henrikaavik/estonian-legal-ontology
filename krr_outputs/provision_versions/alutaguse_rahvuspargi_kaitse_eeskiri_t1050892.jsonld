        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1050892_Par_3 (redaktsioon 1050892)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1050892",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1050892",
