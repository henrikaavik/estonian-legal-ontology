    {
      "@id": "estleg:Reg_1049492_Par_10_v1049492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049492_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Setomaa Vallavalitsus kuulutab taotlusvooru avatuks sellekohase info avaldamisega Setomaa Vallavalitsuse veebilehel ja võimaluse korral valla lehes vähemalt üks kuu enne taotlusvooru tähtpäeva. Setomaa Vallavalitsus kuulutab taotlusvooru avatuks sellekohase info avaldamisega Setomaa Vallavalitsuse veebilehel ja võimaluse korral valla lehes vähemalt üks kuu enne taotlusvooru tähtpäeva. 2 (2) Taotlusvooru avamise teade peab sisaldama taotluste esitamise tähtpäeva, maksimaalset toetuse summat ja vajadusel toetuse saamise eelistatud piirkondi Setomaa vallas. Taotlusvooru avamise teade peab sisaldama taotluste esitamise tähtpäeva, maksimaalset toetuse summat ja vajadusel toetuse saamise eelistatud piirkondi Setomaa vallas.",
      "rdfs:label": {
        "@value": "Reg_1049492_Par_10 (redaktsioon 1049492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049492",
      "estleg:sourceAct": "Noored Setomaale programm",
      "estleg:provisionRef": "Reg_1049492 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049492_Map"
      }
    },
    {
      "@id": "estleg:Reg_1049492_Par_11_v1049492",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049492_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlus tuleb esitada Setomaa Vallavalitsusele allkirjastatuna paberil või digitaalselt ja sellele tuleb lisada järgmised dokumendid: 1 1) projekti eelarve; 2 2) omafinantseeringut tõendav dokument; 3 3) motivatsioonikiri, sealhulgas taotleja plaanid seoses Setomaaga järgneva viie aasta jooksul; 4 4) eelarves toodud tegevuste kohta vähemalt kaks võrreldavat hinnapakkumist ning juhul kui võrreldavate hinnapakkumiste esitamine ei ole võimalik, tuleb esitada sellekohased põhjendused ja hinnakalkulatsioon; 5 5) ehitusluba või ehitusteatis vastavalt ehitusseadustiku lisale 1; 6 6) ehitusprojekt, mis vastab majandus- ja taristuministri 17. juuli 2015. a määruses nr 97 „Nõuded ehitusprojektile” sätestatud nõuetele. Kui tööde tegemiseks on vajalik ehitusluba, siis peab ehitusprojekti koostama majandustegevuse registris registreeritud ettevõtja. Taotlus tuleb esitada Setomaa Vallavalitsusele allkirjastatuna paberil või digitaalselt ja sellele tuleb lisada järgmised dokumendid: projekti eelarve; omafinantseeringut tõendav dokument; motivatsioonikiri, sealhulgas taotleja plaanid seoses Setomaaga järgneva viie aasta jooksul; eelarves toodud tegevuste kohta vähemalt kaks võrreldavat hinnapakkumist ning juhul kui võrreldavate hinnapakkumiste esitamine ei ole võimalik, tuleb esitada sellekohased põhjendused ja hinnakalkulatsioon; ehitusluba või ehitusteatis vastavalt ehitusseadustiku lisale 1; ehitusprojekt, mis vastab majandus- ja taristuministri 17. juuli 2015. a määruses nr 97 „Nõuded ehitusprojektile” sätestatud nõuetele. Kui tööde tegemiseks on vajalik ehitusluba, siis peab ehitusprojekti koostama majandustegevuse registris registreeritud ettevõtja. 2 (2) Taotlused tuleb esitada taotlusvooru väljakuulutamise teates määratud tähtpäevaks. Tähtpäevast hiljem esitatud taotlused jäetakse läbi vaatamata. Taotlused tuleb esitada taotlusvooru väljakuulutamise teates määratud tähtpäevaks. Tähtpäevast hiljem esitatud taotlused jäetakse läbi vaatamata.",
      "rdfs:label": {
        "@value": "Reg_1049492_Par_11 (redaktsioon 1049492)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049492",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049492",
      "estleg:sourceAct": "Noored Setomaale programm",
      "estleg:provisionRef": "Reg_1049492 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049492_Map"
      }
