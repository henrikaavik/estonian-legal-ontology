      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2019/2020. õppeaastat rakenduskõrgharidusõppesse immatrikuleeritud üliõpilasele rakenduskõrghariduse diplomi andmisel kohaldatakse kuni 1. septembrini 2019. a kehtinud kõrgharidusstandardis kehtestatud diplomi nimetusi. Enne 2019/2020. õppeaastat rakenduskõrgharidusõppesse immatrikuleeritud üliõpilasele rakenduskõrghariduse diplomi andmisel kohaldatakse kuni 1. septembrini 2019. a kehtinud kõrgharidusstandardis kehtestatud diplomi nimetusi.",
      "rdfs:label": {
