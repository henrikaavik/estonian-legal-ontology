    {
      "@id": "estleg:Reg_1047456_Par_6_v1047456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047456_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kõrgharidustaseme õpe lõpeb lõputöö kaitsmise või lõpueksami sooritamisega. Kõrgharidustaseme õpe lõpeb lõputöö kaitsmise või lõpueksami sooritamisega. 2 (2) Lõputöö või lõpueksami maht on: 1 1) rakenduskõrgharidusõppes ja bakalaureuseõppes vähemalt viis ainepunkti; 2 2) magistriõppes vähemalt 15 ainepunkti. Lõputöö või lõpueksami maht on: rakenduskõrgharidusõppes ja bakalaureuseõppes vähemalt viis ainepunkti; magistriõppes vähemalt 15 ainepunkti. 3 (3) Doktoriõpe lõpeb doktoritöö kaitsmisega. Doktoritöö on iseseisev teaduslik uurimus või loometöö. Doktoriõpe lõpeb doktoritöö kaitsmisega. Doktoritöö on iseseisev teaduslik uurimus või loometöö.",
      "rdfs:label": {
        "@value": "Reg_1047456_Par_6 (redaktsioon 1047456)",
        "@language": "et"
      },
