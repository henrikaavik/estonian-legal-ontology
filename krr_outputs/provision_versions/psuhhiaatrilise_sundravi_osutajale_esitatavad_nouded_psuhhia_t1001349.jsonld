      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Psühhiaatrilise sundravi osutajale esitatavad nõuded, psühhiaatrilise sundravi nõuded ja tervishoiuteenuse osutaja töökorraldus kohtu poolt määratud psühhiaatrilise sundravi kohaldamisel (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Psühhiaatrilise sundravi osutajale esitatavad nõuded, psühhiaatrilise sundravi nõuded ja tervishoiuteenuse osutaja töökorraldus kohtu poolt määratud psühhiaatrilise sundravi kohaldamisel"
    },
    {
      "@id": "estleg:Reg_1001349_Par_1_v1001349",
      "@type": [
