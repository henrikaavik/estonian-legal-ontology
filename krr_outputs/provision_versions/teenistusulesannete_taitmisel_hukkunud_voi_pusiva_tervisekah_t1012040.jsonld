  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_teenistusulesannete_taitmisel_hukkunud_voi_pusiva_tervisekah_t1012040_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teenistusülesannete täitmisel hukkunud või püsiva tervisekahjustuse saanud kaitseväelase perekonnaliikmetele sotsiaalnõustamise ja psühholoogilise abi tagamise tingimused, ulatus ja kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teenistusülesannete täitmisel hukkunud või püsiva tervisekahjustuse saanud kaitseväelase perekonnaliikmetele sotsiaalnõustamise ja psühholoogilise abi tagamise tingimused, ulatus ja kord"
    },
    {
      "@id": "estleg:Reg_1012040_Par_1_v1012040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012040_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sotsiaalnõustamist ja psühholoogilist abi on õigus saada teenistusülesannete täitmisel hukkunud või püsiva tervisekahjustuse saanud kaitseväelase lapsel, vanemal ja vanavanemal ning muul sotsiaalhoolekande seaduse § 22 lõikes 2 nimetatud perekonnaliikmel (edaspidi isik), kui tema toimetulekuvõime on vähenenud ja toimetulekuvõime vähenemine on seotud kaitseväelase hukkumise või püsiva tervisekahjustuse saamisega. RT I 2023-03-29 24 129032023024 2023-04-01 Sotsiaalnõustamist ja psühholoogilist abi on õigus saada teenistusülesannete täitmisel hukkunud või püsiva tervisekahjustuse saanud kaitseväelase lapsel, vanemal ja vanavanemal ning muul sotsiaalhoolekande seaduse § 22 lõikes 2 nimetatud perekonnaliikmel (edaspidi isik), kui tema toimetulekuvõime on vähenenud ja toimetulekuvõime vähenemine on seotud kaitseväelase hukkumise või püsiva tervisekahjustuse saamisega. 2 (2) Kehtetu - RT I 2023-03-29 24 129032023024 2023-04-01 Kehtetu - 3 (3) Isikule tagatakse tema soovil ning tuvastatud vajaduse korral sotsiaalnõustamine ja psühholoogiline abi Kaitseväe kaudu ja eelarvest lähtudes käesoleva määruse §-s 2 sätestatud piirmääradest. Isikule tagatakse tema soovil ning tuvastatud vajaduse korral sotsiaalnõustamine ja psühholoogiline abi Kaitseväe kaudu ja eelarvest lähtudes käesoleva määruse §-s 2 sätestatud piirmääradest. 4 (4) Juhul kui Kaitseväes puudub võimalus vajaliku sotsiaalnõustamise või psühholoogilise abi tagamiseks, korraldab Kaitseväes sotsiaalnõustamist ja psühholoogilist abi korraldav struktuuriüksus (edaspidi toetusteenuste keskus) isikule sotsiaalnõustamise või psühholoogilise abi osutamise väljaspool Kaitseväge. Osutatud teenuse maksumus kaetakse Kaitseväe eelarvest teenuse osutaja esitatud kuludokumentide alusel käesoleva määruse §-s 2 sätestatud piirmäära ulatuses. RT I 2023-03-29 24 129032023024 2023-04-01 Juhul kui Kaitseväes puudub võimalus vajaliku sotsiaalnõustamise või psühholoogilise abi tagamiseks, korraldab Kaitseväes sotsiaalnõustamist ja psühholoogilist abi korraldav struktuuriüksus (edaspidi toetusteenuste keskus) isikule sotsiaalnõustamise või psühholoogilise abi osutamise väljaspool Kaitseväge. Osutatud teenuse maksumus kaetakse Kaitseväe eelarvest teenuse osutaja esitatud kuludokumentide alusel käesoleva määruse §-s 2 sätestatud piirmäära ulatuses. 5 (5) Käesoleva paragrahvi lõikes 1 nimetatud isik võib taotleda psühholoogilist abi psühholoogilise nõustamise, psühhoteraapia või tugigrupi teenuse kasutamiseks. Käesoleva paragrahvi lõikes 1 nimetatud isik võib taotleda psühholoogilist abi psühholoogilise nõustamise, psühhoteraapia või tugigrupi teenuse kasutamiseks. 6 (6) Psühholoogilise abi kulu hüvitatakse, kui nimetatud abi osutajal on kutseseaduse alusel antud psühholoogia kutseala kutse, riiklikult tunnustatud kõrgharidus psühholoogias või sellele vastav kvalifikatsioon. RT I 2017-02-03 1 103022017001 2017-02-06 Psühholoogilise abi kulu hüvitatakse, kui nimetatud abi osutajal on kutseseaduse alusel antud psühholoogia kutseala kutse, riiklikult tunnustatud kõrgharidus psühholoogias või sellele vastav kvalifikatsioon. 7 (7) Kehtetu - RT I 2023-03-29 24 129032023024 2023-04-01 Kehtetu - 8 (8) Toetusteenuste keskus koostab isikule psühholoogilise abi ja sotsiaalteenuse osutamise plaani ning teeb isikule ettepaneku teenuse osutaja osas. RT I 2023-03-29 24 129032023024 2023-04-01 Toetusteenuste keskus koostab isikule psühholoogilise abi ja sotsiaalteenuse osutamise plaani ning teeb isikule ettepaneku teenuse osutaja osas.",
      "rdfs:label": {
        "@value": "Reg_1012040_Par_1 (redaktsioon 1012040)",
        "@language": "et"
      },
