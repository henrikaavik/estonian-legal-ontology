      "estleg:provisionRef": "Reg_1012040 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012040_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012040_Par_2_v1012040",
      "@type": [
        "owl:NamedIndividual",
