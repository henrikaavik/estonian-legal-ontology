      "estleg:versionValidFrom": {
        "@value": "2023-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Euroopa Merendus- ja Kalandusfondi rakenduskava 2014–2020ˮ (edaspidi rakenduskava) meetme „Teadlaste ja kalurite partnerlusˮ raames toetuse (edaspidi toetus) andmise ja kasutamise tingimused ja kord ning toetuse kasutamise kava koostamise tingimused ja kord. Määrusega kehtestatakse „Euroopa Merendus- ja Kalandusfondi rakenduskava 2014–2020ˮ (edaspidi rakenduskava) meetme „Teadlaste ja kalurite partnerlusˮ raames toetuse (edaspidi toetus) andmise ja kasutamise tingimused ja kord ning toetuse kasutamise kava koostamise tingimused ja kord.",
      "rdfs:label": {
        "@value": "Reg_1031106_Par_1 (redaktsioon 1031106)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031106",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031106",
      "estleg:sourceAct": "Teadlaste ja kalurite koostöötoetus",
      "estleg:provisionRef": "Reg_1031106 § 1",
