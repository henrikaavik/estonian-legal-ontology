    {
      "@id": "estleg:Reg_1015584_Par_18_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "I klassi valvuri ametis võib olla isik: 1 1) kes on suuteline tulema rutiinses töös toime valvsust, täpsust ja korrektsust nõudvate ametikohustustega; 2 2) kes on kohusetundlik, otsustus- ja vastutusvõimeline ning usaldusväärne ja korrektne; 3 3) kes on võimeline kohanema muutustega, täpselt aru saama talle antud korraldustest ning juhendmaterjali alusel täitma teenistuskohustusi iseseisvalt; 4 4) kes on võimeline pingeolukorras tulemuslikult töötama. I klassi valvuri ametis võib olla isik: kes on suuteline tulema rutiinses töös toime valvsust, täpsust ja korrektsust nõudvate ametikohustustega; kes on kohusetundlik, otsustus- ja vastutusvõimeline ning usaldusväärne ja korrektne; kes on võimeline kohanema muutustega, täpselt aru saama talle antud korraldustest ning juhendmaterjali alusel täitma teenistuskohustusi iseseisvalt; kes on võimeline pingeolukorras tulemuslikult töötama.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_18 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_18_18_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_18_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vanglavälise saatmise tööülesandega ja avaliku korra tagamise ülesannete korras ametiabi andma määratud I klassi valvuri ametiastmele vastava ametikoha vanglaametniku nõuded on: 1 1) valmisolek täita vanglavälist saateülesannet ja avaliku korra tagamise raames ametiabi andmise ülesannet; 2 2) nõusolek valveaja rakendamiseks; RT I 2024-12-17 1 117122024001 2025-01-01 3 3) vastava eriväljaõppe edukas läbimine; 4 4) tulirelva, gaasirelva ja teleskoopnuia kandmise õigus ja nende kasutamise oskus Justiits- ja Digiministeeriumi vanglate osakonna määratud tasemel. RT I 2024-06-22 14 122062024014 2024-07-01 Vanglavälise saatmise tööülesandega ja avaliku korra tagamise ülesannete korras ametiabi andma määratud I klassi valvuri ametiastmele vastava ametikoha vanglaametniku nõuded on: valmisolek täita vanglavälist saateülesannet ja avaliku korra tagamise raames ametiabi andmise ülesannet; nõusolek valveaja rakendamiseks; vastava eriväljaõppe edukas läbimine; tulirelva, gaasirelva ja teleskoopnuia kandmise õigus ja nende kasutamise oskus Justiits- ja Digiministeeriumi vanglate osakonna määratud tasemel.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_18_18 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 18_18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_19_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "II klassi valvur peab olema läbinud teenistusse asumisel vähemalt keskharidusõppe ja ühe aasta jooksul teenistusse asumisest läbima vanglaametniku kutseharidusõppe, välja arvatud juhul, kui ta vastab vangistusseaduse § 113 lõikes 4 nimetatud tingimustele. RT I 2024-12-17 1 117122024001 2025-01-01 II klassi valvur peab olema läbinud teenistusse asumisel vähemalt keskharidusõppe ja ühe aasta jooksul teenistusse asumisest läbima vanglaametniku kutseharidusõppe, välja arvatud juhul, kui ta vastab vangistusseaduse § 113 lõikes 4 nimetatud tingimustele.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_19 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_2_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangla peainspektoriks võib saada isik, kes on olnud teenistuses I klassi vanglainspektori ametiastmele või kõrgemale ametiastmele vastaval ametikohal, vangistusseaduse § 1051 lõike 2 punktis 1 nimetatud ametikohal või kellel on organisatsiooni või struktuuriüksuse juhtimise kogemus. Vangla peainspektoriks võib saada isik, kes on olnud teenistuses I klassi vanglainspektori ametiastmele või kõrgemale ametiastmele vastaval ametikohal, vangistusseaduse § 1051 lõike 2 punktis 1 nimetatud ametikohal või kellel on organisatsiooni või struktuuriüksuse juhtimise kogemus.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_2 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_20_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "II klassi valvur peab vastama järgmistele nõuetele: 1 1) tunneb vangistusseadust ja muid vangistuse täideviimist reguleerivaid õigusakte; 2 2) tal on teadmisi kinnipeetava resotsialiseerimise põhimõtetest; 3 3) oskab tegutseda erakorraliste sündmuste ajal; 4 4) tal on teadmisi vangla turvasüsteemide tööst ja kasutamisest; 5 5) oskab kasutada enesekaitsevahendeid, gaasirelva, külmrelva, ohjeldusmeetmeid, füüsilist jõudu ja ametijuhendis ette nähtud erivahendeid ning tunneb põhjalikult nende kasutamise korda reguleerivaid õigusakte; 6 6) järgib ametniku kutse-eetikat ning tunneb vormiriietuse kandmise nõudeid ja täidab neid; 7 7) tal on hea suhtlemis-, konfliktide lahendamise ja enesekehtestamisoskus ning ta on valmis koostööks kaastöötajate ja teiste asjaomaste isikutega; 8 8) oskab kasutada arvutit ning ametikohal vajalikke arvutiprogramme; 9 9) oskab kasutada ametikohal vajalikke andmekogusid; 10 10) tema eesti keele oskus on vähemalt tasemel C1- või sellele vastaval tasemel ja ta oskab ühte võõrkeelt A1- või sellele vastaval tasemel; 11 11) tal on üldisi teadmisi riigi põhikorrast, sealhulgas põhiseadusest ja põhiseaduslikest seadustest, inimõigustest ning avalikku teenistust reguleerivatest õigusaktidest; 12 12) teab esmaabi- ja elustamisvõtteid ning oskab anda esmaabi ja hinnata olukorda. II klassi valvur peab vastama järgmistele nõuetele: tunneb vangistusseadust ja muid vangistuse täideviimist reguleerivaid õigusakte; tal on teadmisi kinnipeetava resotsialiseerimise põhimõtetest; oskab tegutseda erakorraliste sündmuste ajal; tal on teadmisi vangla turvasüsteemide tööst ja kasutamisest; oskab kasutada enesekaitsevahendeid, gaasirelva, külmrelva, ohjeldusmeetmeid, füüsilist jõudu ja ametijuhendis ette nähtud erivahendeid ning tunneb põhjalikult nende kasutamise korda reguleerivaid õigusakte; järgib ametniku kutse-eetikat ning tunneb vormiriietuse kandmise nõudeid ja täidab neid; tal on hea suhtlemis-, konfliktide lahendamise ja enesekehtestamisoskus ning ta on valmis koostööks kaastöötajate ja teiste asjaomaste isikutega; oskab kasutada arvutit ning ametikohal vajalikke arvutiprogramme; oskab kasutada ametikohal vajalikke andmekogusid; tema eesti keele oskus on vähemalt tasemel C1- või sellele vastaval tasemel ja ta oskab ühte võõrkeelt A1- või sellele vastaval tasemel; tal on üldisi teadmisi riigi põhikorrast, sealhulgas põhiseadusest ja põhiseaduslikest seadustest, inimõigustest ning avalikku teenistust reguleerivatest õigusaktidest; teab esmaabi- ja elustamisvõtteid ning oskab anda esmaabi ja hinnata olukorda.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_20 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_21_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) II klassi valvur peab kehalised katsed sooritama vähemalt § 9 lõikes 2 nimetatud tulemustega. II klassi valvur peab kehalised katsed sooritama vähemalt § 9 lõikes 2 nimetatud tulemustega. 2 (2) Üksuse, kelle põhiülesanne on korraldada pidevat tugevdatud järelevalvet vajavate kinnipeetavate järelevalvet ja vangistuse täideviimist, II klassi valvur peab kehalised katsed sooritama vähemalt § 9 lõikes 3 nimetatud tulemustega. Üksuse, kelle põhiülesanne on korraldada pidevat tugevdatud järelevalvet vajavate kinnipeetavate järelevalvet ja vangistuse täideviimist, II klassi valvur peab kehalised katsed sooritama vähemalt § 9 lõikes 3 nimetatud tulemustega. 3 (3) Kehtetu - RT I 2024-06-22 14 122062024014 2024-07-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_21 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 21",
