      "estleg:provisionRef": "Reg_1015584 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_24_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hinnatava hindamisel lähtutakse: 1 1) ametikohale kehtestatud nõuetest; 2 2) hinnatava ametijuhendist; 3 3) muudest õigusaktidest. Hinnatava hindamisel lähtutakse: ametikohale kehtestatud nõuetest; hinnatava ametijuhendist; muudest õigusaktidest.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_24 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 24",
