  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vanglateenistuse_ametnikule_esitatavad_nouded_nouetele_vasta_t1015584_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik (44 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik"
    },
    {
      "@id": "estleg:Reg_1015584_Par_1_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vangla peainspektor peab olema läbinud: 1 1) kõrgharidusõppe või ametiastmele vastava ettevalmistusteenistuse, välja arvatud juhul, kui ta vastab vangistusseaduse § 113 lõikes 4 nimetatud tingimustele; 2 2) ametialase täiendusõppe. Vangla peainspektor peab olema läbinud: kõrgharidusõppe või ametiastmele vastava ettevalmistusteenistuse, välja arvatud juhul, kui ta vastab vangistusseaduse § 113 lõikes 4 nimetatud tingimustele; ametialase täiendusõppe.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_1 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_10_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "I klassi vanglainspektori ametis võib olla isik: 1 1) kellel on algatusvõimet ja loovust, et algatada ja ellu viia muudatusi ning kiiresti ja paindlikult kohaneda muudatuste ja ootamatute olukordadega; 2 2) kes on võimeline püsivalt ja tulemuslikult töötama pingeolukorras ning oskab planeerida oma aega; 3 3) kes on kohusetundlik ning otsustus- ja vastutusvõimeline ning oskab ette näha oma pädevuse piires tehtud otsuste tagajärgi ja nende eest vastutada; 4 4) kes on usaldusväärne; 5 5) kes oskab eristada olulist ebaolulisest ning kellel on analüüsi- ja sünteesivõime ning suulise ja kirjaliku informatsiooni loogilise ja süsteemse edastamise oskus; 6 6) kes täidab teenistuskohustusi täpselt ning kellel on hea enesekontrollioskus. I klassi vanglainspektori ametis võib olla isik: kellel on algatusvõimet ja loovust, et algatada ja ellu viia muudatusi ning kiiresti ja paindlikult kohaneda muudatuste ja ootamatute olukordadega; kes on võimeline püsivalt ja tulemuslikult töötama pingeolukorras ning oskab planeerida oma aega; kes on kohusetundlik ning otsustus- ja vastutusvõimeline ning oskab ette näha oma pädevuse piires tehtud otsuste tagajärgi ja nende eest vastutada; kes on usaldusväärne; kes oskab eristada olulist ebaolulisest ning kellel on analüüsi- ja sünteesivõime ning suulise ja kirjaliku informatsiooni loogilise ja süsteemse edastamise oskus; kes täidab teenistuskohustusi täpselt ning kellel on hea enesekontrollioskus.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_10 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_11_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "II klassi vanglainspektor peab olema läbinud: 1 1) kõrgharidusõppe või ametiastmele vastava ettevalmistusteenistuse, välja arvatud juhul, kui ta vastab vangistusseaduse § 113 lõikes 4 nimetatud tingimustele; 2 2) ametialase täiendusõppe. II klassi vanglainspektor peab olema läbinud: kõrgharidusõppe või ametiastmele vastava ettevalmistusteenistuse, välja arvatud juhul, kui ta vastab vangistusseaduse § 113 lõikes 4 nimetatud tingimustele; ametialase täiendusõppe.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_11 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015584",
      "estleg:sourceAct": "Vanglateenistuse ametnikule esitatavad nõuded, nõuetele vastavuse hindamine ning vangla direktori värbamine ja valik",
      "estleg:provisionRef": "Reg_1015584 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015584_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1015584_Par_12_v1015584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015584_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) II klassi vanglainspektor peab vastama järgmistele nõuetele: 1 1) tunneb põhjalikult vangistust ja vanglateenistust reguleerivaid õigusakte; 2 2) oskab kaasa aidata vangistuse eesmärkide saavutamisele, ennetada ja tõkestada kinnipeetavate allumatust, põgenemist ja muid erakorralisi sündmusi ning likvideerida nende tagajärgi; 3 3) tal on teadmisi kinnipeetavate õigustest ja kohustustest ning oskab tagada nende järgimise; 4 4) tal on teadmisi vangla järelevalve korraldamise ja kontrollimise põhimõtetest; 5 5) tal on teadmisi vangla turvasüsteemide tööst ja kasutamisest; 6 6) oskab kasutada enesekaitsevahendeid, gaasirelva, külmrelva, ohjeldusmeetmeid, füüsilist jõudu ja ametijuhendis ette nähtud erivahendeid ning tunneb põhjalikult nende kasutamise korda reguleerivaid õigusakte; 7 7) järgib ametniku kutse-eetikat ning tunneb vormiriietuse kandmise nõudeid ja täidab neid; 8 8) tal on hea suhtlemis- ja enesekehtestamisoskus, oskab lahendada konflikte ning on valmis koostööks kaastöötajate ja teiste asjaomaste isikutega; 9 9) tunneb riigi põhikorda, sealhulgas põhiseadust ja põhiseaduslikke seadusi ning inimõigusi, avaliku halduse korraldust ja avalikku teenistust reguleerivaid õigusakte; 10 10) tunneb asjaajamiskorra aluseid; 11 11) tal on põhjalikke teadmisi vanglaid puudutavast Euroopa Liidu õigusest; 12 12) tal on teadmisi infotehnoloogia rakendamise üldpõhimõtetest ja võimalustest, oskab kasutada arvutit ja ametikohal vajalikke arvutiprogramme; 13 13) oskab kasutada ametikohal vajalikke andmekogusid; 14 14) tema eesti keele oskus on vähemalt C1- või sellele vastaval tasemel ja ta oskab ühte võõrkeelt B1- või sellele vastaval tasemel koos ametialase sõnavara valdamisega. II klassi vanglainspektor peab vastama järgmistele nõuetele: tunneb põhjalikult vangistust ja vanglateenistust reguleerivaid õigusakte; oskab kaasa aidata vangistuse eesmärkide saavutamisele, ennetada ja tõkestada kinnipeetavate allumatust, põgenemist ja muid erakorralisi sündmusi ning likvideerida nende tagajärgi; tal on teadmisi kinnipeetavate õigustest ja kohustustest ning oskab tagada nende järgimise; tal on teadmisi vangla järelevalve korraldamise ja kontrollimise põhimõtetest; tal on teadmisi vangla turvasüsteemide tööst ja kasutamisest; oskab kasutada enesekaitsevahendeid, gaasirelva, külmrelva, ohjeldusmeetmeid, füüsilist jõudu ja ametijuhendis ette nähtud erivahendeid ning tunneb põhjalikult nende kasutamise korda reguleerivaid õigusakte; järgib ametniku kutse-eetikat ning tunneb vormiriietuse kandmise nõudeid ja täidab neid; tal on hea suhtlemis- ja enesekehtestamisoskus, oskab lahendada konflikte ning on valmis koostööks kaastöötajate ja teiste asjaomaste isikutega; tunneb riigi põhikorda, sealhulgas põhiseadust ja põhiseaduslikke seadusi ning inimõigusi, avaliku halduse korraldust ja avalikku teenistust reguleerivaid õigusakte; tunneb asjaajamiskorra aluseid; tal on põhjalikke teadmisi vanglaid puudutavast Euroopa Liidu õigusest; tal on teadmisi infotehnoloogia rakendamise üldpõhimõtetest ja võimalustest, oskab kasutada arvutit ja ametikohal vajalikke arvutiprogramme; oskab kasutada ametikohal vajalikke andmekogusid; tema eesti keele oskus on vähemalt C1- või sellele vastaval tasemel ja ta oskab ühte võõrkeelt B1- või sellele vastaval tasemel koos ametialase sõnavara valdamisega. 2 (2) Inspektor – korrapidaja abi peab teadma ka esmaabi- ja elustamisvõtteid ning oskama anda esmaabi ja hinnata olukorda. Inspektor – korrapidaja abi peab teadma ka esmaabi- ja elustamisvõtteid ning oskama anda esmaabi ja hinnata olukorda.",
      "rdfs:label": {
        "@value": "Reg_1015584_Par_12 (redaktsioon 1015584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015584",
