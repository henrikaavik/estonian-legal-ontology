      "estleg:provisionRef": "Reg_1043145 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043145_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043145_Par_6_v1043145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
