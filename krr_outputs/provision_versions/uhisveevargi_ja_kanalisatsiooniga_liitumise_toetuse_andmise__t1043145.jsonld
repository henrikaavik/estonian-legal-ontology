      "estleg:provisionRef": "Reg_1043145 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043145_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043145_Par_20_v1043145",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043145_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse saaja esitab projekti lõpparuande ja maksetaotluse hiljemalt 20 kalendripäeva jooksul pärast projekti abikõlblikkuse perioodi lõppu e-posti teel, e-toetuse keskkonnas digitaalselt allkirjastatuna või allkirjastatuna paberkandjal. Toetuse saaja esitab projekti lõpparuande ja maksetaotluse hiljemalt 20 kalendripäeva jooksul pärast projekti abikõlblikkuse perioodi lõppu e-posti teel, e-toetuse keskkonnas digitaalselt allkirjastatuna või allkirjastatuna paberkandjal. 2 (2) Projekti lõpparuanne peab sisaldama teavet projekti eesmärgi ning väljundnäitajate saavutamise kohta ning teostatud tegevuste kirjeldust. Projekti lõpparuanne peab sisaldama teavet projekti eesmärgi ning väljundnäitajate saavutamise kohta ning teostatud tegevuste kirjeldust. 3 (3) Rakendusüksusel on õigus kontrollida toetuse kasutamise sihipärasust toetuse lõppsaaja juures projekti abikõlblikkuse perioodil ja sellele järgneva viie aasta jooksul. Rakendusüksusel on õigus kontrollida toetuse kasutamise sihipärasust toetuse lõppsaaja juures projekti abikõlblikkuse perioodil ja sellele järgneva viie aasta jooksul.",
      "rdfs:label": {
