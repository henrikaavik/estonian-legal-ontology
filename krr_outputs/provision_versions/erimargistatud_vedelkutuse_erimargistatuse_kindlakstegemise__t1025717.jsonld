      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord"
    },
    {
      "@id": "estleg:Reg_1025717_Par_1_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevat korda rakendatakse sõiduki, samuti muu masina või seadme kütusesüsteemis kasutatava vedelkütuse erimärgistatuse kindlakstegemisel järelevalvemenetluses. Käesolevat korda rakendatakse sõiduki, samuti muu masina või seadme kütusesüsteemis kasutatava vedelkütuse erimärgistatuse kindlakstegemisel järelevalvemenetluses.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_1 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_2_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõiduki, masina või seadme kütusesüsteemist kütuseproovi (edaspidi proov) võtmise õigus on Maksu- ja Tolliameti ametnikul. RT I 2023-11-28 2 128112023002 2023-12-01 Sõiduki, masina või seadme kütusesüsteemist kütuseproovi (edaspidi proov) võtmise õigus on Maksu- ja Tolliameti ametnikul.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_2 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_3_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Proovi võtja kasutab järgmisi abivahendeid: 1 1) pump sõiduki, masina või seadme kütusesüsteemist proovi võtmiseks; 2 2) korgiga pudelid või muud anumad, mis võimaldavad kohapeal plommi või tõkendi paigaldamist ning proovi saatmist laborisse analüüsimiseks; RT I 2023-11-28 2 128112023002 2023-12-01 3 3) läbipaistvad klaas- või plastkorgiga hermeetiliselt suletavad klaaspudelid või katseklaasid värvaine visuaalseks tuvastamiseks välitingimustes. RT I 2023-11-28 2 128112023002 2023-12-01 Proovi võtja kasutab järgmisi abivahendeid: pump sõiduki, masina või seadme kütusesüsteemist proovi võtmiseks; korgiga pudelid või muud anumad, mis võimaldavad kohapeal plommi või tõkendi paigaldamist ning proovi saatmist laborisse analüüsimiseks; läbipaistvad klaas- või plastkorgiga hermeetiliselt suletavad klaaspudelid või katseklaasid värvaine visuaalseks tuvastamiseks välitingimustes.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_3 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_4_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kütusesüsteemist võetakse selleks ettenähtud pumba abil prooviks kuni 200 grammi kütust kahes anumas. RT I 2023-11-28 2 128112023002 2023-12-01 Kütusesüsteemist võetakse selleks ettenähtud pumba abil prooviks kuni 200 grammi kütust kahes anumas. 2 (2) Kui kütusesüsteemist proovi võtmine osutub kohapeal võimatuks, on proovi võtjal õigus anda sõiduki, masina või seadme valdajale korraldus toimetada sõiduk, masin või seade lähimasse kohta, kus selle kütusesüsteemist on võimalik proovi võtta. Kui kütusesüsteemist proovi võtmine osutub kohapeal võimatuks, on proovi võtjal õigus anda sõiduki, masina või seadme valdajale korraldus toimetada sõiduk, masin või seade lähimasse kohta, kus selle kütusesüsteemist on võimalik proovi võtta. 3 (3) Kui proovi võtmisel kohapeal ei avastata kohe korrarikkumisele viitavaid asjaolusid, võib proovi võtnud ametnik selle kohe tagastada isikule, kelle kütusest proov võeti. RT I 2023-11-28 2 128112023002 2023-12-01 Kui proovi võtmisel kohapeal ei avastata kohe korrarikkumisele viitavaid asjaolusid, võib proovi võtnud ametnik selle kohe tagastada isikule, kelle kütusest proov võeti.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_4 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_5_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Proovi võtja koostab proovi võtmise kohta protokolli. Kui pärast proovi võtmist ei avastata korrarikkumisele viitavaid asjaolusid, võib proovi võtnud ametnik jätta protokolli koostamata, välja arvatud juhul, kui asjaomane isik seda nõuab. RT I 2023-11-28 2 128112023002 2023-12-01 Proovi võtja koostab proovi võtmise kohta protokolli. Kui pärast proovi võtmist ei avastata korrarikkumisele viitavaid asjaolusid, võib proovi võtnud ametnik jätta protokolli koostamata, välja arvatud juhul, kui asjaomane isik seda nõuab. 2 (2) Protokollis tuuakse ära järgmised andmed: 1 1) protokolli koostamise aeg ja koht; 2 2) sõiduki, masina või seadme valdaja nimi ja aadress; 3 3) sõiduki, masina või seadme omaniku nimi ja elukoha või asukoha aadress, kui omanik ei ole sõiduki, masina või seadme valdaja; 4 4) sõiduki, masina või seadme valdaja selgitused ja märkused ning allkiri; 5 5) märge selle kohta, kas kütuse erimärgistatus on visuaalselt selgesti nähtav; 6 6) pitseri, plommi või tõkendi number; 7 7) selle asutuse nimi ja aadress, kelle nimel protokoll koostatakse; 8 8) protokolli koostanud isiku ametinimetus, ees- ja perekonnanimi ning allkiri. Protokollis tuuakse ära järgmised andmed: protokolli koostamise aeg ja koht; sõiduki, masina või seadme valdaja nimi ja aadress; sõiduki, masina või seadme omaniku nimi ja elukoha või asukoha aadress, kui omanik ei ole sõiduki, masina või seadme valdaja; sõiduki, masina või seadme valdaja selgitused ja märkused ning allkiri; märge selle kohta, kas kütuse erimärgistatus on visuaalselt selgesti nähtav; pitseri, plommi või tõkendi number; selle asutuse nimi ja aadress, kelle nimel protokoll koostatakse; protokolli koostanud isiku ametinimetus, ees- ja perekonnanimi ning allkiri. 3 (3) Kui sõiduki, masina või seadme valdaja keeldub protokollile alla kirjutamast, tehakse protokolli selle kohta märge. Kui sõiduki, masina või seadme valdaja keeldub protokollile alla kirjutamast, tehakse protokolli selle kohta märge.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_5 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_6_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võetud proovis markeri Solvent Yellow 124 tuvastamiseks kütuses kasutab proovi võtja määruse lisas 1 toodud metoodikat ning markeri butoksübenseen tuvastamiseks määruse lisas 2 toodud metoodikat. RT I 2023-11-28 2 128112023002 2023-12-01 Võetud proovis markeri Solvent Yellow 124 tuvastamiseks kütuses kasutab proovi võtja määruse lisas 1 toodud metoodikat ning markeri butoksübenseen tuvastamiseks määruse lisas 2 toodud metoodikat.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_6 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_7_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Proovi võtja otsustab proovi analüüsi tegemiseks laborisse saatmise vajaduse lähtuvalt asjaoludest. Proovi laborisse saatmisel jääb teine anum sama prooviga proovi võtjale. RT I 2023-11-28 2 128112023002 2023-12-01 Proovi võtja otsustab proovi analüüsi tegemiseks laborisse saatmise vajaduse lähtuvalt asjaoludest. Proovi laborisse saatmisel jääb teine anum sama prooviga proovi võtjale.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_7 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_8_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Labor kasutab proovi analüüsimisel markeri ja värvaine tuvastamiseks määruse lisades 1–3 toodud metoodikaid. RT I 2023-11-28 2 128112023002 2023-12-01 Labor kasutab proovi analüüsimisel markeri ja värvaine tuvastamiseks määruse lisades 1–3 toodud metoodikaid.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_8 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1025717_Par_9_v1025717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025717_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Proovi võtjale jäänud pudelis või anumas sisalduv proov saadetakse laborisse uue analüüsi tegemiseks juhul, kui sõiduki, masina või seadme valdaja või omanik vaidlustab labori tehtud proovi analüüsi tulemuse. Proovi võtjale jäänud pudelis või anumas sisalduv proov saadetakse laborisse uue analüüsi tegemiseks juhul, kui sõiduki, masina või seadme valdaja või omanik vaidlustab labori tehtud proovi analüüsi tulemuse.",
      "rdfs:label": {
        "@value": "Reg_1025717_Par_9 (redaktsioon 1025717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025717",
      "estleg:sourceAct": "Erimärgistatud vedelkütuse erimärgistatuse kindlakstegemise kord",
      "estleg:provisionRef": "Reg_1025717 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1025717_Map_2026"
      }
    },
