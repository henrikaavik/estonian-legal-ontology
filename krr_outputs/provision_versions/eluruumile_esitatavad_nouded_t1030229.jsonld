      }
    },
    {
      "@id": "estleg:Reg_1030229_Par_5_v1030229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030229_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eluruum peab olema varustatud tualetiga või selle puudumisel peab olema tagatud tualeti kasutamise võimalus samas hoones või hoone teenindamiseks määratud maa-alal. Eluruum peab olema varustatud tualetiga või selle puudumisel peab olema tagatud tualeti kasutamise võimalus samas hoones või hoone teenindamiseks määratud maa-alal. 2 (2) Eluruumis peab olema tagatud vähemalt külma vee saamise võimalus või selle puudumisel peab olema tagatud külma vee saamise võimalus samas hoones või hoone teenindamiseks määratud maa-alal. Eluruumis peab olema tagatud vähemalt külma vee saamise võimalus või selle puudumisel peab olema tagatud külma vee saamise võimalus samas hoones või hoone teenindamiseks määratud maa-alal.",
      "rdfs:label": {
        "@value": "Reg_1030229_Par_5 (redaktsioon 1030229)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030229",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030229",
      "estleg:sourceAct": "Eluruumile esitatavad nõuded",
      "estleg:provisionRef": "Reg_1030229 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030229_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030229_Par_6_v1030229",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030229_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne 7. veebruari 1999. aastat püstitatud hoones asuv eluruum, mis ei vasta käesoleva määruse §-des 2–5 sätestatud nõuetele, võib kasutada eluruumina, kuid hoone olulise rekonstrueerimise korral tuleb eluruum viia vastavusse käesolevas määruses sätestatud nõuetega. Enne 7. veebruari 1999. aastat püstitatud hoones asuv eluruum, mis ei vasta käesoleva määruse §-des 2–5 sätestatud nõuetele, võib kasutada eluruumina, kuid hoone olulise rekonstrueerimise korral tuleb eluruum viia vastavusse käesolevas määruses sätestatud nõuetega. 2 (2) Enne 1940. aastat ehitatud hoones asuv eluruum võib pärast olulist rekonstrueerimist erineda käesoleva määruse §-des 2 ja 3 sätestatud nõuetest kuni 10 protsendi võrra. Enne 1940. aastat ehitatud hoones asuv eluruum võib pärast olulist rekonstrueerimist erineda käesoleva määruse §-des 2 ja 3 sätestatud nõuetest kuni 10 protsendi võrra. 3 (3) Käesoleva määruse §-des 2 ja 3 ning § 5 lõikes 1 sätestatud nõudeid ei rakendata mälestiseks tunnistatud hoones, muinsuskaitsealal paiknevas hoones, UNESCO maailmapärandi nimekirja kantud ja miljööväärtuslikul (hoonestus)alal asuvas hoones, mis on püstitatud enne 1. juulit 2015. aastat, asuvale eluruumile. Käesoleva määruse §-des 2 ja 3 ning § 5 lõikes 1 sätestatud nõudeid ei rakendata mälestiseks tunnistatud hoones, muinsuskaitsealal paiknevas hoones, UNESCO maailmapärandi nimekirja kantud ja miljööväärtuslikul (hoonestus)alal asuvas hoones, mis on püstitatud enne 1. juulit 2015. aastat, asuvale eluruumile. 4 (4) Enne 2019. aasta 1. augustit koostatud ehitusprojektile ei rakendata § 3 lõike 4 nõudeid. RT I 2018-08-24 1 124082018001 2018-08-27 Enne 2019. aasta 1. augustit koostatud ehitusprojektile ei rakendata § 3 lõike 4 nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1030229_Par_6 (redaktsioon 1030229)",
        "@language": "et"
      },
