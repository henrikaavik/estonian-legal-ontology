    {
      "@id": "estleg:Reg_1002215_Par_16_v1002215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002215_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PCT taotluse menetlusse võtmiseks peab taotleja esitama Patendiametile „Patendiseaduse” § 33 lõikes 1 sätestatud 31 kuu jooksul prioriteedikuupäevast, mitme prioriteedi korral aga varaseimast prioriteedikuupäevast, käesoleva määruse §-s 4 nimetatud dokumendid. PCT taotluse menetlusse võtmiseks peab taotleja esitama Patendiametile „Patendiseaduse” § 33 lõikes 1 sätestatud 31 kuu jooksul prioriteedikuupäevast, mitme prioriteedi korral aga varaseimast prioriteedikuupäevast, käesoleva määruse §-s 4 nimetatud dokumendid. 2 (2) PCT taotluse siseriiklikku menetlusse esitamise päevaks loetakse dokumentide tegelik Patendiametisse saabumise päev. See kehtib ka patenditaotluse edastamisel posti- või kulleriteenust kasutades. PCT taotluse siseriiklikku menetlusse esitamise päevaks loetakse dokumentide tegelik Patendiametisse saabumise päev. See kehtib ka patenditaotluse edastamisel posti- või kulleriteenust kasutades.",
      "rdfs:label": {
        "@value": "Reg_1002215_Par_16 (redaktsioon 1002215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002215",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1002215",
      "estleg:sourceAct": "Rahvusvahelise patenditaotluse Patendiametile esitamise kord",
      "estleg:provisionRef": "Reg_1002215 § 16",
