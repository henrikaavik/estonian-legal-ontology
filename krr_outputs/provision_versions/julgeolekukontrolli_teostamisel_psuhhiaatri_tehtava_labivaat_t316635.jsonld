      "estleg:sourceAct": "Julgeolekukontrolli teostamisel psühhiaatri tehtava läbivaatuse ja järeldusotsuse vormistamise kord",
      "estleg:provisionRef": "Reg_316635 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_316635_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_316635_Par_3_v316635",
      "@type": [
