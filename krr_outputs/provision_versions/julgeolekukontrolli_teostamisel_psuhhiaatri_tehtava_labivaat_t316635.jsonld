      },
      "dc:source": "Julgeolekukontrolli teostamisel psühhiaatri tehtava läbivaatuse ja järeldusotsuse vormistamise kord"
    },
    {
      "@id": "estleg:Reg_316635_Par_1_v316635",
      "@type": [
