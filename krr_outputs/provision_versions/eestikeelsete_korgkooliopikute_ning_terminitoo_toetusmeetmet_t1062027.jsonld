        "@value": "2025-10-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõrgkooliõpiku toetuse saaja tagab, et toetuse abil valminud õpik on avalikult juurdepääsetavas repositooriumis tasuta kättesaadav. Kõrgkooliõpiku toetuse saaja tagab, et toetuse abil valminud õpik on avalikult juurdepääsetavas repositooriumis tasuta kättesaadav.",
      "rdfs:label": {
        "@value": "Reg_1062027_Par_20 (redaktsioon 1062027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062027",
      "estleg:sourceAct": "Eestikeelsete kõrgkooliõpikute ning terminitöö toetusmeetmete elluviimiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1062027 § 20",
