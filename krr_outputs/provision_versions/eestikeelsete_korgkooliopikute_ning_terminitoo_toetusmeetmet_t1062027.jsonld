        "@language": "et"
      },
      "estleg:versionRedactionId": "1062027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062027",
      "estleg:sourceAct": "Eestikeelsete kõrgkooliõpikute ning terminitöö toetusmeetmete elluviimiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1062027 § 18",
