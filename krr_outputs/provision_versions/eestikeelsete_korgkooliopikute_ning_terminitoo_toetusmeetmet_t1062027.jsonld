        "@value": "2025-10-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotluste hindamisel võtab juhtkomitee arvesse plaanitava sündmuse sobivust konkursi eesmärkide ja tingimustega ning kavandatud eelarvet, lähtudes sündmuse eesmärgist ja sihtrühmast. Taotluste hindamisel võtab juhtkomitee arvesse plaanitava sündmuse sobivust konkursi eesmärkide ja tingimustega ning kavandatud eelarvet, lähtudes sündmuse eesmärgist ja sihtrühmast.",
      "rdfs:label": {
        "@value": "Reg_1062027_Par_15 (redaktsioon 1062027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062027",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062027",
      "estleg:sourceAct": "Eestikeelsete kõrgkooliõpikute ning terminitöö toetusmeetmete elluviimiseks toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1062027 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062027_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1062027_Par_16_v1062027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
