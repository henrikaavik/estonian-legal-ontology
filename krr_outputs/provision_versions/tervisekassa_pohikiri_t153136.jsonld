      "estleg:versionText": "Tervisekassa asub Tallinnas. Tervisekassa asub Tallinnas.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_2 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
