      }
    },
    {
      "@id": "estleg:Reg_153136_Par_40_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu - RT I 2015-12-08 5 108122015005 2016-01-01 Kehtetu - 2 (2) Juhatus esitab hiljemalt 15. oktoobriks nõukogule läbivaatamiseks Tervisekassa eelarve esialgse projekti koos seletuskirjaga. Nõukogu arutab esialgset eelarve projekti vähemalt kahel lugemisel ja vajadusel tagastab Tervisekassa eelarve esialgse projekti juhatusele muudatuste tegemiseks. RT I 2006 23 170 1028275 2006-05-26 Juhatus esitab hiljemalt 15. oktoobriks nõukogule läbivaatamiseks Tervisekassa eelarve esialgse projekti koos seletuskirjaga. Nõukogu arutab esialgset eelarve projekti vähemalt kahel lugemisel ja vajadusel tagastab Tervisekassa eelarve esialgse projekti juhatusele muudatuste tegemiseks. 3 (3) Juhatus esitab Tervisekassa eelarve projekti, milles on arvestatud nõukogus toimunud lugemiste tulemusi ning vastuvõetud iga-aastase riigieelarve seadusest tulenevaid muutusi, nõukogule kinnitamiseks 14 päeva jooksul, arvates iga-aastase riigieelarve seaduse Riigi Teatajas avaldamisest. Juhatus esitab Tervisekassa eelarve projekti, milles on arvestatud nõukogus toimunud lugemiste tulemusi ning vastuvõetud iga-aastase riigieelarve seadusest tulenevaid muutusi, nõukogule kinnitamiseks 14 päeva jooksul, arvates iga-aastase riigieelarve seaduse Riigi Teatajas avaldamisest.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_40 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_41_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõukogu kinnitab Tervisekassa eelarve 30 päeva jooksul, arvates iga-aastase riigieelarve seaduse Riigi Teatajas avaldamisest. Kui nõukogu ei ole nimetatud tähtajaks Tervisekassa eelarvet kinnitanud, läheb eelarve kinnitamise õigus ja kohustus üle Vabariigi Valitsusele. Nõukogu kinnitab Tervisekassa eelarve 30 päeva jooksul, arvates iga-aastase riigieelarve seaduse Riigi Teatajas avaldamisest. Kui nõukogu ei ole nimetatud tähtajaks Tervisekassa eelarvet kinnitanud, läheb eelarve kinnitamise õigus ja kohustus üle Vabariigi Valitsusele.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_41 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_42_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_153136_Par_42 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 42",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_43_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekassa eelarves majandusaastaks määratud kulude otstarbe muutmiseks, muutmata kulude kogumahtu, esitab juhatus eelarve muutmise projekti nõukogule kinnitamiseks. Tervisekassa eelarves majandusaastaks määratud kulude otstarbe muutmiseks, muutmata kulude kogumahtu, esitab juhatus eelarve muutmise projekti nõukogule kinnitamiseks. 2 (2) Juhatus võib majandusaasta jooksul esitada nõukogule kinnitamiseks Tervisekassa lisaeelarve projekti, tasakaalustatult suurendades või vähendades Tervisekassa kulusid ja kulude katteallikaid. RT I 2009 20 134 13167901 2009-04-11 Juhatus võib majandusaasta jooksul esitada nõukogule kinnitamiseks Tervisekassa lisaeelarve projekti, tasakaalustatult suurendades või vähendades Tervisekassa kulusid ja kulude katteallikaid. 3 (3) Nõukogu arutab eelarve muutmise või lisaeelarve projekti kahel lugemisel ja otsustab selle kinnitamise hiljemalt 60 päeva jooksul, alates eelarve muutmise või lisaeelarve projekti esitamise päevast. RT I 2006 23 170 1028275 2006-05-26 Nõukogu arutab eelarve muutmise või lisaeelarve projekti kahel lugemisel ja otsustab selle kinnitamise hiljemalt 60 päeva jooksul, alates eelarve muutmise või lisaeelarve projekti esitamise päevast.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_43 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_44_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekassa eelarve kulude katteallikateks on: 1 1) Tervisekassa majandusaasta tulud; 2 2) eelmiste perioodide jaotamata kasum, mis võetakse kasutusele «Tervisekassa seaduse» §-s 361 sätestatud korras. RT I 2023-04-05 1 105042023001 2023-04-08 Tervisekassa eelarve kulude katteallikateks on: Tervisekassa majandusaasta tulud; eelmiste perioodide jaotamata kasum, mis võetakse kasutusele «Tervisekassa seaduse» §-s 361 sätestatud korras. 2 (2) Tervisekassa majandusaasta tulud on: 1 1) riigieelarves ravikindlustuseks ettenähtud vahendid ja ravikindlustuseks ettenähtud sotsiaalmaksu ülelaekumised, sealhulgas sotsiaalmaksuseaduses sätestatud ulatuses ja korras täiendavalt riikliku ravikindlustuse vahenditesse kantud summad; RT I 2015-12-08 5 108122015005 2017-01-01 1 1¹) tervishoiuteenuste korraldamise seaduse alusel kehtestatud riigieelarvelise eraldise osa; RT I 2017-12-29 24 129122017024 2018-01-01 2 2) tulud kindlustuslepingute alusel; RT I 2015-12-08 5 108122015005 2016-01-01 3 3) sissenõuded teistelt isikutelt; 4 4) finantstulud; 5 5) muud tulud. RT I 2009 20 134 13167901 2009-04-11 Tervisekassa majandusaasta tulud on: riigieelarves ravikindlustuseks ettenähtud vahendid ja ravikindlustuseks ettenähtud sotsiaalmaksu ülelaekumised, sealhulgas sotsiaalmaksuseaduses sätestatud ulatuses ja korras täiendavalt riikliku ravikindlustuse vahenditesse kantud summad; tervishoiuteenuste korraldamise seaduse alusel kehtestatud riigieelarvelise eraldise osa; tulud kindlustuslepingute alusel; sissenõuded teistelt isikutelt; finantstulud; muud tulud.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_44 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 44",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_45_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekassa eelarve kulud jagunevad tervishoiukuludeks ja Tervisekassa tegevuskuludeks. RT I 2017-12-29 24 129122017024 2018-01-01 Tervisekassa eelarve kulud jagunevad tervishoiukuludeks ja Tervisekassa tegevuskuludeks. 2 (2) Tervisekassa tervishoiukulud jagunevad: 1 1) tervishoiuteenuste, sealhulgas haiguste ennetamise kulud, perearstiabi ja eriarstiabi kulud, iseseisvalt osutatava õendusabi kulud, alla 19-aastaste kindlustatud isikute hambaravi kulud, täiskasvanute mitterahalise hambaravihüvitise ja mitterahalise proteesihüvitise kulud, kiirabi kulud; RT I 2024-10-01 3 101102024003 2024-10-04 2 2) tervise edendamise kulud; 3 3) kindlustatutele kompenseeritavate ravimite kulud, sealhulgas täiendava ravimihüvitise kulud; 4 4) ajutise töövõimetuse hüvitiste kulud; 5 5) meditsiiniseadmehüvitiste kulud; 6 6) kindlustatule välisriigis osutatud tervishoiuteenuste kulud; 7 7) muud kulud. RT I 2017-12-29 24 129122017024 2018-01-01 Tervisekassa tervishoiukulud jagunevad: tervishoiuteenuste, sealhulgas haiguste ennetamise kulud, perearstiabi ja eriarstiabi kulud, iseseisvalt osutatava õendusabi kulud, alla 19-aastaste kindlustatud isikute hambaravi kulud, täiskasvanute mitterahalise hambaravihüvitise ja mitterahalise proteesihüvitise kulud, kiirabi kulud; tervise edendamise kulud; kindlustatutele kompenseeritavate ravimite kulud, sealhulgas täiendava ravimihüvitise kulud; ajutise töövõimetuse hüvitiste kulud; meditsiiniseadmehüvitiste kulud; kindlustatule välisriigis osutatud tervishoiuteenuste kulud; muud kulud. 3 (3) Tervisekassa tegevuskuludeks on ravikindlustussüsteemi administreerimiseks vajalikud kulud, mis jagunevad: 1 1) tööjõukulud, sealhulgas töötasu, nõukogu ja juhatuse liikmete tasud ning sotsiaalmaks ja töötuskindlustusmakse; RT I 2015-12-08 5 108122015005 2016-01-01 2 2) majandamiskulud; 3 3) infotehnoloogia kulud; 4 4) kehtetu - RT I 2006 23 170 1028275 2006-05-26 5 5) arenduskulud; 6 6) kehtetu - RT I 2015-12-08 5 108122015005 2016-01-01 7 7) kehtetu - RT I 2003 61 405 623231 2003-10-01 8 8) muud tegevuskulud. RT I 2015-12-08 5 108122015005 2016-01-01 Tervisekassa tegevuskuludeks on ravikindlustussüsteemi administreerimiseks vajalikud kulud, mis jagunevad: tööjõukulud, sealhulgas töötasu, nõukogu ja juhatuse liikmete tasud ning sotsiaalmaks ja töötuskindlustusmakse; majandamiskulud; infotehnoloogia kulud; kehtetu - arenduskulud; kehtetu - kehtetu - muud tegevuskulud.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_45 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 45",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_46_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa kassatagavara on Tervisekassa rahalised vahendid, välja arvatud reservkapitali vahendid, mida kasutatakse Tervisekassa rahavoogude juhtimiseks. RT I 2012-07-03 13 103072012013 2012-07-06 Tervisekassa kassatagavara on Tervisekassa rahalised vahendid, välja arvatud reservkapitali vahendid, mida kasutatakse Tervisekassa rahavoogude juhtimiseks.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_46 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 46",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_47_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekassa hoiab kassatagavara vahendeid riigiga sõlmitava hoiulepingu alusel riigi kontsernikonto koosseisu kuuluval arvelduskontol ja teostab sealt makseid. Tervisekassa hoiab kassatagavara vahendeid riigiga sõlmitava hoiulepingu alusel riigi kontsernikonto koosseisu kuuluval arvelduskontol ja teostab sealt makseid. 2 (2) Kassatagavara vahendeid paigutab Rahandusministeerium koos riigi rahaga riigieelarve seaduse § 67 lõike 4 alusel. RT I 2017-12-29 24 129122017024 2018-01-01 Kassatagavara vahendeid paigutab Rahandusministeerium koos riigi rahaga riigieelarve seaduse § 67 lõike 4 alusel. 3 (3) Riik maksab Tervisekassale riigi kontsernikonto koosseisu kuuluval arvelduskontol hoitava kassatagavara jäägilt intressi, mille suurus on võrdne riigi kassareservi tulususega, kui Tervisekassaga sõlmitavas hoiulepingus ei ole kokku lepitud teisiti. RT I 2012-07-03 13 103072012013 2012-07-06 Riik maksab Tervisekassale riigi kontsernikonto koosseisu kuuluval arvelduskontol hoitava kassatagavara jäägilt intressi, mille suurus on võrdne riigi kassareservi tulususega, kui Tervisekassaga sõlmitavas hoiulepingus ei ole kokku lepitud teisiti.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_47 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 47",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
