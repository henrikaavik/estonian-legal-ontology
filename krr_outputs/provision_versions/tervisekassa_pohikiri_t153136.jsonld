      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "Reg_153136_Par_50 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_51_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa põhikirja kehtestab ning põhikirjas teeb muudatusi Vabariigi Valitsus. Enne põhikirja muutmise ettepaneku esitamist Vabariigi Valitsusele kuulab valdkonna eest vastutav minister ära Tervisekassa nõukogu arvamuse. RT I 2015-12-08 5 108122015005 2016-01-01 Tervisekassa põhikirja kehtestab ning põhikirjas teeb muudatusi Vabariigi Valitsus. Enne põhikirja muutmise ettepaneku esitamist Vabariigi Valitsusele kuulab valdkonna eest vastutav minister ära Tervisekassa nõukogu arvamuse.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_51 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153136_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153136_Par_52_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa ei või jaguneda ega ühineda teiste juriidiliste isikutega ning Tervisekassat ei või ümber kujundada muud liiki juriidiliseks isikuks. Tervisekassa ei või jaguneda ega ühineda teiste juriidiliste isikutega ning Tervisekassat ei või ümber kujundada muud liiki juriidiliseks isikuks.",
      "rdfs:label": {
        "@value": "Reg_153136_Par_52 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
