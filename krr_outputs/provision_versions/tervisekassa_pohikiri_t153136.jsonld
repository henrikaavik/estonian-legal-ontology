    {
      "@id": "estleg:Reg_153136_Par_5_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa organid on Tervisekassa nõukogu (edaspidi nõukogu) ja Tervisekassa juhatus (edaspidi juhatus). Tervisekassa organid on Tervisekassa nõukogu (edaspidi nõukogu) ja Tervisekassa juhatus (edaspidi juhatus).",
      "rdfs:label": {
        "@value": "Reg_153136_Par_5 (redaktsioon 153136)",
        "@language": "et"
      },
