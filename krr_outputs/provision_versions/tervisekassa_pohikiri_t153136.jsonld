    {
      "@id": "estleg:Reg_153136_Par_37_v153136",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153136_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "Reg_153136_Par_37 (redaktsioon 153136)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153136",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153136",
      "estleg:sourceAct": "Tervisekassa põhikiri",
      "estleg:provisionRef": "Reg_153136 § 37",
