        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 14. detsembri 2010. a käskkirjaga nr 1828 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Kaitseala kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 14. detsembri 2010. a käskkirjaga nr 1828 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1022021_Par_18 (redaktsioon 1022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022021",
      "estleg:sourceAct": "Kihnu laidude looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1022021 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022021_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1022021_Par_19_v1022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022021_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1022021_Par_19 (redaktsioon 1022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1022021",
      "estleg:sourceAct": "Kihnu laidude looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1022021 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022021_Map_2026"
      }
    },
