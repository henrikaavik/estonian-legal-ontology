    {
      "@id": "estleg:Reg_1022021_Par_10_v1022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022021_Par_10"
