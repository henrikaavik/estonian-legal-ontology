      "dc:source": "Maapiirkonnas majandustegevuse mitmekesistamise investeeringutoetuse andmise ja kasutamise tingimused ning kord"
    },
    {
      "@id": "estleg:Reg_1028724_Par_1_v1028724",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028724_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 6 „Põllumajandusettevõtete ja ettevõtluse areng” tegevuse liigi „Investeeringud majandustegevuse mitmekesistamiseks maapiirkonnas mittepõllumajandusliku tegevuse suunas” raames antava maapiirkonnas majandustegevuse mitmekesistamise investeeringutoetuse (edaspidi toetus) andmise ja kasutamise tingimused ning kord. Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” (edaspidi arengukava) meetme 6 „Põllumajandusettevõtete ja ettevõtluse areng” tegevuse liigi „Investeeringud majandustegevuse mitmekesistamiseks maapiirkonnas mittepõllumajandusliku tegevuse suunas” raames antava maapiirkonnas majandustegevuse mitmekesistamise investeeringutoetuse (edaspidi toetus) andmise ja kasutamise tingimused ning kord.",
      "rdfs:label": {
        "@value": "Reg_1028724_Par_1 (redaktsioon 1028724)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028724",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028724",
      "estleg:sourceAct": "Maapiirkonnas majandustegevuse mitmekesistamise investeeringutoetuse andmise ja kasutamise tingimused ning kord",
      "estleg:provisionRef": "Reg_1028724 § 1",
