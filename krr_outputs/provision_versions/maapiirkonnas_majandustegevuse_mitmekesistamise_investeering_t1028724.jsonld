    {
      "@id": "estleg:Reg_1028724_Par_21_v1028724",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028724_Par_21"
