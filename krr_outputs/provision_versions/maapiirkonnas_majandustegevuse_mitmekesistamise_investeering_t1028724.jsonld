      "estleg:versionValidFrom": {
        "@value": "2025-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitatakse PRIAs kuni 2032. aasta 31. detsembrini. Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitatakse PRIAs kuni 2032. aasta 31. detsembrini.",
      "rdfs:label": {
        "@value": "Reg_1028724_Par_20 (redaktsioon 1028724)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028724",
