      "estleg:versionText": "«Looduskaitseseaduse» § 21 lõike 1 kohaselt on püsielupaiga valitsejaks Keskkonnaamet. RTL 2009 11 131 13126723 2009-02-01 «Looduskaitseseaduse» § 21 lõike 1 kohaselt on püsielupaiga valitsejaks Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_301125_Par_3 (redaktsioon 301125)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301125",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301125",
      "estleg:sourceAct": "Euroopa naaritsa püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301125 § 3",
