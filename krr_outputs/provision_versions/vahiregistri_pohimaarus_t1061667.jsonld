      "estleg:provisionRef": "Reg_1061667 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061667_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061667_Par_12_v1061667",
