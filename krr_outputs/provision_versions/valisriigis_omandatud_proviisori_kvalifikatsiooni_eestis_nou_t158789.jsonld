      "dc:source": "Välisriigis omandatud proviisori kvalifikatsiooni Eestis nõutava kvalifikatsiooniga võrdlemise kord"
    },
    {
      "@id": "estleg:Reg_158789_Par_1_v158789",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158789_Par_1"
