      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Hoiualade kaitse alla võtmine Ida-Viru maakonnas (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Hoiualade kaitse alla võtmine Ida-Viru maakonnas"
    },
    {
      "@id": "estleg:Reg_158680_Par_1_v158680",
      "@type": [
