      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib tasu vähendada või jätta tasu määramata, kui advokaat ei ole oma kohustusi õigusabi osutamisel täitnud nõuetekohase hoolsusega. Kohus võib tasu vähendada või jätta tasu määramata, kui advokaat ei ole oma kohustusi õigusabi osutamisel täitnud nõuetekohase hoolsusega.",
      "rdfs:label": {
        "@value": "Reg_1035613_Par_3 (redaktsioon 1035613)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035613",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035613",
      "estleg:sourceAct": "Advokaadile riigi õigusabi tasu maksmise ja kulude hüvitamise kord",
      "estleg:provisionRef": "Reg_1035613 § 3",
