      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi õigusabi osutamisel alaealisele kohtulahendi tutvustamise eest on tasu 30 eurot. RT I 2023-02-03 51 103022023051 2023-02-06 Riigi õigusabi osutamisel alaealisele kohtulahendi tutvustamise eest on tasu 30 eurot.",
      "rdfs:label": {
        "@value": "Reg_1035613_Par_14_14 (redaktsioon 1035613)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035613",
