      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervise Arengu Instituut (edaspidi TAI) on Sotsiaalministeeriumi hallatav riigi teadus- ja arendusasutus. Tervise Arengu Instituut (edaspidi TAI) on Sotsiaalministeeriumi hallatav riigi teadus- ja arendusasutus. 2 (2) TAI nimetus inglise keeles on National Institute for Health Development. TAI rahvusvaheline lühend on NIHD. TAI nimetus inglise keeles on National Institute for Health Development. TAI rahvusvaheline lühend on NIHD.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_1 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
