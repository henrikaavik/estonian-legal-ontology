    {
      "@id": "estleg:Reg_1058406_Par_10_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) TAI teadus- ja arendustegevusega seotud küsimuste lahendamiseks põhimääruses sätestatud ulatuses moodustatakse viie- kuni seitsmeliikmeline teadusnõukogu, mille koosseisu kinnitab direktori ettepanekul minister. RT I 2026-04-28 1 128042026001 2026-05-01 TAI teadus- ja arendustegevusega seotud küsimuste lahendamiseks põhimääruses sätestatud ulatuses moodustatakse viie- kuni seitsmeliikmeline teadusnõukogu, mille koosseisu kinnitab direktori ettepanekul minister. 2 (2) Teadusnõukogusse kuulub ametikoha järgi TAI teadusdirektor. Teadusnõukogusse kuulub ametikoha järgi TAI teadusdirektor. 3 (3) Teadusnõukogu liikmed valivad enda hulgast teadusnõukogu juhi. Teadusnõukogu liikmed valivad enda hulgast teadusnõukogu juhi.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_10 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_11_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teadusnõukogu: 1 1) kinnitab TAI teadustegevuse uurimissuunad, annab soovitusi välisprojektides osalemiseks ning annab hinnangu nende tulemustele; RT I 2026-04-28 1 128042026001 2026-05-01 2 2) annab suuniseid TAI teadus- ja arendustegevuste elluviimiseks; 3 3) kehtetu - RT I 2026-04-28 1 128042026001 2026-05-01 4 4) kehtetu - RT I 2026-04-28 1 128042026001 2026-05-01 5 5) kiidab heaks TAI akadeemilise töötaja ametikohtade nimetused, nende täitmise tingimused ja akadeemilisele töötajale esitatavad nõuded; RT I 2026-04-28 1 128042026001 2026-05-01 6 6) esitab TAI töötajaid asutuseväliseks autasustamiseks, Eesti Teaduste Akadeemiasse või auastmeisse valimiseks ja annab vastavaid soovitusi. Teadusnõukogu: kinnitab TAI teadustegevuse uurimissuunad, annab soovitusi välisprojektides osalemiseks ning annab hinnangu nende tulemustele; annab suuniseid TAI teadus- ja arendustegevuste elluviimiseks; kehtetu - kehtetu - kiidab heaks TAI akadeemilise töötaja ametikohtade nimetused, nende täitmise tingimused ja akadeemilisele töötajale esitatavad nõuded; esitab TAI töötajaid asutuseväliseks autasustamiseks, Eesti Teaduste Akadeemiasse või auastmeisse valimiseks ja annab vastavaid soovitusi.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_11 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_12_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_12"
