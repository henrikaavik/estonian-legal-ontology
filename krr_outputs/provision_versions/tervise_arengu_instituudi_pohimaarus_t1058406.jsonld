    {
      "@id": "estleg:Reg_1058406_Par_2_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) TAI-l on väikese riigivapi kujutise ja oma nimega pitsat. TAI-l on väikese riigivapi kujutise ja oma nimega pitsat. 2 (2) TAI-l on oma logo, mida võib kasutada TAI dokumendiplangil ning muul asutuse trükisel ja meenel. TAI-l on oma logo, mida võib kasutada TAI dokumendiplangil ning muul asutuse trükisel ja meenel.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_2 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_3_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) TAI tegevust rahastatakse riigieelarvest, põhitegevusega seotud tasulistest teenustest saadud tulust, programmide ja projektide täitmiseks eraldatud vahenditest ja muudest laekumistest. TAI tegevust rahastatakse riigieelarvest, põhitegevusega seotud tasulistest teenustest saadud tulust, programmide ja projektide täitmiseks eraldatud vahenditest ja muudest laekumistest. 2 (2) TAI taristu kulu, riiklike tervise- ja sotsiaalvaldkonna programmide ja arengukavade elluviimise ja tervisestatistika tegemise kulud ja registrite ülalpidamisega seotud kulud kaetakse riigieelarvest Sotsiaalministeeriumi eelarve kaudu. TAI taristu kulu, riiklike tervise- ja sotsiaalvaldkonna programmide ja arengukavade elluviimise ja tervisestatistika tegemise kulud ja registrite ülalpidamisega seotud kulud kaetakse riigieelarvest Sotsiaalministeeriumi eelarve kaudu.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_3 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_4_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "TAI on aruandekohustuslik valdkonna eest vastutava ministri (edaspidi minister) ees, kes suunab ja koordineerib TAI tegevust ja eelarve ning teeb tema tegevuse üle järelevalvet. TAI on aruandekohustuslik valdkonna eest vastutava ministri (edaspidi minister) ees, kes suunab ja koordineerib TAI tegevust ja eelarve ning teeb tema tegevuse üle järelevalvet.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_4 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_5_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "TAI asub Tallinnas ja Tartus. TAI asub Tallinnas ja Tartus.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_5 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_6_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "TAI tegevusvaldkonnad on heaolu ja tervise: 1 1) edendamiseks, haiguste ennetamiseks ja tõrjeks ning riikliku tervisepoliitika kujundamiseks kvaliteetsete ja ajakohaste terviseandmete ning tõenduspõhise teabe kogumine ja analüüs; 2 2) kõrgetasemeline teadmusloome; 3 3) innovaatiliste lahenduste väljatöötamine ja katsetamine. TAI tegevusvaldkonnad on heaolu ja tervise: edendamiseks, haiguste ennetamiseks ja tõrjeks ning riikliku tervisepoliitika kujundamiseks kvaliteetsete ja ajakohaste terviseandmete ning tõenduspõhise teabe kogumine ja analüüs; kõrgetasemeline teadmusloome; innovaatiliste lahenduste väljatöötamine ja katsetamine.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_6 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058406_Par_7_v1058406",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058406_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "TAI ülesanded oma tegevusvaldkonnas on: 1 1) rahvastiku tervise ja heaolu ning neid mõjutavate tegurite seire, analüüs ja teadustöö; 2 2) teadustöö tegemiseks, tervise- ja sotsiaalkaitse arendamiseks ja juhtimiseks vajalike andmekogude moodustamine ja pidamine, uuringuandmete kogumine, nende analüüs ja kättesaadavuse korraldamine; 3 3) riigi infosüsteemi kuuluvate tervisevaldkonna andmekogude pidamine ja arendamine, mille vastutavaks või volitatud töötlejaks TAI on määratud; 4 4) tervisestatistika tegemine, s.o kõik toimingud, mis on seotud tervisestatistika jaoks andmete kogumise, nende statistilise töötlemise, analüüsi, levitamise ja säilitamisega ning nimetatud tegevuste arendamisega; 5 5) tervisesüsteemi toimivuse hindamise indikaatorite väljatöötamine ja seire; 6 6) iga-aastase rahvastiku tervise aruande koostamine; 7 7) eri valdkondade poliitiliste muudatuste, otsuste ja meetmete heaolu ja tervisega seotud mõjususe ja kuluefektiivsuse hindamine; 8 8) eri valdkondade sekkumiste, sealhulgas teenuste arendamine, toetamine, esmane rakendamine ja hindamine ning rakendamise ja hindamise koordineerimine; 9 9) ettepanekute tegemine ja osalemine eri valdkondade poliitika, strateegiate ja arengukavade koostamisel ja elluviimisel; 10 10) riiklike ja välisrahastusel põhinevate programmide väljatöötamine ja neis osalemine, nende koordineerimine ja elluviimine, strateegiate rakendamiseks vajalike tegevuskavade väljatöötamine ja elluviimine; 11 11) ekspertabi osutamine rahvastiku tervise- ja sotsiaalkaitse küsimustes; 12 12) osalemine riiklikus ja rahvusvahelises teadus- ja arendustegevuses; 13 13) asutuse põhitegevusega seotud valdkondades riigi esindamine Euroopa Liidu ja rahvusvahelistes organisatsioonides, töörühmades, võrgustikes ja komiteedes; RT I 2026-04-28 1 128042026001 2026-05-01 14 14) spetsialistide teadmiste ja oskuste arendamine ja koolituste korraldamine asutuse põhitegevusega seotud valdkondades; 15 15) meditsiiniterminoloogia ning tervishoiu-, rahvatervishoiu- ja sotsiaalvaldkonna terminoloogia arendamine; 16 16) klassifikaatori omanikuna klassifikaatori arendamise, juurutamise ja semantilise koosvõime eest vastutamine; 17 17) muude ministeeriumi või TAI teadusnõukogu antud ülesannete täitmine. TAI ülesanded oma tegevusvaldkonnas on: rahvastiku tervise ja heaolu ning neid mõjutavate tegurite seire, analüüs ja teadustöö; teadustöö tegemiseks, tervise- ja sotsiaalkaitse arendamiseks ja juhtimiseks vajalike andmekogude moodustamine ja pidamine, uuringuandmete kogumine, nende analüüs ja kättesaadavuse korraldamine; riigi infosüsteemi kuuluvate tervisevaldkonna andmekogude pidamine ja arendamine, mille vastutavaks või volitatud töötlejaks TAI on määratud; tervisestatistika tegemine, s.o kõik toimingud, mis on seotud tervisestatistika jaoks andmete kogumise, nende statistilise töötlemise, analüüsi, levitamise ja säilitamisega ning nimetatud tegevuste arendamisega; tervisesüsteemi toimivuse hindamise indikaatorite väljatöötamine ja seire; iga-aastase rahvastiku tervise aruande koostamine; eri valdkondade poliitiliste muudatuste, otsuste ja meetmete heaolu ja tervisega seotud mõjususe ja kuluefektiivsuse hindamine; eri valdkondade sekkumiste, sealhulgas teenuste arendamine, toetamine, esmane rakendamine ja hindamine ning rakendamise ja hindamise koordineerimine; ettepanekute tegemine ja osalemine eri valdkondade poliitika, strateegiate ja arengukavade koostamisel ja elluviimisel; riiklike ja välisrahastusel põhinevate programmide väljatöötamine ja neis osalemine, nende koordineerimine ja elluviimine, strateegiate rakendamiseks vajalike tegevuskavade väljatöötamine ja elluviimine; ekspertabi osutamine rahvastiku tervise- ja sotsiaalkaitse küsimustes; osalemine riiklikus ja rahvusvahelises teadus- ja arendustegevuses; asutuse põhitegevusega seotud valdkondades riigi esindamine Euroopa Liidu ja rahvusvahelistes organisatsioonides, töörühmades, võrgustikes ja komiteedes; spetsialistide teadmiste ja oskuste arendamine ja koolituste korraldamine asutuse põhitegevusega seotud valdkondades; meditsiiniterminoloogia ning tervishoiu-, rahvatervishoiu- ja sotsiaalvaldkonna terminoloogia arendamine; klassifikaatori omanikuna klassifikaatori arendamise, juurutamise ja semantilise koosvõime eest vastutamine; muude ministeeriumi või TAI teadusnõukogu antud ülesannete täitmine.",
      "rdfs:label": {
        "@value": "Reg_1058406_Par_7 (redaktsioon 1058406)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058406",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058406",
      "estleg:sourceAct": "Tervise Arengu Instituudi põhimäärus",
      "estleg:provisionRef": "Reg_1058406 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058406_Map"
      }
    },
