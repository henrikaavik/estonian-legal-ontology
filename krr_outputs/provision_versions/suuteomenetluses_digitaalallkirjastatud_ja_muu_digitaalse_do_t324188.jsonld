      }
    },
    {
      "@id": "estleg:Reg_324188_Par_5_v324188",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324188_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-02-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Menetleja edastab digitaalse dokumendi teisele menetlejale e-toimiku süsteemi kaudu. Menetleja edastab digitaalse dokumendi teisele menetlejale e-toimiku süsteemi kaudu. 2 (2) Kui e-toimiku süsteemi kaudu ei ole dokumendi edastamine võimalik, edastatakse dokument vahetult või elektronpostiga. Kui e-toimiku süsteemi kaudu ei ole dokumendi edastamine võimalik, edastatakse dokument vahetult või elektronpostiga.",
