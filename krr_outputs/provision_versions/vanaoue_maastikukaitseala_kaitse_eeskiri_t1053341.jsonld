    {
      "@id": "estleg:Reg_1053341_Par_1_v1053341",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053341_Par_1"
