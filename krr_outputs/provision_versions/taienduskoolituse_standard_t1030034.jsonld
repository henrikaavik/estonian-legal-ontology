      "estleg:sourceAct": "Täienduskoolituse standard",
      "estleg:provisionRef": "Reg_1030034 § 3_3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030034_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030034_Par_4_v1030034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030034_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Täienduskoolituse õppekavade liigitamisel lähtutakse käesoleva määruse lisaga kehtestatud õppekavarühmade loetelust, mille aluseks on rahvusvaheline haridus- ja koolitusvaldkondade liigitus International Standard Classification of Education Fields of Education and Training (ISCED-F 2013). RT I 2016-11-11 1 111112016001 2017-01-01 Täienduskoolituse õppekavade liigitamisel lähtutakse käesoleva määruse lisaga kehtestatud õppekavarühmade loetelust, mille aluseks on rahvusvaheline haridus- ja koolitusvaldkondade liigitus International Standard Classification of Education Fields of Education and Training (ISCED-F 2013). 2 (2) Täienduskoolituse õppekavarühmade loetelu esitatakse käesoleva määruse lisas. Täienduskoolituse õppekavarühmade loetelu esitatakse käesoleva määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1030034_Par_4 (redaktsioon 1030034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030034",
      "estleg:sourceAct": "Täienduskoolituse standard",
      "estleg:provisionRef": "Reg_1030034 § 4",
      "estleg:partOfAct": {
