      }
    },
    {
      "@id": "estleg:Reg_1030034_Par_4_5_v1030034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030034_Par_4_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täienduskoolitusasutused võivad jätkata õppetöö läbiviimist täienduskoolituse alustamise hetkel kehtinud õppekavaga ning väljastada selle alusel tunnistused kuni 31. augustini 2025. RT I 2025-04-22 1 122042025001 2025-04-25 Täienduskoolitusasutused võivad jätkata õppetöö läbiviimist täienduskoolituse alustamise hetkel kehtinud õppekavaga ning väljastada selle alusel tunnistused kuni 31. augustini 2025.",
