      "estleg:provisionRef": "Reg_1058855 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058855_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058855_Par_5_v1058855",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
