      "estleg:versionValidFrom": {
        "@value": "2009-10-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksuse toimingu või otsuse peale võib esitada vaide rakendusasutusele vastavalt «Perioodi 2007–2013 struktuuritoetuse seaduse» § 34 lõikele 3. Vaie vaadatakse läbi «Haldusmenetluse seaduses» sätestatud korras. Rakendusüksuse toimingu või otsuse peale võib esitada vaide rakendusasutusele vastavalt «Perioodi 2007–2013 struktuuritoetuse seaduse» § 34 lõikele 3. Vaie vaadatakse läbi «Haldusmenetluse seaduses» sätestatud korras.",
      "rdfs:label": {
