    {
      "@id": "estleg:Reg_324421_Par_16_v324421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324421_Par_16"
      },
      "estleg:versionValidFrom": {
