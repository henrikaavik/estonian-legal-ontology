      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Abipolitseinikule ja abipolitseiniku kandidaadile lisapuhkuse ning selle eest makstava hüvitise taotlemise ja väljamaksmise kord ning kriisirolliga abipolitseinikule kriisi lahendamises osalemise eest makstava hüvitise ulatus ning selle taotlemise ja väljamaksmise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Abipolitseinikule ja abipolitseiniku kandidaadile lisapuhkuse ning selle eest makstava hüvitise taotlemise ja väljamaksmise kord ning kriisirolliga abipolitseinikule kriisi lahendamises osalemise eest makstava hüvitise ulatus ning selle taotlemise ja väljamaksmise kord"
    },
    {
      "@id": "estleg:Reg_1057438_Par_1_v1057438",
      "@type": [
