      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tasustamata lisapuhkuse saamiseks esitab abipolitseinik või abipolitseiniku kandidaat tööandjale Politsei- ja Piirivalveameti peadirektori või tema volitatud isiku kirjaliku taotluse, milles märgitakse: 1 1) tööandja nimi ja registrikood; 2 2) abipolitseiniku või abipolitseiniku kandidaadi ees- ja perekonnanimi ning isikukood; 3 3) tasustamata lisapuhkuse aeg ja eesmärk. Tasustamata lisapuhkuse saamiseks esitab abipolitseinik või abipolitseiniku kandidaat tööandjale Politsei- ja Piirivalveameti peadirektori või tema volitatud isiku kirjaliku taotluse, milles märgitakse: tööandja nimi ja registrikood; abipolitseiniku või abipolitseiniku kandidaadi ees- ja perekonnanimi ning isikukood; tasustamata lisapuhkuse aeg ja eesmärk.",
      "rdfs:label": {
        "@value": "Reg_1057438_Par_1 (redaktsioon 1057438)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057438",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057438",
      "estleg:sourceAct": "Abipolitseinikule ja abipolitseiniku kandidaadile lisapuhkuse ning selle eest makstava hüvitise taotlemise ja väljamaksmise kord ning kriisirolliga abipolitseinikule kriisi lahendamises osalemise eest makstava hüvitise ulatus ning selle taotlemise ja väljamaksmise kord",
      "estleg:provisionRef": "Reg_1057438 § 1",
