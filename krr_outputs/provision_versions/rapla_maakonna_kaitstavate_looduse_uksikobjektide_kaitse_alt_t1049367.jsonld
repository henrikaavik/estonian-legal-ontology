      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Rapla maakonna kaitstavate looduse üksikobjektide kaitse alt väljaarvamine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Rapla maakonna kaitstavate looduse üksikobjektide kaitse alt väljaarvamine"
    },
    {
      "@id": "estleg:Reg_1049367_Par_1_v1049367",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049367_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitstavate loodusobjektide hävimise või nende looduskaitseväärtuse kadumise tõttu arvatakse kaitse alt välja järgmised Rapla maakonnas asuvad kaitstavad looduse üksikobjektid: 1 1) Angerja põlispuud (KLO4000563)1; 2 2) ENSV TA Geoloogia Instituudi rändkivide kollektsioon (Mardi rändrahnud) (KLO4001047); 3 3) Ilmandu-Sepa pärn (KLO4000348); 4 4) Juuru saar (KLO4000198); 5 5) Lõhkisekivi mäe kivikülv (KLO4000528); 6 6) Peetri mägimännid (KLO4000568); 7 7) Pipra põlispuud (KLO4000571); 8 8) Pühajõe allikas (KLO4000554); 9 9) Ranga kadakas (KLO4000324); 10 10) Rapla orjakivi (KLO4000585); 11 11) Siimu-Miku pärn (KLO4000243); 12 12) Tuberiku vaher (KLO4000580). Kaitstavate loodusobjektide hävimise või nende looduskaitseväärtuse kadumise tõttu arvatakse kaitse alt välja järgmised Rapla maakonnas asuvad kaitstavad looduse üksikobjektid: Angerja põlispuud (KLO4000563)1; ENSV TA Geoloogia Instituudi rändkivide kollektsioon (Mardi rändrahnud) (KLO4001047); Ilmandu-Sepa pärn (KLO4000348); Juuru saar (KLO4000198); Lõhkisekivi mäe kivikülv (KLO4000528); Peetri mägimännid (KLO4000568); Pipra põlispuud (KLO4000571); Pühajõe allikas (KLO4000554); Ranga kadakas (KLO4000324); Rapla orjakivi (KLO4000585); Siimu-Miku pärn (KLO4000243); Tuberiku vaher (KLO4000580).",
      "rdfs:label": {
        "@value": "Reg_1049367_Par_1 (redaktsioon 1049367)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049367",
