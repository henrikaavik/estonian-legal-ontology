    {
      "@id": "estleg:Reg_1043851_Par_2_v1043851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043851_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruses kasutatakse termineid järgmises tähenduses: 1 1) hukkunu – isik, kes suri liiklusõnnetuses saadud vigastuse tagajärjel 30 päeva jooksul pärast liiklusõnnetust; 2 2) vigastatu – isik, kellele liiklusõnnetuses saadud vigastuse või tervisekahjustuse tõttu antakse meditsiinilist esmaabi, määratakse ambulatoorne või statsionaarne ravi. Määruses kasutatakse termineid järgmises tähenduses: hukkunu – isik, kes suri liiklusõnnetuses saadud vigastuse tagajärjel 30 päeva jooksul pärast liiklusõnnetust; vigastatu – isik, kellele liiklusõnnetuses saadud vigastuse või tervisekahjustuse tõttu antakse meditsiinilist esmaabi, määratakse ambulatoorne või statsionaarne ravi.",
      "rdfs:label": {
