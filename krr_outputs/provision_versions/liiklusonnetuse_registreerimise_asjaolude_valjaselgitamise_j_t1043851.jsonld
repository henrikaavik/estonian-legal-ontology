      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politsei- ja Piirivalveamet teavitab raskete liiklusõnnetuste uurimise ekspertkomisjoni, kui ta saab teada nimetatud komisjoni uurimispädevusse kuuluva liiklusõnnetuse toimumisest. Politsei- ja Piirivalveamet teavitab raskete liiklusõnnetuste uurimise ekspertkomisjoni, kui ta saab teada nimetatud komisjoni uurimispädevusse kuuluva liiklusõnnetuse toimumisest.",
      "rdfs:label": {
        "@value": "Reg_1043851_Par_7 (redaktsioon 1043851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043851",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043851",
      "estleg:sourceAct": "Liiklusõnnetuse registreerimise, asjaolude väljaselgitamise ja arvestuse kord ning liiklusõnnetuste andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1043851 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043851_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043851_Par_8_v1043851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043851_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Liiklusõnnetuste andmekogu (edaspidi andmekogu) pidamise eesmärk on tagada riikliku liiklusohutuspoliitika kujundamiseks, samuti liiklusohutusalaseks arendus- ja uurimistööks vajaliku andmestiku olemasolu ja kättesaadavus. Liiklusõnnetuste andmekogu (edaspidi andmekogu) pidamise eesmärk on tagada riikliku liiklusohutuspoliitika kujundamiseks, samuti liiklusohutusalaseks arendus- ja uurimistööks vajaliku andmestiku olemasolu ja kättesaadavus.",
      "rdfs:label": {
