      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet andmekogu pidamise üle teostavad andmekogu vastutav töötleja, Riigi Infosüsteemi Amet ja Andmekaitse Inspektsioon vastavalt õigusaktides sätestatud pädevusele. Järelevalvet andmekogu pidamise üle teostavad andmekogu vastutav töötleja, Riigi Infosüsteemi Amet ja Andmekaitse Inspektsioon vastavalt õigusaktides sätestatud pädevusele.",
      "rdfs:label": {
