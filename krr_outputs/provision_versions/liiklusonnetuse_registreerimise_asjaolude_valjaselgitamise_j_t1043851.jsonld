      "estleg:provisionRef": "Reg_1043851 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043851_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043851_Par_6_v1043851",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043851_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registreerimisele ei kuulu liiklusõnnetus, mis toimus metsa-, põllu-, ehitustöö või muu samalaadse töösoorituse käigus, liiklusõnnetus oli vahetult töösoorituse tagajärg ning töösooritus ei olnud tavapärase liikluse osa. Registreerimisele ei kuulu liiklusõnnetus, mis toimus metsa-, põllu-, ehitustöö või muu samalaadse töösoorituse käigus, liiklusõnnetus oli vahetult töösoorituse tagajärg ning töösooritus ei olnud tavapärase liikluse osa.",
      "rdfs:label": {
