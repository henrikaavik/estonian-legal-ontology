      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Narkootiliste ja psühhotroopsete ainete seadus (36 versiooni)",
        "@language": "et"
      },
      "dc:source": "Narkootiliste ja psühhotroopsete ainete seadus"
    },
    {
      "@id": "estleg:narkootiliste_ja_psuhhotroopsete_ainete_seadus_Par_1_v73726",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:narkootiliste_ja_psuhhotroopsete_ainete_seadus_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega reguleeritakse: narkootiliste ja psühhotroopsete ainete ning nende valmistamiseks kasutatavate ainete (edaspidi lähteained) nimekirjade koostamise ja kinnitamise korda; narkootiliste, psühhotroopsete ja lähteainete käitlemise korda; narkootiliste, psühhotroopsete ja lähteainete kontrolli ning identifitseerimise korda, samuti narkootiliste, psühhotroopsete ja lähteainete käitlemiseks vajalike lubade väljastamise korda ning kontrolli selle täitmise üle; narkootiliste, psühhotroopsete ja lähteainetega seotud informatsiooni ning aruandluse korda; narkomaania leviku tõkestamise, narkomaanide ravi ja rehabilitatsiooni korda.",
      "rdfs:label": {
        "@value": "narkootiliste_ja_psuhhotroopsete_ainete_seadus_Par_1 (redaktsioon 73726)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "73726",
      "estleg:supersededByVersion": {
