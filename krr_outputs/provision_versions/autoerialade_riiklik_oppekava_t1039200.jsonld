        "@id": "estleg:Reg_1039200_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039200_Par_11_v1039200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039200_Par_11"
      },
