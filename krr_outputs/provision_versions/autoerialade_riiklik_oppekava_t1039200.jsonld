      },
      "estleg:versionText": "Käesoleva määruse § 10 lõikes 2 nimetatud moodulite õpiväljundite saavutamisel omandatakse kutsele „Autoplekksepp, tase 4” vastavad kompetentsid. RT I 2022-08-26 20 126082022020 2022-08-29 Käesoleva määruse § 10 lõikes 2 nimetatud moodulite õpiväljundite saavutamisel omandatakse kutsele „Autoplekksepp, tase 4” vastavad kompetentsid.",
      "rdfs:label": {
        "@value": "Reg_1039200_Par_11 (redaktsioon 1039200)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039200",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039200",
      "estleg:sourceAct": "Autoerialade riiklik õppekava",
      "estleg:provisionRef": "Reg_1039200 § 11",
      "estleg:partOfAct": {
