      "estleg:provisionRef": "Reg_1030247 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030247_Map"
      }
    },
    {
      "@id": "estleg:Reg_1030247_Par_14_v1030247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030247_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist elektriohutusseaduse alusel tehtud tehnilist kontrolli loetakse käesoleva määruse tähenduses auditiks. Kui järgmise tehnilise kontrolli tähtaeg on määratud tehnilise kontrolli dokumentatsioonis ja see erineb käesolevas määruses sätestatust, kohaldatakse tehnilise kontrolli dokumentatsioonis olevat tähtaega. Enne käesoleva määruse jõustumist elektriohutusseaduse alusel tehtud tehnilist kontrolli loetakse käesoleva määruse tähenduses auditiks. Kui järgmise tehnilise kontrolli tähtaeg on määratud tehnilise kontrolli dokumentatsioonis ja see erineb käesolevas määruses sätestatust, kohaldatakse tehnilise kontrolli dokumentatsioonis olevat tähtaega.",
      "rdfs:label": {
