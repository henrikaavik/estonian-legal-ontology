      }
    },
    {
      "@id": "estleg:Reg_1030247_Par_13_v1030247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030247_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erakorraline audit tehakse vastavalt vajadusele ja selle ulatuse ja kontrollimisel aluseks võetavad normdokumendid määrab tellija. Erakorraline audit tehakse vastavalt vajadusele ja selle ulatuse ja kontrollimisel aluseks võetavad normdokumendid määrab tellija. 2 (2) Kontrollimeetodite ning mõõtmiste vajaduse üle otsustab auditi tegija. Kontrollimeetodite ning mõõtmiste vajaduse üle otsustab auditi tegija. 3 (3) Kui kasutuses olev teise või kolmanda liigi elektripaigaldis muutub lisandunud ohu tõttu esimese liigi elektripaigaldiseks, tehakse sellele elektripaigaldisele erakorraline audit. Erakorralise auditi ulatus ja kontrollimise aluseks võetavad normdokumendid peavad hõlmama vähemalt lisandunud ohust tingitud elektriohutusnõudeid. RT I 2024-01-05 7 105012024007 2024-01-08 Kui kasutuses olev teise või kolmanda liigi elektripaigaldis muutub lisandunud ohu tõttu esimese liigi elektripaigaldiseks, tehakse sellele elektripaigaldisele erakorraline audit. Erakorralise auditi ulatus ja kontrollimise aluseks võetavad normdokumendid peavad hõlmama vähemalt lisandunud ohust tingitud elektriohutusnõudeid.",
      "rdfs:label": {
        "@value": "Reg_1030247_Par_13 (redaktsioon 1030247)",
        "@language": "et"
      },
