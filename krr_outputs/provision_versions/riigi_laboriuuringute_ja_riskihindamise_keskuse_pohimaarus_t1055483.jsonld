      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055483",
      "estleg:sourceAct": "Riigi Laboriuuringute ja Riskihindamise Keskuse põhimäärus",
      "estleg:provisionRef": "Reg_1055483 § 8",
      "estleg:partOfAct": {
