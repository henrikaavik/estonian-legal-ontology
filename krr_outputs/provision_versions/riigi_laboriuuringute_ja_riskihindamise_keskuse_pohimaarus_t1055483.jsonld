      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskus asub Tartus ja selle postiaadress on Fr. R. Kreutzwaldi 30, Tartu, 51006. Keskuse mujal asuva struktuuriüksuse asukoht ja postiaadress märgitakse struktuuriüksuse põhimääruses. Keskus asub Tartus ja selle postiaadress on Fr. R. Kreutzwaldi 30, Tartu, 51006. Keskuse mujal asuva struktuuriüksuse asukoht ja postiaadress märgitakse struktuuriüksuse põhimääruses.",
      "rdfs:label": {
        "@value": "Reg_1055483_Par_3 (redaktsioon 1055483)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055483",
