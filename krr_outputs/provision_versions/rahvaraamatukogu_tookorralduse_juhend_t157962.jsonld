      "estleg:versionText": "§ 7. Teavikute laadid ja nende arvestus",
      "rdfs:label": {
        "@value": "Reg_157962_Par_7 (redaktsioon 157962)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157962",
