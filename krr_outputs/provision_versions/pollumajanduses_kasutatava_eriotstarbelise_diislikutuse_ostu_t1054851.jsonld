      },
      "estleg:versionText": "Määrus jõustub 15. novembril 2022. a. Määrus jõustub 15. novembril 2022. a.",
      "rdfs:label": {
        "@value": "Reg_1054851_Par_10 (redaktsioon 1054851)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054851",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054851",
      "estleg:sourceAct": "Põllumajanduses kasutatava eriotstarbelise diislikütuse ostuõiguse andmine",
