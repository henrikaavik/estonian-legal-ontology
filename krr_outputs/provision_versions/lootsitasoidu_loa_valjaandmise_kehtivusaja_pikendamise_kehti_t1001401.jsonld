    {
      "@id": "estleg:Reg_1001401_Par_5_v1001401",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001401_Par_5"
