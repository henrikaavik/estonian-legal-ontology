    {
      "@id": "estleg:Reg_1046455_Par_6_v1046455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046455_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantakse ettevõtja majandustegevuse kohta järgmised üldandmed: 1 1) majandustegevuse seadustiku üldosa seaduse § 15 lõike 1 punktides 1–7 ja § 52 lõikes 2 nimetatud andmed; 2 2) väetiseseaduse § 21 lõikes 2 nimetatud andmed; 3 3) andmed hoolsuskohustuse täitmise kava kohta. Registrisse kantakse ettevõtja majandustegevuse kohta järgmised üldandmed: majandustegevuse seadustiku üldosa seaduse § 15 lõike 1 punktides 1–7 ja § 52 lõikes 2 nimetatud andmed; väetiseseaduse § 21 lõikes 2 nimetatud andmed; andmed hoolsuskohustuse täitmise kava kohta.",
      "rdfs:label": {
        "@value": "Reg_1046455_Par_6 (redaktsioon 1046455)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046455",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046455",
      "estleg:sourceAct": "Väetiseregistri põhimäärus",
      "estleg:provisionRef": "Reg_1046455 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046455_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046455_Par_7_v1046455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046455_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantakse ettekirjutuse kohta majandustegevuse seadustiku üldosa seaduse §-s 54 nimetatud andmed. Registrisse kantakse ettekirjutuse kohta majandustegevuse seadustiku üldosa seaduse §-s 54 nimetatud andmed.",
      "rdfs:label": {
        "@value": "Reg_1046455_Par_7 (redaktsioon 1046455)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046455",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046455",
      "estleg:sourceAct": "Väetiseregistri põhimäärus",
      "estleg:provisionRef": "Reg_1046455 § 7",
      "estleg:partOfAct": {
