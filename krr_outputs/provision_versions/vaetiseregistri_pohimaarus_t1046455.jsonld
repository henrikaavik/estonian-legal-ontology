      }
    },
    {
      "@id": "estleg:Reg_1046455_Par_8_v1046455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046455_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettevõtja või ettevõtjaga seotud isiku majandustegevuse keelu kohta kantakse registrisse majandustegevuse seadustiku üldosa seaduse §-s 55 nimetatud andmed. Ettevõtja või ettevõtjaga seotud isiku majandustegevuse keelu kohta kantakse registrisse majandustegevuse seadustiku üldosa seaduse §-s 55 nimetatud andmed.",
      "rdfs:label": {
        "@value": "Reg_1046455_Par_8 (redaktsioon 1046455)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046455",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046455",
      "estleg:sourceAct": "Väetiseregistri põhimäärus",
      "estleg:provisionRef": "Reg_1046455 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046455_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046455_Par_9_v1046455",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046455_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seadusest või kohtulahendist tuleneva ärikeelu või kriminaalasjas jõustunud kohtuotsusega määratud tegutsemiskeelu või ettevõtluskeelu kohta kantakse registrisse iga keelu kohta eraldi majandustegevuse seadustiku üldosa seaduse §-s 56 nimetatud andmed. Seadusest või kohtulahendist tuleneva ärikeelu või kriminaalasjas jõustunud kohtuotsusega määratud tegutsemiskeelu või ettevõtluskeelu kohta kantakse registrisse iga keelu kohta eraldi majandustegevuse seadustiku üldosa seaduse §-s 56 nimetatud andmed.",
      "rdfs:label": {
        "@value": "Reg_1046455_Par_9 (redaktsioon 1046455)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046455",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046455",
      "estleg:sourceAct": "Väetiseregistri põhimäärus",
      "estleg:provisionRef": "Reg_1046455 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046455_Map_2026"
      }
    },
