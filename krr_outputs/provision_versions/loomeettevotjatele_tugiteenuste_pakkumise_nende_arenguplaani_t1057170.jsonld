      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057170_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse võib rahuldada osaliselt ühendmääruse § 9 lõike 1 alusel. Taotluse võib rahuldada osaliselt ühendmääruse § 9 lõike 1 alusel. 2 (2) Taotluse rahuldamise otsuse võib teha kõrvaltingimusega ühendmääruse § 9 lõigetes 2 ja 3 sätestatu alusel. Taotluse rahuldamise otsuse võib teha kõrvaltingimusega ühendmääruse § 9 lõigetes 2 ja 3 sätestatu alusel. 3 (3) Taotluse tingimusliku rahuldamise otsuse põhjal ei teki toetuse saajal õigust toetuse maksetele. Õigus toetusega seotud maksetele tekib toetuse saajal pärast rakendusüksuselt tingimuse saabumise või täitmise tuvastamist toetuse saaja esitatud teabe põhjal, välja arvatud kui teavet on võimalik rakendusüksusel tuvastada infosüsteemist või andmeallikast. Taotluse tingimusliku rahuldamise otsuse põhjal ei teki toetuse saajal õigust toetuse maksetele. Õigus toetusega seotud maksetele tekib toetuse saajal pärast rakendusüksuselt tingimuse saabumise või täitmise tuvastamist toetuse saaja esitatud teabe põhjal, välja arvatud kui teavet on võimalik rakendusüksusel tuvastada infosüsteemist või andmeallikast.",
      "rdfs:label": {
        "@value": "Reg_1057170_Par_22 (redaktsioon 1057170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057170",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057170",
      "estleg:sourceAct": "Loomeettevõtjatele tugiteenuste pakkumise, nende arenguplaanide elluviimise ja ekspordivõimekuse kasvu toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057170 § 22",
