    {
      "@id": "estleg:Reg_1057170_Par_29_v1057170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057170_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantskorrektsiooni otsus tehakse ja toetus tagastatakse ÜSS2021_2027 §-des 28–30 ja ühendmääruse §-des 34–38 sätestatu alusel. Finantskorrektsiooni otsus tehakse ja toetus tagastatakse ÜSS2021_2027 §-des 28–30 ja ühendmääruse §-des 34–38 sätestatu alusel.",
      "rdfs:label": {
        "@value": "Reg_1057170_Par_29 (redaktsioon 1057170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057170",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057170",
      "estleg:sourceAct": "Loomeettevõtjatele tugiteenuste pakkumise, nende arenguplaanide elluviimise ja ekspordivõimekuse kasvu toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057170 § 29",
