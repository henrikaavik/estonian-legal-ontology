    {
      "@id": "estleg:Reg_1057170_Par_27_v1057170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057170_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksus võib peatada toetuse maksmise aluseks olevate dokumentide menetlemise osaliselt või täielikult ühendmääruse §-s 33 sätestatud juhul. Rakendusüksus võib peatada toetuse maksmise aluseks olevate dokumentide menetlemise osaliselt või täielikult ühendmääruse §-s 33 sätestatud juhul.",
      "rdfs:label": {
        "@value": "Reg_1057170_Par_27 (redaktsioon 1057170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057170",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057170",
      "estleg:sourceAct": "Loomeettevõtjatele tugiteenuste pakkumise, nende arenguplaanide elluviimise ja ekspordivõimekuse kasvu toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057170 § 27",
      "estleg:partOfAct": {
