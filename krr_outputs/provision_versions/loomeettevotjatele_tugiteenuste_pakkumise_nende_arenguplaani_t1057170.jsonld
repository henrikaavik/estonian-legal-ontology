      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusasutus on Kultuuriministeerium (edaspidi rakendusasutus). Rakendusasutus on Kultuuriministeerium (edaspidi rakendusasutus). 2 (2) Rakendusüksus on Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi rakendusüksus). Rakendusüksus on Ettevõtluse ja Innovatsiooni Sihtasutus (edaspidi rakendusüksus).",
      "rdfs:label": {
        "@value": "Reg_1057170_Par_5 (redaktsioon 1057170)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057170",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057170",
      "estleg:sourceAct": "Loomeettevõtjatele tugiteenuste pakkumise, nende arenguplaanide elluviimise ja ekspordivõimekuse kasvu toetamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057170 § 5",
