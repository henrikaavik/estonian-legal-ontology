    {
      "@id": "estleg:Reg_1057170_Par_26_v1057170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057170_Par_26"
