      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu vastutaval töötlejal on lubatud talle seadusega pandud ülesannete täitmiseks esitada päringuid ja saada andmeid teistest andmekogudest ning saata § 7 lõike 3 punktis 4 nimetatud andmeid Tallinna Sadama automaatsesse numbrituvastussüsteemi. Andmekogu vastutaval töötlejal on lubatud talle seadusega pandud ülesannete täitmiseks esitada päringuid ja saada andmeid teistest andmekogudest ning saata § 7 lõike 3 punktis 4 nimetatud andmeid Tallinna Sadama automaatsesse numbrituvastussüsteemi.",
      "rdfs:label": {
        "@value": "Reg_1039254_Par_10 (redaktsioon 1039254)",
        "@language": "et"
      },
