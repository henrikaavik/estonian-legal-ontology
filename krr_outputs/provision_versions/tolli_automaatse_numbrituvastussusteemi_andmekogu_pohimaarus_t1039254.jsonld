    {
      "@id": "estleg:Reg_1039254_Par_2_v1039254",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039254_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise eesmärk on transpordivahendite ning kaubakonteinerite liikumise kohta teabe kogumine ja töötlemine riiklike maksude kogumiseks ning rahvusvahelise kaubanduse seaduslikkuse tagamiseks, samuti maksupettuste ja salakaubaveo tõkestamiseks. Andmekogu pidamise eesmärk on transpordivahendite ning kaubakonteinerite liikumise kohta teabe kogumine ja töötlemine riiklike maksude kogumiseks ning rahvusvahelise kaubanduse seaduslikkuse tagamiseks, samuti maksupettuste ja salakaubaveo tõkestamiseks.",
      "rdfs:label": {
        "@value": "Reg_1039254_Par_2 (redaktsioon 1039254)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039254",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039254",
      "estleg:sourceAct": "Tolli automaatse numbrituvastussüsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039254 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039254_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039254_Par_3_v1039254",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039254_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tolli automaatne numbrituvastussüsteem koosneb statsionaarsest või mobiilsest numbrituvastusvahendist, salvestusseadmest ja vajalikest lisaseadmetest, mille abil §-s 7 nimetatud andmeid töödeldakse §-s 2 nimetatud eesmärgil. Tolli automaatne numbrituvastussüsteem koosneb statsionaarsest või mobiilsest numbrituvastusvahendist, salvestusseadmest ja vajalikest lisaseadmetest, mille abil §-s 7 nimetatud andmeid töödeldakse §-s 2 nimetatud eesmärgil.",
      "rdfs:label": {
        "@value": "Reg_1039254_Par_3 (redaktsioon 1039254)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039254",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039254",
      "estleg:sourceAct": "Tolli automaatse numbrituvastussüsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039254 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039254_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039254_Par_4_v1039254",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039254_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordivahendi või kaubakonteineri möödumist numbrituvastusvahendist. Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordivahendi või kaubakonteineri möödumist numbrituvastusvahendist.",
      "rdfs:label": {
        "@value": "Reg_1039254_Par_4 (redaktsioon 1039254)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039254",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039254",
      "estleg:sourceAct": "Tolli automaatse numbrituvastussüsteemi andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039254 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039254_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1039254_Par_5_v1039254",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039254_Par_5"
      },
