        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu vastutav töötleja on Maksu- ja Tolliamet. Andmekogu vastutav töötleja on Maksu- ja Tolliamet.",
      "rdfs:label": {
        "@value": "Reg_1039254_Par_5 (redaktsioon 1039254)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039254",
