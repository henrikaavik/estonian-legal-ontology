    {
      "@id": "estleg:ProvisionVersions_berni_kirjandus_ja_kunstiteoste_kaitse_konventsiooniga_uhinemise_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Berni kirjandus- ja kunstiteoste kaitse konventsiooniga ühinemise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Berni kirjandus- ja kunstiteoste kaitse konventsiooniga ühinemise seadus"
    },
    {
      "@id": "estleg:BKKKKU_Par_1_v24662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:BKKKKU_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taasühinemiseks Berni kirjandus- ja kunstiteoste kaitse 1886. aasta konventsiooniga, mille revideeritud tekstiga ühines Eesti Vabariik 1927. aasta 31. märtsi seaduse (RT 1927, 44, 41) alusel, ühineda juurdelisatud Pariisi 1971. aasta 24. juuli redaktsiooniga (muudatustega 1979. aasta 28. septembrist).",
      "rdfs:label": {
        "@value": "BKKKKU_Par_1 (redaktsioon 24662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24662"
    },
    {
      "@id": "estleg:BKKKKU_Par_2_v24662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:BKKKKU_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Deklareerida, et Berni konventsiooniga kaitstud teost, mis on käesoleva seaduse jõustumise päevaks juba tõlgitud eesti keelde, kuid ei ole veel avaldatud, võib 18 kuu jooksul käesoleva seaduse jõustumisest arvates avaldada või muul viisil sihipäraselt kasutada (lavastada, avalikult esitada, üle kanda raadios või televisioonis) autorile tasu maksmata.",
      "rdfs:label": {
        "@value": "BKKKKU_Par_2 (redaktsioon 24662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24662"
    },
    {
      "@id": "estleg:BKKKKU_Par_3_v24662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:BKKKKU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Deklareerida, et vastavalt käesoleva seaduse §-s 1 nimetatud konventsiooni artiklile 25(4)(a) ja (b) soovib Eesti Vabariik kuuluda oma liikmemaksu suuruse arvestuselt VII klassi.",
      "rdfs:label": {
        "@value": "BKKKKU_Par_3 (redaktsioon 24662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24662"
    }
  ]
}
