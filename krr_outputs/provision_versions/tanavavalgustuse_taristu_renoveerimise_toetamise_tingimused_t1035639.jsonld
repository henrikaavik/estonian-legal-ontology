    {
      "@id": "estleg:Reg_1035639_Par_20_v1035639",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035639_Par_20"
