      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035639",
      "estleg:sourceAct": "Tänavavalgustuse taristu renoveerimise toetamise tingimused",
      "estleg:provisionRef": "Reg_1035639 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035639_Map_2026"
      }
    },
