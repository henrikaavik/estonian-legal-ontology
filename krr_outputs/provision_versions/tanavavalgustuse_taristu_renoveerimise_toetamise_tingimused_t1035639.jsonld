    {
      "@id": "estleg:Reg_1035639_Par_4_v1035639",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035639_Par_4"
