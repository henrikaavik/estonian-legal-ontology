    },
    {
      "@id": "estleg:Reg_1042683_Par_4_v1042683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042683_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas5 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndite piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas5 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndite piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1042683_Par_4 (redaktsioon 1042683)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042683",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042683",
      "estleg:sourceAct": "Uhtju looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042683 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042683_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042683_Par_5_v1042683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042683_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitsealal on lubatud, välja arvatud § 11 punktis 3 sätestatud juhul: 1 1) inimeste viibimine ning marjade, seente ja muude metsa kõrvalsaaduste korjamine; 2 2) ujuvvahendiga sõitmine; 3 3) kalapüük, välja arvatud püük mõrra või võrguga, mille silma suurus ületab 200 mm. Kaitsealal on lubatud, välja arvatud § 11 punktis 3 sätestatud juhul: inimeste viibimine ning marjade, seente ja muude metsa kõrvalsaaduste korjamine; ujuvvahendiga sõitmine; kalapüük, välja arvatud püük mõrra või võrguga, mille silma suurus ületab 200 mm. 2 (2) Kaitseala valitseja nõusolekul on kaitsealal lubatud: 1 1) rajatiste hooldustööd; 2 2) väikekiskjate arvukuse reguleerimine. Kaitseala valitseja nõusolekul on kaitsealal lubatud: rajatiste hooldustööd; väikekiskjate arvukuse reguleerimine.",
      "rdfs:label": {
        "@value": "Reg_1042683_Par_5 (redaktsioon 1042683)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042683",
