    {
      "@id": "estleg:Reg_1042683_Par_17_v1042683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042683_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 14. septembri 2017. a käskkirjaga nr 1-2/17/889 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 14. septembri 2017. a käskkirjaga nr 1-2/17/889 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1042683_Par_17 (redaktsioon 1042683)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042683",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042683",
      "estleg:sourceAct": "Uhtju looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042683 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042683_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042683_Par_18_v1042683",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042683_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1042683_Par_18 (redaktsioon 1042683)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042683",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042683",
      "estleg:sourceAct": "Uhtju looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1042683 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042683_Map"
      }
    },
    {
      "@id": "estleg:Reg_1042683_Par_2_v1042683",
      "@type": [
        "owl:NamedIndividual",
