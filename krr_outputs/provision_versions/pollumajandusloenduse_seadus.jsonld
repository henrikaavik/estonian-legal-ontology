  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_pollumajandusloenduse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Põllumajandusloenduse seadus (31 versiooni)",
        "@language": "et"
      },
      "dc:source": "Põllumajandusloenduse seadus"
    },
    {
      "@id": "estleg:PõLS_Par_1_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab üleriigilise põllumajandusloenduse (edaspidi loendus ) läbiviimise korra.",
      "rdfs:label": {
        "@value": "PõLS_Par_1 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_10_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusringkonnad moodustab Statistikaamet haldusterritoriaalse korralduse alusel. (2) Loendusringkonna tööd juhib loendusringkonna juhataja (edaspidi ringkonnajuhataja ). Ringkonnajuhataja äraolekul asendab teda ringkonnajuhataja asetäitja. (3) Ringkonnajuhataja ja tema asetäitja ülesanne on korraldada loendusringkonna territooriumil loendus ning selle tulemuste põhjal teha loenduseeskirjas sätestatud korras esialgsed kokkuvõtted.",
      "rdfs:label": {
        "@value": "PõLS_Par_10 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_11_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loenduspiirkonnad moodustab Statistikaameti ettepanekul maakonna või linna põllumajandusloenduskomisjon. (2) Loenduspiirkonnad moodustatakse loendusringkonna territooriumil. (3) Loenduspiirkond on loendajate juhendaja tööpiirkond. Loendajate juhendaja ülesanne on loendus ette valmistada ja korraldada loendajate töö loenduspiirkonnas ning selle tulemuste põhjal teha loenduseeskirjas sätestatud korras esialgsed kokkuvõtted.",
      "rdfs:label": {
        "@value": "PõLS_Par_11 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_12_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusjaoskonnad moodustab Statistikaameti ettepanekul maakonna või linna põllumajandusloenduskomisjon. (2) Loendusjaoskond on loendaja tööpiirkond. (3) Loendaja ülesanne on loendusjaoskonnas loendus ette valmistada ja läbi viia ning selle tulemuste põhjal teha loenduseeskirjas sätestatud korras esialgsed kokkuvõtted.",
      "rdfs:label": {
        "@value": "PõLS_Par_12 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_13_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakonna põllumajandusloenduskomisjoni moodustab maavanem hiljemalt üks aasta enne loendusmomenti. (2) Maakonna põllumajandusloenduskomisjoni esimehe ja selle liikmed nimetab maavanem. (3) Maakonna põllumajandusloenduskomisjon kooskõlastab maakonnas loenduse korraldamise kava, koordineerib ja jälgib loenduse korraldamist oma haldusalal ning aitab lahendada loendusega seotud küsimusi. (4) Maakonna põllumajandusloenduskomisjonil on õigus saada maakonnas asuvatelt riigiasutustelt ja kohaliku omavalitsuse asutustelt ning loendusringkondade juhatajatelt oma tegevuseks vajalikku teavet.",
      "rdfs:label": {
        "@value": "PõLS_Par_13 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_14_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Linna põllumajandusloenduskomisjon moodustatakse Tallinnas, Tartus, Pärnus, Kohtla-Järvel ja Narvas. Komisjoni moodustab linnavalitsus vähemalt üks aasta enne loendusmomenti. (2) Linna põllumajandusloenduskomisjoni esimehe ja liikmed nimetab linnavalitsus. (3) Linna põllumajandusloenduskomisjon kooskõlastab linnas loenduse korraldamise kava, koordineerib ja jälgib loenduse korraldamist oma haldusalal ning aitab lahendada loendusega seotud küsimusi. (4) Linna põllumajandusloenduskomisjonil on õigus saada linnas asuvatelt riigiasutustelt ja kohaliku omavalitsuse asutustelt ning loendusringkondade juhatajatelt oma tegevuseks vajalikku teavet.",
      "rdfs:label": {
        "@value": "PõLS_Par_14 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_15_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Statistikaameti ülesanded on: informeerida avalikkust loenduse eesmärkidest, esitatavatest küsimustest ning loenduse läbiviimise korrast ja loendusperioodist; koostada loendusdokumentide ja loenduse abidokumentide vormid ning varustada loendusringkonnad nimetatud dokumentidega; võtta tööle loendustöötajad, neid koolitada ja juhendada ning kontrollida nende tööd; juhendada loenduse korraldamises osalevate põllumajandusloenduskomisjonide ja asutuste tööd; koguda, töödelda, analüüsida, avaldada ja säilitada loendusandmeid; koostada loenduse eelarve ja jälgida selle täitmist; jälgida, et loenduse korraldamisel järgitaks käesolevat seadust. (2) Statistikaamet on loendusandmeid sisaldavate andmekogude vastutav ja volitatud töötleja, kes tagab loendusandmete kaitse nende kogumisel, töötlemisel, kasutamisel ja säilitamisel.",
      "rdfs:label": {
        "@value": "PõLS_Par_15 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_16_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohalik omavalitsus koostöös põllumajandusloenduskomisjonide ja valitsusasutustega tagab loenduse korraldamise oma haldusterritooriumil, sealhulgas: võimaldades kaasata kohaliku omavalitsuse teenistujaid loenduse korraldamisse; osaledes loenduse korraldamiseks vajalike loenduskaartide ning majapidamiste ja kodumajapidamiste nimekirjade koostamisel; täpsustades loenduse eel hoonete numeratsiooni ning majapidamiste ja kodumajapidamiste omanike ja valdajate nimekirja; andes Vabariigi Valitsuse põllumajandusloenduskomisjonile ning maakonna ja linna põllumajandusloenduskomisjonidele loenduse korraldamiseks vajalikku teavet.",
      "rdfs:label": {
        "@value": "PõLS_Par_16 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_17_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendustöötajad on ringkonnajuhataja, tema asetäitja, loendajate juhendaja ja loendaja. (2) Loendustöötaja võetakse teenistusse Statistikaameti peadirektori käskkirjaga määratud ajaks avaliku teenistuse seaduse (RT I 1995, 16, 228; 1999, 7, 112; 10, 155; 16, 271 ja 276; 2000, 25, 144 ja 145; 28, 167) § 8 alusel. Loendustöötajaid võidakse tööle võtta ka tööettevõtulepinguga. (3) Loendustöötaja ametikohustused, kvalifikatsiooninõuded ning koolituse ja atesteerimise korra kehtestab Statistikaameti peadirektor. (4) Loendustöötajana võib töötada vähemalt 18-aastane isik, kes vastab Statistikaameti kehtestatud kvalifikatsiooninõuetele ja on läbinud loendustööks vajaliku koolituse. (5) Loendustöötaja volitusi tõendab Statistikaameti väljaantud kehtiv loendaja pildiga töötõend. (6) Loendustöötajana võidakse teenistusse võtta ka teise tööandja juures töötav isik tööandja kirjalikul nõusolekul. (7) Loendustöötajate töö tasustamise ning kulude hüvitamise korra ja määrad kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "PõLS_Par_17 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_18_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loenduse korraldamisel on riigi ja kohalike omavalitsuste andmekogude pidajad kohustatud Statistikaameti nõudmisel esitama riigi ja kohalike omavalitsuste andmekogudes olevaid loenduse korraldamiseks vajalikke andmeid kooskõlas isikuandmete kaitse seaduse (RT I 1996, 48, 944; 1998, 59, 941; 111, 1833) ja andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155) ning nende alusel kehtestatud õigusaktidega.",
      "rdfs:label": {
        "@value": "PõLS_Par_18 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961",
      "estleg:supersededByVersion": {
        "@id": "estleg:PõLS_Par_18_v12825178"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PõLS_Par_18_v12825178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loenduse korraldamisel on riigi ja kohalike omavalitsuste andmekogude pidajad kohustatud Statistikaameti nõudmisel esitama riigi ja kohalike omavalitsuste andmekogudes olevaid loenduse korraldamiseks vajalikke andmeid kooskõlas isikuandmete kaitse seaduse, avaliku teabe seaduse ning nende alusel kehtestatud õigusaktidega.",
      "rdfs:label": {
        "@value": "PõLS_Par_18 (redaktsioon 12825178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825178"
    },
    {
      "@id": "estleg:PõLS_Par_19_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Küsitletavat isikut küsitletakse tema elukohas või majapidamise või kodumajapidamise asukohas. (2) Loendaja esitab küsitletavale isikule oma volitusi tõendava dokumendi. (3) Loendaja küsitleb küsitletavat isikut vahetult. Loendusega kogutavad andmed kannab loendaja loenduslehtedele vastavuses loenduseeskirjaga. (4) Loendajal ja loendajate juhendajal on õigus küsitletava isiku elukohas loendust ja järelküsitlust teostada kella 8.00-st kuni 22.00-ni. (5) Loenduslehed on eestikeelsed ja täidetakse eesti keeles. (6) Küsitletaval isikul on õigus anda loendajale vastuseid eesti keele mittevaldamise korral mõnes muus keeles, mida ta valdab. (7) Kui loendaja ei valda küsitletava isiku poolt kasutatavat keelt, on loendajal õigus kasutada tõlgi abi. (8) Loendamisel osalevale tõlgile laienevad käesoleva seaduse § 23 lõikes 1 ja §-s 26 sätestatud kohustused.",
      "rdfs:label": {
        "@value": "PõLS_Par_19 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_2_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seaduses kasutatakse mõisteid järgmises tähenduses: loendusmoment – loendusperioodi alguskuupäeva kellaaeg 00.00, milleks ajastatakse loendusega kogutavad andmed; loendusperiood – ajavahemik, mille kestel kogutakse loendusandmeid; järelküsitlusperiood – ajavahemik loendusandmete kontrollimiseks korraldatava väljavõttelise järelküsitluse läbiviimiseks; loendusandmed – loendusel kogutavad andmed; loendustulemused – loendusandmete töötluse koondandmed ja nende põhjal tehtud põllumajanduslike tootmisüksuste struktuuri analüüs; küsitletav isik – majapidamise või kodumajapidamise valdaja või tema esindaja.",
      "rdfs:label": {
        "@value": "PõLS_Par_2 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_20_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Küsitletav isik on kohustatud andma tõeseid ja täielikke vastuseid kõigile loenduslehtedel esitatud küsimustele. (2) Küsitletaval isikul on õigus tutvuda tema majapidamise või kodumajapidamise kohta täidetud loenduslehtedega.",
      "rdfs:label": {
        "@value": "PõLS_Par_20 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_21_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loendusandmeid kasutatakse üksnes statistilistel eesmärkidel.",
      "rdfs:label": {
        "@value": "PõLS_Par_21 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_22_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusandmeid säilitab Statistikaamet. Loendusandmed salvestatakse magnetkandjatele, mida säilitatakse Statistikaameti arhiivis. (2) Loenduslehti säilitatakse kuni järgmise loenduse lõpuni vastavalt andmekogude seadusele ning arhiveerimist sätestavatele õigusaktidele.",
      "rdfs:label": {
        "@value": "PõLS_Par_22 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961",
      "estleg:supersededByVersion": {
        "@id": "estleg:PõLS_Par_22_v12825178"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PõLS_Par_22_v12825178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusandmeid säilitab Statistikaamet. Loendusandmed salvestatakse magnetkandjatele, mida säilitatakse Statistikaameti arhiivis. (2) Loenduslehti säilitatakse kuni järgmise loenduse lõpuni vastavalt avaliku teabe seadusele ning arhiveerimist sätestavatele õigusaktidele.",
      "rdfs:label": {
        "@value": "PõLS_Par_22 (redaktsioon 12825178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825178"
    },
    {
      "@id": "estleg:PõLS_Par_23_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusandmed on konfidentsiaalsed. Neid ei avalikustata ega anta üle kolmandatele isikutele. Loendaja on kohustatud pidama tähtajatult saladuses ka loendamisel teatavaks saanud muid andmeid. (2) Loendusandmete kaitse korraldamisel juhindutakse isikuandmete kaitse seadusest, andmekogude seadusest ja riikliku statistika seadusest (RT I 1997, 51, 822).",
      "rdfs:label": {
        "@value": "PõLS_Par_23 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961",
      "estleg:supersededByVersion": {
        "@id": "estleg:PõLS_Par_23_v12825178"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PõLS_Par_23_v12825178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusandmed on konfidentsiaalsed. Neid ei avalikustata ega anta üle kolmandatele isikutele. Loendaja on kohustatud pidama tähtajatult saladuses ka loendamisel teatavaks saanud muid andmeid. (2) Loendusandmete kaitse korraldamisel juhindutakse isikuandmete kaitse seadusest, avaliku teabe seadusest ja riikliku statistika seadusest (RT I 1997, 51, 822).",
      "rdfs:label": {
        "@value": "PõLS_Par_23 (redaktsioon 12825178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825178"
    },
    {
      "@id": "estleg:PõLS_Par_24_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet isikuandmete kaitse nõuetest kinnipidamise üle loenduse läbiviimisel korraldab Andmekaitse Inspektsioon.",
      "rdfs:label": {
        "@value": "PõLS_Par_24 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_25_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendustulemused on avalikud ja kõigile kättesaadavad. (2) Esialgsed loenduse kokkuvõtted avaldab Statistikaamet hiljemalt üheksakümnendal päeval järelküsitluse lõppemisest arvates. Loendustulemused statistiliste tabelitena avaldab Statistikaamet kahe aasta jooksul pärast loendusperioodi lõppemist. (3) Loendustulemusi võib avaldada või edastada ainult sellisel kujul, mis välistab majapidamise ja kodumajapidamise otsese või kaudse identifitseerimise. (4) Valitsusasutuse, kohaliku omavalitsuse asutuse või juriidilise või füüsilise isiku taotlusel võib Statistikaamet andmekaitse nõudeid arvestades koostada taotleja kulul selliseid statistilisi tabeleid, mis ei kuulu kehtestatud statistiliste tabelite nimistusse.",
      "rdfs:label": {
        "@value": "PõLS_Par_25 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_26_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loendustöötaja ja loendusandmete töötleja võetakse käesolevas seaduses, isikuandmete kaitse seaduses ja andmekogude seaduses sätestatud nõuete rikkumise eest haldus- või kriminaalvastutusele seadusega sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "PõLS_Par_26 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961",
      "estleg:supersededByVersion": {
        "@id": "estleg:PõLS_Par_26_v12825178"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PõLS_Par_26_v12825178",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loendustöötaja ja loendusandmete töötleja võetakse käesolevas seaduses, isikuandmete kaitse seaduses ja avaliku teabe seaduses sätestatud nõuete rikkumise eest haldus- või kriminaalvastutusele seadusega sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "PõLS_Par_26 (redaktsioon 12825178)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825178"
    },
    {
      "@id": "estleg:PõLS_Par_27_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loendusega kogutavate andmete esitamise ja edastamise korra rikkumise eest kohaldatakse haldusõiguserikkumiste seadustiku (RT 1992, 29, 396; RT I 1999, 41, 496; 45, õiend; 58, 608; 60, 616; 87, 792; 92, 825; 95, 843; 2000, 10, 58; 25, 141; 28, 167; 29, 169) §-s 183 ja riikliku statistika seaduses sätestatud karistusi.",
      "rdfs:label": {
        "@value": "PõLS_Par_27 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_3_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loenduse objektiks on põllumajanduslik majapidamine ja põllumajanduslik kodumajapidamine. (2) Põllumajanduslik majapidamine (edaspidi majapidamine ) on ühtse majandusliku ja tehnilise juhtimisega tootmisüksus, mille põhitegevusala on põllumajandus ja kus: on vähemalt üks hektar põllumajandus- või metsamaad või 0,3 hektarit kalatiike või on vähem kui üks hektar põllumajandus- või metsamaad või 0,3 hektarit kalatiike või see puudub ja kus toodetakse põllumajandussaadusi peamiselt (üle poole) müügiks. (3) Põllumajanduslik kodumajapidamine (edaspidi kodumajapidamine ) on majandusüksus, kus on vähem kui üks hektar põllumajandus- või metsamaad või see puudub ja kus toodetakse põllumajandussaadusi peamiselt (üle poole) oma tarbeks ning kus on vähemalt kas: 50 ruutmeetrit köögiviljamaad või kolm viljapuud või kuus marjapõõsast või 10 küülikut, 10 kodulindu või teisi põllumajandusloomi või kolm mesipuud.",
      "rdfs:label": {
        "@value": "PõLS_Par_3 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_4_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loenduse eesmärk on saada: andmeid loenduse objektide majandustegevuse ja majandusseisundi, tootmise tüübi, peamiste sissetulekuallikate, tootmisressursside, asukoha, õigusliku seisundi, juhtimise ja juhtide kohta; koondandmeid majapidamiste põllumajandusliku tegevuse põhinäitajate dünaamika analüüsimiseks loendustevahelisel ajal; koondandmeid haldusüksuste põllumajandusliku seisundi kohta; andmeid statistiliste vaatluste valimite moodustamiseks.",
      "rdfs:label": {
        "@value": "PõLS_Par_4 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_5_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loenduse põhikorraldaja on Statistikaamet. (2) Loenduse korraldamisel tekkivate probleemide lahendamiseks moodustatakse asjatundjate komisjonina Vabariigi Valitsuse põllumajandusloenduskomisjon. (3) Vähemalt üks aasta enne loendusmomenti moodustatakse käesoleva seaduse alusel maakondade ja linnade põllumajandusloenduskomisjonid. (4) Kohalikud omavalitsused täidavad loenduse korraldamisel käesoleva seadusega sätestatud kohustusi. (5) Loenduse korraldamist finantseeritakse riigieelarvest. (6) Loendusmomendi, loendusperioodi ja järelküsitlusperioodi (7) Järgmine loendus korraldatakse hiljemalt kümne aasta möödumisel viimasest loendusest.",
      "rdfs:label": {
        "@value": "PõLS_Par_5 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_6_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loenduse käigus kogutavad andmed loenduse objekti kohta on järgmised: asukoht; nimi ja äriregistri kood; omaniku liik; valdaja ja juhi ees- ja perekonnanimi, isikukood, elukoht, põllumajandusliku ettevalmistuse tase; omandis oleva ja renditud maa suurus; maakasutus; sissetulek majapidamisest tegevusalati; loomade arv; traktorid, masinad ja seadmed; hoidlad ja loomakasvatushooned; tööjõud; puistute varu; metsaraie- ja metsauuendustööd; metsatöötlusmasinad ja -seadmed, metsateed; paadid ja kalapüügivahendid.",
      "rdfs:label": {
        "@value": "PõLS_Par_6 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_7_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loendusdokumendid on loendusleht, loenduseeskiri, loenduskaart ja loendustulemuste tabel. (2) Loendusleht on loendusandmete kogumise küsimustik. (3) Loenduseeskiri sisaldab loenduslehe täitmise, loenduse korraldamise ning kokkuvõtete tegemise selgitusi. (4) Loenduskaart on loenduse jaoks kohandatud tihe- ja hajaasustusalade kaart digitaalkujul ja paberil. (5) Loenduse korraldamisel kasutatakse järgmisi abidokumente: juhendeid, nimestikke, aruandevorme, tõendeid ja teatisi. (6) Loendusandmete töötlemisel ja tulemuste avaldamisel kasutatakse riiklikke standardeid ja klassifikaatoreid.",
      "rdfs:label": {
        "@value": "PõLS_Par_7 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_8_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loenduseeskirja ja loenduslehe vormi määrusega hiljemalt üks aasta enne loendusmomenti. (2) Loendustulemuste tabelite vormid kinnitab rahandusminister määrusega. (3) Loenduse abidokumentide vormid kinnitab Statistikaameti peadirektor.",
      "rdfs:label": {
        "@value": "PõLS_Par_8 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    },
    {
      "@id": "estleg:PõLS_Par_9_v71961",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PõLS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Loenduse organisatsiooniline korraldus põhineb kehtival haldusterritoriaalsel korraldusel. (2) Loenduse korraldamiseks moodustatakse loendustöötajatele kehtestatud koormusnormide alusel loendusringkonnad, loenduspiirkonnad ja loendusjaoskonnad. (3) Loendustöötajate koormusnormid kehtestab rahandusminister määrusega.",
      "rdfs:label": {
        "@value": "PõLS_Par_9 (redaktsioon 71961)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "71961"
    }
  ]
}
