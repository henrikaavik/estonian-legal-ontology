      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:EUKKEEUEVSEV_Par_11_v693762",
      "@type": [
        "owl:NamedIndividual",
