      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui toetuse saaja ei nõustu tehtud otsuse või temale tehtud ettekirjutusega, on tal õigus esitada selle peale kaebus Ameti peadirektorile või vaidlustada ettekirjutus halduskohtus vastavalt halduskohtumenetluse seadustikule (RT I 1999, 31, 425; 2000, 51, 321).",
      "rdfs:label": {
        "@value": "EUKKEEUEVSEV_Par_10 (redaktsioon 27012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27012",
