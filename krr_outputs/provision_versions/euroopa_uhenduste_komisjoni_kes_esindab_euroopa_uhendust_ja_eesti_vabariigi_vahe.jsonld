      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Euroopa Ühenduste Komisjoni, kes esindab Euroopa Ühendust, ja Eesti Vabariigi vahel sõlmitud Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi mitmeaastase rahastuslepingu ratifitseerimise seadus (34 versiooni)",
        "@language": "et"
      },
      "dc:source": "Euroopa Ühenduste Komisjoni, kes esindab Euroopa Ühendust, ja Eesti Vabariigi vahel sõlmitud Eesti Vabariigis põllumajanduse ja maaelu arendamise liitumiseelse programmi mitmeaastase rahastuslepingu ratifitseerimise seadus"
    },
    {
      "@id": "estleg:EUKKEEUEVSEV_Par_1_v27012",
      "@type": [
