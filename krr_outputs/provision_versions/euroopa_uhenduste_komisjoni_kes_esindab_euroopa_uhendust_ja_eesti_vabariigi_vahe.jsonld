      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud (edaspidileping), mis on alla kirjutatud 2001. aasta 25. jaanuaril Brüsselis.",
      "rdfs:label": {
        "@value": "EUKKEEUEVSEV_Par_1 (redaktsioon 27012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27012"
    },
    {
      "@id": "estleg:EUKKEEUEVSEV_Par_10_v27012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
