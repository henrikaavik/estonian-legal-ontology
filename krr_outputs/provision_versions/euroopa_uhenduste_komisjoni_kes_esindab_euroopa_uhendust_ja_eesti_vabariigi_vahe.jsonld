    {
      "@id": "estleg:EUKKEEUEVSEV_Par_11_v27012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EUKKEEUEVSEV_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduse ja maaelu arendamise programmi raames antava toetuse tagasinõudmise ja tagasimaksmise korra kehtestab Vabariigi Valitsus vastavalt lepingule, lähtudes käesoleva seaduse §-dest 6–10.",
      "rdfs:label": {
        "@value": "EUKKEEUEVSEV_Par_11 (redaktsioon 27012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27012",
      "estleg:supersededByVersion": {
