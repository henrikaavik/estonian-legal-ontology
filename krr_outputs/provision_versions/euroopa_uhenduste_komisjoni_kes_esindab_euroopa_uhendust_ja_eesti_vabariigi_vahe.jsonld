      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajanduse ja maaelu arendamise programmi raames antava vastavalt lepingule, lähtudes käesoleva seaduse §-dest 6–10.",
      "rdfs:label": {
        "@value": "EUKKEEUEVSEV_Par_11 (redaktsioon 693762)",
