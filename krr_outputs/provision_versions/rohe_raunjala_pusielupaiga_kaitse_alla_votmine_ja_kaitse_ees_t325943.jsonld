    {
      "@id": "estleg:Reg_325943_Par_4_v325943",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325943_Par_4"
