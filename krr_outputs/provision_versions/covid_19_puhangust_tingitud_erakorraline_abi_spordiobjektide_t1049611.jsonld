    {
      "@id": "estleg:Reg_1049611_Par_13_v1049611",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1049611_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andjal on õigus nõuda toetuse saajalt toetuse sihipärase kasutamise kohta aruannet. Toetuse andjal on õigus nõuda toetuse saajalt toetuse sihipärase kasutamise kohta aruannet.",
      "rdfs:label": {
        "@value": "Reg_1049611_Par_13 (redaktsioon 1049611)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049611",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1049611",
      "estleg:sourceAct": "COVID-19 puhangust tingitud erakorraline abi spordiobjektide valdajate toetamiseks",
      "estleg:provisionRef": "Reg_1049611 § 13",
      "estleg:partOfAct": {
