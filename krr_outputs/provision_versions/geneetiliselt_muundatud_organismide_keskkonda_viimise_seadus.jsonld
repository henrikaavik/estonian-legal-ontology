        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnaamet võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 45, 46, 49, 50, 51, 52 ja 53 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras. (2) Põllumajandus- ja Toiduamet võib käitlemise nõuete täitmise üle riikliku järelevalve teostamisel kohaldada korrakaitseseaduse §-des 30, 49, 50, 51 ja 52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "GMOVS_Par_31_1 (redaktsioon 110072020045)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110072020045"
    },
    {
      "@id": "estleg:GMOVS_Par_31_2_v114032014023",
