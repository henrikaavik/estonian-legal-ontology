      }
    },
    {
      "@id": "estleg:GMOVS_Par_30_v13197326",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMOVS_Par_30"
      },
      "estleg:versionValidFrom": {
