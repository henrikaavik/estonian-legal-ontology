    },
    {
      "@id": "estleg:GMOVS_Par_37_v742762",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GMOVS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnamõju hindamise ja keskkonnaauditeerimise seaduses (RT I 2000, 54, 348; 2002, 61, 375; 63, 387; 90, 521; 99, 579) tehakse järgmised muudatused: paragrahvi 6 lõike 2 punkt 33 tunnistatakse kehtetuks; paragrahvi 8 punkt 2 muudetakse ja sõnastatakse järgmiselt: «2) kaevandamisluba, vee erikasutusluba, välisõhu saasteluba või jäätmeluba;».",
      "rdfs:label": {
        "@value": "GMOVS_Par_37 (redaktsioon 742762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742762"
    },
