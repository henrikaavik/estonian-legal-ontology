      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geneetiliselt muundatud organismi keskkonda viimise ja geneetiliselt muundatud organismi või toote turustamise taotluses esitatud andmeid hoitakse kuni keskkonnakaitse valdkonda käsitlevate andmekogude keskkonnaregistrisse koondamiseni Keskkonnaministeeriumis riigiasutuse andmekoguna.",
      "rdfs:label": {
        "@value": "GMOVS_Par_36 (redaktsioon 742762)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742762",
