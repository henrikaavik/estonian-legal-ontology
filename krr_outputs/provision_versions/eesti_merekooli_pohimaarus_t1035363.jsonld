      }
    },
    {
      "@id": "estleg:Reg_1035363_Par_12_v1035363",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035363_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kooli struktuuri moodustavad õppekasvatustöö struktuuriüksused ja õppekasvatustööd toetavad struktuuriüksused. Kooli struktuuri moodustavad õppekasvatustöö struktuuriüksused ja õppekasvatustööd toetavad struktuuriüksused. 2 (2) Kooli struktuuri kinnitab nõukogu kooli direktori ettepanekul. RT I 2019-08-16 1 116082019001 2019-09-01 Kooli struktuuri kinnitab nõukogu kooli direktori ettepanekul.",
      "rdfs:label": {
        "@value": "Reg_1035363_Par_12 (redaktsioon 1035363)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035363",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035363",
      "estleg:sourceAct": "Eesti Merekooli põhimäärus",
      "estleg:provisionRef": "Reg_1035363 § 12",
      "estleg:partOfAct": {
