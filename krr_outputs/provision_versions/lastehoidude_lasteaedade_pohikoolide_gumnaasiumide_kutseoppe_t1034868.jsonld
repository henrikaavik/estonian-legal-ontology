      }
    },
    {
      "@id": "estleg:Reg_1034868_Par_5_v1034868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034868_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutseõppeasutuse tegevusnäitajad on järgmised: 1 1) kutsekeskharidusõppesse sisse astunud õpilaste põhikooli lõpueksamite tulemused; 2 2) kutsekeskhariduse tasemel õppivate õpilaste rahulolu; 3 3) digilahenduste kasutamise sagedus õppetegevuses; 4 4) kutseeksami sooritanute osakaal eksamil osalenutest; 5 5) õppetöö katkestajate osakaal; 6 6) kutsekeskhariduse nominaalajaga lõpetajate osakaal; 7 7) lõpetajate hõive aasta pärast lõpetamist; 8 8) töökohapõhise õppe lõpetanud õpilaste osakaal. Kutseõppeasutuse tegevusnäitajad on järgmised: kutsekeskharidusõppesse sisse astunud õpilaste põhikooli lõpueksamite tulemused; kutsekeskhariduse tasemel õppivate õpilaste rahulolu; digilahenduste kasutamise sagedus õppetegevuses; kutseeksami sooritanute osakaal eksamil osalenutest; õppetöö katkestajate osakaal; kutsekeskhariduse nominaalajaga lõpetajate osakaal; lõpetajate hõive aasta pärast lõpetamist; töökohapõhise õppe lõpetanud õpilaste osakaal.",
      "rdfs:label": {
        "@value": "Reg_1034868_Par_5 (redaktsioon 1034868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034868",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034868",
