      "estleg:provisionRef": "Reg_1034868 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034868_Map"
      }
    },
    {
      "@id": "estleg:Reg_1034868_Par_6_v1034868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034868_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Täienduskoolitusasutuse tegevusnäitajad õppekavarühmade lõikes on järgmised: 1 1) täienduskoolitust alustanud õppijate arv; 2 2) väljaantud tunnistuste arv; 3 3) läbiviidud kursuste arv kokku; 4 4) kursused mahus kuni 8 akadeemilist tundi; 5 5) kursused mahus 9–26 akadeemilist tundi; 6 6) kursused mahus 27–80 akadeemilist tundi; 7 7) kursused mahus 81–240 akadeemilist tundi; 8 8) kursused mahus rohkem kui 240 akadeemilist tundi. Täienduskoolitusasutuse tegevusnäitajad õppekavarühmade lõikes on järgmised: täienduskoolitust alustanud õppijate arv; väljaantud tunnistuste arv; läbiviidud kursuste arv kokku; kursused mahus kuni 8 akadeemilist tundi; kursused mahus 9–26 akadeemilist tundi; kursused mahus 27–80 akadeemilist tundi; kursused mahus 81–240 akadeemilist tundi; kursused mahus rohkem kui 240 akadeemilist tundi. 2 (2) Tegevusnäitajate arvestamisel võetakse aluseks kursused, mis on lõppenud arvestuse aluseks olnud kalendriaastal. Tegevusnäitajate arvestamisel võetakse aluseks kursused, mis on lõppenud arvestuse aluseks olnud kalendriaastal.",
      "rdfs:label": {
        "@value": "Reg_1034868_Par_6 (redaktsioon 1034868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034868",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1034868",
