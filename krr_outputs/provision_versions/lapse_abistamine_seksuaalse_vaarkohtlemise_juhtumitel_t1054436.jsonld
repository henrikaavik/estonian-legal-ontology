        "@value": "Sätete redaktsioonid: Lapse abistamine seksuaalse väärkohtlemise juhtumitel (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lapse abistamine seksuaalse väärkohtlemise juhtumitel"
    },
    {
      "@id": "estleg:Reg_1054436_Par_1_v1054436",
      "@type": [
