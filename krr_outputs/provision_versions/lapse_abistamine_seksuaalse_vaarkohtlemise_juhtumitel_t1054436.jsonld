      }
    },
    {
      "@id": "estleg:Reg_1054436_Par_5_v1054436",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054436_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lastemaja töötaja jälgib lapse abistamiseks rakendatud meetmete mõju ja tulemuslikkust kolme kuu jooksul viimasest Sotsiaalkindlustusameti menetlustoimingust lapse suhtes. Lastemaja töötaja jälgib lapse abistamiseks rakendatud meetmete mõju ja tulemuslikkust kolme kuu jooksul viimasest Sotsiaalkindlustusameti menetlustoimingust lapse suhtes.",
      "rdfs:label": {
        "@value": "Reg_1054436_Par_5 (redaktsioon 1054436)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054436",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054436",
      "estleg:sourceAct": "Lapse abistamine seksuaalse väärkohtlemise juhtumitel",
      "estleg:provisionRef": "Reg_1054436 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054436_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054436_Par_6_v1054436",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054436_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seksuaalse väärkohtlemise juhtumitel laste heaolu toetavate meetmete arendamiseks teeb Sotsiaalkindlustusamet püsivat koostööd Politsei- ja Piirivalveameti, prokuratuuri, Eesti Kohtuekspertiisi Instituudi ja seksuaalvägivalla kriisiabi osutavate tervishoiuasutustega. Seksuaalse väärkohtlemise juhtumitel laste heaolu toetavate meetmete arendamiseks teeb Sotsiaalkindlustusamet püsivat koostööd Politsei- ja Piirivalveameti, prokuratuuri, Eesti Kohtuekspertiisi Instituudi ja seksuaalvägivalla kriisiabi osutavate tervishoiuasutustega.",
      "rdfs:label": {
        "@value": "Reg_1054436_Par_6 (redaktsioon 1054436)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054436",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054436",
      "estleg:sourceAct": "Lapse abistamine seksuaalse väärkohtlemise juhtumitel",
      "estleg:provisionRef": "Reg_1054436 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054436_Map_2026"
      }
    },
