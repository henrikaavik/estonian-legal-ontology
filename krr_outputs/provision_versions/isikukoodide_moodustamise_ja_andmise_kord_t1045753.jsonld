      "estleg:versionText": "Määrusega kehtestatakse isikukoodide moodustamise ja andmise kord. Määrusega kehtestatakse isikukoodide moodustamise ja andmise kord.",
      "rdfs:label": {
        "@value": "Reg_1045753_Par_1 (redaktsioon 1045753)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045753",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045753",
