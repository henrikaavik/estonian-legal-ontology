  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_loetelu_hadaolukorda_pohjustada_voivatest_sundmustest_mille__t1052342_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Loetelu hädaolukorda põhjustada võivatest sündmustest, mille kohta koostatakse nende lahendamise plaan, plaani koostamise nõuded ja kord ning selle koostamist juhtivad asutused, hädaolukorra lahendamist juhtivad täidesaatva riigivõimu asutused, hädaolukordade loetelu, mille puhul korraldatakse riskikommunikatsiooni, ning selle korraldamise eest vastutavad asutused (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Loetelu hädaolukorda põhjustada võivatest sündmustest, mille kohta koostatakse nende lahendamise plaan, plaani koostamise nõuded ja kord ning selle koostamist juhtivad asutused, hädaolukorra lahendamist juhtivad täidesaatva riigivõimu asutused, hädaolukordade loetelu, mille puhul korraldatakse riskikommunikatsiooni, ning selle korraldamise eest vastutavad asutused"
    },
    {
      "@id": "estleg:Reg_1052342_Par_1_v1052342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052342_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse: 1 1) loetelu hädaolukorda põhjustada võivatest sündmustest, mille kohta koostatakse nende lahendamise plaan; 2 2) hädaolukorra lahendamise plaani koostamist juhtivad asutused, sealhulgas elutähtsa teenuse toimepidevust korraldavad ja hädaolukorra seaduse § 37 lõikes 5 nimetatud asutused (edaspidi plaani koostamist juhtiv asutus); 3 3) hädaolukordade lahendamist juhtivad täidesaatva riigivõimu asutused; 4 4) loetelu hädaolukordadest, mille puhul korraldatakse riskikommunikatsiooni, ja riskikommunikatsiooni korraldamise eest vastutavad asutused; 5 5) hädaolukorra lahendamise plaani (edaspidi plaan) nõuded ja koostamise, sealhulgas uuendamise kord. Määrusega kehtestatakse: loetelu hädaolukorda põhjustada võivatest sündmustest, mille kohta koostatakse nende lahendamise plaan; hädaolukorra lahendamise plaani koostamist juhtivad asutused, sealhulgas elutähtsa teenuse toimepidevust korraldavad ja hädaolukorra seaduse § 37 lõikes 5 nimetatud asutused (edaspidi plaani koostamist juhtiv asutus); hädaolukordade lahendamist juhtivad täidesaatva riigivõimu asutused; loetelu hädaolukordadest, mille puhul korraldatakse riskikommunikatsiooni, ja riskikommunikatsiooni korraldamise eest vastutavad asutused; hädaolukorra lahendamise plaani (edaspidi plaan) nõuded ja koostamise, sealhulgas uuendamise kord.",
      "rdfs:label": {
        "@value": "Reg_1052342_Par_1 (redaktsioon 1052342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052342",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052342",
      "estleg:sourceAct": "Loetelu hädaolukorda põhjustada võivatest sündmustest, mille kohta koostatakse nende lahendamise plaan, plaani koostamise nõuded ja kord ning selle koostamist juhtivad asutused, hädaolukorra lahendamist juhtivad täidesaatva riigivõimu asutused, hädaolukordade loetelu, mille puhul korraldatakse riskikommunikatsiooni, ning selle korraldamise eest vastutavad asutused",
      "estleg:provisionRef": "Reg_1052342 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052342_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052342_Par_2_v1052342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052342_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Politsei- ja Piirivalveamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: 1 1) põgenike massiline sisseränne; 2 2) äkkrünnak; 3 3) massiline korratus; 4 4) ulatuslik merepäästesündmus, sealhulgas reostus piiriveekogus. RT I 2022-07-21 1 121072022001 2023-01-01 Politsei- ja Piirivalveamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: põgenike massiline sisseränne; äkkrünnak; massiline korratus; ulatuslik merepäästesündmus, sealhulgas reostus piiriveekogus. 2 (2) Päästeamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: 1 1) üleujutus tiheasustusalal; 2 2) ulatuslik tööstusõnnetus. Päästeamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: üleujutus tiheasustusalal; ulatuslik tööstusõnnetus. 3 (3) Keskkonnaamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: 1 1) kiirgusõnnetus naaberriigis; 2 2) riigisisene kiirgusõnnetus. Keskkonnaamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: kiirgusõnnetus naaberriigis; riigisisene kiirgusõnnetus. 4 (4) Terviseamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: 1 1) ulatuslik mürgistus; 2 2) epideemia. Terviseamet juhib järgmiste hädaolukordade lahendamist, nende kohta plaani koostamist ning riskikommunikatsiooni korraldamist: ulatuslik mürgistus; epideemia. 5 (5) Riigi Infosüsteemi Amet juhib küberintsidendist põhjustatud hädaolukorra lahendamist, selle kohta plaani koostamist ning riskikommunikatsiooni korraldamist. Riigi Infosüsteemi Amet juhib küberintsidendist põhjustatud hädaolukorra lahendamist, selle kohta plaani koostamist ning riskikommunikatsiooni korraldamist. 6 (6) Põllumajandus- ja Toiduamet juhib loomataudist põhjustatud hädaolukorra lahendamist, selle kohta plaani koostamist ning riskikommunikatsiooni korraldamist. Põllumajandus- ja Toiduamet juhib loomataudist põhjustatud hädaolukorra lahendamist, selle kohta plaani koostamist ning riskikommunikatsiooni korraldamist. 7 (7) Kaitsepolitseiamet juhib keemilise, bioloogilise, radioloogilise, tuuma- või lõhkeaine kuritahtlikust või terroristlikust kasutamisest põhjustatud hädaolukorra lahendamist, selle kohta plaani koostamist ning riskikommunikatsiooni korraldamist. Kaitsepolitseiamet juhib keemilise, bioloogilise, radioloogilise, tuuma- või lõhkeaine kuritahtlikust või terroristlikust kasutamisest põhjustatud hädaolukorra lahendamist, selle kohta plaani koostamist ning riskikommunikatsiooni korraldamist. 8 (8) Kaitsepolitseiamet juhib lõigetes 1–6 nimetatud hädaolukordade lahendamist, kui Kaitsepolitseiametil on põhjendatud alus arvata, on teada või hädaolukorra lahendamisel ilmneb, et hädaolukorra on põhjustanud terroristlik tegevus. Hädaolukorra lahendamise juhtimise ülevõtmise korraldus ja koostöö asutuste vahel terroristlikust tegevusest põhjustatud hädaolukorra lahendamisel kajastatakse lõigetes 1–6 nimetatud hädaolukordade lahendamise plaanides. Selle plaaniosa koostamist juhib Kaitsepolitseiamet. Kaitsepolitseiamet juhib lõigetes 1–6 nimetatud hädaolukordade lahendamist, kui Kaitsepolitseiametil on põhjendatud alus arvata, on teada või hädaolukorra lahendamisel ilmneb, et hädaolukorra on põhjustanud terroristlik tegevus. Hädaolukorra lahendamise juhtimise ülevõtmise korraldus ja koostöö asutuste vahel terroristlikust tegevusest põhjustatud hädaolukorra lahendamisel kajastatakse lõigetes 1–6 nimetatud hädaolukordade lahendamise plaanides. Selle plaaniosa koostamist juhib Kaitsepolitseiamet. 9 (9) Kaitsevägi juhib Eesti merealal merereostusest põhjustatud hädaolukorra lahendamist, selle kohta hädaolukorra lahendamise plaani koostamist ja riskikommunikatsiooni korraldamist. RT I 2022-07-21 1 121072022001 2023-01-01 Kaitsevägi juhib Eesti merealal merereostusest põhjustatud hädaolukorra lahendamist, selle kohta hädaolukorra lahendamise plaani koostamist ja riskikommunikatsiooni korraldamist.",
      "rdfs:label": {
        "@value": "Reg_1052342_Par_2 (redaktsioon 1052342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052342",
