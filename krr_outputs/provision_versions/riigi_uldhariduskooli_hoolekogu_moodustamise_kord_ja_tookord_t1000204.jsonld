    {
      "@id": "estleg:Reg_1000204_Par_6_v1000204",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000204_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoolekogu töövorm on koosolek. Hoolekogu töövorm on koosolek. 2 (2) Hoolekogu korralised koosolekud toimuvad õppeaasta kestel vähemalt kord nelja kuu jooksul. Hoolekogu korralised koosolekud toimuvad õppeaasta kestel vähemalt kord nelja kuu jooksul. 3 (3) Koosolekut juhatab hoolekogu esimees, tema äraolekul aseesimees, ning protokollib hoolekogu sekretär. Koosolekut juhatab hoolekogu esimees, tema äraolekul aseesimees, ning protokollib hoolekogu sekretär.",
      "rdfs:label": {
        "@value": "Reg_1000204_Par_6 (redaktsioon 1000204)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000204",
