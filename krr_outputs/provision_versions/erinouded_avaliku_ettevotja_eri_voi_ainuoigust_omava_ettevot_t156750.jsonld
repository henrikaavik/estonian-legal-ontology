      "estleg:provisionRef": "Reg_156750 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156750_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156750_Par_5_v156750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156750_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-des 1, 2 ja 4 nimetatud ettevõtjad on kohustatud §-des 1 ja 2 nimetatud teavet säilitama seitse aastat arvates majandusaasta lõpust, mille jooksul ettevõtjale eraldati § 1 lõikes 1 nimetatud vahendid või leidis aset § 1 lõike 2 punktides 1, 2, 3, 5 või 6 nimetatud tegevus. Käesoleva määruse §-des 1, 2 ja 4 nimetatud ettevõtjad on kohustatud §-des 1 ja 2 nimetatud teavet säilitama seitse aastat arvates majandusaasta lõpust, mille jooksul ettevõtjale eraldati § 1 lõikes 1 nimetatud vahendid või leidis aset § 1 lõike 2 punktides 1, 2, 3, 5 või 6 nimetatud tegevus.",
      "rdfs:label": {
