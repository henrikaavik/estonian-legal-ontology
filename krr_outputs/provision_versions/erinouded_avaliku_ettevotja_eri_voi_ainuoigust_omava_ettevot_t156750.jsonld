  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_erinouded_avaliku_ettevotja_eri_voi_ainuoigust_omava_ettevot_t156750_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Erinõuded avaliku ettevõtja, eri- või ainuõigust omava ettevõtja ja üldist huvi pakkuvat teenust osutava ettevõtja raamatupidamise läbipaistvusele ning avaliku tootmisettevõtja aruandele (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Erinõuded avaliku ettevõtja, eri- või ainuõigust omava ettevõtja ja üldist huvi pakkuvat teenust osutava ettevõtja raamatupidamise läbipaistvusele ning avaliku tootmisettevõtja aruandele"
    },
    {
      "@id": "estleg:Reg_156750_Par_1_v156750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156750_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avalik ettevõtja «Konkurentsiseaduse» § 31 lg 31 tähenduses, kelle käive (müügitulu) aruandeaastal ja kahel sellele eelnenud majandusaastal on olnud vähemalt 6 071 700 eurot (edaspidi avalik ettevõtja), on kohustatud pidama raamatupidamises eraldi arvestust riigi või kohaliku omavalitsuse üksuse poolt temale vahetult või teise avaliku ettevõtja, krediidi- või finantseerimisasutuse vahendusel eraldatud vahendite ja nende kasutamise kohta. RT I2010-11-0911091120100012011-01-01 Avalik ettevõtja «Konkurentsiseaduse» § 31 lg 31 tähenduses, kelle käive (müügitulu) aruandeaastal ja kahel sellele eelnenud majandusaastal on olnud vähemalt 6 071 700 eurot (edaspidi avalik ettevõtja), on kohustatud pidama raamatupidamises eraldi arvestust riigi või kohaliku omavalitsuse üksuse poolt temale vahetult või teise avaliku ettevõtja, krediidi- või finantseerimisasutuse vahendusel eraldatud vahendite ja nende kasutamise kohta. 2 (2) Avaliku ettevõtja ja riigi või kohaliku omavalitsuse üksuse vaheliste finantssuhete läbipaistvuse tagamiseks peab avalik ettevõtja oma majandusaasta aruandes lisaks raamatupidamise seaduses sätestatule andma teavet alljärgneva kohta: 1 1) aktsia- või osakapitali suurendamine ja vähendamine riigi või kohaliku omavalitsuse üksuse poolt; 2 2) riigilt või kohaliku omavalitsuse üksuselt tagastamatute toetuste või soodustingimustel laenude saamine; 3 3) riigilt või kohaliku omavalitsuse üksuselt finantssoodustuste saamine kasumist, dividendist või nõudest loobumise näol või õiguse andmine vahendite kasutamiseks alla turuhinna; 4 4) omakapitali, vara ja käibe puhasrentaablus võrreldes samas valdkonnas tegutsevate ettevõtjate samade näitajatega, sama tegevusvaldkonna vastavate võrdlusandmete puudumisel võrreldes kõigi Eestis registreeritud ettevõtjate vastavate näitajatega; 5 5) riigi või kohaliku omavalitsuse üksuse poolt kehtestatud finantskohustuste täitmisest vabastamine; 6 6) muu riigiabi saamine. Avaliku ettevõtja ja riigi või kohaliku omavalitsuse üksuse vaheliste finantssuhete läbipaistvuse tagamiseks peab avalik ettevõtja oma majandusaasta aruandes lisaks raamatupidamise seaduses sätestatule andma teavet alljärgneva kohta: aktsia- või osakapitali suurendamine ja vähendamine riigi või kohaliku omavalitsuse üksuse poolt; riigilt või kohaliku omavalitsuse üksuselt tagastamatute toetuste või soodustingimustel laenude saamine; riigilt või kohaliku omavalitsuse üksuselt finantssoodustuste saamine kasumist, dividendist või nõudest loobumise näol või õiguse andmine vahendite kasutamiseks alla turuhinna; omakapitali, vara ja käibe puhasrentaablus võrreldes samas valdkonnas tegutsevate ettevõtjate samade näitajatega, sama tegevusvaldkonna vastavate võrdlusandmete puudumisel võrreldes kõigi Eestis registreeritud ettevõtjate vastavate näitajatega; riigi või kohaliku omavalitsuse üksuse poolt kehtestatud finantskohustuste täitmisest vabastamine; muu riigiabi saamine.",
      "rdfs:label": {
        "@value": "Reg_156750_Par_1 (redaktsioon 156750)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156750",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156750",
      "estleg:sourceAct": "Erinõuded avaliku ettevõtja, eri- või ainuõigust omava ettevõtja ja üldist huvi pakkuvat teenust osutava ettevõtja raamatupidamise läbipaistvusele ning avaliku tootmisettevõtja aruandele",
      "estleg:provisionRef": "Reg_156750 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156750_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156750_Par_2_v156750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156750_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Eri- või ainuõigust omav ettevõtja “Konkurentsiseaduse” § 14 tähenduses või üldist huvi pakkuvat teenust osutav ettevõtja “Konkurentsiseaduse” § 31 lõike 32 tähenduses, kes seoses sellise teenuse osutamisega saab riigilt või kohaliku omavalitsuse üksuselt otseselt või kaudselt mis tahes vormis hüvitist või soodustust ning kelle käive aruandeaastal ja kahel sellele eelnenud majandusaastal on olnud vähemalt 6 071 700 eurot, on kohustatud täitma käesoleva määruse §-s 1 sätestatud kohustusi ning tegutsemise korral rohkem kui ühel tegevusalal käesoleva paragrahvi lõike 2 tähenduses pidama raamatupidamises eraldi arvestust erinevate tegevusaladega seotud tulude ja kulude kohta. RT I2010-11-0911091120100012011-01-01 Eri- või ainuõigust omav ettevõtja “Konkurentsiseaduse” § 14 tähenduses või üldist huvi pakkuvat teenust osutav ettevõtja “Konkurentsiseaduse” § 31 lõike 32 tähenduses, kes seoses sellise teenuse osutamisega saab riigilt või kohaliku omavalitsuse üksuselt otseselt või kaudselt mis tahes vormis hüvitist või soodustust ning kelle käive aruandeaastal ja kahel sellele eelnenud majandusaastal on olnud vähemalt 6 071 700 eurot, on kohustatud täitma käesoleva määruse §-s 1 sätestatud kohustusi ning tegutsemise korral rohkem kui ühel tegevusalal käesoleva paragrahvi lõike 2 tähenduses pidama raamatupidamises eraldi arvestust erinevate tegevusaladega seotud tulude ja kulude kohta. 2 (2) Tegevusalad käesoleva määruse tähenduses on: 1 1) iga toote tootmine või teenuse osutamine, mille suhtes on ettevõtjale antud eri- või ainuõigus; 2 2) iga üldist huvi pakkuva teenuse osutamine, mille osutamise on riik või kohaliku omavalitsuse üksus ettevõtjale ülesandeks teinud; 3 3) iga muu toote või teenuse liik, mille tootmise või osutamisega ettevõtja tegeleb. Tegevusalad käesoleva määruse tähenduses on: iga toote tootmine või teenuse osutamine, mille suhtes on ettevõtjale antud eri- või ainuõigus; iga üldist huvi pakkuva teenuse osutamine, mille osutamise on riik või kohaliku omavalitsuse üksus ettevõtjale ülesandeks teinud; iga muu toote või teenuse liik, mille tootmise või osutamisega ettevõtja tegeleb. 3 (3) Eraldi raamatupidamisarvestuse pidamisel jaotatakse ettevõtja kõik kulud ja tulud erinevate tegevusalade vahel lähtudes järjepidevalt kohaldatavatest ja objektiivselt põhjendatud kuluarvestuspõhimõtetest. Kuluarvestuspõhimõtted tuleb selgelt määratleda ettevõtja raamatupidamise sise-eeskirjades. Eraldi raamatupidamisarvestuse pidamisel jaotatakse ettevõtja kõik kulud ja tulud erinevate tegevusalade vahel lähtudes järjepidevalt kohaldatavatest ja objektiivselt põhjendatud kuluarvestuspõhimõtetest. Kuluarvestuspõhimõtted tuleb selgelt määratleda ettevõtja raamatupidamise sise-eeskirjades. 4 (4) Eraldi raamatupidamisarvestuse pidamisel ja vastava aruande koostamisel lähtutakse «Raamatupidamise seaduse» § 32 lõike 1 alusel Raamatupidamise Toimkonna poolt välja antud juhendis «RTJ 12 Valitsusepoolne abi» sätestatud nõuetest. Eraldi raamatupidamisarvestuse pidamisel ja vastava aruande koostamisel lähtutakse «Raamatupidamise seaduse» § 32 lõike 1 alusel Raamatupidamise Toimkonna poolt välja antud juhendis «RTJ 12 Valitsusepoolne abi» sätestatud nõuetest. 5 (5) Erinevate tegevusaladega seotud tulude ja kulude kohta koostatud aruanne on ettevõtja majandusaasta aruande lisa. Erinevate tegevusaladega seotud tulude ja kulude kohta koostatud aruanne on ettevõtja majandusaasta aruande lisa.",
      "rdfs:label": {
        "@value": "Reg_156750_Par_2 (redaktsioon 156750)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156750",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156750",
      "estleg:sourceAct": "Erinõuded avaliku ettevõtja, eri- või ainuõigust omava ettevõtja ja üldist huvi pakkuvat teenust osutava ettevõtja raamatupidamise läbipaistvusele ning avaliku tootmisettevõtja aruandele",
      "estleg:provisionRef": "Reg_156750 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156750_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156750_Par_3_v156750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156750_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvides 1 ja 2 sätestatud kohustuste täitmise kontrollimiseks on rahandusministril õigus nõuda samades paragrahvides nimetatud ettevõtjatelt ülevaadet § 1 lõikes 1 nimetatud vahendite kasutamise kohta, käesoleva määruse reguleerimisala puudutavaid väljavõtteid ettevõtja raamatupidamise registritest ja muid raamatupidamise läbipaistvuse hindamiseks vajalikke dokumente. Paragrahvides 1 ja 2 sätestatud kohustuste täitmise kontrollimiseks on rahandusministril õigus nõuda samades paragrahvides nimetatud ettevõtjatelt ülevaadet § 1 lõikes 1 nimetatud vahendite kasutamise kohta, käesoleva määruse reguleerimisala puudutavaid väljavõtteid ettevõtja raamatupidamise registritest ja muid raamatupidamise läbipaistvuse hindamiseks vajalikke dokumente. 2 (2) Ettevõtja on kohustatud esitama lõikes 1 nimetatud teabe rahandusministri nõudmisel kümne päeva jooksul, kuid mitte enne majandusaasta, mille kohta teavet nõutakse, aruande kinnitamist või selle kinnitamise tähtaega. Ettevõtja on kohustatud esitama lõikes 1 nimetatud teabe rahandusministri nõudmisel kümne päeva jooksul, kuid mitte enne majandusaasta, mille kohta teavet nõutakse, aruande kinnitamist või selle kinnitamise tähtaega.",
      "rdfs:label": {
        "@value": "Reg_156750_Par_3 (redaktsioon 156750)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156750",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156750",
      "estleg:sourceAct": "Erinõuded avaliku ettevõtja, eri- või ainuõigust omava ettevõtja ja üldist huvi pakkuvat teenust osutava ettevõtja raamatupidamise läbipaistvusele ning avaliku tootmisettevõtja aruandele",
      "estleg:provisionRef": "Reg_156750 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156750_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_156750_Par_4_v156750",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156750_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avalik tootmisettevõtja on avalik ettevõtja, kelle käibest vähemalt 50% moodustab tootmisalane tegevus «Raamatupidamise seaduse» § 45 lõike 3 tähenduses ning kelle käive (müügitulu) aruandeaastal on üle 31 955 900 euro. RT I2010-11-0911091120100012011-01-01 Avalik tootmisettevõtja on avalik ettevõtja, kelle käibest vähemalt 50% moodustab tootmisalane tegevus «Raamatupidamise seaduse» § 45 lõike 3 tähenduses ning kelle käive (müügitulu) aruandeaastal on üle 31 955 900 euro. 2 (2) Avalik tootmisettevõtja on kohustatud esitama rahandusministrile oma majandusaasta aruande koos lisaga erinevate tegevusaladega seotud tulude ja kulude kohta hiljemalt ühe kuu jooksul pärast majandusaasta aruande kinnitamist. Erinevate tegevusaladega seotud tulude ja kulude kajastamisele kohaldatakse § 2 lõigetes 2, 3 ja 4 sätestatut. Avalik tootmisettevõtja on kohustatud esitama rahandusministrile oma majandusaasta aruande koos lisaga erinevate tegevusaladega seotud tulude ja kulude kohta hiljemalt ühe kuu jooksul pärast majandusaasta aruande kinnitamist. Erinevate tegevusaladega seotud tulude ja kulude kajastamisele kohaldatakse § 2 lõigetes 2, 3 ja 4 sätestatut. 3 (3) Avalik tootmisettevõtja on kohustatud esitama rahandusministrile koos oma majandusaasta aruandega aruande järgmiste andmetega, mis ei ole kajastatud tema majandusaasta aruandes: 1 1) igasugused sissemaksed osa- või aktsiakapitali, näidates seejuures eraldi riigi, kohaliku omavalitsuse üksuse, teise avaliku ettevõtja, sh krediidi- või finantseerimisasutuse poolt tehtud sissemaksed, täpsustades vahendite eraldamise tingimusi (emiteeritavate väärtpaberite liik ja olemasolul nendele omistatavad dividendi- või konverteerimisõigused); 2 2) vahetusvõlakirjade emiteerimine; 3 3) saadud allutatud laenud; 4 4) riigilt, kohaliku omavalitsuse üksuselt või teiselt avalikult ettevõtjalt saadud tagastamatud toetused või teatud tingimustel tagastatavad toetused; 5 5) teave mis tahes laenude (sh arvelduskrediidid ja osa- või aktsiakapitali sissemaksete ettemaksud) kohta koos intressimäära ja muude laenu oluliste tingimustega (sh tagatised, mida ettevõtja on laenuandjale andnud); 6 6) ettevõtja poolt võetud laenudele riigi või kohaliku omavalitsuse üksuse poolt antud laenutagatised koos kõigi tingimustega; 7 7) riigi või kohaliku omavalitsuse üksuse poolt laenude ja toetustega seotud nõuetest loobumine, tulu- või sotsiaalmaksust, muudest maksudest või kohustustest vabastamine või muus vormis sekkumine. Avalik tootmisettevõtja on kohustatud esitama rahandusministrile koos oma majandusaasta aruandega aruande järgmiste andmetega, mis ei ole kajastatud tema majandusaasta aruandes: igasugused sissemaksed osa- või aktsiakapitali, näidates seejuures eraldi riigi, kohaliku omavalitsuse üksuse, teise avaliku ettevõtja, sh krediidi- või finantseerimisasutuse poolt tehtud sissemaksed, täpsustades vahendite eraldamise tingimusi (emiteeritavate väärtpaberite liik ja olemasolul nendele omistatavad dividendi- või konverteerimisõigused); vahetusvõlakirjade emiteerimine; saadud allutatud laenud; riigilt, kohaliku omavalitsuse üksuselt või teiselt avalikult ettevõtjalt saadud tagastamatud toetused või teatud tingimustel tagastatavad toetused; teave mis tahes laenude (sh arvelduskrediidid ja osa- või aktsiakapitali sissemaksete ettemaksud) kohta koos intressimäära ja muude laenu oluliste tingimustega (sh tagatised, mida ettevõtja on laenuandjale andnud); ettevõtja poolt võetud laenudele riigi või kohaliku omavalitsuse üksuse poolt antud laenutagatised koos kõigi tingimustega; riigi või kohaliku omavalitsuse üksuse poolt laenude ja toetustega seotud nõuetest loobumine, tulu- või sotsiaalmaksust, muudest maksudest või kohustustest vabastamine või muus vormis sekkumine.",
      "rdfs:label": {
        "@value": "Reg_156750_Par_4 (redaktsioon 156750)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156750",
