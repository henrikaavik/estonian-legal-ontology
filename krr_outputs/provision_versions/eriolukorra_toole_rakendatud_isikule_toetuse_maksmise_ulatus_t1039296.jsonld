    {
      "@id": "estleg:Reg_1039296_Par_2_v1039296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039296_Par_2"
