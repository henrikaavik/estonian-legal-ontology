    },
    {
      "@id": "estleg:PRS_Par_30_v22217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PRS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet põllumajandusreformi läbiviimise üle teostavad põllumajandusminister ja maavanem korras.",
      "rdfs:label": {
        "@value": "PRS_Par_30 (redaktsioon 22217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22217",
      "estleg:supersededByVersion": {
        "@id": "estleg:PRS_Par_30_v258881"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PRS_Par_30_v258881",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PRS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet põllumajandusreformi läbiviimise üle teostavad valdkonna eest vastutav minister ja maavanem , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"põllumajandusminister\" sõnadega \"valdkonna eest vastutav minister\".",
      "rdfs:label": {
        "@value": "PRS_Par_30 (redaktsioon 258881)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "258881",
      "estleg:supersededByVersion": {
        "@id": "estleg:PRS_Par_30_v101092015025"
      },
      "estleg:versionValidTo": {
        "@value": "2015-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:PRS_Par_30_v101092015025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PRS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet põllumajandusreformi läbiviimise üle teostavad valdkonna eest vastutav minister ja maavanem kehtestatud korras. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „põllumajandusminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "PRS_Par_30 (redaktsioon 101092015025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101092015025"
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_4_v22217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusreform viiakse ühismajandis läbi kooskõlas endise maaomandiõiguse taastamise ja maa erastamisega vastavalt Eesti Vabariigi 1991.aasta 17. oktoobri maareformi seadusele (Riigi Teataja 1991, nr. 34, art. 426) järgmistes etappides: osade kindlaksmääramine ühismajandi varas; ühismajandi likvideerimine või reorganiseerimine. (2) Osade kindlaksmääramisel ühismajandi varas: viiakse läbi ühismajandi vara inventeerimine, mille käigus tehakse kindlaks vara koosseis ning eraldatakse reservfond reformi läbiviimiseks kooskõlas käesoleva seaduse §-ga 26; tehakse kindlaks ühismajandi vara hulka kuuluv ühistatud vara ja õigustatud subjektid ning otsustatakse ühistatud vara tagastamine või kompenseerimine vastavalt Alustele ja käesolevale seadusele; tehakse kindlaks ühismajandi vara hulka kuuluv muu õigusvastaselt võõrandatud vara. Nimetatud vara tagastamine või kompenseerimine toimub vastavalt Aluste § 17 2. lõikele; tehakse kindlaks põllumajandusreformi teiste õigustatud subjektide osa ühismajandi varas käesoleva seaduse §-de 10-11 ja 13-14 alusel; arvutatakse ülejäänud varast õigustatud subjektide tööosakud vastavalt käesoleva seaduse §-le 16. (3) Varaosade kindlaksmääramise järel otsustatakse vara edasise kasutamise kord ning ühismajandi reorganiseerimine või likvideerimine ning uute ettevõtlusvormide rakendamine vastavalt käesoleva seaduse III peatükile.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_4 (redaktsioon 22217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22217",
      "estleg:supersededByVersion": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_4_v258881"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_4_v258881",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusreform viiakse ühismajandis läbi kooskõlas endise maaomandiõiguse taastamise ja maa erastamisega vastavalt Eesti Vabariigi 1991. aasta 17. oktoobri maareformi seadusele (Riigi Teataja, 1991, nr. 34, art. 426) järgmistes etappides: osade kindlaksmääramine ühismajandi varas; ühismajandi likvideerimine või reorganiseerimine. (2) Osade kindlaksmääramisel ühismajandi varas: viiakse läbi ühismajandi vara inventeerimine, mille käigus tehakse kindlaks vara koosseis ning eraldatakse reservfond reformi läbiviimiseks kooskõlas käesoleva seaduse §-ga 26; tehakse kindlaks ühismajandi vara hulka kuuluv ühistatud vara ja õigustatud subjektid ning otsustatakse ühistatud vara tagastamine või kompenseerimine vastavalt Alustele ja käesolevale seadusele; tehakse kindlaks ühismajandi vara hulka kuuluv muu õigusvastaselt võõrandatud vara. Nimetatud vara tagastamine või kompenseerimine toimub vastavalt Aluste § 17 2. lõikele; tehakse kindlaks põllumajandusreformi teiste õigustatud subjektide osa ühismajandi varas käesoleva seaduse §-de 10–11 ja 13–14 alusel; arvutatakse ülejäänud varast õigustatud subjektide tööosakud vastavalt käesoleva seaduse §-le 16. (3) Varaosade kindlaksmääramise järel otsustatakse vara edasise kasutamise kord ning ühismajandi reorganiseerimine või likvideerimine ning uute ettevõtlusvormide rakendamine vastavalt käesoleva seaduse III peatükile.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_4 (redaktsioon 258881)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "258881"
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_5_v22217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusreformi läbiviimiseks moodustatakse iga ühismajandi jaoks kohaliku omavalitsuse haldusüksuse reformikomisjon, mille koosseisus on võrdne arv ühismajandi, kohalike talupidajate ja kohaliku omavalitsuse esindajaid, samuti riigi esindajad. (2) Reformikomisjoni moodustamise korra ja töökorralduse määrab kindlaks Eesti Vabariigi Valitsus. (3) Reformikomisjon: tagab ühismajandi vara inventeerimise; teeb kindlaks ühistatud vara koosseisu ja maksumuse ning otsustab selle tagastamise või kompenseerimise; esitab kohaliku omavalitsuse volikogule ettepanekud elanike sotsiaalseks ja kultuuriliseks teenindamiseks vajalike varade munitsipaliseerimise kohta; teeb kindlaks riigi osa ühismajandi varas; teeb kindlaks käesoleva seaduse § 3 1. lõike punktides 2-12 loetletud isikute ringi ja neile kuuluva varaosa suuruse; vaatab läbi ühismajandi reorganiseerimise või likvideerimise kava ja annab oma nõusoleku selle elluviimiseks; täidab teisi käesolevast seadusest ja muudest normatiivaktidest tulenevaid ülesandeid põllumajandusreformi läbiviimisel. (4) Reformikomisjonil on õigus teha ühismajandile ülesandeks põllumajandusreformi läbiviimiseks vajalike materjalide ja dokumentide ettevalmistamine. (5) Kõiki tehinguid ühismajandi põhivaraga on lubatud põllumajandusreformi läbiviimise perioodil teostada ainult reformikomisjoni loal.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_5 (redaktsioon 22217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22217",
      "estleg:supersededByVersion": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_5_v258881"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_5_v258881",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandusreformi läbiviimiseks moodustatakse iga ühismajandi jaoks kohaliku omavalitsuse haldusüksuse reformikomisjon, mille koosseisus on võrdne arv ühismajandi, kohalike talupidajate ja kohaliku omavalitsuse esindajaid, samuti riigi esindajad. (2) Reformikomisjoni moodustamise korra ja töökorralduse määrab kindlaks (3) Reformikomisjon: tagab ühismajandi vara inventeerimise; teeb kindlaks ühistatud vara koosseisu ja maksumuse ning otsustab selle tagastamise või kompenseerimise; esitab kohaliku omavalitsuse volikogule ettepanekud elanike sotsiaalseks ja kultuuriliseks teenindamiseks vajalike varade munitsipaliseerimise kohta; teeb kindlaks riigi osa ühismajandi varas; teeb kindlaks käesoleva seaduse § 3 1. lõike punktides 2–12 loetletud isikute ringi ja neile kuuluva varaosa suuruse; vaatab läbi ühismajandi reorganiseerimise või likvideerimise kava ja annab oma nõusoleku selle elluviimiseks; täidab teisi käesolevast seadusest ja muudest normatiivaktidest tulenevaid ülesandeid põllumajandusreformi läbiviimisel. (4) Reformikomisjonil on õigus teha ühismajandile ülesandeks põllumajandusreformi läbiviimiseks vajalike materjalide ja dokumentide ettevalmistamine. (5) Kõiki tehinguid ühismajandi põhivaraga on lubatud põllumajandusreformi läbiviimise perioodil teostada ainult reformikomisjoni loal.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_5 (redaktsioon 258881)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "258881"
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_6_v22217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandusreformi läbiviimisel oma haldusterritooriumil kohalik omavalitsus: tagab põllumajandusreformi seostatuse maa- ja haldusreformiga; annab ühismajandi reorganiseerimise või likvideerimise käigus moodustatavale juriidilisele isikule tegutsemisloa; otsustab munitsipaliseeritud vara edasise kasutamise korra ja tingimused; kooskõlas käesoleva seaduse § 5 1. lõikega nimetab reformikomisjonist väljalangenud liikme asemele uue isiku, kui väljalangenud liige ei ole riigi esindaja; täidab käesoleva seaduse §-des 19, 25, 28, 28.1 ja 28.2 sätestatud ning teistest õigusaktidest tulenevaid ülesandeid põllumajandusreformi läbiviimisel.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_6 (redaktsioon 22217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22217",
      "estleg:supersededByVersion": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_6_v258881"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_6_v258881",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-02-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põllumajandusreformi läbiviimisel oma haldusterritooriumil kohalik omavalitsus: tagab põllumajandusreformi seostatuse maa- ja haldusreformiga; annab ühismajandi reorganiseerimise või likvideerimise käigus moodustatavale juriidilisele isikule tegutsemisloa; otsustab munitsipaliseeritud vara edasise kasutamise korra ja tingimused; kooskõlas käesoleva seaduse § 5 1. lõikega nimetab reformikomisjonist väljalangenud liikme asemele uue isiku, kui väljalangenud liige ei ole riigi esindaja; täidab käesoleva seaduse §-des 19, 25, 28, 281 ja 282 sätestatud ning teistest õigusaktidest tulenevaid ülesandeid põllumajandusreformi läbiviimisel.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_6 (redaktsioon 258881)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "258881"
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_7_v22217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:pollumajandusreformi_seadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühistatud vara tagastamise või kompenseerimise avaldused vaatab läbi reformikomisjon vastavalt Alustele ja käesolevale seadusele.",
      "rdfs:label": {
        "@value": "pollumajandusreformi_seadus_Par_7 (redaktsioon 22217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22217"
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_8_v22217",
      "@type": [
