        "@id": "estleg:pollumajandusreformi_seadus_Par_9_v258881"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:pollumajandusreformi_seadus_Par_9_v258881",
      "@type": [
        "owl:NamedIndividual",
