      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mitteioniseeriva kiirguse ohutuse tagamise nõuded ja hindamise kord (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mitteioniseeriva kiirguse ohutuse tagamise nõuded ja hindamise kord"
    },
    {
      "@id": "estleg:Reg_1061750_Par_1_v1061750",
      "@type": [
