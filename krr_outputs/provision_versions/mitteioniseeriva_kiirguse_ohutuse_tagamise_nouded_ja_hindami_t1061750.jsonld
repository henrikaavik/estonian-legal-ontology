        "@type": "xsd:date"
      },
      "estleg:versionText": "Mitteioniseeriva kiirguse piirväärtused elukeskkonnas on kehtestatud määruse lisas. Mitteioniseeriva kiirguse piirväärtused elukeskkonnas on kehtestatud määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1061750_Par_4 (redaktsioon 1061750)",
