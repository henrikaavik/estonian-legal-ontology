      "estleg:sourceAct": "Mitteioniseeriva kiirguse ohutuse tagamise nõuded ja hindamise kord",
      "estleg:provisionRef": "Reg_1061750 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061750_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061750_Par_4_v1061750",
      "@type": [
        "owl:NamedIndividual",
