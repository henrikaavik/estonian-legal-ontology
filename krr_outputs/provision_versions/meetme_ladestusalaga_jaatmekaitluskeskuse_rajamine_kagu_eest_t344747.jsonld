      "estleg:versionValidFrom": {
        "@value": "2010-12-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärast taotlusvooru vabanenud toetuse summad lisatakse meetme «Jäätmete kogumise, sortimise ja taaskasutusse suunamise arendamine» eelarvesse. <table summary=\"allkiri\" width=\"100%\"> <tbody><tr valign=\"top\"> <td width=\"60%\"> </td> <td width=\"39%\"> <b></b> </td> </tr> </tbody></table> <table summary=\"allkiri\" width=\"100%\"> <tbody><tr valign=\"top\"> <td width=\"60%\"> </td> <td width=\"39%\"> <b></b> </td> </tr> </tbody></table> Pärast taotlusvooru vabanenud toetuse summad lisatakse meetme «Jäätmete kogumise, sortimise ja taaskasutusse suunamise arendamine» eelarvesse.",
      "rdfs:label": {
        "@value": "Reg_344747_Par_19 (redaktsioon 344747)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "344747",
