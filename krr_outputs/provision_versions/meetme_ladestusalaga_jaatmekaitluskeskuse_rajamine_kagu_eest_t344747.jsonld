    {
      "@id": "estleg:Reg_344747_Par_12_v344747",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_344747_Par_12"
