      },
      "estleg:versionValidFrom": {
        "@value": "2018-08-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rannaküla sihtkaitsevööndis on poollooduslike koosluste esinemisalal nende ilme ja liigikoosseisu säilimise tagamiseks vajalik heina niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Rannaküla sihtkaitsevööndis on poollooduslike koosluste esinemisalal nende ilme ja liigikoosseisu säilimise tagamiseks vajalik heina niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
