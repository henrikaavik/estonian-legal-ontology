    {
      "@id": "estleg:Reg_1037215_Par_13_v1037215",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037215_Par_13"
