      "estleg:versionValidFrom": {
        "@value": "2020-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-d 6, 7 ja 8, jõustuvad neli kuud pärast käesoleva määruse Riigi Teatajas avaldamist. Käesoleva määruse §-d 6, 7 ja 8, jõustuvad neli kuud pärast käesoleva määruse Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "Reg_1037215_Par_13 (redaktsioon 1037215)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037215",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037215",
      "estleg:sourceAct": "Energiaauditi miinimumnõuded",
      "estleg:provisionRef": "Reg_1037215 § 13",
