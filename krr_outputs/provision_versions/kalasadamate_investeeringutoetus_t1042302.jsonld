      }
    },
    {
      "@id": "estleg:Reg_1042302_Par_13_v1042302",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042302_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaeluministri 24. jaanuari 2018. a määrust nr 5 „2018. aastal toetatavate „Euroopa Merendus- ja Kalandusfondi rakenduskava 2014–2020” meetmete ja tegevuste liigid” täiendatakse punktiga 8 järgmises sõnastuses:„8) kalasadamate investeeringutoetus”. ” Maaeluministri 24. jaanuari 2018. a määrust nr 5 „2018. aastal toetatavate „Euroopa Merendus- ja Kalandusfondi rakenduskava 2014–2020” meetmete ja tegevuste liigid” täiendatakse punktiga 8 järgmises sõnastuses:„8) kalasadamate investeeringutoetus”. ”",
      "rdfs:label": {
        "@value": "Reg_1042302_Par_13 (redaktsioon 1042302)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042302",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042302",
      "estleg:sourceAct": "Kalasadamate investeeringutoetus",
      "estleg:provisionRef": "Reg_1042302 § 13",
      "estleg:partOfAct": {
