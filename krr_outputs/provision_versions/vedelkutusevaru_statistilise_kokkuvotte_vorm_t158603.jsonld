        "@value": "Sätete redaktsioonid: Vedelkütusevaru statistilise kokkuvõtte vorm (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Vedelkütusevaru statistilise kokkuvõtte vorm"
    },
    {
      "@id": "estleg:Reg_158603_Par_1_v158603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
