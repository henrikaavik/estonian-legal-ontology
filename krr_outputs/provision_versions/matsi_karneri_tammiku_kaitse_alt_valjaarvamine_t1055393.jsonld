      "estleg:versionValidFrom": {
        "@value": "2022-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 18. märtsi 2021. a käskkirjaga nr 151 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 18. märtsi 2021. a käskkirjaga nr 151 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1055393_Par_5 (redaktsioon 1055393)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055393",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055393",
      "estleg:sourceAct": "Matsi-Kärneri tammiku kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1055393 § 5",
      "estleg:partOfAct": {
