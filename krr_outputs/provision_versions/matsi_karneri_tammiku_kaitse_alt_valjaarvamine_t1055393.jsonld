    {
      "@id": "estleg:Reg_1055393_Par_5_v1055393",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055393_Par_5"
