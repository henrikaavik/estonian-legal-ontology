      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Looduskaitselise otstarbekuse puudumise tõttu arvatakse looduskaitse alt välja Rapla maakonnas Rapla vallas Kuku külas asuv Matsi-Kärneri tammik (KLO1000531)1. Looduskaitselise otstarbekuse puudumise tõttu arvatakse looduskaitse alt välja Rapla maakonnas Rapla vallas Kuku külas asuv Matsi-Kärneri tammik (KLO1000531)1.",
      "rdfs:label": {
        "@value": "Reg_1055393_Par_1 (redaktsioon 1055393)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055393",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055393",
      "estleg:sourceAct": "Matsi-Kärneri tammiku kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1055393 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055393_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055393_Par_2_v1055393",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055393_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 1 nimetatud kaitseala kaitse alt väljaarvamisega tunnistatakse kehtetuks Rapla Maavalitsuse 20. oktoobri 1992. a määruse nr 97 „Objektide looduskaitse alla võtmine, nimetuse muutmine, pindalade ning uute pindalade kinnitamine” punkt 1.9, millega võeti kaitse alla Rapla vallas Kuku külas Purila o/ü metsakvartali nr 40 eraldused 10 ja 14 (kokku 4,7 ha) eesmärgiga kujundada seal tamme peapuuliigiga puistu. Ala nimetati Matsi-Kärneri tammikuks. Paragrahvis 1 nimetatud kaitseala kaitse alt väljaarvamisega tunnistatakse kehtetuks Rapla Maavalitsuse 20. oktoobri 1992. a määruse nr 97 „Objektide looduskaitse alla võtmine, nimetuse muutmine, pindalade ning uute pindalade kinnitamine” punkt 1.9, millega võeti kaitse alla Rapla vallas Kuku külas Purila o/ü metsakvartali nr 40 eraldused 10 ja 14 (kokku 4,7 ha) eesmärgiga kujundada seal tamme peapuuliigiga puistu. Ala nimetati Matsi-Kärneri tammikuks.",
      "rdfs:label": {
        "@value": "Reg_1055393_Par_2 (redaktsioon 1055393)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055393",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055393",
      "estleg:sourceAct": "Matsi-Kärneri tammiku kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1055393 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055393_Map"
      }
    },
