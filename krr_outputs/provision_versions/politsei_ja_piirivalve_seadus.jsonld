      "estleg:provisionRef": "POLITS § 72_1",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_73_v13249880",
      "@type": [
        "owl:NamedIndividual",
