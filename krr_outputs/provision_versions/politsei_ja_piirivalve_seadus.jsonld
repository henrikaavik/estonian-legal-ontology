      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiasutuse ameti- ja abiteenistuskohtade üldarvu ning selle jagunemise politseiametnike ja avaliku teenistuse üldliigi ameti- ja abiteenistuskohtadeks, sealhulgas kodakondsuse ja migratsiooni valdkonna ametikohtadeks,",
      "rdfs:label": {
