    {
      "@id": "estleg:POLITS_Par_108_16_v127052022028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_108_16"
      },
      "estleg:versionValidFrom": {
