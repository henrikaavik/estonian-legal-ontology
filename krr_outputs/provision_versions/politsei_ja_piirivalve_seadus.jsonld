      }
    },
    {
      "@id": "estleg:POLITS_Par_7_21_v131122012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_7_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei võib töödelda isikuandmeid, tehes kirjaliku või elektroonilise päringu elektroonilise side seaduse § 1111 lõike 1 punktis 6 ning lõigetes 2 ja 3 ning § 112 lõikes 3 nimetatud andmete saamiseks isiku kohta, kelle puhul see on vajalik kõrgendatud ohu väljaselgitamiseks või tõrjumiseks. (2) Isikut tuleb käesoleva paragrahvi lõikes 1 sätestatud isikuandmete töötlemisest viivitamata teavitada, kui isiku asukoht on teada. (3) Käesolevas paragrahvis sätestatud meetme protokollimine on kohustuslik.",
      "rdfs:label": {
        "@value": "POLITS_Par_7_21 (redaktsioon 131122012007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122012007",
      "estleg:supersededByVersion": {
