      },
      "estleg:versionText": "merepäästetöö tegemisel käesoleva seaduse § 1085 lõikes 3 nimetatud eritunnuse kirjelduse ja kandmise korra.",
      "rdfs:label": {
        "@value": "POLITS_Par_108_13 (redaktsioon 104072012022)",
