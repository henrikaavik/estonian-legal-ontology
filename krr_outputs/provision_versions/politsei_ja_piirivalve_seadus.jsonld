    {
      "@id": "estleg:POLITS_Par_95_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 44 lõike 2 punktide 1 ja 2 alusel määratud ajaks ametisse nimetatud ametnik vabastatakse ametikohalt teenistustähtaja möödumise tõttu ning käesoleva seaduse §-s 43 toodud ametniku poolt: nimetatakse tema kirjalikul nõusolekul uueks ametiajaks tagasi senisele ametikohale; nimetatakse tema kirjalikul nõusolekul muule ametikohale; vabastatakse politseiteenistusest.",
      "rdfs:label": {
        "@value": "POLITS_Par_95 (redaktsioon 13249880)",
        "@language": "et"
      },
