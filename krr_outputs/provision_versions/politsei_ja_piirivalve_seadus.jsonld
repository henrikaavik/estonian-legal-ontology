        "@value": "2016-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072012022",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 108_15",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_108_15_v131122015029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_108_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Merepäästetöö tegemise käigus vabatahtliku merepäästja hukkumise ja osalise või puuduva töövõime tuvastamise korral kohaldatakse hüvitise maksmisele ja varalise kahju hüvitamisele abipolitseiniku seaduse §-des 38 ja 39 sätestatut. (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
        "@value": "POLITS_Par_108_15 (redaktsioon 131122015029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015029",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_108_15_v127052022028"
      },
