    {
      "@id": "estleg:POLITS_Par_47_v104072012022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ametisse nimetamine vormistatakse käskkirjaga. (2) Käskkiri peab vastama haldusdokumentidele esitatavatele nõuetele ja sisaldama vähemalt järgmisi andmeid: ametisse nimetatava isiku ees- ja perekonnanimi; asutuse nimetus, kuhu isik teenistusse võetakse; ametisse nimetatava isiku või ametikoha teenistusaste; ametikoha nimetus; ametisse astumiseks määratud kuupäev; määratud ajaks ametisse nimetamisel – teenistustähtaeg; katseaja kohaldamisel – katseaja kestus; ametipalk ja lisatasud; politseiteenistuse staaži pikkus või selle puudumine ametisse nimetamise kuupäeva seisuga.",
      "rdfs:label": {
        "@value": "POLITS_Par_47 (redaktsioon 104072012022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072012022",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_47_v126032013012"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072012022",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 47",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_47_v126032013012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldusakt, millega politseiametnik ametisse nimetatakse, peab sisaldama vähemalt järgmisi andmeid: ametisse nimetatava isiku ees- ja perekonnanimi ning isikukood; selle ametiasutuse nimetus, kuhu isik teenistusse võetakse; ametisse nimetatava isiku teenistusaste; ametikoht; avaliku võimu teostamise volitus viitega selle aluseks olevale sättele või avaliku teenistuse seaduses nimetatud avaliku võimu teostamise ülesandele; ametipalk ja lisatasud; ametisse asumise kuupäev; määratud ajaks ametisse nimetamise korral teenistustähtaeg; katseaja määramisel selle kestus; osalise tööajaga töötamise korral koormus; politseiteenistuse staaži pikkus või selle puudumine ametisse nimetamise kuupäeva seisuga; vaidlustamisviide.",
      "rdfs:label": {
        "@value": "POLITS_Par_47 (redaktsioon 126032013012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013012",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_47_v119032015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013012",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 47",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_47_v119032015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldusakt, millega politseiametnik ametikohale nimetatakse, peab sisaldama vähemalt järgmisi andmeid: ametikohale nimetatava isiku ees- ja perekonnanimi ning isikukood; selle ametiasutuse nimetus, kuhu isik teenistusse võetakse; ametikohale nimetatava isiku teenistusaste; ametikoht; avaliku võimu teostamise volitus viitega selle aluseks olevale sättele või avaliku teenistuse seaduses nimetatud avaliku võimu teostamise ülesandele; ametipalk ja lisatasud; ametikohale asumise kuupäev; määratud ajaks ametikohale nimetamise korral teenistustähtaeg; katseaja määramisel selle kestus; osalise tööajaga töötamise korral koormus; politseiteenistuse staaži pikkus või selle puudumine ametikohale nimetamise kuupäeva seisuga; vaidlustamisviide.",
      "rdfs:label": {
        "@value": "POLITS_Par_47 (redaktsioon 119032015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_47_v127052022028"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015005",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 47",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_47_v127052022028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks avaliku teenistuse seaduse § 26 lõikes 1 sätestatule märgitakse politseiametniku ametikohale nimetamise haldusakti järgmised andmed: ametikohale nimetatava isiku teenistusaste; politseiteenistuse staaži pikkus või selle puudumine ametikohale nimetamise kuupäeva seisuga.",
      "rdfs:label": {
        "@value": "POLITS_Par_47 (redaktsioon 127052022028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022028",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127052022028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 47",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_48_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistusastmed jagunevad spetsialisti ja juhi teenistusastmeteks.",
      "rdfs:label": {
        "@value": "POLITS_Par_48 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_48_v129122011028"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 48",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_48_v129122011028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ametikohad on spetsialisti ametikohad ja juhi ametikohad. (2) Spetsialisti ametikohad ülenevas järjestuses on: nooremspetsialisti ametikoht; vanemspetsialisti ametikoht; juhtivspetsialisti ametikoht ja peaspetsialisti ametikoht. (3) Teenistusastmed ülenevas järjestuses on: nooremkonstaabel, nooremassistent, nooreminspektor; konstaabel, assistent, inspektor, nooremveebel; vanemkonstaabel, vanemassistent, vaneminspektor, veebel; ülemkonstaabel, ülemassistent, üleminspektor, vanemveebel; komissar, ülemveebel; vanemkomissar; politseileitnant; politseikapten; politseimajor; politseikolonelleitnant; politseikolonel; politseikindralinspektor ja politseikindral. (4) Nooremveebli, veebli, vanemveebli ja ülemveebli teenistusaste on üksnes laeval spetsialisti ametikoha teenistusaste. (5) Nooremassistendi, assistendi, vanemassistendi ja ülemassistendi teenistusaste on üksnes Kaitsepolitseiameti spetsialisti ametikoha teenistusaste.",
      "rdfs:label": {
        "@value": "POLITS_Par_48 (redaktsioon 129122011028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011028",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122011028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 48",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_49_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Spetsialisti teenistusastmed on ülenevas järjestuses: nooremkonstaabel, nooremassistent, nooreminspektor; konstaabel, assistent, inspektor, vanemmadrus; vanemkonstaabel, vanemassistent, vaneminspektor, veebel; ülemkonstaabel, ülemassistent, üleminspektor, vanemveebel; komissar, ülemveebel; vanemkomissar; politseileitnant; politseikapten. (2) Vanemmadruse, veebli, vanemveebli ja ülemveebli teenistusaste antakse vaid laevadel spetsialisti ametikohale nimetatud politseiametnikule. (3) Nooremassistendi, assistendi, vanemassistendi ja ülemassistendi teenistusaste antakse vaid Kaitsepolitseiametis spetsialisti ametikohale nimetatud politseiametnikule.",
      "rdfs:label": {
        "@value": "POLITS_Par_49 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
