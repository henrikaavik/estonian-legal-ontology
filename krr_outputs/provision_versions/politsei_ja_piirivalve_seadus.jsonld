      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kadett on sisekaitselise rakenduskõrgkooli politsei või piirivalve erialal täiskoormusega päevases õppevormis keskhariduse baasil kutseharidust omandav õpilane ja rakenduskõrgharidust omandav üliõpilane.",
      "rdfs:label": {
