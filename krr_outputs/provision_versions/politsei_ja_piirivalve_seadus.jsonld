      }
    },
    {
      "@id": "estleg:POLITS_Par_98_v126032013012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistusest vabastamise haldusakt peab sisaldama vähemalt järgmisi andmeid: ametiasutuse nimetus; politseiametniku ees- ja perekonnanimi ning isikukood; politseiametniku teenistusaste; selle ametikoha nimetus, millelt politseiametnik vabastatakse; vabastamise põhjendus; vabastamise alus viitega seaduse paragrahvile, lõikele ja punktile; politseiametnikule makstav hüvitis, sealhulgas hüvitis kasutamata puhkusepäevade eest, kui vabastamisega kaasneb hüvitise maksmine; väljateenitud politseiteenistuse staaž; ametist vabastamise kuupäev. (2) Teenistusest vabastamise haldusakti koopia antakse teenistusest vabastatud politseiametnikule.",
      "rdfs:label": {
        "@value": "POLITS_Par_98 (redaktsioon 126032013012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013012",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_98_v127052022028"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/126032013012",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_98_v127052022028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_98"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks avaliku teenistuse seaduse § 103 lõikes 2 sätestatule sisaldab politseiametniku teenistusest vabastamise haldusakt järgmisi andmeid: politseiametniku teenistusaste; politseiteenistuse staaž.",
      "rdfs:label": {
        "@value": "POLITS_Par_98 (redaktsioon 127052022028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022028",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127052022028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 98",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_99_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_99"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametniku ja tema perekonnaliikmete riikliku pensioni liigid on: väljateenitud aastate pension; töövõimetuspension; toitjakaotuspension. (2) Politseiametniku ja tema perekonnaliikmete pensionikindlustuses kohaldatakse riikliku pensionikindlustuse seaduse sätteid, arvestades käesolevas seaduses sätestatud erisusi. (3) Politseiametnikule, kellel on samal ajal õigus mitmele käesolevas seaduses või muudes seadustes sätestatud riiklikule pensionile, määratakse tema valikul üks riikliku pensioni liik. (4) Politseiametniku pensioni ei suurendata avaliku teenistuse seaduse § 57 alusel.",
      "rdfs:label": {
        "@value": "POLITS_Par_99 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
