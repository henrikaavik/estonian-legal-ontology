    },
    {
      "@id": "estleg:POLITS_Par_67_9_v129122011028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_67_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiametniku töötamine variisiku või politseiagendina ei too kaasa tema politseiteenistussuhte peatamist ega vabastamist politseiametniku ametikohalt ning tema poolt variisikuna või politseiagendina täidetavad ülesanded loetakse teenistusülesanneteks.",
      "rdfs:label": {
        "@value": "POLITS_Par_67_9 (redaktsioon 129122011028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011028",
