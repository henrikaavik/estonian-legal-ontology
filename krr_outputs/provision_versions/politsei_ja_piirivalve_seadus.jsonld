      "estleg:versionText": "Käesoleva seaduse alusel tehtud jälitustoiminguga kogutud teabe vormistamise ja säilitamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "POLITS_Par_7_57 (redaktsioon 102122014008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102122014008",
