        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122011028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 35",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_35_v119032015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametniku ametikoht on asutuse teenistujate koosseisus ettenähtud ametikoht, millel töötamine on politseiteenistus (edaspidi ametikoht). (2) Sisekaitselise rakenduskõrgkooli politsei või piirivalve erialal täiskoormusega õppes keskhariduse baasil kutseharidust omandava õpilase või rakenduskõrgharidust omandava üliõpilase, kes ei ole politseiteenistuses, võib võtta õppepraktika läbimise ajaks politseiteenistusse politseiametnikuna. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "POLITS_Par_35 (redaktsioon 119032015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015005",
