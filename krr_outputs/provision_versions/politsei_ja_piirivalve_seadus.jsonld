        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131122015029",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 108_15",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_108_15_v127052022028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_108_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabatahtliku merepäästja ülesande täitmise käigus vabatahtliku merepäästja hukkumise, haigestumise ja vigastada saamise korral kohaldatakse hüvitise maksmisele ja varalise kahju hüvitamisele abipolitseiniku seaduse §-des 38 ja 39 sätestatut.",
      "rdfs:label": {
        "@value": "POLITS_Par_108_15 (redaktsioon 127052022028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022028",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/127052022028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 108_15",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_108_16_v104072012022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_108_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabatahtliku merepäästja transpordi-, side-, koolitus- ning muud Politsei- ja Piirivalveameti ning mittetulundusühingu vahel sõlmitud vabatahtliku merepäästetöö korraldamise lepingus ettenähtud ja vabatahtliku merepäästja ülesannete täitmiseks vajalikud kulutused hüvitab Politsei- ja Piirivalveamet Vabariigi Valitsuse kehtestatud ulatuses kulutuse teinud vabatahtlikule merepäästjale või mittetulundusühingule, kellega Politsei- ja Piirivalveamet on eelnimetatud lepingu sõlminud. (2) Ennetustöö tegemise transpordi-, side-, koolitus- ning muud Politsei- ja Piirivalveameti ning mittetulundusühingu vahel sõlmitud ennetustöö tegemise lepingus ettenähtud ja ennetustöö tegemisel vajalikud kulutused hüvitab Politsei- ja Piirivalveamet Vabariigi Valitsuse kehtestatud ulatuses kulutuse teinud mittetulundusühingu liikmele või mittetulundusühingule, kellega Politsei- ja Piirivalveamet on eelnimetatud lepingu sõlminud. (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetatud kulutuste hüvitamise ulatuse ja korra",
      "rdfs:label": {
        "@value": "POLITS_Par_108_16 (redaktsioon 104072012022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072012022",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_108_16_v102122014008"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104072012022",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 108_16",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
