      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 44 lõike 2 punktide 1 ja 2 alusel määratud ajaks ametikohale nimetatud ametnik vabastatakse ametikohalt teenistustähtaja möödumise tõttu ning käesoleva seaduse §-s 43 toodud ametniku poolt: nimetatakse tema kirjalikul nõusolekul uueks ametiajaks tagasi senisele ametikohale; nimetatakse tema kirjalikul nõusolekul muule ametikohale; vabastatakse politseiteenistusest.",
      "rdfs:label": {
        "@value": "POLITS_Par_95 (redaktsioon 119032015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015005",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_95_v127052022028"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015005",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 95",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
