      }
    },
    {
      "@id": "estleg:POLITS_Par_72_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametnikule hüvitab politseiasutus sõidu elukohast teenistuskohta ja tagasi, kui taotleja elukohast teenistuskohta ei ole mõistliku ajagraafikuga ühistransporditeenust ning politsei ei korralda vastavat transporti. (2) Politseiametnikule sõidukulude kompenseerimise tingimused, ulatuse ja korra",
      "rdfs:label": {
        "@value": "POLITS_Par_72 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
