      }
    },
    {
      "@id": "estleg:POLITS_Par_22_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrisse kantakse andmed: Schengeni konventsiooni artikli 95 alusel loovutamise või väljaandmise eesmärgil tagaotsitava isiku kohta; Schengeni konventsiooni artikli 96 alusel välismaalaste kohta, kellele on kehtestatud sissesõidukeeld; Schengeni konventsiooni artikli 97 alusel isiku kohta, kes on kadunud või keda tema enda turvalisuse huvides või kaitseks ohu eest on vaja ajutiselt paigutada turvalisse paika; Schengeni konventsiooni artikli 98 alusel tagaotsitava tunnistaja ja süüdistatava või süüdimõistetud isiku kohta; Schengeni konventsiooni artikli 99 alusel isiku ja sõiduki kohta varjatud või erikontrolli teostamiseks; Schengeni konventsiooni artikli 100 alusel arestimise, konfiskeerimise või kriminaalmenetluses asitõendi tagamiseks. (2) Kehtetu –",
      "rdfs:label": {
        "@value": "POLITS_Par_22 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_22_v13343113"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 22",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_22_v13343113",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrisse kantakse andmed: Schengeni konventsiooni artikli 95 alusel loovutamise või väljaandmise eesmärgil tagaotsitava isiku kohta; Schengeni konventsiooni artikli 96 alusel välismaalaste kohta, kellele on kehtestatud sissesõidukeeld; Schengeni konventsiooni artikli 97 alusel isiku kohta, kes on kadunud või keda tema enda turvalisuse huvides või kaitseks ohu eest on vaja ajutiselt paigutada turvalisse paika; Schengeni konventsiooni artikli 98 alusel tagaotsitava tunnistaja ja süüdistatava või süüdimõistetud isiku kohta; Schengeni konventsiooni artikli 99 alusel isiku ja sõiduki kohta varjatud või erikontrolli teostamiseks; Schengeni konventsiooni artikli 100 alusel arestimise, konfiskeerimise või kriminaalmenetluses asitõendi tagamiseks. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "POLITS_Par_22 (redaktsioon 13343113)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13343113",
      "estleg:supersededByVersion": {
