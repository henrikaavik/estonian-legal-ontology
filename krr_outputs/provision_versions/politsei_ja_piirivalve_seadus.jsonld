      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistusastmeid annavad ja muudavad: komissari, vanemkomissari, politseileitnandi, politseikapteni, politseimajori, politseikolonelleitnandi, politseikoloneli, politseikindralinspektori ja politseikindrali teenistusastmeid – siseminister; ülejäänud teenistusastmeid – Politsei- ja Piirivalveameti peadirektor ning Kaitsepolitseiameti peadirektor. (2) Esmase teenistusastme annab erialase kutsehariduse omandanud politseiametnikule Politsei- ja Piirivalveameti peadirektor, Kaitsepolitseiametis Kaitsepolitseiameti peadirektor.",
      "rdfs:label": {
        "@value": "POLITS_Par_53 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
