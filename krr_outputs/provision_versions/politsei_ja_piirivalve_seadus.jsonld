    },
    {
      "@id": "estleg:POLITS_Par_70_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametniku palgaks nimetatakse ametipalka koos seaduses sätestatud lisatasudega ja seaduse alusel makstavate lisatasudega. (2) Politseiametniku ametipalgaks nimetatakse astmepalka koos teenistusastmetasuga. (3) Politseiametniku astmepalk on ametikoha palgaastmele vastav palgamäär. (4) Politseiametnikule makstakse teenistusastmetasu vastavalt politseiametniku teenistusastmele. (5) Politseiametnikule ei maksta lisatasu teenistusaastate eest avaliku teenistuse seaduse § 37 alusel. (6) igaks järgnevaks kalendriaastaks määrusega politseiametnike palgaastmetele vastavad palgamäärad, diferentseerimise alused, teenistusastmetasu suuruse ning politseiametnikele lisatasude maksmise alused ja ulatuse. (7) Politseiametniku palga määrab politseiasutuse juht, Kaitsepolitseiameti peadirektor või Sisekaitseakadeemia rektor käskkirjaga. (8) Politsei- ja Piirivalveameti peadirektori, Kaitsepolitseiameti peadirektori, Politsei- ja Piirivalveameti peadirektori asetäitja ning Kaitsepolitseiameti peadirektori asetäitja ja prefekti palga määrab siseminister.",
      "rdfs:label": {
        "@value": "POLITS_Par_70 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_70_v129122011028"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 70",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
