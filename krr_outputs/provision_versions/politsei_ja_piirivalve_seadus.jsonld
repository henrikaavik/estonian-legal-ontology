    {
      "@id": "estleg:POLITS_Par_109_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiametniku vannet ei anna isikud, kes enne käesoleva seaduse alusel ametisse nimetamist on andnud politseiteenistuses või piirivalveteenistuses olles ametivande.",
      "rdfs:label": {
        "@value": "POLITS_Par_109 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_109_v119032015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 109",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_109_v119032015005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_109"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiametniku vannet ei anna isikud, kes enne käesoleva seaduse alusel ametikohale nimetamist on andnud politseiteenistuses või piirivalveteenistuses olles ametivande.",
      "rdfs:label": {
        "@value": "POLITS_Par_109 (redaktsioon 119032015005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015005",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 109",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_11_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei andmekogusse esitab andmeid politseiasutus. (2) Politsei andmekogusse esitavad andmeid § 8 lõikes 1 sätestatud eesmärgil andmekogu põhimääruses määratud muud asutused kehtestatud ulatuses.",
      "rdfs:label": {
        "@value": "POLITS_Par_11 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
