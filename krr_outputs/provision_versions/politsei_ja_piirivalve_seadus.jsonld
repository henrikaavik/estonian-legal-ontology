        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhi asetäitja ametikohale vastav teenistusaste on sama kui juhi ametikohale vastav teenistusaste või sellest ühe teenistusastme võrra madalam.",
      "rdfs:label": {
        "@value": "POLITS_Par_60 (redaktsioon 13249880)",
        "@language": "et"
      },
