        "@type": "xsd:date"
      },
      "estleg:versionText": "Merepäästetöö tegemise käigus vabatahtliku merepäästja hukkumise või töövõimetuks muutumise korral kohaldatakse hüvitise maksmisele ja varalise kahju hüvitamisele abipolitseiniku seaduse §-des 38 ja 39 sätestatut.",
      "rdfs:label": {
        "@value": "POLITS_Par_108_15 (redaktsioon 104072012022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072012022",
