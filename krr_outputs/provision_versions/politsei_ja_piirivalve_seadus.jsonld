      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisaks korruptsioonivastases seaduses ettenähtud töökoha- ja tegevuspiirangutele ei tohi politseiametnik olla erakonna liige.",
