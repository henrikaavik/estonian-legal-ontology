    },
    {
      "@id": "estleg:POLITS_Par_7_57_v110122020023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_7_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku võib Politsei- ja Piirivalveameti peadirektori või tema volitatud ametniku loal jätta käesoleva seaduse alusel tehtud jälitustoimingust teavitamata kriminaalmenetluse seadustiku § 12613 lõikes 2 sätestatud alusel ja jälitustoiminguga kogutud andmetega tutvustamata kriminaalmenetluse seadustiku § 12614 lõikes 1 sätestatud alusel kuni selle aluse äralangemiseni. (2) Käesoleva seaduse alusel tehtud jälitustoimingust teavitamise ja jälitustoiminguga kogutud andmete tutvustamise korra kehtestab määrusega. (3) Käesoleva seaduse alusel tehtud jälitustoiminguga kogutud teabe vormistamise ja säilitamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "POLITS_Par_7_57 (redaktsioon 110122020023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110122020023",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 7_57",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
