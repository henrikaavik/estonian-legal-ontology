    {
      "@id": "estleg:POLITS_Par_32_4_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_32_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui vahetu sunni kohaldamisega tekitatakse isikule kehavigastus, on politsei kohustatud tagama isikule esimesel võimalusel esmaabi andmise ning vajaduse korral kiirabi kutsumise.",
