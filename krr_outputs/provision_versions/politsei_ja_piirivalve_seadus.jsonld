      }
    },
    {
      "@id": "estleg:POLITS_Par_19_v102122014008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-12-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Piirikontrolli andmekogu pidamise põhimääruse kehtestab määrusega. (2) Piirikontrolli andmekogu pidamise põhimääruses sätestatakse: andmekogu ülesehitus ja andmekogu organisatsiooniline struktuur; andmekogusse kantavate andmete ammendav loetelu; andmekogusse kantud andmete säilitamise tähtaeg; andmete andmekogusse kandmiseks vajalike alusdokumentide loetelu; andmekogusse kantavate andmete vastuvõtmise ja neile juurdepääsu üle arvestuse pidamise kord; andmekogust andmete saajad; andmetega tutvumise ning nende väljastamise kord; ebaõigete andmete parandamise ja sellest teavitamise kord; andmekogu laiendamise, likvideerimise ning teise andmekoguga ühendamise alused ja kord; muud õigusaktidest tulenevad vajalikud tingimused.",
      "rdfs:label": {
        "@value": "POLITS_Par_19 (redaktsioon 102122014008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102122014008",
