    {
      "@id": "estleg:POLITS_Par_105_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_105"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väljateenitud aastate pension määratakse eluajaks. (2) Töövõimetuspension määratakse ajaks, millal politseiametnik on tunnistatud osaliselt või täielikult töövõimetuks. (3) Toitjakaotuspension määratakse ajaks, millal isik vastab käesoleva seaduse §-s 103 sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "POLITS_Par_105 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
