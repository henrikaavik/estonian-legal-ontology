    {
      "@id": "estleg:POLITS_Par_67_2_v129122011028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_67_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiametniku teenistuse või töö korraldamise suhtes vastuvõtvas asutuses, sealhulgas tema üleviimise suhtes ühelt ametikohalt teisele, kohaldatakse vastuvõtva asutuse ametniku või töötaja suhtes kohaldatavat regulatsiooni.",
      "rdfs:label": {
        "@value": "POLITS_Par_67_2 (redaktsioon 129122011028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011028",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122011028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 67_2",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_67_3_v129122011028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_67_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametnikule, kelle politseiteenistussuhe on peatatud seoses nimetamisega või tööle võtmisega teisele ametikohale vastuvõtvas asutuses, maksab vastuvõttev asutus politseiametniku soovil ametipalka, mis on võrdne tema viimase politseiametniku ametikoha ametipalgaga. (2) Käesolevas paragrahvis sätestatut ei kohaldata, kui vastuvõtvaks asutuseks on rahvusvaheline organisatsioon, mille palgakorraldus ei võimalda käesolevas paragrahvis sätestatut kohaldada.",
      "rdfs:label": {
        "@value": "POLITS_Par_67_3 (redaktsioon 129122011028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011028",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_67_3_v119032015005"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122011028",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 67_3",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
