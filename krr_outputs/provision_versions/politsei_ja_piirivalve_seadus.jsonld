      }
    },
    {
      "@id": "estleg:POLITS_Par_107_v119032019065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolevas seaduses sätestatud pensioni makstakse riigieelarve vahenditest. (2) Väljateenitud aastate pensioni saavale isikule makstakse pension välja täies ulatuses, sõltumata saadava sissetuleku suurusest. (jõustumine muudetud - RT I, 17.12.2015, 1) (3) Kehtetu - (4) Kehtetu - (jõustumine muudetud - RT I, 17.12.2015, 1)",
      "rdfs:label": {
        "@value": "POLITS_Par_107 (redaktsioon 119032019065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019065",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_107_v119032019067"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
