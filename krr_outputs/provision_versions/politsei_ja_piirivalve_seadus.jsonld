      }
    },
    {
      "@id": "estleg:POLITS_Par_35_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametniku ametikoht on asutuse teenistujate koosseisus ettenähtud ametikoht, millele on kinnitatud teenistusaste ja kutsekvalifikatsiooni tase ning määratud palgaaste (edaspidi ametikoht ). (2) Ametikohad on: juhi ametikohad; spetsialisti ametikohad, mis jagunevad juhtivspetsialisti, vanemspetsialisti ja nooremspetsialisti ametikohtadeks. (3) Ametikohale kinnitatud teenistusaste määrab: ametikoha liigi käesoleva seaduse § 57 lõike 1 punkti 1 mõistes; ametikoha taseme käesoleva seaduse § 57 lõike 1 punkti 2 mõistes; teenistusastme, mida võib sellele ametikohale nimetatud politseiametnikule anda või milleni võib tema teenistusastet ülendada käesoleva seaduse §-de 49 ja 50 mõistes.",
      "rdfs:label": {
        "@value": "POLITS_Par_35 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_35_v13343113"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 35",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
