      }
    },
    {
      "@id": "estleg:POLITS_Par_108_10_v113032019112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_108_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isikule, keda Politsei- ja Piirivalveamet tunnustab vabatahtliku merepäästjana, annab Politsei- ja Piirivalveamet vabatahtliku merepäästja tunnistuse. (2) Vabatahtliku merepäästja tunnistuse väljastamiseks vajalike andmete esitamise loetelu, andmete säilitamise tähtaja ja tunnistuse kirjelduse kehtestab määrusega.",
      "rdfs:label": {
        "@value": "POLITS_Par_108_10 (redaktsioon 113032019112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019112",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019112",
