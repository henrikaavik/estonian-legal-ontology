      "estleg:provisionRef": "POLITS § 96",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_96_v106072017006",
      "@type": [
        "owl:NamedIndividual",
