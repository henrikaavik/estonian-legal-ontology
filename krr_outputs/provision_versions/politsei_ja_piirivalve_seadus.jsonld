      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "POLITS_Par_105 (redaktsioon 119032019067)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032019067",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032019067",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
