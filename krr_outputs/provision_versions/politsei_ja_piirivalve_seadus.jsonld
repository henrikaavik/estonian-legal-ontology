        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_116_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel politseiametniku ametikohale nimetamisel arvatakse politseiametniku senine ametinimetus teenistusastmeks järgmiselt: (2) Käesoleva seaduse alusel Kaitsepolitseiameti politseiametniku ametikohale nimetamisel arvatakse Kaitsepolitseiameti politseiametniku senine ametinimetus teenistusastmeks järgmiselt: (3) Käesoleva paragrahvi lõigetes 1 ja 2 sätestatud ametinimetuste teenistusastmetega vastavusse viimise korra",
      "rdfs:label": {
        "@value": "POLITS_Par_116 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_116_v122032011011"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 116",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_116_v122032011011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse alusel politseiametniku ametikohale nimetamisel arvatakse politseiametniku senine ametinimetus teenistusastmeks järgmiselt: (2) Käesoleva seaduse alusel Kaitsepolitseiameti politseiametniku ametikohale nimetamisel arvatakse Kaitsepolitseiameti politseiametniku senine ametinimetus teenistusastmeks järgmiselt: (3) Käesoleva paragrahvi lõigetes 1 ja 2 sätestatud ametinimetuste teenistusastmetega vastavusse viimise korra (4) Käesoleva paragrahvi lõike 1 punktides 1-7 ja lõike 2 punktides 1-4 nimetatud politseiametnike ametinimetused viiakse hiljemalt 2011. aasta 1. aprilliks vastavusse teenistusastmetega, mis erinevad 2010. aasta 1. jaanuaril jõustunud eelnimetatud sätetes nimetatud teenistusastmetest. Politseiametniku ametinimetused viiakse teenistusastmetega vastavusse tagasiulatuvalt 2010. aasta 1. jaanuarist arvates.",
      "rdfs:label": {
        "@value": "POLITS_Par_116 (redaktsioon 122032011011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032011011",
