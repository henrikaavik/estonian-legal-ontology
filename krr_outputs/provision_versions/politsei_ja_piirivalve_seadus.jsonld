      "estleg:provisionRef": "POLITS § 36_1",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_36_1_v127052022028",
      "@type": [
        "owl:NamedIndividual",
