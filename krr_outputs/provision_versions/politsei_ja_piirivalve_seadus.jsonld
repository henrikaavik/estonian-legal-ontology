      }
    },
    {
      "@id": "estleg:POLITS_Par_96_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_96"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politseiametnik võib olla politseiteenistuses kuni järgmise piirvanuseni: spetsialistina kuni 55-aastaseks saamiseni; juhina kuni 60-aastaseks saamiseni. (2) Politseiametnik vabastatakse politseiteenistusest käesoleva paragrahvi lõikes 1 märgitud piirvanuse täitumisele järgneva kuu esimesel tööpäeval. (3) Politsei- ja Piivalveameti peadirektor või Kaitsepolitseiameti peadirektor võib pikendada politseiametniku teenistusaega ühe aasta kaupa kuni riikliku pensionikindlustuse seaduse §-s 7 sätestatud vanaduspensioniea saabumiseni. Sel juhul vabastatakse politseiametnik teenistusest üldise pensioniea saabumisel.",
      "rdfs:label": {
        "@value": "POLITS_Par_96 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_96_v106072017006"
      },
      "estleg:versionValidTo": {
        "@value": "2017-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
