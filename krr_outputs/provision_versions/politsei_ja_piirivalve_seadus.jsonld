    {
      "@id": "estleg:POLITS_Par_19_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Piirikontrolli andmekogu pidamise põhimääruse kehtestab (2) Piirikontrolli andmekogu pidamise põhimääruses sätestatakse: andmekogu ülesehitus ja andmekogu organisatsiooniline struktuur; andmekogusse kantavate andmete ammendav loetelu; andmekogusse kantud andmete säilitamise tähtaeg; andmete andmekogusse kandmiseks vajalike alusdokumentide loetelu; andmekogusse kantavate andmete vastuvõtmise ja neile juurdepääsu üle arvestuse pidamise kord; andmekogust andmete saajad; andmetega tutvumise ning nende väljastamise kord; ebaõigete andmete parandamise ja sellest teavitamise kord; andmekogu laiendamise, likvideerimise ning teise andmekoguga ühendamise alused ja kord; muud õigusaktidest tulenevad vajalikud tingimused.",
      "rdfs:label": {
        "@value": "POLITS_Par_19 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
