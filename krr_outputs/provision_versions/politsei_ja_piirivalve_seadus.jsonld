    {
      "@id": "estleg:POLITS_Par_86_v13249880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiametniku distsiplinaarsüütegu on: seaduse või selle alusel kehtestatud õigusaktide või teenistuskohustustega ettenähtud nõuete süüline täitmata jätmine või nende mittenõuetekohane täitmine; teenistuskohustuste täitmisel või väljaspool seda süüliselt toimepandud vääritu tegu, millega diskrediteeritakse politseid; süüline varalise kahju tekitamine ametiasutusele või niisuguse kahju tekkimise ohu süüline loomine.",
      "rdfs:label": {
        "@value": "POLITS_Par_86 (redaktsioon 13249880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249880",
      "estleg:supersededByVersion": {
        "@id": "estleg:POLITS_Par_86_v129122011028"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13249880",
      "estleg:sourceAct": "Politsei ja piirivalve seadus",
      "estleg:provisionRef": "POLITS § 86",
      "estleg:partOfAct": {
        "@id": "estleg:POLITS_Map"
      }
    },
    {
      "@id": "estleg:POLITS_Par_86_v129122011028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:POLITS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Politseiametniku distsiplinaarsüütegudeks on: teenistuskohustuste süüline täitmata jätmine või mittenõuetekohane täitmine; ametiasutusele süüline varalise kahju tekitamine või niisuguse kahju tekkimise ohu süüline loomine; vääritu tegu - süüline tegu, mis on vastuolus üldtunnustatud kõlblusnormidega, ametnikule esitatavate eetiliste nõuetega või diskrediteerib ametnikku või ametiasutust, sõltumata sellest, kas niisugune tegu pandi toime teenistuses või väljaspool teenistust.",
      "rdfs:label": {
        "@value": "POLITS_Par_86 (redaktsioon 129122011028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011028",
