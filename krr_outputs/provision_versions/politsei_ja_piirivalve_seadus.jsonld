        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-s 59 ning sellest tulenevaid politseiametniku kutsekvalifikatsiooni nõudeid rakendatakse alates 2015. aasta 1. septembrist, välja arvatud 6. peatüki 2. jaos sätestatut, mida rakendatakse alates seaduse jõustumisest.",
      "rdfs:label": {
        "@value": "POLITS_Par_116_1 (redaktsioon 129122011028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129122011028",
      "estleg:supersededByVersion": {
