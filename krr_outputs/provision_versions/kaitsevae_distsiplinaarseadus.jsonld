      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud –",
      "rdfs:label": {
        "@value": "KDS_Par_7 (redaktsioon 108072011057)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108072011057"
    },
    {
      "@id": "estleg:KDS_Par_70_v22393",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KDS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1998. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "KDS_Par_70 (redaktsioon 22393)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22393",
      "estleg:supersededByVersion": {
        "@id": "estleg:KDS_Par_70_v13005015"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KDS_Par_70_v13005015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KDS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1998. aasta 1. jaanuaril. Õiend \"Kaitseväe distsiplinaarseaduse\" § 141 lõike 5 uue sõnastuse esimese lause teksti osa \"kaitseväe struktuuriüksuse\" järele lisatud sõna \"ja\"; Alus: \"Riigi Teataja seadus\" § 17 lg 3, 31 ja Riigikogu riigikaitsekomisjoni 8.09.2008 kiri 2.8-3/1664.",
      "rdfs:label": {
        "@value": "KDS_Par_70 (redaktsioon 13005015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13005015",
      "estleg:supersededByVersion": {
        "@id": "estleg:KDS_Par_70_v13246056"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-16",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KDS_Par_70_v13246056",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KDS_Par_70"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1998. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "KDS_Par_70 (redaktsioon 13246056)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13246056"
    },
    {
      "@id": "estleg:KDS_Par_8_v22393",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KDS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväelase distsiplinaarsüütegu on seaduse ja selle alusel kehtestatud õigusaktide või teenistuskohustustega ettenähtud nõuete süüline täitmata jätmine või nende mittekohane täitmine. (2) Distsiplinaarsüüteoks on samuti teenistuskohustuste täitmisel või väljaspool seda kaitseväelase poolt toimepandud vääritu tegu või üldtunnustatud kõlblusnormide eiramine, millega ta diskrediteerib Eesti kaitseväge.",
      "rdfs:label": {
        "@value": "KDS_Par_8 (redaktsioon 22393)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22393"
    },
    {
      "@id": "estleg:KDS_Par_9_v22393",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KDS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväelane kannab toimepandud distsiplinaarsüüteo eest distsiplinaarvastutust, mis seisneb tema suhtes distsiplinaarkaristuse kohaldamises vastavalt tema poolt toimepandud süüteo laadile ja raskusele. (2) Distsiplinaarsüüteo eest võib määrata üksnes käesolevas seaduses sätestatud distsiplinaarkaristuse.",
      "rdfs:label": {
        "@value": "KDS_Par_9 (redaktsioon 22393)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22393"
    }
  ]
}
