      },
      "estleg:versionValidTo": {
        "@value": "2005-10-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KDS_Par_64_v949528",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
