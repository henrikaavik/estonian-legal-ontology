      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048134_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on lamminiitude aladel vajalik nende ilmet ja liigikoosseisu tagav tegevus, nagu heina niitmine, puu- ja põõsarinde kujundamine ja harvendamine või raadamine. Piiranguvööndis on lamminiitude aladel vajalik nende ilmet ja liigikoosseisu tagav tegevus, nagu heina niitmine, puu- ja põõsarinde kujundamine ja harvendamine või raadamine.",
      "rdfs:label": {
        "@value": "Reg_1048134_Par_15 (redaktsioon 1048134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048134",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048134",
      "estleg:sourceAct": "Järveküla looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1048134 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048134_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1048134_Par_16_v1048134",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048134_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-11-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavara kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) biotsiidi, taimekaitsevahendi ja väetise kasutamine; 5 5) roo varumine külmumata pinnaselt. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine; roo varumine külmumata pinnaselt. 2 (2) Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu külmumata pinnaselt, kui pinnas seda võimaldab. Piiranguvööndis on keelatud puidu kokku- ja väljavedu külmumata pinnaselt. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu külmumata pinnaselt, kui pinnas seda võimaldab.",
      "rdfs:label": {
        "@value": "Reg_1048134_Par_16 (redaktsioon 1048134)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048134",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1048134",
