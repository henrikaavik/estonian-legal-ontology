      "estleg:provisionRef": "Reg_1048134 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048134_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1048134_Par_15_v1048134",
      "@type": [
        "owl:NamedIndividual",
