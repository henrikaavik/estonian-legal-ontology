      "estleg:provisionRef": "Reg_1048134 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048134_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1048134_Par_10_v1048134",
      "@type": [
