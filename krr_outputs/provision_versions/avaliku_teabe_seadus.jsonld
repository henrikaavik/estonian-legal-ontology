      },
      "estleg:versionValidTo": {
        "@value": "2003-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVTS_Par_54_1_v556659",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_54_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 30. 09. 2003] (1) Teadvalt ebaõige avaliku teabe väljastamise või asutusesiseseks kasutamiseks ettenähtud teabe avalikustamise või väljastamise eest – karistatakse rahatrahviga kuni 300 trahviühikut. [Lõike 1 sõnastus alates 1. 10. 2003] (1) Teadvalt ebaõige avaliku teabe väljastamise või asutusesiseseks kasutamiseks ettenähtud teabe avalikustamise või väljastamise või Andmekaitse Inspektsiooni ettekirjutuse täitmata jätmise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Käesolevas paragrahvis sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313) sätteid. (3) Käesolevas paragrahvis sätestatud väärtegude kohtuväline menetleja on Andmekaitse Inspektsioon.",
      "rdfs:label": {
        "@value": "AVTS_Par_54_1 (redaktsioon 556659)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "556659",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVTS_Par_54_1_v822692"
      },
      "estleg:versionValidTo": {
