      }
    },
    {
      "@id": "estleg:AVTS_Par_68_v191530",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_68"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "AVTS_Par_68 (redaktsioon 191530)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "191530"
    },
    {
      "@id": "estleg:AVTS_Par_69_v26643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_69"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2001. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "AVTS_Par_69 (redaktsioon 26643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26643"
    },
    {
      "@id": "estleg:AVTS_Par_7_v26643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teabenõudja on iga isik, kes esitab teabevaldajale teabenõude käesolevas seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "AVTS_Par_7 (redaktsioon 26643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26643"
    },
    {
      "@id": "estleg:AVTS_Par_8_v26643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juurdepääs teabele võimaldatakse teabevaldaja poolt: teabenõude täitmisega; teabe avalikustamisega. (2) Teabe avalikustamine on teabevaldaja poolt seadusega sätestatud korras teabele juurdepääsu võimaldamine, ilma et selleks peaks teabenõuet esitama.",
      "rdfs:label": {
        "@value": "AVTS_Par_8 (redaktsioon 26643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26643",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVTS_Par_8_v119122012004"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVTS_Par_8_v119122012004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juurdepääs teabele võimaldatakse teabevaldaja poolt: teabenõude täitmisega; teabe avalikustamisega. (2) Teabe avalikustamine on teabevaldaja poolt seadusega sätestatud korras teabele juurdepääsu võimaldamine, ilma et selleks peaks teabenõuet esitama. (3) Teabele juurdepääs hõlmab ka õigust seda teavet taaskasutada.",
      "rdfs:label": {
        "@value": "AVTS_Par_8 (redaktsioon 119122012004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119122012004",
      "estleg:supersededByVersion": {
        "@id": "estleg:AVTS_Par_8_v106012016007"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:AVTS_Par_8_v106012016007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juurdepääs teabele võimaldatakse teabevaldaja poolt: teabenõude täitmisega; teabe avalikustamisega. (2) Teabe avalikustamine on teabevaldaja poolt seadusega sätestatud korras teabele juurdepääsu võimaldamine, ilma et selleks peaks teabenõuet esitama. (3) Avaandmetele juurdepääs hõlmab ka õigust seda teavet taaskasutada. Kui teabevaldaja on seadnud teabe üldisele kasutamisele tingimusi litsentsi abil, siis tuleb teavet kasutada vastavalt litsentsi tingimustele.",
      "rdfs:label": {
        "@value": "AVTS_Par_8 (redaktsioon 106012016007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106012016007"
    },
    {
      "@id": "estleg:AVTS_Par_9_v26643",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:AVTS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teabevaldaja on kohustatud võimaldama juurdepääsu tema valduses olevale teabele seaduses sätestatud korras. (2) Teabele juurdepääsu võimaldamisel on teabevaldaja kohustatud: tagama juurdepääsu neile dokumentidele, millele teabenõudja juurdepääsu taotleb ja millele teabenõudjal on juurdepääsuõigus; pidama arvestust tema valduses olevate dokumentide üle; avalikustama avalikustamisele kuuluva teabe seaduses sätestatud korras; andma avalikkusele korrapäraselt teavet avalike ülesannete täitmisest; abistama teabenõudjat; teavitama teabenõudjat dokumentide suhtes kehtivatest juurdepääsupiirangutest; tagama teabe juurdepääsupiirangutest kinnipidamise; mitte andma teadvalt eksitavat, tegelikkusele mittevastavat või ebaõiget teavet ning kontrollima kahtluse korral väljastatava teabe õigsust ja vastavust tegelikkusele.",
      "rdfs:label": {
        "@value": "AVTS_Par_9 (redaktsioon 26643)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "26643"
    }
  ]
}
