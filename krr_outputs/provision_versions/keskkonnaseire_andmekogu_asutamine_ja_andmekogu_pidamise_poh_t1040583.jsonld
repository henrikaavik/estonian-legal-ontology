    {
      "@id": "estleg:Reg_1040583_Par_10_v1040583",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040583_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seirenäitaja kohta kantakse andmekogusse järgmised andmed: 1 1) nimetus; 2 2) tüüp; 3 3) grupiline kuuluvus; 4 4) vajadusel seos teiste näitajatega; 5 5) ühik või ühikud; 6 6) analüüsi- või vaatlusmeetod või -metoodika; 7 7) normatiivid, kui need on kehtestatud; 8 8) seiretöö käigus saadud näitaja väärtus. Seirenäitaja kohta kantakse andmekogusse järgmised andmed: nimetus; tüüp; grupiline kuuluvus; vajadusel seos teiste näitajatega; ühik või ühikud; analüüsi- või vaatlusmeetod või -metoodika; normatiivid, kui need on kehtestatud; seiretöö käigus saadud näitaja väärtus.",
      "rdfs:label": {
        "@value": "Reg_1040583_Par_10 (redaktsioon 1040583)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040583",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040583",
      "estleg:sourceAct": "Keskkonnaseire andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1040583 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040583_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040583_Par_11_v1040583",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040583_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Seirenäitaja väärtuse määramiseks kasutatud mõõtmise või vaatluse kohta kantakse andmekogusse andmete võrreldavuse ja usaldusväärsuse tagamiseks järgmised andmed: 1 1) proovivõtu- või vaatlusmeetodi või metoodika kirjeldus; 2 2) analüüsimeetodi või -metoodika kirjeldus; 3 3) proovi võtmise või vaatluse toimumise aeg. Seirenäitaja väärtuse määramiseks kasutatud mõõtmise või vaatluse kohta kantakse andmekogusse andmete võrreldavuse ja usaldusväärsuse tagamiseks järgmised andmed: proovivõtu- või vaatlusmeetodi või metoodika kirjeldus; analüüsimeetodi või -metoodika kirjeldus; proovi võtmise või vaatluse toimumise aeg.",
      "rdfs:label": {
        "@value": "Reg_1040583_Par_11 (redaktsioon 1040583)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040583",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040583",
      "estleg:sourceAct": "Keskkonnaseire andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1040583 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040583_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040583_Par_12_v1040583",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040583_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaseisundi hindamiseks kasutatava tuletatud näitaja kohta kantakse andmekogusse järgmised andmed: 1 1) nimetus; 2 2) hierarhiline tase; 3 3) seisundihinnangu klassifikaator; 4 4) saamise algoritm või metoodika; 5 5) vajadusel seos teiste näitajatega; 6 6) väärtus ja vajadusel ühik; 7 7) hinnangu usaldusväärsus. Keskkonnaseisundi hindamiseks kasutatava tuletatud näitaja kohta kantakse andmekogusse järgmised andmed: nimetus; hierarhiline tase; seisundihinnangu klassifikaator; saamise algoritm või metoodika; vajadusel seos teiste näitajatega; väärtus ja vajadusel ühik; hinnangu usaldusväärsus.",
      "rdfs:label": {
        "@value": "Reg_1040583_Par_12 (redaktsioon 1040583)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040583",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040583",
      "estleg:sourceAct": "Keskkonnaseire andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1040583 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040583_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040583_Par_13_v1040583",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040583_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu võtab püsivate seirekohtade ja seireobjektide andmed Eesti Looduse Infosüsteemist EELIS (edaspidi EELIS). Andmekogu võtab püsivate seirekohtade ja seireobjektide andmed Eesti Looduse Infosüsteemist EELIS (edaspidi EELIS). 2 (2) Käesoleva määruse tähenduses on seirekoht seirejaam, -ala või -koht, kus toimuvad proovivõtmised, vaatlused ja mõõtmised. Käesoleva määruse tähenduses on seirekoht seirejaam, -ala või -koht, kus toimuvad proovivõtmised, vaatlused ja mõõtmised. 3 (3) Käesoleva määruse tähenduses on seireobjekt seirekohaga seotud objekt, mida või keda seiretöö käigus seiratakse. Käesoleva määruse tähenduses on seireobjekt seirekohaga seotud objekt, mida või keda seiretöö käigus seiratakse. 4 (4) Uus ajutine mõõtekoht on käesoleva määruse tähenduses seirekoht, mida oma ajutise iseloomu tõttu ei registreerita EELISes, kuid mis kuulub mõne seirejaama või -ala koosseisu. Uus ajutine mõõtekoht on käesoleva määruse tähenduses seirekoht, mida oma ajutise iseloomu tõttu ei registreerita EELISes, kuid mis kuulub mõne seirejaama või -ala koosseisu. 5 (5) Andmekogusse kantakse uute ajutiste mõõtekohtade kohta järgmised andmed: 1 1) mõõtekohaga seotud seireala või -jaam; 2 2) mõõtekoha kood; 3 3) mõõtekoha staatus; 4 4) mõõtekoha allikas; 5 5) mõõtekoha nimetus; 6 6) mõõtekoha salastatus; 7 7) mõõtekoha geograafiline asukoht; 8 8) mõõtekoha ruumikuju; 9 9) mõõtekohaga seotud objekt, mida või keda seiratakse. Andmekogusse kantakse uute ajutiste mõõtekohtade kohta järgmised andmed: mõõtekohaga seotud seireala või -jaam; mõõtekoha kood; mõõtekoha staatus; mõõtekoha allikas; mõõtekoha nimetus; mõõtekoha salastatus; mõõtekoha geograafiline asukoht; mõõtekoha ruumikuju; mõõtekohaga seotud objekt, mida või keda seiratakse.",
      "rdfs:label": {
        "@value": "Reg_1040583_Par_13 (redaktsioon 1040583)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040583",
