      "estleg:sourceAct": "Keskkonnaseire andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1040583 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040583_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040583_Par_17_v1040583",
      "@type": [
        "owl:NamedIndividual",
