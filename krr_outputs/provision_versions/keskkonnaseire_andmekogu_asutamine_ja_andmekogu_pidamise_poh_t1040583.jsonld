      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu tegevuse lõpetamise otsustab valdkonna eest vastutav minister määrusega. Andmekogu tegevuse lõpetamise otsustab valdkonna eest vastutav minister määrusega. 2 (2) Andmekogu lõpetamine toimub kooskõlas arhiiviseadusega ning avaliku teabe seaduse § 439 lõike 1 punkti 6 alusel kehtestatud õigusaktiga. Andmekogu lõpetamine toimub kooskõlas arhiiviseadusega ning avaliku teabe seaduse § 439 lõike 1 punkti 6 alusel kehtestatud õigusaktiga.",
      "rdfs:label": {
        "@value": "Reg_1040583_Par_21 (redaktsioon 1040583)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040583",
