      }
    },
    {
      "@id": "estleg:Reg_302663_Par_12_v302663",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302663_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse ning maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse ning maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_302663_Par_12 (redaktsioon 302663)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302663",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302663",
      "estleg:sourceAct": "Tudusoo looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_302663 § 12",
      "estleg:partOfAct": {
