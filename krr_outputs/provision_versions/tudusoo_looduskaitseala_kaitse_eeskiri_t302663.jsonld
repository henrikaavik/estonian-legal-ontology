      }
    },
    {
      "@id": "estleg:Reg_302663_Par_13_v302663",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302663_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 5–8 sätestatut; 3 3) jahipidamine 1. juulist 31. jaanuarini. Piiranguvööndis on lubatud: majandustegevus; uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 5–8 sätestatut; jahipidamine 1. juulist 31. jaanuarini. 2 (2) Kaitseala valitseja nõusolekul on lubatud uuendusraie 1. septembrist 31. jaanuarini, kusjuures: 1 1) peab säilitama koosluse liikide ja vanuse mitmekesisuse; 2 2) turberaie on lubatud kuni 2 hektaril häil- ja veerraietena, kui esineb looduslik uuendus kasvukohatüübile sobivatest puuliikidest; 3 3) raielankide vahele peab jääma vähemalt 100 meetri laiune riba üle 60 aasta vanust raiest puutumatut puistut; 4 4) metskonna kvartalites RO183, RO184, RO188, RO193 ja RO194 ei tohi üle 60-aastaste puistute osakaal jääda väiksemaks kui 70%; 5 5) metskonna kvartalites PV024, PV025, PV033, PV040, PV041, PV046, PV068, PV069, PV070, PV071 ja PV072 ei tohi üle 60-aastaste puistute osakaal jääda väiksemaks kui 50%; 6 6) teistes piiranguvööndi kvartalites ei tohi üle 60-aastaste puistute osakaal jääda väiksemaks kui 60%. Kaitseala valitseja nõusolekul on lubatud uuendusraie 1. septembrist 31. jaanuarini, kusjuures: peab säilitama koosluse liikide ja vanuse mitmekesisuse; turberaie on lubatud kuni 2 hektaril häil- ja veerraietena, kui esineb looduslik uuendus kasvukohatüübile sobivatest puuliikidest; raielankide vahele peab jääma vähemalt 100 meetri laiune riba üle 60 aasta vanust raiest puutumatut puistut; metskonna kvartalites RO183, RO184, RO188, RO193 ja RO194 ei tohi üle 60-aastaste puistute osakaal jääda väiksemaks kui 70%; metskonna kvartalites PV024, PV025, PV033, PV040, PV041, PV046, PV068, PV069, PV070, PV071 ja PV072 ei tohi üle 60-aastaste puistute osakaal jääda väiksemaks kui 50%; teistes piiranguvööndi kvartalites ei tohi üle 60-aastaste puistute osakaal jääda väiksemaks kui 60%.",
      "rdfs:label": {
        "@value": "Reg_302663_Par_13 (redaktsioon 302663)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302663",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/302663",
      "estleg:sourceAct": "Tudusoo looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_302663 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_302663_Map"
      }
    },
    {
      "@id": "estleg:Reg_302663_Par_14_v302663",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302663_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine; 3 3) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal, metsamaal ning haritaval maal veekogule lähemal kui 200 meetrit; 6 6) puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal, metsamaal ning haritaval maal veekogule lähemal kui 200 meetrit; puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_302663_Par_14 (redaktsioon 302663)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302663",
