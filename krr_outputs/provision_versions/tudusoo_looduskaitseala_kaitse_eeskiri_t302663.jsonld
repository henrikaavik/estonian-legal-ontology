      }
    },
    {
      "@id": "estleg:Reg_302663_Par_7_v302663",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302663_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on üksteist sihtkaitsevööndit: 1 1) Alekvere sihtkaitsevöönd; 2 2) Järvesoo sihtkaitsevöönd; 3 3) Kõrve sihtkaitsevöönd; 4 4) Küüska sihtkaitsevöönd; 5 5) Luusaare sihtkaitsevöönd; 6 6) Pasti sihtkaitsevöönd; 7 7) Peressaare sihtkaitsevöönd; 8 8) Punasoo sihtkaitsevöönd; 9 9) Saunakünka sihtkaitsevöönd; 10 10) Tudusilla sihtkaitsevöönd; 11 11) Udriku sihtkaitsevöönd. Kaitsealal on üksteist sihtkaitsevööndit: Alekvere sihtkaitsevöönd; Järvesoo sihtkaitsevöönd; Kõrve sihtkaitsevöönd; Küüska sihtkaitsevöönd; Luusaare sihtkaitsevöönd; Pasti sihtkaitsevöönd; Peressaare sihtkaitsevöönd; Punasoo sihtkaitsevöönd; Saunakünka sihtkaitsevöönd; Tudusilla sihtkaitsevöönd; Udriku sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_302663_Par_7 (redaktsioon 302663)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302663",
