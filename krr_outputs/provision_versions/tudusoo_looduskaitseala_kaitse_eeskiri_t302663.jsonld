      }
    },
    {
      "@id": "estleg:Reg_302663_Par_11_v302663",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_302663_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Tudusoo piiranguvöönd. Kaitsealal on Tudusoo piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_302663_Par_11 (redaktsioon 302663)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "302663",
