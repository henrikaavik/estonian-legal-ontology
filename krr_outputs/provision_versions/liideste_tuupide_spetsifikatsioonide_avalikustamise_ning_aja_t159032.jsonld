      "estleg:provisionRef": "Reg_159032 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159032_Map"
      }
    },
    {
      "@id": "estleg:Reg_159032_Par_3_v159032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159032_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sideettevõtja peab avalikustama liideste tüüpide spetsifikatsioonid, kui tema poolt sideteenuse osutamise käigus lõppkasutajale pakutava liidese kaudu osutatakse vähemalt üht järgnevatest teenustest: 1 1) andmesideteenus; 2 2) mobiiltelefoniteenus; 3 3) püsiliiniteenus; 4 4) telefoniteenus. Sideettevõtja peab avalikustama liideste tüüpide spetsifikatsioonid, kui tema poolt sideteenuse osutamise käigus lõppkasutajale pakutava liidese kaudu osutatakse vähemalt üht järgnevatest teenustest: andmesideteenus; mobiiltelefoniteenus; püsiliiniteenus; telefoniteenus.",
      "rdfs:label": {
        "@value": "Reg_159032_Par_3 (redaktsioon 159032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159032",
