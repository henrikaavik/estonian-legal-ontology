    {
      "@id": "estleg:Reg_312417_Par_7_v312417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312417_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Viivitamatult pärast säilmete uude asukohta paigutamist tähistatakse sõjahaud vastavalt kaitseministri või tema määratud asutuse või tema volitatud isiku käskkirjale. RT I 2023-04-21 1 121042023001 2023-04-24 Viivitamatult pärast säilmete uude asukohta paigutamist tähistatakse sõjahaud vastavalt kaitseministri või tema määratud asutuse või tema volitatud isiku käskkirjale. 2 (2) Uus sõjahaud registreeritakse sõjahaudade nimekirjas. Uus sõjahaud registreeritakse sõjahaudade nimekirjas.",
      "rdfs:label": {
        "@value": "Reg_312417_Par_7 (redaktsioon 312417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312417",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312417",
      "estleg:sourceAct": "Sõjaohvrite säilmete ümbermatmise nõuded",
      "estleg:provisionRef": "Reg_312417 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312417_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312417_Par_8_v312417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312417_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastaval kinnistul tuleb kolme kuu jooksul ümbermatmistööde ja hauarajatiste teisaldamistööde lõppemisest taastada tööde teostamise eelsele seisundile võimalikult lähedane olukord, välja arvatud haua juurde kuulunud tähised ja rajatised. Vastaval kinnistul tuleb kolme kuu jooksul ümbermatmistööde ja hauarajatiste teisaldamistööde lõppemisest taastada tööde teostamise eelsele seisundile võimalikult lähedane olukord, välja arvatud haua juurde kuulunud tähised ja rajatised. 2 (2) Korrastustööde teostamisel kohustub ümbermatmise läbiviija arvestama kinnistu omaniku põhjendatud ettepanekutega korrastustööde sisu ja läbiviimise aja osas. Korrastustööde teostamisel kohustub ümbermatmise läbiviija arvestama kinnistu omaniku põhjendatud ettepanekutega korrastustööde sisu ja läbiviimise aja osas.",
      "rdfs:label": {
        "@value": "Reg_312417_Par_8 (redaktsioon 312417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312417",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312417",
      "estleg:sourceAct": "Sõjaohvrite säilmete ümbermatmise nõuded",
      "estleg:provisionRef": "Reg_312417 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312417_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_312417_Par_9_v312417",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312417_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhul kui sõjahaud on tunnistatud mälestiseks või see asub muinsuskaitsealal (sh muinsuskaitseala piiranguvööndis), kohaldatakse sõjahauale mälestise ja muinsuskaitseala kohta sätestatut «Sõjahaudade kaitse seadusest» ja muudest õigusaktidest tulenevate erisustega. Ümbermatmise läbiviimiseks ei ole vaja «Muinsuskaitseseaduses» sätestatud luba kinnismälestistel seotud tööde läbiviimiseks, tööde eelduseks on üksnes «Sõjahaudade kaitse seaduse» § 13 lõike 3 punktis 2 ja käesoleva määruse § 2 lõikes 2 sätestatud teatiste esitamine. Juhul kui sõjahaud on tunnistatud mälestiseks või see asub muinsuskaitsealal (sh muinsuskaitseala piiranguvööndis), kohaldatakse sõjahauale mälestise ja muinsuskaitseala kohta sätestatut «Sõjahaudade kaitse seadusest» ja muudest õigusaktidest tulenevate erisustega. Ümbermatmise läbiviimiseks ei ole vaja «Muinsuskaitseseaduses» sätestatud luba kinnismälestistel seotud tööde läbiviimiseks, tööde eelduseks on üksnes «Sõjahaudade kaitse seaduse» § 13 lõike 3 punktis 2 ja käesoleva määruse § 2 lõikes 2 sätestatud teatiste esitamine.",
      "rdfs:label": {
        "@value": "Reg_312417_Par_9 (redaktsioon 312417)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312417",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/312417",
      "estleg:sourceAct": "Sõjaohvrite säilmete ümbermatmise nõuded",
      "estleg:provisionRef": "Reg_312417 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312417_Map_2026"
      }
    },
