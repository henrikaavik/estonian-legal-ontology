        "@id": "estleg:Reg_306322_Map"
      }
    },
    {
      "@id": "estleg:Reg_306322_Par_10_v306322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
