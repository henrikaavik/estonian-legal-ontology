      }
    },
    {
      "@id": "estleg:Reg_306322_Par_9_v306322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306322_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) olemasoleva maaparandussüsteemi hoiutööd maaparandussüsteemi väljaspool sihtkaitsevööndit asuvate osade toimimise tagamiseks; 2 2) veerežiimi taastamine; 3 3) koosluste kujundamine vastavalt kaitse-eesmärgile; 4 4) kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; 5 5) tee, tehnovõrgu rajatise ja tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks ja olemasolevate ehitiste hooldustööd. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: olemasoleva maaparandussüsteemi hoiutööd maaparandussüsteemi väljaspool sihtkaitsevööndit asuvate osade toimimise tagamiseks; veerežiimi taastamine; koosluste kujundamine vastavalt kaitse-eesmärgile; kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; tee, tehnovõrgu rajatise ja tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks ja olemasolevate ehitiste hooldustööd.",
      "rdfs:label": {
        "@value": "Reg_306322_Par_9 (redaktsioon 306322)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306322",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306322",
      "estleg:sourceAct": "Saarjõe maastikukaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306322 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306322_Map"
      }
    },
