      "estleg:sourceAct": "Saarjõe maastikukaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306322 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306322_Map"
      }
    },
    {
      "@id": "estleg:Reg_306322_Par_13_v306322",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306322_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tõrvaaugu piiranguvööndi kaitse-eesmärk on kuuse genofondi ja maastiku kaitse. Tõrvaaugu piiranguvööndi kaitse-eesmärk on kuuse genofondi ja maastiku kaitse. 2 (2) Pärassaare-Nõmmitsa piiranguvööndi kaitse-eesmärk on kaitsealuse liigi elupaiga kaitse. Pärassaare-Nõmmitsa piiranguvööndi kaitse-eesmärk on kaitsealuse liigi elupaiga kaitse. 3 (3) Saarjõe piiranguvööndi kaitse-eesmärk on poollooduslike koosluste, loodusliku jõe ja maastiku kaitse. Saarjõe piiranguvööndi kaitse-eesmärk on poollooduslike koosluste, loodusliku jõe ja maastiku kaitse.",
      "rdfs:label": {
        "@value": "Reg_306322_Par_13 (redaktsioon 306322)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306322",
