      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” muutmine (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” muutmine"
    },
    {
      "@id": "estleg:Reg_1038861_Par_1_v1038861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038861_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla ühinemise teel moodustatakse uus haldusüksus. Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla ühinemise teel moodustatakse uus haldusüksus. 2 (2) Uue haldusüksuse nimeks määratakse Saaremaa vald. Uue haldusüksuse nimeks määratakse Saaremaa vald. 3 (3) Haldusterritoriaalse korralduse ja haldusüksuse piiride muutmise põhjendused on esitatud määruse seletuskirjas1. Haldusterritoriaalse korralduse ja haldusüksuse piiride muutmise põhjendused on esitatud määruse seletuskirjas1.",
      "rdfs:label": {
        "@value": "Reg_1038861_Par_1 (redaktsioon 1038861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038861",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038861",
      "estleg:sourceAct": "Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” muutmine",
      "estleg:provisionRef": "Reg_1038861 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038861_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038861_Par_2_v1038861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038861_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatava Saaremaa valla piiriks on senise Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla piir, välja arvatud nende omavahelises osas. Haldusterritoriaalse korralduse muutmise käigus moodustatava Saaremaa valla piiriks on senise Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla piir, välja arvatud nende omavahelises osas. 2 (2) Maa-amet kannab Saaremaa valla piiri riigi maakatastri kaardile. Maa-amet kannab Saaremaa valla piiri riigi maakatastri kaardile.",
      "rdfs:label": {
        "@value": "Reg_1038861_Par_2 (redaktsioon 1038861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038861",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038861",
      "estleg:sourceAct": "Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” muutmine",
      "estleg:provisionRef": "Reg_1038861 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038861_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038861_Par_3_v1038861",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038861_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haldusterritoriaalse korralduse muutmise käigus moodustatavale Saaremaa vallale makstakse ühinemistoetust haldusreformi seaduse §-des 20‒23 sätestatud korras. Haldusterritoriaalse korralduse muutmise käigus moodustatavale Saaremaa vallale makstakse ühinemistoetust haldusreformi seaduse §-des 20‒23 sätestatud korras. 2 (2) Ühinemistoetust arvutatakse senise Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Salme valla, Torgu valla ja Valjala valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Salme valla, Torgu valla ja Valjala valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. Ühinemistoetust arvutatakse senise Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Salme valla, Torgu valla ja Valjala valla volikogu algatatud haldusterritoriaalse korralduse muutmist taotlenud Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Salme valla, Torgu valla ja Valjala valla elanike arvu põhjal rahvastikuregistri andmetel 1. jaanuari 2017. a seisuga. 3 (3) Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Saaremaa vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras. Käesoleva määrusega haldusterritoriaalse korralduse muutmise tulemusena moodustatavale Saaremaa vallale hüvitatakse riigieelarvest Vabariigi Valitsuse algatatud ühinemisega seotud tegelikud tehtud kulud kuludokumentide alusel haldusreformi seaduse § 24 lõike 2 alusel kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1038861_Par_3 (redaktsioon 1038861)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038861",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038861",
      "estleg:sourceAct": "Kihelkonna valla, Kuressaare linna, Laimjala valla, Leisi valla, Lääne-Saare valla, Mustjala valla, Orissaare valla, Pihtla valla, Pöide valla, Salme valla, Torgu valla ja Valjala valla osas haldusterritoriaalse korralduse ja Vabariigi Valitsuse 3. aprilli 1995. a määruse nr 159 „Eesti territooriumi haldusüksuste nimistu kinnitamine” muutmine",
      "estleg:provisionRef": "Reg_1038861 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038861_Map"
      }
    },
