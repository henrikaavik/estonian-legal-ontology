    {
      "@id": "estleg:Reg_1001932_Par_6_v1001932",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001932_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-09-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjoni esimees: 1 1) juhib komisjoni tööd; 2 2) kutsub kokku komisjoni koosoleku ja määrab selle päevakorra; 3 3) juhatab komisjoni koosolekuid; 4 4) kirjutab alla komisjoni otsustele, ettekirjutustele ja teistele komisjoni koostatud dokumentidele; 5 5) hoiab ja kasutab komisjoni pitsatit; 6 6) vajaduse korral kutsub komisjoni tööst osa võtma isikuid, kes komisjoni ei kuulu; 7 7) esindab komisjoni. Komisjoni esimees: juhib komisjoni tööd; kutsub kokku komisjoni koosoleku ja määrab selle päevakorra; juhatab komisjoni koosolekuid; kirjutab alla komisjoni otsustele, ettekirjutustele ja teistele komisjoni koostatud dokumentidele; hoiab ja kasutab komisjoni pitsatit; vajaduse korral kutsub komisjoni tööst osa võtma isikuid, kes komisjoni ei kuulu; esindab komisjoni. 2 (2) Komisjoni esimees annab oma pädevuse piires käskkirju. Komisjoni esimees annab oma pädevuse piires käskkirju. 3 (3) Komisjoni esimehe äraolekul täidab tema ülesandeid Välisministeeriumi esindaja komisjonis. Komisjoni esimehe äraolekul täidab tema ülesandeid Välisministeeriumi esindaja komisjonis.",
      "rdfs:label": {
        "@value": "Reg_1001932_Par_6 (redaktsioon 1001932)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001932",
