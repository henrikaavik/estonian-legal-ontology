      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055099_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055099_Par_10_v1055099",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
