      }
    },
    {
      "@id": "estleg:Reg_1041084_Par_5_v1041084",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041084_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse järgmised majandusaasta aruande taksonoomia alusel koostatud raamatupidamise aastaaruande vormid: 1 1) „Kasumit taotleva raamatupidamiskohustuslase raamatupidamise aastaaruanne” (lisa 1); 2 2) „Kasumit mittetaotleva raamatupidamiskohustuslase raamatupidamise aastaaruanne” (lisa 2); 3 3) „Kasumit taotleva raamatupidamiskohustuslase konsolideeritud raamatupidamise aastaaruanne” (lisa 3); 4 4) „Kasumit taotleva raamatupidamiskohustuslase likvideerimisaruanne, likvideerimise vahearuanne ja lõpparuanne” (lisa 4); 5 5) „Kasumit mittetaotleva raamatupidamiskohustuslase likvideerimisaruanne, likvideerimise vahearuanne ja lõpparuanne” (lisa 5); 6 6) „Kasumit taotleva mikroettevõtja raamatupidamise aastaaruanne” (lisa 6). Määrusega kehtestatakse järgmised majandusaasta aruande taksonoomia alusel koostatud raamatupidamise aastaaruande vormid: „Kasumit taotleva raamatupidamiskohustuslase raamatupidamise aastaaruanne” (lisa 1); „Kasumit mittetaotleva raamatupidamiskohustuslase raamatupidamise aastaaruanne” (lisa 2); „Kasumit taotleva raamatupidamiskohustuslase konsolideeritud raamatupidamise aastaaruanne” (lisa 3); „Kasumit taotleva raamatupidamiskohustuslase likvideerimisaruanne, likvideerimise vahearuanne ja lõpparuanne” (lisa 4); „Kasumit mittetaotleva raamatupidamiskohustuslase likvideerimisaruanne, likvideerimise vahearuanne ja lõpparuanne” (lisa 5); „Kasumit taotleva mikroettevõtja raamatupidamise aastaaruanne” (lisa 6).",
      "rdfs:label": {
        "@value": "Reg_1041084_Par_5 (redaktsioon 1041084)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041084",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041084",
      "estleg:sourceAct": "Majandusaasta aruande taksonoomia ja selle alusel koostatavate raamatupidamise aastaaruande vormide kehtestamine",
      "estleg:provisionRef": "Reg_1041084 § 5",
      "estleg:partOfAct": {
