      "estleg:provisionRef": "Reg_1041084 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041084_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041084_Par_4_v1041084",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041084_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taksonoomia haldaja on Rahandusministeerium. Taksonoomia haldaja on Rahandusministeerium. 2 (2) Taksonoomia registreeritakse riigi infosüsteemi haldussüsteemis. Taksonoomia registreeritakse riigi infosüsteemi haldussüsteemis.",
      "rdfs:label": {
