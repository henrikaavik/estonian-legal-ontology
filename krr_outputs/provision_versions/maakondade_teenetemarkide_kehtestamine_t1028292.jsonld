      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "Reg_1028292_Par_34 (redaktsioon 1028292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028292",
      "estleg:sourceAct": "Maakondade teenetemärkide kehtestamine",
      "estleg:provisionRef": "Reg_1028292 § 34",
      "estleg:partOfAct": {
