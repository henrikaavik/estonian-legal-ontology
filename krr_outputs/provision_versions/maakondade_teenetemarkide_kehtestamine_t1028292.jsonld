      }
    },
    {
      "@id": "estleg:Reg_1028292_Par_32_v1028292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028292_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lõikes 11 nimetatud kohalik omavalitsus või kohalike omavalitsuste ühendus võib otsustada isikult teenetemärk ära võtta, kui: RT I 2017-12-23 34 123122017034 2017-12-29 1 1) on jõustunud kohtuotsus, millega isik on süüdi mõistetud tahtliku kuriteo toimepanemises; 2 2) saavad teatavaks enne teenetemärgi andmist esinenud asjaolud, millest teadmise korral ei oleks teenetemärki antud või 3 3) isiku hilisem käitumine on olnud nii vääritu, et see välistaks talle teenetemärgi andmise. Lõikes 11 nimetatud kohalik omavalitsus või kohalike omavalitsuste ühendus võib otsustada isikult teenetemärk ära võtta, kui: on jõustunud kohtuotsus, millega isik on süüdi mõistetud tahtliku kuriteo toimepanemises; saavad teatavaks enne teenetemärgi andmist esinenud asjaolud, millest teadmise korral ei oleks teenetemärki antud või isiku hilisem käitumine on olnud nii vääritu, et see välistaks talle teenetemärgi andmise. 2 (2) Isik, kellelt lõikes 11 nimetatud kohalik omavalitsus või kohalike omavalitsuste ühendus on teenetemärgi ära võtnud, peab teenetemärgi andjale tagastama. RT I 2017-12-23 34 123122017034 2017-12-29 Isik, kellelt lõikes 11 nimetatud kohalik omavalitsus või kohalike omavalitsuste ühendus on teenetemärgi ära võtnud, peab teenetemärgi andjale tagastama.",
      "rdfs:label": {
        "@value": "Reg_1028292_Par_32 (redaktsioon 1028292)",
        "@language": "et"
      },
