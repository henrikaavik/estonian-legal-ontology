    },
    {
      "@id": "estleg:Reg_1028292_Par_31_v1028292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028292_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenetemärki kantakse kooskõlas teenetemärkide kandmise hea tavaga. Teenetemärki kantakse kooskõlas teenetemärkide kandmise hea tavaga. 2 (2) Kaelaskantavat teenetemärki ei kanta samaaegselt Vabariigi Presidendi poolt antud riikliku autasuga. Kaelaskantavat teenetemärki ei kanta samaaegselt Vabariigi Presidendi poolt antud riikliku autasuga. 3 (3) Järvamaa vapimärki ja Järvamaa teenetemedalit ei kanta samaaegselt. Järvamaa vapimärki ja Järvamaa teenetemedalit ei kanta samaaegselt. 4 (4) Õigus teenetemärki kanda on üksnes isikul, kellele see on antud. Õigus teenetemärki kanda on üksnes isikul, kellele see on antud.",
      "rdfs:label": {
        "@value": "Reg_1028292_Par_31 (redaktsioon 1028292)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028292",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028292",
      "estleg:sourceAct": "Maakondade teenetemärkide kehtestamine",
      "estleg:provisionRef": "Reg_1028292 § 31",
      "estleg:partOfAct": {
