      "estleg:provisionRef": "Reg_1028292 § 32",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028292_Map"
      }
    },
    {
      "@id": "estleg:Reg_1028292_Par_33_v1028292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
