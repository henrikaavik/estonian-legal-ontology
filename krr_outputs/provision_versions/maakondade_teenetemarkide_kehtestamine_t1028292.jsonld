        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. märtsil 2015. aastal. Määrus jõustub 1. märtsil 2015. aastal.",
      "rdfs:label": {
        "@value": "Reg_1028292_Par_33 (redaktsioon 1028292)",
        "@language": "et"
      },
