    {
      "@id": "estleg:Reg_1028292_Par_3_v1028292",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028292_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ida-Viru maakonna teenetemärk on Ida-Virumaa teenetemärk. Ida-Viru maakonna teenetemärk on Ida-Virumaa teenetemärk. 2 (2) Ida-Virumaa teenetemärk on hõbedast hõbedaste ja kuldsete kiirtega kaheksanurkne täht, mille keskel on Ida-Viru maakonna sinise ja punase emailiga viimistletud vapp. Teenetemärgi läbimõõt on 37 millimeetrit ning vapi kõrgus on 21 millimeetrit. Teenetemärgi tagakülg on sile, sellele on löödud hõbedaproov ning graveeritud teenetemärgi number. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 3. Ida-Virumaa teenetemärk on hõbedast hõbedaste ja kuldsete kiirtega kaheksanurkne täht, mille keskel on Ida-Viru maakonna sinise ja punase emailiga viimistletud vapp. Teenetemärgi läbimõõt on 37 millimeetrit ning vapi kõrgus on 21 millimeetrit. Teenetemärgi tagakülg on sile, sellele on löödud hõbedaproov ning graveeritud teenetemärgi number. Teenetemärgi kujutis on esitatud käesoleva määruse lisas 3.",
      "rdfs:label": {
