    {
      "@id": "estleg:Reg_155163_Par_10_11_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_10_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puuetega inimeste sotsiaaltoetuste taotlusele kantakse lisaks puuetega inimeste sotsiaaltoetuste seaduse § 16 lõike 2 punktis 1 nimetatud andmetele andmed taotleja elamisloa kohta, kui taotleja viibib Eestis elamisloa alusel, ja informatsioon kojukande vajaduse kohta. RT I 2016-01-05 9 105012016009 2016-07-01 Puuetega inimeste sotsiaaltoetuste taotlusele kantakse lisaks puuetega inimeste sotsiaaltoetuste seaduse § 16 lõike 2 punktis 1 nimetatud andmetele andmed taotleja elamisloa kohta, kui taotleja viibib Eestis elamisloa alusel, ja informatsioon kojukande vajaduse kohta.",
      "rdfs:label": {
        "@value": "Reg_155163_Par_10_11 (redaktsioon 155163)",
        "@language": "et"
      },
