    {
      "@id": "estleg:Reg_155163_Par_2_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puudega lapse toetuse taotlemiseks esitatakse täiendavalt lapse sünnitunnistus, kui andmed ei ole kättesaadavad rahvastikuregistrist. RT I 2012-12-29 59 129122012059 2013-01-01 58 Puudega lapse toetuse taotlemiseks esitatakse täiendavalt lapse sünnitunnistus, kui andmed ei ole kättesaadavad rahvastikuregistrist.",
      "rdfs:label": {
        "@value": "Reg_155163_Par_2 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155163_Par_3_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
