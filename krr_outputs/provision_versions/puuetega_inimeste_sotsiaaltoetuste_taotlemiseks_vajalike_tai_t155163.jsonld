        "@value": "Reg_155163_Par_6 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155163_Par_7_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Täienduskoolitustoetuse taotlemiseks esitatakse täiendavalt: 1 1) tööraamat või muu töötamist tõendav dokument, kui andmeid töötamise kohta ei ole kantud maksukorralduse seaduse §-s 251 sätestatud töötamise registrist riiklikku pensionikindlustuse registrisse; RT I 2014-06-28 8 128062014008 2014-07-01 34 2 2) dokument täienduskoolituskulude kohta. Täienduskoolitustoetuse taotlemiseks esitatakse täiendavalt: tööraamat või muu töötamist tõendav dokument, kui andmeid töötamise kohta ei ole kantud maksukorralduse seaduse §-s 251 sätestatud töötamise registrist riiklikku pensionikindlustuse registrisse; dokument täienduskoolituskulude kohta.",
      "rdfs:label": {
        "@value": "Reg_155163_Par_7 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155163_Par_8_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puuetega inimeste sotsiaaltoetuste taotlemiseks võõras- või kasuvanemale, eestkostjale või hoolduspere vanemale esitatakse täiendavalt eestkostja määramise kohtumäärus, hoolduspere vanemaga sõlmitud leping või valla- või linnavalitsuse korraldus. RT I 2018-01-31 1 131012018001 2018-02-03 1 Puuetega inimeste sotsiaaltoetuste taotlemiseks võõras- või kasuvanemale, eestkostjale või hoolduspere vanemale esitatakse täiendavalt eestkostja määramise kohtumäärus, hoolduspere vanemaga sõlmitud leping või valla- või linnavalitsuse korraldus.",
      "rdfs:label": {
        "@value": "Reg_155163_Par_8 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155163_Par_9_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sotsiaalkindlustusametil on õigus nõuda vajaduse korral muid dokumente, mis tõendavad sotsiaaltoetuste taotleja õigust toetusele. RTL 2008 77 1068 13027263 2008-10-01+03:00 Sotsiaalkindlustusametil on õigus nõuda vajaduse korral muid dokumente, mis tõendavad sotsiaaltoetuste taotleja õigust toetusele.",
      "rdfs:label": {
        "@value": "Reg_155163_Par_9 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
