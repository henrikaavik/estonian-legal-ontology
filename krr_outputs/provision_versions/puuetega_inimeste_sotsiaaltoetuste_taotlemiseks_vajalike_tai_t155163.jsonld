      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "Reg_155163_Par_3 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155163_Par_4_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puudega vanema toetuse taotlemiseks esitatakse täiendavalt: 1 1) lapse sünnitunnistus, kui andmed ei ole kättesaadavad rahvastikuregistrist; RT I 2012-12-29 59 129122012059 2013-01-01 58 2 2) õppeasutuse teatis, kui toetust taotleb 16-19-aastast välismaal õppivat last kasvatav vanem; RT I 2016-01-05 9 105012016009 2017-01-01 3 3) perekonnaseisu tõendav dokument või toetuse taotleja omakäeline kinnitus, et ta kasvatab last üksinda, kui andmed ei ole kättesaadavad rahvastikuregistrist ning toetust taotleb last üksi kasvatav puudega isik; RT I 2012-12-29 59 129122012059 2013-01-01 58 4 4) teise vanema kirjalik nõusolek, kui toetust taotleb üks puudega vanematest. RT I 2014-12-18 16 118122014016 2015-01-01 73 Puudega vanema toetuse taotlemiseks esitatakse täiendavalt: lapse sünnitunnistus, kui andmed ei ole kättesaadavad rahvastikuregistrist; õppeasutuse teatis, kui toetust taotleb 16-19-aastast välismaal õppivat last kasvatav vanem; perekonnaseisu tõendav dokument või toetuse taotleja omakäeline kinnitus, et ta kasvatab last üksinda, kui andmed ei ole kättesaadavad rahvastikuregistrist ning toetust taotleb last üksi kasvatav puudega isik; teise vanema kirjalik nõusolek, kui toetust taotleb üks puudega vanematest.",
      "rdfs:label": {
        "@value": "Reg_155163_Par_4 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_155163_Par_5_v155163",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155163_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppetoetuse taotlemiseks esitatakse täiendavalt: 1 1) õppeasutuse teatis välisriigis õppimise kohta; RT I 2016-01-05 9 105012016009 2017-01-01 2 2) dokument puudest tingitud ja õppetööga seotud lisakulude olemasolu või selliste kulutuste tegemise vajaduse kohta; 3 3) kehtetu - RT I 2014-06-28 8 128062014008 2014-07-01 34 Õppetoetuse taotlemiseks esitatakse täiendavalt: õppeasutuse teatis välisriigis õppimise kohta; dokument puudest tingitud ja õppetööga seotud lisakulude olemasolu või selliste kulutuste tegemise vajaduse kohta; kehtetu -",
      "rdfs:label": {
        "@value": "Reg_155163_Par_5 (redaktsioon 155163)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155163",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155163",
      "estleg:sourceAct": "Puuetega inimeste sotsiaaltoetuste taotlemiseks vajalike täiendavate dokumentide loetelu ja taotluse andmete loetelu",
      "estleg:provisionRef": "Reg_155163 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155163_Map_2026"
      }
    },
    {
