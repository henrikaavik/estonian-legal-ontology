      "estleg:versionText": "Määrus kehtestab nõuded elektroonilise teabevahetuse seadmele. Määrus kehtestab nõuded elektroonilise teabevahetuse seadmele.",
      "rdfs:label": {
        "@value": "Reg_1039672_Par_1 (redaktsioon 1039672)",
        "@language": "et"
      },
