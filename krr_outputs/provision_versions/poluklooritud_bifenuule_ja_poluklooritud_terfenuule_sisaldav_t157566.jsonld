    {
      "@id": "estleg:Reg_157566_Par_3_v157566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157566_Par_3"
