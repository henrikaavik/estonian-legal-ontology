    {
      "@id": "estleg:Reg_1033626_Par_1_v1033626",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033626_Par_1"
