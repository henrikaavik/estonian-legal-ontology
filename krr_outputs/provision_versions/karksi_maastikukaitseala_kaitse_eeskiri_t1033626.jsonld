      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033626_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-03-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) olemasolevate maaparandussüsteemide hoiutööd ja loodusliku veerežiimi taastamine; 2 2) koosluse kujundamine vastavalt kaitse-eesmärgile; 3 3) olemasolevate ehitiste hooldustööd; 4 4) tee, tehnovõrgu või muu rajatise ehitamine kaitseala või kaitsealal paikneva kinnistu tarbeks või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks; 5 5) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: olemasolevate maaparandussüsteemide hoiutööd ja loodusliku veerežiimi taastamine; koosluse kujundamine vastavalt kaitse-eesmärgile; olemasolevate ehitiste hooldustööd; tee, tehnovõrgu või muu rajatise ehitamine kaitseala või kaitsealal paikneva kinnistu tarbeks või tootmisotstarbeta ehitise püstitamine kaitseala tarbeks; kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus.",
      "rdfs:label": {
        "@value": "Reg_1033626_Par_10 (redaktsioon 1033626)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1033626",
