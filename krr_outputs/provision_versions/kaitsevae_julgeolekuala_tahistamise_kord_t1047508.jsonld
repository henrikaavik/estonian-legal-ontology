      "estleg:provisionRef": "Reg_1047508 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047508_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047508_Par_6_v1047508",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047508_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-08-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 3–5 nimetatud tähistele võib teksti alla lisada punast värvi läbiva joonega ringi läbimõõduga kaheksa sentimeetrit, mille keskel on musta värvi fotoaparaadi, mikrofoni või mehitamata õhusõiduki kujutis. Paragrahvides 3–5 nimetatud tähistele võib teksti alla lisada punast värvi läbiva joonega ringi läbimõõduga kaheksa sentimeetrit, mille keskel on musta värvi fotoaparaadi, mikrofoni või mehitamata õhusõiduki kujutis.",
      "rdfs:label": {
        "@value": "Reg_1047508_Par_6 (redaktsioon 1047508)",
