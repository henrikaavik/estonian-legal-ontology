    {
      "@id": "estleg:Reg_1047508_Par_8_v1047508",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047508_Par_8"
