      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Postiseadus_Par_9_v695918",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
