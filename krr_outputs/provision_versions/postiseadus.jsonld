    {
      "@id": "estleg:Postiseadus_Par_17_v13111182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Postiseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Konkurentsiamet väljastab käesoleva seaduse § 10 lõike 1 punktis 1 nimetatud postiteenuse osutamiseks tegevusloa viieks aastaks. (2) Konkurentsiamet väljastab käesoleva seaduse § 10 lõike 1 punktides 2 ja 3 nimetatud postiteenuste osutamiseks tegevusloa viieks aastaks.",
      "rdfs:label": {
        "@value": "Postiseadus_Par_17 (redaktsioon 13111182)",
        "@language": "et"
      },
