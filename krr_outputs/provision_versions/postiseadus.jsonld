      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2006. aasta 1. juulil. (2) Käesoleva seaduse § 5 lõike 2 punkt 3 jõustub 2007. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "Postiseadus_Par_56 (redaktsioon 12899359)",
        "@language": "et"
      },
