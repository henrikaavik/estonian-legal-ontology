      }
    },
    {
      "@id": "estleg:Reg_1048951_Par_5_v1048951",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048951_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abikõlblikud ei ole Euroopa Parlamendi ja nõukogu määruse (EL) nr 1303/2013 artikli 69 lõigetes 1 ja 2 ning lõike 3 punktides a ja b nimetatud kulud ning Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 artiklis 11 nimetatud tegevuste elluviimisega seotud kulud. Abikõlblikud ei ole Euroopa Parlamendi ja nõukogu määruse (EL) nr 1303/2013 artikli 69 lõigetes 1 ja 2 ning lõike 3 punktides a ja b nimetatud kulud ning Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 artiklis 11 nimetatud tegevuste elluviimisega seotud kulud.",
