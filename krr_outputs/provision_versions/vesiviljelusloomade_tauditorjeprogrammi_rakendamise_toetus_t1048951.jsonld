    {
      "@id": "estleg:Reg_1048951_Par_2_v1048951",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048951_Par_2"
