    {
      "@id": "estleg:Reg_1048951_Par_8_v1048951",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1048951_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-10-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) PRIA teeb nõuetekohase taotluse rahuldamise otsuse kalandusturu korraldamise seaduse § 30 lõike 5 alusel. PRIA teeb nõuetekohase taotluse rahuldamise otsuse kalandusturu korraldamise seaduse § 30 lõike 5 alusel. 2 (2) PRIA teeb taotluse rahuldamata jätmise otsuse kalandusturu korraldamise seaduse § 30 lõike 9 alusel. PRIA teeb taotluse rahuldamata jätmise otsuse kalandusturu korraldamise seaduse § 30 lõike 9 alusel. 3 (3) PRIA teeb taotluse rahuldamise või rahuldamata jätmise otsuse 35 tööpäeva jooksul taotluse esitamisest arvates. PRIA teeb taotluse rahuldamise või rahuldamata jätmise otsuse 35 tööpäeva jooksul taotluse esitamisest arvates.",
      "rdfs:label": {
        "@value": "Reg_1048951_Par_8 (redaktsioon 1048951)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048951",
