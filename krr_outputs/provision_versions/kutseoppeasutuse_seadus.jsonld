      },
      "estleg:versionRedactionId": "123122024003"
    },
    {
      "@id": "estleg:KUTSEO_Par_19_v22418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õpe toimub päeva-, õhtu- ja kaugõppe vormis.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_19 (redaktsioon 22418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22418",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_19_v262314"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_19_v262314",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Põhihariduse baasil läbiviidava kutsekeskhariduse õppekava järgi võib toimuda õpe päevase, õhtuse ja kaugõppe vormis.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_19 (redaktsioon 262314)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262314",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_19_v968161"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_19_v968161",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õpe toimub koolipõhise või töökohapõhise õppe (õpipoisiõppe) vormis. (2) Koolipõhine õppevorm põhineb kutse-, eri- või ametialasel ettevalmistusel, millest praktika ettevõttes või asutuses ei ületa poolt õppekava kutseõppe osa kogumahust. (3) Töökohapõhine õppevorm põhineb kutse-, eri- ja ametialasel ettevalmistusel, millest praktika ettevõttes või asutuses moodustab vähemalt kaks kolmandikku õppekava kutseõppe osa kogumahust. (4) Töökohapõhise õppe rakendamise korra kehtestab haridus- ja teadusminister määrusega.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_19 (redaktsioon 968161)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "968161",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_19_v12778192"
      },
      "estleg:versionValidTo": {
        "@value": "2007-01-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_19_v12778192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õpe toimub koolipõhise või töökohapõhise õppe (õpipoisiõppe) vormis. (2) Koolipõhine õppevorm põhineb kutse-, eri- või ametialasel ettevalmistusel, millest praktika ettevõttes või asutuses ei ületa poolt õppekava kutseõppe osa kogumahust. (3) Töökohapõhine õppevorm põhineb kutse-, eri- ja ametialasel ettevalmistusel, millest praktika ettevõttes või asutuses moodustab vähemalt kaks kolmandikku õppekava kutseõppe osa kogumahust. (4) Töökohapõhise õppe rakendamise korra",
      "rdfs:label": {
        "@value": "KUTSEO_Par_19 (redaktsioon 12778192)",
