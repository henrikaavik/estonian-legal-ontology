      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppekeel on koolis eesti keel. Õppekeelena teiste keelte kasutamise otsustab haridus- ja teadusminister. - joust. 1. 01. 2003",
      "rdfs:label": {
        "@value": "KUTSEO_Par_18 (redaktsioon 262314)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262314",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_18_v968161"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_18_v968161",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õppekeel on koolis eesti keel. Õppekeelena teiste keelte kasutamise otsustab haridus- ja teadusminister.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_18 (redaktsioon 968161)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "968161",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_18_v102072013001"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_18_v102072013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõunike kogu on kooli ja ühiskonda sidustav nõuandev kogu, mille ülesanne on nõustada kooli ja kooli pidajat arengu kavandamisel ning õppekasvatustöö ja majandustegevuse korraldamisel. (2) Nõunike kogu on vähemalt seitsmeliikmeline ja selle moodustab kooli pidaja viieks aastaks. (3) Nõunike kogu: teeb kooli pidajale ja kooli nõukogule ettepanekuid kooli arengusuundade, tegevuse, vara, eelarve, juhtimise ja põhimääruse muutmisega seotud küsimustes; annab hinnangu kooli koostööle riigiasutuste, kohaliku omavalitsuse üksuste ja ettevõtetega kooli arengukava eesmärkide saavutamisel; avaldab arvamust uues õppekavarühmas õppe läbiviimise õiguse taotlemise kohta; annab hinnangu praktika korraldamisele koolis ning asutustes ja ettevõtetes; nimetab esindaja direktori vabale ametikohale korraldatava konkursi läbiviimiseks moodustatava konkursikomisjoni koosseisu; avaldab arvamust kooli majandusaasta aruande kohta. (4) Nõunike kogu esindajal on õigus osa võtta kooli nõukogu istungitest. (5) Nõunike kogu moodustamise ja tegutsemise korra määrusega.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_18 (redaktsioon 102072013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_18_v114032014063"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_18_v114032014063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõunike kogu on kooli ja ühiskonda sidustav nõuandev kogu, mille ülesanne on nõustada kooli ja kooli pidajat arengu kavandamisel ning õppekasvatustöö ja majandustegevuse korraldamisel. (2) Nõunike kogu on vähemalt seitsmeliikmeline ja selle moodustab kooli pidaja viieks aastaks. (3) Nõunike kogu: teeb kooli pidajale ja kooli nõukogule ettepanekuid kooli arengusuundade, tegevuse, vara, eelarve, juhtimise ja põhimääruse muutmisega seotud küsimustes; annab hinnangu kooli koostööle riigiasutuste, kohaliku omavalitsuse üksuste ja ettevõtetega kooli arengukava eesmärkide saavutamisel; avaldab arvamust uues õppekavarühmas õppe läbiviimise õiguse taotlemise kohta; annab hinnangu praktika korraldamisele koolis ning asutustes ja ettevõtetes; nimetab esindaja direktori vabale ametikohale korraldatava konkursi läbiviimiseks moodustatava konkursikomisjoni koosseisu; avaldab arvamust kooli majandusaasta aruande kohta. (4) Nõunike kogu esindajal on õigus osa võtta kooli nõukogu istungitest. (5) Nõunike kogu moodustamise ja tegutsemise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_18 (redaktsioon 114032014063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014063",
