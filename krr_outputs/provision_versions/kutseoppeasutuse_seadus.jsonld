        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolis omandatakse kõrgharidus rakenduskõrghariduse õppekava alusel, mille õppekavaga määratud õppeaja nominaalkestus on kolm kuni neli aastat.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_16 (redaktsioon 215541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "215541",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_16_v102072013001"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_16_v102072013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kooli direktori vaba ametikoha täitmiseks korraldatakse avalik konkurss. (2) Riigikooli direktori vaba ametikoha täitmiseks korraldatava konkursi läbiviimise korra määrusega. (3) Munitsipaalkooli direktori vaba ametikoha täitmiseks korraldatava konkursi korra kehtestab valla- või linnavalitsus. (4) Riigikooli direktoriga sõlmib töölepingu, muudab seda ja ütleb selle üles haridus- ja teadusminister või tema volitatud esindaja. (5) Munitsipaalkooli direktoriga sõlmib töölepingu, muudab seda ja ütleb selle üles vallavanem või linnapea või tema volitatud esindaja.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_16 (redaktsioon 102072013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_16_v114032014063"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_16_v114032014063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kooli direktori vaba ametikoha täitmiseks korraldatakse avalik konkurss. (2) Riigikooli direktori vaba ametikoha täitmiseks korraldatava konkursi läbiviimise korra kehtestab määrusega. (3) Munitsipaalkooli direktori vaba ametikoha täitmiseks korraldatava konkursi korra kehtestab valla- või linnavalitsus. (4) Riigikooli direktoriga sõlmib töölepingu, muudab seda ja ütleb selle üles valdkonna eest vastutav minister või tema volitatud esindaja. (5) Munitsipaalkooli direktoriga sõlmib töölepingu, muudab seda ja ütleb selle üles vallavanem või linnapea või tema volitatud esindaja.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_16 (redaktsioon 114032014063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014063"
    },
    {
      "@id": "estleg:KUTSEO_Par_17_v22418",
