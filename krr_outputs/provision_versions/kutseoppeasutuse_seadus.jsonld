      }
    },
    {
      "@id": "estleg:KUTSEO_Par_27_v102072013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õppeaasta algab 1. septembril ja lõpeb järgmise aasta 31. augustil. (2) Õpilase jaoks on õppeaastas vähemalt 40 nädalat õppetööd ja vähemalt kaheksa nädalat vaheaega. (3) Õppetöö maht õppeaastas on 60 arvestuspunkti.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_27 (redaktsioon 102072013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013001"
    },
    {
      "@id": "estleg:KUTSEO_Par_28_v22418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kooli liikmeskonna moodustavad kooli pedagoogid ja teised töötajad (edaspidi personal) ning õpilased ja üliõpilased (edaspidi õpilased). (2) Käesoleva seaduse tähenduses on üliõpilaseks kutsekõrghariduse õppekava järgi õppija. Üliõpilastele laienevad käesoleva seadusega kehtestatud õigused ja kohustused niivõrd, kuivõrd rakenduskõrgkooli seadus ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_28 (redaktsioon 22418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22418",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_28_v180466"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-04",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_28_v180466",
