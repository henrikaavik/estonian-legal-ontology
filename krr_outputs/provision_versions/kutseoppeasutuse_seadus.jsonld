      }
    },
    {
      "@id": "estleg:KUTSEO_Par_5_v968161",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_5"
      },
      "estleg:versionValidFrom": {
