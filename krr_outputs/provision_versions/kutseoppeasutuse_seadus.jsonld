        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_18_v123122024003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
