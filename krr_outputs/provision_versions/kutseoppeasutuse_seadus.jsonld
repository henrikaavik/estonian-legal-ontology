      }
    },
    {
      "@id": "estleg:KUTSEO_Par_10_v12957441",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_10"
      },
      "estleg:versionValidFrom": {
