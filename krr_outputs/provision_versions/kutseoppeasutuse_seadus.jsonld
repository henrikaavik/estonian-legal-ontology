      }
    },
    {
      "@id": "estleg:KUTSEO_Par_22_v968161",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kool loetakse lõpetatuks pärast vastava õppekava täitmist. (1¹) Eesti keelest erineva õppekeelega õppegruppides kutsekeskharidust omandavad lõpetajad sooritavad kooli lõpetamiseks eesti keelest erineva õppekeelega õpilastele läbiviidava eesti keele riigieksami vastavalt põhikooli- ja gümnaasiumiseaduse alusel kehtestatud põhikooli ja gümnaasiumi lõpueksamite korraldamise ning põhikooli ja gümnaasiumi lõpetamise tingimustele ja korrale. (3) Kooli väljaantud lõputunnistused kantakse Eesti Vabariigi haridusseaduse § 366 lõike 4 alusel asutatud Eesti Hariduse Infosüsteemi.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_22 (redaktsioon 968161)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "968161",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_22_v13148030"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_22_v13148030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kool loetakse lõpetatuks pärast vastava õppekava täitmist. (1¹) Eesti keelest erineva õppekeelega õppegruppides kutsekeskharidust omandavad lõpetajad sooritavad kooli lõpetamiseks eesti keelest erineva õppekeelega õpilastele läbiviidava eesti keele riigieksami vastavalt põhikooli- ja gümnaasiumiseaduse alusel kehtestatud põhikooli ja gümnaasiumi lõpueksamite korraldamise ning põhikooli ja gümnaasiumi lõpetamise tingimustele ja korrale. (2) Kooli lõpetamist tõendab kooli lõputunnistus, mille vormi ja väljaandmise korra (3) Kooli väljaantud lõputunnistused kantakse Eesti Vabariigi haridusseaduse § 366 lõike 4 alusel asutatud Eesti Hariduse Infosüsteemi.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_22 (redaktsioon 13148030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13148030",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_22_v13336386"
      },
      "estleg:versionValidTo": {
        "@value": "2010-08-31",
