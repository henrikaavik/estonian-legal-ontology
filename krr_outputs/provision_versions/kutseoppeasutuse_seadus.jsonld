    },
    {
      "@id": "estleg:KUTSEO_Par_15_v102072013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kooli juhib direktor. (2) Direktor: vastutab oma pädevuse piires kooli üldseisundi, õppekasvatustöö, arendustegevuse ning rahaliste vahendite õiguspärase ja otstarbeka kasutamise eest; teostab oma pädevuse piires koolis kõrgeimat haldus- ja distsiplinaarvõimu; esindab kooli käesoleva seaduse ning kooli põhimäärusega antud volituste ulatuses; sõlmib töölepingud kooli töötajatega; moodustab nõukogu kooli põhimääruses sätestatud korras; kinnitab kooli õppekavad ja teised õigusaktidega ettenähtud dokumendid ja aruanded, mille kinnitamine ei ole nõukogu pädevuses; kinnitab kooli eelarve, eelarve täitmise aruande ja hankeplaani; käsutab kooli eelarvevahendeid käesoleva seaduse ning kooli põhimäärusega antud volituste ulatuses; kinnitab kooli majandusaasta aruande; annab aru kooli nõunike kogule ja kooli pidajale; lahendab muid küsimusi, mille lahendamine ei ole õigusaktidega antud teiste juhtorganite pädevusse. (3) Direktor annab oma pädevuse piires käskkirju.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_15 (redaktsioon 102072013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_15_v128122018012"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_15_v128122018012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kooli juhib direktor. (2) Direktor: vastutab oma pädevuse piires kooli üldseisundi, õppekasvatustöö, arendustegevuse ning rahaliste vahendite ja vara õiguspärase ja otstarbeka kasutamise eest; teostab oma pädevuse piires koolis kõrgeimat haldus- ja distsiplinaarvõimu; esindab kooli käesoleva seaduse ning kooli põhimäärusega antud volituste ulatuses; sõlmib töölepingud kooli töötajatega; moodustab nõukogu kooli põhimääruses sätestatud korras; kinnitab kooli õppekavad ja teised õigusaktidega ettenähtud dokumendid ja aruanded, mille kinnitamine ei ole nõukogu pädevuses; kinnitab kooli eelarve ja hankeplaani; käsutab kooli eelarvevahendeid käesoleva seaduse ning kooli põhimäärusega antud volituste ulatuses; kehtetu - annab aru kooli nõunike kogule ja kooli pidajale; korraldab kooli arengukava koostamise, vastutab arengukava elluviimise eest ning kinnitab kooli arengukava täitmise aruande; lahendab muid küsimusi, mille lahendamine ei ole õigusaktidega antud teiste juhtorganite pädevusse. (3) Direktor annab oma pädevuse piires käskkirju.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_15 (redaktsioon 128122018012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122018012"
    },
    {
      "@id": "estleg:KUTSEO_Par_16_v22418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolis omandatakse kõrgharidus kutsekõrghariduse õppekava alusel, mille õppekavaga määratud õppeaja nominaalkestus on kolm kuni neli aastat.",
      "rdfs:label": {
