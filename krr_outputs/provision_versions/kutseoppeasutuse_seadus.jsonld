      }
    },
    {
      "@id": "estleg:KUTSEO_Par_22_v13336386",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kool loetakse lõpetatuks pärast vastava õppekava täitmist. (1¹) Eesti keelest erineva õppekeelega õppegruppides kutsekeskharidust omandavad lõpetajad sooritavad kooli lõpetamiseks eesti keelest erineva õppekeelega õpilastele läbiviidava eesti keele riigieksami põhikooli- ja gümnaasiumiseaduse alusel kehtestatud põhikooli ja gümnaasiumi lõpetamiseks sooritatavate eksamite läbiviimise korra kohaselt. (2) Kooli lõpetamist tõendab kooli lõputunnistus, mille vormi ja väljaandmise korra (3) Kooli väljaantud lõputunnistused kantakse Eesti Vabariigi haridusseaduse § 366 lõike 4 alusel asutatud Eesti Hariduse Infosüsteemi.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_22 (redaktsioon 13336386)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13336386",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_22_v102072013001"
      },
      "estleg:versionValidTo": {
        "@value": "2013-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_22_v102072013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutseharidusstandardi määrusega, kinnitades selles järgmised ühtsed nõuded kutseõppele: kutseõppe õpiväljundid, sealhulgas võtmepädevuste alal, ja nende seos Eesti kvalifikatsiooniraamistikuga; õppekava ning õppe ülesanded ja nõuded, sealhulgas õppe maht, õpingute alustamise ja lõpetamise nõuded, võtmepädevuste õppe struktuur ja mahud ning ühisõppekava erisused; õppekava muutmise põhimõtted; varasemate õpingute ja varasema töökogemuse arvestamise põhimõtted; õppevaldkondade ja -suundade ning õppekavarühmade loetelu.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_22 (redaktsioon 102072013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102072013001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_22_v114032014063"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KUTSEO_Par_22_v114032014063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KUTSEO_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutseharidusstandardi kehtestab määrusega, kinnitades selles järgmised ühtsed nõuded kutseõppele: kutseõppe õpiväljundid, sealhulgas võtmepädevuste alal, ja nende seos Eesti kvalifikatsiooniraamistikuga; õppekava ning õppe ülesanded ja nõuded, sealhulgas õppe maht, õpingute alustamise ja lõpetamise nõuded, võtmepädevuste õppe struktuur ja mahud ning ühisõppekava erisused; õppekava muutmise põhimõtted; varasemate õpingute ja varasema töökogemuse arvestamise põhimõtted; õppevaldkondade ja -suundade ning õppekavarühmade loetelu.",
      "rdfs:label": {
        "@value": "KUTSEO_Par_22 (redaktsioon 114032014063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014063",
      "estleg:supersededByVersion": {
        "@id": "estleg:KUTSEO_Par_22_v128122018012"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      }
    },
    {
