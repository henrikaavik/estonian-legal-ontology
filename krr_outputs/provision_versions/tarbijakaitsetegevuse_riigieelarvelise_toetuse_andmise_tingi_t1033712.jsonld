    {
      "@id": "estleg:Reg_1033712_Par_2_v1033712",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033712_Par_2"
