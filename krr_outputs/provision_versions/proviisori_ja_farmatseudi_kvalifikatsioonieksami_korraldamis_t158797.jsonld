      },
      "dc:source": "Proviisori ja farmatseudi kvalifikatsioonieksami korraldamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_158797_Par_1_v158797",
      "@type": [
        "owl:NamedIndividual",
