      },
      "estleg:versionText": "Omafinantseeringu minimaalne määr puudub. Omafinantseeringu minimaalne määr puudub.",
      "rdfs:label": {
        "@value": "Reg_1033184_Par_3 (redaktsioon 1033184)",
        "@language": "et"
      },
