      "estleg:provisionRef": "Reg_1033184 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1033184_Map"
      }
    },
    {
      "@id": "estleg:Reg_1033184_Par_5_v1033184",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1033184_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Abikõlblik ei ole Euroopa Parlamendi ja nõukogu määruse (EL) nr 1303/2013 artikli 69 lõigetes 1 ja 2 ning lõike 3 punktides a ja b nimetatud kulu, Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 artiklis 11 nimetatud tegevuste elluviimisega seotud kulu ega kulu, mis on tehtud enne 1. jaanuari 2015. RT I 2020-08-05 19 105082020019 2020-08-08 Abikõlblik ei ole Euroopa Parlamendi ja nõukogu määruse (EL) nr 1303/2013 artikli 69 lõigetes 1 ja 2 ning lõike 3 punktides a ja b nimetatud kulu, Euroopa Parlamendi ja nõukogu määruse (EL) nr 508/2014 artiklis 11 nimetatud tegevuste elluviimisega seotud kulu ega kulu, mis on tehtud enne 1. jaanuari 2015.",
      "rdfs:label": {
