        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056047_Par_3 (redaktsioon 1056047)",
        "@language": "et"
      },
