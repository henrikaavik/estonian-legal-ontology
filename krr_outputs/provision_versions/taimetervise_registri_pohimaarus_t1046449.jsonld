      "estleg:provisionRef": "Reg_1046449 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046449_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1046449_Par_11_v1046449",
      "@type": [
        "owl:NamedIndividual",
