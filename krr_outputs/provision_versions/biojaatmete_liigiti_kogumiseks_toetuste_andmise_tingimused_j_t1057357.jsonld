    {
      "@id": "estleg:Reg_1057357_Par_11_v1057357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057357_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotleja tunnistatakse nõuetele vastavaks, kui ta vastab §-s 7 sätestatud nõuetele. Taotleja tunnistatakse nõuetele vastavaks, kui ta vastab §-s 7 sätestatud nõuetele. 2 (2) Taotlus tunnistatakse nõuetele vastavaks, kui taotlus on esitatud käesolevas määruses sätestatud korras ja see vastab §-s 8 sätestatud nõuetele. Taotlus tunnistatakse nõuetele vastavaks, kui taotlus on esitatud käesolevas määruses sätestatud korras ja see vastab §-s 8 sätestatud nõuetele. 3 (3) Taotlus ei vasta nõuetele, kui esineb vähemalt üks järgmistest asjaoludest: 1 1) taotlus ei vasta kasvõi ühele käesolevas määruses esitatud nõudele; 2 2) taotluses on esitatud ebaõigeid või mittetäielikke andmeid või taotleja mõjutab pettuse või ähvardusega või muul õigusvastasel viisil taotluse menetlemist; 3 3) taotleja ei ole määratud tähtaja jooksul kõrvaldanud taotluses esinevaid puudusi. Taotlus ei vasta nõuetele, kui esineb vähemalt üks järgmistest asjaoludest: taotlus ei vasta kasvõi ühele käesolevas määruses esitatud nõudele; taotluses on esitatud ebaõigeid või mittetäielikke andmeid või taotleja mõjutab pettuse või ähvardusega või muul õigusvastasel viisil taotluse menetlemist; taotleja ei ole määratud tähtaja jooksul kõrvaldanud taotluses esinevaid puudusi.",
      "rdfs:label": {
        "@value": "Reg_1057357_Par_11 (redaktsioon 1057357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057357",
