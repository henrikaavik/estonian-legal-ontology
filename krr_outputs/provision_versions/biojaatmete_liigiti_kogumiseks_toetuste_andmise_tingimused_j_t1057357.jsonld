      }
    },
    {
      "@id": "estleg:Reg_1057357_Par_5_v1057357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057357_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Projekti elluviimise periood määratakse kindlaks taotluse rahuldamise otsuses. Projekti elluviimise periood määratakse kindlaks taotluse rahuldamise otsuses. 2 (2) Projekti elluviimise perioodi algus ei või olla varasem kui taotluse rahuldamise otsuse kuupäev ning lõpp ei või olla hilisem kui 31. märts 2025. Projekti elluviimise perioodi algus ei või olla varasem kui taotluse rahuldamise otsuse kuupäev ning lõpp ei või olla hilisem kui 31. märts 2025. 3 (3) Toetuse saaja peab projekti tegevustega alustama kahe kuu jooksul taotluse rahuldamise otsusest. Toetuse saaja peab projekti tegevustega alustama kahe kuu jooksul taotluse rahuldamise otsusest.",
      "rdfs:label": {
        "@value": "Reg_1057357_Par_5 (redaktsioon 1057357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057357",
