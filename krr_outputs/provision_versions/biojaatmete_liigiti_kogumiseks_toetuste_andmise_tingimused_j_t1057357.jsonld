      }
    },
    {
      "@id": "estleg:Reg_1057357_Par_3_v1057357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057357_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Meetme viib ellu Kliimaministeerium. Meetme viib ellu Kliimaministeerium. 2 (2) Toetuse taotlusi menetleb, taotluse rahuldamise ja mitterahuldamise otsustab, teeb toetatavatele projektidele väljamakseid ja projektide üle järelevalvet Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi KIK). Toetuse taotlusi menetleb, taotluse rahuldamise ja mitterahuldamise otsustab, teeb toetatavatele projektidele väljamakseid ja projektide üle järelevalvet Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi KIK).",
      "rdfs:label": {
        "@value": "Reg_1057357_Par_3 (redaktsioon 1057357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057357",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057357",
      "estleg:sourceAct": "Biojäätmete liigiti kogumiseks toetuste andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057357 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057357_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057357_Par_4_v1057357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057357_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetust antakse kodumajapidamistes tekkivate biojäätmete liigiti kogumiseks vajalike konteinerite, korvide või tekkekohal kompostimiseks kompostrite soetamiseks. Toetust antakse kodumajapidamistes tekkivate biojäätmete liigiti kogumiseks vajalike konteinerite, korvide või tekkekohal kompostimiseks kompostrite soetamiseks. 2 (2) Toetust ei anta projektile, mille tegevused on tehtud enne taotluse esitamist. Toetust ei anta projektile, mille tegevused on tehtud enne taotluse esitamist.",
      "rdfs:label": {
        "@value": "Reg_1057357_Par_4 (redaktsioon 1057357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057357",
