      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välisluureameti teabetoimiku pidamise ja säilitamise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välisluureameti teabetoimiku pidamise ja säilitamise kord"
    },
    {
      "@id": "estleg:Reg_1039058_Par_1_v1039058",
      "@type": [
