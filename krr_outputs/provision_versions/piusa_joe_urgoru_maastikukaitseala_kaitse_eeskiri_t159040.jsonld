    {
      "@id": "estleg:Reg_159040_Par_14_v159040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159040_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 2 2) biotsiidi ja taimekaitsevahendi kasutamine metsamaal ja looduslikul rohumaal; 3 3) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liigiline ja vanuseline mitmekesisus; 4 4) puidu kokku- ja väljavedu külmumata pinnasel; 5 5) puhtpuistute kujundamine ja energiapuistute rajamine. Piiranguvööndis on keelatud: maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; biotsiidi ja taimekaitsevahendi kasutamine metsamaal ja looduslikul rohumaal; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liigiline ja vanuseline mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; puhtpuistute kujundamine ja energiapuistute rajamine.",
      "rdfs:label": {
        "@value": "Reg_159040_Par_14 (redaktsioon 159040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "159040",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/159040",
      "estleg:sourceAct": "Piusa jõe ürgoru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_159040 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159040_Map_2026"
      }
    },
