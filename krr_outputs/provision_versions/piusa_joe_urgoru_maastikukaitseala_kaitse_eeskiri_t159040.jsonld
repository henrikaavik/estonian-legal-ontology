    {
      "@id": "estleg:Reg_159040_Par_13_v159040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159040_Par_13"
