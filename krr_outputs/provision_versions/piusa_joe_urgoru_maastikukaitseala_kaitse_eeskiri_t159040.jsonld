    {
      "@id": "estleg:Reg_159040_Par_2_v159040",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_159040_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Võru maakonnas Meremäe vallas Ignasõ, Navikõ, Härmä, Väiko-Härmä, Paklova, Jõksi ja Raotu külas ning Vastseliina vallas Lindora, Mäe-Kõoküla, Tellaste, Hinniala, Savioja, Möldri, Tallikeste, Plessi ja Vana-Vastseliina külas. Kaitseala asub Võru maakonnas Meremäe vallas Ignasõ, Navikõ, Härmä, Väiko-Härmä, Paklova, Jõksi ja Raotu külas ning Vastseliina vallas Lindora, Mäe-Kõoküla, Tellaste, Hinniala, Savioja, Möldri, Tallikeste, Plessi ja Vana-Vastseliina külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud määruse lisas 4. Kaitseala välispiir ja vööndite piirid on esitatud määruse lisas 4.",
      "rdfs:label": {
        "@value": "Reg_159040_Par_2 (redaktsioon 159040)",
        "@language": "et"
      },
