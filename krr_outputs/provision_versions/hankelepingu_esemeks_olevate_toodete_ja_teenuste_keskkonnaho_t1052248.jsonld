      }
    },
    {
      "@id": "estleg:Reg_1052248_Par_8_v1052248",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052248_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koopia- ja joonestuspaber käesoleva määruse tähenduses on kirjutamiseks, trükkimiseks ja koopiate tegemiseks ette nähtud trükimärkideta paber (kuni 170g/m²), mida müüakse lehtede või rullidena. Koopia- ja joonestuspaber käesoleva määruse tähenduses on kirjutamiseks, trükkimiseks ja koopiate tegemiseks ette nähtud trükimärkideta paber (kuni 170g/m²), mida müüakse lehtede või rullidena. 2 (2) Koopia- ja joonestuspaber käesoleva paragrahvi lõike 1 tähenduses ei hõlma selliseid paberist valmistooteid nagu kirjutusplokid, joonistusplokid, kalendrid, märkmikud jms. Koopia- ja joonestuspaber käesoleva paragrahvi lõike 1 tähenduses ei hõlma selliseid paberist valmistooteid nagu kirjutusplokid, joonistusplokid, kalendrid, märkmikud jms. 3 (3) Koopia- ja joonestuspaberi keskkonnahoidlikud kriteeriumid on sätestatud käesoleva määruse lisas 4. Koopia- ja joonestuspaberi keskkonnahoidlikud kriteeriumid on sätestatud käesoleva määruse lisas 4.",
      "rdfs:label": {
