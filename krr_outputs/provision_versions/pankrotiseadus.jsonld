      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "PankrS_Par_95 (redaktsioon 112112010015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010015",
      "estleg:supersededByVersion": {
