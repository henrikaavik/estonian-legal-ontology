      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_174"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PankrS_Par_174 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 174",
      "estleg:partOfAct": {
