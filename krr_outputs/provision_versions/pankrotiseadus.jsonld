    {
      "@id": "estleg:PankrS_Par_4_1_v114032011046",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_4_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus, millega pankrot välja kuulutatakse, on kehtiv ja kuulub täitmisele alates avalikult teatavaks tegemisest. Määrus, millega pankrotiavaldus jäetakse rahuldamata, samuti määrus, millega avaldus jäetakse läbi vaatamata või lõpetatakse menetlus, on kehtiv ja kuulub täitmisele alates jõustumisest.",
      "rdfs:label": {
        "@value": "PankrS_Par_4_1 (redaktsioon 114032011046)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032011046",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032011046",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 4_1",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_5_v22226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrotiavalduse läbivaatamine kuulub maa- või linnakohtu pädevusse. (2) Pankrotiavaldus esitatakse kohtule füüsilisest isikust võlgniku elukoha või juriidilisest isikust võlgniku asukoha järgi.",
      "rdfs:label": {
        "@value": "PankrS_Par_5 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_5_v257670"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22226",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_5_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrotimenetluses tehtud kohtumääruse peale võib esitada erikaebuse käesolevas seaduses ettenähtud juhtudel, samuti juhul, kui kohtumäärus takistab edasist menetlust. (2) Ringkonnakohtu määruse peale erikaebuse kohta võib edasi kaevata üksnes siis, kui see on käesolevas seaduses ette nähtud. (3) Erikaebuse esitamine ei peata määruse täitmist, kui seaduses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "PankrS_Par_5 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_5_v928068"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 5",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_5_v928068",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrotimenetluses tehtud kohtumääruse peale võib esitada erikaebuse käesolevas seaduses ettenähtud juhtudel, samuti juhul, kui kohtumäärus takistab edasist menetlust. (2) Ringkonnakohtu määruse peale erikaebuse kohta võib edasi kaevata üksnes siis, kui see on käesolevas seaduses ette nähtud. (3) Erikaebuse esitamine ei peata määruse täitmist, kui seaduses ei ole sätestatud teisiti. [Paragrahvi 5 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "PankrS_Par_5 (redaktsioon 928068)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928068",
