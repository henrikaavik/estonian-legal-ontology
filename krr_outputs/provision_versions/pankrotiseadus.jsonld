        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus võib määrusega kohustada pankrotiavalduse esitanud võlausaldajat tasuma ajutise halduri tasu ja kulutuste katteks kohtu deposiiti kohtu määratud rahasumma, kui on alust eeldada, et pankrotivara selleks ei jätku. Määruse peale võib pankrotiavalduse esitanud võlausaldaja esitada erikaebuse.",
      "rdfs:label": {
        "@value": "PankrS_Par_11 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_11_v928068"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 11",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
