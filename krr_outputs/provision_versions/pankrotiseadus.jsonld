      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PankrS_Par_95 (redaktsioon 129062011014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062011014",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062011014",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 95",
      "estleg:partOfAct": {
