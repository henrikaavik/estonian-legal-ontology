      },
      "estleg:versionText": "Kohus teostab järelevalvet pankrotimenetluse seaduslikkuse üle ja täidab muid seadusest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "PankrS_Par_84 (redaktsioon 992422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992422",
