        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_192_6_v130112021013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_192_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus tagab maksejõuetuse teenistusele juurdepääsu pankroti-, saneerimis-, võlgade ümberkujundamise või füüsilise isiku kohustustest vabastamise menetlusele või sellega seotud menetlusele, kui kohus saab menetluse algatamise avalduse või hagi.",
      "rdfs:label": {
        "@value": "PankrS_Par_192_6 (redaktsioon 130112021013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112021013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130112021013",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 192_6",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_192_7_v130112021013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_192_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eriauditi ja pankrotimenetluse läbiviimisel avaliku uurimisena tekkinud kulud kantakse Konkurentsiameti eelarves maksejõuetuse teenistusele ettenähtud vahenditest ning hüvitatakse riigieelarvesse vastavalt käesoleva seaduse § 146 lõike 1 punktis 4 ja § 150 lõike 1 punktis 7 sätestatule. (2) Eriaudititele tehtud kulutused hüvitatakse pankrotivara arvelt ühe pankrotimenetluse kohta kuni kümne protsendi ulatuses pandiga tagamata võlausaldajatele jaotise alusel tehtavate väljamaksete summast.",
      "rdfs:label": {
        "@value": "PankrS_Par_192_7 (redaktsioon 130112021013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112021013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130112021013",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 192_7",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_192_8_v130112021013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_192_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksejõuetuse teenistus teostab järelevalvet võlgniku ja võlgniku lähikondsete tegevuse üle käesolevas seaduses sätestatud nõuete täitmisel eesmärgiga uurida võlgniku ja võlgniku lähikondsete võimalikku seadusvastast käitumist võlgniku maksejõuetuse tekitamisel või makseraskuste suurendamisel pankrotimenetlustes, milles esineb avalik huvi vältida raugemist, või selgitada välja avalikus huvis oleva maksejõuetusasja olulised asjaolud. (2) Kui ilmneb, et võlgnik või võlgniku lähikondne on seoses maksejõuetuse tekkimisega pannud toime kuriteo tunnustega teo, teatab maksejõuetuse teenistus sellest prokurörile või politseile kriminaalmenetluse alustamise otsustamiseks. Teates ei tohi tugineda teabele, mille kasutamine tõendina oleks käesoleva seaduse § 85 lõikes 4 sätestatu kohaselt välistatud. (3) Maksejõuetuse teenistus võib võlgniku või võlgniku lähikondse tegevuse kontrollimiseks läbi viia eriauditi või pankrotimenetluse avaliku uurimise. (4) Maksejõuetuse teenistus võib taotleda kohtult ärikeelu kohaldamist vastavalt käesoleva seaduse §-s 91 sätestatule.",
      "rdfs:label": {
        "@value": "PankrS_Par_192_8 (redaktsioon 130112021013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112021013",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_192_8_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130112021013",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 192_8",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_192_8_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_192_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maksejõuetuse teenistus teostab järelevalvet võlgniku ja võlgniku lähikondsete tegevuse üle seoses võlgniku pankrotimenetlusega ja eesmärgiga uurida võlgniku ja võlgniku lähikondsete võimalikku seadusvastast käitumist võlgniku maksejõuetuse tekitamisel või makseraskuste suurendamisel pankrotimenetlustes, milles esineb avalik huvi vältida raugemist, või selgitada välja avalikus huvis oleva maksejõuetusasja olulised asjaolud. (2) Kui ilmneb, et võlgnik või võlgniku lähikondne on seoses maksejõuetuse tekkimisega pannud toime kuriteo tunnustega teo, teatab maksejõuetuse teenistus sellest prokurörile või politseile kriminaalmenetluse alustamise otsustamiseks. Teates ei tohi tugineda teabele, mille kasutamine tõendina oleks käesoleva seaduse § 85 lõikes 4 sätestatu kohaselt välistatud. (3) Maksejõuetuse teenistus võib võlgniku või võlgniku lähikondse tegevuse kontrollimiseks läbi viia eriauditi või pankrotimenetluse avaliku uurimise. (4) Maksejõuetuse teenistus võib taotleda kohtult ärikeelu kohaldamist vastavalt käesoleva seaduse §-s 91 sätestatule.",
      "rdfs:label": {
        "@value": "PankrS_Par_192_8 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 192_8",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_192_9_v130112021013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_192_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistus võib käesoleva seaduse §-s 1928 sätestatud järelevalve teostamiseks kohaldada korrakaitseseaduse 3. peatüki 2. jaos sätestatud üldmeetmeid ning sama seaduse §-s 30, § 31 lõigetes 1–3, § 32 lõigetes 1–4 ja §-des 49–52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras, eelkõige siis, kui on alust arvata, et võlgnik või võlgniku lähikondne võib varjata või hävitada maksejõuetusmenetluse olulisi dokumente või keelduda muul viisil teabe andmisest. (2) Teenistusel on järelevalve teostamisel õigus saada viivitamata kohtult, haldurilt, võlgnikult, võlgniku lähikondselt, võlausaldajalt, võlausaldajate üldkoosolekult, pankrotitoimkonnalt, riigi- ja kohaliku omavalitsuse asutuselt ning krediidiasutuselt, samuti muult isikult tasuta teavet ja dokumente, mis on vajalikud järelevalve teostamiseks, sealhulgas: tutvuda pankrotiasja kohtutoimikuga, halduri toimikuga, võlausaldajate üldkoosoleku dokumentidega ja pankrotitoimkonna dokumentidega; tutvuda pankrotiasjaga seotud menetluste kohtutoimikutega, sealhulgas pankrotihalduri vastu esitatud kahju hüvitamise või juhatuse liikme vastu tagasivõitmise nõude menetluse kohtutoimikuga; tutvuda halduri poolt pankrotimenetluse kohta peetava arvepidamisega ja pankrotivõlgniku raamatupidamisega ning pankrotivõlgniku varalise seisukorraga; saada võlgniku pangakontode väljavõtteid perioodi kohta, mille suhtes teenistus järelevalvet teostab; teha dokumentidest paber- või elektroonilisi koopiaid; tutvuda likvideerimismenetluse dokumentidega ja likvideeritava äriühingu pangakontode väljavõtetega likvideerimismenetluse perioodi kohta; viibida pankrotitoimkonna koosolekul ja võlausaldajate üldkoosolekul ning avaldada arvamust; nõuda haldurilt võlausaldajate üldkoosoleku kokkukutsumist või eriliste tingimuste korral see ise kokku kutsuda ja seda juhatada. (3) Ajutine haldur ja haldur peavad maksejõuetuse teenistusele ka pärast ülesannetest vabastamist andma teavet ja dokumente ning tegema teenistusega koostööd. (4) Teenistusel on vajaduse korral õigus kasutada oma ülesannete täitmiseks menetlusväliste riigi- ja kohaliku omavalitsuse asutuste, sealhulgas politsei abi.",
      "rdfs:label": {
        "@value": "PankrS_Par_192_9 (redaktsioon 130112021013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112021013",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_192_9_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130112021013",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 192_9",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_192_9_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_192_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teenistus võib käesoleva seaduse §-s 1928 sätestatud järelevalve teostamiseks kohaldada korrakaitseseaduse 3. peatüki 2. jaos sätestatud üldmeetmeid ning sama seaduse §-s 30, § 31 lõigetes 1–3, § 32 lõigetes 1–4 ja §-des 49–52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras, eelkõige siis, kui on alust arvata, et võlgnik või võlgniku lähikondne võib varjata või hävitada maksejõuetusmenetluse olulisi dokumente või keelduda muul viisil teabe andmisest. (2) Teenistusel on järelevalve teostamisel õigus saada viivitamata kohtult, haldurilt, võlgnikult, võlgniku lähikondselt, võlausaldajalt, võlausaldajate üldkoosolekult, pankrotitoimkonnalt, riigi- ja kohaliku omavalitsuse asutuselt ning krediidiasutuselt, samuti muult isikult tasuta teavet ja dokumente, mis on vajalikud järelevalve teostamiseks, sealhulgas: tutvuda pankrotiasja kohtutoimikuga, halduri toimikuga, võlausaldajate üldkoosoleku dokumentidega ja pankrotitoimkonna dokumentidega; tutvuda pankrotiasjaga seotud menetluste kohtutoimikutega, sealhulgas pankrotihalduri vastu esitatud kahju hüvitamise või juhatuse liikme vastu tagasivõitmise nõude menetluse kohtutoimikuga; tutvuda halduri poolt pankrotimenetluse kohta peetava arvepidamisega ja pankrotivõlgniku raamatupidamisega ning pankrotivõlgniku varalise seisukorraga; saada võlgniku pangakontode väljavõtteid perioodi kohta, mille suhtes teenistus järelevalvet teostab; teha dokumentidest paber- või elektroonilisi koopiaid; tutvuda likvideerimismenetluse dokumentidega ja likvideeritava äriühingu pangakontode väljavõtetega likvideerimismenetluse perioodi kohta; viibida pankrotitoimkonna koosolekul ja võlausaldajate üldkoosolekul ning avaldada arvamust; nõuda haldurilt võlausaldajate üldkoosoleku kokkukutsumist või eriliste tingimuste korral see ise kokku kutsuda ja seda juhatada. (3) Ajutine haldur, usaldusisik ja haldur peavad maksejõuetuse teenistusele ka pärast ülesannetest vabastamist andma teavet ja dokumente ning tegema teenistusega koostööd. (4) Teenistusel on vajaduse korral õigus kasutada oma ülesannete täitmiseks menetlusväliste riigi- ja kohaliku omavalitsuse asutuste, sealhulgas politsei abi.",
      "rdfs:label": {
        "@value": "PankrS_Par_192_9 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 192_9",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_193_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_193"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne käesoleva seaduse jõustumist alanud pankrotimenetluses kohaldatakse nende pankrotimenetluse toimingute suhtes, mis tehakse pärast käesoleva seaduse jõustumist, käesolevas seaduses sätestatut. (2) Käesoleva seaduse § 33 lõige 5, § 39 lõige 2, § 40 lõike 2 kolmas lause ja § 41 lõike 1 kolmas lause jõustuvad Eesti liitumisel Euroopa Liiduga eraldi seadusega.",
      "rdfs:label": {
        "@value": "PankrS_Par_193 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
