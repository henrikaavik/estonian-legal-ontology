    },
    {
      "@id": "estleg:PankrS_Par_176_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui võlgnik vabastatakse oma pankrotimenetluses täitmata jäänud kohustustest, lõpevad pankrotivõlausaldajate nõuded võlgniku vastu, sealhulgas ka nende pankrotivõlausaldajate nõuded, kes ei ole pankrotimenetluses nõudeid esitanud. (2) Võlgniku pankrotimenetluses täitmata jäänud kohustustest vabastamisel ei lõpe õigusvastaselt tahtlikult tekitatud kahju hüvitamise kohustused. (3) Võlgniku kohustustest vabastamine ei vabasta võlgnikuga solidaarselt vastutavat isikut oma kohustuse täitmisest. Kui võlgnikuga solidaarselt vastutav isik täidab kohustuse, ei saa ta kohustustest vabastamise korral esitada tagasinõuet võlgniku vastu. (4) Kui võlgnik on võlausaldaja nõude rahuldanud pärast oma pankrotimenetluses täitmata jäänud kohustustest vabastamist, ei saa kohustuse täitmiseks üleantut võlausaldajalt tagasi nõuda.",
      "rdfs:label": {
        "@value": "PankrS_Par_176 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_176_v13260597"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 176",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_176_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui võlgnik vabastatakse oma pankrotimenetluses täitmata jäänud kohustustest, lõpevad pankrotivõlausaldajate nõuded võlgniku vastu, sealhulgas ka nende pankrotivõlausaldajate nõuded, kes ei ole pankrotimenetluses nõudeid esitanud. (2) Võlgniku pankrotimenetluses täitmata jäänud kohustustest vabastamisel ei lõpe õigusvastaselt tahtlikult tekitatud kahju hüvitamise ning lapsele või vanemale elatise maksmise kohustused. (3) Võlgniku kohustustest vabastamine ei vabasta võlgnikuga solidaarselt vastutavat isikut oma kohustuse täitmisest. Kui võlgnikuga solidaarselt vastutav isik täidab kohustuse, ei saa ta kohustustest vabastamise korral esitada tagasinõuet võlgniku vastu. (4) Kui võlgnik on võlausaldaja nõude rahuldanud pärast oma pankrotimenetluses täitmata jäänud kohustustest vabastamist, ei saa kohustuse täitmiseks üleantut võlausaldajalt tagasi nõuda.",
      "rdfs:label": {
        "@value": "PankrS_Par_176 (redaktsioon 13260597)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260597",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_176_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260597",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 176",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_176_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_176"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "PankrS_Par_176 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 176",
      "estleg:partOfAct": {
