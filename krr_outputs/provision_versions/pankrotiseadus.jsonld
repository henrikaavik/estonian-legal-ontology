      }
    },
    {
      "@id": "estleg:PankrS_Par_18_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus võib pankrotiavalduse tagamiseks rakendada kõiki hagi tagamise abinõusid, samuti kohaldada võlgniku suhtes elukohast lahkumise keeldu vastavalt käesoleva seaduse §-s 88 ja võlgniku sundtoomist ja aresti vastavalt §-s 89 sätestatule. (2) Kui hagi tagamise abinõusid oli kohaldatud enne pankrotimenetluse algatamise otsustamist ja kohus ei otsusta teisiti, jäävad need pankrotimenetluse algatamisel kehtima. (3) Pankrotiavalduse tagamise määruse täidab ajutine haldur täitemenetluse seadustikus sätestatud korras. (4) Määruse peale, millega pankrotiavaldus tagati, võib esitada erikaebuse isik, kelle õigust on määrusega kitsendatud.",
      "rdfs:label": {
        "@value": "PankrS_Par_18 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_18_v751863"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_18_v751863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus võib pankrotiavalduse tagamiseks rakendada kõiki hagi tagamise abinõusid, samuti kohaldada võlgniku suhtes elukohast lahkumise keeldu vastavalt käesoleva seaduse §-s 88 ja võlgniku sundtoomist ja aresti vastavalt §-s 89 sätestatule. (2) Kui hagi tagamise abinõusid oli kohaldatud enne pankrotimenetluse algatamise otsustamist ja kohus ei otsusta teisiti, jäävad need pankrotimenetluse algatamisel kehtima. (3) Pankrotiavalduse tagamise määruse täidab ajutine haldur täitemenetluse seadustikus sätestatud korras. (4) Määruse peale, millega pankrotiavaldus tagati, võib esitada erikaebuse isik, kelle õigust on määrusega kitsendatud. (5) Pankrotiavalduse tagamise abinõude rakendamine ei mõjuta käsutustehingu kehtivust, mis on tehtud asjaõigusseaduse (RT I 1993, 39, 590; 1999, 44, 509; 2001, 34, 185; 93, 565; 2002, 47, 297; 53, 336; 99, 579; 2003, 13, 64; 17, 95; 78, 523; 2004, 20, 141) §-s 314 1 nimetatud finantstagatise kokkuleppest tuleneva õiguse teostamiseks või kohustuse täitmiseks, samuti krediidiasutuste seaduse (RT I 1999, 23, 349; 2002, 17, 96; 21, 117; 23, 131; 53, 336; 63, 387; 102, 600; 105, 612; 2003, 17, 95; 23, 133; 81, 544) § 87 lõikes 2 nimetatud maksesüsteemi vahendusel või väärtpaberituru seaduse (RT I 2001, 89, 532; 2002, 23, 131; 63, 387; 102, 600; 105, 612; 2003, 81, 544; 88, 591) § 213 lõikes 1 nimetatud väärtpaberiarveldussüsteemi vahendusel teostatavaid tasaarvestusi.",
      "rdfs:label": {
        "@value": "PankrS_Par_18 (redaktsioon 751863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751863",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_18_v928068"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/751863",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_18_v928068",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus võib pankrotiavalduse tagamiseks rakendada kõiki hagi tagamise abinõusid, samuti kohaldada võlgniku suhtes elukohast lahkumise keeldu vastavalt käesoleva seaduse § -s 88 ja võlgniku sundtoomist ja aresti vastavalt § -s 89 sätestatule. (2) Kui hagi tagamise abinõusid oli kohaldatud enne pankrotimenetluse algatamise otsustamist ja kohus ei otsusta teisiti, jäävad need pankrotimenetluse algatamisel kehtima. (3) Pankrotiavalduse tagamise määruse täidab ajutine haldur täitemenetluse seadustikus sätestatud korras. [Lõike 4 sõnastus kuni 31. 12. 2005] (4) Määruse peale, millega pankrotiavaldus tagati, võib esitada erikaebuse isik, kelle õigust on määrusega kitsendatud. [Lõike 4 sõnastus alates 1. 01. 2006] (4) Määruse peale, millega pankrotiavaldus tagati, võib esitada määruskaebuse isik, kelle õigust on määrusega kitsendatud. (5) Pankrotiavalduse tagamise abinõude rakendamine ei mõjuta käsutustehingu kehtivust, mis on tehtud asjaõigusseaduse (RT I 1993, 39, 590; 1999, 44, 509; 2001, 34, 185; 93, 565; 2002, 47, 297; 53, 336; 99, 579; 2003, 13, 64; 17, 95; 78, 523; 2004, 20, 141) § -s 314 1 nimetatud finantstagatise kokkuleppest tuleneva õiguse teostamiseks või kohustuse täitmiseks, samuti krediidiasutuste seaduse (RT I 1999, 23, 349; 2002, 17, 96; 21, 117; 23, 131; 53, 336; 63, 387; 102, 600; 105, 612; 2003, 17, 95; 23, 133; 81, 544) § 87 lõikes 2 nimetatud maksesüsteemi vahendusel või väärtpaberituru seaduse (RT I 2001, 89, 532; 2002, 23, 131; 63, 387; 102, 600; 105, 612; 2003, 81, 544; 88, 591) § 213 lõikes 1 nimetatud väärtpaberiarveldussüsteemi vahendusel teostatavaid tasaarvestusi.",
      "rdfs:label": {
        "@value": "PankrS_Par_18 (redaktsioon 928068)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928068",
      "estleg:supersededByVersion": {
