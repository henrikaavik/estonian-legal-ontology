        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121062014020",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 72",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_72_v130112021013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Halduri tegevuse üle haldusjärelevalvet või võlgniku või võlgniku lähikondse üle järelevalvet teostanud isik on kohustatud töö- või teenistussuhte ajal ja pärast selle lõppemist hoidma talle tema ülesannete tõttu teatavaks saanud äri-, panga- ja maksusaladust, samuti hoidma saladuses teiste inimeste perekonna- ja eraellu puutuvaid andmeid ning muud konfidentsiaalsena saadud teavet.",
      "rdfs:label": {
        "@value": "PankrS_Par_72 (redaktsioon 130112021013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112021013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130112021013",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 72",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
