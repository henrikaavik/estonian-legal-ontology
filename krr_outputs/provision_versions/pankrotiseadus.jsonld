      }
    },
    {
      "@id": "estleg:PankrS_Par_169_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Füüsilisest isikust võlgnik võidakse vabastada pankrotimenetluses täitmata jäänud kohustustest. Kohustustest vabastamine toimub käesolevas peatükis sätestatud alustel ja korras.",
      "rdfs:label": {
        "@value": "PankrS_Par_169 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_169_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
