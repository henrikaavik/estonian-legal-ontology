      "estleg:provisionRef": "PankrS § 99",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_99_v104012021049",
      "@type": [
        "owl:NamedIndividual",
