      }
    },
    {
      "@id": "estleg:PankrS_Par_168_v129062011014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_168"
      },
      "estleg:versionValidFrom": {
