    },
    {
      "@id": "estleg:PankrS_Par_24_v22226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pankrotimenetluses on kohtu pädevuses: pankrotimenetluse algatamine; pankroti väljakuulutamine; ajutise halduri ja halduri nimetamine ja tasu määramine ning järelevalve ajutise halduri ja halduri tegevuse üle seaduses sätestatud ulatuses; kompromissi kinnitamine ja tühistamine; nõuete kaitsmise vaidluste lahendamine; vara tagasivõitmise hagide läbivaatamine; võlausaldajate üldkoosoleku otsuste peale esitatud kaebuste läbivaatamine; jaotusettepaneku kinnitamine; pankrotimenetluse lõpetamine; muude seadusest tulenevate ülesannete täitmine.",
      "rdfs:label": {
        "@value": "PankrS_Par_24 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_24_v257670"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22226",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 24",
      "estleg:partOfAct": {
