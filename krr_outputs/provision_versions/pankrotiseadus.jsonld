      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Halduri tegevuse peale võivad võlausaldaja ja võlgnik kaevata pankrotitoimkonnale, võlausaldajate üldkoosolekule, kohtule või Justiitsministeeriumile.",
      "rdfs:label": {
        "@value": "PankrS_Par_67 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
