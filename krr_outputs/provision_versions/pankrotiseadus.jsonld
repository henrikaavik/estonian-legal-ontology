      }
    },
    {
      "@id": "estleg:PankrS_Par_174_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_174"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlgniku kohustustest vabastamise menetluse kestel ei saa pankrotivõlausaldajad pöörata sissenõuet võlgniku varale. (2) Võlausaldajad, kelle nõue võlgniku vastu on tekkinud pärast võlgniku kohustustest vabastamise menetluse algatamist, ei saa menetluse kestel pöörata sissenõuet usaldusisikule üleandmisele kuuluvatele rahasummadele.",
      "rdfs:label": {
        "@value": "PankrS_Par_174 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_174_v13260597"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 174",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_174_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_174"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlgniku kohustustest vabastamise menetluse kestel ei saa pankrotivõlausaldajad, sealhulgas need pankrotivõlausaldajad, kes ei ole pankrotimenetluses nõudeid esitanud, pöörata sissenõuet võlgniku varale. (2) Võlausaldajad, kelle nõue võlgniku vastu on tekkinud pärast pankroti väljakuulutamist, ei saa võlgniku kohustustest vabastamise menetluse kestel pöörata sissenõuet usaldusisikule üleandmisele kuuluvatele rahasummadele.",
      "rdfs:label": {
        "@value": "PankrS_Par_174 (redaktsioon 13260597)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260597",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_174_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260597",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 174",
      "estleg:partOfAct": {
