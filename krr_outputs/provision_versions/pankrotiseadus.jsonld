      }
    },
    {
      "@id": "estleg:PankrS_Par_150_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_150"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrotimenetluse kulud on: kohtukulud; ajutise halduri tasu; halduri tasu; pankrotitoimkonna liikmete tasu; ajutise halduri ja halduri tehtud vajalikud kulutused oma ülesannete täitmiseks. (2) Kui pankrotiavaldus rahuldatakse, samuti kui pankrotimenetlus lõpetatakse kompromissiga, tasutakse pankrotimenetluse kulud pankrotivarast. (3) Kui kohus jätab võlausaldaja pankrotiavalduse rahuldamata või läbi vaatamata, samuti kui pankrotimenetlus lõpetatakse seetõttu, et võlausaldaja oma pankrotiavaldusest loobub, hüvitab pankrotimenetluse kulud võlausaldaja. (4) Pankrotimenetluse raugemise korral otsustab kohus pankrotimenetluse kulude jagamise asjaolude kohaselt. (5) Pankrotimenetluse kulude kohta tehtud määruse peale võib esitada erikaebuse.",
      "rdfs:label": {
        "@value": "PankrS_Par_150 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_150_v928068"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 150",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_150_v928068",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_150"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrotimenetluse kulud on: kohtukulud; ajutise halduri tasu; halduri tasu; pankrotitoimkonna liikmete tasu; ajutise halduri ja halduri tehtud vajalikud kulutused oma ülesannete täitmiseks. (2) Kui pankrotiavaldus rahuldatakse, samuti kui pankrotimenetlus lõpetatakse kompromissiga, tasutakse pankrotimenetluse kulud pankrotivarast. (3) Kui kohus jätab võlausaldaja pankrotiavalduse rahuldamata või läbi vaatamata, samuti kui pankrotimenetlus lõpetatakse seetõttu, et võlausaldaja oma pankrotiavaldusest loobub, hüvitab pankrotimenetluse kulud võlausaldaja. (4) Pankrotimenetluse raugemise korral otsustab kohus pankrotimenetluse kulude jagamise asjaolude kohaselt. [Lõike 5 sõnastus kuni 31. 12. 2005] (5) Pankrotimenetluse kulude kohta tehtud määruse peale võib esitada erikaebuse. [Lõike 5 sõnastus alates 1. 01. 2006] (5) Pankrotimenetluse kulude kohta tehtud määruse peale võib esitada määruskaebuse.",
      "rdfs:label": {
        "@value": "PankrS_Par_150 (redaktsioon 928068)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928068",
