        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrot käesoleva seaduse tähenduses on võlgniku kohtuotsusega väljakuulutatud maksejõuetus. (2) Võlgnik on maksejõuetu, kui ta ei suuda rahuldada võlausaldaja nõudeid ja see suutmatus ei ole võlgniku majanduslikust olukorrast tulenevalt ajutine.",
      "rdfs:label": {
        "@value": "PankrS_Par_1 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_1_v257670"
      },
      "estleg:versionValidTo": {
