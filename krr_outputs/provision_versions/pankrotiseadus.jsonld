      }
    },
    {
      "@id": "estleg:PankrS_Par_140_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui pankrotivarasse kuuluv ese on koormatud pandiõiguse või muu asjaõigusega, mis annab võlausaldajale õiguse nõuda koormatud eseme sundmüüki, peab haldur koormatud eseme müüma kolme kuu jooksul, koormatud kinnisasja aga nelja kuu jooksul, arvates ajast, mil haldur võis alustada pankrotivara müüki.",
      "rdfs:label": {
        "@value": "PankrS_Par_140 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_140_v13260597"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_140_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui pankrotivarasse kuuluv ese on koormatud pandiõiguse või muu asjaõigusega, mis annab võlausaldajale õiguse nõuda koormatud eseme sundmüüki, müüb haldur koormatud eseme kolme kuu jooksul, koormatud kinnisasja aga nelja kuu jooksul arvates ajast, millal haldur võis alustada pankrotivara müüki, arvestades §-des 133 ja 134 sätestatut.",
      "rdfs:label": {
        "@value": "PankrS_Par_140 (redaktsioon 13260597)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260597",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260597",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_141_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettevõtte või selle organisatsiooniliselt iseseisva osa võib haldur müüa üksnes pankrotitoimkonna nõusolekul. (2) Ettevõtte või selle organisatsiooniliselt iseseisva osa võib müüa üksnes võlausaldajate üldkoosoleku nõusolekul, kui omandaja või isik, kes omab omandajaks olevas juriidilises isikus otseselt või kaudselt rohkem kui 1/5 suurust osalust, on: võlgniku lähikondne; võlausaldaja, kelle nõuded moodustavad hinnanguliselt rohkem kui 1/5 pankrotimenetluses esitatud nõuete kogusummast.",
      "rdfs:label": {
        "@value": "PankrS_Par_141 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_141_v13260597"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 141",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_141_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettevõtte või selle organisatsiooniliselt iseseisva osa võib haldur müüa üksnes pankrotitoimkonna nõusolekul. (2) Enampakkumiseta võib ettevõtte või selle organisatsiooniliselt iseseisva osa müüa üksnes võlausaldajate üldkoosoleku nõusolekul, kui omandaja või isik, kes omab omandajaks olevas juriidilises isikus otseselt või kaudselt rohkem kui 1/5-suurust osalust, on: võlgniku lähikondne; võlausaldaja, kelle nõuded moodustavad hinnanguliselt rohkem kui 1/5 pankrotimenetluses esitatud nõuete kogusummast.",
      "rdfs:label": {
        "@value": "PankrS_Par_141 (redaktsioon 13260597)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260597",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260597",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 141",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
