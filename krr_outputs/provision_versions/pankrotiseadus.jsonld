      },
      "estleg:versionText": "Enne pankroti väljakuulutamist võlgniku varale kohaldatud arest lõpeb pankroti väljakuulutamisega.",
      "rdfs:label": {
        "@value": "PankrS_Par_45 (redaktsioon 992422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992422",
