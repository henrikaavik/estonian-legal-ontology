    {
      "@id": "estleg:PankrS_Par_58_v22226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tööandja pankroti korral jätkab haldur töölepingu täitmist või lõpetab selle seaduses sätestatud korras. (2) --(3) [Kehtetud] (3¹) Tööandja pankroti või käesoleva seaduse § 15 lõike 1 punktis 2 sätestatud juhul pankrotimenetluse raugemise tõttu saamata jäänud palga, puhkusetasu ja töölepingu lõpetamise hüvitise maksab töötajale Eesti Töötukassa töötuskindlustuse seaduses (RT I 2001, 59, 359) sätestatud korras. (4) [Kehtetu]",
      "rdfs:label": {
        "@value": "PankrS_Par_58 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_58_v257670"
      },
      "estleg:versionValidTo": {
