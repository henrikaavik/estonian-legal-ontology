      }
    },
    {
      "@id": "estleg:PankrS_Par_160_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_160"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus lõpetab pankrotimenetluse võlgniku avalduse alusel, kui menetluse lõpetamisega on nõustunud kõik tähtaegselt nõuded esitanud võlausaldajad. (2) Kui menetluse lõpetamisega ei ole nõustunud võlausaldaja, kelle nõude on haldur või võlgnik vaidlustanud või kelle nõue on pandiga tagatud, siis otsustab kohus, kas menetluse lõpetamine selle võlausaldaja nõusolekuta või talle tagatist andmata on võimalik.",
      "rdfs:label": {
        "@value": "PankrS_Par_160 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_160_v13260597"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 160",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_160_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_160"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus lõpetab pankrotimenetluse võlgniku avalduse alusel, kui menetluse lõpetamisega on nõustunud kõik tähtaegselt nõuded esitanud võlausaldajad. (2) Kui menetluse lõpetamisega ei ole nõustunud võlausaldaja, kelle nõude on haldur või võlgnik vaidlustanud või kelle nõue on pandiga tagatud, siis otsustab kohus, kas menetluse lõpetamine selle võlausaldaja nõusolekuta või talle tagatist andmata on võimalik. (3) Kui juriidilisest isikust võlgnik on püsivalt maksejõuetu, otsustab kohus juriidilisest isikust võlgniku likvideerimise menetluse lõpetamise määrusega. Juriidilisest isikust võlgniku likvideerib haldur kahe kuu jooksul nimetatud määruse jõustumisest arvates.",
      "rdfs:label": {
        "@value": "PankrS_Par_160 (redaktsioon 13260597)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260597",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_160_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260597",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 160",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_160_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_160"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus lõpetab pankrotimenetluse võlgniku avalduse alusel, kui menetluse lõpetamisega on nõustunud kõik tähtaegselt nõuded esitanud võlausaldajad. (2) Kui menetluse lõpetamisega ei ole nõustunud võlausaldaja, kelle nõude on haldur või võlgnik vaidlustanud või kelle nõue on pandiga tagatud, siis otsustab kohus, kas menetluse lõpetamine selle võlausaldaja nõusolekuta või talle tagatist andmata on võimalik. (3) Kui juriidilisest isikust võlgnik on püsivalt maksejõuetu, otsustab kohus juriidilisest isikust võlgniku likvideerimise menetluse lõpetamise määrusega. Juriidilisest isikust võlgniku likvideerib haldur kahe kuu jooksul nimetatud määruse jõustumisest arvates. (4) Kui füüsilisest isikust võlgniku suhtes algatati ka kohustustest vabastamise menetlus, mis ei ole käesoleva paragrahvi lõikes 1 nimetatud avalduse esitamise ajaks veel lõppenud, lõpetab kohus koos pankrotimenetlusega ka kohustustest vabastamise menetluse füüsilise isiku maksejõuetuse seaduse § 52 alusel. Kui kohustustest vabastamise menetlus on juba lõpetatud, ei saa füüsilisest isikust võlgnik esitada käesoleva paragrahvi lõikes 1 nimetatud avaldust.",
      "rdfs:label": {
        "@value": "PankrS_Par_160 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_160_v120062022022"
      },
      "estleg:versionValidTo": {
        "@value": "2023-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 160",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_160_v120062022022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_160"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus lõpetab pankrotimenetluse võlgniku avalduse alusel, kui menetluse lõpetamisega on nõustunud kõik tähtaegselt nõuded esitanud võlausaldajad. (2) Kui menetluse lõpetamisega ei ole nõustunud võlausaldaja, kelle nõude on haldur või võlgnik vaidlustanud või kelle nõue on pandiga tagatud, siis otsustab kohus, kas menetluse lõpetamine selle võlausaldaja nõusolekuta või talle tagatist andmata on võimalik. (3) Kui juriidilisest isikust võlgnik on püsivalt maksejõuetu, otsustab kohus juriidilisest isikust võlgniku likvideerimise menetluse lõpetamise määrusega. Haldur likvideerib juriidilisest isikust võlgniku kahe kuu jooksul nimetatud määruse jõustumisest arvates ja esitab avalduse juriidilise isiku registrist kustutamiseks. Haldur kinnitab võlgniku registrist kustutamise avalduses, et takistusi registrist kustutamiseks ei ole. (4) Kui füüsilisest isikust võlgniku suhtes algatati ka kohustustest vabastamise menetlus, mis ei ole käesoleva paragrahvi lõikes 1 nimetatud avalduse esitamise ajaks veel lõppenud, lõpetab kohus koos pankrotimenetlusega ka kohustustest vabastamise menetluse füüsilise isiku maksejõuetuse seaduse § 52 alusel. Kui kohustustest vabastamise menetlus on juba lõpetatud, ei saa füüsilisest isikust võlgnik esitada käesoleva paragrahvi lõikes 1 nimetatud avaldust.",
      "rdfs:label": {
        "@value": "PankrS_Par_160 (redaktsioon 120062022022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022022",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022022",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 160",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_161_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_161"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teade pankrotimenetluse lõpetamise avalduse esitamisest käesoleva seaduse §-des 159 ja 160 sätestatud alustel avaldatakse väljaandes Ametlikud Teadaanded. Teates märgitakse, kus ja millal saab tutvuda avalduse aluseks olevate dokumentide ja võlausaldajate nõusolekutega, samuti selgitus, et avaldusele võib esitada vastuväite vastavalt käesoleva paragrahvi lõikele 2. (2) Vastuväite pankrotimenetluse lõpetamise avaldusele võivad võlausaldajad esitada kohtule 10 päeva jooksul käesoleva paragrahvi lõikes 1 nimetatud teate avaldamisest arvates. (3) Menetlust ei või lõpetada enne, kui haldur on teinud käesoleva seaduse §-s 146 nimetatud väljamaksed ja esitanud kohtule aruande, mis peab sisaldama käesoleva seaduse § 162 lõikes 2 nimetatud andmeid. (4) Kohus lõpetab menetluse pärast käesoleva paragrahvi lõikes 2 nimetatud tähtaja möödumist ja lõikes 3 nimetatud väljamaksete tegemist, tehes selle kohta määruse. Enne lõpetamise otsustamist kuulab kohus ära võlgniku, pankrotihalduri ja pankrotitoimkonna arvamuse. Vastuväite esitamise korral kuulab kohus ära ka vastuväite esitanud võlausaldaja arvamuse.",
      "rdfs:label": {
        "@value": "PankrS_Par_161 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_161_v928068"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 161",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_161_v928068",
