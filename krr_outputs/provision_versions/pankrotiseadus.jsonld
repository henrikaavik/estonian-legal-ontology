    {
      "@id": "estleg:PankrS_Par_112_v22226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kompromiss on tehtud pärast pankroti väljakuulutamist, on halduril õigus kompromissi kehtivuse ajal vara pankrotivarasse tagasi nõuda või tagasi võita. Pankrotivarasse saadud varast täidab võlgnik kompromissotsusest tulenevaid kohustusi.",
      "rdfs:label": {
        "@value": "PankrS_Par_112 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_112_v257670"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22226",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_112_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus tunnistab kehtetuks võlgniku ja tema abikaasa abieluvaralepingu või ühisvara jagamise kokkuleppe, millega võlgnik olulisel määral oma varast või oma osast ühisomandis loobus, kui abieluleping või ühisvara jagamise kokkulepe on sõlmitud: ühe aasta jooksul enne pankrotimenetluse algatamist, samuti pankrotimenetluse algatamisest kuni pankroti väljakuulutamiseni; enne käesoleva lõike punktis 1 nimetatud tähtaja algust, kuid viie aasta jooksul enne pankrotimenetluse algatamist, kui võlgnik või tema abikaasa ei tõenda, et võlgnik oli vara jagamise või varast loobumise ajal maksejõuline ega muutunud maksejõuetuks ühisvara jagamise või varast loobumise tõttu.",
      "rdfs:label": {
        "@value": "PankrS_Par_112 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_112_v114032011037"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_112_v114032011037",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus tunnistab kehtetuks võlgniku ja tema abikaasa abieluvaralepingu või ühisvara jagamise kokkuleppe, millega võlgnik olulisel määral oma varast või oma osast ühisomandis loobus, kui abieluleping või ühisvara jagamise kokkulepe on sõlmitud: ühe aasta jooksul enne ajutise halduri nimetamist, samuti ajutise halduri nimetamisest kuni pankroti väljakuulutamiseni; enne käesoleva lõike punktis 1 nimetatud tähtaja algust, kuid viie aasta jooksul enne ajutise halduri nimetamist, kui võlgnik või tema abikaasa ei tõenda, et võlgnik oli vara jagamise või varast loobumise ajal maksejõuline ega muutunud maksejõuetuks ühisvara jagamise või varast loobumise tõttu.",
      "rdfs:label": {
        "@value": "PankrS_Par_112 (redaktsioon 114032011037)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032011037",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_112_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032011037",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_112_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus tunnistab kehtetuks võlgniku ja tema abikaasa abieluvaralepingu või ühisvara jagamise kokkuleppe, millega võlgnik olulisel määral oma varast või oma osast ühisomandis loobus, kui abieluleping või ühisvara jagamise kokkulepe on sõlmitud: ühe aasta jooksul enne ajutise halduri või usaldusisiku nimetamist, samuti ajutise halduri või usaldusisiku nimetamisest kuni pankroti väljakuulutamiseni; enne käesoleva lõike punktis 1 nimetatud tähtaja algust, kuid viie aasta jooksul enne ajutise halduri või usaldusisiku nimetamist, kui võlgnik või tema abikaasa ei tõenda, et võlgnik oli vara jagamise või varast loobumise ajal maksejõuline ega muutunud maksejõuetuks ühisvara jagamise või varast loobumise tõttu.",
      "rdfs:label": {
        "@value": "PankrS_Par_112 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_112_v106072023061"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_112_v106072023061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohus tunnistab kehtetuks võlgniku ja tema abikaasa abieluvaralepingu, võlgniku ja tema registreeritud elukaaslase kooselulepingu varalisi õigusi puudutavas osas või ühisvara jagamise kokkuleppe, millega võlgnik olulisel määral oma varast või oma osast ühisvaras loobus, kui abielu, kooseluleping või ühisvara jagamise kokkulepe on sõlmitud: ühe aasta jooksul enne ajutise halduri või usaldusisiku nimetamist, samuti ajutise halduri või usaldusisiku nimetamisest kuni pankroti väljakuulutamiseni; enne käesoleva paragrahvi punktis 1 nimetatud tähtaja algust, kuid viie aasta jooksul enne ajutise halduri nimetamist, kui võlgnik, tema abikaasa või registreeritud elukaaslane ei tõenda, et võlgnik oli vara jagamise või varast loobumise ajal maksejõuline ega muutunud maksejõuetuks ühisvara jagamise või varast loobumise tõttu.",
      "rdfs:label": {
        "@value": "PankrS_Par_112 (redaktsioon 106072023061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072023061",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072023061",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_113_v22226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kompromissettepanek esitatakse enne pankroti väljakuulutamist, võib kohus võlausaldajate üldkoosoleku taotlusel nõuda võlgnikult vande andmist enne kompromissi tegemist.",
      "rdfs:label": {
        "@value": "PankrS_Par_113 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_113_v257670"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22226",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 113",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_113_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus tunnistab kehtetuks rahalise kohustuse täitmise võlausaldajale, kui kohustus täideti: pankrotimenetluse algatamisest kuni pankroti väljakuulutamiseni; kolme kuu jooksul enne pankrotimenetluse algatamist, kui täitmine toimus ebatavalise maksevahendiga või enne täitmise tähtpäeva või üht võlausaldajat teisele eelistades, samuti kui võlgnik oli täitmise ajal maksejõuetu ja võlausaldaja teadis või pidi võlgniku maksejõuetusest teadma; kahe aasta jooksul enne pankrotimenetluse algatamist võlgniku lähikondsele, kui lähikondne ega võlgnik ei tõenda, et võlgnik oli sel ajal maksejõuline ega muutunud maksejõuetuks kohustuse täitmise tõttu. (2) Võlgniku lähikondse puhul eeldatakse, et ta võlgniku maksejõuetust teadis.",
      "rdfs:label": {
        "@value": "PankrS_Par_113 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_113_v114032011037"
      },
      "estleg:versionValidTo": {
        "@value": "2011-03-23",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 113",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_113_v114032011037",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus tunnistab kehtetuks rahalise kohustuse täitmise võlausaldajale, kui kohustus täideti: ajutise halduri nimetamisest kuni pankroti väljakuulutamiseni; kolme kuu jooksul enne ajutise halduri nimetamist, kui täitmine toimus ebatavalise maksevahendiga või enne täitmise tähtpäeva või üht võlausaldajat teisele eelistades, samuti kui võlgnik oli täitmise ajal maksejõuetu ja võlausaldaja teadis või pidi võlgniku maksejõuetusest teadma; kahe aasta jooksul enne ajutise halduri nimetamist võlgniku lähikondsele, kui lähikondne ega võlgnik ei tõenda, et võlgnik oli sel ajal maksejõuline ega muutunud maksejõuetuks kohustuse täitmise tõttu. (2) Võlgniku lähikondse puhul eeldatakse, et ta võlgniku maksejõuetust teadis.",
      "rdfs:label": {
        "@value": "PankrS_Par_113 (redaktsioon 114032011037)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032011037",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_113_v120062022021"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/114032011037",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 113",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_113_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_113"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus tunnistab kehtetuks rahalise kohustuse täitmise võlausaldajale, kui kohustus täideti: ajutise halduri või usaldusisiku nimetamisest kuni pankroti väljakuulutamiseni; kolme kuu jooksul enne ajutise halduri või usaldusisiku nimetamist, kui täitmine toimus ebatavalise maksevahendiga või enne täitmise tähtpäeva või üht võlausaldajat teisele eelistades, samuti kui võlgnik oli täitmise ajal maksejõuetu ja võlausaldaja teadis või pidi võlgniku maksejõuetusest teadma; kahe aasta jooksul enne ajutise halduri või usaldusisiku nimetamist võlgniku lähikondsele, kui lähikondne ega võlgnik ei tõenda, et võlgnik oli sel ajal maksejõuline ega muutunud maksejõuetuks kohustuse täitmise tõttu. (2) Võlgniku lähikondse puhul eeldatakse, et ta võlgniku maksejõuetust teadis.",
      "rdfs:label": {
        "@value": "PankrS_Par_113 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 113",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_113_1_v120062022021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_113_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui võlgniku suhtes on läbi viidud saneerimismenetlus, ei saa järgnevas pankrotimenetluses tagasi võita tehinguid, millega: võlausaldaja rahastas võlgnikku saneerimismenetluses, et kinnitada ja täita saneerimiskava, ning sellise rahastuse suuruse, allikad ja tingimused on kohus saneerimiskavaga kinnitanud (edaspidi uus rahastamine); võlausaldaja rahastas võlgnikku saneerimismenetluse avalduse esitamise ja saneerimiskava kinnitamise vahelisel ajal ning see oli mõistlikel tingimustel ja viivitamata vajalik ettevõtja tegevuse jätkamiseks, tema väärtuse säilitamiseks või suurendamiseks (edaspidi vaherahastamine). (2) Käesoleva paragrahvi lõikes 1 nimetatud pankrotimenetluses ei ole saneerimiskava üle peetavate läbirääkimiste edendamiseks tehtud mõistlik ja viivitamata vajalik tehing tagasivõidetav üksnes seetõttu, et selline tehing kahjustas kõikide võlausaldajate huve, eeldusel et kohus on saneerimiskava kinnitanud ja tehing ei ole tehtud pärast seda, kui võlgnik ei suutnud enam oma sissenõutavaid kohustusi täita. Nimetatud tehingu eesmärgiks on muu hulgas: saneerimiskava üle peetavate läbirääkimiste, vastuvõtmise või kinnitamise, samuti saneerimismenetlusega tihedalt seotud küsimustes erialase nõu küsimise eest tasude maksmine ja kulude kandmine; töötajate sissenõutavaks muutunud töötasu maksmine; muud tavapärase majandustegevuse osana tehtud maksed. (3) Käesoleva paragrahvi lõikes 1 nimetatud pankrotimenetluses ei ole saneerimiskava rakendamise edendamiseks tehtud mõistlik ja viivitamata vajalik tehing tagasivõidetav üksnes seetõttu, et selline tehing kahjustas kõikide võlausaldajate huve, eeldusel et tehing on tehtud kooskõlas saneerimiskavaga.",
      "rdfs:label": {
        "@value": "PankrS_Par_113_1 (redaktsioon 120062022021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/120062022021",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 113_1",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_114_v22226",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kompromissi täitmise järele vaatab haldur. (2) Kui kompromiss on tehtud enne pankroti väljakuulutamist, nimetab kohus üheaegselt kompromissotsuse kinnitamisega halduriks võlausaldajate üldkoosoleku esitatud isiku. Kui esitatud isik ei vasta paragrahvis 29 sätestatud nõuetele, nimetab kohus halduriks teise isiku.",
      "rdfs:label": {
        "@value": "PankrS_Par_114 (redaktsioon 22226)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22226",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_114_v257670"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22226",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 114",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_114_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus tunnistab kehtetuks tagatise andmise, kui tagatis anti: pankrotimenetluse algatamisest kuni pankroti väljakuulutamiseni; kuue kuu jooksul enne pankrotimenetluse algatamist ja tagatis seati juba tekkinud kohustuse tagamiseks, kui võlgnik ei olnud kohustuse tekkimisel sellise tagatise andmiseks kohustatud, samuti kui võlgnik oli tagatise andmise ajal maksejõuetu ja tagatise saaja teadis või pidi võlgniku maksejõuetusest teadma; kahe aasta jooksul enne pankrotimenetluse algatamist, kui tagatise saajaks on võlgniku lähikondne ja kui tagatise saaja või võlgnik ei tõenda, et võlgnik oli tagatise andmise ajal maksejõuline. (2) Tagatise andmist ei saa tagasi võita, kui tagatis anti laenu või muu krediidilepingu tagamiseks ja võlgnik sai pärast tagatise andmist enda käsutusse tagatud lepingu järgi tagatise väärtusele vastava rahasumma, välja arvatud käesoleva paragrahvi lõike 1 punktis 3 nimetatud juhul. (3) Võlgniku lähikondse puhul eeldatakse, et ta võlgniku maksejõuetusest teadis.",
      "rdfs:label": {
        "@value": "PankrS_Par_114 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_114_v751863"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 114",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_114_v751863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_114"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus tunnistab kehtetuks tagatise andmise, kui tagatis anti: pankrotimenetluse algatamisest kuni pankroti väljakuulutamiseni; kuue kuu jooksul enne pankrotimenetluse algatamist ja tagatis seati juba tekkinud kohustuse tagamiseks, kui võlgnik ei olnud kohustuse tekkimisel sellise tagatise andmiseks kohustatud, samuti kui võlgnik oli tagatise andmise ajal maksejõuetu ja tagatise saaja teadis või pidi võlgniku maksejõuetusest teadma; kahe aasta jooksul enne pankrotimenetluse algatamist, kui tagatise saajaks on võlgniku lähikondne ja kui tagatise saaja või võlgnik ei tõenda, et võlgnik oli tagatise andmise ajal maksejõuline. (2) Tagatise andmist ei saa tagasi võita, kui tagatis anti laenu või muu krediidilepingu tagamiseks ja võlgnik sai pärast tagatise andmist enda käsutusse tagatud lepingu järgi tagatise väärtusele vastava rahasumma, välja arvatud käesoleva paragrahvi lõike 1 punktis 3 nimetatud juhul. (3) Võlgniku lähikondse puhul eeldatakse, et ta võlgniku maksejõuetusest teadis. (4) Asjaõigusseaduse §-s 314 1 sätestatud finantstagatise kokkuleppest tulenevate õiguste teostamiseks või kohustuste täitmiseks tehtud tehingut ei saa tagasi võita.",
      "rdfs:label": {
        "@value": "PankrS_Par_114 (redaktsioon 751863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "751863",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_114_v928068"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/751863",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 114",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
