    {
      "@id": "estleg:PankrS_Par_122_v104012021049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_122"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui vara on võlgniku ja tema abikaasa ühisomandis, nõuab haldur ühisvara jagamist ja võlgniku osa ühisomandist. Võlgnikul on õigus koos halduriga protsessis osaleda. Protsessiosalisena on võlgnikul õigus anda üksnes seletusi. (2) Kehtetu - (3) Kehtetu - (4) Kui haldur on pankrotivarasse arvanud vara, mis on võlgniku ja tema abikaasa ühisomandis, võib võlgniku abikaasa esitada hagi ühisvara jagamiseks ja oma osa välistamiseks pankrotivarast. Võlgnikul on õigus koos halduriga protsessis osaleda. Protsessiosalisena on võlgnikul õigus anda üksnes seletusi. (5) Kehtetu -",
      "rdfs:label": {
        "@value": "PankrS_Par_122 (redaktsioon 104012021049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104012021049",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_122_v106072023061"
      },
      "estleg:versionValidTo": {
        "@value": "2023-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104012021049",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 122",
