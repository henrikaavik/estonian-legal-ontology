    },
    {
      "@id": "estleg:PankrS_Par_65_1_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_65_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduri tasu alammäär pankrotivaralt suurusega kuni 100 000 krooni on 20% pankrotivarast. Üle 100 000-krooniselt pankrotivaralt makstava tasu alammäärad on järgmised: (2) Haldurile kuni 100 000 krooni suuruselt pankrotivaralt makstava tasu ülemmäär on 35% pankrotivarast. Üle 100 000-krooniselt pankrotivaralt makstava tasu ülemmäärad on järgmised: (3) Halduri tasu ülemmäär pankrotivaralt, mille suurus ületab 10 000 000 krooni, on kuni 5% pankrotivarast. (4) Tasu suurus ei või olla väiksem kui 1% pankrotivara müügist ja tagasivõitmisest ning halduri muu tegevuse tulemusena pankrotivarasse laekunud ja pankrotivara hulka arvatud rahast.",
      "rdfs:label": {
        "@value": "PankrS_Par_65_1 (redaktsioon 13260597)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13260597",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_65_1_v112112010015"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13260597",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 65_1",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_65_1_v112112010015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_65_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Halduri tasu alammäär pankrotivaralt suurusega kuni 6400 eurot on 20% pankrotivarast. Üle 6400 euro suuruselt pankrotivaralt makstava tasu alammäärad on järgmised: (2) Haldurile kuni 6400 euro suuruselt pankrotivaralt makstava tasu ülemmäär on 35% pankrotivarast. Üle 6400 euro suuruselt pankrotivaralt makstava tasu ülemmäärad on järgmised: (3) Halduri tasu ülemmäär pankrotivaralt, mille suurus ületab 640 000 eurot, on kuni 5% pankrotivarast. (4) Tasu suurus ei või olla väiksem kui 1% pankrotivara müügist ja tagasivõitmisest ning halduri muu tegevuse tulemusena pankrotivarasse laekunud ja pankrotivara hulka arvatud rahast.",
      "rdfs:label": {
        "@value": "PankrS_Par_65_1 (redaktsioon 112112010015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112112010015",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_65_1_v104012021049"
      },
      "estleg:versionValidTo": {
        "@value": "2021-01-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112112010015",
