      }
    },
    {
      "@id": "estleg:PankrS_Par_178_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_178"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kompromiss on võlgniku ja võlausaldajate vaheline kokkulepe võlgade tasumise kohta, mis seisneb võlgade vähendamises või nende tasumise tähtaja pikendamises. (2) Kompromiss tehakse võlgniku või halduri ettepanekul pankrotimenetluses pärast pankroti väljakuulutamist. Võlausaldajate üldkoosolek või pankrotitoimkond võib teha haldurile ülesandeks töötada välja kompromissettepanek. (3) Kompromissotsuse teeb võlausaldajate üldkoosolek. Kohus otsustab kompromissi kinnitamise, tehes selle kohta määruse.",
      "rdfs:label": {
        "@value": "PankrS_Par_178 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 178",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_179_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_179"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kompromissettepanekus määratakse, mis ulatuses ja mis tähtpäevaks võlgnik tasub võlad. Kompromissettepanekus tuleb põhjendada, et võlgnik suudab oma võlad selles ulatuses ja selleks tähtpäevaks tasuda. Kui võlgnik tegeleb majandus- või kutsetegevusega, esitatakse ettepaneku lisana majandus- või kutsetegevuse jätkamise kava ja ettevõtte tervendamiskava. (2) Kompromissettepaneku võib esitada kuni esimese jaotusettepaneku kinnitamiseni kohtu poolt.",
      "rdfs:label": {
        "@value": "PankrS_Par_179 (redaktsioon 257670)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "257670",
      "estleg:supersededByVersion": {
        "@id": "estleg:PankrS_Par_179_v13260597"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/257670",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 179",
      "estleg:partOfAct": {
        "@id": "estleg:PankrS_Map"
      }
    },
    {
      "@id": "estleg:PankrS_Par_179_v13260597",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_179"
      },
      "estleg:versionValidFrom": {
