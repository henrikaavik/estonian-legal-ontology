      }
    },
    {
      "@id": "estleg:PankrS_Par_58_v257670",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PankrS_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pankrotihalduri eksamil kontrollitakse isiku kutseoskuste ja isiksuseomaduste sobivust tööks pankrotihaldurina. (2) Eksami tegemise nõue ei kehti vandeadvokaadi ja vandeadvokaadi vanemabi suhtes. (3) Eksami tegemise korra kehtestab justiitsminister.",
      "rdfs:label": {
