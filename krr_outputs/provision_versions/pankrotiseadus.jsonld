        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 50–53 sätestatut kohaldatakse ka kompromissi kehtivuse ajal.",
      "rdfs:label": {
        "@value": "PankrS_Par_185 (redaktsioon 992422)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "992422",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/992422",
      "estleg:sourceAct": "Pankrotiseadus",
      "estleg:provisionRef": "PankrS § 185",
      "estleg:partOfAct": {
