      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1050040_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti asukoht on Tallinn. Ameti mujal asuvate üksuste ja esinduste asukoha ning postiaadressi määrab ameti peadirektor. Ameti asukoht on Tallinn. Ameti mujal asuvate üksuste ja esinduste asukoha ning postiaadressi määrab ameti peadirektor.",
      "rdfs:label": {
