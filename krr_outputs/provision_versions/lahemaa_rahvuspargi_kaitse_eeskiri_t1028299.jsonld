        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist. Määrus jõustub kümnendal päeval pärast Riigi Teatajas avaldamist.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_24 (redaktsioon 1028299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028299",
      "estleg:sourceAct": "Lahemaa rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1028299 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028299_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1028299_Par_25_v1028299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028299_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui enne käesoleva määruse jõustumist, kuid pärast looduskaitseseaduse jõustumist kehtestatud detailplaneering on vastuolus käesoleva määrusega, saab selle detailplaneeringu alusel seatud ehitusõigust realiseerida ka pärast käesoleva määruse jõustumist. Kui enne käesoleva määruse jõustumist, kuid pärast looduskaitseseaduse jõustumist kehtestatud detailplaneering on vastuolus käesoleva määrusega, saab selle detailplaneeringu alusel seatud ehitusõigust realiseerida ka pärast käesoleva määruse jõustumist. 2 (2) Enne 31. detsembrit 2010. a kehtestatud detailplaneeringute alusel koostatavatel ehitusprojektidel on nõutav arhitektuursete lisatingimuste taotlemine. Lisatingimused tuleb kooskõlastada kaitseala valitsejaga. Enne 31. detsembrit 2010. a kehtestatud detailplaneeringute alusel koostatavatel ehitusprojektidel on nõutav arhitektuursete lisatingimuste taotlemine. Lisatingimused tuleb kooskõlastada kaitseala valitsejaga.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_25 (redaktsioon 1028299)",
        "@language": "et"
      },
