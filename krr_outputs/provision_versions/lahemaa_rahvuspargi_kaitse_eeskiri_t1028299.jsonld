    {
      "@id": "estleg:Reg_1028299_Par_29_v1028299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028299_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lahemaa rahvuspargi kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 25. augusti 2004. a käskkirjaga nr 776 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5. Lahemaa rahvuspargi kaitse-eeskirja kehtestamise menetlus viidi läbi keskkonnaministri 25. augusti 2004. a käskkirjaga nr 776 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas5.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_29 (redaktsioon 1028299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028299",
      "estleg:sourceAct": "Lahemaa rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1028299 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028299_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1028299_Par_3_v1028299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028299_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Läänemere ranna ehituskeeluvöönd mandril ja Võsu jõe ehituskeeluvöönd Võsu aleviku tiheasustusalale jäävas osas on esitatud kaardil määruse lisas. Läänemere ranna ehituskeeluvöönd mandril ja Võsu jõe ehituskeeluvöönd Võsu aleviku tiheasustusalale jäävas osas on esitatud kaardil määruse lisas. 2 (2) Läänemere saartel on ehituskeeluvööndi laius 200 m. Läänemere saartel on ehituskeeluvööndi laius 200 m. 3 (3) Järvedel, ojadel, maaparandussüsteemide eesvooludel ja jõgedel, välja arvatud Pudisoo jõel ja Võsu jõel Võsu aleviku tiheasustusalale jäävas osas, arvestatakse ehituskeeluvööndi laiust vastavalt looduskaitseseadusele. Järvedel, ojadel, maaparandussüsteemide eesvooludel ja jõgedel, välja arvatud Pudisoo jõel ja Võsu jõel Võsu aleviku tiheasustusalale jäävas osas, arvestatakse ehituskeeluvööndi laiust vastavalt looduskaitseseadusele. 4 (4) Pudisoo jõe kaldal on ehituskeeluvööndi laius 100 meetrit. Pudisoo jõe kaldal on ehituskeeluvööndi laius 100 meetrit.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_3 (redaktsioon 1028299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028299",
      "estleg:sourceAct": "Lahemaa rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1028299 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028299_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1028299_Par_30_v1028299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028299_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_30 (redaktsioon 1028299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028299",
      "estleg:sourceAct": "Lahemaa rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1028299 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028299_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1028299_Par_4_v1028299",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1028299_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_4 (redaktsioon 1028299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028299",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028299",
      "estleg:sourceAct": "Lahemaa rahvuspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1028299 § 4",
      "estleg:partOfAct": {
