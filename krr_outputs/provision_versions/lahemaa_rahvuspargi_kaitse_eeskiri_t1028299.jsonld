      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loodusreservaadis on keelatud igasugune inimtegevus, sealhulgas inimeste viibimine, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamise eesmärgil ning kaitseala valitseja nõusolekul kaitseala seisundi jälgimise ja hindamise ning teadustegevuse eesmärgil. Loodusreservaadis on keelatud igasugune inimtegevus, sealhulgas inimeste viibimine, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamise eesmärgil ning kaitseala valitseja nõusolekul kaitseala seisundi jälgimise ja hindamise ning teadustegevuse eesmärgil.",
      "rdfs:label": {
        "@value": "Reg_1028299_Par_11 (redaktsioon 1028299)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1028299",
