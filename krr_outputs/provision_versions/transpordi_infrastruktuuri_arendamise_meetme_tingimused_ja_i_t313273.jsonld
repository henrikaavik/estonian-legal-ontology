        "@type": "xsd:date"
      },
      "estleg:versionText": "Meetme eesmärgiks on ÜF- ja ERF-suundade elluviimine ja eesmärkide saavutamine vastavalt rakenduskavale. Meetme eesmärgiks on ÜF- ja ERF-suundade elluviimine ja eesmärkide saavutamine vastavalt rakenduskavale.",
      "rdfs:label": {
        "@value": "Reg_313273_Par_2 (redaktsioon 313273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313273",
