      "dc:source": "Transpordi infrastruktuuri arendamise meetme tingimused ja investeeringute kava koostamise kord"
    },
    {
      "@id": "estleg:Reg_313273_Par_1_v313273",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_313273_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-04-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus kehtestab «Majanduskeskkonna arendamise rakenduskava» (edaspidi rakenduskava) prioriteetsete suundade «Strateegilise tähtsusega transpordiinvesteeringud (ÜF)» (edaspidi ÜF-suund) ja «Regionaalse tähtsusega transpordi infrastruktuuri arendamine (ERF)» (edaspidi ERF-suund) elluviimiseks toetuse andmise ja kasutamise tingimused ja korra ning investeeringute kava koostamise korra transpordi infrastruktuuri arendamise meetme (edaspidi meede) raames. Määrus kehtestab «Majanduskeskkonna arendamise rakenduskava» (edaspidi rakenduskava) prioriteetsete suundade «Strateegilise tähtsusega transpordiinvesteeringud (ÜF)» (edaspidi ÜF-suund) ja «Regionaalse tähtsusega transpordi infrastruktuuri arendamine (ERF)» (edaspidi ERF-suund) elluviimiseks toetuse andmise ja kasutamise tingimused ja korra ning investeeringute kava koostamise korra transpordi infrastruktuuri arendamise meetme (edaspidi meede) raames.",
      "rdfs:label": {
        "@value": "Reg_313273_Par_1 (redaktsioon 313273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "313273",
