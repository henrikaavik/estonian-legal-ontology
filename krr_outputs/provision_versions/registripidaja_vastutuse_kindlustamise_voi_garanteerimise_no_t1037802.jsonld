      "estleg:sourceAct": "Registripidaja vastutuse kindlustamise või garanteerimise nõuded",
      "estleg:provisionRef": "Reg_1037802 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037802_Map_2026"
      }
    },
