      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2002. a.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_11 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_2_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus ei laiene eksperdile, kes täidab oma kohustusi ametiülesandena.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_2 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_3_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnistaja või eksperdi kaasamise kulud kannab isik või haldusorgan, kelle taotlusel tunnistaja või ekspert menetlusse kaasati.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_3 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_4_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldusorgani taotlusel haldusmenetlusse kaasatud tunnistajal on õigus saada oma ülesannete täitmise eest keskmist töötasu. Kui tunnistaja ei esita haldusorganile tõendit oma keskmise palga kohta, makstakse talle hüvitist lähtudes Vabariigi Valitsuse kehtestatud kuupalga alammäärast.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_4 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_5_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eksperdil on õigus saada töötasu haldusorgani taotlusel tehtud töö eest.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_5 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_6_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldusorgani taotlusel haldusmenetlusse kaasatud ekspertidele makstakse ekspertiisi eest tunnitasu kuni 10 Vabariigi Valitsuse kehtestatud tunnipalga alammäära ulatuses.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_6 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_7_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tasu suuruse kindlaksmääramisel arvestab haldusorgan eksperdi kvalifikatsiooni, ekspertiisi keerukust ja ekspertiisi läbiviimiseks kulunud aega.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_7 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_8_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstakse sõidu-, korteri- ja päevaraha Vabariigi vastavalt „Tulumaksuseaduse“ § 13 lõike 3 punkti 1 alusel kehtestatud korrale.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_8 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_153650_Par_9_v153650",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_153650_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tasu ning hüvitis määratakse kindlaks ning hüvitatakse menetlusse kaasatud tunnistaja või eksperdi poolt haldusorganile esitatud kirjaliku avalduse alusel.",
      "rdfs:label": {
        "@value": "Reg_153650_Par_9 (redaktsioon 153650)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "153650",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/153650",
      "estleg:sourceAct": "Tunnistajale või eksperdile raha väljamaksmise kord ja väljaspool oma elukohta haldusmenetluses osalevale eksperdile või tunnistajale makstava sõidu-, korteri- ja päevaraha suurus",
      "estleg:provisionRef": "Reg_153650 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_153650_Map_2026"
      }
    },
