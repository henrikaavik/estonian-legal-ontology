      }
    },
    {
      "@id": "estleg:Reg_336405_Par_3_v336405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336405_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andmise eesmärk on elukeskkonna seire vastavalt Euroopa ühistele põhimõtetele ja keskkonnainfo regulaarne tootmine ning üldsusele esitamine. Toetuse andmise eesmärk on elukeskkonna seire vastavalt Euroopa ühistele põhimõtetele ja keskkonnainfo regulaarne tootmine ning üldsusele esitamine.",
      "rdfs:label": {
        "@value": "Reg_336405_Par_3 (redaktsioon 336405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336405",
      "estleg:sourceAct": "Meetme „Keskkonnaseire arendamine” tingimused",
      "estleg:provisionRef": "Reg_336405 § 3",
      "estleg:partOfAct": {
