      }
    },
    {
      "@id": "estleg:Reg_336405_Par_4_v336405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336405_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusasutus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 5 punktile 2 Keskkonnaministeerium (edaspidi rakendusasutus). Rakendusasutus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 5 punktile 2 Keskkonnaministeerium (edaspidi rakendusasutus). 2 (2) Rakendusüksus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 6 punktile 1 Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi rakendusüksus). Rakendusüksus on vastavalt Vabariigi Valitsuse 19. aprilli 2007. a määruse nr 111 «Perioodi 2007–2013 struktuuritoetuse andmist korraldavate asutuste määramine» § 6 punktile 1 Sihtasutus Keskkonnainvesteeringute Keskus (edaspidi rakendusüksus). 3 (3) Toetuse saajad on Keskkonnaagentuur ning Keskkonnaministeerium (edaspidi toetuse saaja). RT I 2013-05-29 5 129052013005 2013-06-01 Toetuse saajad on Keskkonnaagentuur ning Keskkonnaministeerium (edaspidi toetuse saaja).",
      "rdfs:label": {
        "@value": "Reg_336405_Par_4 (redaktsioon 336405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336405",
      "estleg:sourceAct": "Meetme „Keskkonnaseire arendamine” tingimused",
      "estleg:provisionRef": "Reg_336405 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336405_Map"
      }
    },
    {
      "@id": "estleg:Reg_336405_Par_5_v336405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336405_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetust antakse järgmistele Keskkonnaministeeriumi tegevustele: 1 1) keskkonnaseire erinevate tasandite andmehõive infotehnoloogiliste lahenduste arendamiseks ja tugisüsteemi soetamiseks; 2 2) valgalapõhiste veemajanduskavade haldamise, seire, aruandluse ja avalikustamise teenusepõhise infosüsteemi loomiseks ja arendamiseks; 3 3) kohalike omavalitsuste seirekavade juhendmaterjali ja seirekavade koostamiseks. RT I 2010 33 173 13326427 2010-06-21+03:00 Toetust antakse järgmistele Keskkonnaministeeriumi tegevustele: keskkonnaseire erinevate tasandite andmehõive infotehnoloogiliste lahenduste arendamiseks ja tugisüsteemi soetamiseks; valgalapõhiste veemajanduskavade haldamise, seire, aruandluse ja avalikustamise teenusepõhise infosüsteemi loomiseks ja arendamiseks; kohalike omavalitsuste seirekavade juhendmaterjali ja seirekavade koostamiseks. 2 (2) Toetust antakse järgmistele Keskkonnaagentuuri tegevustele: RT I 2013-05-29 5 129052013005 2013-06-01 1 1) hüdromeetrilise, meteoroloogilise ja rannikumere seirevõrgu infrastruktuuride projekteerimiseks ja väljaarendamiseks; 2 2) meteoroloogilise seirevõrgu tehniliseks rekonstrueerimiseks, täiustamiseks ja tänapäeva nõuete kohase aparatuuriga varustamiseks; 3 3) hüdromeetrilise seirevõrgu tehniliseks rekonstrueerimiseks, täiustamiseks ja tänapäeva nõuete kohase aparatuuriga varustamiseks; 4 4) rannikumere hüdromeetrilise seirevõrgu tihendamiseks, tehniliseks rekonstrueerimiseks, täiustamiseks ja tänapäeva nõuete kohase aparatuuriga varustamiseks; 5 5) seadmete installeerimiseks ning seadmete ja infotehnoloogiliste lahenduste kasutuselevõtuga seotud väljaõppeks. Toetust antakse järgmistele Keskkonnaagentuuri tegevustele: hüdromeetrilise, meteoroloogilise ja rannikumere seirevõrgu infrastruktuuride projekteerimiseks ja väljaarendamiseks; meteoroloogilise seirevõrgu tehniliseks rekonstrueerimiseks, täiustamiseks ja tänapäeva nõuete kohase aparatuuriga varustamiseks; hüdromeetrilise seirevõrgu tehniliseks rekonstrueerimiseks, täiustamiseks ja tänapäeva nõuete kohase aparatuuriga varustamiseks; rannikumere hüdromeetrilise seirevõrgu tihendamiseks, tehniliseks rekonstrueerimiseks, täiustamiseks ja tänapäeva nõuete kohase aparatuuriga varustamiseks; seadmete installeerimiseks ning seadmete ja infotehnoloogiliste lahenduste kasutuselevõtuga seotud väljaõppeks.",
      "rdfs:label": {
        "@value": "Reg_336405_Par_5 (redaktsioon 336405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336405",
      "estleg:sourceAct": "Meetme „Keskkonnaseire arendamine” tingimused",
      "estleg:provisionRef": "Reg_336405 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336405_Map"
      }
    },
    {
      "@id": "estleg:Reg_336405_Par_6_v336405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336405_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meetme raames antav toetus ei ole riigiabi «Konkurentsiseaduse» § 30 lõike 1 tähenduses. Meetme raames antav toetus ei ole riigiabi «Konkurentsiseaduse» § 30 lõike 1 tähenduses.",
      "rdfs:label": {
        "@value": "Reg_336405_Par_6 (redaktsioon 336405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336405",
      "estleg:sourceAct": "Meetme „Keskkonnaseire arendamine” tingimused",
      "estleg:provisionRef": "Reg_336405 § 6",
