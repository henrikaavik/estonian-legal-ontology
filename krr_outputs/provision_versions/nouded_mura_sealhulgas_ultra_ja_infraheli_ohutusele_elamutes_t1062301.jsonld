      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062301_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062301_Par_2_v1062301",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062301_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Müra normtasemete kohaldamisel arvestatakse: 1 1) ajavahemikku: päevane (7.00–23.00) ja öine (23.00–7.00); 2 2) müraallikat: auto-, raudtee- ja lennuliiklus, veesõidukite liiklus (edaspidi liiklus), meelelahutusüritused, tööstus-, teenindus- ja kaubandusettevõtted, tehnoseadmed ja -süsteemid; 3 3) müra iseloomu: püsiva või muutuva tasemega müra. Müra normtasemete kohaldamisel arvestatakse: ajavahemikku: päevane (7.00–23.00) ja öine (23.00–7.00); müraallikat: auto-, raudtee- ja lennuliiklus, veesõidukite liiklus (edaspidi liiklus), meelelahutusüritused, tööstus-, teenindus- ja kaubandusettevõtted, tehnoseadmed ja -süsteemid; müra iseloomu: püsiva või muutuva tasemega müra.",
      "rdfs:label": {
        "@value": "Reg_1062301_Par_2 (redaktsioon 1062301)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062301",
