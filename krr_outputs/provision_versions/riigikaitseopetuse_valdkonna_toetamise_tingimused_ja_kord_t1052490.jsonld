    {
      "@id": "estleg:Reg_1052490_Par_29_33_v1052490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052490_Par_29_33"
