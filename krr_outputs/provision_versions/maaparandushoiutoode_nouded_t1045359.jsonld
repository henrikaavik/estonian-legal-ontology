    {
      "@id": "estleg:Reg_1045359_Par_17_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Muu maaparandussüsteemi kuivenduse, niisutuse või veerežiimi kahepoolse reguleerimise rajatise nagu truup- ja kaevregulaatori ning ülevoolu hooldamisel täidetakse §-des 11 ja 12 sätestatud nõudeid. Muu maaparandussüsteemi kuivenduse, niisutuse või veerežiimi kahepoolse reguleerimise rajatise nagu truup- ja kaevregulaatori ning ülevoolu hooldamisel täidetakse §-des 11 ja 12 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_17 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
      "estleg:sourceAct": "Maaparandushoiutööde nõuded",
      "estleg:provisionRef": "Reg_1045359 § 17",
