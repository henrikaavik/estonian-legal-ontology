      }
    },
    {
      "@id": "estleg:Reg_1045359_Par_23_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Drenaažirikke asukoht tehakse kindlaks kuivendatud maa-ala taimestiku, mulla iseärasuste ja mulla veerežiimi uurimise ning torude videosondeerimise, läbipesemise või torustiku lahtikaevamise teel. RT I 2020-06-30 4 130062020004 2020-07-03 Drenaažirikke asukoht tehakse kindlaks kuivendatud maa-ala taimestiku, mulla iseärasuste ja mulla veerežiimi uurimise ning torude videosondeerimise, läbipesemise või torustiku lahtikaevamise teel. 2 (2) Purunenud drenaažitoru asendatakse uue nõuetekohaselt kaetud toruga. Purunenud drenaažitoru asendatakse uue nõuetekohaselt kaetud toruga. 3 (3) Drenaažitoru läbipesemisel ei tohi väljauhutavat vett suunata drenaažisüsteemi. Drenaažitoru läbipesemisel ei tohi väljauhutavat vett suunata drenaažisüsteemi.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_23 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
