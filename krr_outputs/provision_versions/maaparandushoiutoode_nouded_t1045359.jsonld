    },
    {
      "@id": "estleg:Reg_1045359_Par_26_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teekatte uuendamisel kruusaga või muu sobiliku materjaliga ja teeprofiili taastamisega tagatakse, et teele kogunev vesi valgub teekraavidesse kogu tee ulatuses. Kruusa või muud sobilikku materjali lisatakse teele kuni 15 sentimeetri paksuse kihina, mis on mõõdetud tihendatud olekus. RT I 2020-06-30 4 130062020004 2020-07-03 Teekatte uuendamisel kruusaga või muu sobiliku materjaliga ja teeprofiili taastamisega tagatakse, et teele kogunev vesi valgub teekraavidesse kogu tee ulatuses. Kruusa või muud sobilikku materjali lisatakse teele kuni 15 sentimeetri paksuse kihina, mis on mõõdetud tihendatud olekus. 2 (2) Teekattesse lisatakse kruusa või muud sobilikku materjali sellisel määral, et ebatasasused teel oleksid tasandatud ja kogu teekatte keskmine paksus vastaks maaparandussüsteemi ehitusprojekti nõuetele. Teekattesse lisatakse kruusa või muud sobilikku materjali sellisel määral, et ebatasasused teel oleksid tasandatud ja kogu teekatte keskmine paksus vastaks maaparandussüsteemi ehitusprojekti nõuetele.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_26 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
      "estleg:sourceAct": "Maaparandushoiutööde nõuded",
      "estleg:provisionRef": "Reg_1045359 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045359_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045359_Par_27_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teekraav ning teemaal paiknev maaparandussüsteemi rajatis uuendatakse, kui see ei toimi nõuetekohaselt. Teekraavi uuendamise käigus tehakse vajadusel ka §-s 5, § 6 lõigetes 1, 4 ja 5 ning §-des 7–9, 12 ja 21 nimetatud tööd. RT I 2020-06-30 4 130062020004 2020-07-03 Teekraav ning teemaal paiknev maaparandussüsteemi rajatis uuendatakse, kui see ei toimi nõuetekohaselt. Teekraavi uuendamise käigus tehakse vajadusel ka §-s 5, § 6 lõigetes 1, 4 ja 5 ning §-des 7–9, 12 ja 21 nimetatud tööd.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_27 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
      "estleg:sourceAct": "Maaparandushoiutööde nõuded",
      "estleg:provisionRef": "Reg_1045359 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045359_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045359_Par_28_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Poldri kuivendussüsteem uuendatakse 3. peatüki jagudes 1–4 sätestatud nõuete kohaselt. Poldri kuivendussüsteem uuendatakse 3. peatüki jagudes 1–4 sätestatud nõuete kohaselt. 2 (2) Poldri muu ehitis uuendatakse, kui see on lagunenud ega taga poldri nõuetekohast toimimist. Poldri muu ehitis uuendatakse, kui see on lagunenud ega taga poldri nõuetekohast toimimist.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_28 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
      "estleg:sourceAct": "Maaparandushoiutööde nõuded",
      "estleg:provisionRef": "Reg_1045359 § 28",
      "estleg:partOfAct": {
