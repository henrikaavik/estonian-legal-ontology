    {
      "@id": "estleg:Reg_1045359_Par_15_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teekraavi hooldamisel täidetakse §-des 5–9 sätestatud nõudeid. Teekraavi hooldamisel täidetakse §-des 5–9 sätestatud nõudeid. 2 (2) Teekraavi hooldamisel ei tohi jätta puittaimestikku kasvama eesvoolu või kuivenduskraavi põhja ega teepoolsele nõlvale ja kaldale, välja arvatud allee ja esteetilise või looduskaitselise väärtusega puud. RT I 2020-06-30 4 130062020004 2020-07-03 Teekraavi hooldamisel ei tohi jätta puittaimestikku kasvama eesvoolu või kuivenduskraavi põhja ega teepoolsele nõlvale ja kaldale, välja arvatud allee ja esteetilise või looduskaitselise väärtusega puud. 3 (3) Teemaal paikneva suudme ja drenaažikaevu hooldamisel täidetakse §-des 10–11 sätestatud nõudeid. Teemaal paikneva suudme ja drenaažikaevu hooldamisel täidetakse §-des 10–11 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_15 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
