    {
      "@id": "estleg:Reg_1045359_Par_22_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Drenaažisüsteem uuendatakse, kui see ei toimi nõuetekohaselt. Drenaažisüsteem uuendatakse, kui see ei toimi nõuetekohaselt. 2 (2) Drenaažisüsteemi uuendamiseks loetakse ka olemasolevate dreenidega ristsuunas täidis- või piludreenide ja dreenfiltrite rajamine ning drenaažitoru asendamine sama läbimõõduga drenaažitoruga. RT I 2020-06-30 4 130062020004 2020-07-03 Drenaažisüsteemi uuendamiseks loetakse ka olemasolevate dreenidega ristsuunas täidis- või piludreenide ja dreenfiltrite rajamine ning drenaažitoru asendamine sama läbimõõduga drenaažitoruga. 3 (3) Täidis- või piludreenide ja dreenfiltrite rajamisel ei tohi kahjustada olemasolevat drenaažitorustikku. Täidis- või piludreenide ja dreenfiltrite rajamisel ei tohi kahjustada olemasolevat drenaažitorustikku. 4 (4) Drenaažisüsteemile tuuletõkkeriba rajamisel peab selle kaugus drenaažitorust olema vähemalt viis meetrit. Kui seda nõuet ei ole võimalik täita, kasutatakse tuuletõkkeriba ulatuses aukudeta drenaažitoru või ümbritsetakse toru materjaliga, mis välistab puujuurte tungimise torustikku. RT I 2020-06-30 4 130062020004 2020-07-03 Drenaažisüsteemile tuuletõkkeriba rajamisel peab selle kaugus drenaažitorust olema vähemalt viis meetrit. Kui seda nõuet ei ole võimalik täita, kasutatakse tuuletõkkeriba ulatuses aukudeta drenaažitoru või ümbritsetakse toru materjaliga, mis välistab puujuurte tungimise torustikku.",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_22 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
      "estleg:sourceAct": "Maaparandushoiutööde nõuded",
      "estleg:provisionRef": "Reg_1045359 § 22",
      "estleg:partOfAct": {
