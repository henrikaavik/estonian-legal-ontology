    },
    {
      "@id": "estleg:Reg_1045359_Par_21_v1045359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045359_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Truup uuendatakse, kui selle osad on paigast nihkunud, truubi sisse- ja väljavoolu konstruktsioon on lagunenud, teekate truubi kohal ei vasta nõuetele või truubil liiklemine on häiritud või ohtlik. Truup uuendatakse, kui selle osad on paigast nihkunud, truubi sisse- ja väljavoolu konstruktsioon on lagunenud, teekate truubi kohal ei vasta nõuetele või truubil liiklemine on häiritud või ohtlik. 2 (2) Truubi uuendamistööd on: 1 1) lagunenud truubi asendamine samaväärse läbilaskevõimega truubiga; RT I 2020-06-30 4 130062020004 2020-07-03 2 2) lagunenud truubi otsaku lammutamine ja uue ehitamine; 3 3) truubitoru asendi korrigeerimine või purunenud truubitoru asendamine koos toruliiduste uuesti isoleerimisega; 4 4) puittaimestiku raiumine eesvoolu või kuivenduskraavi nõlvalt truubi sisse- ja väljavoolu kindlustuste ulatuses; 5 5) kraavikindlustuse taastamine truubi sisse- ja väljavoolu juures; 6 6) truubi kohal teekatte uuendamine; 7 7) kuivenduskraavi või muu vee ära juhtimiseks vajaliku rajatise rajamine selliselt, et oleks tagatud teelt valguva vee juhtimine eesvoolu või kuivenduskraavi maaparandussüsteemi rajatist kahjustamata. RT I 2020-06-30 4 130062020004 2020-07-03 Truubi uuendamistööd on: lagunenud truubi asendamine samaväärse läbilaskevõimega truubiga; lagunenud truubi otsaku lammutamine ja uue ehitamine; truubitoru asendi korrigeerimine või purunenud truubitoru asendamine koos toruliiduste uuesti isoleerimisega; puittaimestiku raiumine eesvoolu või kuivenduskraavi nõlvalt truubi sisse- ja väljavoolu kindlustuste ulatuses; kraavikindlustuse taastamine truubi sisse- ja väljavoolu juures; truubi kohal teekatte uuendamine; kuivenduskraavi või muu vee ära juhtimiseks vajaliku rajatise rajamine selliselt, et oleks tagatud teelt valguva vee juhtimine eesvoolu või kuivenduskraavi maaparandussüsteemi rajatist kahjustamata. 3 (3) Kehtetu - RT I 2020-06-30 4 130062020004 2020-07-03 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1045359_Par_21 (redaktsioon 1045359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045359",
