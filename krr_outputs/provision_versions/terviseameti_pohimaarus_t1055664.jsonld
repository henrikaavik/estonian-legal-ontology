      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametil on oma eelarve ja ameti kulud kaetakse riigieelarvest. Ameti eelarve kinnitab, muudab ja täitmist kontrollib valdkonna eest vastutav minister. Ametil on oma eelarve ja ameti kulud kaetakse riigieelarvest. Ameti eelarve kinnitab, muudab ja täitmist kontrollib valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "Reg_1055664_Par_3 (redaktsioon 1055664)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055664",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055664",
      "estleg:sourceAct": "Terviseameti põhimäärus",
      "estleg:provisionRef": "Reg_1055664 § 3",
      "estleg:partOfAct": {
