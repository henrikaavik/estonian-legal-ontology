    {
      "@id": "estleg:Reg_1029055_Par_1_v1029055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029055_Par_1"
