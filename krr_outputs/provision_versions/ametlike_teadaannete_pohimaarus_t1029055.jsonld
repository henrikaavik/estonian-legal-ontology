      },
      "estleg:versionText": "Määrus jõustub 2015. aasta 6. aprillil. Määrus jõustub 2015. aasta 6. aprillil.",
      "rdfs:label": {
        "@value": "Reg_1029055_Par_21 (redaktsioon 1029055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029055",
