      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 1. jaanuarit 2020. aastal antud esindusõigused jäävad andmekogus kehtima. RT I 2019-12-19 30 119122019030 2020-01-01 Enne 1. jaanuarit 2020. aastal antud esindusõigused jäävad andmekogus kehtima.",
      "rdfs:label": {
