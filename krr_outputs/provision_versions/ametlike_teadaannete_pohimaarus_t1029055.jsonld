    {
      "@id": "estleg:Reg_1029055_Par_11_v1029055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029055_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Volitatud töötleja või avaldaja parandab avaldatud teadaandes ilmse ebatäpsuse koos vea parandamise põhjenduse ja paranduse kirjeldusega. Volitatud töötleja või avaldaja parandab avaldatud teadaandes ilmse ebatäpsuse koos vea parandamise põhjenduse ja paranduse kirjeldusega. 2 (2) Vea parandamine on keelatud, kui see muudab teadaande sisu või isiku andmeid. Vea parandamine on keelatud, kui see muudab teadaande sisu või isiku andmeid. 3 (3) Avaldatud teadaandes vea parandamisel kuvatakse teadaande juures parandaja, vea parandamise aeg ja põhjendus paranduse kirjeldusega. Avaldatud teadaandes vea parandamisel kuvatakse teadaande juures parandaja, vea parandamise aeg ja põhjendus paranduse kirjeldusega.",
      "rdfs:label": {
        "@value": "Reg_1029055_Par_11 (redaktsioon 1029055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029055",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029055",
      "estleg:sourceAct": "Ametlike Teadaannete põhimäärus",
      "estleg:provisionRef": "Reg_1029055 § 11",
