      },
      "estleg:versionText": "Määrusega kehtestatakse välisriigi politseiametniku Eesti territooriumil piiriülese jälitamisega seotud toimingute dokumenteerimise kord. Määrusega kehtestatakse välisriigi politseiametniku Eesti territooriumil piiriülese jälitamisega seotud toimingute dokumenteerimise kord.",
      "rdfs:label": {
        "@value": "Reg_339379_Par_1 (redaktsioon 339379)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339379",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339379",
      "estleg:sourceAct": "Välisriigi politseiametniku Eesti territooriumil piiriülese jälitamisega seotud toimingute dokumenteerimise kord",
      "estleg:provisionRef": "Reg_339379 § 1",
