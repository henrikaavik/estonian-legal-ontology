        "@id": "estleg:Reg_1052939_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052939_Par_6_v1052939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
