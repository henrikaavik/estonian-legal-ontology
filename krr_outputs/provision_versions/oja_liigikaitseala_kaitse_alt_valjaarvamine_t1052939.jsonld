    {
      "@id": "estleg:Reg_1052939_Par_5_v1052939",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052939_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 17. aprilli 2020. a käskkirjaga nr 1-2/20/183 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 17. aprilli 2020. a käskkirjaga nr 1-2/20/183 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1052939_Par_5 (redaktsioon 1052939)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052939",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052939",
