      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvis 1 nimetatud kaitseala kaitse alt väljaarvamisega tunnistatakse kehtetuks Viljandi Maakonnavalitsuse 9. novembri 1992. a määruse nr 413 „Looduskaitse korraldus Viljandi maakonnas” lisa 4 „Riikliku looduskaitse all olevate objektide nimekiri” punkt 13 (Oja väike-konnakotka kaitseala). Paragrahvis 1 nimetatud kaitseala kaitse alt väljaarvamisega tunnistatakse kehtetuks Viljandi Maakonnavalitsuse 9. novembri 1992. a määruse nr 413 „Looduskaitse korraldus Viljandi maakonnas” lisa 4 „Riikliku looduskaitse all olevate objektide nimekiri” punkt 13 (Oja väike-konnakotka kaitseala).",
      "rdfs:label": {
        "@value": "Reg_1052939_Par_2 (redaktsioon 1052939)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052939",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052939",
      "estleg:sourceAct": "Oja liigikaitseala kaitse alt väljaarvamine",
      "estleg:provisionRef": "Reg_1052939 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052939_Map"
      }
    },
