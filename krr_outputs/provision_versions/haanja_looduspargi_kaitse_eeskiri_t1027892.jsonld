      "estleg:provisionRef": "Reg_1027892 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027892_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027892_Par_16_v1027892",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027892_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoiuküla, Pärandmaastiku, Tavaala ja Keskusala piiranguvööndis on olemasoleval hoonestusalal lubatud väikeehitiste püstitamine, mis ei nõua ehitusseadusest tulenevalt kohaliku omavalitsuse kirjalikku nõusolekut. Hoiuküla, Pärandmaastiku, Tavaala ja Keskusala piiranguvööndis on olemasoleval hoonestusalal lubatud väikeehitiste püstitamine, mis ei nõua ehitusseadusest tulenevalt kohaliku omavalitsuse kirjalikku nõusolekut. 2 (2) Kaitseala valitseja nõusolekul on lubatud: 1 1) Keskusala, Tavaala ja Pargi piiranguvööndis ehitiste püstitamine; 2 2) Hoiuküla ja Pärandmaastiku piiranguvööndis ehitiste püstitamine kinnistu olemasolevatel ja endistel hoonestusaladel, uue hoonestusala rajamine vastavalt välja kujunenud asustusstruktuurile ja ehitise püstitamine hoonestuse tarbeks väljapoole hoonestusala. Kaitseala valitseja nõusolekul on lubatud: Keskusala, Tavaala ja Pargi piiranguvööndis ehitiste püstitamine; Hoiuküla ja Pärandmaastiku piiranguvööndis ehitiste püstitamine kinnistu olemasolevatel ja endistel hoonestusaladel, uue hoonestusala rajamine vastavalt välja kujunenud asustusstruktuurile ja ehitise püstitamine hoonestuse tarbeks väljapoole hoonestusala.",
      "rdfs:label": {
        "@value": "Reg_1027892_Par_16 (redaktsioon 1027892)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027892",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027892",
      "estleg:sourceAct": "Haanja looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1027892 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027892_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027892_Par_17_v1027892",
      "@type": [
        "owl:NamedIndividual",
