      "estleg:versionValidFrom": {
        "@value": "2008-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kutsestandardi kutsetaseme ja -nimetuse osas sätestatakse kutsetase kvalifikatsiooniraamistikus ja -kutsenimetus, samuti võimalikud spetsialiseerumised. Kutsestandardi kutsetaseme ja -nimetuse osas sätestatakse kutsetase kvalifikatsiooniraamistikus ja -kutsenimetus, samuti võimalikud spetsialiseerumised.",
      "rdfs:label": {
        "@value": "Reg_328964_Par_10 (redaktsioon 328964)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "328964",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/328964",
      "estleg:sourceAct": "Kutsestandardite koostamise, muutmise ja vormistamise kord",
      "estleg:provisionRef": "Reg_328964 § 10",
