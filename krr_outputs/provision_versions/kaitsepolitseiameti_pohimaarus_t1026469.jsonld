    {
      "@id": "estleg:Reg_1026469_Par_1_v1026469",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026469_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitsepolitseiamet (edaspidi amet) on Siseministeeriumi valitsemisala valitsusasutus, kes täidab seadusest ja teistest õigusaktidest tulenevaid ülesandeid, teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ettenähtud alustel, ulatuses ja korras. Kaitsepolitseiamet (edaspidi amet) on Siseministeeriumi valitsemisala valitsusasutus, kes täidab seadusest ja teistest õigusaktidest tulenevaid ülesandeid, teostab riiklikku järelevalvet ning kohaldab riiklikku sundi seaduses ettenähtud alustel, ulatuses ja korras. 2 (2) Oma ülesannete täitmisel esindab amet riiki. Oma ülesannete täitmisel esindab amet riiki. 3 (3) Ameti nimetuse ametlik lühend on KAPO. Ameti nimetuse ametlik lühend on KAPO. 4 (4) Ameti kõrgemalseisvaks valitsusasutuseks on Siseministeerium. Ameti kõrgemalseisvaks valitsusasutuseks on Siseministeerium.",
      "rdfs:label": {
        "@value": "Reg_1026469_Par_1 (redaktsioon 1026469)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026469",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026469",
