    {
      "@id": "estleg:Reg_1026469_Par_6_v1026469",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026469_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ameti ingliskeelne nimetus on Estonian Internal Security Service. Kui kasutatakse ameti ingliskeelset nimetust ja samas kohas on inglise keelde tõlgitud riigi nimi „Eesti Vabariik”, võib ameti ingliskeelsest nimetusest sõna „Estonian” ära jätta. Ameti ingliskeelne nimetus on Estonian Internal Security Service. Kui kasutatakse ameti ingliskeelset nimetust ja samas kohas on inglise keelde tõlgitud riigi nimi „Eesti Vabariik”, võib ameti ingliskeelsest nimetusest sõna „Estonian” ära jätta.",
      "rdfs:label": {
        "@value": "Reg_1026469_Par_6 (redaktsioon 1026469)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026469",
