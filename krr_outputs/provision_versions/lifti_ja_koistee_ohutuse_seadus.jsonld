      }
    },
    {
      "@id": "estleg:LKOS_Par_15_v749126",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKOS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehnilise kontrolli teostaja peab kümne tööpäeva jooksul pärast tehnilist kontrolli esitama Tehnilise Järelevalve Inspektsioonile elektrooniliselt andmed registreerimisele kuuluva lifti ja registreerimisele kuuluva köistee (edaspidi registreeritav tõsteseade), selle omaniku ja kasutamise järelevaataja ning tehnilise kontrolli kohta. (2) Tõsteseadme registreerib Tehnilise Järelevalve Inspektsioon tehnilise kontrolli teostaja esitatud andmete alusel. (3) Registreeritavate tõsteseadmete loetelu, samuti registreeritavate tõsteseadmete, nende omanike ja kasutamise järelevaatajate ning tehnilise kontrolli kohta esitatavate andmete loetelu,",
      "rdfs:label": {
        "@value": "LKOS_Par_15 (redaktsioon 749126)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "749126",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKOS_Par_15_v12894921"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
