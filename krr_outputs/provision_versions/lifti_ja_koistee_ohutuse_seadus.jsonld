    {
      "@id": "estleg:LKOS_Par_21_v12971217",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKOS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 22 sätestatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 27 sätestatud nõuetele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Isiku nõuetele vastavuse hindaja ja tõendaja akrediteerijale kohaldatakse toote nõuetele vastavuse tõendamise seaduse §-s 141 sätestatut. (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "LKOS_Par_21 (redaktsioon 12971217)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12971217",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKOS_Par_21_v13328458"
      },
      "estleg:versionValidTo": {
        "@value": "2010-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKOS_Par_21_v13328458",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKOS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 22 sätestatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 27 sätestatud nõuetele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Kehtetu – (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "LKOS_Par_21 (redaktsioon 13328458)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13328458",
      "estleg:supersededByVersion": {
        "@id": "estleg:LKOS_Par_21_v13329246"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LKOS_Par_21_v13329246",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LKOS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isiku nõuetele vastavuse hindamine ja tõendamine on lubatud käesoleva seaduse §-s 22 sätestatud registri registreeringu olemasolu korral. (2) Isiku nõuetele vastavuse hindaja ja tõendaja peab: omama isiku nõuetele vastavuse hindamiseks ja tõendamiseks vajaliku erialase ettevalmistuse, väljaõppe ja kogemusega töötajaid; valdama vahendeid isiku nõuetele vastavuse hindamiseks ja tõendamiseks; olema sõltumatu, asjatundlik, erapooletu ja mittediskrimineeriv; omama kogu isiku nõuetele vastavuse hindaja ja tõendajana tegutsemise aja jooksul kehtivat ja käesoleva seaduse §-s 27 sätestatud nõuetele vastavat vastutuskindlustust; olema isiku nõuetele vastavuse hindamiseks ja tõendamiseks akrediteeritud; tagama isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse kõigile taotlejatele. (3) Kehtetu - (4) Isiku nõuetele vastavuse hindamise ja tõendamise teenuse ning välisriigis omandatud pädevuse tunnustamise teenuse hinnad peavad olema kulupõhised, läbipaistvad ja mittediskrimineerivad ning kujundatud selliselt, et kataksid nende teenustega seotud põhjendatud kulutused ja tagaksid isiku nõuetele vastavuse hindajale ja tõendajale mõistliku kasumi.",
      "rdfs:label": {
        "@value": "LKOS_Par_21 (redaktsioon 13329246)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13329246",
