    },
    {
      "@id": "estleg:Reg_1019044_Par_1_v1019044",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019044_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega asutatakse riigi infosüsteemi kuuluv andmekogu „Eesti topograafia andmekogu” (edaspidi andmekogu) ja kehtestatakse andmekogu pidamise põhimäärus. Andmekogu lühinimetus on ETAK. Määrusega asutatakse riigi infosüsteemi kuuluv andmekogu „Eesti topograafia andmekogu” (edaspidi andmekogu) ja kehtestatakse andmekogu pidamise põhimäärus. Andmekogu lühinimetus on ETAK. 2 (2) Andmekogu ingliskeelne nimetus on „Estonian Topographic Database”. Andmekogu ingliskeelne nimetus on „Estonian Topographic Database”.",
      "rdfs:label": {
        "@value": "Reg_1019044_Par_1 (redaktsioon 1019044)",
        "@language": "et"
      },
