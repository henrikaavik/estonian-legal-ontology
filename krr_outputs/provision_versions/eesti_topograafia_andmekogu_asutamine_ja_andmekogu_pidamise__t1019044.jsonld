    {
      "@id": "estleg:Reg_1019044_Par_11_v1019044",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019044_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Topoandmete andmebaasi andmed ja kaardid avalikustatakse vastutava töötleja pakutavate otsingu- ja vaatamisteenuste kaudu. Topoandmete andmebaasi andmed ja kaardid avalikustatakse vastutava töötleja pakutavate otsingu- ja vaatamisteenuste kaudu. 2 (2) Vastutav töötleja võib andmekogu andmetest avalikustada nii kehtiva kui ka ajaloolise versiooni. Vastutav töötleja võib andmekogu andmetest avalikustada nii kehtiva kui ka ajaloolise versiooni.",
      "rdfs:label": {
        "@value": "Reg_1019044_Par_11 (redaktsioon 1019044)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019044",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1019044",
      "estleg:sourceAct": "Eesti topograafia andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1019044 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1019044_Map"
      }
    },
    {
      "@id": "estleg:Reg_1019044_Par_12_v1019044",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1019044_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu andmed antakse kasutusse tärkandmetena, digitaalselt või tardkujul kaartide ja plaanidena või ruumiandmekogumitena. Andmekogu andmed antakse kasutusse tärkandmetena, digitaalselt või tardkujul kaartide ja plaanidena või ruumiandmekogumitena. 2 (2) Andmekogu andmete kasutusse andmisel tasuliste andme- ja võrguteenuste kaudu lähtutakse ruumiandmete seaduse § 73 lõike 3 alusel kehtestatud korrast. Andmekogu andmete kasutusse andmisel tasuliste andme- ja võrguteenuste kaudu lähtutakse ruumiandmete seaduse § 73 lõike 3 alusel kehtestatud korrast. 3 (3) Vastutav töötleja peab arvestust andmete kasutusse andmise aja, kasutusse antud andmete koosseisu ja andmete saajate üle. Vastutav töötleja peab arvestust andmete kasutusse andmise aja, kasutusse antud andmete koosseisu ja andmete saajate üle. 4 (4) Teabevaldajale antakse õigusaktide ja rahvusvaheliste lepingutega pandud kohustuste täitmiseks andmekogu andmed tasuta kasutada. Teabevaldajale antakse õigusaktide ja rahvusvaheliste lepingutega pandud kohustuste täitmiseks andmekogu andmed tasuta kasutada. 5 (5) Vastutav töötleja annab andmekogu andmetest kasutusse kehtiva versiooni või kokkuleppel andmete saajaga mõne ajaloolise versiooni. Vastutav töötleja annab andmekogu andmetest kasutusse kehtiva versiooni või kokkuleppel andmete saajaga mõne ajaloolise versiooni.",
      "rdfs:label": {
        "@value": "Reg_1019044_Par_12 (redaktsioon 1019044)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019044",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1019044",
      "estleg:sourceAct": "Eesti topograafia andmekogu asutamine ja andmekogu pidamise põhimäärus",
      "estleg:provisionRef": "Reg_1019044 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1019044_Map"
      }
