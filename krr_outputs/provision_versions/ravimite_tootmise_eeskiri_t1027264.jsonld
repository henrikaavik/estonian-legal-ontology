      "estleg:provisionRef": "Reg_1027264 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1027264_Map"
      }
    },
    {
      "@id": "estleg:Reg_1027264_Par_4_v1027264",
