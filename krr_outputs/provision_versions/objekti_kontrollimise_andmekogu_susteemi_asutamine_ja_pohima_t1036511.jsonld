    {
      "@id": "estleg:Reg_1036511_Par_16_v1036511",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1036511_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu andmetest tehakse koopiad digitaalsel kujul. Andmekogu andmetest tehakse koopiad digitaalsel kujul. 2 (2) Andmekogu andmeid ning andmete aluseks olevaid dokumente säilitatakse kümme aastat. Erandi moodustavad nõuete haldamiseks vajalikud andmed, mida säilitatakse kauem kui kümme aastat kuni vajaduse möödumiseni. Andmekogu andmeid ning andmete aluseks olevaid dokumente säilitatakse kümme aastat. Erandi moodustavad nõuete haldamiseks vajalikud andmed, mida säilitatakse kauem kui kümme aastat kuni vajaduse möödumiseni.",
      "rdfs:label": {
        "@value": "Reg_1036511_Par_16 (redaktsioon 1036511)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036511",
