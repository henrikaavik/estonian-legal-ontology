    {
      "@id": "estleg:Reg_1051753_Par_14_v1051753",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051753_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andjal on õigus nõuda toetuse saajalt toetuse sihipärase kasutamise kohta aruannet. Toetuse andjal on õigus nõuda toetuse saajalt toetuse sihipärase kasutamise kohta aruannet.",
      "rdfs:label": {
        "@value": "Reg_1051753_Par_14 (redaktsioon 1051753)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1051753",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1051753",
      "estleg:sourceAct": "COVID-19 puhangust tingitud erakorraline abi spordiobjektide valdajate toetamiseks",
      "estleg:provisionRef": "Reg_1051753 § 14",
      "estleg:partOfAct": {
