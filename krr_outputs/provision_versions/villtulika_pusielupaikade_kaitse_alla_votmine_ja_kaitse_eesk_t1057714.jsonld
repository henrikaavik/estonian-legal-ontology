      "estleg:versionValidFrom": {
        "@value": "2023-11-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 31. augusti 2022. a käskkirjaga nr 1-2/22/295 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 31. augusti 2022. a käskkirjaga nr 1-2/22/295 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1057714_Par_15 (redaktsioon 1057714)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057714",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057714",
      "estleg:sourceAct": "Villtulika püsielupaikade kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1057714 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057714_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057714_Par_16_v1057714",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057714_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
