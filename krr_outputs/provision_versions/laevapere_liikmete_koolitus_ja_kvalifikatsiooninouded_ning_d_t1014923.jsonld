    {
      "@id": "estleg:Reg_1014923_Par_51_60_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_51_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku tunnistuse saamiseks on vajalik: 1 1) väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku koolitus; 2 2) vähemalt neli kuud praktikapäevikus vormistatud meresõidupraktikat masinavahis laevamehaaniku juhendamisel laeval peamasinate efektiivse koguvõimsusega 150 kW või enam. Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku tunnistuse saamiseks on vajalik: väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku koolitus; vähemalt neli kuud praktikapäevikus vormistatud meresõidupraktikat masinavahis laevamehaaniku juhendamisel laeval peamasinate efektiivse koguvõimsusega 150 kW või enam. 2 (2) Kui isikul puudub mereõppeasutuse nõuetekohaselt vormistatud meresõidupraktika tõend, tuleb tunnistuse saamiseks esitada tõend vähemalt 12 kuu pikkuse meresõidupraktika kohta masinaruumis laeval peamasinate efektiivse koguvõimsusega 150 kW või enam, millest vähemalt kuus kuud on praktikat masinavahis laevamehaaniku juhendamisel. Kui isikul puudub mereõppeasutuse nõuetekohaselt vormistatud meresõidupraktika tõend, tuleb tunnistuse saamiseks esitada tõend vähemalt 12 kuu pikkuse meresõidupraktika kohta masinaruumis laeval peamasinate efektiivse koguvõimsusega 150 kW või enam, millest vähemalt kuus kuud on praktikat masinavahis laevamehaaniku juhendamisel. 3 (3) Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku tunnistuse omanik võib töötada mehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 750 kW. RT I 2021-07-09 1 109072021001 2021-08-02 Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku tunnistuse omanik võib töötada mehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 750 kW.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_51_60 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014923",
      "estleg:sourceAct": "Laevapere liikmete koolitus- ja kvalifikatsiooninõuded ning diplomeerimise kord",
      "estleg:provisionRef": "Reg_1014923 § 51_60",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014923_Map"
      }
    },
    {
      "@id": "estleg:Reg_1014923_Par_52_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku tunnistuse saamiseks on vajalik: 1 1) väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku tunnistus; RT I 2021-07-09 1 109072021001 2021-08-02 2 2) vähemalt 12 kuud meresõidupraktikat masinaruumis või masinavahis laeval peamasinate efektiivse koguvõimsusega 150 kW või enam; 3 3) eksami sooritamine Transpordiameti komisjoni ees. RT I 2024-09-18 1 118092024001 2025-01-01 Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku tunnistuse saamiseks on vajalik: väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva mehaaniku tunnistus; vähemalt 12 kuud meresõidupraktikat masinaruumis või masinavahis laeval peamasinate efektiivse koguvõimsusega 150 kW või enam; eksami sooritamine Transpordiameti komisjoni ees. 2 (2) Tunnistust ei vahetata kõrgema kutsekvalifikatsiooni tunnistuse vastu. Tunnistust ei vahetata kõrgema kutsekvalifikatsiooni tunnistuse vastu. 3 (3) Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku tunnistuse omanik võib töötada vanemmehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 750 kW. RT I 2018-01-23 1 123012018001 2018-02-01 Väiksema kui 750 kW peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku tunnistuse omanik võib töötada vanemmehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 750 kW.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_52 (redaktsioon 1014923)",
        "@language": "et"
      },
