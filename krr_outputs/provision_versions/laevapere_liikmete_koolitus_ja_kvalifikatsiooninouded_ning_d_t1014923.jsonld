    {
      "@id": "estleg:Reg_1014923_Par_61_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Raadiosideoperaatori tunnistuse saamiseks on vajalik raadiosideoperaatori koolitus. Raadiosideoperaatori tunnistuse saamiseks on vajalik raadiosideoperaatori koolitus. 2 (2) Tunnistus väljastatakse vähemalt 18-aastasele isikule. Tunnistus väljastatakse vähemalt 18-aastasele isikule. 3 (3) Raadiosideoperaatori tunnistuse omanik võib töötada kõikidel laevadel, mille sõidupiirkond on GMDSSi rajoonid A1, A2, A3 ja A4. Raadiosideoperaatori tunnistuse omanik võib töötada kõikidel laevadel, mille sõidupiirkond on GMDSSi rajoonid A1, A2, A3 ja A4.",
      "rdfs:label": {
