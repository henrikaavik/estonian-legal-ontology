    {
      "@id": "estleg:Reg_1014923_Par_6_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "STCW konventsiooni reegli I/12 ja STCW koodeksi jaotises A-I/12 sätestatud tehnilisi tingimusi ja teisi selle jaotise sätteid ning STCW koodeksi A osaga meresõidudiplomi või kutsetunnistuse suhtes kehtestatud nõudeid järgitakse: 1 1) kõikide kohustuslike valmendil põhinevate koolituste puhul; 2 2) kõikide STCW koodeksi A osas nõutavate hindamiste puhul, mida tehakse valmendi abil; 3 3) kõikide STCW koodeksi A osas nõutavate pädevustaseme demonstreerimiste puhul, mida tehakse valmendi abil. STCW konventsiooni reegli I/12 ja STCW koodeksi jaotises A-I/12 sätestatud tehnilisi tingimusi ja teisi selle jaotise sätteid ning STCW koodeksi A osaga meresõidudiplomi või kutsetunnistuse suhtes kehtestatud nõudeid järgitakse: kõikide kohustuslike valmendil põhinevate koolituste puhul; kõikide STCW koodeksi A osas nõutavate hindamiste puhul, mida tehakse valmendi abil; kõikide STCW koodeksi A osas nõutavate pädevustaseme demonstreerimiste puhul, mida tehakse valmendi abil.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_6 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
