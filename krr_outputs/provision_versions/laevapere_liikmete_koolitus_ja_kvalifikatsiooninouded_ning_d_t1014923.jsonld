    {
      "@id": "estleg:Reg_1014923_Par_5_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Laevapere liikmete koolitusel peab erialase ja täiendusõppe õppejõudude, õpetajate ja eksamineerijate kvalifikatsioon vastama vähemalt kvalifikatsioonile, mille andmise aluseks on nende läbiviidav või eksamineeritav koolitus. RT I 2014-06-11 1 111062014001 2014-06-14 Laevapere liikmete koolitusel peab erialase ja täiendusõppe õppejõudude, õpetajate ja eksamineerijate kvalifikatsioon vastama vähemalt kvalifikatsioonile, mille andmise aluseks on nende läbiviidav või eksamineeritav koolitus. 2 (2) Taseme- ja täiendusõppe eksamikomisjoni esimehe kvalifikatsioon peab vastama vähemalt kvalifikatsioonile, mille andmise aluseks on tema eksamineeritav koolitus. RT I 2014-06-11 1 111062014001 2014-06-14 Taseme- ja täiendusõppe eksamikomisjoni esimehe kvalifikatsioon peab vastama vähemalt kvalifikatsioonile, mille andmise aluseks on tema eksamineeritav koolitus. 3 (3) Laevapere liikmete erialase ja täiendusõppe õppejõud, õpetaja ja eksamineerija peavad vastama STCW koodeksi jaotise A-I/6 lõigete 4, 5 ja 6 tingimustele ning olema läbinud vähemalt vastavalt lektori või eksamineerija koolituse. RT I 2018-01-23 1 123012018001 2018-02-01 Laevapere liikmete erialase ja täiendusõppe õppejõud, õpetaja ja eksamineerija peavad vastama STCW koodeksi jaotise A-I/6 lõigete 4, 5 ja 6 tingimustele ning olema läbinud vähemalt vastavalt lektori või eksamineerija koolituse.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_5 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014923",
      "estleg:sourceAct": "Laevapere liikmete koolitus- ja kvalifikatsiooninõuded ning diplomeerimise kord",
      "estleg:provisionRef": "Reg_1014923 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014923_Map"
      }
    },
    {
      "@id": "estleg:Reg_1014923_Par_50_v1014923",
