      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väiksema kui 200-se kogumahutavusega merelaeva rannasõidu vahitüürimehe tunnistuse asemel väljastatakse väiksema kui 200-se kogumahutavusega laeva vahitüürimehe tunnistus. Väiksema kui 200-se kogumahutavusega merelaeva rannasõidu vahitüürimehe tunnistuse asemel väljastatakse väiksema kui 200-se kogumahutavusega laeva vahitüürimehe tunnistus.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_79 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014923",
      "estleg:sourceAct": "Laevapere liikmete koolitus- ja kvalifikatsiooninõuded ning diplomeerimise kord",
      "estleg:provisionRef": "Reg_1014923 § 79",
      "estleg:partOfAct": {
