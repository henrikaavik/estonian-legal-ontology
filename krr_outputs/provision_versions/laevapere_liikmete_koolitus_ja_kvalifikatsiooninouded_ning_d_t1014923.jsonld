      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiirlaeva laevajuhi tunnistuse saamiseks on vajalik: 1 1) laeva kapteni või vanemtüürimehe meresõidudiplom või tunnistus; 2 2) kiirlaeva laevajuhtide täiendusõppe läbimine mereõppeasutuses; 3 3) kiirlaeva laevajuhtide täiendusõppe teoreetilise osa ja sõidueksami protokollid. Kiirlaeva laevajuhi tunnistuse saamiseks on vajalik: laeva kapteni või vanemtüürimehe meresõidudiplom või tunnistus; kiirlaeva laevajuhtide täiendusõppe läbimine mereõppeasutuses; kiirlaeva laevajuhtide täiendusõppe teoreetilise osa ja sõidueksami protokollid.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_72 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
