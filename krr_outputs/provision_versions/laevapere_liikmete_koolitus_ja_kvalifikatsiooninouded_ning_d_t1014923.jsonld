      }
    },
    {
      "@id": "estleg:Reg_1014923_Par_74_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_74"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Päästevahendite ja valvepaadi vanema tunnistuse saamiseks on vajalik: 1 1) päästevahendite ja valvepaadi vanema täiendusõppekursuse lõpetamine mereõppeasutuses; 2 2) vähemalt kuus kuud meresõidupraktikat laeval. Päästevahendite ja valvepaadi vanema tunnistuse saamiseks on vajalik: päästevahendite ja valvepaadi vanema täiendusõppekursuse lõpetamine mereõppeasutuses; vähemalt kuus kuud meresõidupraktikat laeval. 2 (2) Tunnistus väljastatakse vähemalt 18-aastasele isikule. Tunnistus väljastatakse vähemalt 18-aastasele isikule.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_74 (redaktsioon 1014923)",
        "@language": "et"
      },
