    {
      "@id": "estleg:Reg_1014923_Par_30_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Turvakohustusi täitva laevapere liikme koolituse peavad läbima kõik laevapere liikmed, kellele pannakse turvaalased kohustused. Koolitus peab vastama STCW koodeksi jaotise A-VI/6 punktide 6–8 nõuetele, võttes arvesse jaotise B-VI/6 soovitusi. Koolitust viib läbi mereõppeasutus. Koolitust ei nõuta kohalikus rannasõidus ega laevadel, millele ei laiene ISPS koodeks. RT I 2019-07-23 3 123072019003 2019-08-01 Turvakohustusi täitva laevapere liikme koolituse peavad läbima kõik laevapere liikmed, kellele pannakse turvaalased kohustused. Koolitus peab vastama STCW koodeksi jaotise A-VI/6 punktide 6–8 nõuetele, võttes arvesse jaotise B-VI/6 soovitusi. Koolitust viib läbi mereõppeasutus. Koolitust ei nõuta kohalikus rannasõidus ega laevadel, millele ei laiene ISPS koodeks.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_30 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014923",
      "estleg:sourceAct": "Laevapere liikmete koolitus- ja kvalifikatsiooninõuded ning diplomeerimise kord",
      "estleg:provisionRef": "Reg_1014923 § 30",
