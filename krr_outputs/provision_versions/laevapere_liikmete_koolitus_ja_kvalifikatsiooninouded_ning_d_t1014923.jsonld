      "estleg:provisionRef": "Reg_1014923 § 53",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1014923_Map"
      }
    },
    {
      "@id": "estleg:Reg_1014923_Par_54_v1014923",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1014923_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väiksema kui 3000 kW peamasinate efektiivse koguvõimsusega mootorlaeva teise mehaaniku diplomi saamiseks on vajalik: 1 1) väiksema kui 3000 kW peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku koolitus või 3000 kW ja suurema peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku koolitus; RT I 2014-06-11 1 111062014001 2014-06-14 2 2) 750 kW ja suurema peamasinate efektiivse koguvõimsusega mootorlaeva vahimehaaniku diplom; 3 3) vähemalt 12 kuud meresõidupraktikat vahimehaanikuna laeval peamasinate efektiivse koguvõimsusega 750 kW või enam; 4 4) eksami sooritamine Transpordiameti komisjoni ees. Väiksema kui 3000 kW peamasinate efektiivse koguvõimsusega mootorlaeva teise mehaaniku diplomi saamiseks on vajalik: väiksema kui 3000 kW peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku koolitus või 3000 kW ja suurema peamasinate efektiivse koguvõimsusega mootorlaeva vanemmehaaniku koolitus; 750 kW ja suurema peamasinate efektiivse koguvõimsusega mootorlaeva vahimehaaniku diplom; vähemalt 12 kuud meresõidupraktikat vahimehaanikuna laeval peamasinate efektiivse koguvõimsusega 750 kW või enam; eksami sooritamine Transpordiameti komisjoni ees. 2 (2) Diplomi saamiseks vajaliku meresõidupraktika hulka ei arvata tööd sõjalaeval. Diplomi saamiseks vajaliku meresõidupraktika hulka ei arvata tööd sõjalaeval. 3 (3) Väiksema kui 3000 kW peamasinate efektiivse koguvõimsusega mootorlaeva teise mehaaniku diplomi omanik võib töötada: 1 1) vahimehaanikuna igal mootorlaeval; 2 2) teise mehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 3000 kW; 3 3) vanemmehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 750 kW; 4 4) kohalikus rannasõidus vanemmehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 3000 kW, kui tal on vähemalt kuus kuud meresõidupraktikat teise mehaanikuna mootorlaeval peamasinate efektiivse koguvõimsusega 750 kW või enam. RT I 2014-06-11 1 111062014001 2014-06-14 Väiksema kui 3000 kW peamasinate efektiivse koguvõimsusega mootorlaeva teise mehaaniku diplomi omanik võib töötada: vahimehaanikuna igal mootorlaeval; teise mehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 3000 kW; vanemmehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 750 kW; kohalikus rannasõidus vanemmehaanikuna mootorlaeval, mille peamasinate efektiivne koguvõimsus on väiksem kui 3000 kW, kui tal on vähemalt kuus kuud meresõidupraktikat teise mehaanikuna mootorlaeval peamasinate efektiivse koguvõimsusega 750 kW või enam.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_54 (redaktsioon 1014923)",
        "@language": "et"
      },
