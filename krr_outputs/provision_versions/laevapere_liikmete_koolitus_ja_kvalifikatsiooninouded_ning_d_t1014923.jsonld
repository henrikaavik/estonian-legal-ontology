      },
      "estleg:versionText": "Raadiosideoperaatorite koolitus peab vastama STCW koodeksi jaotise A-IV/2 nõuetele ja jaotise B-IV/2 soovitustele. RT I 2018-01-23 1 123012018001 2018-02-01 Raadiosideoperaatorite koolitus peab vastama STCW koodeksi jaotise A-IV/2 nõuetele ja jaotise B-IV/2 soovitustele.",
      "rdfs:label": {
        "@value": "Reg_1014923_Par_22 (redaktsioon 1014923)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1014923",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1014923",
