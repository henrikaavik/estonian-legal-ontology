      "estleg:provisionRef": "Reg_1051966 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051966_Map"
      }
    },
    {
      "@id": "estleg:Reg_1051966_Par_2_v1051966",
      "@type": [
        "owl:NamedIndividual",
