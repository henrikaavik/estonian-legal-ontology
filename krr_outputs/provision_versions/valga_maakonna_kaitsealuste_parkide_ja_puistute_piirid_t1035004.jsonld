        "@value": "2016-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 15. detsembri 2005. a määruses nr 311 „Hoiualade kaitse alla võtmine Valga maakonnas” tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "Reg_1035004_Par_6 (redaktsioon 1035004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035004",
      "estleg:sourceAct": "Valga maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:provisionRef": "Reg_1035004 § 6",
