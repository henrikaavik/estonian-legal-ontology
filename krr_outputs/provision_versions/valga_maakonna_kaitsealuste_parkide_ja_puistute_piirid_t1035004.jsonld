    },
    {
      "@id": "estleg:Reg_1035004_Par_7_v1035004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035004_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 8. juuli 2010. a käskkirjaga nr 963 ja keskkonnaministri 4. märtsi 2015. a käskkirjaga nr 224 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 8. juuli 2010. a käskkirjaga nr 963 ja keskkonnaministri 4. märtsi 2015. a käskkirjaga nr 224 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1035004_Par_7 (redaktsioon 1035004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035004",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035004",
      "estleg:sourceAct": "Valga maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:provisionRef": "Reg_1035004 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035004_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035004_Par_8_v1035004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035004_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-06-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1035004_Par_8 (redaktsioon 1035004)",
        "@language": "et"
      },
