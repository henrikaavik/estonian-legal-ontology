      }
    },
    {
      "@id": "estleg:TTKS_Par_24_v958243",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_24"
