      },
      "estleg:versionText": "Ämmaemandusabi on ambulatoorne või statsionaarne tervishoiuteenus, mida osutab ämmaemand koos pere- või eriarstiga või iseseisvalt.",
      "rdfs:label": {
        "@value": "TTKS_Par_26_1 (redaktsioon 13264247)",
        "@language": "et"
      },
