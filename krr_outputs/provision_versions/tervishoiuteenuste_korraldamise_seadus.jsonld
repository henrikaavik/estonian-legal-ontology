      },
      "estleg:versionValidFrom": {
        "@value": "2011-03-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. jaanuaril. (2) Käesoleva seaduse § 22 lõige 2 jõustub 2003. aasta 1. jaanuaril ja §-d 12-15 jõustuvad 2005. aasta 1. jaanuaril. (3) Käesoleva seaduse § 592 lõige 11 jõustub 2013. aasta 1. jaanuaril.",
      "rdfs:label": {
