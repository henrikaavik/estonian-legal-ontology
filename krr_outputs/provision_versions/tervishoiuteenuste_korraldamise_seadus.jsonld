    {
      "@id": "estleg:TTKS_Par_41_v12766722",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa saamiseks esitab taotleja tegevusloa väljaandjale järgmised dokumendid ja andmed: avalduse, milles märgitakse ära taotleja nimetus ning tegevuskoha asukoht, aadress ja sidevahendite numbrid; asutamisel oleva juriidilise isiku asutamislepingu või -otsuse ja põhikirja või ühingulepingu ärakirjad; füüsilisest isikust ettevõtja puhul ettevõtja nime, isikukoodi või sünniaja, elukoha ja ärinime; kiirabi osutamise loa taotlemise korral riigi päästeasutuse poolt selle asutuse asukoha, riigi- ja kohaliku omavalitsuse asutuste riiklikus registris registreerimise numbri, põhimääruse ja kõrgemalseisva valitsusasutuse nimetuse; tervishoiuteenuste loetelu, mille osutamiseks tegevusluba taotletakse; tervishoiutöötajate nimed ja registreerimistõendite numbrid; kiirabi osutamise loa taotlemise korral taotletavate kiirabibrigaadide arvu, koosseisu ja varustuse; haiglas eriarstiabi osutamise loa taotlemise korral taotletava haigla liigi; ruumide meditsiinitehnoloogia osa projekti, milles on andmed ruumide, sisseseade ja aparatuuri kohta; andmed andmekaitse järelevalve asutuses delikaatsete isikuandmete töötlemise registreerimise kohta; 11)–12) Kehtetud –",
      "rdfs:label": {
        "@value": "TTKS_Par_41 (redaktsioon 12766722)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12766722",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_41_v12825073"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_41_v12825073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa saamiseks esitab taotleja tegevusloa väljaandjale järgmised dokumendid ja andmed: avalduse, milles märgitakse taotleja nimi, äriregistri või mittetulundusühingute ja sihtasutuste registri kood või äriregistrisse mittekantud füüsilisest isikust ettevõtja isikukood ning tegevuskoht, aadress ja sidevahendite numbrid; asutamisel oleva juriidilise isiku asutamislepingu või -otsuse ja põhikirja või ühingulepingu ärakirjad; füüsilisest isikust ettevõtja puhul ettevõtja nime, isikukoodi või sünniaja, elukoha ja ärinime; kiirabi osutamise loa taotlemise korral riigi päästeasutuse poolt selle asutuse asukoha, riigi- ja kohaliku omavalitsuse asutuste riiklikus registris registreerimise numbri, põhimääruse ja kõrgemalseisva valitsusasutuse nimetuse; tervishoiuteenuste loetelu, mille osutamiseks tegevusluba taotletakse; tervishoiutöötajate nimed ja isikukoodid ning esmasel tegevusloa taotlemisel tervishoiutöötajate kirjalikud nõusolekud tegevusluba taotleva tervishoiuteenuse osutaja juurde tööle asumiseks. kiirabi osutamise loa taotlemise korral taotletavate kiirabibrigaadide arvu, koosseisu ja varustuse; haiglas eriarstiabi osutamise loa taotlemise korral taotletava haigla liigi; ruumide meditsiinitehnoloogia osa projekti, milles on andmed ruumide, sisseseade ja aparatuuri kohta; andmed andmekaitse järelevalve asutuses delikaatsete isikuandmete töötlemise registreerimise kohta; 11)–12) kehtetud –",
      "rdfs:label": {
        "@value": "TTKS_Par_41 (redaktsioon 12825073)",
        "@language": "et"
      },
