      }
    },
    {
      "@id": "estleg:TTKS_Par_19_v121122018006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirabi eest tasutakse Eesti Haigekassa eelarvest Eesti Haigekassa ja kiirabibrigaadi pidaja vahel sõlmitud kiirabi rahastamise lepingu alusel. (2) Kiirabi eest tasumise korra, kiirabibrigaadi pidajale makstava tasu arvutamise metoodika ja kiirabi hinna kehtestab määrusega Eesti Haigekassa nõukogu ettepanekul. (3) Kiirabibrigaadi pidaja ei või nõuda visiiditasu kiirabi osutamise eest.",
      "rdfs:label": {
        "@value": "TTKS_Par_19 (redaktsioon 121122018006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122018006",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_19_v111032023092"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_19_v111032023092",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kiirabi eest tasutakse Tervisekassa eelarvest Tervisekassa ja kiirabibrigaadi pidaja vahel sõlmitud kiirabi rahastamise lepingu alusel. (2) Kiirabi eest tasumise korra, kiirabibrigaadi pidajale makstava tasu arvutamise metoodika ja kiirabi hinna kehtestab määrusega Tervisekassa nõukogu ettepanekul. (3) Kiirabibrigaadi pidaja ei või nõuda visiiditasu kiirabi osutamise eest.",
      "rdfs:label": {
        "@value": "TTKS_Par_19 (redaktsioon 111032023092)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023092"
    },
    {
      "@id": "estleg:TTKS_Par_2_v27072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tervishoiuteenus on tervishoiutöötaja tegevus haiguse, vigastuse või mürgituse ennetamiseks, diagnoosimiseks ja ravimiseks eesmärgiga leevendada inimese vaevusi, hoida ära tema tervise seisundi halvenemist või haiguse ägenemist ning taastada tervist. Tervishoiuteenuste loetelu kehtestab sotsiaalminister. (2) Statsionaarne on tervishoiuteenus, mille osutamiseks on vajalik inimese ööpäevaringne viibimine haiglas. (3) Ambulatoorne on tervishoiuteenus, mille osutamiseks inimese ööpäevaringne viibimine haiglas ei ole vajalik.",
      "rdfs:label": {
        "@value": "TTKS_Par_2 (redaktsioon 27072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27072",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_2_v958243"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-17",
        "@type": "xsd:date"
      }
    },
