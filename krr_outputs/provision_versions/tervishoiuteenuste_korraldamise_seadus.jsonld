      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tervishoiuteenuste osutajatele kehtestatud nõuete täitmise üle teostab riiklikku järelevalvet Terviseamet.",
      "rdfs:label": {
        "@value": "TTKS_Par_60 (redaktsioon 106062014021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106062014021",
