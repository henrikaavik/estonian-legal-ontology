      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Perearstina tegutsemise õiguse äravõtmise korral korraldab maavanem perearsti nimistusse kuuluvate isikute ja teeninduspiirkonna teenindamise kuni uue perearsti tegutsemise õiguse kinnitamiseni.",
      "rdfs:label": {
