      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_66_5_v106062014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
