      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "TTKS_Par_44 (redaktsioon 105012011017)",
        "@language": "et"
