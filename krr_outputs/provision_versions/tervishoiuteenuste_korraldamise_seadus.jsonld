        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba on nõutav: kiirabi osutamiseks; eriarstiabi osutamiseks; iseseisvalt õendusabi osutamiseks; iseseisvalt ämmaemandusabi osutamiseks.",
      "rdfs:label": {
        "@value": "TTKS_Par_40 (redaktsioon 13264247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13264247",
