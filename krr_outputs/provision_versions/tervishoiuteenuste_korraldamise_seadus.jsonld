        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "TTKS_Par_72 (redaktsioon 13342621)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13342621"
    },
    {
      "@id": "estleg:TTKS_Par_72_1_v122122013055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_72_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2014. aasta 1. jaanuari hooldusravi osutamiseks välja antud eriarstiabi osutamise tegevusload kehtivad nende kehtivusaja lõpuni.",
      "rdfs:label": {
