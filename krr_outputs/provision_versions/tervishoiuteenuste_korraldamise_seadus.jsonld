        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_57_v113032019165",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse 2. ja 3. peatükis sätestatud ülesandeid täidab Terviseamet. (2) Kehtetu - (3) Terviseamet korraldab vajaduse korral perearsti nimistu alusel tegutsevate perearstide ajutist asendamist, sealhulgas tagab käesoleva seaduse § 81 lõigetes 2 ja 3 reguleerimata juhtudel või ettenägematu ja vältimatu vajaduse ilmnemisel perearsti ajutise asendaja leidmise. (4) Käesoleva paragrahvi lõikes 3 nimetatud perearstide ajutise asendamise eest tasutakse Eesti Haigekassa eelarvest Eesti Haigekassa ja Terviseameti vahel sõlmitud halduslepingu alusel halduskoostöö seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "TTKS_Par_57 (redaktsioon 113032019165)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019165",
