      }
    },
    {
      "@id": "estleg:TTKS_Par_32_1_v120062022093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_32_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Terviseamet võib peatada tervishoiutöötaja registreeringu tervishoiukorralduse infosüsteemis kuni üheks aastaks, kui tervishoiutöötaja on jätnud ettekirjutuse täitmata. (2) Terviseamet peatab tervishoiutöötaja registreeringu tervishoiukorralduse infosüsteemis kuni kolmeks aastaks, kui tervishoiutöötajale on kohtuotsusega kohaldatud kvalifikatsiooni tõendavas dokumendis või infosüsteemis märgitud kutse- või erialal tegutsemise keeldu.",
      "rdfs:label": {
        "@value": "TTKS_Par_32_1 (redaktsioon 120062022093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022093"
    },
    {
      "@id": "estleg:TTKS_Par_32_2_v130122015048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
