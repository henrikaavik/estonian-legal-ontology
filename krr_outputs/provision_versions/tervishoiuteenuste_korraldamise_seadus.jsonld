    },
    {
      "@id": "estleg:TTKS_Par_24_v27072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õendusabi on ambulatoorne või statsionaarne tervishoiuteenus, mida osutavad õde ja ämmaemand koos pere-, eri- või hambaarstiga või iseseisvalt. (2) Õendusabi erialade loetelu kehtestab sotsiaalminister.",
      "rdfs:label": {
        "@value": "TTKS_Par_24 (redaktsioon 27072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27072",
