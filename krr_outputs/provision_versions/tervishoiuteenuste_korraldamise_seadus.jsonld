      }
    },
    {
      "@id": "estleg:TTKS_Par_57_v117052020013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse 2. ja 3. peatükis sätestatud ülesandeid täidab Terviseamet. (2) Kehtetu - (3) Terviseamet korraldab vajaduse korral perearsti nimistu alusel tegutsevate perearstide ajutist asendamist, sealhulgas tagab käesoleva seaduse § 81 lõigetes 2 ja 3 reguleerimata juhtudel või ettenägematu ja vältimatu vajaduse ilmnemisel perearsti ajutise asendaja leidmise. (4) Kehtetu - (jõustumine muudetud - RT I, 21.12.2018, 1) (5) Käesoleva paragrahvi lõikes 3 nimetatud juhtudel tasutakse perearstide ajutise asendamise eest Eesti Haigekassa eelarvest ravikindlustuse seaduse alusel. (jõustumine muudetud - RT I, 21.12.2018, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_57 (redaktsioon 117052020013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117052020013",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_57_v120062022095"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_57_v120062022095",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse 2. ja 3. peatükis sätestatud ülesandeid täidab käesolevas seaduses sätestatud ulatuses Terviseamet. (1¹) Käesoleva seaduse 2. peatüki 2. jaos ja 3. peatüki 2. jaos sätestatud ülesandeid täidab käesolevas seaduses sätestatud ulatuses Eesti Haigekassa. (2) Kehtetu - (3) Eesti Haigekassa korraldab vajaduse korral perearsti nimistu alusel tegutsevate perearstide ajutist asendamist, tagades käesoleva seaduse § 81 lõigetes 2 ja 3 reguleerimata juhtudel või ettenägematu ja vältimatu vajaduse ilmnemisel perearsti ajutise asendaja leidmise, ning edastab teabe asendamise kohta Terviseametile. (3¹) Käesoleva paragrahvi lõikes 3 sätestatud juhul võib tervishoiutöötaja, kellel on arsti kvalifikatsioon, asendada perearsti pikaajalise asendamise korral kuni üks aasta. (3²) Avaliku konkursi korras täitmata perearsti kohaga nimistu puhul võib pikaajaline asendamine kesta kauem kui üks aasta. (4) Kehtetu - (jõustumine muudetud - RT I, 21.12.2018, 1) (5) Käesoleva paragrahvi lõikes 3 nimetatud juhtudel tasutakse perearstide ajutise asendamise eest Eesti Haigekassa eelarvest ravikindlustuse seaduse alusel. (jõustumine muudetud - RT I, 21.12.2018, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_57 (redaktsioon 120062022095)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120062022095",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_57_v110102022004"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_57_v110102022004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_57"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse 2. ja 3. peatükis sätestatud ülesandeid täidab käesolevas seaduses sätestatud ulatuses Terviseamet. (1¹) Käesoleva seaduse 2. peatüki 2. jaos ja 3. peatüki 2. jaos sätestatud ülesandeid täidab käesolevas seaduses sätestatud ulatuses Eesti Haigekassa. (2) Kehtetu - (3) Eesti Haigekassa korraldab vajaduse korral perearsti nimistu alusel tegutsevate perearstide ajutist asendamist, tagades käesoleva seaduse § 81 lõigetes 2 ja 3 reguleerimata juhtudel või ettenägematu ja vältimatu vajaduse ilmnemisel perearsti ajutise asendaja leidmise, ning edastab teabe asendamise kohta Terviseametile. (3¹) Käesoleva paragrahvi lõikes 3 sätestatud juhul võib tervishoiutöötaja, kellel on arsti kvalifikatsioon, asendada perearsti pikaajalise asendamise korral kuni üks aasta. (3²) Avaliku konkursi korras täitmata perearsti kohaga nimistu puhul võib pikaajaline asendamine kesta kauem kui üks aasta. (3³) Käesoleva paragrahvi lõikes 3 sätestatud juhul võib perearsti nimistusse kuuluvaid isikuid Eesti Haigekassa otsuse alusel teenindada selline üldarstiabi osutav juriidiline isik või füüsilisest isikust ettevõtja, kes tegutseb taristus, milles osutab üldarstiabi vähemalt kolm nimistuga perearsti ja kus osutatakse ka ämmaemanda iseseisva vastuvõtu teenust, füsioteraapiateenust ja koduõendusteenust. (3⁴) Käesoleva paragrahvi lõikes 33 nimetatud korras teenuse osutamisel tuleb järgida samu põhimõtteid ja nõudeid nagu perearsti asendamise korral, kui käesolevas seaduses ja selle alusel kehtestatud õigusaktides ei ole sätestatud teisiti. (3⁵) Käesoleva paragrahvi lõikes 33 nimetatud töökorraldus võib kesta kuni üks aasta. (3⁶) Eesti Haigekassa teavitab käesoleva paragrahvi lõikes 33 nimetatud otsuse tegemisest nimistu teeninduspiirkonna kohaliku omavalitsuse üksust, Terviseametit ja perearsti nimistusse kantud isikuid, märkides asendamise kestuse, üldarstiabi osutava isiku, üldarstiabi osutamise koha ja korralduse. See informatsioon pannakse ligipääsetavale ja nähtavale kohale välja ka senises perearsti tegevuskohas. (4) Kehtetu - (jõustumine muudetud - RT I, 21.12.2018, 1) (5) Käesoleva paragrahvi lõikes 3 nimetatud juhtudel tasutakse perearstide ajutise asendamise eest Eesti Haigekassa eelarvest ravikindlustuse seaduse alusel. (jõustumine muudetud - RT I, 21.12.2018, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_57 (redaktsioon 110102022004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110102022004",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_57_v111032023092"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-31",
        "@type": "xsd:date"
      }
    },
