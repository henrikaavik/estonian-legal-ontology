      },
      "estleg:versionValidTo": {
        "@value": "2002-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_65_v197423",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2003.aasta 1. jaanuarini võivad nimistu alusel perearstina tegutseda üldarst ja lastearst, kes on saanud perearstina tegutsemise õiguse enne käesoleva seaduse jõustumist.",
      "rdfs:label": {
        "@value": "TTKS_Par_65 (redaktsioon 197423)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "197423",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_65_v235091"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_65_v235091",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2005.aasta 1. jaanuarini võivad nimistu alusel perearstina tegutseda üldarst ja lastearst, kui nad on saanud perearstina tegutsemise õiguse enne käesoleva seaduse jõustumist ja kui nad õpivad perearsti residentuuris või perearstiks spetsialiseerumise kursustel.",
      "rdfs:label": {
        "@value": "TTKS_Par_65 (redaktsioon 235091)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "235091",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_65_v837122"
      },
      "estleg:versionValidTo": {
        "@value": "2005-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_65_v837122",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni 2005. aasta 1. jaanuarini võivad nimistu alusel perearstina tegutseda üldarst ja lastearst, kui nad on saanud perearstina tegutsemise õiguse enne käesoleva seaduse jõustumist ja kui nad õpivad perearsti residentuuris või perearstiks spetsialiseerumise kursustel.",
      "rdfs:label": {
        "@value": "TTKS_Par_65 (redaktsioon 837122)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "837122",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_65_v12825073"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_65_v12825073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni 2005. aasta 1. jaanuarini võivad nimistu alusel perearstina tegutseda üldarst ja lastearst, kui nad on saanud perearstina tegutsemise õiguse enne käesoleva seaduse jõustumist ja kui nad õpivad perearsti residentuuris või perearstiks spetsialiseerumise kursustel. (2) Käesoleva seaduse § 37 lõike 1 punktis 10 nimetatud perearsti töölt eemalviibimise alguskuupäeva arvestatakse 2007. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "TTKS_Par_65 (redaktsioon 12825073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825073",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_65_v104072012026"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_65_v104072012026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kuni 2005. aasta 1. jaanuarini võivad nimistu alusel perearstina tegutseda üldarst ja lastearst, kui nad on saanud perearstina tegutsemise õiguse enne käesoleva seaduse jõustumist ja kui nad õpivad perearsti residentuuris või perearstiks spetsialiseerumise kursustel. (2) Käesoleva seaduse § 37 lõike 1 punktis 10 nimetatud perearsti töölt eemalviibimise alguskuupäeva arvestatakse 2007. aasta 1. juulist. (3) Perearst, kelle nimistu osas on maavanem enne 2013. aasta 1. jaanuari kooskõlastatult Eesti Haigekassaga lubanud kõrvalekaldeid kehtestatud nimistu piirsuurusest, peab viima oma nimistu vastavusse käesoleva seaduse § 8 lõigetes 41 ja 42 sätestatud nõuetega hiljemalt 2014. aasta 1. jaanuariks. (4) Kui käesoleva paragrahvi lõikes 3 nimetatud nimistusse kantud isikute arv ületab käesoleva seaduse § 8 lõike 41 punktis 1 sätestatud maksimaalse piirmäära, peab perearst hiljemalt 2015. aasta 1. jaanuariks tagama nimistusse kuuluvatele isikutele üldarstiabi osutamise selliselt, et koos perearstiga osutaks üldarstiabi vähemalt üks arsti kvalifikatsiooniga tervishoiutöötaja.",
      "rdfs:label": {
        "@value": "TTKS_Par_65 (redaktsioon 104072012026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072012026"
    },
    {
      "@id": "estleg:TTKS_Par_66_v27072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_66"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigi hallatavate tervishoiuasutuste ümberkujundamine eraõiguslikeks juriidilisteks isikuteks toimub riigi poolt eraõiguslike juriidiliste isikute asutamise ja nendes osalemise seaduses (RT I 1996, 48, 942; 73, õiend; 1998, 59, 941) sätestatud korras. (2) Kohalike omavalitsuste hallatavate tervishoiuasutuste ümberkujundamine eraõiguslikeks juriidilisteks isikuteks toimub kohaliku omavalitsuse korralduse seaduses (RT I 1993, 37, 558; 1999, 82, 755; 2000, 51, 322) sätestatud korras. (3) Riigi või kohalike omavalitsuste hallatavate tervishoiuasutuste ümberkujundamisel eraõiguslikeks juriidilisteks isikuteks lähevad kehtivad töölepingud üle asutatavatele eraõiguslikele juriidilistele isikutele.",
      "rdfs:label": {
        "@value": "TTKS_Par_66 (redaktsioon 27072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27072",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_66_v742897"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
