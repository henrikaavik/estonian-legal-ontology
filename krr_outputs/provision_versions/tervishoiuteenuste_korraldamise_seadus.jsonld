    {
      "@id": "estleg:TTKS_Par_32_1_v106062014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_32_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral võib Terviseamet peatada tervishoiutöötaja registreeringu kuni üheks aastaks käesoleva seaduse § 271 lõike 1 alusel asutatud registris.",
      "rdfs:label": {
        "@value": "TTKS_Par_32_1 (redaktsioon 106062014021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106062014021",
