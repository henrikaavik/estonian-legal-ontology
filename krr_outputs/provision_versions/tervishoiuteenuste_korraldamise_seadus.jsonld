      "estleg:versionValidTo": {
        "@value": "2018-05-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_60_v122052018012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tervishoiuteenuste osutajatele kehtestatud nõuete täitmise üle teostab riiklikku järelevalvet Terviseamet. (2) Riiklikku järelevalvet käesoleva seaduse § 17 lõike 12 ja § 22 lõike 42 nõuete täitmise üle teostab Riigi Infosüsteemi Amet küberturvalisuse seaduses sätestatud pädevuse piires.",
      "rdfs:label": {
        "@value": "TTKS_Par_60 (redaktsioon 122052018012)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122052018012",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_60_v118062021009"
      },
      "estleg:versionValidTo": {
        "@value": "2021-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_60_v118062021009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tervishoiuteenuste osutajatele kehtestatud nõuete täitmise üle teostab riiklikku järelevalvet Terviseamet. (2) Riiklikku järelevalvet käesoleva seaduse § 10 lõike 2, § 17 lõike 12 ja § 22 lõike 42 nõuete täitmise üle teostab Riigi Infosüsteemi Amet küberturvalisuse seaduses sätestatud pädevuse piires.",
      "rdfs:label": {
        "@value": "TTKS_Par_60 (redaktsioon 118062021009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118062021009",
