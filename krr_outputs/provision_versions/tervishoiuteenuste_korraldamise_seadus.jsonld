    {
      "@id": "estleg:TTKS_Par_50_2_v108102024020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_50_2"
      },
      "estleg:versionValidFrom": {
