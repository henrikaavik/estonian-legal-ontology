    },
    {
      "@id": "estleg:TTKS_Par_44_v27072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloas esitatakse: tegevusloa omaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja väljaandmise kuupäev; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik.",
      "rdfs:label": {
        "@value": "TTKS_Par_44 (redaktsioon 27072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27072",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_44_v12825073"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_44_v12825073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
