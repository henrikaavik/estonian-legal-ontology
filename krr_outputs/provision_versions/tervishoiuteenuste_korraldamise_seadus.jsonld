        "@id": "estleg:TTKS_Par_1_v12911510"
      },
      "estleg:versionValidTo": {
        "@value": "2008-01-27",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_1_v12911510",
      "@type": [
