      "estleg:versionRedactionId": "121062024028"
    },
    {
      "@id": "estleg:TTKS_Par_42_v27072",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning teeb otsuse tegevusloa väljaandmise või sellest keeldumise kohta käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates kahe kuu jooksul.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 27072)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27072",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v186751"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v186751",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning teeb otsuse tegevusloa väljaandmise või sellest keeldumise kohta käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates kahe kuu jooksul. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 186751)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186751",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v12825073"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v12825073",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning taotleja poolt esitatud tervishoiutöötajate registreeritust Tervishoiuametis. Otsuse tegevusloa väljaandmise või sellest keeldumise kohta teeb tegevusloa väljaandja kahe kuu jooksul käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates. (1¹) Tegevusloa väljaandmise otsuses märgitakse: otsuse tegija; tegevusloa saaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja otsuse tegemise kuupäev; otsuse tegemise alused; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik ja osutatavate tervishoiuteenuste loetelu; tegevusloa kehtivuse aeg; otsuse vaidlustamise kord. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 12825073)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12825073",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v13188694"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v13188694",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning taotleja poolt esitatud tervishoiutöötajate registreeritust Tervishoiuametis. Otsuse tegevusloa väljaandmise või sellest keeldumise kohta teeb tegevusloa väljaandja kahe kuu jooksul käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates. (1¹) Tegevusloa väljaandmise otsuses märgitakse: otsuse tegija; tegevusloa saaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja otsuse tegemise kuupäev; otsuse tegemise alused; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik ja osutatavate tervishoiuteenuste loetelu; tegevusloa kehtivuse aeg; otsuse vaidlustamise kord; tervishoiuteenuse osutajate nimi, perekonnanimi ja eriala. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 13188694)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13188694",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v13258819"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v13258819",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning taotleja poolt esitatud tervishoiutöötajate registreeritust Terviseametis. Otsuse tegevusloa väljaandmise või sellest keeldumise kohta teeb tegevusloa väljaandja kahe kuu jooksul käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates. (1¹) Tegevusloa väljaandmise otsuses märgitakse: otsuse tegija; tegevusloa saaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja otsuse tegemise kuupäev; otsuse tegemise alused; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik ja osutatavate tervishoiuteenuste loetelu; tegevusloa kehtivuse aeg; otsuse vaidlustamise kord; tervishoiuteenuse osutajate nimi, perekonnanimi ja eriala. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 13258819)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13258819",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v104072012026"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v104072012026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning taotleja poolt esitatud tervishoiutöötajate registreeritust Terviseametis. Otsuse tegevusloa väljaandmise või sellest keeldumise kohta teeb tegevusloa väljaandja kahe kuu jooksul käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates. (1¹) Tegevusloa väljaandmise otsuses märgitakse: otsuse tegija; tegevusloa saaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja otsuse tegemise kuupäev; otsuse tegemise alused; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik ja osutatavate tervishoiuteenuste loetelu; tegevusloa kehtivuse aeg; otsuse vaidlustamise kord; tervishoiuteenuse osutajate nimi, perekonnanimi ja eriala, välja arvatud perearsti nimistu alusel üldarstiabi osutamise loa korral. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 104072012026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072012026",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v129112013006"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v129112013006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-12-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning taotleja poolt esitatud tervishoiutöötajate registreeritust Terviseametis. Otsuse tegevusloa väljaandmise või sellest keeldumise kohta teeb tegevusloa väljaandja kahe kuu jooksul käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates. (1¹) Tegevusloa väljaandmise otsuses märgitakse: otsuse tegija; tegevusloa saaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja otsuse tegemise kuupäev; otsuse tegemise alused; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik ja osutatavate tervishoiuteenuste loetelu; tegevusloa kehtivuse aeg; otsuse vaidlustamise kord; tervishoiuteenuse osutajate nimi, perekonnanimi ja kutse või eriala, välja arvatud perearsti nimistu alusel üldarstiabi osutamise loa korral. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 129112013006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112013006",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v122122013055"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v122122013055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tegevusloa väljaandja kontrollib taotleja esitatud dokumente ja andmeid ning taotleja poolt esitatud tervishoiutöötajate registreeritust Terviseametis. Otsuse tegevusloa väljaandmise või sellest keeldumise kohta teeb tegevusloa väljaandja kahe kuu jooksul käesoleva seaduse §-s 41 nimetatud dokumentide ja andmete esitamisest alates. (1¹) Tegevusloa väljaandmise otsuses märgitakse: otsuse tegija; tegevusloa saaja nimi ning tegevuskoht ja aadress, füüsilisest isikust ettevõtja puhul tema nimi, isikukood, elukoht ja ärinimi; tegevusloa number ja otsuse tegemise kuupäev; otsuse tegemise alused; eriarstiabi osutamise loa korral nende tervishoiuteenuste loetelu, mida isikul on lubatud osutada; kiirabi osutamise loa korral kiirabibrigaadide arv; haiglas eriarstiabi osutamise loa korral haigla liik ja osutatavate tervishoiuteenuste loetelu; tegevusloa kehtivuse aeg; otsuse vaidlustamise kord; tervishoiuteenuse osutajate nimi, perekonnanimi ja kutse või eriala, välja arvatud perearsti nimistu alusel üldarstiabi osutamise loa korral; iseseisvalt statsionaarse õendusabi osutamise loa korral konsulteeriva arsti nimi, isikukood ja kontaktandmed. (2) Enne taotluse esitamist peab taotleja tasuma riigilõivu.",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 122122013055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122013055",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v106062014021"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v106062014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba antakse, kui: perearsti nimistu alusel üldarstiabi osutamise ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel perearsti tegevuskohale kehtestatud nõuetele; eriarstiabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel kehtestatud nõuetele; kiirabi osutamiseks kiirabibrigaadi koosseis ja varustus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ämmaemandusabi osutamise ruumid, sisseseade, aparatuur ja töövahendid vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt õendusabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade, aparatuur, töövahendid ja ravimid vastavad käesoleva seaduse alusel kehtestatud nõuetele; taotleja infotehnoloogiline valmisolek vastab tervise infosüsteemiga andmevahetuseks esitatavatele nõuetele. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 106062014021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106062014021",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v106062014022"
      },
      "estleg:versionValidTo": {
        "@value": "2014-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v106062014022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba antakse, kui: perearsti nimistu alusel üldarstiabi osutamise ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel perearsti tegevuskohale kehtestatud nõuetele; eriarstiabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel kehtestatud nõuetele; kiirabi osutamiseks kiirabibrigaadi koosseis ja varustus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ämmaemandusabi osutamise ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning ämmaemanda pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt õendusabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade, aparatuur, töövahendid ja ravimid vastavad käesoleva seaduse alusel kehtestatud nõuetele; taotleja infotehnoloogiline valmisolek vastab tervise infosüsteemiga andmevahetuseks esitatavatele nõuetele. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 106062014022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106062014022",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v130122015047"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-08",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v130122015047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba antakse, kui: perearsti nimistu alusel üldarstiabi osutamise ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel perearsti tegevuskohale kehtestatud nõuetele; eriarstiabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel kehtestatud nõuetele; kiirabi osutamiseks kiirabibrigaadi koosseis ja varustus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ämmaemandusabi osutamise ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning ämmaemanda pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt õendusabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning õe pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; taotleja infotehnoloogiline valmisolek vastab tervise infosüsteemiga andmevahetuseks esitatavatele nõuetele. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 130122015047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015047",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v111032023093"
      },
      "estleg:versionValidTo": {
        "@value": "2023-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v111032023093",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba antakse, kui: perearsti nimistu alusel üldarstiabi osutamise ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel perearsti tegevuskohale kehtestatud nõuetele; eriarstiabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel kehtestatud nõuetele; kiirabi osutamiseks kiirabibrigaadi koosseis ja varustus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ämmaemandusabi osutamise ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning ämmaemanda pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt õendusabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning õe pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ravi eesmärgil füsioteraapia osutamise tingimused ja nõuded on täidetud ning füsioterapeudi pädevus vastab käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt logopeedilise ravi osutamise tingimused ja nõuded on täidetud ning logopeedi pädevus vastab käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt psühholoogilise ravi osutamise tingimused ja nõuded on täidetud ning kliinilise psühholoogi pädevus vastab käesoleva seaduse alusel kehtestatud nõuetele; taotleja infotehnoloogiline valmisolek vastab tervise infosüsteemiga andmevahetuseks esitatavatele nõuetele. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 111032023093)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023093",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_v121062024028"
      },
      "estleg:versionValidTo": {
        "@value": "2024-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_v121062024028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusluba antakse, kui: perearsti nimistu alusel perearstiabi osutamise ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel perearsti tegevuskohale kehtestatud nõuetele; eriarstiabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade ja aparatuur vastavad käesoleva seaduse alusel kehtestatud nõuetele; kiirabi osutamiseks kiirabibrigaadi koosseis ja varustus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ämmaemandusabi osutamise ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning ämmaemanda pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt õendusabi osutamiseks vajalik töötajate koosseis, ruumid, sisseseade, aparatuur, töövahendid ja ravimid ning õe pädevus vastavad käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt ravi eesmärgil füsioteraapia osutamise tingimused ja nõuded on täidetud ning füsioterapeudi pädevus vastab käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt logopeedilise ravi osutamise tingimused ja nõuded on täidetud ning logopeedi pädevus vastab käesoleva seaduse alusel kehtestatud nõuetele; iseseisvalt psühholoogilise ravi osutamise tingimused ja nõuded on täidetud ning kliinilise psühholoogi pädevus vastab käesoleva seaduse alusel kehtestatud nõuetele; taotleja infotehnoloogiline valmisolek vastab tervise infosüsteemiga andmevahetuseks esitatavatele nõuetele. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_42 (redaktsioon 121062024028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062024028"
    },
    {
      "@id": "estleg:TTKS_Par_42_1_v106062014021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloale lisatakse kõrvaltingimusena tervishoiuteenused, mille osutamiseks on tegevusluba välja antud. (jõustumine muudetud - RT I, 22.12.2013, 1)",
      "rdfs:label": {
        "@value": "TTKS_Par_42_1 (redaktsioon 106062014021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106062014021",
      "estleg:supersededByVersion": {
        "@id": "estleg:TTKS_Par_42_1_v126022015015"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TTKS_Par_42_1_v126022015015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TTKS_Par_42_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tegevusloale lisatakse kõrvaltingimusena: tervishoiuteenused, mille osutamiseks on tegevusluba välja antud; siirata lubatud elundi liik, kui eriarstiabi osutamise tegevusluba on välja antud elundi siirdamiseks.",
      "rdfs:label": {
        "@value": "TTKS_Par_42_1 (redaktsioon 126022015015)",
        "@language": "et"
      },
