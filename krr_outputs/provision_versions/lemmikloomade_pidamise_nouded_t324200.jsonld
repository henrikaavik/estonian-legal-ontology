    {
      "@id": "estleg:Reg_324200_Par_10_v324200",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_324200_Par_10"
