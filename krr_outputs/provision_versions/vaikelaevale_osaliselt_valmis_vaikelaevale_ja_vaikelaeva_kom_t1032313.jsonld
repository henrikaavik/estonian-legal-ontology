  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_vaikelaevale_osaliselt_valmis_vaikelaevale_ja_vaikelaeva_kom_t1032313_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Väikelaevale, osaliselt valmis väikelaevale ja väikelaeva komponentidele esitatavad ohutus- ja kvaliteedinõuded, nende teabe ja märgistusega varustamise ning nõuetele vastavuse tõendamise kord (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Väikelaevale, osaliselt valmis väikelaevale ja väikelaeva komponentidele esitatavad ohutus- ja kvaliteedinõuded, nende teabe ja märgistusega varustamise ning nõuetele vastavuse tõendamise kord"
    },
    {
      "@id": "estleg:Reg_1032313_Par_1_v1032313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032313_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevat määrust kohaldatakse Euroopa Parlamendi ja nõukogu direktiivi 2013/53/EL väikelaevade ja jettide kohta ning direktiivi 94/25/EÜ kehtetuks tunnistamise kohta (ELT L 354, 28.12.2013, lk 90–131) kohaldamisalas olevatele toodetele, milleks on: 1 1) väikelaev ja osaliselt valmis väikelaev; 2 2) jett ja osaliselt valmis jett; 3 3) väikelaeva ja jeti komponent, kui see lastakse Euroopa Liidu turule eraldi; 4 4) käitur, mis on paigaldatud või spetsiaalselt ette nähtud väikelaeva või jeti peale või sisse paigaldamiseks; 5 5) käitur, mis on paigaldatud väikelaeva või jeti peale või sisse ning mida on oluliselt muudetud; 6 6) oluliselt ümber ehitatud väikelaev või jett. Käesolevat määrust kohaldatakse Euroopa Parlamendi ja nõukogu direktiivi 2013/53/EL väikelaevade ja jettide kohta ning direktiivi 94/25/EÜ kehtetuks tunnistamise kohta (ELT L 354, 28.12.2013, lk 90–131) kohaldamisalas olevatele toodetele, milleks on: väikelaev ja osaliselt valmis väikelaev; jett ja osaliselt valmis jett; väikelaeva ja jeti komponent, kui see lastakse Euroopa Liidu turule eraldi; käitur, mis on paigaldatud või spetsiaalselt ette nähtud väikelaeva või jeti peale või sisse paigaldamiseks; käitur, mis on paigaldatud väikelaeva või jeti peale või sisse ning mida on oluliselt muudetud; oluliselt ümber ehitatud väikelaev või jett.",
      "rdfs:label": {
        "@value": "Reg_1032313_Par_1 (redaktsioon 1032313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032313",
      "estleg:sourceAct": "Väikelaevale, osaliselt valmis väikelaevale ja väikelaeva komponentidele esitatavad ohutus- ja kvaliteedinõuded, nende teabe ja märgistusega varustamise ning nõuetele vastavuse tõendamise kord",
      "estleg:provisionRef": "Reg_1032313 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032313_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1032313_Par_2_v1032313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032313_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toote võib teha kättesaadavaks või võtta kasutusele üksnes siis, kui nõuetekohase hooldamise ja ettenähtud otstarbel kasutamise korral ei ohusta see inimeste tervist, turvalisust, vara ega keskkonda, ning üksnes juhul, kui see vastab Euroopa Parlamendi ja nõukogu direktiivist 2013/53/EL tulenevatele nõuetele. Toote võib teha kättesaadavaks või võtta kasutusele üksnes siis, kui nõuetekohase hooldamise ja ettenähtud otstarbel kasutamise korral ei ohusta see inimeste tervist, turvalisust, vara ega keskkonda, ning üksnes juhul, kui see vastab Euroopa Parlamendi ja nõukogu direktiivist 2013/53/EL tulenevatele nõuetele. 2 (2) Toote nõuetele vastavust tuleb tõendada käesoleva paragrahvi lõikes 1 nimetatud õigusakti kohaselt. Toote nõuetele vastavust tuleb tõendada käesoleva paragrahvi lõikes 1 nimetatud õigusakti kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1032313_Par_2 (redaktsioon 1032313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032313",
      "estleg:sourceAct": "Väikelaevale, osaliselt valmis väikelaevale ja väikelaeva komponentidele esitatavad ohutus- ja kvaliteedinõuded, nende teabe ja märgistusega varustamise ning nõuetele vastavuse tõendamise kord",
      "estleg:provisionRef": "Reg_1032313 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032313_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1032313_Par_3_v1032313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032313_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas määruses sätestatud nõuetele vastavuse üle teeb järelevalvet Transpordiamet Euroopa Parlamendi ja nõukogu direktiivis 2013/53/EL, toote nõuetele vastavuse seaduses ja meresõiduohutuse seaduses sätestatud korras. RT I 2022-02-03 1 103022022001 2022-02-06 Käesolevas määruses sätestatud nõuetele vastavuse üle teeb järelevalvet Transpordiamet Euroopa Parlamendi ja nõukogu direktiivis 2013/53/EL, toote nõuetele vastavuse seaduses ja meresõiduohutuse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1032313_Par_3 (redaktsioon 1032313)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032313",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1032313",
      "estleg:sourceAct": "Väikelaevale, osaliselt valmis väikelaevale ja väikelaeva komponentidele esitatavad ohutus- ja kvaliteedinõuded, nende teabe ja märgistusega varustamise ning nõuetele vastavuse tõendamise kord",
      "estleg:provisionRef": "Reg_1032313 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032313_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1032313_Par_4_v1032313",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032313_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kuni 2017. aasta 18. jaanuarini on lubatud turule lasta või kasutusele võtta tooteid, mis kuuluvad Euroopa Parlamendi ja nõukogu direktiivi 94/25/EÜ väikelaevu käsitlevate liikmesriikide õigus- ja haldusnormide ühtlustamise kohta (EÜT L 164, 30.6.1994, lk 15) reguleerimisalasse ning vastavad nimetatud direktiivis sätestatud nõuetele. Kuni 2017. aasta 18. jaanuarini on lubatud turule lasta või kasutusele võtta tooteid, mis kuuluvad Euroopa Parlamendi ja nõukogu direktiivi 94/25/EÜ väikelaevu käsitlevate liikmesriikide õigus- ja haldusnormide ühtlustamise kohta (EÜT L 164, 30.6.1994, lk 15) reguleerimisalasse ning vastavad nimetatud direktiivis sätestatud nõuetele. 2 (2) Kuni 15 kW võimsusega sädesüütega päramootoreid, mis vastavad Euroopa Parlamendi ja nõukogu direktiivi 2013/53/EL I lisa B osa punktis 2.1 sätestatud I etapi heite piirnormidele, on lubatud turule lasta kuni 2020. aasta 18. jaanuarini, eeldusel, et need on tootnud väikesed ja keskmise suurusega ettevõtjad vastavalt Euroopa Komisjoni soovitusele 2003/361/EÜ (ELT L 124, 20.5.2003, lk 36). Kuni 15 kW võimsusega sädesüütega päramootoreid, mis vastavad Euroopa Parlamendi ja nõukogu direktiivi 2013/53/EL I lisa B osa punktis 2.1 sätestatud I etapi heite piirnormidele, on lubatud turule lasta kuni 2020. aasta 18. jaanuarini, eeldusel, et need on tootnud väikesed ja keskmise suurusega ettevõtjad vastavalt Euroopa Komisjoni soovitusele 2003/361/EÜ (ELT L 124, 20.5.2003, lk 36).",
      "rdfs:label": {
        "@value": "Reg_1032313_Par_4 (redaktsioon 1032313)",
        "@language": "et"
      },
