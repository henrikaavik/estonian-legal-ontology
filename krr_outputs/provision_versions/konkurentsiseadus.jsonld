      }
    },
    {
      "@id": "estleg:KonkS_Par_87_v126052017002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KonkS_Par_87"
      },
      "estleg:versionValidFrom": {
