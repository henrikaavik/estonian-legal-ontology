        "@language": "et"
      },
      "estleg:versionRedactionId": "130122014015"
    },
    {
      "@id": "estleg:KonkS_Par_73_7_v782641",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KonkS_Par_73_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juriidilise isiku juhatuse, seda asendava organi või nõukogu liikme poolt teisele ettevõtjale mõistlikel või mittediskrimineerivatel tingimustel võrgustikule, infrastruktuurile või muule olulisele vahendile juurdepääsu mittelubamise eest, samuti muu tegevuse eest, millega on kaasnenud eri- või ainuõigust või olulist vahendit omava juriidilise isiku seaduses sätestatud kohustuste rikkumine, – karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "KonkS_Par_73_7 (redaktsioon 782641)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "782641",
      "estleg:supersededByVersion": {
        "@id": "estleg:KonkS_Par_73_7_v12791504"
      },
      "estleg:versionValidTo": {
        "@value": "2007-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KonkS_Par_73_7_v12791504",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KonkS_Par_73_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teisele ettevõtjale mõistlikel või mittediskrimineerivatel tingimustel võrgustikule, infrastruktuurile või muule olulisele vahendile juurdepääsu mittelubamise eest, samuti muu tegevuse eest, millega on kaasnenud eri- või ainuõigust või olulist vahendit omava ettevõtja seaduses sätestatud kohustuste rikkumine, –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "KonkS_Par_73_7 (redaktsioon 12791504)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12791504",
      "estleg:supersededByVersion": {
        "@id": "estleg:KonkS_Par_73_7_v13316160"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
