        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konkurentsiameti peadirektori või tema asetäitja otsuste peale on isikul õigus kaevata halduskohtumenetluse seadustikus (RT I 1999, 31, 425; 33, õiend; 40, õiend; 96, 846; 2000, 51, 321) sätestatud korras kohtusse.",
      "rdfs:label": {
        "@value": "KonkS_Par_73 (redaktsioon 22479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22479",
      "estleg:supersededByVersion": {
