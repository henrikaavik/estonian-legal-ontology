    {
      "@id": "estleg:KonkS_Par_34_2_v127062012011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KonkS_Par_34_2"
