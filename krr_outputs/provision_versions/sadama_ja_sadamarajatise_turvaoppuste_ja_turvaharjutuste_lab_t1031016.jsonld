      "estleg:provisionRef": "Reg_1031016 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031016_Map"
      }
    },
    {
      "@id": "estleg:Reg_1031016_Par_3_v1031016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031016_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama ja sadamarajatise turvaõppused ja turvaharjutused võivad olla läbi viidud: 1 1) täieulatuslikena või tegelikes oludes; 2 2) mudelsimulatsiooni või seminari vormis või 3 3) kombineerituna teiste isikute või asutuste õppustega. Sadama ja sadamarajatise turvaõppused ja turvaharjutused võivad olla läbi viidud: täieulatuslikena või tegelikes oludes; mudelsimulatsiooni või seminari vormis või kombineerituna teiste isikute või asutuste õppustega.",
      "rdfs:label": {
        "@value": "Reg_1031016_Par_3 (redaktsioon 1031016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031016",
      "estleg:sourceAct": "Sadama ja sadamarajatise turvaõppuste ja turvaharjutuste läbiviimise kord",
      "estleg:provisionRef": "Reg_1031016 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031016_Map"
      }
    },
    {
      "@id": "estleg:Reg_1031016_Par_4_v1031016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031016_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kõik sadamas ja sadamarajatises läbi viidavad turvaõppused ja turvaharjutused peavad olema planeeritud ning dokumenteeritud selliselt, et oleks võimalik tuvastada: 1 1) turvaõppuse või turvaharjutuse toimumise aeg; 2 2) turvaõppuse või turvaharjutuse liik; 3 3) turvaõppusest või turvaharjutusest osavõtjad; 4 4) turvaõppuse või turvaharjutuse sisu. Kõik sadamas ja sadamarajatises läbi viidavad turvaõppused ja turvaharjutused peavad olema planeeritud ning dokumenteeritud selliselt, et oleks võimalik tuvastada: turvaõppuse või turvaharjutuse toimumise aeg; turvaõppuse või turvaharjutuse liik; turvaõppusest või turvaharjutusest osavõtjad; turvaõppuse või turvaharjutuse sisu. 2 (2) Pärast turvaõppuse või turvaharjutuse läbiviimist koostatakse hindamisaruanne, milles hinnatakse turvaõppusele või turvaharjutusele seatud eesmärkide täitmist ning kirjeldatakse turvaõppusel või turvaharjutusel esilekerkinud probleeme ja nende lahendamiseks ette võetud meetmeid. RT I 2022-01-21 16 121012022016 2022-01-24 Pärast turvaõppuse või turvaharjutuse läbiviimist koostatakse hindamisaruanne, milles hinnatakse turvaõppusele või turvaharjutusele seatud eesmärkide täitmist ning kirjeldatakse turvaõppusel või turvaharjutusel esilekerkinud probleeme ja nende lahendamiseks ette võetud meetmeid.",
      "rdfs:label": {
        "@value": "Reg_1031016_Par_4 (redaktsioon 1031016)",
        "@language": "et"
      },
