      }
    },
    {
      "@id": "estleg:Reg_1062316_Par_8_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse minimaalne suurus ühe projekti kohta on 200 000 eurot. Toetuse minimaalne suurus ühe projekti kohta on 200 000 eurot. 2 (2) Toetuse maksimaalne suurus ühe projekti kohta on 215 000 eurot. Toetuse maksimaalne suurus ühe projekti kohta on 215 000 eurot. 3 (3) Toetus projekti kohta on 100 protsenti projekti abikõlblikest kuludest, millest 70 protsenti on Euroopa Sotsiaalfond+ toetus ja 30 protsenti riiklik kaasfinantseering. Toetus projekti kohta on 100 protsenti projekti abikõlblikest kuludest, millest 70 protsenti on Euroopa Sotsiaalfond+ toetus ja 30 protsenti riiklik kaasfinantseering.",
