      }
    },
    {
      "@id": "estleg:Reg_1062316_Par_12_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetust taotletakse vooruliselt. Taotlusvooru võib avada ühe või mitme § 4 lõikes 1 sätestatud tegevuse elluviimise toetamiseks. Toetust taotletakse vooruliselt. Taotlusvooru võib avada ühe või mitme § 4 lõikes 1 sätestatud tegevuse elluviimise toetamiseks. 2 (2) Rakendusüksus avaldab oma veebilehel vähemalt 20 kalendripäeva enne taotluste vastuvõtmise alustamist taotlusvooru tähtaja ja eelarve. Rakendusüksus avaldab oma veebilehel vähemalt 20 kalendripäeva enne taotluste vastuvõtmise alustamist taotlusvooru tähtaja ja eelarve.",
      "rdfs:label": {
        "@value": "Reg_1062316_Par_12 (redaktsioon 1062316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062316",
      "estleg:sourceAct": "Soolise segregatsiooni vähendamine hariduses ja tööturul",
      "estleg:provisionRef": "Reg_1062316 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062316_Par_13_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotluse menetlemise tähtaeg on kuni 60 tööpäeva taotluste esitamise tähtpäevast arvates. Taotluse menetlemise tähtaeg on kuni 60 tööpäeva taotluste esitamise tähtpäevast arvates. 2 (2) Kui taotluse, taotleja või partneri nõuetele vastavuse kontrollimisel avastatakse puudusi, teatatakse sellest viivitamata taotlejale ja antakse puuduste kõrvaldamiseks kuni kümme tööpäeva, mille võrra pikeneb taotluse menetlemise tähtaeg. Kui taotluse, taotleja või partneri nõuetele vastavuse kontrollimisel avastatakse puudusi, teatatakse sellest viivitamata taotlejale ja antakse puuduste kõrvaldamiseks kuni kümme tööpäeva, mille võrra pikeneb taotluse menetlemise tähtaeg.",
      "rdfs:label": {
        "@value": "Reg_1062316_Par_13 (redaktsioon 1062316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062316",
      "estleg:sourceAct": "Soolise segregatsiooni vähendamine hariduses ja tööturul",
      "estleg:provisionRef": "Reg_1062316 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062316_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062316_Par_14_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksus teeb taotluse rahuldamata jätmise otsuse taotlust sisuliselt hindamata, kui taotleja, partner või taotlus ei vasta määruses sätestatud nõudele. Rakendusüksus teeb taotluse rahuldamata jätmise otsuse taotlust sisuliselt hindamata, kui taotleja, partner või taotlus ei vasta määruses sätestatud nõudele.",
      "rdfs:label": {
