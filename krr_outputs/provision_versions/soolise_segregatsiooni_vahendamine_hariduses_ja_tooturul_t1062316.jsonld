    },
    {
      "@id": "estleg:Reg_1062316_Par_16_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_16"
