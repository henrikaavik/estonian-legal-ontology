      }
    },
    {
      "@id": "estleg:Reg_1062316_Par_17_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotlus jäetakse rahuldamata, kui esineb vähemalt üks järgmistest asjaoludest: 1 1) taotleja, partner või taotlus ei vasta määruses sätestatud nõudele; 2 2) taotluses esitatud ja taotluse menetlemisel kogutud teavet hinnates ilmneb, et projekti eesmärgid on saavutatavad ilma toetust määramata; 3 3) taotletav toetuse summa ületab vooru toetuste eelarve jääki ja taotlust ei ole võimalik osaliselt rahuldada; 4 4) taotluses on esitatud ebaõigeid või puudulikke andmeid või taotleja mõjutab õigusvastaselt taotluse menetlemist; 5 5) projekti koondhinne on vähem kui 18 punkti. Taotlus jäetakse rahuldamata, kui esineb vähemalt üks järgmistest asjaoludest: taotleja, partner või taotlus ei vasta määruses sätestatud nõudele; taotluses esitatud ja taotluse menetlemisel kogutud teavet hinnates ilmneb, et projekti eesmärgid on saavutatavad ilma toetust määramata; taotletav toetuse summa ületab vooru toetuste eelarve jääki ja taotlust ei ole võimalik osaliselt rahuldada; taotluses on esitatud ebaõigeid või puudulikke andmeid või taotleja mõjutab õigusvastaselt taotluse menetlemist; projekti koondhinne on vähem kui 18 punkti.",
      "rdfs:label": {
        "@value": "Reg_1062316_Par_17 (redaktsioon 1062316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062316",
      "estleg:sourceAct": "Soolise segregatsiooni vähendamine hariduses ja tööturul",
