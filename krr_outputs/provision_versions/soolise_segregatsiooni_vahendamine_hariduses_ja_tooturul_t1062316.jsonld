    {
      "@id": "estleg:Reg_1062316_Par_3_v1062316",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062316_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksus on Riigi Tugiteenuste Keskus. Rakendusüksus on Riigi Tugiteenuste Keskus. 2 (2) Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium. Rakendusasutus on Majandus- ja Kommunikatsiooniministeerium.",
      "rdfs:label": {
        "@value": "Reg_1062316_Par_3 (redaktsioon 1062316)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062316",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062316",
      "estleg:sourceAct": "Soolise segregatsiooni vähendamine hariduses ja tööturul",
      "estleg:provisionRef": "Reg_1062316 § 3",
