      "estleg:sourceAct": "Jõgevamaa looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056296 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056296_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056296_Par_2_v1056296",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056296_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Jõgevamaal võetakse kaitse alla järgmised üksikobjektid: 1 1) Kivioja rändrahn Pajusi vallas Kaave külas; 2 2) Näkikivi Puurmanni vallas Tammiku külas; 3 3) Ruskavere rändrahn Ruskavere külas; 4 4) Taska-Sepasaare rändrahn Pajusi vallas uuevälja külas; 5 5) Tarakvere allikad (5tk) Saare vallas Tarakvere külas; 6 6) Torma tamm Torma alevikus. RT I 2021-12-23 33 123122021033 2022-01-02 Jõgevamaal võetakse kaitse alla järgmised üksikobjektid: Kivioja rändrahn Pajusi vallas Kaave külas; Näkikivi Puurmanni vallas Tammiku külas; Ruskavere rändrahn Ruskavere külas; Taska-Sepasaare rändrahn Pajusi vallas uuevälja külas; Tarakvere allikad (5tk) Saare vallas Tarakvere külas; Torma tamm Torma alevikus.",
      "rdfs:label": {
        "@value": "Reg_1056296_Par_2 (redaktsioon 1056296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056296",
