        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitse alla võtmise eesmärk on tagada Jõgeva maakonna suuremate rändrahnude, esinduslikumate langeallikate rühma ja põlispuu säilimine. Kaitse alla võtmise eesmärk on tagada Jõgeva maakonna suuremate rändrahnude, esinduslikumate langeallikate rühma ja põlispuu säilimine.",
      "rdfs:label": {
        "@value": "Reg_1056296_Par_1 (redaktsioon 1056296)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056296",
