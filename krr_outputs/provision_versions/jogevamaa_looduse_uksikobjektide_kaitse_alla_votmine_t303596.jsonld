      "estleg:sourceAct": "Jõgevamaa looduse üksikobjektide kaitse alla võtmine",
      "estleg:provisionRef": "Reg_1056296 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056296_Map"
      }
    },
