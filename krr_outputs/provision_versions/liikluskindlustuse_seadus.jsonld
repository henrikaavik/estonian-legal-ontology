      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LIIKLU_Par_10_v131122010010",
      "@type": [
        "owl:NamedIndividual",
