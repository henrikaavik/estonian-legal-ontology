    {
      "@id": "estleg:LIIKLU_Par_41_v111042014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_Par_41"
      },
      "estleg:versionValidFrom": {
