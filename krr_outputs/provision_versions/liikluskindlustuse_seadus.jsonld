        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "LIIKLU_Par_73 (redaktsioon 101062013009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101062013009",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_Par_73_v111042014001"
      },
      "estleg:versionValidTo": {
        "@value": "2014-09-30",
