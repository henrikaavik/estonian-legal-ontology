    {
      "@id": "estleg:LIIKLU_Par_11_v131122010010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_Par_11"
      },
