        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LIIKLU_Par_3_v13074672",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandjal või Garantiifondil on käesolevast seadusest ja liikluskindlustuse lepingust (edaspidi leping) tulenevad kohustused, kui käesoleva seaduse §-s 4 sätestatud sõidukiga tekitati kindlustusjuhtum. (2) Teeliiklus käesoleva seaduse tähenduses on käesoleva seaduse §-s 4 sätestatud sõiduki kasutamine Eesti territooriumil. (3) Teeliiklus käesoleva seaduse tähenduses ei ole liiklus: hoone sees ja sõidukis, välja arvatud hoones asuvas parklas; kohas, mis on eraldatud ja tähistatud võistlusteks või treeninguks; tegutseva lennuvälja territooriumi osal, mis on liikluseks suletud. (4) Sadamas sildunud riigisisest liinivedu tegevale reisiparvlaevale mootorsõidukite pealesõitu ja sellelt mahasõitu loetakse teeliikluseks.",
      "rdfs:label": {
        "@value": "LIIKLU_Par_3 (redaktsioon 13074672)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13074672",
      "estleg:supersededByVersion": {
