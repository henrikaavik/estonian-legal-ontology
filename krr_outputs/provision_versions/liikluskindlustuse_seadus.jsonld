      }
    },
    {
      "@id": "estleg:LIIKLU_Par_73_v111042014001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri põhiandmed avaliku teabe seaduse § 436 lõike 1 tähenduses on andmed: käesoleva seaduse alusel sõlmitud lepingute kohta; Eestis toimunud kindlustusjuhtumite kohta; välisriigis toimunud kindlustusjuhtumite kohta, mis on põhjustatud Eestis põhiasukohta omava sõidukiga. (2) Registris olevate andmete andmekoosseisud, andmekogust andmete saajad, andmete esitamise, väljastamise ja säilitamise tingimused ning kord sätestatakse registri pidamise põhimääruses.",
      "rdfs:label": {
        "@value": "LIIKLU_Par_73 (redaktsioon 111042014001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111042014001",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_Par_73_v129062024011"
      },
      "estleg:versionValidTo": {
        "@value": "2024-11-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LIIKLU_Par_73_v129062024011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registri põhiandmed avaliku teabe seaduse § 436 lõike 1 tähenduses on andmed: sõlmitud lepingute ja automaatse liikluskindlustuse kohta; Eestis toimunud kindlustusjuhtumite kohta; välisriigis toimunud kindlustusjuhtumite kohta, mis on põhjustatud Eestis põhiasukohta omava sõidukiga. (2) Registris olevate andmete andmekoosseisud, andmekogust andmete saajad, andmete esitamise, väljastamise ja säilitamise tingimused ning kord sätestatakse registri pidamise põhimääruses.",
      "rdfs:label": {
        "@value": "LIIKLU_Par_73 (redaktsioon 129062024011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062024011"
    },
    {
      "@id": "estleg:LIIKLU_Par_74_v27016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
