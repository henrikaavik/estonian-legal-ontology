    {
      "@id": "estleg:Reg_1045453_Par_6_v1045453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045453_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lisa-aadresse ja kontaktandmeid kannavad rahvastikuregistrisse järgmised asutused ja isikud: 1 1) Kaitseressursside Amet; 2 2) kohaliku omavalitsuse üksus, kui lisa-aadress või kontaktandmed esitatakse muu menetluse käigus; 3 3) Transpordiamet; RT I 2022-05-19 1 119052022001 2022-05-22 4 4) Maksu- ja Tolliamet; 5 5) Politsei- ja Piirivalveamet; 6 6) Riigi Infosüsteemi Amet; 7 7) Sotsiaalkindlustusamet; 8 8) Välisministeerium kontaktandmete korral; 9 9) notar perekonnaseisutoimingute seaduse § 3 lõikes 8 nimetatud juhtudel ja kooselulepingu sõlmimise või lõpetamise korral; RT I 2023-09-28 3 128092023003 2024-01-01 10 10) kohus kontaktandmete korral; RT I 2022-05-19 1 119052022001 2022-05-22 11 11) Tervise ja Heaolu Infosüsteemide Keskus. RT I 2023-09-05 7 105092023007 2024-01-01 Lisa-aadresse ja kontaktandmeid kannavad rahvastikuregistrisse järgmised asutused ja isikud: Kaitseressursside Amet; kohaliku omavalitsuse üksus, kui lisa-aadress või kontaktandmed esitatakse muu menetluse käigus; Transpordiamet; Maksu- ja Tolliamet; Politsei- ja Piirivalveamet; Riigi Infosüsteemi Amet; Sotsiaalkindlustusamet; Välisministeerium kontaktandmete korral; notar perekonnaseisutoimingute seaduse § 3 lõikes 8 nimetatud juhtudel ja kooselulepingu sõlmimise või lõpetamise korral; kohus kontaktandmete korral; Tervise ja Heaolu Infosüsteemide Keskus.",
      "rdfs:label": {
        "@value": "Reg_1045453_Par_6 (redaktsioon 1045453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045453",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045453",
      "estleg:sourceAct": "Lisa-aadresse ja kontaktandmeid rahvastikuregistrisse kandvate avalikku ülesannet täitvate asutuste ja isikute ning isiku viibimiskoha aadressi andmeandjate loetelu ning lisa-aadressi ja kontaktandmete rahvastikuregistrisse kandmise ja isiku viibimiskoha andmete esitamise kord",
      "estleg:provisionRef": "Reg_1045453 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045453_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045453_Par_7_v1045453",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045453_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-s 6 nimetatud asutus või isik, kellele lisa-aadress või kontaktandmed esitati, tuvastab andmeid esitanud isiku dokumendi alusel, mis on sätestatud isikut tõendavate dokumentide seaduse § 2 lõike 2 punktides 1 ja 12−11 või §-s 4. Käesoleva määruse §-s 6 nimetatud asutus või isik, kellele lisa-aadress või kontaktandmed esitati, tuvastab andmeid esitanud isiku dokumendi alusel, mis on sätestatud isikut tõendavate dokumentide seaduse § 2 lõike 2 punktides 1 ja 12−11 või §-s 4.",
      "rdfs:label": {
        "@value": "Reg_1045453_Par_7 (redaktsioon 1045453)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045453",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045453",
      "estleg:sourceAct": "Lisa-aadresse ja kontaktandmeid rahvastikuregistrisse kandvate avalikku ülesannet täitvate asutuste ja isikute ning isiku viibimiskoha aadressi andmeandjate loetelu ning lisa-aadressi ja kontaktandmete rahvastikuregistrisse kandmise ja isiku viibimiskoha andmete esitamise kord",
      "estleg:provisionRef": "Reg_1045453 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045453_Map_2026"
      }
    },
