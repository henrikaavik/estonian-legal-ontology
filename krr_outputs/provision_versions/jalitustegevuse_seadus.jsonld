    {
      "@id": "estleg:JTS_Par_15_v13247639",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JTS_Par_15"
      },
      "estleg:versionValidFrom": {
