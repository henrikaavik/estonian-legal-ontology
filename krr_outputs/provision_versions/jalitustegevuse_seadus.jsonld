        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:JTS_Par_17_v12825142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JTS_Par_17"
      },
      "estleg:versionValidFrom": {
