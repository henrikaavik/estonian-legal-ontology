        "@id": "estleg:JTS_Par_6_v13003193"
      },
      "estleg:versionValidTo": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:JTS_Par_6_v13003193",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JTS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jälitusasutusteks oma pädevuse piirides on: Kaitsepolitseiamet; Politseiamet; Sõjaväepolitsei; Justiitsministeeriumi vanglate osakond ja vangla; Maksu- ja Tolliamet; Kehtetu – (2) Jälitusasutused tegelevad jälitustegevusega nii vahetult kui ka nende halduses olevate ja selleks volitatud asutuste, allüksuste ja töötajate, samuti salajasele koostööle kaasatud isikute kaudu. (3) Jälitusasutuse juht vastutab jälitustegevuse korraldamise ning selle tegevuse seaduslikkuse eest temale alluvas süsteemis. (4) Jälitusasutused teevad omavahelist koostööd, lähtudes käesolevast seadusest. (5) Kaitsepolitseiamet on jälitusasutus kriminaalasjade kohtueelsel uurimisel. Muude tema pädevusse kuuluvate ülesannete lahendamisele kohaldatakse julgeolekuasutuste seadust.",
      "rdfs:label": {
        "@value": "JTS_Par_6 (redaktsioon 13003193)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13003193",
      "estleg:supersededByVersion": {
        "@id": "estleg:JTS_Par_6_v13247639"
      },
      "estleg:versionValidTo": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:JTS_Par_6_v13247639",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:JTS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jälitusasutusteks oma pädevuse piirides on: Kaitsepolitseiamet; Politsei- ja Piirivalveamet; kehtetu – Sõjaväepolitsei; Justiitsministeeriumi vanglate osakond ja vangla; Maksu- ja Tolliamet; Kehtetu – (2) Jälitusasutused tegelevad jälitustegevusega nii vahetult kui ka nende halduses olevate ja selleks volitatud asutuste, allüksuste ja töötajate, samuti salajasele koostööle kaasatud isikute kaudu. (3) Jälitusasutuse juht vastutab jälitustegevuse korraldamise ning selle tegevuse seaduslikkuse eest temale alluvas süsteemis. (4) Jälitusasutused teevad omavahelist koostööd, lähtudes käesolevast seadusest. (5) Kaitsepolitseiamet on jälitusasutus kriminaalasjade kohtueelsel uurimisel. Muude tema pädevusse kuuluvate ülesannete lahendamisele kohaldatakse julgeolekuasutuste seadust.",
