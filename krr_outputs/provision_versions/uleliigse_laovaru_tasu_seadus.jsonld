        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ÜLTS_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põllumajandustoote ülekandevaru ja üleliigse laovaru määramiseks deklaratsiooni esitamata jätmise või deklaratsioonis valeandmete esitamise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "ÜLTS_Par_21 (redaktsioon 115032014084)",
        "@language": "et"
