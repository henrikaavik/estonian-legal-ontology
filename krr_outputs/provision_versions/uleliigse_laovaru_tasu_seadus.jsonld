    {
      "@id": "estleg:ÜLTS_Par_22_v742646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ÜLTS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 21 sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590) sätteid. (2) Käesoleva seaduse §-s 21 sätestatud väärtegude kohtuväline menetleja on Maksu- ja Tolliamet.",
      "rdfs:label": {
        "@value": "ÜLTS_Par_22 (redaktsioon 742646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742646",
