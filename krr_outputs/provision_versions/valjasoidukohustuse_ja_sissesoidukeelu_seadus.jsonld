      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuni väljasaatmislaagri ehitamiseni ja vastuvõtmiseni viiakse väljasaadetavate kinnipidamise otsused täide kinnise vangla teistest osakondadest eraldatud osakonnas. Väljasaadetavat võib kinni pidada ka politsei arestimajas, kuid mitte üle kümne päeva järjest.",
      "rdfs:label": {
        "@value": "VSS_Par_34_1 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419",
