    },
    {
      "@id": "estleg:VSS_Par_4_v22419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettekirjutus on haldusakt, millega kohustatakse Eestis viibimisaluseta viibivat välismaalast käesolevas seaduses sätestatud juhtudel ja korras Eestist lahkuma või oma Eestis viibimine seadustama. (2) Välismaalane on kohustatud täitma ettekirjutuse lühima võimaliku aja jooksul.",
      "rdfs:label": {
        "@value": "VSS_Par_4 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419"
    },
    {
      "@id": "estleg:VSS_Par_5_v22419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaatmine on seaduses sätestatud juhtudel ja korras väljasõidukohustuse sunniviisiline täitmine.",
      "rdfs:label": {
        "@value": "VSS_Par_5 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419"
    },
    {
      "@id": "estleg:VSS_Par_6_v22419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sissesõidukeeld on tõkend, mille eesmärk on vältida ebasoovitava välismaalase Eestisse saabumist ja Eestis viibimist.",
      "rdfs:label": {
        "@value": "VSS_Par_6 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_6_v108062022022"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_6_v108062022022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sissesõidukeeld on tõkend, mille eesmärk on vältida ebasoovitava välismaalase Eestisse saabumist ja Eestis viibimist. (2) Schengeni sissesõidukeeluga keelatakse välismaalasel siseneda Eesti ja teise Schengeni konventsiooni liikmesriigi territooriumile ja seal viibida.",
      "rdfs:label": {
        "@value": "VSS_Par_6 (redaktsioon 108062022022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108062022022",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_6_v111032023042"
      },
      "estleg:versionValidTo": {
        "@value": "2023-03-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_6_v111032023042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sissesõidukeeld on tõkend, mille eesmärk on vältida ebasoovitava välismaalase Eestisse saabumist ja Eestis viibimist. (2) Schengeni sissesõidukeeluga keelatakse välismaalasel siseneda Eesti ning teise Schengeni konventsiooni ja Euroopa Liidu liikmesriigi territooriumile ja seal viibida.",
      "rdfs:label": {
        "@value": "VSS_Par_6 (redaktsioon 111032023042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111032023042"
    },
    {
      "@id": "estleg:VSS_Par_6_1_v13252342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Migratsioonijärelevalveametnik käesoleva seaduse tähenduses on Politsei- ja Piirivalveameti ametnik, kes ei ole politseiametnik, kuid täidab käesolevast seadusest tulenevaid ülesandeid.",
      "rdfs:label": {
        "@value": "VSS_Par_6_1 (redaktsioon 13252342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13252342",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_6_1_v115032014097"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_6_1_v115032014097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VSS_Par_6_1 (redaktsioon 115032014097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014097"
    },
    {
      "@id": "estleg:VSS_Par_6_2_v13252342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis viibimise, elamise ja töötamise õiguspärasuse kontrollimise ja välismaalase Eestist väljasõidukohustuse täitmise menetlustes kohaldatakse välismaalase isiku tuvastamise ja isikusamasuse kontrollimisele välismaalaste seaduses sätestatut.",
      "rdfs:label": {
        "@value": "VSS_Par_6_2 (redaktsioon 13252342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13252342",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_6_2_v129112010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_6_2_v129112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_6_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses sätestatud menetlustele kohaldatakse välismaalaste seaduse §-des 13–15, 18, 19, 21–28, 30–40, 42, 270, 271 ja 281–284 sätestatut.",
      "rdfs:label": {
        "@value": "VSS_Par_6_2 (redaktsioon 129112010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112010009",
      "estleg:supersededByVersion": {
