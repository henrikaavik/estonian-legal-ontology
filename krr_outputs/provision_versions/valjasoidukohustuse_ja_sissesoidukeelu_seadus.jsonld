        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VSS_Par_22_1 (redaktsioon 129112010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112010009"
    },
    {
      "@id": "estleg:VSS_Par_22_2_v12751464",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_22_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaatmisel õhuteed pidi kasutatakse otselendu. Kui otselennu kasutamine ei ole võimalik, võidakse väljasaatmisel õhuteed pidi taotleda läbisõitu Euroopa Liidu liikmesriigi rahvusvaheliseks lennuliikluseks avatud lennujaama kaudu (edaspidi läbisõit ).",
      "rdfs:label": {
        "@value": "VSS_Par_22_2 (redaktsioon 12751464)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12751464",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_22_2_v129112010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_22_2_v129112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_22_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaatmisel õhuteed pidi kasutatakse otselendu. Kui otselennu kasutamine ei ole võimalik, võidakse väljasaatmisel õhuteed pidi taotleda läbisõitu Euroopa Liidu liikmesriigi rahvusvaheliseks lennuliikluseks avatud lennujaama kaudu (edaspidi läbisõit).",
      "rdfs:label": {
        "@value": "VSS_Par_22_2 (redaktsioon 129112010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112010009",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_22_2_v103012017016"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_22_2_v103012017016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_22_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väljasaatmisel õhuteed pidi kasutatakse otselendu. Kui otselennu kasutamine ei ole mõistlik, võidakse väljasaatmisel õhuteed pidi taotleda läbisõitu Euroopa Liidu liikmesriigi rahvusvaheliseks lennuliikluseks avatud lennujaama kaudu (edaspidi läbisõit).",
      "rdfs:label": {
        "@value": "VSS_Par_22_2 (redaktsioon 103012017016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103012017016"
    },
    {
      "@id": "estleg:VSS_Par_22_3_v12751464",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_22_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väljasaatmist korraldav valitsusasutus esitab lennujaama asukohajärgse riigi pädevale asutusele kirjaliku taotluse väljasaadetava saatjaga või saatjata läbisõiduks õhuteed pidi (edaspidi taotlus ). (2) Taotlus esitatakse vähemalt 48 tundi enne läbisõidu alustamist. Põhjendatud juhul võib taotluse esitada vähemalt 24 tundi enne läbisõidu alustamist. (3) Läbisõitu ei alustata enne loa saamist. Kui taotluse saanud riik ei ole 48 tunni jooksul taotluse esitamisest arvates vastanud, võib alustada läbisõitu, saates selle kohta vastava teate. (4) Väljasaatmist korraldav valitsusasutus võtab vajalikud abimeetmed, et tagada läbisõit võimalikult lühikese aja jooksul. Läbisõit võib kesta kuni 24 tundi. (5) Taotluse vormi õhuteed pidi läbisõiduks",
      "rdfs:label": {
        "@value": "VSS_Par_22_3 (redaktsioon 12751464)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12751464",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_22_3_v129112010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_22_3_v129112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
