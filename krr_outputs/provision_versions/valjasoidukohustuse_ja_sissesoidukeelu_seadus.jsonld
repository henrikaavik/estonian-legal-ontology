        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_14_v742651",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
