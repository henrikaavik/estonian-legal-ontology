      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis viibimise, elamise ja töötamise õiguspärasuse kontrollimise ja välismaalase Eestist väljasõidu kohustuse täitmise menetlustes on välismaalasel ja muul asjassepuutuval isikul välismaalaste seaduses sätestatud kaasaaitamiskohustus, tõendamiskohustus, teavitamiskohustus ja menetlustoimingutel osalemise kohustus.",
      "rdfs:label": {
