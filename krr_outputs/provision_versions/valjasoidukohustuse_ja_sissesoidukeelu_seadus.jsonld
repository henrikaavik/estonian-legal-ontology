      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1999. aasta 1. aprillil.",
      "rdfs:label": {
        "@value": "VSS_Par_37 (redaktsioon 1036440)",
        "@language": "et"
      },
