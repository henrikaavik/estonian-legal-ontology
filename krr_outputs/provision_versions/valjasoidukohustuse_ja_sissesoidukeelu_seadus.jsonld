      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui väljasaatmiskeskuses kinnipidamise tähtaja jooksul ei ole võimalik väljasaatmist täide viia, pikendab halduskohus Politsei- ja Piirivalveameti taotlusel väljasaadetava väljasaatmiskeskuses kinnipidamise tähtaega kuni kahe kuu kaupa kuni väljasaatmise täideviimiseni või välismaalase vabastamiseni käesoleva seaduse § 24 lõike 2 või 3 järgi.",
      "rdfs:label": {
