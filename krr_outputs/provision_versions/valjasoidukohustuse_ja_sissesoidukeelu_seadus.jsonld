      },
      "estleg:versionValidFrom": {
        "@value": "2004-08-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väljasaatmiskeskuse ametnikele korraldatakse tasuta terviseuuringud ning vajaduse korral vaktsineerimine nakkushaiguste vastu. (2) Terviseuuringute ja vaktsineerimise tingimused ja korra",
      "rdfs:label": {
        "@value": "VSS_Par_26_23 (redaktsioon 780269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "780269",
