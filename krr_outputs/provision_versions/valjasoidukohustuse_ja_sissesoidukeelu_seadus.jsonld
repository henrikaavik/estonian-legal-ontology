        "@id": "estleg:VSS_Par_33_1_v129112010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_33_1_v129112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
