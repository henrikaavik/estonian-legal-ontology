      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_34_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Massilisest sisserändest põhjustatud hädaolukorras alustatud kohtumenetluse võib kohus pärast hädaolukorra lõppemist lõpuni viia massilisest sisserändest põhjustatud hädaolukorra sätete kohaselt.",
      "rdfs:label": {
        "@value": "VSS_Par_34_4 (redaktsioon 106082022011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106082022011"
    },
