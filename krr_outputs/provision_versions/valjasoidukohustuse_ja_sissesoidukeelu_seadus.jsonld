      }
    },
    {
      "@id": "estleg:VSS_Par_26_23_v13252342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_26_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Migratsioonijärelevalveametnikele korraldatakse tasuta terviseuuringud ning vajaduse korral vaktsineerimine nakkushaiguste vastu. (2) Terviseuuringute ja vaktsineerimise tingimused ja korra",
      "rdfs:label": {
        "@value": "VSS_Par_26_23 (redaktsioon 13252342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13252342",
