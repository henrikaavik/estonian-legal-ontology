        "@value": "2010-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_23_v129112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väljasaatmist ei ole võimalik lõpule viia käesolevas seaduses sätestatud tähtaja jooksul, paigutatakse väljasaadetav väljasaatmist taotlenud või väljasaatmist täideviiva valitsusasutuse taotlusel halduskohtuniku loal väljasaatmiskeskusse kuni väljasaatmiseni, kuid mitte kauemaks kui kaheks kuuks. (1¹) Väljasaatmiskeskusse paigutatud väljasaadetavat võib väljasaatmiskeskuse asemel kuni 30 päeva kinni pidada politsei arestimajas. Politsei arestimajas kinnipidamisel kohaldatakse vangistusseaduses sätestatud aresti täideviimise tingimusi. (2) Kehtetu - (3) Kehtetu - (4) Kui väljasaadetava kinnipidamine väljasaatmiskeskuses või politsei arestimajas turvalisuse või tervisekaitse kaalutlustel või muul põhjusel ei ole võimalik või on oluliselt raskendatud, võib väljasaadetavat väljasaatmiskeskuse juhataja otsusel majutada järelevalve all väljaspool väljasaatmiskeskust.",
      "rdfs:label": {
        "@value": "VSS_Par_23 (redaktsioon 129112010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112010009",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_23_v103072013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_23_v103072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väljasaatmist ei ole võimalik lõpule viia käesolevas seaduses sätestatud tähtaja jooksul, paigutatakse väljasaadetav väljasaatmist taotlenud või väljasaatmist täideviiva valitsusasutuse taotlusel halduskohtuniku loal kinnipidamiskeskusse kuni väljasaatmiseni, kuid mitte kauemaks kui kaheks kuuks. (1¹) Kinnipidamiskeskusse paigutatud väljasaadetavat võib kinnipidamiskeskuse asemel kuni 30 päeva kinni pidada politsei arestimajas. Politsei arestimajas kinnipidamisel kohaldatakse vangistusseaduses sätestatud aresti täideviimise tingimusi. (2) Kehtetu - (3) Kehtetu - (4) Kui väljasaadetava kinnipidamine kinnipidamiskeskuses või politsei arestimajas turvalisuse või tervisekaitse kaalutlustel või muul põhjusel ei ole võimalik või on oluliselt raskendatud, võib väljasaadetavat kinnipidamiskeskuse juhataja otsusel majutada järelevalve all väljaspool kinnipidamiskeskust.",
      "rdfs:label": {
        "@value": "VSS_Par_23 (redaktsioon 103072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_23_v115032014098"
      },
      "estleg:versionValidTo": {
        "@value": "2014-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_23_v115032014098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väljasaadetavat on vaja käesoleva seaduse § 15 lõikes 2 sätestatud alusel ja lõikes 1 nimetatud põhimõtteid arvestades kinni pidada kauem kui 48 tundi, taotleb Politsei- ja Piirivalveamet või Kaitsepolitseiamet halduskohtult loa väljasaadetava kinnipidamiseks ja paigutamiseks kinnipidamiskeskusesse kuni kaheks kuuks. (1¹) Halduskohus annab loa väljasaadetava kinnipidamiseks ja paigutamiseks kinnipidamiskeskusesse kuni kaheks kuuks, kui esinevad käesoleva seaduse § 15 lõikes 2 sätestatud alus ja lõikes 1 nimetatud põhimõtted. (2) Kehtetu - (3) Kehtetu - (4) Kui väljasaadetava kinnipidamine kinnipidamiskeskuses ei ole turvalisuse või tervisekaitse kaalutlustel või muul põhjusel võimalik või on oluliselt raskendatud, võib väljasaadetavat majutada politsei arestimajas või kinnipidamiskeskuse juhataja otsusel järelevalve all väljaspool kinnipidamiskeskust. (5) Käesoleva paragrahvi lõikes 4 sätestatud juhul tagatakse väljasaadetavale tema kinnipidamisel vähemalt käesoleva seaduse §-des 265, 267, 269 ja 2610 sätestatud teenused.",
      "rdfs:label": {
        "@value": "VSS_Par_23 (redaktsioon 115032014098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014098",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_23_v123032015028"
      },
      "estleg:versionValidTo": {
        "@value": "2015-04-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_23_v123032015028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-04-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väljasaadetavat on vaja käesoleva seaduse § 15 lõikes 2 sätestatud alusel ja lõikes 1 nimetatud põhimõtteid arvestades kinni pidada kauem kui 48 tundi, taotleb Politsei- ja Piirivalveamet või Kaitsepolitseiamet halduskohtult loa väljasaadetava kinnipidamiseks ja paigutamiseks kinnipidamiskeskusesse kuni kaheks kuuks. (1¹) Halduskohus annab loa väljasaadetava kinnipidamiseks ja paigutamiseks kinnipidamiskeskusesse kuni kaheks kuuks, kui esinevad käesoleva seaduse § 15 lõikes 2 sätestatud alus ja lõikes 1 nimetatud põhimõtted. (2) Kehtetu - (3) Kehtetu - (4) Kui väljasaadetava kinnipidamine kinnipidamiskeskuses ei ole turvalisuse või tervisekaitse kaalutlustel või muul põhjusel võimalik või on oluliselt raskendatud, võib väljasaadetavat majutada politsei arestimajas või kinnipidamiskeskuse juhataja või tema poolt määratud ametniku otsusel järelevalve all väljaspool kinnipidamiskeskust. (5) Käesoleva paragrahvi lõikes 4 sätestatud juhul tagatakse väljasaadetavale tema kinnipidamisel vähemalt käesoleva seaduse §-des 265, 267, 269 ja 2610 sätestatud teenused.",
      "rdfs:label": {
        "@value": "VSS_Par_23 (redaktsioon 123032015028)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015028",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_23_v117062020003"
      },
      "estleg:versionValidTo": {
        "@value": "2020-06-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_23_v117062020003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-06-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väljasaadetavat on vaja käesoleva seaduse § 15 lõikes 2 sätestatud alusel ja lõikes 1 nimetatud põhimõtteid arvestades kinni pidada kauem kui 48 tundi, taotleb Politsei- ja Piirivalveamet või Kaitsepolitseiamet halduskohtult loa väljasaadetava kinnipidamiseks ja paigutamiseks kinnipidamiskeskusesse kuni kaheks kuuks. (1¹) Halduskohus annab loa väljasaadetava kinnipidamiseks ja paigutamiseks kinnipidamiskeskusesse kuni kaheks kuuks, kui esinevad käesoleva seaduse § 15 lõikes 2 sätestatud alus ja lõikes 1 nimetatud põhimõtted. (2) Kehtetu - (3) Kehtetu - (4) Politsei- ja Piirivalveamet võib väljasaadetava paigutada politsei arestimajja või teise kinnipidamiskohta, kui väljasaadetava kinnipidamine kinnipidamiskeskuses ei ole võimalik kinnipeetavate arvu ettenägematu kasvu tõttu või see on vajalik turvalisuse või tervisekaitse kaalutlustel. (5) Käesoleva paragrahvi lõikes 4 sätestatud juhul kohaldatakse väljasaadetava kinnipidamisele käesoleva seaduse § 19 lõigetes 12–14 ning § 265 lõigetes 7 ja 8 sätestatut.",
      "rdfs:label": {
        "@value": "VSS_Par_23 (redaktsioon 117062020003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117062020003",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_23_v108062022022"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_23_v108062022022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveamet või Kaitsepolitseiamet taotleb halduskohtult loa pidada Eestis viibimisaluseta viibiv välismaalane kinni ja paigutada ta kinnipidamiskeskusesse kuni kaheks kuuks, kui käesolevas seaduses sätestatud järelevalvemeetmete kohaldamine ei taga välismaalase Eestist lahkuma kohustamise menetluse läbiviimise või lahkumiskohustuse täitmise tulemuslikkust. See on eelkõige lubatud juhul, kui: esineb välismaalase põgenemise oht; välismaalane ei täida kaasaaitamiskohustust või välismaalasel puuduvad tagasipöördumiseks vajalikud dokumendid või nende hankimine vastuvõtvast või transiidiriigist viibib. (1¹) Halduskohus annab loa välismaalase kinnipidamiseks kuni kaheks kuuks käesoleva paragrahvi lõikes 1 sätestatud alusel, kui käesolevas seaduses sätestatud järelevalvemeetmeid ei ole võimalik tõhusalt kohaldada. Kinnipidamine peab olema kooskõlas proportsionaalsuse põhimõttega ning kinnipidamisel peab igal üksikjuhtumil arvestama välismaalasega seotud olulisi asjaolusid. (2) Kehtetu - (3) Kehtetu - (4) Politsei- ja Piirivalveamet võib väljasaadetava paigutada politsei arestimajja või teise kinnipidamiskohta, kui väljasaadetava kinnipidamine kinnipidamiskeskuses ei ole võimalik kinnipeetavate arvu ettenägematu kasvu tõttu või see on vajalik turvalisuse või tervisekaitse kaalutlustel. (5) Käesoleva paragrahvi lõikes 4 sätestatud juhul peab tagama välismaalasele vähemalt järgmiste teenuste osutamise: tervisekontroll ja vajaliku tervishoiuteenuse kättesaadavus käesoleva seaduse § 269 lõikes 7 sätestatud ulatuses; toitlustamine; informeerimine tema õigustest ja kohustustest; vajaduse korral käesoleva seaduse alusel tehtavas menetlustoimingus keeleabi andmine; vajaduse korral varustamine esmavajalike riietus- ja muude tarbeesemete ning isikliku hügieeni vahenditega; välismaalase soovi korral suhtlemise ja kokkusaamise võimaldamine käesoleva seaduse §-s 2610 nimetatud isikuga, kui ei esine nimetatud seaduses sätestatud alust kokkusaamine keelata. (6) Kui välismaalane paigutatakse vangla nõusolekul vanglasse või arestimajja, eraldatakse ta vanglakaristust kandvast kinnipeetavast, eelvangistust kandvast vahistatust ja aresti kandvast isikust. Vanglasse või arestimajja paigutatud välismaalase kinnipidamisele kohaldatakse vangistusseaduses vanglas või arestimajas kinnipidamise kohta sätestatut, arvestades käesolevas paragrahvis sätestatud erisusi. (7) Käesoleva paragrahvi lõikes 4 sätestatud juhul majutatakse perekonnaliikmed kokku. Alaealise välismaalase suhtes kohaldatakse käesoleva seaduse § 265 lõigetes 7 ja 8 sätestatut. (8) Kui Eestist lahkuma kohustamise menetluse tagamiseks on kinnipidamiskeskusesse paigutatud välismaalane, kellele ei ole tehtud lahkumisettekirjutust, kohaldatakse tema kinnipidamisele käesolevas seaduses väljasaadetava kinnipidamiskeskuses kinnipidamise kohta sätestatut.",
      "rdfs:label": {
        "@value": "VSS_Par_23 (redaktsioon 108062022022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108062022022"
    },
    {
      "@id": "estleg:VSS_Par_24_v22419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui osutub võimalikuks väljasaatmislaagris viibiva välismaalase väljasaatmise täideviimine, vabastatakse välismaalane väljasaatmislaagrist ning saadetakse käesolevas seaduses sätestatud korras välja väljasaatmist täideviiva valitsusasutuse taotluse alusel. (2) Kui väljasaadetav võetakse kriminaalasjas kahtlustatava või süüdistatavana vahi alla, vabastatakse väljasaadetav väljasaatmislaagrist vahi alla võtmise määruse alusel. (3) Ettekirjutuse tühistamise või kehtetuks tunnistamise või välismaalasele viibimisaluse andmise otsuse korral vabastatakse välismaalane väljasaatmislaagrist ettekirjutuse tühistamise või kehtetuks tunnistamise või viibimisaluse andmise otsuse alusel. (4) Ettekirjutuse tühistamisest või kehtetuks tunnistamisest või Eestis viibimisaluse andmisest teavitab Kodakondsus- ja Migratsiooniamet kohe välismaalast ja väljasaatmislaagrit.",
      "rdfs:label": {
        "@value": "VSS_Par_24 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_24_v642710"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_24_v642710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui osutub võimalikuks väljasaatmiskeskuses viibiva välismaalase väljasaatmise täideviimine, vabastatakse välismaalane väljasaatmiskeskusest ning saadetakse käesolevas seaduses sätestatud korras välja väljasaatmist täideviiva valitsusasutuse taotluse alusel. (2) Kui väljasaadetav võetakse kriminaalasjas kahtlustatava või süüdistatavana vahi alla, vabastatakse väljasaadetav väljasaatmiskeskusest vahi alla võtmise määruse alusel. (3) Ettekirjutuse tühistamise või kehtetuks tunnistamise või välismaalasele viibimisaluse andmise otsuse korral vabastatakse välismaalane väljasaatmiskeskusest ettekirjutuse tühistamise või kehtetuks tunnistamise või viibimisaluse andmise otsuse alusel. (4) Ettekirjutuse tühistamisest või kehtetuks tunnistamisest või Eestis viibimisaluse andmisest teavitab Kodakondsus- ja Migratsiooniamet kohe välismaalast.",
      "rdfs:label": {
        "@value": "VSS_Par_24 (redaktsioon 642710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "642710",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_24_v13252342"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_24_v13252342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui osutub võimalikuks väljasaatmiskeskuses viibiva välismaalase väljasaatmise täideviimine, vabastatakse välismaalane väljasaatmiskeskusest ning saadetakse käesolevas seaduses sätestatud korras välja väljasaatmist täideviiva valitsusasutuse taotluse alusel. (2) Kui väljasaadetav võetakse kriminaalasjas kahtlustatava või süüdistatavana vahi alla, vabastatakse väljasaadetav väljasaatmiskeskusest vahi alla võtmise määruse alusel. (3) Ettekirjutuse tühistamise või kehtetuks tunnistamise või välismaalasele viibimisaluse andmise otsuse korral vabastatakse välismaalane väljasaatmiskeskusest ettekirjutuse tühistamise või kehtetuks tunnistamise või viibimisaluse andmise otsuse alusel. (4) Ettekirjutuse tühistamisest või kehtetuks tunnistamisest või Eestis viibimisaluse andmisest teavitab Politsei- ja Piirivalveamet kohe välismaalast.",
      "rdfs:label": {
        "@value": "VSS_Par_24 (redaktsioon 13252342)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13252342",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_24_v129112010009"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_24_v129112010009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-12-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui osutub võimalikuks väljasaatmiskeskuses viibiva välismaalase väljasaatmise täideviimine, vabastatakse välismaalane väljasaatmiskeskusest ning saadetakse käesolevas seaduses sätestatud korras välja väljasaatmist täideviiva asutuse taotluse alusel. (1¹) Väljasaadetav vabastatakse väljasaatmiskeskusest või politsei arestimajast või lõpetatakse tema majutamine järelevalve all väljaspool väljasaatmiskeskust, kui 18 kuu jooksul välismaalase väljasaatmiskeskusesse paigutamise otsuse tegemise päevast arvates ei ole väljasaatmist täide viidud. Välismaalase väljasaatmiskeskuses kinnipidamise tähtaja hulka ei loeta välismaalase poolt esitatud rahvusvahelise kaitse saamise taotluse menetlemise aega. (1²) Väljasaadetava vabastamise otsuse teeb väljasaatmiskeskuse juhataja. (2) Kui väljasaadetav võetakse kriminaalasjas kahtlustatava või süüdistatavana vahi alla, vabastatakse väljasaadetav väljasaatmiskeskusest vahi alla võtmise määruse alusel. (3) Ettekirjutuse tühistamise või kehtetuks tunnistamise või välismaalasele viibimisaluse andmise otsuse korral vabastatakse välismaalane väljasaatmiskeskusest ettekirjutuse tühistamise või kehtetuks tunnistamise või viibimisaluse andmise otsuse alusel. (4) Ettekirjutuse tühistamisest või kehtetuks tunnistamisest või Eestis viibimisaluse andmisest teavitab Politsei- ja Piirivalveamet kohe välismaalast. (5) Väljasaatmiskeskusest vabastamine ei anna välismaalasele seaduslikku alust Eestis viibimiseks ja tema Eestis viibimine on ebaseaduslik, kui ta ei oma välismaalaste seaduses, välismaalasele rahvusvahelise kaitse andmise seaduses või Euroopa Liidu kodaniku seaduses sätestatud seaduslikku alust Eestis viibimiseks.",
      "rdfs:label": {
        "@value": "VSS_Par_24 (redaktsioon 129112010009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129112010009",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_24_v103072013007"
      },
      "estleg:versionValidTo": {
        "@value": "2013-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_24_v103072013007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui osutub võimalikuks kinnipidamiskeskuses viibiva välismaalase väljasaatmise täideviimine, vabastatakse välismaalane kinnipidamiskeskusest ning saadetakse käesolevas seaduses sätestatud korras välja väljasaatmist täideviiva asutuse taotluse alusel. (1¹) Väljasaadetav vabastatakse kinnipidamiskeskusest või politsei arestimajast või lõpetatakse tema majutamine järelevalve all väljaspool kinnipidamiskeskust, kui 18 kuu jooksul välismaalase kinnipidamiskeskusesse paigutamise otsuse tegemise päevast arvates ei ole väljasaatmist täide viidud. Välismaalase kinnipidamiskeskuses kinnipidamise tähtaja hulka ei loeta välismaalase poolt esitatud rahvusvahelise kaitse saamise taotluse menetlemise aega. (1²) Väljasaadetava vabastamise otsuse teeb kinnipidamiskeskuse juhataja. (2) Kui väljasaadetav võetakse kriminaalasjas kahtlustatava või süüdistatavana vahi alla, vabastatakse väljasaadetav kinnipidamiskeskusest vahi alla võtmise määruse alusel. (3) Ettekirjutuse tühistamise või kehtetuks tunnistamise või välismaalasele viibimisaluse andmise otsuse korral vabastatakse välismaalane kinnipidamiskeskusest ettekirjutuse tühistamise või kehtetuks tunnistamise või viibimisaluse andmise otsuse alusel. (4) Ettekirjutuse tühistamisest või kehtetuks tunnistamisest või Eestis viibimisaluse andmisest teavitab Politsei- ja Piirivalveamet kohe välismaalast. (5) Kinnipidamiskeskusest vabastamine ei anna välismaalasele seaduslikku alust Eestis viibimiseks ja tema Eestis viibimine on ebaseaduslik, kui ta ei oma välismaalaste seaduses, välismaalasele rahvusvahelise kaitse andmise seaduses või Euroopa Liidu kodaniku seaduses sätestatud seaduslikku alust Eestis viibimiseks.",
      "rdfs:label": {
        "@value": "VSS_Par_24 (redaktsioon 103072013007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103072013007",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_24_v115032014098"
      },
      "estleg:versionValidTo": {
        "@value": "2014-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_24_v115032014098",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui osutub võimalikuks kinnipidamiskeskuses viibiva välismaalase väljasaatmise täideviimine, vabastatakse välismaalane kinnipidamiskeskusest ning saadetakse käesolevas seaduses sätestatud korras välja väljasaatmist täideviiva asutuse taotluse alusel. (1¹) Kinnipidamiskeskuse juhataja vabastab väljasaadetava viivitamata, kui kinnipidamise alus on ära langenud, kinnipidamise tähtaeg on möödunud või väljasaatmine on perspektiivitu. (1²) Kehtetu - (2) Kui väljasaadetav võetakse kriminaalasjas kahtlustatava või süüdistatavana vahi alla, vabastatakse väljasaadetav kinnipidamiskeskusest vahi alla võtmise määruse alusel. (3) Ettekirjutuse tühistamise või kehtetuks tunnistamise või välismaalasele viibimisaluse andmise otsuse korral vabastatakse välismaalane kinnipidamiskeskusest ettekirjutuse tühistamise või kehtetuks tunnistamise või viibimisaluse andmise otsuse alusel. (4) Ettekirjutuse tühistamisest või kehtetuks tunnistamisest või Eestis viibimisaluse andmisest teavitab Politsei- ja Piirivalveamet kohe välismaalast. (5) Kinnipidamiskeskusest vabastamine ei anna väljasaadetavale seaduslikku alust Eestis viibida.",
      "rdfs:label": {
        "@value": "VSS_Par_24 (redaktsioon 115032014098)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014098"
    },
    {
      "@id": "estleg:VSS_Par_25_v22419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui väljasaatmislaagris kinnipidamise tähtaja jooksul ei ole võimalik väljasaatmist täide viia, pikendab halduskohus selleks pädeva kodakondsus- ja migratsiooniametniku taotlusel väljasaadetava väljasaatmislaagris kinnipidamise tähtaega kuni kahe kuu kaupa kuni väljasaatmise täideviimiseni või välismaalase vabastamiseni käesoleva seaduse § 24 lõike 2 või 3 järgi.",
      "rdfs:label": {
        "@value": "VSS_Par_25 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_25_v642710"
      },
      "estleg:versionValidTo": {
        "@value": "2003-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_25_v642710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui väljasaatmiskeskuses kinnipidamise tähtaja jooksul ei ole võimalik väljasaatmist täide viia, pikendab halduskohus selleks pädeva kodakondsus- ja migratsiooniametniku taotlusel väljasaadetava väljasaatmiskeskuses kinnipidamise tähtaega kuni kahe kuu kaupa kuni väljasaatmise täideviimiseni või välismaalase vabastamiseni käesoleva seaduse § 24 lõike 2 või 3 järgi.",
      "rdfs:label": {
        "@value": "VSS_Par_25 (redaktsioon 642710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "642710",
