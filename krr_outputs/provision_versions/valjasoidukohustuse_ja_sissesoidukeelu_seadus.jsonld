      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välismaalase suhtes, kelle sissesõit Eestisse on enne käesoleva seaduse jõustumist tõkestatud, kohaldatakse sissesõidukeeldu vastavalt käesoleva seaduse 5. peatükile.",
      "rdfs:label": {
        "@value": "VSS_Par_34 (redaktsioon 22419)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22419"
    },
    {
      "@id": "estleg:VSS_Par_34_1_v22419",
