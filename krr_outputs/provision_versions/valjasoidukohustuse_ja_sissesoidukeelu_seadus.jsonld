      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_25_v13252342",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
