      }
    },
    {
      "@id": "estleg:VSS_Par_26_23_v115032014097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VSS_Par_26_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Politsei- ja Piirivalveameti ametnikule, kes täidab käesolevast seadusest tulenevaid ülesandeid, korraldatakse tasuta terviseuuringud ning vajaduse korral vaktsineerimine nakkushaiguste vastu. (2) Terviseuuringute ja vaktsineerimise tingimused ja korra",
      "rdfs:label": {
        "@value": "VSS_Par_26_23 (redaktsioon 115032014097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014097",
      "estleg:supersededByVersion": {
