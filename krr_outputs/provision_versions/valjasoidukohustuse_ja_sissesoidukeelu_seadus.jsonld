      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VSS_Par_33_v1036440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
