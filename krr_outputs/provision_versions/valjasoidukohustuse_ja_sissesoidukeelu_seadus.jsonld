      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kodakondsus- ja Migratsiooniameti kinnipidamise õigust omavale ametnikule ja väljasaatmiskeskuse ametnikule võib anda vormiriietuse, mille kirjelduse ja kandmise korra, samuti eraldusmärkide kirjelduse ja kandmise korra kehtestab siseminister määrusega.",
      "rdfs:label": {
        "@value": "VSS_Par_26_22 (redaktsioon 976293)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "976293",
      "estleg:supersededByVersion": {
        "@id": "estleg:VSS_Par_26_22_v13252342"
      },
      "estleg:versionValidTo": {
