      "estleg:provisionRef": "Reg_1035608 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035608_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035608_Par_3_v1035608",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
