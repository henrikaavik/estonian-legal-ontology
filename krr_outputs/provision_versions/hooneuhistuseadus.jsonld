        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HÜS_Par_21_v118122012011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
