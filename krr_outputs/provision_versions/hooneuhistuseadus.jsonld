      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2005. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "HÜS_Par_23 (redaktsioon 776055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776055",
