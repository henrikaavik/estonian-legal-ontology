      }
    },
    {
      "@id": "estleg:HÜS_Par_23_v12742142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HÜS_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-10-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2005. aasta 1. jaanuaril. (2) Käesoleva seaduse § 15 lõige 3 jõustub 2009. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "HÜS_Par_23 (redaktsioon 12742142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12742142"
    },
    {
      "@id": "estleg:HÜS_Par_2_1_v12895646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HÜS_Par_2_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hooneühistu osakapital peab olema vähemalt 40 000 krooni. (2) Hooneühistu liikme osalus hooneühistu osakapitalis (osamaks) vastab tema liikmemaksumäärale. (3) Hooneühistu osakapital märgitakse hooneühistu põhikirjas ja kantakse mittetulundusühingute ja sihtasutuste registrisse.",
      "rdfs:label": {
        "@value": "HÜS_Par_2_1 (redaktsioon 12895646)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895646",
      "estleg:supersededByVersion": {
        "@id": "estleg:HÜS_Par_2_1_v13315664"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HÜS_Par_2_1_v13315664",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HÜS_Par_2_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hooneühistu osakapital peab olema vähemalt 2500 eurot. (2) Hooneühistu liikme osalus hooneühistu osakapitalis (osamaks) vastab tema liikmemaksumäärale. (3) Hooneühistu osakapital märgitakse hooneühistu põhikirjas ja kantakse mittetulundusühingute ja sihtasutuste registrisse.",
      "rdfs:label": {
        "@value": "HÜS_Par_2_1 (redaktsioon 13315664)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13315664",
      "estleg:supersededByVersion": {
        "@id": "estleg:HÜS_Par_2_1_v118122012011"
      },
      "estleg:versionValidTo": {
        "@value": "2012-12-18",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HÜS_Par_2_1_v118122012011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HÜS_Par_2_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hooneühistu osakapital peab olema vähemalt 2500 eurot. (2) Hooneühistu liikme osalus hooneühistu osakapitalis (osamaks) vastab tema liikmemaksumäärale. (3) Hooneühistu osakapital märgitakse hooneühistu põhikirjas ja kantakse äriregistrisse.",
      "rdfs:label": {
        "@value": "HÜS_Par_2_1 (redaktsioon 118122012011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012011"
    },
    {
      "@id": "estleg:HÜS_Par_3_v776055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HÜS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hooneühistu liikme ainukasutuses olev hooneosa on hoonejaotusplaanis temale kasutamiseks kindlaksmääratud eluruumid või mitteeluruumid ning nende juurde kuuluvad hooneosad, mida on võimalik eraldi kasutada ning mida saab muuta, kõrvaldada või lisada kinnisasja ning ühistu teise liikme õigusi kahjustamata või hoone välist kuju muutmata. Hooneühistu liikme ainukasutuses oleva hooneosa hulka võib kuuluda ka püsiva markeeringuga tähistatud garaažiosa. (2) Hooneühistu liikmete ühiskasutuses on kinnisasi ning selle osad ja seadmed, mis on vajalikud hoone püsimiseks, ohutuse tagamiseks või ühiseks kasutamiseks, ka siis, kui need asuvad hooneühistu liikme ainukasutuses oleva hooneosa piires.",
      "rdfs:label": {
        "@value": "HÜS_Par_3 (redaktsioon 776055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776055",
      "estleg:supersededByVersion": {
        "@id": "estleg:HÜS_Par_3_v13087624"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:HÜS_Par_3_v13087624",
