        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "HÜS_Par_21 (redaktsioon 118122012011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012011"
    },
    {
      "@id": "estleg:HÜS_Par_22_v776055",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:HÜS_Par_22"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eluruumide erastamise seaduse (RT I 1993, 23, 411; 2000, 99, 638; 2001, 93, 565; 2002, 47, 297; 53, 336; 2003, 88, 594) § 219 lõike 1 esimene lause muudetakse ja sõnastatakse järgmiselt: «Elamuühistule (-kooperatiivile) kuuluva elamu korterivaldajate koosolek võib kuni vastava elamu aluse maa kinnistusraamatusse kandmiseni otsustada senisest elamuühistust (-kooperatiivist) eraldumise ja elamu baasil korteriühistu või uue elamuühistu asutamise.»",
      "rdfs:label": {
        "@value": "HÜS_Par_22 (redaktsioon 776055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "776055",
      "estleg:supersededByVersion": {
        "@id": "estleg:HÜS_Par_22_v13315664"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
