        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liikme surma korral läheb liikmesus üle pärijale. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "HÜS_Par_10 (redaktsioon 118122012011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012011"
