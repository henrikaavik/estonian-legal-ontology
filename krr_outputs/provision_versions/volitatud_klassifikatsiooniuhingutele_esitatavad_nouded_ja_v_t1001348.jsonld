      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Volitatud klassifikatsiooniühingutele esitatavad nõuded ja volitatud klassifikatsiooniühingute üle järelevalve teostamise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Volitatud klassifikatsiooniühingutele esitatavad nõuded ja volitatud klassifikatsiooniühingute üle järelevalve teostamise kord"
    },
    {
      "@id": "estleg:Reg_1001348_Par_1_v1001348",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
