      }
    },
    {
      "@id": "estleg:Reg_1035222_Par_12_v1035222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035222_Par_12"
