        "@type": "xsd:date"
      },
      "estleg:versionText": "Kõikides veekogudes on keelatud püüda tuurlasi, harjust, tõugjat ja säga. Kõikides veekogudes on keelatud püüda tuurlasi, harjust, tõugjat ja säga.",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_21 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035222",
      "estleg:sourceAct": "Kalapüügieeskiri",
      "estleg:provisionRef": "Reg_1035222 § 21",
