      "estleg:provisionRef": "Reg_1035222 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035222_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035222_Par_28_v1035222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035222_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Püügile asetamisel tuleb täita järgmisi nõudeid: 1 1) avaveemõrdade kaugus üksteisest peab olema vähemalt 300 m külgsuunas ja 50 m muus suunas; 2 2) ääremõrdade kaugus üksteisest ja avaveemõrdadest peab olema vähemalt 100 m külgsuunas ja 50 m muus suunas. Üle 100 m pikkuse juhtaiaga ääremõrra püügile asetamisel kohaldatakse punktis 3 esitatud nõudeid; 3 3) jadasse asetatud avavee- või ääremõrdade kogupikkus ei või ületada 400 m ning jadade omavaheline kaugus peab olema vähemalt 300 m külgsuunas ja 50 m muus suunas; 4 4) kastmõrdade kaugus üksteisest peab olema vähemalt 400 m külgsuunas ja vähemalt 200 m muus suunas ning teistest lõkspüünistest vähemalt 300 m külgsuunas ja vähemalt 100 m muus suunas. Püügile asetamisel tuleb täita järgmisi nõudeid: avaveemõrdade kaugus üksteisest peab olema vähemalt 300 m külgsuunas ja 50 m muus suunas; ääremõrdade kaugus üksteisest ja avaveemõrdadest peab olema vähemalt 100 m külgsuunas ja 50 m muus suunas. Üle 100 m pikkuse juhtaiaga ääremõrra püügile asetamisel kohaldatakse punktis 3 esitatud nõudeid; jadasse asetatud avavee- või ääremõrdade kogupikkus ei või ületada 400 m ning jadade omavaheline kaugus peab olema vähemalt 300 m külgsuunas ja 50 m muus suunas; kastmõrdade kaugus üksteisest peab olema vähemalt 400 m külgsuunas ja vähemalt 200 m muus suunas ning teistest lõkspüünistest vähemalt 300 m külgsuunas ja vähemalt 100 m muus suunas.",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_28 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035222",
      "estleg:sourceAct": "Kalapüügieeskiri",
      "estleg:provisionRef": "Reg_1035222 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035222_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035222_Par_29_v1035222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035222_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keelatud on kasutada nootasid, mille võrgulina silmasuurus on väiksem kui: 1 1) 24 mm meritindipüügil; 2 2) 48 mm punktis 1 ja Euroopa Parlamendi ja nõukogu määruse (EL) nr 2019/1241 VIII lisa B osa punktis 1 nimetamata kalaliikide püügil. RT I 2020-12-22 9 122122020009 2021-01-01 Keelatud on kasutada nootasid, mille võrgulina silmasuurus on väiksem kui: 24 mm meritindipüügil; 48 mm punktis 1 ja Euroopa Parlamendi ja nõukogu määruse (EL) nr 2019/1241 VIII lisa B osa punktis 1 nimetamata kalaliikide püügil.",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_29 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035222",
      "estleg:sourceAct": "Kalapüügieeskiri",
      "estleg:provisionRef": "Reg_1035222 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035222_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035222_Par_3_v1035222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035222_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lubatud kalapüügivahendid jagunevad õngpüünisteks, allveepüügivahenditeks, nakkepüünisteks, lõkspüünisteks, kurnpüünisteks ja traalpüünisteks. Lubatud kalapüügivahendid jagunevad õngpüünisteks, allveepüügivahenditeks, nakkepüünisteks, lõkspüünisteks, kurnpüünisteks ja traalpüünisteks.",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_3 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
