    },
    {
      "@id": "estleg:Reg_1035222_Par_48_v1035222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035222_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kala kaaspüüki, kelle püük sellel ajal või selle püünisega on keelatud, lubatakse kaalu järgi järgmiselt: 1 1) koha, haugi või linaskit lõkspüünistega püügil kuni 3% ahvena, haugi, koha, latika, linaski, lutsu ja säina kogusaagist; 2 2) haugi nakkepüünistega püügil kuni 10% ahvena, koha, latika, linaski, lutsu ja säina kogusaagist. RT I 2023-11-29 1 129112023001 2024-01-01 Kala kaaspüüki, kelle püük sellel ajal või selle püünisega on keelatud, lubatakse kaalu järgi järgmiselt: koha, haugi või linaskit lõkspüünistega püügil kuni 3% ahvena, haugi, koha, latika, linaski, lutsu ja säina kogusaagist; haugi nakkepüünistega püügil kuni 10% ahvena, koha, latika, linaski, lutsu ja säina kogusaagist. 2 (2) Alamõõdulise koha, haugi, lutsu ja linaski kaaspüük kaalu järgi sama kalaliigi mõõduliste isendite saagist on lubatud nakkepüünistega püügil kuni 5% või lõkspüünistega püügil kuni 3%. Alamõõdulise koha, haugi, lutsu ja linaski kaaspüük kaalu järgi sama kalaliigi mõõduliste isendite saagist on lubatud nakkepüünistega püügil kuni 5% või lõkspüünistega püügil kuni 3%. 3 (3) Lõkspüünistega püügil on lubatud alamõõdulise angerja kaaspüük kaalu järgi kuni 2% mõõduliste angerjate saagist. Lõkspüünistega püügil on lubatud alamõõdulise angerja kaaspüük kaalu järgi kuni 2% mõõduliste angerjate saagist.",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_48 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035222",
      "estleg:sourceAct": "Kalapüügieeskiri",
      "estleg:provisionRef": "Reg_1035222 § 48",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035222_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035222_Par_49_v1035222",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035222_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Siseveekogudes, välja arvatud Peipsi, Lämmi- ja Pihkva järves ning Võrtsjärves, peab silmasuurus olema: 1 1) mõrras vähemalt 24 mm, välja arvatud silmupüügil silmumõrraga; 2 2) noodapäras vähemalt 40 mm; 3 3) nakkepüünisel vähemalt 60 mm, välja arvatud lõikes 2 sätestatud juhul. RT I 2023-11-29 1 129112023001 2024-01-01 Siseveekogudes, välja arvatud Peipsi, Lämmi- ja Pihkva järves ning Võrtsjärves, peab silmasuurus olema: mõrras vähemalt 24 mm, välja arvatud silmupüügil silmumõrraga; noodapäras vähemalt 40 mm; nakkepüünisel vähemalt 60 mm, välja arvatud lõikes 2 sätestatud juhul. 2 (2) Saadjärves rääbisepüügil sügavamal kui 7 m peab 1. juulist 31. juulini nakkepüünise silmasuurus olema 40–44 mm. RT I 2023-11-29 1 129112023001 2024-01-01 Saadjärves rääbisepüügil sügavamal kui 7 m peab 1. juulist 31. juulini nakkepüünise silmasuurus olema 40–44 mm.",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_49 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
