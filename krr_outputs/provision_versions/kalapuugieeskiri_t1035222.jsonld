      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Keelatud on püüda: 1 1) nakke- ja lõkspüünistega Võrtsjärves Emajõe muulidele lähemal kui 100 meetrit, ja lõuna pool ala, mis on piiritletud koordinaatidega 58º7.356'N, 26º3.596'E ja 58º7.321'N, 26º5.388'E; RT I 2023-11-29 1 129112023001 2024-01-01 2 2) nakkepüünisega – 15. märtsist, jääalusel püügil 26. märtsist 31. augustini; RT I 2023-11-29 1 129112023001 2024-01-01 3 3) haugi – 15. märtsist 30. aprillini; 4 4) koha – 5. maist 10. juunini; 5 5) linaskit – 20. juunist 20. juulini, välja arvatud püük lihtkäsiõnge, käsiõnge ja põhjaõngega. Keelatud on püüda: nakke- ja lõkspüünistega Võrtsjärves Emajõe muulidele lähemal kui 100 meetrit, ja lõuna pool ala, mis on piiritletud koordinaatidega 58º7.356'N, 26º3.596'E ja 58º7.321'N, 26º5.388'E; nakkepüünisega – 15. märtsist, jääalusel püügil 26. märtsist 31. augustini; haugi – 15. märtsist 30. aprillini; koha – 5. maist 10. juunini; linaskit – 20. juunist 20. juulini, välja arvatud püük lihtkäsiõnge, käsiõnge ja põhjaõngega. 2 (2) Kehtetu - RT I 2026-01-20 5 120012026005 2026-01-23 Kehtetu - 3 (3) Kehtetu - RT I 2026-01-20 5 120012026005 2026-01-23 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1035222_Par_47 (redaktsioon 1035222)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035222",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035222",
      "estleg:sourceAct": "Kalapüügieeskiri",
      "estleg:provisionRef": "Reg_1035222 § 47",
