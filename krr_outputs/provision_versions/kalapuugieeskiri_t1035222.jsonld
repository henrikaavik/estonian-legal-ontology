      "estleg:sourceAct": "Kalapüügieeskiri",
      "estleg:provisionRef": "Reg_1035222 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035222_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1035222_Par_30_v1035222",
      "@type": [
        "owl:NamedIndividual",
