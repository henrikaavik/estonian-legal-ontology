        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega kehtestatakse doonorivere kohustuslike uuringute loetelu, uurimismeetodid ja uuringutulemuste hindamise kord. Käesoleva määrusega kehtestatakse doonorivere kohustuslike uuringute loetelu, uurimismeetodid ja uuringutulemuste hindamise kord.",
      "rdfs:label": {
        "@value": "Reg_1031282_Par_1 (redaktsioon 1031282)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1031282",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1031282",
      "estleg:sourceAct": "Nakkustekitajate suhtes doonorivere ja verekomponentide uurimise kord",
      "estleg:provisionRef": "Reg_1031282 § 1",
      "estleg:partOfAct": {
