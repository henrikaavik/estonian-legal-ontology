      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339383",
      "estleg:sourceAct": "Saatemeeskonna ülesanded ja töökord",
      "estleg:provisionRef": "Reg_339383 § 8",
      "estleg:partOfAct": {
