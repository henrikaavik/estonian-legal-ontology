      }
    },
    {
      "@id": "estleg:Reg_339383_Par_9_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui saadetav paneb saatmise ajal toime õigusaktides sätestatud süülise rikkumise, koostab saatemeeskonna vanem selle kohta ettekande kahes eksemplaris, millest üks lisatakse saadetava isiklikku toimikusse ja teine esitatakse saatmist teostanud Politsei- ja Piirivalveameti struktuuriüksusele. RT I 2011-12-29 72 129122011072 2012-01-01 28 Kui saadetav paneb saatmise ajal toime õigusaktides sätestatud süülise rikkumise, koostab saatemeeskonna vanem selle kohta ettekande kahes eksemplaris, millest üks lisatakse saadetava isiklikku toimikusse ja teine esitatakse saatmist teostanud Politsei- ja Piirivalveameti struktuuriüksusele.",
