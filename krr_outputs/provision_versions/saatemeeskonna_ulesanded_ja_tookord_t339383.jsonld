    {
      "@id": "estleg:Reg_339383_Par_2_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnipeetud isiku saatmine on kahtlustatavana kinnipeetud isiku, vahistatu, sundtoodud isiku, väljasaadetava, arestialuse või süüdimõistetu saatmine arestimajas ja väljaspool arestimaja relvastatud saatemeeskonna valve all. Kinnipeetud isiku saatmine on kahtlustatavana kinnipeetud isiku, vahistatu, sundtoodud isiku, väljasaadetava, arestialuse või süüdimõistetu saatmine arestimajas ja väljaspool arestimaja relvastatud saatemeeskonna valve all.",
      "rdfs:label": {
        "@value": "Reg_339383_Par_2 (redaktsioon 339383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339383",
      "estleg:sourceAct": "Saatemeeskonna ülesanded ja töökord",
      "estleg:provisionRef": "Reg_339383 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339383_Map"
      }
    },
    {
      "@id": "estleg:Reg_339383_Par_3_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Saatmise aluseks on: 1 1) uurimisasutuse määrus; 2 2) kohtumäärus või -otsus; 3 3) prokuratuuri määrus; 4 4) uurimisasutuse, kohtu või prokuratuuri kutse; 5 5) sundtoomismäärus; 6 6) väljasaatmisotsus. Saatmise aluseks on: uurimisasutuse määrus; kohtumäärus või -otsus; prokuratuuri määrus; uurimisasutuse, kohtu või prokuratuuri kutse; sundtoomismäärus; väljasaatmisotsus.",
      "rdfs:label": {
        "@value": "Reg_339383_Par_3 (redaktsioon 339383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339383",
      "estleg:sourceAct": "Saatemeeskonna ülesanded ja töökord",
      "estleg:provisionRef": "Reg_339383 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339383_Map"
      }
    },
    {
      "@id": "estleg:Reg_339383_Par_4_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saatmisülesande täitmise aluseks on saatmise ja saatemeeskonna kohta kirjalik korraldus, mille annab politseiasutuse juht, politseiasutuse vastava struktuuriüksuse juht või arestimaja juht. Saatmisülesande täitmise aluseks on saatmise ja saatemeeskonna kohta kirjalik korraldus, mille annab politseiasutuse juht, politseiasutuse vastava struktuuriüksuse juht või arestimaja juht. 2 (2) Korralduses nimetatud saatemeeskonna koosseisu suurus sõltub konkreetse ülesande iseloomust, saadetavate arvust ja eripärast. Saatemeeskonna minimaalse koosseisu kehtestab Politsei- ja Piirivalveameti peadirektor käskkirjaga. Korralduses nimetatud saatemeeskonna koosseisu suurus sõltub konkreetse ülesande iseloomust, saadetavate arvust ja eripärast. Saatemeeskonna minimaalse koosseisu kehtestab Politsei- ja Piirivalveameti peadirektor käskkirjaga. 3 (3) Saadetavate kinnipeetavate (edaspidi saadetavad) kohta koostatakse saateleht (lisa 1). Saadetavate kinnipeetavate (edaspidi saadetavad) kohta koostatakse saateleht (lisa 1). 4 (4) Korraldus ja saateleht koostatakse kahes eksemplaris. Korraldusel ja saatelehel on ühtne numeratsioon. Korralduse ja saatelehe teine eksemplar antakse kinnipidamiskohale, kuhu saatemeeskond isiku toimetas. Korraldus ja saateleht koostatakse kahes eksemplaris. Korraldusel ja saatelehel on ühtne numeratsioon. Korralduse ja saatelehe teine eksemplar antakse kinnipidamiskohale, kuhu saatemeeskond isiku toimetas.",
      "rdfs:label": {
        "@value": "Reg_339383_Par_4 (redaktsioon 339383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339383",
      "estleg:sourceAct": "Saatemeeskonna ülesanded ja töökord",
      "estleg:provisionRef": "Reg_339383 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339383_Map"
      }
    },
    {
      "@id": "estleg:Reg_339383_Par_5_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saatmine toimub alarmsõidukiga, või kui see ei ole võimalik, siis muu selleks sobiva sõidukiga, milles on tagatud saadetava turvalisus ja käesolevas määruses sätestatud nõuetest kinnipidamine. Saatmine toimub alarmsõidukiga, või kui see ei ole võimalik, siis muu selleks sobiva sõidukiga, milles on tagatud saadetava turvalisus ja käesolevas määruses sätestatud nõuetest kinnipidamine. 2 (2) Saatmine tuleb korraldada viisil, mis välistab saadetava kokkupuute kõrvalise isikuga, saadetava põgenemise või muud saatmise häired. Tagatud peab olema käesoleva määruse § 6 lõikes 1 sätestatud tunnuste alusel saadetavate omavaheline eraldatus saatmisel ja kambritesse paigutamisel. Saatemeeskond on kohustatud kaitsma saadetavat õigusvastase ründe eest. Saatmine tuleb korraldada viisil, mis välistab saadetava kokkupuute kõrvalise isikuga, saadetava põgenemise või muud saatmise häired. Tagatud peab olema käesoleva määruse § 6 lõikes 1 sätestatud tunnuste alusel saadetavate omavaheline eraldatus saatmisel ja kambritesse paigutamisel. Saatemeeskond on kohustatud kaitsma saadetavat õigusvastase ründe eest. 3 (3) Isikut, kelle transportimine ei ole arsti otsuse alusel lubatud, ei saadeta. Meditsiinitöötaja kaasamiseta ei või saata isikut, kes arsti otsuse alusel vajab teekonnal arstiabi. Isikut, kelle transportimine ei ole arsti otsuse alusel lubatud, ei saadeta. Meditsiinitöötaja kaasamiseta ei või saata isikut, kes arsti otsuse alusel vajab teekonnal arstiabi.",
      "rdfs:label": {
        "@value": "Reg_339383_Par_5 (redaktsioon 339383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339383",
      "estleg:sourceAct": "Saatemeeskonna ülesanded ja töökord",
      "estleg:provisionRef": "Reg_339383 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339383_Map"
      }
    },
    {
      "@id": "estleg:Reg_339383_Par_6_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saatmisel paigutatakse eraldi: 1 1) eri soost kinnipeetavad; 2 2) uurimisalused grupikuriteos, kui selle kohta on kohtumäärus või uurimisasutuse määrus; 3 3) alaealine ja täiskasvanu; 4 4) ohtliku nakkushaiguse põdejad; 5 5) psüühiliselt haiged isikud; 6 6) kaitseväe- ja õigus- või korrakaitseasutuste ametnikud, samuti endised ametnikud juhul, kui esineb oht nende elule või tervisele. Saatmisel paigutatakse eraldi: eri soost kinnipeetavad; uurimisalused grupikuriteos, kui selle kohta on kohtumäärus või uurimisasutuse määrus; alaealine ja täiskasvanu; ohtliku nakkushaiguse põdejad; psüühiliselt haiged isikud; kaitseväe- ja õigus- või korrakaitseasutuste ametnikud, samuti endised ametnikud juhul, kui esineb oht nende elule või tervisele. 2 (2) Erandjuhul on politseiasutuse juhi, politseiasutuse vastava struktuuriüksuse juhi või arestimaja juhi loal lubatud sõidukiga saatmisel eirata käesoleva paragrahvi lõike 1 punktides 3 ja 6 sätestatud nõuet. Erandjuhul on politseiasutuse juhi, politseiasutuse vastava struktuuriüksuse juhi või arestimaja juhi loal lubatud sõidukiga saatmisel eirata käesoleva paragrahvi lõike 1 punktides 3 ja 6 sätestatud nõuet.",
      "rdfs:label": {
        "@value": "Reg_339383_Par_6 (redaktsioon 339383)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "339383",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/339383",
      "estleg:sourceAct": "Saatemeeskonna ülesanded ja töökord",
      "estleg:provisionRef": "Reg_339383 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339383_Map"
      }
    },
