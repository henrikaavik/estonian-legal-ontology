    {
      "@id": "estleg:Reg_339383_Par_10_v339383",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_339383_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Saadetava võtab vastu saatemeeskonna vanem. Saadetava võtab vastu saatemeeskonna vanem. 2 (2) Saadetavat vastu võttes või üle andes esitab saatemeeskonna vanem oma ametitunnistuse, kontrollib koos kinnipidamiskoha esindajaga saadetava isiklikku toimikut, saatmise aluseks olevat dokumenti ja saadetava isikusamasust. Saadetavat vastu võttes või üle andes esitab saatemeeskonna vanem oma ametitunnistuse, kontrollib koos kinnipidamiskoha esindajaga saadetava isiklikku toimikut, saatmise aluseks olevat dokumenti ja saadetava isikusamasust. 3 (3) Käesoleva määrusega kehtestatud kohustusliku dokumendi puudumisel või selle mittenõuetekohase vormistamise puhul saadetavat vastu ei võeta ning saatelehele tehakse sellekohane märge. Käesoleva määrusega kehtestatud kohustusliku dokumendi puudumisel või selle mittenõuetekohase vormistamise puhul saadetavat vastu ei võeta ning saatelehele tehakse sellekohane märge.",
      "rdfs:label": {
        "@value": "Reg_339383_Par_10 (redaktsioon 339383)",
        "@language": "et"
      },
