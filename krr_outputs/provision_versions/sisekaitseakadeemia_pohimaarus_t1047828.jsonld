    {
      "@id": "estleg:Reg_1047828_Par_27_v1047828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047828_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Akadeemia õigusaktid ja nõukogu koosseis viiakse käesoleva määrusega vastavusse hiljemalt 1. aprilliks 2025. aastal. Akadeemia õigusaktid ja nõukogu koosseis viiakse käesoleva määrusega vastavusse hiljemalt 1. aprilliks 2025. aastal. 2 (2) Instituudi juhataja tööleping viiakse käesoleva määruse § 17 lõikega 4 vastavusse hiljemalt 1. jaanuariks 2025. aastal. Instituudi juhataja tööleping viiakse käesoleva määruse § 17 lõikega 4 vastavusse hiljemalt 1. jaanuariks 2025. aastal. 3 (3) Rektori kehtestatud siseturvalisuse karjäärikeskuse põhimäärust rakendatakse 1. detsembrist 2024. aastal. RT I 2024-12-17 18 117122024018 2024-12-20 Rektori kehtestatud siseturvalisuse karjäärikeskuse põhimäärust rakendatakse 1. detsembrist 2024. aastal.",
      "rdfs:label": {
        "@value": "Reg_1047828_Par_27 (redaktsioon 1047828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047828",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047828",
      "estleg:sourceAct": "Sisekaitseakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1047828 § 27",
