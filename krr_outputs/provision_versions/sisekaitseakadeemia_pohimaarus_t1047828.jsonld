      "estleg:sourceAct": "Sisekaitseakadeemia põhimäärus",
      "estleg:provisionRef": "Reg_1047828 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047828_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047828_Par_9_v1047828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047828_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nõunike kogu on nõuandev kogu, mis teeb akadeemia arengu kohta ettepanekuid rektorile, nõukogule ja Siseministeeriumile. Nõunike kogu on nõuandev kogu, mis teeb akadeemia arengu kohta ettepanekuid rektorile, nõukogule ja Siseministeeriumile.",
