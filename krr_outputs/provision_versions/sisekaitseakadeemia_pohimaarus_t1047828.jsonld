    {
      "@id": "estleg:Reg_1047828_Par_21_v1047828",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047828_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Akadeemia töötajad on akadeemilised töötajad ning rektor, prorektorid, struktuuriüksuste juhid ja teised mitteakadeemilised töötajad. Akadeemia töötajad on akadeemilised töötajad ning rektor, prorektorid, struktuuriüksuste juhid ja teised mitteakadeemilised töötajad. 2 (2) Akadeemia töötaja ametikoht võib olla politsei-, pääste- või vanglaametniku ametikoht. Akadeemia töötaja ametikoht võib olla politsei-, pääste- või vanglaametniku ametikoht.",
      "rdfs:label": {
        "@value": "Reg_1047828_Par_21 (redaktsioon 1047828)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047828",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047828",
      "estleg:sourceAct": "Sisekaitseakadeemia põhimäärus",
