        "@value": "2017-04-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1038491_Par_3 (redaktsioon 1038491)",
        "@language": "et"
      },
