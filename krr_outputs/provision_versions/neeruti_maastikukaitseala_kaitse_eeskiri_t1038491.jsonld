    },
    {
      "@id": "estleg:Reg_1038491_Par_14_v1038491",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038491_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on bioloogilise mitmekesisuse, maastikuilme, pinnavormide ja poollooduslike koosluste säilitamine. Piiranguvööndi kaitse-eesmärk on bioloogilise mitmekesisuse, maastikuilme, pinnavormide ja poollooduslike koosluste säilitamine.",
      "rdfs:label": {
        "@value": "Reg_1038491_Par_14 (redaktsioon 1038491)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038491",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038491",
