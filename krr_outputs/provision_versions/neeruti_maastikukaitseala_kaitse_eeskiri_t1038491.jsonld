      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Neeruti piiranguvöönd. Kaitsealal on Neeruti piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1038491_Par_13 (redaktsioon 1038491)",
