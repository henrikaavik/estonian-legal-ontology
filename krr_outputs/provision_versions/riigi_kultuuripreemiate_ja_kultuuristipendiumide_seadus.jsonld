        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKPSS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": ". Stipendiumi võib määrata füüsilisele isikule, juriidilisele isikule või asutusele.",
      "rdfs:label": {
