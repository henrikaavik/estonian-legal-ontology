      }
    },
    {
      "@id": "estleg:RKPSS_Par_8_v186618",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKPSS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Igal aastal määratakse 20 stipendiumi. (2) Stipendiumi suurus määratakse igal aastal riigieelarves. (3) Riigi kultuuristipendium antakse haldusmenetluse seaduses (RT I 2001, 58, 354) sätestatud korras, kui käesolev seadus ei näe ette teisiti.",
      "rdfs:label": {
        "@value": "RKPSS_Par_8 (redaktsioon 186618)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186618"
    },
    {
      "@id": "estleg:RKPSS_Par_9_v22421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKPSS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettepanekuid ja taotlusi stipendiumide määramiseks võivad esitada: loomeliidud; teised juriidilised isikud ja asutused, kelle põhikirjas või põhimääruses on sätestatud kultuuri- ja haridusalane tegevus; kohalikud omavalitsused.",
      "rdfs:label": {
        "@value": "RKPSS_Par_9 (redaktsioon 22421)",
        "@language": "et"
      },
