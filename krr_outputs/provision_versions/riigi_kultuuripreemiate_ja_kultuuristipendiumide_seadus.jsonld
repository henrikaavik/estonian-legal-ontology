      },
      "estleg:versionValidTo": {
        "@value": "2003-11-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RKPSS_Par_1_v642357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKPSS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": ". Preemia määratakse füüsilisele isikule.",
      "rdfs:label": {
        "@value": "RKPSS_Par_1 (redaktsioon 642357)",
        "@language": "et"
      },
