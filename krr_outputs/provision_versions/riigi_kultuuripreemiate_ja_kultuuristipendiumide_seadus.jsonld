      "estleg:versionRedactionId": "12787653"
    },
    {
      "@id": "estleg:RKPSS_Par_8_v22421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RKPSS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Igal aastal määratakse 20 stipendiumi. (2) Stipendiumi suurus määratakse igal aastal riigieelarves.",
      "rdfs:label": {
        "@value": "RKPSS_Par_8 (redaktsioon 22421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22421",
