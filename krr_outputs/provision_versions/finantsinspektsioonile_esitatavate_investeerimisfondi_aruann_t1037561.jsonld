      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Finantsinspektsioonile esitatavate investeerimisfondi aruannete sisu, koostamise metoodika ja esitamise kord (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Finantsinspektsioonile esitatavate investeerimisfondi aruannete sisu, koostamise metoodika ja esitamise kord"
    },
    {
      "@id": "estleg:Reg_1037561_Par_1_v1037561",
      "@type": [
