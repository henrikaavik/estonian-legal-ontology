    {
      "@id": "estleg:Reg_158904_Par_12_v158904",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158904_Par_12"
