    },
    {
      "@id": "estleg:Reg_1032376_Par_2_2_v1032376",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032376_Par_2_2"
