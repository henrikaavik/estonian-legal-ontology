      }
    },
    {
      "@id": "estleg:Reg_1054743_Par_3_v1054743",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054743_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu vastutav töötleja on Keskkonnaamet. Andmekogu vastutav töötleja on Keskkonnaamet. 2 (2) Andmekogu vastutav töötleja: 1 1) tagab andmekogu pidamise õigusaktides sätestatud nõuete järgi; 2 2) tagab andmekogu arendamise, haldamise ja pidamise finantseerimise; 3 3) juhib andmekogu arendustöid; 4 4) määrab andmekogu käideldavuse, tervikluse ja konfidentsiaalsuse tagamiseks andmekogu turvameetmed ja korraldab nende rakendamise; 5 5) rakendab meetmeid andmete käideldavuse, tervikluse ja konfidentsiaalsuse nõuete tagamiseks; 6 6) tagab andmekogu teenuste kasutajatoe; 7 7) informeerib volitatud töötlejat aegsasti kavandatavatest muudatustest andmekogu pidamisel ning olulistest takistustest ja probleemidest andmekoguga seotud kohustuste täitmisel; 8 8) teeb oma pädevuse piires järelevalvet andmekogu pidamise üle. Andmekogu vastutav töötleja: tagab andmekogu pidamise õigusaktides sätestatud nõuete järgi; tagab andmekogu arendamise, haldamise ja pidamise finantseerimise; juhib andmekogu arendustöid; määrab andmekogu käideldavuse, tervikluse ja konfidentsiaalsuse tagamiseks andmekogu turvameetmed ja korraldab nende rakendamise; rakendab meetmeid andmete käideldavuse, tervikluse ja konfidentsiaalsuse nõuete tagamiseks; tagab andmekogu teenuste kasutajatoe; informeerib volitatud töötlejat aegsasti kavandatavatest muudatustest andmekogu pidamisel ning olulistest takistustest ja probleemidest andmekoguga seotud kohustuste täitmisel; teeb oma pädevuse piires järelevalvet andmekogu pidamise üle.",
      "rdfs:label": {
        "@value": "Reg_1054743_Par_3 (redaktsioon 1054743)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054743",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054743",
      "estleg:sourceAct": "Fluoritud kasvuhoonegaase ja osoonikihti kahandavaid aineid sisaldavate toodete, seadmete, süsteemide ja mahutite ning käitlemistoimingute registri põhimäärus, registrisse andmete esitamise kord ja andmekoosseis",
      "estleg:provisionRef": "Reg_1054743 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054743_Map_2026"
      }
