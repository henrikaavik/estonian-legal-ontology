    {
      "@id": "estleg:Reg_1054743_Par_12_v1054743",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054743_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogusse esitatud andmete õigsuse eest vastutab andmete esitaja. Andmekogusse esitatud andmete õigsuse eest vastutab andmete esitaja. 2 (2) Andmekogusse kantud andmete muutumise või neis vigade ilmnemise korral parandab andmete esitaja, vastutav või volitatud töötleja andmed viivitamata. Andmekogusse kantud andmete muutumise või neis vigade ilmnemise korral parandab andmete esitaja, vastutav või volitatud töötleja andmed viivitamata. 3 (3) Kui andmekogu ei võimalda andmete esitajal andmeid parandada, teavitab ta andmete muutumisest või andmetes vea avastamisest viivitamata vastutavat töötlejat. Kui andmekogu ei võimalda andmete esitajal andmeid parandada, teavitab ta andmete muutumisest või andmetes vea avastamisest viivitamata vastutavat töötlejat.",
      "rdfs:label": {
        "@value": "Reg_1054743_Par_12 (redaktsioon 1054743)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054743",
