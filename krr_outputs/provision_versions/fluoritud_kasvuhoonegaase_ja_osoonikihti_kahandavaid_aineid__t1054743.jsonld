    },
    {
      "@id": "estleg:Reg_1054743_Par_8_v1054743",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054743_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete andmekogusse kandmise alusdokumendid on: 1 1) fluoritud kasvuhoonegaase sisaldava toote, seadme ja süsteemi käitlemise luba; 2 2) fluoritud kasvuhoonegaase sisaldavate elektrijaotlate paigaldamise, teenindamise, hooldamise, remondi või kasutuselt kõrvaldamisega või paiksetest elektrijaotlatest fluoritud kasvuhoonegaaside kokkukogumisega tegeleva füüsilise isiku sertifikaat; 3 3) osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevust tõendavad dokumendid, mis on nimetatud atmosfääriõhu kaitse seaduse § 186 lõike 2 alusel kehtestatud valdkonna eest vastutava ministri määruses; RT I 2023-07-13 1 113072023001 2023-07-16 4 4) Keskkonnaameti objekti kontrollimise protokoll. Andmete andmekogusse kandmise alusdokumendid on: fluoritud kasvuhoonegaase sisaldava toote, seadme ja süsteemi käitlemise luba; fluoritud kasvuhoonegaase sisaldavate elektrijaotlate paigaldamise, teenindamise, hooldamise, remondi või kasutuselt kõrvaldamisega või paiksetest elektrijaotlatest fluoritud kasvuhoonegaaside kokkukogumisega tegeleva füüsilise isiku sertifikaat; osoonikihti kahandavaid aineid sisaldavate või nendel ainetel põhinevate toodete, seadmete või mahutite käitlemisega tegeleva isiku pädevust tõendavad dokumendid, mis on nimetatud atmosfääriõhu kaitse seaduse § 186 lõike 2 alusel kehtestatud valdkonna eest vastutava ministri määruses; Keskkonnaameti objekti kontrollimise protokoll.",
      "rdfs:label": {
        "@value": "Reg_1054743_Par_8 (redaktsioon 1054743)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054743",
