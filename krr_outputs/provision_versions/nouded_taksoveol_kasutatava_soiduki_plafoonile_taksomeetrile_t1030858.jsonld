      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Nõuded taksoveol kasutatava sõiduki plafoonile, taksomeetrile ja hinnakirjale ning nende paigutusele (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Nõuded taksoveol kasutatava sõiduki plafoonile, taksomeetrile ja hinnakirjale ning nende paigutusele"
    },
    {
      "@id": "estleg:Reg_1030858_Par_1_v1030858",
