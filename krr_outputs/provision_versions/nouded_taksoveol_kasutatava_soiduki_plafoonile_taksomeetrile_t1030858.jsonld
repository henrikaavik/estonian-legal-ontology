      },
      "estleg:versionValidFrom": {
        "@value": "2015-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Plafoon peab olema sõiduki katusel risti sõidusuunaga, sisevalgustusega ja selle esiküljel peab olema trükitähtedega kirjutatud ainult sõna „TAKSO” minimaalse tähemärgi kõrgusega neli sentimeetrit. Plafoon peab olema sõiduki katusel risti sõidusuunaga, sisevalgustusega ja selle esiküljel peab olema trükitähtedega kirjutatud ainult sõna „TAKSO” minimaalse tähemärgi kõrgusega neli sentimeetrit.",
      "rdfs:label": {
        "@value": "Reg_1030858_Par_1 (redaktsioon 1030858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030858",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030858",
      "estleg:sourceAct": "Nõuded taksoveol kasutatava sõiduki plafoonile, taksomeetrile ja hinnakirjale ning nende paigutusele",
      "estleg:provisionRef": "Reg_1030858 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030858_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030858_Par_2_v1030858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030858_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taksomeeter peab olema paigutatud sõitjale nähtavale kohale armatuurlaual või asuma salongi tahavaatepeeglis ja olema sõidukiga kohandatud ning sobima paigaldatud printeriga. Taksomeeter peab olema paigutatud sõitjale nähtavale kohale armatuurlaual või asuma salongi tahavaatepeeglis ja olema sõidukiga kohandatud ning sobima paigaldatud printeriga.",
      "rdfs:label": {
        "@value": "Reg_1030858_Par_2 (redaktsioon 1030858)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030858",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030858",
      "estleg:sourceAct": "Nõuded taksoveol kasutatava sõiduki plafoonile, taksomeetrile ja hinnakirjale ning nende paigutusele",
      "estleg:provisionRef": "Reg_1030858 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030858_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030858_Par_3_v1030858",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1030858_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hinnakiri peab vastama taksomeetri kohandamistunnistusele, olema selgelt loetav ja arusaadav ning see tuleb paigaldada sõiduki armatuurlaua paremale poole nähtavale kohale ja parempoolse tagaukse aknale nii, et see oleks nähtav nii sõiduki seest kui väljast. Hinnakiri peab vastama taksomeetri kohandamistunnistusele, olema selgelt loetav ja arusaadav ning see tuleb paigaldada sõiduki armatuurlaua paremale poole nähtavale kohale ja parempoolse tagaukse aknale nii, et see oleks nähtav nii sõiduki seest kui väljast.",
      "rdfs:label": {
        "@value": "Reg_1030858_Par_3 (redaktsioon 1030858)",
        "@language": "et"
      },
