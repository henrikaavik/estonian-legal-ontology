      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Praktika korraldamise ning läbiviimise tingimused ja kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Praktika korraldamise ning läbiviimise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1016426_Par_1_v1016426",
      "@type": [
