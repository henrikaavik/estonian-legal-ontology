    },
    {
      "@id": "estleg:RELS_Par_14_v22413",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RELS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loenduse korraldamisel on riigi ja kohalike omavalitsuste andmekogude pidajad kohustatud Statistikaameti nõudmisel esitama riigi ja kohalike omavalitsuste andmekogudes olevaid loenduse läbiviimiseks vajalikke andmeid kooskõlas isikuandmete kaitse seaduse (RT I 1996, 48, 944), andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552) ning nende alusel kehtestatud õigusaktidega.",
      "rdfs:label": {
        "@value": "RELS_Par_14 (redaktsioon 22413)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22413",
      "estleg:supersededByVersion": {
