        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RELS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loenduse korraldamisel on riigi ja kohalike omavalitsuste andmekogude pidajad kohustatud Statistikaameti nõudmisel esitama riigi ja kohalike omavalitsuste andmekogudes olevaid loenduse läbiviimiseks vajalikke andmeid kooskõlas isikuandmete kaitse seaduse (RT I 1996, 48, 944), avaliku teabe seaduse ning nende alusel kehtestatud õigusaktidega.",
      "rdfs:label": {
        "@value": "RELS_Par_14 (redaktsioon 12825117)",
        "@language": "et"
      },
