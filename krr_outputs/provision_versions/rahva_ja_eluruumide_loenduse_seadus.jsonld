      }
    },
    {
      "@id": "estleg:RELS_Par_5_v12825117",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RELS_Par_5"
