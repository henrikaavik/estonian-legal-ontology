      },
      "estleg:versionValidTo": {
        "@value": "2009-02-12",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RELS_Par_41_v13141388",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RELS_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loendusega kogutavate andmete esitamise ja edastamise korra rikkumisel rakendatakse haldusõiguserikkumiste seadustiku paragrahvis 183 sätestatud karistusi.",
      "rdfs:label": {
        "@value": "RELS_Par_41 (redaktsioon 13141388)",
        "@language": "et"
