        "@value": "Sätete redaktsioonid: Eestis soetatud kaupade eest tasutud käibemaksu tagastamiseks esitatava taotluse vorm (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eestis soetatud kaupade eest tasutud käibemaksu tagastamiseks esitatava taotluse vorm"
    },
    {
      "@id": "estleg:Reg_1034723_Par_1_v1034723",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
