      },
      "dc:source": "Riiklikku alkoholiregistrisse registrikande tegemiseks esitatava taotluse vorminõuded"
    },
    {
      "@id": "estleg:Reg_155495_Par_1_v155495",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
