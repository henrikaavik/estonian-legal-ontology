    {
      "@id": "estleg:Reg_305244_Par_2_v305244",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305244_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Viljandi maakonnas Viiratsi vallas Kibeküla külas, Paistu vallas Loodi, Paistu, Aidu, Intsu, Lolu, Viisuküla, Holstre, Pirmastu ja Mustapali külas ning Pärsti vallas Heimtali, Sinialliku, Vardi ja Matapera külas. Kaitseala asub Viljandi maakonnas Viiratsi vallas Kibeküla külas, Paistu vallas Loodi, Paistu, Aidu, Intsu, Lolu, Viisuküla, Holstre, Pirmastu ja Mustapali külas ning Pärsti vallas Heimtali, Sinialliku, Vardi ja Matapera külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_305244_Par_2 (redaktsioon 305244)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305244",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305244",
      "estleg:sourceAct": "Loodi looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305244 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305244_Map_2026"
      }
    },
