    },
    {
      "@id": "estleg:Reg_305244_Par_14_v305244",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305244_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas; 3 3) uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 4–7 sätestatut. Piiranguvööndis on lubatud: majandustegevus; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas; uute ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 4–7 sätestatut. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas; 2 2) uue maaparandussüsteemi rajamine; 3 3) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 4 4) energiapuistute rajamine; 5 5) pargis puuvõrade või põõsaste kujundamine ja puittaimestiku raie. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas; uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; energiapuistute rajamine; pargis puuvõrade või põõsaste kujundamine ja puittaimestiku raie.",
      "rdfs:label": {
        "@value": "Reg_305244_Par_14 (redaktsioon 305244)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305244",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305244",
      "estleg:sourceAct": "Loodi looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305244 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305244_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305244_Par_15_v305244",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305244_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine; 2 2) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul valitsejaga kooskõlastatud kohtades; 3 3) Sinialliku ojale Viljandi–Karksi-Nuia maanteest allavoolu uute tõkestusrajatiste rajamine; 4 4) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal; 5 5) uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; 6 6) puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: puhtpuistute kujundamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul valitsejaga kooskõlastatud kohtades; Sinialliku ojale Viljandi–Karksi-Nuia maanteest allavoolu uute tõkestusrajatiste rajamine; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal; uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_305244_Par_15 (redaktsioon 305244)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305244",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305244",
      "estleg:sourceAct": "Loodi looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305244 § 15",
