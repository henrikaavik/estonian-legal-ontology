    {
      "@id": "estleg:Reg_305244_Par_5_v305244",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305244_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekuta on kaitsealal keelatud: 1 1) muuta katastriüksuse kõlviku piire ja sihtotstarvet; 2 2) koostada maakorralduskava ja teostada maakorraldustoiminguid; 3 3) väljastada metsamajandamiskava; 4 4) kehtestada detailplaneeringut ja üldplaneeringut; 5 5) anda nõusolekut väikeehitise, sealhulgas lautri või paadisilla ehitamiseks; 6 6) anda projekteerimistingimusi; 7 7) anda ehitusluba. Kaitseala valitseja nõusolekuta on kaitsealal keelatud: muuta katastriüksuse kõlviku piire ja sihtotstarvet; koostada maakorralduskava ja teostada maakorraldustoiminguid; väljastada metsamajandamiskava; kehtestada detailplaneeringut ja üldplaneeringut; anda nõusolekut väikeehitise, sealhulgas lautri või paadisilla ehitamiseks; anda projekteerimistingimusi; anda ehitusluba.",
      "rdfs:label": {
        "@value": "Reg_305244_Par_5 (redaktsioon 305244)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305244",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305244",
      "estleg:sourceAct": "Loodi looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305244 § 5",
