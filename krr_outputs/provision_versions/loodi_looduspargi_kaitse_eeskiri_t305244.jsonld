      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305244",
      "estleg:sourceAct": "Loodi looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305244 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_305244_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_305244_Par_13_v305244",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_305244_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_305244_Par_13 (redaktsioon 305244)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "305244",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/305244",
      "estleg:sourceAct": "Loodi looduspargi kaitse-eeskiri",
      "estleg:provisionRef": "Reg_305244 § 13",
