    {
      "@id": "estleg:Reg_158989_Par_4_v158989",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158989_Par_4"
