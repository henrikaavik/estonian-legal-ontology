        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VPA_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-02-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametivolituste ajal on presidendil õigus kasutada riigi kulul töö-, elu- ja esindusruume ning ametiautot koos nende korrashoiu ja kasutamisega seotud teenustega.",
      "rdfs:label": {
        "@value": "VPA_Par_4 (redaktsioon 993386)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "993386",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/993386",
      "estleg:sourceAct": "Vabariigi Presidendi ametihüve seadus",
      "estleg:provisionRef": "VPA § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VPA_Map_2026"
      }
    },
    {
