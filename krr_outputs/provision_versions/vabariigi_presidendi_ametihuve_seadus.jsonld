        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Presidendiks valitud isikule korraldatakse riigi kulul austusavaldustega matused.",
      "rdfs:label": {
        "@value": "VPA_Par_12 (redaktsioon 34815)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "34815",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/34815",
