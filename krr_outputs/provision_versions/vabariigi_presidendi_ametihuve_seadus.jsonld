      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametivolituste ajal on presidendil õigus kasutada ametikorterit, ametiautot ja autojuhi teenuseid.",
      "rdfs:label": {
        "@value": "VPA_Par_4 (redaktsioon 34815)",
        "@language": "et"
