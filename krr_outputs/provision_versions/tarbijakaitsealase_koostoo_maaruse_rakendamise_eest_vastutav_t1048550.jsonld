        "@language": "et"
      },
      "dc:source": "Tarbijakaitsealase koostöö määruse rakendamise eest vastutavate pädevate asutuste nimetamine"
    },
    {
      "@id": "estleg:Reg_1048550_Par_1_v1048550",
