    {
      "@id": "estleg:LENN_Par_59_1_v13203022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_59_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-07-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuvälja käitaja, kelle poolt käideldav lennuväli on avatud rahvusvaheliseks regulaarseks lennuliikluseks, samuti Tallinna lennuinfopiirkonnas lennuliikluse teenindamist tagav aeronavigatsiooniteenuse osutaja on hädaolukorra seaduse § 34 lõike 2 punktides 4 ja 5 nimetatud elutähtsa teenuse osutaja.",
      "rdfs:label": {
        "@value": "LENN_Par_59_1 (redaktsioon 13203022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13203022",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_59_1_v103032017016"
      },
      "estleg:versionValidTo": {
        "@value": "2017-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_59_1_v103032017016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_59_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuvälja käitaja, kelle käitatav lennuväli on avatud rahvusvaheliseks regulaarseks lennuliikluseks, samuti Tallinna lennuinfopiirkonnas lennuliikluse teenindamist tagav aeronavigatsiooniteenuse osutaja peab elektroonilise turvalisuse tagamiseks täitma hädaolukorra seaduse § 41 lõigetes 1 ja 2 ning § 41 lõike 3 alusel kehtestatud nõudeid.",
      "rdfs:label": {
        "@value": "LENN_Par_59_1 (redaktsioon 103032017016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103032017016",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_59_1_v122052018009"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_59_1_v122052018009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_59_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuvälja käitaja, kelle käitatav lennuväli on avatud rahvusvaheliseks regulaarseks lennuliikluseks, samuti Tallinna lennuinfopiirkonnas lennuliikluse teenindamist tagav aeronavigatsiooniteenuse osutaja peab teenuse osutamiseks kasutatava võrgu- ja infosüsteemi turvalisuse tagamiseks täitma küberturvalisuse seaduse §-dega 7 ja 8 ning nende alusel kehtestatud nõudeid.",
      "rdfs:label": {
        "@value": "LENN_Par_59_1 (redaktsioon 122052018009)",
        "@language": "et"
