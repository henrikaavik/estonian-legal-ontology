      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "LENN_Par_42_2 (redaktsioon 107032018002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032018002"
    },
    {
      "@id": "estleg:LENN_Par_42_3_v12995132",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_42_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sertifikaadi väljaandmisest, muutmisest või kehtivusaja pikendamisest keeldutakse, kui: sertifikaadi väljaandmise, muutmise või kehtivusaja pikendamise taotlemisel on esitatud tegelikkusele mittevastavaid andmeid; taotleja organisatsiooniline struktuur, talitused, rajatised, õhusõidukid, seadmed, varustus, töökorralduslikud protseduurid, käsiraamatud ja dokumendid, personali teadmised, oskused ning kogemused või kvaliteedisüsteem ei vasta kehtestatud nõuetele; taotleja ei vasta käesoleva seaduse § 422 lõikes 3 sätestatud nõuetele või taotleja rikub lennundusalaste õigusaktide nõudeid.",
      "rdfs:label": {
        "@value": "LENN_Par_42_3 (redaktsioon 12995132)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12995132",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_42_3_v107032018002"
      },
      "estleg:versionValidTo": {
        "@value": "2018-03-14",
        "@type": "xsd:date"
      }
    },
    {
