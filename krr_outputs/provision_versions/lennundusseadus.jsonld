    {
      "@id": "estleg:LENN_Par_39_v1027910",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_39"
