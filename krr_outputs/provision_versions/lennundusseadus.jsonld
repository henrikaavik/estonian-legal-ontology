      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuvälja, kopteriväljaku või aeronavigatsiooniteenuse osutaja tähistusmärkide, seadmete või rajatiste rikkumise või nende paigutamise nõuete rikkumise eest – karistatakse rahatrahviga kuni 100 trahviühikut.",
