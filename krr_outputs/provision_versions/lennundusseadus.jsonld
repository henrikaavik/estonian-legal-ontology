      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_61_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiamet tunnistab enda välja antud aeronavigatsiooniseadme sertifikaadid kehtetuks käesoleva seaduse §-de 37 ja 371 kehtetuks tunnistamisest alates.",
      "rdfs:label": {
        "@value": "LENN_Par_61_5 (redaktsioon 109042026005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109042026005"
    },
