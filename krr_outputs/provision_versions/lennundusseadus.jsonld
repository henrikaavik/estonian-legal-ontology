      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_58_v1027910",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_58"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tulenevalt Euroopa Parlamendi ja EL Nõukogu määrusest 785/2004/EÜ (ELT L 138, 30.04.2004, lk 1–6) kindlustusnõuete kohta lennuettevõtjatele ja õhusõiduki käitajatele peab õhusõiduki puhul, mille maksimaalne lubatud stardimass on 2700 kg või vähem ning mida ei käitata ärilisel eesmärgil, kindlustussumma ümberarvestatuna Rahvusvahelise Valuutafondi arvestusühikutesse SDR ühe kindlustusjuhtumi korral ühe reisija kohta olema vähemalt 100 000 SDR-i. § -d 581–583 Kehtetud –",
