      },
      "estleg:versionValidTo": {
        "@value": "2007-02-06",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_18_v12787641",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-02-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduk kantakse tsiviilõhusõidukite riiklikusse registrisse taotluse alusel, kui: õhusõiduki omanik või valdaja on Eesti kodanik või isik, kellel on pikaajalise elaniku elamisluba või alaline elamisõigus Eestis, või Eestis registreeritud juriidiline isik või kohalik omavalitsus või Eesti riik; õhusõidukil on Eestis väljaantud lennukõlblikkussertifikaat või mõne teise riigi pädeva asutuse väljaantud ja Eestis tunnustatud lennukõlblikkussertifikaat; õhusõiduki tüüp on sertifitseeritud Eestis tunnustatud lennukõlblikkusnõuete alusel või Lennuameti poolt tunnustatud. (2) Kehtetu – (3) Registrisse ei kanta õhusõidukit, mis on teise riigi registris.",
      "rdfs:label": {
        "@value": "LENN_Par_18 (redaktsioon 12787641)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12787641",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_18_v13087834"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_18_v13087834",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduk kantakse õhusõidukite registrisse taotluse alusel, kui: õhusõiduki omanik või käitaja on Eesti kodanik või isik, kellel on pikaajalise elaniku elamisluba või alaline elamisõigus Eestis, või Eestis registreeritud juriidiline isik või kohalik omavalitsus või Eesti riik; õhusõidukil on Eestis väljaantud lennuluba, lennukõlblikkussertifikaat või mõne teise riigi pädeva asutuse väljaantud ja Eestis tunnustatud lennukõlblikkussertifikaat; õhusõiduki tüüp on sertifitseeritud Eestis tunnustatud lennukõlblikkusnõuete alusel või Lennuameti poolt tunnustatud. (2) Õhusõiduk, millel puudub kehtiv lennukõlblikkussertifikaat või lennuluba, kantakse õhusõidukite registrisse ajutiselt kuni kolmeks kuuks, kuni käesoleva paragrahvi lõike 1 punktides 1–3 nimetatud nõuded on täidetud. (3) Registrisse ei kanta õhusõidukit, mis on teise riigi registris.",
      "rdfs:label": {
        "@value": "LENN_Par_18 (redaktsioon 13087834)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13087834",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_18_v110122020014"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_18_v110122020014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduk kantakse õhusõidukite registrisse taotluse alusel, kui: õhusõiduki omanik või käitaja on Eesti kodanik või isik, kellel on pikaajalise elaniku elamisluba või alaline elamisõigus Eestis, või Eestis registreeritud juriidiline isik või kohalik omavalitsus või Eesti riik; õhusõidukil on Eestis väljaantud lennuluba, lennukõlblikkussertifikaat või mõne teise riigi pädeva asutuse väljaantud ja Eestis tunnustatud lennukõlblikkussertifikaat; õhusõiduki tüüp on sertifitseeritud Eestis tunnustatud lennukõlblikkusnõuete alusel või Transpordiameti poolt tunnustatud. (2) Õhusõiduk, millel puudub kehtiv lennukõlblikkussertifikaat või lennuluba, kantakse õhusõidukite registrisse ajutiselt kuni kolmeks kuuks, kuni käesoleva paragrahvi lõike 1 punktides 1–3 nimetatud nõuded on täidetud. (3) Registrisse ei kanta õhusõidukit, mis on teise riigi registris.",
      "rdfs:label": {
        "@value": "LENN_Par_18 (redaktsioon 110122020014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020014"
    },
    {
      "@id": "estleg:LENN_Par_19_v22438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrisse kantakse teave: õhusõiduki, selle omaniku ja käitaja ning seda teavet puudutavate muutuste kohta; õhusõidukile seatud pandiõiguste kohta. (2) Registri lisasse kantakse: ehitamisel olev õhusõiduk, mis on juba identifitseeritav õhusõidukina; õhusõiduk, mida Eesti omanikule ehitatakse välismaal või mis on Eesti omanikule üle antud, juhul kui käesoleva seaduse paragrahv 18 lõike 1 punktis 1 sätestatud tingimused on täidetud; välismaal asuv õhusõiduk, mis vastab käesoleva seaduse paragrahv 18 lõike 1 punktis 1 sätestatud tingimustele ja millele Lennuamet on andnud ühekordse lennuloa. (3) Õhusõiduki käitaja on kohustatud registripidajale viivitamata teatama registrisse kantud andmete muutumisest. (4) Õhusõiduki omaniku vahetumise korral peavad sellest Lennuametile kümne päeva jooksul teatama nii õhusõiduki uus kui endine omanik. Teatele peavad olema lisatud uue omaniku omandiõigust ning vastavust käesoleva seaduse paragrahv 18 lõikes 1 esitatud nõuetele tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "LENN_Par_19 (redaktsioon 22438)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22438",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_19_v186110"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_19_v186110",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Registrisse kantakse teave: õhusõiduki, selle omaniku ja käitaja ning seda teavet puudutavate muutuste kohta; õhusõidukile seatud pandiõiguste kohta. (2) Registri lisasse kantakse: ehitamisel olev õhusõiduk, mis on juba identifitseeritav õhusõidukina; õhusõiduk, mida Eesti omanikule ehitatakse välismaal või mis on Eesti omanikule üle antud, juhul kui käesoleva seaduse § 18 lõike 1 punktis 1 sätestatud tingimused on täidetud; välismaal asuv õhusõiduk, mis vastab käesoleva seaduse § 18 lõike 1 punktis 1 sätestatud tingimustele ja millele Lennuamet on andnud ühekordse lennuloa. (3) Õhusõiduki käitaja on kohustatud registripidajale viivitamata teatama registrisse kantud andmete muutumisest. (4) Õhusõiduki omaniku vahetumise korral peavad sellest Lennuametile kümne päeva jooksul teatama nii õhusõiduki uus kui endine omanik. Teatele peavad olema lisatud uue omaniku omandiõigust ning vastavust käesoleva seaduse § 18 lõikes 1 esitatud nõuetele tõendavad dokumendid.",
      "rdfs:label": {
        "@value": "LENN_Par_19 (redaktsioon 186110)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186110",
