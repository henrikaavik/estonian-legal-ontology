      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuvälja või lennuliiklusteenistuse tähistusmärkide, seadmete või rajatiste rikkumise või nende paigutamise nõuete rikkumise eest – karistatakse rahatrahviga kuni 100 trahviühikut.",
