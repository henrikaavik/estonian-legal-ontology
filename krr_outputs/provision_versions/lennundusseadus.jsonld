      }
    },
    {
      "@id": "estleg:LENN_Par_24_4_v13321547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "LENN_Par_24_4 (redaktsioon 13321547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13321547"
    },
    {
      "@id": "estleg:LENN_Par_24_5_v13087834",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduki meeskonnaliige, kes lennuettevõtja lennutegevuse käsiraamatus on määratud lennureisi ajal osutama esma- ja meditsiiniabi, peab oskama õhusõiduki pardal anda esma- ja meditsiiniabi ning kasutada meditsiiniabivahendeid. (2) Õhusõiduki käitaja peab tagama ja korraldama esma- ja meditsiiniabi andvale õhusõiduki meeskonnaliikmele väljaõppe enne tema töökohustuste täitmisele asumist ning edaspidi tema sellekohase täiendusõppe. (3) Õhusõiduki meeskonnaliikme esmaabi- ja meditsiiniabikoolituse väljaõppe ja täiendusõppe nõuded, õppekavad ja koolitaja kvalifikatsiooninõuded kehtestab sotsiaalminister.",
      "rdfs:label": {
        "@value": "LENN_Par_24_5 (redaktsioon 13087834)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13087834",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_24_5_v129062014027"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_24_5_v129062014027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduki meeskonnaliige, kes lennuettevõtja lennutegevuse käsiraamatus on määratud lennureisi ajal osutama esma- ja meditsiiniabi, peab oskama õhusõiduki pardal anda esma- ja meditsiiniabi ning kasutada meditsiiniabivahendeid. (2) Õhusõiduki käitaja peab tagama ja korraldama esma- ja meditsiiniabi andvale õhusõiduki meeskonnaliikmele väljaõppe enne tema töökohustuste täitmisele asumist ning edaspidi tema sellekohase täiendusõppe. (3) Õhusõiduki meeskonnaliikme esmaabi- ja meditsiiniabikoolituse väljaõppe ja täiendusõppe nõuded, õppekavad ja koolitaja kvalifikatsiooninõuded kehtestab valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "LENN_Par_24_5 (redaktsioon 129062014027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014027",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_24_5_v126022015030"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_24_5_v126022015030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õhusõiduki meeskonnaliige, kes lennuettevõtja lennutegevuse käsiraamatus on määratud lennureisi ajal osutama esma- ja meditsiiniabi, peab oskama õhusõiduki pardal anda esma- ja meditsiiniabi ning kasutada meditsiiniabivahendeid. (2) Õhusõiduki käitaja peab tagama ja korraldama esma- ja meditsiiniabi andvale õhusõiduki meeskonnaliikmele väljaõppe enne tema töökohustuste täitmisele asumist ning edaspidi tema sellekohase täiendusõppe. (3) Kehtetu -",
      "rdfs:label": {
        "@value": "LENN_Par_24_5 (redaktsioon 126022015030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126022015030"
    },
    {
      "@id": "estleg:LENN_Par_24_6_v107032018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennuamet lahendab komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusmeditsiinikeskuse sertifikaadi taotluse sertifikaadi andmise või andmisest keeldumisega 90 päeva jooksul taotluse ja dokumentide esitamisest arvates. Lennuamet võib taotluse lahendamise tähtaega üks kord kuni 90 päeva võrra pikendada, kui see on vajalik üksikjuhtumi keerukuse tõttu. Kui taotlust ei vaadata läbi tähtaja jooksul, ei loeta sertifikaati tähtaja möödumisel taotlejale vaikimisi antuks. (2) Lennundusmeditsiinikeskuse sertifikaadi taotluse ja sertifikaadi muutmise taotluse läbivaatamise ning lennundusmeditsiinikeskuse sertifikaadi hoidmise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "LENN_Par_24_6 (redaktsioon 107032018002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032018002",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_24_6_v110122020014"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_24_6_v110122020014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet lahendab komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusmeditsiinikeskuse sertifikaadi taotluse sertifikaadi andmise või andmisest keeldumisega 90 päeva jooksul taotluse ja dokumentide esitamisest arvates. Transpordiamet võib taotluse lahendamise tähtaega üks kord kuni 90 päeva võrra pikendada, kui see on vajalik üksikjuhtumi keerukuse tõttu. Kui taotlust ei vaadata läbi tähtaja jooksul, ei loeta sertifikaati tähtaja möödumisel taotlejale vaikimisi antuks. (2) Lennundusmeditsiinikeskuse sertifikaadi taotluse ja sertifikaadi muutmise taotluse läbivaatamise ning lennundusmeditsiinikeskuse sertifikaadi hoidmise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "LENN_Par_24_6 (redaktsioon 110122020014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020014"
    },
    {
      "@id": "estleg:LENN_Par_24_7_v107032018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennuamet lahendab komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusarsti tunnistuse taotluse tunnistuse andmise või selle andmisest keeldumisega 90 päeva jooksul taotluse ja dokumentide esitamisest arvates. (2) Lennuamet lahendab selle lennundusarsti taotluse, kellel on komisjoni määruse (EL) nr 1178/2011 kohane lennundusarsti tunnistus ja kes soovib saada klassi 1 tervisetõendite kehtivuse pikendamiseks ja taastamiseks vajalike arstlike läbivaatuste korraldamise pädevust, tema pädevuse laiendamisega või sellest keeldumisega 30 päeva jooksul taotluse ja dokumentide esitamisest arvates. (3) Komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusarsti tunnistuse kehtivusaja pikendamiseks esitab taotleja Lennuametile taotluse vähemalt 30 päeva enne tunnistuse kehtivusaja lõppemist. (4) Lennundusarsti tunnistuse taotluse, tunnistuse kehtivusaja pikendamise taotluse, tunnistuse muutmise taotluse ning komisjoni määruse (EL) nr 1178/2011 kohase lennundusarsti tunnistust omava lennundusarsti pädevuse laiendamise taotluse läbivaatamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "LENN_Par_24_7 (redaktsioon 107032018002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107032018002",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_24_7_v110122020014"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_24_7_v110122020014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet lahendab komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusarsti tunnistuse taotluse tunnistuse andmise või selle andmisest keeldumisega 90 päeva jooksul taotluse ja dokumentide esitamisest arvates. (2) Transpordiamet lahendab selle lennundusarsti taotluse, kellel on komisjoni määruse (EL) nr 1178/2011 kohane lennundusarsti tunnistus ja kes soovib saada klassi 1 tervisetõendite kehtivuse pikendamiseks ja taastamiseks vajalike arstlike läbivaatuste korraldamise pädevust, tema pädevuse laiendamisega või sellest keeldumisega 30 päeva jooksul taotluse ja dokumentide esitamisest arvates. (3) Komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusarsti tunnistuse kehtivusaja pikendamiseks esitab taotleja Transpordiametile taotluse vähemalt 30 päeva enne tunnistuse kehtivusaja lõppemist. (4) Lennundusarsti tunnistuse taotluse, tunnistuse kehtivusaja pikendamise taotluse, tunnistuse muutmise taotluse ning komisjoni määruse (EL) nr 1178/2011 kohase lennundusarsti tunnistust omava lennundusarsti pädevuse laiendamise taotluse läbivaatamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "LENN_Par_24_7 (redaktsioon 110122020014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020014",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_24_7_v108062022010"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_24_7_v108062022010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet lahendab komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusarsti tunnistuse taotluse tunnistuse andmise või selle andmisest keeldumisega 90 päeva jooksul taotluse ja dokumentide esitamisest arvates. (2) Transpordiamet lahendab selle lennundusarsti taotluse, kellel on komisjoni määruse (EL) nr 1178/2011 kohane lennundusarsti tunnistus ja kes soovib saada 1. klassi tervisetõendite kehtivuse pikendamiseks ja taastamiseks vajalike arstlike läbivaatuste korraldamise pädevust, tema pädevuse laiendamisega või sellest keeldumisega 30 päeva jooksul taotluse ja dokumentide esitamisest arvates. (3) Komisjoni määruste (EL) nr 1178/2011 ja (EL) nr 2015/340 kohase lennundusarsti tunnistuse kehtivusaja pikendamiseks esitab taotleja Transpordiametile taotluse vähemalt 30 päeva enne tunnistuse kehtivusaja lõppemist. (4) Lennundusarsti tunnistuse taotluse, tunnistuse kehtivusaja pikendamise taotluse, tunnistuse muutmise taotluse ning komisjoni määruse (EL) nr 1178/2011 kohase lennundusarsti tunnistust omava lennundusarsti pädevuse laiendamise taotluse läbivaatamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "LENN_Par_24_7 (redaktsioon 108062022010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108062022010"
    },
    {
      "@id": "estleg:LENN_Par_24_8_v108062022010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet annab lennujuhiõpilase loa ja lennujuhi loa ning nendega seotud pädevus- ja oskusmärked välja, kui taotleja vastab komisjoni määruse (EL) 2015/340 I lisa ATCO-osas sätestatud nõuetele. (2) Transpordiamet annab välja, pikendab ning taastab üksuse oskusmärke, kui taotleja vastab komisjoni määruse (EL) 2015/340 I lisa ATCO-osas sätestatud nõuetele. (3) Transpordiamet annab keeleoskusmärke välja, kui taotleja vastab komisjoni määruse (EL) 2015/340 I lisa ATCO-osas sätestatud nõuetele, ning pikendab või taastab selle, kui on täidetud komisjoni määruse (EL) 2015/340 ATCO-osas sätestatud nõuded. (4) Transpordiamet annab lennuinformaatori loa ning sellega seotud pädevus- ja oskusmärked välja, kui lennuinformaatori loa taotleja: on vähemalt 18-aastane; on läbinud Transpordiameti heakskiidetud või aktsepteeritud lennuinformaatori koolituskursuse ning teadmiste ja oskuste kontrolli; on läbinud taotluse esitamisele eelneva kuue kuu jooksul vähemalt kahekuulise töökohakoolituse üksuses, kus töötamiseks ta lennuinfo teenuse osutamise pädevust vajab; omab komisjoni määruse (EL) 2015/340 kohast kehtivat 3. klassi tervisetõendit; oskab eesti keelt käesoleva seaduse § 233 lõike 1 kohaselt C1-tasemele vastavalt ja inglise keelt komisjoni määruses (EL) 2015/340 sätestatud nõuetele vastavalt; omab lennunduse raadioside luba raadioside pidamiseks eesti ja inglise keeles. (5) Käesoleva paragrahvi lõike 4 punktis 3 nimetatud töökohakoolitus tuleb läbida sellise lennuinformaatori või lennujuhi juhendamisel, kellel on vähemalt kaheaastane tööpraktika ja kehtiv üksuse oskusmärge. (6) Transpordiamet teeb otsuse lennujuhiõpilase, lennujuhi ja lennuinformaatori loa, nendega seotud pädevus- ja oskusmärke, üksuse oskusmärke või keeleoskusmärke andmise, pikendamise või sellest keeldumise kohta 14 päeva jooksul nõuetekohase taotluse esitamisest arvates.",
      "rdfs:label": {
        "@value": "LENN_Par_24_8 (redaktsioon 108062022010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108062022010"
    },
    {
      "@id": "estleg:LENN_Par_24_9_v108062022010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet annab lennujuhtide töökohakoolituse juhendaja, treeningseadme instruktori ning tasemetestija oskusmärke välja või pikendab või uuendab seda, kui selle taotleja vastab komisjoni määruse (EL) 2015/340 ATCO-osas sätestatud nõuetele. (2) Transpordiamet teeb otsuse lennujuhtide töökohakoolituse juhendaja, treeningseadme instruktori või tasemetestija oskusmärke väljaandmise, pikendamise või uuendamise kohta või selle väljaandmisest, pikendamisest või uuendamisest keeldumise kohta 14 päeva jooksul nõuetekohase taotluse esitamisest arvates. (3) Kui taotleja ei ole Transpordiameti määratud tähtaja jooksul kõrvaldanud käesoleva paragrahvi lõikes 2 nimetatud taotluses esinevaid puudusi või esitanud lisaandmeid, lõpetatakse taotluse läbivaatamise menetlus vastava oskusmärke väljaandmisest, pikendamisest või uuendamisest keeldumise otsusega.",
      "rdfs:label": {
        "@value": "LENN_Par_24_9 (redaktsioon 108062022010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108062022010"
    },
    {
      "@id": "estleg:LENN_Par_25_v22438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennundusluba või kehtivustõend tunnistatakse kehtetuks või selle kehtivus peatatakse, kui selle omanik: on rikkunud lennuohutuse nõudeid, sealhulgas juhtinud õhusõidukit või täitnud ametiülesandeid alkoholi, narkootikumide, psühhotroopsete, psühhotoksiliste või teiste lennuohutust mõjutada võivate ainete mõju all, käitanud õhusõidukit haigena, väsinuna või muul põhjusel seisundis, kui isik ei saa täita oma ülesandeid ohutul viisil; on rikkunud lennundusalaste õigusaktide sätteid; on tunnistatud tervislikel põhjustel sobimatuks täitma oma ülesandeid; on tunnistatud eksamite või kontroll-lendude alusel oma teadmiste või oskuste poolest mittevastavaks lennundusloas või kehtivustõendis märgitud tegevusele. (2) Lennuamet võib ametkondliku uurimise ajaks peatada lennundusloa või kehtivustõendi kehtivuse uurimise lõpuni.",
      "rdfs:label": {
        "@value": "LENN_Par_25 (redaktsioon 22438)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22438",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_25_v905511"
      },
      "estleg:versionValidTo": {
        "@value": "2005-05-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_25_v905511",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennundusloa või kehtivustõendiga antud õigused tunnistatakse kehtetuks või nimetatud õiguste kehtivus peatatakse, kui selle omanik: on rikkunud lennuohutuse nõudeid, sealhulgas juhtinud õhusõidukit või täitnud ametiülesandeid alkoholi, narkootikumide, psühhotroopsete või teiste lennuohutust mõjutada võivate ainete mõju all, käitanud õhusõidukit haigena, väsinuna või muul põhjusel seisundis, kui isik ei saa täita oma ülesandeid ohutul viisil; on rikkunud lennundusalaste õigusaktide sätteid; on tunnistatud tervislikel põhjustel sobimatuks täitma oma ülesandeid; on tunnistatud eksamite või kontroll-lendude alusel oma teadmiste või oskuste poolest mittevastavaks lennundusloas või kehtivustõendis märgitud tegevusele. (2) Lennuamet võib ametkondliku uurimise ajaks peatada lennundusloa või kehtivustõendiga antud õigused uurimise lõpuni. (3) Lennuamet võib peatada lennundusloaga antud õiguste kehtivuse kuni 12 kuuks, kui isik on toime pannud käesoleva seaduse §-s 60 6, 6011, 6012, 6014, 6016, 60 20, 6021, 6023, 6027, 6028 või 6029 sätestatud väärteo.",
      "rdfs:label": {
        "@value": "LENN_Par_25 (redaktsioon 905511)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "905511",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_25_v1027910"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_25_v1027910",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennundusloa või kehtivustõendiga antud õigused tunnistatakse kehtetuks või nimetatud õiguste kehtivus peatatakse, kui selle omanik: on rikkunud lennuohutuse nõudeid, sealhulgas juhtinud õhusõidukit või täitnud ametiülesandeid alkoholi, narkootikumide, psühhotroopsete või teiste lennuohutust mõjutada võivate ainete mõju all, käitanud õhusõidukit haigena, väsinuna või muul põhjusel seisundis, kui isik ei saa täita oma ülesandeid ohutul viisil; on rikkunud lennundusalaste õigusaktide sätteid; on tunnistatud tervislikel põhjustel sobimatuks täitma oma ülesandeid; on tunnistatud eksamite või kontroll-lendude alusel oma teadmiste või oskuste poolest mittevastavaks lennundusloas või kehtivustõendis märgitud tegevusele. (2) Lennuamet võib ametkondliku uurimise ajaks peatada lennundusloa või kehtivustõendiga antud õigused uurimise lõpuni. (3) Lennuamet võib peatada lennundusloaga antud õiguste kehtivuse kuni 12 kuuks, kui isik on toime pannud käesoleva seaduse § -s 60 6, 6011, 6012, 6014, 6016, 60 20, 6021, 6023, 6027, 6028 või 6029 sätestatud väärteo.",
      "rdfs:label": {
        "@value": "LENN_Par_25 (redaktsioon 1027910)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027910",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_25_v1036357"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_25_v1036357",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
