      },
      "estleg:versionValidTo": {
        "@value": "2003-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_38_v681568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuettevõtja käesoleva seaduse tähenduses on füüsiline isik, juriidiline isik või asutus, kes omab kehtivat lennutegevusluba.",
      "rdfs:label": {
