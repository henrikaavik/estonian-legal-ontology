    {
      "@id": "estleg:LENN_Par_54_v22438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohtlike ainete vedu tsiviilõhusõidukitega toimub Lennuameti kirjaliku loa alusel 1944. aasta Chicago rahvusvahelise tsiviillennunduse konventsiooni nõuete kohaselt.",
