    {
      "@id": "estleg:LENN_Par_60_40_v13255371",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_60_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennuvälja või kopteriväljaku julgestuspiirangualale või lennujaama kinnise ala muudele osadele selleks volitusi omamata sisenemise või selle võimaldamise eest –karistatakse rahatrahviga kuni 150 trahviühikut. (2) Sama teo eest, kui see pannakse toime ettenähtud läbipääsu läbimata, –karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "LENN_Par_60_40 (redaktsioon 13255371)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13255371"
    },
    {
      "@id": "estleg:LENN_Par_60_41_v13255371",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_60_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuameti poolt läbivaatuse teostajana tunnustamata isiku julgestusalast läbivaatust teostama lubamise eest –karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "LENN_Par_60_41 (redaktsioon 13255371)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13255371",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_60_41_v126022015030"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_60_41_v126022015030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_60_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuameti poolt julgestusmeetmete kohaldajana tunnustamata isiku julgestusmeetmeid kohaldama lubamise eest –karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "LENN_Par_60_41 (redaktsioon 126022015030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126022015030",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_60_41_v110122020014"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_60_41_v110122020014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_60_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Transpordiameti poolt julgestusmeetmete kohaldajana tunnustamata isiku julgestusmeetmeid kohaldama lubamise eest –karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "LENN_Par_60_41 (redaktsioon 110122020014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020014"
    },
    {
      "@id": "estleg:LENN_Par_60_42_v13255371",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_60_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tsiviilkäibes keelatud relva, külmrelva, gaasirelva, tulirelva, tulirelva olulise osa või mulaaži, laskemoona või lõhkeseadeldise, lõhkeseadeldise olulise osa või mulaaži lennuvälja või kopteriväljaku julgestuspiirangualale viimise või viimise katse eest selleks volitusi omamata –karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "LENN_Par_60_42 (redaktsioon 13255371)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13255371"
    },
