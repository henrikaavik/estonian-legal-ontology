      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõidukit, mille käitamine on keelatud tehnilise rikke tõttu, juhtima lubamise eest sõiduki omaniku, valdaja, tehnoseisundi või käitamise eest vastutava isiku poolt – karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
