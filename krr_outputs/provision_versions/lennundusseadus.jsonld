    {
      "@id": "estleg:LENN_Par_24_4_v905511",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_24_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuamet on pädev asutus (competent authority) Euroopa Komisjoni määruse 2042/2003/EÜ (ELT L 315, 20.11.2003, lk 1–165), millega kehtestatakse nõuded õhusõidukite ja lennundustoodete ning nende osade ja seadmete jätkuva lennukõlblikkuse ning sellega tegelevate organisatsioonide ja isikute sertifitseerimise kohta, IV lisa (Osa 147) jaotise 147.1 punkti 1 kohaselt lennundustehniliste töötajate koolitusorganisatsiooni koolituse ja eksamite korraldamise sertifitseerimisel.",
      "rdfs:label": {
