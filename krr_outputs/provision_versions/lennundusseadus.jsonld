      },
      "estleg:versionValidTo": {
        "@value": "2018-03-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_42_8_v107032018002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
