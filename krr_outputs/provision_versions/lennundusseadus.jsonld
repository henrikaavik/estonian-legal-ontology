    },
    {
      "@id": "estleg:LENN_Par_44_v22438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennutegevusluba ja lennuettevõtja sertifikaati omav ettevõtja on kohustatud Lennuametile viivitamata kirjalikult teatama kõigist muutustest andmetes, mis olid aluseks tegevusloa ja sertifikaadi väljaandmisel.",
      "rdfs:label": {
        "@value": "LENN_Par_44 (redaktsioon 22438)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22438",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_44_v13087834"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-21",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_44_v13087834",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennutegevusluba ja lennuettevõtja sertifikaati omav isik on kohustatud Lennuametile viivitamata kirjalikult teatama kõigist muutustest andmetes, mis olid aluseks tegevusloa ja sertifikaadi väljaandmisel. (2) Lennuohutuse tagamise huvides võib Lennuamet muuta sertifikaati või selle käitamistingimusi, kui käitaja või tema tegevus ei vasta käesoleva seaduse § 424 lõikes 1 nimetatud nõuetele. Sertifikaadi muutmisest teavitatakse kirjalikult viivitamata sertifikaati omavat isikut.",
      "rdfs:label": {
        "@value": "LENN_Par_44 (redaktsioon 13087834)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13087834",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_44_v126022015030"
      },
      "estleg:versionValidTo": {
        "@value": "2015-02-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_44_v126022015030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_44"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lennuettevõtja sertifikaati omav isik on kohustatud Lennuametile viivitamata kirjalikult teatama kõigist muutustest andmetes, mis olid aluseks sertifikaadi väljaandmisel. (2) Lennuohutuse tagamise huvides võib Lennuamet muuta sertifikaati või selle käitamistingimusi, kui käitaja või tema tegevus ei vasta käesoleva seaduse § 424 lõikes 1 nimetatud nõuetele. Sertifikaadi muutmisest teavitatakse kirjalikult viivitamata sertifikaati omavat isikut.",
      "rdfs:label": {
