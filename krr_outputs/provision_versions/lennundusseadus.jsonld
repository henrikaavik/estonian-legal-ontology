      }
    },
    {
      "@id": "estleg:LENN_Par_54_3_v129062014027",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_54_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi relvastatud pardasaatjal ei ole lubatud kanda ametirelva ja laskemoona väljaspool õhusõidukit, välja arvatud juhul, kui teda saadab pädeva asutuse esindaja. (2) Välisriigi relvastatud pardasaatja ametirelva ja selle laskemoona hoiulevõtmist, hoidmist ja tagastamist korraldab Politsei- ja Piirivalveamet. (3) Välisriigi relvastatud pardasaatja ametirelva ja selle laskemoona hoiuleandmise ja tagastamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LENN_Par_54_3 (redaktsioon 129062014027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014027"
    },
    {
      "@id": "estleg:LENN_Par_55_v22438",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keelatud on: õhusõiduki start, kui õhusõiduk ei ole lennukõlblik või nõuetekohaselt mehitatud, varustatud ja lastitud või ilmnevad muud õhusõiduki käitamist takistavad asjaolud, välja arvatud käesoleva seaduse paragrahv 14 lõikes 4 nimetatud juhtudel; kasutada tsiviilõhusõidukit Eesti Vabariigi õigusaktidega keelatud esemete või ainete vedamiseks; õhusõiduki käitamine alkoholi, narkootikumide, psühhotroopsete, psühhotoksiliste või teiste lennuohutust mõjutada võivate ainete mõju all; õhusõiduki käitamine haigena, väsinuna või muul põhjusel seisundis, kui isik ei saa täita oma ülesandeid ohutul viisil. (2) Lennuvälja käitajal või tema poolt kirjalikult volitatud isikul on õigus keelduda õhusõiduki teenindamisest, kui kehtestatud maksed, mis on seotud õhusõiduki viimase maandumisega lennuväljale, viibimisega seal või lahkumisega sealt, ei ole tasutud või ei ole esitatud tagatist nende tasumise kohta. (3) Lennuliikluse juhtimise teenuse osutajal on õigus keelduda õhusõiduki teenindamisest, mille käitaja ei ole tasunud varasema lennuliikluse juhtimise teenuse eest, kui sellega ei seata ohtu inimeste elu ja tervist ega tekitata kahju keskkonnale ega kolmandatele isikutele.",
      "rdfs:label": {
        "@value": "LENN_Par_55 (redaktsioon 22438)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22438",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_55_v186110"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_55_v186110",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keelatud on: õhusõiduki start, kui õhusõiduk ei ole lennukõlblik või nõuetekohaselt mehitatud, varustatud ja lastitud või ilmnevad muud õhusõiduki käitamist takistavad asjaolud, välja arvatud käesoleva seaduse § 14 lõikes 4 nimetatud juhtudel; kasutada tsiviilõhusõidukit Eesti Vabariigi õigusaktidega keelatud esemete või ainete vedamiseks; õhusõiduki käitamine alkoholi, narkootikumide, psühhotroopsete, psühhotoksiliste või teiste lennuohutust mõjutada võivate ainete mõju all; õhusõiduki käitamine haigena, väsinuna või muul põhjusel seisundis, kui isik ei saa täita oma ülesandeid ohutul viisil. (2) Lennuvälja käitajal või tema poolt kirjalikult volitatud isikul on õigus keelduda õhusõiduki teenindamisest, kui kehtestatud maksed, mis on seotud õhusõiduki viimase maandumisega lennuväljale, viibimisega seal või lahkumisega sealt, ei ole tasutud või ei ole esitatud tagatist nende tasumise kohta. (3) Lennuliikluse juhtimise teenuse osutajal on õigus keelduda õhusõiduki teenindamisest, mille käitaja ei ole tasunud varasema lennuliikluse juhtimise teenuse eest, kui sellega ei seata ohtu inimeste elu ja tervist ega tekitata kahju keskkonnale ega kolmandatele isikutele.",
      "rdfs:label": {
        "@value": "LENN_Par_55 (redaktsioon 186110)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186110",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_55_v194114"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:LENN_Par_55_v194114",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keelatud on: õhusõiduki start, kui õhusõiduk ei ole lennukõlblik või nõuetekohaselt mehitatud, varustatud ja lastitud või ilmnevad muud õhusõiduki käitamist takistavad asjaolud, välja arvatud käesoleva seaduse § 14 lõikes 4 nimetatud juhtudel; kasutada tsiviilõhusõidukit Eesti Vabariigi õigusaktidega keelatud esemete või ainete vedamiseks; õhusõiduki käitamine alkoholi, narkootikumide, psühhotroopsete, psühhotoksiliste või teiste lennuohutust mõjutada võivate ainete mõju all; õhusõiduki käitamine haigena, väsinuna või muul põhjusel seisundis, kui isik ei saa täita oma ülesandeid ohutul viisil. (2) Lennuvälja käitajal või tema poolt kirjalikult volitatud isikul on õigus keelduda õhusõiduki teenindamisest, kui kehtestatud maksed, mis on seotud õhusõiduki viimase maandumisega lennuväljale, viibimisega seal või lahkumisega sealt, ei ole tasutud või ei ole esitatud tagatist nende tasumise kohta. (3) Lennuliikluse juhtimise teenuse osutajal on õigus keelduda õhusõiduki teenindamisest, mille käitaja ei ole tasunud varasema lennuliikluse juhtimise teenuse eest, kui sellega ei seata ohtu inimeste elu ja tervist ega tekitata kahju keskkonnale ega kolmandatele isikutele. (4) Kui isik käitab õhusõidukit käesoleva paragrahvi lõike 1 punktis 3 keelatud viisil, siis suunatakse ta läbivaatusele joobeseisundi tuvastamiseks liiklusseaduse (RT I 2001, 3, 6; 93, 565; 2002, 38, 234) § 201 lõikes 2 sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "LENN_Par_55 (redaktsioon 194114)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194114",
      "estleg:supersededByVersion": {
        "@id": "estleg:LENN_Par_55_v170160"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
