    {
      "@id": "estleg:LENN_Par_60_20_v13321547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LENN_Par_60_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õhusõiduki juhtimise või lennuliikluse teenindamise eest joobeseisundis isiku poolt –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
