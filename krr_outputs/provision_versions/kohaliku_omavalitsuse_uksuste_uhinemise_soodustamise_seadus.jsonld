      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kehtetu - (4) Kehtetu -",
      "rdfs:label": {
        "@value": "KOUS_Par_7 (redaktsioon 113032014043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014043",
