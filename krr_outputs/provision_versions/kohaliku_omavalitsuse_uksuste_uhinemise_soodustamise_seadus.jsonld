      "estleg:provisionRef": "KOUS § 6",
      "estleg:partOfAct": {
        "@id": "estleg:KOUS_Map"
      }
    },
    {
      "@id": "estleg:KOUS_Par_6_v13085477",
      "@type": [
        "owl:NamedIndividual",
