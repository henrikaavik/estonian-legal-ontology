    {
      "@id": "estleg:Reg_329419_Par_4_v329419",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_329419_Par_4"
