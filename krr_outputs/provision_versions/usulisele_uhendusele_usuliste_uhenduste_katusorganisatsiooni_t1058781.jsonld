      }
    },
    {
      "@id": "estleg:Reg_1058781_Par_2_v1058781",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058781_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andja on Siseministeerium. Toetuse andja on Siseministeerium.",
      "rdfs:label": {
        "@value": "Reg_1058781_Par_2 (redaktsioon 1058781)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058781",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058781",
      "estleg:sourceAct": "Usulisele ühendusele usuliste ühenduste katusorganisatsioonile ja riiklikult akrediteeritud konfessionaalsele kõrgkoolile toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1058781 § 2",
