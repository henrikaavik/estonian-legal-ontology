      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse saaja esitab toetuse andjale taotluse rahuldamise otsuses määratud tähtajaks toetuse kasutamise lõpparuande. RT I 2026-04-16 1 116042026001 2026-04-19 Toetuse saaja esitab toetuse andjale taotluse rahuldamise otsuses määratud tähtajaks toetuse kasutamise lõpparuande.",
      "rdfs:label": {
        "@value": "Reg_1058781_Par_17 (redaktsioon 1058781)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058781",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058781",
      "estleg:sourceAct": "Usulisele ühendusele usuliste ühenduste katusorganisatsioonile ja riiklikult akrediteeritud konfessionaalsele kõrgkoolile toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1058781 § 17",
