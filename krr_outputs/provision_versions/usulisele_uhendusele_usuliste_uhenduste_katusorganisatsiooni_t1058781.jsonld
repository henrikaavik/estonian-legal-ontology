      "estleg:provisionRef": "Reg_1058781 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058781_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058781_Par_4_v1058781",
