    {
      "@id": "estleg:Reg_1037880_Par_18_v1037880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037880_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 20. veebruari 2015. a käskkirjaga nr 181 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 20. veebruari 2015. a käskkirjaga nr 181 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1037880_Par_18 (redaktsioon 1037880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037880",
