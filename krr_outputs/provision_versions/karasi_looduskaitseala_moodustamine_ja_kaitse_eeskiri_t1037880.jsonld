      }
    },
    {
      "@id": "estleg:Reg_1037880_Par_19_v1037880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037880_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1037880_Par_19 (redaktsioon 1037880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037880",
      "estleg:sourceAct": "Kärasi looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1037880 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1037880_Par_2_v1037880",
