        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine ning kaitsealuste liikide kaitse. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine ning kaitsealuste liikide kaitse.",
      "rdfs:label": {
        "@value": "Reg_1037880_Par_13 (redaktsioon 1037880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037880",
      "estleg:sourceAct": "Kärasi looduskaitseala moodustamine ja kaitse-eeskiri",
