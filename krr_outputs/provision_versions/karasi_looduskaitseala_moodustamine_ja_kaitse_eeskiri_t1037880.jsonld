      }
    },
    {
      "@id": "estleg:Reg_1037880_Par_12_v1037880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037880_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on kaks piiranguvööndit: 1 1) Kärasi piiranguvöönd; 2 2) Vadi piiranguvöönd. Kaitsealal on kaks piiranguvööndit: Kärasi piiranguvöönd; Vadi piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1037880_Par_12 (redaktsioon 1037880)",
        "@language": "et"
      },
