      }
    },
    {
      "@id": "estleg:Reg_1037880_Par_3_v1037880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037880_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1037880_Par_3 (redaktsioon 1037880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037880",
      "estleg:sourceAct": "Kärasi looduskaitseala moodustamine ja kaitse-eeskiri",
