      },
      "estleg:versionText": "Pärandvarasse kuuluvale varale seatud kommertspant ei lõpe füüsilisest isikust ettevõtja surma korral.",
      "rdfs:label": {
        "@value": "KomPS_Par_8 (redaktsioon 22357)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22357",
