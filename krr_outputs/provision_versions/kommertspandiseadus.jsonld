      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kande parandamisel märgitakse ebaõige kanne kehtetuks ja tehakse õige kanne. (2) Uues kandes märgitakse, et see asendab eelmist. (3) Kande parandamine muul viisil on keelatud.",
      "rdfs:label": {
        "@value": "KomPS_Par_26 (redaktsioon 118122012017)",
        "@language": "et"
      },
