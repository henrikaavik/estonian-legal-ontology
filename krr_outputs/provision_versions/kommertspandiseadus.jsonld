      }
    },
    {
      "@id": "estleg:KomPS_Par_6_v118122012017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KomPS_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kommertspandiga koormatud vara, mis moodustab ettevõtte või käitise, üleminekul jääb kommertspant sellele püsima.",
      "rdfs:label": {
        "@value": "KomPS_Par_6 (redaktsioon 118122012017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118122012017",
