    {
      "@id": "estleg:Reg_310426_Par_4_v310426",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_310426_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala maa- ja veeala seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala maa- ja veeala seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on kaks sihtkaitsevööndit: 1 1) Ulli sihtkaitsevöönd; 2 2) Kõveri sihtkaitsevöönd. Kaitsealal on kaks sihtkaitsevööndit: Ulli sihtkaitsevöönd; Kõveri sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_310426_Par_4 (redaktsioon 310426)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "310426",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/310426",
      "estleg:sourceAct": "Tolkuse looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_310426 § 4",
      "estleg:partOfAct": {
