      },
      "dc:source": "Meditsiini- ja taimekaitsetoodete täiendava kaitse tunnistuse vormi ja väljaandmise kord"
    },
    {
      "@id": "estleg:Reg_1002202_Par_1_v1002202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1002202_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruses kasutatakse järgmisi mõisteid ja mõistete lühendeid: 1 1) „täiendav kaitse” on meditsiinitoote või taimekaitsetoote täiendav õiguskaitse; 2 2) „tunnistus” on meditsiinitoote või taimekaitsetoote täiendava kaitse tunnistus; 3 3) „täiendava kaitse taotlus” on meditsiinitootele või taimekaitsetootele täiendava õiguskaitse saamiseks esitatav taotlus; 4 4) „täiendava kaitse saanud isik” on isik, kelle nimi on täiendava kaitse andmise teates ja kellele on väljastatud tunnistus. Tunnistus väljastatakse aluspatendi omanikule. Määruses kasutatakse järgmisi mõisteid ja mõistete lühendeid: „täiendav kaitse” on meditsiinitoote või taimekaitsetoote täiendav õiguskaitse; „tunnistus” on meditsiinitoote või taimekaitsetoote täiendava kaitse tunnistus; „täiendava kaitse taotlus” on meditsiinitootele või taimekaitsetootele täiendava õiguskaitse saamiseks esitatav taotlus; „täiendava kaitse saanud isik” on isik, kelle nimi on täiendava kaitse andmise teates ja kellele on väljastatud tunnistus. Tunnistus väljastatakse aluspatendi omanikule.",
      "rdfs:label": {
        "@value": "Reg_1002202_Par_1 (redaktsioon 1002202)",
        "@language": "et"
      },
