      },
      "estleg:versionValidFrom": {
        "@value": "2023-09-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Patendiamet kontrollib registreeringu kehtivust, vormistab tunnistuse vastavalt määruse 2. peatükile ning kannab tunnistuse paremasse ülaossa sõna „DUPLIKAAT” ja duplikaadi väljaandmise kuupäeva. RT I 2023-09-08 1 108092023001 2023-09-11 Patendiamet kontrollib registreeringu kehtivust, vormistab tunnistuse vastavalt määruse 2. peatükile ning kannab tunnistuse paremasse ülaossa sõna „DUPLIKAAT” ja duplikaadi väljaandmise kuupäeva.",
      "rdfs:label": {
        "@value": "Reg_1002202_Par_10 (redaktsioon 1002202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002202",
