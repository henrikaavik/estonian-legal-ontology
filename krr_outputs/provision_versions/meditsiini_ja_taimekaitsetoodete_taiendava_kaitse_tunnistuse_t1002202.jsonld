      },
      "estleg:versionText": "Tunnistus koosneb tunnistuse lehest ja andmelehest. RT I 2023-09-08 1 108092023001 2023-09-11 Tunnistus koosneb tunnistuse lehest ja andmelehest.",
      "rdfs:label": {
        "@value": "Reg_1002202_Par_2 (redaktsioon 1002202)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1002202",
