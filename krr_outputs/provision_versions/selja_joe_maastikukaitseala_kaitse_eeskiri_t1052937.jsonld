    },
    {
      "@id": "estleg:Reg_1052937_Par_14_v1052937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052937_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on Selja jõe oru, ajaloolise maakasutuse, piirkonnale iseloomuliku asustusstruktuuri, metsa- ja poollooduslike koosluste, nõukogu direktiivi 92/43/EMÜ I lisas nimetatud elupaigatüübi laialehiste lammimetsade (91F0) ning kaitsealuste liikide kaitse. Piiranguvööndi kaitse-eesmärk on Selja jõe oru, ajaloolise maakasutuse, piirkonnale iseloomuliku asustusstruktuuri, metsa- ja poollooduslike koosluste, nõukogu direktiivi 92/43/EMÜ I lisas nimetatud elupaigatüübi laialehiste lammimetsade (91F0) ning kaitsealuste liikide kaitse.",
      "rdfs:label": {
        "@value": "Reg_1052937_Par_14 (redaktsioon 1052937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052937",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052937",
      "estleg:sourceAct": "Selja jõe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052937 § 14",
      "estleg:partOfAct": {
