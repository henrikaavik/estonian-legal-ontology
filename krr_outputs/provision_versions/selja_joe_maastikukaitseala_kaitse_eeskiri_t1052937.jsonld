      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 31. oktoobri 2019. a käskkirjaga nr 1-2/19/705 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 31. oktoobri 2019. a käskkirjaga nr 1-2/19/705 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1052937_Par_20 (redaktsioon 1052937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052937",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052937",
      "estleg:sourceAct": "Selja jõe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052937 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052937_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052937_Par_21_v1052937",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052937_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1052937_Par_21 (redaktsioon 1052937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052937",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052937",
      "estleg:sourceAct": "Selja jõe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1052937 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052937_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052937_Par_3_v1052937",
