      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1052937_Par_3 (redaktsioon 1052937)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052937",
