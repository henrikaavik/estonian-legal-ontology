      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_v695566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäämurdetööde korra kehtestab majandus- ja kommunikatsiooniminister. (2) Käesoleva paragrahvi lõikes 1 nimetatud korda kohaldatakse ka välisriigi lippu kandvale laevale.",
      "rdfs:label": {
        "@value": "MSOS_Par_50 (redaktsioon 695566)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "695566",
