      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Siseveeteedel laevade ja väikelaevade ning muude veesõidukite sulengutes, reididel või sadamates liiklemise, seismise või mitme aluse või parve pukseerimise nõuete, laevade laadimise, lossimise või veoste ladustamise korra rikkumise, samuti sadama- või hüdrotehniliste rajatiste, seadeldiste või seadmete kahjustamise eest – karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "MSOS_Par_83 (redaktsioon 908666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908666",
