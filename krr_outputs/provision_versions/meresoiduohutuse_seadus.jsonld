      }
    },
    {
      "@id": "estleg:MSOS_Par_56_v117032023048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lootsiteenust osutab riigi poolt moodustatud äriühing. (2) Sadama akvatooriumil võib lootsiteenust osutada sadama pidaja laeva ümberhaalamiseks või dokkimiseks. (3) Laevaagent ja sadamakapten on kohustatud teavitama laeva kaptenit lootsi tellimise vajalikkusest kohustuslikus lootsimise alas.",
      "rdfs:label": {
        "@value": "MSOS_Par_56 (redaktsioon 117032023048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023048",
