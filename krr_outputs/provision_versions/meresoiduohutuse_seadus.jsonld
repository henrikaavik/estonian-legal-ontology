    },
    {
      "@id": "estleg:MSOS_Par_50_5_v738238",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tuletornitasu ja navigatsioonitasu makstakse järgmistes määrades:",
      "rdfs:label": {
        "@value": "MSOS_Par_50_5 (redaktsioon 738238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738238",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_50_5_v130052013010"
      },
      "estleg:versionValidTo": {
        "@value": "2013-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_5_v130052013010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veeteetasu arvestatakse laeva kogumahutavuse (GT) järgi, korrutades laeva kogumahutavuse ühikuhinnaga. (2) Merematkelaeva ühikuhind on 0,1 eurot. (3) Muu laeva ühikuhind on vastavalt laeva jääklassile järgmine: 1A Super või sellele vastav jääklass – 0,28 eurot; 1A või sellele vastav jääklass – 0,30 eurot; muu jääklass või ilma jääklassita – 0,35 eurot. (4) Veeteetasu maksimaalne suurus ühe reisi kohta on tankeril 20 000 eurot, merematkelaeval 10 000 eurot ja muudel laevadel 15 000 eurot.",
      "rdfs:label": {
        "@value": "MSOS_Par_50_5 (redaktsioon 130052013010)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130052013010",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_50_5_v122122013031"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_5_v122122013031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veeteetasu arvestatakse laeva kogumahutavuse (GT) järgi, korrutades laeva kogumahutavuse ühikuhinnaga. (2) Merematkelaeva ühikuhind on 0,12 eurot. (3) Muu laeva ühikuhind on vastavalt laeva jääklassile järgmine: 1A Super või sellele vastav jääklass – 0,28 eurot; 1A või sellele vastav jääklass – 0,30 eurot; muu jääklass või ilma jääklassita – 0,35 eurot. (4) Veeteetasu maksimaalne suurus ühe reisi kohta on tankeril 20 000 eurot, merematkelaeval 12 000 eurot ja muudel laevadel 15 000 eurot.",
      "rdfs:label": {
        "@value": "MSOS_Par_50_5 (redaktsioon 122122013031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122013031",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_50_5_v131052021007"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_5_v131052021007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veeteetasu arvestatakse laeva kogumahutavuse (GT) järgi, korrutades laeva kogumahutavuse ühikuhinnaga. Pukseerimise puhul lähtutakse kogumahutavuse arvestamisel puksiirkoosseisu kuuluva vedurlaeva ja pukseeritavate veesõidukite kogumahutavuste summast. (2) Merematkelaeva ühikuhind on 0,12 eurot. (3) Muu laeva ühikuhind on vastavalt laeva jääklassile järgmine: 1A Super või sellele vastav jääklass – 0,28 eurot; 1A või sellele vastav jääklass – 0,30 eurot; muu jääklass või ilma jääklassita – 0,35 eurot. (4) Veeteetasu maksimaalne suurus ühe reisi kohta on tankeril 20 000 eurot, merematkelaeval 12 000 eurot ja muudel laevadel 15 000 eurot.",
      "rdfs:label": {
        "@value": "MSOS_Par_50_5 (redaktsioon 131052021007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131052021007"
    },
    {
      "@id": "estleg:MSOS_Par_50_6_v738238",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reeder või laevaagent on makseteatise alusel kohustatud kandma tuletornitasu ja navigatsioonitasu üle Veeteede Ameti pangakontole makseteatises märgitud tähtpäevaks. (2) Veeteede Amet esitab reederile või laevaagendile saldoteatise tasu laekumise kohta üks kord kvartalis.",
      "rdfs:label": {
        "@value": "MSOS_Par_50_6 (redaktsioon 738238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738238",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_50_6_v908666"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_6_v908666",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reeder või laevaagent on kohustatud kandma tuletornitasu ja navigatsioonitasu arvel näidatud pangakontole hiljemalt arvel märgitud tähtpäevaks. (2) Veeteede Amet esitab reederile või laevaagendile tema nõudmisel saldoteatise tasu laekumise kohta.",
      "rdfs:label": {
        "@value": "MSOS_Par_50_6 (redaktsioon 908666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908666",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_50_6_v13063170"
      },
      "estleg:versionValidTo": {
        "@value": "2008-11-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_6_v13063170",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_50_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Reeder või laevaagent on kohustatud kandma tuletornitasu ja navigatsioonitasu makseteatisel näidatud pangakontole hiljemalt makseteatisel märgitud tähtpäevaks. (2) Veeteede Amet esitab reederile või laevaagendile tema nõudmisel saldoteatise tasu laekumise kohta.",
      "rdfs:label": {
        "@value": "MSOS_Par_50_6 (redaktsioon 13063170)",
