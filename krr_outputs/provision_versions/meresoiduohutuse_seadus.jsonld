      }
    },
    {
      "@id": "estleg:MSOS_Par_56_v131122010063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_56"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lootsiteenust osutab riigi poolt moodustatud äriühing. (2) Sadama akvatooriumil võib lootsiteenust osutada sadama pidaja laeva ümberhaalamiseks või dokkimiseks. (3) Laevaagent ja sadamakapten on kohustatud teavitama laeva kaptenit lootsi tellimise vajalikkusest kohustuslikus lootsimise piirkonnas.",
      "rdfs:label": {
        "@value": "MSOS_Par_56 (redaktsioon 131122010063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010063",
