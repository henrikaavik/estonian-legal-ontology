        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Enne väikelaeva kasutamist on selle juht kohustatud tutvuma sõidupiirkonna navigatsioonitingimuste ja ilmateatega.",
      "rdfs:label": {
        "@value": "MSOS_Par_37 (redaktsioon 958194)",
