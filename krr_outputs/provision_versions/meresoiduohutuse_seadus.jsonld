      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäämurdetööde korra kehtestab teede- ja sideminister. (2) Käesoleva paragrahvi lõikes 1 nimetatud korda kohaldatakse ka välisriigi lippu kandvale laevale.",
      "rdfs:label": {
        "@value": "MSOS_Par_50 (redaktsioon 194180)",
        "@language": "et"
      },
