    },
    {
      "@id": "estleg:MSOS_Par_11_12_v131052021007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_11_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
