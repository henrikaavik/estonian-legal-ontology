      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jäämurdetöid korraldab Transpordiamet. (2) Jäämurdetöid teostab Riigilaevastik.",
      "rdfs:label": {
        "@value": "MSOS_Par_49_2 (redaktsioon 117042025029)",
        "@language": "et"
