      },
      "estleg:versionValidTo": {
        "@value": "2009-07-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_50_8_v13198714",
      "@type": [
        "owl:NamedIndividual",
