    },
    {
      "@id": "estleg:MSOS_Par_36_v129062014112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_36"
      },
      "estleg:versionValidFrom": {
