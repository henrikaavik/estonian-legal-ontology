      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekontrolli otsusega mittenõustuv isik võib esitada otsuse peale vaide Tervishoiuametile.",
      "rdfs:label": {
        "@value": "MSOS_Par_26_2 (redaktsioon 738238)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "738238",
