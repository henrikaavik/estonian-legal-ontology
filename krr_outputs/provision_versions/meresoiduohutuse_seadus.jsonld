      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kapten võib loobuda laevale saadetud lootsi nõuannete kasutamisest, kui ta leiab, et nõuanded ei vasta tegelikule olukorrale või et loots ei ole võimeline oma kohustusi täitma. Sel juhul peab ta nõudma teise lootsi saatmist laevale.",
      "rdfs:label": {
        "@value": "MSOS_Par_66 (redaktsioon 908666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908666",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_66_v131052021007"
      },
