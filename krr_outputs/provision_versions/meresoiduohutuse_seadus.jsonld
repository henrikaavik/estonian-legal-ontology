    {
      "@id": "estleg:MSOS_Par_94_26_v908666",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_94_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 80–94 25 sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40; 46, 329; 54, 387; 56, 401; 88, 600; 2005, 20, 126) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590; RT III 2004, 9, 96; RT I 2004, 46, 329; 54, 387 ja 390; 56, 403) sätteid. (2) Käesoleva seaduse §-des 80–93 3 ja 94 1 –94 25 sätestatud väärtegude kohtuväline menetleja on Veeteede Amet. (3) Käesoleva seaduse §-des 94, 94 4 ja 94 11 sätestatud väärtegude kohtuväline menetleja on Piirivalveamet. (4) Käesoleva seaduse §-des 88, 89, 93, 94 24 ja 94 25 sätestatud väärteo kohtuvälised menetlejad on Politseiamet ja Piirivalveamet. (5) Käesolevat paragrahvi ja käesoleva seaduse § 80–94 18 , 94 21 , 94 22 , 94 24 ja 94 25 kohaldatakse ka välisriigi lippu kandvatele laevadele ja väikelaevadele, välja arvatud juhul, kui välisriigis, mille lippu väikelaev kannab, ei kohaldata käesolevas seaduses sätestatuga samaväärseid dokumendinõudeid.",
      "rdfs:label": {
        "@value": "MSOS_Par_94_26 (redaktsioon 908666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908666",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_94_26_v1027803"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_94_26_v1027803",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_94_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse § -des 80–94 25 sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 86, 504; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601; 2004, 7, 40; 46, 329; 54, 387; 56, 401; 88, 600; 2005, 20, 126) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590; RT III 2004, 9, 96; RT I 2004, 46, 329; 54, 387 ja 390; 56, 403) sätteid. (2) Käesoleva seaduse § -des 80–93 3 ja 94 1 –94 25 sätestatud väärtegude kohtuväline menetleja on Veeteede Amet. (3) Käesoleva seaduse § -des 94, 94 4 ja 94 11 sätestatud väärtegude kohtuväline menetleja on Piirivalveamet. (4) Käesoleva seaduse § -des 88, 89, 93, 94 24 ja 94 25 sätestatud väärteo kohtuvälised menetlejad on Julgestuspolitsei, politseiprefektuur ja Piirivalveamet. (5) Käesolevat paragrahvi ja käesoleva seaduse § 80–94 18 , 94 21 , 94 22 , 94 24 ja 94 25 kohaldatakse ka välisriigi lippu kandvatele laevadele ja väikelaevadele, välja arvatud juhul, kui välisriigis, mille lippu väikelaev kannab, ei kohaldata käesolevas seaduses sätestatuga samaväärseid dokumendinõudeid.",
      "rdfs:label": {
        "@value": "MSOS_Par_94_26 (redaktsioon 1027803)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027803",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_94_26_v13063170"
      },
      "estleg:versionValidTo": {
        "@value": "2008-11-15",
        "@type": "xsd:date"
      }
    },
