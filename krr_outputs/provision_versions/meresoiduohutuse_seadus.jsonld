    {
      "@id": "estleg:MSOS_Par_5_v22396",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi territooriumil asuvates sadamates nõutakse välisriigi laevalt rahvusvahelistes konventsioonides ettenähtud tunnistusi.",
      "rdfs:label": {
        "@value": "MSOS_Par_5 (redaktsioon 22396)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22396",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_5_v194180"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
