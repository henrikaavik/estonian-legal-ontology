      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_94_3_v131122010063",
      "@type": [
        "owl:NamedIndividual",
