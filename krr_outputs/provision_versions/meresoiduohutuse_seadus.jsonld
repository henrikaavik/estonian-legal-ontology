    {
      "@id": "estleg:MSOS_Par_15_1_v908666",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_15_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-06-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eestis kohaldatakse laeva ja ohtliku lasti käitamise ning hädaolukorras tegutsemise hõlbustamiseks IMO heakskiidetud leppemärke, mis avaldatakse Veeteede Ameti Teatajas ja Veeteede Ameti veebilehel.",
      "rdfs:label": {
        "@value": "MSOS_Par_15_1 (redaktsioon 908666)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "908666",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_15_1_v110122020020"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_15_1_v110122020020",
