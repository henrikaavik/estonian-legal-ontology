      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veesõiduki juhtimise eest ilma nõuetekohase juhtimisõigust tõendava dokumendita –karistatakse rahatrahviga kuni 200 trahviühikut.",
      "rdfs:label": {
