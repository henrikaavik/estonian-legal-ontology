      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva reisiks ettevalmistamata jätmise eest –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "MSOS_Par_94_3 (redaktsioon 131122010063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010063"
    },
    {
