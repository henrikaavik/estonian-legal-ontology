      }
    },
    {
      "@id": "estleg:MSOS_Par_5_v194180",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laeva sõidupiirkonna määrab ja kannab selle andmed meresõiduohutust tõendavatesse tunnistustesse või sisevetel kasutatava laeva sõidukõlblikkuse tunnistusse (edaspidi sõidukõlblikkuse tunnistus ) Veeteede Amet. (2) Veeteede Amet tunnustab volitatud klassifikatsiooniühingu või Euroopa Liidu liikmesriigi mereadministratsiooni määratud sõidupiirkonna kohta tehtud kannet laeva meresõiduohutust tõendavas tunnistuses, kui see vastab rahvusvaheliste konventsioonide ja käesoleva seaduse nõuetele.",
      "rdfs:label": {
        "@value": "MSOS_Par_5 (redaktsioon 194180)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194180",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_5_v131122010063"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_5_v131122010063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Laeva sõidupiirkonna määrab ja kannab selle andmed meresõiduohutust tõendavatesse tunnistustesse või sisevetel kasutatava laeva sõidukõlblikkuse tunnistusse (edaspidi sõidukõlblikkuse tunnistus) Veeteede Amet. (2) Veeteede Amet tunnustab volitatud klassifikatsiooniühingu või Euroopa Liidu liikmesriigi pädeva asutuse määratud sõidupiirkonna kohta tehtud kannet laeva meresõiduohutust tõendavas tunnistuses, kui see vastab rahvusvaheliste konventsioonide ja käesoleva seaduse nõuetele.",
      "rdfs:label": {
        "@value": "MSOS_Par_5 (redaktsioon 131122010063)",
