      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_26_2_v13249714",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_26_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekontrolli otsusega mittenõustuv isik võib esitada otsuse peale vaide Terviseametile.",
      "rdfs:label": {
        "@value": "MSOS_Par_26_2 (redaktsioon 13249714)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13249714",
