        "@value": "MSOS_Par_101 (redaktsioon 130122011049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011049"
    },
    {
      "@id": "estleg:MSOS_Par_102_v131122010034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
