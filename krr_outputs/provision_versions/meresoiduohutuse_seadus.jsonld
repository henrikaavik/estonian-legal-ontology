      }
    },
    {
      "@id": "estleg:MSOS_Par_48_v131122010063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitustegevust veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas piiratakse, kui ehitustegevus kahjustab meresõiduohutust või sisevetel sõidu ohutust. (2) Veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas ehitustegevuse korra (3) Kehtetu - (4) Navigatsioonimärgi lähedusse või mõjupiirkonda on keelatud paigaldada tulesid, mis segavad navigatsioonimärgi eristamist. Veeteede Ameti ettekirjutusel või sadamakapteni nõudmisel tuleb segavad tuled eemaldada. (5) Silla, õhuliini, veealuse kaabli, torujuhtme või muu sellise rajatise on selle omanik kohustatud veeteel tähistama Veeteede Ameti nõudmisel. (6) Veeteede Ametil on õigus kinnisasja omaniku või valdaja nõusolekuta navigatsioonimärgi mõjupiirkonnas kasvavat taimestikku piirata või seda eemaldada, kui see takistab navigatsioonimärgi nähtavust. Veeteede Amet teavitab eelnevalt kinnisasja omanikku või valdajat taimestiku piiramise või eemaldamise vajadusest.",
      "rdfs:label": {
        "@value": "MSOS_Par_48 (redaktsioon 131122010063)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122010063",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_48_v129062014112"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_48_v129062014112",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitustegevust veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas piiratakse, kui ehitustegevus kahjustab meresõiduohutust või sisevetel sõidu ohutust. (2) Veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas ehitustegevuse korra kehtestab (3) Kehtetu - (4) Navigatsioonimärgi lähedusse või mõjupiirkonda on keelatud paigaldada tulesid, mis segavad navigatsioonimärgi eristamist. Veeteede Ameti ettekirjutusel või sadamakapteni nõudmisel tuleb segavad tuled eemaldada. (5) Silla, õhuliini, veealuse kaabli, torujuhtme või muu sellise rajatise on selle omanik kohustatud veeteel tähistama Veeteede Ameti nõudmisel. (6) Veeteede Ametil on õigus kinnisasja omaniku või valdaja nõusolekuta navigatsioonimärgi mõjupiirkonnas kasvavat taimestikku piirata või seda eemaldada, kui see takistab navigatsioonimärgi nähtavust. Veeteede Amet teavitab eelnevalt kinnisasja omanikku või valdajat taimestiku piiramise või eemaldamise vajadusest.",
      "rdfs:label": {
        "@value": "MSOS_Par_48 (redaktsioon 129062014112)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014112",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_48_v110122020020"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_48_v110122020020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitustegevust veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas piiratakse, kui ehitustegevus kahjustab meresõiduohutust või sisevetel sõidu ohutust. (2) Veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas ehitustegevuse korra kehtestab (3) Kehtetu - (4) Navigatsioonimärgi lähedusse või mõjupiirkonda on keelatud paigaldada tulesid, mis segavad navigatsioonimärgi eristamist. Transpordiameti ettekirjutusel või sadamakapteni nõudmisel tuleb segavad tuled eemaldada. (5) Silla, õhuliini, veealuse kaabli, torujuhtme või muu sellise rajatise on selle omanik kohustatud veeteel tähistama Transpordiameti nõudmisel. (6) Transpordiametil on õigus kinnisasja omaniku või valdaja nõusolekuta navigatsioonimärgi mõjupiirkonnas kasvavat taimestikku piirata või seda eemaldada, kui see takistab navigatsioonimärgi nähtavust. Transpordiamet teavitab eelnevalt kinnisasja omanikku või valdajat taimestiku piiramise või eemaldamise vajadusest.",
      "rdfs:label": {
        "@value": "MSOS_Par_48 (redaktsioon 110122020020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020020",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_48_v117042025029"
      },
      "estleg:versionValidTo": {
        "@value": "2025-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_48_v117042025029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_48"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitustegevust veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas piiratakse, kui ehitustegevus kahjustab meresõiduohutust või sisevetel sõidu ohutust. (2) Veeteel või navigatsioonimärgi vahetus läheduses või mõjupiirkonnas ehitustegevuse korra kehtestab (3) Kehtetu - (4) Navigatsioonimärgi lähedusse või mõjupiirkonda on keelatud paigaldada tulesid, mis segavad navigatsioonimärgi eristamist. Transpordiameti ettekirjutusel või sadamakapteni nõudmisel tuleb segavad tuled eemaldada. (5) Silla, õhuliini, veealuse kaabli, torujuhtme või muu sellise rajatise on selle omanik kohustatud veeteel tähistama Transpordiameti nõudmisel. (6) Riigilaevastikul on õigus kinnisasja omaniku või valdaja nõusolekuta navigatsioonimärgi mõjupiirkonnas kasvavat taimestikku piirata või seda eemaldada, kui see takistab navigatsioonimärgi nähtavust. Riigilaevastik teavitab eelnevalt kinnisasja omanikku või valdajat taimestiku piiramise või eemaldamise vajadusest.",
      "rdfs:label": {
        "@value": "MSOS_Par_48 (redaktsioon 117042025029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117042025029"
    },
    {
      "@id": "estleg:MSOS_Par_49_v22396",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Loots on kohustatud laevale saabumisel esitama laeva kaptenile täitmiseks teede- ja sideministri kehtestatud vorminõuetele vastava lootsikviitungi, mille täidab ja kinnitab oma allkirjaga kapten.",
      "rdfs:label": {
        "@value": "MSOS_Par_49 (redaktsioon 22396)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22396",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_49_v194180"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_49_v194180",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MSOS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti vetes pukseerival laeval või väikelaeval tuleb võtta tarvitusele kõik abinõud, et tagada pukseeriva laeva või väikelaeva ja pukseeritava laeva või väikelaeva või muu objekti ohutus. (2) Pukseerimise nõuded kehtestab teede- ja sideminister. (3) Käesolevat paragrahvi kohaldatakse ka välisriigi lippu kandvale laevale ja väikelaevale.",
      "rdfs:label": {
        "@value": "MSOS_Par_49 (redaktsioon 194180)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194180",
      "estleg:supersededByVersion": {
        "@id": "estleg:MSOS_Par_49_v695566"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MSOS_Par_49_v695566",
      "@type": [
