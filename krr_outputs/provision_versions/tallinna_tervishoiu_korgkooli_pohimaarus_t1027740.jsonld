      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rektor annab oma pädevuse piires käskkirju. Rektor annab oma pädevuse piires käskkirju.",
      "rdfs:label": {
        "@value": "Reg_1027740_Par_8 (redaktsioon 1027740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027740",
