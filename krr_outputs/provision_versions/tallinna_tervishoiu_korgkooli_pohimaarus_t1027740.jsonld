      }
    },
    {
      "@id": "estleg:Reg_1027740_Par_9_v1027740",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1027740_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rektor valitakse avaliku konkursiga kuni viieks aastaks vastavalt kõrgharidusseaduse § 24 lõikele 4 valdkonna eest vastutava ministri määrusega kehtestatud korras. Minister, kelle juhitava ministeeriumi valitsemisalasse rakenduskõrgkool kuulub, või tema volitatud esindaja sõlmib rektoriga töölepingu. RT I 2019-08-09 1 109082019001 2019-09-01 Rektor valitakse avaliku konkursiga kuni viieks aastaks vastavalt kõrgharidusseaduse § 24 lõikele 4 valdkonna eest vastutava ministri määrusega kehtestatud korras. Minister, kelle juhitava ministeeriumi valitsemisalasse rakenduskõrgkool kuulub, või tema volitatud esindaja sõlmib rektoriga töölepingu. 2 (2) Rektori ametikohale valitud kõrgkooli töötajal on pärast rektori töökohustustest vabanemist õigus asuda kõrgkoolis ametikohale, kus ta töötas enne rektoriks valimist. Rektori ametikohale valitud kõrgkooli töötajal on pärast rektori töökohustustest vabanemist õigus asuda kõrgkoolis ametikohale, kus ta töötas enne rektoriks valimist. 3 (3) Rektori ametitunnus on rektori ametiraha, mille statuudi kinnitab nõukogu. Rektori ametitunnus on rektori ametiraha, mille statuudi kinnitab nõukogu.",
      "rdfs:label": {
        "@value": "Reg_1027740_Par_9 (redaktsioon 1027740)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1027740",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1027740",
