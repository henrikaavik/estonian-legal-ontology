      "estleg:provisionRef": "Reg_1055678 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055678_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055678_Par_3_v1055678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055678_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-11-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meditsiiniseadme esmakordsest Eestis levitamisest teavitamisel esitab levitaja Ravimiametile meditsiiniseadmete ja abivahendite andmekogu kaudu vähemalt järgmised andmed: RT I 2024-12-05 5 105122024005 2025-01-01 1 1) meditsiiniseadme levitaja registrikood, ärinimi, aadress, telefoninumber ja e-posti aadress; 2 2) meditsiiniseadme tootja ja tema volitatud esindaja (kui on kohaldatav) ärinimi ja aadress; 3 3) meditsiiniseadme eesti- ja ingliskeelne nimetus, sihtotstarve eesti ja inglise keeles ning riskiklass; 4 4) meditsiiniseadet identifitseerivad andmed – meditsiiniseadme mudel, liik, tüüp, tarkvara versioon, artikli- või katalooginumber (kui on kohaldatav); 5 5) koopia eestikeelsest või ingliskeelsest (kui on kohaldatav) meditsiiniseadmega kaasnevast teabest, mis tagab seadme ohutu ja sihtotstarbekohase kasutamise, ja originaalkeelse kasutusjuhendi koopia (kui on kohaldatav); 6 6) märgistuse koopia; 7 7) teavitatud asutuse identifitseerimis- ehk tunnusnumber ja väljastatud vastavussertifikaat (kui on kohaldatav); 8 8) vastavusdeklaratsioon (kui on kohaldatav); 9 9) Euroopa Parlamendi ja nõukogu määruse (EL) 2017/745 artikli 22 lõikes 1 nimetatud kinnitus (kui on kohaldatav). Meditsiiniseadme esmakordsest Eestis levitamisest teavitamisel esitab levitaja Ravimiametile meditsiiniseadmete ja abivahendite andmekogu kaudu vähemalt järgmised andmed: meditsiiniseadme levitaja registrikood, ärinimi, aadress, telefoninumber ja e-posti aadress; meditsiiniseadme tootja ja tema volitatud esindaja (kui on kohaldatav) ärinimi ja aadress; meditsiiniseadme eesti- ja ingliskeelne nimetus, sihtotstarve eesti ja inglise keeles ning riskiklass; meditsiiniseadet identifitseerivad andmed – meditsiiniseadme mudel, liik, tüüp, tarkvara versioon, artikli- või katalooginumber (kui on kohaldatav); koopia eestikeelsest või ingliskeelsest (kui on kohaldatav) meditsiiniseadmega kaasnevast teabest, mis tagab seadme ohutu ja sihtotstarbekohase kasutamise, ja originaalkeelse kasutusjuhendi koopia (kui on kohaldatav); märgistuse koopia; teavitatud asutuse identifitseerimis- ehk tunnusnumber ja väljastatud vastavussertifikaat (kui on kohaldatav); vastavusdeklaratsioon (kui on kohaldatav); Euroopa Parlamendi ja nõukogu määruse (EL) 2017/745 artikli 22 lõikes 1 nimetatud kinnitus (kui on kohaldatav).",
      "rdfs:label": {
        "@value": "Reg_1055678_Par_3 (redaktsioon 1055678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055678",
