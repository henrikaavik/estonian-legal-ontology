      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Õhukvaliteedi piir- ja sihtväärtused, õhukvaliteedi muud piirnormid ning õhukvaliteedi hindamispiirid (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Õhukvaliteedi piir- ja sihtväärtused, õhukvaliteedi muud piirnormid ning õhukvaliteedi hindamispiirid"
    },
    {
      "@id": "estleg:Reg_1037343_Par_1_v1037343",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037343_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-02-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega sätestatakse: 1 1) õhukvaliteedi piirväärtused; 2 2) õhukvaliteedi piirväärtuse lubatud ületamise määr; 3 3) õhukvaliteedi sihtväärtused; 4 4) õhukvaliteedi piir- ja sihtväärtuse ületamise lubatud kordade arv kalendriaastas; 5 5) õhukvaliteedi kriitiline tase; 6 6) õhukvaliteedi häiretase; 7 7) õhukvaliteedi teavitamistase ja kaugem eesmärk; 8 8) õhukvaliteedi hindamispiirid; 9 9) peenete osakeste (PM2,5) keskmise kokkupuute näitaja vähendamise eesmärk baasaasta suhtes ja selle saavutamise tähtaeg; 10 10) kohustuslikult saavutatav õhukvaliteedi tase. Määrusega sätestatakse: õhukvaliteedi piirväärtused; õhukvaliteedi piirväärtuse lubatud ületamise määr; õhukvaliteedi sihtväärtused; õhukvaliteedi piir- ja sihtväärtuse ületamise lubatud kordade arv kalendriaastas; õhukvaliteedi kriitiline tase; õhukvaliteedi häiretase; õhukvaliteedi teavitamistase ja kaugem eesmärk; õhukvaliteedi hindamispiirid; peenete osakeste (PM2,5) keskmise kokkupuute näitaja vähendamise eesmärk baasaasta suhtes ja selle saavutamise tähtaeg; kohustuslikult saavutatav õhukvaliteedi tase.",
      "rdfs:label": {
        "@value": "Reg_1037343_Par_1 (redaktsioon 1037343)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037343",
