      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Mobilisatsiooni ajal kogunemiskohta ilmumisel kaasas olevate dokumentide ja esemete loetelu (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Mobilisatsiooni ajal kogunemiskohta ilmumisel kaasas olevate dokumentide ja esemete loetelu"
    },
    {
      "@id": "estleg:Reg_1056399_Par_1_v1056399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056399_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse loetelu dokumentidest ja esemetest, mis peavad kaitseväekohustuslasel ja sõjaaja ametikohale nimetatud kaitseväekohustuseta isikul olema kaasas, kui ta ilmub mobilisatsiooni ajal kogunemiskohta. Määrusega kehtestatakse loetelu dokumentidest ja esemetest, mis peavad kaitseväekohustuslasel ja sõjaaja ametikohale nimetatud kaitseväekohustuseta isikul olema kaasas, kui ta ilmub mobilisatsiooni ajal kogunemiskohta.",
      "rdfs:label": {
        "@value": "Reg_1056399_Par_1 (redaktsioon 1056399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056399",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056399",
      "estleg:sourceAct": "Mobilisatsiooni ajal kogunemiskohta ilmumisel kaasas olevate dokumentide ja esemete loetelu",
      "estleg:provisionRef": "Reg_1056399 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056399_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056399_Par_2_v1056399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056399_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväekohustuslane ja sõjaaja ametikohale nimetatud kaitseväekohustuseta isik on kohustatud mobilisatsiooni ajal kogunemiskohta ilmumisel võtma kaasa järgmised dokumendid: 1 1) isikut tõendav dokument; 2 2) juhiluba või muu juhtimisõigust tõendav dokument, kui see on olemas; 3 3) arvelduskonto andmed. Kaitseväekohustuslane ja sõjaaja ametikohale nimetatud kaitseväekohustuseta isik on kohustatud mobilisatsiooni ajal kogunemiskohta ilmumisel võtma kaasa järgmised dokumendid: isikut tõendav dokument; juhiluba või muu juhtimisõigust tõendav dokument, kui see on olemas; arvelduskonto andmed.",
      "rdfs:label": {
        "@value": "Reg_1056399_Par_2 (redaktsioon 1056399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056399",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056399",
      "estleg:sourceAct": "Mobilisatsiooni ajal kogunemiskohta ilmumisel kaasas olevate dokumentide ja esemete loetelu",
      "estleg:provisionRef": "Reg_1056399 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056399_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056399_Par_3_v1056399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056399_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväekohustuslane ja sõjaaja ametikohale nimetatud kaitseväekohustuseta isik on kohustatud mobilisatsiooni ajal kogunemiskohta ilmumisel võtma kaasa järgmised esemed: 1 1) identifitseerimiskoodiga isikuplaat, kui see on olemas; 2 2) isiklikud hügieenitarbed; 3 3) aastaajale vastav riietus ja jalanõud; 4 4) kaks paari aluspesu ja sokke 5 5) sõjaväerelv ja laskemoon, kui see on olemas; 6 6) taskunuga; 7 7) vahend tule süütamiseks; 8 8) ühe päeva toit ja veepudel; 9 9) sularaha ja kirjatarbed; 10 10) riideparanduskomplekt; 11 11) eriarsti poolt määratud retseptiravimid kuni kaheks päevaks; 12 12) Kaitseväe väljastatud kaitseväelase individuaalvarustus, kui see on olemas. Kaitseväekohustuslane ja sõjaaja ametikohale nimetatud kaitseväekohustuseta isik on kohustatud mobilisatsiooni ajal kogunemiskohta ilmumisel võtma kaasa järgmised esemed: identifitseerimiskoodiga isikuplaat, kui see on olemas; isiklikud hügieenitarbed; aastaajale vastav riietus ja jalanõud; kaks paari aluspesu ja sokke sõjaväerelv ja laskemoon, kui see on olemas; taskunuga; vahend tule süütamiseks; ühe päeva toit ja veepudel; sularaha ja kirjatarbed; riideparanduskomplekt; eriarsti poolt määratud retseptiravimid kuni kaheks päevaks; Kaitseväe väljastatud kaitseväelase individuaalvarustus, kui see on olemas.",
      "rdfs:label": {
        "@value": "Reg_1056399_Par_3 (redaktsioon 1056399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056399",
