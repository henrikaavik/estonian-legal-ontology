      },
      "dc:source": "Tõendusliku alkomeetri ja indikaatorvahendi kasutamise ning nende kasutamise dokumenteerimise kord"
    },
    {
      "@id": "estleg:Reg_1024405_Par_1_v1024405",
      "@type": [
