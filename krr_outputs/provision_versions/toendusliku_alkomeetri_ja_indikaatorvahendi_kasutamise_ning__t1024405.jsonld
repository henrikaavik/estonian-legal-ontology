    {
      "@id": "estleg:Reg_1024405_Par_2_v1024405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024405_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Indikaatorvahendiga kontrollitakse alkoholi sisaldumist kontrollile allutatud isiku väljahingatavas õhus. Indikaatorvahendiga kontrollitakse alkoholi sisaldumist kontrollile allutatud isiku väljahingatavas õhus. 2 (2) Kontrollile allutatud isik puhub indikaatorvahendisse ühe korra. Vajaduse korral puhub ta uuesti. Kontrollile allutatud isik puhub indikaatorvahendisse ühe korra. Vajaduse korral puhub ta uuesti. 3 (3) Kontrollile allutatud isiku nõudmisel esitatakse talle indikaatorvahendi tulemus. Kontrollile allutatud isiku nõudmisel esitatakse talle indikaatorvahendi tulemus.",
      "rdfs:label": {
        "@value": "Reg_1024405_Par_2 (redaktsioon 1024405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024405",
