      }
    },
    {
      "@id": "estleg:Reg_1024405_Par_3_v1024405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024405_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Indikaatorvahendi kasutamine ja näit protokollitakse: 1 1) haldusmenetluse seaduse § 18 lõikes 1 nimetatud alustel; 2 2) indikaatorvahendi näidu kasutamiseks tõendina. Indikaatorvahendi kasutamine ja näit protokollitakse: haldusmenetluse seaduse § 18 lõikes 1 nimetatud alustel; indikaatorvahendi näidu kasutamiseks tõendina. 2 (2) Indikaatorvahendi kasutamine protokollitakse käesoleva määruse lisas esitatud vormi kohaselt. Protokolli koopia väljastatakse kontrollile allutatud isikule tema nõudmisel. Indikaatorvahendi kasutamine protokollitakse käesoleva määruse lisas esitatud vormi kohaselt. Protokolli koopia väljastatakse kontrollile allutatud isikule tema nõudmisel. 3 (3) Indikaatorvahendi kasutamise protokoll lisatakse süüteomenetluse materjalidele või korrakaitseorgan säilitab selle vastavalt tema asjaajamiskorrale. Indikaatorvahendi kasutamise protokoll lisatakse süüteomenetluse materjalidele või korrakaitseorgan säilitab selle vastavalt tema asjaajamiskorrale.",
      "rdfs:label": {
        "@value": "Reg_1024405_Par_3 (redaktsioon 1024405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024405",
      "estleg:sourceAct": "Tõendusliku alkomeetri ja indikaatorvahendi kasutamise ning nende kasutamise dokumenteerimise kord",
      "estleg:provisionRef": "Reg_1024405 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024405_Map"
      }
    },
    {
      "@id": "estleg:Reg_1024405_Par_4_v1024405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024405_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tõendusliku alkomeetriga mõõdetakse etanooli massikontsentratsiooni kontrollile allutatud isiku väljahingatavas õhus. Tõendusliku alkomeetriga mõõdetakse etanooli massikontsentratsiooni kontrollile allutatud isiku väljahingatavas õhus. 2 (2) Tõendusliku alkomeetriga mõõdab üksnes pädev mõõtja mõõtemetoodikat järgides. Tõendusliku alkomeetriga mõõdab üksnes pädev mõõtja mõõtemetoodikat järgides. 3 (3) Tõendusliku alkomeetri mõõtetsükkel koosneb kahest puhumisest. Tõendusliku alkomeetri mõõtetsükkel koosneb kahest puhumisest. 4 (4) Mõõtmiste lõplik lugem on näidikule kuvatav kahe puhumise vähim tulemus. Mõõtmiste lõplik lugem on näidikule kuvatav kahe puhumise vähim tulemus. 5 (5) Kui tõenduslik alkomeeter ei kuva mõõtetsükli tulemusena lõplikku lugemit või annab veateate, korratakse mõõtetsüklit. Kui tõenduslik alkomeeter ei kuva mõõtetsükli tulemusena lõplikku lugemit või annab veateate, korratakse mõõtetsüklit.",
      "rdfs:label": {
        "@value": "Reg_1024405_Par_4 (redaktsioon 1024405)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1024405",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1024405",
      "estleg:sourceAct": "Tõendusliku alkomeetri ja indikaatorvahendi kasutamise ning nende kasutamise dokumenteerimise kord",
      "estleg:provisionRef": "Reg_1024405 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024405_Map"
      }
    },
    {
      "@id": "estleg:Reg_1024405_Par_5_v1024405",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1024405_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tõendusliku alkomeetri kasutamine dokumenteeritakse väljatrükina või protokollina. Tõendusliku alkomeetri kasutamine dokumenteeritakse väljatrükina või protokollina. 2 (2) Väljatrükk või protokoll peab sisaldama vähemalt järgmisi andmeid: 1 1) mõõtmise kuupäev ja kellaaeg; 2 2) kontrollile allutatud isiku ees- ja perekonnanimi, sünniaeg või isikukood; 3 3) mõõtmiseks kasutatava tõendusliku alkomeetri nimetus; 4 4) kahe mõõtmise lugemid ning lõplik lugem; 5 5) mõõtmist teostanud ametniku ees- ja perekonnanimi. Väljatrükk või protokoll peab sisaldama vähemalt järgmisi andmeid: mõõtmise kuupäev ja kellaaeg; kontrollile allutatud isiku ees- ja perekonnanimi, sünniaeg või isikukood; mõõtmiseks kasutatava tõendusliku alkomeetri nimetus; kahe mõõtmise lugemid ning lõplik lugem; mõõtmist teostanud ametniku ees- ja perekonnanimi. 3 (3) Väljatrüki või protokolli allkirjastab mõõtmist teostanud ametnik. Väljatrüki või protokolli allkirjastab mõõtmist teostanud ametnik. 4 (4) Mõõtmisele allutatud isiku nõudmisel väljastatakse talle koopia väljatrükist või protokollist. Mõõtmisele allutatud isiku nõudmisel väljastatakse talle koopia väljatrükist või protokollist. 5 (5) Väljatrükk või protokoll lisatakse süüteomaterjalidele ning säilitatakse vastavalt süüteomenetluse nõuetele või korrakaitseorgan säilitab selle vastavalt tema asjaajamiskorrale. Väljatrükk või protokoll lisatakse süüteomaterjalidele ning säilitatakse vastavalt süüteomenetluse nõuetele või korrakaitseorgan säilitab selle vastavalt tema asjaajamiskorrale.",
      "rdfs:label": {
