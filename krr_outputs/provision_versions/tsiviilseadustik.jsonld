        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidiline isik lõpetatakse: üldkoosoleku või muu pädeva organi otsusega; isiku, organi või asutuse otsusega, kellele seadusega on antud õigus lõpetada avalik-õiguslik juriidiline isik; seaduses, põhikirjas või ühingulepingus seatud eesmärgi saavutamisel; tähtaja möödumisel, kui juriidiline isik on asutatud tähtajaliselt; juriidilise isiku pankroti väljakuulutamisega või pankrotimenetluse raugemisega enne pankroti väljakuulutamist; Kehtetud – kohtumäärusega sundlõpetamise kohta; muul seaduse, põhikirja või ühingulepinguga ettenähtud alusel.",
      "rdfs:label": {
        "@value": "TsUS_Osa2_Par_39 (redaktsioon 13111425)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13111425",
      "estleg:supersededByVersion": {
        "@id": "estleg:TsUS_Osa2_Par_39_v13334839"
      },
      "estleg:versionValidTo": {
        "@value": "2010-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13111425",
      "estleg:sourceAct": "Tsiviilseadustiku üldosa seadus",
      "estleg:provisionRef": "TsUS § 39"
    },
    {
      "@id": "estleg:TsUS_Osa2_Par_39_v13334839",
