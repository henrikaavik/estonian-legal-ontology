    },
    {
      "@id": "estleg:TsUS_Osa2_Par_39_v22293",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsUS_Osa2_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eraõiguslikul juriidilisel isikul on põhikiri või seaduses sätestatud juhtudel ühinguleping. (2) Avalik-õiguslikul juriidilisel isikul on põhikiri, kui see on sätestatud vastava juriidilise isiku kohta käivas seaduses.",
      "rdfs:label": {
        "@value": "TsUS_Osa2_Par_39 (redaktsioon 22293)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22293",
      "estleg:supersededByVersion": {
        "@id": "estleg:TsUS_Osa2_Par_39_v95221"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22293",
      "estleg:sourceAct": "Tsiviilseadustiku üldosa seadus",
      "estleg:provisionRef": "TsUS § 39"
    },
    {
      "@id": "estleg:TsUS_Osa2_Par_39_v95221",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsUS_Osa2_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidiline isik lõpetatakse: üldkoosoleku või muu pädeva organi otsusega; isiku, organi või asutuse otsusega, kellele seadusega on antud õigus lõpetada avalik-õiguslik juriidiline isik; seaduses, põhikirjas või ühingulepingus seatud eesmärgi saavutamisel; tähtaja möödumisel, kui juriidiline isik on asutatud tähtajaliselt; võlausaldajate üldkoosoleku otsusega pankrotimenetluses; kohtumäärusega, millega pankrotimenetlus on lõpetatud vara puudumise tõttu; kohtuotsusega sundlõpetamise kohta; muul seaduse, põhikirja või ühingulepinguga ettenähtud alusel.",
      "rdfs:label": {
        "@value": "TsUS_Osa2_Par_39 (redaktsioon 95221)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "95221",
      "estleg:supersededByVersion": {
        "@id": "estleg:TsUS_Osa2_Par_39_v925981"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/95221",
      "estleg:sourceAct": "Tsiviilseadustiku üldosa seadus",
      "estleg:provisionRef": "TsUS § 39"
    },
    {
      "@id": "estleg:TsUS_Osa2_Par_39_v925981",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TsUS_Osa2_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juriidiline isik lõpetatakse: üldkoosoleku või muu pädeva organi otsusega; isiku, organi või asutuse otsusega, kellele seadusega on antud õigus lõpetada avalik-õiguslik juriidiline isik; seaduses, põhikirjas või ühingulepingus seatud eesmärgi saavutamisel; tähtaja möödumisel, kui juriidiline isik on asutatud tähtajaliselt; [Punkt 4 1 jõustub 1. 01. 2006] juriidilise isiku pankroti väljakuulutamisega või pankrotimenetluse raugemisega enne pankroti väljakuulutamist; võlausaldajate üldkoosoleku otsusega pankrotimenetluses; kohtumäärusega, millega pankrotimenetlus on lõpetatud vara puudumise tõttu; kohtuotsusega sundlõpetamise kohta; muul seaduse, põhikirja või ühingulepinguga ettenähtud alusel.",
      "rdfs:label": {
