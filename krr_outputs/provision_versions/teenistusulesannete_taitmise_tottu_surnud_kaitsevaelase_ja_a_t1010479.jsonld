  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_teenistusulesannete_taitmise_tottu_surnud_kaitsevaelase_ja_a_t1010479_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu ulatus, maksmise tingimused ja kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu ulatus, maksmise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1010479_Par_1_v1010479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010479_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesolev määrus reguleerib kaitseväeteenistuses ja asendusteenistuses teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu (edaspidi matusekulud) ulatust, hüvitavate matusekulude loetelu, matusekulu maksmise tingimusi ja korda. Käesolev määrus reguleerib kaitseväeteenistuses ja asendusteenistuses teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu (edaspidi matusekulud) ulatust, hüvitavate matusekulude loetelu, matusekulu maksmise tingimusi ja korda. 2 (2) Käesolevat määrust ei kohaldata, kui tegevväelane on suunatud kaitseväeteenistuse seaduse § 119 lõike 1 alusel sõjaväelise auastmeta ameti- või töökohale. Käesolevat määrust ei kohaldata, kui tegevväelane on suunatud kaitseväeteenistuse seaduse § 119 lõike 1 alusel sõjaväelise auastmeta ameti- või töökohale.",
      "rdfs:label": {
        "@value": "Reg_1010479_Par_1 (redaktsioon 1010479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010479",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1010479",
      "estleg:sourceAct": "Teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu ulatus, maksmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1010479 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1010479_Map"
      }
    },
    {
      "@id": "estleg:Reg_1010479_Par_2_v1010479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010479_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Matusekuludeks on surnu matuseks ettevalmistamise, transportimise, tuhastamise või matmise ning leinatalituse kulud. Matusekuludeks on surnu matuseks ettevalmistamise, transportimise, tuhastamise või matmise ning leinatalituse kulud. 2 (2) Matusekulud kantakse kuni 5000 euro ulatuses. RT I 2017-12-29 11 129122017011 2018-01-01 Matusekulud kantakse kuni 5000 euro ulatuses. 3 (3) Vajadusel kantakse täiendavalt käesoleva paragrahvi lõigetes 1–2 sätestatule välisriigis hukkunud või surnud kaitseväelase Eestisse toomise kulud. Vajadusel kantakse täiendavalt käesoleva paragrahvi lõigetes 1–2 sätestatule välisriigis hukkunud või surnud kaitseväelase Eestisse toomise kulud.",
      "rdfs:label": {
        "@value": "Reg_1010479_Par_2 (redaktsioon 1010479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010479",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1010479",
      "estleg:sourceAct": "Teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu ulatus, maksmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1010479 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1010479_Map"
      }
    },
    {
      "@id": "estleg:Reg_1010479_Par_3_v1010479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010479_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenistusülesannete täitmise tõttu surnud kaitseväelase matusekulud kannab Kaitsevägi. Teenistusülesannete täitmise tõttu surnud kaitseväelase matusekulud kannab Kaitsevägi. 2 (2) Teenistusülesannete täitmise tõttu surnud asendusteenistuja matusekulud kannab Kaitseressursside Amet. Teenistusülesannete täitmise tõttu surnud asendusteenistuja matusekulud kannab Kaitseressursside Amet.",
      "rdfs:label": {
        "@value": "Reg_1010479_Par_3 (redaktsioon 1010479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010479",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1010479",
      "estleg:sourceAct": "Teenistusülesannete täitmise tõttu surnud kaitseväelase ja asendusteenistuja matuse korraldamise kulu ulatus, maksmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1010479 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1010479_Map"
      }
    },
    {
      "@id": "estleg:Reg_1010479_Par_4_v1010479",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1010479_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-s 3 nimetatud asutuse juht teeb otsuse matusekulude kandmise kohta viivitamatult pärast isiku teenistusalase tagatise saamise õiguse tuvastamist, kuid mitte hiljem kui kolme kalendripäeva jooksul arvates kaitseväelase või asendusteenistuja surmast. Käesoleva määruse §-s 3 nimetatud asutuse juht teeb otsuse matusekulude kandmise kohta viivitamatult pärast isiku teenistusalase tagatise saamise õiguse tuvastamist, kuid mitte hiljem kui kolme kalendripäeva jooksul arvates kaitseväelase või asendusteenistuja surmast.",
      "rdfs:label": {
        "@value": "Reg_1010479_Par_4 (redaktsioon 1010479)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1010479",
