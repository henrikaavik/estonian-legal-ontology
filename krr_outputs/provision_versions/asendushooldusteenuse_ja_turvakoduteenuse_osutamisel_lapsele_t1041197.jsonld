      },
      "dc:source": "Asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolituse tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1041197_Par_1_v1041197",
      "@type": [
        "owl:NamedIndividual",
