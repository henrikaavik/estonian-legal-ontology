      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041197_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolitust (edaspidi koolitus) korraldab Sotsiaalkindlustusamet (edaspidi koolitusasutus). RT I 2022-12-14 1 114122022001 2023-01-01 Asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolitust (edaspidi koolitus) korraldab Sotsiaalkindlustusamet (edaspidi koolitusasutus). 2 (2) Koolituse läbiviimisele kohaldatakse täiskasvanute koolituse seaduses sätestatud nõudeid. Koolituse läbiviimisele kohaldatakse täiskasvanute koolituse seaduses sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1041197_Par_1 (redaktsioon 1041197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041197",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041197",
      "estleg:sourceAct": "Asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolituse tingimused ja kord",
      "estleg:provisionRef": "Reg_1041197 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041197_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041197_Par_2_v1041197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041197_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolitusasutus hindab perioodiliselt lapsele teenust vahetult osutavate isikute koolitusvajadust ja koostab selle alusel koolituse õppekava, mis avalikustatakse koolitusasutuse kodulehel. RT I 2019-07-12 12 112072019012 2019-07-15 Koolitusasutus hindab perioodiliselt lapsele teenust vahetult osutavate isikute koolitusvajadust ja koostab selle alusel koolituse õppekava, mis avalikustatakse koolitusasutuse kodulehel. 2 (2) Eraldi õppekavad luuakse hoolduspere vanemale ning perevanemale, kasvatajale ja turvakoduteenuse osutamisel lapsele teenust vahetult osutavale isikule. RT I 2019-07-12 12 112072019012 2019-07-15 Eraldi õppekavad luuakse hoolduspere vanemale ning perevanemale, kasvatajale ja turvakoduteenuse osutamisel lapsele teenust vahetult osutavale isikule. 3 (3) Koolituse õppekava peab tagama asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutavale isikule vajaliku ettevalmistuse ning toetama talle seaduses või muus õigusaktis pandud ülesannete täitmist, lapse heaolu ja arengu tagamist, lapse õiguste ja huvide kaitsmist ning lapse kasvatamiseks ja abistamiseks vajalike meetmete pakkumist. RT I 2019-07-12 12 112072019012 2019-07-15 Koolituse õppekava peab tagama asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutavale isikule vajaliku ettevalmistuse ning toetama talle seaduses või muus õigusaktis pandud ülesannete täitmist, lapse heaolu ja arengu tagamist, lapse õiguste ja huvide kaitsmist ning lapse kasvatamiseks ja abistamiseks vajalike meetmete pakkumist. 4 (4) Koolituse õppekava peab sisaldama teoreetilist ja praktilist osa auditoorse ning iseseisva töö vormis lõikes 3 sätestatud eesmärkide täitmiseks. RT I 2018-10-25 4 125102018004 2018-10-28 Koolituse õppekava peab sisaldama teoreetilist ja praktilist osa auditoorse ning iseseisva töö vormis lõikes 3 sätestatud eesmärkide täitmiseks.",
      "rdfs:label": {
        "@value": "Reg_1041197_Par_2 (redaktsioon 1041197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041197",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041197",
      "estleg:sourceAct": "Asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolituse tingimused ja kord",
      "estleg:provisionRef": "Reg_1041197 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041197_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041197_Par_3_v1041197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041197_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolituse läbimisel väljastab koolitusasutus koolituse läbinule tunnistuse. Koolituse läbimisel väljastab koolitusasutus koolituse läbinule tunnistuse. 2 (2) Hoolduspere vanema koolituse läbimisel lisatakse tunnistusele kaaskiri, milles on sisuline hinnang koolituse läbinu valmisoleku kohta saada hoolduspere vanemaks. Hoolduspere vanema koolituse läbimisel lisatakse tunnistusele kaaskiri, milles on sisuline hinnang koolituse läbinu valmisoleku kohta saada hoolduspere vanemaks.",
      "rdfs:label": {
        "@value": "Reg_1041197_Par_3 (redaktsioon 1041197)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041197",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041197",
      "estleg:sourceAct": "Asendushooldusteenuse ja turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolituse tingimused ja kord",
      "estleg:provisionRef": "Reg_1041197 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041197_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1041197_Par_4_v1041197",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041197_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Hoolduspere vanema koolituse läbinuks loetakse ka isikud, kes on läbinud koolituse, mis oli enne 1. jaanuari 2018. a kehtinud sotsiaalhoolekande seaduse redaktsiooni alusel kohustuslik perekonnas hooldajatele ning mille kohta on koolituse läbinud isikule väljastatud tunnistus. RT I 2018-10-25 4 125102018004 2018-10-28 Hoolduspere vanema koolituse läbinuks loetakse ka isikud, kes on läbinud koolituse, mis oli enne 1. jaanuari 2018. a kehtinud sotsiaalhoolekande seaduse redaktsiooni alusel kohustuslik perekonnas hooldajatele ning mille kohta on koolituse läbinud isikule väljastatud tunnistus. 2 (2) Turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolituse läbinuks loetakse ka isikud, kes on pärast 1. jaanuari 2017. a läbinud koolituse, mis oli kohustuslik asenduskodu kasvatajatele ja perevanematele või asendushooldusteenuse osutamisel lapsele teenust vahetult osutavatele kasvatajatele ja perevanematele ning mille kohta on koolituse läbinud isikule väljastatud tunnistus. RT I 2019-07-12 12 112072019012 2019-07-15 Turvakoduteenuse osutamisel lapsele teenust vahetult osutava isiku täienduskoolituse läbinuks loetakse ka isikud, kes on pärast 1. jaanuari 2017. a läbinud koolituse, mis oli kohustuslik asenduskodu kasvatajatele ja perevanematele või asendushooldusteenuse osutamisel lapsele teenust vahetult osutavatele kasvatajatele ja perevanematele ning mille kohta on koolituse läbinud isikule väljastatud tunnistus.",
      "rdfs:label": {
        "@value": "Reg_1041197_Par_4 (redaktsioon 1041197)",
        "@language": "et"
      },
