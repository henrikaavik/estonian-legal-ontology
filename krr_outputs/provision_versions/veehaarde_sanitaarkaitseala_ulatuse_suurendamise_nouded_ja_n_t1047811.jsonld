      "estleg:provisionRef": "Reg_1047811 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047811_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047811_Par_7_v1047811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047811_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sanitaarkaitseala projekt peab sisaldama vähemalt järgmisi jooniseid: 1 1) asukoha ülevaatekaart mõõtkavas 1 : 25000 kuni 1 : 100 000; 2 2) asukohaplaan mõõtkavas 1 : 500 kuni 1 : 10 000; 3 3) sanitaarkaitseala plaan mõõtkavas 1 : 500 kuni 1 : 10 000; 4 4) veehaarde ehitiste joonised; 5 5) hüdrogeoloogilised ja põhjavee kaitstuse kaardid piirkonna kohta; 6 6) hüdrogeoloogilised läbilõiked piirkonna kohta; 7 7) kehtestatud põhjaveevaruga ala või alade kaart. Sanitaarkaitseala projekt peab sisaldama vähemalt järgmisi jooniseid: asukoha ülevaatekaart mõõtkavas 1 : 25000 kuni 1 : 100 000; asukohaplaan mõõtkavas 1 : 500 kuni 1 : 10 000; sanitaarkaitseala plaan mõõtkavas 1 : 500 kuni 1 : 10 000; veehaarde ehitiste joonised; hüdrogeoloogilised ja põhjavee kaitstuse kaardid piirkonna kohta; hüdrogeoloogilised läbilõiked piirkonna kohta; kehtestatud põhjaveevaruga ala või alade kaart.",
      "rdfs:label": {
        "@value": "Reg_1047811_Par_7 (redaktsioon 1047811)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047811",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047811",
      "estleg:sourceAct": "Veehaarde sanitaarkaitseala ulatuse suurendamise nõuded ja nõuded veehaarde sanitaarkaitseala projekti kohta ning joogiveehaarde toiteala ja valgala ulatus ning piirid",
      "estleg:provisionRef": "Reg_1047811 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047811_Map"
      }
    },
    {
      "@id": "estleg:Reg_1047811_Par_8_v1047811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047811_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Joogiveehaarde toiteala ulatus ja piirid määratakse hüdrogeoloogilise uuringu käigus hüdrodünaamiliste arvutustega ning need esitatakse veeseaduse § 852 kohase joogiveehaarde toiteala riskihindamise raames. Arvutuste aluseks on veehaarde kasutamise aeg, mille jooksul veekihti sattunud saasteained liikumisel veehaarde suunas ei jõua veel sinna. Joogiveehaarde toiteala ulatus ja piirid määratakse hüdrogeoloogilise uuringu käigus hüdrodünaamiliste arvutustega ning need esitatakse veeseaduse § 852 kohase joogiveehaarde toiteala riskihindamise raames. Arvutuste aluseks on veehaarde kasutamise aeg, mille jooksul veekihti sattunud saasteained liikumisel veehaarde suunas ei jõua veel sinna. 2 (2) Isikul, kes määrab joogiveehaarde toiteala ulatuse ja piirid, peab olema hüdrogeoloogiliste tööde tegevusluba hüdrogeoloogiliste uuringute valdkonnas. Isikul, kes määrab joogiveehaarde toiteala ulatuse ja piirid, peab olema hüdrogeoloogiliste tööde tegevusluba hüdrogeoloogiliste uuringute valdkonnas. 3 (3) Veeseaduse § 852 kohase joogiveehaarde valgala riskihindamise jaoks kasutatakse joogiveehaarde valgala ulatuse ning piiri andmetena joogiveehaarde veekogumi osavalgla Eestisse jääva osa andmeid Eesti looduse infosüsteemist. RT I 2023-04-20 1 120042023001 2023-04-23 Veeseaduse § 852 kohase joogiveehaarde valgala riskihindamise jaoks kasutatakse joogiveehaarde valgala ulatuse ning piiri andmetena joogiveehaarde veekogumi osavalgla Eestisse jääva osa andmeid Eesti looduse infosüsteemist.",
