      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kõrgharidustaseme õppe ainepunktide tasu ülemmäärad (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kõrgharidustaseme õppe ainepunktide tasu ülemmäärad"
    },
    {
      "@id": "estleg:Reg_1047470_Par_1_v1047470",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
