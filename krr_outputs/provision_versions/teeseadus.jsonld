    },
    {
      "@id": "estleg:TeeS_Par_45_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 16 sätestatud teehoiu rahastamise korda rakendatakse alates 2001. aasta 1. jaanuarist, kusjuures kütuseaktsiisist suunatakse teehoiu rahastamiseks: alates 2001. aasta 1. jaanuarist 55 protsenti; alates 2002. aasta 1. jaanuarist 65 protsenti; alates 2003. aasta 1. jaanuarist 75 protsenti. (2) Käesoleva seaduse § 17 lõikes 4 sätestatud nõuet tee-ehitusmaterjalide ja -toodete nõuetele vastavuse tõendamise suhtes rakendatakse 2001. aasta 1. juulist. (3) Käesoleva seaduse §-s 25 1 nimetatud teehoiutööde tegevusluba on nõutav alates 2001. aasta 1. juulist.",
      "rdfs:label": {
        "@value": "TeeS_Par_45 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_45_v828536"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22439",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 45",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
