    {
      "@id": "estleg:TeeS_Par_12_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa teedevõrgu registris olev tee peab olema tähistatud E-tähisega, riiklikus maanteeregistris olev tee riigimaantee tähisega ning kohalikus teeregistris olev tee kohaliku tee nime või tähisega. Tänav ja eratee peavad olema tähistatud nimega. (2) Asustusüksusesse sissesõidu tee ja sealt väljasõidu tee peab tee omanik tähistama suunaviitadega. (3) Teetähistussüsteemi ja selle rakendamise korra kehtestab teede- ja sideminister.",
      "rdfs:label": {
        "@value": "TeeS_Par_12 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:supersededByVersion": {
