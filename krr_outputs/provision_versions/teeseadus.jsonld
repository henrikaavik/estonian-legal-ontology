        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/696444",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 40",
