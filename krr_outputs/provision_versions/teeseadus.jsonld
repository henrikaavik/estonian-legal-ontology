      }
    },
    {
      "@id": "estleg:TeeS_Par_26_v129062014078",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigimaantee kasutamise eest tasu ei võeta. (2) Kui käesoleva paragrahvi lõikes 1 nimetamata tee omanik soovib rakendada Euroopa Parlamendi ja nõukogu direktiivi 2004/52/EÜ ühenduse elektroonilise maanteemaksu koostalitlusvõime kohta (ELT L 166, 30.04.2004, lk 124–143) kohast elektroonilist maanteemaksu, teavitab ta sellest valdkonna eest vastutavat ministrit, kes korra, millega tagatakse direktiivi nõuete täitmine.",
      "rdfs:label": {
        "@value": "TeeS_Par_26 (redaktsioon 129062014078)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014078",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014078",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_27_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teel paikneva melioratsiooni- ja hüdrotehnilise ning muu rajatise hoidu korraldab selle omanik tee omaniku nõusolekul. (2) Teed ületavat viadukti hoiab korras selle omanik.",
      "rdfs:label": {
        "@value": "TeeS_Par_27 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22439",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_28_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raudteeületuskoht on tee ja raudtee samatasandilise ristumise ala. (2) Raudteeületuskohal teeb ristumiskoha hoiutöid ja on kohustatud looma tingimused ohutuks liiklemiseks tee omanik ja raudtee omanik vastavalt neile kuuluva kinnisasja ulatuses. (3) Tee ja raudtee kattuvas kaitsevööndis teevad tee omanik ja raudtee omanik hoiutöid omavahelise kokkuleppe alusel.",
      "rdfs:label": {
        "@value": "TeeS_Par_28 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_28_v696444"
      },
      "estleg:versionValidTo": {
        "@value": "2004-01-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22439",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_28_v696444",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raudteeületuskoht on tee ja raudtee samatasandilise ristumise ala. [Lõike 2 sõnastus kuni 30. 03. 2004] (2) Raudteeületuskohal teeb ristumiskoha hoiutöid ja on kohustatud looma tingimused ohutuks liiklemiseks tee omanik ja raudtee omanik vastavalt neile kuuluva kinnisasja ulatuses. [Lõike 2 sõnastus alates 31. 03. 2004] (2) Raudteeületuskohal teeb ristumiskoha hoiutöid ja on kohustatud looma tingimused ohutuks liiklemiseks tee omanik ja raudteeinfrastruktuuri-ettevõtja või raudtee muu omanik või valdaja vastavalt nende valduses oleva kinnisasja ulatuses, välja arvatud talihooldustööde osas, mis on raudteeületuskoha terves ulatuses tee omaniku kohustus. Raudteeületuskohal talihooldustööde tegija peab talihooldustööde tehnoloogilised üksikasjad kooskõlastama raudteeinfrastruktuuri-ettevõtja või raudtee muu omaniku või valdajaga. (3) Tee ja raudtee kattuvas kaitsevööndis teevad tee omanik ja raudtee omanik hoiutöid omavahelise kokkuleppe alusel.",
      "rdfs:label": {
        "@value": "TeeS_Par_28 (redaktsioon 696444)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "696444",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_28_v828536"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/696444",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_28_v828536",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raudteeületuskoht on tee ja raudtee samatasandilise ristumise ala. (2) Raudteeületuskohal teeb ristumiskoha hoiutöid ja on kohustatud looma tingimused ohutuks liiklemiseks tee omanik ja raudteeinfrastruktuuri-ettevõtja või raudtee muu omanik või valdaja vastavalt nende valduses oleva kinnisasja ulatuses, välja arvatud talihooldustööde osas, mis on raudteeületuskoha terves ulatuses tee omaniku kohustus. Raudteeületuskohal talihooldustööde tegija peab talihooldustööde tehnoloogilised üksikasjad kooskõlastama raudteeinfrastruktuuri-ettevõtja või raudtee muu omaniku või valdajaga. (3) Tee ja raudtee kattuvas kaitsevööndis teevad tee omanik ja raudtee omanik hoiutöid omavahelise kokkuleppe alusel.",
      "rdfs:label": {
        "@value": "TeeS_Par_28 (redaktsioon 828536)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "828536",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_28_v12895156"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/828536",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_28_v12895156",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Raudteeületuskoht on tee ja raudtee samatasandilise ristumise ala. (2) Raudteeületuskohal teeb ristumiskoha hoiutöid ja on kohustatud looma tingimused ohutuks liiklemiseks tee omanik ja raudteeinfrastruktuuri-ettevõtja või raudtee muu omanik või valdaja nende valduses oleva kinnisasja ulatuses, välja arvatud talihooldustööde puhul, mis on raudteeületuskoha terves ulatuses tee omaniku kohustus. Tee talihooldustööde tegija ja raudteeinfrastruktuuri-ettevõtja või raudtee muu omanik või valdaja sõlmivad lepingu, milles on sätestatud talihooldustööde tehnilised üksikasjad. (3) Tee ja raudtee kattuvas kaitsevööndis teevad tee omanik ja raudtee omanik hoiutöid omavahelise kokkuleppe alusel.",
      "rdfs:label": {
        "@value": "TeeS_Par_28 (redaktsioon 12895156)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895156",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895156",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_29_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikult kasutatava tee maakasutuse sihtotstarve on transpordimaa. (2) Avalikult kasutatava tee seisundist või teehoiutöödest tingitud ajutiseks ümbersõiduks sõlmib tee omanik lepingu kinnistu omanikuga, kelle maal ümbersõiduks kasutatav tee asub. Lepingut ei pea sõlmima avarii ja loodusõnnetuse korral. (3) Avalikult kasutatava tee omanikul on õigus anda teemaad maakasutust reguleerivate õigusaktide kohaselt kasutada teisele isikule ilma hoonestusõiguseta tingimusel, etseeei raskenda teehoidu ega halvenda liiklusolusid. (4) Teealuses maapõue osas tehtavate kaevandamistööde suhtes, välja arvatud allmaaehitiste rajamine, ei kohaldata maapõueseadust (RT I 1994, 86/87, 1488; 1995, 75, 1321; 1996, 49, 953; 1997, 52, 833; 86, 1461; 93, 1562; 1998, 64/65, 1005; 1999, 10, 155).",
      "rdfs:label": {
        "@value": "TeeS_Par_29 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_29_v170179"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22439",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_29_v170179",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
