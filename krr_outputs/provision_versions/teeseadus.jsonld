    {
      "@id": "estleg:TeeS_Par_1_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teeseadus sätestab tee suhtes esitatavad nõuded, tee omaniku ja liikleja õigused ja kohustused ning vastutuse liiklusohutusnõuete rikkumise eest, reguleerib teehoiu, tee kasutuse ja kaitse korraldamist ja rahastamist ning inimeste ja keskkonna kaitset liiklusest tulenevate ohtude eest.",
      "rdfs:label": {
        "@value": "TeeS_Par_1 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_1_v186707"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22439",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_1_v186707",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teeseadus sätestab tee suhtes esitatavad nõuded, tee omaniku ja liikleja õigused ja kohustused ning vastutuse liiklusohutusnõuete rikkumise eest, reguleerib teehoiu, tee kasutuse ja kaitse korraldamist ja rahastamist ning inimeste ja keskkonna kaitset liiklusest tulenevate ohtude eest. (2) Käesolevas seaduses ettenähtud haldusmenetlusele kohaldatakse haldusmenetluse seaduse (RT I 2001, 58, 354) sätteid, arvestades käesoleva seaduse erisusi.",
      "rdfs:label": {
        "@value": "TeeS_Par_1 (redaktsioon 186707)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186707",
