      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teetööde tehnoloogia ja kvaliteet peavad vastama liiklusohutus- ja keskkonnakaitse- ning tee seisundi kohta esitatavatele nõuetele. (2) Tee ja teetööde kvaliteedinõuded",
      "rdfs:label": {
        "@value": "TeeS_Par_30 (redaktsioon 12895156)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895156",
