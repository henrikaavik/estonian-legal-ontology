        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/194464",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 41",
      "estleg:partOfAct": {
