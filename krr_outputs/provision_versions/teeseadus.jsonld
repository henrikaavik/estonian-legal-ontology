      },
      "estleg:versionValidTo": {
        "@value": "2005-02-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/828536",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_10_v854541",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teel peab olema võimalik ohutult liigelda ning tee peab vastama tee seisundi nõuetele. (2) Tee ohutusrajatiste, liiklusmärkide, fooride, piirete, tähispostide ja teemärgistuse kohta ning riigimaantee, kohaliku tee ja talitee seisundi kohta esitatavad nõuded kehtestab majandus- ja kommunikatsiooniminister. (3) Metsatee seisundi kohta esitatavad nõuded kehtestab keskkonnaminister. (4) Avalikult kasutatava tee omanik või teehoiu korraldamise eest vastutavaks määratud isik on kohustatud hoidma tee käesolevas seaduses ja selle alusel kehtestatud õigusaktidega sätestatud nõuetele vastavas seisundis.",
      "rdfs:label": {
        "@value": "TeeS_Par_10 (redaktsioon 854541)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "854541",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_10_v962374"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/854541",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
