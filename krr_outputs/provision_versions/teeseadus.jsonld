      }
    },
    {
      "@id": "estleg:TeeS_Par_24_v179223",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teeprojekti ja muud olulised dokumendid peab säilitama tee omanik. Teekasutusloa saamisest arvates kümne aasta pärast antakse teedokumendid arhiivi, kus neid säilitatakse arhiiviseaduses (RT I 1998, 36/37, 552; 1999, 16, 271) sätestatud korras.",
      "rdfs:label": {
        "@value": "TeeS_Par_24 (redaktsioon 179223)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179223",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_24_v12895156"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/179223",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_24_v12895156",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teeprojekti ja muud olulised dokumendid peab säilitama tee omanik. Teekasutusloa saamisest arvates kümne aasta pärast antakse teedokumendid arhiivi, kus neid säilitatakse arhiiviseaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "TeeS_Par_24 (redaktsioon 12895156)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895156",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895156",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 24",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_25_v22439",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Teehoidu korraldab tee omanik Euroopa lepingu (RT II 1995,22-27, 120), riigihangete seaduse (RT I 2000, 84, 534; 2001, 34, 189) ja käesoleva seaduse ning nende alusel antud õigusaktide kohaselt. (2) Maanteeamet korraldab riigi omandis olevatel teedel teehoidu ja on kohustatud looma tingimused ohutuks liiklemiseks nendel teedel. (3) Valla- või linnavalitsus korraldab kohaliku omavalitsuse omandis olevatel teedel teehoidu ja on kohustatud looma tingimused ohutuks liiklemiseks nendel teedel. (4) Eratee omanik korraldab tema omandis oleval teel teehoidu ja on kohustatud looma tingimused ohutuks liiklemiseks tema teel. (5) Talitee rajaja korraldab teehoidu taliteel ja on kohustatud looma tingimused ohutuks liiklemiseks tema rajatud teel. (6) Teehoiutööde ajal tagab liiklusohutuse teehoiutöö tegija. Teehoiu korraldamise eest vastutava isiku määravad tee omanik ja teehoiutööde tegija lepinguga. (7) Linnas, alevis ja alevikus on teega külgneva territooriumi kasutaja kohustatud tegema heakorratöid sõidutee ja vastava territooriumi vahel oleval kõnniteel.",
      "rdfs:label": {
        "@value": "TeeS_Par_25 (redaktsioon 22439)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22439",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_25_v186707"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22439",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 25",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
