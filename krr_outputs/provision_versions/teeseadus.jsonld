      }
    },
    {
      "@id": "estleg:TeeS_Par_26_v12895156",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigimaantee kasutamise eest tasu ei võeta. (2) Kui käesoleva paragrahvi lõikes 1 nimetamata tee omanik soovib rakendada Euroopa Parlamendi ja nõukogu direktiivi 2004/52/EÜ ühenduse elektroonilise maanteemaksu koostalitlusvõime kohta (ELT L 166, 30.04.2004, lk 124–143) kohast elektroonilist maanteemaksu, teavitab ta sellest majandus- ja kommunikatsiooniministrit, kes kehtestab seejärel mõistliku aja jooksul määrusega korra, millega tagatakse direktiivi nõuete täitmine.",
      "rdfs:label": {
        "@value": "TeeS_Par_26 (redaktsioon 12895156)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12895156",
      "estleg:supersededByVersion": {
        "@id": "estleg:TeeS_Par_26_v130122011035"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12895156",
      "estleg:sourceAct": "Teeseadus",
      "estleg:provisionRef": "TeeS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:TeeS_Map"
      }
    },
    {
      "@id": "estleg:TeeS_Par_26_v130122011035",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
