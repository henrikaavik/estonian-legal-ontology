    {
      "@id": "estleg:TeeS_Par_20_v962374",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TeeS_Par_20"
      },
      "estleg:versionValidFrom": {
