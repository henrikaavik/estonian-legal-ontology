      },
      "dc:source": "Kuusalu valla ja Loksa valla haldusterritoriaalse korralduse ja sellega seonduvalt Vabariigi Valitsuse määruste muutmine"
    },
    {
      "@id": "estleg:Reg_158837_Par_1_v158837",
      "@type": [
