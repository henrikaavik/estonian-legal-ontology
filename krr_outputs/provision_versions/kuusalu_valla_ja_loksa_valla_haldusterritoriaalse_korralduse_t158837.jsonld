        "@value": "2005-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kuusalu valla ja Loksa valla ühinemisel moodustatakse uus kohaliku omavalitsuse üksus Kuusalu vald.",
      "rdfs:label": {
        "@value": "Reg_158837_Par_1 (redaktsioon 158837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158837",
