    },
    {
      "@id": "estleg:Reg_158837_Par_2_v158837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158837_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Moodustatava Kuusalu valla piiriks kehtestatakse seniste Kuusalu valla ja Loksa valla piir, välja arvatud seniste Kuusalu valla ja Loksa valla vaheline piir.",
      "rdfs:label": {
        "@value": "Reg_158837_Par_2 (redaktsioon 158837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158837",
