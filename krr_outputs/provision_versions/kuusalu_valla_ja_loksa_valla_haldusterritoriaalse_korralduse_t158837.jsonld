      "estleg:sourceAct": "Kuusalu valla ja Loksa valla haldusterritoriaalse korralduse ja sellega seonduvalt Vabariigi Valitsuse määruste muutmine",
      "estleg:provisionRef": "Reg_158837 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158837_Map"
      }
    },
    {
      "@id": "estleg:Reg_158837_Par_3_v158837",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158837_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maa-amet kannab muudatused katastrikaardile.",
      "rdfs:label": {
        "@value": "Reg_158837_Par_3 (redaktsioon 158837)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158837",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158837",
      "estleg:sourceAct": "Kuusalu valla ja Loksa valla haldusterritoriaalse korralduse ja sellega seonduvalt Vabariigi Valitsuse määruste muutmine",
      "estleg:provisionRef": "Reg_158837 § 3",
      "estleg:partOfAct": {
