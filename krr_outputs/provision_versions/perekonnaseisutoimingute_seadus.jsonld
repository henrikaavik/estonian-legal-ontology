    {
      "@id": "estleg:PKTS_Par_20_v130122017005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKTS_Par_20"
      },
      "estleg:versionValidFrom": {
