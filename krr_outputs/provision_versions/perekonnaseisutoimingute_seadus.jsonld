    {
      "@id": "estleg:PKTS_Par_4_v130122017005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKTS_Par_4"
      },
      "estleg:versionValidFrom": {
