      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sugu muutnud isikule väljastatakse perekonnaseisuandmete väljavõte soo andmete muutmise kohta. (2) Soo muutmise tõendi vormi (3) Taotluse korral lisatakse soo muutmise tõendile väljavõte muudest andmetest. (4) Soo muutmise tõendi väljastamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "PKTS_Par_49_2 (redaktsioon 123122013055)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122013055",
      "estleg:supersededByVersion": {
        "@id": "estleg:PKTS_Par_49_2_v131122015033"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-01",
