      }
    },
    {
      "@id": "estleg:PKTS_Par_49_v106072023063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:PKTS_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Abielu lahutamise tõendamiseks väljastatakse kinnitatud väljavõte järgmistest rahvastikuregistri andmetest: mõlema lahutatud abikaasa isikunimi, isikukood ja sünniaeg; perekonnanimi pärast abielu lahutamist; abielu lahutanud asutuse nimetus; abielu lahutamise kuupäev; kande number. (2) Taotluse korral lisatakse väljavõte muudest andmetest. (3) Abielulahutuse tõendi vormi kehtestab määrusega. (4) Abielulahutuse tõendi väljastamise eest tasutakse riigilõivu riigilõivuseaduses sätestatud määras.",
      "rdfs:label": {
        "@value": "PKTS_Par_49 (redaktsioon 106072023063)",
        "@language": "et"
      },
