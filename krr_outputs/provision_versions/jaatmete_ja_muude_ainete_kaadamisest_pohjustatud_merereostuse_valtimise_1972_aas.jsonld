        "@value": "Sätete redaktsioonid: Jäätmete ja muude ainete kaadamisest põhjustatud merereostuse vältimise 1972. aasta konventsiooni 1996. aasta protokolliga ühinemise seadus (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Jäätmete ja muude ainete kaadamisest põhjustatud merereostuse vältimise 1972. aasta konventsiooni 1996. aasta protokolliga ühinemise seadus"
    },
    {
      "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_1_v225042013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda juurdelisatud , mis on koostatud 1996. aasta 7. novembril Londonis (edaspidi 1996. aasta protokoll).",
      "rdfs:label": {
        "@value": "jaatmete_ja_muude_ainete_kaadamisest_poh_Par_1 (redaktsioon 225042013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "225042013001"
    },
    {
      "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_2_v225042013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teha 1996. aasta protokolliga ühinemisel protokolli artikli 16 lõike 5 alusel deklaratsioon, et artikli 3 lõike 1 või 2 tõlgendamist või kohaldamist käsitleva vaidluse lahendamiseks lisas 3 sätestatud vahekohtumenetluse kohaselt on iga kord vajalik Eesti Vabariigi nõusolek.",
      "rdfs:label": {
        "@value": "jaatmete_ja_muude_ainete_kaadamisest_poh_Par_2 (redaktsioon 225042013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "225042013001"
    },
    {
      "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_3_v225042013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-05-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1996. aasta protokolli kohaste lubade andmist ja artikli 9 lõikes 4 nimetatud andmete esitamist Läänemere Merekeskkonna Kaitse Komisjonile või Rahvusvahelisele Mereorganisatsioonile korraldab Keskkonnaministeerium.",
      "rdfs:label": {
        "@value": "jaatmete_ja_muude_ainete_kaadamisest_poh_Par_3 (redaktsioon 225042013001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "225042013001",
      "estleg:supersededByVersion": {
