      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_3_v216012024008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1996. aasta protokolli kohaste lubade andmist ja artikli 9 lõikes 4 nimetatud andmete esitamist Läänemere Merekeskkonna Kaitse Komisjonile või Rahvusvahelisele Mereorganisatsioonile korraldab Kliimaministeerium. ; Vabariigi Valitsuse seaduse § 105.19 lõike 6 alusel asendatud sõna „Keskkonnaministeerium” sõnaga „Kliimaministeerium”.",
      "rdfs:label": {
        "@value": "jaatmete_ja_muude_ainete_kaadamisest_poh_Par_3 (redaktsioon 216012024008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "216012024008"
    },
    {
      "@id": "estleg:jaatmete_ja_muude_ainete_kaadamisest_poh_Par_4_v225042013001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
