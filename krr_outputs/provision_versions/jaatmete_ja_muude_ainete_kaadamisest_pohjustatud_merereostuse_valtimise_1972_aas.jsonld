        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet 1996. aasta protokolli kohaselt keelatud tegevuse tuvastamiseks teostab Keskkonnainspektsioon.",
      "rdfs:label": {
        "@value": "jaatmete_ja_muude_ainete_kaadamisest_poh_Par_4 (redaktsioon 225042013001)",
