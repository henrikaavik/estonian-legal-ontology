      }
    },
    {
      "@id": "estleg:Reg_158907_Par_8_v158907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158907_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevööndis on keelatud: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine. Sihtkaitsevööndis on keelatud: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine. 2 (2) Tänavjärve sihtkaitsevööndis on keelatud jahipidamine 1. veebruarist 1. augustini. Tänavjärve sihtkaitsevööndis on keelatud jahipidamine 1. veebruarist 1. augustini.",
      "rdfs:label": {
        "@value": "Reg_158907_Par_8 (redaktsioon 158907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158907",
      "estleg:sourceAct": "Läänemaa Suursoo maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158907 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158907_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158907_Par_9_v158907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158907_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; 2 2) tee-ehitus, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks ja olemasolevate ehitiste hooldustööd; 3 3) Karuste sihtkaitsevööndis 1. detsembrist 1. märtsini külmunud pinnasel metsakoosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas. Kaitseala valitseja nõusolekul on sihtkaitsevööndis lubatud: kaitsealuste liikide elutingimuste säilitamiseks ja poollooduslike koosluste ilme ja liigikoosseisu tagamiseks vajalik tegevus; tee-ehitus, tehnovõrgu rajatise või tootmisotstarbeta ehitise püstitamine kaitsealal paikneva kinnistu või kaitseala tarbeks ja olemasolevate ehitiste hooldustööd; Karuste sihtkaitsevööndis 1. detsembrist 1. märtsini külmunud pinnasel metsakoosluse kujundamine vastavalt kaitse-eesmärgile, kusjuures kaitseala valitsejal on õigus esitada nõudeid raieaja ja -tehnoloogia, metsamaterjali kokku- ja väljaveo ning puistu koosseisu ja täiuse osas.",
      "rdfs:label": {
        "@value": "Reg_158907_Par_9 (redaktsioon 158907)",
        "@language": "et"
      },
