      }
    },
    {
      "@id": "estleg:Reg_158907_Par_7_v158907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158907_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. Kaitseala sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike ja poollooduslike koosluste säilitamiseks. 2 (2) Kaitsealal on seitse sihtkaitsevööndit: 1 1) Karuste sihtkaitsevöönd; 2 2) Tänavjärve sihtkaitsevöönd; 3 3) Kõrgeraba sihtkaitsevöönd; 4 4) Leotusraba sihtkaitsevöönd; 5 5) Linnuraba sihtkaitsevöönd; 6 6) Inka sihtkaitsevöönd; 7 7) Väljaraba sihtkaitsevöönd. Kaitsealal on seitse sihtkaitsevööndit: Karuste sihtkaitsevöönd; Tänavjärve sihtkaitsevöönd; Kõrgeraba sihtkaitsevöönd; Leotusraba sihtkaitsevöönd; Linnuraba sihtkaitsevöönd; Inka sihtkaitsevöönd; Väljaraba sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_158907_Par_7 (redaktsioon 158907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158907",
      "estleg:sourceAct": "Läänemaa Suursoo maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158907 § 7",
      "estleg:partOfAct": {
