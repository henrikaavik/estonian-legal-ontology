        "@value": "2004-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud töötleja rahvastikuregistri pidamise tulude ja kulude eelarve kinnitab ja eelarve täitmist kontrollib regionaalminister.",
      "rdfs:label": {
        "@value": "RRS_Par_91 (redaktsioon 733571)",
        "@language": "et"
      },
