      }
    },
    {
      "@id": "estleg:RRS_Par_86_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_86"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui kohaliku omavalitsuse üksuse territooriumil püsivalt viibiva rahvastikuregistri subjektiks oleva isiku elukoha aadress ei ole kantud rahvastikuregistrisse või isiku kinnitusel ei kasuta ta enam rahvastikuregistrisse kantud aadressijärgset elukohta, peab kohaliku omavalitsuse üksus algatama elukoha aadressi rahvastikuregistrisse kandmise või muutmise käesoleva seaduse §-s 85 nimetatud asutuse või isiku antud andmete alusel käesolevas peatükis sätestatud korras.",
      "rdfs:label": {
        "@value": "RRS_Par_86 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 86",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_87_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aktis märgitud puuduste ja rikkumiste kõrvaldamistest või järelevalve tulemusel tehtud ettekirjutuste täitmisest teavitab järelevalvealune asutus või isik vastutavat töötlejat ja Andmekaitse Inspektsiooni aktis ettenähtud tähtaja jooksul või, kui sellist tähtaega ei määratud, ühe kuu jooksul akti koostamisest. (2) Kui järelevalvet teostati andmeandja või andmesaaja üle, teavitatakse järelevalve tulemustega arvestamisest ka volitatud töötlejat.",
      "rdfs:label": {
        "@value": "RRS_Par_87 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_87_v186525"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 87",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_87_v186525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Järelevalve tulemusel tehtud ettekirjutuste täitmisest teavitab järelevalvealune asutus või isik vastutavat töötlejat ja Andmekaitse Inspektsiooni ettekirjutuses ettenähtud tähtaja jooksul või, kui sellist tähtaega ei määratud, ühe kuu jooksul ettekirjutuse teatavakstegemisest. (2) Kui järelevalvet teostati andmeandja või andmesaaja üle, teavitatakse järelevalve tulemustega arvestamisest ka volitatud töötlejat.",
      "rdfs:label": {
        "@value": "RRS_Par_87 (redaktsioon 186525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "186525",
