    {
      "@id": "estleg:RRS_Par_46_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisel ja juriidilisel isikul on õigustatud huvi korral õigus pääseda juurde järgmistele rahvastikuregistri andmetele: käesoleva seaduse § 21 lõikes 1 ja § 22 lõike 1 punktis 1 sätestatud andmed; isiku surma tõttu rahvastikuregistri subjekti staatuse kaotanud isiku andmed. (2) Õigustatud huviga on tegemist eelkõige juhtudel, kui andmete väljastamist taotletakse: taotleja või muu isiku elu, tervise ning õiguste ja vabaduste kaitseks; taotlejaga sõlmitud lepingu täitmiseks või lepingu täitmise tagamiseks; teaduslikul eesmärgil, lähtudes isikuandmete kaitse seaduses sätestatud tingimustest.",
      "rdfs:label": {
        "@value": "RRS_Par_46 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_46_v113032019128"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 46",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_46_v113032019128",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_46"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Füüsilisel ja juriidilisel isikul on õigustatud huvi korral õigus pääseda juurde järgmistele rahvastikuregistri andmetele: käesoleva seaduse § 21 lõikes 1 ja § 22 lõike 1 punktis 1 sätestatud andmed; isiku surma tõttu rahvastikuregistri subjekti staatuse kaotanud isiku andmed. (2) Õigustatud huviga on tegemist eelkõige juhtudel, kui andmete väljastamist taotletakse: taotleja või muu isiku elu, tervise ning õiguste ja vabaduste kaitseks; taotlejaga sõlmitud lepingu täitmiseks või lepingu täitmise tagamiseks; teaduslikul eesmärgil, lähtudes Euroopa Parlamendi ja nõukogu määruses (EL) 2016/679 sätestatud tingimustest.",
      "rdfs:label": {
        "@value": "RRS_Par_46 (redaktsioon 113032019128)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019128",
