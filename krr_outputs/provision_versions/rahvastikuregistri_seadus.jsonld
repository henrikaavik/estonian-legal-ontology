      }
    },
    {
      "@id": "estleg:RRS_Par_91_v115032014042",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud töötleja rahvastikuregistri pidamise tulude ja kulude eelarve kinnitab ja eelarve täitmist kontrollib valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "RRS_Par_91 (redaktsioon 115032014042)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "115032014042",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_91_v122122018013"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/115032014042",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 91",
      "estleg:partOfAct": {
