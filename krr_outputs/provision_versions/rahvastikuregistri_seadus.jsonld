      }
    },
    {
      "@id": "estleg:RRS_Par_52_v122112013002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitatud töötleja moodustab ja annab isikule uue isikukoodi: lapse põlvnemise andmete muutmisel vanema või eestkostja avalduse alusel; isiku soo andmete muutmisel isiku avalduse ja arstliku ekspertiisikomisjoni otsuse alusel; käesoleva seaduse § 21 lõike 1 punktides 3 ja 4 sätestatud rahvastikuregistrisse kantud isikuandmete parandamisel või muutmisel. (2) Uue isikukoodi andmisest teatab volitatud töötleja andmesaajatele, kes saavad rahvastikuregistrist andmeid nende poolt peetavatesse andmekogudesse või väljaantavatesse dokumentidesse kandmiseks. (3) Uue isikukoodi andmisel korraldab perekonnaseisuasutus uut isikukoodi kajastava väljavõtte kättetoimetamise ja isikut tõendavat dokumenti väljaandev asutus uue isikut tõendava dokumendi väljastamise.",
      "rdfs:label": {
        "@value": "RRS_Par_52 (redaktsioon 122112013002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122112013002",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_52_v130122017011"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122112013002",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 52",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_52_v130122017011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Volitatud töötleja moodustab ja annab isikule uue isikukoodi: lapse põlvnemise andmete muutmisel vanema või eestkostja avalduse alusel; isiku soo andmete muutmisel isiku avalduse ja arstliku ekspertiisikomisjoni otsuse alusel; käesoleva seaduse § 21 lõike 1 punktides 3 ja 4 sätestatud rahvastikuregistrisse kantud isikuandmete parandamisel, muutmisel või taastamisel. (2) Uue isikukoodi andmisest teatab volitatud töötleja andmesaajatele, kes saavad rahvastikuregistrist andmeid nende poolt peetavatesse andmekogudesse või väljaantavatesse dokumentidesse kandmiseks. (3) Uue isikukoodi andmisel korraldab perekonnaseisuasutus uut isikukoodi kajastava väljavõtte kättetoimetamise ja isikut tõendavat dokumenti väljaandev asutus uue isikut tõendava dokumendi väljastamise.",
      "rdfs:label": {
        "@value": "RRS_Par_52 (redaktsioon 130122017011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122017011",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_52_v122122018013"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122017011",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 52",
      "estleg:partOfAct": {
