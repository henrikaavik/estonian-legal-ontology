      }
    },
    {
      "@id": "estleg:RRS_Par_37_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvastikuregistri subjekti staatust mittesaava isiku andmed kantakse rahvastikuregistrisse: enne rahvastikuregistri loomist koostatud Eesti perekonnasündmuse dokumendi andmete rahvastikuregistrisse kandmisel; Eesti perekonnasündmuse registreerimisel; isikut tõendava dokumendi väljaandmisel; isikukoodi andmisel isiku riigi andmekogusse kandmise eesmärgil; käesoleva seaduse §-s 36 sätestatud ettevalmistava staatusega isiku rahvastikuregistri subjektina arvelevõtmise aluse äralangemisel.",
      "rdfs:label": {
        "@value": "RRS_Par_37 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 37",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_38_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregistri andmete muutmise või parandamise korral kantakse rahvastikuregistri aktuaalsete andmete hulka uued andmed ja rahvastikuregistri arhiivi rahvastikuregistri varasemad andmed. (2) Andmete parandamisel kantakse ebaõiged andmed rahvastikuregistri arhiivi koos andmetega selle kohta, kes, mille tõttu ja millal vea tegi.",
      "rdfs:label": {
        "@value": "RRS_Par_38 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_38_v122122018013"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_38_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregistri subjekti staatus lõpeb: rahvastikuregistri subjekti surma korral; Eesti kodakondsuse kaotamisel; rahvastikuregistri subjekti staatust määrava dokumendi tähtaja lõppemisel, tühistamisel või kehtetuks tunnistamisel; Euroopa Liidu, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodanikul elamisõiguse lõppemisel; ekslikult rahvastikuregistri subjektina arvelevõtmise tuvastamisel; kui rahvastikuregistri subjekt on vähemalt 100 aastat vana ja rahvastikuregistrisse ei ole kantud tema kehtiva isikut tõendava dokumendi andmeid; kui Eesti kodanik saab 21 aastat vanaks ning tema andmed on rahvastikuregistrisse kantud, ta on rahvastikuregistri subjektiks saanud välisriigi sünnidokumendi alusel ja vähemalt ühel tema vanemal oli tema sünni ajal Eesti kodakondsus, talle ei ole välja antud isikut tõendavate dokumentide seaduse § 2 lõike 2 punktis 1 või 2 sätestatud Eesti isikut tõendavat dokumenti ning isiku viibimiskohana ei ole rahvastikuregistrisse kantud käesoleva seaduse § 96 lõike 1 punktis 4 nimetatud viibimiskohta; kui Eesti kodanikule, kelle andmed on kantud rahvastikuregistrisse valijate nimekirja alusel, ei ole välja antud isikut tõendavate dokumentide seaduse § 2 lõike 2 punktis 1 või 2 sätestatud Eesti isikut tõendavat dokumenti. (2) Käesoleva paragrahvi lõike 1 punktis 3 nimetatud rahvastikuregistri subjekti staatust määrava dokumendi tähtaja lõppemisel lõpeb välismaalase rahvastikuregistri subjekti staatus välismaalaste seaduse § 43 lõikes 4 või 5 sätestatud tähtaja saabumisel, kui välismaalane ei ole taotlenud elamisloa pikendamist, uut tähtajalist elamisluba või pikaajalise elaniku elamisluba.",
      "rdfs:label": {
        "@value": "RRS_Par_38 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_38_v121112025007"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 38",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_38_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_38"
      },
      "estleg:versionValidFrom": {
