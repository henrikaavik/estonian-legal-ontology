      }
    },
    {
      "@id": "estleg:RRS_Par_16_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Lepingu lõpetamine vormistatakse aktiga, milles sätestatakse: rahvastikuregistri pidamise uuele volitatud töötlejale üleandmise kord ja tähtajad; lepingupoolte lepingu lõpetamise järgsed õigused ja kohustused. (2) Aktile kirjutavad alla vastutava ja volitatud töötleja ning riigi infosüsteemide arendamist koordineeriva asutuse ja Andmekaitse Inspektsiooni volitatud esindajad.",
      "rdfs:label": {
        "@value": "RRS_Par_16 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
