    {
      "@id": "estleg:RRS_Par_80_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi elukoha aadressi kandmiseks rahvastikuregistrisse esitab välisriigis alaliselt või peamiselt elav rahvastikuregistri subjekt kirjalikult elukohateate viimase Eesti elukoha järgsele kohaliku omavalitsuse üksusele. (2) Elukohateatega välisriigi aadressi esitades ei pea lisama eluruumi kasutamise õigust tõendavat dokumenti ega eluruumi omaniku nõusolekut elukohateates nimetatud elukoha andmete kandmiseks rahvastikuregistrisse. (3) Elukohateates märgitakse täpne elukoha aadress välisriigis, selle puudumisel vähemalt riigi nimi.",
      "rdfs:label": {
        "@value": "RRS_Par_80 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_80_v112032022013"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 80",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_80_v112032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_80"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisriigi elukoha aadressi kandmiseks rahvastikuregistrisse esitab rahvastikuregistri subjekt elukohateate rahvastikuregistrisse kantud Eesti elukoha järgsele kohaliku omavalitsuse üksusele ja käesoleva seaduse §-s 95 nimetamata isik rahvastikuregistris Eesti elukoha puudumise korral volitatud töötlejale. (2) Elukohateatega välisriigi aadressi esitades ei pea lisama eluruumi kasutamise õigust tõendavat dokumenti ega eluruumi omaniku nõusolekut elukohateates nimetatud elukoha andmete kandmiseks rahvastikuregistrisse. (3) Elukohateates märgitakse täpne elukoha aadress välisriigis, selle puudumisel vähemalt riigi nimi.",
      "rdfs:label": {
        "@value": "RRS_Par_80 (redaktsioon 112032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032022013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 80",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_81_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvastikuregistrist väljastatud andmete ristkasutus teistest andmekogudest saadud või andmesaaja enda poolt kogutud andmetega on lubatud ainult seaduses või seaduse alusel antud õigusaktis sätestatud juhtudel Andmekaitse Inspektsiooni loal.",
      "rdfs:label": {
        "@value": "RRS_Par_81 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_81_v900682"
      },
      "estleg:versionValidTo": {
