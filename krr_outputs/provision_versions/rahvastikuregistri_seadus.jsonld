      }
    },
    {
      "@id": "estleg:RRS_Par_110_1_v112032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_110_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui enne käesoleva paragrahvi jõustumist on Euroopa Liidu kodanikul, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodanikul tekkinud käesoleva seaduse § 91 lõike 2 ja § 110 alusel riigi täpsusega elukoha aadress, lõpetatakse tema elukoha andmete kehtivus rahvastikuregistris kuus kuud pärast käesoleva paragrahvi jõustumist.",
      "rdfs:label": {
        "@value": "RRS_Par_110_1 (redaktsioon 112032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_110_1_v121112025007"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032022013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 110_1",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_110_1_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_110_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui enne käesoleva paragrahvi jõustumist on Euroopa Liidu kodanikul tekkinud käesoleva seaduse § 91 lõike 2 ja § 110 alusel riigi täpsusega elukoha aadress, lõpetatakse tema elukoha andmete kehtivus rahvastikuregistris kuus kuud pärast käesoleva paragrahvi jõustumist.",
      "rdfs:label": {
        "@value": "RRS_Par_110_1 (redaktsioon 121112025007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121112025007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121112025007",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 110_1",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_110_2_v104082022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_110_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui enne käesoleva seaduse jõustumist on isiku elukoha andmed kantud rahvastikuregistrisse kohaliku omavalitsuse üksuse algatusel asustusüksuse täpsusega, võib kohaliku omavalitsuse üksus lõpetada isiku elukoha andmete kehtivuse kohaliku omavalitsuse üksuse algatusel vastavalt käesoleva seaduse §-s 871 sätestatule.",
      "rdfs:label": {
        "@value": "RRS_Par_110_2 (redaktsioon 104082022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104082022013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/104082022013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 110_2",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_110_3_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_110_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui enne käesoleva paragrahvi jõustumist on rahvastikuregistrisse kantud alla 15-aastase isiku kontaktandmed, lõpetatakse nende kehtivus.",
      "rdfs:label": {
        "@value": "RRS_Par_110_3 (redaktsioon 121112025007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121112025007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121112025007",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 110_3",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_111_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_111"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-s 49 sätestatud rahvastikuregistri andmetele juurdepääsu menetlemise infosüsteemi kasutusele võtmiseni menetletakse andmetele juurdepääsu taotlusi tavapärase asjaajamiskorra kohaselt. (2) Enne käesoleva seaduse jõustumist rahvastikuregistri andmete töötlemiseks sõlmitud lepingute tingimused, samuti käesoleva seaduse § 50 lõike 1 alusel antud haldusaktid kantakse juurdepääsu menetlemise infosüsteemi selle kasutusele võtmisest arvates. Lepingud kehtivad kuni käesoleva seaduse § 50 lõikes 1 sätestatud tingimuste kandmiseni rahvastikuregistri andmetele juurdepääsu menetlemise infosüsteemi, millega loetakse juurdepääs antuks käesoleva seaduse kohaselt.",
      "rdfs:label": {
        "@value": "RRS_Par_111 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 111",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva seaduse jõustumist isikuandmetele ja nendega seotud andmetele isiku taotlusel kehtestatud juurdepääsu piirang, mis ei vasta käesoleva seaduse § 57 lõikes 1 sätestatud eesmärkidele, loetakse käesoleva seaduse jõustumisel kehtestatuks käesoleva seaduse § 57 lõikes 1 sätestatud eesmärkidel.",
      "rdfs:label": {
        "@value": "RRS_Par_112 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_1_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui hääleõigusliku isiku elukoha aadress on käesoleva seaduse § 83 lõike 2 alusel kantud rahvastikuregistrisse vähemalt linna ja linnaosa või valla täpsusega ajavahemikul 2019. aasta Riigikogu valimiste eelhääletamise esimesest päevast kuni Riigikogu valimiste päevani, lõpeb tema elukoha andmete kehtivus, kui nendes ei ole tehtud muudatust nelja kuu jooksul andmete rahvastikuregistrisse kandmisest arvates.",
      "rdfs:label": {
        "@value": "RRS_Par_112_1 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112_1",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_2_v131012020016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses käsitatakse Euroopa Liidu kodanikuna ka Ühendkuningriigi kodanikku, kes omandab elamisõiguse Eestis enne 2021. aasta 1. aprilli.",
      "rdfs:label": {
        "@value": "RRS_Par_112_2 (redaktsioon 131012020016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131012020016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/131012020016",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112_2",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_3_v112032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 50 lõikes 21 nimetatud oskusi ja teadmisi ei kontrollita isiku puhul, kellel on käesoleva paragrahvi jõustumisel § 50 lõikes 21 nimetatud juurdepääs rahvastikuregistri andmetele.",
      "rdfs:label": {
        "@value": "RRS_Par_112_3 (redaktsioon 112032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032022013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112_3",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_4_v112032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 80 lõike 1, § 81 lõike 2 ja § 991 rakendamiseks luuakse rahvastikuregistri tehniline valmisolek 2024. aasta 1. jaanuariks.",
      "rdfs:label": {
        "@value": "RRS_Par_112_4 (redaktsioon 112032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032022013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112_4",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_5_v118102024003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui isik viibib käesoleva seaduse § 96 lõike 1 punktis 1 nimetatud viibimiskohas ja tema elukoha aadressina on enne käesoleva seaduse jõustumist rahvastikuregistrisse kantud ööpäevaringset sotsiaalteenust osutava hoolekandeasutuse aadress, kantakse kohaliku omavalitsuse üksuse algatusel 11. peatükis sätestatud korras isiku elukoha aadressina rahvastikuregistrisse tema viibimiskoha aadress linna ja linnaosa või valla täpsusega. (2) Käesoleva paragrahvi lõiget 1 kohaldatakse ka isikule, kes viibib käesoleva seaduse § 96 lõike 1 punktis 1 nimetatud viibimiskohas ja kelle viimase, ruumi täpsusega esitatud elukoha aadressina oli enne käesoleva seaduse jõustumist rahvastikuregistrisse kantud ööpäevaringset sotsiaalteenust osutava hoolekandeasutuse aadress, kuid kelle: kehtiv elukoha aadress rahvastikuregistris on ööpäevaringset sotsiaalteenust osutava hoolekandeasutuse asukoha järgne linn ja linnaosa, vald või asustusüksus; elukoha aadressina kanti seejärel rahvastikuregistrisse või säilitati selles ööpäevaringset sotsiaalteenust osutava hoolekandeasutuse asukoha järgne linn ja linnaosa, vald või asustusüksus ning kellel puudub rahvastikuregistris kehtiv elukoha aadress; elukoha aadressi kehtivus on lõpetatud ja kellel puudub seetõttu rahvastikuregistris kehtiv elukoha aadress. (3) Kui isiku elukoha aadressi on muudetud käesoleva paragrahvi lõike 1 või 2 alusel ning tema käesoleva seaduse § 96 lõike 1 punktis 1 nimetatud viibimiskoha aadressina kantakse rahvastikuregistrisse aadress, mis asub teises linnas ja linnaosas või vallas kui tema kehtiv linna ja linnaosa või valla täpsusega elukoha aadress, kannab kohaliku omavalitsuse üksus 11. peatükis sätestatud korras isiku elukoha aadressina rahvastikuregistrisse tema viibimiskoha aadressi linna ja linnaosa või valla täpsusega. (4) Käesoleva paragrahvi lõigetes 1 ja 2 nimetatud ööpäevaringset sotsiaalteenust osutava hoolekandeasutusena, mille aadress on enne käesoleva seaduse jõustumist kantud isiku elukoha aadressina rahvastikuregistrisse, käsitatakse ööpäevaringset erihoolekandeteenust osutanud hoolekandeasutust, mis on alates 2007. aastast erihoolekandeasutuste reorganiseerimise käigus suletud.",
      "rdfs:label": {
        "@value": "RRS_Par_112_5 (redaktsioon 118102024003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "118102024003",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/118102024003",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112_5",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_112_6_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_112_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui isiku elukoha aadressi kehtivus on lõpetatud käesoleva seaduse § 91 lõike 1 alusel ajal, millal isik viibis § 96 lõikes 1 nimetatud viibimiskohas, taastab kohaliku omavalitsuse üksus selle aktuaalsuse linna ja linnaosa või valla täpsusega.",
      "rdfs:label": {
        "@value": "RRS_Par_112_6 (redaktsioon 121112025007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121112025007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121112025007",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 112_6",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_12_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregistri volitatud töötlejaks (edaspidi volitatud töötleja ) määrab siseministri ettepanekul Vabariigi Valitsus oma korraldusega käesolevas paragrahvis sätestatud nõuetele vastava riigiasutuse või eraõigusliku juriidilise isiku, kelle kõik aktsiad või osad kuuluvad riigile. (2) Volitatud töötleja määramisel kuulab Vabariigi Valitsus ära riigi infosüsteemide alaseid töid koordineeriva asutuse ja Andmekaitse Inspektsiooni arvamuse. (3) Volitatud töötleja peab: omama või tal peab olema võimalus kasutada rahvastikuregistri pidamiseks vajalikku infotehnoloogilist riistvara; omama automatiseeritud andmetöötlusega andmekogude pidamise kogemusi; olema võimeline läbi viima rahvastikuregistri andmete töötlemiseks vajalikku väljaõpet; omama rahvastikuregistri andmete kaitse korraldamiseks vajalikke teadmisi ning võimalusi; omama võimalust kasutada töötajaid, kes tunnevad isikuandmete kaitse ja andmekogude alaseid õigusakte ning kõrgtasemel infotehnoloogiat. (4) Eraõiguslikust juriidilisest isikust volitatud töötlejal ei või olla maksuvõlgnevusi ja muid varalisi kohustusi, mis takistaksid rahvastikuregistri pidamist. (5) Vastutav töötleja kontrollib enne Vabariigi Valitsusele ettepaneku esitamist koos infosüsteemidealaseid töid koordineeriva asutuse ja Andmekaitse Inspektsiooniga volitatud töötleja kandidaadi vastavust nõuetele. (6) Vastutav töötleja võib täpsustada käesoleva paragrahvi lõikes 3 nimetatud tingimusi, teatades täpsustatud tingimustest volitatud töötleja kandidaadile üks kuu enne tema nõuetele vastavuse kontrollimist.",
      "rdfs:label": {
        "@value": "RRS_Par_12 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_12_v733571"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_12_v733571",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregistri volitatud töötlejaks (edaspidi volitatud töötleja ) määrab regionaalministri ettepanekul Vabariigi Valitsus oma korraldusega käesolevas paragrahvis sätestatud nõuetele vastava riigiasutuse või eraõigusliku juriidilise isiku, kelle kõik aktsiad või osad kuuluvad riigile. (2) Volitatud töötleja määramisel kuulab Vabariigi Valitsus ära riigi infosüsteemide alaseid töid koordineeriva asutuse ja Andmekaitse Inspektsiooni arvamuse. (3) Volitatud töötleja peab: omama või tal peab olema võimalus kasutada rahvastikuregistri pidamiseks vajalikku infotehnoloogilist riistvara; omama automatiseeritud andmetöötlusega andmekogude pidamise kogemusi; olema võimeline läbi viima rahvastikuregistri andmete töötlemiseks vajalikku väljaõpet; omama rahvastikuregistri andmete kaitse korraldamiseks vajalikke teadmisi ning võimalusi; omama võimalust kasutada töötajaid, kes tunnevad isikuandmete kaitse ja andmekogude alaseid õigusakte ning kõrgtasemel infotehnoloogiat. (4) Eraõiguslikust juriidilisest isikust volitatud töötlejal ei või olla maksuvõlgnevusi ja muid varalisi kohustusi, mis takistaksid rahvastikuregistri pidamist. (5) Vastutav töötleja kontrollib enne Vabariigi Valitsusele ettepaneku esitamist koos infosüsteemidealaseid töid koordineeriva asutuse ja Andmekaitse Inspektsiooniga volitatud töötleja kandidaadi vastavust nõuetele. (6) Vastutav töötleja võib täpsustada käesoleva paragrahvi lõikes 3 nimetatud tingimusi, teatades täpsustatud tingimustest volitatud töötleja kandidaadile üks kuu enne tema nõuetele vastavuse kontrollimist.",
      "rdfs:label": {
        "@value": "RRS_Par_12 (redaktsioon 733571)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "733571",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_12_v900682"
      },
      "estleg:versionValidTo": {
        "@value": "2005-05-26",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/733571",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_12_v900682",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregistri volitatud töötlejaks (edaspidi volitatud töötleja ) määrab regionaalministri ettepanekul Vabariigi Valitsus oma korraldusega käesolevas paragrahvis sätestatud nõuetele vastava riigiasutuse või eraõigusliku juriidilise isiku. Eraõigusliku juriidilise isiku määramine toimub halduskoostöö seaduses (RT I 2003, 20, 117; 82, 552; 2004, 53, 367; 89, 603) sätestatud korras. (2) Volitatud töötleja määramisel kuulab Vabariigi Valitsus ära riigi infosüsteemide alaseid töid koordineeriva asutuse ja Andmekaitse Inspektsiooni arvamuse. (3) Volitatud töötleja peab: omama või tal peab olema võimalus kasutada rahvastikuregistri pidamiseks vajalikku infotehnoloogilist riistvara; omama automatiseeritud andmetöötlusega andmekogude pidamise kogemusi; olema võimeline läbi viima rahvastikuregistri andmete töötlemiseks vajalikku väljaõpet; omama rahvastikuregistri andmete kaitse korraldamiseks vajalikke teadmisi ning võimalusi; omama võimalust kasutada töötajaid, kes tunnevad isikuandmete kaitse ja andmekogude alaseid õigusakte ning kõrgtasemel infotehnoloogiat. (4) Eraõiguslikust juriidilisest isikust volitatud töötlejal ei või olla maksuvõlgnevusi ja muid varalisi kohustusi, mis takistaksid rahvastikuregistri pidamist. (5) Vastutav töötleja kontrollib enne Vabariigi Valitsusele ettepaneku esitamist koos infosüsteemidealaseid töid koordineeriva asutuse ja Andmekaitse Inspektsiooniga volitatud töötleja kandidaadi vastavust nõuetele. (6) Vastutav töötleja võib täpsustada käesoleva paragrahvi lõikes 3 nimetatud tingimusi, teatades täpsustatud tingimustest volitatud töötleja kandidaadile üks kuu enne tema nõuetele vastavuse kontrollimist.",
      "rdfs:label": {
        "@value": "RRS_Par_12 (redaktsioon 900682)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "900682",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_12_v13188166"
      },
      "estleg:versionValidTo": {
        "@value": "2009-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/900682",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 12",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
