      }
    },
    {
      "@id": "estleg:RRS_Par_17_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvastikuregistri pidamist rahastatakse riigieelarvest ja rahvastikuregistri volitatud töötleja poolt käesolevas seaduses sätestatud rahvastikuregistri andmetele juurdepääsu teenuste osutamise eest saadud tasudest.",
      "rdfs:label": {
        "@value": "RRS_Par_17 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
