      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "RRS_Par_79 (redaktsioon 109122010006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109122010006",
      "estleg:supersededByVersion": {
