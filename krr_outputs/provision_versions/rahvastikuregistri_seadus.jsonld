    {
      "@id": "estleg:RRS_Par_95_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Püsivalt välisriigis elav Eesti kodanik ja konsulaarseaduses sätestatud välismaalane esitavad välisriigi elukoha aadressi kandmiseks rahvastikuregistrisse konsulaarseaduses sätestatud korras taotluse Eesti konsulaarametnikule, kes kannab esitatud elukoha andmed rahvastikuregistrisse.",
      "rdfs:label": {
        "@value": "RRS_Par_95 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
