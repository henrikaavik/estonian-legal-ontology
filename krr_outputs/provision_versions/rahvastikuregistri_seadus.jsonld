      }
    },
    {
      "@id": "estleg:RRS_Par_91_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omaniku nõudmisel isiku elukoha andmete muutmisel lõpetatakse isiku rahvastikuregistrisse kantud elukoha andmete kehtivus. Kui isik asub käesoleva seaduse § 96 lõikes 1 nimetatud asutuses, on isikul või tema seaduslikul esindajal õigus taotleda isiku elukoha aadressi säilitamist rahvastikuregistri aktuaalsete andmete hulgas linna ja linnaosa või valla täpsusega. (2) Eestis elukoha rahvastikuregistrisse kandnud Euroopa Liidu kodaniku, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodaniku elukoha andmete muutmisel käesolevas paragrahvis sätestatud alustel säilitatakse rahvastikuregistri aktuaalsete andmete hulgas tema elukoha aadress riigi täpsusega.",
      "rdfs:label": {
        "@value": "RRS_Par_91 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_91_v112032022013"
      },
      "estleg:versionValidTo": {
        "@value": "2022-03-21",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_91_v112032022013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-03-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omaniku nõudmisel isiku elukoha andmete muutmisel lõpetatakse isiku rahvastikuregistrisse kantud elukoha andmete kehtivus. Kui isik asub käesoleva seaduse § 96 lõikes 1 nimetatud asutuses, on isikul või tema seaduslikul esindajal õigus taotleda isiku elukoha aadressi säilitamist rahvastikuregistri aktuaalsete andmete hulgas linna ja linnaosa või valla täpsusega. (2) Eestis elukoha rahvastikuregistrisse kandnud Euroopa Liidu kodaniku, Euroopa Majanduspiirkonna liikmesriigi ja Šveitsi Konföderatsiooni kodaniku elukoha andmete muutmisel käesolevas paragrahvis sätestatud alustel säilitatakse rahvastikuregistri aktuaalsete andmete hulgas tema elukoha aadress riigi täpsusega. Kui isiku rahvastikuregistrisse kantud elukoha andmeid ei ole kuue kuu jooksul pärast käesoleva paragrahvi alusel elukoha andmete muutmist muudetud, lõpetatakse tema elukoha andmete kehtivus rahvastikuregistris.",
      "rdfs:label": {
        "@value": "RRS_Par_91 (redaktsioon 112032022013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032022013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_91_v121112025007"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032022013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_91_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Omaniku nõudmisel isiku elukoha andmete muutmisel lõpetatakse isiku rahvastikuregistrisse kantud elukoha andmete kehtivus. Kui isiku rahvastikuregistrijärgne viibimiskoht on käesoleva seaduse § 96 lõikes 1 nimetatud viibimiskoht, säilitab kohaliku omavalitsuse üksus tema elukoha aadressi rahvastikuregistri aktuaalsete andmete hulgas linna ja linnaosa või valla täpsusega. (2) Eestis elukoha rahvastikuregistrisse kandnud Euroopa Liidu kodaniku elukoha andmete muutmisel käesolevas paragrahvis sätestatud alustel säilitatakse rahvastikuregistri aktuaalsete andmete hulgas tema elukoha aadress riigi täpsusega. Kui isiku rahvastikuregistrisse kantud elukoha andmeid ei ole kuue kuu jooksul pärast käesoleva paragrahvi alusel elukoha andmete muutmist muudetud, lõpetatakse tema elukoha andmete kehtivus rahvastikuregistris.",
      "rdfs:label": {
        "@value": "RRS_Par_91 (redaktsioon 121112025007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121112025007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121112025007",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 91",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_92_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud töötleja esitab vastutavale töötlejale rahvastikuregistri eelarve täitmise aruande vähemalt üks kord aastas, kui vastutava töötlejaga sõlmitud rahvastikuregistri pidamise lepingus ei ole ette nähtud sagedamat aruandlust.",
      "rdfs:label": {
        "@value": "RRS_Par_92 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_92_v122122018013"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 92",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_92_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Omaniku ja isiku vaidlus ruumi kasutusõiguse üle lahendatakse tsiviilkohtupidamise korras või üürivaidluse lahendamise seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "RRS_Par_92 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 92",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_93_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregister moodustatakse seni peetavate rahvastiku arvestuse andmebaasi, Eesti hääleõiguslike kodanike riiklikku registrisse ja Eesti hääleõiguslike välismaalaste riiklikku registrisse kantud andmete alusel käesolevas seaduses ettenähtud korras. (2) Rahvastikuregistri moodustamisel kantakse rahvastiku arvestuse andmebaasist, Eesti hääleõiguslike kodanike riiklikust registrist ja Eesti hääleõiguslike välismaalaste riiklikust registrist andmed üle rahvastikuregistri arhiivi. (3) Rahvastikuregistri arhiivist kantakse rahvastikuregistri aktuaalsete andmete hulka nende isikute andmed, kelle kohta on olemas vähemalt järgmised andmed: perekonnanimi või perekonnanimed; eesnimi või eesnimed; sünniaeg; sünnikoht; sugu; isikukood; elukoha aadress vähemalt kohaliku omavalitsusüksuse täpsusega; Eesti kodakondsusesse kuulumine või kehtiva elamisloa omamine.",
      "rdfs:label": {
        "@value": "RRS_Par_93 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_93_v122122018013"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 93",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_93_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_93"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üürivaidlust lahendava komisjoni jõustunud otsus või jõustunud kohtulahend ruumi kasutusõiguse olemasolu või puudumise kohta on kohaliku omavalitsuse üksusele aluseks, et muuta rahvastikuregistris elukoha aadress. (2) Kui isik kaotab õiguse kasutada ruumi elukohana üürivaidluskomisjoni või kohtulahendi alusel, säilitatakse rahvastikuregistri aktuaalsete andmete hulgas isiku elukoha aadress linna ja linnaosa või valla täpsusega. Kui isiku rahvastikuregistrisse kantud elukoha andmeid ei ole 30 päeva jooksul pärast käesoleva lõike alusel elukoha andmete muutmist muudetud, lõpetatakse tema elukoha andmete kehtivus rahvastikuregistris.",
      "rdfs:label": {
        "@value": "RRS_Par_93 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 93",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_94_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui isikute kohta puuduvad osaliselt käesoleva seaduse § 93 lõikes 3 sätestatud andmed, esitab volitatud töötleja puuduvate andmete väljaselgitamiseks vähemalt üheksa kuud enne rahvastikuregistri kasutuselevõtmist järelepärimise vastavatele andmeandjatele. (2) Andmeandjad on kohustatud selgitama välja ja esitama õiged andmed koos käesoleva seaduse § 26 lõikes 1 sätestatud rahvastikuregistri andmete alusdokumendi andmetega kolme kuu jooksul järelepärimise saamisest käesolevas seaduses andmete üleandmiseks sätestatud korras. Kui andmeandjal ei ole mõne isiku kohta andmeid, siis teatab ta andmete puudumisest. (3) Isikul on õigus kontrollida rahvastikuregistrisse kantavate andmete olemasolu rahvastikuregistris ja esitada puuduvad andmed ning nõuda nende andmete rahvastikuregistrisse kandmist. Volitatud töötleja esitab saadud andmed vastavale andmeandjale kontrollimiseks ja kannab andmed andmeandja poolt esitatud kujul rahvastikuregistrisse või teatab isikule andmete rahvastikuregistrisse kandmata jätmise põhjustest ühe kuu jooksul isikult avalduse saamisest.",
      "rdfs:label": {
        "@value": "RRS_Par_94 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_94_v122122018013"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 94",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_94_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aadressiandmete muutumise korral aadressiandmete süsteemi infosüsteemis muudetakse isiku elukoha aadressi andmed rahvastikuregistris. (2) Kui isiku elukoha aadressina on rahvastikuregistrisse kantud aadress, kus puudub aadressiobjekt, või kui aadressiandmete süsteemi infosüsteemis toimunud aadressiandmete muudatuste alusel ei ole võimalik tuvastada isiku rahvastikuregistrisse kantud elukoha uut aadressi, lõpetab kohaliku omavalitsuse üksus tema elukoha andmete kehtivuse rahvastikuregistris. (3) Isiku teavitamise elukoha muutunud aadressist korraldab isiku elukohajärgne kohaliku omavalitsuse üksus.",
      "rdfs:label": {
        "@value": "RRS_Par_94 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_94_v121112025007"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 94",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_94_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Aadressiandmete muutumise korral aadressiandmete süsteemi infosüsteemis muudetakse isiku elukoha aadressi andmed rahvastikuregistris. (2) Kui isiku elukoha aadressina on rahvastikuregistrisse kantud aadress, kus puudub aadressiandmete süsteemi infosüsteemi andmetel käesoleva seaduse § 77 kohane ruum, või kui aadressiandmete süsteemi infosüsteemis toimunud aadressiandmete muudatuste alusel ei ole võimalik tuvastada isiku rahvastikuregistrisse kantud elukoha uut aadressi, lõpetab kohaliku omavalitsuse üksus tema elukoha andmete kehtivuse rahvastikuregistris. (3) Isiku teavitamise elukoha muutunud aadressist korraldab isiku elukohajärgne kohaliku omavalitsuse üksus.",
      "rdfs:label": {
        "@value": "RRS_Par_94 (redaktsioon 121112025007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121112025007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/121112025007",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 94",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_95_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvastikuregistri moodustamisel peetakse samaaegselt rahvastiku arvestuse andmebaasi, Eesti hääleõiguslike kodanike riiklikku registrit ja Eesti hääleõiguslike välismaalaste riiklikku registrit. (2) Rahvastikuregistri kasutuselevõtmisest alates lõpetab Vabariigi Valitsus rahvastiku arvestuse andmebaasi, Eesti hääleõiguslike kodanike riikliku registri ja Eesti hääleõiguslike välismaalaste riikliku registri pidamise. (3) Käesoleva seaduse §-de 40-48 jõustumisel kohaldatakse kuni rahvastikuregistri kasutuselevõtmiseni rahvastikuregistrisse kantud elukoha andmetena rahvastiku arvestuse andmebaasi vastavaid andmeid.",
      "rdfs:label": {
        "@value": "RRS_Par_95 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_95_v109122010006"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22462",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 95",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_95_v109122010006",
