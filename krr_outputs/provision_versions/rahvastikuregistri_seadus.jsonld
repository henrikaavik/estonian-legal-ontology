      }
    },
    {
      "@id": "estleg:RRS_Par_76_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elukoha andmed rahvastikuregistrisse kandnud asutus säilitab paberil esitatud elukohateateid kümme aastat. (2) Käesoleva seaduse § 82 lõikes 1 sätestatud juhul säilitab paberil esitatud elukohateateid elukohateate vastu võtnud asutus või isik.",
      "rdfs:label": {
        "@value": "RRS_Par_76 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:supersededByVersion": {
        "@id": "estleg:RRS_Par_76_v121112025007"
      },
      "estleg:versionValidTo": {
        "@value": "2025-12-01",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 76",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_76_v121112025007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
