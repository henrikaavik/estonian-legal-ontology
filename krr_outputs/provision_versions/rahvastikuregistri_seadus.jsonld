      }
    },
    {
      "@id": "estleg:RRS_Par_90_v122122018013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse üksus ei rahulda ruumi omaniku taotlust muuta isiku elukoha andmed, kui: isik tõestab taotluse kättetoimetamisest või Ametlikes Teadaannetes avaldamisest arvates 30 päeva jooksul dokumentaalselt oma õigust kasutada ruumi oma elukohana; isiku ja omaniku vahel on pooleli kohtuvaidlus või vaidlus üürikomisjonis ruumi kasutusõiguse üle.",
      "rdfs:label": {
        "@value": "RRS_Par_90 (redaktsioon 122122018013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122122018013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122122018013",
      "estleg:sourceAct": "Rahvastikuregistri seadus",
      "estleg:provisionRef": "RRS § 90",
      "estleg:partOfAct": {
        "@id": "estleg:RRS_Map_2026"
      }
    },
    {
      "@id": "estleg:RRS_Par_91_v22462",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RRS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud töötleja rahvastikuregistri pidamise tulude ja kulude eelarve kinnitab ja eelarve täitmist kontrollib siseminister.",
      "rdfs:label": {
        "@value": "RRS_Par_91 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
