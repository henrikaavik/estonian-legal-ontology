      },
      "estleg:versionText": "Lepingu lõpetamisest teatab lepingu lõpetamise algataja kirjalikult teisele lepingupoolele hiljemalt üks aasta enne lepingu tähtaja lõppemist, ennetähtaegsest lõpetamisest hiljemalt kuus kuud enne lepingu lõpetamist, viidates käesoleva seaduse § 16 lõikes 1 või 2 sätestatud alusele.",
      "rdfs:label": {
        "@value": "RRS_Par_17 (redaktsioon 22462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22462",
      "estleg:supersededByVersion": {
