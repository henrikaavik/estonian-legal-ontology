      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikult võib nõuda isikukoodi andmist vaid juhul, kui isiku üheselt kindlaksmääramine on vajalik seadusega või seaduse alusel pandud ülesande täitmiseks.",
