        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Sdaseadus_Par_31_v13361720",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sdaseadus_Par_31"
      },
      "estleg:versionValidFrom": {
