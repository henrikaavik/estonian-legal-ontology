      "rdfs:label": {
        "@value": "Sdaseadus_Par_35 (redaktsioon 693736)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693736",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sdaseadus_Par_35_v12780735"
