    {
      "@id": "estleg:Sdaseadus_Par_17_v103122020006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sdaseadus_Par_17"
      },
      "estleg:versionValidFrom": {
