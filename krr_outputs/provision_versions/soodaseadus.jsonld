      },
      "estleg:versionValidTo": {
        "@value": "2010-10-15",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Sdaseadus_Par_17_v13361720",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Sdaseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sööta võib eksportida kooskõlas Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 178/2002 artiklis 12 sätestatud nõuetega. (2) Sööda eksportimise korral väljastab Veterinaar- ja Toiduamet sööda nõuetekohasust tõendava dokumendi, kui sellise dokumendi esitamist nõutakse ühendusevälises riigis.",
      "rdfs:label": {
        "@value": "Sdaseadus_Par_17 (redaktsioon 13361720)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13361720",
      "estleg:supersededByVersion": {
        "@id": "estleg:Sdaseadus_Par_17_v104122019028"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Sdaseadus_Par_17_v104122019028",
