      },
      "estleg:versionValidTo": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:Sdaseadus_Par_38_v750608",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
