      },
      "estleg:versionValidFrom": {
        "@value": "2010-10-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu - (2) Kehtetu - (3) Kehtetu - (4) Käesoleva seaduse §-des 13 ja 15 sätestatud nõuete täitmise üle riikliku järelevalve teostamisel täidavad Veterinaar- ja Toiduameti järelevalveametnikud käesolevas seaduses sätestatud järelevalveametniku ülesandeid ning neil on kõik järelevalveametniku õigused alates käesoleva seaduse jõustumisest. (5) Kehtetu - (6) Kehtetu - (7) Kehtetu -",
      "rdfs:label": {
