      ],
      "estleg:versionOf": {
        "@id": "estleg:Sdaseadus_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sööta võib eksportida kooskõlas Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 178/2002 artiklis 12 sätestatud nõuetega. (2) Sööda eksportimise korral väljastab Veterinaar- ja Toiduamet sööda nõuetekohasust tõendava dokumendi, kui sellise dokumendi esitamist nõutakse liiduvälises riigis.",
      "rdfs:label": {
        "@value": "Sdaseadus_Par_17 (redaktsioon 104122019028)",
