        "@type": "xsd:date"
      },
      "estleg:versionText": "[Välja jäetud – – jõust. 20.12.2007]",
      "rdfs:label": {
        "@value": "ISIKUA_Par_54 (redaktsioon 12909389)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12909389",
