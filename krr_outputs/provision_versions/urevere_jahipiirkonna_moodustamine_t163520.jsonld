      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Urevere jahipiirkonna moodustamine (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Urevere jahipiirkonna moodustamine"
    },
    {
      "@id": "estleg:Reg_163520_Par_1_v163520",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163520_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Urevere jahipiirkonna pindala on 5200 hektarit. Urevere jahipiirkonna pindala on 5200 hektarit. 2 (2) Urevere jahipiirkonna piirikirjeldus on järgmine: Urevere jahipiirkonna piirikirjeldus on järgmine: Urevere jahipiirkonna piir läheb Kasari jõe ja Vigala-Loodna tee ristumiskohast mööda Vigala-Loodna teed Jädivere-Silla teeni; teeristist mööda Jädivere-Silla teed Nurme talu teeni, jätkudes mööda Nurme talu teed Nurme kraavini ning mööda Nurme kraavi Kõrtsu kraavini; sealt mööda Kõrtsu kraavi Luiste jõeni ning mööda Luiste jõge Pokuti ojani; edasi mööda Pokuti oja Kõki kraavini ning mööda Kõki, Jõe ja Klausimetsa kraavi Krahvi teeni; siitpeale mööda Krahvi teed Luiste kraavini, jätkudes mööda Luiste kraavi Loodna peakraavini ning mööda Loodna peakraavi Kiristu kraavini; sealt mööda Kiristu kraavi Koluvere-Märjamaa maanteeni (Jüri bussipeatuse juures); sealt mööda Koluvere-Märjamaa maanteed Kasari jõeni ning mööda Kasari jõge Vigala-Loodna teeni. RTL 2005 30 416 862155 2005-03-18 Urevere jahipiirkonna piir läheb Kasari jõe ja Vigala-Loodna tee ristumiskohast mööda Vigala-Loodna teed Jädivere-Silla teeni; teeristist mööda Jädivere-Silla teed Nurme talu teeni, jätkudes mööda Nurme talu teed Nurme kraavini ning mööda Nurme kraavi Kõrtsu kraavini; sealt mööda Kõrtsu kraavi Luiste jõeni ning mööda Luiste jõge Pokuti ojani; edasi mööda Pokuti oja Kõki kraavini ning mööda Kõki, Jõe ja Klausimetsa kraavi Krahvi teeni; siitpeale mööda Krahvi teed Luiste kraavini, jätkudes mööda Luiste kraavi Loodna peakraavini ning mööda Loodna peakraavi Kiristu kraavini; sealt mööda Kiristu kraavi Koluvere-Märjamaa maanteeni (Jüri bussipeatuse juures); sealt mööda Koluvere-Märjamaa maanteed Kasari jõeni ning mööda Kasari jõge Vigala-Loodna teeni.",
      "rdfs:label": {
        "@value": "Reg_163520_Par_1 (redaktsioon 163520)",
        "@language": "et"
      },
