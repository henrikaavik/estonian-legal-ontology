      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist alustatud projekteerimistööd või selleks sõlmitud lepingud võib viia lõpuni projekteerimistööde alustamise või lepingu sõlmimise hetkel kehtinud nõuete kohaselt. Enne käesoleva määruse jõustumist alustatud projekteerimistööd või selleks sõlmitud lepingud võib viia lõpuni projekteerimistööde alustamise või lepingu sõlmimise hetkel kehtinud nõuete kohaselt.",
      "rdfs:label": {
