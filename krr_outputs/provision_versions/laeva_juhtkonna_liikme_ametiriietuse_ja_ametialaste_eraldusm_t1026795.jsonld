        "@id": "estleg:Reg_1026795_Map"
      }
    },
    {
      "@id": "estleg:Reg_1026795_Par_14_v1026795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026795_Par_14"
