      },
      "estleg:versionText": "Määrus jõustub 1. jaanuaril 2020. a. Määrus jõustub 1. jaanuaril 2020. a.",
      "rdfs:label": {
        "@value": "Reg_1048525_Par_12 (redaktsioon 1048525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1048525",
