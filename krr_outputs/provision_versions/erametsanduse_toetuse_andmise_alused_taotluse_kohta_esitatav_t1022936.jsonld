      "estleg:provisionRef": "Reg_1022936 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1022936_Map"
      }
    },
    {
      "@id": "estleg:Reg_1022936_Par_7_v1022936",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1022936_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-03-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse alusel antavad toetused on: 1 1) vastutustundliku metsanduse edendamise toetus; RT I 2025-07-02 7 102072025007 2025-07-05 2 2) mitmekesise ja kliimakindla metsa rajamise toetus; RT I 2025-10-10 1 110102025001 2025-10-13 3 3) pärandkultuuri säilitamise ja eksponeerimise toetus; 4 4) erametsaomanike metsa inventeerimise toetus; RT I 2017-01-06 2 106012017002 2017-01-09 5 5) metsaühistu toetus; 6 6) maaparandussüsteemi korrastamise toetus; RT I 2025-10-10 1 110102025001 2025-10-13 7 7) metsa sertifitseerimise toetus; RT I 2018-07-31 1 131072018001 2018-08-06 8 8) üraskikahjustuste ennetamise toetus; RT I 2021-01-19 1 119012021001 2021-01-22 9 9) väljaspool Natura 2000 võrgustiku ala asuvate erametsaalade looduskaitseliste piirangute hüvitamise toetus; RT I 2022-04-01 4 101042022004 2022-04-04 10 10) mitmekesise ja kliimakindla metsa kujundamise toetus. RT I 2025-10-10 1 110102025001 2025-10-13 Käesoleva määruse alusel antavad toetused on: vastutustundliku metsanduse edendamise toetus; mitmekesise ja kliimakindla metsa rajamise toetus; pärandkultuuri säilitamise ja eksponeerimise toetus; erametsaomanike metsa inventeerimise toetus; metsaühistu toetus; maaparandussüsteemi korrastamise toetus; metsa sertifitseerimise toetus; üraskikahjustuste ennetamise toetus; väljaspool Natura 2000 võrgustiku ala asuvate erametsaalade looduskaitseliste piirangute hüvitamise toetus; mitmekesise ja kliimakindla metsa kujundamise toetus.",
      "rdfs:label": {
        "@value": "Reg_1022936_Par_7 (redaktsioon 1022936)",
        "@language": "et"
      },
