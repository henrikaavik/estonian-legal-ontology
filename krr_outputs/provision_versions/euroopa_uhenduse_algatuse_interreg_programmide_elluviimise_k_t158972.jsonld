    {
      "@id": "estleg:Reg_158972_Par_10_v158972",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158972_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-08-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetust saanud Eesti partner on kohustatud lisaks käesoleva määruse §-s 9 sätestatule: 1 1) toetuslepingu ettevalmistamiseks teatama viivitamatult Rahandusministeeriumile struktuuritoetuse lepingu sõlmimisest projekti juhtpartneri ja vastava Interreg programmi korraldusasutuse vahel ning hiljemalt kahe kuu jooksul struktuuritoetuse lepingu sõlmimisest esitama Rahandusministeeriumile toetuslepingu sõlmimiseks vajalikud dokumendid; RT I 2015-08-19 1 119082015001 2015-09-01 2 2) kasutama toetust ja toetuse abil soetatavat, ehitatavat või renoveeritavat vara vastavuses Rahandusministeeriumiga sõlmitud toetuslepinguga; RT I 2015-08-19 1 119082015001 2015-09-01 3 3) esitama Rahandusministeeriumile toetuslepingus ettenähtud informatsiooni ja aruandeid tähtajaliselt; RT I 2015-08-19 1 119082015001 2015-09-01 4 4) tagama Rahandusministeeriumiga sõlmitud toetuslepingus ettenähtud omavahendid. RT I 2015-08-19 1 119082015001 2015-09-01 Toetust saanud Eesti partner on kohustatud lisaks käesoleva määruse §-s 9 sätestatule: toetuslepingu ettevalmistamiseks teatama viivitamatult Rahandusministeeriumile struktuuritoetuse lepingu sõlmimisest projekti juhtpartneri ja vastava Interreg programmi korraldusasutuse vahel ning hiljemalt kahe kuu jooksul struktuuritoetuse lepingu sõlmimisest esitama Rahandusministeeriumile toetuslepingu sõlmimiseks vajalikud dokumendid; kasutama toetust ja toetuse abil soetatavat, ehitatavat või renoveeritavat vara vastavuses Rahandusministeeriumiga sõlmitud toetuslepinguga; esitama Rahandusministeeriumile toetuslepingus ettenähtud informatsiooni ja aruandeid tähtajaliselt; tagama Rahandusministeeriumiga sõlmitud toetuslepingus ettenähtud omavahendid.",
      "rdfs:label": {
        "@value": "Reg_158972_Par_10 (redaktsioon 158972)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158972",
