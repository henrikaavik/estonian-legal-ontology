      "estleg:provisionRef": "Reg_1009071 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_20_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rehabiliteeritud isiku õigusvastaselt vahi all, kinnipidamiskohas või asumisel oleku aega tõendatakse järgmiste dokumentidega: 1 1) rehabiliteerimistunnistus; 2 2) muu dokument, millest nähtub isiku kohtuväline represseerimine või alusetult süüdimõistmine ning õigusvastaselt vahi all, kinnipidamiskohas või asumisel oleku aeg. Rehabiliteeritud isiku õigusvastaselt vahi all, kinnipidamiskohas või asumisel oleku aega tõendatakse järgmiste dokumentidega: rehabiliteerimistunnistus; muu dokument, millest nähtub isiku kohtuväline represseerimine või alusetult süüdimõistmine ning õigusvastaselt vahi all, kinnipidamiskohas või asumisel oleku aeg. 2 (2) Rehabiliteeritud isiku puhul vahi alt, kinnipidamiskohast või asumiselt vabanemisele järgnenud aega kuni Eestisse elama asumise õiguse andmiseni, kui isikult oli õigusvastaselt võetud õigus asuda elama Eestisse, tõendatakse rehabiliteerimistunnistusega ja Rahvusarhiivi arhiiviteatisega või Eesti NSV Ministrite Nõukogu Büroo protokollilise otsusega või muu dokumendiga, millest nähtub isiku õigusvastaselt võetud õigus asuda elama Eestisse. Rehabiliteeritud isiku puhul vahi alt, kinnipidamiskohast või asumiselt vabanemisele järgnenud aega kuni Eestisse elama asumise õiguse andmiseni, kui isikult oli õigusvastaselt võetud õigus asuda elama Eestisse, tõendatakse rehabiliteerimistunnistusega ja Rahvusarhiivi arhiiviteatisega või Eesti NSV Ministrite Nõukogu Büroo protokollilise otsusega või muu dokumendiga, millest nähtub isiku õigusvastaselt võetud õigus asuda elama Eestisse.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_20 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 20",
