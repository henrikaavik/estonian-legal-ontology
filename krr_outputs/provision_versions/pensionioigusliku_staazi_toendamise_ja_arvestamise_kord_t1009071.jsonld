      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pensioniõigusliku staaži tõendamiseks esitatakse originaaldokumendid või nende notariaalselt kinnitatud või haldusmenetluse seaduse §-s 24 sätestatud korras ametlikult kinnitatud ärakirjad. Sotsiaalkindlustusametisse jääva koopia võib kinnitada Sotsiaalkindlustusamet. Pensioniõigusliku staaži tõendamiseks esitatakse originaaldokumendid või nende notariaalselt kinnitatud või haldusmenetluse seaduse §-s 24 sätestatud korras ametlikult kinnitatud ärakirjad. Sotsiaalkindlustusametisse jääva koopia võib kinnitada Sotsiaalkindlustusamet.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_23 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
