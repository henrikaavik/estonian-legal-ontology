        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_4_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistusaega Eesti Kaitseväes ning kooskõlas kaitseväeteenistuse seadusega selle teenistusega võrdsustatud teenistusaega tõendatakse ühega järgmistest dokumentidest: 1 1) kaitseväeteenistuse tunnistus; 2 2) Kaitseväe teatis; 3 3) Kaitseressursside Ameti teatis; 4 4) Kaitseliidu peastaabi teatis; 5 5) muu dokument, millest nähtub Eesti Kaitseväes teenimine või kaitseväeteenistuse seaduses nimetatud teenistusega võrdsustatud teenistusaeg; 6 6) dokumendi alusel tööraamatusse tehtud kanne teenistusaja kohta. Teenistusaega Eesti Kaitseväes ning kooskõlas kaitseväeteenistuse seadusega selle teenistusega võrdsustatud teenistusaega tõendatakse ühega järgmistest dokumentidest: kaitseväeteenistuse tunnistus; Kaitseväe teatis; Kaitseressursside Ameti teatis; Kaitseliidu peastaabi teatis; muu dokument, millest nähtub Eesti Kaitseväes teenimine või kaitseväeteenistuse seaduses nimetatud teenistusega võrdsustatud teenistusaeg; dokumendi alusel tööraamatusse tehtud kanne teenistusaja kohta.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_4 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_5_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teenistusaega Siseministeeriumi süsteemis tõendatakse dokumendi alusel tööraamatusse tehtud kandega teenistusaja kohta või Siseministeeriumi või tema allasutuse teatisega. Teenistusaega Siseministeeriumi süsteemis tõendatakse dokumendi alusel tööraamatusse tehtud kandega teenistusaja kohta või Siseministeeriumi või tema allasutuse teatisega.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_5 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_6_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohustusliku sõjaväeteenistuse ja asendusteenistuse aega, kui isik suunati teenistusse Eestist, tõendatakse ühega järgmistest dokumentidest: 1 1) sõjaväepilet; 2 2) Kaitseressursside Ameti teatis; 3 3) muu dokument, millest nähtub kohustuslikus sõjaväeteenistuses või asendusteenistuses teenimine; 4 4) dokumendi alusel tööraamatusse tehtud kanne kohustusliku sõjaväeteenistuse või asendusteenistuse kohta. Kohustusliku sõjaväeteenistuse ja asendusteenistuse aega, kui isik suunati teenistusse Eestist, tõendatakse ühega järgmistest dokumentidest: sõjaväepilet; Kaitseressursside Ameti teatis; muu dokument, millest nähtub kohustuslikus sõjaväeteenistuses või asendusteenistuses teenimine; dokumendi alusel tööraamatusse tehtud kanne kohustusliku sõjaväeteenistuse või asendusteenistuse kohta. 2 (2) Kohustusliku sõjaväeteenistuse ja asendusteenistuse aega, kui isik elas enne ja pärast väljastpoolt Eestit teenistusse suunamist Eestis, tõendatakse ühega lõikes 1 nimetatud dokumentidest ning dokumendiga, millest nähtub isiku elamine Eestis enne ja pärast väljastpoolt Eestit teenistusse suunamist. Kohustusliku sõjaväeteenistuse ja asendusteenistuse aega, kui isik elas enne ja pärast väljastpoolt Eestit teenistusse suunamist Eestis, tõendatakse ühega lõikes 1 nimetatud dokumentidest ning dokumendiga, millest nähtub isiku elamine Eestis enne ja pärast väljastpoolt Eestit teenistusse suunamist.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_6 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_7_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õpiaega kutseõppeasutuse statsionaarses õppes või ülikooli või rakenduskõrgkooli statsionaarses õppevormis või nendega võrdsustatud õppevormides tõendatakse diplomi, tunnistuse või muu dokumendiga, milles on andmed õppeasutuse, õppevormi ja õppeaja kestuse kohta. Õpiaega kutseõppeasutuse statsionaarses õppes või ülikooli või rakenduskõrgkooli statsionaarses õppevormis või nendega võrdsustatud õppevormides tõendatakse diplomi, tunnistuse või muu dokumendiga, milles on andmed õppeasutuse, õppevormi ja õppeaja kestuse kohta.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_7 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_8_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi diplomaadi abikaasa välisesinduses oleku aega tõendatakse järgmiste dokumentidega: 1 1) diplomaadi abikaasa tööraamat; 2 2) välisministri käskkiri või Välisministeeriumi muu dokument, millest nähtub diplomaadi nimi ja diplomaadi abikaasa välisesinduses oleku aeg; 3 3) abielu tõendav dokument, kui selle kohta ei ole andmeid rahvastikuregistris. Eesti Vabariigi diplomaadi abikaasa välisesinduses oleku aega tõendatakse järgmiste dokumentidega: diplomaadi abikaasa tööraamat; välisministri käskkiri või Välisministeeriumi muu dokument, millest nähtub diplomaadi nimi ja diplomaadi abikaasa välisesinduses oleku aeg; abielu tõendav dokument, kui selle kohta ei ole andmeid rahvastikuregistris.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_8 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_9_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti Vabariigi presidendi mittetöötavale abikaasale presidendi ametivolituste aja pensioniõigusliku staaži hulka arvamist tõendatakse järgmiste dokumentidega: 1 1) presidendi abikaasa tööraamat; 2 2) Vabariigi Presidendi Kantselei teatis presidendi ametivolituste aja kohta; 3 3) abielu tõendav dokument, kui selle kohta ei ole andmeid rahvastikuregistris. Eesti Vabariigi presidendi mittetöötavale abikaasale presidendi ametivolituste aja pensioniõigusliku staaži hulka arvamist tõendatakse järgmiste dokumentidega: presidendi abikaasa tööraamat; Vabariigi Presidendi Kantselei teatis presidendi ametivolituste aja kohta; abielu tõendav dokument, kui selle kohta ei ole andmeid rahvastikuregistris.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_9 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
