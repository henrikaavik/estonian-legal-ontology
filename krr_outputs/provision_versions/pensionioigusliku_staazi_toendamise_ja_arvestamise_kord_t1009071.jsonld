      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_21_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sõjavangis, II maailmasõja ajal koonduslaagris, getos, samuti aastatel 1941–1942 töö- ja ehituspataljonis või töö- ja ehituskolonnis viibimise aega tõendatakse sõjaväepileti, punaarmeelase raamatu, Kaitseressursside Ameti või muu asutuse dokumendiga või arhiiviteatisega. Sõjavangis, II maailmasõja ajal koonduslaagris, getos, samuti aastatel 1941–1942 töö- ja ehituspataljonis või töö- ja ehituskolonnis viibimise aega tõendatakse sõjaväepileti, punaarmeelase raamatu, Kaitseressursside Ameti või muu asutuse dokumendiga või arhiiviteatisega. 2 (2) 1944. aasta oktoobris või novembris Saaremaalt Sõrve poolsaarelt Saksamaale sunniviisiliselt ümberasustatud isiku puhul aega alates ümberasustamisest kuni Eestisse elama asumiseni tõendatakse arhiiviteatisega. 1944. aasta oktoobris või novembris Saaremaalt Sõrve poolsaarelt Saksamaale sunniviisiliselt ümberasustatud isiku puhul aega alates ümberasustamisest kuni Eestisse elama asumiseni tõendatakse arhiiviteatisega.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_21 (redaktsioon 1009071)",
        "@language": "et"
      },
