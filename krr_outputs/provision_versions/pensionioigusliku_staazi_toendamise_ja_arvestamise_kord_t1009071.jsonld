      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_3_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loomeliitude ja kutseühingute liikmete tegevuse aega alates loometegevuse algusest tõendatakse loomeliidu juhatuse sekretariaadi või juhatuse tõendi või teatisega, millest nähtub loometegevuse algusaeg, loomeliidu liikmeks astumise aeg, samuti loomingulise tegevuse aeg. Nende loometöötajate pensioniõiguslikku staaži, kes ei olnud loomeliitude liikmed, kuid kuulusid kutseühingutesse, tõendatakse vastava kutseühingu poolt välja antud teatisega. Loomeliitude ja kutseühingute liikmete tegevuse aega alates loometegevuse algusest tõendatakse loomeliidu juhatuse sekretariaadi või juhatuse tõendi või teatisega, millest nähtub loometegevuse algusaeg, loomeliidu liikmeks astumise aeg, samuti loomingulise tegevuse aeg. Nende loometöötajate pensioniõiguslikku staaži, kes ei olnud loomeliitude liikmed, kuid kuulusid kutseühingutesse, tõendatakse vastava kutseühingu poolt välja antud teatisega. 2 (2) Loometegevuse aega alates 1. jaanuarist 1991. a tõendatakse teatisega, millest nähtub sotsiaalmaksu tasumine loomeliitude ja kutseühingute liikmete poolt või eest. Loometegevuse aega alates 1. jaanuarist 1991. a tõendatakse teatisega, millest nähtub sotsiaalmaksu tasumine loomeliitude ja kutseühingute liikmete poolt või eest.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_3 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_30_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
