      "estleg:provisionRef": "Reg_1009071 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1009071_Map"
      }
    },
    {
      "@id": "estleg:Reg_1009071_Par_12_v1009071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1009071_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigi tööhõivetalituses töötu abiraha saamise või tööhõivetalituse vahendusel tööturukoolituses osalemise aega tõendatakse Eesti Töötukassa teatisega. Riigi tööhõivetalituses töötu abiraha saamise või tööhõivetalituse vahendusel tööturukoolituses osalemise aega tõendatakse Eesti Töötukassa teatisega.",
      "rdfs:label": {
        "@value": "Reg_1009071_Par_12 (redaktsioon 1009071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1009071",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1009071",
      "estleg:sourceAct": "Pensioniõigusliku staaži tõendamise ja arvestamise kord",
      "estleg:provisionRef": "Reg_1009071 § 12",
      "estleg:partOfAct": {
