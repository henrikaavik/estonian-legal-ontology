      },
      "estleg:versionText": "PRIA kontrollib taotluse esitamisel nõutavate dokumentide olemasolu ja taotluse tähtaegset esitamist. PRIA kontrollib taotluse esitamisel nõutavate dokumentide olemasolu ja taotluse tähtaegset esitamist.",
      "rdfs:label": {
        "@value": "Reg_1030678_Par_10 (redaktsioon 1030678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1030678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1030678",
      "estleg:sourceAct": "Lühikeste tarneahelate või kohalike turgude kaudu põllumajandustoodete ja toidu turustamisvõimaluste arendamise toetus",
      "estleg:provisionRef": "Reg_1030678 § 10",
