      "estleg:provisionRef": "KuTS § 18",
      "estleg:partOfAct": {
        "@id": "estleg:KuTS_Map_2026"
      }
    },
    {
      "@id": "estleg:KuTS_Par_18_v130122025015",
      "@type": [
