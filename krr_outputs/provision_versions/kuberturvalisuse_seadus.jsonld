      },
      "estleg:versionText": "Riigi Infosüsteemi Amet tuvastab käesoleva seaduse § 3 lõikes 3 nimetatud teenuse osutajad 2018. aasta 9. novembriks.",
      "rdfs:label": {
        "@value": "KuTS_Par_20 (redaktsioon 122052018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122052018001",
