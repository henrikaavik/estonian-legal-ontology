      "estleg:provisionRef": "KuTS § 17_1",
      "estleg:partOfAct": {
        "@id": "estleg:KuTS_Map_2026"
      }
    },
    {
      "@id": "estleg:KuTS_Par_17_1_v130122025015",
      "@type": [
        "owl:NamedIndividual",
