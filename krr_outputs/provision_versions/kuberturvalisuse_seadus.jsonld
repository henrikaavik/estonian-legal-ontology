      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavushindamisasutusena tegutsemisele ja vastavushindamisasutusele tegevusloa andmisele kohaldatakse toote nõuetele vastavuse seaduse §-e 22–31 ja 33 ning § 35 lõiget 1, arvestades Euroopa Parlamendi ja nõukogu määruse (EL) 2019/881 artiklites 60 ja 61 ning artikli 61 alusel vastu võetud Euroopa Komisjoni rakendusaktis ning sama määruse lisas toodud erisusi.",
      "rdfs:label": {
        "@value": "KuTS_Par_13_2 (redaktsioon 106082022018)",
        "@language": "et"
