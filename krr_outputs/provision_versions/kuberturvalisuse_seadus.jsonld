      "estleg:provisionRef": "KuTS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:KuTS_Map_2026"
      }
    },
    {
      "@id": "estleg:KuTS_Par_7_v130122025015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KuTS_Par_7"
      },
      "estleg:versionValidFrom": {
