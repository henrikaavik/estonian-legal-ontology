      "estleg:sourceAct": "Kutseregistri põhimäärus",
      "estleg:provisionRef": "Reg_335568 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335568_Map"
      }
    },
    {
      "@id": "estleg:Reg_335568_Par_12_13_v335568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_335568_Par_12_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-07-28",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvi 7 punktis 8 nimetatud andmed saadakse infosüsteemide andmevahetuskihi kaudu Eesti Hariduse Infosüsteemist. Paragrahvi 7 punktis 8 nimetatud andmed saadakse infosüsteemide andmevahetuskihi kaudu Eesti Hariduse Infosüsteemist. 2 (2) Paragrahvi 8 lõike 1 punktis 1 ja lõike 2 punktis 1 nimetatud andmed saadakse infosüsteemide andmevahetuskihi kaudu Eesti rahvastikuregistrist. RT I 2016-07-29 11 129072016011 2016-08-01 Paragrahvi 8 lõike 1 punktis 1 ja lõike 2 punktis 1 nimetatud andmed saadakse infosüsteemide andmevahetuskihi kaudu Eesti rahvastikuregistrist.",
      "rdfs:label": {
