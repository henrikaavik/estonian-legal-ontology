      "estleg:provisionRef": "Reg_335568 § 8_8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335568_Map"
      }
    },
    {
      "@id": "estleg:Reg_335568_Par_9_v335568",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
