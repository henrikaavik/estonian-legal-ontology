        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrit peetakse ühetasandilise infotehnoloogilise andmekoguna. Registrit peetakse ühetasandilise infotehnoloogilise andmekoguna.",
      "rdfs:label": {
        "@value": "Reg_335568_Par_3 (redaktsioon 335568)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "335568",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/335568",
