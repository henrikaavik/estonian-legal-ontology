      }
    },
    {
      "@id": "estleg:Reg_1061906_Par_5_v1061906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061906_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tõlgi tasu ja muud kulud määratakse tõlgi või muu teenuse osutaja ning visiidi korraldaja vahelise kokkuleppega. Tõlgi tasu ja muud kulud määratakse tõlgi või muu teenuse osutaja ning visiidi korraldaja vahelise kokkuleppega.",
      "rdfs:label": {
        "@value": "Reg_1061906_Par_5 (redaktsioon 1061906)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061906",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061906",
      "estleg:sourceAct": "Väliskülaliste vastuvõtmisega seotud majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad riigiasutustele",
      "estleg:provisionRef": "Reg_1061906 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061906_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061906_Par_6_v1061906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061906_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvides 2 ja 4 sätestatud piirmäärasid võib ületada erivajadustega külalise puhul või külaliste turvalisuse huvides. Paragrahvides 2 ja 4 sätestatud piirmäärasid võib ületada erivajadustega külalise puhul või külaliste turvalisuse huvides. 2 (2) Paragrahvi 2 lõikes 1 sätestatud inimeste arvu võib ületada Eesti arengukoostöö sihtriikide, äridiplomaatia prioriteetriikide ning riikide, keda Eesti on otsustanud välispoliitiliselt toetada, puhul. Paragrahvi 2 lõikes 1 sätestatud inimeste arvu võib ületada Eesti arengukoostöö sihtriikide, äridiplomaatia prioriteetriikide ning riikide, keda Eesti on otsustanud välispoliitiliselt toetada, puhul. 3 (3) Riigipea visiidi korral võib paragrahvis 2 sätestatust teha erandeid ning paragrahvides 3 ja 4 sätestatud piirmäärasid ei kohaldata. Riigipea visiidi korral võib paragrahvis 2 sätestatust teha erandeid ning paragrahvides 3 ja 4 sätestatud piirmäärasid ei kohaldata.",
      "rdfs:label": {
        "@value": "Reg_1061906_Par_6 (redaktsioon 1061906)",
        "@language": "et"
      },
