      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Väliskülaliste vastuvõtmisega seotud majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad riigiasutustele (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Väliskülaliste vastuvõtmisega seotud majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad riigiasutustele"
    },
    {
      "@id": "estleg:Reg_1061906_Par_1_v1061906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061906_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad, millest riigiasutused peavad lähtuma välisriigi riigipea, ministri ja kõrgema riigiametniku või rahvusvahelise organisatsiooni juhi ja kõrgema ametniku vastuvõtmisel. Määrusega kehtestatakse majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad, millest riigiasutused peavad lähtuma välisriigi riigipea, ministri ja kõrgema riigiametniku või rahvusvahelise organisatsiooni juhi ja kõrgema ametniku vastuvõtmisel. 2 (2) Määrust ei kohaldata Eestis toimuvate konverentside ega teadus- või koolitusürituste korraldamisele. Määrust ei kohaldata Eestis toimuvate konverentside ega teadus- või koolitusürituste korraldamisele.",
      "rdfs:label": {
        "@value": "Reg_1061906_Par_1 (redaktsioon 1061906)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061906",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061906",
      "estleg:sourceAct": "Väliskülaliste vastuvõtmisega seotud majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad riigiasutustele",
      "estleg:provisionRef": "Reg_1061906 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061906_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061906_Par_2_v1061906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061906_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Väliskülaliste vastuvõtmisel kannab Eesti pool külaliste majutuskulud järgmiselt: 1 1) riigivisiidi puhul kuni 10 inimese majutuskulud; 2 2) ametliku visiidi puhul kuni 5 inimese majutuskulud; 3 3) töövisiidi puhul kuni 2 inimese majutuskulud. Väliskülaliste vastuvõtmisel kannab Eesti pool külaliste majutuskulud järgmiselt: riigivisiidi puhul kuni 10 inimese majutuskulud; ametliku visiidi puhul kuni 5 inimese majutuskulud; töövisiidi puhul kuni 2 inimese majutuskulud. 2 (2) Majutuskulude piirmäär ühe inimese kohta päevas on: 1 1) riigipea või valitsusjuhi tasemel delegatsiooni puhul 1100 eurot; 2 2) ministri või aseministri tasemel delegatsiooni puhul 450 eurot; 3 3) muu delegatsiooni juhi, delegatsiooni liikme ja üksikkülalise puhul 200 eurot. Majutuskulude piirmäär ühe inimese kohta päevas on: riigipea või valitsusjuhi tasemel delegatsiooni puhul 1100 eurot; ministri või aseministri tasemel delegatsiooni puhul 450 eurot; muu delegatsiooni juhi, delegatsiooni liikme ja üksikkülalise puhul 200 eurot. 3 (3) Käesoleva määruse tähenduses loetakse riigivisiidiks välisriigi riigipea kõrgeima taseme visiiti, ametlikuks visiidiks välisriigi riigipea, valitsusjuhi ja rahvusvahelise organisatsiooni juhi visiiti ning töövisiidiks välisriigi riigipea, valitsusjuhi, ministri, kõrgema riigiametniku, rahvusvahelise organisatsiooni juhi ja kõrgema ametniku tööalast visiiti. Visiidi vorm lepitakse kokku väliskülalisega. Käesoleva määruse tähenduses loetakse riigivisiidiks välisriigi riigipea kõrgeima taseme visiiti, ametlikuks visiidiks välisriigi riigipea, valitsusjuhi ja rahvusvahelise organisatsiooni juhi visiiti ning töövisiidiks välisriigi riigipea, valitsusjuhi, ministri, kõrgema riigiametniku, rahvusvahelise organisatsiooni juhi ja kõrgema ametniku tööalast visiiti. Visiidi vorm lepitakse kokku väliskülalisega.",
      "rdfs:label": {
        "@value": "Reg_1061906_Par_2 (redaktsioon 1061906)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061906",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061906",
      "estleg:sourceAct": "Väliskülaliste vastuvõtmisega seotud majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad riigiasutustele",
      "estleg:provisionRef": "Reg_1061906 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061906_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061906_Par_3_v1061906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
