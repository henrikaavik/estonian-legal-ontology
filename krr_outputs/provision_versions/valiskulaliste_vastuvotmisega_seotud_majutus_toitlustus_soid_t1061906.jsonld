        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõiduki rentimise kulude piirmäär ühe sõiduki kohta on 1000 eurot päevas. Sõiduki rentimise kulude piirmäär ühe sõiduki kohta on 1000 eurot päevas.",
      "rdfs:label": {
