        "@type": "xsd:date"
      },
      "estleg:versionText": "Toitlustuskulude piirmäär ühe inimese kohta päevas on: 1 1) ministri tasemel delegatsiooni puhul 250 eurot; 2 2) muu, madalamal tasemel delegatsiooni või üksikkülalise puhul 200 eurot. Toitlustuskulude piirmäär ühe inimese kohta päevas on: ministri tasemel delegatsiooni puhul 250 eurot; muu, madalamal tasemel delegatsiooni või üksikkülalise puhul 200 eurot.",
      "rdfs:label": {
        "@value": "Reg_1061906_Par_3 (redaktsioon 1061906)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061906",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061906",
      "estleg:sourceAct": "Väliskülaliste vastuvõtmisega seotud majutus-, toitlustus-, sõidu-, tõlke- ja muude kulude piirmäärad riigiasutustele",
      "estleg:provisionRef": "Reg_1061906 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061906_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061906_Par_4_v1061906",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
