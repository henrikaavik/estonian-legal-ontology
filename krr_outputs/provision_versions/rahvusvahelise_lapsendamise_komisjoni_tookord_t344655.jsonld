      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/344655",
      "estleg:sourceAct": "Rahvusvahelise lapsendamise komisjoni töökord",
      "estleg:provisionRef": "Reg_344655 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_344655_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_344655_Par_3_v344655",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_344655_Par_3"
