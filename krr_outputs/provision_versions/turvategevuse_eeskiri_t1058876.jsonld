    {
      "@id": "estleg:Reg_1058876_Par_3_v1058876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058876_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Turvaettevõtja koostab turvaplaani ja esitab selle turvamise tellijale enne turvamist. Turvaplaan võib olla osa turvamiseks sõlmitavast lepingust. Turvaettevõtja koostab turvaplaani ja esitab selle turvamise tellijale enne turvamist. Turvaplaan võib olla osa turvamiseks sõlmitavast lepingust. 2 (2) Turvaplaani allkirjastab turvajuht. Turvaplaani allkirjastab turvajuht.",
      "rdfs:label": {
        "@value": "Reg_1058876_Par_3 (redaktsioon 1058876)",
