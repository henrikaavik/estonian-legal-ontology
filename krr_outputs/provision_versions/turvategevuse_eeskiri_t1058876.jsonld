      }
    },
    {
      "@id": "estleg:Reg_1058876_Par_7_v1058876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058876_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kutsenõuetele vastavuse säilitamiseks läbib turvateenistuja igal aastal turvateenistuja täienduskoolituse, mille maht on vähemalt 16 akadeemilist tundi. Kutsenõuetele vastavuse säilitamiseks läbib turvateenistuja igal aastal turvateenistuja täienduskoolituse, mille maht on vähemalt 16 akadeemilist tundi. 2 (2) Turvatöötaja ja turvamise turvajuhi täienduskoolitus sisaldab vähemalt kuue akadeemilise tunni ulatuses praktilist kontaktõpet füüsilise jõu, relva ja erivahendi kasutamise kohta. Turvatöötaja ja turvamise turvajuhi täienduskoolitus sisaldab vähemalt kuue akadeemilise tunni ulatuses praktilist kontaktõpet füüsilise jõu, relva ja erivahendi kasutamise kohta. 3 (3) Turvateenistuja, kes täidab tööülesannet, milleks on vaja lisateadmisi, -oskusi ja -hoiakuid, läbib enne tööülesande täitmist vastava erialase koolituse. Turvateenistuja, kes täidab tööülesannet, milleks on vaja lisateadmisi, -oskusi ja -hoiakuid, läbib enne tööülesande täitmist vastava erialase koolituse.",
      "rdfs:label": {
        "@value": "Reg_1058876_Par_7 (redaktsioon 1058876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058876",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058876",
      "estleg:sourceAct": "Turvategevuse eeskiri",
      "estleg:provisionRef": "Reg_1058876 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058876_Map"
      }
    },
    {
      "@id": "estleg:Reg_1058876_Par_8_v1058876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058876_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Turvateenistuja koolitajal peavad olema turvateenistuja väljaõppe ettevalmistamiseks ja läbiviimiseks vajalikud teadmised, oskused ja hoiakud. Turvateenistuja koolitajal peavad olema turvateenistuja väljaõppe ettevalmistamiseks ja läbiviimiseks vajalikud teadmised, oskused ja hoiakud. 2 (2) Turvateenistuja koolitaja läbib vähemalt üks kord viie aasta jooksul erialase täienduskoolituse. Turvateenistuja koolitaja läbib vähemalt üks kord viie aasta jooksul erialase täienduskoolituse.",
      "rdfs:label": {
        "@value": "Reg_1058876_Par_8 (redaktsioon 1058876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058876",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1058876",
      "estleg:sourceAct": "Turvategevuse eeskiri",
      "estleg:provisionRef": "Reg_1058876 § 8",
