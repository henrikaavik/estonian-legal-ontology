      }
    },
    {
      "@id": "estleg:Reg_1058876_Par_9_v1058876",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1058876_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Turvateenistuja peab: 1 1) olema aus ja seaduskuulekas; 2 2) oskama teha meeskonnatööd; 3 3) olema kohusetundlik ja otsustusvõimeline; 4 4) olema hea suhtleja ja analüüsivõimeline. Turvateenistuja peab: olema aus ja seaduskuulekas; oskama teha meeskonnatööd; olema kohusetundlik ja otsustusvõimeline; olema hea suhtleja ja analüüsivõimeline. 2 (2) Turvatöötaja ja turvamise turvajuhi kehaline ettevalmistus peab võimaldama tal oma tööülesannete täitmisel kasutada erivahendeid ja rakendada jõudu. Turvatöötaja ja turvamise turvajuhi kehaline ettevalmistus peab võimaldama tal oma tööülesannete täitmisel kasutada erivahendeid ja rakendada jõudu. 3 (3) Turvaettevõtja kontrollib turvatöötaja ja turvamise turvajuhi kehalise ettevalmistuse nõuetele vastavust vähemalt üks kord aastas. Turvaettevõtja kontrollib turvatöötaja ja turvamise turvajuhi kehalise ettevalmistuse nõuetele vastavust vähemalt üks kord aastas.",
      "rdfs:label": {
