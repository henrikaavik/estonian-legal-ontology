        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 1. juulil 2024. aastal. Määrus jõustub 1. juulil 2024. aastal.",
      "rdfs:label": {
        "@value": "Reg_1058876_Par_30 (redaktsioon 1058876)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1058876",
