    {
      "@id": "estleg:Reg_1026228_Par_20_v1026228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026228_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1026228_Par_20 (redaktsioon 1026228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026228",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026228",
      "estleg:sourceAct": "Ropka-Ihaste looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1026228 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026228_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026228_Par_3_v1026228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026228_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1026228_Par_3 (redaktsioon 1026228)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026228",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026228",
      "estleg:sourceAct": "Ropka-Ihaste looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1026228 § 3",
      "estleg:partOfAct": {
