    {
      "@id": "estleg:Reg_1026228_Par_10_v1026228",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026228_Par_10"
