      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas3 on esitatud põhjendused: 3 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndi piiri kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas3 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndi piiri kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1054736_Par_4 (redaktsioon 1054736)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054736",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054736",
      "estleg:sourceAct": "Papioru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1054736 § 4",
      "estleg:partOfAct": {
