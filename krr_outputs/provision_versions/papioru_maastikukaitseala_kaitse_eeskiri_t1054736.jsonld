        "@value": "2022-09-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 18. märtsi 2021. a käskkirjaga nr 1-2/21/150 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 18. märtsi 2021. a käskkirjaga nr 1-2/21/150 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1054736_Par_11 (redaktsioon 1054736)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054736",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054736",
      "estleg:sourceAct": "Papioru maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1054736 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054736_Map"
      }
    },
    {
      "@id": "estleg:Reg_1054736_Par_12_v1054736",
      "@type": [
        "owl:NamedIndividual",
