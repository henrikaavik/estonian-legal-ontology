      "estleg:provisionRef": "Reg_1041785 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041785_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041785_Par_14_v1041785",
      "@type": [
