      }
    },
    {
      "@id": "estleg:Reg_163062_Par_5_v163062",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_163062_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-08-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sadama pidaja, kes kavatseb osutada sadamateenuseid välisriigi lipu või Eesti lipu all sõitvale laevale kogumahutavusega 500 ja enam, peab sellest teatama Transpordiametile ja Riigilaevastikule vähemalt kuus kuud enne sadamateenuste osutamise alustamist eespool nimetatud laevadele. RT I 2023-06-09 9 109062023009 2023-07-01 Sadama pidaja, kes kavatseb osutada sadamateenuseid välisriigi lipu või Eesti lipu all sõitvale laevale kogumahutavusega 500 ja enam, peab sellest teatama Transpordiametile ja Riigilaevastikule vähemalt kuus kuud enne sadamateenuste osutamise alustamist eespool nimetatud laevadele.",
