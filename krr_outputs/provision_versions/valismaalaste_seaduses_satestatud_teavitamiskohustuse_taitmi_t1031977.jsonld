      "estleg:provisionRef": "Reg_1031977 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1031977_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1031977_Par_2_v1031977",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031977_Par_2"
