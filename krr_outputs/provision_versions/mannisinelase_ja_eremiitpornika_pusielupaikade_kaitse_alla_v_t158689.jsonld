    {
      "@id": "estleg:Reg_158689_Par_4_v158689",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158689_Par_4"
