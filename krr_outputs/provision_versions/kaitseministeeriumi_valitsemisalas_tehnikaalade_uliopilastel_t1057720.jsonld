        "@language": "et"
      },
      "estleg:versionRedactionId": "1057720",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057720",
      "estleg:sourceAct": "Kaitseministeeriumi valitsemisalas tehnikaalade üliõpilastele stipendiumi määramise tingimused ja kord",
      "estleg:provisionRef": "Reg_1057720 § 10",
