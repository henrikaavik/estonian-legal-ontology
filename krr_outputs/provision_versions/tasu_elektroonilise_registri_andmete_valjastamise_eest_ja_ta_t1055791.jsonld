      "estleg:provisionRef": "Reg_1055791 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055791_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055791_Par_3_v1055791",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055791_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikaardi andmed on äriregistri seaduse §-des 12–21, mittetulundusühingute seaduse § 10 lõikes 1 ning sihtasutuste seaduse §-s 14 nimetatud andmed. Registrikaardi andmed on äriregistri seaduse §-des 12–21, mittetulundusühingute seaduse § 10 lõikes 1 ning sihtasutuste seaduse §-s 14 nimetatud andmed.",
      "rdfs:label": {
        "@value": "Reg_1055791_Par_3 (redaktsioon 1055791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055791",
      "estleg:sourceAct": "Tasu elektroonilise registri andmete väljastamise eest ja tasuta andmeid saama õigustatud isikud",
      "estleg:provisionRef": "Reg_1055791 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055791_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055791_Par_4_v1055791",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055791_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrikaardivälised andmed käesoleva määruse tähenduses on kõik andmed, mida kuvatakse elektroonilises registris, kuid ei kanta registrikaardile. Registrikaardivälised andmed käesoleva määruse tähenduses on kõik andmed, mida kuvatakse elektroonilises registris, kuid ei kanta registrikaardile.",
      "rdfs:label": {
        "@value": "Reg_1055791_Par_4 (redaktsioon 1055791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055791",
      "estleg:sourceAct": "Tasu elektroonilise registri andmete väljastamise eest ja tasuta andmeid saama õigustatud isikud",
      "estleg:provisionRef": "Reg_1055791 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055791_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055791_Par_5_v1055791",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055791_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avaliku toimiku elektrooniline dokument käesoleva määruse tähenduses on avalikku toimikusse kuuluv dokument, mis on tehtud kättesaadavaks äriregistri seaduse § 7 lõike 2 punkti 1 alusel kehtestatud määruses nimetatud vormingus. Avaliku toimiku elektrooniline dokument käesoleva määruse tähenduses on avalikku toimikusse kuuluv dokument, mis on tehtud kättesaadavaks äriregistri seaduse § 7 lõike 2 punkti 1 alusel kehtestatud määruses nimetatud vormingus.",
      "rdfs:label": {
        "@value": "Reg_1055791_Par_5 (redaktsioon 1055791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055791",
      "estleg:sourceAct": "Tasu elektroonilise registri andmete väljastamise eest ja tasuta andmeid saama õigustatud isikud",
      "estleg:provisionRef": "Reg_1055791 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055791_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055791_Par_6_v1055791",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055791_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päring käesoleva määruse tähenduses on e-äriregistri andmete kohta e-teenuste või e-äriregistri kaudu tehtav päring, mille alusel väljastatakse andmekoosseis vastavalt §-dele 3–5. Päring käesoleva määruse tähenduses on e-äriregistri andmete kohta e-teenuste või e-äriregistri kaudu tehtav päring, mille alusel väljastatakse andmekoosseis vastavalt §-dele 3–5.",
      "rdfs:label": {
        "@value": "Reg_1055791_Par_6 (redaktsioon 1055791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055791",
      "estleg:sourceAct": "Tasu elektroonilise registri andmete väljastamise eest ja tasuta andmeid saama õigustatud isikud",
      "estleg:provisionRef": "Reg_1055791 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055791_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055791_Par_7_v1055791",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055791_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päringutasu tasutakse enne elektrooniliste andmete väljastamist, välja arvatud juhul, kui Registrite ja Infosüsteemide Keskusega sõlmitud päringusüsteemide kasutamise lepingus on sätestatud teisiti. Päringutasu tasutakse enne elektrooniliste andmete väljastamist, välja arvatud juhul, kui Registrite ja Infosüsteemide Keskusega sõlmitud päringusüsteemide kasutamise lepingus on sätestatud teisiti.",
      "rdfs:label": {
        "@value": "Reg_1055791_Par_7 (redaktsioon 1055791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055791",
      "estleg:sourceAct": "Tasu elektroonilise registri andmete väljastamise eest ja tasuta andmeid saama õigustatud isikud",
      "estleg:provisionRef": "Reg_1055791 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055791_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055791_Par_8_v1055791",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055791_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Paragrahvides 3–5 nimetatud andmete ja dokumentide elektroonilise väljastamise eest, sealhulgas XML-, JSON-, XBRL- või muus vormingus allalaadimise võimaldamise eest, ei võeta tasu. Paragrahvides 3–5 nimetatud andmete ja dokumentide elektroonilise väljastamise eest, sealhulgas XML-, JSON-, XBRL- või muus vormingus allalaadimise võimaldamise eest, ei võeta tasu. 2 (2) Mittetulundusühingu kohta §-s 5 nimetatud avaliku toimiku elektroonilise dokumendi väljastamise eest võetakse tasu ühe päringu eest 2 eurot. Mittetulundusühingu kohta §-s 5 nimetatud avaliku toimiku elektroonilise dokumendi väljastamise eest võetakse tasu ühe päringu eest 2 eurot.",
      "rdfs:label": {
        "@value": "Reg_1055791_Par_8 (redaktsioon 1055791)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055791",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055791",
