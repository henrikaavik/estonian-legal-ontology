    {
      "@id": "estleg:Reg_303775_Par_25_v303775",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_303775_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne 1. maid 2006. aastal kehtinud nõuete kohaselt märgistatud õli- ja kiudtaimede pakendatud seemet võib turustada kuni kauba lõppemiseni. RTL 2007 24 429 12804828 2007-03-25+02:00 Enne 1. maid 2006. aastal kehtinud nõuete kohaselt märgistatud õli- ja kiudtaimede pakendatud seemet võib turustada kuni kauba lõppemiseni. 2 (2) Enne 25. märtsi 2007. aastal kehtinud nõuete kohaselt märgistatud õli- ja kiudtaimede pakendatud seemet võib turustada kuni etiketi kehtivusaja lõpuni. RTL 2007 24 429 12804828 2007-03-25+02:00 Enne 25. märtsi 2007. aastal kehtinud nõuete kohaselt märgistatud õli- ja kiudtaimede pakendatud seemet võib turustada kuni etiketi kehtivusaja lõpuni.",
      "rdfs:label": {
        "@value": "Reg_303775_Par_25 (redaktsioon 303775)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303775",
