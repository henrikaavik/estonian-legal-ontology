      },
      "estleg:versionText": "Määrus jõustub 1. mail 2006. a. Määrus jõustub 1. mail 2006. a.",
      "rdfs:label": {
        "@value": "Reg_303775_Par_26 (redaktsioon 303775)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "303775",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/303775",
      "estleg:sourceAct": "Õli- ja kiudtaimede seemne kategooriad ning õli- ja kiudtaimede seemne tootmise ja turustamise nõuded",
