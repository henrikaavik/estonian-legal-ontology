      "dc:source": "Õli- ja kiudtaimede seemne kategooriad ning õli- ja kiudtaimede seemne tootmise ja turustamise nõuded"
    },
    {
      "@id": "estleg:Reg_303775_Par_1_v303775",
      "@type": [
        "owl:NamedIndividual",
