        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014062",
      "estleg:sourceAct": "Säästva arengu seadus",
      "estleg:provisionRef": "SaAS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:SaAS_Map_2026"
      }
    },
    {
      "@id": "estleg:SaAS_Par_10_v110112016016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SaAS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Keskkonnanormatiiv on keskkonna kvaliteedile, heitmekogusele või toodangu ühikule kehtestatud keskkonnakaitseline kontrollarv või loodusvara erikulu. (2) Keskkonnanormatiiv muudetakse kohustuslikuks valdkonna eest vastutava ministri määruse või saasteloaga. (3) Keskkonnastandard on asjaosaliste kokkuleppel koostatud ning kinnitatud reegleid, juhtnööre ja arvnäitajaid sisaldav dokument, mis korraldab keskkonnaseisundit mõjutavat või mõjutada võivat tegevust või tegevuse tulemust. (4) [Välja jäetud]",
      "rdfs:label": {
        "@value": "SaAS_Par_10 (redaktsioon 110112016016)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110112016016",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110112016016",
