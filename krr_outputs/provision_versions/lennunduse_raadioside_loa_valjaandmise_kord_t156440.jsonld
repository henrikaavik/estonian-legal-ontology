    {
      "@id": "estleg:Reg_156440_Par_2_v156440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156440_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kehtetu – 2013-06-25 RT I 2013-06-28 10 128062013010 2013-07-01 Kehtetu – 2 (2) Luba annab selle valdajale õiguse pidada raadiosidet vastavalt loas toodud keeleoskusmärkele, milles isik on sooritanud lennunduse raadioside eksami. RT I 2013-06-28 10 128062013010 2013-07-01 Luba annab selle valdajale õiguse pidada raadiosidet vastavalt loas toodud keeleoskusmärkele, milles isik on sooritanud lennunduse raadioside eksami. 3 (3) Luba võib olla välja antud eraldi dokumendina või märkena lennundusloal. Luba võib olla välja antud eraldi dokumendina või märkena lennundusloal. 4 (4) Raadiosidet pidaval isikul peab luba olema kaasas tööülesannete täitmisel. Raadiosidet pidaval isikul peab luba olema kaasas tööülesannete täitmisel.",
      "rdfs:label": {
        "@value": "Reg_156440_Par_2 (redaktsioon 156440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156440",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156440",
      "estleg:sourceAct": "Lennunduse raadioside loa väljaandmise kord",
      "estleg:provisionRef": "Reg_156440 § 2",
      "estleg:partOfAct": {
