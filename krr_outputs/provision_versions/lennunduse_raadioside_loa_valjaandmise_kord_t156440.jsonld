      }
    },
    {
      "@id": "estleg:Reg_156440_Par_7_v156440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156440_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolitust loa saamiseks võib läbi viia ainult Lennuametis registreeritud koolitaja või lennukoolitusorganisatsioon. Koolitust loa saamiseks võib läbi viia ainult Lennuametis registreeritud koolitaja või lennukoolitusorganisatsioon.",
      "rdfs:label": {
        "@value": "Reg_156440_Par_7 (redaktsioon 156440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156440",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156440",
      "estleg:sourceAct": "Lennunduse raadioside loa väljaandmise kord",
      "estleg:provisionRef": "Reg_156440 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156440_Map"
      }
    },
    {
      "@id": "estleg:Reg_156440_Par_8_v156440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156440_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolitus tuleb läbi viia vastavalt Lennuameti poolt heakskiidetud programmile. Koolitus võib moodustada osa muust lennundusalasest koolitusest. Koolitus tuleb läbi viia vastavalt Lennuameti poolt heakskiidetud programmile. Koolitus võib moodustada osa muust lennundusalasest koolitusest. 2 (2) Koolitusprogrammi heakskiitmise taotlemiseks esitatakse Lennuametile kirjalik avaldus, millele on lisatud järgmised andmed: 1 1) registreeritud koolitaja või lennukoolitusorganisatsiooni nimi ja kontaktandmed; 2 2) teooriaõpetajate nimed ja kvalifikatsioon; 3 3) koolitusprogrammi kirjeldus; 4 4) ülevaade õppetööks ettenähtud ruumidest ja seadmetest. Koolitusprogrammi heakskiitmise taotlemiseks esitatakse Lennuametile kirjalik avaldus, millele on lisatud järgmised andmed: registreeritud koolitaja või lennukoolitusorganisatsiooni nimi ja kontaktandmed; teooriaõpetajate nimed ja kvalifikatsioon; koolitusprogrammi kirjeldus; ülevaade õppetööks ettenähtud ruumidest ja seadmetest. 3 (3) Lennuametil on õigus nõuda muud asjakohast teavet lisaks lõikes 2 esitatud asjaoludele. Lennuametil on õigus nõuda muud asjakohast teavet lisaks lõikes 2 esitatud asjaoludele. 4 (4) Lennuamet annab koolitusprogrammile heakskiidu, kui see hõlmab kõiki 1944. a Chicago rahvusvahelise tsiviillennunduse konventsiooni lisa 2 («Lennureeglid»), lisa 10 («Lennunduse elekterside»), Doc 4444 («Lennuliikluse korraldamine») ja Doc 9432 («Raadioside käsiraamat») raadiosidet käsitlevaid osi. Lennuamet annab koolitusprogrammile heakskiidu, kui see hõlmab kõiki 1944. a Chicago rahvusvahelise tsiviillennunduse konventsiooni lisa 2 («Lennureeglid»), lisa 10 («Lennunduse elekterside»), Doc 4444 («Lennuliikluse korraldamine») ja Doc 9432 («Raadioside käsiraamat») raadiosidet käsitlevaid osi. 5 (5) Kui koolitus ei moodusta osa muust lennundusalasest koolitusest, peab registreeritud koolitaja või lennukoolitusorganisatsioon enne koolituse algust esitama Lennuametile nimekirja koolitusprogrammi läbima asuvatest taotlejatest. Kui koolitus ei moodusta osa muust lennundusalasest koolitusest, peab registreeritud koolitaja või lennukoolitusorganisatsioon enne koolituse algust esitama Lennuametile nimekirja koolitusprogrammi läbima asuvatest taotlejatest. 6 (6) Lõikes 2 esitatud andmete aluseks olevate asjaolude muutumisel koolituse toimumise ajal peab registreeritud koolitaja või lennukoolitusorganisatsioon kooskõlastama need Lennuametiga. Lõikes 2 esitatud andmete aluseks olevate asjaolude muutumisel koolituse toimumise ajal peab registreeritud koolitaja või lennukoolitusorganisatsioon kooskõlastama need Lennuametiga. 7 (7) Vahetult pärast koolitusprogrammi lõppemist peab koolitusorganisatsiooni või registreeritud koolitaja koolituse eest vastutav isik allkirjaga kinnitama koolitusprogrammi edukat läbimist taotleja raadioside kvalifikatsioonieksami avalduse ja aruande vormil. Vahetult pärast koolitusprogrammi lõppemist peab koolitusorganisatsiooni või registreeritud koolitaja koolituse eest vastutav isik allkirjaga kinnitama koolitusprogrammi edukat läbimist taotleja raadioside kvalifikatsioonieksami avalduse ja aruande vormil.",
      "rdfs:label": {
        "@value": "Reg_156440_Par_8 (redaktsioon 156440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156440",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156440",
      "estleg:sourceAct": "Lennunduse raadioside loa väljaandmise kord",
      "estleg:provisionRef": "Reg_156440 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156440_Map"
      }
    },
    {
      "@id": "estleg:Reg_156440_Par_9_v156440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_156440_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-06-25",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registreeritud koolitaja või lennukoolitusorganisatsioon peab säilitama kursuse lõpupäevast alates kolme aasta jooksul ja esitama Lennuametile viimase nõudmisel kõik 1 1) koolitusprogrammid; 2 2) päevikud, milles kajastub õppetundide arv ja sisu; 3 3) õpetajate nimekirja. Registreeritud koolitaja või lennukoolitusorganisatsioon peab säilitama kursuse lõpupäevast alates kolme aasta jooksul ja esitama Lennuametile viimase nõudmisel kõik koolitusprogrammid; päevikud, milles kajastub õppetundide arv ja sisu; õpetajate nimekirja.",
      "rdfs:label": {
        "@value": "Reg_156440_Par_9 (redaktsioon 156440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "156440",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/156440",
      "estleg:sourceAct": "Lennunduse raadioside loa väljaandmise kord",
      "estleg:provisionRef": "Reg_156440 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_156440_Map"
      }
    },
