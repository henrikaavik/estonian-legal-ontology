      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Lossitava kala kaalumise täiendavad nõuded ja metoodika (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lossitava kala kaalumise täiendavad nõuded ja metoodika"
    },
    {
      "@id": "estleg:Reg_1042007_Par_1_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse nõuded lossitava kala kaalumise kohta, kui kala on püütud merel kutselisel kalapüügil: 1 1) kastmõrraga; 2 2) traalpüünisega; 3 3) põhjanoodaga; 4 4) kalalaevaga, millel käesoleva määruse erisusi arvestades ei kasutata käesoleva paragrahvi punktides 1–3 loetletud püügivahendeid ja mille üldpikkus on vähemalt 10 meetrit (edaspidi kalalaev, mille üldpikkus on vähemalt 10 meetrit). Määrusega kehtestatakse nõuded lossitava kala kaalumise kohta, kui kala on püütud merel kutselisel kalapüügil: kastmõrraga; traalpüünisega; põhjanoodaga; kalalaevaga, millel käesoleva määruse erisusi arvestades ei kasutata käesoleva paragrahvi punktides 1–3 loetletud püügivahendeid ja mille üldpikkus on vähemalt 10 meetrit (edaspidi kalalaev, mille üldpikkus on vähemalt 10 meetrit).",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_1 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042007_Par_2_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Traalpüünisega püügil vastutab lossitava kala kaalumise ja lossimisdeklaratsiooni andmete õigsuse eest kalalaeva kapten. Traalpüünisega püügil vastutab lossitava kala kaalumise ja lossimisdeklaratsiooni andmete õigsuse eest kalalaeva kapten. 2 (2) Kalapüügil kastmõrra, põhjanooda ja kalalaevaga, mille üldpikkus on vähemalt 10 meetrit, vastutab lossitava kala kaalumise ja lossimisdeklaratsiooni andmete õigsuse eest kalapüügiloa omanik või tema volitatud esindaja. Kalapüügil kastmõrra, põhjanooda ja kalalaevaga, mille üldpikkus on vähemalt 10 meetrit, vastutab lossitava kala kaalumise ja lossimisdeklaratsiooni andmete õigsuse eest kalapüügiloa omanik või tema volitatud esindaja.",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_2 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042007_Par_3_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pelaagiliste liikide kaalumisel võib nende kogumassist 2% ulatuses maha arvata vee ja jää. Pelaagiliste liikide kaalumisel võib nende kogumassist 2% ulatuses maha arvata vee ja jää.",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_3 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042007_Par_4_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kala kaalutakse lossimisel maaletoomiskohas enne töötlemist, üleandmist, hoidlas hoidmist, transportimist, esmamüüki või kui kala viiakse välisriiki. Kala kaalutakse lossimisel maaletoomiskohas enne töötlemist, üleandmist, hoidlas hoidmist, transportimist, esmamüüki või kui kala viiakse välisriiki.",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_4 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042007_Par_5_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erandina käesoleva määruse §-s 4 sätestatust võib lossitava kala maaletoomiskohas kaaluda osaliselt käesoleva määruse lisa kohaselt, kui kala on püütud kastmõrraga või traalpüünisega ja käesoleva paragrahvi lõigete 2–4 alusel on võimalik moodustada esinduslik mahutite valim. Erandina käesoleva määruse §-s 4 sätestatust võib lossitava kala maaletoomiskohas kaaluda osaliselt käesoleva määruse lisa kohaselt, kui kala on püütud kastmõrraga või traalpüünisega ja käesoleva paragrahvi lõigete 2–4 alusel on võimalik moodustada esinduslik mahutite valim. 2 (2) Kõik kalaga täitmata mahutid on sama eeldatava massiga. Kõik kalaga täitmata mahutid on sama eeldatava massiga. 3 (3) Kõik lossitavad mahutid täidetakse kalaga võrdsel määral. Lossitavad mahutid loetakse võrdsel määral täidetuks, kui kala mass kaalutavates mahutites ei erine rohkem kui 15%. Kõik lossitavad mahutid täidetakse kalaga võrdsel määral. Lossitavad mahutid loetakse võrdsel määral täidetuks, kui kala mass kaalutavates mahutites ei erine rohkem kui 15%. 4 (4) Lossitava kala kogumass saadakse, arvutades kalaga täidetud kaalutud mahutite alusel kala keskmise massi ühe mahuti kohta ilma mahuti massita ning saadud tulemus korrutatakse lossitavate mahutite koguarvuga. Lossitava kala kogumass saadakse, arvutades kalaga täidetud kaalutud mahutite alusel kala keskmise massi ühe mahuti kohta ilma mahuti massita ning saadud tulemus korrutatakse lossitavate mahutite koguarvuga. 5 (5) Kala osalisel kaalumisel maaletoomiskohas võib iga lossimise kohta esineda üks mahuti, mis ei ole ülejäänud mahutitega võrdsel määral kalaga täidetud. Kala osalisel kaalumisel maaletoomiskohas võib iga lossimise kohta esineda üks mahuti, mis ei ole ülejäänud mahutitega võrdsel määral kalaga täidetud. 6 (6) Käesoleva paragrahvi lõike 5 kohaselt täidetud mahutit ei arvata kaalutavate mahutite valimi hulka, vaid kaalutakse eraldi ning saadud tulemus liidetakse käesoleva paragrahvi lõike 4 kohaselt arvutatud kala kogumassi tulemusele. Käesoleva paragrahvi lõike 5 kohaselt täidetud mahutit ei arvata kaalutavate mahutite valimi hulka, vaid kaalutakse eraldi ning saadud tulemus liidetakse käesoleva paragrahvi lõike 4 kohaselt arvutatud kala kogumassi tulemusele.",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_5 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042007_Par_6_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Erandina käesoleva määruse §-s 4 sätestatust võib kala transportida ja kaaluda kalakäitlemisettevõttes, kui: 1 1) kala lossitakse kalalaevalt paakautosse; 2 2) kala on püütud põhjanoodaga või käesoleva määruse § 1 punktis 4 nimetatud juhul. Erandina käesoleva määruse §-s 4 sätestatust võib kala transportida ja kaaluda kalakäitlemisettevõttes, kui: kala lossitakse kalalaevalt paakautosse; kala on püütud põhjanoodaga või käesoleva määruse § 1 punktis 4 nimetatud juhul. 2 (2) Kala kaalumine kalakäitlemisettevõttes peab toimuma enne kala käitlemist ettevõttes, sealhulgas enne üleandmist, hoidlas hoidmist, töötlemist ja müüki. Kala kaalumine kalakäitlemisettevõttes peab toimuma enne kala käitlemist ettevõttes, sealhulgas enne üleandmist, hoidlas hoidmist, töötlemist ja müüki. 3 (3) Kala kaalumisel ettevõttes kaalutakse kogu lossitud kala, osaline kaalumine ei ole lubatud. Kala kaalumisel ettevõttes kaalutakse kogu lossitud kala, osaline kaalumine ei ole lubatud.",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_6 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1042007_Par_7_v1042007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1042007_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse §-de 4–6 kohaselt kaalutud kala kaalumisandmed, arvestades kalaliigi osakaalu määramist Vabariigi Valitsuse 16. juuni 2016. a määruse nr 65 „Kalapüügieeskiri” § 15 kohaselt, märgitakse lossimisdeklaratsiooni ja esitatakse lossimisdeklaratsioonis enne esmakokkuostukviitungi või üleandmisdeklaratsiooni esitamist ja enne kala müüki oma tarbeks kalapüügiseaduse § 10 lõike 12 kohasel juhul. Käesoleva määruse §-de 4–6 kohaselt kaalutud kala kaalumisandmed, arvestades kalaliigi osakaalu määramist Vabariigi Valitsuse 16. juuni 2016. a määruse nr 65 „Kalapüügieeskiri” § 15 kohaselt, märgitakse lossimisdeklaratsiooni ja esitatakse lossimisdeklaratsioonis enne esmakokkuostukviitungi või üleandmisdeklaratsiooni esitamist ja enne kala müüki oma tarbeks kalapüügiseaduse § 10 lõike 12 kohasel juhul.",
      "rdfs:label": {
        "@value": "Reg_1042007_Par_7 (redaktsioon 1042007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1042007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1042007",
      "estleg:sourceAct": "Lossitava kala kaalumise täiendavad nõuded ja metoodika",
      "estleg:provisionRef": "Reg_1042007 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042007_Map_2026"
      }
    },
