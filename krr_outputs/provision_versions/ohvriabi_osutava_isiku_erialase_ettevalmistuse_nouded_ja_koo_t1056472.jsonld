      "estleg:provisionRef": "Reg_1056472 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056472_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056472_Par_5_v1056472",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056472_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ohvriabi vahetult osutav isik, kes oli ohvriabiteenuse osutaja 31. märtsi 2023. a seisuga, peab vastama § 2 lõigetes 1, 2 ja 4–8 sätestatud nõuetele hiljemalt 1. aprilliks 2024. a. Ohvriabi vahetult osutav isik, kes oli ohvriabiteenuse osutaja 31. märtsi 2023. a seisuga, peab vastama § 2 lõigetes 1, 2 ja 4–8 sätestatud nõuetele hiljemalt 1. aprilliks 2024. a. 2 (2) Naiste tugikeskuse teenust vahetult osutav isik, kes osutas teenust 31. märtsi 2023. a seisuga, ei pea § 2 lõikes 5 nimetatud koolitusi või õppeainet läbima. Naiste tugikeskuse teenust vahetult osutav isik, kes osutas teenust 31. märtsi 2023. a seisuga, ei pea § 2 lõikes 5 nimetatud koolitusi või õppeainet läbima.",
      "rdfs:label": {
