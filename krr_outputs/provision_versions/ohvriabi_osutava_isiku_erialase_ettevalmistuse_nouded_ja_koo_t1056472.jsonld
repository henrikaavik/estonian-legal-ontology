      }
    },
    {
      "@id": "estleg:Reg_1056472_Par_3_v1056472",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056472_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohvriabi osutava isiku põhi- ja täienduskoolitusi korraldab Sotsiaalministeerium või tema valitsemisalas olev asutus, lähtudes täiskasvanute koolituse seadusest. Ohvriabi osutava isiku põhi- ja täienduskoolitusi korraldab Sotsiaalministeerium või tema valitsemisalas olev asutus, lähtudes täiskasvanute koolituse seadusest.",
      "rdfs:label": {
        "@value": "Reg_1056472_Par_3 (redaktsioon 1056472)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056472",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056472",
      "estleg:sourceAct": "Ohvriabi osutava isiku erialase ettevalmistuse nõuded ja koolitused",
      "estleg:provisionRef": "Reg_1056472 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056472_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056472_Par_4_v1056472",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056472_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ohvriabi põhikoolitus peab tagama ohvriabi vahetult osutavale isikule vajaliku ettevalmistuse ning toetama talle seaduses või muus õigusaktis pandud ülesannete täitmist, et pakkuda ohvritele vajaduspõhist abi ja tuge. Ohvriabi põhikoolitus peab tagama ohvriabi vahetult osutavale isikule vajaliku ettevalmistuse ning toetama talle seaduses või muus õigusaktis pandud ülesannete täitmist, et pakkuda ohvritele vajaduspõhist abi ja tuge. 2 (2) Naistevastast vägivalda käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks vägivalla ohvriga ning andma ülevaate naistevastase vägivalla ja soolise võrdõiguslikkuse mõistetest, naistevastasest vägivallast kui inimõiguste rikkumisest ja selle seostest soolise ebavõrdsusega ning ohvri ja vägivallatseja käitumise motiividest ja vägivalla mõjust naisele ja lapsele. Naistevastast vägivalda käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks vägivalla ohvriga ning andma ülevaate naistevastase vägivalla ja soolise võrdõiguslikkuse mõistetest, naistevastasest vägivallast kui inimõiguste rikkumisest ja selle seostest soolise ebavõrdsusega ning ohvri ja vägivallatseja käitumise motiividest ja vägivalla mõjust naisele ja lapsele. 3 (3) Inimkaubandust käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks inimkaubanduse ohvriga ning andma ülevaate inimkaubanduse iseloomust, praktilistest juhtumitest, kannatanu abistamise võimalustest ning inimkaubanduse kuriteo ülesehitusest ja toimimise loogikast. Inimkaubandust käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks inimkaubanduse ohvriga ning andma ülevaate inimkaubanduse iseloomust, praktilistest juhtumitest, kannatanu abistamise võimalustest ning inimkaubanduse kuriteo ülesehitusest ja toimimise loogikast. 4 (4) Psühholoogilist esmaabi käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks ohvriga ning andma ülevaate kriisist ja psühholoogilisest esmaabist, sealhulgas psühholoogilise esmaabi andmise etappidest ja tegevustest ning enesehoiu viisidest ja tehnikatest. Psühholoogilist esmaabi käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks ohvriga ning andma ülevaate kriisist ja psühholoogilisest esmaabist, sealhulgas psühholoogilise esmaabi andmise etappidest ja tegevustest ning enesehoiu viisidest ja tehnikatest. 5 (5) Seksuaalvägivalda käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks seksuaalvägivalla ohvriga ning andma ülevaate seksuaalvägivalla olemusest ja selle vormidest, seksuaalvägivalla mõjust ohvrile ja abi andmise võimalustest ning karistusseadustikus seksuaalvägivalda käsitlevatest kuriteokoosseisudest. Seksuaalvägivalda käsitlev täienduskoolitus peab tagama teenust vahetult osutava isiku ettevalmistuse tööks seksuaalvägivalla ohvriga ning andma ülevaate seksuaalvägivalla olemusest ja selle vormidest, seksuaalvägivalla mõjust ohvrile ja abi andmise võimalustest ning karistusseadustikus seksuaalvägivalda käsitlevatest kuriteokoosseisudest.",
      "rdfs:label": {
        "@value": "Reg_1056472_Par_4 (redaktsioon 1056472)",
        "@language": "et"
      },
