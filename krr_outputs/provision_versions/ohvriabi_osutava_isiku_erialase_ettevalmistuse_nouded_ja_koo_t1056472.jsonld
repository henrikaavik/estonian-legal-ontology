      "dc:source": "Ohvriabi osutava isiku erialase ettevalmistuse nõuded ja koolitused"
    },
    {
      "@id": "estleg:Reg_1056472_Par_1_v1056472",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056472_Par_1"
