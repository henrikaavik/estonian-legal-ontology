        "@id": "estleg:TULUMA_Par_21_v122122021041"
      },
      "estleg:versionValidTo": {
        "@value": "2021-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_21_v122122021041",
