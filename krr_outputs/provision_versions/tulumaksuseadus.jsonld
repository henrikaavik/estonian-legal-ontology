      },
      "estleg:versionText": "Residendist füüsilise isiku maksustamisperioodi tulust arvatakse maha kogumispensionide seaduse alusel tasutud kohustusliku kogumispensioni maksed.",
      "rdfs:label": {
        "@value": "TULUMA_Par_28_1 (redaktsioon 22456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22456",
