        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_50_v920745",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_50"
