      },
      "estleg:versionValidTo": {
        "@value": "2004-05-26",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_19_v765523",
      "@type": [
        "owl:NamedIndividual",
