      }
    },
    {
      "@id": "estleg:TULUMA_Par_28_2_v833697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_28_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-des 25–27 sätestatud mahaarvamisi võib maksustamisperioodil teha kokku kuni 50 000 krooni maksumaksja kohta, kuid mitte rohkem kui 50% ulatuses maksumaksja sama maksustamisperioodi tulust, millest on tehtud ettevõtlusega seotud mahaarvamised.",
      "rdfs:label": {
        "@value": "TULUMA_Par_28_2 (redaktsioon 833697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "833697",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULUMA_Par_28_2_v119112010007"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_28_2_v119112010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_28_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Paragrahvides 25–27 sätestatud mahaarvamisi võib maksustamisperioodil teha kokku kuni 3196 eurot maksumaksja kohta, kuid mitte rohkem kui 50% ulatuses maksumaksja sama maksustamisperioodi Eestis maksustatavast tulust, millest on tehtud ettevõtlusega seotud mahaarvamised, arvestades lõikeid 2 ja 3. (2) Kui residendist füüsiline isik sai maksustamisperioodil vähemalt 75% oma maksustatavast tulust välisriigis ning osa välismaal saadud tulust on Eestis tulumaksust vabastatud, võib ta teha käesolevas peatükis sätestatud mahaarvamisi oma Eestis maksustatavast tulust proportsionaalselt selle osakaaluga tema maksustamisperioodi maksustatavas tulus. Eelmises lauses nimetatud piirangut ei kohaldata § 281 lõikes 2 sätestatud mahaarvamisele. Maksustatava tuluna käsitatakse isiku sellist tulu enne mahaarvamiste tegemist, mis on maksustatav Eestis või riigis, kus tulu saadi. (3) Lõikes 2 nimetatud isik võib valida oma maksustamisperioodi kogutulu suhtes § 45 rakendamise. Sel juhul lõikes 2 sätestatud piirangut ei kohaldata.",
      "rdfs:label": {
        "@value": "TULUMA_Par_28_2 (redaktsioon 119112010007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119112010007",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULUMA_Par_28_2_v128122011063"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_28_2_v128122011063",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
