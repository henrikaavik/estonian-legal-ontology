    {
      "@id": "estleg:TULUMA_Par_61_v13246182",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_61"
      },
