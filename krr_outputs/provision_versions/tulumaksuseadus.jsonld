        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Residendist füüsilise isiku maksustamisperioodi tulust arvatakse maha maksuvaba tulu: 2040 eurot 2016. aastal; 2160 eurot 2017. aastal; 2280 eurot 2018. aastal; 2460 eurot alates 2019. aastast.",
      "rdfs:label": {
        "@value": "TULUMA_Par_23 (redaktsioon 117122015023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117122015023",
