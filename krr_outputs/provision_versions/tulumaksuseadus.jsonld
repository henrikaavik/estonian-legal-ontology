        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_39_v119112010007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_39"
