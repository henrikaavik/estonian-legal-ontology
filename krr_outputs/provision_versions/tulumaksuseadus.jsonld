        "@id": "estleg:TULUMA_Par_13_v920745"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_13_v920745",
