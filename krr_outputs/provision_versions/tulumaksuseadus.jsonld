      "estleg:versionText": "[Paragrahvi 19 pealkirja sõnastus alates 01.01.2006]",
      "rdfs:label": {
        "@value": "TULUMA_Par_19 (redaktsioon 920745)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "920745",
      "estleg:supersededByVersion": {
