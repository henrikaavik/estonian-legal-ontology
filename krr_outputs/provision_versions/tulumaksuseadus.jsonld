        "@language": "et"
      },
      "estleg:versionRedactionId": "13340627",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULUMA_Par_52_v131122016004"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
