    {
      "@id": "estleg:TULUMA_Par_3_v128122018051",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_3"
      },
      "estleg:versionValidFrom": {
