        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_23_5_v120122024005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_23_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Alates maksustamisperioodist, kui lepinguriigi residendist füüsiline isik jõuab vanaduspensioniikka, arvatakse tema maksustamisperioodi maksustatavast tulust maha maksuvaba tulu 9312 eurot. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "TULUMA_Par_23_5 (redaktsioon 120122024005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "120122024005"
    },
    {
      "@id": "estleg:TULUMA_Par_24_v22456",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
