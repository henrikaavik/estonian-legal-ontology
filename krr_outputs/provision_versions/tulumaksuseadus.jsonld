        "@id": "estleg:TULUMA_Par_15_v120122024005"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_15_v120122024005",
