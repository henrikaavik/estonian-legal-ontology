      "rdfs:label": {
        "@value": "TULUMA_Par_52 (redaktsioon 750811)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "750811",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULUMA_Par_52_v765523"
