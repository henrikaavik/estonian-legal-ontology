      },
      "estleg:versionValidTo": {
        "@value": "2020-07-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULUMA_Par_41_v110072020067",
      "@type": [
        "owl:NamedIndividual",
