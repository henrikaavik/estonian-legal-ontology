      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Residendist füüsilisel isikul on õigus maksustamisperioodi tulust maha arvata tema poolt maksustamisperioodil residendist füüsilisele isikule makstud elatis, kui see elatis kuulub maksustamisele § 19 lõike 1 kohaselt.",
      "rdfs:label": {
        "@value": "TULUMA_Par_24 (redaktsioon 22456)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22456",
      "estleg:supersededByVersion": {
