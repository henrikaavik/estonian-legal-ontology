    {
      "@id": "estleg:TULUMA_Par_27_v750811",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULUMA_Par_27"
      },
      "estleg:versionValidFrom": {
