      "estleg:provisionRef": "Reg_1060710 § 23",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060710_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060710_Par_3_v1060710",
      "@type": [
        "owl:NamedIndividual",
