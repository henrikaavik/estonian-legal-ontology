    },
    {
      "@id": "estleg:Reg_1060710_Par_17_v1060710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060710_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetus makstakse toetuse saajale välja vastavalt toetuse rahuldamise või osalise rahuldamise otsuses sätestatud tingimustele. Toetus makstakse toetuse saajale välja vastavalt toetuse rahuldamise või osalise rahuldamise otsuses sätestatud tingimustele. 2 (2) Toetus makstakse toetuse saajale välja 14 kalendripäeva jooksul pärast taotluse rahuldamise või osalise rahuldamise otsuse tegemist. Toetus makstakse toetuse saajale välja 14 kalendripäeva jooksul pärast taotluse rahuldamise või osalise rahuldamise otsuse tegemist. 3 (3) Kui taotluse rahuldamise otsus tehakse kõrvaltingimusega, makstakse toetus välja 14 kalendripäeva jooksul pärast kõrvaltingimuse saabumist või täitmist. Kui taotluse rahuldamise otsus tehakse kõrvaltingimusega, makstakse toetus välja 14 kalendripäeva jooksul pärast kõrvaltingimuse saabumist või täitmist.",
      "rdfs:label": {
        "@value": "Reg_1060710_Par_17 (redaktsioon 1060710)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060710",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060710",
      "estleg:sourceAct": "Vabatahtlikkuse alusel Päästeameti tegevuses osalejale toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1060710 § 17",
