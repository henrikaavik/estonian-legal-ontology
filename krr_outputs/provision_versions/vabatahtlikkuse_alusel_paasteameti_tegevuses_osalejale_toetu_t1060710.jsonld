      }
    },
    {
      "@id": "estleg:Reg_1060710_Par_12_v1060710",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060710_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse andja kinnitab taotluste esitamise ajakava ja eelarve. Toetuse andja kinnitab taotluste esitamise ajakava ja eelarve. 2 (2) Toetuse andja kuulutab taotlusvooru välja oma veebisaidil. Toetuse andja kuulutab taotlusvooru välja oma veebisaidil. 3 (3) Taotleja esindusõiguslik isik esitab taotluse ja selle lisadokumendid digiallkirjastatult toetuse andja e-posti aadressil info@paasteamet.ee. Taotleja esindusõiguslik isik esitab taotluse ja selle lisadokumendid digiallkirjastatult toetuse andja e-posti aadressil info@paasteamet.ee.",
      "rdfs:label": {
