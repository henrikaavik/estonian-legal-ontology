        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vormiriietuse esemete ja eririietuse esemete väljaandmise ja tagastamise ajalist ja koguselist arvestust peetakse iga teenistuja kohta, kellele vormiriietuse ese on välja antud. Vormiriietuse esemete ja eririietuse esemete väljaandmise ja tagastamise ajalist ja koguselist arvestust peetakse iga teenistuja kohta, kellele vormiriietuse ese on välja antud.",
      "rdfs:label": {
        "@value": "Reg_1057566_Par_14 (redaktsioon 1057566)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057566",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057566",
      "estleg:sourceAct": "Riigi keskkonnakaitseinspektori vormiriietuse ja ametitunnuste kirjeldus ning vormi- ja eririietuse väljaandmise ja kandmise kord",
      "estleg:provisionRef": "Reg_1057566 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057566_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057566_Par_15_v1057566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
