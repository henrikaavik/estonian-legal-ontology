        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev määrus jõustub 2023. aasta 1. novembril. Käesolev määrus jõustub 2023. aasta 1. novembril.",
      "rdfs:label": {
        "@value": "Reg_1057566_Par_23 (redaktsioon 1057566)",
        "@language": "et"
      },
