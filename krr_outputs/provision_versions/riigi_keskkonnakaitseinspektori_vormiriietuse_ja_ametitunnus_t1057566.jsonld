    {
      "@id": "estleg:Reg_1057566_Par_3_v1057566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1057566_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitunnusena kantakse vormiriietuse vasakul varrukal rohelisel 53 mm pikkusel ja 65 mm laiusel alusel riigitunnust, millel on riigilipu kujutis ja valgete trükitähtedega sõna ESTONIA, ja riigitunnusest 10 mm allpool varrukaembleemi, millel on 85 mm läbimõõduga keskkonnajärelevalve tunnus. Ametitunnusena kantakse vormiriietuse vasakul varrukal rohelisel 53 mm pikkusel ja 65 mm laiusel alusel riigitunnust, millel on riigilipu kujutis ja valgete trükitähtedega sõna ESTONIA, ja riigitunnusest 10 mm allpool varrukaembleemi, millel on 85 mm läbimõõduga keskkonnajärelevalve tunnus. 2 (2) Inspektori vormiriietuse esemetel kasutatava Keskkonnaameti keskkonnajärelevalve tunnuse kujundus on esitatud käesoleva määruse lisas. Inspektori vormiriietuse esemetel kasutatava Keskkonnaameti keskkonnajärelevalve tunnuse kujundus on esitatud käesoleva määruse lisas. 3 (3) Vormiriietusel puuduvad ametiastmetunnused. Vormiriietusel puuduvad ametiastmetunnused. 4 (4) Inspektori vormiriietusel on sõna KESKKONNAAMET ja nimesilt käesoleva peatüki 2. jaos sätestatu kohaselt. Inspektori vormiriietusel on sõna KESKKONNAAMET ja nimesilt käesoleva peatüki 2. jaos sätestatu kohaselt.",
      "rdfs:label": {
        "@value": "Reg_1057566_Par_3 (redaktsioon 1057566)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1057566",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057566",
      "estleg:sourceAct": "Riigi keskkonnakaitseinspektori vormiriietuse ja ametitunnuste kirjeldus ning vormi- ja eririietuse väljaandmise ja kandmise kord",
      "estleg:provisionRef": "Reg_1057566 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057566_Map"
      }
    },
    {
      "@id": "estleg:Reg_1057566_Par_4_v1057566",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
