        "@language": "et"
      },
      "estleg:versionRedactionId": "1057566",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1057566",
      "estleg:sourceAct": "Riigi keskkonnakaitseinspektori vormiriietuse ja ametitunnuste kirjeldus ning vormi- ja eririietuse väljaandmise ja kandmise kord",
      "estleg:provisionRef": "Reg_1057566 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057566_Map"
      }
