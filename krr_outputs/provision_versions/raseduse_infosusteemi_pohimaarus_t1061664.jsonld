      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Infosüsteem koosneb kahest elektroonsest andmekogust ja arhiveeritud andmetest. Infosüsteem koosneb kahest elektroonsest andmekogust ja arhiveeritud andmetest.",
      "rdfs:label": {
        "@value": "Reg_1061664_Par_4 (redaktsioon 1061664)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061664",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061664",
