      }
    },
    {
      "@id": "estleg:Reg_1038603_Par_12_v1038603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038603_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) inimeste viibimine Kojastu sihtkaitsevööndis 15. veebruarist kuni 31. juulini ja Mangu sihtkaitsevööndis 1. veebruarist kuni 31. juulini. Liikumispiirang ei kehti järelevalve- ja päästetöödel, kaitseala valitsemisega või kaitse korraldamisega seotud töödel ning kaitseala valitseja nõusolekul teostatavatel teadustöödel. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; inimeste viibimine Kojastu sihtkaitsevööndis 15. veebruarist kuni 31. juulini ja Mangu sihtkaitsevööndis 1. veebruarist kuni 31. juulini. Liikumispiirang ei kehti järelevalve- ja päästetöödel, kaitseala valitsemisega või kaitse korraldamisega seotud töödel ning kaitseala valitseja nõusolekul teostatavatel teadustöödel.",
      "rdfs:label": {
        "@value": "Reg_1038603_Par_12 (redaktsioon 1038603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038603",
