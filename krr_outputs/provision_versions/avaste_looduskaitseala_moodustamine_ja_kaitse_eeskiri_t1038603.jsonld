      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1038603_Par_3 (redaktsioon 1038603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038603",
