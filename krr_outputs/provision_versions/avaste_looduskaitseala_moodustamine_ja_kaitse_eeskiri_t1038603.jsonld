      }
    },
    {
      "@id": "estleg:Reg_1038603_Par_14_v1038603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038603_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on poollooduslike koosluste säilitamine ja taastamine ning häirimise vältimine kaitsealuste linnuliikide pesitsuspaiga soodsa seisundi säilimiseks. Piiranguvööndi kaitse-eesmärk on poollooduslike koosluste säilitamine ja taastamine ning häirimise vältimine kaitsealuste linnuliikide pesitsuspaiga soodsa seisundi säilimiseks.",
      "rdfs:label": {
        "@value": "Reg_1038603_Par_14 (redaktsioon 1038603)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038603",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038603",
      "estleg:sourceAct": "Avaste looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038603 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038603_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1038603_Par_15_v1038603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038603_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) kuni 75 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas. Piiranguvööndis on lubatud: majandustegevus; kuni 75 osalejaga rahvaürituse korraldamine selleks ettevalmistamata kohas. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) kaitseala või kaitsealal paikneva kinnistu tarbeks tootmisotstarbeta ehitise püstitamine; 2 2) rohkem kui 75 osalejaga rahvaürituse korraldamine ettevalmistamata ja tähistamata kohas. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: kaitseala või kaitsealal paikneva kinnistu tarbeks tootmisotstarbeta ehitise püstitamine; rohkem kui 75 osalejaga rahvaürituse korraldamine ettevalmistamata ja tähistamata kohas. 3 (3) Piiranguvööndis on lubatud uuendusraie. Parasmaa piiranguvööndis on raie lubatud 1. augustist kuni 31. jaanuarini. Piiranguvööndis on lubatud uuendusraie. Parasmaa piiranguvööndis on raie lubatud 1. augustist kuni 31. jaanuarini.",
