      }
    },
    {
      "@id": "estleg:Reg_1038603_Par_13_v1038603",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038603_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-05-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on kaks piiranguvööndit: 1 1) Parasmaa piiranguvöönd; 2 2) Sõõrike piiranguvöönd. Kaitsealal on kaks piiranguvööndit: Parasmaa piiranguvöönd; Sõõrike piiranguvöönd.",
      "rdfs:label": {
