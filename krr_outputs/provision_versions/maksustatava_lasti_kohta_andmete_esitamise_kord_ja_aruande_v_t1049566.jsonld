      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Maksustatava lasti kohta andmete esitamise kord ja aruande vorm (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Maksustatava lasti kohta andmete esitamise kord ja aruande vorm"
    },
    {
      "@id": "estleg:Reg_1049566_Par_1_v1049566",
      "@type": [
