      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse andmete esitamise kord eelmisel kalendriaastal vastuvõetud maksustatava lasti, sealhulgas nafta kohta ning aruande vormid ja maksustavatava nafta liikide näidisloetelu. Määrusega kehtestatakse andmete esitamise kord eelmisel kalendriaastal vastuvõetud maksustatava lasti, sealhulgas nafta kohta ning aruande vormid ja maksustavatava nafta liikide näidisloetelu.",
      "rdfs:label": {
        "@value": "Reg_1049566_Par_1 (redaktsioon 1049566)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1049566",
