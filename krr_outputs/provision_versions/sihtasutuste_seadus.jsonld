      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "SAS_Par_60 (redaktsioon 179066)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "179066",
      "estleg:supersededByVersion": {
        "@id": "estleg:SAS_Par_60_v12769868"
      },
      "estleg:versionValidTo": {
