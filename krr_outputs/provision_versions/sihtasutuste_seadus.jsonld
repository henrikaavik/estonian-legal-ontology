    {
      "@id": "estleg:SAS_Par_3_v117122010028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_3"
      },
      "estleg:versionValidFrom": {
