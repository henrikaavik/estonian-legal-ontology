    {
      "@id": "estleg:SAS_Par_87_v22345",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Justiitsminister võib anda määrusi registriosakondade tegevuse korraldamiseks.",
      "rdfs:label": {
        "@value": "SAS_Par_87 (redaktsioon 22345)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22345",
      "estleg:supersededByVersion": {
        "@id": "estleg:SAS_Par_87_v121032014031"
      },
      "estleg:versionValidTo": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SAS_Par_87_v121032014031",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Valdkonna eest vastutav minister võib anda määrusi registriosakondade tegevuse korraldamiseks. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"Justiitsminister\" sõnadega \"Valdkonna eest vastutav minister\".",
      "rdfs:label": {
        "@value": "SAS_Par_87 (redaktsioon 121032014031)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032014031",
      "estleg:supersededByVersion": {
        "@id": "estleg:SAS_Par_87_v121062014049"
      },
      "estleg:versionValidTo": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SAS_Par_87_v121062014049",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "SAS_Par_87 (redaktsioon 121062014049)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121062014049"
    },
    {
      "@id": "estleg:SAS_Par_88_v22345",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_88"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1996. aasta 1. oktoobril.",
      "rdfs:label": {
        "@value": "SAS_Par_88 (redaktsioon 22345)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22345"
    },
    {
      "@id": "estleg:SAS_Par_9_v22345",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Soodustatud isikuks on isik, kellele vastavalt sihtasutuse põhikirjale võib sihtasutuse varast teha väljamakseid. Kui põhikirjas ei ole soodustatud isikute ringi määratud, loetakse soodustatuks kõik isikud, kellel on õigus saada väljamakseid, lähtudes sihtasutuse eesmärgist.",
      "rdfs:label": {
        "@value": "SAS_Par_9 (redaktsioon 22345)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22345"
    }
  ]
