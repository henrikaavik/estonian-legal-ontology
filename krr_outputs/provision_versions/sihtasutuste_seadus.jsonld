        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SAS_Par_60_v12769868",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SAS_Par_60"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu –",
      "rdfs:label": {
        "@value": "SAS_Par_60 (redaktsioon 12769868)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12769868",
      "estleg:supersededByVersion": {
