      },
      "estleg:versionValidTo": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/700415",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 55",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_55_v700431",
      "@type": [
        "owl:NamedIndividual",
