    {
      "@id": "estleg:ulikooliseadus_Par_24_v13000391",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikoolis omandatakse kõrgharidus kolmel astmel: bakalaureuse-, magistri- ja doktoriõppes. Ülikooli struktuuri kuuluvas õppeasutuses võib omandada kõrghariduse rakenduskõrgharidusõppes. (2) Bakalaureuse- ja magistriõppe integreeritud õppekavadel põhinevas õppes omandatav kõrgharidus on kaheastmeline.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_24 (redaktsioon 13000391)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13000391",
      "estleg:supersededByVersion": {
        "@id": "estleg:ulikooliseadus_Par_24_v112122011007"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13000391",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 24",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_24_v112122011007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikoolis omandatakse kõrgharidus kolmel astmel: rakenduskõrgharidus- ja bakalaureuseõppes, magistriõppes ning doktoriõppes. (2) Bakalaureuse- ja magistriõppe integreeritud õppekavadel põhinevas õppes omandatav kõrgharidus on kaheastmeline.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_24 (redaktsioon 112122011007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122011007",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122011007",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 24",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_25_v22308",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Magistri- ja doktori akadeemilised kraadid jagunevad teadus- ja kutsekraadideks. (2) Teaduskraad antakse teaduslike uuringute alusel kirjutatud lõputöö kaitsnud ülikooli lõpetajale. (3) Kutsekraad antakse ülikooli lõpetajale, kes lõputöö kaitsmisega või muul moel on tõestanud vastaval tasemel kutsealase loomingulise professionaalsuse saavutamist.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_25 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
