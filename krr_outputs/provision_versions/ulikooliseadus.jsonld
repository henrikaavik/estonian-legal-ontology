    },
    {
      "@id": "estleg:ulikooliseadus_Par_34_v22308",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikooli õppejõud on professorid, dotsendid, lektorid, assistendid ja õpetajad. (2) Ülikooli teadustöötajad on vanemteadurid ja teadurid. (3) Korraline õppejõud ja teadustöötaja valitakse konkursi korras ametisse kuni viieks aastaks. Erakorraline õppejõud ja teadustöötaja võetakse tööle tähtajaliselt kuni kolmeks aastaks. (4) Ülikooli nõukogu kehtestatud tingimustel on rektoril õigus kutsuda korraliste õppejõudude kohtadele teadlasi väljastpoolt ülikooli.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_34 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
