      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/700338",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_41_v700440",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üliõpilane on isik, kes on vastu võetud (immatrikuleeritud) ülikooli rakenduskõrgharidus-, bakalaureuse-, magistri-, doktoriõppe või bakalaureuse- ja magistriõppe integreeritud õppekavadel põhineva õppe täiskoormusega või osakoormusega õppesse.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_41 (redaktsioon 700440)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "700440",
      "estleg:supersededByVersion": {
        "@id": "estleg:ulikooliseadus_Par_41_v13000391"
      },
      "estleg:versionValidTo": {
        "@value": "2008-08-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/700440",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_41_v13000391",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üliõpilane on isik, kes on vastu võetud (immatrikuleeritud) ülikooli rakenduskõrgharidus-, bakalaureuse-, magistri-, doktoriõppe või bakalaureuse- ja magistriõppe integreeritud õppekavadel põhineva õppe täiskoormusega või osakoormusega õppesse. (2) Ühisõppekava korral võetakse käesoleva paragrahvi lõikes 1 nimetatud isik vastu (immatrikuleeritakse) igasse ühisõppekava alusel õpet läbiviivasse õppeasutusse, kus ta õpet läbib.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_41 (redaktsioon 13000391)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13000391",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13000391",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 41",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_42_v22308",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üliõpilastel on õigus: mis tahes alal õppides valida oma õppekavasse aineid väljastpoolt õppesuunda ülikooli nõukogu kehtestatud korras; õppekavaväliselt kuulata loenguid ning sooritada praktikume, seminare, eksameid ja arvestusi, kusjuures õppejõud võib tingimuste (töökohad, õppevahendid jne.) puudumisel üliõpilaste osavõttu õppekavavälisest õppest piirata; kasutada tasuta auditooriume, laboratooriume, arvutisaale, raamatukogusid, inventari, seadmeid ja muud vara ülikoolis kehtestatud korras; ülikooli või mõne tema õppekava sulgemise korral jätkata õpinguid teise õppekava alusel või teises ülikoolis; valida oma esindajaid ja olla valitud ülikooli kollegiaalsetesse otsustuskogudesse; esitada rektorile põhjendatud taotlus õppejõu kõrvaldamiseks õppetegevusest; saada õppelaenu Eesti Vabariigi haridusseaduses (RT 1992, 12, 192; RT I 1993, 35, 547; 40, 593; 63, 892; 1994, 12, 200; 1995, 12, 119; 16, 228; 23, 333; 58, 1003; 1996, 49, 953; 51, 965; 1997, 42, 678; 81, 1365; 1998, 57, 859; 61, 980; 64/65, 1007; 1999, 10, 150; 24, 358; 51, 550) sätestatud tingimustel; saada akadeemilist puhkust ülikooli nõukogu kehtestatud korras; saada õppimiseks vajalikke õppekavu, -programme ja muud informatsiooni; nõuda eksami või arvestuse sooritamiseks komisjoni; saada üliõpilaspilet haridusministri kehtestatud korras; üliõpilasomavalitsusele paragrahvis 43 sätestatud tingimustel ja korras; kasutada muid seaduse, ülikooli põhikirja, sisekorraeeskirjade ja muude õigusaktidega üliõpilastele kehtestatud õigusi. (2) Üliõpilased peavad jälgima käesoleva seaduse, ülikooli põhikirja, sisekorraeeskirjade ja muude õigusaktidega üliõpilastele kehtestatud kohustusi ning kandma vastutust nende rikkumise eest.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_42 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
      "estleg:supersededByVersion": {
        "@id": "estleg:ulikooliseadus_Par_42_v700279"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22308",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 42",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_42_v700279",
