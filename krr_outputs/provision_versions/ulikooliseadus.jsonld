        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108112010008",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 53",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_53_v113032014078",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_53"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Haldusjärelevalvet ülikooli tegevuse õiguspärasuse üle teostab Haridus- ja Teadusministeerium (edaspidi riiklik järelevalveorgan). Riiklikul järelevalveorganil on õigus kaasata haldusjärelevalve teostamisele eksperte.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_53 (redaktsioon 113032014078)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014078",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032014078",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 53",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_54_v22308",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_54"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikool annab oma tegevusest aru seaduses või selle alusel sätestatud mahus ja korras. (2) Ülikool esitab oma tegevuse kohta statistilise ja eelarve täitmise aruande seadusega ettenähtud korras ja tähtaegadeks. (3) Sihtfinantseeringute kulutamise kohta esitab ülikool aruande finantseerijale viimase nõudel.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_54 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22308",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 54",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_55_v22308",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kõrghariduse hindamise nõukogu korraldab kõikide ülikoolide õppekavade akrediteerimise seitsme aasta jooksul, arvates käesoleva seaduse jõustumisest. Kuni akrediteerimisotsuse tegemiseni väljastavad avalik-õiguslikud ülikoolid nende õppekavade läbinutele riiklikud haridust tõendavad dokumendid. (2) [Kehtetu]",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_55 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
      "estleg:supersededByVersion": {
        "@id": "estleg:ulikooliseadus_Par_55_v700338"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-04",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22308",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 55",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_55_v700338",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_55"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 2002. aasta 1. juunit Haridusministeeriumi õppekavade registrisse kantud akrediteerimata õppekava alusel avalik-õigusliku ülikooli lõpetanud isikule väljastab ülikool akrediteerimisotsuse kehtima hakkamiseni riikliku haridust tõendava dokumendi. (2) [Kehtetu] (3) Ülikoolil on õigus kuni 2003. aasta 1. jaanuarini taotleda enne 2002. aasta 1. septembrit vastu võetud akrediteerimisotsuste laienemist nende kehtivusaja lõpuni ka ülikooli nõukogus kinnitatud sama õppesuuna õppekavadele, mis on kantud Haridusministeeriumi õppekavade registrisse. Õppekava akrediteerimisotsuse laienemise ülikooli nõukogus kinnitatud sama õppesuuna õppekavadele, mis on kantud Haridusministeeriumi õppekavade registrisse, kinnitab kõrghariduse hindamise nõukogu ettepanekul haridusminister.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_55 (redaktsioon 700338)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "700338",
      "estleg:supersededByVersion": {
        "@id": "estleg:ulikooliseadus_Par_55_v700415"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/700338",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 55",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_55_v700415",
      "@type": [
        "owl:NamedIndividual",
