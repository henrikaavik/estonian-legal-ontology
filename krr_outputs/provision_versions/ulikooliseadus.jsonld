    {
      "@id": "estleg:ulikooliseadus_Par_24_v22308",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ulikooliseadus_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ülikoolis toimub akadeemiline õpe ja võib toimuda diplomiõpe. (2) Akadeemiline õpe on kolmeastmeline: bakalaureuse- , magistri- ja doktoriõpe. (2¹) Paragrahvis 291 nimetatud kutsealadel toimuv akadeemiline õpe on kaheastmeline. (3) Diplomiõpe on üheastmeline. (4) Akadeemilise õppe iga astme ja diplomiõppe lõpetamist loetakse ülikooli lõpetamiseks. Lõpetanul on õigus jätkata õpinguid käesolevas seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_24 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
      "estleg:supersededByVersion": {
        "@id": "estleg:ulikooliseadus_Par_24_v700279"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22308",
      "estleg:sourceAct": "Ülikooliseadus",
      "estleg:provisionRef": "ulikooliseadus § 24",
      "estleg:partOfAct": {
        "@id": "estleg:ÜKS_Map_2026"
      }
    },
    {
      "@id": "estleg:ulikooliseadus_Par_24_v700279",
      "@type": [
