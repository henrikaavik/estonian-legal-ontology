        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Üliõpilane on isik, kes on immatrikuleeritud ülikooli statsionaarsesse või kaugõppe õppevormi diplomi-, bakalaureuse-, magistri- või doktoriõppesse, arstiõppesse, loomaarstiõppesse, proviisoriõppesse, hambaarstiõppesse või arhitekt-inseneri õppesse või diplomi- või bakalaureuseõppele järgnevasse õpetajakoolitusse.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_41 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
