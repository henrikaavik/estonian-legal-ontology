        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikooliseaduse ülesanne on sätestada ülikooli asutamise, ühinemise, jagunemise ja tegevuse lõpetamise kord, tegutsemise alused, autonoomia piirid, juhtimise põhimõtted, kõrghariduse omandamise vormid ja tingimused, ülikooli varade õiguslik seisund, finantseerimise kord, õppejõudude ja üliõpilaste põhiõigused ja -kohustused ning riiklik järelevalve ülikooli tegevuse üle.",
      "rdfs:label": {
        "@value": "ulikooliseadus_Par_1 (redaktsioon 22308)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22308",
