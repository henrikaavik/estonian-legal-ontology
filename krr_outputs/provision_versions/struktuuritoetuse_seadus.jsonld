      },
      "estleg:versionValidTo": {
        "@value": "2005-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_8_v918730",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toetuse kasutamise lõpetamise deklaratsioon vastavalt Euroopa Komisjoni määruse 438/2001/EÜ artiklitele 15–17 ning Euroopa Komisjoni määruse 1386/2002/EÜ artiklitele 13–15 on auditeeriva asutuse poolt Euroopa Komisjonile esitatav toetuse kasutamist kinnitav dokument, mis auditeerimiste ning vajaduse korral tehtud täiendavate audititoimingute tulemustele tuginedes koostatakse toetuse andmise lõppemisel. (2) Toetuse kasutamise lõpetamise deklaratsiooni koostamise ja esitamise korra kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_8 (redaktsioon 918730)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "918730",
      "estleg:supersededByVersion": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_8_v925755"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_8_v925755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toetuse kasutamise lõpetamise deklaratsioon vastavalt Euroopa Komisjoni määruse 438/2001/EÜ artiklitele 15–17 ning Euroopa Komisjoni määruse 1386/2002/EÜ artiklitele 13–15 on auditeeriva asutuse poolt Euroopa Komisjonile esitatav toetuse kasutamist kinnitav dokument, mis auditeerimiste ning vajaduse korral tehtud täiendavate audititoimingute tulemustele tuginedes koostatakse toetuse andmise lõppemisel.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_8 (redaktsioon 925755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "925755"
    },
    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_9_v688575",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Struktuuritoetuse register (edaspidi register) on riiklik register andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61 375; 63, 387; 2003, 18, 107; 26, 158) mõistes. (2) Registrisse kantakse andmed toetuse andmise, seire ja hindamise korraldamiseks ning Euroopa Komisjoniga vajaliku andmevahetuse tagamiseks. (3) Registri asutab ja registri pidamise põhimääruse kinnitab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_9 (redaktsioon 688575)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "688575",
      "estleg:supersededByVersion": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_9_v918730"
      },
      "estleg:versionValidTo": {
        "@value": "2005-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_9_v918730",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Struktuuritoetuse register (edaspidi register) on riiklik register andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61 375; 63, 387; 2003, 18, 107; 26, 158; 2004, 30, 204) mõistes. (2) Registrile tuginedes kogutakse statistilist ja finantsinformatsiooni, peetakse arvestust toetuse andmise ja kasutamise üle Euroopa Komisjonile vajalike andmete esitamiseks ning toetuse andmise ja kasutamise juhtimiseks vastavalt EL Nõukogu määruse 1260/1999/EÜ artikli 34 lõike 1 punktile a ning tehakse toetuse väljamakseid. (3) Enne toetuse taotluse rahuldamise või rahuldamata jätmise otsuse tegemist võidakse registrisse kantud andmetest kolmandatele isikutele avalikustada ainult statistilisi ülevaateid. Toetuse taotlejal ja toetuse saajal on õigus saada kõiki tema enda, tema taotluse ja tema projekti kohta registrisse kantud andmeid. (4) Pärast toetuse taotluse rahuldamise otsuse tegemist on registrisse kantud toetuse taotluse rahuldamise otsuses sisalduva projekti andmed avalikud, välja arvatud andmed projekti äriplaani ja tehnoloogiliste lahenduste kohta ja muud andmed, mida loetakse ärisaladuseks või mis on tunnistatud asutusesiseseks kasutamiseks avaliku teabe seaduses (RT I 2000, 92, 597; 2002, 61, 375; 63, 387; 2003, 25, 153; 26, 158; 2004, 81, 542) sätestatud korras. Andmed projekti omafinantseeringu kohta ei ole avalikud, välja arvatud omafinantseeringu osas, mis on saadud riigieelarvelistest vahenditest; (5) Taotleja, kelle toetuse taotlust ei rahuldatud, ja tema toetuse taotluses sisalduva projekti kohta registrisse kantud andmed avalikustamisele ei kuulu. (6) Registri asutab ja registri pidamise põhimääruse kinnitab Vabariigi Valitsus. (7) Rahandusminister kehtestab: nõuded registri arendamisele ja registri arendamise korra; registri kasutamise tingimused ja korra.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_9 (redaktsioon 918730)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "918730",
      "estleg:supersededByVersion": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_9_v925755"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_9_v925755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Struktuuritoetuse register (edaspidi register) on riiklik register andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61 375; 63, 387; 2003, 18, 107; 26, 158; 2004, 30, 204) mõistes. (2) Registrile tuginedes kogutakse statistilist ja finantsinformatsiooni, peetakse arvestust toetuse andmise ja kasutamise üle Euroopa Komisjonile vajalike andmete esitamiseks ning toetuse andmise ja kasutamise juhtimiseks vastavalt EL Nõukogu määruse 1260/1999/EÜ artikli 34 lõike 1 punktile a ning tehakse toetuse väljamakseid. (3) Enne toetuse taotluse rahuldamise või rahuldamata jätmise otsuse tegemist võidakse registrisse kantud andmetest kolmandatele isikutele avalikustada ainult statistilisi ülevaateid. Toetuse taotlejal ja toetuse saajal on õigus saada kõiki tema enda, tema taotluse ja tema projekti kohta registrisse kantud andmeid. (4) Pärast toetuse taotluse rahuldamise otsuse tegemist on registrisse kantud toetuse taotluse rahuldamise otsuses sisalduva projekti andmed avalikud, välja arvatud andmed projekti äriplaani ja tehnoloogiliste lahenduste kohta ja muud andmed, mida loetakse ärisaladuseks või mis on tunnistatud asutusesiseseks kasutamiseks avaliku teabe seaduses (RT I 2000, 92, 597; 2002, 61, 375; 63, 387; 2003, 25, 153; 26, 158; 2004, 81, 542) sätestatud korras. Andmed projekti omafinantseeringu kohta ei ole avalikud, välja arvatud omafinantseeringu osas, mis on saadud riigieelarvelistest vahenditest; (5) Taotleja, kelle toetuse taotlust ei rahuldatud, ja tema toetuse taotluses sisalduva projekti kohta registrisse kantud andmed avalikustamisele ei kuulu. (7) Rahandusminister kehtestab: nõuded registri arendamisele ja registri arendamise korra;",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_9 (redaktsioon 925755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "925755"
    }
  ]
