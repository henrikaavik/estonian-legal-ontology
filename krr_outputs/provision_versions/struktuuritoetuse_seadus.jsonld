    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_8_v688575",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse lõpetamise deklaratsioon on auditeeriva asutuse poolt Euroopa Komisjonile esitatav toetuse kasutamist kinnitav dokument, mis koostatakse toetuste andmise lõppemisel, tuginedes teostatud auditeerimiste ning vajadusel läbiviidud täiendavate audititoimingute tulemustele.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_8 (redaktsioon 688575)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "688575",
      "estleg:supersededByVersion": {
