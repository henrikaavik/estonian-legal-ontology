    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_7_v688575",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toetuse seire on pidev tegevus, millega tagatakse arengukava, prioriteedi, meetme, programmi või projekti tulemuslik rakendamine. (2) Toetuse kasutamise hindamise käigus analüüsitakse toetuse kasutamist ja antakse soovitusi toetuse kasutamise tulemuslikkuse ja mõjususe saavutamiseks.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_7 (redaktsioon 688575)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "688575",
