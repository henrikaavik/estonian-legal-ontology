        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:struktuuritoetuse_seadus_Par_7_v918730",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:struktuuritoetuse_seadus_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Toetuse kasutamise seire on pidev tegevus, mille abil jälgitakse arengukava, prioriteedi, meetme, projekti või programmi rakendamise tulemuslikkust ja kvaliteeti. (2) Toetuse kasutamise hindamise käigus analüüsitakse vastavalt EL Nõukogu määruse 1260/1999/EÜ artiklitele 40–43 ja EL Nõukogu määruse 1164/1994/EÜ artiklile 13 toetuse kasutamist ning antakse soovitusi toetuse kasutamise tulemuslikkuse ja mõjususe suurendamiseks. (3) Toetuse kasutamise seire ja hindamise üldised tingimused ja korra kehtestab rahandusminister.",
      "rdfs:label": {
        "@value": "struktuuritoetuse_seadus_Par_7 (redaktsioon 918730)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "918730",
