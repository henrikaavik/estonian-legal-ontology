      }
    },
    {
      "@id": "estleg:VRKAS_Par_29_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvuse kultuuriomavalitsusasutuse tegevuse lõpetamisel antakse talle kuulunud varad üle kultuurinõukogu otsusega määratud korras.",
      "rdfs:label": {
        "@value": "VRKAS_Par_29 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 29",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_3_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Keelatud on rahvuskultuuri tavade ja usukommete halvustamine ning nende täitmise takistamine, samuti tegevus, mille eesmärgiks on vähemusrahvuse sunniviisiline ümberrahvustamine.",
      "rdfs:label": {
        "@value": "VRKAS_Par_3 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_3_v113032019194"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_3_v113032019194",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vähemusrahvusse kuuluval isikul on õigus säilitada oma etniline kuuluvus, kultuuritavad, emakeel ja usutunnistus. (2) Keelatud on rahvuskultuuri tavade ja usukommete halvustamine ning nende täitmise takistamine, samuti tegevus, mille eesmärgiks on vähemusrahvuse sunniviisiline ümberrahvustamine.",
      "rdfs:label": {
        "@value": "VRKAS_Par_3 (redaktsioon 113032019194)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019194",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019194",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 3",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_30_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tunnistatakse kehtetuks Eesti Nõukogude Sotsialistliku Vabariigi 1989.aasta 15.detsembri seadus \"Eesti NSV kodanike rahvuslikest õigustest\" (ENSV Teataja 1989, 40, 618).",
      "rdfs:label": {
        "@value": "VRKAS_Par_30 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_30_v180002"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_30_v180002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VRKAS_Par_30 (redaktsioon 180002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "180002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/180002",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 30",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_4_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvusse kuuluval isikul on õigus:1) moodustada ja toetada rahvuslikke kultuuri- ja haridusasutusi ning usukogudusi;2) luua rahvuslikke organisatsioone; 3) täita rahvustraditsioone ja usukultuslikke tavasid, kui see ei kahjusta avalikku korda, tervist ega kõlblust; 4) kasutada oma emakeelt asjaajamises keeleseadusega kehtestatud piires; 5) kirjastada rahvuskeelseid trükiseid; 6) sõlmida koostöökokkuleppeid rahvuslike kultuuri- ja haridusasutuste ning usukoguduste vahel; 7) levitada ja vahetada teavet oma emakeeles.",
      "rdfs:label": {
        "@value": "VRKAS_Par_4 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_4_v180002"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_4_v180002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvusse kuuluval isikul on õigus:1) moodustada ja toetada rahvuslikke kultuuri- ja haridusasutusi ning usukogudusi; 2) luua rahvuslikke organisatsioone; 3) täita rahvustraditsioone ja usukultuslikke tavasid, kui see ei kahjusta avalikku korda, tervist ega kõlblust; 4) kasutada oma emakeelt asjaajamises keeleseadusega kehtestatud piires; 5) kirjastada rahvuskeelseid trükiseid; 6) sõlmida koostöökokkuleppeid rahvuslike kultuuri- ja haridusasutuste ning usukoguduste vahel;7) levitada ja vahetada teavet oma emakeeles.",
      "rdfs:label": {
        "@value": "VRKAS_Par_4 (redaktsioon 180002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "180002",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_4_v182796"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/180002",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
