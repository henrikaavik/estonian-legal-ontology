    },
    {
      "@id": "estleg:VRKAS_Par_1_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvusena käesoleva seaduse mõttes käsitletakse Eesti kodanikke, kes - elavad Eesti territooriumil;- omavad kauaaegseid, kindlaid ja kestvaid sidemeid Eestiga;- erinevad eestlastest oma etnilise kuuluvuse, kultuurilise omapära, religiooni või keele poolest;- on ajendatud soovist üheskoos alal hoida oma kultuuritavasid, religiooni või keelt, mis on aluseks nende ühisele identiteedile.",
      "rdfs:label": {
        "@value": "VRKAS_Par_1 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_1_v180002"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
