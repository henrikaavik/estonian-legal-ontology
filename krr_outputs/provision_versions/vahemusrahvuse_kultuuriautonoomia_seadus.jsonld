    {
      "@id": "estleg:VRKAS_Par_1_v182796",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvusena käesoleva seaduse mõttes käsitletakse Eesti kodanikke, kes– elavad Eesti territooriumil;– omavad kauaaegseid, kindlaid ja kestvaid sidemeid Eestiga;– erinevad eestlastest oma etnilise kuuluvuse, kultuurilise omapära, religiooni või keele poolest;– on ajendatud soovist üheskoos alal hoida oma kultuuritavasid, religiooni või keelt, mis on aluseks nende ühisele identiteedile.",
      "rdfs:label": {
        "@value": "VRKAS_Par_1 (redaktsioon 182796)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182796",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/182796",
