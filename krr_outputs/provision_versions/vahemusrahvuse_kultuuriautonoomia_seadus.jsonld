    {
      "@id": "estleg:VRKAS_Par_26_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kultuuriomavalitsusasutused on iseseisvad juriidilised isikud, võivad omada kinnisvara ja vastutavad oma varaliste kohustuste eest.",
      "rdfs:label": {
        "@value": "VRKAS_Par_26 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_26_v180002"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_26_v180002",
      "@type": [
        "owl:NamedIndividual",
