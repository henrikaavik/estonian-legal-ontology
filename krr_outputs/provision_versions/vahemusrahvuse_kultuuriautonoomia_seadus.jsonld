    {
      "@id": "estleg:VRKAS_Par_28_v113032019194",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvuse kultuuriomavalitsusasutuste tegevuse lõpetab Vabariigi Valitsus: kui vähemusrahvuse rahvusnimekirja andmetel on Eestis alaliselt elavate vähemusrahvusse kuuluvate isikute arv viimase viie aasta jooksul alla 3000; kui kahel järgneval kultuurinõukogu valimistel ei suudeta koostada nõuetekohast valijate nimekirja; kui kahel järgneval kultuurinõukogu valimistel osaleb vähem kui pool valijate nimekirjadesse kantud isikutest; kultuurinõukogu ettepanekul.",
      "rdfs:label": {
        "@value": "VRKAS_Par_28 (redaktsioon 113032019194)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019194",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019194",
