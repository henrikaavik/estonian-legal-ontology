      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusnimekirjast kustutatakse: isiku soovil; isiku loobumisel Eesti kodakondsusest või asumisel alaliselt elama välisriiki; isiku surma korral.",
      "rdfs:label": {
        "@value": "VRKAS_Par_9 (redaktsioon 113032019194)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019194",
