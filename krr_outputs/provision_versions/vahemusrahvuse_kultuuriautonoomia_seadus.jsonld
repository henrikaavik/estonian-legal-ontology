      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VRKAS_Par_26 (redaktsioon 180002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "180002",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/180002",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 26",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_27_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(2) Vähemusrahvuse kultuuriomavalitsus võib talle sihtotstarbeliselt eraldatud varasid kasutada ainult selleks ettenähtud korras ja otstarbel. Kontrolli varade kasutamise üle teostatakse kooskõlas kehtivate õigusaktidega selleks volitatud riiklike kontrolliorganite poolt.",
      "rdfs:label": {
        "@value": "VRKAS_Par_27 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_27_v113032019194"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_27_v113032019194",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vähemusrahvuse kultuuriomavalitsuse ja tema asutuste rahalised vahendid moodustuvad: eraldistest riigieelarvest vastavalt seadusele ja sihtotstarbelistest toetustest; kohaliku omavalitsuse eelarvest kultuuriomavalitsuse õppe-, kultuuri- ja hoolekandeasutustele eraldatud sihtotstarbelistest toetustest; kultuuriomavalitsuse osamaksust, mille suuruse määrab kultuurinõukogu; toetustest, annetustest ja pärandustest; välisorganisatsioonide toetustest. (2) Vähemusrahvuse kultuuriomavalitsus võib talle sihtotstarbeliselt eraldatud varasid kasutada ainult selleks ettenähtud korras ja otstarbel. Kontrolli varade kasutamise üle teostatakse kooskõlas kehtivate õigusaktidega selleks volitatud riiklike kontrolliorganite poolt.",
      "rdfs:label": {
        "@value": "VRKAS_Par_27 (redaktsioon 113032019194)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019194",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019194",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 27",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
    {
      "@id": "estleg:VRKAS_Par_28_v24535",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VRKAS_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemusrahvuse kultuuriomavalitsusasutuste tegevuse lõpetab Vabariigi Valitsus:1) kui vähemusrahvuse rahvusnimekirja andmetel on Eestis alaliselt elavate vähemusrahvusse kuuluvate isikute arv viimase viie aasta jooksul alla 3000; 2) kui kahel järgneval kultuurinõukogu valimistel ei suudeta koostada nõuetekohast valijate nimekirja; 3) kui kahel järgneval kultuurinõukogu valimistel osaleb vähem kui pool valijate nimekirjadesse kantud isikutest;4) kultuurinõukogu ettepanekul.",
      "rdfs:label": {
        "@value": "VRKAS_Par_28 (redaktsioon 24535)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24535",
      "estleg:supersededByVersion": {
        "@id": "estleg:VRKAS_Par_28_v180002"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24535",
      "estleg:sourceAct": "Vähemusrahvuse kultuuriautonoomia seadus",
      "estleg:provisionRef": "VRKAS § 28",
      "estleg:partOfAct": {
        "@id": "estleg:VRKAS_Map"
      }
    },
