      "estleg:provisionRef": "Reg_1030642 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1030642_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1030642_Par_9_v1030642",
      "@type": [
