      "estleg:versionValidFrom": {
        "@value": "2013-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse välisriikide kaitseministrite, välisriikide relvajõudude juhtkonna, Põhja-Atlandi Lepingu Organisatsiooni tsiviil- ja sõjaliste peakorterite juhtkonna, kaitseministri ja Kaitseväe juhataja ning Kaitseväe korralduse seaduse § 21 lõike 11 alusel kaitseministri määratud isikute kaitse korraldamise alused ja teostamise viisid. Määrusega kehtestatakse välisriikide kaitseministrite, välisriikide relvajõudude juhtkonna, Põhja-Atlandi Lepingu Organisatsiooni tsiviil- ja sõjaliste peakorterite juhtkonna, kaitseministri ja Kaitseväe juhataja ning Kaitseväe korralduse seaduse § 21 lõike 11 alusel kaitseministri määratud isikute kaitse korraldamise alused ja teostamise viisid.",
      "rdfs:label": {
        "@value": "Reg_1008897_Par_1 (redaktsioon 1008897)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1008897",
