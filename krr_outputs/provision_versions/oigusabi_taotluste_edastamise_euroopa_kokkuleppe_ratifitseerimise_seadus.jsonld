      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerida juurdelisatud , mis on sõlmitud 1977. aasta 27. jaanuaril Strasbourg'is ja millele Eesti Vabariik on alla kirjutanud 1998. aasta 25. veebruaril.",
      "rdfs:label": {
        "@value": "OTEEKR_Par_1 (redaktsioon 79006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "79006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/79006",
      "estleg:sourceAct": "Õigusabi taotluste edastamise Euroopa kokkuleppe ratifitseerimise seadus",
      "estleg:provisionRef": "OTEEKR § 1",
      "estleg:partOfAct": {
        "@id": "estleg:OTEEKR_Map"
      }
    },
    {
      "@id": "estleg:OTEEKR_Par_2_v79006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OTEEKR_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimisel teha selle kokkuleppe artikli 6 lõike 1 punktile b sama kokkuleppe artikli 13 alusel järgmine reservatsioon: Eesti Vabariik deklareerib, et ei aktsepteeri dokumenti, mis on prantsuse keeles või millele on lisatud tõlge prantsuse keelde, kui dokumendil puudub tõlge inglise või eesti keelde.",
      "rdfs:label": {
        "@value": "OTEEKR_Par_2 (redaktsioon 79006)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "79006",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/79006",
      "estleg:sourceAct": "Õigusabi taotluste edastamise Euroopa kokkuleppe ratifitseerimise seadus",
      "estleg:provisionRef": "OTEEKR § 2",
      "estleg:partOfAct": {
        "@id": "estleg:OTEEKR_Map"
      }
    },
    {
      "@id": "estleg:OTEEKR_Par_3_v79006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OTEEKR_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Nimetada õigusabi taotlusi vastuvõtvaks keskasutuseks ja edastavaks asutuseks eelnimetatud kokkuleppe artikli 2 tähenduses Justiitsministeerium.",
      "rdfs:label": {
        "@value": "OTEEKR_Par_3 (redaktsioon 79006)",
        "@language": "et"
      },
