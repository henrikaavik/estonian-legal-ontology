        "@value": "Sätete redaktsioonid: Õigusabi taotluste edastamise Euroopa kokkuleppe ratifitseerimise seadus (3 versiooni)",
        "@language": "et"
      },
      "dc:source": "Õigusabi taotluste edastamise Euroopa kokkuleppe ratifitseerimise seadus"
    },
    {
      "@id": "estleg:OTEEKR_Par_1_v79006",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
