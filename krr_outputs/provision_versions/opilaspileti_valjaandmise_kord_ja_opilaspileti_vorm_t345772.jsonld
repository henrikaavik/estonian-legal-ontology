    {
      "@id": "estleg:Reg_345772_Par_4_v345772",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345772_Par_4"
      },
