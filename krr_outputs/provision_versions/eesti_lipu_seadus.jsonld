    {
      "@id": "estleg:ELS_Par_26_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2006. aasta 1. jaanuaril. (2) Käesoleva seaduse § 5 lõige 3 jõustub 2005. aasta 1. septembril. Eesti lipp Sinine toon rahvusvahelise PANTONE värvitabeli järgi on 285 C Vabariigi Presidendi lipp Sinine toon rahvusvahelise PANTONE värvitabeli järgi on 285 C Suur riigivapp Sinine toon rahvusvahelise PANTONE värvitabeli järgi on 285 C Väike riigivapp Sinine toon rahvusvahelise PANTONE värvitabeli järgi on 285 C Suur riigivapp Väike riigivapp Suur riigivapp Väike riigivapp",
      "rdfs:label": {
