  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_eesti_lipu_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Eesti lipu seadus (43 versiooni)",
        "@language": "et"
      },
      "dc:source": "Eesti lipu seadus"
    },
    {
      "@id": "estleg:ELS_Par_1_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti lipp on sinimustvalge. (2) Eesti lippu kasutatakse rahvus- ja riigilipuna.",
      "rdfs:label": {
        "@value": "ELS_Par_1 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_10_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui Eesti lipp heisatakse koos teiste lippudega, peab Eesti lipp olema auväärsemal kohal. (2) Vabariigi Presidendi lipp paigutatakse Eesti lipust lipurivi tagant vaadatuna paremale ja välisriigi riigipea lipp vasakule. (3) Teiste riikide lipud paigutatakse Eesti lipu järel prantsuskeelsete riiginimede tähestikulises järjekorras. Ainult Euroopa Liidu liikmesriikide lippude heiskamisel paigutatakse riigilipud omakeelsete riiginimede tähestikulises järjekorras. Prantsuskeelsete ja Euroopa Liidu omakeelsete riiginimede tähestikuline järjekord avaldatakse riigisekretäri teadaandena Riigi Teataja Lisas. (4) Kui Eesti lipp heisatakse koos teise riigi lipuga ning rahvusvahelise organisatsiooni lipuga ja Eesti maakonna, linna, valla või muu lipuga, paigutatakse Eesti maakonna, linna või valla lipp või muu lipp rahvusvahelise organisatsiooni lipust lipurivi tagant vaadatuna vasakule. (5) Sõltuvalt lipurivi asukohast ja lippude arvust võib lõigetes 2–4 ettenähtud lippude järjestust heiskamisel muuta, arvestades, et Eesti lipp oleks auväärsemal kohal. (6) Lipud heisatakse eraldi, ühesuguse pikkusega lipuvardasse või -masti ja Eesti lipuga samale kõrgusele. Heisatavad lipud on võrdse laiusega.",
      "rdfs:label": {
        "@value": "ELS_Par_10 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_10_v13311721"
      },
      "estleg:versionValidTo": {
        "@value": "2010-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_10_v13311721",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui Eesti lipp heisatakse koos teiste lippudega, peab Eesti lipp olema auväärsemal kohal. (2) Vabariigi Presidendi lipp paigutatakse Eesti lipust lipurivi tagant vaadatuna paremale ja välisriigi riigipea lipp vasakule. (3) Teiste riikide lipud paigutatakse Eesti lipu järel prantsuskeelsete riiginimede tähestikulises järjekorras. Ainult Euroopa Liidu liikmesriikide lippude heiskamisel paigutatakse riigilipud omakeelsete riiginimede tähestikulises järjekorras. Prantsuskeelsete ja Euroopa Liidu omakeelsete riiginimede tähestikuline järjekord avaldatakse riigisekretäri teadaandena Riigikantselei veebilehel. (4) Kui Eesti lipp heisatakse koos teise riigi lipuga ning rahvusvahelise organisatsiooni lipuga ja Eesti maakonna, linna, valla või muu lipuga, paigutatakse Eesti maakonna, linna või valla lipp või muu lipp rahvusvahelise organisatsiooni lipust lipurivi tagant vaadatuna vasakule. (5) Sõltuvalt lipurivi asukohast ja lippude arvust võib lõigetes 2–4 ettenähtud lippude järjestust heiskamisel muuta, arvestades, et Eesti lipp oleks auväärsemal kohal. (6) Lipud heisatakse eraldi, ühesuguse pikkusega lipuvardasse või -masti ja Eesti lipuga samale kõrgusele. Heisatavad lipud on võrdse laiusega.",
      "rdfs:label": {
        "@value": "ELS_Par_10 (redaktsioon 13311721)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13311721"
    },
    {
      "@id": "estleg:ELS_Par_11_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, Riigikohtu, Riigikontrolli, Õiguskantsleri, ministeeriumi, Eesti Panga, Kaitsejõudude Peastaabi, maavalitsuse, valla- ja linnavolikogu ning valla- ja linnavalitsuse hoonele või hoone juures asuvatesse lipumastidesse heisatakse koos Eesti lipuga Euroopa Liidu lipp Euroopa päeval ja Euroopa Parlamendi valimise päeval. (3) Eesti välisesinduse hoonel Euroopa Liidu lipu heiskamise kohta annab juhised välisminister. Euroopa Liidu lipp heisatakse koos Eesti riigilipuga.",
      "rdfs:label": {
        "@value": "ELS_Par_11 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_11_v13003097"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_11_v13003097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, Riigikohtu, Riigikontrolli, õiguskantsleri, ministeeriumi, Eesti Panga, Kaitseväe Peastaabi, maavalitsuse, valla- ja linnavolikogu ning valla- ja linnavalitsuse hoonele või hoone juures asuvatesse lipumastidesse heisatakse koos Eesti lipuga Euroopa Liidu lipp Euroopa päeval ja Euroopa Parlamendi valimise päeval. (3) Eesti välisesinduse hoonel Euroopa Liidu lipu heiskamise kohta annab juhised välisminister. Euroopa Liidu lipp heisatakse koos Eesti riigilipuga.",
      "rdfs:label": {
        "@value": "ELS_Par_11 (redaktsioon 13003097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13003097",
