        "@value": "2014-06-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_11_v104062014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, Riigikohtu, Riigikontrolli, õiguskantsleri, ministeeriumi, Eesti Panga, Kaitseväe Peastaabi, maavalitsuse, valla- ja linnavolikogu ning valla- ja linnavalitsuse hoonele või hoone juures asuvatesse lipumastidesse heisatakse koos Eesti lipuga Euroopa Liidu lipp Euroopa päeval ja Euroopa Parlamendi valimise päeval. (2) määrab piiripunktid, kus koos Eesti lipuga heisatakse alaliselt Euroopa Liidu lipp. (3) Eesti välisesinduse hoonel Euroopa Liidu lipu heiskamise kohta annab juhised valdkonna eest vastutav minister. Euroopa Liidu lipp heisatakse koos Eesti riigilipuga. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „välisminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ELS_Par_11 (redaktsioon 104062014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104062014004",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_11_v104072017014"
      },
      "estleg:versionValidTo": {
        "@value": "2017-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_11_v104072017014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, Riigikohtu, Riigikontrolli, õiguskantsleri, ministeeriumi, Eesti Panga, Kaitseväe Peastaabi, valla- ja linnavolikogu ning valla- ja linnavalitsuse hoonele või hoone juures asuvatesse lipumastidesse heisatakse koos Eesti lipuga Euroopa Liidu lipp Euroopa päeval ja Euroopa Parlamendi valimise päeval. (2) määrab piiripunktid, kus koos Eesti lipuga heisatakse alaliselt Euroopa Liidu lipp. (3) Eesti välisesinduse hoonel Euroopa Liidu lipu heiskamise kohta annab juhised valdkonna eest vastutav minister. Euroopa Liidu lipp heisatakse koos Eesti riigilipuga. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist „välisminister” sõnadega „valdkonna eest vastutav minister”.",
      "rdfs:label": {
        "@value": "ELS_Par_11 (redaktsioon 104072017014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104072017014"
    },
    {
      "@id": "estleg:ELS_Par_12_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Üleriigilise leina tähistamiseks heisatakse Eesti lipp leinalipuna. (2) Kui Eesti lipp heisatakse leinalipuna, kinnitatakse lipuvarda ülemisse otsa must lint või heisatakse lipp poolde masti.",
      "rdfs:label": {
        "@value": "ELS_Par_12 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_13_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti lippu võib paigutada diplomaatilise protokolli nõuete kohaselt Eesti välisesinduse juhi ja välisriigi esindaja Eesti-visiidil kasutatavale liiklusvahendile ning liiklusvahendile, mida kasutavad Riigikogu esimees, peaminister või Eesti Vabariigi muu ametlik esindaja oma teenistusülesandeid täites.",
      "rdfs:label": {
        "@value": "ELS_Par_13 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_14_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti lipu heiskamist ja kasutamist laeval reguleerivad laeva lipuõiguse ja laevaregistrite seadus (RT I 1998, 23, 321; 59, 941; 1999, 10, 149; 2000, 55, 365; 2001, 56, 336; 93, 565; 2002, 61, 375; 63, 387; 2003, 13, 66; 88, 594; 2004, 30, 208) ning head rahvusvahelised meretavad ja -kombed.",
      "rdfs:label": {
        "@value": "ELS_Par_14 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_14_v13003097"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_14_v13003097",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti lipu heiskamist ja kasutamist laeval reguleerivad laeva lipuõiguse ja laevaregistrite seadus ning head rahvusvahelised meretavad ja -kombed.",
      "rdfs:label": {
        "@value": "ELS_Par_14 (redaktsioon 13003097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13003097"
    },
    {
      "@id": "estleg:ELS_Par_15_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti lippu või selle värvikombinatsiooni kasutatakse head tava järgides. (2) Kaitseväe väeosa lipu üks külg võib olla Eesti lipu värvikombinatsioonis. (3) Igaühel on õigus kasutada Eesti lipu värvikombinatsioonis vimplit. Vimpel ei asenda Eesti lippu. (4) Eesti lipu kujutist sisaldavat tähist ei kasutata kauba- või teenindusmärgina. (5) Füüsilise isiku või juriidilise isiku lipp (välja arvatud Eesti Üliõpilaste Seltsi lipp) ei tohi olla Eesti lipuga äravahetamiseni sarnane. (6) Eesti lipu ja selle värvikombinatsiooni kasutamise korra ja hea tava kohta annab selgitusi Riigikantselei. (7) Riigikantseleil on õigus juhtida tähelepanu Eesti lipu ja selle värvikombinatsiooni kasutamise korra ja hea tava järgimise vajadusele.",
      "rdfs:label": {
        "@value": "ELS_Par_15 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_16_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kasutamiskõlbmatuks muutunud lippu hävitatakse sündsal viisil.",
      "rdfs:label": {
        "@value": "ELS_Par_16 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_17_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Presidendi lipp on Eesti lipp, mille mõlemal küljel on keskel suur riigivapp. Vapilõvid lipu mõlemal küljel on suunatud lipuvarda poole. Vabariigi Presidendi lipu kujutis on lisatud käesolevale seadusele. (2) Vabariigi Presidendi lipp heisatakse tema residentsile ja liiklusvahendile ning vajaduse korral tseremoonia toimumise kohas Vabariigi Presidendi osavõtu ajaks.",
      "rdfs:label": {
        "@value": "ELS_Par_17 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_18_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erimärgiga Eesti lippu on õigus kasutada kaitseministril, piirivalve-, tolli- ja postiasutusel. (2) Erimärgiga Eesti lipu kirjeldus",
      "rdfs:label": {
        "@value": "ELS_Par_18 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_18_v13246870"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_18_v13246870",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erimärgiga Eesti lippu on õigus kasutada kaitseministril, politsei-, tolli- ja postiasutusel. (2) Erimärgiga Eesti lipu kirjeldus",
      "rdfs:label": {
        "@value": "ELS_Par_18 (redaktsioon 13246870)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13246870",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_18_v104062014004"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_18_v104062014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Erimärgiga Eesti lippu on õigus kasutada valdkonna eest vastutaval ministril, politsei-, tolli- ja postiasutusel. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud sõna „kaitseministril“ sõnadega „valdkonna eest vastutaval ministril“. (2) Erimärgiga Eesti lipu kirjeldus kehtestatakse määrusega.",
      "rdfs:label": {
        "@value": "ELS_Par_18 (redaktsioon 104062014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104062014004"
    },
    {
      "@id": "estleg:ELS_Par_19_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti mereväe lipp on Eesti lipu värvikombinatsioonis ja selle mõlemal küljel on väike riigivapp. Vapilõvid lipu mõlemal küljel on suunatud lipuvarda poole. (2) Eesti mereväe lipu kirjeldus",
      "rdfs:label": {
        "@value": "ELS_Par_19 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELS_Par_19_v104062014004"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELS_Par_19_v104062014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-06-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti mereväe lipp on Eesti lipu värvikombinatsioonis ja selle mõlemal küljel on väike riigivapp. Vapilõvid lipu mõlemal küljel on suunatud lipuvarda poole. (2) Eesti mereväe lipu kirjeldus kehtestatakse määrusega.",
      "rdfs:label": {
        "@value": "ELS_Par_19 (redaktsioon 104062014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104062014004"
    },
    {
      "@id": "estleg:ELS_Par_2_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti lipp koosneb kolmest võrdse laiusega horisontaalsest värvilaiust. Ülemine laid on sinine, keskmine must ja alumine valge. Lipu laiuse ja pikkuse vahekord on 7:11. (2) Eesti lipu kujutis on lisatud käesolevale seadusele.",
      "rdfs:label": {
        "@value": "ELS_Par_2 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
      "@id": "estleg:ELS_Par_20_v882755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riigivapi seaduses (RT I 2001, 65, 376; 2002, 34, 206; 63, 387) tehakse järgmised muudatused: paragrahv 4 muudetakse ja sõnastatakse järgmiselt: «Käesolev seadus kinnitab: Eesti Vabariigi suure riigivapi etalonkujutise koos sinise värvitooni määratlusega rahvusvahelise PANTONE värvitabeli järgi (Lisa 1); Eesti Vabariigi väikese riigivapi etalonkujutise koos sinise värvitooni määratlusega rahvusvahelise PANTONE värvitabeli järgi (Lisa 2); Eesti Vabariigi suure riigivapi mustvalge graafilise etalonkujutise (Lisa 3 ja 5); Eesti Vabariigi väikese riigivapi mustvalge graafilise etalonkujutise (Lisa 4 ja 6).»; paragrahvi 23 täiendatakse lõikega 4 järgmises sõnastuses: «(4) Riigivapid, mis on kasutusele võetud Eesti Vabariigi seaduse Eesti Vabariigi riigilipu ja riigivapi etalonkujutiste kinnitamise kohta (RT 1992, 43, 566) alusel, kehtivad nende kasutusaja lõpuni.»",
      "rdfs:label": {
        "@value": "ELS_Par_20 (redaktsioon 882755)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "882755"
    },
    {
