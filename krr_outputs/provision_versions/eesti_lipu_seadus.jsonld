      }
    },
    {
      "@id": "estleg:ELS_Par_11_v13311721",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikogu, Vabariigi Presidendi, Vabariigi Valitsuse, Riigikohtu, Riigikontrolli, õiguskantsleri, ministeeriumi, Eesti Panga, Kaitseväe Peastaabi, maavalitsuse, valla- ja linnavolikogu ning valla- ja linnavalitsuse hoonele või hoone juures asuvatesse lipumastidesse heisatakse koos Eesti lipuga Euroopa Liidu lipp Euroopa päeval ja Euroopa Parlamendi valimise päeval. (2) piiripunktid, kus koos Eesti lipuga heisatakse alaliselt Euroopa Liidu lipp. (3) Eesti välisesinduse hoonel Euroopa Liidu lipu heiskamise kohta annab juhised välisminister. Euroopa Liidu lipp heisatakse koos Eesti riigilipuga.",
      "rdfs:label": {
        "@value": "ELS_Par_11 (redaktsioon 13311721)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13311721",
