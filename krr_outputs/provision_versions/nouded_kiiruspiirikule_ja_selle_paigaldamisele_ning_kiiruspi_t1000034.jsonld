    {
      "@id": "estleg:Reg_1000034_Par_5_v1000034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000034_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõidukile paigaldatud kiiruspiiriku perioodiline kontrollimine toimub mootorsõiduki korralise ülevaatuse käigus. Kiiruspiiriku perioodilisel kontrollimisel ja teel liikleva mootorsõiduki kiiruspiiriku kontrollimisel tuleb kontrollida piirkiirust tähistava sildi või plaadi olemasolu ja sellele kantud kiiruse vastavust käesoleva määruse § 4 lõikele 6 ning kui see on võimalik, siis ka piirkiiruse õigsust, plommide olemasolu ja puutumatust ning kiiruspiiriku toimimist. Mootorsõidukile paigaldatud kiiruspiiriku perioodiline kontrollimine toimub mootorsõiduki korralise ülevaatuse käigus. Kiiruspiiriku perioodilisel kontrollimisel ja teel liikleva mootorsõiduki kiiruspiiriku kontrollimisel tuleb kontrollida piirkiirust tähistava sildi või plaadi olemasolu ja sellele kantud kiiruse vastavust käesoleva määruse § 4 lõikele 6 ning kui see on võimalik, siis ka piirkiiruse õigsust, plommide olemasolu ja puutumatust ning kiiruspiiriku toimimist.",
      "rdfs:label": {
        "@value": "Reg_1000034_Par_5 (redaktsioon 1000034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1000034",
      "estleg:sourceAct": "Nõuded kiiruspiirikule ja selle paigaldamisele ning kiiruspiiriku kontrollimise tingimused ja kord",
      "estleg:provisionRef": "Reg_1000034 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000034_Map"
      }
    },
    {
      "@id": "estleg:Reg_1000034_Par_6_v1000034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000034_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pädevaks asutuseks, kes kontrollib kiiruspiirikute kohandajate tegevust ja teeb ettekirjutusi avastatud puuduste kõrvaldamiseks, kogub informatsiooni kiiruspiirikute kohandamise kohta ja korraldab nende perioodilist kontrollimist, on Transpordiamet. RT I 2021-09-03 1 103092021001 2021-09-06 Pädevaks asutuseks, kes kontrollib kiiruspiirikute kohandajate tegevust ja teeb ettekirjutusi avastatud puuduste kõrvaldamiseks, kogub informatsiooni kiiruspiirikute kohandamise kohta ja korraldab nende perioodilist kontrollimist, on Transpordiamet. 2 (2) Kiiruspiiriku kohandajad peavad Transpordiametile esitama kohandamisel kasutatavate piirkiirust tähistavate siltide või plaatide ja plommide näidised ning paigaldusskeemid. RT I 2021-09-03 1 103092021001 2021-09-06 Kiiruspiiriku kohandajad peavad Transpordiametile esitama kohandamisel kasutatavate piirkiirust tähistavate siltide või plaatide ja plommide näidised ning paigaldusskeemid. 3 (3) Kiiruspiiriku kohandajad peavad säilitama vähemalt kahe aasta jooksul järgmisi andmeid: 1 1) mootorsõiduki registreerimisnumber ja VIN-kood ehk tehasetähis; 2 2) rehvide mõõdud ja rehvi siserõhk; 3 3) teostatud tööde sisu ning ilmnenud vead; 4 4) kohandamise või kontrollimise kuupäev. Kiiruspiiriku kohandajad peavad säilitama vähemalt kahe aasta jooksul järgmisi andmeid: mootorsõiduki registreerimisnumber ja VIN-kood ehk tehasetähis; rehvide mõõdud ja rehvi siserõhk; teostatud tööde sisu ning ilmnenud vead; kohandamise või kontrollimise kuupäev. 4 (4) Transpordiamet peab kiiruspiiriku kohandajate andmepanka ja annab mootorsõiduki tehnonõuetele vastavuse kontrollimise õigust omavatele isikutele nende nõudmisel vajalikku informatsiooni. RT I 2021-09-03 1 103092021001 2021-09-06 Transpordiamet peab kiiruspiiriku kohandajate andmepanka ja annab mootorsõiduki tehnonõuetele vastavuse kontrollimise õigust omavatele isikutele nende nõudmisel vajalikku informatsiooni.",
      "rdfs:label": {
        "@value": "Reg_1000034_Par_6 (redaktsioon 1000034)",
        "@language": "et"
