      "estleg:provisionRef": "Reg_1012891 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012891_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1012891_Par_3_v1012891",
