      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teate tasumisele kuuluva riigilõivu kohta edastab konkursi korraldaja konkursi võitjale kolme tööpäeva jooksul konkursi võitja kohta otsuse tegemisest arvates. Teate tasumisele kuuluva riigilõivu kohta edastab konkursi korraldaja konkursi võitjale kolme tööpäeva jooksul konkursi võitja kohta otsuse tegemisest arvates.",
      "rdfs:label": {
