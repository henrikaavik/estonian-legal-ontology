    {
      "@id": "estleg:Reg_1012891_Par_18_v1012891",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1012891_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-01-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konkursi korraldaja annab konkursi võitjale sagedusloa kolme tööpäeva jooksul pärast riigilõivu ja ühekordse loatasu laekumist. Konkursi korraldaja annab konkursi võitjale sagedusloa kolme tööpäeva jooksul pärast riigilõivu ja ühekordse loatasu laekumist. 2 (2) Kõik konkursil osalemisel ja selle võitmisel võetud kohustused ja tingimused kantakse sagedusloale. Kõik konkursil osalemisel ja selle võitmisel võetud kohustused ja tingimused kantakse sagedusloale.",
      "rdfs:label": {
        "@value": "Reg_1012891_Par_18 (redaktsioon 1012891)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1012891",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1012891",
      "estleg:sourceAct": "Avaliku konkursi läbiviimise kord, nõuded ja tingimused sageduslubade andmiseks maapealsetes süsteemides üldkasutatava elektroonilise side teenuse osutamiseks sagedusalas 790–862 MHz",
      "estleg:provisionRef": "Reg_1012891 § 18",
