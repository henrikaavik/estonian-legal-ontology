        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_1001418_Par_8 (redaktsioon 1001418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001418",
      "estleg:sourceAct": "Tallinna Konstantin Pätsi Vabaõhukooli põhimäärus",
      "estleg:provisionRef": "Reg_1001418 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001418_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001418_Par_9_v1001418",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001418_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolil on raamatukogu, mille põhiülesanne on toetada trükiste, audiovisuaalsete ja muude teabekandjate hoidmise ja kättesaadavaks tegemise kaudu kooli õppekava järgset õpet, arendada õpilaste iseseisva õpitöö ja teabe hankimise oskust ning lugemishuvi. Koolil on raamatukogu, mille põhiülesanne on toetada trükiste, audiovisuaalsete ja muude teabekandjate hoidmise ja kättesaadavaks tegemise kaudu kooli õppekava järgset õpet, arendada õpilaste iseseisva õpitöö ja teabe hankimise oskust ning lugemishuvi.",
      "rdfs:label": {
        "@value": "Reg_1001418_Par_9 (redaktsioon 1001418)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001418",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001418",
      "estleg:sourceAct": "Tallinna Konstantin Pätsi Vabaõhukooli põhimäärus",
      "estleg:provisionRef": "Reg_1001418 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001418_Map"
      }
    },
