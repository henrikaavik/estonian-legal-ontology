      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ES_Par_64 (redaktsioon 176259)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "176259"
    },
    {
      "@id": "estleg:ES_Par_65_v22220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ES_Par_65"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1992. aasta 1. juulist. Seaduse jõustumise hetkest kaotab kehtivuse \"Eesti NSV elamukoodeks\".",
      "rdfs:label": {
