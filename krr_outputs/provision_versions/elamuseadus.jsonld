      },
      "estleg:versionValidTo": {
        "@value": "2004-12-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ES_Par_7_v829085",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ES_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-12-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Valitsuse võimkonda elamusuhete reguleerimisel kuulub: kehtetu - kehtetu - muude küsimuste otsustamine, mis on seadusega antud valitsuse võimkonda. (2) Valitsuse võimkonda kuulub riigi omanduses olevate",
      "rdfs:label": {
        "@value": "ES_Par_7 (redaktsioon 829085)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "829085",
