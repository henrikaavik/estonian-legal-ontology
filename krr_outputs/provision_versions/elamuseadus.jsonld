      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud -",
      "rdfs:label": {
        "@value": "ES_Par_26_1 (redaktsioon 121032014040)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032014040"
    },
    {
      "@id": "estleg:ES_Par_27_v22220",
      "@type": [
