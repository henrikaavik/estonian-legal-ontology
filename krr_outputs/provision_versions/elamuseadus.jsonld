      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ES_Par_63 (redaktsioon 829085)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "829085"
    },
    {
      "@id": "estleg:ES_Par_64_v22220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ES_Par_64"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui Eesti Vabariigile kohustusliku rahvusvahelise lepinguga ei ole kehtestatud teistsugust korda, kohaldatakse Eesti Vabariigis elavate välisriikide kodanike ja kodakondsuseta isikute suhtes käesoleva seaduse eeskirju.",
      "rdfs:label": {
        "@value": "ES_Par_64 (redaktsioon 22220)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22220",
      "estleg:supersededByVersion": {
        "@id": "estleg:ES_Par_64_v176259"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ES_Par_64_v176259",
      "@type": [
