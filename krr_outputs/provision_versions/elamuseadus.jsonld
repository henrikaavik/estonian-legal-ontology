      "estleg:versionValidFrom": {
        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 1992. aasta 1. juulist. Seaduse jõustumise hetkest kaotab kehtivuse \"Eesti NSV elamukoodeks\". §-d 66-67. Kehtetud -",
      "rdfs:label": {
        "@value": "ES_Par_65 (redaktsioon 256530)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "256530",
