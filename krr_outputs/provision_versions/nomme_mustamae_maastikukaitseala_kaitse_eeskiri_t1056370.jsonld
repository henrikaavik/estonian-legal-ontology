      "estleg:sourceAct": "Nõmme-Mustamäe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056370 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056370_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056370_Par_2_v1056370",
      "@type": [
