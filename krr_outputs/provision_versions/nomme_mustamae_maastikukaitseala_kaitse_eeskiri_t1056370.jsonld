    {
      "@id": "estleg:Reg_1056370_Par_10_v1056370",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056370_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 15. augusti 2022. a käskkirjaga nr 1-2/22/258 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 15. augusti 2022. a käskkirjaga nr 1-2/22/258 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1056370_Par_10 (redaktsioon 1056370)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056370",
