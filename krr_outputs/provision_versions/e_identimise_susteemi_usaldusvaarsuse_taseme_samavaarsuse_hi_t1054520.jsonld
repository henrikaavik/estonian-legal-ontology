      "rdfs:label": {
        "@value": "Sätete redaktsioonid: E-identimise süsteemi usaldusväärsuse taseme samaväärsuse hindamise tingimused ja kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "E-identimise süsteemi usaldusväärsuse taseme samaväärsuse hindamise tingimused ja kord"
    },
    {
      "@id": "estleg:Reg_1054520_Par_1_v1054520",
      "@type": [
        "owl:NamedIndividual",
