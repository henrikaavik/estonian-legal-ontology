      "estleg:sourceAct": "E-identimise süsteemi usaldusväärsuse taseme samaväärsuse hindamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1054520 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054520_Map_2026"
      }
    },
