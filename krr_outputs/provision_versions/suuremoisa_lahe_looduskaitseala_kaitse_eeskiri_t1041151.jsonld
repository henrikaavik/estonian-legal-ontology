        "@type": "xsd:date"
      },
      "estleg:versionText": "Suuremõisa lahe sihtkaitsevööndis poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu taastamiseks ja säilitamiseks vajalik rohu ja roo niitmine, loomade karjatamine, puu- ja põõsarinde harvendamine või raadamine. Suuremõisa lahe sihtkaitsevööndis poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu taastamiseks ja säilitamiseks vajalik rohu ja roo niitmine, loomade karjatamine, puu- ja põõsarinde harvendamine või raadamine.",
      "rdfs:label": {
        "@value": "Reg_1041151_Par_12 (redaktsioon 1041151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041151",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041151",
      "estleg:sourceAct": "Suuremõisa lahe looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041151 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041151_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041151_Par_13_v1041151",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041151_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala osa, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Aljava piiranguvöönd. Kaitsealal on Aljava piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_1041151_Par_13 (redaktsioon 1041151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041151",
