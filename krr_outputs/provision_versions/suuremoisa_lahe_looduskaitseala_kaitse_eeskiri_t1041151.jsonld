      }
    },
    {
      "@id": "estleg:Reg_1041151_Par_2_v1041151",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041151_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Saare maakonnas Muhu vallas Laheküla ja Pädaste külas. Kaitseala asub Saare maakonnas Muhu vallas Laheküla ja Pädaste külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_1041151_Par_2 (redaktsioon 1041151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041151",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041151",
      "estleg:sourceAct": "Suuremõisa lahe looduskaitseala kaitse-eeskiri",
