      }
    },
    {
      "@id": "estleg:Reg_1041151_Par_14_v1041151",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041151_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ning kaitstavate liikide ja nende elupaikade kaitse. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ning kaitstavate liikide ja nende elupaikade kaitse.",
      "rdfs:label": {
        "@value": "Reg_1041151_Par_14 (redaktsioon 1041151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041151",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041151",
      "estleg:sourceAct": "Suuremõisa lahe looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041151 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041151_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041151_Par_15_v1041151",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041151_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus, arvestades käesoleva määrusega sätestatud erisusi; 2 2) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja nõusolekul tähistamata kohas. Piiranguvööndis on lubatud: majandustegevus, arvestades käesoleva määrusega sätestatud erisusi; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja nõusolekul tähistamata kohas. 2 (2) Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: 1 1) ehitise, kaasa arvatud ajutise ehitise püstitamine, kusjuures kaitse-eesmärgist lähtuvalt on lubatud ehitisi püstitada ka ehituskeeluvööndis; 2 2) rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; 3 3) veekogude veetaseme ja kaldajoone muutmine; 4 4) häil- ja aegjärkne raie 1. augustist 14. veebruarini kuni kahe hektari suuruse langina. Kaitseala valitseja nõusolekul on piiranguvööndis lubatud: ehitise, kaasa arvatud ajutise ehitise püstitamine, kusjuures kaitse-eesmärgist lähtuvalt on lubatud ehitisi püstitada ka ehituskeeluvööndis; rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohas; veekogude veetaseme ja kaldajoone muutmine; häil- ja aegjärkne raie 1. augustist 14. veebruarini kuni kahe hektari suuruse langina. 3 (3) Aegjärkse raie viimase raiejärgu tegemisel tuleb raielangile jätta säilikpuid vähemalt 10 tihumeetrit hektari kohta. Aegjärkse raie viimase raiejärgu tegemisel tuleb raielangile jätta säilikpuid vähemalt 10 tihumeetrit hektari kohta.",
      "rdfs:label": {
        "@value": "Reg_1041151_Par_15 (redaktsioon 1041151)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041151",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041151",
      "estleg:sourceAct": "Suuremõisa lahe looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041151 § 15",
      "estleg:partOfAct": {
