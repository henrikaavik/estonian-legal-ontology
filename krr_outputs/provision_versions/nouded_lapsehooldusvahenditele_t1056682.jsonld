        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056682_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Käesoleva määrusega kehtestatakse nõuded rõngas- ja pudeliluttidele ning lapse suu ja suulimaskestaga kokkupuutumiseks ette nähtud muudele lapsehooldusvahenditele või nende osadele (edaspidi koos lapsehooldusvahend), et tagada kasutamisel nende ohutus lapse tervisele. Käesoleva määrusega kehtestatakse nõuded rõngas- ja pudeliluttidele ning lapse suu ja suulimaskestaga kokkupuutumiseks ette nähtud muudele lapsehooldusvahenditele või nende osadele (edaspidi koos lapsehooldusvahend), et tagada kasutamisel nende ohutus lapse tervisele. 2 (2) Lapsehooldusvahend käesoleva määruse tähenduses on toode, mis on ette nähtud lapse uinumise, rahustamise, hügieeni, toitmise ja imemise hõlbustamiseks. Lapsehooldusvahend käesoleva määruse tähenduses on toode, mis on ette nähtud lapse uinumise, rahustamise, hügieeni, toitmise ja imemise hõlbustamiseks. 3 (3) Nõudeid ei rakendata enneaegse lapse toitmiseks ja eridiagnoosiga haige lapse toitmiseks kasutatava luti, sealhulgas Pierre Robini sündroomiga lapse luti mõõtmete kohta. Nõudeid ei rakendata enneaegse lapse toitmiseks ja eridiagnoosiga haige lapse toitmiseks kasutatava luti, sealhulgas Pierre Robini sündroomiga lapse luti mõõtmete kohta.",
      "rdfs:label": {
        "@value": "Reg_1056682_Par_1 (redaktsioon 1056682)",
        "@language": "et"
      },
