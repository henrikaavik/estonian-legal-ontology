    {
      "@id": "estleg:Reg_1051859_Par_7_v1051859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051859_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatud sõitja kõrgeim piletihind ning sõiduki ja selle haagise piletihind ning sõidusoodustused jõustuvad: 1 1) Sviby-Rohuküla laevaliinil 1. juunil 2021. a; 2 2) Kihnu-Munalaid ja Munalaid-Manilaid laevaliinil ning Laaksaare-Piirissaar laevaliinil 1. septembril 2021. a; 3 3) Ringsu-Munalaid, Ringsu-Pärnu ja Ringsu-Roomassaare laevaliinil 1. mail 2022. a. Määrusega kehtestatud sõitja kõrgeim piletihind ning sõiduki ja selle haagise piletihind ning sõidusoodustused jõustuvad: Sviby-Rohuküla laevaliinil 1. juunil 2021. a; Kihnu-Munalaid ja Munalaid-Manilaid laevaliinil ning Laaksaare-Piirissaar laevaliinil 1. septembril 2021. a; Ringsu-Munalaid, Ringsu-Pärnu ja Ringsu-Roomassaare laevaliinil 1. mail 2022. a.",
      "rdfs:label": {
        "@value": "Reg_1051859_Par_7 (redaktsioon 1051859)",
        "@language": "et"
      },
