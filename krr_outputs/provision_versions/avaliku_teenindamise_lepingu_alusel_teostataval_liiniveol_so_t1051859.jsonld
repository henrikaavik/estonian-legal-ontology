      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Avaliku teenindamise lepingu alusel teostataval liiniveol sõitja kõrgeim piletihind, sõiduki ja selle haagise piletihinnad ning sõidusoodustused Eesti mandri ja väikesaarte vahelistel laevaliinidel (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Avaliku teenindamise lepingu alusel teostataval liiniveol sõitja kõrgeim piletihind, sõiduki ja selle haagise piletihinnad ning sõidusoodustused Eesti mandri ja väikesaarte vahelistel laevaliinidel"
    },
    {
      "@id": "estleg:Reg_1051859_Par_1_v1051859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
