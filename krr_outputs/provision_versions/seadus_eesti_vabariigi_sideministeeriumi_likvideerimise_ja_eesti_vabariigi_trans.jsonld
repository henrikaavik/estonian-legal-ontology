        "@type": "xsd:date"
      },
      "estleg:versionText": "Teha Eesti NSV 1989. aasta 6. detsembri seaduse \"Eesti Nõukogude Sotsialistliku Vabariigi Valitsuse kohta\" (ENSV Teataja 1989, nr. 39, art. 609) paragrahvis 24 järgmised muudatused: jätta välja sõna \"Sideministeerium\"; asendada sõna \"Transpordiministeerium\" sõnadega \"Transpordi- ja Sideministeerium\".",
      "rdfs:label": {
        "@value": "EVSLEVTR_Par_3 (redaktsioon 24097)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "24097",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/24097",
      "estleg:sourceAct": "Seadus Eesti Vabariigi Sideministeeriumi likvideerimise ja Eesti Vabariigi Transpordiministeeriumi reorganiseerimise kohta",
      "estleg:provisionRef": "EVSLEVTR § 3",
      "estleg:partOfAct": {
        "@id": "estleg:EVSLEVTR_Map"
      }
    },
    {
