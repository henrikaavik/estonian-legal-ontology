        "@value": "2020-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse § 3 lõike 2 punkt 6 jõustub 1. juulil 2018. aastal. Määruse § 3 lõike 2 punkt 6 jõustub 1. juulil 2018. aastal.",
      "rdfs:label": {
        "@value": "Reg_1040662_Par_19 (redaktsioon 1040662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040662",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040662",
