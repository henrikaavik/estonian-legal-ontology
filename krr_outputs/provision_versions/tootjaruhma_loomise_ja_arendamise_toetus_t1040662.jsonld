      "estleg:provisionRef": "Reg_1040662 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040662_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1040662_Par_15_v1040662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040662_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitab PRIA kuni 2032. aasta 31. detsembrini. Määruse alusel esitatud dokumente taotlejale ei tagastata. Nimetatud dokumente säilitab PRIA kuni 2032. aasta 31. detsembrini.",
      "rdfs:label": {
        "@value": "Reg_1040662_Par_15 (redaktsioon 1040662)",
        "@language": "et"
      },
