    {
      "@id": "estleg:Reg_1040662_Par_16_v1040662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040662_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui §-s 11 nimetatud otsuse tegemise tähtpäevaks ei ole Euroopa Komisjon teinud kooskõlas Euroopa Liidu suunistega riigiabi kohta põllumajandus- ja metsandussektoris ning maapiirkondades aastateks 2014–2020 (ELT C 204, 01.07.2014, lk 1‒97) riigiabi teatise kohta otsust, teeb PRIA metsandussektori tootjarühma puhul §-s 11 nimetatud otsuse 40 tööpäeva jooksul arvates vastava teatise kohta otsuse saamisest. Kui §-s 11 nimetatud otsuse tegemise tähtpäevaks ei ole Euroopa Komisjon teinud kooskõlas Euroopa Liidu suunistega riigiabi kohta põllumajandus- ja metsandussektoris ning maapiirkondades aastateks 2014–2020 (ELT C 204, 01.07.2014, lk 1‒97) riigiabi teatise kohta otsust, teeb PRIA metsandussektori tootjarühma puhul §-s 11 nimetatud otsuse 40 tööpäeva jooksul arvates vastava teatise kohta otsuse saamisest.",
      "rdfs:label": {
        "@value": "Reg_1040662_Par_16 (redaktsioon 1040662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040662",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040662",
