        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA kontrollib taotluse vastuvõtmisel nõutavate dokumentide olemasolu ja taotluse tähtaegset esitamist. PRIA kontrollib taotluse vastuvõtmisel nõutavate dokumentide olemasolu ja taotluse tähtaegset esitamist.",
      "rdfs:label": {
        "@value": "Reg_1040662_Par_8 (redaktsioon 1040662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040662",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040662",
      "estleg:sourceAct": "Tootjarühma loomise ja arendamise toetus",
      "estleg:provisionRef": "Reg_1040662 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040662_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1040662_Par_9_v1040662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040662_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "PRIA kontrollib taotluse nõuetele vastavust ja selles esitatud andmete õigsust ning taotleja ja toetatava tegevuse vastavust Euroopa Liidu õigusaktides, Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduses, arengukavas ja selles määruses sätestatud nõuetele. PRIA kontrollib taotluse nõuetele vastavust ja selles esitatud andmete õigsust ning taotleja ja toetatava tegevuse vastavust Euroopa Liidu õigusaktides, Euroopa Liidu ühise põllumajanduspoliitika rakendamise seaduses, arengukavas ja selles määruses sätestatud nõuetele.",
