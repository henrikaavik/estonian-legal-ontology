      "estleg:provisionRef": "Reg_1040662 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040662_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1040662_Par_7_v1040662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040662_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja esitab avalduse, mis sisaldab järgmisi andmeid: 1 1) taotleja ärinimi, äriregistri kood, taotleja esindaja nimi ja kontaktandmed; 2 2) taotleja tegevusvaldkond, rakenduspiirkond ja tegevuskoha aadress; 3 3) taotletava toetuse summa; 4 4) teave taotleja § 3 lõike 2 punktis 1 nimetatud mikro-, väikese või keskmise suurusega ettevõtjale esitatud nõuetele vastavuse kohta; 5 5) teave paragrahvis 5 nimetatud müügitulu kohta; 6 6) teave selle kohta, et taotleja ei ole raskustes olev ettevõtja; 7 7) andmed, mida on vaja seireks ja hindamiseks. Taotleja esitab avalduse, mis sisaldab järgmisi andmeid: taotleja ärinimi, äriregistri kood, taotleja esindaja nimi ja kontaktandmed; taotleja tegevusvaldkond, rakenduspiirkond ja tegevuskoha aadress; taotletava toetuse summa; teave taotleja § 3 lõike 2 punktis 1 nimetatud mikro-, väikese või keskmise suurusega ettevõtjale esitatud nõuetele vastavuse kohta; teave paragrahvis 5 nimetatud müügitulu kohta; teave selle kohta, et taotleja ei ole raskustes olev ettevõtja; andmed, mida on vaja seireks ja hindamiseks.",
      "rdfs:label": {
        "@value": "Reg_1040662_Par_7 (redaktsioon 1040662)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040662",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040662",
      "estleg:sourceAct": "Tootjarühma loomise ja arendamise toetus",
      "estleg:provisionRef": "Reg_1040662 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040662_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1040662_Par_8_v1040662",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
