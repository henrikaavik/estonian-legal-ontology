  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_laenude_riikliku_tagamise_tehniliste_eraldiste_moodustamise__t158678_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord"
    },
    {
      "@id": "estleg:Reg_158678_Par_1_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse «Ettevõtluse toetamise ja laenude riikliku tagamise seaduse» § 7 lõikes 1 nimetatud sihtasutuse (edaspidi sihtasutus) laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_1 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_2_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sihtasutuse laenude tagamise tehnilised eraldised on kehtivatest tagatislepingutest tulenevate ja tulevikus sihtasutuse poolt potentsiaalselt väljamaksmisele kuuluvate nõuete katteks arvestatud kohustuste summa. (2) Sihtasutus on kohustatud käesoleva määruse alusel moodustama ja ümber arvutama iga kvartali viimase päeva seisuga järgmiste tehniliste eraldiste suurused: 1) ettemakstud preemiate eraldis; 2) rahuldamata nõuete eraldis; 3) tasanduseraldis. (3) Kui lõikes 2 nimetatud eraldistest potentsiaalsete nõuete kajastamiseks ei piisa, siis võib sihtasutus lisaks lõikes 2 nimetatud tehnilistele eraldistele vajaduse korral moodustada täiendavaid tehnilisi eraldisi. (4) Sihtasutuse audiitor hindab aastaaruande auditeerimisel muu hulgas aruandes kajastatud eraldiste vastavust sihtasutuse poolt potentsiaalselt väljamaksmisele kuuluvate nõuete summale ja sihtasutuse poolt eraldiste arvutamisel kasutatud metoodika vastavust käesolevale määrusele.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_2 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_3_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettemakstud preemiate eraldis on arvestuslik summa teenitud tagatistasudest, mille ulatuses on sihtasutusel tagatisest tulenev risk ja sellega seotud kulud kandmata ja mis lepingu katkestamisel kuuluvad seetõttu tagastamisele.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_3 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_4_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahuldamata nõuete eraldis on sihtasutuse laenude riiklikust tagamisest tulenevate ja sihtasutusele teada olevate, kuid rahuldamata nõuete arvestuslik summa.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_4 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_5_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tasanduseraldis on sihtasutuse poolt tagatistasude arvel laenude riiklikust tagamisest tulenevate tulevastel perioodidel potentsiaalselt väljamaksmisele kuuluvate nõuete, mille suurus ega väljamaksmise aeg pole teada, katteks moodustatud eraldis.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_5 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_6_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ettemakstud preemiate eraldis arvutatakse selliste tagatistasude kohta, mille eest on arve esitatud ette, kuid mis lepingu katkestamisel kuuluvad tagastamisele vastavalt kandmata jäänud riski suurusele. (2) Ettemakstud preemiate eraldis väheneb võrdeliselt veel möödumata tagatisperioodi ja kogu tagatislepingu kehtivuse perioodi suhtele.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_6 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_7_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahuldamata nõuete eraldise suuruse arvutamisel hinnatakse sihtasutuse poolt väljamaksmisele kuuluvaid hüvitisi, mis tulenevad enne eraldise arvutamise kuupäeva ilmnenud, tagatisega hõlmatud kahjujuhtumitest. Rahuldamata nõuete eraldise suuruse arvutamisel võetakse arvesse võlgniku muid tagatisi. Rahuldamata nõuete eraldist ei vähendata võimalike regressinõuete võrra. (2) Kehtivate tagatiste rahuldamata nõuete eraldise suurus leitakse järgmiste osade summana: 1) käsitluses olevate nõuete eeldatav summa hinnatuna kahjujuhtumite (avatud kahjutoimikute) kaupa; 2) sihtasutuse poolt hüvitistaotluste käsitlemisel tehtavad kulutused, mida on võimalik ette näha. (3) Nõuded loetakse käsitluses olevateks nõueteks, kui tagatise saaja on esitanud tagatishüvitise taotluse või on teatanud laenulepingu lõpetamisest ja laenu sissenõudmisest.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_7 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_8_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tasanduseraldisse kantakse tagatislepingutest tulenevate kahjude katteks mõeldud osa tagatistasust. Tasanduseraldist vähendatakse rahuldamata nõuete eraldisse arvestatud ja välja makstud kahjude võrra. (2) Tasanduseraldise minimaalne suurus on 1% sihtasutuse kõigist tasanduseraldise arvutamise kuupäeval kehtivatest laenude tagamise lepingutest ja kehtivatest tagatispakkumustest tulenevatest kohustustest. Tasanduseraldise minimaalse suuruse arvutamisel ei võeta arvesse lepinguid, mille kohta on moodustatud rahuldamata nõuete eraldis. (3) Lõikes 2 nimetatud tagatispakkumustest, mis ei ole lepinguna sõlmitud, võetakse kohustuste arvutamisel arvesse 70%.",
      "rdfs:label": {
        "@value": "Reg_158678_Par_8 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158678_Par_9_v158678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158678_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vabariigi Valitsuse 10. juuni 2003. a määrus nr 168 «Laenude riikliku tagamise tehniliste eraldiste arvutamise kord» (RT I 2003, 46, 323) tunnistatakse kehtetuks. Peaminister Andrus ANSIP Majandus- ja kommunikatsiooniminister Edgar SAVISAAR Riigisekretär Heiki LOOT",
      "rdfs:label": {
        "@value": "Reg_158678_Par_9 (redaktsioon 158678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158678",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158678",
      "estleg:sourceAct": "Laenude riikliku tagamise tehniliste eraldiste moodustamise põhimõtted ja arvutamise kord",
      "estleg:provisionRef": "Reg_158678 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158678_Map_2026"
      }
    },
