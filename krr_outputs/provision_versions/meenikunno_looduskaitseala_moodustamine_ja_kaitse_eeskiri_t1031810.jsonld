    {
      "@id": "estleg:Reg_1031810_Par_14_v1031810",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1031810_Par_14"
