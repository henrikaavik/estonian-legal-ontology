      }
    },
    {
      "@id": "estleg:Reg_1043880_Par_8_v1043880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043880_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Teenuseosutaja põhitegevust toetavate teenuste sisseostmine (edaspidi teenuse sisseostmine) on olukord, kus hädaolukorra seaduse § 39 lõike 5 alusel kehtestatud määruse kohaselt väljaselgitatud kriitilist tegevust või selle osa täidab väline teenuseosutaja. Teenuseosutaja põhitegevust toetavate teenuste sisseostmine (edaspidi teenuse sisseostmine) on olukord, kus hädaolukorra seaduse § 39 lõike 5 alusel kehtestatud määruse kohaselt väljaselgitatud kriitilist tegevust või selle osa täidab väline teenuseosutaja. 2 (2) Teenuseosutaja ei vabane teenuse sisseostmisel kohustustest ja vastutusest, mis on talle pandud hädaolukorra seadusega ja selle alusel kehtestatud õigusaktidega. Teenuseosutaja ei vabane teenuse sisseostmisel kohustustest ja vastutusest, mis on talle pandud hädaolukorra seadusega ja selle alusel kehtestatud õigusaktidega. 3 (3) Hädaolukorra seaduse § 36 lõike 1 punktides 5, 6 ja 7 ja § 36 lõike 11 punktides 1 ja 3 nimetatud teenuseid sisse ostes ei tohi elutähtsa teenuse osutamine sõltuda ettevõtetest, kes ei ole elutähtsa teenuse osutajad. RT I 2024-06-28 1 128062024001 2025-01-01 Hädaolukorra seaduse § 36 lõike 1 punktides 5, 6 ja 7 ja § 36 lõike 11 punktides 1 ja 3 nimetatud teenuseid sisse ostes ei tohi elutähtsa teenuse osutamine sõltuda ettevõtetest, kes ei ole elutähtsa teenuse osutajad. 4 (4) Kui sisse ostetakse hädaolukorra seaduse § 39 lõike 5 alusel kehtestatud määruse järgi kriitiline tegevus, mille kriitilisuse aste on 16 või suurem, peab sisseostetava teenuse osutaja täitma küberturvalisuse seaduse § 7 alusel kehtestatud turvameetmeid. Kui sisse ostetakse hädaolukorra seaduse § 39 lõike 5 alusel kehtestatud määruse järgi kriitiline tegevus, mille kriitilisuse aste on 16 või suurem, peab sisseostetava teenuse osutaja täitma küberturvalisuse seaduse § 7 alusel kehtestatud turvameetmeid.",
      "rdfs:label": {
        "@value": "Reg_1043880_Par_8 (redaktsioon 1043880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043880",
      "estleg:sourceAct": "Makseteenuse ja sularaharingluse kirjeldus ja toimepidevuse nõuded",
      "estleg:provisionRef": "Reg_1043880 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043880_Par_9_v1043880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043880_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Elutähtsa teenuse katkestuse või katkestuse ohu korral käivitab teenuseosutaja olukorra lahendamiseks toimepidevuse plaani taastekavas kirjeldatud tegevused ning kaasab neisse tegevustesse elutähtsa teenuse taastamise ja kasutamisega seotud asutused ja isikud. Elutähtsa teenuse katkestuse või katkestuse ohu korral käivitab teenuseosutaja olukorra lahendamiseks toimepidevuse plaani taastekavas kirjeldatud tegevused ning kaasab neisse tegevustesse elutähtsa teenuse taastamise ja kasutamisega seotud asutused ja isikud. 2 (2) Kui võimalik, lähtub teenuseosutaja elutähtsa teenuse taastamisel järgmistest eesmärkidest: 1 1) elutähtis teenus taastatakse esmalt suurema asustustihedusega piirkondades; 2 2) elutähtis teenus tehakse kättesaadavaks esmajärjekorras teistele elutähtsa teenuste osutajatele. Kui võimalik, lähtub teenuseosutaja elutähtsa teenuse taastamisel järgmistest eesmärkidest: elutähtis teenus taastatakse esmalt suurema asustustihedusega piirkondades; elutähtis teenus tehakse kättesaadavaks esmajärjekorras teistele elutähtsa teenuste osutajatele.",
      "rdfs:label": {
        "@value": "Reg_1043880_Par_9 (redaktsioon 1043880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043880",
