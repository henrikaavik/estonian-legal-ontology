      "estleg:provisionRef": "Reg_1043880 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043880_Par_3_v1043880",
      "@type": [
        "owl:NamedIndividual",
