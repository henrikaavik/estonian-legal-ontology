      },
      "estleg:versionText": "Elutähtsad makseteenused on teenuseosutaja osutatavad pangasisesed maksed, teenuseosutajate vahelised maksed ja teenuseosutaja osutatavad kaardimaksed. Elutähtsad makseteenused on teenuseosutaja osutatavad pangasisesed maksed, teenuseosutajate vahelised maksed ja teenuseosutaja osutatavad kaardimaksed.",
      "rdfs:label": {
        "@value": "Reg_1043880_Par_3 (redaktsioon 1043880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043880",
      "estleg:sourceAct": "Makseteenuse ja sularaharingluse kirjeldus ja toimepidevuse nõuded",
      "estleg:provisionRef": "Reg_1043880 § 3",
      "estleg:partOfAct": {
