      }
    },
    {
      "@id": "estleg:Reg_1043880_Par_4_v1043880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043880_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sularaharinglus kui elutähtis teenus on teenuseosutaja osutatav teenus, mida kasutades saavad kliendid maksekontole sularaha sisse maksta ja maksekontolt sularaha välja võtta. Sularaharinglus kui elutähtis teenus on teenuseosutaja osutatav teenus, mida kasutades saavad kliendid maksekontole sularaha sisse maksta ja maksekontolt sularaha välja võtta.",
      "rdfs:label": {
        "@value": "Reg_1043880_Par_4 (redaktsioon 1043880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043880",
      "estleg:sourceAct": "Makseteenuse ja sularaharingluse kirjeldus ja toimepidevuse nõuded",
      "estleg:provisionRef": "Reg_1043880 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043880_Par_5_v1043880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043880_Par_5"
      },
