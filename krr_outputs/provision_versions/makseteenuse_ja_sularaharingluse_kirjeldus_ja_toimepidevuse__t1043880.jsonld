      "estleg:sourceAct": "Makseteenuse ja sularaharingluse kirjeldus ja toimepidevuse nõuded",
      "estleg:provisionRef": "Reg_1043880 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043880_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1043880_Par_7_v1043880",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043880_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elutähtsa teenuse katkestuse lubatud aeg on kuni 12 tundi. RT I2026-02-1211120220260012026-02-15 Elutähtsa teenuse katkestuse lubatud aeg on kuni 12 tundi.",
      "rdfs:label": {
        "@value": "Reg_1043880_Par_7 (redaktsioon 1043880)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043880",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043880",
      "estleg:sourceAct": "Makseteenuse ja sularaharingluse kirjeldus ja toimepidevuse nõuded",
      "estleg:provisionRef": "Reg_1043880 § 7",
      "estleg:partOfAct": {
