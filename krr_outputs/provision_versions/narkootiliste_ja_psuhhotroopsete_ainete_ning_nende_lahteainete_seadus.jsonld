      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku ja haldusjärelevalvet Euroopa Liidus lähteainete kaubandust reguleerivate vahetult kohalduvate õigusaktide ning käesoleva seaduse ja selle alusel kehtestatud õigusaktide täitmise üle teostavad vastavalt oma pädevusele Ravimiamet ning Maksu- ja Tolliamet.",
      "rdfs:label": {
        "@value": "NPALS_Par_12_1 (redaktsioon 109052014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014004",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_12_1_v102012025041"
      },
      "estleg:versionValidTo": {
        "@value": "2025-01-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052014004",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 12_1",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_12_1_v102012025041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_12_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Riiklikku ja haldusjärelevalvet Euroopa Liidus lähteainete kaubandust reguleerivate vahetult kohalduvate õigusaktide ning käesoleva seaduse ja selle alusel kehtestatud õigusaktide täitmise üle teostavad vastavalt oma pädevusele Ravimiamet, Politsei- ja Piirivalveamet ning Maksu- ja Tolliamet.",
      "rdfs:label": {
        "@value": "NPALS_Par_12_1 (redaktsioon 102012025041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102012025041",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102012025041",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 12_1",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_12_2_v109052014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_12_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Korrakaitseorgan võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30, 31, 32, 50, 51 ja 52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "NPALS_Par_12_2 (redaktsioon 109052014004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014004",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_12_2_v102012025041"
      },
      "estleg:versionValidTo": {
        "@value": "2025-01-11",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052014004",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 12_2",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_12_2_v102012025041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_12_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ravimiamet võib käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30–32 ja 50–52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras. (2) Politsei- ja Piirivalveamet ning Maksu- ja Tolliamet võivad käesolevas seaduses sätestatud riikliku järelevalve teostamiseks kohaldada korrakaitseseaduse §-des 30–32 ja 45–52 sätestatud riikliku järelevalve erimeetmeid korrakaitseseaduses sätestatud alusel ja korras.",
      "rdfs:label": {
        "@value": "NPALS_Par_12_2 (redaktsioon 102012025041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102012025041",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102012025041",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 12_2",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_12_3_v109052014004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_12_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 1600 eurot.",
      "rdfs:label": {
        "@value": "NPALS_Par_12_3 (redaktsioon 109052014004)",
