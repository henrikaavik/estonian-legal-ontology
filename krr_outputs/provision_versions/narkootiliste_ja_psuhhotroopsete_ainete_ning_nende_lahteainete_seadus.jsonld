    {
      "@id": "estleg:NPALS_Par_11_1_v12851706",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_11_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkomaaniaravi andmekogu (edaspidi andmekogu ) on Vabariigi Valitsuse poolt andmekogude seaduse (RT I 1997, 28, 423; 1998, 36/37, 552; 1999, 10, 155; 2000, 50, 317; 57, 373; 92, 597; 2001, 7, 17; 17, 77; 2002, 61, 375; 63, 387; 2003, 18, 107; 26, 158; 2004, 30, 204) ning käesoleva seaduse alusel asutatud riiklik register, mida peetakse narkomaaniaravile pöördunud isikute kohta arvestuse pidamiseks. (2) Andmekogu eesmärk on Eesti elanikel diagnoositud narkomaaniajuhtude registreerimine, andmete töötlemine narkomaaniastatistika korraldamiseks, narkomaania esinemise analüüsiks ja tervishoiukorralduseks, narkomaania preventsioonimeetmete kavandamiseks ning nende tõhususe hindamiseks. (3) Andmekogu vastutav töötleja on Sotsiaalministeerium ja volitatud töötleja on Tervise Arengu Instituut. (4) Andmekogu asutab ja põhimääruse kinnitab Vabariigi Valitsus. (5) Andmekogu peetakse kujul, mis ei võimalda registrisse kantud isikut tuvastada. (6) Psühhiaatria tegevusluba omavad tervishoiuteenuse osutajad on kohustatud psühhiaatria tervishoiuteenuse osutamise korral esitama saadud andmed andmekogule vastavalt andmekogu põhimääruses sätestatud tingimustele ja korrale.",
      "rdfs:label": {
        "@value": "NPALS_Par_11_1 (redaktsioon 12851706)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12851706",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_11_1_v12851736"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12851706",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 11_1",
