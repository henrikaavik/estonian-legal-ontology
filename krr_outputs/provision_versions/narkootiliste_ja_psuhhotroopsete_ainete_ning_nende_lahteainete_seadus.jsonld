    },
    {
      "@id": "estleg:NPALS_Par_10_3_v109052014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_10_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Volitatud töötlejad kannavad uue psühhoaktiivse aine kohta varajase hoiatuse infosüsteemi järgmised neile teadaolevad andmed: aine eesti- ja ingliskeelne nimetus ning lühend; aine kasutajate seas levinud nimetus; aine keemiline kirjeldus, olek ja välimus ning toote või preparaadi nimetus, kui aine sisaldub konkreetses tootes või preparaadis; teave aine analüüsitulemuste kohta Justiitsministeeriumilt või Justiitsministeeriumi hallatavalt riigiasutuselt; aine konfiskeerimise sagedus ja kogused ning päritolumaa; teave aine kasutajate ja kasutussituatsioonide kohta; aine tootmise viisid; aine levitamise viisid; aine manustamise viisid; aine toime inimesele; aine sõltuvuse tekitamise risk ja võrdlus ainega, mis juba on kantud käesoleva seaduse § 31 lõike 1 alusel kehtestatud nimekirja; teave aine tarvitamisega seotud võimalike tervisekahjustuste ja -riskide kohta; aine legaalne kasutus; aine illegaalne kasutus; teave aine varasema esinemise kohta Eestis; teave aine käitlemispiirangute kohta Euroopa Liidu liikmesriikides ja mujal maailmas; teave aine hinna kohta; ettepanek aine käitlemispiirangute rakendamiseks ja põhjendus.",
      "rdfs:label": {
        "@value": "NPALS_Par_10_3 (redaktsioon 109052014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_10_3_v113032019102"
      },
      "estleg:versionValidTo": {
        "@value": "2019-03-14",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052014003",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 10_3",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_10_3_v113032019102",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_10_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete esitaja esitab uue psühhoaktiivse aine kohta varajase hoiatuse infosüsteemi järgmised talle teadaolevad andmed: aine identifitseerimiseks ja teistest ainetest eristamiseks vajalikud andmed; teave aine tootmise, levitamise ja käitlemise kohta; teave aine kasutamise kohta; teave aine farmakoloogilise toime kohta; ettepanek käitlemispiirangute rakendamiseks.",
      "rdfs:label": {
        "@value": "NPALS_Par_10_3 (redaktsioon 113032019102)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032019102",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_10_3_v103022023006"
      },
      "estleg:versionValidTo": {
        "@value": "2023-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/113032019102",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 10_3",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
