    {
      "@id": "estleg:NPALS_Par_9_v12851706",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste, psühhotroopsete ja lähteainete lõpliku identifitseerimise tagab Kohtuekspertiisi ja Kriminalistika Keskus. (2) Narkootilisi, psühhotroopseid ja lähteaineid sisaldavate ravimite ja nende kõlblikkuse määramise tagab Ravimiamet. (3) Narkootiliste ja psühhotroopsete ainete lõpliku identifitseerimise inimpäritoluga bioloogilistest materjalidest tagab Eesti Kohtuarstlik Ekspertiisibüroo. (4) Kohtuekspertiisi ja Kriminalistika Keskus, Eesti Kohtuarstlik Ekspertiisibüroo ja Ravimiamet võivad tellida analüüse kodu- ja välismaistest laboratooriumidest.",
      "rdfs:label": {
        "@value": "NPALS_Par_9 (redaktsioon 12851706)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12851706",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_9_v12851752"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12851706",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_9_v12851752",
      "@type": [
        "owl:NamedIndividual",
