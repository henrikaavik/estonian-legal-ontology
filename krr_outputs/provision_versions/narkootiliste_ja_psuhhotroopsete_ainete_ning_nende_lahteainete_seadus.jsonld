      }
    },
    {
      "@id": "estleg:NPALS_Par_10_v12851706",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste ja psühhotroopsete ainete ebaseadusliku tarvitamise tõkestamist ning narkomaania leviku vähendamist korraldatakse käesoleva seaduse ja riikliku programmi alusel. Narkomaania ennetamise riikliku programmi kinnitab Vabariigi Valitsus ning seda finantseeritakse riigieelarvest. (2) Vabariigi Valitsus ja kohalikud omavalitsused soodustavad igati narkomaania leviku tõkestamist taotlevate mittetulundusühingute ja sihtasutuste tegevust. (3) Uimastiolukorra kohta olemasolevate epidemioloogiliste ja statistiliste andmete kogumise, analüüsi ning narkomaania leviku hindamisega tegeleb Tervise Arengu Instituudi koosseisu kuuluv Eesti Uimastiseire Keskus.",
      "rdfs:label": {
        "@value": "NPALS_Par_10 (redaktsioon 12851706)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12851706",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_10_v109052014003"
      },
      "estleg:versionValidTo": {
        "@value": "2014-05-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12851706",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_10_v109052014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste ja psühhotroopsete ainete ebaseadusliku tarvitamise tõkestamist ning narkomaania leviku vähendamist korraldatakse käesoleva seaduse ja Vabariigi Valitsuse kinnitatava vastavat valdkonda hõlmava strateegilise arengukava alusel. (2) Vabariigi Valitsus ja kohalikud omavalitsused soodustavad igati narkomaania leviku tõkestamist taotlevate mittetulundusühingute ja sihtasutuste tegevust. (3) Uimastiolukorra kohta olemasolevate epidemioloogiliste ja statistiliste andmete kogumise ja analüüsimise ning narkomaania leviku hindamisega tegeleb Sotsiaalministeerium või Sotsiaalministeeriumi hallatav riigi teadus- ja arendusasutus.",
      "rdfs:label": {
        "@value": "NPALS_Par_10 (redaktsioon 109052014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "109052014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_10_v106082022028"
      },
      "estleg:versionValidTo": {
        "@value": "2022-08-15",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/109052014003",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_10_v106082022028",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootiliste ja psühhotroopsete ainete ebaseadusliku tarvitamise tõkestamist ning narkomaania leviku vähendamist korraldatakse korrakaitseseaduse §-s 20 nimetatud ennetusnõukogu koordineerimisel ning käesoleva seaduse ja Vabariigi Valitsuse kinnitatava vastavat valdkonda hõlmava strateegilise arengukava alusel. (2) Vabariigi Valitsus ja kohalikud omavalitsused soodustavad igati narkomaania leviku tõkestamist taotlevate mittetulundusühingute ja sihtasutuste tegevust. (3) Uimastiolukorra kohta olemasolevate epidemioloogiliste ja statistiliste andmete kogumise ja analüüsimise ning narkomaania leviku hindamisega tegeleb Sotsiaalministeerium või Sotsiaalministeeriumi hallatav riigi teadus- ja arendusasutus.",
      "rdfs:label": {
        "@value": "NPALS_Par_10 (redaktsioon 106082022028)",
        "@language": "et"
      },
