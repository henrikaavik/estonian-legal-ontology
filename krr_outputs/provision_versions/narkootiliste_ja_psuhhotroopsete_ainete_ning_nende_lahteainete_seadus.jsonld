      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadus jõustub 1997. aasta 1. novembril. (2) Käesoleva seaduse § 3 1 lõige 3 jõustub 2005. aasta 1. juulil. (3) Käesoleva seaduse § 8 tunnistatakse kehtetuks alates 2005. aasta 1. juulist. (4) Käesoleva seaduse § 11 1 jõustub 2006. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "NPALS_Par_19 (redaktsioon 12851706)",
        "@language": "et"
