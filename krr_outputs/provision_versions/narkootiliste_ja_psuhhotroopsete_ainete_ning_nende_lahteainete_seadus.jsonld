    {
      "@id": "estleg:NPALS_Par_15_1_v112072014103",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_15_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine arsti ettekirjutuseta tarvitamise või väikeses koguses ebaseadusliku valmistamise, omandamise või valdamise eest –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "NPALS_Par_15_1 (redaktsioon 112072014103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112072014103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112072014103",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 15_1",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_15_2_v12851706",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_15_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine või nende lähteaine valmistamise, tootmise, töötlemise, pakkimise, säilitamise, veo, impordi, ekspordi, transiidi, üleandmise või arvestuse ja aruandluse nõuete rikkumise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, – karistatakse rahatrahviga kuni 50 000 krooni.",
      "rdfs:label": {
        "@value": "NPALS_Par_15_2 (redaktsioon 12851706)",
        "@language": "et"
      },
