        "@value": "2023-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105032013002",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 3",
