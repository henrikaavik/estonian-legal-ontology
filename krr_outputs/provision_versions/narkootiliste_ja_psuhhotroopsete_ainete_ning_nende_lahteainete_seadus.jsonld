      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 15_2",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_15_2_v117022011005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_15_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Narkootilise või psühhotroopse aine või nende lähteaine valmistamise, tootmise, töötlemise, pakkimise, säilitamise, veo, impordi, ekspordi, transiidi, üleandmise või arvestuse ja aruandluse nõuete rikkumise eest – karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "NPALS_Par_15_2 (redaktsioon 117022011005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117022011005",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_15_2_v112072014103"
      },
      "estleg:versionValidTo": {
        "@value": "2014-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117022011005",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 15_2",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
