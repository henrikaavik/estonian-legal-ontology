      }
    },
    {
      "@id": "estleg:NPALS_Par_18_1_v12851706",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:NPALS_Par_18_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-05-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne 2004. aasta 1. maid väljaantud lähteainete käitlemise registreerimistunnistused ning impordi- ja ekspordiload kehtivad kuni 2005. aasta 1. maini, kuid mitte kauem nendele märgitud kehtivusajast.",
      "rdfs:label": {
        "@value": "NPALS_Par_18_1 (redaktsioon 12851706)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12851706",
      "estleg:supersededByVersion": {
        "@id": "estleg:NPALS_Par_18_1_v101122015004"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-10",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12851706",
      "estleg:sourceAct": "Narkootiliste ja psühhotroopsete ainete ning nende lähteainete seadus",
      "estleg:provisionRef": "NPALS § 18_1",
      "estleg:partOfAct": {
        "@id": "estleg:NPALS_Map"
      }
    },
    {
      "@id": "estleg:NPALS_Par_18_1_v101122015004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
