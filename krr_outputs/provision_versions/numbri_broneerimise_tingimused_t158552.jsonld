      },
      "estleg:versionText": "Määruses sätestatakse numbri broneerimise tingimused. Määruses sätestatakse numbri broneerimise tingimused.",
      "rdfs:label": {
        "@value": "Reg_158552_Par_1 (redaktsioon 158552)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158552",
