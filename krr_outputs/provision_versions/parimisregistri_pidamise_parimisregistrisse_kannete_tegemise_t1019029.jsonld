      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui pärimisregistrisse kantava isiku kohta ei ole teada Eesti isikukoodi, kantakse pärimisregistrisse tema sünniaeg ja võimaluse korral sünnikoht. Kui pärimisregistrisse kantava isiku kohta ei ole teada Eesti isikukoodi, kantakse pärimisregistrisse tema sünniaeg ja võimaluse korral sünnikoht.",
      "rdfs:label": {
        "@value": "Reg_1019029_Par_17 (redaktsioon 1019029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1019029",
      "estleg:sourceAct": "Pärimisregistri pidamise, pärimisregistrisse kannete tegemise ja pärimisregistrist teabe väljastamise kord",
      "estleg:provisionRef": "Reg_1019029 § 17",
      "estleg:partOfAct": {
