        "@type": "xsd:date"
      },
      "estleg:versionText": "Pärimisregister koosneb arhiivist ja käesolevas määruses sätestatud pärimisregistrisse kantavatest andmetest. RT I 2015-03-06 36 106032015036 2015-03-09 Pärimisregister koosneb arhiivist ja käesolevas määruses sätestatud pärimisregistrisse kantavatest andmetest.",
      "rdfs:label": {
        "@value": "Reg_1019029_Par_5 (redaktsioon 1019029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1019029",
