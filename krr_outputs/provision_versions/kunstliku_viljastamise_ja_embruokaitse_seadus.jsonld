        "@value": "2018-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehavälise viljastamise ja embrüo siirdamise tervishoiuteenused ning nendega seonduvad ravimikulud hüvitatakse ravikindlustuse seaduses sätestatud tingimustel ja korras.",
      "rdfs:label": {
        "@value": "KVEKS_Par_35_1 (redaktsioon 128122017035)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "128122017035"
    },
    {
      "@id": "estleg:KVEKS_Par_36_v25334",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KVEKS_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalkoodeksis (RT 1992, 20, 288; RT I 1997, 21/22, 353; 28, 423; 30, 472; 34, 535) tehakse järgmised muudatused ja täiendused: koodeksit täiendatakse §-dega 1201 ja 1202 järgmises sõnastuses: «§ 1201. Võõra munaraku või sellest loodud embrüo ülekandmine naisele Võõra munaraku või sellest loodud embrüo ülekandmise eest naisele kunstliku viljastamise ja embrüokaitse seadust rikkudes, samuti võõra munaraku või sellest valmistatud embrüo ülekandmise eraviisilise vahendamise eest -- karistatakse rahatrahvi või teataval ametikohal töötamise või teataval tegevusalal tegutsemise õiguse äravõtmisega.",
      "rdfs:label": {
        "@value": "KVEKS_Par_36 (redaktsioon 25334)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25334",
      "estleg:supersededByVersion": {
        "@id": "estleg:KVEKS_Par_36_v261097"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-06",
        "@type": "xsd:date"
      }
    },
