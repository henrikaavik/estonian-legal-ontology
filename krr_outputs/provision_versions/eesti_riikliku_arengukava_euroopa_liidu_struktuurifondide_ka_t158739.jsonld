    {
      "@id": "estleg:Reg_158739_Par_7_v158739",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158739_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-10-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud:11)vastama taotleja, partnerite ja taotluse kohta sihtasutuse poolt esitatud küsimustele;22)võimaldama sihtasutusel kontrollida taotleja ja partnerite vastavust taotlejale esitatavatele nõuetele, teostada taotluse nõuetele vastavuse kontrolli, kohapealset kontrolli ning esitatud andmete õigsuse kontrolli;33)esitama sihtasutusele tähtaegselt ettenähtud vormil ja viisil nõutud informatsiooni;44)informeerima sihtasutust viivitamatult kirjalikult kõigist esitatud andmetes toimunud muudatustest või asjaoludest, mis mõjutavad või võivad mõjutada toetuse saaja poolt oma kohustuste täitmist, sealhulgas nime ja aadressi muutumisest, ümberkujundamisest, tegevuse lõpetamisest ka siis, kui eelnimetatud muudatused on avalikustatud massiteabevahendite kaudu;55)täitma teisi õigusaktides sätestatud kohustusi ja esitama sihtasutusele informatsiooni, mis võib mõjutada taotluse kohta otsuse tegemist. Taotleja on kohustatud: vastama taotleja, partnerite ja taotluse kohta sihtasutuse poolt esitatud küsimustele; võimaldama sihtasutusel kontrollida taotleja ja partnerite vastavust taotlejale esitatavatele nõuetele, teostada taotluse nõuetele vastavuse kontrolli, kohapealset kontrolli ning esitatud andmete õigsuse kontrolli; esitama sihtasutusele tähtaegselt ettenähtud vormil ja viisil nõutud informatsiooni; informeerima sihtasutust viivitamatult kirjalikult kõigist esitatud andmetes toimunud muudatustest või asjaoludest, mis mõjutavad või võivad mõjutada toetuse saaja poolt oma kohustuste täitmist, sealhulgas nime ja aadressi muutumisest, ümberkujundamisest, tegevuse lõpetamisest ka siis, kui eelnimetatud muudatused on avalikustatud massiteabevahendite kaudu; täitma teisi õigusaktides sätestatud kohustusi ja esitama sihtasutusele informatsiooni, mis võib mõjutada taotluse kohta otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_158739_Par_7 (redaktsioon 158739)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158739",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158739",
      "estleg:sourceAct": "\"Eesti riikliku arengukava Euroopa Liidu struktuurifondide kasutuselevõtuks - ühtne programmdokument aastateks 2004-2006\" meetme 2.3 \"Teadus- ja arendustegevuse ning innovatsiooni edendamine\" osa \"Teaduse tippkeskuste programm\" rakendamiseks struktuuritoetuse andmise tingimused",
      "estleg:provisionRef": "Reg_158739 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158739_Map"
      }
