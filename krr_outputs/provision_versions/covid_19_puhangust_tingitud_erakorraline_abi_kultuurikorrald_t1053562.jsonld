    {
      "@id": "estleg:Reg_1053562_Par_2_v1053562",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053562_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-02-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Toetuse andmise eesmärk on COVID-19 puhangust oluliselt mõjutatud kultuurikorraldaja majandusliku jätkusuutlikkuse tagamine. Toetuse andmise eesmärk on COVID-19 puhangust oluliselt mõjutatud kultuurikorraldaja majandusliku jätkusuutlikkuse tagamine. 2 (2) Toetuse andmise tulemusena on kultuurikorraldaja majanduslik jätkusuutlikkus tagatud. Toetuse andmise tulemusena on kultuurikorraldaja majanduslik jätkusuutlikkus tagatud.",
      "rdfs:label": {
        "@value": "Reg_1053562_Par_2 (redaktsioon 1053562)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053562",
