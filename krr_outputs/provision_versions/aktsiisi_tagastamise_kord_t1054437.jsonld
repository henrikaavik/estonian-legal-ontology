      },
      "estleg:versionText": "Taotlus aktsiisi tagastamiseks esitatakse aktsiisi tagastamise taotluse (edaspidi taotlus) vormil (lisatud). Taotlus aktsiisi tagastamiseks esitatakse aktsiisi tagastamise taotluse (edaspidi taotlus) vormil (lisatud).",
      "rdfs:label": {
        "@value": "Reg_1054437_Par_2 (redaktsioon 1054437)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054437",
