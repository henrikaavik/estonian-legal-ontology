        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustusandja poolt käesoleva seaduse § 131 lõikes 2 sätestatud nõude arvestamata jätmise eest – karistatakse rahatrahviga kuni 500 000 krooni.",
      "rdfs:label": {
        "@value": "KINDLU_Par_204 (redaktsioon 13199184)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13199184",
