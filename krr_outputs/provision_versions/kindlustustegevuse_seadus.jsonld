      }
    },
    {
      "@id": "estleg:KINDLU_Par_263_2_v103122024009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_263_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2019/1238 artikli 5 lõikes 1 ning artiklites 6, 7, 18–47, 50 ja 52–56 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 700 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kümme protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "KINDLU_Par_263_2 (redaktsioon 103122024009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "103122024009"
    },
    {
      "@id": "estleg:KINDLU_Par_263_3_v117032023011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_263_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud juriidilise isiku käive on aastane kogukäive vastavalt viimasele kättesaadavale juhtimisorgani kinnitatud raamatupidamise aruandele. Kui juriidiline isik on emaettevõtja või sellise emaettevõtja tütarettevõtja, kes peab koostama konsolideeritud finantsaruandeid, siis on käesoleva lõike esimeses lauses nimetatud kogukäive aastane kogukäive või vastav tululiik viimase kättesaadava konsolideeritud raamatupidamise aruande järgi, mille on heaks kiitnud kõrgeima taseme emaettevõtja juhtimisorgan.",
      "rdfs:label": {
        "@value": "KINDLU_Par_263_3 (redaktsioon 117032023011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023011",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_263_3_v111102024009"
      },
      "estleg:versionValidTo": {
        "@value": "2024-10-20",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_263_3_v111102024009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_263_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-10-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas peatükis sätestatud juriidilise isiku käive on aastane kogukäive vastavalt viimasele kättesaadavale juhtimisorgani kinnitatud raamatupidamise aruandele. Kui juriidiline isik on emaettevõtja või sellise emaettevõtja tütarettevõtja, kes peab koostama konsolideeritud finantsaruandeid, siis on eelmises lauses nimetatud kogukäive aastane kogukäive või vastav tululiik viimase kättesaadava konsolideeritud raamatupidamise aruande järgi, mille on heaks kiitnud kõrgeima taseme emaettevõtja juhtimisorgan.",
      "rdfs:label": {
        "@value": "KINDLU_Par_263_3 (redaktsioon 111102024009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111102024009"
    },
