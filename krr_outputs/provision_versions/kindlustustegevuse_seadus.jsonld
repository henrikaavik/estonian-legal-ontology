    {
      "@id": "estleg:KINDLU_Par_249_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_249"
