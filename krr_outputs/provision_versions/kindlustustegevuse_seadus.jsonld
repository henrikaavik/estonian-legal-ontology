      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 199–207 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesolevas seaduses sätestatud väärtegude kohtuväline menetleja on Finantsinspektsioon.",
      "rdfs:label": {
        "@value": "KINDLU_Par_208 (redaktsioon 12894043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894043",
