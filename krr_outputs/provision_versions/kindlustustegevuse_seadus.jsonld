    },
    {
      "@id": "estleg:KINDLU_Par_170_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_170"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja pankrotitoimkonnas on viis liiget, kellest kolm nimetab Finantsinspektsioon. (2) Kindlustusandja pankrotimenetluses ei kohaldata pankrotiseaduse § 74 lõikes 7 sätestatut.",
      "rdfs:label": {
        "@value": "KINDLU_Par_170 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_171_v831362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_171"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Selgituste andmiseks kohustatud isik võib keelduda Finantsinspektsioonile selgituse andmisest kriminaalmenetluse seadustiku (RT I 2003, 27, 166; 2004, 65, 456) §-s 71 või 73 sätestatud alustel.",
      "rdfs:label": {
        "@value": "KINDLU_Par_171 (redaktsioon 831362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "831362",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_171_v12894043"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_171_v12894043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_171"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Selgituste andmiseks kohustatud isik võib keelduda Finantsinspektsioonile selgituse andmisest kriminaalmenetluse seadustiku §-s 71 või 73 sätestatud alustel.",
      "rdfs:label": {
        "@value": "KINDLU_Par_171 (redaktsioon 12894043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894043",
      "estleg:supersededByVersion": {
