      }
    },
    {
      "@id": "estleg:KINDLU_Par_263_1_v117032023011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_263_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-11-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Euroopa Parlamendi ja nõukogu määruse (EL) 2020/852, millega kehtestatakse kestlike investeeringute hõlbustamise raamistik ja muudetakse määrust (EL) 2019/2088 (ELT L 198, 22.06.2020, lk 13–43), artiklites 5–7 sätestatud nõuete rikkumise eest –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 5 000 000 eurot või kuni kahekordses väärteo tulemusel teenitud kasule või ära hoitud kahjule vastavas summas või kuni kümme protsenti juriidilise isiku või tema konsolideerimisgrupi konsolideeritud käibest.",
      "rdfs:label": {
        "@value": "KINDLU_Par_263_1 (redaktsioon 117032023011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032023011"
    },
    {
      "@id": "estleg:KINDLU_Par_263_2_v117032023010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
