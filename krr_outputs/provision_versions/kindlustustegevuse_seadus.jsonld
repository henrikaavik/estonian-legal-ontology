      }
    },
    {
      "@id": "estleg:KINDLU_Par_27_v111042014003",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib tegevusloa täielikult või üksikute kindlustustegevuste liikide või alaliikide osas kehtetuks tunnistada, kui ilmneb, et: kindlustusandja ei ole alustanud kindlustustegevuse liigi või alaliigiga tegelemist 12 kuu jooksul, arvates tegevusloa või täiendava tegevusloa andmisest, või kindlustusandja tegevus on peatunud kauemaks kui kuueks järjestikuseks kuuks; kindlustusandja on esitanud või tegevusloa taotlemisel on esitatud Finantsinspektsioonile eksitavaid andmeid või dokumente või valeandmeid või -dokumente; kindlustusandja ei vasta kehtivatele tegevusloa andmise tingimustele; ilmnevad käesoleva seaduse § 23 lõike 1 punktis 3 või 4 sätestatud asjaolud; kindlustusandja ei ole järginud käesoleva seaduse § 22 lõikes 3 nimetatud kõrvaltingimusi; kindlustusandja on korduvalt või olulisel määral rikkunud tema tegevust reguleerivates õigusaktides sätestatut, kindlustusandjale on kohaldatud karistust majandusalase, ametialase, varavastase või avaliku usalduse vastase süüteo eest ning karistusandmed ei ole karistusregistri seaduse kohaselt karistusregistrist kustutatud või kindlustusandja tegevus või tegevusetus ei vasta avalikule huvile; kindlustusandja avaldab oma tegevuse või juhtorgani liikme kohta oluliselt ebaõigeid või eksitavaid andmeid või oluliselt ebaõiget või eksitavat reklaami; kindlustusandja kuulub konsolideerimisgruppi, mille struktuur ei võimalda saada konsolideeritud järelevalveks vajalikku teavet või kindlustusandjaga samasse konsolideerimisgruppi kuuluv äriühing tegutseb välisriigi õigusaktide alusel ja seetõttu on piisava järelevalve teostamine takistatud; kindlustusandja on toime pannud rahapesu või rikub õigusaktiga kehtestatud rahapesu ning terrorismi rahastamise tõkestamise korda; lepinguriigi finantsjärelevalve asutuse poolt Finantsinspektsioonile esitatud teabe kohaselt on kindlustusandja rikkunud lepinguriigi õigusaktis sätestatut või käesoleva seaduse § 35 lõike 6 kohaseid lepinguriigi finantsjärelevalve asutuse esitatud tingimusi; kindlustusandja ei ole võimeline täitma endale võetud kohustusi või tema tegevus muul põhjusel kahjustab oluliselt kindlustusvõtjate, kindlustatute või soodustatud isikute huve; kindlustusandja omavahendite suurus ei vasta käesoleva seaduse nõuetele; kindlustusandja kindlustustehnilised eraldised ja finantskohustused või seotud vara ei vasta käesoleva seaduse nõuetele; kohustusliku liikluskindlustusega tegelev kindlustusandja ei täida liikluskindlustuse fondi liikmesusest tulenevaid kohustusi; kindlustusandja, kes sõlmib pensionilepinguid, ei ole ettenähtud tähtajal või täies ulatuses tasunud Tagatisfondi seaduse kohaseid pensionilepingute osafondi makseid; kindlustusandja ei ole täies ulatuses või tähtaegselt täitnud Finantsinspektsiooni ettekirjutust.",
      "rdfs:label": {
        "@value": "KINDLU_Par_27 (redaktsioon 111042014003)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "111042014003",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_27_v107072015001"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_27_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsioon võib oma ettekirjutusega keelata kindlustusandjal tegutsemise lepinguriigis asutatud filiaali kaudu, kui: esineb käesoleva seaduse § 26 lõikes 2 nimetatud asjaolu; filiaali asukoha lepinguriigi finantsjärelevalve asutus on Finantsinspektsiooni teavitanud kindlustusandja poolt lepinguriigi õigusakti või käesoleva seaduse § 26 lõike 5 alusel lepinguriigi finantsjärelevalve asutuse esitatud kindlustustegevusega tegelemise tingimuste rikkumisest.",
      "rdfs:label": {
        "@value": "KINDLU_Par_27 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_270_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_270"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustusandja suhtes, kes on investeerinud enne 2011. aasta 1. jaanuari väärtpaberiteks või teisteks finantsinstrumentideks struktureeritud laenudesse, kohaldatakse käesoleva seaduse § 52 lõiget 10 juhul, kui 2014. aasta 31. detsembri seisuga on lisandunud uusi alusvarast tulenevaid riske.",
      "rdfs:label": {
        "@value": "KINDLU_Par_270 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_270_v104122019007"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_270_v104122019007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_270"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-12-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "KINDLU_Par_270 (redaktsioon 104122019007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "104122019007"
    },
    {
      "@id": "estleg:KINDLU_Par_271_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_271"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui kindlustusandja kasutab solventsuskapitalinõude arvutamisel sisemudelit, võib Finantsinspektsioon nõuda, et kindlustusandja kohaldaks kuni 2017. aasta 31. detsembrini miinimumkapitalinõude arvutamisel käesoleva seaduse § 82 lõikes 8 sätestatud protsendimäärasid standardvalemi alusel leitud solventsuskapitalinõude suhtes. (2) Kuni 2017. aasta 31. detsembrini kasutatakse liikmesriikide keskvalitsuste või keskpankade vastu esitatud selliste nõuete puhul, mis on nomineeritud või väljastatud mis tahes muu liikmesriigi valuutas, standardvalemi kohaselt kontsentratsiooniriski alammoodulis ja hinnavaheriski alammoodulis kasutatavate standardnäitajatena samu näitajaid, mida kasutatakse selliste nõuete puhul, mis on nomineeritud ja väljastatud samas valuutas. (3) 2018. aastal vähendatakse liikmesriikide keskvalitsuste või keskpankade vastu esitatud selliste nõuete puhul, mis on nomineeritud või väljastatud mis tahes muu liikmesriigi valuutas, standardvalemi kohaselt kontsentratsiooniriski alammoodulis ja hinnavaheriski alammoodulis kasutatavaid standardnäitajaid 80 protsenti. (4) 2019. aastal vähendatakse liikmesriikide keskvalitsuste või keskpankade vastu esitatud selliste nõuete puhul, mis on nomineeritud või väljastatud mis tahes muu liikmesriigi valuutas, standardvalemi kohaselt kontsentratsiooniriski alammoodulis ja hinnavaheriski alammoodulis kasutatavaid standardnäitajaid 50 protsenti. (5) 2020. aastal ja hiljem liikmesriikide keskvalitsuste või keskpankade vastu esitatud nõuete puhul standardparameetreid ei vähendata. (6) Kui kindlustusandja omavahendite suurus vastab omavahendite normatiivile enne käesoleva seaduse jõustumist kehtinud kindlustustegevuse seaduse kohaselt, kuid ei vasta käesolevas seaduses sätestatud solventsuskapitalinõudele 2016. aastal, nõuab Finantsinspektsioon kindlustusandjalt kõikide vajalike meetmete rakendamist, et saavutada solventsuskapitalinõude täitmiseks vajalike nõuetekohaste omavahendite tase või muuta oma riskiprofiili, et tagada solventsuskapitalinõude täitmine 2017. aasta 31. detsembriks. (7) Käesoleva paragrahvi lõikes 6 sätestatud juhul peab kindlustusandja iga kolme kuu järel esitama Finantsinspektsioonile ülevaate samas lõikes sätestatud eesmärgi saavutamiseks rakendavatest meetmetest ja tehtud edusammudest. (8) Kui Finantsinspektsioon tuvastab esitatud ülevaate põhjal, et kindlustusandja ei ole teinud solventsuskapitalinõude mittetäitmise tuvastamise ja ülevaate esitamise vahelisel ajavahemikul olulisi edusamme, ei kohaldata kindlustusandjale käesoleva paragrahvi lõiget 6. (9) Kindlustusandja võib kooskõlas komisjoni delegeeritud määruse (EL) nr 2015/35 artikliga 173 kasutada aktsiariski kapitalinõude arvutamisel standardparameetrit, mis tuleb leida järgmiste suuruste kaalutud keskmisena: standardparameeter vastavalt komisjoni delegeeritud määruse (EL) nr 2015/35 artiklile 170; standardparameeter vastavalt komisjoni delegeeritud määruse (EL) nr 2015/35 artiklile 169. (10) Käesoleva paragrahvi lõike 9 punktis 2 nimetatud standardparameetri osakaal suureneb vähemalt lineaarselt iga aasta lõpus, olles 2016. aastal null protsenti ja 2023. aastal 100 protsenti.",
      "rdfs:label": {
        "@value": "KINDLU_Par_271 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_272_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_272"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-e 267 ja 268, § 269 lõikeid 2 ja 3, § 270 ning § 271 lõikeid 2–5 kohaldatakse kindlustusgrupi tasandil. (2) Käesoleva seaduse § 271 lõikeid 6–8 kohaldatakse kindlustusgrupi tasandil, kui kindlustusgrupi omavahendite suurus vastab enne käesoleva seaduse jõustumist kehtinud kindlustustegevuse seaduse kohastele konsolideeritud omavahenditele, kuid ei vasta käesolevas seaduses sätestatud kindlustusgrupi solventsuskapitalinõudele.",
      "rdfs:label": {
        "@value": "KINDLU_Par_272 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_273_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_273"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja esitab Finantsinspektsioonile käesoleva seaduse § 123 lõikes 2 nimetatud regulaarsed järelevalvelised aruanded: 2016. aasta kohta 20 nädala jooksul pärast majandusaasta lõppu ja 2016. aasta kvartaliaruanded 8 nädala jooksul pärast kvartali lõppu; 2017. aasta kohta 18 nädala jooksul pärast majandusaasta lõppu ja 2017. aasta kvartaliaruanded 7 nädala jooksul pärast kvartali lõppu; 2018. aasta kohta 16 nädala jooksul pärast majandusaasta lõppu ja 2018. aasta kvartaliaruanded 6 nädala jooksul pärast kvartali lõppu. (2) Kindlustusandja avalikustab käesoleva seaduse § 123 lõikes 1 nimetatud solventsuse ja finantsseisundi aruande: 2016. aasta kohta 20 nädala jooksul pärast majandusaasta lõppu; 2017. aasta kohta 18 nädala jooksul pärast majandusaasta lõppu; 2018. aasta kohta 16 nädala jooksul pärast majandusaasta lõppu. (3) Kindlustusgrupi juhtiv ettevõtja esitab kindlustusgrupi järelevalve teostajale käesoleva seaduse § 123 lõikes 4 nimetatud kindlustusgrupi regulaarsed järelevalvelised aruanded: 2016. aasta kohta 26 nädala jooksul pärast majandusaasta lõppu; 2017. aasta kohta 24 nädala jooksul pärast majandusaasta lõppu; 2018. aasta kohta 22 nädala jooksul pärast majandusaasta lõppu. (4) Kindlustusgrupi juhtiv ettevõtja avalikustab käesoleva seaduse § 123 lõikes 3 nimetatud kindlustusgrupi solventsuse ja finantsseisundi aruande: 2016. aasta kohta 26 nädala jooksul pärast majandusaasta lõppu; 2017. aasta kohta 24 nädala jooksul pärast majandusaasta lõppu; 2018. aasta kohta 22 nädala jooksul pärast majandusaasta lõppu.",
      "rdfs:label": {
        "@value": "KINDLU_Par_273 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_273_1_v122032018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_273_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustusandja kohaldab käesoleva seaduse § 105 lõike 2 punktis 10 nimetatud korda kindlustusagendi suhtes, kes on kantud vahendajate nimekirja enne Euroopa Parlamendi ja nõukogu direktiivis (EL) 2016/97 sätestatud rakendamiskuupäeva, hiljemalt selle direktiivi artiklis 40 nimetatud kuupäevast.",
      "rdfs:label": {
        "@value": "KINDLU_Par_273_1 (redaktsioon 122032018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032018001"
    },
    {
      "@id": "estleg:KINDLU_Par_274_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_274"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustusmaakler ja kindlustusagentuur on kohustatud oma tegevuse ning dokumendid käesoleva seaduse §-s 186 ja § 198 lõikes 3 sätestatud sise-eeskirjade kehtestamise nõuetega kooskõlla viima hiljemalt 2016. aasta 1. juuliks.",
      "rdfs:label": {
        "@value": "KINDLU_Par_274 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_274_v122032018001"
      },
      "estleg:versionValidTo": {
        "@value": "2018-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_274_v122032018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_274"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusmaakler ja kindlustusagentuur on kohustatud oma tegevuse ning dokumendid käesoleva seaduse §-s 186 ja § 198 lõikes 3 sätestatud sise-eeskirjade kehtestamise nõuetega kooskõlla viima hiljemalt 2016. aasta 1. juuliks. (2) Kindlustusmaakler, kes on kantud vahendajate nimekirja enne Euroopa Parlamendi ja nõukogu direktiivi (EL) 2016/97 rakendamiskuupäeva, on kohustatud oma tegevuse käesoleva seaduse § 178 lõikes 4 sätestatud dokumenteerimisnõuetega ning § 186 lõike 2 punktis 16 nimetatud korra nõuetega kooskõlla viima selle direktiivi artiklis 40 nimetatud kuupäevaks.",
      "rdfs:label": {
        "@value": "KINDLU_Par_274 (redaktsioon 122032018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032018001"
    },
    {
      "@id": "estleg:KINDLU_Par_275_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_275"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Finantsinspektsiooni seaduses tehakse järgmised muudatused:",
      "rdfs:label": {
        "@value": "KINDLU_Par_275 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_28_v22463",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja võib välja lasta ainult nimelisi aktsiaid. (2) Kindlustusandja ei või välja lasta eelisaktsiaid.",
      "rdfs:label": {
        "@value": "KINDLU_Par_28 (redaktsioon 22463)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22463",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_28_v831362"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_28_v831362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Finantsinspektsioon avalikustab tegevusloa andmise, selle muutmise ning kehtetuks tunnistamise oma veebilehel hiljemalt otsuse tegemisele järgneval tööpäeval. (2) Tegevusloa kehtetuks tunnistamise avalikustab Finantsinspektsioon lisaks käesoleva paragrahvi lõikes 1 ettenähtule veel vähemalt ühes üleriigilise levikuga päevalehes.",
      "rdfs:label": {
        "@value": "KINDLU_Par_28 (redaktsioon 831362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "831362",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_28_v107072015001"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_28_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja, kes soovib asutada filiaali kolmandas riigis, peab selleks taotlema Finantsinspektsioonilt kolmanda riigi filiaali asutamise loa. (2) Kolmanda riigi filiaali asutamise loa taotlemisel tuleb kindlustusandjal Finantsinspektsioonile esitada kirjalik taotlus koos järgmiste andmete ja dokumentidega: selle kolmanda riigi nimi, kus kindlustusandja soovib filiaali asutada, koos kolmanda riigi finantsjärelevalve asutuse kinnitusega, et selle riigi õigusaktide kohaselt on kindlustusandja filiaali asutamine selles riigis lubatud; filiaali asukoha aadress kolmandas riigis; käesoleva seaduse §-s 18 sätestatud nõuetele vastav filiaali tegevuskava kindlustustegevuse kohta kolmandas riigis koos kavandatava kindlustustegevuse ja organisatsioonilise ülesehituse üksikasjaliku kirjeldusega; kindlustusandja nimel tegutsemiseks piisavat esindusõigust omava filiaali juhataja nimi, isikukood või selle puudumise korral sünniaeg ning esindusõigust tõendav dokument. (3) Käesoleva paragrahvi lõike 2 punktides 2–4 nimetatud andmete muutumisest ja dokumentide muutmisest teavitab kindlustusandja viivitamata Finantsinspektsiooni.",
      "rdfs:label": {
        "@value": "KINDLU_Par_28 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_286_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_286"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kindlustustegevuse seadus (RT I 2004, 90, 616) tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "KINDLU_Par_286 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_286_v131122016026"
      },
      "estleg:versionValidTo": {
        "@value": "2017-01-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_286_v131122016026",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_286"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "KINDLU_Par_286 (redaktsioon 131122016026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016026"
    },
    {
      "@id": "estleg:KINDLU_Par_287_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_287"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2016. aasta 1. jaanuaril. (2) Käesoleva seaduse § 276 jõustub üldises korras. (3) Käesoleva seaduse § 123 lõiked 11 ja 12 jõustuvad 2019. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "KINDLU_Par_287 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_29_v22463",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja minimaalne aktsiakapital peab olema: edasikindlustusega tegelemise korral 20 miljonit krooni; elukindlustusega tegelemise korral 12 miljonit krooni; kohustusliku liikluskindlustuse, teiste vastutuskindlustuste, samuti krediidi-, garantii- või finantskahjude kindlustusega tegelemise korral 10 miljonit krooni; muude kahjukindlustusliikidega tegelemise korral 5 miljonit krooni. (2) Kahe või enama kindlustustegevuse liigiga tegelemiseks tegevusluba omava kindlustusandja aktsiakapitalile laieneb vastavate kindlustusliikide aktsiakapitalile käesoleva paragrahvi lõikes 1 sätestatutest kõrgeim nõue. (3) Käesoleva paragrahvi lõikes 1 sätestatud aktsiakapital peab kindlustusandja asutamisel olema tasutud rahalise sissemaksena.",
      "rdfs:label": {
        "@value": "KINDLU_Par_29 (redaktsioon 22463)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22463",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_29_v831362"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_29_v831362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti kindlustusandja võib välisriigis tegeleda kindlustustegevusega, milleks Finantsinspektsioon on talle andnud tegevusloa, asutades selleks filiaali või tegeledes piiriülese kindlustustegevusega. (2) Eesti kindlustusandja filiaaliks lepinguriigis loetakse käesoleva seaduse tähenduses ka Eesti kindlustusandja töötaja poolt juhitava esinduse või kontori või kindlustusandja poolt teda püsivalt esindama volitatud sõltumatu isiku püsivat tegelemist kindlustustegevusega lepinguriigis ning sellele kohaldatakse käesoleva seaduse §-des 35–37 sätestatut. (3) Välisriigis kindlustustegevusega tegeledes peab kindlustusandja järgima käesolevas seaduses ning selle alusel antud õigusaktides ning välisriigi õigusaktides sätestatud nõudeid. (4) Lepinguriigis teenuste osutamisele kohaldatakse käesoleva seaduse §-des 30 ja 35–40 sätestatut. (5) Käesoleva paragrahvi lõikes 4 nimetamata välisriigis (edaspidi kolmandas riigis) teenuste osutamisele kohaldatakse käesoleva seaduse §-des 31–34 sätestatut. Eesti kindlustusandja ei või tegeleda kolmandas riigis piiriülese kindlustustegevusega.",
      "rdfs:label": {
        "@value": "KINDLU_Par_29 (redaktsioon 831362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "831362",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_29_v12898375"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_29_v12898375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti kindlustusandja võib välisriigis tegeleda kindlustustegevusega, milleks Finantsinspektsioon on talle andnud tegevusloa, asutades selleks filiaali või tegeledes piiriülese kindlustustegevusega. (2) Eesti kindlustusandja filiaaliks lepinguriigis peetakse käesoleva seaduse tähenduses ka Eesti kindlustusandja poolt teda alaliselt esindama volitatud isiku püsivat tegelemist kindlustustegevusega lepinguriigis ning sellele kohaldatakse käesoleva seaduse §-des 35–37 sätestatut. (3) Välisriigis kindlustustegevusega tegeledes peab kindlustusandja järgima käesolevas seaduses ning selle alusel antud õigusaktides ning välisriigi õigusaktides sätestatud nõudeid. (4) Lepinguriigis teenuste osutamisele kohaldatakse käesoleva seaduse §-des 30 ja 35–40 sätestatut. (5) Käesoleva paragrahvi lõikes 4 nimetamata välisriigis (edaspidi kolmandas riigis) teenuste osutamisele kohaldatakse käesoleva seaduse §-des 31–34 sätestatut. Eesti kindlustusandja ei või tegeleda kolmandas riigis piiriülese kindlustustegevusega. (6) Eesti edasikindlustusandja võib tegeleda kolmandas riigis piiriülese edasikindlustustegevusega ning tema suhtes kohaldatakse käesoleva seaduse § 30 lõikes 4 ja §-des 38–40 sätestatut.",
      "rdfs:label": {
        "@value": "KINDLU_Par_29 (redaktsioon 12898375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12898375",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_29_v13277324"
      },
      "estleg:versionValidTo": {
        "@value": "2010-02-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_29_v13277324",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-02-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti kindlustusandja võib välisriigis tegeleda kindlustustegevusega, milleks Finantsinspektsioon on talle andnud tegevusloa, asutades selleks filiaali või tegeledes piiriülese kindlustustegevusega. (2) Kui Eesti kindlustusandjat alaliselt esindama volitatud isik tegeleb välisriigis püsivalt kindlustusagendi tegevuse või kindlustustegevusega, loetakse volitatud isiku tegevus Eesti kindlustusandja välisriigi filiaali tegevuseks ning sellise tegevuse jätkamiseks peab kindlustusandja käesoleva seaduse §-de 31–37 kohaselt asutama filiaali. (3) Välisriigis kindlustustegevusega tegeledes peab kindlustusandja järgima käesolevas seaduses ning selle alusel antud õigusaktides ning välisriigi õigusaktides sätestatud nõudeid. (4) Lepinguriigis teenuste osutamisele kohaldatakse käesoleva seaduse §-des 30, 35–37 ja 38–40. (5) Käesoleva paragrahvi lõikes 4 nimetamata välisriigis (edaspidi kolmas riik) teenuste osutamisele kohaldatakse käesoleva seaduse §-des 31–34 ja 371 sätestatut. (6) Eesti edasikindlustusandja võib tegeleda kolmandas riigis piiriülese edasikindlustustegevusega ning tema suhtes kohaldatakse käesoleva seaduse § 30 lõikes 4 ja §-des 38–40 sätestatut.",
      "rdfs:label": {
        "@value": "KINDLU_Par_29 (redaktsioon 13277324)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13277324",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_29_v107072015001"
      },
      "estleg:versionValidTo": {
        "@value": "2015-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_29_v107072015001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kolmandas riigis filiaali asutamise loa taotluse menetlemisel, esitatud andmete kontrollimisel ja taotleja finantsseisundi, organisatsioonilise ülesehituse ja tehniliste süsteemide ning filiaali asutamiseks piisavate vahendite olemasolu kontrollimisel kohaldatakse käesoleva seaduse §-s 19 sätestatut. (2) Otsuse kolmandas riigis filiaali asutamise loa andmise või sellest keeldumise kohta teeb Finantsinspektsioon kahe kuu jooksul kõigi nõuetekohaste andmete ja dokumentide saamisest arvates, kuid mitte hiljem kui kolme kuu möödumisel vastava taotluse esitamisest.",
      "rdfs:label": {
        "@value": "KINDLU_Par_29 (redaktsioon 107072015001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "107072015001"
    },
    {
      "@id": "estleg:KINDLU_Par_3_v22463",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja või kindlustusvahendaja ärinimes peab sisalduma sõna «kindlustus». (2) Muude kui käesoleva paragrahvi lõikes 1 nimetatud juriidiliste isikute ärinimes ei või sisalduda sõna «kindlustus» ei eesti ega võõrkeeles. (3) Käesoleva paragrahvi lõikes 2 sätestatu ei laiene mittetulundusühingutele.",
      "rdfs:label": {
        "@value": "KINDLU_Par_3 (redaktsioon 22463)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22463",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_3_v831362"
      },
      "estleg:versionValidTo": {
        "@value": "2004-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_3_v831362",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja käesoleva seaduse tähenduses on äriühing, kelle peamiseks ja püsivaks tegevuseks on kindlustusjuhtumi toimumisel kindlustusjuhtumi tõttu tekkinud kahju hüvitamine või kokkulepitud rahasumma maksmine. (2) Kindlustusandja võib asutada ainult aktsiaseltsina või Euroopa äriühinguna, kui seadusega ei ole ette nähtud teisiti. (3) Kindlustusandja suhtes rakendatakse äriseadustikus (RT I 1995, 26–28, 355; 1998, 91–93, 1500; 1999, 10, 155; 23, 355; 24, 360; 57, 596; 102, 907; 2000, 29, 172; 49, 303; 55, 365; 57, 373; 2001, 34, 185; 56, 332 ja 336; 89, 532; 93, 565; 2002, 3, 6; 35, 214; 53, 336; 61, 375; 63, 387 ja 388; 96, 564; 102, 600; 110, 657; 2003, 4, 19; 13, 64; 18, 100; 78, 523; 88, 591) sätestatut käesolevast seadusest tulenevate erisustega. (4) Kindlustusandja võib tegeleda üksnes kindlustustegevuse ja vahendusega ning teha muid otseselt nendest tulenevaid tehinguid ja toiminguid. (5) Käesoleva paragrahvi lõikes 4 sätestatu ei mõjuta kindlustusandja tehingute ja toimingute kehtivust. (6) Kindlustusandja võib käesoleva seaduse §-des 65 ja 66 sätestatud ulatuses ja korras kolmandale isikule edasi anda järgmisi kindlustustegevusega seotud tegevusi: kindlustatud esemete väärtuse hindamine; kindlustuslepingute sõlmimine; kindlustuslepingutest tulenevate kahjude käsitlemine; investeeringute või varade haldamine; raamatupidamine; infosüsteemide haldamine; siseauditi funktsioon; muud tegevused Finantsinspektsiooni loal. (7) Edasikindlustusandja käesoleva seaduse tähenduses on äriühing, kes on kindlustusandja või teise edasikindlustusandjaga sõlminud edasikindlustuslepingu, mille kohaselt edasikindlustusandja võtab kohustuse maksta kindlustusandjale või teisele edasikindlustusandjale kokkulepitud suuruses hüvitist seoses kindlustusandja ja kindlustusvõtja vahel sõlmitud kindlustuslepingu või teise edasikindlustusandja ja kindlustusandja vahel sõlmitud edasikindlustuslepingu järgse kindlustusjuhtumiga. (8) Edasikindlustusandjale kohaldatakse kindlustusandja kohta sätestatut, kui käesoleva seadusega ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINDLU_Par_3 (redaktsioon 831362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "831362",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_3_v12894043"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-14",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_3_v12894043",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja käesoleva seaduse tähenduses on äriühing, kelle peamiseks ja püsivaks tegevuseks on kindlustusjuhtumi toimumisel kindlustusjuhtumi tõttu tekkinud kahju hüvitamine või kokkulepitud rahasumma maksmine. (2) Kindlustusandja võib asutada ainult aktsiaseltsina või Euroopa äriühinguna, kui seadusega ei ole ette nähtud teisiti. (3) Kindlustusandja suhtes rakendatakse äriseadustikus sätestatut käesolevast seadusest tulenevate erisustega. (4) Kindlustusandja võib tegeleda üksnes kindlustustegevuse ja vahendusega ning teha muid otseselt nendest tulenevaid tehinguid ja toiminguid. (5) Käesoleva paragrahvi lõikes 4 sätestatu ei mõjuta kindlustusandja tehingute ja toimingute kehtivust. (6) Kindlustusandja võib käesoleva seaduse §-des 65 ja 66 sätestatud ulatuses ja korras kolmandale isikule edasi anda järgmisi kindlustustegevusega seotud tegevusi: kindlustatud esemete väärtuse hindamine; kindlustuslepingute sõlmimine; kindlustuslepingutest tulenevate kahjude käsitlemine; investeeringute või varade haldamine; raamatupidamine; infosüsteemide haldamine; siseauditi funktsioon; muud tegevused Finantsinspektsiooni loal. (7) Edasikindlustusandja käesoleva seaduse tähenduses on äriühing, kes on kindlustusandja või teise edasikindlustusandjaga sõlminud edasikindlustuslepingu, mille kohaselt edasikindlustusandja võtab kohustuse maksta kindlustusandjale või teisele edasikindlustusandjale kokkulepitud suuruses hüvitist seoses kindlustusandja ja kindlustusvõtja vahel sõlmitud kindlustuslepingu või teise edasikindlustusandja ja kindlustusandja vahel sõlmitud edasikindlustuslepingu järgse kindlustusjuhtumiga. (8) Edasikindlustusandjale kohaldatakse kindlustusandja kohta sätestatut, kui käesoleva seadusega ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "KINDLU_Par_3 (redaktsioon 12894043)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12894043",
      "estleg:supersededByVersion": {
        "@id": "estleg:KINDLU_Par_3_v12898375"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_3_v12898375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kindlustusandja käesoleva seaduse tähenduses on äriühing, kelle peamiseks ja püsivaks tegevuseks on kindlustusjuhtumi toimumisel kindlustusjuhtumi tõttu tekkinud kahju hüvitamine või kokkulepitud rahasumma maksmine. (2) Kindlustusandja võib asutada ainult aktsiaseltsina või Euroopa äriühinguna, kui seadusega ei ole ette nähtud teisiti. (3) Kindlustusandja suhtes rakendatakse äriseadustikus sätestatut käesolevast seadusest tulenevate erisustega. (4) Kindlustusandja võib tegeleda üksnes kindlustustegevuse, edasikindlustustegevuse ja vahendusega ning teha muid otseselt nendest tulenevaid tehinguid ja toiminguid, kui need abistavad või täiendavad vahetult põhitegevust. (5) Käesoleva paragrahvi lõikes 4 sätestatu ei mõjuta kindlustusandja tehingute ja toimingute kehtivust. (6) Kindlustusandja võib käesoleva seaduse §-des 65 ja 66 sätestatud ulatuses ja korras kolmandale isikule edasi anda järgmisi kindlustustegevusega seotud tegevusi: kindlustatud esemete väärtuse hindamine; kindlustuslepingute sõlmimine; kindlustuslepingutest tulenevate kahjude käsitlemine; investeeringute või varade haldamine; raamatupidamine; infosüsteemide haldamine; siseauditi funktsioon; muud tegevused Finantsinspektsiooni loal. (7) –(8) Kehtetud –",
      "rdfs:label": {
        "@value": "KINDLU_Par_3 (redaktsioon 12898375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12898375",
      "estleg:supersededByVersion": {
