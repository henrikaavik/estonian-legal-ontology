      },
      "estleg:versionText": "Käesoleva seadusega reguleeritakse kindlustustegevust ja selle järelevalvet.",
      "rdfs:label": {
        "@value": "KINDLU_Par_1 (redaktsioon 22463)",
        "@language": "et"
