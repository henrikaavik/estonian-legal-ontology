        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seaduses eurodes väljendatud summad arvutatakse ümber Eesti kroonidesse Eesti Panga kursi alusel.",
      "rdfs:label": {
        "@value": "KINDLU_Par_265 (redaktsioon 831362)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "831362",
