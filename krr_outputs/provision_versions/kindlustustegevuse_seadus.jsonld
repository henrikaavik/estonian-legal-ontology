      "estleg:versionValidTo": {
        "@value": "2011-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KINDLU_Par_208_v129062011009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KINDLU_Par_208"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 199–2071 sätestatud väärtegudele kohaldatakse karistusseadustiku üldosa ja väärteomenetluse seadustiku sätteid. (2) Käesolevas seaduses sätestatud väärtegude kohtuväline menetleja on Finantsinspektsioon.",
      "rdfs:label": {
        "@value": "KINDLU_Par_208 (redaktsioon 129062011009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062011009",
      "estleg:supersededByVersion": {
