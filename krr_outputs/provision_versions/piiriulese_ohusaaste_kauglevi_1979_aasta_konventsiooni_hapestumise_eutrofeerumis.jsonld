        "@id": "estleg:piiriulese_ohusaaste_kauglevi_1979_aasta_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teha protokolliga ühinemisel deklaratsioon, et Eesti Vabariik tunnustab protokolli tõlgendamise või kohaldamisega seotud vaidluse korral artikli 11 lõikes 2 nimetatud vaidluse lahendamise meetmeid kohustuslikuna iga lepinguosalise suhtes, kes võtab endale sama kohustuse.",
      "rdfs:label": {
