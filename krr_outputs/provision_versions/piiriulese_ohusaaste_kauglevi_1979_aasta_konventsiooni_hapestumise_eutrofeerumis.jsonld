        "@id": "estleg:piiriulese_ohusaaste_kauglevi_1979_aasta_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-11-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiita heaks protokolli muudatused, mis on vastu võetud konventsiooni täitevorgani 2012. aasta 4. mai ja otsusega 2012/2 (ELT L 248, 27.09.2017, lk 5–75).",
      "rdfs:label": {
        "@value": "piiriulese_ohusaaste_kauglevi_1979_aasta_Par_2 (redaktsioon 213112018001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "213112018001"
    },
    {
      "@id": "estleg:piiriulese_ohusaaste_kauglevi_1979_aasta_Par_3_v213112018001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
