      "estleg:provisionRef": "perekonnaseisundite_dokumendid § 15",
      "estleg:partOfAct": {
        "@id": "estleg:PEREKO_Map_2026"
      }
    },
    {
      "@id": "estleg:perekonnaseisundite_dokumendid_Par_15_v131122015033",
      "@type": [
        "owl:NamedIndividual",
