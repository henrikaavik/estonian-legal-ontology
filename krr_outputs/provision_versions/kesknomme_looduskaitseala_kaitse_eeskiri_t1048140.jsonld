      "estleg:provisionRef": "Reg_1048140 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048140_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048140_Par_2_v1048140",
