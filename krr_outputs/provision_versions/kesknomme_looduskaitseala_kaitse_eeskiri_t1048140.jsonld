      "estleg:provisionRef": "Reg_1048140 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048140_Map"
      }
    },
    {
      "@id": "estleg:Reg_1048140_Par_10_v1048140",
      "@type": [
        "owl:NamedIndividual",
