        "@language": "et"
      },
      "dc:source": "Kaitsekorralduskava koostamise ja kinnitamise kord ning kaitsekorralduskava kinnitaja määramine"
    },
    {
      "@id": "estleg:Reg_1055047_Par_1_v1055047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055047_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määrusega reguleeritakse kaitsealade, püsielupaikade, üksikobjektide ja hoiualade kaitse korraldamiseks koostatavate kaitsekorralduskavade koostamist ja kinnitamist ning määratakse kaitsekorralduskava kinnitaja. Käesoleva määrusega reguleeritakse kaitsealade, püsielupaikade, üksikobjektide ja hoiualade kaitse korraldamiseks koostatavate kaitsekorralduskavade koostamist ja kinnitamist ning määratakse kaitsekorralduskava kinnitaja.",
      "rdfs:label": {
        "@value": "Reg_1055047_Par_1 (redaktsioon 1055047)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055047",
