    {
      "@id": "estleg:Reg_1055047_Par_6_v1055047",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055047_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-11-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva määruse jõustumist kinnitatud kaitsekorralduskavad kehtivad kuni nende muutmise või kehtetuks tunnistamiseni, olenemata kaitsekorralduskavas märgitud ajaperioodist. Enne käesoleva määruse jõustumist kinnitatud kaitsekorralduskavad kehtivad kuni nende muutmise või kehtetuks tunnistamiseni, olenemata kaitsekorralduskavas märgitud ajaperioodist.",
