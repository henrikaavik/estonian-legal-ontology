      },
      "dc:source": "Kütuse käitlemise aruandes esitatavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1046399_Par_1_v1046399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046399_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kütuse müügiks tegevusluba omava isiku (edaspidi kütusemüüja) poolt tanklast müüdud vedelkütuste kohta kütuse käitlemise aruandes esitatavate andmete loetelu. Määrusega kehtestatakse kütuse müügiks tegevusluba omava isiku (edaspidi kütusemüüja) poolt tanklast müüdud vedelkütuste kohta kütuse käitlemise aruandes esitatavate andmete loetelu.",
      "rdfs:label": {
        "@value": "Reg_1046399_Par_1 (redaktsioon 1046399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046399",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1046399",
      "estleg:sourceAct": "Kütuse käitlemise aruandes esitatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1046399 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046399_Map"
      }
    },
    {
      "@id": "estleg:Reg_1046399_Par_2_v1046399",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1046399_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kütusemüüja esitab kütuse käitlemise aruande tegevuskohtade lõikes järgnevate andmetega: 1 1) müüdud kütuse nimetus; 2 2) müüdud kütuse kogus; 3 3) vedelkütuse erimärgistamise seaduse § 12 lõike 3 alusel kogutud andmed, eriotstarbelise diislikütuse müügi kuupäev, välisriigist ostja puhul ostja riik ja isikukoodi puudumisel sünnikuupäev. Kütusemüüja esitab kütuse käitlemise aruande tegevuskohtade lõikes järgnevate andmetega: müüdud kütuse nimetus; müüdud kütuse kogus; vedelkütuse erimärgistamise seaduse § 12 lõike 3 alusel kogutud andmed, eriotstarbelise diislikütuse müügi kuupäev, välisriigist ostja puhul ostja riik ja isikukoodi puudumisel sünnikuupäev.",
      "rdfs:label": {
        "@value": "Reg_1046399_Par_2 (redaktsioon 1046399)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1046399",
