      }
    },
    {
      "@id": "estleg:Reg_306836_Par_13_v306836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306836_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus, kaasa arvatud metsa raie käesolevas määruses sätestatud erisustega 16. juulist 14. aprillini. RT I 2018-04-10 3 110042018003 2018-04-20 2 2) kehtetu - RT I 2018-04-10 3 110042018003 2018-04-20 Piiranguvööndis on lubatud: majandustegevus, kaasa arvatud metsa raie käesolevas määruses sätestatud erisustega 16. juulist 14. aprillini. kehtetu - 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud, arvestades käesoleva määrusega sätestatud erisusi: RT I 2018-04-10 3 110042018003 2018-04-20 1 1) ehitise, kaasa arvatud ajutise ehitise püstitamine; RT I 2018-04-10 3 110042018003 2018-04-20 2 2) kehtetu - RT I 2018-04-10 3 110042018003 2018-04-20 3 3) turberaie langi pindalaga kuni kaks hektarit; RT I 2018-04-10 3 110042018003 2018-04-20 4 4) lageraie kuusikutes langi pindalaga kuni üks hektar. RT I 2018-04-10 3 110042018003 2018-04-20 Piiranguvööndis on kaitseala valitseja nõusolekul lubatud, arvestades käesoleva määrusega sätestatud erisusi: ehitise, kaasa arvatud ajutise ehitise püstitamine; kehtetu - turberaie langi pindalaga kuni kaks hektarit; lageraie kuusikutes langi pindalaga kuni üks hektar.",
      "rdfs:label": {
        "@value": "Reg_306836_Par_13 (redaktsioon 306836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306836",
      "estleg:sourceAct": "Pihla-Kaibaldi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306836 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306836_Map"
      }
    },
    {
      "@id": "estleg:Reg_306836_Par_14_v306836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306836_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) veekogude veetaseme ja kaldajoone muutmine; 3 3) maavara kaevandamine; 4 4) biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal; RT I 2018-04-10 3 110042018003 2018-04-20 5 5) kehtetu - RT I 2018-04-10 3 110042018003 2018-04-20 6 6) puidu kokku- ja väljavedu külmumata pinnasel. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab; RT I 2018-04-10 3 110042018003 2018-04-20 7 7) uue maaparandussüsteemi rajamine. RT I 2018-04-10 3 110042018003 2018-04-20 Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; veekogude veetaseme ja kaldajoone muutmine; maavara kaevandamine; biotsiidi, taimekaitsevahendi ja väetise kasutamine, välja arvatud õue- ja põllumaal; kehtetu - puidu kokku- ja väljavedu külmumata pinnasel. Kaitseala valitseja võib lubada puidu kokku- ja väljavedu, kui pinnas seda võimaldab; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_306836_Par_14 (redaktsioon 306836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306836",
      "estleg:sourceAct": "Pihla-Kaibaldi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306836 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306836_Map"
      }
    },
    {
      "@id": "estleg:Reg_306836_Par_15_v306836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306836_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu säilimise tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu säilimise tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_306836_Par_15 (redaktsioon 306836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306836",
      "estleg:sourceAct": "Pihla-Kaibaldi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306836 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306836_Map"
      }
    },
