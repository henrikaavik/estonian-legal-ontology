      "estleg:versionValidFrom": {
        "@value": "2018-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvöönd on kaitseala maa- ja veeala, mis ei kuulu sihtkaitsevööndisse. Piiranguvöönd on kaitseala maa- ja veeala, mis ei kuulu sihtkaitsevööndisse. 2 (2) Kaitsealal on Pihla-Kaibaldi piiranguvöönd. Kaitsealal on Pihla-Kaibaldi piiranguvöönd.",
      "rdfs:label": {
        "@value": "Reg_306836_Par_11 (redaktsioon 306836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306836",
