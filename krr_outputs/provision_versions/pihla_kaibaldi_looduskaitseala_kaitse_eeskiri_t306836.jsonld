      "estleg:provisionRef": "Reg_306836 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306836_Map"
      }
    },
    {
      "@id": "estleg:Reg_306836_Par_11_v306836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
