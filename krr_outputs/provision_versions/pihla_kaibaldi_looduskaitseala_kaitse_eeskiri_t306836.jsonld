      "estleg:provisionRef": "Reg_306836 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306836_Map"
      }
    },
    {
      "@id": "estleg:Reg_306836_Par_12_v306836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306836_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine. Piiranguvööndi kaitse-eesmärk on elustiku mitmekesisuse ja maastikuilme säilitamine.",
      "rdfs:label": {
        "@value": "Reg_306836_Par_12 (redaktsioon 306836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306836",
      "estleg:sourceAct": "Pihla-Kaibaldi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306836 § 12",
