    },
    {
      "@id": "estleg:Reg_306836_Par_2_v306836",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306836_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-04-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala asub Hiiu maakonnas Hiiumaa vallas Kanapeeksi, Koidma, Leigri, Metsaküla, Määvli, Prählamäe ja Tubala külas. RT I 2018-04-10 3 110042018003 2018-04-20 Kaitseala asub Hiiu maakonnas Hiiumaa vallas Kanapeeksi, Koidma, Leigri, Metsaküla, Määvli, Prählamäe ja Tubala külas. 2 (2) Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas4.",
      "rdfs:label": {
        "@value": "Reg_306836_Par_2 (redaktsioon 306836)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306836",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306836",
      "estleg:sourceAct": "Pihla-Kaibaldi looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306836 § 2",
