    {
      "@id": "estleg:RTO_Par_8_v104032011001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RTO_Par_8"
      },
      "estleg:versionValidFrom": {
