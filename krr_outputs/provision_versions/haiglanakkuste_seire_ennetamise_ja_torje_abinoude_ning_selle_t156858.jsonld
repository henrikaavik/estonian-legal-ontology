      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Haiglanakkuste seire, ennetamise ja tõrje abinõude ning sellekohase teabe edastamise kord ning mikrobioloogia- ja viroloogialaborist haiglanakkuse laboratoorse seire ning mikroobide ravimresistentsuse uurimise tulemuste Terviseametile edastamise kord (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Haiglanakkuste seire, ennetamise ja tõrje abinõude ning sellekohase teabe edastamise kord ning mikrobioloogia- ja viroloogialaborist haiglanakkuse laboratoorse seire ning mikroobide ravimresistentsuse uurimise tulemuste Terviseametile edastamise kord"
    },
    {
      "@id": "estleg:Reg_156858_Par_1_v156858",
      "@type": [
