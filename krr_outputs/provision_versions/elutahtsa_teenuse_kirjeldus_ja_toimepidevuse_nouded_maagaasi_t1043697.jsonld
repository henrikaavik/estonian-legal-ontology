      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded maagaasiga varustamisel (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded maagaasiga varustamisel"
    },
    {
      "@id": "estleg:Reg_1043697_Par_1_v1043697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043697_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruses kehtestatakse nõuded hädaolukorra seaduse § 36 lõike 11 punktis 2 sätestatud elutähtsale teenusele ning selle kirjeldus. RT I 2023-07-05 7 105072023007 2023-07-08 Määruses kehtestatakse nõuded hädaolukorra seaduse § 36 lõike 11 punktis 2 sätestatud elutähtsale teenusele ning selle kirjeldus. 2 (2) Määruses sätestatakse elutähtsa teenuse taseme, valmisoleku ja teenuse katkestuse ennetamise nõuded. Samuti sätestatakse tingimused, mille puhul on tegemist elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga, ja nõuded elutähtsa teenuse põhitegevust toetavate teenuste sisseostmiseks teiselt ettevõttelt ning hädaolukorrast või selle ohust teavitamise korraldus. Määruses sätestatakse elutähtsa teenuse taseme, valmisoleku ja teenuse katkestuse ennetamise nõuded. Samuti sätestatakse tingimused, mille puhul on tegemist elutähtsa teenuse ulatuslikust või raskete tagajärgedega katkestusest põhjustatud hädaolukorraga, ja nõuded elutähtsa teenuse põhitegevust toetavate teenuste sisseostmiseks teiselt ettevõttelt ning hädaolukorrast või selle ohust teavitamise korraldus.",
      "rdfs:label": {
        "@value": "Reg_1043697_Par_1 (redaktsioon 1043697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043697",
