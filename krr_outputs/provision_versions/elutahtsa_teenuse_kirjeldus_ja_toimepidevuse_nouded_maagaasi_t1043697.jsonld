      }
    },
    {
      "@id": "estleg:Reg_1043697_Par_6_v1043697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043697_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maagaasiga varustaja lähtub elutähtsa teenuse taastamisel toimepidevuse plaanis esitatud teenuse taastamise prioriteetidest, arvestades võimalusel järgmisega: 1 1) esimesena taastatakse teenus objektidel, kus teenuse katkestusega kaasneb vahetu oht inimelule; 2 2) teisena taastatakse teenus objektidel, mis tagavad elutähtsa teenuse või riigikaitseobjektide toimepidevuse; 3 3) kolmandana taastatakse teenus muudel objektidel. Maagaasiga varustaja lähtub elutähtsa teenuse taastamisel toimepidevuse plaanis esitatud teenuse taastamise prioriteetidest, arvestades võimalusel järgmisega: esimesena taastatakse teenus objektidel, kus teenuse katkestusega kaasneb vahetu oht inimelule; teisena taastatakse teenus objektidel, mis tagavad elutähtsa teenuse või riigikaitseobjektide toimepidevuse; kolmandana taastatakse teenus muudel objektidel.",
      "rdfs:label": {
        "@value": "Reg_1043697_Par_6 (redaktsioon 1043697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043697",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded maagaasiga varustamisel",
      "estleg:provisionRef": "Reg_1043697 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043697_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043697_Par_7_v1043697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043697_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vastavalt Euroopa Parlamendi ja nõukogu määruse (EL) nr 2017/1938, mis käitleb gaasivarustuskindluse tagamise meetmeid ja millega tunnistatakse kehtetuks määrus (EL) nr 994/2010 (JO L 280, 28.10.2017, 1–56) artikli 11 lõike 1 punktile c on gaasitarne hädaolukorraga tegemist juhul, kui esineb vähemalt üks järgnevatest tingimustest: 1 1) erandlikult suur gaasinõudlus; 2 2) märkimisväärne tarnehäire või tarneolukorra muu märkimisväärne häire; 3 3) turumeetmed ei taga piisavat gaasivarustust, mistõttu tuleb täiendavalt kasutusele võtta mitteturupõhised meetmed, et kindlustada gaasitarne eelkõige kaitstud tarbijatele. Vastavalt Euroopa Parlamendi ja nõukogu määruse (EL) nr 2017/1938, mis käitleb gaasivarustuskindluse tagamise meetmeid ja millega tunnistatakse kehtetuks määrus (EL) nr 994/2010 (JO L 280, 28.10.2017, 1–56) artikli 11 lõike 1 punktile c on gaasitarne hädaolukorraga tegemist juhul, kui esineb vähemalt üks järgnevatest tingimustest: erandlikult suur gaasinõudlus; märkimisväärne tarnehäire või tarneolukorra muu märkimisväärne häire; turumeetmed ei taga piisavat gaasivarustust, mistõttu tuleb täiendavalt kasutusele võtta mitteturupõhised meetmed, et kindlustada gaasitarne eelkõige kaitstud tarbijatele.",
      "rdfs:label": {
        "@value": "Reg_1043697_Par_7 (redaktsioon 1043697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043697",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded maagaasiga varustamisel",
      "estleg:provisionRef": "Reg_1043697 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043697_Map"
      }
    },
    {
      "@id": "estleg:Reg_1043697_Par_8_v1043697",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1043697_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Maagaasi varustaja teavitab viivitamata Kliimaministeeriumit ja Konkurentsiametit tarnehäirest, tarnehäirest põhjustatud hädaolukorrast või selle ohust telefoni ja e-posti teel. RT I 2023-07-05 7 105072023007 2023-07-08 Maagaasi varustaja teavitab viivitamata Kliimaministeeriumit ja Konkurentsiametit tarnehäirest, tarnehäirest põhjustatud hädaolukorrast või selle ohust telefoni ja e-posti teel. 2 (2) Lõikes 1 kirjeldatud teavitus sisaldab vähemalt järgmist teavet: 1 1) katkestuse tegelik või oletatav põhjus ja hetkeolukorra lühikirjeldus; 2 2) katkestuse toimumise aeg ja kestus; 3 3) teenuse taastamise või teenuse katkestuse mõju vähendamiseks rakendatud ja rakendatavad meetmed; 4 4) esialgsed andmed prognoositava kahju kohta teenuse tarbijale; 5 5) esialgsed andmed prognoositava mõju kohta teiste elutähtsate teenuste toimepidevusele; 6 6) vajadusel esialgsed andmed prognoositava mõju kohta keskkonnale. Lõikes 1 kirjeldatud teavitus sisaldab vähemalt järgmist teavet: katkestuse tegelik või oletatav põhjus ja hetkeolukorra lühikirjeldus; katkestuse toimumise aeg ja kestus; teenuse taastamise või teenuse katkestuse mõju vähendamiseks rakendatud ja rakendatavad meetmed; esialgsed andmed prognoositava kahju kohta teenuse tarbijale; esialgsed andmed prognoositava mõju kohta teiste elutähtsate teenuste toimepidevusele; vajadusel esialgsed andmed prognoositava mõju kohta keskkonnale. 3 (3) Kliimaministeerium teavitab viivitamatult avalikkust hädaolukorrast või selle ohust meediakanalite kaudu vastavalt kliimaministri käskkirjaga välja antud kriisikommunikatsiooni plaanile. RT I 2023-07-05 7 105072023007 2023-07-08 Kliimaministeerium teavitab viivitamatult avalikkust hädaolukorrast või selle ohust meediakanalite kaudu vastavalt kliimaministri käskkirjaga välja antud kriisikommunikatsiooni plaanile.",
      "rdfs:label": {
        "@value": "Reg_1043697_Par_8 (redaktsioon 1043697)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1043697",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1043697",
      "estleg:sourceAct": "Elutähtsa teenuse kirjeldus ja toimepidevuse nõuded maagaasiga varustamisel",
      "estleg:provisionRef": "Reg_1043697 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043697_Map"
      }
    },
