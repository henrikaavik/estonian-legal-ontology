        "@value": "Sätete redaktsioonid: Teabe esitamise tähtaegade täpsustatud loetelu elektri- ja elektroonikaseadmete kategooriate lõikes (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Teabe esitamise tähtaegade täpsustatud loetelu elektri- ja elektroonikaseadmete kategooriate lõikes"
    },
    {
      "@id": "estleg:Reg_1000910_Par_1_v1000910",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
