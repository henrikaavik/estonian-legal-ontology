      "rdfs:label": {
        "@value": "Sätete redaktsioonid: 2026. aastal maaelu ja põllumajandusturu korraldamiseks antavad toetused (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "2026. aastal maaelu ja põllumajandusturu korraldamiseks antavad toetused"
    },
    {
      "@id": "estleg:Reg_1062628_Par_1_v1062628",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062628_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2026. aastal antakse maaelu ja põllumajandusturu korraldamise seaduse alusel järgmisi toetusi riigiabi, vähese tähtsusega abi ja muu toetusena, mis ei ole riigiabi ega vähese tähtsusega abi: 1) põllumajandusloomade aretustoetus; 2) põllumajandustootja asendamise toetus; 3) turuarendustoetus; 4) mesilaspere toetus; 5) haridusasutuses mahepõllumajandusliku toidu ja mahepõllumajanduslikke koostisosi sisaldava toidu pakkumise toetu; 6) erakorraline investeeringutoetus sealihatootjatele sigade Aafrika katku ennetamiseks.",
      "rdfs:label": {
        "@value": "Reg_1062628_Par_1 (redaktsioon 1062628)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062628",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062628",
      "estleg:sourceAct": "2026. aastal maaelu ja põllumajandusturu korraldamiseks antavad toetused",
      "estleg:provisionRef": "Reg_1062628 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062628_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062628_Par_2_v1062628",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062628_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "2026. aastal võib § 1 punktis 3 nimetatud turuarendustoetust taotleda välisriigis toimuval või rahvusvahelisel virtuaalsel messil osalemise korraldamiseks.",
      "rdfs:label": {
        "@value": "Reg_1062628_Par_2 (redaktsioon 1062628)",
