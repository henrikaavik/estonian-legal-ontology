      "estleg:sourceAct": "Laeva saabumisest teatamisel esitatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1001280 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001280_Map_2026"
      }
