  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_laeva_saabumisest_teatamisel_esitatavate_andmete_loetelu_t1001280_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Laeva saabumisest teatamisel esitatavate andmete loetelu (2 versiooni)",
        "@language": "et"
      },
      "dc:source": "Laeva saabumisest teatamisel esitatavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1001280_Par_1_v1001280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001280_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laeva saabumisest teate esitamisel tuleb esitada Transpordiametile järgmised andmed: 1) laeva nimi, laeva kutsung, IMO number või MMSI number; 2) laeva sihtsadam; 3) sihtsadamasse või lootsi laevalemineku ja laevalt mahatuleku kohta jõudmise eeldatav aeg; 4) sihtsadamast või lootsi laevalemineku ja laevalt mahatuleku kohast lahkumise eeldatav aeg; 5) pardal olevate isikute koguarv; 6) eelmine külastussadam ja sellest lahkumise aeg; 7) laeva omaniku, reederi ja prahtija nimi, IMO number ja kodakondsus või selle puudumisel elukoha aadress ning juriidilise isiku korral asukoha aadress riigi täpsusega; 8) laeva klassifikatsiooniühingu nimi; 9) majandus- ja kommunikatsiooniministri 14. juuli 2011. a määruse nr 74 „Ohtlikust lastist teavitamise kord” § 9 lõikes 1 sätestatud teave pardal veetava ohtliku lasti kohta.",
      "rdfs:label": {
        "@value": "Reg_1001280_Par_1 (redaktsioon 1001280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001280",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001280",
      "estleg:sourceAct": "Laeva saabumisest teatamisel esitatavate andmete loetelu",
      "estleg:provisionRef": "Reg_1001280 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001280_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1001280_Par_2_v1001280",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001280_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-10-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Edastatud andmete muutumise korral peab reeder, kapten või laevaagent viivitamatult tegema vastava muudatuse elektroonilises mereinfosüsteemis.",
      "rdfs:label": {
        "@value": "Reg_1001280_Par_2 (redaktsioon 1001280)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001280",
