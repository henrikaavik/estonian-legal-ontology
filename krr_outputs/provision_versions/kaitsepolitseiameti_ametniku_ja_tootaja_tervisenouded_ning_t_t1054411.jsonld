    {
      "@id": "estleg:Reg_1054411_Par_2_v1054411",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054411_Par_2"
