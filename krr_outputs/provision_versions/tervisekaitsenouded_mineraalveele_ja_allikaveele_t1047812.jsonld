    },
    {
      "@id": "estleg:Reg_1047812_Par_8_v1047812",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1047812_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Loodusliku mineraalvee vedu on lubatud üksnes tarbijale ette nähtud müügipakendites. Loodusliku mineraalvee vedu on lubatud üksnes tarbijale ette nähtud müügipakendites. 2 (2) Loodusliku mineraalvee villimiseks ja pakendamiseks kasutatavatel müügipakenditel peavad olema asjakohased sulgemisvahendid igasuguse võltsimise ja saastumise vältimiseks. Loodusliku mineraalvee villimiseks ja pakendamiseks kasutatavatel müügipakenditel peavad olema asjakohased sulgemisvahendid igasuguse võltsimise ja saastumise vältimiseks.",
      "rdfs:label": {
