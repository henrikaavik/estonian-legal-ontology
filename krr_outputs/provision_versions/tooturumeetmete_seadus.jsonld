    },
    {
      "@id": "estleg:ToMS_Par_18_v112062025016",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ToMS_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ToMS_Par_18 (redaktsioon 112062025016)",
        "@language": "et"
