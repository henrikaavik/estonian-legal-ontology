        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsler võib nõuda, et järelevalvealune asutus ja lepitusmenetluse pooled annavad avalduse asjas kirjaliku seletuse. Asutus või isik täidab nõude õiguskantsleri määratud tähtaja jooksul.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_29 (redaktsioon 927343)",
        "@language": "et"
      },
