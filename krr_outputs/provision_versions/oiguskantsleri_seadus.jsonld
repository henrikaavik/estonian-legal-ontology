      }
    },
    {
      "@id": "estleg:OIGUSK_Par_28_v22447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsler võib nõuda käesoleva seaduse paragrahvis 20 osundatud asutustelt kirjaliku seletuse andmist avalduse asjas. Vastav asutus peab nõude täitma õiguskantsleri poolt määratud tähtaja jooksul.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_28 (redaktsioon 22447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22447",
