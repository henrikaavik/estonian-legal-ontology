        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsler vastab Riigikogu liikme arupärimisele seadusega sätestatud korras.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_3 (redaktsioon 22447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22447",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22447",
