        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129122012039",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 43_7",
      "estleg:partOfAct": {
