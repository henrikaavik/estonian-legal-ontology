      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ametist tagasiastumisest teatab õiguskantsler Vabariigi Presidendile vähemalt neli kuud ette.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_9 (redaktsioon 22447)",
