        "@id": "estleg:OIGUSK_Par_36_v129052012005"
      },
      "estleg:versionValidTo": {
        "@value": "2012-06-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/927343",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 36",
      "estleg:partOfAct": {
