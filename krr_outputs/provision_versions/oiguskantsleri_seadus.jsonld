      },
      "estleg:versionText": "Õiguskantsler võib nõuda käesoleva seaduse §-s 20 osundatud asutustelt kirjaliku seletuse andmist avalduse asjas. Vastav asutus peab nõude täitma õiguskantsleri poolt määratud tähtaja jooksul.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_28 (redaktsioon 262599)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "262599",
