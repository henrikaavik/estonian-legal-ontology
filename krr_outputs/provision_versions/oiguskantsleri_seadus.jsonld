      },
      "estleg:versionValidFrom": {
        "@value": "2010-05-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "OIGUSK_Par_16 (redaktsioon 13312103)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13312103",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13312103",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 16",
      "estleg:partOfAct": {
