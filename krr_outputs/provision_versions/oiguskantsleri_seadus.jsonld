      }
    },
    {
      "@id": "estleg:OIGUSK_Par_28_v927343",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsleril on õigus nõuda oma ülesannete täitmiseks vajalikku teavet. Järelevalvealune asutus, lepitusmenetluse pooled ning muud isikud ja asutused edastavad teabe õiguskantsleri määratud tähtaja jooksul.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_28 (redaktsioon 927343)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "927343",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/927343",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 28",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_29_v22447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õiguskantsler võib menetluse käigus võtta suulisi ütlusi kõigilt isikutelt, kelle kohta on andmeid, et nad teavad asjas tähtsust omavaid fakte ning on võimelised nende kohta andma õigeid ütlusi. (2) Suulise ütluse andmisele kutsutud isik on kohustatud ilmuma õiguskantsleri kutse peale.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_29 (redaktsioon 22447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22447",
      "estleg:supersededByVersion": {
        "@id": "estleg:OIGUSK_Par_29_v182889"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22447",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 29",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_29_v182889",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õiguskantsler võib menetluse käigus võtta suulisi ütlusi kõigilt isikutelt, kelle kohta on andmeid, etnadteavad asjas tähtsust omavaid fakte ning on võimelised nende kohta andma õigeid ütlusi. (2) Suulise ütluse andmisele kutsutud isik on kohustatud ilmuma õiguskantsleri kutse peale.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_29 (redaktsioon 182889)",
