      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantsleril on menetluse käigus vaba juurdepääs käesoleva seaduse paragrahvis 20 osundatud asutuste valduses olevatele dokumentidele, materjalidele ja paikadele. Vastavad asutused peavad võimaldama õiguskantslerile tingimusteta ja viivitamatu juurdepääsu kõigile oma valduses olevatele dokumentidele, materjalidele ja paikadele.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_30 (redaktsioon 22447)",
        "@language": "et"
      },
