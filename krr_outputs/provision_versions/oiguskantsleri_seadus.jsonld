      }
    },
    {
      "@id": "estleg:OIGUSK_Par_36_v129052012005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_36"
