      }
    },
    {
      "@id": "estleg:OIGUSK_Par_17_v22447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui õiguskantsler leiab, et õigustloov akt kas täielikult või osaliselt ei vasta põhiseadusele või seadusele, teeb ta akti vastu võtnud organile ettepaneku see akt või selle säte 20 päeva jooksul põhiseaduse ja seadusega kooskõlla viia.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_17 (redaktsioon 22447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22447",
      "estleg:supersededByVersion": {
