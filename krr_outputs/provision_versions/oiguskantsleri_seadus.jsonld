    {
      "@id": "estleg:OIGUSK_Par_15_v22447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus pöörduda avaldusega õiguskantsleri poole seaduse või mõne muu õigustloova akti põhiseadusele ja seadusele vastavuse kontrollimiseks.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_15 (redaktsioon 22447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22447",
      "estleg:supersededByVersion": {
        "@id": "estleg:OIGUSK_Par_15_v129052012005"
      },
      "estleg:versionValidTo": {
        "@value": "2012-06-07",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22447",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 15",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_15_v129052012005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Igaühel on õigus pöörduda avaldusega õiguskantsleri poole seaduse või mõne muu õigustloova akti põhiseadusele ja seadusele vastavuse kontrollimiseks. Avaldaja esitab avalduses põhjendused, milles ta näeb õigusakti vastuolu põhiseaduse või seadusega. (2) Õiguskantsler võib alustada menetlust ka omal algatusel.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_15 (redaktsioon 129052012005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129052012005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129052012005",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 15",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_15_1_v129052012005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_15_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-06-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õiguskantsler vaatab õigustloova akti põhiseadusele ja seadusele vastavuse kontrollimiseks esitatud avalduse läbi käesoleva seaduse 4. peatüki 1. ja 2. jaos sätestatud korras, arvestades käesolevas peatükis sätestatud erisusi. (2) Õiguskantsler võib jätta avalduse läbi vaatamata, kui esineb käesoleva seaduse § 25 lõikes 2 või lõike 3 punktides 1, 2, 4 ja 5 nimetatud asjaolu või kui menetlemiseks puudub oluline avalik huvi.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_15_1 (redaktsioon 129052012005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129052012005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129052012005",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 15_1",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_16_v22447",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantslerile saadetakse kõigi seadusandliku ja täidesaatva riigivõimu ning kohaliku omavalitsuse õigustloovate aktide, jõustumata välislepingute ning kõigi Riigikohtu põhiseaduslikke vaidlusi käsitlevate jõustunud kohtuotsuste, samuti rahvahääletuse korraldamise otsuste ärakirjad kümne päeva jooksul vastavalt nende väljakuulutamisest, vastuvõtmisest, allakirjutamisest või jõustumisest arvates. - jõust. 6.04.2002]",
      "rdfs:label": {
        "@value": "OIGUSK_Par_16 (redaktsioon 22447)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22447",
      "estleg:supersededByVersion": {
        "@id": "estleg:OIGUSK_Par_16_v182889"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22447",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 16",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_16_v182889",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskantslerile saadetakse kõigi seadusandliku ja täidesaatva riigivõimu ning kohaliku omavalitsuse õigustloovate aktide, jõustumata välislepingute ning kõigi Riigikohtu põhiseaduslikke vaidlusi käsitlevate jõustunud kohtuotsuste, samuti rahvahääletuse korraldamise otsuste ärakirjad kümne päeva jooksul vastavalt nende väljakuulutamisest, vastuvõtmisest, allakirjutamisest või jõustumisest arvates.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_16 (redaktsioon 182889)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182889",
