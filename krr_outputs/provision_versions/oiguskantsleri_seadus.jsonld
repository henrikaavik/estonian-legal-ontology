    {
      "@id": "estleg:OIGUSK_Par_19_v264575",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Igaühel on õigus pöörduda õiguskantsleri poole riigiasutuste tegevuse, sealhulgas isikute põhiseaduslike õiguste ja vabaduste tagamise kontrollimiseks.",
      "rdfs:label": {
        "@value": "OIGUSK_Par_19 (redaktsioon 264575)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "264575",
