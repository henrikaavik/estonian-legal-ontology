      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/22447",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 17",
      "estleg:partOfAct": {
        "@id": "estleg:OIGUSK_Map"
      }
    },
    {
      "@id": "estleg:OIGUSK_Par_17_v182889",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:OIGUSK_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui õiguskantsler leiab, etõigustloovakt kas täielikult või osaliselt ei vasta põhiseadusele või seadusele, teeb ta akti vastu võtnud organile ettepaneku see akt või selle säte 20 päeva jooksul põhiseaduse ja seadusega kooskõlla viia.",
      "rdfs:label": {
