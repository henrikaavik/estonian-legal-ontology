      },
      "estleg:versionValidTo": {
        "@value": "2010-05-12",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/182889",
      "estleg:sourceAct": "Õiguskantsleri seadus",
      "estleg:provisionRef": "OIGUSK § 16",
      "estleg:partOfAct": {
