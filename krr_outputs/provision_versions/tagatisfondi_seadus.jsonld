        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondil on õigus saada Inspektsioonilt, fondiosalistelt, fondiosalistega samasse konsolideerimisgruppi kuuluvatelt äriühingutelt, registripidajalt, pensionifondi depoopangalt, hoiustajatelt, investoritelt, osakuomanikelt ning käesoleva seaduse § 38 lõikes 1 ja § 57 lõikes 1 nimetatud halduritelt andmeid ulatuses, mis on vajalik Fondi kohustuste täitmiseks. (2) hoiuste tagamise osafondi osas Eesti Panga presidendi poolt kehtestatud ulatuses ja korras;",
      "rdfs:label": {
        "@value": "TFS_Par_92 (redaktsioon 960904)",
