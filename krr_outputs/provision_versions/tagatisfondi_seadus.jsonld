      }
    },
    {
      "@id": "estleg:TFS_Par_9_v182911",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu volituste tähtaeg on neli aastat, alates nõukogu esimese koosoleku päevast. (2) Volituste tähtaja lõppemisel jätkab nõukogu oma tegevust kuni nõukogu uue koosseisu esimese koosolekuni. Nimetatud perioodil hoidub nõukogu vältimatu vajaduseta käesoleva seaduse § 6 lõike 2 punktides 1, 2, 4¿6, 8¿10, 12¿14 ja 16 nimetatud otsuste tegemisest.",
      "rdfs:label": {
        "@value": "TFS_Par_9 (redaktsioon 182911)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "182911",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_9_v230638"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_9_v230638",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu volituste tähtaeg on neli aastat, alates nõukogu esimese koosoleku päevast. (2) Volituste tähtaja lõppemisel jätkab nõukogu oma tegevust kuni nõukogu uue koosseisu esimese koosolekuni. Nimetatud perioodil hoidub nõukogu vältimatu vajaduseta käesoleva seaduse § 6 lõike 2 punktides 1, 2, 4-6, 8-10, 12-14 ja 16 nimetatud otsuste tegemisest.",
      "rdfs:label": {
        "@value": "TFS_Par_9 (redaktsioon 230638)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "230638",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_9_v121122010024"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_9_v121122010024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu volituste tähtaeg on neli aastat, alates nõukogu esimese koosoleku päevast. (2) Volituste tähtaja lõppemisel jätkab nõukogu oma tegevust kuni nõukogu uue koosseisu esimese koosolekuni. Nimetatud perioodil hoidub nõukogu vältimatu vajaduseta käesoleva seaduse § 6 lõike 2 punktides 1, 2, 4–6, 8–10, 12–14 ja 16 nimetatud otsuste tegemisest.",
      "rdfs:label": {
        "@value": "TFS_Par_9 (redaktsioon 121122010024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010024",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_9_v124032011015"
      },
      "estleg:versionValidTo": {
        "@value": "2011-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_9_v124032011015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu volituste tähtaeg on neli aastat alates nõukogu esimese koosoleku toimumise päevast. Nimetatud nelja-aastast volituste tähtaega kohaldatakse käesoleva seaduse § 7 lõike 1 punktides 2–8 nimetatud nõukogu liikmetele. (2) Riigikogu poolt nimetatud nõukogu liikme volitused kestavad kuni Riigikogu liikme volituste peatumise või lõppemiseni. Nimetatud nõukogu liige jätkab oma tegevust kuni uue nõukogu liikme nimetamiseni Riigikogu poolt. (3) Nõukogu volituste tähtaja lõppemisel jätkab nõukogu oma tegevust kuni nõukogu uue koosseisu esimese koosolekuni. Nimetatud perioodil hoidub nõukogu vältimatu vajaduseta käesoleva seaduse § 6 lõike 2 punktides 1, 2, 4–6, 8–10, 12–14 ja 16 nimetatud otsuste tegemisest (4) Nõukogu uus koosseis on uute, käesoleva seaduse § 7 lõike 1 punktides 2–8 nimetatud nõukogu liikmete nimetamise tulemusel pärast eelmise nõukogu volituste tähtaja möödumist kujunenud nõukogu koosseis.",
      "rdfs:label": {
        "@value": "TFS_Par_9 (redaktsioon 124032011015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "124032011015"
    },
    {
      "@id": "estleg:TFS_Par_90_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_90"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondi kontrollivad Riigikontroll ja audiitor.",
      "rdfs:label": {
        "@value": "TFS_Par_90 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774"
    },
    {
      "@id": "estleg:TFS_Par_91_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu nimetab Fondi tegevuse kontrollimiseks ning majandusaasta aruande õigsusele hinnangu andmiseks rahvusvaheliselt tunnustatud audiitori. (2) Audiitori võib nimetada ühekordseks kontrollimiseks või teatud tähtajaks. (3) Fondi audiitoriks ei või olla Fondi, fondiosalise ega fondiosalisega samasse konsolideerimisgruppi kuuluva äriühingu nõukogu või juhatuse liige ega töötaja.",
      "rdfs:label": {
        "@value": "TFS_Par_91 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774"
    },
    {
      "@id": "estleg:TFS_Par_92_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_92"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fondil on õigus saada Inspektsioonilt, fondiosalistelt, fondiosalistega samasse konsolideerimisgruppi kuuluvatelt äriühingutelt, registripidajalt, pensionifondi depoopangalt, hoiustajatelt, investoritelt, osakuomanikelt ning käesoleva seaduse § 38 lõikes 1 ja § 57 lõikes 1 nimetatud halduritelt andmeid ulatuses, mis on vajalik Fondi kohustuste täitmiseks. (2) Fondiosalised ning käesoleva seaduse § 38 lõikes 1 ja § 57 lõikes 1 nimetatud haldurid on kohustatud esitama Fondile Inspektsiooni kaudu aruandeid: hoiuste tagamise osafondi osas Eesti Panga presidendi poolt kehtestatud ulatuses ja korras; investorikaitse osafondi ja pensionikaitse osafondi osas rahandusministri poolt kehtestatud ulatuses ja korras.",
      "rdfs:label": {
        "@value": "TFS_Par_92 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_92_v960904"
      },
      "estleg:versionValidTo": {
        "@value": "2005-11-14",
        "@type": "xsd:date"
      }
    },
