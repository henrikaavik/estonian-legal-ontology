    {
      "@id": "estleg:TFS_Par_47_v835253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_47"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
