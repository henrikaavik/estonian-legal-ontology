      }
    },
    {
      "@id": "estleg:TFS_Par_76_v13064949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osafond moodustub: käesoleva seaduse kohaselt krediidiasutuste, investeerimisasutuste, pensionifondivalitsejate ja kindlustusandjate (kõik koos edaspidi fondiosalised ) tasutavatest osamaksetest; käesoleva seaduse § 77 alusel tasumisele kuuluvatest viivistest; osamaksete ja osafondi muu vara paigutamisest saadavast tulust; tulust, mis saadakse osafondi vara kasutamisel teise osafondi kohustuste täitmiseks käesoleva seaduse § 86 lõike 2 kohaselt; käesoleva seaduse § 78 lõigetes 1 ja 1 1 nimetatud nõudeõiguse alusel laekuvast rahast; käesoleva seaduse § 41 lõike 3 ja § 60 lõike 4 kohaselt hoiustatud ning § 73 lõike 4 alusel tagastatavast rahast.",
      "rdfs:label": {
        "@value": "TFS_Par_76 (redaktsioon 13064949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13064949",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_76_v121122010024"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_76_v121122010024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osafond moodustub: käesoleva seaduse kohaselt krediidiasutuste, investeerimisasutuste, pensionifondivalitsejate ja kindlustusandjate (kõik koos edaspidi fondiosalised) tasutavatest osamaksetest; käesoleva seaduse § 77 alusel tasumisele kuuluvatest viivistest; osamaksete ja osafondi muu vara paigutamisest saadavast tulust; tulust, mis saadakse osafondi vara kasutamisel teise osafondi kohustuste täitmiseks käesoleva seaduse § 86 lõike 2 kohaselt; käesoleva seaduse § 78 lõigetes 1 ja 11 nimetatud nõudeõiguse alusel laekuvast rahast; käesoleva seaduse § 41 lõike 3 ja § 60 lõike 4 kohaselt hoiustatud ning § 73 lõike 4 alusel tagastatavast rahast.",
      "rdfs:label": {
        "@value": "TFS_Par_76 (redaktsioon 121122010024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010024"
    },
    {
      "@id": "estleg:TFS_Par_77_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondiosalise poolt käesoleva seaduse §-s 33, 34, 51, 52, 66 või 67 sätestatud tähtpäevaks osamakse tasumata jätmise või osalise tasumise korral arvestab Fond viivist tasumata summalt 0,2 protsenti päevas.",
      "rdfs:label": {
        "@value": "TFS_Par_77 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_77_v13064949"
      },
      "estleg:versionValidTo": {
        "@value": "2008-11-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_77_v13064949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondiosalise poolt käesoleva seaduse §-s 33, 34, 51, 52, 66, 67, 73 6 või 73 7 sätestatud tähtpäevaks osamakse tasumata jätmise või osalise tasumise korral arvestab Fond viivist tasumata summalt 0,2 protsenti päevas.",
      "rdfs:label": {
        "@value": "TFS_Par_77 (redaktsioon 13064949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13064949",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_77_v121122010024"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_77_v121122010024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondiosalise poolt käesoleva seaduse §-s 33, 34, 51, 52, 66, 67, 736 või 737 sätestatud tähtpäevaks osamakse tasumata jätmise või osalise tasumise korral arvestab Fond viivist tasumata summalt 0,2 protsenti päevas.",
      "rdfs:label": {
        "@value": "TFS_Par_77 (redaktsioon 121122010024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010024",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_77_v131122015039"
      },
      "estleg:versionValidTo": {
        "@value": "2016-01-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_77_v131122015039",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-01-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Fondiosalise poolt käesoleva seaduse §-des 33, 34, 361, 51, 52, 66, 67, 736, 737, 7317 ja 7320 sätestatud tähtpäevaks osamakse tasumata jätmise või osalise tasumise korral arvestab Fond viivist tasumata summalt 0,2 protsenti päevas.",
      "rdfs:label": {
        "@value": "TFS_Par_77 (redaktsioon 131122015039)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122015039"
    },
    {
      "@id": "estleg:TFS_Par_78_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hoiustajatele, investoritele, osakuomanikele ning teistele õigustatud isikutele hüvitiste väljamaksmisel läheb nõudeõigus fondiosalise vastu väljamakstud summa ulatuses neilt isikutelt üle Fondile. (2) Fondi poolt hüvitamata õigustatud isikute nõuded fondiosalise vastu kuuluvad rahuldamisele vastavalt pankrotiseadusele (RT 1992, 31, 403; RT I 1997, 18, 302; 1998, 2, 46; 36/37, 552; 1999, 10, 155; 2000, 13, 93; 54, 353; 2001, 56, 336; 82, 488; 93, 565) või muudele seadustele.",
      "rdfs:label": {
        "@value": "TFS_Par_78 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_78_v13064949"
      },
      "estleg:versionValidTo": {
        "@value": "2008-11-13",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_78_v13064949",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-11-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hoiustajatele, investoritele, osakuomanikele ning teistele õigustatud isikutele hüvitiste väljamaksmisel läheb nõudeõigus fondiosalise vastu väljamakstud summa ulatuses neilt isikutelt üle Fondile. (1¹) Pensionilepingute kindlustusportfelli üleandmise toetamisega läheb väljamakstud toetussumma ulatuses kindlustusportfellis sisaldunud pensionilepingute kindlustusvõtjate ja soodustatud isikute nõudeõigus fondiosalise vastu neilt isikutelt üle Fondile. (2) Fondi poolt hüvitamata õigustatud isikute nõuded fondiosalise vastu kuuluvad rahuldamisele vastavalt pankrotiseadusele või muudele seadustele.",
      "rdfs:label": {
        "@value": "TFS_Par_78 (redaktsioon 13064949)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13064949",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_78_v130112022005"
      },
      "estleg:versionValidTo": {
        "@value": "2022-12-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_78_v130112022005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_78"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Hoiustajatele, investoritele, osakuomanikele ning teistele õigustatud isikutele hüvitiste väljamaksmisel läheb nõudeõigus fondiosalise vastu väljamakstud summa ulatuses neilt isikutelt üle Fondile. (1¹) Pensionilepingute kindlustusportfelli üleandmise toetamisega läheb väljamakstud toetussumma ulatuses kindlustusportfellis sisaldunud pensionilepingute kindlustusvõtjate ja soodustatud isikute nõudeõigus fondiosalise vastu neilt isikutelt üle Fondile. (2) Fondi poolt hüvitamata õigustatud isikute nõuded fondiosalise vastu kuuluvad rahuldamisele vastavalt pankrotiseadusele või muudele seadustele. (3) Käesoleva seaduse § 40 lõikes 11 sätestatud juhul tagastab Fond mõistliku aja jooksul krediidiasutusele rahalised vahendid, mis ületavad krediidiasutuste seaduse § 131 lõike 1 punktis 2 sätestatud nõuete summat.",
      "rdfs:label": {
        "@value": "TFS_Par_78 (redaktsioon 130112022005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130112022005"
    },
    {
      "@id": "estleg:TFS_Par_79_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_79"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Fond võib kasutada oma vara hüvitiste maksmiseks käesoleva seaduse kohaselt ning Fondi tegevuskuludeks vastavalt nõukogu kinnitatud eelarvele. (2) Eelarve esitab juhataja nõukogule kinnitamiseks vähemalt 40 päeva enne majandusaasta algust. Eelarves kajastatakse kõik Fondi tulud ja kulud.",
      "rdfs:label": {
        "@value": "TFS_Par_79 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774"
    },
    {
      "@id": "estleg:TFS_Par_8_v27774",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Nõukogu liige peab olema teovõimeline Eesti kodanik, kellel on riiklikult tunnustatud akadeemiline haridus või sellele tasemele vastav haridus, laitmatu eri- ja ärialane reputatsioon ning finants- või avaliku sektori asutuse juhtimiseks vajalikud kogemused. (2) Nõukogu liikmeks ei või nimetada: isikut, kes on eeluurimise või kohtu all süüdistatuna kuriteos, mille eest on seadusega ette nähtud vabadusekaotus, ega isikut, kellel on karistatus ametialases kuriteos või tahtlikult toimepandud muus kuriteos; isikut, kelle varasem õigusvastane tegevus või tegevusetus on põhjustanud äriühingu pankroti, sundlõpetamise või tegevusloa kehtetuks tunnistamise; pankrotivõlgnikku ega isikut, kelle suhtes on kohaldatud ärikeeldu või kellelt on seaduse alusel ära võetud õigus olla ettevõtja. (3) Käesoleva seaduse § 7 lõike 1 punktides 5–7 nimetatud nõukogu liikme vastavust käesolevas seaduses sätestatud nõuetele kontrollib Inspektsioon. Inspektsioonil on õigus nõuda nõukogu liikmelt selleks vajalikke andmeid.",
      "rdfs:label": {
        "@value": "TFS_Par_8 (redaktsioon 27774)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27774",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_8_v182911"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_8_v182911",
