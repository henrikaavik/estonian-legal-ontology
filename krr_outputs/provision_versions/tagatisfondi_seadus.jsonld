        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Osafondi osamaksed on ühekordne ja kvartaliosamakse. (2) Osamaksed tasutakse Fondile. (3) Osamakseid ei tagastata kindlustusandjale ega filiaalile, kui seadusest ei tulene teisiti.",
      "rdfs:label": {
        "@value": "TFS_Par_73_5 (redaktsioon 121122010024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010024"
    },
    {
      "@id": "estleg:TFS_Par_73_6_v121122010024",
      "@type": [
        "owl:NamedIndividual",
