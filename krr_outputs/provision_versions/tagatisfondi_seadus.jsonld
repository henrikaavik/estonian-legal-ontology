      },
      "estleg:versionValidFrom": {
        "@value": "2005-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osafond moodustub: käesoleva seaduse kohaselt krediidiasutuste, investeerimisasutuste või pensionifondivalitsejate (kõik koos edaspidi fondiosalised ) poolt tasutavatest osamaksetest; käesoleva seaduse § 77 alusel tasumisele kuuluvatest viivistest; osamaksete ja osafondi muu vara paigutamisest saadavast tulust; tulust, mis saadakse osafondi vara kasutamisel teise osafondi kohustuste täitmiseks k��esoleva seaduse § 86 lõike 2 kohaselt; käesoleva seaduse § 78 lõikes 1 nimetatud nõudeõiguse alusel laekuvast rahast; käesoleva seaduse § 41 lõike 3 ja § 60 lõike 4 kohaselt hoiustatud ning § 73 lõike 4 alusel tagastatavast rahast.",
      "rdfs:label": {
        "@value": "TFS_Par_76 (redaktsioon 835253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "835253",
