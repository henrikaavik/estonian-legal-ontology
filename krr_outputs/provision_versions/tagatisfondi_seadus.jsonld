      }
    },
    {
      "@id": "estleg:TFS_Par_87_v121122010024",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_87"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui nõukogu otsusel ei piisa osafondi kohustuste täitmiseks käesoleva seaduse § 86 lõikes 2 sätestatud võimalustest, võib nõukogu taotleda riigilt Fondile laenu andmist või riigigarantiid Fondi poolt võetavale laenule. (2) Vabariigi Valitsus võib otsustada Fondile laenu andmise riigieelarves ettenähtud ulatuses.",
      "rdfs:label": {
        "@value": "TFS_Par_87 (redaktsioon 121122010024)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122010024",
      "estleg:supersededByVersion": {
        "@id": "estleg:TFS_Par_87_v129032022007"
      },
      "estleg:versionValidTo": {
        "@value": "2022-04-07",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TFS_Par_87_v129032022007",
      "@type": [
        "owl:NamedIndividual",
