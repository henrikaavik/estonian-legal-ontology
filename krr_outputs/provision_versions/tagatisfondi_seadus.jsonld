      }
    },
    {
      "@id": "estleg:TFS_Par_76_v12763883",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TFS_Par_76"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Osafond moodustub: käesoleva seaduse kohaselt krediidiasutuste, investeerimisasutuste või pensionifondivalitsejate (kõik koos edaspidi fondiosalised ) poolt tasutavatest osamaksetest; käesoleva seaduse § 77 alusel tasumisele kuuluvatest viivistest; osamaksete ja osafondi muu vara paigutamisest saadavast tulust; tulust, mis saadakse osafondi vara kasutamisel teise osafondi kohustuste täitmiseks käesoleva seaduse § 86 lõike 2 kohaselt; käesoleva seaduse § 78 lõikes 1 nimetatud nõudeõiguse alusel laekuvast rahast; käesoleva seaduse § 41 lõike 3 ja § 60 lõike 4 kohaselt hoiustatud ning § 73 lõike 4 alusel tagastatavast rahast.",
      "rdfs:label": {
        "@value": "TFS_Par_76 (redaktsioon 12763883)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12763883",
