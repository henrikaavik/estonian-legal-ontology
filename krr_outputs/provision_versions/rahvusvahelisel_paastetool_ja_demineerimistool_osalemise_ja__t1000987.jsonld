      "estleg:sourceAct": "Rahvusvahelisel päästetööl ja demineerimistööl osalemise ja kulude katmise kord",
      "estleg:provisionRef": "Reg_1000987 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000987_Map"
      }
    },
    {
      "@id": "estleg:Reg_1000987_Par_3_v1000987",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1000987_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-05-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Missioonil osalemiseks moodustatakse reservis olevatest ekspertidest meeskond. Missioonil osalemiseks moodustatakse reservis olevatest ekspertidest meeskond. 2 (2) Meeskonna nimetus on Eesti päästemeeskond; inglise keeles Estonian Disaster Relief Team (EDRT). Meeskonna nimetust võib kasutada ka missioonil osalev üks ekspert. Meeskonna nimetus on Eesti päästemeeskond; inglise keeles Estonian Disaster Relief Team (EDRT). Meeskonna nimetust võib kasutada ka missioonil osalev üks ekspert. 3 (3) Meeskonna ülesandeks on teha päästetöid ja demineerimistöid vastavalt missiooni eesmärkidele. Meeskonna ülesandeks on teha päästetöid ja demineerimistöid vastavalt missiooni eesmärkidele. 4 (4) Meeskonna ja eksperdi missiooniks valmistumist ja missioonil osalemist korraldab Päästeamet, kaasates vajaduse korral teisi ametiasutusi. Meeskonna ja eksperdi missiooniks valmistumist ja missioonil osalemist korraldab Päästeamet, kaasates vajaduse korral teisi ametiasutusi.",
      "rdfs:label": {
        "@value": "Reg_1000987_Par_3 (redaktsioon 1000987)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1000987",
