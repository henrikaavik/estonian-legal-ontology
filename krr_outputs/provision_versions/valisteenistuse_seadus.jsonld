      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_37_v126032013018",
      "@type": [
        "owl:NamedIndividual",
