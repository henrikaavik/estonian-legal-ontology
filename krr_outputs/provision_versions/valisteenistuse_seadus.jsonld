      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Avalik konkurss vabale ametikohale kuulutatakse välja meedias ning Välisministeeriumi veebilehel.",
      "rdfs:label": {
        "@value": "VALIST_Par_87 (redaktsioon 12750525)",
