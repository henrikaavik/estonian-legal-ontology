      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALIST_Par_60 (redaktsioon 127092024002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127092024002"
    },
    {
      "@id": "estleg:VALIST_Par_61_v12750525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_61"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Diplomaatilise teenistusastmega karjääridiplomaadile makstakse välisteenistuses oleku ajal igal kuul diplomaatilise teenistusastme tasu. (2) Diplomaatilise auastmega karjääridiplomaadile makstakse välisteenistuses oleku ajal igal kuul diplomaatilise auastme tasu. (3) Käesoleva seaduse § 60 lõigetes 2–4 nimetatud juhtudel diplomaatilise au- ega teenistusastme tasu ei maksta. (4) Diplomaatilise au- ja teenistusastme tasu maksmise korra ning tasu määrad",
      "rdfs:label": {
        "@value": "VALIST_Par_61 (redaktsioon 12750525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750525",
