      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 80 lõike 2 punktides 1–3 ja 5 nimetatud otsustest teatatakse Välisministeeriumi koosseisulistele ja koosseisuvälistele teenistujatele.",
