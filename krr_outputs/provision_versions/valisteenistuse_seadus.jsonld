        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Konkursikomisjoni esimees on Välisministeeriumi kantsler. (2) Konkursikomisjoni aseesimees on Välisministeeriumi personaliosakonna peadirektor.",
      "rdfs:label": {
        "@value": "VALIST_Par_81 (redaktsioon 127092024002)",
        "@language": "et"
