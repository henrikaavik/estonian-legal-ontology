    {
      "@id": "estleg:VALIST_Par_5_v22311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisministeeriumi diplomaatilise koosseisu ametiastmed on: kantsler - secretairegeneral, permanentundersecretary; osakonna peadirektor - directeurgeneral de departement, directorgeneral of department; büroo direktor - directeur de bureau, director of division; nõunik - conseiller, counsellor; ministeeriumi esimene (I) sekretär - premiersecretaire de ministere, firstsecretary of ministry; ministeeriumi teine (II) sekretär - deuxiemesecretaire de ministere, secondsecretary of ministry; ministeeriumi kolmas (III) sekretär - troisiemesecretaire de ministere, thirdsecretary of ministry; ministeeriumi atašee - attache de ministere, attache of ministry.",
      "rdfs:label": {
        "@value": "VALIST_Par_5 (redaktsioon 22311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22311",
