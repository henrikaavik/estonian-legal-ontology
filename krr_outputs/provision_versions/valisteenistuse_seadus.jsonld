        "@value": "2002-10-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_6_v207111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisesinduse diplomaatilise koosseisu ametiastmed on: erakorraline ja täievoliline suursaadik - ambassadeur extraordinaire et plenipotentiaire, ambassador extraordinary and plenipotentiary; minister-nõunik - ministre-conseiller, minister-counsellor; suursaatkonna nõunik - conseiller d'ambassade, counsellor of embassy; suursaatkonna esimene (I) sekretär - premier secretaire d'ambassade, first secretary of embassy; suursaatkonna teine (II) sekretär - deuxieme secretaire d'ambassade, second secretary of embassy; suursaatkonna kolmas (III) sekretär - troisieme secretaire d'ambassade, third secretary of embassy; suursaatkonna atašee - attache d'ambassade, attache of embassy. (2) Välisesinduse konsulaarkoosseisu ametiastmed on: peakonsul - consul general, consul general; konsul - consul; asekonsul - vice-consul.",
      "rdfs:label": {
        "@value": "VALIST_Par_6 (redaktsioon 207111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207111",
      "estleg:supersededByVersion": {
