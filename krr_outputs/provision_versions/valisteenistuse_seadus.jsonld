        "@id": "estleg:VALIST_Par_23_v127092024002"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_23_v127092024002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Diplomaatilise auastme võib ära võtta Vabariigi President, kui diplomaat on kriminaalkorras karistatud või distsiplinaarsüüteo eest teenistusest vabastatud. (2) Vabariigi Presidendile teeb diplomaatilise auastme äravõtmise ettepaneku Vabariigi Valitsus. Sellekohase taotluse esitab Vabariigi Valitsusele valdkonna eest vastutav minister konkursikomisjoni ettepanekul.",
      "rdfs:label": {
        "@value": "VALIST_Par_23 (redaktsioon 127092024002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127092024002"
    },
    {
      "@id": "estleg:VALIST_Par_24_v22311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistustasu makstakse diplomaadile välisesinduses töötamise ajal Vabariigi Valitsuse poolt kehtestatud ulatuses ja korras.",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 22311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22311",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_24_v207111"
      },
      "estleg:versionValidTo": {
        "@value": "2002-10-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_24_v207111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistustasu makstakse diplomaadile välisesinduses töötamise ajal",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 207111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207111",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_24_v12750525"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_24_v12750525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistusse võib võtta isiku: kellel on Eesti kodakondsus; kellel on kõrgharidus; kes valdab vähemalt kahte võõrkeelt, millest üks on inglise või prantsuse keel, kelle majanduslikud või muud kohustused ei takista välisteenistuses olemist; kelle tervis võimaldab töötada välisteenistuses; kes on ustav Eesti põhiseaduslikule korrale, kaitseb Eesti iseseisvust ning on oma tegevuses korrektne ja väärikas, hoides kõrgel Eesti rahvusvahelist mainet.",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 12750525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750525",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_24_v126032013018"
      },
      "estleg:versionValidTo": {
        "@value": "2013-03-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_24_v126032013018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistusse võib võtta isiku: kellel on Eesti kodakondsus; kellel on kõrgharidus; kes valdab vähemalt kahte võõrkeelt, millest üks on inglise või prantsuse keel, , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"välisministri\" sõnadega \"valdkonna eest vastutava ministri\". kelle majanduslikud või muud kohustused ei takista välisteenistuses olemist; kelle tervis võimaldab töötada välisteenistuses; kes on ustav Eesti põhiseaduslikule korrale, kaitseb Eesti iseseisvust ning on oma tegevuses korrektne ja väärikas, hoides kõrgel Eesti rahvusvahelist mainet.",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 126032013018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "126032013018",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_24_v123032015277"
      },
      "estleg:versionValidTo": {
        "@value": "2015-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_24_v123032015277",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistusse võib võtta isiku: kellel on Eesti kodakondsus; kellel on kõrgharidus; kes valdab vähemalt kahte võõrkeelt, millest üks on inglise või prantsuse keel, kehtestatud ulatuses; kelle majanduslikud või muud kohustused ei takista välisteenistuses olemist; kelle tervis võimaldab töötada välisteenistuses; kes on ustav Eesti põhiseaduslikule korrale, kaitseb Eesti iseseisvust ning on oma tegevuses korrektne ja väärikas, hoides kõrgel Eesti rahvusvahelist mainet.",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 123032015277)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015277",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_24_v108112016005"
      },
      "estleg:versionValidTo": {
        "@value": "2016-11-17",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_24_v108112016005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisteenistusse võib võtta isiku: kellel on Eesti kodakondsus; kellel on kõrgharidus; kes valdab vähemalt kahte võõrkeelt, millest üks on inglise või prantsuse keel, kehtestatud ulatuses; kelle majanduslikud või muud kohustused ei takista välisteenistuses olemist; kelle tervis võimaldab töötada välisteenistuses; kes on ustav Eesti põhiseaduslikule korrale, kaitseb Eesti iseseisvust ning on oma tegevuses korrektne ja väärikas, hoides kõrgel Eesti rahvusvahelist mainet. (2) Erialadiplomaadile ei kohaldata käesoleva paragrahvi lõike 1 punktis 3 sätestatud nõuet. Erialadiplomaadiks võib välisteenistusse võtta isiku, kes valdab inglise keelt valdkonna eest vastutava ministri kehtestatud ulatuses.",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 108112016005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108112016005",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_24_v127092024002"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_24_v127092024002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisteenistusse võib võtta avaliku teenistuse seaduse §-s 14 sätestatud nõuetele vastava isiku: kehtetu - kellel on kõrgharidus; kehtetu - kelle majanduslikud või muud kohustused ei takista välisteenistuses olemist; kelle tervis võimaldab töötada välisteenistuses; kes on ustav Eesti põhiseaduslikule korrale, kaitseb Eesti iseseisvust ning on oma tegevuses korrektne ja väärikas, hoides kõrgel Eesti rahvusvahelist mainet. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "VALIST_Par_24 (redaktsioon 127092024002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127092024002"
    },
    {
      "@id": "estleg:VALIST_Par_25_v22311",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisteenistusse võtmisel ja iga järgneva teenistusaasta algul makstakse diplomaadile esindustasu kahe kuu ametipalga ulatuses. Esindustasu ei kuulu maksustamisele.",
      "rdfs:label": {
        "@value": "VALIST_Par_25 (redaktsioon 22311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22311",
      "estleg:supersededByVersion": {
        "@id": "estleg:VALIST_Par_25_v12750525"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_25_v12750525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Välisteenistusse võtmise alus on atesteerimiskomisjoni ettepanek. (2) Isik võetakse välisteenistusse karjääridiplomaadiks, andes talle teenistusastme välisministri käskkirjaga selles märgitud kuupäeval. (3) Isik võetakse välisteenistusse erialadiplomaadiks välisesindusse lähetamise ajaks Välisministeeriumi kantsleri käskkirjaga.",
      "rdfs:label": {
        "@value": "VALIST_Par_25 (redaktsioon 12750525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750525",
