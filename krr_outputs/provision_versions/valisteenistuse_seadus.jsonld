        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisesinduses töötava teenistuja kasutuses oleva eluruumi suuruse normid, selle andmise ning kulude hüvitamise alused ja korra ning eluruumi taotluse vormi",
      "rdfs:label": {
        "@value": "VALIST_Par_64 (redaktsioon 12750525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750525",
      "estleg:supersededByVersion": {
