        "@value": "2009-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Peakonsuli, konsuli ja asekonsuli nimetab välisesinduse juhiks välisminister atesteerimiskomisjoni ettepanekul ning konsulaarseaduses sätestatut arvestades.",
      "rdfs:label": {
        "@value": "VALIST_Par_37 (redaktsioon 13197276)",
        "@language": "et"
      },
