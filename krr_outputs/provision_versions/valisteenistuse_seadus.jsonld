      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_60_v127092024002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
