      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VALIST_Par_23_v12750525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Diplomaatilise auastme võib ära võtta Vabariigi President, kui diplomaat on kriminaalkorras karistatud. (2) Vabariigi Presidendile teeb diplomaatilise auastme äravõtmise ettepaneku Vabariigi Valitsus. Sellekohase taotluse esitab Vabariigi Valitsusele välisminister atesteerimiskomisjoni ettepanekul.",
      "rdfs:label": {
        "@value": "VALIST_Par_23 (redaktsioon 12750525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750525",
