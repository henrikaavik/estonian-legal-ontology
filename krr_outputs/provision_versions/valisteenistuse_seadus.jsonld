      }
    },
    {
      "@id": "estleg:VALIST_Par_5_v207111",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Välisministeeriumi diplomaatilise koosseisu ametiastmed on: kantsler – secrétaire général; permanent under-secretary; asekantsler – secrétaire général adjoint; deputy under-secretary; osakonna peadirektor – directeur général de département; director general of department; büroo direktor – directeur de bureau; director of division; nõunik – conseiller; counsellor; ministeeriumi esimene (I) sekretär – premier secrétaire de ministère; first secretary of ministry; ministeeriumi teine (II) sekretär – deuxième secrétaire de ministère; second secretary of ministry; ministeeriumi kolmas (III) sekretär – troisième secrétaire de ministère; third secretary of ministry; ministeeriumi atašee – attaché de ministère; attaché of ministry.",
      "rdfs:label": {
        "@value": "VALIST_Par_5 (redaktsioon 207111)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207111",
