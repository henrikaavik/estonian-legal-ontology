      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VALIST_Par_76 (redaktsioon 127092024002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127092024002"
    },
    {
      "@id": "estleg:VALIST_Par_77_v12750525",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VALIST_Par_77"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Karjääridiplomaadile määratavad distsiplinaarkaristused on: noomitus; ametipalga vähendamine 10–30% kuni kolmeks kuuks; diplomaatilise teenistusastme madaldamine kuni kahe astme võrra; teenistusest vabastamine avaliku teenistuse seaduse § 118 alusel.",
      "rdfs:label": {
        "@value": "VALIST_Par_77 (redaktsioon 12750525)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12750525",
