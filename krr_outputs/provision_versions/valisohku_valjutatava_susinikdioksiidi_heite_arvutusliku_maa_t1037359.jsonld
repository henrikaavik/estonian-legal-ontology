      "estleg:sourceAct": "Välisõhku väljutatava süsinikdioksiidi heite arvutusliku määramise meetodid",
      "estleg:provisionRef": "Reg_1037359 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037359_Map"
      }
