      "estleg:versionText": "Kütuste oksüdatsioonitegur on 1. RT I 2019-03-08 5 108032019005 2019-03-11 Kütuste oksüdatsioonitegur on 1.",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_8 (redaktsioon 1037359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037359",
