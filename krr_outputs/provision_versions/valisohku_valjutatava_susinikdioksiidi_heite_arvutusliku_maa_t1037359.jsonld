    {
      "@id": "estleg:Reg_1037359_Par_2_v1037359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037359_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Standardmeetodiga määratakse CO2-heide järgmiselt: 1 1) arvutatakse kütusekulu; 2 2) kütusekulu arvutatakse ümber ühtsesse mõõtsüsteemi energiaühikule; 3 3) leitakse kütuse eriheide määruse lisast 2 või arvutatakse kütuse süsinikusisalduse ja kütteväärtuse järgi; 4 4) määratakse kütuse oksüdatsioonitegur ja arvutatakse kütuse süsinikuheide; 5 5) arvutatakse kütuse süsinikuheite alusel välisõhku väljutatav CO2-heide; 6 6) leitakse käitise välisõhku väljutatav CO2-heide, summeerides kõigist põletatud kütuseliikidest väljutatud CO2-heited. RT I 2019-03-08 5 108032019005 2019-03-11 Standardmeetodiga määratakse CO2-heide järgmiselt: arvutatakse kütusekulu; kütusekulu arvutatakse ümber ühtsesse mõõtsüsteemi energiaühikule; leitakse kütuse eriheide määruse lisast 2 või arvutatakse kütuse süsinikusisalduse ja kütteväärtuse järgi; määratakse kütuse oksüdatsioonitegur ja arvutatakse kütuse süsinikuheide; arvutatakse kütuse süsinikuheite alusel välisõhku väljutatav CO2-heide; leitakse käitise välisõhku väljutatav CO2-heide, summeerides kõigist põletatud kütuseliikidest väljutatud CO2-heited.",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_2 (redaktsioon 1037359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037359",
      "estleg:sourceAct": "Välisõhku väljutatava süsinikdioksiidi heite arvutusliku määramise meetodid",
      "estleg:provisionRef": "Reg_1037359 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037359_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037359_Par_2_2_v1037359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037359_Par_2_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Massibilansi meetodiga määratakse CO2-heide järgmiselt: 1 1) määratakse massibilansiga hõlmatud sisendvood ja väljundvood (kütused ja materjalid); 2 2) määratakse sisend- ja väljundvoogude kogused; 3 3) määratakse sisend- ja väljundvoogude süsinikusisaldus; 4 4) leitakse iga sisend- ja väljundvoo jaoks määruse lisas 2 esitatud süsiniku eriheide või arvutatakse see vastava sisend- või väljundvoo süsinikusisalduse järgi; 5 5) määratakse iga sisend- ja väljundvoo jaoks oksüdatsioonitegur ning arvutatakse iga sisend- ja väljundvoo süsinikuheide; 6 6) arvutatakse iga sisend- ja väljundvoo süsinikuheite alusel iga sisend- ja väljundvoo CO2-heide; 7 7) arvutatakse käitise välisõhku väljutatav CO2-heide, lahutades kõikide sisendvoogude CO2‑heidete summast maha kõikide väljundvoogude CO2-heidete summa. RT I 2019-03-08 5 108032019005 2019-03-11 Massibilansi meetodiga määratakse CO2-heide järgmiselt: määratakse massibilansiga hõlmatud sisendvood ja väljundvood (kütused ja materjalid); määratakse sisend- ja väljundvoogude kogused; määratakse sisend- ja väljundvoogude süsinikusisaldus; leitakse iga sisend- ja väljundvoo jaoks määruse lisas 2 esitatud süsiniku eriheide või arvutatakse see vastava sisend- või väljundvoo süsinikusisalduse järgi; määratakse iga sisend- ja väljundvoo jaoks oksüdatsioonitegur ning arvutatakse iga sisend- ja väljundvoo süsinikuheide; arvutatakse iga sisend- ja väljundvoo süsinikuheite alusel iga sisend- ja väljundvoo CO2-heide; arvutatakse käitise välisõhku väljutatav CO2-heide, lahutades kõikide sisendvoogude CO2‑heidete summast maha kõikide väljundvoogude CO2-heidete summa.",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_2_2 (redaktsioon 1037359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037359",
      "estleg:sourceAct": "Välisõhku väljutatava süsinikdioksiidi heite arvutusliku määramise meetodid",
      "estleg:provisionRef": "Reg_1037359 § 2_2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037359_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037359_Par_3_v1037359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037359_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kütusekulu arvutatakse ümber teradžaulidesse (TJ), kasutades määruse lisas 1 esitatud energiaühikute ümberarvutuse vahekordi ja järgmist valemit: Kütusekulu arvutatakse ümber teradžaulidesse (TJ), kasutades määruse lisas 1 esitatud energiaühikute ümberarvutuse vahekordi ja järgmist valemit: B1 = B × Qr i × n, kus B1 – ümberarvutatud kütusekulu, TJ;B – kütusekulu, kg;Qr i – kütuse kütteväärtus, MJ/kg; n – suhtarv määruse lisast 1. RT I 2019-03-08 5 108032019005 2019-03-11 B1 = B × Qr i × n, kus B1 – ümberarvutatud kütusekulu, TJ;B – kütusekulu, kg;Qr i – kütuse kütteväärtus, MJ/kg; n – suhtarv määruse lisast 1.",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_3 (redaktsioon 1037359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037359",
      "estleg:sourceAct": "Välisõhku väljutatava süsinikdioksiidi heite arvutusliku määramise meetodid",
      "estleg:provisionRef": "Reg_1037359 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037359_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037359_Par_4_v1037359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037359_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Süsiniku eriheide (qc) arvutatakse vedelate ja tahkete kütuste, välja arvatud põlevkivi, süsinikusisalduse järgi, kasutades järgmist valemit: Süsiniku eriheide (qc) arvutatakse vedelate ja tahkete kütuste, välja arvatud põlevkivi, süsinikusisalduse järgi, kasutades järgmist valemit: qc = 10 × Cr i / Qr i , tC/TJ, kus Qr i – kütuse kütteväärtus, MJ/kg; Cr i – kütuse süsinikusisaldus, %. qc = 10 × Cr i / Qr i , tC/TJ, kus Qr i – kütuse kütteväärtus, MJ/kg; Cr i – kütuse süsinikusisaldus, %.",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_4 (redaktsioon 1037359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037359",
      "estleg:sourceAct": "Välisõhku väljutatava süsinikdioksiidi heite arvutusliku määramise meetodid",
      "estleg:provisionRef": "Reg_1037359 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037359_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037359_Par_5_v1037359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037359_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Elektrijaamades Eesti põlevkivi põletamisel ja põlevkivituha ladestamisel tuhaväljadele arvutatakse süsiniku eriheide, kasutades järgmist valemit: Elektrijaamades Eesti põlevkivi põletamisel ja põlevkivituha ladestamisel tuhaväljadele arvutatakse süsiniku eriheide, kasutades järgmist valemit: qcpõlevkivi = 10 [Crpõlevkivi + k(CO2)r M × 0,273] / Qrpõlevkivi, tC/TJ, kus Qrpõlevkivi – põlevkivi kütteväärtus, MJ/kg; Crpõlevkivi – põlevkivi süsinikusisaldus, %; (CO2)r M – põlevkivi mineraalse süsinikdioksiidi sisaldus, %; k – põlevkivi karbonaatide lagunemisastet põlevkivi põletamisel kateldes (kCO2) ja tuhaväljadel CO2 tagasisidumist (ksidumata) arvestavate tegurite korrutis (põlevkivi tolmpõletamisel k = 0,64, põlevkivi keevkihtpõletamisel k = 0,40). qcpõlevkivi = 10 [Crpõlevkivi + k(CO2)r M × 0,273] / Qrpõlevkivi, tC/TJ, kus Qrpõlevkivi – põlevkivi kütteväärtus, MJ/kg; Crpõlevkivi – põlevkivi süsinikusisaldus, %; (CO2)r M – põlevkivi mineraalse süsinikdioksiidi sisaldus, %; k – põlevkivi karbonaatide lagunemisastet põlevkivi põletamisel kateldes (kCO2) ja tuhaväljadel CO2 tagasisidumist (ksidumata) arvestavate tegurite korrutis (põlevkivi tolmpõletamisel k = 0,64, põlevkivi keevkihtpõletamisel k = 0,40).",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_5 (redaktsioon 1037359)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1037359",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1037359",
      "estleg:sourceAct": "Välisõhku väljutatava süsinikdioksiidi heite arvutusliku määramise meetodid",
      "estleg:provisionRef": "Reg_1037359 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037359_Map"
      }
    },
    {
      "@id": "estleg:Reg_1037359_Par_6_v1037359",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1037359_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-05",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maagaasi iseloomustavate näitajatena kasutatakse selle koostist (gaaside CH4, C2H6, C3H8, C4H10, C5H12, CO2, CO mahu%), kütteväärtust (kcal/m3, kJ/m3, MJ/m3) ja tihedust (kg/m3) standardtingimustel (T = 293,15 K, p = 101,3 kPa). Maagaasi süsiniku eriheide arvutatakse, kasutades järgmist valemit: Maagaasi iseloomustavate näitajatena kasutatakse selle koostist (gaaside CH4, C2H6, C3H8, C4H10, C5H12, CO2, CO mahu%), kütteväärtust (kcal/m3, kJ/m3, MJ/m3) ja tihedust (kg/m3) standardtingimustel (T = 293,15 K, p = 101,3 kPa). Maagaasi süsiniku eriheide arvutatakse, kasutades järgmist valemit: qcmaagaas = 10 (0,749 CH4 + 0,799 C2H6 + 0,817 C3H8 + 0,827 C4H10 + 0,832 C5H12 + 0,273 CO2 + 0,429 CO) / Qrmaagaas, tC/TJ, kus Qrmaagaas = Qmaagaas / ρmaagaas, MJ/kg, kusQmaagaas – maagaasi kütteväärtus standardtingimustel (T = 293,15 K, p = 101,3 kPa), MJ/m3;ρmaagaas – maagaasi tihedus standardtingimustel (T = 293,15 K, p = 101,3 kPa), kg/m3. qcmaagaas = 10 (0,749 CH4 + 0,799 C2H6 + 0,817 C3H8 + 0,827 C4H10 + 0,832 C5H12 + 0,273 CO2 + 0,429 CO) / Qrmaagaas, tC/TJ, kus Qrmaagaas = Qmaagaas / ρmaagaas, MJ/kg, kusQmaagaas – maagaasi kütteväärtus standardtingimustel (T = 293,15 K, p = 101,3 kPa), MJ/m3;ρmaagaas – maagaasi tihedus standardtingimustel (T = 293,15 K, p = 101,3 kPa), kg/m3.",
      "rdfs:label": {
        "@value": "Reg_1037359_Par_6 (redaktsioon 1037359)",
        "@language": "et"
      },
