    },
    {
      "@id": "estleg:Reg_1038337_Par_4_v1038337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038337_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas5 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas5 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndite piiri kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1038337_Par_4 (redaktsioon 1038337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038337",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038337",
      "estleg:sourceAct": "Nätsi-Võlla looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038337 § 4",
