    {
      "@id": "estleg:Reg_1038337_Par_14_v1038337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038337_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 28. mai 2015. a käskkirjaga nr 511 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 28. mai 2015. a käskkirjaga nr 511 algatatud haldusmenetluses. Menetluse ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1038337_Par_14 (redaktsioon 1038337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038337",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038337",
      "estleg:sourceAct": "Nätsi-Võlla looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038337 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038337_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038337_Par_15_v1038337",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1038337_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1038337_Par_15 (redaktsioon 1038337)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1038337",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1038337",
      "estleg:sourceAct": "Nätsi-Võlla looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1038337 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038337_Map"
      }
    },
    {
      "@id": "estleg:Reg_1038337_Par_2_v1038337",
      "@type": [
