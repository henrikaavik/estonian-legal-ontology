        "@value": "2017-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1038337_Par_3 (redaktsioon 1038337)",
        "@language": "et"
      },
