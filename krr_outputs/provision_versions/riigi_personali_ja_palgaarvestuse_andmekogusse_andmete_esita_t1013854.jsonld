        "@id": "estleg:Reg_1013854_Map"
      }
    },
    {
      "@id": "estleg:Reg_1013854_Par_15_v1013854",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013854_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolituste arvestamisel lähtutakse avaliku teenistuse seaduse § 10 lõike 1 punkti 3 alusel kehtestatud määrusest, asutuse koolituse korrast ning andmekogus määratud koolituse vormist, liigist ja valdkonnast. Koolituste arvestamisel lähtutakse avaliku teenistuse seaduse § 10 lõike 1 punkti 3 alusel kehtestatud määrusest, asutuse koolituse korrast ning andmekogus määratud koolituse vormist, liigist ja valdkonnast. 2 (2) Arvestust peetakse töötajate läbitud koolituste kohta. Arvestus toimub koolituste kaupa § 6 punktides 16 ja 17 nimetatud kohustuslike andmete alusel. Arvestust peetakse töötajate läbitud koolituste kohta. Arvestus toimub koolituste kaupa § 6 punktides 16 ja 17 nimetatud kohustuslike andmete alusel. 3 (3) Koolituskulude kohta peetakse arvestust otseste ja kaudsete kulude lõikes finantseerimisallikate kaupa. Koolituskulud seotakse koolitusel osalenud töötajaga. Koolituskulude kohta peetakse arvestust otseste ja kaudsete kulude lõikes finantseerimisallikate kaupa. Koolituskulud seotakse koolitusel osalenud töötajaga.",
      "rdfs:label": {
        "@value": "Reg_1013854_Par_15 (redaktsioon 1013854)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013854",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013854",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogusse andmete esitamise ja arvestuse toimingute teostamise kord",
      "estleg:provisionRef": "Reg_1013854 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013854_Map"
      }
    },
    {
      "@id": "estleg:Reg_1013854_Par_16_v1013854",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
