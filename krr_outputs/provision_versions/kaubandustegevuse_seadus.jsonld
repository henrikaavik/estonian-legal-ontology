    {
      "@id": "estleg:KaubTS_Par_33_v715219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KaubTS_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesoleva seaduse §-des 24–32 sätestatud väärtegudele kohaldatakse karistusseadustiku (RT I 2001, 61, 364; 2002, 44, 284; 56, 350; 64, 390; 82, 480; 105, 612; 2003, 4, 22; 83, 557; 90, 601) üldosa ja väärteomenetluse seadustiku (RT I 2002, 50, 313; 110, 654; 2003, 26, 156; 83, 557; 88, 590) sätteid. (2) Käesoleva seaduse §-des 24, 26 ja 32 sätestatud väärtegude kohtuväline menetleja on: Tarbijakaitseamet; Tervisekaitseinspektsioon; politseiprefektuur; valla- või linnavalitsus. (3) Käesoleva seaduse §-s 25 sätestatud väärtegude kohtuväline menetleja on: Tarbijakaitseamet; valla- või linnavalitsus. (4) Käesoleva seaduse §-des 27–29 sätestatud väärtegude kohtuväline menetleja on: Tarbijakaitseamet; politseiprefektuur; valla- või linnavalitsus. (5) Käesoleva seaduse §-des 30 ja 31 sätestatud väärtegude kohtuväline menetleja on: Tarbijakaitseamet; Tervisekaitseinspektsioon; politseiprefektuur.",
      "rdfs:label": {
        "@value": "KaubTS_Par_33 (redaktsioon 715219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715219",
