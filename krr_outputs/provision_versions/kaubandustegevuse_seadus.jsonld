    {
      "@id": "estleg:KaubTS_Par_9_v715219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KaubTS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Arveldamisel võib kauba või teenuse lõpphinda ümardada 10 sendiga täisarvuliselt jaguva summani: ülespoole, kui enne ümardamist oleks kauba või teenuse lõpphind lõppenud viie või enama sendiga; allapoole, kui enne ümardamist oleks kauba või teenuse lõpphind lõppenud vähema kui viie sendiga. (2) Kauba või teenuse eest maksekaardiga tasumise korral peab kaupleja kliendi nõudmisel võimaldama maksekaardi kasutamise kliendi juuresolekul.",
      "rdfs:label": {
        "@value": "KaubTS_Par_9 (redaktsioon 715219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "715219",
