        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on sunniraha asendustäitmise ja sunniraha seaduses sätestatud korras rakendatav sunniraha ülemmäär 640 eurot.",
      "rdfs:label": {
        "@value": "KaubTS_Par_23 (redaktsioon 129062014025)",
        "@language": "et"
