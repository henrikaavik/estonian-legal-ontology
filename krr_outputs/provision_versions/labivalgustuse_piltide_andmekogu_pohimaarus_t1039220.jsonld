        "@id": "estleg:Reg_1039220_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039220_Par_6_v1039220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039220_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordivahendi või kaubakonteineri läbivalgustamist läbivalgustusseadmega. Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordivahendi või kaubakonteineri läbivalgustamist läbivalgustusseadmega.",
      "rdfs:label": {
        "@value": "Reg_1039220_Par_6 (redaktsioon 1039220)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039220",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039220",
      "estleg:sourceAct": "Läbivalgustuse piltide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039220 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039220_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039220_Par_7_v1039220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039220_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogusse kantakse järgmised andmed: 1 1) läbivalgustuse pilt; 2 2) läbivalgustuse teostamise kuupäev; 3 3) läbivalgustuse asukoht; 4 4) kasutatud läbivalgustustehnika andmed; 5 5) transpordivahendi andmed; 6 6) kauba konteineri number; 7 7) skaneeritud kauba saatedokumendid; 8 8) skaneeritud transpordivahendi juhi isikut tõendav dokument või juhiluba, 9 9) kui kaup saadetakse füüsilisse kontrolli seoses salakaubaveo kahtlusega, siis märgitakse andmekogusse füüsilise kontrolli tulemused. Andmekogusse kantakse järgmised andmed: läbivalgustuse pilt; läbivalgustuse teostamise kuupäev; läbivalgustuse asukoht; kasutatud läbivalgustustehnika andmed; transpordivahendi andmed; kauba konteineri number; skaneeritud kauba saatedokumendid; skaneeritud transpordivahendi juhi isikut tõendav dokument või juhiluba, kui kaup saadetakse füüsilisse kontrolli seoses salakaubaveo kahtlusega, siis märgitakse andmekogusse füüsilise kontrolli tulemused.",
      "rdfs:label": {
        "@value": "Reg_1039220_Par_7 (redaktsioon 1039220)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039220",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039220",
      "estleg:sourceAct": "Läbivalgustuse piltide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039220 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039220_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039220_Par_8_v1039220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039220_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu andmete turbeaste on keskmine (M) ja andmekogu turvaklass on K2T1S2. Andmekogu andmete turbeaste on keskmine (M) ja andmekogu turvaklass on K2T1S2.",
      "rdfs:label": {
        "@value": "Reg_1039220_Par_8 (redaktsioon 1039220)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039220",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039220",
      "estleg:sourceAct": "Läbivalgustuse piltide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039220 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039220_Map"
      }
    },
    {
      "@id": "estleg:Reg_1039220_Par_9_v1039220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039220_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Läbivalgustuse piltide andmekogu andmed ei ole avalikud. Andmekogule on juurdepääs Maksu- ja Tolliametil, Politsei- ja Piirivalveametil, Rahapesu Andmebürool, Kaitsepolitseiametil ning Välisluureametil. RT I 2020-12-15 1 115122020001 2021-01-01 Läbivalgustuse piltide andmekogu andmed ei ole avalikud. Andmekogule on juurdepääs Maksu- ja Tolliametil, Politsei- ja Piirivalveametil, Rahapesu Andmebürool, Kaitsepolitseiametil ning Välisluureametil. 2 (2) Läbivalgustuse piltide andmekogu vastutav töötleja võib avaldada andmekogu andmeid teise riigi tolliasutusele liidu õigusakti või välislepingu alusel toimuva tolli- või maksualase koostöö raames. Läbivalgustuse piltide andmekogu vastutav töötleja võib avaldada andmekogu andmeid teise riigi tolliasutusele liidu õigusakti või välislepingu alusel toimuva tolli- või maksualase koostöö raames. 3 (3) Lõikes 2 nimetatud andmevahetust ei teostata § 7 punktides 7 ja 8 nimetatud andmete osas. Lõikes 2 nimetatud andmevahetust ei teostata § 7 punktides 7 ja 8 nimetatud andmete osas.",
      "rdfs:label": {
        "@value": "Reg_1039220_Par_9 (redaktsioon 1039220)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039220",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039220",
      "estleg:sourceAct": "Läbivalgustuse piltide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039220 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039220_Map"
      }
