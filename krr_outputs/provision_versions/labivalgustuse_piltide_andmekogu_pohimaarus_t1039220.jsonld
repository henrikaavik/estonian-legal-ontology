    {
      "@id": "estleg:Reg_1039220_Par_5_v1039220",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1039220_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-12-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu peetakse ühetasandilise elektroonilise andmekoguna. Andmekogu peetakse ühetasandilise elektroonilise andmekoguna. 2 (2) Andmekogu pidamisel kasutatakse automatiseeritud andmetöötlust ja andmed säilitatakse digitaalsel kujul. Andmekogu pidamisel kasutatakse automatiseeritud andmetöötlust ja andmed säilitatakse digitaalsel kujul.",
      "rdfs:label": {
        "@value": "Reg_1039220_Par_5 (redaktsioon 1039220)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1039220",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1039220",
      "estleg:sourceAct": "Läbivalgustuse piltide andmekogu põhimäärus",
      "estleg:provisionRef": "Reg_1039220 § 5",
