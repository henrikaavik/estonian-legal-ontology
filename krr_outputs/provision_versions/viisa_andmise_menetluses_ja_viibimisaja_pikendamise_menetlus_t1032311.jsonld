      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Viisa andmise menetluses ja viibimisaja pikendamise menetluses daktüloskopeerimise kord (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Viisa andmise menetluses ja viibimisaja pikendamise menetluses daktüloskopeerimise kord"
    },
    {
      "@id": "estleg:Reg_1032311_Par_1_v1032311",
      "@type": [
        "owl:NamedIndividual",
