      "estleg:versionValidFrom": {
        "@value": "2023-12-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Daktüloskopeerimisel arvestatakse Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 810/2009, millega kehtestatakse ühenduse viisaeeskiri (viisaeeskiri) (ELT L 243, 15.09.2009, lk 1–58) (edaspidi viisaeeskiri), artiklis 13 daktüloskopeerimisele ja sõrmejäljekujutisele sätestatud nõudeid. Daktüloskopeerimisel arvestatakse Euroopa Parlamendi ja nõukogu määruse (EÜ) nr 810/2009, millega kehtestatakse ühenduse viisaeeskiri (viisaeeskiri) (ELT L 243, 15.09.2009, lk 1–58) (edaspidi viisaeeskiri), artiklis 13 daktüloskopeerimisele ja sõrmejäljekujutisele sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1032311_Par_2 (redaktsioon 1032311)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1032311",
