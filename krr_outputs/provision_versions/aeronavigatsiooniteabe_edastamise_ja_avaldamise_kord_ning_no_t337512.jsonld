      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Aeronavigatsiooniteabe edastamise ja avaldamise kord ning nõuded aeronavigatsioonimõõdistustele (11 versiooni)",
        "@language": "et"
      },
      "dc:source": "Aeronavigatsiooniteabe edastamise ja avaldamise kord ning nõuded aeronavigatsioonimõõdistustele"
    },
    {
      "@id": "estleg:Reg_337512_Par_1_v337512",
      "@type": [
        "owl:NamedIndividual",
