      "estleg:sourceAct": "Aeronavigatsiooniteabe edastamise ja avaldamise kord ning nõuded aeronavigatsioonimõõdistustele",
      "estleg:provisionRef": "Reg_337512 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_337512_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_337512_Par_7_v337512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337512_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lennuvälja või kopteriväljaku käitaja peab tagama aeronavigatsiooniteabe õigeaegse kättesaadavuse lennutegevusega seotud personalile ja teenistustele. Lennuvälja või kopteriväljaku käitaja peab tagama aeronavigatsiooniteabe õigeaegse kättesaadavuse lennutegevusega seotud personalile ja teenistustele.",
      "rdfs:label": {
