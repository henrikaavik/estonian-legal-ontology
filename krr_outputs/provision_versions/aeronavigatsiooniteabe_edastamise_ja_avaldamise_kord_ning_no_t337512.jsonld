      }
    },
    {
      "@id": "estleg:Reg_337512_Par_8_v337512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337512_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Aeronavigatsiooniteabes kasutatavad geodeetilist laiust ja pikkust määratlevad geodeetilised koordinaadid tuleb avaldada Maailma Geodeetilise Süsteemi 1984 (WGS-84 – World Geodetic System) referentssüsteemis. Aeronavigatsiooniteabes kasutatavad geodeetilist laiust ja pikkust määratlevad geodeetilised koordinaadid tuleb avaldada Maailma Geodeetilise Süsteemi 1984 (WGS-84 – World Geodetic System) referentssüsteemis. 2 (2) Geodeetilisi koordinaate võib aeronavigatsiooniteenuse osutaja avaldada aeronavigatsiooniteabena pärast nende kandmist Transpordiameti poolt peetavasse lennuliikluse geodeetiliste andmete registrisse. RT I 2023-07-05 7 105072023007 2023-07-08 Geodeetilisi koordinaate võib aeronavigatsiooniteenuse osutaja avaldada aeronavigatsiooniteabena pärast nende kandmist Transpordiameti poolt peetavasse lennuliikluse geodeetiliste andmete registrisse.",
      "rdfs:label": {
        "@value": "Reg_337512_Par_8 (redaktsioon 337512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337512",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/337512",
      "estleg:sourceAct": "Aeronavigatsiooniteabe edastamise ja avaldamise kord ning nõuded aeronavigatsioonimõõdistustele",
      "estleg:provisionRef": "Reg_337512 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_337512_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_337512_Par_9_v337512",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_337512_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-06-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Aeronavigatsiooniteabes kasutatakse vertikaalse referentssüsteemina keskmise merepinna (Mean Sea Level – MSL) kõrgussüsteemi, mis väljendub gravitatsioonilise kõrgustasandina geoidi tasapinnast. Geoidi mudelina kasutatakse Maa Gravitatsioonimudelit 1996 (EGM–96 – Earth Gravitational Model 1996). Aeronavigatsiooniteabes kasutatakse vertikaalse referentssüsteemina keskmise merepinna (Mean Sea Level – MSL) kõrgussüsteemi, mis väljendub gravitatsioonilise kõrgustasandina geoidi tasapinnast. Geoidi mudelina kasutatakse Maa Gravitatsioonimudelit 1996 (EGM–96 – Earth Gravitational Model 1996).",
      "rdfs:label": {
        "@value": "Reg_337512_Par_9 (redaktsioon 337512)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "337512",
