      }
    },
    {
      "@id": "estleg:Reg_158494_Par_30_v158494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158494_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määruse § 2 lõigetes 1–9, § 4 lõikes 1, § 7 lõikes 5, § 8 lõike 1 punktis 3 ja § 8 lõikes 2 sätestatud nõudeid rakendatakse enne käesoleva määruse jõustumist tegutsenud veterinaarapteegile alates 2006. a 1. märtsist. Määruse § 2 lõigetes 1–9, § 4 lõikes 1, § 7 lõikes 5, § 8 lõike 1 punktis 3 ja § 8 lõikes 2 sätestatud nõudeid rakendatakse enne käesoleva määruse jõustumist tegutsenud veterinaarapteegile alates 2006. a 1. märtsist. 2 (2) Määruse § 3 lõikes 2 sätestatud nõudeid rakendatakse enne käesoleva määruse jõustumist tegutsenud haiglaapteegile alates 2006. aasta 1. jaanuarist. Määruse § 3 lõikes 2 sätestatud nõudeid rakendatakse enne käesoleva määruse jõustumist tegutsenud haiglaapteegile alates 2006. aasta 1. jaanuarist. 3 (3) Määrus jõustub 2005. a 1. märtsil. Määrus jõustub 2005. a 1. märtsil. 4 (4) Määruse § 27 lõike 1 punkti 6 kohaselt üldapteegi aruandes nõutud personaalselt jaendatud ravimite väljastamiskordade arvu, personaalselt jaendatud ravimeid kasutavate patsientide arvu ja jaendamistasu kohta andmete esitamist alustatakse 2015. a I kvartalis osutatud teenuse kohta ja esimene aruanne esitatakse 1. maiks 2015. a. RT I 2014-12-11 10 111122014010 2014-12-14 70 Määruse § 27 lõike 1 punkti 6 kohaselt üldapteegi aruandes nõutud personaalselt jaendatud ravimite väljastamiskordade arvu, personaalselt jaendatud ravimeid kasutavate patsientide arvu ja jaendamistasu kohta andmete esitamist alustatakse 2015. a I kvartalis osutatud teenuse kohta ja esimene aruanne esitatakse 1. maiks 2015. a.",
      "rdfs:label": {
        "@value": "Reg_158494_Par_30 (redaktsioon 158494)",
        "@language": "et"
      },
