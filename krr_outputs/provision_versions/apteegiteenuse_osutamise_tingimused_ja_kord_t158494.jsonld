      }
    },
    {
      "@id": "estleg:Reg_158494_Par_9_v158494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158494_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ravimite käitlemist reguleerivatest õigusaktidest tulenevate nõuete täitmiseks peavad apteegis olema: 1 1) vajadustekohane sisustus, töövahendid ja seadmed; 2 2) turvameetmed (sh valvesignalisatsioon); 3 3) apteegi sidevahendid. RT I 2024-03-06 1 106032024001 2024-03-09 Ravimite käitlemist reguleerivatest õigusaktidest tulenevate nõuete täitmiseks peavad apteegis olema: vajadustekohane sisustus, töövahendid ja seadmed; turvameetmed (sh valvesignalisatsioon); apteegi sidevahendid.",
      "rdfs:label": {
        "@value": "Reg_158494_Par_9 (redaktsioon 158494)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158494",
