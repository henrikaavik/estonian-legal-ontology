    {
      "@id": "estleg:Reg_158494_Par_24_v158494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158494_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Apteek peab pidama turult kõrvaldatud ravimite arvestust. Apteek peab pidama turult kõrvaldatud ravimite arvestust. 2 (2) Arvestuses peavad olema järgmised andmed: 1 1) ravimi nimetus; 2 2) toimeaine sisaldus; 3 3) pakendi suurus; 4 4) pakendite arv; 5 5) müügiloa hoidja, selle puudumisel ravimitootja; 6 6) partii number; 7 7) turult kõrvaldamise põhjus. Arvestuses peavad olema järgmised andmed: ravimi nimetus; toimeaine sisaldus; pakendi suurus; pakendite arv; müügiloa hoidja, selle puudumisel ravimitootja; partii number; turult kõrvaldamise põhjus.",
      "rdfs:label": {
        "@value": "Reg_158494_Par_24 (redaktsioon 158494)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158494",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158494",
      "estleg:sourceAct": "Apteegiteenuse osutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_158494 § 24",
