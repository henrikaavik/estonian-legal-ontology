      "estleg:provisionRef": "Reg_158494 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158494_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158494_Par_3_v158494",
      "@type": [
