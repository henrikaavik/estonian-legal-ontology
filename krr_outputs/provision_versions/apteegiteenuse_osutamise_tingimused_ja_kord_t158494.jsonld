    {
      "@id": "estleg:Reg_158494_Par_16_v158494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158494_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ravimite apteeki saabumise hetkest vastutab ravimite kvaliteedi säilimise eest apteek. Ravimite apteeki saabumise hetkest vastutab ravimite kvaliteedi säilimise eest apteek. 2 (2) Ravimeid tuleb säilitada vastavalt «Ravimiseaduse» § 34 lõike 5 alusel kehtestatud korrale. Ravimeid tuleb säilitada vastavalt «Ravimiseaduse» § 34 lõike 5 alusel kehtestatud korrale. 3 (3) Müügiloata ravimid tuleb säilitada eraldi ja asjakohaselt märgistada või rakendada muid eristamist tagavaid efektiivseid meetmeid. RT I 2024-03-06 1 106032024001 2024-03-09 Müügiloata ravimid tuleb säilitada eraldi ja asjakohaselt märgistada või rakendada muid eristamist tagavaid efektiivseid meetmeid.",
      "rdfs:label": {
        "@value": "Reg_158494_Par_16 (redaktsioon 158494)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158494",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158494",
      "estleg:sourceAct": "Apteegiteenuse osutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_158494 § 16",
      "estleg:partOfAct": {
