    },
    {
      "@id": "estleg:Reg_158494_Par_25_v158494",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158494_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-02-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Apteek peab pidama välisabi korras saabunud ravimite arvestust. Apteek peab pidama välisabi korras saabunud ravimite arvestust. 2 (2) Arvestuses peavad olema järgmised andmed: 1 1) ravimi nimetus; 2 2) toimeaine sisaldus; 3 3) pakendi suurus; 4 4) pakendite arv; 5 5) tootja; 6 6) partii number; 7 7) tarnija; 8 8) saabumise kuupäev. Arvestuses peavad olema järgmised andmed: ravimi nimetus; toimeaine sisaldus; pakendi suurus; pakendite arv; tootja; partii number; tarnija; saabumise kuupäev. 3 (3) Saatedokumente välisabi korras saabunud ravimite saabumise ja väljastamise kohta tuleb säilitada eraldi teiste ravimite saatedokumentidest. Saatedokumente välisabi korras saabunud ravimite saabumise ja väljastamise kohta tuleb säilitada eraldi teiste ravimite saatedokumentidest.",
      "rdfs:label": {
        "@value": "Reg_158494_Par_25 (redaktsioon 158494)",
        "@language": "et"
