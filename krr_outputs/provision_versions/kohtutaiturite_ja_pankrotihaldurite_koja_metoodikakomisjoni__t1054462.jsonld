      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kohtutäiturite ja Pankrotihaldurite Koja metoodikakomisjoni töö korraldus, võlgniku usaldusisiku eksami, esmase koolituse ja täiendusõppe nõuded ning kojale makstava tasu suurus (18 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohtutäiturite ja Pankrotihaldurite Koja metoodikakomisjoni töö korraldus, võlgniku usaldusisiku eksami, esmase koolituse ja täiendusõppe nõuded ning kojale makstava tasu suurus"
