      "estleg:versionValidFrom": {
        "@value": "2025-02-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Erialateadmiste testiga kontrollitakse usaldusisiku eksamil osaleja teadmisi järgmistes valdkondades: 1 1) pankrotiõigus, sealhulgas ajutise halduri ülesanded ja tagasivõitmise võimaluste hindamine; 2 2) kohustustest vabastamise menetlus; 3 3) võlgade ümberkujundamise menetlus; 4 4) täitemenetlus; 5 5) tsiviilõiguse üldosa; 6 6) võlaõigus, sealhulgas tarbijakrediidi õigus; 7 7) perekonnaõigus, sealhulgas ühisvara regulatsioon; 8 8) pärimisõigus; 9 9) tööõigus; 10 10) tsiviilkohtumenetlus, sealhulgas hagita menetlus; 11 11) haldusõigus. RT I 2025-02-21 11 121022025011 2025-02-24 Erialateadmiste testiga kontrollitakse usaldusisiku eksamil osaleja teadmisi järgmistes valdkondades: pankrotiõigus, sealhulgas ajutise halduri ülesanded ja tagasivõitmise võimaluste hindamine; kohustustest vabastamise menetlus; võlgade ümberkujundamise menetlus; täitemenetlus; tsiviilõiguse üldosa; võlaõigus, sealhulgas tarbijakrediidi õigus; perekonnaõigus, sealhulgas ühisvara regulatsioon; pärimisõigus; tööõigus; tsiviilkohtumenetlus, sealhulgas hagita menetlus; haldusõigus.",
      "rdfs:label": {
        "@value": "Reg_1054462_Par_8 (redaktsioon 1054462)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054462",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054462",
      "estleg:sourceAct": "Kohtutäiturite ja Pankrotihaldurite Koja metoodikakomisjoni töö korraldus, võlgniku usaldusisiku eksami, esmase koolituse ja täiendusõppe nõuded ning kojale makstava tasu suurus",
      "estleg:provisionRef": "Reg_1054462 § 8",
