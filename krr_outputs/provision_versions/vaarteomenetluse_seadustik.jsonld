        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kedagi ei tohi käsitada väärteo toimepanemises süüdlasena enne, kui väärteo eest karistamise otsus on tema kohta jõustunud.",
      "rdfs:label": {
        "@value": "VTMS_Par_4 (redaktsioon 781219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "781219",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_4_v782829"
      },
      "estleg:versionValidTo": {
        "@value": "2005-02-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/781219",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_4_v782829",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kedagi ei tohi käsitada väärteo toimepanemises süüdlasena enne, kui väärteo eest karistamise otsus on tema kohta jõustunud.",
      "rdfs:label": {
        "@value": "VTMS_Par_4 (redaktsioon 782829)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "782829",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/782829",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 4",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_40_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik kutsutakse menetleja juurde kutsega. (2) Isikule saadetav kutse sisaldab järgmisi andmeid: füüsilise isiku kutsumise korral tema ees- ja perekonnanimi ning elukoha aadress, juriidilise isiku kutsumise korral tema nimetus ja asukoha aadress; kohtuvälise menetleja kutsumisel kohtuvälise menetleja nimetus ja asukoha aadress; kutsumise põhjus ja kellena isik välja kutsutakse; väärteoasja nimetus; ilmumise aeg ja koht; menetlusaluse isiku kutsumise korral tema õigused ja kohustused vastavalt käesoleva seadustiku §-le 19; kas menetlusaluse isiku kutsumise korral on tema ilmumine kohustuslik ning ilmumata jäämise tagajärjed vastavalt käesoleva seadustiku §-le 43; kas kohtuvälise menetleja kutsumise korral on tema ilmumine kohustuslik; tunnistaja kutsumise korral tema ilmumise kohustuslikkus ning ilmumata jäämise tagajärjed vastavalt käesoleva seadustiku §-le 43; kohustus teatada ilmumata jäämisest ja selle põhjusest. (3) Kutse lõpposa sisaldab teatise, mis täidetakse juhul, kui kutse antakse isikule allkirja vastu kätte. Teatises märgitakse isiku ees- ja perekonnanimi, kellele kutse adresseeritud, isiku allkiri kutse kättesaamise kohta ja kutse kättesaamise kuupäev. Kui isik keeldub kutse vastuvõtmisest, siis menetleja märge kutse vastuvõtmisest keeldumise kohta, keeldumise kuupäev, menetleja allkiri ja ametinimetus.",
      "rdfs:label": {
        "@value": "VTMS_Par_40 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_40_v553290"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_40_v553290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik kutsutakse menetleja juurde kutsega. (2) Isikule saadetav kutse sisaldab järgmisi andmeid: füüsilise isiku kutsumise korral tema ees- ja perekonnanimi ning elukoha aadress, juriidilise isiku kutsumise korral tema nimetus ja asukoha aadress; kohtuvälise menetleja kutsumisel kohtuvälise menetleja nimetus ja asukoha aadress; kutsumise põhjus ja kellena isik välja kutsutakse; väärteo kvalifikatsioon ning, kui väärteomenetlus on alustatud isiku suhtes, siis isiku ees- ja perekonnanimi; ilmumise aeg ja koht; menetlusaluse isiku kutsumise korral tema õigused ja kohustused vastavalt käesoleva seadustiku §-le 19; kas menetlusaluse isiku kutsumise korral on tema ilmumine kohustuslik ning ilmumata jäämise tagajärjed vastavalt käesoleva seadustiku §-le 43; kas kohtuvälise menetleja kutsumise korral on tema ilmumine kohustuslik; tunnistaja kutsumise korral tema ilmumise kohustuslikkus ning ilmumata jäämise tagajärjed vastavalt käesoleva seadustiku §-le 43; kohustus teatada ilmumata jäämisest ja selle põhjusest. (3) Kutse lõpposa sisaldab teatise, mis täidetakse juhul, kui kutse antakse isikule allkirja vastu kätte. Teatises märgitakse isiku ees- ja perekonnanimi, kellele kutse adresseeritud, isiku allkiri kutse kättesaamise kohta ja kutse kättesaamise kuupäev. Kui isik keeldub kutse vastuvõtmisest, siis menetleja märge kutse vastuvõtmisest keeldumise kohta, keeldumise kuupäev, menetleja allkiri ja ametinimetus.",
      "rdfs:label": {
        "@value": "VTMS_Par_40 (redaktsioon 553290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "553290",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_40_v693416"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/553290",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 40",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_40_v693416",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Isik kutsutakse menetleja juurde kutsega. (2) Isikule saadetav kutse sisaldab järgmisi andmeid: füüsilise isiku kutsumise korral tema ees- ja perekonnanimi ning elukoha aadress, juriidilise isiku kutsumise korral tema nimetus ja asukoha aadress; kohtuvälise menetleja kutsumisel kohtuvälise menetleja nimetus ja asukoha aadress; kutsumise põhjus ja kellena isik välja kutsutakse; väärteo kvalifikatsioon ning, kui väärteomenetlus on alustatud isiku suhtes, siis isiku ees- ja perekonnanimi ; ilmumise aeg ja koht; menetlusaluse isiku kutsumise korral tema õigused ja kohustused vastavalt käesoleva seadustiku §-le 19; kas menetlusaluse isiku kutsumise korral on tema ilmumine kohustuslik ning ilmumata jäämise tagajärjed vastavalt käesoleva seadustiku §-le 43; kas kohtuvälise menetleja kutsumise korral on tema ilmumine kohustuslik; tunnistaja kutsumise korral tema ilmumise kohustuslikkus ning ilmumata jäämise tagajärjed vastavalt käesoleva seadustiku §-le 43; kohustus teatada ilmumata jäämisest ja selle põhjusest. (3) Kutse lõpposa sisaldab teatise, mis täidetakse juhul, kui kutse antakse isikule allkirja vastu kätte. Teatises märgitakse isiku ees- ja perekonnanimi, kellele kutse adresseeritud, isiku allkiri kutse kättesaamise kohta ja kutse kättesaamise kuupäev. Kui isik keeldub kutse vastuvõtmisest, siis menetleja märge kutse vastuvõtmisest keeldumise kohta, keeldumise kuupäev, menetleja allkiri ja ametinimetus.",
      "rdfs:label": {
        "@value": "VTMS_Par_40 (redaktsioon 693416)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693416",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_40_v782829"
      },
      "estleg:versionValidTo": {
