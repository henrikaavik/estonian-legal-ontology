        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928061",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_140_v977490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maakohus saadab apellatsiooni koopiad kohtumenetluse pooltele apellatsiooni kättesaamisest alates kolme päeva jooksul. (2) Kohtumenetluse pooltel on õigus: tutvuda kohtus väärteotoimikuga ning teha toimikus olevatest kirjalikest tõenditest väljakirjutusi ning taotleda kohtu kantseleilt toimikus olevatest kirjalikest tõenditest tasu eest koopiate tegemist; esitada ringkonnakohtule apellatsiooni kohta kirjalik vastulause kuni kohtuistungi alguseni. (3) Kui apellatsioonitähtaeg on möödunud, saadab maakohus apellatsiooni ja väärteotoimiku ringkonnakohtusse.",
      "rdfs:label": {
        "@value": "VTMS_Par_140 (redaktsioon 977490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977490",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_140_v119032015034"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/977490",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_140_v119032015034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohus saadab apellatsiooni koopiad kohtumenetluse pooltele apellatsiooni kättesaamisest alates kolme päeva jooksul. (2) Kohtumenetluse pooltel on õigus: tutvuda ringkonnakohtus väärteotoimikuga ja teha toimikus olevatest kirjalikest tõenditest väljakirjutusi ning taotleda kohtu kantseleilt toimikus olevatest kirjalikest tõenditest koopiate tegemist tasu eest; esitada ringkonnakohtule apellatsiooni kohta kirjalik vastulause kuni kohtuistungi alguseni.",
      "rdfs:label": {
        "@value": "VTMS_Par_140 (redaktsioon 119032015034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015034",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_141_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eelmenetluses kohtunik: kontrollib apellatsiooniõigust, apellatsioonitähtaega ja apellatsiooni nõuete täitmist vastavalt käesoleva seadustiku §-dele 136, 137 ja 139; jätab apellatsiooni käiguta käesoleva seadustiku § 142 lõikes 1 sätestatu alusel; jätab apellatsiooni läbi vaatamata käesoleva seadustiku § 142 lõikes 2 sätestatu alusel; saadab väärteoasja maa- või linnakohtule uueks arutamiseks käesoleva seadustiku §-s 143 sätestatu alusel; lõpetab väärteomenetluse käesoleva seadustiku § 144 lõikes 1 sätestatu alusel; lahendab asja kirjalikus menetluses vastavalt käesoleva seadustiku §-le 145. (2) Kui apellatsiooni ei lahendata käesoleva paragrahvi lõike 1 punkte 2–6 järgides, selgitab kohtunik kohtuistungile kutsutavad isikud, apellatsioonist tulenevad kohtuliku arutamise piirid ja uuritavad tõendid, lahendab apellatsioonis esitatud taotlused, kutsub kohtumenetluse pooled kohtuistungile käesoleva seadustiku §-de 40 ja 41 kohaselt ning määrab asja arutada vastavalt käesoleva seadustiku §-le 121.",
      "rdfs:label": {
        "@value": "VTMS_Par_141 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_141_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 141",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_141_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_141"
