    {
      "@id": "estleg:VTMS_Par_85_v977490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja kohtulikku arutamist ette valmistades maakohtunik: kontrollib väärteoasja kohtualluvust; teeb kindlaks kohtumenetluse pooled, tunnistaja, tõlgi ja eksperdi ning teatab neile asja arutamise aja ja koha; teeb kindlaks, milliseid tõendeid tuleb uurida kohtulikul arutamisel ja võtab tarvitusele abinõud nende esitamiseks kohtuistungil; lahendab tunnistajate erinõude korras ülekuulamise teises maakohtus; lahendab ekspertiisi tegemise, arvestades kohtumenetluse poolte arvamust; lahendab kohtumenetluse poolte esitatud taotlused.",
      "rdfs:label": {
        "@value": "VTMS_Par_85 (redaktsioon 977490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977490",
      "estleg:supersededByVersion": {
