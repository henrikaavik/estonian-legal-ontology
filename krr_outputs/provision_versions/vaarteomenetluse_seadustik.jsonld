    {
      "@id": "estleg:VTMS_Par_147_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohus võib kohtuotsusega: jätta maa- või linnakohtu kohtuotsuse muutmata ja apellatsiooni rahuldamata; jätta maa- või linnakohtu kohtuotsuse sisuliselt muutmata, tehes sellesse täpsustusi; muuta maa- või linnakohtu kohtuotsuse põhiosa, jättes välja selles esitatud asjaolusid; tühistada maa- või linnakohtu kohtuotsuse täies ulatuses või osaliselt ja teha uue kohtuotsuse käesoleva seadustiku §-s 151 sätestatu alusel. (2) Ringkonnakohus võib määrusega: käesoleva seadustiku §-s 148 sätestatud alustel tühistada maa- või linnakohtu kohtuotsuse ja saata väärteoasja uueks arutamiseks maa- või linnakohtule teises koosseisus; tühistada maa- või linnakohtu kohtuotsuse täies ulatuses või osaliselt ja lõpetada väärteomenetluse käesoleva seadustiku §-s 29 või 30 sätestatu alusel.",
      "rdfs:label": {
        "@value": "VTMS_Par_147 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_147_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 147",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_147_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ringkonnakohus võib kohtuotsusega: jätta maa- või linnakohtu kohtuotsuse muutmata ja apellatsiooni rahuldamata; jätta maa- või linnakohtu kohtuotsuse sisuliselt muutmata, tehes sellesse täpsustusi; muuta maa- või linnakohtu kohtuotsuse põhiosa, jättes välja selles esitatud asjaolusid; tühistada maa- või linnakohtu kohtuotsuse täies ulatuses või osaliselt ja teha uue kohtuotsuse käesoleva seadustiku §-s 151 sätestatu alusel. (2) Ringkonnakohus võib määrusega: käesoleva seadustiku §-s 148 sätestatud alustel tühistada maa- või linnakohtu kohtuotsuse ja saata väärteoasja uueks arutamiseks maa- või linnakohtule teises koosseisus; tühistada maa- või linnakohtu kohtuotsuse täies ulatuses või osaliselt ja lõpetada väärteomenetluse käesoleva seadustiku §-s 29 või 30 sätestatu alusel. [Paragrahvi 147 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VTMS_Par_147 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
      "estleg:supersededByVersion": {
