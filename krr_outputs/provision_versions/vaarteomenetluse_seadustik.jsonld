      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1028004",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 124",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_124_v1047192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_124"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus teatab, milline asi ning kelle kaebuse alusel tuleb arutamisele. (2) Kohus alustab kaebuse kohtulikku arutamist, teostades käesoleva seadustiku §-s 95 sätestatud toimingud.",
      "rdfs:label": {
        "@value": "VTMS_Par_124 (redaktsioon 1047192)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1047192",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1047192",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 124",
