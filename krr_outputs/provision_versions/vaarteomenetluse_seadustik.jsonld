    {
      "@id": "estleg:VTMS_Par_126_v1047192",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_126"
      },
      "estleg:versionValidFrom": {
