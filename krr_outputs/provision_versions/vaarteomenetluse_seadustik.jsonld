      },
      "estleg:versionText": "Teistmisavalduse põhjendatuse korral tühistab Riigikohus vaidlustatud kohtulahendi oma otsusega ja saadab väärteoasja kohtulahendi teinud kohtule uuesti arutada.",
      "rdfs:label": {
        "@value": "VTMS_Par_187 (redaktsioon 977490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977490",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/977490",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 187",
