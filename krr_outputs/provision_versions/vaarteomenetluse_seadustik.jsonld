      "estleg:provisionRef": "VTMS § 177",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_177_v119032015034",
      "@type": [
        "owl:NamedIndividual",
