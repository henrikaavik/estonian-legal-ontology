      },
      "estleg:versionText": "Riigikohtu lahend jõustub allakirjutamise päeval ja seda ei saa edasi kaevata.",
      "rdfs:label": {
        "@value": "VTMS_Par_177 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
