    {
      "@id": "estleg:VTMS_Par_108_v119032015036",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuotsuse tegemiseks selgitatakse: kas on toime pandud seadusega sätestatud väärteo tunnustele vastav tegu; väärteo kvalifikatsioon: seaduse nimetus, paragrahv, lõige ja punkt; kas väärteo on toime pannud menetlusalune isik; teo õigusvastasus ja süülisus; kas on karistust kergendavaid või raskendavaid asjaolusid; karistuse liik ja määr; kuidas toimida asitõendite ja muude äravõetud esemetega; kas on vaja kohaldada konfiskeerimist; kas mõista karistus karistusseadustiku § 63 lõike 1 või 3 kohaselt; kas lõpetada väärteomenetlus ja kohaldada karistusseadustiku §-s 87 sätestatud alaealisele kohaldatavaid mõjutusvahendeid või anda väärteoasja materjalid üle alaealiste komisjonile; kuidas lahendada taotlus hüvitada süüteomenetluses tekitatud kahju süüteomenetluses tekitatud kahju hüvitamise seaduse kohaselt.",
      "rdfs:label": {
        "@value": "VTMS_Par_108 (redaktsioon 119032015036)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015036",
