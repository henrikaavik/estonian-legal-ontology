      }
    },
    {
      "@id": "estleg:VTMS_Par_142_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui apellatsioon ei vasta käesoleva seadustiku § 139 nõuetele, teeb ringkonnakohtunik selle käiguta jätmise kohta määruse ning annab kaebuse esitajale tähtaja puuduste kõrvaldamiseks. (2) Ringkonnakohtunik teeb apellatsiooni läbi vaatamata jätmise kohta määruse ja saadab määruse koopia ning tagastab apellatsiooni apellandile, kui: apellatsioon on esitatud pärast käesoleva seadustiku § 137 lõikes 3 sätestatud tähtaja möödumist ja tähtaja ennistamise taotlust ei ole esitatud või kohtunik on jätnud tähtaja ennistamata; apellatsiooni on esitanud isik, kellel käesoleva seadustiku § 136 lõike 1 järgi ei ole õigust kaebust esitada; apellatsioon ei ole esitatud käesoleva seadustiku § 136 lõikes 1 ettenähtud kohtuotsuse peale; apellant ei ole käesoleva paragrahvi lõikes 1 ettenähtud korras määratud tähtaja jooksul kõrvaldanud apellatsioonis esinenud puudusi; apellatsioonist on kuni kohtuistungi alguseni loobutud.",
      "rdfs:label": {
        "@value": "VTMS_Par_142 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_142_v693416"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 142",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_142_v693416",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui apellatsioon ei vasta käesoleva seadustiku § 139 nõuetele, teeb ringkonnakohtunik selle käiguta jätmise kohta määruse ning annab kaebuse esitajale tähtaja puuduste kõrvaldamiseks. (2) Ringkonnakohtunik teeb apellatsiooni läbi vaatamata jätmise kohta määruse ja saadab määruse koopia ning tagastab apellatsiooni apellandile, kui: apellatsioon on esitatud pärast käesoleva seadustiku § 137 lõikes 3 sätestatud tähtaja möödumist ja tähtaja ennistamise taotlust ei ole esitatud või kohtunik on jätnud tähtaja ennistamata; apellatsiooni on esitanud isik, kellel käesoleva seadustiku § 136 lõike 1 järgi ei ole õigust kaebust esitada; apellatsioon ei ole esitatud käesoleva seadustiku § 136 lõikes 1 ettenähtud kohtuotsuse peale; apellant ei ole käesoleva seadustiku § 113 lõike 4 punktis 3 ettenähtud tähtaja jooksul teatanud maa- või linnakohtule kirjalikult apellatsiooniõiguse kasutamise soovist; apellant ei ole käesoleva paragrahvi lõikes 1 ettenähtud korras määratud tähtaja jooksul kõrvaldanud apellatsioonis esinenud puudusi; apellatsioonist on kuni kohtuistungi alguseni loobutud.",
      "rdfs:label": {
        "@value": "VTMS_Par_142 (redaktsioon 693416)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693416",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_142_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/693416",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 142",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_142_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_142"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui apellatsioon ei vasta käesoleva seadustiku § 139 nõuetele, teeb ringkonnakohtunik selle käiguta jätmise kohta määruse ning annab kaebuse esitajale tähtaja puuduste kõrvaldamiseks. (2) Ringkonnakohtunik teeb apellatsiooni läbi vaatamata jätmise kohta määruse ja saadab määruse koopia ning tagastab apellatsiooni apellandile, kui: apellatsioon on esitatud pärast käesoleva seadustiku § 137 lõikes 3 sätestatud tähtaja möödumist ja tähtaja ennistamise taotlust ei ole esitatud või kohtunik on jätnud tähtaja ennistamata; apellatsiooni on esitanud isik, kellel käesoleva seadustiku § 136 lõike 1 järgi ei ole õigust kaebust esitada; apellatsioon ei ole esitatud käesoleva seadustiku § 136 lõikes 1 ettenähtud kohtuotsuse peale; [Punkti 3 1 sõnastus kuni 31. 12. 2005] apellant ei ole käesoleva seadustiku § 113 lõike 4 punktis 3 ettenähtud tähtaja jooksul teatanud maa- või linnakohtule kirjalikult apellatsiooniõiguse kasutamise soovist; [Punkti 3 1 sõnastus alates 1. 01. 2006] apellant ei ole käesoleva seadustiku § 113 lõike 4 punktis 3 ettenähtud tähtaja jooksul teatanud maakohtule kirjalikult apellatsiooniõiguse kasutamise soovist; apellant ei ole käesoleva paragrahvi lõikes 1 ettenähtud korras määratud tähtaja jooksul kõrvaldanud apellatsioonis esinenud puudusi; apellatsioonist on kuni kohtuistungi alguseni loobutud. [Paragrahvi 143 sõnastus kuni 31. 12. 2005]",
      "rdfs:label": {
        "@value": "VTMS_Par_142 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_142_v977490"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928061",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 142",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
