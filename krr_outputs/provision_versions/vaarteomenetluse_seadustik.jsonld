      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ringkonnakohus tühistab maa- või linnakohtus tehtud otsuse järgmistel alustel: menetluse ühekülgsus või puudulikkus; materiaalõiguse ebaõige kohaldamine vastavalt käesoleva seadustiku §-le 149; väärteomenetlusõiguse oluline rikkumine vastavalt käesoleva seadustiku §-le 150; karistuse või muu mõjutusvahendi mittevastavus väärteo raskusele ja menetlusalusele isikule.",
      "rdfs:label": {
        "@value": "VTMS_Par_148 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
