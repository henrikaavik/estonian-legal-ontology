      }
    },
    {
      "@id": "estleg:VTMS_Par_200_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_200"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuvälise menetleja jõustunud otsust ja määrust ning jõustunud kohtuotsust ja määrust on kohustatud täitma kõik isikud Eesti Vabariigi territooriumil.",
      "rdfs:label": {
        "@value": "VTMS_Par_200 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 200",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_201_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_201"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuvälise menetleja otsus ja määrus ning kohtuotsus ja määrus pööratakse täitmisele, kui see on jõustunud ja kui täitmisele pööramist ei ole edasi lükatud vastavalt käesoleva seadustiku §-le 209. (2) Kui kohtuvälise menetleja otsuse peale on esitatud kaebus maa- või linnakohtule või kohtuotsuse peale on esitatud apellatsioon või kassatsioon ainult ühe menetlusaluse isiku suhtes, pööratakse teiste menetlusaluste isikute suhtes kohtuvälise menetleja otsus või kohtuotsus täitmisele.",
      "rdfs:label": {
        "@value": "VTMS_Par_201 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_201_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 201",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_201_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_201"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuvälise menetleja otsus ja määrus ning kohtuotsus ja määrus pööratakse täitmisele, kui see on jõustunud ja kui täitmisele pööramist ei ole edasi lükatud vastavalt käesoleva seadustiku §-le 209. [Lõike 2 sõnastus kuni 31. 12. 2005] (2) Kui kohtuvälise menetleja otsuse peale on esitatud kaebus maa- või linnakohtule või kohtuotsuse peale on esitatud apellatsioon või kassatsioon ainult ühe menetlusaluse isiku suhtes, pööratakse teiste menetlusaluste isikute suhtes kohtuvälise menetleja otsus või kohtuotsus täitmisele. [Lõike 2 sõnastus alates 1. 01. 2006] (2) Kui kohtuvälise menetleja otsuse peale on esitatud kaebus maakohtule või kohtuotsuse peale on esitatud apellatsioon või kassatsioon ainult ühe menetlusaluse isiku suhtes, pööratakse teiste menetlusaluste isikute suhtes kohtuvälise menetleja otsus või kohtuotsus täitmisele. [Paragrahvi 202 sõnastus kuni 31. 12. 2005]",
      "rdfs:label": {
        "@value": "VTMS_Par_201 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
