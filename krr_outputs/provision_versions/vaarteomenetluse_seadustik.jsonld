      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_217"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Väärteomenetluse seadustik jõustub koos karistusseadustiku jõustumisega. Õiend Väärteomenetluse seadustiku § 161 pealkirjas viidud sisse \"Kriminaalmenetluse koodeksi, karistusseadustiku ja väärteomenetluse seadustiku muutmise seadusega\" tehtud muudatus.",
      "rdfs:label": {
        "@value": "VTMS_Par_217 (redaktsioon 693416)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693416",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_217_v1028004"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/693416",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 217",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
