    {
      "@id": "estleg:VTMS_Par_182_v125042012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_182"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teistmisavalduse võib esitada: kohtuotsuse jõustumisest alates kuue kuu jooksul käesoleva seadustiku § 180 punktides 1–41 ettenähtud alusel; kohtu määruse jõustumisest alates kuue kuu jooksul käesoleva seadustiku § 180 punktis 4 ettenähtud alusel; uue asjaolu ilmnemisest alates kolme kuu jooksul käesoleva seadustiku § 180 punktis 5 ettenähtud alusel; muu asjaolu ilmnemisest alates kolme kuu jooksul käesoleva seadustiku § 180 punktis 6 ettenähtud alusel.",
      "rdfs:label": {
        "@value": "VTMS_Par_182 (redaktsioon 125042012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125042012008",
