      }
    },
    {
      "@id": "estleg:VTMS_Par_206_v131122016018",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_206"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-02-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui seadusega ei sätestata teisiti, saadab kohtulahendit või kohtuvälise menetleja lahendit täitmisele pöörav menetleja konfiskeeritud vara valitsema volitatud asutusele: kohtuotsuse või -määruse või kohtuvälise menetleja otsuse või määruse koopia märkega selle jõustumise kohta; konfiskeeritud vara käsitleva menetlusdokumendi koopia. (2) Konfiskeeritud vara võõrandamise ja hävitamise kulud tasub süüdlane. (3) Konfiskeeritud vara üleandmise ja vara võõrandamisest saadud raha eelarvest seaduslikule valdajale tagastamise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "VTMS_Par_206 (redaktsioon 131122016018)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "131122016018",
