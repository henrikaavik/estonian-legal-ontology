      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928061",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 116",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_116_v977490",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_116"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast kiirmenetluses käesoleva seadustiku § 55 lõike 2 või üldmenetluses käesoleva seadustiku § 73 lõike 1 kohaselt tehtud kohtuvälise menetleja otsuse peale esitatud kaebuse saamist nõuab maakohus viivitamata väärteotoimiku otsuse teinud kohtuväliselt menetlejalt. (2) Kohtuväline menetleja saadab maakohtu nõudel viivitamata väärteotoimiku maakohtule.",
      "rdfs:label": {
        "@value": "VTMS_Par_116 (redaktsioon 977490)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "977490",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/977490",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 116",
      "estleg:partOfAct": {
