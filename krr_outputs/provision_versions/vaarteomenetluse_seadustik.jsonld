      },
      "estleg:versionText": "(1) Väärteoasja kohtuvälise menetluse dokumentide näidisvormid kehtestab (2) Väärteomenetluses digitaalallkirjastatud ja muu digitaalse dokumendi vormistamise, edastamise ja säilitamise korra kehtestab",
      "rdfs:label": {
        "@value": "VTMS_Par_51 (redaktsioon 119032015034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015034",
