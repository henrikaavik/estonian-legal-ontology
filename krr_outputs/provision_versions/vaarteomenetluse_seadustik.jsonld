    {
      "@id": "estleg:VTMS_Par_155_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_155"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Õigus esitada käesoleva seadustiku § 157 sätestatu alusel kassatsioon on: kohtumenetluse poolel maa- või linnakohtu otsuse peale, mis on tehtud käesoleva seadustiku §-s 132 sätestatu alusel; kohtumenetluse poolel, kui tema suhtes on kasutatud apellatsiooniõigust; kohtumenetluse pooltel, kui ringkonnakohus on teinud ühe käesoleva seadustiku § 147 lõikes 1 nimetatud kohtuotsustest. (2) Kassatsiooni esitamise õigus on kohtumenetluse pooltel advokaadist esindaja vahendusel. (3) Kassatsiooni esitanud kohtumenetluse poolt esindav advokaat on kassatsioonimenetluses kassaator.",
      "rdfs:label": {
        "@value": "VTMS_Par_155 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_155_v693416"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 155",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_155_v693416",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_155"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
