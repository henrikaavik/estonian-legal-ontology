      }
    },
    {
      "@id": "estleg:VTMS_Par_107_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- või linnakohus teeb: kohtuotsuse rahatrahvi või aresti mõistmise kohta; kohtuotsuse väärteomenetluse lõpetamise kohta käesoleva seadustiku § 29 lõike 1 punktis 1 ja §-s 30 sätestatud alustel. (2) Käesoleva seadustiku § 29 lõike 1 punktides 2–7 sätestatud alustel teeb kohus väärteomenetluse lõpetamise määruse. Kui kohus teeb väärteomenetluse lõpetamise määruse alla 14-aastase isiku kohta, järgitakse käesoleva seadustiku § 29 lõikes 2 sätestatut.",
      "rdfs:label": {
        "@value": "VTMS_Par_107 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_107_v553290"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 107",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_107_v553290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_107"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- või linnakohus teeb: kohtuotsuse rahatrahvi või aresti mõistmise kohta; kohtuotsuse väärteomenetluse lõpetamise kohta käesoleva seadustiku § 29 lõike 1 punktis 1 ja §-s 30 sätestatud alustel. (2) Käesoleva seadustiku § 29 lõike 1 punktides 2–7 sätestatud alustel teeb kohus väärteomenetluse lõpetamise määruse. Kui kohus teeb otsuse või määruse väärteomenetluse lõpetamise kohta alaealise suhtes, kes ei olnud õigusvastast tegu toime pannes oma ea tõttu süüvõimeline või oli neljateist- kuni kaheksateistaastane, järgitakse vastavalt käesoleva seadustiku § 29 lõikes 2 või § 30 lõikes 2 sätestatut.",
      "rdfs:label": {
        "@value": "VTMS_Par_107 (redaktsioon 553290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "553290",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_107_v693416"
      },
      "estleg:versionValidTo": {
