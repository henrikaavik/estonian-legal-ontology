      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuistung helisalvestatakse. (2) Kohtuistungi võib jätta salvestamata, kui: enne istungit või istungi käigus ilmneb, et salvestamine on tehniliselt võimatu, ning kui kohus on veendunud, et istungi läbiviimine salvestamiseta on otstarbekas ja kohtumenetluse poolte huvidega kooskõlas; istung toimub väljaspool kohtu ruume; tegemist on kohtulahendi kuulutamiseks korraldatud istungiga; tegemist on Riigikohtu istungiga.",
      "rdfs:label": {
        "@value": "VTMS_Par_130_1 (redaktsioon 112122018086)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018086",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112122018086",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 130_1",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
