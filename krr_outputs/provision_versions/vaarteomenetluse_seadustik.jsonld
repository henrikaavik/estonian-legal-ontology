      }
    },
    {
      "@id": "estleg:VTMS_Par_168_v122032013021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärteoasi antakse kohtu määruse alusel läbi vaadata Riigikohtu erikogule, kui Riigikohtu kriminaalkolleegium väärteoasja kogu kosseisus läbi vaadates peab vajalikuks seadust tõlgendades muuta Riigikohtu teise kolleegiumi või erikogu viimases kohtulahendis esitatud seisukohta. (2) Riigikohtu erikogu moodustab kriminaalkolleegiumi kogu koosseisu määruse alusel Riigikohtu esimees. (3) Riigikohtu erikogu koosseisu kuuluvad: Riigikohtu esimees eesistujana; kaks riigikohtunikku kriminaalkolleegiumist; kaks riigikohtunikku sellest kolleegiumist, kelle seisukoha seaduse kohaldamisel on kriminaalkolleegium vaidlustanud. (4) Erikogu istungil on ettekandja kriminaalkolleegiumi liige.",
      "rdfs:label": {
        "@value": "VTMS_Par_168 (redaktsioon 122032013021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122032013021",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_168_v106072013009"
      },
      "estleg:versionValidTo": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/122032013021",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 168",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_168_v106072013009",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärteoasi antakse kohtu määruse alusel läbi vaadata Riigikohtu erikogule, kui Riigikohtu kriminaalkolleegium väärteoasja kogu koosseisus läbi vaadates peab vajalikuks seadust tõlgendades muuta Riigikohtu teise kolleegiumi või erikogu viimases kohtulahendis esitatud seisukohta. (2) Riigikohtu erikogu moodustab kriminaalkolleegiumi kogu koosseisu määruse alusel Riigikohtu esimees. (3) Riigikohtu erikogu koosseisu kuuluvad: Riigikohtu esimees eesistujana; kaks riigikohtunikku kriminaalkolleegiumist; kaks riigikohtunikku sellest kolleegiumist, kelle seisukoha seaduse kohaldamisel on kriminaalkolleegium vaidlustanud. (4) Erikogu istungil on ettekandja kriminaalkolleegiumi liige.",
      "rdfs:label": {
        "@value": "VTMS_Par_168 (redaktsioon 106072013009)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072013009",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_168_v119032015034"
      },
      "estleg:versionValidTo": {
        "@value": "2015-03-28",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/106072013009",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 168",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_168_v119032015034",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_168"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-03-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärteoasi antakse kohtu määruse alusel läbi vaadata Riigikohtu erikogule, kui Riigikohtu kriminaalkolleegium peab väärteoasja läbi vaadates vajalikuks seadust tõlgendades muuta Riigikohtu teise kolleegiumi või erikogu viimases kohtulahendis esitatud seisukohta või see on vajalik seaduse ühetaolise kohaldamise tagamiseks. (2) Riigikohtu erikogu moodustab kriminaalkolleegiumi kogu koosseisu määruse alusel Riigikohtu esimees. (3) Riigikohtu erikogu koosseisu kuuluvad: Riigikohtu esimees eesistujana; kaks riigikohtunikku kriminaalkolleegiumist; kaks riigikohtunikku sellest kolleegiumist, kelle seisukoha seaduse kohaldamisel on kriminaalkolleegium vaidlustanud. (4) Erikogu istungil on ettekandja kriminaalkolleegiumi liige.",
      "rdfs:label": {
        "@value": "VTMS_Par_168 (redaktsioon 119032015034)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "119032015034",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/119032015034",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 168",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_169_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_169"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Väärteoasi antakse kohtu määruse alusel läbi vaadata Riigikohtu üldkogule, kui kriminaalkolleegiumi täiskogu peab vajalikuks: muuta Riigikohtu üldkogu või erikogu viimases lahendis esitatud seisukohta seaduse kohaldamise kohta või et väärteoasjas seaduse ühetaoliseks kohaldamiseks on pädev Riigikohtu üldkogu. (2) Väärteoasi antakse asja läbivaatava kohtukoosseisu poolt Riigikohtu üldkogule arutamiseks, kui väärteoasja lahendamine eeldab põhiseaduslikkuse järelevalve kohtumenetluse seaduse alusel läbivaadatava küsimuse lahendamist.",
      "rdfs:label": {
        "@value": "VTMS_Par_169 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_169_v236547"
      },
      "estleg:versionValidTo": {
        "@value": "2003-01-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 169",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
