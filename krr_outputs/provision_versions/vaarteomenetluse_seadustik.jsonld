    {
      "@id": "estleg:VTMS_Par_132_v12749262",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_132"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-11-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maakohus võib kohtuotsusega: jätta kohtuvälise menetleja otsuse muutmata ja kaebuse rahuldamata; tühistada kohtuvälise menetleja otsuse täies ulatuses või osaliselt ja teha uue otsuse, kui see ei raskenda menetlusaluse isiku olukorda; tühistada kohtuvälise menetleja otsuse ja lõpetada väärteomenetluse käesoleva seadustiku §-s 29 või 30 sätestatud alustel.",
      "rdfs:label": {
        "@value": "VTMS_Par_132 (redaktsioon 12749262)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12749262",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/12749262",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 132",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_133_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaebuse lahendamiseks selgitab kohus järgmised küsimused: kas väärteoasjas ei esine käesoleva seadustiku §-s 29 sätestatud väärteomenetlust välistavaid asjaolusid; kas leidis aset tegu, milles menetlusalust isikut süüdistatakse; kas teo on pannud toime menetlusalune isik; kas tegu on väärtegu ning kas see on õigesti kvalifitseeritud; kas karistus väärteo eest määrati selleks pädeva kohtuvälise menetleja poolt; kas väärteo menetlemisel kohtuvälise menetleja poolt on järgitud väärteomenetlusõigust; kas menetlusalusele isikule karistuse määramine on toimunud kooskõlas karistuse kohaldamise alustega; kas väärteomenetlus ei kuulu lõpetamisele käesoleva seadustiku §-s 30 sätestatud alustel.",
      "rdfs:label": {
        "@value": "VTMS_Par_133 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_133_v553290"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 133",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_133_v553290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_133"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaebuse lahendamiseks selgitab kohus järgmised küsimused: kas väärteoasjas ei esine käesoleva seadustiku §-s 29 sätestatud väärteomenetlust välistavaid asjaolusid; kas leidis aset tegu, milles menetlusalust isikut süüdistatakse; kas teo on pannud toime menetlusalune isik; kas tegu on väärtegu ning kas see on õigesti kvalifitseeritud; kas karistus väärteo eest määrati selleks pädeva kohtuvälise menetleja poolt; kas väärteo menetlemisel kohtuvälise menetleja poolt on järgitud väärteomenetlusõigust; kas menetlusalusele isikule karistuse määramine on toimunud kooskõlas karistuse kohaldamise alustega; kas väärteomenetlus ei kuulu lõpetamisele käesoleva seadustiku §-s 30 sätestatud alustel; kas lõpetada väärteomenetlus ja kohaldada karistusseadustiku §-s 87 sätestatud alaealisele kohaldatavaid mõjutusvahendeid või anda väärteoasja materjalid üle alaealiste komisjonile.",
      "rdfs:label": {
        "@value": "VTMS_Par_133 (redaktsioon 553290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "553290",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_133_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/553290",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 133",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
