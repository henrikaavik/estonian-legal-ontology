    {
      "@id": "estleg:VTMS_Par_73_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuväline menetleja teeb: otsuse rahatrahvi määramise kohta; väärteomenetluse lõpetamise määruse käesoleva seadustiku §-s 29 või 30 sätestatud alustel. (2) Kui kohtuväline menetleja teeb väärteomenetluse lõpetamise määruse alla 14-aastase isiku kohta, järgitakse käesoleva seadustiku § 29 lõikes 2 sätestatut.",
      "rdfs:label": {
        "@value": "VTMS_Par_73 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_73_v553290"
      },
      "estleg:versionValidTo": {
        "@value": "2003-03-20",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 73",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_73_v553290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuväline menetleja teeb: otsuse rahatrahvi määramise kohta; väärteomenetluse lõpetamise määruse käesoleva seadustiku §-s 29 või 30 sätestatud alustel. (2) Kui kohtuväline menetleja teeb väärteomenetluse lõpetamise määruse alaealise kohta, kes ei olnud õigusvastast tegu toime pannes oma ea tõttu süüvõimeline või oli neljateist- kuni kaheksateistaastane, järgitakse vastavalt käesoleva seadustiku § 29 lõikes 2 või § 30 lõikes 2 sätestatut.",
      "rdfs:label": {
        "@value": "VTMS_Par_73 (redaktsioon 553290)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "553290",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_73_v693416"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/553290",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 73",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_73_v693416",
