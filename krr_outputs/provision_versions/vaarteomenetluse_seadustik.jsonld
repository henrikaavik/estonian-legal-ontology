      }
    },
    {
      "@id": "estleg:VTMS_Par_140_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- või linnakohus saadab apellatsiooni koopiad kohtumenetluse pooltele apellatsiooni kättesaamisest alates kolme päeva jooksul. (2) Kohtumenetluse pooltel on õigus: tutvuda kohtus väärteotoimikuga ning teha toimikus olevatest kirjalikest tõenditest väljakirjutusi ning taotleda kohtu kantseleilt toimikus olevatest kirjalikest tõenditest tasu eest koopiate tegemist; esitada ringkonnakohtule apellatsiooni kohta kirjalik vastulause kuni kohtuistungi alguseni. (3) Kui apellatsioonitähtaeg on möödunud, saadab maa- või linnakohus apellatsiooni ja väärteotoimiku ringkonnakohtusse.",
      "rdfs:label": {
        "@value": "VTMS_Par_140 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_140_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 140",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_140_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_140"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maa- või linnakohus saadab apellatsiooni koopiad kohtumenetluse pooltele apellatsiooni kättesaamisest alates kolme päeva jooksul. (2) Kohtumenetluse pooltel on õigus: tutvuda kohtus väärteotoimikuga ning teha toimikus olevatest kirjalikest tõenditest väljakirjutusi ning taotleda kohtu kantseleilt toimikus olevatest kirjalikest tõenditest tasu eest koopiate tegemist; esitada ringkonnakohtule apellatsiooni kohta kirjalik vastulause kuni kohtuistungi alguseni. (3) Kui apellatsioonitähtaeg on möödunud, saadab maa- või linnakohus apellatsiooni ja väärteotoimiku ringkonnakohtusse. [Paragrahvi 140 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VTMS_Par_140 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
      "estleg:supersededByVersion": {
