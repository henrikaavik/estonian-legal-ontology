      }
    },
    {
      "@id": "estleg:VTMS_Par_71_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_71"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väärteoasja arutamine allub vastavalt käesoleva seadustiku §-le 83 maa- või linnakohtule, saadab kohtuväline menetleja 20 päeva möödudes pärast menetlusaluse isiku või tema kaitsja poolt väärteoprotokolli koopia kättesaamist väärteotoimiku, esitatud vastulause ja sellele lisatud materjalid asja arutamiseks maa- või linnakohtule. (2) Kui väärteoasja arutamine allub vastavalt käesoleva seadustiku §-le 83 maa- või linnakohtule ja menetlusalune isik on vastavalt käesoleva seadustiku § 44 lõikele 1 kinni peetud, toimitakse käesoleva seadustiku § 44 lõike 2 punkti 3 kohaselt. [Paragrahvi 71 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VTMS_Par_71 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_71_v977490"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928061",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 71",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_71_v977490",
