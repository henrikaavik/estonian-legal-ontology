    {
      "@id": "estleg:VTMS_Par_85_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asja kohtulikku arutamist ette valmistades maa- või linnakohtunik: kontrollib väärteoasja kohtualluvust; teeb kindlaks kohtumenetluse pooled, tunnistaja, tõlgi ja eksperdi ning teatab neile asja arutamise aja ja koha; teeb kindlaks, milliseid tõendeid tuleb uurida kohtulikul arutamisel ja võtab tarvitusele abinõud nende esitamiseks kohtuistungil; lahendab tunnistajate erinõude korras ülekuulamise teises maa- või linnakohtus; lahendab ekspertiisi tegemise, arvestades kohtumenetluse poolte arvamust; lahendab kohtumenetluse poolte esitatud taotlused.",
      "rdfs:label": {
        "@value": "VTMS_Par_85 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_85_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 85",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_85_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
