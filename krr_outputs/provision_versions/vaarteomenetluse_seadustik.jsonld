    {
      "@id": "estleg:VTMS_Par_141_v125042012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_141"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eelmenetluses kohtunik: kontrollib apellatsiooniõigust, apellatsioonitähtaega ja apellatsiooni nõuete täitmist vastavalt käesoleva seadustiku §-dele 136, 137 ja 139; jätab apellatsiooni käiguta käesoleva seadustiku § 142 lõikes 1 sätestatu alusel; jätab apellatsiooni läbi vaatamata käesoleva seadustiku § 142 lõikes 2 sätestatu alusel; saadab väärteoasja maakohtule uueks arutamiseks käesoleva seadustiku §-s 143 sätestatu alusel; lõpetab väärteomenetluse käesoleva seadustiku § 144 lõikes 1 sätestatu alusel; lahendab asja kirjalikus menetluses vastavalt käesoleva seadustiku §-le 145. (2) Kui apellatsiooni ei lahendata käesoleva paragrahvi lõike 1 punkte 2–6 järgides, selgitab kohtunik kohtuistungile kutsutavad isikud, apellatsioonist tulenevad kohtuliku arutamise piirid ja uuritavad tõendid, lahendab apellatsioonis esitatud taotlused, kutsub kohtumenetluse pooled kohtuistungile käesoleva seadustiku §-de 40 ja 41 kohaselt ning määrab asja arutada vastavalt käesoleva seadustiku §-le 121.",
      "rdfs:label": {
        "@value": "VTMS_Par_141 (redaktsioon 125042012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125042012008",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/125042012008",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 141",
