      },
      "dc:source": "Väärteomenetluse seadustik"
    },
    {
      "@id": "estleg:VTMS_Par_1_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevas seadustikus sätestatakse väärtegude kohtuvälise menetluse ja kohtumenetluse kord ning väärteo eest kohaldatud karistuse täitmisele pööramise kord.",
      "rdfs:label": {
        "@value": "VTMS_Par_1 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 1",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_10_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuväline menetleja osaleb menetluses ametniku kaudu. (2) Kohtuväline menetleja kinnitab nende ametikohtade loetelu, mida täitev ametnik on pädev väärteomenetluses osalema kohtuvälise menetleja nimel. (3) Kohtuväline menetleja annab ametnikule tema pädevust tõendava tunnistuse. Tunnistuses peab olema märgitud ametniku pädevuse aluseks oleva õigusakti nimetus, number ja kuupäev. (4) Kohtuvälise menetleja ametnik on kohustatud esitama menetlusalusele isikule ja teistele menetlusosalistele ning kohtule oma pädevust tõendava tunnistuse.",
      "rdfs:label": {
        "@value": "VTMS_Par_10 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_10_v236547"
      },
      "estleg:versionValidTo": {
        "@value": "2003-01-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_10_v236547",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-01-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuväline menetleja osaleb menetluses ametniku kaudu. (2) Kohtuväline menetleja kinnitab nende ametikohtade loetelu, mida täitev ametnik on pädev väärteomenetluses osalema kohtuvälise menetleja nimel. (3) Kohtuväline menetleja annab ametnikule tema pädevust tõendava tunnistuse. Tunnistuses peab olema märgitud ametniku pädevuse aluseks oleva õigusakti nimetus, number ja kuupäev. (4) Kohtuvälise menetleja ametnik on kohustatud esitama menetlusalusele isikule ja teistele menetlusosalistele ning kohtule oma pädevust tõendava tunnistuse. (5) Käesoleva seadustiku § 9 punktis 3 nimetatud eraõiguslik juriidiline isik osaleb väärteomenetluses oma töötaja kaudu. Eraõiguslikule juriidilisele isikule laieneb käesoleva paragrahvi lõigetes 2–4 sätestatu tema erisusi arvestades.",
      "rdfs:label": {
        "@value": "VTMS_Par_10 (redaktsioon 236547)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "236547",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_10_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/236547",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 10",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_10_v928061",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuväline menetleja osaleb menetluses ametniku kaudu. (2) Kohtuväline menetleja kinnitab nende ametikohtade loetelu, mida täitev ametnik on pädev väärteomenetluses osalema kohtuvälise menetleja nimel. Vajaduse korral võib loetelus eristada ametikohad karistuse määramise pädevusest tulenevalt. (3) Kohtuväline menetleja annab ametnikule tema pädevust tõendava tunnistuse. Tunnistuses peab olema märgitud ametniku pädevuse aluseks oleva õigusakti nimetus, number ja kuupäev. (4) Kohtuvälise menetleja ametnik on kohustatud esitama menetlusalusele isikule ja teistele menetlusosalistele ning kohtule oma pädevust tõendava tunnistuse. (5) Käesoleva seadustiku § 9 punktis 3 nimetatud eraõiguslik juriidiline isik osaleb väärteomenetluses oma töötaja kaudu. Eraõiguslikule juriidilisele isikule laieneb käesoleva paragrahvi lõigetes 2–4 sätestatu tema erisusi arvestades.",
      "rdfs:label": {
        "@value": "VTMS_Par_10 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_10_v12970497"
      },
      "estleg:versionValidTo": {
        "@value": "2008-05-15",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/928061",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 10",
      "estleg:partOfAct": {
