    {
      "@id": "estleg:VTMS_Par_72_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_72"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui väärteoasja menetlemine on seaduse alusel kohtuvälise menetleja pädevuses ja seadus ei näe ette, et väärteoasja arutab kohus, teeb kohtuväline menetleja käesoleva seadustiku §-s 73 märgitud lahendi menetlusaluse isiku ütlustest, asjas kogutud tõenditest, esitatud vastulausest ja sellele lisatud materjalist lähtudes kirjalikus menetluses menetlusosalisi välja kutsumata. (2) Otsuse tegemisel peab kohtuväline menetleja lahendama käesoleva seadustiku §-s 108 loetletud küsimused.",
      "rdfs:label": {
        "@value": "VTMS_Par_72 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_72_v1028004"
      },
      "estleg:versionValidTo": {
        "@value": "2006-05-24",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 72",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
