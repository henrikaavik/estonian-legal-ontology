      }
    },
    {
      "@id": "estleg:VTMS_Par_165_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_165"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohus teeb kassaatorile ja kohtumenetluse pooltele teatavaks kohtuistungi kuupäeva ja koha. (2) Kohtukutse saadetakse kassaatorile ja teiste kohtumenetluse poolte advokaatidest esindajatele. (3) Kui kassaator ja teiste kohtumenetluse poolte advokaatidest esindajad on kutse kätte saanud, ei takista nende mitteilmumine asja arutamist.",
      "rdfs:label": {
        "@value": "VTMS_Par_165 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_165_v693416"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 165",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_165_v693416",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_165"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Riigikohus teeb kassaatorile ja kohtumenetluse pooltele teatavaks kohtuistungi kuupäeva ja koha. (2) Kohtukutse saadetakse kassaatorile, kohtuvälisele menetlejale ja teiste kohtumenetluse poolte advokaatidest esindajatele. (3) Kui kassaator, kohtuväline menetleja ja teiste kohtumenetluse poolte advokaatidest esindajad on kutse kätte saanud, ei takista nende ilmumata jäämine asja arutamist .",
      "rdfs:label": {
        "@value": "VTMS_Par_165 (redaktsioon 693416)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "693416",
      "estleg:supersededByVersion": {
