    {
      "@id": "estleg:VTMS_Par_163_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_163"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtumenetluse pooltel on õigus tutvuda Riigikohtus väärteotoimiku ja kassatsiooniga advokaadist esindaja vahendusel, teha kassatsioonist ja toimikus olevatest dokumentidest oma kulul koopiaid ning esitada advokaadist esindaja vahendusel Riigikohtule kassatsioonivastus.",
      "rdfs:label": {
        "@value": "VTMS_Par_163 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_163_v1028004"
      },
      "estleg:versionValidTo": {
