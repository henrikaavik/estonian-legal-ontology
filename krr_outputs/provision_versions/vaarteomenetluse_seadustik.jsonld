      }
    },
    {
      "@id": "estleg:VTMS_Par_188_v171515",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_188"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast väärteoasja teistmist toimub kohtumenetlus maa- ja linnakohtus ning ringkonnakohtus üldkorras. (2) Kohtuliku uurimiseta võib menetluse lõpetada: kui süüdlane on surnud; kui asjaolud on selged ja kohtuväline menetleja ei taotle kohtulikku arutamist.",
      "rdfs:label": {
        "@value": "VTMS_Par_188 (redaktsioon 171515)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171515",
      "estleg:supersededByVersion": {
        "@id": "estleg:VTMS_Par_188_v928061"
      },
      "estleg:versionValidTo": {
        "@value": "2005-09-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/171515",
      "estleg:sourceAct": "Väärteomenetluse seadustik",
      "estleg:provisionRef": "VTMS § 188",
      "estleg:partOfAct": {
        "@id": "estleg:VTMS_Map"
      }
    },
    {
      "@id": "estleg:VTMS_Par_188_v928061",
      "@type": [
