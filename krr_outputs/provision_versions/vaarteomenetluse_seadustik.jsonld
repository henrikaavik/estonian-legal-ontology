      "estleg:versionText": "[Paragrahvi 114 pealkirja sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "VTMS_Par_114 (redaktsioon 928061)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "928061",
      "estleg:supersededByVersion": {
