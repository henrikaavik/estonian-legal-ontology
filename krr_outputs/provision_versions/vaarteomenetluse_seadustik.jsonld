    },
    {
      "@id": "estleg:VTMS_Par_108_v553290",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VTMS_Par_108"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-03-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtuotsuse tegemiseks selgitatakse: kas on toime pandud seadusega sätestatud väärteo tunnustele vastav tegu; väärteo kvalifikatsioon: seaduse nimetus, paragrahv, lõige ja punkt; kas väärteo on toime pannud menetlusalune isik; teo õigusvastasus ja süülisus; kas on karistust kergendavaid või raskendavaid asjaolusid; karistuse liik ja määr; kuidas toimida asitõendite ja muude äravõetud esemetega; kas on vaja kohaldada konfiskeerimist; kas mõista karistus karistusseadustiku § 63 lõike 1 või 3 kohaselt; kas lõpetada väärteomenetlus ja kohaldada karistusseadustiku §-s 87 sätestatud alaealisele kohaldatavaid mõjutusvahendeid või anda väärteoasja materjalid üle alaealiste komisjonile.",
      "rdfs:label": {
