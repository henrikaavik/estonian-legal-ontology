        "@type": "xsd:date"
      },
      "estleg:versionText": "Õpilasele või üliõpilasele igal õppekuul makstava põhitoetuse, täiendava toetuse ja doktoranditoetuse suurus kehtestatakse igaks aastaks riigieelarvega.",
      "rdfs:label": {
