      "rdfs:label": {
        "@value": "ÕÕS_Par_21 (redaktsioon 12749233)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12749233",
      "estleg:supersededByVersion": {
        "@id": "estleg:ÕÕS_Par_21_v13315676"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ÕÕS_Par_21_v13315676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
