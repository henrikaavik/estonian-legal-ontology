        "@type": "xsd:date"
      },
      "estleg:versionText": "Kord reguleerib ümberkruntimiskava koostamist kinnisasjade ümberkruntimisel ning täpsustab ümberkruntimiskavale ja selle lisadele esitatavaid nõudeid. Kord reguleerib ümberkruntimiskava koostamist kinnisasjade ümberkruntimisel ning täpsustab ümberkruntimiskavale ja selle lisadele esitatavaid nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1061584_Par_1 (redaktsioon 1061584)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061584",
