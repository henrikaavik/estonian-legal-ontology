      "estleg:provisionRef": "Reg_1061584 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061584_Map"
      }
    },
    {
      "@id": "estleg:Reg_1061584_Par_8_v1061584",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061584_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ümberkruntimiskava kaardist koostatakse väljavõte koos seadusjärgsete kitsenduste aladega ning kinnistusraamatusse kantud ruumilise ulatusega seotud piiratud asjaõiguste asukoha ja ulatuse kohta. Ümberkruntimiskava kaardist koostatakse väljavõte koos seadusjärgsete kitsenduste aladega ning kinnistusraamatusse kantud ruumilise ulatusega seotud piiratud asjaõiguste asukoha ja ulatuse kohta. 2 (2) Kitsenduste ja piiratud asjaõiguste ulatus märgitakse kaardil erineva tähistusega, kusjuures samaliigiliste kitsenduste ja piiratud asjaõiguste ulatuse kajastamisel kasutatakse kogu maakorralduspiirkonna ulatuses sama kujundust. Kitsenduste ja piiratud asjaõiguste ulatus märgitakse kaardil erineva tähistusega, kusjuures samaliigiliste kitsenduste ja piiratud asjaõiguste ulatuse kajastamisel kasutatakse kogu maakorralduspiirkonna ulatuses sama kujundust.",
      "rdfs:label": {
        "@value": "Reg_1061584_Par_8 (redaktsioon 1061584)",
        "@language": "et"
      },
