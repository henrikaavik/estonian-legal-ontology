    {
      "@id": "estleg:Reg_1040656_Par_20_v1040656",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040656_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 22. juuni 2015. a käskkirjaga nr 609 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 22. juuni 2015. a käskkirjaga nr 609 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1040656_Par_20 (redaktsioon 1040656)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040656",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040656",
      "estleg:sourceAct": "Kaugatoma-Lõu maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1040656 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040656_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040656_Par_21_v1040656",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040656_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1040656_Par_21 (redaktsioon 1040656)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040656",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1040656",
      "estleg:sourceAct": "Kaugatoma-Lõu maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1040656 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040656_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040656_Par_3_v1040656",
      "@type": [
        "owl:NamedIndividual",
