      "estleg:provisionRef": "Reg_1040656 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040656_Map"
      }
    },
    {
      "@id": "estleg:Reg_1040656_Par_10_v1040656",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1040656_Par_10"
