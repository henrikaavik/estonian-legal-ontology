      },
      "estleg:versionValidFrom": {
        "@value": "2017-11-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1040656_Par_3 (redaktsioon 1040656)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1040656",
