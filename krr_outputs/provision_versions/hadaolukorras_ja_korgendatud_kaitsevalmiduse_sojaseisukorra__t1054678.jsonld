      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse hädaolukorra, kõrgendatud kaitsevalmiduse või sõjaseisukorra lahendamise või mobilisatsiooni ja demobilisatsiooni toetamise või korraldamise ajal ühelt riigivara valitsejalt teisele täidesaatva riigivõimu asutusele riigivara valitsemise üleandmise, vara ajutisse kasutusse võtmise ja tagastamise ning kulude hüvitamise tingimused ja korraldamise põhimõtted. Määrusega kehtestatakse hädaolukorra, kõrgendatud kaitsevalmiduse või sõjaseisukorra lahendamise või mobilisatsiooni ja demobilisatsiooni toetamise või korraldamise ajal ühelt riigivara valitsejalt teisele täidesaatva riigivõimu asutusele riigivara valitsemise üleandmise, vara ajutisse kasutusse võtmise ja tagastamise ning kulude hüvitamise tingimused ja korraldamise põhimõtted.",
      "rdfs:label": {
        "@value": "Reg_1054678_Par_1 (redaktsioon 1054678)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054678",
