      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Hädaolukorras ja kõrgendatud kaitsevalmiduse, sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ajal riigivara valitsemise üleandmise või ajutisse kasutusse võtmise, tagastamise ja kulude hüvitamise tingimused ning kord (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Hädaolukorras ja kõrgendatud kaitsevalmiduse, sõjaseisukorra, mobilisatsiooni ja demobilisatsiooni ajal riigivara valitsemise üleandmise või ajutisse kasutusse võtmise, tagastamise ja kulude hüvitamise tingimused ning kord"
    },
    {
      "@id": "estleg:Reg_1054678_Par_1_v1054678",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
