    {
      "@id": "estleg:Reg_301190_Par_10_v301190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301190_Par_10"
