    {
      "@id": "estleg:Reg_301190_Par_13_v301190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301190_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) telkimine ja lõkke tegemine kaitseala valitseja nõusolekul selleks ettevalmistatud ja tähistatud kohtades. Piiranguvööndis on lubatud: majandustegevus; telkimine ja lõkke tegemine kaitseala valitseja nõusolekul selleks ettevalmistatud ja tähistatud kohtades. 2 (2) Kaitseala valitseja nõusolekul on lubatud ehitise, kaasa arvatud ajutise ehitise püstitamine. Kaitseala valitseja nõusolekul on lubatud ehitise, kaasa arvatud ajutise ehitise püstitamine.",
      "rdfs:label": {
        "@value": "Reg_301190_Par_13 (redaktsioon 301190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301190",
      "estleg:sourceAct": "Nõmme raba looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301190 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_301190_Par_14_v301190",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_301190_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 3 3) maavara kaevandamine; 4 4) puhtpuistute kujundamine ja energiapuistute rajamine; 5 5) uuendusraie, välja arvatud lageraie langi suurusega kuni 1 ha ja laiusega kuni 30 m ning turberaie langi suurusega kuni 2 ha, kusjuures piiranguvööndi üle 60-aastase metsa osakaal ei tohi jääda väiksemaks kui 50% ning raielankide vahele tuleb jätta vähemalt 100 m laiune riba üle 40 aasta vanust puistut; 6 6) puidu kokku- ja väljavedu külmumata pinnasel; 7 7) biotsiidi ja taimekaitsevahendi kasutamine. Piiranguvööndis on keelatud: uue maaparandussüsteemi rajamine; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; maavara kaevandamine; puhtpuistute kujundamine ja energiapuistute rajamine; uuendusraie, välja arvatud lageraie langi suurusega kuni 1 ha ja laiusega kuni 30 m ning turberaie langi suurusega kuni 2 ha, kusjuures piiranguvööndi üle 60-aastase metsa osakaal ei tohi jääda väiksemaks kui 50% ning raielankide vahele tuleb jätta vähemalt 100 m laiune riba üle 40 aasta vanust puistut; puidu kokku- ja väljavedu külmumata pinnasel; biotsiidi ja taimekaitsevahendi kasutamine.",
      "rdfs:label": {
        "@value": "Reg_301190_Par_14 (redaktsioon 301190)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301190",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301190",
      "estleg:sourceAct": "Nõmme raba looduskaitseala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_301190 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_301190_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_301190_Par_2_v301190",
      "@type": [
        "owl:NamedIndividual",
