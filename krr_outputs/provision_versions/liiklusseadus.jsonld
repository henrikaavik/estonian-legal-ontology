      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_11_v22474",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõidukiomanik on füüsiline või juriidiline isik, kellele sõiduk kuulub omandiõiguse alusel. (2) Sõidukiomanik tagab talle kuuluva sõiduki õige kasutamise, tehnilise korrasoleku ja nõuetekohase hoidmise.",
