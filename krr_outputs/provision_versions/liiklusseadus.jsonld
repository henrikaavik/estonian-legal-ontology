    },
    {
      "@id": "estleg:LIIKLU_2_Par_210_v102032012014",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_210"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-03-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootorsõidukit või maastikusõidukit, millel omal jõul ei ole lubatud sõita, juhtima lubamise eest sõiduki omaniku, valdaja või tehnonõuetele vastavuse või käitamise eest vastutava isiku poolt –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_210 (redaktsioon 102032012014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "102032012014",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/102032012014",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 210",
      "estleg:partOfAct": {
