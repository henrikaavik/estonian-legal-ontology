      "estleg:provisionRef": "LIIKLU_2 § 196_2",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_196_2_v104072017107",
      "@type": [
