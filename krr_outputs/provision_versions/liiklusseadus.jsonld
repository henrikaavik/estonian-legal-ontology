      },
      "estleg:versionText": "Liiklusjärelevalve teostaja kannab seadusega ettenähtud korras vastutust õigusvastase tegevuse või tegevusetuse eest.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_197 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
