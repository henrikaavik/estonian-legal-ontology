        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Motokiivri kasutamise nõuete rikkumise eest sõidukijuhi või sõitja poolt –karistatakse rahatrahviga kuni 50 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_239_1 (redaktsioon 106072018014)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "106072018014",
