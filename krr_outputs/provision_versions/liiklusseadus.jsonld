      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõiduki- või trammijuhi poolt sõitjate- või veoseveo nõuete rikkumise eest –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_238 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
