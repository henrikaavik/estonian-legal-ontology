    {
      "@id": "estleg:LIIKLU_2_Par_25_v22474",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juhiluba kehtib kümme aastat, kui käesoleva seaduse § 28 lõike 2 järgi kehtestatud nõuded ei näe ette lühemat tähtaega. (2) Esmane juhiluba kehtib kaks aastat.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_25 (redaktsioon 22474)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22474",
