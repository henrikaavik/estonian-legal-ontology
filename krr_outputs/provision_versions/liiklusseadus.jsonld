        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõiduki juhtimise eest, millel puudub kohustuslik sõidumeerik või mille sõidumeerik ei ole töökorras või on nõuetekohaselt plommimata, –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_211 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
