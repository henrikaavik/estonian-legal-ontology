    },
    {
      "@id": "estleg:LIIKLU_2_Par_256_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_256"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ohtlike ainete, esemete või jäätmete autoveol inimese elule, tervisele või keskkonnale kõrgendatud ohuga seonduvate nõuete rikkumise eest –karistatakse rahatrahviga kuni 200 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_256 (redaktsioon 117032011021)",
        "@language": "et"
      },
