      "estleg:provisionRef": "LIIKLU_2 § 225",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_225_v129062014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_225"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootorsõiduki, maastikusõiduki või trammi omaniku, valdaja või juhi poolt joobeseisundis või käesoleva seaduse § 69 lõikes 3 nimetatud seisundis isiku mootorsõidukit, maastikusõidukit või trammi juhtima lubamise või talle juhtimise üleandmise eest –karistatakse rahatrahviga kuni 300 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_225 (redaktsioon 129062014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014029",
