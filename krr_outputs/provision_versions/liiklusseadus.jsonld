    {
      "@id": "estleg:LIIKLU_2_Par_27_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Suure eseme või käsikäruga jalakäija võib liikuda sõiduteel, kui ta kõnniteel või teepeenral liikudes takistaks teisi liiklejaid ja sõiduteel liikumine ei ole talle ja teistele liiklejatele ohtlik. (2) Pimeda ajal või halva nähtavuse korral, peab jalakäija kasutataval käsikärul, mis on üle ühe meetri lai, olema vasakul küljel ees valge ja taga punane tuli. Nimetatud tulede asemel võib käsikärul kasutada vasakul küljel ühte, eest valge ja tagant punase tulega laternat.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_27 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_279_v117032011021",
