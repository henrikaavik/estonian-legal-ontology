    {
      "@id": "estleg:LIIKLU_2_Par_170_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_170"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiklusõnnetuse sündmuskohal teostab päästetöid päästeasutus päästeseaduse kohaselt. (2) Liiklusõnnetuse sündmuskohal annab meditsiinilist abi kiirabi tervishoiuteenuste korraldamise seaduse kohaselt. (3) Liiklusõnnetuse kohal korraldab hukkunute äravedu politsei. (4) Kui sõidukijuht sai liiklusõnnetuses surma või selliselt vigastada, et ta toimetati haiglasse, korraldab tema sõiduki liiklusõnnetuse kohalt äraviimise ja tagab selle säilimise politsei.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_170 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_170_v130122011010"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 170",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_170_v130122011010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_170"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiklusõnnetuse sündmuskohal teostab päästetöid Päästeamet päästeseaduse kohaselt. (2) Liiklusõnnetuse sündmuskohal annab meditsiinilist abi kiirabi tervishoiuteenuste korraldamise seaduse kohaselt. (3) Liiklusõnnetuse kohal korraldab hukkunute äravedu politsei. (4) Kui sõidukijuht sai liiklusõnnetuses surma või selliselt vigastada, et ta toimetati haiglasse, korraldab tema sõiduki liiklusõnnetuse kohalt äraviimise ja tagab selle säilimise politsei.",
      "rdfs:label": {
