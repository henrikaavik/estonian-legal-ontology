      },
      "estleg:versionText": "Liiklusõnnetuse asjaolude väljaselgitamise, vormistamise, registreerimise ja arvestuse korra kehtestab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_60 (redaktsioon 22474)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22474",
