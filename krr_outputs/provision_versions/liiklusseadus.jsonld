      },
      "estleg:versionValidTo": {
        "@value": "2017-07-13",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 259",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_259_v104072017106",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_259"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-07-14",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalakäija, tasakaaluliikuri juhi, robotliikuri juhi või kasutaja, jalgratturi, pisimopeedijuhi, loomveoki juhi või sõitja poolt liiklusnõuete muu rikkumise eest, kui puudub käesoleva seaduse §-s 226, 234, 236, 237, 239 või 241 sätestatud väärteokoosseis, –karistatakse rahatrahviga kuni kümme trahviühikut. (2) Sama teo eest: kui see on toime pandud joobeseisundis; kui sellega on tekitatud inimesele ettevaatamatusest tervisekahjustus või kui sellega on tekitatud varaline kahju või liiklusoht, –karistatakse rahatrahviga kuni 100 trahviühikut.",
