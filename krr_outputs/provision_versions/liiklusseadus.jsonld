        "@language": "et"
      },
      "estleg:versionRedactionId": "130122011010",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/130122011010",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 170",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_171_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_171"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiklusõnnetusi registreerivad: politseiprefektuur; liikluskindlustusega tegelev kindlustusandja või Eesti Liikluskindlustuse Fond; tegevusloa alusel tegutsev tervishoiuteenuse osutaja; nimistu alusel tegutsev perearst. (2) Liiklusõnnetusest teatamise ning liiklusõnnetuse registreerimise, vormistamise, asjaolude väljaselgitamise ja arvestuse korra",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_171 (redaktsioon 117032011021)",
        "@language": "et"
      },
