      "estleg:provisionRef": "LIIKLU_2 § 37",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_37_v110122020015",
      "@type": [
