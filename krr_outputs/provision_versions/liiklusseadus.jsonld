        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui isiku suhtes on jõustunud mootorsõiduki juhtimisõiguse äravõtmise või kehtetuks tunnistamise otsus, on isik kohustatud viie tööpäeva jooksul otsuse jõustumisest arvates loovutama oma juhiloa Maanteeametile.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_127 (redaktsioon 130122015027)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122015027",
      "estleg:supersededByVersion": {
