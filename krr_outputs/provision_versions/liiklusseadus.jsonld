    {
      "@id": "estleg:LIIKLU_2_Par_207_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_207"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tehnonõuetele vastavuse kontrolli mitteläbinud mootorsõiduki või trammi juhtimise eest –karistatakse rahatrahviga kuni 50 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_207 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_207_v125052018005"
      },
      "estleg:versionValidTo": {
        "@value": "2018-05-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 207",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_207_v125052018005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_207"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tehnonõuetele vastavuse kontrolli mitteläbinud mootorsõiduki, samuti autorongi või masinrongi, mille koosseisus on tehnonõuetele vastavuse kontrolli mitteläbinud haagis, või trammi juhtimise eest –karistatakse rahatrahviga kuni 100 trahviühikut. (2) Sama teo eest, kui see pandi toime bussiga, üle 3500-kilogrammise täismassiga veoautoga või bussist või üle 3500-kilogrammise täismassiga veoautost koosneva autorongiga, –karistatakse rahatrahviga kuni 300 trahviühikut või arestiga.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_207 (redaktsioon 125052018005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "125052018005",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_207_v130032021003"
      },
      "estleg:versionValidTo": {
        "@value": "2021-04-08",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/125052018005",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 207",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
