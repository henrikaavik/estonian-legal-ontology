      "estleg:provisionRef": "LIIKLU_2 § 84",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_84_v112032015032",
      "@type": [
