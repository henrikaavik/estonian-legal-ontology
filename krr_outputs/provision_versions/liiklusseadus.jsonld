      "estleg:provisionRef": "LIIKLU_2 § 78",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_78_v114022014003",
      "@type": [
        "owl:NamedIndividual",
