    {
      "@id": "estleg:LIIKLU_2_Par_213_v108102014011",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_213"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Mootorsõidukit, millel puudub kohustuslik sõidumeerik, mille sõidumeerik ei ole töökorras või on nõuetekohaselt plommimata või mille sõidumeerikule on paigaldatud tööd häirida võimaldav seade, juhtima lubamise eest sõiduki omaniku, valdaja või tehnonõuetele vastavuse või käitamise eest vastutava isiku poolt –karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 3200 eurot.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_213 (redaktsioon 108102014011)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "108102014011",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/108102014011",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 213",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
