      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_144_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_144"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Trammijuhte valmistavad ette käesoleva seaduse § 112 lõikes 1 nimetatud tingimustele vastavad ja B-, C- või D-kategooria mootorsõiduki juhtide koolitamise õigusega koolitajad.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_144 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 144",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_145_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Trammi juhtimisõiguse annab Maanteeamet. (2) Trammi juhtimisel peab trammijuhil kaasas olema juhiluba ja trammi registreerimistunnistus. (3) Trammi juhtimisõigus võetakse ära, tunnistatakse kehtetuks ja taastatakse mootorsõiduki juhtimisõiguse äravõtmise, kehtetuks tunnistamise ja taastamise kohta sätestatu kohaselt. (4) Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimisõiguse andmise korra",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_145 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_145_v129062014029"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 145",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_145_v129062014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Trammi juhtimisõiguse annab Maanteeamet. (2) Trammi juhtimisel peab trammijuhil kaasas olema juhiluba ja trammi registreerimistunnistus. (3) Trammi juhtimisõigus võetakse ära, tunnistatakse kehtetuks ja taastatakse mootorsõiduki juhtimisõiguse äravõtmise, kehtetuks tunnistamise ja taastamise kohta sätestatu kohaselt. (4) Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimisõiguse andmise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_145 (redaktsioon 129062014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014029",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_145_v110122020015"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014029",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 145",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_145_v110122020015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_145"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Trammi juhtimisõiguse annab Transpordiamet. (2) Trammi juhtimisel peab trammijuhil kaasas olema juhiluba ja trammi registreerimistunnistus. (3) Trammi juhtimisõigus võetakse ära, tunnistatakse kehtetuks ja taastatakse mootorsõiduki juhtimisõiguse äravõtmise, kehtetuks tunnistamise ja taastamise kohta sätestatu kohaselt. (4) Trammijuhi kvalifikatsiooninõuded, trammijuhi ettevalmistamise, eksamineerimise ja temale trammi juhtimisõiguse andmise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_145 (redaktsioon 110122020015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110122020015",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 145",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_146_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Trammi ei tohi juhtida isik: kellel ei ole B-kategooria mootorsõiduki ja trammi juhtimisõigust; kes ei täida trammijuhile ja trammile kehtestatud ja juhiloale märgitud nõudeid või kes on kõrvaldatud sõiduki juhtimiselt käesoleva seaduse § 91 kohaselt. (2) Trammi omanik, valdaja või juht ei tohi lubada trammi juhtima isikut või anda juhtimist üle isikule, kellel puudub B-kategooria mootorsõiduki ja trammi juhtimisõigus, kes on joobeseisundis, alkoholi piirmäära ületavas seisundis või liiklusohtlikus terviseseisundis. (3) Trammijuht ei tohi olla joobeseisundis, alkoholi piirmäära ületavas seisundis ega liiklusohtlikus terviseseisundis. (4) Käesoleva paragrahvi lõikes 3 nimetatud seisund tuvastatakse käesoleva seaduse §-des 69 ja 70 sätestatud korras. (5) Trammijuhi liiklusohtlike terviseseisundite tuvastamise ekspertiisiakti vormi",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_146 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_146_v129062014029"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 146",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_146_v129062014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_146"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Trammi ei tohi juhtida isik: kellel ei ole B-kategooria mootorsõiduki ja trammi juhtimisõigust; kes ei täida trammijuhile ja trammile kehtestatud ja juhiloale märgitud nõudeid või kes on kõrvaldatud sõiduki juhtimiselt käesoleva seaduse § 91 kohaselt. (2) Trammi omanik, valdaja või juht ei tohi lubada trammi juhtima isikut või anda juhtimist üle isikule, kellel puudub B-kategooria mootorsõiduki ja trammi juhtimisõigus, kes on joobeseisundis, alkoholi piirmäära ületavas seisundis või liiklusohtlikus terviseseisundis. (3) Trammijuht ei tohi olla joobeseisundis, alkoholi piirmäära ületavas seisundis ega liiklusohtlikus terviseseisundis. (4) Käesoleva paragrahvi lõikes 3 nimetatud seisund tuvastatakse käesoleva seaduse §-des 69 ja 70 sätestatud korras. (5) Trammijuhi liiklusohtlike terviseseisundite tuvastamise ekspertiisiakti vormi kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_146 (redaktsioon 129062014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014029",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014029",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 146",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_147_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_147"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Trammijuht kõrvaldatakse trammi juhtimiselt, kui: on alust arvata, et ta on tarvitanud narkootilisi või psühhotroopseid aineid; on alust arvata, et ta on joobeseisundis, alkoholi piirmäära ületavas seisundis või liiklusohtlikus terviseseisundis; tal puudub trammi juhtimisõigus; tal puudub trammi kasutamise õigus; trammi rikke, heitmete saasteainesisalduse, mürataseme või muu puuduse tõttu on sellega sõidu jätkamine keelatud; tema juhiluba saadetakse ekspertiisi seoses võltsimise tunnuste ilmnemisega või on alust arvata, et ta terviseseisund ei vasta kehtestatud nõuetele. (2) Juhtimiselt kõrvaldamise otsuses märgitakse: otsuse tegemise aeg ja koht; otsuse teinud ametiisiku asutuse nimetus ja aadress; otsuse teinud ametiisiku ametikoht, ees- ja perekonnanimi; trammijuhi ees- ja perekonnanimi, isikukood või sünniaeg; trammijuhi elukoht; trammi tüüp, mark ja registreerimismärk; käesoleva paragrahvi lõike 1 punktides 1–7 nimetatud juhtimiselt kõrvaldamise alus ning juhtimiselt kõrvaldamise alguse aeg ja lõppemise tingimus; otsuse koostaja allkiri. (3) Juhtimiselt kõrvaldamise otsus jõustub selle tegemisest. (4) Juhtimiselt kõrvaldamise otsus vormistatakse kahes eksemplaris, millest üks antakse trammijuhile. Otsuse teisel eksemplaril kinnitab trammijuht otsuse kättesaamist allkirjaga ja märgib otsuse kättesaamise kuupäeva. Kui trammijuht keeldub allkirja andmast või on sellises joobe või haigusseisundis, milles ta ei ole võimeline allkirja andma, tehakse juhtimiselt kõrvaldamise otsusesse selle kohta kanne.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_147 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 147",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_148_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalgratast võib iseseisvalt sõiduteel juhtida vähemalt 10-aastane isik, kes on omandanud jalgratturi kvalifikatsiooni. 10–15-aastasel isikul peab sõiduteel sõitmisel olema kaasas sellekohane juhiluba. Seadusliku esindaja või viimase nõusolekul muu täiskasvanud isiku vahetu järelevalve all võib sõiduteel jalgratast juhtida vähemalt 8-aastane isik. (2) Pisimopeedi võib juhtida vähemalt 14-aastane isik. 14- ja 15-aastasel pisimopeedijuhil peab olema kaasas jalgrattajuhiluba. (3) Pisimopeedijuhi kvalifikatsioon peab vastama jalgratturi kvalifikatsioonile. (4) Jalgratturi kvalifikatsiooni nõuded",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_148 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_148_v129062014029"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 148",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_148_v129062014029",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalgratast võib iseseisvalt sõiduteel juhtida vähemalt 10-aastane isik, kes on omandanud jalgratturi kvalifikatsiooni. 10–15-aastasel isikul peab sõiduteel sõitmisel olema kaasas sellekohane juhiluba. Seadusliku esindaja või viimase nõusolekul muu täiskasvanud isiku vahetu järelevalve all võib sõiduteel jalgratast juhtida vähemalt 8-aastane isik. (2) Pisimopeedi võib juhtida vähemalt 14-aastane isik. 14- ja 15-aastasel pisimopeedijuhil peab olema kaasas jalgrattajuhiluba. (3) Pisimopeedijuhi kvalifikatsioon peab vastama jalgratturi kvalifikatsioonile. (4) Jalgratturi kvalifikatsiooni nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_148 (redaktsioon 129062014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014029",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_148_v112032015033"
      },
      "estleg:versionValidTo": {
        "@value": "2015-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014029",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 148",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_148_v112032015033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_148"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalgratast tohib iseseisvalt sõiduteel juhtida vähemalt kümneaastane isik, kes on omandanud jalgratturi kvalifikatsiooni. 10–15-aastasel isikul peab sõiduteel sõitmiseks olema jalgratta juhtimisõigus. Jalgratta juhtimisõigust tõendavaks dokumendiks on jalgrattajuhiluba või tõendatakse jalgratta juhtimisõigust liiklusregistri andmete alusel. Seadusliku esindaja või viimase nõusolekul muu täiskasvanud isiku vahetu järelevalve all võib sõiduteel jalgratast juhtida vähemalt kaheksa-aastane isik. Käesoleva lõike nõuded ei laiene õuealal liiklevale jalgratturile. (2) Pisimopeedi võib juhtida vähemalt 14-aastane isik. 14- ja 15-aastasel pisimopeedijuhil peab olema jalgratta juhtimisõigus. (2¹) Kui juhil on kaasas isikut tõendav dokument, ei ole Eestis väljastatud jalgrattajuhiloa kaasaskandmine kohustuslik, kui jalgratturi või pisimopeedijuhi andmed on kantud liiklusregistrisse. Kui jalgratturi või pisimopeedijuhi andmeid ei ole kantud liiklusregistrisse, peab tal olema kaasas jalgrattajuhiluba ning ta peab selle käesoleva paragrahvi lõigetes 1 või 2 nimetatud juhtimisõiguse tõendamiseks esitama politseiametniku või teise isiku nõudel, kelle pädevus selleks tuleneb seadusest. (3) Pisimopeedijuhi kvalifikatsioon peab vastama jalgratturi kvalifikatsioonile. (4) Jalgratturi kvalifikatsiooni nõuded kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_148 (redaktsioon 112032015033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015033",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 148",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_148_1_v110122020015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_148_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõiduteel kergliikuriga sõitmisel kohaldatakse kergliikurijuhile käesoleva seaduse §-s 148 jalgratturi vanusele ja kvalifikatsioonile ning juhtimisõiguse tõendamisele sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_148_1 (redaktsioon 110122020015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020015",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110122020015",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 148_1",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_149_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_149"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalgratturi koolitust viivad läbi ja valmistavad neid ohutuks liiklemiseks ette koolieelsed lasteasutused, põhikoolid, gümnaasiumid, kutseõppeasutused, huvikoolid, mootorsõidukijuhi koolitamise luba omavad koolitajad ning organisatsioonid, kelle põhikirjaliste tegevuste hulka kuulub jalgratturi koolitus. (2) Üksikkorras võib jalgratturit koolitada lapsevanem. (3) Jalgratturi õpetaja peab omama mis tahes mootorsõiduki juhiluba. (4) Jalgratturi ja pisimopeedijuhi koolitus tuleb läbi viia nõuetekohasel õppeväljakul ning nõuetele vastavate õppevahenditega. (5) Jalgratturi ja pisimopeedijuhi ettevalmistamise korra ja nõuded õppevahenditele ning õppeväljakutele",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_149 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_149_v129062014029"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 149",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
