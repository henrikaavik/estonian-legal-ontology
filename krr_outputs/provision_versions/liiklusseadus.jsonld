    {
      "@id": "estleg:LIIKLU_2_Par_229_v112032015033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_229"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Automaatse liiklusjärelevalve süsteemi mõõtmistegevuse korrapärase toimimise takistamise või häirimise eest viisil, mis tegi võimatuks õigusrikkumise andmete nõuetekohase dokumenteerimise või salvestamise –karistatakse rahatrahviga kuni 300 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_229 (redaktsioon 112032015033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015033",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015033",
