      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110122020015",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 139_1",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_14_v22474",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tüübikinnitus on menetlus, millega pädev asutus tunnistab antud sõiduki tüübi vastavust kehtivatele tehnonõuetele. (2) Eestis esmakordselt kasutusele võetavate autode, ratastraktorite ja nende haagiste ning mootorrataste tüübid kuuluvad tüübikinnitamisele. (3) Autode ja nende haagiste ning mootorrataste tüübikinnitamise eeskirja kehtestab teede- ja sideminister. (4) Ratastraktorite ja nende haagiste tüübikinnitamise eeskirja kehtestab põllumajandusminister.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_14 (redaktsioon 22474)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22474",
