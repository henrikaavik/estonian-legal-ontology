        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Juhi, tööandja ja riiklikku järelevalvet teostava ametiisiku kaart antakse viieks aastaks, töökoja kaart üheks aastaks.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_133 (redaktsioon 129062014029)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014029",
      "estleg:supersededByVersion": {
