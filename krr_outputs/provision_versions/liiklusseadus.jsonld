    {
      "@id": "estleg:LIIKLU_2_Par_259_v110122020015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_259"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalakäija, kergliikurijuhi, robotliikuri juhi või kasutaja, jalgratturi, pisimopeedijuhi, loomveoki juhi või sõitja poolt liiklusnõuete muu rikkumise eest, kui puudub käesoleva seaduse §-s 226, 234, 236, 237, 239 või 241 sätestatud väärteokoosseis, –karistatakse rahatrahviga kuni kümme trahviühikut. (2) Sama teo eest: kui see on toime pandud joobeseisundis; kui sellega on tekitatud inimesele ettevaatamatusest tervisekahjustus või kui sellega on tekitatud varaline kahju või liiklusoht, –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_259 (redaktsioon 110122020015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110122020015",
