      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiklusseadus (RT I 2001, 3, 6; 2010, 24, 115) tunnistatakse kehtetuks. (2) Kuni käesoleva seaduse jõustumiseni kehtinud kehtivad pärast käesoleva seaduse jõustumist niivõrd, kuivõrd nad ei ole vastuolus käesoleva seadusega, kuni nende kehtetuks tunnistamiseni.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_280 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 280",
      "estleg:partOfAct": {
