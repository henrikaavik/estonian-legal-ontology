        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/110122020015",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 259",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_259_v129062024025",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_259"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalakäija, kergliikurijuhi, robotliikuri juhi või kasutaja, jalgratturi, pisimopeedijuhi, loomveoki juhi või sõitja poolt liiklusnõuete muu rikkumise eest, kui puudub käesoleva seaduse §-s 2242, 226, 234, 236, 237, 239 või 241 sätestatud väärteokoosseis, –karistatakse rahatrahviga kuni 15 trahviühikut. (2) Sama teo eest: kui see on toime pandud lubatud alkoholi piirmäära ületanuna või joobeseisundis; kui sellega on tekitatud inimesele ettevaatamatusest tervisekahjustus või kui sellega on tekitatud varaline kahju või liiklusoht, –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_259 (redaktsioon 129062024025)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062024025",
