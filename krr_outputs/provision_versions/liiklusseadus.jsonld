      "estleg:provisionRef": "LIIKLU_2 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_9_v110122020015",
      "@type": [
