      "estleg:provisionRef": "LIIKLU_2 § 94",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_94_v112032015033",
      "@type": [
        "owl:NamedIndividual",
