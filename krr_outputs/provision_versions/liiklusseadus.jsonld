      },
      "estleg:versionText": "Käesoleva seaduse § 36 lõikes 2 nimetatud nõuded mootorsõidukijuhi õpetaja kvalifikatsioonile rakenduvad 2002. aasta 1. juulil.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_77 (redaktsioon 886951)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "886951",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_77_v117032011021"
      },
      "estleg:versionValidTo": {
        "@value": "2011-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/886951",
      "estleg:sourceAct": "Liiklusseadus",
