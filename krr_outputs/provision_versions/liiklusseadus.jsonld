    {
      "@id": "estleg:LIIKLU_2_Par_198_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_198"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Liiklusjärelevalvet teostatakse jalgsi või sõidukiga, liikuvas või paikses toimkonnas, teisaldatava või statsionaarse tehnilise vahendiga.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_198 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 198",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_199_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_199"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiklusjärelevalvet võib teostada: avalikult, politseivärvides alarmsõidukiga; avalikult, piirivalvevärvides alarmsõidukiga; politseiametnikud varjatult, eritunnusteta sõidukiga ja riietuses liiklus- ja muude õigusrikkumiste tõkestamiseks; teisaldatava või statsionaarse tehnilise vahendiga; kombineeritult, kasutades punktides 1–3 nimetatud meetodeid või liiklusalase politseioperatsiooniga. (2) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogu on majandus- ja kommunikatsiooniministri asutatud andmekogu, milles töödeldakse riigimaanteedele püsipaigaldatud kiirusmõõtesüsteemiga kogutud liiklusalaste õigusrikkumiste andmeid eesmärgiga tagada tõhus liiklusjärelevalve lubatud piirkiiruse ületamise suhtes. (3) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogusse kantud andmetel on õiguslik tähendus. (4) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogu vastutav töötleja on Maanteeamet. (5) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogu põhimääruse (6) Kiirusmõõturi ja kiirusmõõtesüsteemi kasutamisel tuleb järgida mõõtemetoodikat ja tootja kasutusjuhendi nõudeid. Nõuded mõõteprotseduurile ja mõõtetulemuste töötlemisele",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_199 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_199_v105122012002"
      },
      "estleg:versionValidTo": {
        "@value": "2013-01-18",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 199",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_199_v105122012002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_199"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-01-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Liiklusjärelevalvet võib teostada: avalikult, politseivärvides alarmsõidukiga; [Käesolevast tekstist välja jäetud.] - kehtis kuni 31.12.2011 politseiametnikud varjatult, eritunnusteta sõidukiga ja riietuses liiklus- ja muude õigusrikkumiste tõkestamiseks; teisaldatava või statsionaarse tehnilise vahendiga; kombineeritult, kasutades punktides 1–3 nimetatud meetodeid või liiklusalase politseioperatsiooniga. (2) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogu on majandus- ja kommunikatsiooniministri asutatud andmekogu, milles töödeldakse riigimaanteedele püsipaigaldatud kiirusmõõtesüsteemiga kogutud liiklusalaste õigusrikkumiste andmeid eesmärgiga tagada tõhus liiklusjärelevalve lubatud piirkiiruse ületamise suhtes. (3) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogusse kantud andmetel on õiguslik tähendus. (4) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogu vastutav töötleja on Maanteeamet. (5) Statsionaarse automaatse kiirusmõõtesüsteemi andmekogu põhimääruse (6) Kiirusmõõturi ja kiirusmõõtesüsteemi kasutamisel tuleb järgida mõõtemetoodikat ja tootja kasutusjuhendi nõudeid. Nõuded mõõteprotseduurile ja mõõtetulemuste töötlemisele",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_199 (redaktsioon 105122012002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "105122012002",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_199_v129062014029"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/105122012002",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 199",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
