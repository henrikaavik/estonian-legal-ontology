      "estleg:provisionRef": "LIIKLU_2 § 196",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_196_v129062014029",
