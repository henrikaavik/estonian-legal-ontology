    {
      "@id": "estleg:LIIKLU_2_Par_150_v112032015033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_150"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Jalgratturi ja pisimopeedijuhi eksamineerimise õigus on põhikoolil, gümnaasiumil, huvikoolil, Politsei- ja Piirivalveametil, mootorsõidukijuhi koolitamise luba omaval koolitajal ja Maanteeametil. (2) Jalgratta juhtimisõiguse taotleja peab edukalt sooritama teooria- ja sõidueksami. (3) Jalgratturi ja pisimopeedijuhi eksamineerimise korra kehtestab määrusega.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_150 (redaktsioon 112032015033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015033",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_150_v110122020015"
      },
