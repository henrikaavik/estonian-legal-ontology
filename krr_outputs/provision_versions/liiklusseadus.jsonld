      },
      "estleg:versionText": "(1) Eestis kehtib sõidukite parempoolne liiklus.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_3 (redaktsioon 927457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "927457",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_3_v117032011021"
      },
      "estleg:versionValidTo": {
        "@value": "2011-06-30",
