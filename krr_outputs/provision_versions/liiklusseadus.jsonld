    {
      "@id": "estleg:LIIKLU_2_Par_85_v129062014030",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kaitseväe ja Kaitseliidu mootorsõiduk, maastikusõiduk ja nende haagised peavad olema kehtestatud korras registreeritud ja läbinud tehnonõuetele vastavuse kontrolli ning neil peavad olema riiklikud registreerimismärgid. (2) Kaitseväe ja Kaitseliidu mootorsõiduki, maastikusõiduki ja nende haagiste registreerimise ja tehnonõuetele vastavuse kontrollimise korra ning tehnonõuded mootorsõidukile, maastikusõidukile ja nende haagistele ning nõuded nende varustusele kehtestab määrusega. (3) Kaitseväe ja Kaitseliidu sõiduki tüübikinnituse tunnistamisel on pädevaks asutuseks Kaitsevägi.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_85 (redaktsioon 129062014030)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014030",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_85_v112032015033"
      },
      "estleg:versionValidTo": {
        "@value": "2015-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/129062014030",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 85",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
