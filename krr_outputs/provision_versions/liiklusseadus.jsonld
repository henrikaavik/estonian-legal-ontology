      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõiduki suhtes tuleb sõlmida liikluskindlustuse leping või sõiduki kasutamisel peab sõiduki suhtes kehtima automaatne liikluskindlustus liikluskindlustuse seaduses sätestatud tingimustel. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_81 (redaktsioon 129062024026)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062024026",
