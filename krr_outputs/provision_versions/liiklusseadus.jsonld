      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõidukijuhi poolt teiste tööde tööaja käsitsi salvestuslehtedele või väljatrükile kandmata või digitaalsesse sõidumeerikusse manuaalselt sisestamata jätmise eest –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_212 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
