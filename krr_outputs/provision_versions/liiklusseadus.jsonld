        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Mootorsõidukile paigaldatud sõidumeeriku ettenähtud juhtudel kasutamata jätmise või sõidumeeriku või selle plommi tahtliku rikkumise eest –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_214 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
