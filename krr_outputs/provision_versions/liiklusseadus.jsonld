    {
      "@id": "estleg:LIIKLU_2_Par_262_v117032011021",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_262"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kirjalikus hoiatamismenetluses kohaldatakse hoiatustrahvi järgmiselt: suurima lubatud sõidukiiruse ületamise korral määratakse hoiatustrahv, mille suurus eurodes saadakse lubatud sõidukiirust ületanud kilomeetrite arvu korrutamisel arvuga 3; sõiduki parkimise eest selleks keelatud kohas või liikluskorraldusvahendiga ettenähtud parkimiskorda või -viisi rikkudes või ristmikul seismisega teiste liiklejate võimaliku takistamise või ühissõidukiraja lubamatu kasutamise eest määratakse hoiatustrahv suurusega 20 eurot; käesoleva paragrahvi punktis 2 kirjeldatud teo eest viisil, mis on ohtlik teistele liiklejatele või häirib oluliselt liiklust, määratakse hoiatustrahv suurusega 64 eurot; keelava fooritule ajal ristmikule või jalakäijate ülekäigurajale sõitmise eest määratakse hoiatustrahv suurusega 96 eurot; käesoleva paragrahvi punktis 4 kirjeldatud teo eest viisil, mis on ohtlik teistele liiklejatele või häirib oluliselt liiklust, määratakse hoiatustrahv suurusega 190 eurot.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_262 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_262_v112032015033"
      },
      "estleg:versionValidTo": {
        "@value": "2015-04-30",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 262",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_262_v112032015033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_262"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kirjalikus hoiatamismenetluses kohaldatakse hoiatustrahvi järgmiselt: suurima lubatud sõidukiiruse ületamise korral määratakse hoiatustrahv, mille suurus eurodes saadakse lubatud sõidukiirust ületanud kilomeetrite arvu korrutamisel arvuga 3; sõiduki parkimise eest selleks keelatud kohas või liikluskorraldusvahendiga ettenähtud parkimiskorda või -viisi rikkudes või ristmikul seismisega teiste liiklejate võimaliku takistamise või ühissõidukiraja lubamatu kasutamise eest määratakse hoiatustrahv suurusega 20 eurot; käesoleva paragrahvi punktis 2 kirjeldatud teo eest viisil, mis on ohtlik teistele liiklejatele või häirib oluliselt liiklust, määratakse hoiatustrahv suurusega 64 eurot; keelava fooritule ajal ristmikule või jalakäijate ülekäigurajale sõitmise eest määratakse hoiatustrahv suurusega 96 eurot; käesoleva paragrahvi punktis 4 kirjeldatud teo eest viisil, mis on ohtlik teistele liiklejatele või häirib oluliselt liiklust, määratakse hoiatustrahv suurusega 190 eurot; tehnonõuetele vastavuse kontrolli mitteläbinud mootorsõiduki juhtimise korral määratakse hoiatustrahv suurusega 25 eurot; liikluskindlustuse seaduse alusel kindlustuskohustusega hõlmatud sellise sõiduki liikluses kasutamise korral, millel ei ole kohustuslikku liikluskindlustust või automaatset liikluskindlustust, määratakse hoiatustrahv suurusega 25 eurot.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_262 (redaktsioon 112032015033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112032015033",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_262_v106072018014"
      },
      "estleg:versionValidTo": {
        "@value": "2018-12-31",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/112032015033",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 262",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
