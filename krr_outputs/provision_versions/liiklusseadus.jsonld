      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Trammijuhile kehtestatud töö- ja puhkeaja nõuete rikkumise eest trammijuhi poolt –karistatakse rahatrahviga kuni 100 trahviühikut.",
      "rdfs:label": {
