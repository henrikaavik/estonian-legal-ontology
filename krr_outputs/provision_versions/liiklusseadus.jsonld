    {
      "@id": "estleg:LIIKLU_2_Par_32_v748718",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_32"
