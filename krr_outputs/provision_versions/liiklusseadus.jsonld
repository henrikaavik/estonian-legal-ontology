        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõidukiomanik on füüsiline või juriidiline isik, kellele sõiduk kuulub omandiõiguse alusel. (2) Sõidukiomanik tagab talle kuuluva sõiduki õige kasutamise, tehnilise korrasoleku ja nõuetekohase hoidmise. (3) Kui mootorsõiduki omanik annab mootorsõiduki kasutada teisele isikule, peab ta säilitama mootorsõiduki kasutada andmisest kolme kuu jooksul ja liiklusjärelevalve teostaja nõudmisel esitama järgmised andmed: mootorsõidukit kasutanud isiku ees- ja perekonnanimi; mootorsõidukit kasutanud isiku aadress; mootorsõidukit kasutanud isiku juhiloa number.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_11 (redaktsioon 13093075)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13093075",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_11_v13248878"
      },
      "estleg:versionValidTo": {
        "@value": "2009-12-22",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13093075",
      "estleg:sourceAct": "Liiklusseadus",
      "estleg:provisionRef": "LIIKLU_2 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_11_v13248878",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:LIIKLU_2_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-12-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõidukiomanik on füüsiline või juriidiline isik, kellele sõiduk kuulub omandiõiguse alusel. (2) Sõidukiomanik tagab talle kuuluva sõiduki õige kasutamise, tehnilise korrasoleku ja nõuetekohase hoidmise. (3) Kui mootorsõiduki omanik annab mootorsõiduki kasutada teisele isikule, peab ta säilitama mootorsõiduki kasutada andmise või sõiduki kasutamise volikirja tähtaja lõppemisest kuue kuu jooksul ja liiklusjärelevalve teostaja nõudmisel esitama järgmised andmed: mootorsõidukit kasutanud isiku ees- ja perekonnanimi; mootorsõidukit kasutanud isiku aadress; mootorsõidukit kasutanud isiku juhiloa number; mootorsõidukit kasutanud isiku sünniaeg või isikukood.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_11 (redaktsioon 13248878)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13248878",
      "estleg:supersededByVersion": {
        "@id": "estleg:LIIKLU_2_Par_11_v13308365"
      },
      "estleg:versionValidTo": {
        "@value": "2010-05-09",
        "@type": "xsd:date"
      },
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/13248878",
