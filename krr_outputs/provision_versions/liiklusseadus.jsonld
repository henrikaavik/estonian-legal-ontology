      },
      "estleg:versionValidFrom": {
        "@value": "2011-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sõitja ei tohi sõidu ajal tõmmata juhi tähelepanu sõiduki juhtimiselt kõrvale.",
      "rdfs:label": {
        "@value": "LIIKLU_2_Par_28 (redaktsioon 117032011021)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "117032011021",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/117032011021",
