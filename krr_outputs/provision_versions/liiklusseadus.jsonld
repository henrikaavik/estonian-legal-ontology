      "estleg:provisionRef": "LIIKLU_2 § 190_9",
      "estleg:partOfAct": {
        "@id": "estleg:LIIKLU_2_Map"
      }
    },
    {
      "@id": "estleg:LIIKLU_2_Par_190_9_v110122020015",
