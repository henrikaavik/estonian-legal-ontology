      }
    },
    {
      "@id": "estleg:KRIMIN_Par_287_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_287"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Paragrahvi 288 sõnastus kuni 31. 08. 2002]",
      "rdfs:label": {
        "@value": "KRIMIN_Par_287 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
