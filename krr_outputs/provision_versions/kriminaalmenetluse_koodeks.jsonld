        "@value": "2002-10-23",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_276_v207008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_276"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õigeksmõistva kohtuotsuse resolutiivosas näidatakse: füüsilisest isikust õigeksmõistetu ees- ja perekonnanimi või juriidilisest isikust õigeksmõistetu nimetus; kohtualuse õigeksmõistmine kriminaalseaduse vastava paragrahvi, lõike või punkti järgi; valitud tõkendi tühistamine; tsiviilhagi tagamiseks tarvituselevõetud abinõude tühistamine; kuidas toimida asitõendite ja muude äravõetud esemetega; kohtuotsuse peale edasikaebamise kord ja tähtaeg.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_276 (redaktsioon 207008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207008"
    },
    {
      "@id": "estleg:KRIMIN_Par_277_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_277"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[kehtetu]",
      "rdfs:label": {
        "@value": "KRIMIN_Par_277 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201"
    },
    {
      "@id": "estleg:KRIMIN_Par_278_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_278"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsus kuulutatakse pärast sellele allakirjutamist. Kohtuotsuse loeb ette kohtunik või kohtukaasistuja kogu kohtukoosseisu juuresolekul istungisaalis. (2) Kõik istungisaalis viibijad kuulavad otsust seistes. (3) Kui kohtuotsus loetakse ette keeles, mida kohtualune ei valda, siis pärast kohtuotsuse kuulutamist tõlgib kohtuotsuse kohtualusele istungist osavõttev tõlk. (4) Kohtunik selgitab kohtualusele arusaadavas väljenduses kohtuotsuse sisu, samuti kohtuotsuse peale edasikaebamise korda ja tähtaega.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_278 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_278_v184247"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_278_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_278"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsus kuulutatakse pärast sellele allakirjutamist. Kohtuotsuse loeb ette kohtunik või rahvakohtunik kogu kohtukoosseisu juuresolekul istungisaalis. (2) Kõik istungisaalis viibijad kuulavad otsust seistes. (3) Kui kohtuotsus loetakse ette keeles, mida kohtualune ei valda, siis pärast kohtuotsuse kuulutamist tõlgib kohtuotsuse kohtualusele istungist osavõttev tõlk. (4) Kohtunik selgitab kohtualusele arusaadavas väljenduses kohtuotsuse sisu, samuti kohtuotsuse peale edasikaebamise korda ja tähtaega.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_278 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_278_v194734"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_278_v194734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_278"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsus kuulutatakse pärast sellele allakirjutamist. Kohtuotsuse loeb ette kohtunik või rahvakohtunik kogu kohtukoosseisu juuresolekul istungisaalis. (2) Kõik istungisaalis viibijad kuulavad otsust seistes. (3) Kui kohtuotsus loetakse ette keeles, mida kohtualune ei valda, siis pärast kohtuotsuse kuulutamist tõlgib kohtuotsuse kohtualusele istungist osavõttev tõlk. (4) Kohtunik selgitab kohtualusele arusaadavas väljenduses kohtuotsuse sisu, samuti kohtuotsuse peale edasikaebamise korda ja tähtaega. (5) Kohus võib kohtuotsuse resolutiivosa koostada eraldi menetlusdokumendina. Resolutiivosa kuulutades teatab kohus, millal menetlusosalised saavad kohtu kantseleis kohtuotsusega tutvuda. (6) Kui kohtuotsuse resolutiivosa koostatakse eraldi menetlusdokumendina, tuleb kohtuotsus koostada resolutiivosa kuulutamisest alates kahekümne päeva jooksul. (7) Käesoleva paragrahvi lõigetes 5 ja 6 sätestatud juhtudel lisatakse toimikusse kohtuotsuse resolutiivosa ja kohtuotsus.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_278 (redaktsioon 194734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194734"
    },
    {
      "@id": "estleg:KRIMIN_Par_279_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_279"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtualuse õigeksmõistmisel või tema vabastamisel karistuse kandmisest või temale karistuse mõistmisel, mis ei ole seotud vabadusekaotuse või arestiga, vabastatakse vahi all viibiv kohtualune vahi alt viivitamatult istungisaalis.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_279 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201"
    },
    {
      "@id": "estleg:KRIMIN_Par_280_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_280"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsuse ärakiri antakse kätte või saadetakse kohtualusele, samuti vahi alla võetud menetlusosalisele kolme ööpäeva jooksul pärast kohtuotsuse kuulutamist. Teistele menetlusosalistele saadetakse kohtuotsuse ärakiri nende taotlusel viie ööpäeva jooksul pärast kohtuotsuse kuulutamist. (2) Kui otsus oli kirjutatud keeles, mida kohtualune ei valda, antakse kohtuotsuse ärakiri temale kätte tõlgituna kohtualuse emakeelde või teise temale arusaadavasse keelde. (3) Jõustunud kohtuotsuse ärakiri saadetakse süüdimõistetu töökohta, elamu valdajale või kohaliku omavalitsuse asutusele. Kui süüdimõistetule on mõistetud mittevabadusekaotuslik karistus, saadetakse jõustunud kohtuotsuse ärakiri süüdimõistetu elukohajärgsele politseijaoskonnale. (4) Kohtualusele vabadusekaotusliku karistuse mõistmisel kindlustab kohus süüdimõistetu omastele võimaluse kohtuda süüdimõistetuga enne karistuse kandmisele asumist.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_280 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_280_v184247"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_280_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_280"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsuse ärakiri antakse kätte või saadetakse kohtualusele, samuti vahi alla võetud menetlusosalisele kolme ööpäeva jooksul pärast kohtuotsuse kuulutamist. Teistele menetlusosalistele saadetakse kohtuotsuse ärakiri nende taotlusel viie ööpäeva jooksul pärast kohtuotsuse kuulutamist. (2) Kui otsus oli kirjutatud keeles, mida kohtualune ei valda, antakse kohtuotsuse ärakiri temale kätte tõlgituna kohtualuse emakeelde või teise temale arusaadavasse keelde. (3) Jõustunud kohtuotsuse ärakiri saadetakse süüdimõistetu töökohta, elamu valdajale või kohaliku omavalitsuse asutusele. Kui süüdimõistetule on mõistetud mittevabadusekaotuslik karistus, saadetakse jõustunud kohtuotsuse ärakiri süüdimõistetu elukohajärgsele politseijaoskonnale. (4) Kohtualusele vabadusekaotusliku karistuse mõistmisel kindlustab kohus süüdimõistetu omastele võimaluse kohtuda süüdimõistetuga enne karistuse kandmisele asumist. Kahekümne kuues peatükk PSÜHHIAATRILISE SUNDRAVI KOHALDAMINE [Paragrahvi 281 sõnastus kuni 31. 08. 2002]",
      "rdfs:label": {
        "@value": "KRIMIN_Par_280 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_280_v194734"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_280_v194734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_280"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuotsuse ärakiri antakse kätte või saadetakse kohtualusele, samuti vahi alla võetud menetlusosalisele kolme ööpäeva jooksul pärast kohtuotsuse kuulutamist või kohtukantselei kaudu teatavaks tegemist. Teistele menetlusosalistele saadetakse kohtuotsuse ärakiri nende taotlusel viie ööpäeva jooksul. (2) Kui otsus oli kirjutatud keeles, mida kohtualune ei valda, antakse kohtuotsuse ärakiri temale kätte tõlgituna kohtualuse emakeelde või teise temale arusaadavasse keelde. (3) Jõustunud kohtuotsuse ärakiri saadetakse süüdimõistetu töökohta, elamu valdajale või kohaliku omavalitsuse asutusele. Kui süüdimõistetule on mõistetud mittevabadusekaotuslik karistus, saadetakse jõustunud kohtuotsuse ärakiri süüdimõistetu elukohajärgsele politseijaoskonnale. (4) Kohtualusele vabadusekaotusliku karistuse mõistmisel kindlustab kohus süüdimõistetu omastele võimaluse kohtuda süüdimõistetuga enne karistuse kandmisele asumist. Kahekümne kuues peatükk PSÜHHIAATRILISE SUNDRAVI KOHALDAMINE",
      "rdfs:label": {
        "@value": "KRIMIN_Par_280 (redaktsioon 194734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194734"
    },
    {
      "@id": "estleg:KRIMIN_Par_281_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_281"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui isik pani toime ühiskonnaohtliku teo süüdimatusseisundis või haigestus pärast selle teo toimepanemist, kuid enne kohtuotsuse tegemist vaimuhaigusesse, mille tagajärjel ta ei ole võimeline endale oma tegudest aru andma või neid juhtima, alustatakse kriminaalmenetlust ja uuritakse kriminaalasja üldises korras, välja arvatud käesolevas peatükis ettenähtud erandid. (2) Kui isik pani toime ühiskonnaohtliku teo süüdimatusseisundis või haigestus pärast selle teo toimepanemist, kuid enne kohtuotsuse tegemist vaimuhaigusesse, mille tagajärjel ta ei ole võimeline endale oma tegudest aru andma või neid juhtima, siis teeb uurija kriminaalasja lõpetamise määruse või määruse kriminaalasja saatmiseks kohtusse kriminaalkoodeksi §-s 59 lg 1 ettenähtud meditsiinilise iseloomuga mõjutusvahendite või kriminaalkoodeksi §-s 59 lg 4 ettenähtud vahendi kohaldamise otsustamiseks. (3) Isiku psüühilise seisundi tuvastab uurimise käigus kohtupsühhiaatriaekspertiis.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_281 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_281_v184247"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_281_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_281"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui isik pani toime ühiskonnaohtliku teo süüdimatusseisundis või haigestus pärast selle teo toimepanemist, kuid enne kohtuotsuse tegemist vaimuhaigusesse, mille tagajärjel ta ei ole võimeline endale oma tegudest aru andma või neid juhtima, alustatakse kriminaalmenetlust ja uuritakse kriminaalasja üldises korras, välja arvatud käesolevas peatükis ettenähtud erandid. (2) Kui isik pani toime ühiskonnaohtliku teo süüdimatusseisundis või haigestus pärast selle teo toimepanemist, kuid enne kohtuotsuse tegemist vaimuhaigusesse, mille tagajärjel ta ei ole võimeline endale oma tegudest aru andma või neid juhtima, siis teeb uurija kriminaalasja lõpetamise määruse või määruse kriminaalasja saatmiseks kohtusse kriminaalkoodeksi §-s 59 lg 1 ettenähtud meditsiinilise iseloomuga mõjutusvahendite või kriminaalkoodeksi §-s 59 lg 4 ettenähtud vahendi kohaldamise otsustamiseks. (3) Isiku psüühilise seisundi tuvastab uurimise käigus kohtupsühhiaatriaekspertiis. [Paragrahvi 281 sõnastus alates 1. 09. 2002]",
      "rdfs:label": {
        "@value": "KRIMIN_Par_281 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_281_v194734"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_281_v194734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_281"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui isik pani toime õigusvastase teo süüdimatus seisundis või kui tal pärast õigusvastase teo toimepanemist, kuid enne eeluurimise lõpetamist tuvastati vaimuhaigus või nõdrameelsus või muu raske psüühikahäire, alustatakse kriminaalmenetlust ja uuritakse kriminaalasja üldises korras käesolevas peatükis sätestatud erisustega. (2) Eeluurimise lõpetamisel käesoleva paragrahvi lõikes 1 tähendatud juhul teeb uurija määruse kriminaalasja saatmiseks kohtusse karistusseadustiku §-s 86 ettenähtud psühhiaatrilise sundravi määramise otsustamiseks. (3) Isiku psüühilise seisundi tuvastab uurimise käigus kohtupsühhiaatriaekspertiis.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_281 (redaktsioon 194734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194734"
    },
    {
      "@id": "estleg:KRIMIN_Par_282_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_282"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva koodeksi §-s 281 ettenähtud määruse saadab uurija koos toimikuga prokurörile, kes määrusega nõustumisel kinnitab selle ja annab üle kohtule, mittenõustumisel aga tagastab selle täiendavaks uurimiseks.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_282 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201"
    },
    {
      "@id": "estleg:KRIMIN_Par_283_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_283"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Saanud prokurörilt kriminaalasja, määrab kohtunik selle arutamisele, teatab sellest prokurörile, kaitsjale ja uurimisaluse seaduslikele esindajatele ning teeb korralduse kannatanute, tunnistajate ja ekspertide väljakutsumiseks. (2) Kriminaalasja arutamine toimub prokuröri ja kaitsja osavõtul. (3) Kui kohtunik leiab, et kriminaalasi kuulub lõpetamisele või tagastamisele täiendavaks uurimiseks, määrab ta kriminaalasja läbivaatamiseks kohtu korraldaval istungil.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_283 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201"
    },
    {
      "@id": "estleg:KRIMIN_Par_284_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_284"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalasja kohtulik arutamine toimub käesoleva koodeksi sätete kohaselt. (2) Kohtulik uurimine algab käesoleva koodeksi §-s 282 ettenähtud määruse avaldamisega. (3) Kohtuistungil kuulatakse üle tunnistajad ja kannatanud, kontrollitakse kõiki tõendeid, ekspertidearvamust uurimisaluse psüühilise seisundi kohta ja kõiki kriminaalasja otsustamisel olulise tähtsusega asjaolusid. (4) Kohtuistungile võib kohtu äranägemisel kutsuda isiku, kelle suhtes taotleti meditsiinilise iseloomuga mõjutusvahendi kohaldamist.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_284 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_284_v184247"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_284_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_284"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalasja kohtulik arutamine toimub käesoleva koodeksi sätete kohaselt. (2) Kohtulik uurimine algab käesoleva koodeksi §-s 282 ettenähtud määruse avaldamisega. (3) Kohtuistungil kuulatakse üle tunnistajad ja kannatanud, kontrollitakse kõiki tõendeid, ekspertidearvamust uurimisaluse psüühilise seisundi kohta ja kõiki kriminaalasja otsustamisel olulise tähtsusega asjaolusid. [Lõike 4 sõnastus kuni 31. 08. 2002] (4) Kohtuistungile võib kohtu äranägemisel kutsuda isiku, kelle suhtes taotleti meditsiinilise iseloomuga mõjutusvahendi kohaldamist. [Lõike 4 sõnastus alates 1. 09. 2002] (4) Kohtuistungile võib kohtu äranägemisel kutsuda isiku, kelle suhtes taotleti psühhiaatrilise sundravi kohaldamist.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_284 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_284_v194734"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_284_v194734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_284"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kriminaalasja kohtulik arutamine toimub käesoleva koodeksi sätete kohaselt. (2) Kohtulik uurimine algab käesoleva koodeksi §-s 282 ettenähtud määruse avaldamisega. (3) Kohtuistungil kuulatakse üle tunnistajad ja kannatanud, kontrollitakse kõiki tõendeid, ekspertidearvamust uurimisaluse psüühilise seisundi kohta ja kõiki kriminaalasja otsustamisel olulise tähtsusega asjaolusid. (4) Kohtuistungile võib kohtu äranägemisel kutsuda isiku, kelle suhtes taotleti psühhiaatrilise sundravi kohaldamist.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_284 (redaktsioon 194734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194734"
    },
    {
      "@id": "estleg:KRIMIN_Par_285_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_285"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus otsustab kriminaalasja oma määrusega, mis tehakse nõupidamistoas. (2) Määruse tegemisel peab kohus otsustama järgmised küsimused: kas on toimunud kriminaalseaduses ettenähtud ühiskonnaohtlik tegu; kas selle teo pani toime antud isik; kas antud isik pani selle teo toime süüdimatusseisundis või haigestus pärast kuriteo toimepanemist vaimuhaigusesse, mille tagajärjel ta ei ole võimeline endale oma tegudest aru andma või neid juhtima; kas antud isiku suhtes tuleb kohaldada kriminaalkoodeksi §-s 59 lg 1 ettenähtud meditsiinilise iseloomuga mõjutusvahendeid või kriminaalkoodeksi §-s 59 lg 4 ettenähtud vahendit ja nimelt millist vahendit.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_285 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_285_v184247"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_285_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_285"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus otsustab kriminaalasja oma määrusega, mis tehakse nõupidamistoas. [Lõike 2 sõnastus kuni 31. 08. 2002] (2) Määruse tegemisel peab kohus otsustama järgmised küsimused: kas on toimunud kriminaalseaduses ettenähtud ühiskonnaohtlik tegu; kas selle teo pani toime antud isik; kas antud isik pani selle teo toime süüdimatusseisundis või haigestus pärast kuriteo toimepanemist vaimuhaigusesse, mille tagajärjel ta ei ole võimeline endale oma tegudest aru andma või neid juhtima; kas antud isiku suhtes tuleb kohaldada kriminaalkoodeksi §-s 59 lg 1 ettenähtud meditsiinilise iseloomuga mõjutusvahendeid või kriminaalkoodeksi §-s 59 lg 4 ettenähtud vahendit ja nimelt millist vahendit. [Lõike 2 sõnastus alates 1. 09. 2002] (2) Määruse tegemisel peab kohus otsustama: kas on toimunud karistusseadustikus sätestatud õigusvastane tegu; kas selle teo pani toime antud isik; kas antud isik pani selle teo toime süüdimatus seisundis või jäi pärast õigusvastase teo toimepanemist vaimuhaigeks või nõdrameelseks või tal tekkis muu raske psüühikahäire, mille tõttu ta ei olnud võimeline aru saama oma teo keelatusest või oma käitumist vastavalt sellele arusaamisele juhtima; kas antud isiku suhtes tuleb kohaldada karistusseadustiku §-s 86 sätestatud psühhiaatrilist sundravi.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_285 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_285_v194734"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_285_v194734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_285"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohus otsustab kriminaalasja oma määrusega, mis tehakse nõupidamistoas. (2) Määruse tegemisel peab kohus otsustama: kas on toimunud karistusseadustikus sätestatud õigusvastane tegu; kas selle teo pani toime antud isik; kas antud isik pani selle teo toime süüdimatus seisundis või jäi pärast õigusvastase teo toimepanemist vaimuhaigeks või nõdrameelseks või tal tekkis muu raske psüühikahäire, mille tõttu ta ei olnud võimeline aru saama oma teo keelatusest või oma käitumist vastavalt sellele arusaamisele juhtima; kas antud isiku suhtes tuleb kohaldada karistusseadustiku §-s 86 sätestatud psühhiaatrilist sundravi.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_285 (redaktsioon 194734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194734"
    },
    {
      "@id": "estleg:KRIMIN_Par_286_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_286"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tunnistanud tõendatuks antud isiku poolt kriminaalseaduses ettenähtud ühiskonnaohtliku teo toimepanemise süüdimatusseisundis või pärast kuriteo toimepanemist vaimuhaigusesse haigestumise, mille tagajärjel see isik ei ole võimeline endale oma tegudest aru andma või neid juhtima, teeb kohus kriminaalasja lõpetamise määruse, ja kohaldab antud isiku suhtes kriminaalkoodeksi §-s 59 lg 1 ettenähtud meditsiinilise iseloomuga mõjutusvahendeid või kriminaalkoodeksi §-s 59 lg 4 ettenähtud vahendi või jätab need kohaldamata, kui selleks puudub vajadus. (2) Tunnistanud, et antud isiku süüdimatus ei ole kindlaks tehtud või et kuriteo toimepannud isiku haigestumine ei ole selline, et ta ei ole võimeline endale oma tegudest aru andma või neid juhtima, tagastab kohus kriminaalasja oma määrusega täiendavaks uurimiseks ja edasiseks menetluseks üldises korras. (3) Kui kohus tunnistab, et antud isiku süü ühiskonnaohtliku teo toimepanemises ei ole tõendatud või et kriminaalasjas esinevad käesoleva koodeksi §-s 5 ettenähtud kriminaalmenetluse alustamist kõrvaldavad alused, teeb ta kriminaalasja lõpetamise määruse.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_286 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_286_v184247"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-28",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_286_v184247",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_286"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Lõike 1 sõnastus kuni 31. 08. 2002] (1) Tunnistanud tõendatuks antud isiku poolt kriminaalseaduses ettenähtud ühiskonnaohtliku teo toimepanemise süüdimatusseisundis või pärast kuriteo toimepanemist vaimuhaigusesse haigestumise, mille tagajärjel see isik ei ole võimeline endale oma tegudest aru andma või neid juhtima, teeb kohus kriminaalasja lõpetamise määruse, ja kohaldab antud isiku suhtes kriminaalkoodeksi §-s 59 lg 1 ettenähtud meditsiinilise iseloomuga mõjutusvahendeid või kriminaalkoodeksi §-s 59 lg 4 ettenähtud vahendi või jätab need kohaldamata, kui selleks puudub vajadus. [Lõike 1 sõnastus alates 1. 09. 2002] (1) Tunnistanud tõendatuks antud isiku poolt karistusseadustikus sätestatud õigusvastase teo toimepanemise süüdimatus seisundis või pärast õigusvastase teo toimepanemist tema vaimuhaigeks või nõdrameelseks jäämise või tal muu raske psüühikahäire tekkimise, mille tagajärjel isik on oma teo ja vaimse seisundi tõttu ohtlik endale ja ühiskonnale ning vajab ravi, teeb kohus kriminaalasja lõpetamise määruse ja kohaldab antud isiku suhtes karistusseadustiku §-s 86 ettenähtud psühhiaatrilist sundravi või jätab selle kohaldamata, kui selleks puudub vajadus. [Lõike 2 sõnastus kuni 31. 08. 2002] (2) Tunnistanud, et antud isiku süüdimatus ei ole kindlaks tehtud või et kuriteo toimepannud isiku haigestumine ei ole selline, et ta ei ole võimeline endale oma tegudest aru andma või neid juhtima, tagastab kohus kriminaalasja oma määrusega täiendavaks uurimiseks ja edasiseks menetluseks üldises korras. [Lõike 2 sõnastus alates 1. 09. 2002] (2) Tunnistanud, et antud isiku poolt karistusseadustikus sätestatud õigusvastase teo toimepanemine süüdimatus seisundis ei ole tõendatud või et isik ei ole pärast õigusvastase teo toimepanemist jäänud vaimuhaigeks või nõdrameelseks või tal ei ole tekkinud muud rasket psüühikahäiret, mille tagajärjel ta oma teo ja vaimse seisundi tõttu on ohtlik endale ja ühiskonnale ning vajab ravi, tagastab kohus kriminaalasja oma määrusega täiendavaks uurimiseks ja edasiseks menetlemiseks üldises korras. (3) Kui kohus tunnistab, et antud isiku süü ühiskonnaohtliku teo toimepanemises ei ole tõendatud või et kriminaalasjas esinevad käesoleva koodeksi §-s 5 ettenähtud kriminaalmenetluse alustamist kõrvaldavad alused, teeb ta kriminaalasja lõpetamise määruse.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_286 (redaktsioon 184247)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184247",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_286_v194734"
      },
      "estleg:versionValidTo": {
        "@value": "2002-08-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_286_v194734",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_286"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tunnistanud tõendatuks antud isiku poolt karistusseadustikus sätestatud õigusvastase teo toimepanemise süüdimatus seisundis või pärast õigusvastase teo toimepanemist tema vaimuhaigeks või nõdrameelseks jäämise või tal muu raske psüühikahäire tekkimise, mille tagajärjel isik on oma teo ja vaimse seisundi tõttu ohtlik endale ja ühiskonnale ning vajab ravi, teeb kohus kriminaalasja lõpetamise määruse ja kohaldab antud isiku suhtes karistusseadustiku §-s 86 ettenähtud psühhiaatrilist sundravi või jätab selle kohaldamata, kui selleks puudub vajadus. (2) Tunnistanud, et antud isiku poolt karistusseadustikus sätestatud õigusvastase teo toimepanemine süüdimatus seisundis ei ole tõendatud või et isik ei ole pärast õigusvastase teo toimepanemist jäänud vaimuhaigeks või nõdrameelseks või tal ei ole tekkinud muud rasket psüühikahäiret, mille tagajärjel ta oma teo ja vaimse seisundi tõttu on ohtlik endale ja ühiskonnale ning vajab ravi, tagastab kohus kriminaalasja oma määrusega täiendavaks uurimiseks ja edasiseks menetlemiseks üldises korras. (3) Kui kohus tunnistab, et antud isiku süü ühiskonnaohtliku teo toimepanemises ei ole tõendatud või et kriminaalasjas esinevad käesoleva koodeksi §-s 5 ettenähtud kriminaalmenetluse alustamist kõrvaldavad alused, teeb ta kriminaalasja lõpetamise määruse.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_286 (redaktsioon 194734)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "194734",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_286_v740766"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KRIMIN_Par_286_v740766",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_286"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tunnistanud tõendatuks antud isiku poolt karistusseadustikus sätestatud õigusvastase teo toimepanemise süüdimatus seisundis või pärast õigusvastase teo toimepanemist tema vaimuhaigeks või nõdrameelseks jäämise või tal muu raske psüühikahäire tekkimise, mille tagajärjel isik on oma teo ja vaimse seisundi tõttu ohtlik endale ja ühiskonnale ning vajab ravi, teeb kohus kriminaalasja lõpetamise määruse ja kohaldab antud isiku suhtes karistusseadustiku §-s 86 ettenähtud psühhiaatrilist sundravi või jätab selle kohaldamata, kui selleks puudub vajadus. (2) Tunnistanud, etantudisiku poolt karistusseadustikus sätestatud õigusvastase teo toimepanemine süüdimatus seisundis ei ole tõendatud või et isik ei ole pärast õigusvastase teo toimepanemist jäänud vaimuhaigeks või nõdrameelseks või tal ei ole tekkinud muud rasket psüühikahäiret, mille tagajärjel ta oma teo ja vaimse seisundi tõttu on ohtlik endale ja ühiskonnale ning vajab ravi, tagastab kohus kriminaalasja oma määrusega täiendavaks uurimiseks ja edasiseks menetlemiseks üldises korras. (3) Kui kohus tunnistab, et antud isiku süü ühiskonnaohtliku teo toimepanemises ei ole tõendatud või et kriminaalasjas esinevad käesoleva koodeksi §-s 5 ettenähtud kriminaalmenetluse alustamist kõrvaldavad alused, teeb ta kriminaalasja lõpetamise määruse.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_286 (redaktsioon 740766)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "740766"
    },
    {
      "@id": "estleg:KRIMIN_Par_287_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_287"
      },
      "estleg:versionValidFrom": {
