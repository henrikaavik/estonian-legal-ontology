      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtueelse uurimise asutusteks oma pädevuse piires on: Politseiamet, Keskkriminaalpolitsei ja politseiprefektuurid; Kaitsepolitseiamet; vanglad ja väljasaatmislaager; piirivalveasutused; tolliasutused; Kaitsejõudude Peastaap; Maksuamet.",
      "rdfs:label": {
