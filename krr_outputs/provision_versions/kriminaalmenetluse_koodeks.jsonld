        "@type": "xsd:date"
      },
      "estleg:versionText": "[kehtetu]",
      "rdfs:label": {
        "@value": "KRIMIN_Par_287 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201",
      "estleg:supersededByVersion": {
