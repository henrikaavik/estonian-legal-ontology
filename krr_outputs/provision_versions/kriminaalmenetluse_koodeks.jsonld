    },
    {
      "@id": "estleg:KRIMIN_Par_97_v22201",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_97"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kriminaalmenetluse alustamisel: alustab uurija viivitamata eeluurimist; saadab kohtunik viivitamata avalduse või teate eeluurimiseks või alustab menetlust erasüüdistusasjas.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_97 (redaktsioon 22201)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22201"
    },
