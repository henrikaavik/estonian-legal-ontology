    {
      "@id": "estleg:KRIMIN_Par_104_v207008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KRIMIN_Par_104"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-10-24",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohtueelse uurimise asutusteks oma pädevuse piires on: Politseiamet, Keskkriminaalpolitsei ja politseiprefektuurid; Kaitsepolitseiamet; vanglad ja väljasaatmislaager; piirivalveasutused; tolliasutused; Kaitsejõudude Peastaap; Maksuamet; Konkurentsiamet.",
      "rdfs:label": {
        "@value": "KRIMIN_Par_104 (redaktsioon 207008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "207008",
      "estleg:supersededByVersion": {
        "@id": "estleg:KRIMIN_Par_104_v693412"
      },
