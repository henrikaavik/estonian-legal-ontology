    },
    {
      "@id": "estleg:Reg_1053339_Par_1_v1053339",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053339_Par_1"
