    {
      "@id": "estleg:Reg_1041146_Par_1_v1041146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041146_Par_1"
