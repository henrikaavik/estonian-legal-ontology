    {
      "@id": "estleg:Reg_1041146_Par_11_v1041146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041146_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: 1 1) majandustegevus; 2 2) loodusvarade kasutamine; 3 3) uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatiste püstitamine kaitseala tarbeks ja olemasolevate rajatiste hooldustööd; 4 4) inimeste viibimine Laidude sihtkaitsevööndis 1. aprillist 15. juulini, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel. Sihtkaitsevööndis on keelatud, arvestades käesoleva määrusega sätestatud erisusi: majandustegevus; loodusvarade kasutamine; uute ehitiste püstitamine, välja arvatud kaitseala valitseja nõusolekul rajatiste püstitamine kaitseala tarbeks ja olemasolevate rajatiste hooldustööd; inimeste viibimine Laidude sihtkaitsevööndis 1. aprillist 15. juulini, välja arvatud järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel ning kaitseala valitseja nõusolekul teostataval teadustegevusel.",
      "rdfs:label": {
        "@value": "Reg_1041146_Par_11 (redaktsioon 1041146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041146",
      "estleg:sourceAct": "Letipea maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041146 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041146_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041146_Par_12_v1041146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
