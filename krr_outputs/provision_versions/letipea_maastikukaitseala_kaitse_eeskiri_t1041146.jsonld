    {
      "@id": "estleg:Reg_1041146_Par_3_v1041146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1041146_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1041146_Par_3 (redaktsioon 1041146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041146",
      "estleg:sourceAct": "Letipea maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041146 § 3",
