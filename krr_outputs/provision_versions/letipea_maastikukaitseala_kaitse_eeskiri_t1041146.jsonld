      "estleg:versionValidFrom": {
        "@value": "2017-12-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu säilimise tagamiseks vajalik heina ja roo niitmine ja/või loomade karjatamine ning puu- ja põõsarinde kujundamine. Poollooduslike koosluste esinemisaladel on nende ilme ja liigikoosseisu säilimise tagamiseks vajalik heina ja roo niitmine ja/või loomade karjatamine ning puu- ja põõsarinde kujundamine.",
      "rdfs:label": {
        "@value": "Reg_1041146_Par_15 (redaktsioon 1041146)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041146",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1041146",
      "estleg:sourceAct": "Letipea maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1041146 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041146_Map"
      }
    },
    {
      "@id": "estleg:Reg_1041146_Par_16_v1041146",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
