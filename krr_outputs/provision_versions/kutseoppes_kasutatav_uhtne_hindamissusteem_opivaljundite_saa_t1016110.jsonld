      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kutseõppes kasutatav ühtne hindamissüsteem, õpiväljundite saavutatuse hindamise alused, hindamismeetodid ja -kriteeriumid ning hinnete kirjeldused (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kutseõppes kasutatav ühtne hindamissüsteem, õpiväljundite saavutatuse hindamise alused, hindamismeetodid ja -kriteeriumid ning hinnete kirjeldused"
    },
    {
      "@id": "estleg:Reg_1016110_Par_1_v1016110",
