    {
      "@id": "estleg:Reg_155186_Par_23_v155186",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155186_Par_23"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Haigla ja muu avaliku otstarbega hoone ning eriarsti vastuvõtuüksuse üldkasutatavad ruumid võivad olla ühised, kui see ei ole vastuolus hügieeninõuetega ja patsientidele on tagatud nende ruumide kasutamise võimalus. Haigla ja muu avaliku otstarbega hoone ning eriarsti vastuvõtuüksuse üldkasutatavad ruumid võivad olla ühised, kui see ei ole vastuolus hügieeninõuetega ja patsientidele on tagatud nende ruumide kasutamise võimalus. 2 (2) Pulmonoloogi vastuvõtuüksuse ooteruumi teiste eriarstide vastuvõtuüksuste ooteruumiga ei ühitata. <p align=\"center\"><b>5. jagu</b><br/><b>Personali- ja abiruumid</b></p> Pulmonoloogi vastuvõtuüksuse ooteruumi teiste eriarstide vastuvõtuüksuste ooteruumiga ei ühitata.",
      "rdfs:label": {
        "@value": "Reg_155186_Par_23 (redaktsioon 155186)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155186",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155186",
      "estleg:sourceAct": "Nõuded haiglavälise eriarstiabi osutamiseks vajalikele ruumidele, sisseseadele ja aparatuurile",
      "estleg:provisionRef": "Reg_155186 § 23",
