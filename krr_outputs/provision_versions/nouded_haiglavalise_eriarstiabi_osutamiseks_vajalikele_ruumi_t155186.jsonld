        "@value": "2016-05-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ambulatoorse silmakirurgia ruumid peavad vastama päevakirurgia operatsiooniruumide nõuetele. Töökorraldus, sisseseade ja varustus määratletakse ehitusprojekti meditsiinitehnoloogia osas. <p align=\"center\"><b>3. jagu</b><br/><b>Endoskoopiaüksus</b></p> Ambulatoorse silmakirurgia ruumid peavad vastama päevakirurgia operatsiooniruumide nõuetele. Töökorraldus, sisseseade ja varustus määratletakse ehitusprojekti meditsiinitehnoloogia osas.",
      "rdfs:label": {
        "@value": "Reg_155186_Par_38 (redaktsioon 155186)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155186",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155186",
      "estleg:sourceAct": "Nõuded haiglavälise eriarstiabi osutamiseks vajalikele ruumidele, sisseseadele ja aparatuurile",
      "estleg:provisionRef": "Reg_155186 § 38",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_155186_Map"
      }
    },
    {
      "@id": "estleg:Reg_155186_Par_39_v155186",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
