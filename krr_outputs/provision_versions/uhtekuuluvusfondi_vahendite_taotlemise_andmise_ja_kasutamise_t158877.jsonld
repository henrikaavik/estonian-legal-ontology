    },
    {
      "@id": "estleg:Reg_158877_Par_10_v158877",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158877_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-10-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Rakendusüksusele, rakendusasutusele ja korraldusasutusele esitatud dokumente taotlejale ja toetuse saajale ei tagastata. Nimetatud üksused ja asutused ning makseasutus tagavad dokumentide säilitamise vähemalt 31. detsembrini 2015. a. Rakendusüksusele, rakendusasutusele ja korraldusasutusele esitatud dokumente taotlejale ja toetuse saajale ei tagastata. Nimetatud üksused ja asutused ning makseasutus tagavad dokumentide säilitamise vähemalt 31. detsembrini 2015. a. 2 (2) Toetuse saaja on kohustatud dokumenteerima kõik projekti elluviimise ja toetuse kasutamisega seotud toimingud ning tagama dokumentide säilitamise vähemalt 31. detsembrini 2015. a. Toetuse saaja on kohustatud dokumenteerima kõik projekti elluviimise ja toetuse kasutamisega seotud toimingud ning tagama dokumentide säilitamise vähemalt 31. detsembrini 2015. a.",
      "rdfs:label": {
        "@value": "Reg_158877_Par_10 (redaktsioon 158877)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158877",
