        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muuseum asub Palamuse alevikus. Muuseum asub Palamuse alevikus. 2 (2) Muuseumi postiaadress on Köstri allee 3, Palamuse, Palamuse vald, 49226 Jõgeva maakond. Muuseumi postiaadress on Köstri allee 3, Palamuse, Palamuse vald, 49226 Jõgeva maakond.",
      "rdfs:label": {
        "@value": "Reg_1015312_Par_2 (redaktsioon 1015312)",
        "@language": "et"
      },
