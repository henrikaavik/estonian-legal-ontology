      }
    },
    {
      "@id": "estleg:Reg_1015312_Par_4_v1015312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015312_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muuseum täiendab muuseumikogu eesmärgipäraselt, lähtudes muuseumi koostatud kogumispõhimõtetest ning muuseumikogu täiendamise ja asja muuseumisse hoiule võtmise komisjoni otsustest. Muuseum täiendab muuseumikogu eesmärgipäraselt, lähtudes muuseumi koostatud kogumispõhimõtetest ning muuseumikogu täiendamise ja asja muuseumisse hoiule võtmise komisjoni otsustest. 2 (2) Kultuuriväärtusega asja museaalina arvele ja muuseumisse hoiule võtmine, märgistamine, säilitamine, muuseumikogust väljaarvamine ja üleandmine toimub muuseumiseaduses ja selle alusel kehtestatud õigusaktides sätestatud korras. Kultuuriväärtusega asja museaalina arvele ja muuseumisse hoiule võtmine, märgistamine, säilitamine, muuseumikogust väljaarvamine ja üleandmine toimub muuseumiseaduses ja selle alusel kehtestatud õigusaktides sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1015312_Par_4 (redaktsioon 1015312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015312",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015312",
      "estleg:sourceAct": "Palamuse O. Lutsu Kihelkonnakoolimuuseumi põhimäärus",
      "estleg:provisionRef": "Reg_1015312 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015312_Map"
      }
    },
    {
      "@id": "estleg:Reg_1015312_Par_5_v1015312",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1015312_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muuseumi juhib direktor, kellega sõlmib tähtajalise töölepingu kuni viieks aastaks kultuuriminister. Muuseumi juhib direktor, kellega sõlmib tähtajalise töölepingu kuni viieks aastaks kultuuriminister. 2 (2) Muuseumi direktori ametikoha täitmiseks korraldatakse avalik konkurss. Muuseumi direktori ametikoha täitmiseks korraldatakse avalik konkurss. 3 (3) Direktorit asendab tema äraolekul direktori määratud töötaja. Direktorit asendab tema äraolekul direktori määratud töötaja. 4 (4) Muuseumi tegevuse põhisuundade kavandamiseks, muuseumi töö paremaks korraldamiseks, tema tegevuse hindamiseks ja kultuuriministrile vastavate ettepanekute esitamiseks on muuseumil kuni üheksaliikmeline nõuandva õigusega nõukoda. Muuseumi tegevuse põhisuundade kavandamiseks, muuseumi töö paremaks korraldamiseks, tema tegevuse hindamiseks ja kultuuriministrile vastavate ettepanekute esitamiseks on muuseumil kuni üheksaliikmeline nõuandva õigusega nõukoda. 5 (5) Muuseumi nõukotta kuuluvad Kultuuriministeeriumi, Muinsuskaitseameti, kohaliku omavalitsusüksuse ning kultuuri- ja majandusvaldkonna esindajad. Muuseumi nõukotta kuuluvad Kultuuriministeeriumi, Muinsuskaitseameti, kohaliku omavalitsusüksuse ning kultuuri- ja majandusvaldkonna esindajad. 6 (6) Muuseumi nõukoja koosseisu kinnitab kultuuriminister direktori ettepanekul. Muuseumi nõukoja koosseisu kinnitab kultuuriminister direktori ettepanekul.",
      "rdfs:label": {
        "@value": "Reg_1015312_Par_5 (redaktsioon 1015312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015312",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015312",
      "estleg:sourceAct": "Palamuse O. Lutsu Kihelkonnakoolimuuseumi põhimäärus",
      "estleg:provisionRef": "Reg_1015312 § 5",
