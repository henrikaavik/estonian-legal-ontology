        "@id": "estleg:Reg_1015312_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2013-07-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Muuseumi valduses oleva vara valdamine, kasutamine ja käsutamine toimub riigivaraseaduses sätestatud korras, arvestades muuseumiseaduse erisusi. Muuseumi valduses oleva vara valdamine, kasutamine ja käsutamine toimub riigivaraseaduses sätestatud korras, arvestades muuseumiseaduse erisusi. 2 (2) Muuseumi tegevust rahastatakse riigieelarvest ning muuseum võib saada rahalisi vahendeid toetustest, annetustest ja oma põhitegevusega seotud tasulistest teenustest, mida võib osutada tingimusel, et see ei takista muuseumi ülesannete täitmist. Muuseumi tegevust rahastatakse riigieelarvest ning muuseum võib saada rahalisi vahendeid toetustest, annetustest ja oma põhitegevusega seotud tasulistest teenustest, mida võib osutada tingimusel, et see ei takista muuseumi ülesannete täitmist. 3 (3) Muuseumi eelarve kinnitamine ja raha kasutamine toimub õigusaktidega kehtestatud korras. Muuseumi eelarve kinnitamine ja raha kasutamine toimub õigusaktidega kehtestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1015312_Par_8 (redaktsioon 1015312)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1015312",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1015312",
