    {
      "@id": "estleg:Reg_1045023_Par_7_v1045023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045023_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 21. septembri 2015. a käskkirjaga nr 825 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 21. septembri 2015. a käskkirjaga nr 825 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1045023_Par_7 (redaktsioon 1045023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045023",
      "estleg:sourceAct": "Saare maakonna kaitstavate looduse üksikobjektide piiranguvööndi ulatus",
      "estleg:provisionRef": "Reg_1045023 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045023_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1045023_Par_8_v1045023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045023_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-03-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse haldusmenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1045023_Par_8 (redaktsioon 1045023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1045023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1045023",
      "estleg:sourceAct": "Saare maakonna kaitstavate looduse üksikobjektide piiranguvööndi ulatus",
      "estleg:provisionRef": "Reg_1045023 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045023_Map_2026"
      }
