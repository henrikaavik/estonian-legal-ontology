    {
      "@id": "estleg:Reg_1045023_Par_2_v1045023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1045023_Par_2"
