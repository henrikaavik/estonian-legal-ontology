      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "TULEOH_Par_41 (redaktsioon 129062014086)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014086"
    },
    {
      "@id": "estleg:TULEOH_Par_42_v13314859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enesekontrolli teostamata jätmise eest –karistatakse rahatrahviga kuni 200 trahviühikut. (2) Sama teo eest, kui selle on toime pannud juriidiline isik, –karistatakse rahatrahviga kuni 30 000 krooni.",
      "rdfs:label": {
        "@value": "TULEOH_Par_42 (redaktsioon 13314859)",
