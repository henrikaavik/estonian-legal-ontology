      }
    },
    {
      "@id": "estleg:TULEOH_Par_29_v123032015137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "võib määrusega kehtestada kaitsejõudude tuleohutusnõuded.",
      "rdfs:label": {
        "@value": "TULEOH_Par_29 (redaktsioon 123032015137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015137",
      "estleg:supersededByVersion": {
