        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ettekirjutuse täitmata jätmise korral on asendustäitmise ja sunniraha seaduses sätestatud korras rakendatava sunniraha ülemmäär 3200 eurot.",
      "rdfs:label": {
        "@value": "TULEOH_Par_40 (redaktsioon 129062014086)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014086"
    },
    {
      "@id": "estleg:TULEOH_Par_41_v13314859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Päästeamet võib kaasata eksperte tuleohutuse hindamiseks, kui ehitise, seadme, tegevuse või ehitusmaterjali kohta ei ole Eestis asjaomaseid norme. Ekspertide kaasamisega seotud kulud tasub seadet omav või ehitist ehitada või kasutada sooviv isik.",
      "rdfs:label": {
        "@value": "TULEOH_Par_41 (redaktsioon 13314859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314859",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULEOH_Par_41_v129062014086"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
