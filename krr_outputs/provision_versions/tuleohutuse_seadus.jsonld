    {
      "@id": "estleg:TULEOH_Par_56_1_v112122018071",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_56_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kohtuväline menetleja kohaldab väärteomenetluse alustamisel lühimenetlust käesoleva seaduse: § 44 lõikes 1 sätestatud väärteokoosseisu korral, kui rikuti käesoleva seaduse § 5 lõikes 3 või 4, § 6 lõikes 1, § 8 lõikes 4 või 6, § 10 lõikes 3 või § 15 lõikes 1, 2 või 4 sätestatud nõudeid; § 50 lõikes 1 sätestatud väärteokoosseisu korral. (2) Käesoleva seaduse § 44 lõikes 1 ja § 50 lõikes 1 sätestatud väärteo korral määratakse mõjutustrahv suurusega 40 eurot.",
      "rdfs:label": {
        "@value": "TULEOH_Par_56_1 (redaktsioon 112122018071)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "112122018071",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULEOH_Par_56_1_v129062024007"
      },
      "estleg:versionValidTo": {
        "@value": "2024-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULEOH_Par_56_1_v129062024007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
