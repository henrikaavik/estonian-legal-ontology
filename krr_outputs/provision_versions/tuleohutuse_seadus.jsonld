        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "TULEOH_Par_60 (redaktsioon 130122010013)",
        "@language": "et"
      },
