        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULEOH_Par_26_v130122020005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-03-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "TULEOH_Par_26 (redaktsioon 130122020005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122020005"
    },
    {
      "@id": "estleg:TULEOH_Par_27_v13314859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Seadme ja paigaldise paigaldamisel, kasutamisel, hooldamisel ja kontrollimisel tuleb vältida tuleohtu ning juhinduda tootja kasutusjuhendist ja õigusaktidest. (2) Keelatud on kasutada tuleohtu põhjustada võiva rikkega seadet ja paigaldist.",
      "rdfs:label": {
        "@value": "TULEOH_Par_27 (redaktsioon 13314859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314859"
    },
    {
      "@id": "estleg:TULEOH_Par_28_v13314859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) tuleohutusnõuded raudteetranspordile ja tsiviillennundusele ning veesõidukile. (2) tuleohutusnõuded allmaarajatisele.",
      "rdfs:label": {
        "@value": "TULEOH_Par_28 (redaktsioon 13314859)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13314859",
      "estleg:supersededByVersion": {
        "@id": "estleg:TULEOH_Par_28_v123032015137"
      },
      "estleg:versionValidTo": {
        "@value": "2015-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:TULEOH_Par_28_v123032015137",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) võib määrusega kehtestada tuleohutusnõuded raudteetranspordile ja tsiviillennundusele ning veesõidukile. (2) võib määrusega kehtestada tuleohutusnõuded allmaarajatisele.",
      "rdfs:label": {
        "@value": "TULEOH_Par_28 (redaktsioon 123032015137)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015137"
    },
    {
      "@id": "estleg:TULEOH_Par_29_v13314859",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:TULEOH_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-09-01",
