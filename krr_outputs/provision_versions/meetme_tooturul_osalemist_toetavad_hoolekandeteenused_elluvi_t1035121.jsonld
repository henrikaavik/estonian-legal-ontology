    {
      "@id": "estleg:Reg_1035121_Par_8_8_v1035121",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035121_Par_8_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusvahelise kaitse saanud isikute toimetuleku toetamisega seotud ühikuhinnad on järgmised: 1 1) tegevuste koordineerimisel tunnitasu 16,5 eurot ja kuutasu täistööajaga töötamise korral 2638,4 eurot; 2 2) tugiisikuteenuse osutamisel tunnitasu 10,3 eurot ja kuutasu täistööajaga töötamise korral 1730,4 eurot. RT I 2022-07-08 11 108072022011 2022-07-11 Rahvusvahelise kaitse saanud isikute toimetuleku toetamisega seotud ühikuhinnad on järgmised: tegevuste koordineerimisel tunnitasu 16,5 eurot ja kuutasu täistööajaga töötamise korral 2638,4 eurot; tugiisikuteenuse osutamisel tunnitasu 10,3 eurot ja kuutasu täistööajaga töötamise korral 1730,4 eurot.",
      "rdfs:label": {
        "@value": "Reg_1035121_Par_8_8 (redaktsioon 1035121)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035121",
