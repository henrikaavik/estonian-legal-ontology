    {
      "@id": "estleg:Reg_1035121_Par_27_v1035121",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035121_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Finantskorrektsiooni otsus tehakse ja toetus nõutakse tagasi vastavalt struktuuritoetuse seaduse §-des 45–47 ja ühendmääruse §-des 21–23 sätestatule. Finantskorrektsiooni otsus tehakse ja toetus nõutakse tagasi vastavalt struktuuritoetuse seaduse §-des 45–47 ja ühendmääruse §-des 21–23 sätestatule. 2 (2) Toetus makstakse tagasi vastavalt struktuuritoetuse seaduse §-s 48 sätestatule. Toetuse tagasimaksmist võib ajatada ühendmääruse §-s 24 sätestatud tingimustel. Toetus makstakse tagasi vastavalt struktuuritoetuse seaduse §-s 48 sätestatule. Toetuse tagasimaksmist võib ajatada ühendmääruse §-s 24 sätestatud tingimustel. 3 (3) Kui toetust tagasimaksmise tähtpäevaks tagasi ei maksta, peab toetuse saaja maksma viivist vastavalt struktuuritoetuse seaduse §-s 49 sätestatule. Kui toetust tagasimaksmise tähtpäevaks tagasi ei maksta, peab toetuse saaja maksma viivist vastavalt struktuuritoetuse seaduse §-s 49 sätestatule.",
      "rdfs:label": {
        "@value": "Reg_1035121_Par_27 (redaktsioon 1035121)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035121",
