    {
      "@id": "estleg:Reg_1035121_Par_20_v1035121",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035121_Par_20"
