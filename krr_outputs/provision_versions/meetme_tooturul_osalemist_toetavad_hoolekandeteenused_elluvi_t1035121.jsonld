      },
      "estleg:versionValidFrom": {
        "@value": "2022-07-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rakendusüksuse otsuse või toimingu vaide menetleja on rakendusüksus. Rakendusüksuse otsuse või toimingu vaide menetleja on rakendusüksus.",
      "rdfs:label": {
        "@value": "Reg_1035121_Par_4 (redaktsioon 1035121)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035121",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035121",
      "estleg:sourceAct": "Meetme „Tööturul osalemist toetavad hoolekandeteenused” elluviimiseks struktuuritoetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1035121 § 4",
