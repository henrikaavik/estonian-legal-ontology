      }
    },
    {
      "@id": "estleg:Reg_336142_Par_4_v336142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336142_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Konsulaarametnik registreerib taotluses esitatud andmed konsulaarametniku ametitoimingute andmekogus välisministri 7. augusti 2017. a määruse nr 6 „Konsulaarametniku ametitoimingute andmekogu pidamise kord” §-de 6 ja 15 kohaselt. 2017-12-19 RT I 2018-01-04 4 104012018004 2018-01-07 9 Konsulaarametnik registreerib taotluses esitatud andmed konsulaarametniku ametitoimingute andmekogus välisministri 7. augusti 2017. a määruse nr 6 „Konsulaarametniku ametitoimingute andmekogu pidamise kord” §-de 6 ja 15 kohaselt.",
      "rdfs:label": {
        "@value": "Reg_336142_Par_4 (redaktsioon 336142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336142",
