  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_valisriigis_ajutiselt_viibiva_voi_pusivalt_elava_eesti_kodan_t336142_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välisriigis ajutiselt viibiva või püsivalt elava Eesti kodaniku või välismaalase andmete registreerimise kord ja registreerimistaotluse vormid (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välisriigis ajutiselt viibiva või püsivalt elava Eesti kodaniku või välismaalase andmete registreerimise kord ja registreerimistaotluse vormid"
    },
    {
      "@id": "estleg:Reg_336142_Par_1_v336142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336142_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Konsulaarametnik või aukonsul registreerib välisesinduses või aukonsuli juhitavas konsulaarasutuses välisriigis ajutiselt viibiva või seal püsivalt elava Eesti kodaniku või «Konsulaarseaduse» § 1 lõikes 2 nimetatud välismaalase (edaspidi välismaalane) andmed tema taotluse alusel. Konsulaarametnik või aukonsul registreerib välisesinduses või aukonsuli juhitavas konsulaarasutuses välisriigis ajutiselt viibiva või seal püsivalt elava Eesti kodaniku või «Konsulaarseaduse» § 1 lõikes 2 nimetatud välismaalase (edaspidi välismaalane) andmed tema taotluse alusel. 2 (2) Eesti kodanik või välismaalane, kes elab püsivalt Eestis, kuid viibib ajutiselt välisriigis, või Eesti kodanik, kes elab püsivalt välisriigis, kus puudub Eesti välisesindus või aukonsuli juhitav konsulaarasutus, võib esitada taotluse välisriigis ajutise viibimise või seal püsivalt elamise registreerimiseks Välisministeeriumi konsulaarosakonnale (edaspidi konsulaarosakond). Eesti kodanik või välismaalane, kes elab püsivalt Eestis, kuid viibib ajutiselt välisriigis, või Eesti kodanik, kes elab püsivalt välisriigis, kus puudub Eesti välisesindus või aukonsuli juhitav konsulaarasutus, võib esitada taotluse välisriigis ajutise viibimise või seal püsivalt elamise registreerimiseks Välisministeeriumi konsulaarosakonnale (edaspidi konsulaarosakond).",
      "rdfs:label": {
        "@value": "Reg_336142_Par_1 (redaktsioon 336142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336142",
      "estleg:sourceAct": "Välisriigis ajutiselt viibiva või püsivalt elava Eesti kodaniku või välismaalase andmete registreerimise kord ja registreerimistaotluse vormid",
      "estleg:provisionRef": "Reg_336142 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336142_Map"
      }
    },
    {
      "@id": "estleg:Reg_336142_Par_2_v336142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336142_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ajutiselt välisriigis viibiv Eesti kodanik või välismaalane (edaspidi taotleja) esitab välisesinduse või konsulaarosakonna konsulaarametnikule või aukonsulile ajutiselt välisriigis viibimise registreerimise taotluse (lisa 1). Ajutiselt välisriigis viibiv Eesti kodanik või välismaalane (edaspidi taotleja) esitab välisesinduse või konsulaarosakonna konsulaarametnikule või aukonsulile ajutiselt välisriigis viibimise registreerimise taotluse (lisa 1). 2 (2) Püsivalt välisriigis elav taotleja esitab konsulaarametnikule või aukonsulile välisriigi püsiva elukoha andmete registreerimise taotluse (lisa 2). Püsivalt välisriigis elav taotleja esitab konsulaarametnikule või aukonsulile välisriigi püsiva elukoha andmete registreerimise taotluse (lisa 2). 3 (3) Taotleja esitab isiklikult allkirjastatud ajutiselt välisriigis viibimise registreerimise taotluse või välisriigi püsiva elukoha andmete registreerimise taotluse (edaspidi koos taotlus) kas isiklikult või posti, faksi või elektronposti teel. Ajutiselt välisriigis registreerimise taotluse saab taotleja esitada ka Välisministeeriumi veebilehe või mobiilirakenduse kaudu. Elektronposti teel esitatud välisriigi püsiva elukoha andmete registreerimise taotluse allkirjastab taotleja omakäeliselt või digitaalselt. RT I 2019-01-22 4 122012019004 2019-01-25 Taotleja esitab isiklikult allkirjastatud ajutiselt välisriigis viibimise registreerimise taotluse või välisriigi püsiva elukoha andmete registreerimise taotluse (edaspidi koos taotlus) kas isiklikult või posti, faksi või elektronposti teel. Ajutiselt välisriigis registreerimise taotluse saab taotleja esitada ka Välisministeeriumi veebilehe või mobiilirakenduse kaudu. Elektronposti teel esitatud välisriigi püsiva elukoha andmete registreerimise taotluse allkirjastab taotleja omakäeliselt või digitaalselt. 4 (4) Kui välisriigi püsiva elukoha andmete registreerimise taotlus esitatakse elektronposti, posti või faksi teel, tuleb taotlusele lisada taotleja isikut tõendava dokumendi isikuandmetega lehekülje koopia. RT I 2019-01-22 4 122012019004 2019-01-25 Kui välisriigi püsiva elukoha andmete registreerimise taotlus esitatakse elektronposti, posti või faksi teel, tuleb taotlusele lisada taotleja isikut tõendava dokumendi isikuandmetega lehekülje koopia. 5 (5) Taotleja esitab ajutiselt välisriigis viibimise registreerimise taotluses järgmised andmed: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) isikut tõendava dokumendi liik ja number; 4 4) kontaktandmed välisriigis (täpne aadress, telefoni- või faksinumber, elektronposti aadress); 5 5) välisriigis viibimise ajavahemik (välisriiki saabumise ja sealt lahkumise kuupäev); 6 6) sugulase või kontaktisiku andmed (ees- ja perekonnanimi, suhe taotlejaga, telefoninumber, elektronposti aadress); 7 7) kaasareisivate perekonnaliikmete andmed (ees- ja perekonnanimi, isikut tõendava dokumendi liik ja number, isikood või sünniaeg); 8 8) taotluse esitamise kuupäev. Taotleja esitab ajutiselt välisriigis viibimise registreerimise taotluses järgmised andmed: ees- ja perekonnanimi; isikukood; isikut tõendava dokumendi liik ja number; kontaktandmed välisriigis (täpne aadress, telefoni- või faksinumber, elektronposti aadress); välisriigis viibimise ajavahemik (välisriiki saabumise ja sealt lahkumise kuupäev); sugulase või kontaktisiku andmed (ees- ja perekonnanimi, suhe taotlejaga, telefoninumber, elektronposti aadress); kaasareisivate perekonnaliikmete andmed (ees- ja perekonnanimi, isikut tõendava dokumendi liik ja number, isikood või sünniaeg); taotluse esitamise kuupäev. 6 (6) Taotleja esitab välisriigi püsiva elukoha andmete registreerimise taotluses järgmised andmed: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) isikut tõendava dokumendi liik ja number; 4 4) elukoht ja kontaktandmed välisriigis (täpne aadress, telefoni/faksi number, elektronposti aadress); 5 5) taotlejaga koos elavate pereliikmete andmed (ees- ja perekonnanimi, isikukood, isikut tõendava dokumendi liik ja number, suhe taotlejaga);51) alaealise lapse elukohaandmete esitamise korral teise hooldusõigusliku lapsevanema nõusolek (teise vanema ees- ja perekonnanimi, isikukood, allkiri) või kontaktandmed; RT I 2019-01-22 4 122012019004 2019-01-25 6 6) sugulase või kontaktisiku andmed (ees-ja perekonnanimi, suhe taotlejaga, telefoni number, elektronposti aadress); 7 7) enda, oma vanemate või vanavanemate või vanavanavanemate viimane püsiv elukoht Eestis; 8 8) taotluse esitamise kuupäev. Taotleja esitab välisriigi püsiva elukoha andmete registreerimise taotluses järgmised andmed: ees- ja perekonnanimi; isikukood; isikut tõendava dokumendi liik ja number; elukoht ja kontaktandmed välisriigis (täpne aadress, telefoni/faksi number, elektronposti aadress); taotlejaga koos elavate pereliikmete andmed (ees- ja perekonnanimi, isikukood, isikut tõendava dokumendi liik ja number, suhe taotlejaga);51) alaealise lapse elukohaandmete esitamise korral teise hooldusõigusliku lapsevanema nõusolek (teise vanema ees- ja perekonnanimi, isikukood, allkiri) või kontaktandmed; sugulase või kontaktisiku andmed (ees-ja perekonnanimi, suhe taotlejaga, telefoni number, elektronposti aadress); enda, oma vanemate või vanavanemate või vanavanavanemate viimane püsiv elukoht Eestis; taotluse esitamise kuupäev. 7 (7) Välisriigis püsivalt elav Eesti kodanik esitab käesoleva paragrahvi lõike 6 punktis 7 nimetatud andmed kehtiva haldusterritoriaalse korralduse alusel valla või linna ja Tallinnas linnaosa täpsusega. Andmed on vajalikud valimisringkonna kindlaksmääramisel. Välisriigis püsivalt elav Eesti kodanik esitab käesoleva paragrahvi lõike 6 punktis 7 nimetatud andmed kehtiva haldusterritoriaalse korralduse alusel valla või linna ja Tallinnas linnaosa täpsusega. Andmed on vajalikud valimisringkonna kindlaksmääramisel.",
      "rdfs:label": {
        "@value": "Reg_336142_Par_2 (redaktsioon 336142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "336142",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/336142",
      "estleg:sourceAct": "Välisriigis ajutiselt viibiva või püsivalt elava Eesti kodaniku või välismaalase andmete registreerimise kord ja registreerimistaotluse vormid",
      "estleg:provisionRef": "Reg_336142 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336142_Map"
      }
    },
    {
      "@id": "estleg:Reg_336142_Par_3_v336142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336142_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-01-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlus võetakse menetlusse selle esitamise päeval. Posti, faksi või elektronposti teel esitatud taotlus võetakse menetlusse hiljemalt järgmisel tööpäeval pärast selle saabumist. Taotlus võetakse menetlusse selle esitamise päeval. Posti, faksi või elektronposti teel esitatud taotlus võetakse menetlusse hiljemalt järgmisel tööpäeval pärast selle saabumist. 2 (2) Aukonsulile esitatud taotlus edastatakse esimesel võimalusel konsulaarosakonna või välisesinduse konsulaarametnikule registreerimiseks. Aukonsulile esitatud taotlus edastatakse esimesel võimalusel konsulaarosakonna või välisesinduse konsulaarametnikule registreerimiseks. 3 (3) Alaealise kohta esitatud taotluse korral teeb konsulaarametnik elukohaandmete muutmise otsuse kümne tööpäeva jooksul taotluse menetlusse võtmisest arvates. RT I 2019-01-22 4 122012019004 2019-01-25 Alaealise kohta esitatud taotluse korral teeb konsulaarametnik elukohaandmete muutmise otsuse kümne tööpäeva jooksul taotluse menetlusse võtmisest arvates. 4 (4) Teise hooldusõigusliku vanema nõusoleku puudumisel võtab konsulaarametnik temaga ühendust ja kontrollib nõusoleku olemasolu. Nõusoleku tähtpäevaks mittesaabumisel või nõusolekust keeldumisel teeb konsulaarametnik elukohaandmete muutmise või muutmata jätmise otsuse kõiki asjaolusid kaaludes. RT I 2019-01-22 4 122012019004 2019-01-25 Teise hooldusõigusliku vanema nõusoleku puudumisel võtab konsulaarametnik temaga ühendust ja kontrollib nõusoleku olemasolu. Nõusoleku tähtpäevaks mittesaabumisel või nõusolekust keeldumisel teeb konsulaarametnik elukohaandmete muutmise või muutmata jätmise otsuse kõiki asjaolusid kaaludes.",
      "rdfs:label": {
        "@value": "Reg_336142_Par_3 (redaktsioon 336142)",
        "@language": "et"
      },
