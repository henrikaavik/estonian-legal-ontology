      }
    },
    {
      "@id": "estleg:SRKS_Par_9_v113032014079",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Vabariigi Valitsus: täidab rahuaja riigikaitse seadusega temale pandud ülesandeid, välja arvatud need ülesanded, mis käesoleva seadusega on antud Riigikogu, Vabariigi Presidendi ja Kaitseväe juhataja pädevusse; kehtetu - kehtetu - kehtetu - kehtetu - annab Kaitseväe juhataja alluvusse üksusi ja asutusi; kehtestab piirangud või keelab riigikaitseks ja elanike tarbeks vajalike kaupade ning muu vara, samuti valuuta väljaveo Eestist; normeerib vajadusel toidu ja muude kaupade tarbimist; määrab vajadusel sundhindu; piirab vajadusel isikute õigusi ja vabadusi ning paneb neile kohustusi vastavalt käesoleva seaduse §-le 5; paneb riigiasutustele, kohaliku omavalitsuse täitevorganitele ning muudele asutustele ja organisatsioonidele täiendavaid riigikaitselisi kohustusi; otsustab rahuläbirääkimistega seotud küsimusi, sõlmib rahulepinguid ja esitab need Riigikogule ratifitseerimiseks; otsustab muid riigikaitsega seotud küsimusi, mis ei ole põhiseaduse või seadusega antud Riigikogu või Vabariigi Presidendi pädevusse. (2) Vabariigi Valitsusel on õigus peatada Kaitseväe juhataja poolt temale mitteallutatud juriidilistele ja füüsilistele isikutele antud käske ja korraldusi. (3) Kui Riigikogu ei saa kokku tulla, on Vabariigi Valitsusel õigus sõjaajal: ümber jaotada riigikaitselistel eesmärkidel riigieelarve vahendeid; teha täiendavaid kulusid, investeeringuid ja finantseerimistehinguid, milleks riigieelarves ei ole vahendeid ette nähtud või mille tegemiseks riigieelarve vahenditest ei jätku.",
      "rdfs:label": {
        "@value": "SRKS_Par_9 (redaktsioon 113032014079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014079"
