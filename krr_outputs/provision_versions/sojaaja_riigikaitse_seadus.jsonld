      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sõjaaja riigikaitse seadus (62 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sõjaaja riigikaitse seadus"
    },
    {
      "@id": "estleg:SRKS_Par_1_v22300",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seadusega reguleeritakse riigikaitse korralduse alused sõjaajal.",
      "rdfs:label": {
        "@value": "SRKS_Par_1 (redaktsioon 22300)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22300"
    },
    {
      "@id": "estleg:SRKS_Par_10_v22300",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseministeerium: täidab rahuaja riigikaitse seadusega temale pandud ülesandeid, välja arvatud need ülesanded, mis käesoleva seadusega on antud kaitseväe ülemjuhataja pädevusse; juhib ja korraldab reservväelaste mobiliseerimist, neile mobilisatsioonikäskude edasiandmist, reservväelaste kogunemist ja teenistuskohtadesse toimetamist; juhib ja korraldab koostöös kaitseväe ülemjuhatajaga riigikaitseliste sundkoormiste rakendamist; seoses sõjapidamiskuludega jaotab ümber Kaitseministeeriumile riigieelarves ettenähtud assigneeringud; teeb Vabariigi Valitsusele ettepanekuid sõjapidamiskulude osas, milleks riigieelarves ei ole assigneeringuid määratud või mille tegemiseks riigieelarve assigneeringutest ei jätku; esitab Vabariigi Valitsusele sõjaaja lisaeelarve eelnõule ettepanekuid; korraldab kaitsejõudude majandamist, varustamist ja tervishoidu ning sõjapidamiseks vajalike varustustagavarade soetamist, säilitamist ja väljaandmist; korraldab kaitseväe ülemjuhataja taotlusel kutsealuste ja reservväelaste täiendavat mobiliseerimist ning täiendavate sundkoormiste rakendamist.",
      "rdfs:label": {
        "@value": "SRKS_Par_10 (redaktsioon 22300)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22300",
      "estleg:supersededByVersion": {
        "@id": "estleg:SRKS_Par_10_v255833"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SRKS_Par_10_v255833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseministeerium: täidab rahuaja riigikaitse seadusega temale pandud ülesandeid, välja arvatud need ülesanded, mis käesoleva seadusega on antud kaitseväe ülemjuhataja pädevusse; [Alapunkt 2 kehtetu alates 1. 05. 2003] juhib ja korraldab reservväelaste mobiliseerimist, neile mobilisatsioonikäskude edasiandmist, reservväelaste kogunemist ja teenistuskohtadesse toimetamist; [Alapunkt 3 kehtetu alates 1. 05. 2003] juhib ja korraldab koostöös kaitseväe ülemjuhatajaga riigikaitseliste sundkoormiste rakendamist; [Alapunkt 4 kehtetu alates 1. 05. 2003] seoses sõjapidamiskuludega jaotab ümber Kaitseministeeriumile riigieelarves ettenähtud assigneeringud; teeb Vabariigi Valitsusele ettepanekuid sõjapidamiskulude osas, milleks riigieelarves ei ole assigneeringuid määratud või mille tegemiseks riigieelarve assigneeringutest ei jätku; esitab Vabariigi Valitsusele sõjaaja lisaeelarve eelnõule ettepanekuid; korraldab kaitsejõudude majandamist, varustamist ja tervishoidu ning sõjapidamiseks vajalike varustustagavarade soetamist, säilitamist ja väljaandmist; [Alapunkt 8 kehtetu alates 1. 05. 2003] korraldab kaitseväe ülemjuhataja taotlusel kutsealuste ja reservväelaste täiendavat mobiliseerimist ning täiendavate sundkoormiste rakendamist.",
      "rdfs:label": {
        "@value": "SRKS_Par_10 (redaktsioon 255833)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "255833",
      "estleg:supersededByVersion": {
        "@id": "estleg:SRKS_Par_10_v12795773"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SRKS_Par_10_v12795773",
