    {
      "@id": "estleg:SRKS_Par_4_v129112011008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-12-09",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Sõjalist tegevust riigi kaitseks juhib ainuisikuliselt kaitseväe juhataja, kelle alluvuses on kaitsevägi ja Kaitseliit. (2) Kehtetu -",
      "rdfs:label": {
        "@value": "SRKS_Par_4 (redaktsioon 129112011008)",
        "@language": "et"
