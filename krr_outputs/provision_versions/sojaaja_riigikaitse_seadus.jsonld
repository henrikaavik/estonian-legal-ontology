    {
      "@id": "estleg:SRKS_Par_10_v113032014079",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-03-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseministeerium: täidab rahuaja riigikaitse seadusega temale pandud ülesandeid, välja arvatud need ülesanded, mis käesoleva seadusega on antud Kaitseväe juhataja pädevusse; kehtetu - kehtetu - kehtetu - teeb Vabariigi Valitsusele ettepanekuid sõjapidamiskulude kohta, milleks riigieelarves ei ole vahendeid ette nähtud või mille tegemiseks riigieelarve vahenditest ei jätku; esitab Vabariigi Valitsusele sõjaaja lisaeelarve eelnõule ettepanekuid; korraldab kaitsejõudude majandamist, varustamist ja tervishoidu ning sõjapidamiseks vajalike varustustagavarade soetamist, säilitamist ja väljaandmist. kehtetu -",
      "rdfs:label": {
        "@value": "SRKS_Par_10 (redaktsioon 113032014079)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "113032014079"
    },
    {
      "@id": "estleg:SRKS_Par_11_v22300",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse täitevorganid: täidavad rahuaja riigikaitse seadusega neile pandud ülesandeid; korraldavad koostöös Kaitseministeeriumiga reservväelastele ja kutsealustele mobilisatsioonikäskude edasiandmist, reservväelaste ja kutsealuste kogunemist ning nende teenistuskohtadesse toimetamist; korraldavad riigikaitseliste sundkoormiste rakendamist; täidavad Vabariigi Valitsuse või kaitseväe ülemjuhataja poolt neile pandud riigikaitselisi ülesandeid vastavalt käesoleva seaduse paragrahv 9 punktile 11 ning paragrahv 12 2. lõike punktile 2 ja 3. lõike punktile 6.",
      "rdfs:label": {
        "@value": "SRKS_Par_11 (redaktsioon 22300)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22300",
      "estleg:supersededByVersion": {
        "@id": "estleg:SRKS_Par_11_v255833"
      },
      "estleg:versionValidTo": {
        "@value": "2003-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:SRKS_Par_11_v255833",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SRKS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kohaliku omavalitsuse täitevorganid: täidavad rahuaja riigikaitse seadusega neile pandud ülesandeid; [Alapunkt 2 kehtetu alates 1. 05. 2003] korraldavad koostöös Kaitseministeeriumiga reservväelastele ja kutsealustele mobilisatsioonikäskude edasiandmist, reservväelaste ja kutsealuste kogunemist ning nende teenistuskohtadesse toimetamist; [Alapunkt 3 kehtetu alates 1. 05. 2003] korraldavad riigikaitseliste sundkoormiste rakendamist; täidavad Vabariigi Valitsuse või kaitseväe ülemjuhataja poolt neile pandud riigikaitselisi ülesandeid vastavalt käesoleva seaduse § 9 punktile 11 ning § 12 2. lõike punktile 2 ja 3. lõike punktile 6.",
      "rdfs:label": {
