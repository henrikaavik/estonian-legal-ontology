      },
      "dc:source": "Riigi kaitsetegevuse kava koostamise, elluviimise, aruandluse, hindamise ja muutmise kord"
    },
    {
      "@id": "estleg:Reg_1034911_Par_1_v1034911",
      "@type": [
        "owl:NamedIndividual",
