        "@id": "estleg:Reg_1034911_Map"
      }
    },
    {
      "@id": "estleg:Reg_1034911_Par_2_v1034911",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1034911_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2016-05-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kavas esitatakse omavahel seostatuna täidesaatva riigivõimu asutuste, kohaliku omavalitsuse üksuste ja muude riigikaitseülesandega juriidiliste isikute riigikaitseülesanded ning nende täitmiseks vajalikud tegevused. Kavas esitatakse omavahel seostatuna täidesaatva riigivõimu asutuste, kohaliku omavalitsuse üksuste ja muude riigikaitseülesandega juriidiliste isikute riigikaitseülesanded ning nende täitmiseks vajalikud tegevused. 2 (2) Kavas nimetatakse riigikaitseülesandeid täitvate asutuste ja isikute olulisemad olemasolevad võimed, mis on vajalikud riigi julgeolekut ähvardava ohu ennetamiseks ja tõrjumiseks ning riigi toimimise tagamiseks selle ajal. Kavas nimetatakse riigikaitseülesandeid täitvate asutuste ja isikute olulisemad olemasolevad võimed, mis on vajalikud riigi julgeolekut ähvardava ohu ennetamiseks ja tõrjumiseks ning riigi toimimise tagamiseks selle ajal.",
      "rdfs:label": {
        "@value": "Reg_1034911_Par_2 (redaktsioon 1034911)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1034911",
