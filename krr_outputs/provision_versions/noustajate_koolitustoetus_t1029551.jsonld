      "estleg:versionOf": {
        "@id": "estleg:Reg_1029551_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” meetme 2 „Nõustamisteenused, põllumajandusettevõtte juhtimis- ja asendusteenused” tegevuse liigi „Toetus nõustajate koolituseks” raames antava nõustajate koolitustoetuse (edaspidi toetus) saamise täpsemad nõuded toetuse taotlejale, toetuse saajale ja toetatavale tegevusele ning toetuse saaja valiku hindamiskriteeriumid. Määrusega kehtestatakse „Eesti maaelu arengukava 2014–2020” meetme 2 „Nõustamisteenused, põllumajandusettevõtte juhtimis- ja asendusteenused” tegevuse liigi „Toetus nõustajate koolituseks” raames antava nõustajate koolitustoetuse (edaspidi toetus) saamise täpsemad nõuded toetuse taotlejale, toetuse saajale ja toetatavale tegevusele ning toetuse saaja valiku hindamiskriteeriumid.",
      "rdfs:label": {
        "@value": "Reg_1029551_Par_1 (redaktsioon 1029551)",
        "@language": "et"
      },
