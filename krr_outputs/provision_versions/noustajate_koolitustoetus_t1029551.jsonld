    {
      "@id": "estleg:Reg_1029551_Par_4_v1029551",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029551_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja kvalifitseerimisel, pakkumuse vastavaks tunnistamisel või pakkumuse hindamisel võetakse lisaks muudele hanketeates või hankedokumentides esitatud kriteeriumidele arvesse: 1 1) taotleja varasemat kogemust ja pädevust koolituse valdkonnas; 2 2) pakkumuse asjakohasust ning vastavust § 3 lõikes 1 nimetatud õppekavale; 3 3) koolituse või selle osade maksumust. Taotleja kvalifitseerimisel, pakkumuse vastavaks tunnistamisel või pakkumuse hindamisel võetakse lisaks muudele hanketeates või hankedokumentides esitatud kriteeriumidele arvesse: taotleja varasemat kogemust ja pädevust koolituse valdkonnas; pakkumuse asjakohasust ning vastavust § 3 lõikes 1 nimetatud õppekavale; koolituse või selle osade maksumust.",
      "rdfs:label": {
        "@value": "Reg_1029551_Par_4 (redaktsioon 1029551)",
        "@language": "et"
      },
