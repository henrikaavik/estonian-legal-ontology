      "dc:source": "Olmejäätmete liigiti kogumise ja sortimise nõuded ja kord ning sorditud jäätmete liigitamise alused"
    },
    {
      "@id": "estleg:Reg_1054283_Par_1_v1054283",
      "@type": [
