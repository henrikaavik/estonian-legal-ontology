      "estleg:provisionRef": "Reg_159120 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159120_Map"
      }
    },
    {
      "@id": "estleg:Reg_159120_Par_10_v159120",
      "@type": [
        "owl:NamedIndividual",
