      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kalapüügi- või vesiviljelustoodete tootja või töötleja koolitustoetus (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kalapüügi- või vesiviljelustoodete tootja või töötleja koolitustoetus"
    },
    {
      "@id": "estleg:Reg_1029412_Par_1_v1029412",
      "@type": [
        "owl:NamedIndividual",
