      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Tehnilised nõuded sagedusloa alusel kasutatavatele raadioseadmetele (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Tehnilised nõuded sagedusloa alusel kasutatavatele raadioseadmetele"
    },
    {
      "@id": "estleg:Reg_338947_Par_1_v338947",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_338947_Par_1"
      },
