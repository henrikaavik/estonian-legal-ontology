    {
      "@id": "estleg:Reg_1061564_Par_10_v1061564",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061564_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Leiva- või saiatoodet pakutakse iga päev. Leiva- või saiatoodet pakutakse iga päev. 2 (2) Nendes laste- ja haridusasutustes, kus toitlustatakse vähemalt kolm korda päevas, pakutakse erinevast teraviljast või teraviljasegudest valmistatud toite vähemalt üks kord päevas. Nendes laste- ja haridusasutustes, kus toitlustatakse vähemalt kolm korda päevas, pakutakse erinevast teraviljast või teraviljasegudest valmistatud toite vähemalt üks kord päevas. 3 (3) Pastatooteid põhitoiduna või selle lisandina võib pakkuda kuni kahel päeval nädalas. Pastatooteid põhitoiduna või selle lisandina võib pakkuda kuni kahel päeval nädalas.",
      "rdfs:label": {
        "@value": "Reg_1061564_Par_10 (redaktsioon 1061564)",
        "@language": "et"
      },
