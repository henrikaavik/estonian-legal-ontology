      }
    },
    {
      "@id": "estleg:Reg_1061564_Par_16_v1061564",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1061564_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervislikel põhjustel teisiti toituva lapse toitlustamine korraldatakse koostöös lapsevanema või lapse eestkostja ning laste- ja haridusasutuse pidajaga, arvestades võimaluse korral lisades 1–5 sätestatud nõuetega. Tervislikel põhjustel teisiti toituva lapse toitlustamine korraldatakse koostöös lapsevanema või lapse eestkostja ning laste- ja haridusasutuse pidajaga, arvestades võimaluse korral lisades 1–5 sätestatud nõuetega. 2 (2) Diabeeti põdevale lapsele peab olema tagatud juurdepääs süsivesikuterikkale toidule ka väljaspool söögiaega. Diabeeti põdevale lapsele peab olema tagatud juurdepääs süsivesikuterikkale toidule ka väljaspool söögiaega. 3 (3) Võimaluse korral tagatakse taimetoidumenüü ja religioonist või muudest veendumustest tulenev teisiti toitlustamine. Sellisel juhul võib kokkuleppel lapsevanema ning laste- ja haridusasutusega teha erandeid §-des 11 ja 12 sätestatust, arvestades lisades 1–5 sätestatud nõuetega. Võimaluse korral tagatakse taimetoidumenüü ja religioonist või muudest veendumustest tulenev teisiti toitlustamine. Sellisel juhul võib kokkuleppel lapsevanema ning laste- ja haridusasutusega teha erandeid §-des 11 ja 12 sätestatust, arvestades lisades 1–5 sätestatud nõuetega.",
      "rdfs:label": {
        "@value": "Reg_1061564_Par_16 (redaktsioon 1061564)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061564",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1061564",
      "estleg:sourceAct": "Nõuded laste toitlustamisele haridusasutuses ja sotsiaalteenuse osutamisel",
      "estleg:provisionRef": "Reg_1061564 § 16",
      "estleg:partOfAct": {
