      "estleg:versionValidFrom": {
        "@value": "2026-04-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrus jõustub 1. septembril 2025. a. Määrus jõustub 1. septembril 2025. a. 2 (2) Määruse § 8 lõiget 3, § 9 lõikeid 2 ja 4, § 12 lõiget 3, § 13, § 14 lõiget 2 ja lõike 3 teist lauset ning lisa 5 rakendatakse 1. septembrist 2026. a. Määruse § 8 lõiget 3, § 9 lõikeid 2 ja 4, § 12 lõiget 3, § 13, § 14 lõiget 2 ja lõike 3 teist lauset ning lisa 5 rakendatakse 1. septembrist 2026. a. 3 (3) Määruse § 9 lõiked 1 ja 3 kehtivad kuni 31. augustini 2026. a. Määruse § 9 lõiked 1 ja 3 kehtivad kuni 31. augustini 2026. a.",
      "rdfs:label": {
        "@value": "Reg_1061564_Par_19 (redaktsioon 1061564)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1061564",
