    },
    {
      "@id": "estleg:Reg_1055281_Par_20_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_20 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_3_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_3 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_4_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse seletuskirjas4 on esitatud põhjendused: 1 1) kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; 2 2) loodusobjekti kaitse alla võtmise otstarbekuse kohta; 3 3) kaitstava loodusobjekti tüübi valiku kohta; 4 4) kaitstava loodusobjekti välis- ja vööndite piiride kulgemise kohta; 5 5) kaitsekorra kohta. Määruse seletuskirjas4 on esitatud põhjendused: kaitse alla võtmise eesmärkide vastavuse kohta kaitse alla võtmise eeldustele; loodusobjekti kaitse alla võtmise otstarbekuse kohta; kaitstava loodusobjekti tüübi valiku kohta; kaitstava loodusobjekti välis- ja vööndite piiride kulgemise kohta; kaitsekorra kohta.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_4 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_5_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Inimestel on lubatud viibida ning korjata marju, seeni ja muid metsa kõrvalsaadusi kogu kaitsealal. Inimestel on lubatud viibida ning korjata marju, seeni ja muid metsa kõrvalsaadusi kogu kaitsealal. 2 (2) Telkimine ja lõkketegemine on lubatud kaitseala valitseja nõusolekul, kaitseala valitsemise või kaitse korraldamisega seotud tegevusel, järelevalve- ja päästetöödel ning kaitseala valitseja nõusolekul teostataval teadustegevusel ja metsamajandustöödel. Telkimine ja lõkketegemine on lubatud kaitseala valitseja nõusolekul, kaitseala valitsemise või kaitse korraldamisega seotud tegevusel, järelevalve- ja päästetöödel ning kaitseala valitseja nõusolekul teostataval teadustegevusel ja metsamajandustöödel. 3 (3) Kaitsealal on lubatud: 1 1) sõidukiga sõitmine teedel; 2 2) jalgrattaga sõitmine radadel; 3 3) punktides 1 ja 2 nimetamata juhtudel sõidukiga sõitmine väljaspool teid ja maastikusõidukiga sõitmine järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel, kaitseala valitseja nõusolekul teostataval teadustegevusel ning kaitse-eeskirjaga lubatud töödel, sealhulgas piiranguvööndis metsamajandustöödel. Kaitsealal on lubatud: sõidukiga sõitmine teedel; jalgrattaga sõitmine radadel; punktides 1 ja 2 nimetamata juhtudel sõidukiga sõitmine väljaspool teid ja maastikusõidukiga sõitmine järelevalve- ja päästetöödel, kaitseala valitsemise ja kaitse korraldamisega seotud tegevusel, kaitseala valitseja nõusolekul teostataval teadustegevusel ning kaitse-eeskirjaga lubatud töödel, sealhulgas piiranguvööndis metsamajandustöödel. 4 (4) Kaitsealal on lubatud jahipidamine, välja arvatud linnujaht. Kaitsealal on lubatud jahipidamine, välja arvatud linnujaht.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_5 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_6_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja nõusolekuta on kaitsealal keelatud: 1 1) muuta katastriüksuse kõlvikute piire ja sihtotstarvet; 2 2) koostada maakorralduskava ja teha maakorraldustoiminguid; 3 3) kehtestada detailplaneeringut ja üldplaneeringut; 4 4) lubada ehitada ehitusteatise kohustusega või ehitusloakohustuslikku ehitist; 5 5) anda projekteerimistingimusi; 6 6) anda ehitusluba; 7 7) rajada uut veekogu, mille pindala on suurem kui viis ruutmeetrit, kui selleks ei ole vaja anda veeluba, ehitusluba ega esitada ehitusteatist; 8 8) jahiulukeid lisasööta. Kaitseala valitseja nõusolekuta on kaitsealal keelatud: muuta katastriüksuse kõlvikute piire ja sihtotstarvet; koostada maakorralduskava ja teha maakorraldustoiminguid; kehtestada detailplaneeringut ja üldplaneeringut; lubada ehitada ehitusteatise kohustusega või ehitusloakohustuslikku ehitist; anda projekteerimistingimusi; anda ehitusluba; rajada uut veekogu, mille pindala on suurem kui viis ruutmeetrit, kui selleks ei ole vaja anda veeluba, ehitusluba ega esitada ehitusteatist; jahiulukeid lisasööta.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_6 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_7_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kaitseala valitseja ei kooskõlasta tegevust, mis kaitse-eeskirja kohaselt vajab kaitseala valitseja nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit. Kaitseala valitseja ei kooskõlasta tegevust, mis kaitse-eeskirja kohaselt vajab kaitseala valitseja nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit. 2 (2) Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuse juures ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmise korral tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt haldusmenetluse seadusele õiguspärast ootust sellise tegevuse õiguspärasuse suhtes. Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuse juures ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmise korral tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt haldusmenetluse seadusele õiguspärast ootust sellise tegevuse õiguspärasuse suhtes.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_7 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_8_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. Sihtkaitsevöönd on kaitseala osa seal väljakujunenud või kujundatavate looduslike koosluste säilitamiseks. 2 (2) Kaitsealal on Nepstemurru metsa sihtkaitsevöönd. Kaitsealal on Nepstemurru metsa sihtkaitsevöönd.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_8 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
    {
      "@id": "estleg:Reg_1055281_Par_9_v1055281",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055281_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndi kaitse-eesmärk on laane-, salu- ja soovikumetsade elustiku mitmekesisuse, väike-punalamesklase elupaiga ning kaitsealuste linnuliikide ja nende elupaikade kaitse. Sihtkaitsevööndi kaitse-eesmärk on laane-, salu- ja soovikumetsade elustiku mitmekesisuse, väike-punalamesklase elupaiga ning kaitsealuste linnuliikide ja nende elupaikade kaitse.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_9 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055281_Map"
      }
    },
