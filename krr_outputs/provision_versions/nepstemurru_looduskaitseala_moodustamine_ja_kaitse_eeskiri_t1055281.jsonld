      },
      "estleg:versionValidFrom": {
        "@value": "2022-12-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas3. Kaitseala välispiir ja vööndite piirid on esitatud kaardil määruse lisas3.",
      "rdfs:label": {
        "@value": "Reg_1055281_Par_2 (redaktsioon 1055281)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055281",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055281",
      "estleg:sourceAct": "Nepstemurru looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1055281 § 2",
