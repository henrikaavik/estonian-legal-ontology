    {
      "@id": "estleg:Reg_304825_Par_13_v304825",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_304825_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Alates 1. jaanuarist 2018. a otsustab maa munitsipaalomandisse andmise „Maareformi seaduse” § 28 lõike 1 punktide 1, 3, 4, 5, 7, 8, 9, 10, 11 ja 12 alusel munitsipaalomandisse taotletud maa osas Maa- ja Ruumiameti peadirektor ning sama paragrahvi lõikes 2 nimetatud maa osas majandus- ja tööstusminister. RT I 2024-12-29 4 129122024004 2025-01-01 Alates 1. jaanuarist 2018. a otsustab maa munitsipaalomandisse andmise „Maareformi seaduse” § 28 lõike 1 punktide 1, 3, 4, 5, 7, 8, 9, 10, 11 ja 12 alusel munitsipaalomandisse taotletud maa osas Maa- ja Ruumiameti peadirektor ning sama paragrahvi lõikes 2 nimetatud maa osas majandus- ja tööstusminister.",
      "rdfs:label": {
        "@value": "Reg_304825_Par_13 (redaktsioon 304825)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "304825",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/304825",
      "estleg:sourceAct": "Maa munitsipaalomandisse andmise kord",
      "estleg:provisionRef": "Reg_304825 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_304825_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_304825_Par_2_v304825",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
