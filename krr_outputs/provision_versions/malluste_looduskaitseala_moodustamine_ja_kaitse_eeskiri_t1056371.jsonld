      "estleg:sourceAct": "Malluste looduskaitseala moodustamine ja kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056371 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056371_Map_2026"
      }
    },
