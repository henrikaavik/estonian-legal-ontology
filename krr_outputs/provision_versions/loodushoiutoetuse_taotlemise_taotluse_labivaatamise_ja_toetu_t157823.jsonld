      "estleg:versionValidFrom": {
        "@value": "2023-07-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus kehtestab kaitseala, hoiuala või püsielupaiga Eesti looduse infosüsteemi kantud pärandniitude säilimiseks kaitse-eeskirjaga, kaitsekorralduskavaga või tegevuskavaga määratud vajaliku töö toetamiseks kinnisasja valdajale makstava loodushoiutoetuse (edaspidi toetus) taotlemise, taotluse läbivaatamise, tööde tegemise, toetuse maksmise nõuded ja tingimused, toetuse maksmise ja tagasinõudmise korra ning toetuste määrad. RT I 2022-06-27 1 127062022001 2022-06-30 Määrus kehtestab kaitseala, hoiuala või püsielupaiga Eesti looduse infosüsteemi kantud pärandniitude säilimiseks kaitse-eeskirjaga, kaitsekorralduskavaga või tegevuskavaga määratud vajaliku töö toetamiseks kinnisasja valdajale makstava loodushoiutoetuse (edaspidi toetus) taotlemise, taotluse läbivaatamise, tööde tegemise, toetuse maksmise nõuded ja tingimused, toetuse maksmise ja tagasinõudmise korra ning toetuste määrad.",
      "rdfs:label": {
        "@value": "Reg_157823_Par_1 (redaktsioon 157823)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "157823",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/157823",
