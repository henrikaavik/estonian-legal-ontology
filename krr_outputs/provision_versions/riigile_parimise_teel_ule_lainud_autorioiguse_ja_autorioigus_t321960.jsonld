      }
    },
    {
      "@id": "estleg:Reg_321960_Par_2_v321960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321960_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Stipendiumi võib maksta üliõpilasele, kelle õppe- või loominguline tegevus on seotud autoriõiguse ja autoriõigusega kaasnevate õiguste pärandaja loomevaldkonnaga, eesmärgiga toetada nimetatud tegevust ning enesetäiendamist. Stipendiumi võib maksta üliõpilasele, kelle õppe- või loominguline tegevus on seotud autoriõiguse ja autoriõigusega kaasnevate õiguste pärandaja loomevaldkonnaga, eesmärgiga toetada nimetatud tegevust ning enesetäiendamist.",
      "rdfs:label": {
        "@value": "Reg_321960_Par_2 (redaktsioon 321960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "321960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/321960",
      "estleg:sourceAct": "Riigile pärimise teel üle läinud autoriõiguse ja autoriõigusega kaasnevate õiguste teostamisest saadud tasudest stipendiumi taotlemise ja maksmise kord",
      "estleg:provisionRef": "Reg_321960 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_321960_Map"
      }
    },
    {
      "@id": "estleg:Reg_321960_Par_3_v321960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321960_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Iga autoriõiguse või autoriõigusega kaasnevate õiguste pärandaja tasu osas peetakse Kultuuriministeeriumis eraldi arvestust. Iga autoriõiguse või autoriõigusega kaasnevate õiguste pärandaja tasu osas peetakse Kultuuriministeeriumis eraldi arvestust. 2(2)Stipendiumi nimetus sisaldab autoriõiguse või autoriõigusega kaasnevate õiguste pärandaja ees- ja perekonnanime. Stipendiumi nimetus sisaldab autoriõiguse või autoriõigusega kaasnevate õiguste pärandaja ees- ja perekonnanime. 3(3)Ühel aastal võib määrata mitu stipendiumi. Ühel aastal võib määrata mitu stipendiumi. 4(4)Stipendiumi suuruse kinnitab kultuuriminister käskkirjaga. Stipendiumi suuruse kinnitab kultuuriminister käskkirjaga.",
      "rdfs:label": {
        "@value": "Reg_321960_Par_3 (redaktsioon 321960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "321960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/321960",
      "estleg:sourceAct": "Riigile pärimise teel üle läinud autoriõiguse ja autoriõigusega kaasnevate õiguste teostamisest saadud tasudest stipendiumi taotlemise ja maksmise kord",
      "estleg:provisionRef": "Reg_321960 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_321960_Map"
      }
    },
    {
      "@id": "estleg:Reg_321960_Par_4_v321960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321960_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Stipendiumi võib taotleda üliõpilane, kes õpib täiskoormusega ja õppekaval, mis on seotud autori loomevaldkonnaga ja mille lõpetamisel antakse riiklikult tunnustatud diplom. Stipendiumi võib taotleda üliõpilane, kes õpib täiskoormusega ja õppekaval, mis on seotud autori loomevaldkonnaga ja mille lõpetamisel antakse riiklikult tunnustatud diplom.",
      "rdfs:label": {
        "@value": "Reg_321960_Par_4 (redaktsioon 321960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "321960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/321960",
      "estleg:sourceAct": "Riigile pärimise teel üle läinud autoriõiguse ja autoriõigusega kaasnevate õiguste teostamisest saadud tasudest stipendiumi taotlemise ja maksmise kord",
      "estleg:provisionRef": "Reg_321960 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_321960_Map"
      }
    },
    {
      "@id": "estleg:Reg_321960_Par_5_v321960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321960_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2008-06-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Stipendiumikonkursi korraldab Kultuuriministeerium. Stipendiumikonkursi korraldab Kultuuriministeerium. 2(2)Stipendiumikonkursi väljakuulutamise teade avaldatakse Kultuuriministeeriumi veebilehel hiljemalt iga aasta 31. oktoobriks. Teates märgitakse taotluste laekumise tähtaeg, taotlusele lisatavad dokumendid ja muud andmed. Stipendiumikonkursi väljakuulutamise teade avaldatakse Kultuuriministeeriumi veebilehel hiljemalt iga aasta 31. oktoobriks. Teates märgitakse taotluste laekumise tähtaeg, taotlusele lisatavad dokumendid ja muud andmed. 3(3)Stipendiumikonkurssi ei kuulutata välja, kui 1. oktoobriks on kogunenud raha alla eelmise aasta ühe stipendiumi suuruse. Stipendiumikonkurssi ei kuulutata välja, kui 1. oktoobriks on kogunenud raha alla eelmise aasta ühe stipendiumi suuruse.",
      "rdfs:label": {
        "@value": "Reg_321960_Par_5 (redaktsioon 321960)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "321960",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/321960",
