    },
    {
      "@id": "estleg:Reg_321960_Par_6_v321960",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_321960_Par_6"
