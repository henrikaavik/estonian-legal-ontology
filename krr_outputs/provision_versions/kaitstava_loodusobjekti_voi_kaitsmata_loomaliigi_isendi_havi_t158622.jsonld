      "estleg:provisionRef": "Reg_158622 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158622_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158622_Par_16_v158622",
      "@type": [
