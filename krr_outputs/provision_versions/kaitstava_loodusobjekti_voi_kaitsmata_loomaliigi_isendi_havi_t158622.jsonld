    {
      "@id": "estleg:Reg_158622_Par_26_26_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_26_26"
