    {
      "@id": "estleg:Reg_158622_Par_17_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Hüvitise määr III kaitsekategooria loomaliigi isendi hävitamise eest:11)selgrootu loomaliigi (välja arvatud pisiteo-, kuklase- ja kimalaseliigi) isendi korral on 32 eurot isendi kohta;22)kalaliigi isendi korral on 64 eurot isendi kohta;33)roomaja- või kahepaikseliigi isendi korral on 32 eurot isendi kohta;44)linnuliigi isendi korral on 320 eurot isendi kohta;55)kasetriibiku, pähklinäpi või lagritsa isendi korral on 320 eurot isendi kohta;66)pringli, ahmi või saarma isendi korral on 640 eurot isendi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr III kaitsekategooria loomaliigi isendi hävitamise eest: selgrootu loomaliigi (välja arvatud pisiteo-, kuklase- ja kimalaseliigi) isendi korral on 32 eurot isendi kohta; kalaliigi isendi korral on 64 eurot isendi kohta; roomaja- või kahepaikseliigi isendi korral on 32 eurot isendi kohta; linnuliigi isendi korral on 320 eurot isendi kohta; kasetriibiku, pähklinäpi või lagritsa isendi korral on 320 eurot isendi kohta; pringli, ahmi või saarma isendi korral on 640 eurot isendi kohta. 2(2)Hüvitise määr III kaitsekategooria selgroogse loomaliigi isendi kahjustamise eest on 32 eurot isendi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr III kaitsekategooria selgroogse loomaliigi isendi kahjustamise eest on 32 eurot isendi kohta.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_17 (redaktsioon 158622)",
        "@language": "et"
      },
