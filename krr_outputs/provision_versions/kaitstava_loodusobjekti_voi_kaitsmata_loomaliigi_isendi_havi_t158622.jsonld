  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kaitstava_loodusobjekti_voi_kaitsmata_loomaliigi_isendi_havi_t158622_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kaitstava loodusobjekti või kaitsmata loomaliigi isendi hävitamise või kahjustamisega ning võõrliigi isendi loodusesse laskmisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad (30 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kaitstava loodusobjekti või kaitsmata loomaliigi isendi hävitamise või kahjustamisega ning võõrliigi isendi loodusesse laskmisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad"
    },
    {
      "@id": "estleg:Reg_158622_Par_1_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse kaitstava loodusobjekti või muu linnu- ja imetajaliigi, välja arvatud jahiuluki, isendi hävitamise või kahjustamisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad. Määrusega kehtestatakse kaitstava loodusobjekti või muu linnu- ja imetajaliigi, välja arvatud jahiuluki, isendi hävitamise või kahjustamisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_1 (redaktsioon 158622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158622",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158622",
      "estleg:sourceAct": "Kaitstava loodusobjekti või kaitsmata loomaliigi isendi hävitamise või kahjustamisega ning võõrliigi isendi loodusesse laskmisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad",
      "estleg:provisionRef": "Reg_158622 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158622_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158622_Par_10_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Puu tüve läbimõõt mõõdetakse koos koorega 10 sentimeetri kõrguselt juurekaelast risti tüve pikiteljega. Kui puu juurekael asub maapinnast madalamal, mõõdetakse tüve läbimõõt 10 cm kõrguselt maapinnast. Puu tüve läbimõõt mõõdetakse koos koorega 10 sentimeetri kõrguselt juurekaelast risti tüve pikiteljega. Kui puu juurekael asub maapinnast madalamal, mõõdetakse tüve läbimõõt 10 cm kõrguselt maapinnast.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_10 (redaktsioon 158622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158622",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158622",
      "estleg:sourceAct": "Kaitstava loodusobjekti või kaitsmata loomaliigi isendi hävitamise või kahjustamisega ning võõrliigi isendi loodusesse laskmisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad",
      "estleg:provisionRef": "Reg_158622 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158622_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158622_Par_11_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Hüvitise määr I kaitsekategooria taimeliigi isendi hävitamise eest on 130 eurot isendi kohta ja kahjustamise eest 32 eurot isendi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr I kaitsekategooria taimeliigi isendi hävitamise eest on 130 eurot isendi kohta ja kahjustamise eest 32 eurot isendi kohta. 2(2)Hüvitise määr I kaitsekategooria taimeliigi püsielupaiga hävitamise või kahjustamise eest on:11)püsielupaiga iga ruutmeetri hävitamise korral 260 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 9600 eurot;22)püsielupaiga iga ruutmeetri kahjustamise korral 130 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 3200 eurot.RT I201060407133511092011-01-01+02:00 Hüvitise määr I kaitsekategooria taimeliigi püsielupaiga hävitamise või kahjustamise eest on: püsielupaiga iga ruutmeetri hävitamise korral 260 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 9600 eurot; püsielupaiga iga ruutmeetri kahjustamise korral 130 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 3200 eurot.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_11 (redaktsioon 158622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158622",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158622",
      "estleg:sourceAct": "Kaitstava loodusobjekti või kaitsmata loomaliigi isendi hävitamise või kahjustamisega ning võõrliigi isendi loodusesse laskmisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad",
      "estleg:provisionRef": "Reg_158622 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158622_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158622_Par_12_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Hüvitise määr I kaitsekategooria seene-, sambliku- ja samblaliigi isendi:11)hävitamise eest on 96 eurot isendi kohta;22)kahjustamise eest on 16 eurot isendi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr I kaitsekategooria seene-, sambliku- ja samblaliigi isendi: hävitamise eest on 96 eurot isendi kohta; kahjustamise eest on 16 eurot isendi kohta. 2(2)Hüvitise määr I kaitsekategooria seene-, sambliku- ja samblaliigi püsielupaiga hävitamise või kahjustamise eest:11)püsielupaiga iga ruutmeetri hävitamise korral on 260 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 9600 eurot;22)püsielupaiga iga ruutmeetri kahjustamise korral on 130 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 3200 eurot.RT I201060407133511092011-01-01+02:00 Hüvitise määr I kaitsekategooria seene-, sambliku- ja samblaliigi püsielupaiga hävitamise või kahjustamise eest: püsielupaiga iga ruutmeetri hävitamise korral on 260 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 9600 eurot; püsielupaiga iga ruutmeetri kahjustamise korral on 130 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 3200 eurot.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_12 (redaktsioon 158622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158622",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158622",
      "estleg:sourceAct": "Kaitstava loodusobjekti või kaitsmata loomaliigi isendi hävitamise või kahjustamisega ning võõrliigi isendi loodusesse laskmisega tekitatud keskkonnakahju hüvitamise kord ja hüvitise määrad",
      "estleg:provisionRef": "Reg_158622 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158622_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158622_Par_13_v158622",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158622_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Hüvitise määr II kaitsekategooria ühe- ja kaheaastase rohttaimeliigi isendi:11)hävitamise eest on 64 eurot isendi kohta;22)kahjustamise eest on 6,40 eurot isendi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria ühe- ja kaheaastase rohttaimeliigi isendi: hävitamise eest on 64 eurot isendi kohta; kahjustamise eest on 6,40 eurot isendi kohta. 2(2)Hüvitise määr II kaitsekategooria sõnajalgtaime-, mitmeaastase rohttaimeliigi isendi, puhma, põõsa, kuni ühe meetri kõrguse puu või luuderohu ühe meetri varreosa:11)hävitamise eest on 130 eurot isendi kohta;22)kahjustamise eest on 32 eurot isendi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria sõnajalgtaime-, mitmeaastase rohttaimeliigi isendi, puhma, põõsa, kuni ühe meetri kõrguse puu või luuderohu ühe meetri varreosa: hävitamise eest on 130 eurot isendi kohta; kahjustamise eest on 32 eurot isendi kohta. 3(3)Hüvitise määr II kaitsekategooria sambla-, sambliku- ja seeneliigi isendi hävitamisel:11)värske sambliku, sambla ja seene või nende osade eest on 3,20 eurot ühe grammi kohta;22)kuivanud sambliku, sambla ja seene või nende osade eest on 6,40 eurot ühe grammi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria sambla-, sambliku- ja seeneliigi isendi hävitamisel: värske sambliku, sambla ja seene või nende osade eest on 3,20 eurot ühe grammi kohta; kuivanud sambliku, sambla ja seene või nende osade eest on 6,40 eurot ühe grammi kohta. 4(4)Hüvitise määr II kaitsekategooria sambla-, sambliku- ja seeneliigi isendi kahjustamise eest:11)värske sambla, sambliku ja seene või nende osade eest on 1,30 eurot ühe grammi kohta;22)kuivanud sambla, sambliku ja seene või nende osade eest on 3,20 eurot ühe grammi kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria sambla-, sambliku- ja seeneliigi isendi kahjustamise eest: värske sambla, sambliku ja seene või nende osade eest on 1,30 eurot ühe grammi kohta; kuivanud sambla, sambliku ja seene või nende osade eest on 3,20 eurot ühe grammi kohta. 5(5)Hüvitise määr II kaitsekategooria puu, mille tüve läbimõõt on kuni 10 sentimeetrit:11)hävitamise eest on 64 eurot puu kohta;22)kahjustamise eest ulatuses, mis vähendab puu elujõudu, on 13 eurot puu kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria puu, mille tüve läbimõõt on kuni 10 sentimeetrit: hävitamise eest on 64 eurot puu kohta; kahjustamise eest ulatuses, mis vähendab puu elujõudu, on 13 eurot puu kohta. 6(6)Hüvitise määr II kaitsekategooria puu, mille tüve läbimõõt on 10–30 sentimeetrit:11)hävitamise eest on 130 eurot puu kohta;22)kahjustamise eest ulatuses, mis vähendab puu elujõudu, on 20 eurot puu kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria puu, mille tüve läbimõõt on 10–30 sentimeetrit: hävitamise eest on 130 eurot puu kohta; kahjustamise eest ulatuses, mis vähendab puu elujõudu, on 20 eurot puu kohta. 7(7)Hüvitise määr II kaitsekategooria puu, mille tüve läbimõõt on üle 30 sentimeetri:11)hävitamise eest on 320 eurot puu kohta;22)kahjustamise eest ulatuses, mis vähendab puu elujõudu, on 64 eurot puu kohta.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria puu, mille tüve läbimõõt on üle 30 sentimeetri: hävitamise eest on 320 eurot puu kohta; kahjustamise eest ulatuses, mis vähendab puu elujõudu, on 64 eurot puu kohta. 8(8)Hüvitise määr II kaitsekategooria taime-, sambla-, sambliku- ja seeneliigi püsielupaiga kahjustamise või hävitamise eest:11)püsielupaiga iga ruutmeetri hävitamise korral on 130 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 9600 eurot;22)püsielupaiga iga ruutmeetri kahjustamise korral on 32 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 3200 eurot.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria taime-, sambla-, sambliku- ja seeneliigi püsielupaiga kahjustamise või hävitamise eest: püsielupaiga iga ruutmeetri hävitamise korral on 130 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 9600 eurot; püsielupaiga iga ruutmeetri kahjustamise korral on 32 eurot, kuid ühe püsielupaiga kohta mitte rohkem kui 3200 eurot.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_13 (redaktsioon 158622)",
        "@language": "et"
      },
