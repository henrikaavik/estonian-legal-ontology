      "estleg:versionValidFrom": {
        "@value": "2010-08-23",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1(1)Hüvitise määr I kaitsekategooria kivistise leiukoha:11)iga ruutmeetri hävitamise eest on 640 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 9600 eurot;22)iga ruutmeetri kahjustamise eest on 320 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 3200 eurot.RT I201060407133511092011-01-01+02:00 Hüvitise määr I kaitsekategooria kivistise leiukoha: iga ruutmeetri hävitamise eest on 640 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 9600 eurot; iga ruutmeetri kahjustamise eest on 320 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 3200 eurot. 2(2)Hüvitise määr II kaitsekategooria kivistise leiukoha:11)iga ruutmeetri hävitamise eest on 320 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 9600 eurot;22)iga ruutmeetri kahjustamise eest on 160 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 3200 eurot.RT I201060407133511092011-01-01+02:00 Hüvitise määr II kaitsekategooria kivistise leiukoha: iga ruutmeetri hävitamise eest on 320 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 9600 eurot; iga ruutmeetri kahjustamise eest on 160 eurot, kuid kokku ühe leiukoha kohta mitte rohkem kui 3200 eurot.",
      "rdfs:label": {
        "@value": "Reg_158622_Par_26 (redaktsioon 158622)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158622",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158622",
