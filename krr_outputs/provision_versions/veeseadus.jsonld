      }
    },
    {
      "@id": "estleg:VEE_Par_41_v874375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "VEE_Par_41 (redaktsioon 874375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "874375",
