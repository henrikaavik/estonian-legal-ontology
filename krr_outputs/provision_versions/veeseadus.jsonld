        "@id": "estleg:VEE_Par_42_v113122013008"
      },
      "estleg:versionValidTo": {
        "@value": "2013-12-22",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_42_v113122013008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
