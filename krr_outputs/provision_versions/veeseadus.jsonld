      }
    },
    {
      "@id": "estleg:VEE_Par_16_v13116450",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu – (2) Vee erikasutuseks vee-energia saamise eesmärgil ei väljastata luba, kui erikasutusega kaasnev maaomanike ja teiste veekasutajate õiguste kitsendamine ning veekogu seisundi muutmine on ökoloogilis-majanduslikult põhjendamata. (3) Vee-energia saamisel vooluvee tõkestamisega ja paisutamisega rakendatakse käesoleva seaduse § 17 nõudeid.",
      "rdfs:label": {
        "@value": "VEE_Par_16 (redaktsioon 13116450)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13116450",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_16_v123122010041"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
