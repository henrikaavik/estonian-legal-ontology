      }
    },
    {
      "@id": "estleg:VEE_Par_30_v122022019032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-03-04",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VEE_Par_30 (redaktsioon 122022019032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019032",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_30_v122022019001"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_30_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi ja Venemaa Föderatsiooni territooriumil asuvate piiriüleste vesikondade asjus tehakse koostööd käesoleva seaduse ja välislepingu alusel, et saavutada veekaitse eesmärgid piiriülese vesikonna Eestis paiknevas osas. (2) Vesikond, mis koosneb riigipiiri ületavast valgalast, on piiriülene vesikond. (3) Veekaitset piiriülestes vesikondades korraldatakse Eesti Vabariigi välislepingute kohaselt. (4) Piiriülese vesikonnaga seotud teabe vahetamisel ning dokumentide kooskõlastamisel käesolevas seaduses sätestatud juhtudel edastab asjaomase teabe ja dokumendid välisriigi pädevale asutusele Keskkonnaministeerium.",
      "rdfs:label": {
        "@value": "VEE_Par_30 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_30_v130062023100"
      },
      "estleg:versionValidTo": {
        "@value": "2023-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_30_v130062023100",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Eesti Vabariigi ja Venemaa Föderatsiooni territooriumil asuvate piiriüleste vesikondade asjus tehakse koostööd käesoleva seaduse ja välislepingu alusel, et saavutada veekaitse eesmärgid piiriülese vesikonna Eestis paiknevas osas. (2) Vesikond, mis koosneb riigipiiri ületavast valgalast, on piiriülene vesikond. (3) Veekaitset piiriülestes vesikondades korraldatakse Eesti Vabariigi välislepingute kohaselt. (4) Piiriülese vesikonnaga seotud teabe vahetamisel ning dokumentide kooskõlastamisel käesolevas seaduses sätestatud juhtudel edastab asjaomase teabe ja dokumendid välisriigi pädevale asutusele Kliimaministeerium.",
      "rdfs:label": {
        "@value": "VEE_Par_30 (redaktsioon 130062023100)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130062023100"
    },
    {
      "@id": "estleg:VEE_Par_304_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_304"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veeseadus (RT I 1994, 40, 655) tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "VEE_Par_304 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_304_v121122019017"
      },
      "estleg:versionValidTo": {
        "@value": "2019-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_304_v121122019017",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_304"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VEE_Par_304 (redaktsioon 121122019017)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121122019017"
    },
    {
      "@id": "estleg:VEE_Par_305_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_305"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2019. aasta 1. oktoobril. (2) Käesoleva seaduse § 301 punkt 3 ja § 303 jõustuvad üldises korras. (3) Käesoleva seaduse § 290 punktid 8, 9 ja 11 jõustuvad 2019. aasta 1. juulil. (4) Käesoleva seaduse § 159 lõiked 5 ja 6, § 161 lõige 3 ning § 294 punkt 2 jõustuvad 2021. aasta 1. jaanuaril. (5) Käesoleva seaduse § 164 lõiked 1 ja 6 jõustuvad 2023. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "VEE_Par_305 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001"
    },
    {
      "@id": "estleg:VEE_Par_31_v22283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maavarade ja maa-ainese kaevandamist veekogu põhjast või sellele toetuvate ehitiste rajamist tuleb korraldada nii, etselletagajärjel ei kahjustuks vesi, vee-elustik ega veekogu kaldad. (2) Kui maapõue kasutatakse muudel eesmärkidel kui põhjavee saamiseks, peab rakendama meetmeid põhjavee kaitseks. (3) Veehaarde sanitaarkaitsealal on maavarade kaevandamine keelatud.",
      "rdfs:label": {
        "@value": "VEE_Par_31 (redaktsioon 22283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22283",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_31_v752866"
      },
      "estleg:versionValidTo": {
        "@value": "2004-05-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_31_v752866",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maavarade ja maa-ainese kaevandamist veekogu põhjast või sellele toetuvate ehitiste rajamist tuleb korraldada nii, et selle tagajärjel ei kahjustuks vesi, vee-elustik ega veekogu kaldad. (2) Kui maapõue kasutatakse muudel eesmärkidel kui põhjavee saamiseks, peab rakendama meetmeid põhjavee kaitseks. (3) Veehaarde sanitaarkaitsealal on maavarade kaevandamine keelatud.",
      "rdfs:label": {
        "@value": "VEE_Par_31 (redaktsioon 752866)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "752866",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_31_v122022019001"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_31_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veekaitse üldised eesmärgid on: vähendada inimtegevuse mõju veekeskkonnale; vältida veeökosüsteemide, nendest sõltuvate maismaaökosüsteemide ja märgalade seisundi halvenemist ning parandada nende seisundit; soodustada vee kestlikku kasutamist ning tagada pinna- ja põhjaveevarude pikaajaline kaitse ning piisav veevarustus; lõpetada prioriteetsete ohtlike ainete heide ja piirata saasteainete, sealhulgas muude ohtlike ainete heidet veekeskkonda; aidata kaasa üleujutuste ja põudade mõju leevendamisele; saavutada mereala hea keskkonnaseisund. (2) Kui veekogumi suhtes kehtib samal ajal rohkem kui üks veekaitse eesmärk, kohaldatakse neist kõige rangemat.",
      "rdfs:label": {
        "@value": "VEE_Par_31 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001"
    },
    {
      "@id": "estleg:VEE_Par_32_v22283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veekogu ja põhjaveekihi seisundit mõjutava uue või rekonstrueeritava ehitise asukoha valikul, projekteerimisel, ehitamisel ja likvideerimisel ning uue tehnoloogia evitamisel peab tagama vee kaitse reostamise ja liigvähendamise, veekogu kaitse risustamise eest, arvestama teiste maaomanike ja veekasutajate huve ning kindlustama joogiveevarustatuse. (2) Loa veekogu ja põhjaveekihi seisukorda mõjutavate tööde tegemiseks veekogul ja veekaitsevööndis annab kohalik omavalitsus maaomaniku ja veekasutaja nõusolekul. (3) Kui käesoleva paragrahvi 2. lõikes märgitud tööd toimuvad veehaarde sanitaarkaitsealal, siis on vajalik veehaarde omaniku nõusolek.",
      "rdfs:label": {
        "@value": "VEE_Par_32 (redaktsioon 22283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22283",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_32_v123032015143"
      },
      "estleg:versionValidTo": {
        "@value": "2015-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_32_v123032015143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2015-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veekogu ja põhjaveekihi seisundit mõjutava uue või rekonstrueeritava ehitise asukoha valikul, projekteerimisel, ehitamisel ja lammutamisel ning uue tehnoloogia evitamisel peab tagama vee kaitse reostamise ja liigvähendamise, veekogu kaitse risustamise eest, arvestama teiste maaomanike ja veekasutajate huve ning kindlustama joogiveevarustatuse. (2) Loa veekogu ja põhjaveekihi seisukorda mõjutavate tööde tegemiseks veekogul ja veekaitsevööndis annab kohalik omavalitsus maaomaniku ja veekasutaja nõusolekul. (3) Kui käesoleva paragrahvi 2. lõikes märgitud tööd toimuvad veehaarde sanitaarkaitsealal, siis on vajalik veehaarde omaniku nõusolek.",
      "rdfs:label": {
        "@value": "VEE_Par_32 (redaktsioon 123032015143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123032015143",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_32_v122022019001"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_32_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_32"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pinnavee kaitse eesmärk on pinnaveekogumite, sealhulgas tehisveekogumite, tugevasti muudetud veekogumite ning pinnaveekogumiga hõlmamata veekogude, sealhulgas territoriaalmere, vähemalt hea seisund. (2) Pinnaveekogumi seisund on hea, kui selle ökoloogiline ja keemiline seisund on käesoleva seaduse § 61 lõike 2 alusel kehtestatud kvaliteedinäitajate väärtuste ja § 76 lõike 1 alusel kehtestatud kvaliteedi piirväärtuste kohaselt vähemalt hea. (3) Tehisveekogumi ja tugevasti muudetud veekogumi seisund on hea, kui nende ökoloogiline potentsiaal ja keemiline seisund on käesoleva seaduse § 61 lõike 2 alusel kehtestatud kvaliteedinäitajate väärtuste ja § 76 lõike 1 alusel kehtestatud kvaliteedi piirväärtuste kohaselt vähemalt hea. (4) Pinnavesi kaitset vajavatel aladel käesoleva seaduse § 36 lõike 1 punktide 2 ja 5 tähenduses peab vastama § 36 lõike 6 ja looduskaitseseaduse alusel kehtestatud nõuetele. (5) Pinnaveekogumiga hõlmamata veekogude, sealhulgas territoriaalmere, seisund on hea, kui vees ei ületata käesoleva seaduse § 76 lõike 1 alusel kehtestatud kvaliteedi piirväärtusi ning veekogu, välja arvatud territoriaalmeri, vastab § 61 lõike 4 alusel kehtestatud kvaliteedinäitajate väärtustele.",
      "rdfs:label": {
        "@value": "VEE_Par_32 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001"
    },
    {
      "@id": "estleg:VEE_Par_33_v22283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kui vett või veekogu kasutatakse ilma vastava loa või nõusolekuta või kui vee seisundit mõjutavate tööde tegemisel rikutakse keskkonnakaitsenõudeid, võidakse niisugune tegevus seadusega sätestatud korras peatada. (2) Tegevuse peatamisega seotud vaidlused lahendab kohus.",
      "rdfs:label": {
        "@value": "VEE_Par_33 (redaktsioon 22283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22283",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_33_v122022019001"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_33_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_33"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pinnaveekogumite ökoloogilise ja keemilise seisundi halvenemist tuleb vältida. (2) Tehisveekogumite ja tugevasti muudetud veekogumite ökoloogilise potentsiaali ja keemilise seisundi halvenemist tuleb vältida. (3) Pinnaveekogumiga hõlmamata veekogudes tuleb vältida prioriteetsete ainete, prioriteetsete ohtlike ainete, teatavate muude saasteainete ja vesikonnaspetsiifiliste saasteainete piirväärtuste ületamist ning vee kasutamiseks ja elustiku kaitseks vajalike kvaliteedinäitajate halvenemist.",
      "rdfs:label": {
        "@value": "VEE_Par_33 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001"
    },
    {
      "@id": "estleg:VEE_Par_34_v22283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaomanik (valdaja) ja veekasutaja ei tohi põhjustada: üleujutust; kalda, tammi ega muu rajatise purunemist; maa soostumist; pinnase erosiooni ega maalihet.",
      "rdfs:label": {
        "@value": "VEE_Par_34 (redaktsioon 22283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22283",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_34_v123122010041"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_34_v123122010041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VEE_Par_34 (redaktsioon 123122010041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122010041",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_34_v122022019001"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_34_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_34"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põhjavee kaitse eesmärk on põhjaveekogumite hea seisund. (2) Põhjaveekogumi seisund on hea, kui selle keemiline ja koguseline seisund on käesoleva seaduse § 66 lõike 6 alusel kehtestatud kvaliteedinäitajate väärtuste ja koguselise seisundi määramiseks kasutatavate näitajate ning § 77 lõike 4 alusel kehtestatud läviväärtuste kohaselt hea. (3) Põhjaveekogumiga hõlmamata põhjavee kaitse eesmärk on tagada põhjavee kvaliteedinäitajate vastavus käesoleva seaduse § 66 lõike 6, § 77 lõike 4 ja § 79 lõike 3 alusel kehtestatud kvaliteedinäitajate väärtustele, läviväärtustele ja kvaliteedi piirväärtustele, võttes arvesse kõige sarnasemale põhjaveekogumile esitatavaid nõudeid ja looduslike ainete taustataset põhjavees.",
      "rdfs:label": {
        "@value": "VEE_Par_34 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001"
    },
    {
      "@id": "estleg:VEE_Par_35_v22283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vee toimest põhjustatud loodusõnnetuse tagajärgede kõrvaldamist korraldab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "VEE_Par_35 (redaktsioon 22283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22283",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_35_v13342577"
      },
      "estleg:versionValidTo": {
        "@value": "2010-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_35_v13342577",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetud –",
      "rdfs:label": {
        "@value": "VEE_Par_35 (redaktsioon 13342577)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13342577",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_35_v123122010041"
      },
      "estleg:versionValidTo": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_35_v123122010041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "VEE_Par_35 (redaktsioon 123122010041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122010041",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_35_v122022019001"
      },
      "estleg:versionValidTo": {
        "@value": "2019-09-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_35_v122022019001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2019-10-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põhjaveekogumite keemilise ja koguselise seisundi halvenemist tuleb vältida. (2) Põhjaveekogumis tuleb vähendada saasteainesisaldust ning vältida saasteainesisalduse olulist ja püsivat kasvu. (3) Põhjavee kasutamise ja kaitse kavandamisel tuleb arvestada põhjavee loodusliku ressursiga, tagada põhjavee võtmise ja taastumise tasakaal ning vältida põhjavee liigvähendamist. (4) Põhjavee looduslik ressurss on põhjaveekogumi keskmine pikaajaline aasta toitumismäär, millest on lahutatud pikaajaline aastane vooluhulk, mis on vajalik põhjaveega seotud pinnavee hea ökoloogilise seisundi saavutamiseks, pinnavee ökoloogilise seisundi olulise halvenemise vältimiseks ja põhjaveest sõltuvate maismaa ökosüsteemide olulise kahjustumise vältimiseks. (5) Põhjavee liigvähendamise vältimise meetmete kavandamisel võetakse arvesse asjakohasesse registrisse kantud veeseire ja põhjavee loodusliku ressursi andmed ning käesoleva seaduse § 205 lõike 1 alusel kehtestatud põhjaveevaru.",
      "rdfs:label": {
        "@value": "VEE_Par_35 (redaktsioon 122022019001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "122022019001",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_35_v127052022020"
      },
      "estleg:versionValidTo": {
        "@value": "2022-06-05",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_35_v127052022020",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_35"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-06",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Põhjaveekogumite keemilise ja koguselise seisundi halvenemist tuleb vältida. (2) Põhjaveekogumis tuleb vähendada saasteainesisaldust ning vältida saasteainesisalduse olulist ja püsivat kasvu. (3) Põhjavee kasutamise ja kaitse kavandamisel tuleb arvestada põhjavee loodusliku ressursiga, tagada põhjavee võtmise ja taastumise tasakaal ning vältida põhjavee liigvähendamist. (4) Põhjavee looduslik ressurss on põhjaveekogumi keskmine pikaajaline aasta toitumismäär, millest on lahutatud pikaajaline aastane vooluhulk, mis on vajalik põhjaveega seotud pinnavee hea ökoloogilise seisundi saavutamiseks, pinnavee ökoloogilise seisundi olulise halvenemise vältimiseks ja põhjaveest sõltuvate maismaa ökosüsteemide olulise kahjustumise vältimiseks. (5) Põhjavee liigvähendamise vältimise meetmete kavandamisel võetakse arvesse veeseire ja põhjavee loodusliku ressursi andmed ning käesoleva seaduse § 205 lõike 1 alusel kehtestatud põhjaveevaru.",
      "rdfs:label": {
        "@value": "VEE_Par_35 (redaktsioon 127052022020)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "127052022020"
    },
    {
      "@id": "estleg:VEE_Par_36_v22283",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veevarude arvestust peetakse andmete pikaajaliseks hoidmiseks ja väljastamiseks vee hulga, taseme, kvaliteedi, kasutamise ja kasutajate kohta. (2) Veevarude arvestust peetakse riiklikus registris veekatastrina riiklike registrite asutamist, kasutuselevõtmist, pidamist ja likvideerimist reguleerivas õigusaktis sätestatud korras.",
      "rdfs:label": {
        "@value": "VEE_Par_36 (redaktsioon 22283)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22283",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_36_v742798"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_36_v742798",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Veevarude arvestust peetakse vee hulga, taseme, omaduste, kasutamise ja kasutajate ning puuraukude, veehaarete ja põhjaveemaardlate kohta vastavalt keskkonnaregistri seaduses (RT I 2002, 58, 361) või selle alusel kehtestatud õigusaktides sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "VEE_Par_36 (redaktsioon 742798)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "742798",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_36_v874375"
      },
      "estleg:versionValidTo": {
        "@value": "2005-04-02",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VEE_Par_36_v874375",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2005-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veevarude arvestust peetakse vee hulga, taseme, omaduste, kasutamise ja kasutajate ning puuraukude, veehaarete ja põhjaveemaardlate kohta vastavalt keskkonnaregistri seaduses (RT I 2002, 58, 361) või selle alusel kehtestatud õigusaktides sätestatud nõuetele. (2) Kuni käesoleva paragrahvi lõikes 1 nimetatud andmete üleviimiseni keskkonnaregistrisse, peetakse veevarude arvestust riiklikus registris veekatastrina riiklike registrite asutamist, kasutuselevõtmist, pidamist ja likvideerimist reguleerivas õigusaktis sätestatud korras.",
      "rdfs:label": {
        "@value": "VEE_Par_36 (redaktsioon 874375)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "874375",
      "estleg:supersededByVersion": {
        "@id": "estleg:VEE_Par_36_v918143"
      },
      "estleg:versionValidTo": {
        "@value": "2005-07-09",
        "@type": "xsd:date"
      }
    },
