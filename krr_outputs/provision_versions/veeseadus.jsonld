    {
      "@id": "estleg:VEE_Par_5_v123122010041",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikud veekogud on: sisemeri; territoriaalmeri; piiriveekogude Eestis paiknevad osad; Võrtsjärv; Mullutu laht; Suurlaht; Emajõgi; Narva jõgi; Nasva jõgi; Väike-Emajõgi Võrtsjärvest Jõgeveste sillani; Kasari jõgi suudmest kuni Vigala jõe suudmeni. (2) Avalikud veekogud kuuluvad riigile. Avalikud veekogud ei ole tsiviilkäibes.",
      "rdfs:label": {
        "@value": "VEE_Par_5 (redaktsioon 123122010041)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "123122010041",
