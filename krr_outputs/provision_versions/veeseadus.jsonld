    {
      "@id": "estleg:VEE_Par_18_v918143",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_18"
      },
      "estleg:versionValidFrom": {
