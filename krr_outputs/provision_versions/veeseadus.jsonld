      "estleg:versionText": "1 2000/60/EÜ (EÜT L 327, 22.12.2000, lk 1); 91/676/EMÜ (EÜT L 375, 31.12.91, lk 1).",
      "rdfs:label": {
        "@value": "VEE_Par_41 (redaktsioon 742798)",
