    {
      "@id": "estleg:VEE_Par_5_v13277773",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-02-27",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikud veekogud on: sisemeri; territoriaalmeri; piiriveekogude Eestis paiknevad osad; Võrtsjärv; Mullutu laht; Suurlaht; Emajõgi; Narva jõgi; Nasva jõgi; Väike-Emajõgi Võrtsjärvest Pikasilla sillani; Kasari jõgi suudmest kuni Vigala jõe suudmeni. (2) Avalikud veekogud kuuluvad riigile. Avalikud veekogud ei ole tsiviilkäibes.",
      "rdfs:label": {
        "@value": "VEE_Par_5 (redaktsioon 13277773)",
