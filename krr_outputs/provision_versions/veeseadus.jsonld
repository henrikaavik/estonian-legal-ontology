      },
      "estleg:versionValidFrom": {
        "@value": "2005-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veevarude arvestust peetakse vee hulga, taseme, omaduste, kasutamise ja kasutajate ning puuraukude, veehaarete ja põhjaveemaardlate kohta vastavalt keskkonnaregistri seaduses (RT I 2002, 58, 361) või selle alusel kehtestatud õigusaktides sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "VEE_Par_36 (redaktsioon 918143)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "918143",
