    {
      "@id": "estleg:VEE_Par_36_v12890012",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VEE_Par_36"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-12-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veevarude arvestust peetakse vee hulga, taseme, omaduste, kasutamise ja kasutajate ning puuraukude, veehaarete ja põhjaveemaardlate kohta vastavalt keskkonnaregistri seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetele.",
      "rdfs:label": {
        "@value": "VEE_Par_36 (redaktsioon 12890012)",
