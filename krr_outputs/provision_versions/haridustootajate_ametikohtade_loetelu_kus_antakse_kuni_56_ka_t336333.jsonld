      "estleg:provisionRef": "Reg_336333 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_336333_Map"
      }
    },
    {
      "@id": "estleg:Reg_336333_Par_2_v336333",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_336333_Par_2"
      },
