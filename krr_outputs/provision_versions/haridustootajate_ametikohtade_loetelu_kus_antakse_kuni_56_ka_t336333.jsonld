      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Haridustöötajate ametikohtade loetelu, kus antakse kuni 56 kalendripäeva põhipuhkust, ja puhkuse kestus ametikohtade kaupa (9 versiooni)",
        "@language": "et"
      },
      "dc:source": "Haridustöötajate ametikohtade loetelu, kus antakse kuni 56 kalendripäeva põhipuhkust, ja puhkuse kestus ametikohtade kaupa"
    },
    {
      "@id": "estleg:Reg_336333_Par_1_v336333",
