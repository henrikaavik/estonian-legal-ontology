      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Toetuse andmise tingimused meetme „Ettevõtete ressursitõhusus” tegevuse „Jäätmete ringlussevõtu toetamine” jaoks avatud taotlemise korral (29 versiooni)",
        "@language": "et"
