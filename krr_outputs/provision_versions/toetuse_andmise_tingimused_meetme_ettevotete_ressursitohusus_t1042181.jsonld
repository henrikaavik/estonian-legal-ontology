      "dc:source": "Toetuse andmise tingimused meetme „Ettevõtete ressursitõhusus” tegevuse „Jäätmete ringlussevõtu toetamine” jaoks avatud taotlemise korral"
    },
    {
      "@id": "estleg:Reg_1042181_Par_1_v1042181",
      "@type": [
        "owl:NamedIndividual",
