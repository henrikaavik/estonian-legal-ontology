        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ROS_Par_7_v127022015004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
