      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Riigi eelarvestrateegia, riigieelarve eelnõu ja tõhustamiskava koostamise ning riigieelarve vahendite ülekandmise tingimused ja kord ning riigieelarve seadusest tulenevate aruannete esitamise kord (22 versiooni)",
        "@language": "et"
      },
      "dc:source": "Riigi eelarvestrateegia, riigieelarve eelnõu ja tõhustamiskava koostamise ning riigieelarve vahendite ülekandmise tingimused ja kord ning riigieelarve seadusest tulenevate aruannete esitamise kord"
    },
