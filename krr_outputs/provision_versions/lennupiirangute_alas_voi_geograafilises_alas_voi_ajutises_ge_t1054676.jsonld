      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Lennupiirangute alas või geograafilises alas või ajutises geograafilises alas lendamiseks loa taotlemise ja selle andmise kord ning loa andja määramine (10 versiooni)",
        "@language": "et"
      },
      "dc:source": "Lennupiirangute alas või geograafilises alas või ajutises geograafilises alas lendamiseks loa taotlemise ja selle andmise kord ning loa andja määramine"
    },
    {
      "@id": "estleg:Reg_1054676_Par_1_v1054676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1054676_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-09-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse õhusõidukite lennupiirangute alas või mehitamata õhusõidukite lendamise piiramiseks kehtestatud geograafilises alas või ajutises geograafilises alas: 1 1) lendamiseks loa taotlemise ja selle andmise kord; 2 2) loa andja; 3 3) loetelu valitsusasutustest, kes ei pea lennundusseaduse § 41 lõikes 4 nimetatud luba taotlema. Määrusega kehtestatakse õhusõidukite lennupiirangute alas või mehitamata õhusõidukite lendamise piiramiseks kehtestatud geograafilises alas või ajutises geograafilises alas: lendamiseks loa taotlemise ja selle andmise kord; loa andja; loetelu valitsusasutustest, kes ei pea lennundusseaduse § 41 lõikes 4 nimetatud luba taotlema.",
      "rdfs:label": {
        "@value": "Reg_1054676_Par_1 (redaktsioon 1054676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054676",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1054676",
      "estleg:sourceAct": "Lennupiirangute alas või geograafilises alas või ajutises geograafilises alas lendamiseks loa taotlemise ja selle andmise kord ning loa andja määramine",
      "estleg:provisionRef": "Reg_1054676 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054676_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1054676_Par_10_v1054676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
