        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 8. septembril 2022. a. Määrus jõustub 8. septembril 2022. a.",
      "rdfs:label": {
        "@value": "Reg_1054676_Par_10 (redaktsioon 1054676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1054676",
