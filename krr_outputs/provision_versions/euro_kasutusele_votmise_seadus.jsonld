    },
    {
      "@id": "estleg:EKV_Par_1_v130122010022",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:EKV_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Euro kasutusele võtmise seadus reguleerib Eesti Vabariigi rahaseaduse alusel emiteeritud Eesti krooni (edaspidi käesolevas peatükis kroon) eurodeks vahetamist, krooni käibelt kõrvaldamist ning krooni ja euro paralleelkäivet.",
      "rdfs:label": {
        "@value": "EKV_Par_1 (redaktsioon 130122010022)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "130122010022"
    },
