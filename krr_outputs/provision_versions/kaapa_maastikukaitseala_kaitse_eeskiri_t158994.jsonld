    {
      "@id": "estleg:Reg_158994_Par_13_v158994",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158994_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Piiranguvööndis on lubatud majandustegevus. Piiranguvööndis on lubatud majandustegevus. 2 (2) Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: 1 1) Tammeluha piiranguvööndis tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise rajamine kaitsealal paikneva kinnistu või kaitseala tarbeks; 2 2) Tammeluha piiranguvööndis uue maaparandussüsteemi rajamine; 3 3) harvendus- ja valikraie; 4 4) maavara kaevandamine. Piiranguvööndis on kaitseala valitseja nõusolekul lubatud: Tammeluha piiranguvööndis tee, tehnovõrgu rajatise või tootmisotstarbeta ehitise rajamine kaitsealal paikneva kinnistu või kaitseala tarbeks; Tammeluha piiranguvööndis uue maaparandussüsteemi rajamine; harvendus- ja valikraie; maavara kaevandamine.",
      "rdfs:label": {
        "@value": "Reg_158994_Par_13 (redaktsioon 158994)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158994",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158994",
      "estleg:sourceAct": "Kääpa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158994 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158994_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158994_Par_14_v158994",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158994_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) ehitise, kaasa arvatud ajutise ehitise püstitamine, välja arvatud § 13 lõike 2 punktis 1 nimetatud juhul; 3 3) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 4 4) uue maaparandussüsteemi rajamine Välgi piiranguvööndis; 5 5) biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal; 6 6) uuendusraie, välja arvatud turberaie ja lageraie lankidena, mille kogupindala ei ole suurem kui 2 ha, laiusega maksimaalselt 30 m, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; RT I 2006 12 84 999197 2006-03-12+02:00 7 7) puidu kokku- ja väljavedu külmumata pinnasel; 8 8) roo varumine külmumata pinnasel. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; ehitise, kaasa arvatud ajutise ehitise püstitamine, välja arvatud § 13 lõike 2 punktis 1 nimetatud juhul; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine Välgi piiranguvööndis; biotsiidi ja taimekaitsevahendi kasutamine looduslikul rohumaal ja metsamaal; uuendusraie, välja arvatud turberaie ja lageraie lankidena, mille kogupindala ei ole suurem kui 2 ha, laiusega maksimaalselt 30 m, kusjuures tuleb säilitada koosluse liikide ja vanuse mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; roo varumine külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_158994_Par_14 (redaktsioon 158994)",
        "@language": "et"
      },
