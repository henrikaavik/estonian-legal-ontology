      "estleg:sourceAct": "E-residendi digitaalse isikutunnistuse vorm ja tehniline kirjeldus ning e-residendi digitaalsele isikutunnistusele kantavate andmete loetelu",
      "estleg:provisionRef": "Reg_1061815 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061815_Map"
      }
    },
