      },
      "estleg:versionValidFrom": {
        "@value": "2025-11-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) E-residendi digitaalne isikutunnistus on ümarate nurkadega plastkaart mõõtmetega 85,6 × 53,98 millimeetrit. E-residendi digitaalne isikutunnistus on ümarate nurkadega plastkaart mõõtmetega 85,6 × 53,98 millimeetrit. 2 (2) E-residendi digitaalse isikutunnistuse vorm kehtestatakse määruse lisana. E-residendi digitaalse isikutunnistuse vorm kehtestatakse määruse lisana.",
      "rdfs:label": {
        "@value": "Reg_1061815_Par_1 (redaktsioon 1061815)",
