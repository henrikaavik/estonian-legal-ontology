      "rdfs:label": {
        "@value": "Sätete redaktsioonid: E-residendi digitaalse isikutunnistuse vorm ja tehniline kirjeldus ning e-residendi digitaalsele isikutunnistusele kantavate andmete loetelu (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "E-residendi digitaalse isikutunnistuse vorm ja tehniline kirjeldus ning e-residendi digitaalsele isikutunnistusele kantavate andmete loetelu"
    },
    {
      "@id": "estleg:Reg_1061815_Par_1_v1061815",
      "@type": [
