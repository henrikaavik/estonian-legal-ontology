  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_kohtu_poolt_asitoendite_arvelevotmise_hoidmise_uleandmise_ja_t300219_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord (7 versiooni)",
        "@language": "et"
      },
      "dc:source": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord"
    },
    {
      "@id": "estleg:Reg_300219_Par_1_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300219_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolevat korda kohaldatakse asja suhtes, mis on asitõend tsiviilkohtumenetluses.",
      "rdfs:label": {
        "@value": "Reg_300219_Par_1 (redaktsioon 300219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300219",
      "estleg:sourceAct": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord",
      "estleg:provisionRef": "Reg_300219 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300219_Map"
      }
    },
    {
      "@id": "estleg:Reg_300219_Par_2_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300219_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asitõend võetakse tsiviil- või haldusasja juurde kohtumäärusega, kus märgitakse asitõendina kasutatava asja nimetus ja number, esitatakse üksikasjalik kirjeldus ja märgitakse asitõendi hoiukoht.",
      "rdfs:label": {
        "@value": "Reg_300219_Par_2 (redaktsioon 300219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300219",
      "estleg:sourceAct": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord",
      "estleg:provisionRef": "Reg_300219 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300219_Map"
      }
    },
    {
      "@id": "estleg:Reg_300219_Par_3_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300219_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asitõend säilitatakse toimikus või antakse kohtu asitõendite hoiukohta. (2) Asitõendit, mida ei saa kohtusse toimetada, hoitakse selle asukohas või antakse hoiule menetlusosalisele või kolmandale isikule, kes peab tagama asitõendi säilimise. (3) Asitõendi hoiukoha kohta tehakse toimikusse märge. (4) Isik, kelle valduses asitõend on, peab tagama asitõendi ja selle tõenduslike omaduste säilimise. (5) Vajaduse korral asitõend pitseeritakse.",
      "rdfs:label": {
        "@value": "Reg_300219_Par_3 (redaktsioon 300219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300219",
      "estleg:sourceAct": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord",
      "estleg:provisionRef": "Reg_300219 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300219_Map"
      }
    },
    {
      "@id": "estleg:Reg_300219_Par_4_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300219_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui tsiviilasi antakse ühelt kohtult teisele, antakse koos toimikuga üle ka asitõend.",
      "rdfs:label": {
        "@value": "Reg_300219_Par_4 (redaktsioon 300219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300219",
      "estleg:sourceAct": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord",
      "estleg:provisionRef": "Reg_300219 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300219_Map"
      }
    },
    {
      "@id": "estleg:Reg_300219_Par_5_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300219_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Asitõendi hävitamise aluseks on jõustunud kohtulahend. Kiiresti rikneva asitõendi korral on asitõendi hävitamise aluseks kohtumäärus. (2) Hävitamisele kuuluva asitõendi hävitab kohtu esimehe moodustatud asitõendi hävitamise komisjon. Komisjon moodustatakse vähemalt kolmeliikmelises koosseisus, kelle hulgas on asitõendite arvelevõtja. (3) Asitõend hävitatakse viisil, mis ei ole ohtlik elule, tervisele ega keskkonnale ning mis välistab asitõendi taaskasutuselevõtu. (4) Kui asitõendiks on ese või aine, mille hävitamiseks on kehtestatud erikord või erinõuded, tuleb asitõendi hävitamine korraldada nimetatud korra või nõuete kohaselt. (5) Asitõendi hävitamise kohta koostatakse akt, milles märgitakse asitõendi hävitaja, eseme või aine nimetus, kogus, viide otsusele, mille alusel esemed üle antakse, hävitamise viis, aeg ja koht. Asitõendi hävitamise akt koostatakse kahes eksemplaris, millest üks lisatakse toimikule ja teine jääb akti koostanud asutusele. Akti kinnitavad allkirjaga asitõendi hävitaja ja hävitamise juures viibinud ametnikud. (6) Asitõendi hävitamisega seonduvad kulud kannab asitõendi hävitamist korraldanud kohus.",
      "rdfs:label": {
        "@value": "Reg_300219_Par_5 (redaktsioon 300219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300219",
      "estleg:sourceAct": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord",
      "estleg:provisionRef": "Reg_300219 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300219_Map"
      }
    },
    {
      "@id": "estleg:Reg_300219_Par_6_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_300219_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kiiresti riknevate asitõendite hindamisel, võõrandamisel ja hävitamisel lähtutakse Vabariigi Valitsuse 30. juuli 2004. a määruses nr 263 «Konfiskeeritud vara võõrandamise, üleandmise ja hävitamise, vara võõrandamisest saadud raha eelarvest seaduslikule valdajale tagastamise, asitõendite arvelevõtmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord» sätestatust.",
      "rdfs:label": {
        "@value": "Reg_300219_Par_6 (redaktsioon 300219)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "300219",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/300219",
      "estleg:sourceAct": "Kohtu poolt asitõendite arvelevõtmise, hoidmise, üleandmise ja hävitamise ning kiiresti riknevate asitõendite hindamise, võõrandamise ja hävitamise kord",
      "estleg:provisionRef": "Reg_300219 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_300219_Map"
      }
    },
    {
      "@id": "estleg:Reg_300219_Par_7_v300219",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
