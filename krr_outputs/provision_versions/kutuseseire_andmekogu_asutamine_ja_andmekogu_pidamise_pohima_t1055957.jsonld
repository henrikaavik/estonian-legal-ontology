      }
    },
    {
      "@id": "estleg:Reg_1055957_Par_9_v1055957",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055957_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-02-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogus säilitatakse vedelkütuste keskkonnanõuetele vastavuse seire andmeid alaliselt, kui õigusaktist ei tulene teisiti. Andmekogus säilitatakse vedelkütuste keskkonnanõuetele vastavuse seire andmeid alaliselt, kui õigusaktist ei tulene teisiti. 2 (2) Alusdokumente kütuseseire andmekogus ei säilitata. Alusdokumente kütuseseire andmekogus ei säilitata.",
      "rdfs:label": {
        "@value": "Reg_1055957_Par_9 (redaktsioon 1055957)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055957",
