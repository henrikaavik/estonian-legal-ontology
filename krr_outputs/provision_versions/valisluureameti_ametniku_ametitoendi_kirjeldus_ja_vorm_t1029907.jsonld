  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_valisluureameti_ametniku_ametitoendi_kirjeldus_ja_vorm_t1029907_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välisluureameti ametniku ametitõendi kirjeldus ja vorm (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välisluureameti ametniku ametitõendi kirjeldus ja vorm"
    },
    {
      "@id": "estleg:Reg_1029907_Par_1_v1029907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029907_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Välisluureameti ametniku ametitõend (edaspidi ametitõend) on plastikust valmistatud kaart mõõtmetega 85,5 × 54 mm, mis vastab standardile ISO 7810 (CR-80). RT I 2017-06-28 8 128062017008 2017-07-01 Välisluureameti ametniku ametitõend (edaspidi ametitõend) on plastikust valmistatud kaart mõõtmetega 85,5 × 54 mm, mis vastab standardile ISO 7810 (CR-80). 2 (2) Ametitõendi vorm on esitatud määruse lisas. Ametitõendi vorm on esitatud määruse lisas.",
      "rdfs:label": {
        "@value": "Reg_1029907_Par_1 (redaktsioon 1029907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029907",
      "estleg:sourceAct": "Välisluureameti ametniku ametitõendi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1029907 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029907_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029907_Par_2_v1029907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029907_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitõendi esiküljel on halli värvi turvamuster. RT I 2017-06-28 8 128062017008 2017-07-01 Ametitõendi esiküljel on halli värvi turvamuster. 2 (2) Ametitõendi esikülje ülaservas on Välisluureameti embleem. RT I 2017-06-28 8 128062017008 2017-07-01 Ametitõendi esikülje ülaservas on Välisluureameti embleem. 3 (3) Ametitõendi esikülje valgel alal on järgmised elemendid: 1 1) ees- ja perekonnanimi; 2 2) isikukood; 3 3) koht märkele, kas ametnikul on relva kandmise õigus; 4 4) peadirektori allkiri; 5 5) kehtiv kuni; 6 6) paremas servas koht ametniku fotokujutisele. Ametitõendi esikülje valgel alal on järgmised elemendid: ees- ja perekonnanimi; isikukood; koht märkele, kas ametnikul on relva kandmise õigus; peadirektori allkiri; kehtiv kuni; paremas servas koht ametniku fotokujutisele.",
      "rdfs:label": {
        "@value": "Reg_1029907_Par_2 (redaktsioon 1029907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029907",
      "estleg:sourceAct": "Välisluureameti ametniku ametitõendi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1029907 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029907_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029907_Par_3_v1029907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029907_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitõendi tagaküljel on halli värvi turvamuster. RT I 2017-06-28 8 128062017008 2017-07-01 Ametitõendi tagaküljel on halli värvi turvamuster. 2 (2) Ametitõendi tagakülje turvamustri taustal on väikese riigivapi kujutis. RT I 2017-06-28 8 128062017008 2017-07-01 Ametitõendi tagakülje turvamustri taustal on väikese riigivapi kujutis. 3 (3) Ametitõendi tagaküljel on järgmised elemendid: 1 1) läbivalt suurtähtedega tekst „EESTI VABARIIK REPUBLIC OF ESTONIA”; 2 2) koht ametitõendi numbrile. Ametitõendi tagaküljel on järgmised elemendid: läbivalt suurtähtedega tekst „EESTI VABARIIK REPUBLIC OF ESTONIA”; koht ametitõendi numbrile.",
      "rdfs:label": {
        "@value": "Reg_1029907_Par_3 (redaktsioon 1029907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029907",
      "estleg:sourceAct": "Välisluureameti ametniku ametitõendi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1029907 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029907_Map"
      }
    },
    {
      "@id": "estleg:Reg_1029907_Par_4_v1029907",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1029907_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ametitõendile kantakse järgmised andmed: 1 1) ametniku ees- ja perekonnanimi; 2 2) ametniku isikukood; 3 3) ametniku värvitrükis fotokujutis; 4 4) ametitõendi number; 5 5) ametitõendi kehtivuse viimane kuupäev; 6 6) märge ametniku relva kandmise õiguse kohta; 7 7) peadirektori allkiri. Ametitõendile kantakse järgmised andmed: ametniku ees- ja perekonnanimi; ametniku isikukood; ametniku värvitrükis fotokujutis; ametitõendi number; ametitõendi kehtivuse viimane kuupäev; märge ametniku relva kandmise õiguse kohta; peadirektori allkiri. 2 (2) Ametitõendi kanded tehakse printeriga. Kanded trükitakse musta värviga. RT I 2017-06-28 8 128062017008 2017-07-01 Ametitõendi kanded tehakse printeriga. Kanded trükitakse musta värviga.",
      "rdfs:label": {
        "@value": "Reg_1029907_Par_4 (redaktsioon 1029907)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1029907",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1029907",
      "estleg:sourceAct": "Välisluureameti ametniku ametitõendi kirjeldus ja vorm",
      "estleg:provisionRef": "Reg_1029907 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029907_Map"
      }
    },
