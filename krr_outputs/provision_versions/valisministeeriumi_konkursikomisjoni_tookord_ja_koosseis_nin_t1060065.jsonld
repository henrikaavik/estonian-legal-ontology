  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_valisministeeriumi_konkursikomisjoni_tookord_ja_koosseis_nin_t1060065_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord (15 versiooni)",
        "@language": "et"
      },
      "dc:source": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord"
    },
    {
      "@id": "estleg:Reg_1060065_Par_1_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega kehtestatakse: 1 1) Välisministeeriumi konkursikomisjoni (edaspidi komisjon) koosseis; 2 2) komisjoni töökord; 3 3) vaba ametikoha täitmiseks asutusesisese konkursi korraldamise kord. Määrusega kehtestatakse: Välisministeeriumi konkursikomisjoni (edaspidi komisjon) koosseis; komisjoni töökord; vaba ametikoha täitmiseks asutusesisese konkursi korraldamise kord.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_1 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_10_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjon hindab ja arvestab ametikohale valimisel: 1 1) teenistuskoha nõudeid ja teenistuja vastavust nendele nõuetele; 2 2) teenistuja arenguvestluste ja hindamiste tulemusi; 3 3) võimalusel vastava üksuse juhi eelistust; 4 4) võimalusel teenistuja soove ja eelistust; 5 5) teenistushuve ja personaliplaneerimise vajadust. Komisjon hindab ja arvestab ametikohale valimisel: teenistuskoha nõudeid ja teenistuja vastavust nendele nõuetele; teenistuja arenguvestluste ja hindamiste tulemusi; võimalusel vastava üksuse juhi eelistust; võimalusel teenistuja soove ja eelistust; teenistushuve ja personaliplaneerimise vajadust. 2 (2) Komisjon teeb ametisse nimetamise õigust omavale isikule ühe järgmistest ettepanekutest: 1 1) valida ja nimetada kandidaat ametikohale; 2 2) pikendada konkurssi kandidaatide puudumisel või juhul kui ükski kandidaat ei osutu valituks; 3 3) pikendada või lühendada teenistuja diplomaatilisele ametikohale nimetamise tähtaega või lähetustähtaega; 4 4) teha sobivale kandidaadile suunatud pakkumine; 5 5) kuulutada ametikoha täitmiseks välja avalik konkurss või täita ametikoht asutustevahelise rotatsiooni korras, kui on põhjendatud alus arvata, et selline viis on otstarbekam. Komisjon teeb ametisse nimetamise õigust omavale isikule ühe järgmistest ettepanekutest: valida ja nimetada kandidaat ametikohale; pikendada konkurssi kandidaatide puudumisel või juhul kui ükski kandidaat ei osutu valituks; pikendada või lühendada teenistuja diplomaatilisele ametikohale nimetamise tähtaega või lähetustähtaega; teha sobivale kandidaadile suunatud pakkumine; kuulutada ametikoha täitmiseks välja avalik konkurss või täita ametikoht asutustevahelise rotatsiooni korras, kui on põhjendatud alus arvata, et selline viis on otstarbekam.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_10 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_11_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjon võib vabale ametikohale asumise ettepaneku teha: 1 1) teenistujale, kes on komisjoni arvates teenistushuvidest lähtuvalt sellele ametikohale kõige sobivam; 2 2) teenistujale, kes ei ole diplomaatilisele ametikohale nimetamise tähtaja lõppemisel või pikaajalise välislähetuse lõppemisel kandideerinud vabale ametikohale vähemalt kolm kuud enne diplomaatilisele ametikohale nimetamise, välislähetuse lõppemise või välisesindusest ennetähtaegse tagasikutsumise tähtaega; 3 3) karjääridiplomaadile, kelle avaliku võimu teostamise õigus on peatunud avaliku teenistuse seaduse § 33 lõike 5 või § 83 punkti 1 alusel. Komisjon võib vabale ametikohale asumise ettepaneku teha: teenistujale, kes on komisjoni arvates teenistushuvidest lähtuvalt sellele ametikohale kõige sobivam; teenistujale, kes ei ole diplomaatilisele ametikohale nimetamise tähtaja lõppemisel või pikaajalise välislähetuse lõppemisel kandideerinud vabale ametikohale vähemalt kolm kuud enne diplomaatilisele ametikohale nimetamise, välislähetuse lõppemise või välisesindusest ennetähtaegse tagasikutsumise tähtaega; karjääridiplomaadile, kelle avaliku võimu teostamise õigus on peatunud avaliku teenistuse seaduse § 33 lõike 5 või § 83 punkti 1 alusel. 2 (2) Komisjon teeb teenistujale suunatud pakkumise üldjuhul komisjoni aseesimehe kaudu kirjalikku taasesitamist võimaldavas vormis. Komisjon teeb teenistujale suunatud pakkumise üldjuhul komisjoni aseesimehe kaudu kirjalikku taasesitamist võimaldavas vormis. 3 (3) Teenistuja peab suunatud pakkumisele vastama pakkumises määratud kuupäevaks kirjalikku taasesitamist võimaldavas vormis. Pakkumise tagasilükkamist tuleb põhjendada. Teenistuja peab suunatud pakkumisele vastama pakkumises määratud kuupäevaks kirjalikku taasesitamist võimaldavas vormis. Pakkumise tagasilükkamist tuleb põhjendada.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_11 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_12_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjon arutab ja teeb ettepaneku teenistuja välisesindusest ennetähtaegseks tagasikutsumiseks teenistuskohale sobimatuse tõttu, kui selleks on esitanud komisjonile põhjendatud taotluse: 1 1) teenistuja vahetu juht (kui teenistuja vahetu juht ei ole välisesinduse juht, peab taotlus olema kooskõlastatud välisesinduse juhiga) personaliosakonna kaudu või 2 2) personaliosakonna peadirektor. Komisjon arutab ja teeb ettepaneku teenistuja välisesindusest ennetähtaegseks tagasikutsumiseks teenistuskohale sobimatuse tõttu, kui selleks on esitanud komisjonile põhjendatud taotluse: teenistuja vahetu juht (kui teenistuja vahetu juht ei ole välisesinduse juht, peab taotlus olema kooskõlastatud välisesinduse juhiga) personaliosakonna kaudu või personaliosakonna peadirektor. 2 (2) Tagasikutsumise taotluse esitanud isik teavitab teenistujat tagasikutsumise taotlusest ja küsib teenistuja seisukohta, mis esitatakse komisjonile. Tagasikutsumise taotluse esitanud isik teavitab teenistujat tagasikutsumise taotlusest ja küsib teenistuja seisukohta, mis esitatakse komisjonile.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_12 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_13_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Valdkonna eest vastutaval ministril ja Välisministeeriumi igal teenistujal on õigus esitada komisjonile põhjendatud esildis diplomaatilise auastme andmiseks. Valdkonna eest vastutaval ministril ja Välisministeeriumi igal teenistujal on õigus esitada komisjonile põhjendatud esildis diplomaatilise auastme andmiseks. 2 (2) Komisjon teeb ühe järgmistest otsustest: 1 1) teha valdkonna eest vastutavale ministrile põhjendatud ettepanek esitada Vabariigi Valitsuse kaudu Vabariigi Presidendile taotlus diplomaadile diplomaatilise auastme andmiseks; 2 2) mitte teha diplomaatilise auastme andmise ettepanekut või lükata selle üle otsustamine edasi. Komisjon teeb ühe järgmistest otsustest: teha valdkonna eest vastutavale ministrile põhjendatud ettepanek esitada Vabariigi Valitsuse kaudu Vabariigi Presidendile taotlus diplomaadile diplomaatilise auastme andmiseks; mitte teha diplomaatilise auastme andmise ettepanekut või lükata selle üle otsustamine edasi.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_13 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_14_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui suursaadiku auastmega isikut on kriminaalkorras karistatud või distsiplinaarsüüteo eest teenistusest vabastatud, teeb komisjon valdkonna eest vastutavale ministrile ettepaneku esitada Vabariigi Valitsuse kaudu Vabariigi Presidendile taotlus tema diplomaatilise auastme äravõtmiseks. Kui suursaadiku auastmega isikut on kriminaalkorras karistatud või distsiplinaarsüüteo eest teenistusest vabastatud, teeb komisjon valdkonna eest vastutavale ministrile ettepaneku esitada Vabariigi Valitsuse kaudu Vabariigi Presidendile taotlus tema diplomaatilise auastme äravõtmiseks.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_14 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_15_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus jõustub 2025. a 1. jaanuaril. Määrus jõustub 2025. a 1. jaanuaril.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_15 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_2_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjon arutab ja teeb ettepaneku järgmistes küsimustes: 1 1) teenistuja üleviimine ametikohale asutusesisese konkursi tulemusel või suunatud pakkumisega nii peamajas kui ka välisesindustes; 2 2) teenistuja välisesindusest ennetähtaegne tagasikutsumine ja lähetusaja pikendamine, välja arvatud juhtudel, kui kokkuleppel teenistujaga on ametisse nimetamise õigust omav isik muutnud lähetuse lõpu kuupäeva võrreldes lähetamiskäskkirjas määratuga kuni kahe kuu ulatuses, mida ei loeta välisesindusest ennetähtaegseks tagasikutsumiseks või lähetusaja pikendamiseks; 3 3) diplomaatilise au- või teenistusaste andmine, ennistamine või ära võtmine; 4 4) teenistuja pikaajalisele tööalasele täienduskoolitusele saatmine; 5 5) ametniku avaliku võimu teostamise õiguse peatamine avaliku teenistuse seaduse § 33 lõike 5 või § 83 punkti 1 alusel; 6 6) vaba ametikoha täitmine avaliku konkursi või asutustevahelise rotatsiooni korras; 7 7) vajadusel muud personaliküsimused. Komisjon arutab ja teeb ettepaneku järgmistes küsimustes: teenistuja üleviimine ametikohale asutusesisese konkursi tulemusel või suunatud pakkumisega nii peamajas kui ka välisesindustes; teenistuja välisesindusest ennetähtaegne tagasikutsumine ja lähetusaja pikendamine, välja arvatud juhtudel, kui kokkuleppel teenistujaga on ametisse nimetamise õigust omav isik muutnud lähetuse lõpu kuupäeva võrreldes lähetamiskäskkirjas määratuga kuni kahe kuu ulatuses, mida ei loeta välisesindusest ennetähtaegseks tagasikutsumiseks või lähetusaja pikendamiseks; diplomaatilise au- või teenistusaste andmine, ennistamine või ära võtmine; teenistuja pikaajalisele tööalasele täienduskoolitusele saatmine; ametniku avaliku võimu teostamise õiguse peatamine avaliku teenistuse seaduse § 33 lõike 5 või § 83 punkti 1 alusel; vaba ametikoha täitmine avaliku konkursi või asutustevahelise rotatsiooni korras; vajadusel muud personaliküsimused. 2 (2) Komisjon teeb diplomaatilise au- ja teenistusastmega seotud küsimustes oma otsuse alusel asjakohase ettepaneku valdkonna eest vastutavale ministrile, muudel käesoleva paragrahvi lõikes 1 nimetatud juhtudel ametisse nimetamise õigust omavale isikule. Komisjon teeb diplomaatilise au- ja teenistusastmega seotud küsimustes oma otsuse alusel asjakohase ettepaneku valdkonna eest vastutavale ministrile, muudel käesoleva paragrahvi lõikes 1 nimetatud juhtudel ametisse nimetamise õigust omavale isikule.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_2 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_3_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Komisjoni hääleõiguslikud liikmed on ametikoha järgi: 1 1) kantsler, komisjoni esimees; 2 2) personaliosakonna peadirektor, komisjoni aseesimees; 3 3) asekantslerid. Komisjoni hääleõiguslikud liikmed on ametikoha järgi: kantsler, komisjoni esimees; personaliosakonna peadirektor, komisjoni aseesimees; asekantslerid. 2 (2) Komisjoni hääleõiguseta liikmed on diplomaatide ja mittediplomaatide usaldusisik. Komisjoni hääleõiguseta liikmed on diplomaatide ja mittediplomaatide usaldusisik.",
      "rdfs:label": {
        "@value": "Reg_1060065_Par_3 (redaktsioon 1060065)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060065",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060065",
      "estleg:sourceAct": "Välisministeeriumi konkursikomisjoni töökord ja koosseis ning konkursi korraldamise kord",
      "estleg:provisionRef": "Reg_1060065 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060065_Map"
      }
    },
    {
      "@id": "estleg:Reg_1060065_Par_4_v1060065",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060065_Par_4"
      },
