      },
      "estleg:versionValidTo": {
        "@value": "2026-01-09",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:KOFS_Par_7_v131122025009",
      "@type": [
        "owl:NamedIndividual",
