      }
    },
    {
      "@id": "estleg:Reg_325685_Par_20_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekaardi kolmandale lisalehele kantakse lapse tervisekontrolli järgmised andmed: 1 1) ortopeediline staatus – puusaliigese kontroll lapsele vanuses 6–8 nädalat, kus märgitakse läbivaatuse kuupäev, kirjeldus, soovitused, eriarsti konsultatsioonile suunamine; 2 2) reiearteri pulss, märkides, kas pulss on palpeeritav või mitte; 3 3) testiste laskumine poeglastel, märgitakse, kas esimesel või teisel eluaastal on testised laskunud või ei ole laskunud; 4 4) fimoosi hinnangu kanne tehakse kolmandal eluaastal; 5 5) vererõhk (mmHg) – kanded tehakse alates kolmandast eluaastast; 6 6) hemoglobiini, põhivereanalüüsi tulemus – kanded mõõtmise tulemuste kohta tehakse vanuses 9–12 kuud; 7 7) psühhomotoorse arengu jälgimine. Tervisekaardi kolmandale lisalehele kantakse lapse tervisekontrolli järgmised andmed: ortopeediline staatus – puusaliigese kontroll lapsele vanuses 6–8 nädalat, kus märgitakse läbivaatuse kuupäev, kirjeldus, soovitused, eriarsti konsultatsioonile suunamine; reiearteri pulss, märkides, kas pulss on palpeeritav või mitte; testiste laskumine poeglastel, märgitakse, kas esimesel või teisel eluaastal on testised laskunud või ei ole laskunud; fimoosi hinnangu kanne tehakse kolmandal eluaastal; vererõhk (mmHg) – kanded tehakse alates kolmandast eluaastast; hemoglobiini, põhivereanalüüsi tulemus – kanded mõõtmise tulemuste kohta tehakse vanuses 9–12 kuud; psühhomotoorse arengu jälgimine.",
      "rdfs:label": {
        "@value": "Reg_325685_Par_20 (redaktsioon 325685)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325685",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/325685",
      "estleg:sourceAct": "Tervishoiuteenuse osutamise dokumenteerimise tingimused ja kord",
      "estleg:provisionRef": "Reg_325685 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_325685_Map"
      }
    },
    {
      "@id": "estleg:Reg_325685_Par_21_v325685",
      "@type": [
        "owl:NamedIndividual",
