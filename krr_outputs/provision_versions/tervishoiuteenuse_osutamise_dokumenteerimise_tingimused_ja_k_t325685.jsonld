    {
      "@id": "estleg:Reg_325685_Par_73_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_73"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kiirabikaart on kiirabi osutamist tõendav dokument, mis vormistatakse iga väljakutse ja iga patsiendi kohta, kellele osutatakse kiirabiteenust. RT I 2014-11-25 2 125112014002 2014-11-28 65 Kiirabikaart on kiirabi osutamist tõendav dokument, mis vormistatakse iga väljakutse ja iga patsiendi kohta, kellele osutatakse kiirabiteenust. 2 (2) Kehtetu - RT I 2014-11-25 2 125112014002 2014-11-28 Kehtetu - 3 (3) Kehtetu - RT I 2014-11-25 2 125112014002 2014-11-28 Kehtetu -",
      "rdfs:label": {
