    },
    {
      "@id": "estleg:Reg_325685_Par_82_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_82"
      },
      "estleg:versionValidFrom": {
