    {
      "@id": "estleg:Reg_325685_Par_2_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Protseduur on käesoleva määruse tähenduses ravivõte. RT I 2018-07-13 5 113072018005 2018-07-16 Protseduur on käesoleva määruse tähenduses ravivõte. 2 (2) Epikriis on sünnistusabi- või haigusjuhu kokkuvõte. RT I 2019-09-12 1 112092019001 2019-09-15 Epikriis on sünnistusabi- või haigusjuhu kokkuvõte.",
      "rdfs:label": {
        "@value": "Reg_325685_Par_2 (redaktsioon 325685)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325685",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/325685",
      "estleg:sourceAct": "Tervishoiuteenuse osutamise dokumenteerimise tingimused ja kord",
      "estleg:provisionRef": "Reg_325685 § 2",
      "estleg:partOfAct": {
