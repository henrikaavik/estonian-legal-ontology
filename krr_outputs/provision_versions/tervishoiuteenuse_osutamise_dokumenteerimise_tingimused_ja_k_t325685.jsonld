    {
      "@id": "estleg:Reg_325685_Par_1_1_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_1_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva määruse nõudeid ei kohaldata proviisori ja farmatseudi tegevuse dokumenteerimisel. RT I 2018-07-13 5 113072018005 2018-07-16 Käesoleva määruse nõudeid ei kohaldata proviisori ja farmatseudi tegevuse dokumenteerimisel.",
