    {
      "@id": "estleg:Reg_325685_Par_91_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_91"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lahangu saatekirjale kantakse järgmised andmed: 1 1) surnu ees- ja perekonnanimi; 2 2) surnu isikukood, selle puudumisel sünnipäev, -kuu ja -aasta; 3 3) surma kuupäev ja kellaaeg; 4 4) surmakoht; 4 4¹) suremispaik; RT I 2018-07-13 5 113072018005 2018-07-16 5 5) arvatav surma põhjus; RT I 2018-07-13 5 113072018005 2018-07-16 6 6) lahangut telliva tervishoiuasutuse nimetus ja tegevusloa number; 7 7) arsti ees- ja perekonnanimi; 8 8) haiglasse saabumise kuupäev; 9 9) haigusloo number; 10 10) arsti otsus surnu saatmiseks: patoanatoomilisele lahangule või kohtuarstlikule lahangule; 11 11) surnuga kaasasolevad esemed, raha, dokumendid; 12 12) saatekirja vormistaja ees- ja perekonnanimi, telefoninumber ning allkiri. Lahangu saatekirjale kantakse järgmised andmed: surnu ees- ja perekonnanimi; surnu isikukood, selle puudumisel sünnipäev, -kuu ja -aasta; surma kuupäev ja kellaaeg; surmakoht; suremispaik; arvatav surma põhjus; lahangut telliva tervishoiuasutuse nimetus ja tegevusloa number; arsti ees- ja perekonnanimi; haiglasse saabumise kuupäev; haigusloo number; arsti otsus surnu saatmiseks: patoanatoomilisele lahangule või kohtuarstlikule lahangule; surnuga kaasasolevad esemed, raha, dokumendid; saatekirja vormistaja ees- ja perekonnanimi, telefoninumber ning allkiri.",
      "rdfs:label": {
        "@value": "Reg_325685_Par_91 (redaktsioon 325685)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325685",
