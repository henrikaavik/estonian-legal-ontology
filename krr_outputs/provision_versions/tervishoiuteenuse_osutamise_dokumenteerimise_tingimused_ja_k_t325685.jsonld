      },
      "estleg:versionText": "Tervisekaardi teise lisalehe vormistab perearst lapse tervisekaardi juurde määruse lisas 5 toodud vormi kohaselt. Tervisekaardi teise lisalehe vormistab perearst lapse tervisekaardi juurde määruse lisas 5 toodud vormi kohaselt.",
      "rdfs:label": {
        "@value": "Reg_325685_Par_17 (redaktsioon 325685)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325685",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/325685",
      "estleg:sourceAct": "Tervishoiuteenuse osutamise dokumenteerimise tingimused ja kord",
      "estleg:provisionRef": "Reg_325685 § 17",
