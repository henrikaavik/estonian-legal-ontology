    {
      "@id": "estleg:Reg_325685_Par_94_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_94"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Lahangu protokolli tehakse järgmised kanded: 1 1) lahangu number lahangut tegeva tervishoiuasutuse patoloogiaosakonna numeratsiooni alusel; 2 2) lahangu tegemise kuupäev; 3 3) lahangu teinud patoloogi ees- ja perekonnanimi ning registreerimiskood; 4 4) surnu isikuandmed; 5 5) surmakuupäev; 6 6) haiglas viibitud päevade arv; 7 7) kui lahangu tellija on haigla, märgitakse haigla aadress, tegevusloa number ja osakonna nimetus, haigusloo number, arsti ees- ja perekonnanimi ning registreerimiskood; 8 8) kui lahangu tellija on perearst, märgitakse tema postiaadress, ees- ja perekonnanimi ning registreerimiskood; 9 9) kliiniline diagnoos ja kood RHK-10 järgi; 10 10) lahanguleiu kirjeldus; 11 11) skeemid, fotod; 12 12) lahangul võetud koeproovide histoloogilise uuringu kirjeldus; RT I 2018-07-13 5 113072018005 2018-07-16 13 13) lisauuringute andmed; 14 14) patoanatoomiline diagnoos ja kood RHK-10 järgi: põhihaigus, põhihaiguse tüsistused, kaasuvad haigused; 15 15) haigusest tekitatud muutused kehas, nende tekkepõhjused ja -mehhanismid ning vahetu surmapõhjus; RT I 2018-07-13 5 113072018005 2018-07-16 16 16) lahangu tegija vormistatud surma põhjuse teatise number, väljastamise kuupäev ja sellele kantud tekst; RT I 2018-07-13 5 113072018005 2018-07-16 17 17) protokolli vormistamise kuupäev; 18 18) patoloogi allkiri. Lahangu protokolli tehakse järgmised kanded: lahangu number lahangut tegeva tervishoiuasutuse patoloogiaosakonna numeratsiooni alusel; lahangu tegemise kuupäev; lahangu teinud patoloogi ees- ja perekonnanimi ning registreerimiskood; surnu isikuandmed; surmakuupäev; haiglas viibitud päevade arv; kui lahangu tellija on haigla, märgitakse haigla aadress, tegevusloa number ja osakonna nimetus, haigusloo number, arsti ees- ja perekonnanimi ning registreerimiskood; kui lahangu tellija on perearst, märgitakse tema postiaadress, ees- ja perekonnanimi ning registreerimiskood; kliiniline diagnoos ja kood RHK-10 järgi; lahanguleiu kirjeldus; skeemid, fotod; lahangul võetud koeproovide histoloogilise uuringu kirjeldus; lisauuringute andmed; patoanatoomiline diagnoos ja kood RHK-10 järgi: põhihaigus, põhihaiguse tüsistused, kaasuvad haigused; haigusest tekitatud muutused kehas, nende tekkepõhjused ja -mehhanismid ning vahetu surmapõhjus; lahangu tegija vormistatud surma põhjuse teatise number, väljastamise kuupäev ja sellele kantud tekst; protokolli vormistamise kuupäev; patoloogi allkiri.",
      "rdfs:label": {
        "@value": "Reg_325685_Par_94 (redaktsioon 325685)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325685",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/325685",
      "estleg:sourceAct": "Tervishoiuteenuse osutamise dokumenteerimise tingimused ja kord",
      "estleg:provisionRef": "Reg_325685 § 94",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_325685_Map"
      }
    },
    {
      "@id": "estleg:Reg_325685_Par_95_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_95"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Lahangu protokolli väljavõtte vormistab lahangu teinud patoloog lahangu protokolli põhjal. Lahangu protokolli väljavõtte vormistab lahangu teinud patoloog lahangu protokolli põhjal. 2 (2) Lahangu protokolli väljavõte vormistatakse lahangut tegeva tervishoiuasutuse valitud vormi kohaselt. Lahangu protokolli väljavõte vormistatakse lahangut tegeva tervishoiuasutuse valitud vormi kohaselt. 3 (3) Lahangu protokolli väljavõte edastatakse lahangu tellinud tervishoiuasutusele või perearstile, surnu lahangule saatnud tervishoiuteenuse osutajale. Lahangu protokolli väljavõte edastatakse lahangu tellinud tervishoiuasutusele või perearstile, surnu lahangule saatnud tervishoiuteenuse osutajale.",
      "rdfs:label": {
