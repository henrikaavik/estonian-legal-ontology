    {
      "@id": "estleg:Reg_325685_Par_5_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tervisekaardi vormistab ambulatoorset tervishoiuteenust osutanud tervishoiutöötaja, kui käesolevas määruses ei ole sätestatud teisiti. RT I 2016-04-26 1 126042016001 2016-04-29 27 Tervisekaardi vormistab ambulatoorset tervishoiuteenust osutanud tervishoiutöötaja, kui käesolevas määruses ei ole sätestatud teisiti. 1 (1¹) Päevaravi tervishoiuteenuse osutamisel dokumenteerib tervishoiutöötaja osutatud teenuse vastavalt käesoleva peatüki 5. jaos sätestatule, arvestades päevaravi tervishoiuteenuse eripära. RT I 2019-09-12 1 112092019001 2019-09-15 Päevaravi tervishoiuteenuse osutamisel dokumenteerib tervishoiutöötaja osutatud teenuse vastavalt käesoleva peatüki 5. jaos sätestatule, arvestades päevaravi tervishoiuteenuse eripära. 2 (2) Käesoleva määruse tähenduses koosneb tervisekaart neljast lehest. Lapse puhul vormistatakse eelnimetatud lehtedele täiendavalt ka vajalikud lisalehed. Käesoleva määruse tähenduses koosneb tervisekaart neljast lehest. Lapse puhul vormistatakse eelnimetatud lehtedele täiendavalt ka vajalikud lisalehed.",
      "rdfs:label": {
        "@value": "Reg_325685_Par_5 (redaktsioon 325685)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "325685",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/325685",
      "estleg:sourceAct": "Tervishoiuteenuse osutamise dokumenteerimise tingimused ja kord",
      "estleg:provisionRef": "Reg_325685 § 5",
