      "estleg:sourceAct": "Tervishoiuteenuse osutamise dokumenteerimise tingimused ja kord",
      "estleg:provisionRef": "Reg_325685 § 25_28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_325685_Map"
      }
    },
    {
      "@id": "estleg:Reg_325685_Par_26_v325685",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_325685_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-03",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rasedakaart on tervishoiuteenuse osutamist tõendav dokument, mille vormistab naise raseduse kulgu jälgiv tervishoiutöötaja alates rasedusega arvelevõtmise päevast. Rasedakaart vormistatakse tervishoiuteenuse osutaja valitud vormi kohaselt. Rasedakaart on tervishoiuteenuse osutamist tõendav dokument, mille vormistab naise raseduse kulgu jälgiv tervishoiutöötaja alates rasedusega arvelevõtmise päevast. Rasedakaart vormistatakse tervishoiuteenuse osutaja valitud vormi kohaselt.",
      "rdfs:label": {
