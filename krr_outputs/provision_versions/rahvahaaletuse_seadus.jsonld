      },
      "estleg:versionValidFrom": {
        "@value": "2011-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvahääletuse päeval algab hääletamine kell 9.00 ja lõpeb kell 20.00. (2) Eelhääletamine toimub: kehtetu - kuuendast päevast kuni neljanda päevani enne rahvahääletuse päeva kõigis jaoskondades. Hääletamine algab kell 12.00 ja lõpeb kell 20.00; kümnendast päevast kuni neljanda päevani enne rahvahääletuse päeva elektrooniliselt. Hääletamine algab kümnendal päeval enne rahvahääletuse päeva kell 9.00 ja kestab ööpäevaringselt kuni hääletamise lõpuni neljandal päeval enne rahvahääletuse päeva kell 20.00. (3) Kodus hääletamine korraldatakse käesolevas seaduses ettenähtud juhtudel rahvahääletuse päeval. (4) Kehtetu -",
      "rdfs:label": {
        "@value": "RAHVAH_Par_31 (redaktsioon 13189534)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "13189534",
      "estleg:supersededByVersion": {
        "@id": "estleg:RAHVAH_Par_31_v101112012008"
      },
      "estleg:versionValidTo": {
        "@value": "2012-11-10",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RAHVAH_Par_31_v101112012008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RAHVAH_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-11-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Rahvahääletuse päeval algab hääletamine kell 9.00 ja lõpeb kell 20.00. (2) Eelhääletamine toimub: kümnendast kuni seitsmenda päevani enne rahvahääletuse päeva maakonna valimiskomisjoni määratud jaoskonnas. Hääletamine algab kell 12.00 ja lõpeb kell 20.00; kuuendast päevast kuni neljanda päevani enne rahvahääletuse päeva kõigis jaoskondades. Hääletamine algab kell 12.00 ja lõpeb kell 20.00; kümnendast päevast kuni neljanda päevani enne rahvahääletuse päeva elektrooniliselt. Hääletamine algab kümnendal päeval enne rahvahääletuse päeva kell 9.00 ja kestab ööpäevaringselt kuni hääletamise lõpuni neljandal päeval enne rahvahääletuse päeva kell 18.00. (3) Kodus hääletamine korraldatakse käesolevas seaduses ettenähtud juhtudel rahvahääletuse päeval.",
      "rdfs:label": {
        "@value": "RAHVAH_Par_31 (redaktsioon 101112012008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "101112012008",
      "estleg:supersededByVersion": {
