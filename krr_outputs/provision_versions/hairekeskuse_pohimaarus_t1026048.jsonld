      }
    },
    {
      "@id": "estleg:Reg_1026048_Par_7_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Häirekeskuse ingliskeelne nimetus on Estonian Emergency Response Centre. Kui kasutatakse Häirekeskuse ingliskeelset nimetust ja samas kohas on inglise keelde tõlgitud riigi nimi „Eesti Vabariik”, võib Häirekeskus ingliskeelsest nimetusest sõna „Estonian” ära jätta. Häirekeskuse ingliskeelne nimetus on Estonian Emergency Response Centre. Kui kasutatakse Häirekeskuse ingliskeelset nimetust ja samas kohas on inglise keelde tõlgitud riigi nimi „Eesti Vabariik”, võib Häirekeskus ingliskeelsest nimetusest sõna „Estonian” ära jätta.",
      "rdfs:label": {
        "@value": "Reg_1026048_Par_7 (redaktsioon 1026048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026048",
      "estleg:sourceAct": "Häirekeskuse põhimäärus",
      "estleg:provisionRef": "Reg_1026048 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026048_Par_8_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Häirekeskuse tegevusvaldkond on hädaabiteadete ning abi- ja infoteadete menetlemine. RT I 2025-09-05 2 105092025002 2025-09-08 Häirekeskuse tegevusvaldkond on hädaabiteadete ning abi- ja infoteadete menetlemine.",
      "rdfs:label": {
        "@value": "Reg_1026048_Par_8 (redaktsioon 1026048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026048",
      "estleg:sourceAct": "Häirekeskuse põhimäärus",
      "estleg:provisionRef": "Reg_1026048 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026048_Par_9_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Häirekeskuse ülesanded on: 1 1) hädaabiteadete vastuvõtmine, abivajaduse väljaselgitamine ja ohu hindamine, hädaabiteadete menetlemiseks vajalike andmete pärimine ning vajaduse korral Päästeameti ja kiirabibrigaadi väljasaatmine; RT I 2025-09-05 2 105092025002 2025-09-08 2 2) Häirekeskuse arengudokumentide väljatöötamine ning ettepanekute tegemine Häirekeskuse tegevusvaldkonnaga seotud poliitikate ja arengudokumentide, tegevusvaldkonda reguleerivate õigusaktide ja standardite väljatöötamiseks või muutmiseks, arvamuse andmine Häirekeskuse tegevusvaldkonda puudutavate õigusaktide eelnõude kohta ning osalemine nende väljatöötamisel; 3 3) hädaabiteadete ning abi- ja infoteadete menetlemise andmete haldus ning menetlemise ja seotud päringute kohta statistiliste andmete kogumine ja analüüs; RT I 2025-09-05 2 105092025002 2025-09-08 4 4) oma tegevusest ja hädaolukorra vahetust ohust üldsuse teavitamine õigusaktides ettenähtud juhtudel ja korras; 5 5) Häirekeskuse ülesannete täitmiseks vajaliku koostöö arendamine teiste riigiasutuste, kohaliku omavalitsuse üksuste, valitsusväliste organisatsioonide, avalikkuse ning välisriikide asjaomaste ametiasutuste ja rahvusvaheliste organisatsioonidega; 6 6) abi- ja infoteadete menetlemine; RT I 2022-12-17 3 117122022003 2023-01-01 6 6¹) operatiivteabe töötlemine; RT I 2022-12-17 3 117122022003 2023-01-01 7 7) muude seadusest ja selle alusel antud õigusaktidest tulenevate ülesannete täitmine. Häirekeskuse ülesanded on: hädaabiteadete vastuvõtmine, abivajaduse väljaselgitamine ja ohu hindamine, hädaabiteadete menetlemiseks vajalike andmete pärimine ning vajaduse korral Päästeameti ja kiirabibrigaadi väljasaatmine; Häirekeskuse arengudokumentide väljatöötamine ning ettepanekute tegemine Häirekeskuse tegevusvaldkonnaga seotud poliitikate ja arengudokumentide, tegevusvaldkonda reguleerivate õigusaktide ja standardite väljatöötamiseks või muutmiseks, arvamuse andmine Häirekeskuse tegevusvaldkonda puudutavate õigusaktide eelnõude kohta ning osalemine nende väljatöötamisel; hädaabiteadete ning abi- ja infoteadete menetlemise andmete haldus ning menetlemise ja seotud päringute kohta statistiliste andmete kogumine ja analüüs; oma tegevusest ja hädaolukorra vahetust ohust üldsuse teavitamine õigusaktides ettenähtud juhtudel ja korras; Häirekeskuse ülesannete täitmiseks vajaliku koostöö arendamine teiste riigiasutuste, kohaliku omavalitsuse üksuste, valitsusväliste organisatsioonide, avalikkuse ning välisriikide asjaomaste ametiasutuste ja rahvusvaheliste organisatsioonidega; abi- ja infoteadete menetlemine; operatiivteabe töötlemine; muude seadusest ja selle alusel antud õigusaktidest tulenevate ülesannete täitmine. 2 (2) Abi- ja infoteadete menetlemiseks osutab Häirekeskus riigiasutustele ja kohaliku omavalitsuse üksustele riigiinfo teenust ja kriisiinfo teenust. Riigiinfo teenus hõlmab ööpäevaringset teabe andmist riigiasutusi puudutavates küsimustes. Kriisiinfo teenus hõlmab erakorralise sündmuse tõttu riigiinfo telefoni või muu kanali kaudu osutatavat teenust ehk KRIT-i teenust ja ohuteavituse teenust. RT I 2025-09-05 2 105092025002 2025-09-08 Abi- ja infoteadete menetlemiseks osutab Häirekeskus riigiasutustele ja kohaliku omavalitsuse üksustele riigiinfo teenust ja kriisiinfo teenust. Riigiinfo teenus hõlmab ööpäevaringset teabe andmist riigiasutusi puudutavates küsimustes. Kriisiinfo teenus hõlmab erakorralise sündmuse tõttu riigiinfo telefoni või muu kanali kaudu osutatavat teenust ehk KRIT-i teenust ja ohuteavituse teenust. 3 (3) Häirekeskus osutab riigiinfo või kriisiinfo teenust selle tellinud riigiasutuse või kohaliku omavalitsuse üksusega sõlmitud lepingu kohaselt. Häirekeskus vastab riigiinfo või kriisiinfo teenuse osutamisel saadud päringule ja edastab ohuteavituse, kasutades teenuse tellinud riigiasutuse või kohaliku omavalitsuse üksuse edastatud teavet ja käitumisjuhiseid. Vajaduse korral annab Häirekeskus päringule vastamisel andmeid arvatavate kannatanute kohta, kui päästeseaduse § 91 lõikes 21 nimetatud asutus on selle otsustanud, või teavet isiku evakueerimise kohta. RT I 2022-12-17 3 117122022003 2023-01-01 Häirekeskus osutab riigiinfo või kriisiinfo teenust selle tellinud riigiasutuse või kohaliku omavalitsuse üksusega sõlmitud lepingu kohaselt. Häirekeskus vastab riigiinfo või kriisiinfo teenuse osutamisel saadud päringule ja edastab ohuteavituse, kasutades teenuse tellinud riigiasutuse või kohaliku omavalitsuse üksuse edastatud teavet ja käitumisjuhiseid. Vajaduse korral annab Häirekeskus päringule vastamisel andmeid arvatavate kannatanute kohta, kui päästeseaduse § 91 lõikes 21 nimetatud asutus on selle otsustanud, või teavet isiku evakueerimise kohta.",
      "rdfs:label": {
        "@value": "Reg_1026048_Par_9 (redaktsioon 1026048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026048",
      "estleg:sourceAct": "Häirekeskuse põhimäärus",
      "estleg:provisionRef": "Reg_1026048 § 9",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026048_Map_2026"
      }
    },
