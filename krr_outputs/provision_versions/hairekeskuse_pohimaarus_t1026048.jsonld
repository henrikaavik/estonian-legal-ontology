    {
      "@id": "estleg:Reg_1026048_Par_10_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_10"
