      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne käesoleva paragrahvi jõustumist kehtinud lisa 1 kohast Häirekeskuse embleemi ja lisa 2 kohast lipu etalonkujutist võib kasutada kuni 2027. aasta 31. detsembrini. RT I 2025-09-05 2 105092025002 2025-09-08 Enne käesoleva paragrahvi jõustumist kehtinud lisa 1 kohast Häirekeskuse embleemi ja lisa 2 kohast lipu etalonkujutist võib kasutada kuni 2027. aasta 31. detsembrini.",
      "rdfs:label": {
