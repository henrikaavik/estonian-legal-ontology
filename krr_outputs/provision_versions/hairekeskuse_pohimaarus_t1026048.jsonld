    {
      "@id": "estleg:Reg_1026048_Par_19_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Häirekeskus on valmis osutama kriisiinfo teenust Siseministeeriumi valitsemisala asutustele alates 2020. aasta 15. juulist. Häirekeskus on valmis osutama kriisiinfo teenust Siseministeeriumi valitsemisala asutustele alates 2020. aasta 15. juulist. 2 (2) Häirekeskus on valmis osutama kriisiinfo teenust riigiasutustele ja kohaliku omavalitsuse üksustele alates 2021. aasta 1. jaanuarist. RT I 2020-07-07 1 107072020001 2020-07-15 Häirekeskus on valmis osutama kriisiinfo teenust riigiasutustele ja kohaliku omavalitsuse üksustele alates 2021. aasta 1. jaanuarist. 3 (3) Häirekeskus on valmis osutama ohuteavituse teenust ajast, millal valmib ohuteavituse süsteem. RT I 2022-12-17 3 117122022003 2023-01-01 Häirekeskus on valmis osutama ohuteavituse teenust ajast, millal valmib ohuteavituse süsteem.",
      "rdfs:label": {
        "@value": "Reg_1026048_Par_19 (redaktsioon 1026048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026048",
      "estleg:sourceAct": "Häirekeskuse põhimäärus",
      "estleg:provisionRef": "Reg_1026048 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026048_Par_2_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Häirekeskusel on oma eelarve. Häirekeskusel on arvelduskontod riigikassa kontsernikonto koosseisus. Häirekeskusel on oma eelarve. Häirekeskusel on arvelduskontod riigikassa kontsernikonto koosseisus. 2 (2) Häirekeskuse kulud kaetakse riigieelarvest. Häirekeskuse kulud kaetakse riigieelarvest. 3 (3) Häirekeskuse eelarve kinnitab, seda muudab ja selle täitmist kontrollib valdkonna eest vastutav minister. Häirekeskuse eelarve kinnitab, seda muudab ja selle täitmist kontrollib valdkonna eest vastutav minister.",
      "rdfs:label": {
        "@value": "Reg_1026048_Par_2 (redaktsioon 1026048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026048",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1026048",
      "estleg:sourceAct": "Häirekeskuse põhimäärus",
      "estleg:provisionRef": "Reg_1026048 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026048_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1026048_Par_3_v1026048",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1026048_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-08-30",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Häirekeskus on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib Häirekeskuse tegevust ning teostab Häirekeskuse üle õigusaktides sätestatud korras järelevalvet. Häirekeskus on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib Häirekeskuse tegevust ning teostab Häirekeskuse üle õigusaktides sätestatud korras järelevalvet.",
      "rdfs:label": {
        "@value": "Reg_1026048_Par_3 (redaktsioon 1026048)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1026048",
