    {
      "@id": "estleg:Reg_1055346_Par_24_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_24"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab trahheostoomi kaelapaelte eest tasu maksmise kohustuse üle kuni 30 kaelapaela eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on trahheostoom. Tervisekassa võtab trahheostoomi kaelapaelte eest tasu maksmise kohustuse üle kuni 30 kaelapaela eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on trahheostoom.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_24 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 24",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_25_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_25"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajalike kõneklappide eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: 1 1) püsiva trahheostoomi korral kuni kolme Passy Muir™ kõne- ja neelamisklapi või kuni kuue Orator™ kõneklapi eest kalendripoolaastas; 2 2) ajutise trahheostoomi korral ühe Passy Muir™ kõne- ja neelamisklapi või kuni kahe Orator™ kõneklapi eest kahe kuu jooksul. Tervisekassa võtab kindlustatud isikule vajalike kõneklappide eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: püsiva trahheostoomi korral kuni kolme Passy Muir™ kõne- ja neelamisklapi või kuni kuue Orator™ kõneklapi eest kalendripoolaastas; ajutise trahheostoomi korral ühe Passy Muir™ kõne- ja neelamisklapi või kuni kahe Orator™ kõneklapi eest kahe kuu jooksul.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_25 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 25",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_26_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_26"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajaliku nebulisaatori komplekti eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: 1 1) isikult, kes on invasiivsel kodusel ventilaatorravil ja vajab kaasuva haiguse raviks ravimi inhalatsioone, ühe seadme eest 12 kuu jooksul; 2 2) isikult, kes on invasiivsel kodusel ventilaatorravil ning vajab kaasuva haiguse raviks ravimi inhalatsioone ja ravi kriitilisuse tõttu ka varuseadet, kuni kahe seadme eest 12 kuu jooksul. Tervisekassa võtab kindlustatud isikule vajaliku nebulisaatori komplekti eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: isikult, kes on invasiivsel kodusel ventilaatorravil ja vajab kaasuva haiguse raviks ravimi inhalatsioone, ühe seadme eest 12 kuu jooksul; isikult, kes on invasiivsel kodusel ventilaatorravil ning vajab kaasuva haiguse raviks ravimi inhalatsioone ja ravi kriitilisuse tõttu ka varuseadet, kuni kahe seadme eest 12 kuu jooksul.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_26 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 26",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_27_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_27"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab nebulisaatorite eest tasu maksmise kohustuse üle kindlustatud isikult, kes on invasiivsel kodusel ventilaatorravil ja vajab kaasuva haiguse raviks ravimi inhalatsioone, kuni 13 nebulisaatori eest kalendriaastas. Tervisekassa võtab nebulisaatorite eest tasu maksmise kohustuse üle kindlustatud isikult, kes on invasiivsel kodusel ventilaatorravil ja vajab kaasuva haiguse raviks ravimi inhalatsioone, kuni 13 nebulisaatori eest kalendriaastas.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_27 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 27",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_28_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_28"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab aspiratsioonisondide eest tasu maksmise kohustuse üle kuni 3600 aspiratsioonisondi eest kalendripoolaastas ühe kindlustatud isiku kohta, kes viibib kodusel ventilatsiooniravil või kellel on trahheostoom, neuroloogilisest kahjustusest tingitud neelamishäire või neuromuskulaarsest haigusest tingitud köharefleksi puudumine. Tervisekassa võtab aspiratsioonisondide eest tasu maksmise kohustuse üle kuni 3600 aspiratsioonisondi eest kalendripoolaastas ühe kindlustatud isiku kohta, kes viibib kodusel ventilatsiooniravil või kellel on trahheostoom, neuroloogilisest kahjustusest tingitud neelamishäire või neuromuskulaarsest haigusest tingitud köharefleksi puudumine.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_28 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 28",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_29_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_29"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajaliku tallatoe eest tasu maksmise kohustuse üle järgmises ulatuses: 1 1) üks paar tallatugesid üks kord kuue kuu jooksul pärast operatsiooni või traumat lülisambal või alajäsemel kaasuva valusündroomiga nimetatud piirkonnas; 2 2) kaks paari tallatugesid kalendriaastas kahe kalendriaasta jooksul patsiendile, kellel esineb vaagnapiirkonna (RFK järgi s740) või alajäseme (s750) raske struktuurikahjustus või sellest tulenevad liigeste, luude või lihaste funktsioonihäired (b710–749) ja kaasuvana valu igapäevasel liikumisel või haavandid ning masstoodangu tallatoed ei ole patsiendile näidustatud või on osutunud ebaefektiivseks. Tervisekassa võtab kindlustatud isikule vajaliku tallatoe eest tasu maksmise kohustuse üle järgmises ulatuses: üks paar tallatugesid üks kord kuue kuu jooksul pärast operatsiooni või traumat lülisambal või alajäsemel kaasuva valusündroomiga nimetatud piirkonnas; kaks paari tallatugesid kalendriaastas kahe kalendriaasta jooksul patsiendile, kellel esineb vaagnapiirkonna (RFK järgi s740) või alajäseme (s750) raske struktuurikahjustus või sellest tulenevad liigeste, luude või lihaste funktsioonihäired (b710–749) ja kaasuvana valu igapäevasel liikumisel või haavandid ning masstoodangu tallatoed ei ole patsiendile näidustatud või on osutunud ebaefektiivseks.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_29 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 29",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_3_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvides 4–634 nimetatud meditsiiniseadmete puhul on kindlustatud isiku omaosaluse määr ostetava meditsiiniseadme piirhinna ja Tervisekassa poolt ülevõetava tasu maksmise kohustuse summa vahe. Kui ostetava meditsiiniseadme jaemüügihind on alla piirhinna, on kindlustatud isiku omaosaluse määr jaemüügihinna ja Tervisekassa poolt ülevõetava tasu maksmise kohustuse summa vahe. RT I 2024-06-18 3 118062024003 2024-07-01 Paragrahvides 4–634 nimetatud meditsiiniseadmete puhul on kindlustatud isiku omaosaluse määr ostetava meditsiiniseadme piirhinna ja Tervisekassa poolt ülevõetava tasu maksmise kohustuse summa vahe. Kui ostetava meditsiiniseadme jaemüügihind on alla piirhinna, on kindlustatud isiku omaosaluse määr jaemüügihinna ja Tervisekassa poolt ülevõetava tasu maksmise kohustuse summa vahe.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_3 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_30_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_30"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajaliku randme-kämblaortoosi eest tasu maksmise kohustuse üle järgmises ulatuses: 1 1) ühe ortoosi eest jäseme kohta kuue kuu jooksul funktsioonihäire kompenseerimiseks pärast operatsiooni või traumat; 2 2) alla 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta ühe aasta jooksul; 3 3) vähemalt 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta kahe aasta jooksul. Tervisekassa võtab kindlustatud isikule vajaliku randme-kämblaortoosi eest tasu maksmise kohustuse üle järgmises ulatuses: ühe ortoosi eest jäseme kohta kuue kuu jooksul funktsioonihäire kompenseerimiseks pärast operatsiooni või traumat; alla 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta ühe aasta jooksul; vähemalt 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta kahe aasta jooksul.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_30 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 30",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_31_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_31"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajaliku õla- ja küünarliigese ortoosi eest tasu maksmise kohustuse üle järgmises ulatuses: 1 1) ühe ortoosi eest jäseme kohta kuue kuu jooksul funktsioonihäire kompenseerimiseks pärast operatsiooni või traumat; 2 2) alla 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta ühe aasta jooksul; 3 3) vähemalt 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta kahe aasta jooksul. Tervisekassa võtab kindlustatud isikule vajaliku õla- ja küünarliigese ortoosi eest tasu maksmise kohustuse üle järgmises ulatuses: ühe ortoosi eest jäseme kohta kuue kuu jooksul funktsioonihäire kompenseerimiseks pärast operatsiooni või traumat; alla 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta ühe aasta jooksul; vähemalt 19-aastasele patsiendile ägeda haigestumise või raske kroonilise haigusega kaasneva funktsioonihäire kompenseerimiseks, ühe ortoosi eest jäseme kohta kahe aasta jooksul.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_31 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 31",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_32_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_32"
      },
      "estleg:versionValidFrom": {
