    {
      "@id": "estleg:Reg_1055346_Par_7_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab käesolevas paragrahvis nimetatud meditsiiniseadmete eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 200 stoomirõnga eest kalendripoolaastas iga stoomi või fistuli kohta. Tervisekassa võtab käesolevas paragrahvis nimetatud meditsiiniseadmete eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 200 stoomirõnga eest kalendripoolaastas iga stoomi või fistuli kohta.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_7 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_8_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kaheosalise stoomisüsteemi alusplaatide eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 125 alusplaadi eest kalendripoolaastas iga stoomi või fistuli kohta. Tervisekassa võtab kaheosalise stoomisüsteemi alusplaatide eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 125 alusplaadi eest kalendripoolaastas iga stoomi või fistuli kohta.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_8 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_9_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab stoomikottide või -katete eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, järgmises ulatuses: 1 1) kuni 730 koti või katte eest kalendripoolaastas ühe stoomi või fistuli korral; RT I 2025-12-16 4 116122025004 2026-01-01 2 2) kuni 1080 koti või katte eest kalendripoolaastas kahe stoomi või fistuli korral. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab stoomikottide või -katete eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, järgmises ulatuses: kuni 730 koti või katte eest kalendripoolaastas ühe stoomi või fistuli korral; kuni 1080 koti või katte eest kalendripoolaastas kahe stoomi või fistuli korral.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_9 (redaktsioon 1055346)",
        "@language": "et"
      },
