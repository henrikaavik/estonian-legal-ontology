      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_45_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajalike insuliinipumba infusioonivahendite eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: 1 1) insuliinipumba ravi saavalt alla 19-aastaselt kindlustatud isikult kuni 60 Medtronic Extended, 120 Quick-Set, 120 Silhouette, 120 Mio või kuni 180 Sure-T infusioonivahendi eest kalendriaastas; 2 2) insuliinipumba ravi saavalt 19–25-aastaselt kindlustatud isikult, kes vastab § 44 punktis 3 sätestatud tingimustele, kuni 30 Medtronic Extended, kuni 60 Quick-Set, 60 Silhouette ja 60 Mio infusioonivahendi või kuni 90 Sure-T infusioonivahendi eest kalendripoolaastas. Infusioonivahendite väljakirjutamise õigus on endokrinoloogil; 3 3) insuliinipumba ravi saavalt vähemalt 26-aastaselt kindlustatud isikult, kes vastab § 44 punktis 4 sätestatud tingimustele, kuni 30 Medtronic Extended, 60 Quick-Set, 60 Silhouette ja 60 Mio infusioonivahendi või kuni 90 Sure-T infusioonivahendi eest kalendripoolaastas. Infusioonivahendite väljakirjutamise õigus on endokrinoloogil; 4 4) insuliinipumba ravi saavalt vähemalt 26-aastaselt kindlustatud isikult, kes vastab § 44 punktis 5 sätestatud tingimustele, kuni 30 Medtronic Extended, 60 Quick-Set, 60 Silhouette ja 60 Mio infusioonivahendi või kuni 90 Sure-T infusioonivahendi eest kalendripoolaastas. Infusioonivahendite väljakirjutamise õigus on endokrinoloogil. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab kindlustatud isikule vajalike insuliinipumba infusioonivahendite eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: insuliinipumba ravi saavalt alla 19-aastaselt kindlustatud isikult kuni 60 Medtronic Extended, 120 Quick-Set, 120 Silhouette, 120 Mio või kuni 180 Sure-T infusioonivahendi eest kalendriaastas; insuliinipumba ravi saavalt 19–25-aastaselt kindlustatud isikult, kes vastab § 44 punktis 3 sätestatud tingimustele, kuni 30 Medtronic Extended, kuni 60 Quick-Set, 60 Silhouette ja 60 Mio infusioonivahendi või kuni 90 Sure-T infusioonivahendi eest kalendripoolaastas. Infusioonivahendite väljakirjutamise õigus on endokrinoloogil; insuliinipumba ravi saavalt vähemalt 26-aastaselt kindlustatud isikult, kes vastab § 44 punktis 4 sätestatud tingimustele, kuni 30 Medtronic Extended, 60 Quick-Set, 60 Silhouette ja 60 Mio infusioonivahendi või kuni 90 Sure-T infusioonivahendi eest kalendripoolaastas. Infusioonivahendite väljakirjutamise õigus on endokrinoloogil; insuliinipumba ravi saavalt vähemalt 26-aastaselt kindlustatud isikult, kes vastab § 44 punktis 5 sätestatud tingimustele, kuni 30 Medtronic Extended, 60 Quick-Set, 60 Silhouette ja 60 Mio infusioonivahendi või kuni 90 Sure-T infusioonivahendi eest kalendripoolaastas. Infusioonivahendite väljakirjutamise õigus on endokrinoloogil.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_45 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 45",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_46_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_46"
      },
