    {
      "@id": "estleg:Reg_1055346_Par_1_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Määrusega kehtestatakse Tervisekassa meditsiiniseadmete loetelu, mis on aluseks kindlustatud isikule müüdud meditsiiniseadmete eest tasu maksmise kohustuse ülevõtmisel Tervisekassa poolt, ja tasu maksmise kohustuse ülevõtmise kord. RT I 2023-05-23 1 123052023001 2023-05-26 Määrusega kehtestatakse Tervisekassa meditsiiniseadmete loetelu, mis on aluseks kindlustatud isikule müüdud meditsiiniseadmete eest tasu maksmise kohustuse ülevõtmisel Tervisekassa poolt, ja tasu maksmise kohustuse ülevõtmise kord. 2 (2) Meditsiiniseadmete loetelu on esitatud määruse lisas. Meditsiiniseadmete loetelu on esitatud määruse lisas. 3 (3) Tervisekassa võtab tasu maksmise kohustuse üle määruses kehtestatud tingimustel ja ulatuses. Tervisekassa võtab tasu maksmise kohustuse üle määruses kehtestatud tingimustel ja ulatuses.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_1 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_10_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab käesolevas paragrahvis nimetatud meditsiiniseadmete eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 28 meditsiiniseadme müügipakendi eest kalendripoolaastas iga stoomi või fistuli kohta. Meditsiiniseadme müügipakend, mis sisaldab meditsiiniseadmeid koguses 100, on võrdsustatud kahe pakendiga. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab käesolevas paragrahvis nimetatud meditsiiniseadmete eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 28 meditsiiniseadme müügipakendi eest kalendripoolaastas iga stoomi või fistuli kohta. Meditsiiniseadme müügipakend, mis sisaldab meditsiiniseadmeid koguses 100, on võrdsustatud kahe pakendiga.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_10 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 10",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_11_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab alkoholivaba stoomipasta eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul ja kes ei saa allergilise või põletikulise ja kahjustatud stoomiümbruse naha või nahalõhede tõttu kasutada alkoholi sisaldavat stoomipastat, kuni 13 pasta eest kalendripoolaastas iga stoomi või fistuli kohta. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab alkoholivaba stoomipasta eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul ja kes ei saa allergilise või põletikulise ja kahjustatud stoomiümbruse naha või nahalõhede tõttu kasutada alkoholi sisaldavat stoomipastat, kuni 13 pasta eest kalendripoolaastas iga stoomi või fistuli kohta.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_11 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_12_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab stoomikotivöö eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni kahe stoomikotivöö eest kalendripoolaastas iga stoomi või fistuli kohta. Tervisekassa võtab stoomikotivöö eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni kahe stoomikotivöö eest kalendripoolaastas iga stoomi või fistuli kohta.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_12 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_13_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab stoomi alusplaadi lisakinnituste eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 540 alusplaadi lisakinnituse eest kalendripoolaastas iga stoomi või fistuli kohta. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab stoomi alusplaadi lisakinnituste eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on kolostoom, ileostoom, urostoom või fistul, kuni 540 alusplaadi lisakinnituse eest kalendripoolaastas iga stoomi või fistuli kohta.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_13 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_14_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajalike uriinikogumiskottide eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: 1 1) urostoomiga patsiendilt kuni 50 uriinikogumiskoti eest kalendripoolaastas; 2 2) neuroloogilise, onkoloogilise, uroloogilise või günekoloogilise patoloogiaga patsiendilt, kellel esineb urineerimisfunktsiooni häire, kuni 90 uriinikogumiskoti eest kalendripoolaastas. Tervisekassa võtab kindlustatud isikule vajalike uriinikogumiskottide eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: urostoomiga patsiendilt kuni 50 uriinikogumiskoti eest kalendripoolaastas; neuroloogilise, onkoloogilise, uroloogilise või günekoloogilise patoloogiaga patsiendilt, kellel esineb urineerimisfunktsiooni häire, kuni 90 uriinikogumiskoti eest kalendripoolaastas.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_14 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_15_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab uriinikogumiskoti riputus- ja kinnitusvahendite eest tasu maksmise kohustuse üle neuroloogilise, onkoloogilise, uroloogilise või günekoloogilise patoloogiaga kindlustatud isikult, kellel esineb urineerimisfunktsiooni häire, kuni 12 riputus- ja kinnitusvahendi eest kalendripoolaastas. Tervisekassa võtab uriinikogumiskoti riputus- ja kinnitusvahendite eest tasu maksmise kohustuse üle neuroloogilise, onkoloogilise, uroloogilise või günekoloogilise patoloogiaga kindlustatud isikult, kellel esineb urineerimisfunktsiooni häire, kuni 12 riputus- ja kinnitusvahendi eest kalendripoolaastas.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_15 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_16_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab dušikaitsme eest tasu maksmise kohustuse üle ühe kaitsme eest kalendriaastas ühe kindlustatud isiku kohta, kellel on teostatud larüngektoomia. Tervisekassa võtab dušikaitsme eest tasu maksmise kohustuse üle ühe kaitsme eest kalendriaastas ühe kindlustatud isiku kohta, kellel on teostatud larüngektoomia.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_16 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_17_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_17"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kinnitusplaastrite eest tasu maksmise kohustuse üle kuni 180 plaastri eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on teostatud larüngektoomia. Tervisekassa võtab kinnitusplaastrite eest tasu maksmise kohustuse üle kuni 180 plaastri eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on teostatud larüngektoomia.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_17 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 17",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_18_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_18"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab filtrite eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on teostatud larüngektoomia, kuni 365 filtri eest kalendriaastas. Tervisekassa võtab filtrite eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on teostatud larüngektoomia, kuni 365 filtri eest kalendriaastas.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_18 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 18",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_19_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab liimieemaldusvahendite eest tasu maksmise kohustuse üle kuni 100 puhastuspadjakese või 100 salvräti või kahe sprei eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on teostatud larüngektoomia. Tervisekassa võtab liimieemaldusvahendite eest tasu maksmise kohustuse üle kuni 100 puhastuspadjakese või 100 salvräti või kahe sprei eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on teostatud larüngektoomia.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_19 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_2_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui meditsiiniseadmete loetelus on ühes meditsiiniseadme rühmas kaks võrreldavat meditsiiniseadet, on alates kolmandast meditsiiniseadmete loetellu kantud meditsiiniseadmest ravikindlustuse seaduse § 481 lõike 3 alusel Tervisekassa poolt tasu maksmise kohustuse ülevõtmise aluseks loetelus sisalduva piirhinnalt teise võrreldava meditsiiniseadme piirhind. Kui meditsiiniseadmete loetelus on ühes meditsiiniseadme rühmas kaks võrreldavat meditsiiniseadet, on alates kolmandast meditsiiniseadmete loetellu kantud meditsiiniseadmest ravikindlustuse seaduse § 481 lõike 3 alusel Tervisekassa poolt tasu maksmise kohustuse ülevõtmise aluseks loetelus sisalduva piirhinnalt teise võrreldava meditsiiniseadme piirhind.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_2 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_20_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab trahheostoomi plaastrite eest tasu maksmise kohustuse üle kuni 180 trahheostoomi plaastri eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on trahheostoom. Tervisekassa võtab trahheostoomi plaastrite eest tasu maksmise kohustuse üle kuni 180 trahheostoomi plaastri eest kalendripoolaastas ühe kindlustatud isiku kohta, kellel on trahheostoom.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_20 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_21_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab trahheostoomi filtrite eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on trahheostoom, kuni 730 filtri eest kalendriaastas. Tervisekassa võtab trahheostoomi filtrite eest tasu maksmise kohustuse üle kindlustatud isikult, kellel on trahheostoom, kuni 730 filtri eest kalendriaastas.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_21 (redaktsioon 1055346)",
        "@language": "et"
      },
