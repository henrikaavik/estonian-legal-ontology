    },
    {
      "@id": "estleg:Reg_1055346_Par_49_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_49"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab hooldusvahendite eest tasu maksmise kohustuse üle kuni 100 padjakese või 100 salvräti või kahe sprei eest kalendripoolaastas ühe alla 19-aastase insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) patsiendi kohta, kes on pump- või sensorravil. Tervisekassa võtab hooldusvahendite eest tasu maksmise kohustuse üle kuni 100 padjakese või 100 salvräti või kahe sprei eest kalendripoolaastas ühe alla 19-aastase insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) patsiendi kohta, kes on pump- või sensorravil.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_49 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 49",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_5_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajalike käesolevas paragrahvis nimetatud meditsiiniseadmete eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: 1 1) alla 19-aastasele diabeedihaigele kuni 700 nõela eest kalendripoolaastas; 2 2) I tüübi diabeedi haigele kuni 700 nõela eest kalendripoolaastas; 3 3) rasedusdiabeediga haigele, kes saab raviks insuliinisüste, kuni 700 nõela eest kalendripoolaastas; 4 4) II tüübi diabeedi haigele, kes saab raviks süstitavaid diabeediravimeid, kuni 700 nõela eest kalendripoolaastas; 5 5) muu täpsustatud diabeedi (RHK 10 diagnoosikood E13) haigele kuni 350 nõela eest kalendripoolaastas; 6 6) Parkinsoni tõvega patsiendile, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu apomorfiini süsteravi, kuni 730 10 mm ja/või 12 mm pikkuse nõela eest kalendripoolaastas; 7 7) kasvuhäirega patsiendile, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu kasvuhormooni sisaldavaid ravimeid, kuni 200 nõela eest kalendripoolaastas; 8 8) osteoporoosiga patsiendile, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu teriparatiidi süsteravi, kuni 200 nõela eest kalendripoolaastas kahe kalendriaasta jooksul. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab kindlustatud isikule vajalike käesolevas paragrahvis nimetatud meditsiiniseadmete eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: alla 19-aastasele diabeedihaigele kuni 700 nõela eest kalendripoolaastas; I tüübi diabeedi haigele kuni 700 nõela eest kalendripoolaastas; rasedusdiabeediga haigele, kes saab raviks insuliinisüste, kuni 700 nõela eest kalendripoolaastas; II tüübi diabeedi haigele, kes saab raviks süstitavaid diabeediravimeid, kuni 700 nõela eest kalendripoolaastas; muu täpsustatud diabeedi (RHK 10 diagnoosikood E13) haigele kuni 350 nõela eest kalendripoolaastas; Parkinsoni tõvega patsiendile, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu apomorfiini süsteravi, kuni 730 10 mm ja/või 12 mm pikkuse nõela eest kalendripoolaastas; kasvuhäirega patsiendile, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu kasvuhormooni sisaldavaid ravimeid, kuni 200 nõela eest kalendripoolaastas; osteoporoosiga patsiendile, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu teriparatiidi süsteravi, kuni 200 nõela eest kalendripoolaastas kahe kalendriaasta jooksul.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_5 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_50_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_50"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab korduvkasutatava insuliini süstevahendi eest tasu maksmise kohustuse üle insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) kindlustatud isikult, kes kasutab raviks kolbampullis lühitoimelist insuliini, üks kord kolme aasta jooksul. Tervisekassa võtab korduvkasutatava insuliini süstevahendi eest tasu maksmise kohustuse üle insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) kindlustatud isikult, kes kasutab raviks kolbampullis lühitoimelist insuliini, üks kord kolme aasta jooksul.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_50 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 50",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_51_v1055346",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1055346_Par_51"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tervisekassa võtab kindlustatud isikule vajalike vere β-ketooni testiribade eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: 1 1) alla 19-aastaselt insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) patsiendilt kuni 50 testiriba eest kalendriaastas; 2 2) insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) patsiendilt, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu SGLT-2 inhibiitoreid, kuni 50 testiriba eest kalendriaastas. RT I 2025-12-16 4 116122025004 2026-01-01 Tervisekassa võtab kindlustatud isikule vajalike vere β-ketooni testiribade eest tasu maksmise kohustuse üle järgmistel juhtudel järgmises ulatuses: alla 19-aastaselt insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) patsiendilt kuni 50 testiriba eest kalendriaastas; insuliinsõltuva suhkurtõvega (RHK 10 diagnoosikood E10) patsiendilt, kellele Tervisekassa hüvitab soodusravimite loetelu kaudu SGLT-2 inhibiitoreid, kuni 50 testiriba eest kalendriaastas.",
      "rdfs:label": {
        "@value": "Reg_1055346_Par_51 (redaktsioon 1055346)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1055346",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1055346",
      "estleg:sourceAct": "Tervisekassa meditsiiniseadmete loetelu",
      "estleg:provisionRef": "Reg_1055346 § 51",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055346_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1055346_Par_52_v1055346",
