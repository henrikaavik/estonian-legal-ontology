    {
      "@id": "estleg:rahapesu_ning_kriminaaltulu_avastamise_a_Par_2_v211062022001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:rahapesu_ning_kriminaaltulu_avastamise_a_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teatada kooskõlas konventsiooni artikli 46 lõikega 13, et Eesti Vabariigis on rahapesu andmebürooks konventsiooni mõistes Rahandusministeeriumi valitsemisalasse kuuluv valitsusasutus Rahapesu Andmebüroo.",
      "rdfs:label": {
        "@value": "rahapesu_ning_kriminaaltulu_avastamise_a_Par_2 (redaktsioon 211062022001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "211062022001",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/211062022001",
      "estleg:sourceAct": "Rahapesu ning kriminaaltulu avastamise, arestimise ja konfiskeerimise ning terrorismi rahastamist käsitleva Euroopa Nõukogu konventsiooni ratifitseerimise seadus",
      "estleg:provisionRef": "rahapesu_ning_kriminaaltulu_avastamise_a § 2",
      "estleg:partOfAct": {
        "@id": "estleg:rahapesu_ning_kriminaaltulu_avastamise_a_Map_2026"
      }
    },
    {
      "@id": "estleg:rahapesu_ning_kriminaaltulu_avastamise_a_Par_3_v211062022001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:rahapesu_ning_kriminaaltulu_avastamise_a_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-06-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ratifitseerimisel esitada konventsiooni artikli 53 lõigete 1, 3 ja 4 kohaselt järgmised deklaratsioonid: kooskõlas konventsiooni artikli 3 lõikega 4 deklareerib Eesti Vabariik, et konventsiooni nimetatud sätet rakendatakse vaid riigisiseses seaduses konkreetselt nimetatud kuritegude puhul; kooskõlas konventsiooni artikliga 19 deklareerib Eesti Vabariik, et lõike 3 alusel jälgitakse kontosid Eesti õiguses sätestatud elektroonilise arestimissüsteemi kaudu, kogudes informatsiooni kontol toimunud tehingute kohta nädalase viitega, ja lõike 5 alusel laiendatakse sätet üksnes neile finantsasutustele, kes avavad klientidele IBAN-koodiga maksekontosid; kooskõlas konventsiooni artikli 24 lõikega 3 deklareerib Eesti Vabariik, et kohaldab artikli 24 lõiget 2 üksnes oma põhiseadust ja oma õigussüsteemi põhimõtteid järgides; konventsiooni artikli 31 lõike 2 alusel deklareerib Eesti Vabariik, et kohtudokumendid toimetatakse kätte Justiitsministeeriumi kaudu; konventsiooni artikli 33 lõike 1 alusel deklareerib Eesti Vabariik, et keskasutus on Justiitsministeerium; konventsiooni artikli 35 lõike 3 alusel deklareerib Eesti Vabariik, et Eesti asutustele esitatakse taotlused ja nende lisad koos ingliskeelse tõlkega; konventsiooni artikli 42 lõike 2 alusel deklareerib Eesti Vabariik, et taotluse alusel antud informatsiooni või tõendeid ei või taotluse esitanud asutused kasutada ega edastada taotluse saanud konventsiooniosalise nõusolekuta muuks kui taotluses nimetatud kriminaalmenetluseks.",
      "rdfs:label": {
        "@value": "rahapesu_ning_kriminaaltulu_avastamise_a_Par_3 (redaktsioon 211062022001)",
        "@language": "et"
      },
