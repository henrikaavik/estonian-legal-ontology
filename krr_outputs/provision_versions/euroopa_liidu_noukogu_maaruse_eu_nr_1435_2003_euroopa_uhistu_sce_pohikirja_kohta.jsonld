      "estleg:provisionRef": "SCEPS § 7",
      "estleg:partOfAct": {
        "@id": "estleg:SCEPS_Map"
      }
    },
    {
      "@id": "estleg:SCEPS_Par_7_v125102012007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
