      }
    },
    {
      "@id": "estleg:SCEPS_Par_8_v972385",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SCEPS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse artiklis 24 nimetatud andmed ühinevate äriühingute kohta avaldatakse väljaandes Ametlikud Teadaanded koos äriseadustiku § 399 kohase teatega ühinemise kohta.",
      "rdfs:label": {
        "@value": "SCEPS_Par_8 (redaktsioon 972385)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "972385",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/972385",
      "estleg:sourceAct": "Euroopa Liidu Nõukogu määruse (EÜ) nr 1435/2003 «Euroopa ühistu (SCE) põhikirja kohta» rakendamise seadus",
      "estleg:provisionRef": "SCEPS § 8",
      "estleg:partOfAct": {
        "@id": "estleg:SCEPS_Map"
      }
    },
    {
      "@id": "estleg:SCEPS_Par_9_v972385",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:SCEPS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-18",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Vähemalt üks kuu enne tulundusühistu SCE-ks ümberkujundamist otsustavat üldkoosolekut esitab juhatus äriregistri pidajale ümberkujundamiskava ning avaldab väljaandes Ametlikud Teadaanded teate ümberkujundamiskava koostamise kohta. Teates tuleb märkida, et ümberkujundamiskavaga on võimalik tutvuda registriosakonnas ja juhatuse määratud kohas.",
      "rdfs:label": {
        "@value": "SCEPS_Par_9 (redaktsioon 972385)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "972385",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/972385",
      "estleg:sourceAct": "Euroopa Liidu Nõukogu määruse (EÜ) nr 1435/2003 «Euroopa ühistu (SCE) põhikirja kohta» rakendamise seadus",
      "estleg:provisionRef": "SCEPS § 9",
      "estleg:partOfAct": {
        "@id": "estleg:SCEPS_Map"
      }
    }
  ]
