  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_sekkumis_ja_tegutsemistasemed_ning_avariikutsekiirituse_viit_t1035864_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Sekkumis- ja tegutsemistasemed ning avariikutsekiirituse viitetase kiirgushädaolukorras (5 versiooni)",
        "@language": "et"
      },
      "dc:source": "Sekkumis- ja tegutsemistasemed ning avariikutsekiirituse viitetase kiirgushädaolukorras"
    },
    {
      "@id": "estleg:Reg_1035864_Par_1_v1035864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035864_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Sekkumistasemel 10 millisiivertit tuleb kaaluda kiirgusdoosi ärahoidmiseks varjumist, s.o inimeste püsimist ehitises kuni kaks päeva, et nõrgendada radioaktiivsest pilvest või maapinnale sadenenud radioaktiivsest ainest põhjustatud kiiritust. Sekkumistasemel 10 millisiivertit tuleb kaaluda kiirgusdoosi ärahoidmiseks varjumist, s.o inimeste püsimist ehitises kuni kaks päeva, et nõrgendada radioaktiivsest pilvest või maapinnale sadenenud radioaktiivsest ainest põhjustatud kiiritust. 2 (2) Sekkumistasemel 50 millisiivertit tuleb kaaluda kiirgusdoosi ärahoidmiseks evakueerimist, s.o inimeste kiiret eemaldamist kuni üheks nädalaks kiirgusohtlikust piirkonnast. Sekkumistasemel 50 millisiivertit tuleb kaaluda kiirgusdoosi ärahoidmiseks evakueerimist, s.o inimeste kiiret eemaldamist kuni üheks nädalaks kiirgusohtlikust piirkonnast. 3 (3) Sekkumistasemel 10 milligreid lastel, 100 milligreid täiskasvanutel ja 1 grei üle 50-aastastel tuleb kaaluda kiirgusdoosi ärahoidmiseks kaitsemeetmena joodiprofülaktikat, s.o kilpnäärme küllastamist stabiilse joodiga, et vältida kilpnäärmesse radioaktiivse joodi kogunemist. Sekkumistasemel 10 milligreid lastel, 100 milligreid täiskasvanutel ja 1 grei üle 50-aastastel tuleb kaaluda kiirgusdoosi ärahoidmiseks kaitsemeetmena joodiprofülaktikat, s.o kilpnäärme küllastamist stabiilse joodiga, et vältida kilpnäärmesse radioaktiivse joodi kogunemist.",
      "rdfs:label": {
        "@value": "Reg_1035864_Par_1 (redaktsioon 1035864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035864",
      "estleg:sourceAct": "Sekkumis- ja tegutsemistasemed ning avariikutsekiirituse viitetase kiirgushädaolukorras",
      "estleg:provisionRef": "Reg_1035864 § 1",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035864_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035864_Par_2_v1035864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035864_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Ümberpaigutamist, s.o inimeste radioaktiivselt saastunud maa-alalt äraviimist kuni üheks aastaks, tuleb kaaluda juhul, kui eemaloleku esimese 30 päeva jooksul välditakse rohkem kui 30millisiivertist efektiivdoosi. Ümberpaigutamist, s.o inimeste radioaktiivselt saastunud maa-alalt äraviimist kuni üheks aastaks, tuleb kaaluda juhul, kui eemaloleku esimese 30 päeva jooksul välditakse rohkem kui 30millisiivertist efektiivdoosi. 2 (2) Ümberasustamist, s.o elanike alalist ümberpaigutamist, tuleb kaaluda juhul, kui ümberasustamata jätmisel ületaks elaniku efektiivdoos elu jooksul 1 siiverti. Ümberasustamist, s.o elanike alalist ümberpaigutamist, tuleb kaaluda juhul, kui ümberasustamata jätmisel ületaks elaniku efektiivdoos elu jooksul 1 siiverti. 3 (3) Lõikes 1 sätestatud kaitsemeetme rakendamine lõpetatakse, kui tagasipöördumisele järgneva 30 päeva jooksul ei ületa elaniku saadav efektiivdoos 10 millisiivertit ja elu jooksul saadav efektiivdoos ei ületa 1 siivertit. Lõikes 1 sätestatud kaitsemeetme rakendamine lõpetatakse, kui tagasipöördumisele järgneva 30 päeva jooksul ei ületa elaniku saadav efektiivdoos 10 millisiivertit ja elu jooksul saadav efektiivdoos ei ületa 1 siivertit.",
      "rdfs:label": {
        "@value": "Reg_1035864_Par_2 (redaktsioon 1035864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035864",
      "estleg:sourceAct": "Sekkumis- ja tegutsemistasemed ning avariikutsekiirituse viitetase kiirgushädaolukorras",
      "estleg:provisionRef": "Reg_1035864 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035864_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035864_Par_3_v1035864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035864_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toidu ja sööda radioaktiivse saastatuse tegutsemistasemed on sätestatud nõukogu määruse (Euratom) 2016/52, millega kehtestatakse toidu ja sööda radioaktiivse saastatuse lubatud piirmäärad tuumaavarii või muu kiirgusliku avariiolukorra puhul ning tunnistatakse kehtetuks määrus (Euratom) nr 3954/87 ja komisjoni määrused (Euratom) nr 944/89 ja (Euratom) nr 770/90, I–III lisas. Toidu ja sööda radioaktiivse saastatuse tegutsemistasemed on sätestatud nõukogu määruse (Euratom) 2016/52, millega kehtestatakse toidu ja sööda radioaktiivse saastatuse lubatud piirmäärad tuumaavarii või muu kiirgusliku avariiolukorra puhul ning tunnistatakse kehtetuks määrus (Euratom) nr 3954/87 ja komisjoni määrused (Euratom) nr 944/89 ja (Euratom) nr 770/90, I–III lisas.",
      "rdfs:label": {
        "@value": "Reg_1035864_Par_3 (redaktsioon 1035864)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1035864",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1035864",
      "estleg:sourceAct": "Sekkumis- ja tegutsemistasemed ning avariikutsekiirituse viitetase kiirgushädaolukorras",
      "estleg:provisionRef": "Reg_1035864 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035864_Map"
      }
    },
    {
      "@id": "estleg:Reg_1035864_Par_4_v1035864",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1035864_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-07-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Avariitöötaja ühe aasta jooksul saadud avariikutsekiirituse efektiivdoosi viitetase on 100 millisiivertit. RT I 2018-07-31 5 131072018005 2018-08-03 Avariitöötaja ühe aasta jooksul saadud avariikutsekiirituse efektiivdoosi viitetase on 100 millisiivertit. 2 (2) Lõikes 1 nimetatud viitetaset võib erandkorras ületada juhul, kui on vaja päästa elusid, ära hoida tõsiseid kiirgusest põhjustatud tervisemõjusid või takistada katastroofi väljakujunemist hädaolukorra seaduse tähenduses, eeldusel, et avariitöötaja ühe aasta jooksul saadud avariikutsekiirituse efektiivdoos väliskiiritusest ei ületa 500 millisiivertit. RT I 2018-07-31 5 131072018005 2018-08-03 Lõikes 1 nimetatud viitetaset võib erandkorras ületada juhul, kui on vaja päästa elusid, ära hoida tõsiseid kiirgusest põhjustatud tervisemõjusid või takistada katastroofi väljakujunemist hädaolukorra seaduse tähenduses, eeldusel, et avariitöötaja ühe aasta jooksul saadud avariikutsekiirituse efektiivdoos väliskiiritusest ei ületa 500 millisiivertit. 3 (3) Avariitöötajat tuleb informeerida olemasolevatest kaitsemeetmetest ja sellest, et sekkumises osalemine toimub vabatahtlikkuse alusel. RT I 2018-07-31 5 131072018005 2018-08-03 Avariitöötajat tuleb informeerida olemasolevatest kaitsemeetmetest ja sellest, et sekkumises osalemine toimub vabatahtlikkuse alusel. 4 (4) Lõikes 2 nimetatud juhtudel tuleb avariitöötajat täiendavalt informeerida võimalikest terviseriskidest. RT I 2018-07-31 5 131072018005 2018-08-03 Lõikes 2 nimetatud juhtudel tuleb avariitöötajat täiendavalt informeerida võimalikest terviseriskidest.",
      "rdfs:label": {
        "@value": "Reg_1035864_Par_4 (redaktsioon 1035864)",
        "@language": "et"
      },
