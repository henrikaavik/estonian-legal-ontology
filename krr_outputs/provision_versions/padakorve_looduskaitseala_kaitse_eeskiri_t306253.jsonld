    {
      "@id": "estleg:Reg_306253_Par_13_v306253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306253_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on lubatud: 1 1) majandustegevus; 2 2) tootmisotstarbeta ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 4–7 sätestatut; 3 3) kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas on lubatud kaitseala valitseja nõusolekul. Piiranguvööndis on lubatud: majandustegevus; tootmisotstarbeta ehitiste, kaasa arvatud ajutiste ehitiste püstitamine, arvestades käesoleva määruse § 5 punktides 4–7 sätestatut; kuni 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas. Rohkem kui 50 osalejaga rahvaürituse korraldamine selleks ettevalmistamata ja kaitseala valitseja poolt tähistamata kohas on lubatud kaitseala valitseja nõusolekul.",
      "rdfs:label": {
        "@value": "Reg_306253_Par_13 (redaktsioon 306253)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "306253",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/306253",
      "estleg:sourceAct": "Padakõrve looduskaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_306253 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_306253_Map"
      }
    },
    {
      "@id": "estleg:Reg_306253_Par_14_v306253",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_306253_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud: 1 1) puhtpuistute kujundamine ja energiapuistute rajamine; 2 2) maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; 3 3) veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; 4 4) uue maaparandussüsteemi rajamine; 5 5) biotsiidi ja taimekaitsevahendi kasutamine; 6 6) uuendusraie, välja arvatud turberaie (säilitada tuleb koosluse liikide ja vanuse mitmekesisus) ning metskonna kvartalites VA018, VA032, VA038 ja VA045 lageraie langi pindalaga kuni 2 ha; 7 7) puidu kokku- ja väljavedu külmumata pinnasel. Piiranguvööndis on keelatud: puhtpuistute kujundamine ja energiapuistute rajamine; maavara kaevandamine, välja arvatud «Maapõueseaduse» § 59 lõikes 2 sätestatud juhul kaitseala valitsejaga kooskõlastatud kohtades; veekogude veetaseme ja kaldajoone muutmine ning uute veekogude rajamine; uue maaparandussüsteemi rajamine; biotsiidi ja taimekaitsevahendi kasutamine; uuendusraie, välja arvatud turberaie (säilitada tuleb koosluse liikide ja vanuse mitmekesisus) ning metskonna kvartalites VA018, VA032, VA038 ja VA045 lageraie langi pindalaga kuni 2 ha; puidu kokku- ja väljavedu külmumata pinnasel.",
      "rdfs:label": {
        "@value": "Reg_306253_Par_14 (redaktsioon 306253)",
        "@language": "et"
      },
