        "@value": "2024-08-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseväe juhataja lipp on sinise ja valgega püstjaotatud kahe lipukeelega lipuväli, millel on väikese riigivapi kujutis ja kollane servis. Lipu laiuse ja pikkuse suhe on 7:11, normaalsuurus 105 × 165 cm. Lipu etalonkujutis on esitatud määruse lisas 2. Kaitseväe juhataja lipp on sinise ja valgega püstjaotatud kahe lipukeelega lipuväli, millel on väikese riigivapi kujutis ja kollane servis. Lipu laiuse ja pikkuse suhe on 7:11, normaalsuurus 105 × 165 cm. Lipu etalonkujutis on esitatud määruse lisas 2.",
      "rdfs:label": {
        "@value": "Reg_1044914_Par_4 (redaktsioon 1044914)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044914",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044914",
      "estleg:sourceAct": "Kaitseväe sümbolite kirjeldus ja kasutamise kord",
      "estleg:provisionRef": "Reg_1044914 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044914_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044914_Par_5_v1044914",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
