        "@value": "2024-08-12",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maaväe vappi võib kasutada kujunduselemendina: 1 1) maaväe vormiriietusel; 2 2) maaväe teenete- ja rinnamärkidel; 3 3) maaväe lipul; 4 4) maaväe väljaantavatel trükistel ja meenetel; 5 5) muudel esemetel Kaitseväe juhataja või tema volitatud isiku kirjalikul nõusolekul. Maaväe vappi võib kasutada kujunduselemendina: maaväe vormiriietusel; maaväe teenete- ja rinnamärkidel; maaväe lipul; maaväe väljaantavatel trükistel ja meenetel; muudel esemetel Kaitseväe juhataja või tema volitatud isiku kirjalikul nõusolekul.",
      "rdfs:label": {
        "@value": "Reg_1044914_Par_11 (redaktsioon 1044914)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044914",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044914",
      "estleg:sourceAct": "Kaitseväe sümbolite kirjeldus ja kasutamise kord",
      "estleg:provisionRef": "Reg_1044914 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044914_Map_2026"
      }
