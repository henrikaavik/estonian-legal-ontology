    },
    {
      "@id": "estleg:Reg_345013_Par_83_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_83"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusregister koosneb registriosadest, mis avatakse iga kinnistu (kinnisasi, hoonestusõigus, korteriomand, korterihoonestusõigus) kohta kinnistusraamatusse kandmisel. Kinnistusregister koosneb registriosadest, mis avatakse iga kinnistu (kinnisasi, hoonestusõigus, korteriomand, korterihoonestusõigus) kohta kinnistusraamatusse kandmisel.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_83 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 83",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_84_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_84"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Iga registriosa saab avamisel iseseisva numbri (kinnistu number), mis antakse avatavale registriosale infosüsteemi poolt automaatselt. Iga registriosa saab avamisel iseseisva numbri (kinnistu number), mis antakse avatavale registriosale infosüsteemi poolt automaatselt. 2 (2) Registriosa avamisel antakse registriosale kinnistusregistri järgmine vaba number. Registriosa avamisel antakse registriosale kinnistusregistri järgmine vaba number. 3 (3) Registriosa avamise järjekorranumbrile lisatakse kahekohaline tähis. Registriosa avamise järjekorranumber ja sellele lisatud kahekohaline tähismoodustavad unikaalse ja muutumatu registriosa numbri (kinnistu numbri). RT I 2014-12-11 1 111122014001 2015-01-01 Registriosa avamise järjekorranumbrile lisatakse kahekohaline tähis. Registriosa avamise järjekorranumber ja sellele lisatud kahekohaline tähismoodustavad unikaalse ja muutumatu registriosa numbri (kinnistu numbri). 4 (4) Kehtetu - RT I 2014-12-11 1 111122014001 2015-01-01 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_345013_Par_84 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
