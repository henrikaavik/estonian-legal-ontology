        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrus reguleerib Tartu Maakohtu kinnistusosakonna töökorraldust ning kinnistusraamatu ja laevakinnistusraamatu pidamist. RT I 2017-12-23 1 123122017001 2018-03-01 Määrus reguleerib Tartu Maakohtu kinnistusosakonna töökorraldust ning kinnistusraamatu ja laevakinnistusraamatu pidamist.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_1_1 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 1_1",
