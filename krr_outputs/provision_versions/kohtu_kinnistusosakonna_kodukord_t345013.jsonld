      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusosakond on kohustatud kontrollima andmeid rahvastikuregistrist ja kohtute registriosakonna keskandmebaasist. Kinnistusosakond on kohustatud kontrollima andmeid rahvastikuregistrist ja kohtute registriosakonna keskandmebaasist.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_176 (redaktsioon 345013)",
        "@language": "et"
      },
