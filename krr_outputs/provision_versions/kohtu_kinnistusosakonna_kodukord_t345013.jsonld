    {
      "@id": "estleg:Reg_345013_Par_11_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtunikuabi täidab järgmisi ülesandeid: 1 1) teeb seadusega määratud ulatuses kandemäärusi ning kinnistusraamatu ja laevakinnistusraamatu kandeid; RT I 2017-12-23 1 123122017001 2018-03-01 2 2) vaatab seadusega sätestatud juhtudel läbi määruskaebuse; 3 3) annab rahuldamata jäetud määruskaebuse läbivaatamiseks kohtunikule; 4 4) kinnitab ärakirjade, väljavõtete ja väljatrükkide õigsust; 5 5) otsustab registriosa ümberkirjutamise või sulgemise; RT I 2017-12-23 1 123122017001 2018-03-01 6 6) koostab kinnistusraamatuseaduse § 51 alusel riigilõivu tagastamise määrusi; RT I 2012-12-29 22 129122012022 2013-01-01 7 7) tuvastab kinnistusraamatu veebilehe kaudu saabunud toimikuga tutvumise taotluse õigustatud huvi olemasolu ja koostab selle puudumise korral tsiviilkohtumenetluse seadustiku § 59 alusel kinnistustoimikuga tutvumiseks loa andmiseks keeldumise määrusi; RT I 2017-06-05 1 105062017001 2017-07-01 8 8) juhendab kohtunikuabi ettevalmistuskava täitjaid ning kinnistusosakonna juhataja määramisel notarikandidaate, üliõpilastest praktikante, kinnistussekretäre ja kinnistusosakonna teisi töötajaid ning juhendajana vaatab läbi ja kinnitab juhendatava tehtud lahendite projekte; RT I 2015-12-10 6 110122015010 2016-01-01 8 8¹) kehtetu - RT I 2017-06-05 1 105062017001 2017-07-01 9 9) kohaldab rahvusvahelise sanktsiooni seaduses nimetatud rahvusvahelist finantssanktsiooni. RT I 2019-01-11 3 111012019003 2019-01-14 Kohtunikuabi täidab järgmisi ülesandeid: teeb seadusega määratud ulatuses kandemäärusi ning kinnistusraamatu ja laevakinnistusraamatu kandeid; vaatab seadusega sätestatud juhtudel läbi määruskaebuse; annab rahuldamata jäetud määruskaebuse läbivaatamiseks kohtunikule; kinnitab ärakirjade, väljavõtete ja väljatrükkide õigsust; otsustab registriosa ümberkirjutamise või sulgemise; koostab kinnistusraamatuseaduse § 51 alusel riigilõivu tagastamise määrusi; tuvastab kinnistusraamatu veebilehe kaudu saabunud toimikuga tutvumise taotluse õigustatud huvi olemasolu ja koostab selle puudumise korral tsiviilkohtumenetluse seadustiku § 59 alusel kinnistustoimikuga tutvumiseks loa andmiseks keeldumise määrusi; juhendab kohtunikuabi ettevalmistuskava täitjaid ning kinnistusosakonna juhataja määramisel notarikandidaate, üliõpilastest praktikante, kinnistussekretäre ja kinnistusosakonna teisi töötajaid ning juhendajana vaatab läbi ja kinnitab juhendatava tehtud lahendite projekte; kehtetu - kohaldab rahvusvahelise sanktsiooni seaduses nimetatud rahvusvahelist finantssanktsiooni. 2 (2) Kinnistusosakonna juhataja võib vajaduse korral anda kohtunikuabile ka kinnistussekretäri ülesandeid. RT I 2015-12-10 6 110122015010 2016-01-01 Kinnistusosakonna juhataja võib vajaduse korral anda kohtunikuabile ka kinnistussekretäri ülesandeid.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_11 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
