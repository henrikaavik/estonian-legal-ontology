    {
      "@id": "estleg:Reg_345013_Par_150_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_150"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kui märkega tagatud nõude rahuldamise tõttu sissekantava asjaõiguse kinnistamisavalduses ei ole märke kustutamist taotletud, kustutatakse see pärast kande tegemist ametiülesande korras, välja arvatud kui nõude rahuldamisel ei saa lugeda nõuet lõplikult täidetuks. Kui märkega tagatud nõude rahuldamise tõttu sissekantava asjaõiguse kinnistamisavalduses ei ole märke kustutamist taotletud, kustutatakse see pärast kande tegemist ametiülesande korras, välja arvatud kui nõude rahuldamisel ei saa lugeda nõuet lõplikult täidetuks.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_150 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 150",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_151_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_151"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kui mitut kinnistut koormatakse sama asjaõigusega, märgitakse igas registriosas teised sama õigusega koormatud kinnistud ametiülesande korras. Sama kehtib ka juhul, kui ühte kinnistut koormava õigusega koormatakse hiljem veel teist kinnistut või kui kinnistu osa ülekandmisel teise kinnistusregistriossa kantakse üle ka seda koormav asjaõigus. Kui mitut kinnistut koormatakse sama asjaõigusega, märgitakse igas registriosas teised sama õigusega koormatud kinnistud ametiülesande korras. Sama kehtib ka juhul, kui ühte kinnistut koormava õigusega koormatakse hiljem veel teist kinnistut või kui kinnistu osa ülekandmisel teise kinnistusregistriossa kantakse üle ka seda koormav asjaõigus. 2 (2) Kui käesoleva paragrahvi lõikes 1 nimetatud koormatis mõne kinnistu suhtes kustutatakse, tuleb see märkida teiste kinnistute registriosades. Kui käesoleva paragrahvi lõikes 1 nimetatud koormatis mõne kinnistu suhtes kustutatakse, tuleb see märkida teiste kinnistute registriosades. 3 (3) Kui mitme korteriomandi või korterihoonestusõiguse kasuks seatakse piiratud asjaõigus ning selle kohta tehakse kanne korteriomandi või korterihoonestusõiguse registriossa, tuleb kandesse märkida ka nende korteriomandite või korterihoonestusõiguste registriosade numbrid, kuhu kanded on tehtud. Kui mitme korteriomandi või korterihoonestusõiguse kasuks seatakse piiratud asjaõigus ning selle kohta tehakse kanne korteriomandi või korterihoonestusõiguse registriossa, tuleb kandesse märkida ka nende korteriomandite või korterihoonestusõiguste registriosade numbrid, kuhu kanded on tehtud.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_151 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 151",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
