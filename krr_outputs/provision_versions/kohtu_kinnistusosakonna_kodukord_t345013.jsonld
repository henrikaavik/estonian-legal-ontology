      }
    },
    {
      "@id": "estleg:Reg_345013_Par_2_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusosakonna asjaajamisele kohaldatakse justiitsministri määrusega kehtestatud maa-, haldus- ja ringkonnakohtu kantselei kodukorras sätestatut niivõrd, kuivõrd kinnistusosakonna kodukord ei sätesta teisiti. Kinnistusosakonna asjaajamisele kohaldatakse justiitsministri määrusega kehtestatud maa-, haldus- ja ringkonnakohtu kantselei kodukorras sätestatut niivõrd, kuivõrd kinnistusosakonna kodukord ei sätesta teisiti.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_2 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_20_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_20"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vajaduse korral kehtestab kinnistusosakonna juhataja arvutiandmete kaitse organisatsioonilised lisanõuded need eelnevalt Registrite ja Infosüsteemide Keskusega kooskõlastades ning teavitab arvutiandmete kaitse lisanõuetest asjassepuutuvaid teenistujaid allkirja vastu. Vajaduse korral kehtestab kinnistusosakonna juhataja arvutiandmete kaitse organisatsioonilised lisanõuded need eelnevalt Registrite ja Infosüsteemide Keskusega kooskõlastades ning teavitab arvutiandmete kaitse lisanõuetest asjassepuutuvaid teenistujaid allkirja vastu. 2 (2) Andmekaitse lisanõuete kehtestamisest teavitatakse Justiits- ja Digiministeeriumi. Andmekaitse lisanõuete kehtestamisest teavitatakse Justiits- ja Digiministeeriumi.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_20 (redaktsioon 345013)",
        "@language": "et"
      },
