      "estleg:versionText": "Registriosa kolmas jagu kannab pealkirja „Koormatised ja kitsendused”. RT I 2014-12-11 1 111122014001 2015-01-01 Registriosa kolmas jagu kannab pealkirja „Koormatised ja kitsendused”.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_101 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 101",
