      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusraamat koosneb kinnistusregistrist, kinnistuspäevikust ja kinnistustoimikust. Kinnistusraamat koosneb kinnistusregistrist, kinnistuspäevikust ja kinnistustoimikust.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_82 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
