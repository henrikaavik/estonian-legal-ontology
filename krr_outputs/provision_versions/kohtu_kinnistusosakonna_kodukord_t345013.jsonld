    {
      "@id": "estleg:Reg_345013_Par_74_81_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_74_81"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevakinnistusraamatuga tutvumisel, samuti ärakirjade, väljatrükkide ja tõendite tellimisel võib päringu aluseks olla: 1 1) laeva nimi; 2 2) laeva registrinumber, Rahvusvahelise Mereorganisatsiooni registri number või kalalaeva pardanumber; 3 3) laeva omaniku nimi; 4 4) laeva omaniku isiku- või registrikood. RT I 2014-12-11 1 111122014001 2015-02-03 Laevakinnistusraamatuga tutvumisel, samuti ärakirjade, väljatrükkide ja tõendite tellimisel võib päringu aluseks olla: laeva nimi; laeva registrinumber, Rahvusvahelise Mereorganisatsiooni registri number või kalalaeva pardanumber; laeva omaniku nimi; laeva omaniku isiku- või registrikood.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_74_81 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 74_81",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_74_82_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_74_82"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Laevakinnistusraamatu registriosa väljatrüki ja laevatoimikus oleva dokumendi ärakirja kinnitamise ning väljastamise õigus on notaril ning Transpordiametil. Ärakiri ja väljatrükk võivad kliendi soovil olla digitaalselt kinnitatud. RT I 2021-08-26 1 126082021001 2021-08-29 Laevakinnistusraamatu registriosa väljatrüki ja laevatoimikus oleva dokumendi ärakirja kinnitamise ning väljastamise õigus on notaril ning Transpordiametil. Ärakiri ja väljatrükk võivad kliendi soovil olla digitaalselt kinnitatud. 2 (2) Paberkandjal väljastatavale kinnitatud ärakirjale ja väljatrükile teeb Transpordiamet kinnitusmärke, kus sisalduvad järgmised andmed: RT I 2021-08-26 1 126082021001 2021-08-29 1 1) kinnitus ärakirja vastavuse kohta algdokumendile; 2 2) kinnitamise päev, kuu ja aasta; 3 3) ärakirja kinnitanud ametiisiku allkiri ja nimi; 4 4) ametiasutuse pitsati jäljend (pitser). Paberkandjal väljastatavale kinnitatud ärakirjale ja väljatrükile teeb Transpordiamet kinnitusmärke, kus sisalduvad järgmised andmed: kinnitus ärakirja vastavuse kohta algdokumendile; kinnitamise päev, kuu ja aasta; ärakirja kinnitanud ametiisiku allkiri ja nimi; ametiasutuse pitsati jäljend (pitser). 3 (3) Ärakirja või väljatrüki elektroonilisel kinnitamisel ja edastamisel asendab käesoleva paragrahvi lõikes 2 nimetatud kinnitusmärke elemente ametiasutuse digitaalne tempel või teenistuja digitaalallkiri. Ärakirja või väljatrüki elektroonilisel kinnitamisel ja edastamisel asendab käesoleva paragrahvi lõikes 2 nimetatud kinnitusmärke elemente ametiasutuse digitaalne tempel või teenistuja digitaalallkiri. 4 (4) Notari poolt kinnitatud registriosa väljatrükile ja laevatoimikus olevale dokumendi ärakirjale kohaldatakse tõestamisseaduse § 38. RT I 2017-12-23 1 123122017001 2018-01-01 Notari poolt kinnitatud registriosa väljatrükile ja laevatoimikus olevale dokumendi ärakirjale kohaldatakse tõestamisseaduse § 38.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_74_82 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 74_82",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
