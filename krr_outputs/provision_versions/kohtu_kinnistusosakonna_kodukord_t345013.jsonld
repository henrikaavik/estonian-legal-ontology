      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Isikuandmete muutumise korral tehtud parandusest puudutatud isikutele ei teatata. Isikuandmete muutumise korral tehtud parandusest puudutatud isikutele ei teatata.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_157 (redaktsioon 345013)",
