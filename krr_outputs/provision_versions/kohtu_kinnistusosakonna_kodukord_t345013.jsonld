        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusosakonna teenistujate tegevuse peale esitatud kaebusi säilitatakse eraldi kaustas viis aastat. RT I 2012-12-29 22 129122012022 2013-01-01 Kinnistusosakonna teenistujate tegevuse peale esitatud kaebusi säilitatakse eraldi kaustas viis aastat.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_57 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 57",
