      }
    },
    {
      "@id": "estleg:Reg_345013_Par_85_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_85"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registriosa koosseis on sätestatud kinnistusraamatuseaduse § 11 lõikes 4. RT I 2012-12-29 22 129122012022 2013-01-01 Registriosa koosseis on sätestatud kinnistusraamatuseaduse § 11 lõikes 4. 2 (2) Kehtetu - RT I 2014-12-11 1 111122014001 2015-01-01 Kehtetu -",
      "rdfs:label": {
