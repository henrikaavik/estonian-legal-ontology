      },
      "estleg:versionText": "Registriosa esimene jagu kannab pealkirja „Kinnistu koosseis”. RT I 2014-12-11 1 111122014001 2015-01-01 Registriosa esimene jagu kannab pealkirja „Kinnistu koosseis”.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_88 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
