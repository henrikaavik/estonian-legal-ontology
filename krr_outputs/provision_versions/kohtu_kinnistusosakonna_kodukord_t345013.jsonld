        "@type": "xsd:date"
      },
      "estleg:versionText": "Registriosa neljas jagu kannab pealkirja „Hüpoteegid”. RT I 2014-12-11 1 111122014001 2015-01-01 Registriosa neljas jagu kannab pealkirja „Hüpoteegid”.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_106 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 106",
