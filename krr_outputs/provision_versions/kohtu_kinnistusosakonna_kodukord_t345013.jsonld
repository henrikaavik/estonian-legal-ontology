    {
      "@id": "estleg:Reg_345013_Par_191_220_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_191_220"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Laevakinnistusraamatusse kantud laeva, ehitatava laeva, teisaldatava ujuvvahendi ning ehitatava teisaldatava ujuvvahendi kustutamisel võib omanik nõuda, et notar või Transpordiamet väljastaks talle laevakinnistusraamatust kustutamise tõendi (lisa 4). RT I 2021-08-26 1 126082021001 2021-08-29 Laevakinnistusraamatusse kantud laeva, ehitatava laeva, teisaldatava ujuvvahendi ning ehitatava teisaldatava ujuvvahendi kustutamisel võib omanik nõuda, et notar või Transpordiamet väljastaks talle laevakinnistusraamatust kustutamise tõendi (lisa 4). 2 (2) Laevakinnistusraamatust kustutamise tõend väljastatakse ühes eksemplaris. Laevakinnistusraamatust kustutamise tõend väljastatakse ühes eksemplaris. 3 (3) Laevakinnistusraamatust kustutamise tõend trükitakse § 1902 lõikes 4 nimetatud lipudokumendi blanketile. RT I 2014-12-11 1 111122014001 2015-02-03 Laevakinnistusraamatust kustutamise tõend trükitakse § 1902 lõikes 4 nimetatud lipudokumendi blanketile.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_191_220 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
