    {
      "@id": "estleg:Reg_345013_Par_3_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtudirektor kinnitab kinnistusosakonna koosseisu. Kinnistusosakonna koosseisus on kohtunikuabi ametikohad ning võivad olla kantselei juhataja, kinnistussekretäri ja muud ametikohad. RT I 2015-12-10 6 110122015010 2016-01-01 Kohtudirektor kinnitab kinnistusosakonna koosseisu. Kinnistusosakonna koosseisus on kohtunikuabi ametikohad ning võivad olla kantselei juhataja, kinnistussekretäri ja muud ametikohad. 2 (2) Kehtetu - RT I 2014-12-11 1 111122014001 2015-01-01 Kehtetu - 3 (3) Kohtudirektor nimetab ametisse: 1 1) kantselei juhataja kinnistusosakonna juhataja ettepanekul kinnistussekretäride seast; RT I 2015-12-10 6 110122015010 2016-01-01 2 2) kehtetu - RT I 2015-12-10 6 110122015010 2016-01-01 3 3) kinnistussekretärid kinnistusosakonna juhataja ettepanekul; RT I 2015-12-10 6 110122015010 2016-01-01 4 4) teised kinnistusosakonna koosseisu kuuluvad kohtuteenistujad peale kohtunikuabi. Kohtudirektor nimetab ametisse: kantselei juhataja kinnistusosakonna juhataja ettepanekul kinnistussekretäride seast; kehtetu - kinnistussekretärid kinnistusosakonna juhataja ettepanekul; teised kinnistusosakonna koosseisu kuuluvad kohtuteenistujad peale kohtunikuabi.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_3 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
