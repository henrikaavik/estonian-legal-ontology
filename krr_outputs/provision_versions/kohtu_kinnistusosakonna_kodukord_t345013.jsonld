      }
    },
    {
      "@id": "estleg:Reg_345013_Par_176_198_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_176_198"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Laevakinnistusraamatu kandemääruse tegemisel kohaldatakse kinnistusraamatu kandemääruse tegemise sätteid, kui käesolevas määruses ei ole sätestatud teisiti. RT I 2014-12-11 1 111122014001 2015-02-03 Laevakinnistusraamatu kandemääruse tegemisel kohaldatakse kinnistusraamatu kandemääruse tegemise sätteid, kui käesolevas määruses ei ole sätestatud teisiti.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_176_198 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 176_198",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_176_199_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_176_199"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Enne laeva nime laevakinnistusraamatusse kandmise otsustamist kontrollib menetleja selle piisavat eristatavust teiste Eesti laevade nimedest tõendi alusel, mille on väljastanud Transpordiamet laeva lipuõiguse ja laevaregistrite seaduse § 25 lõike 6 kohaselt nime kooskõlastamise kohta. RT I 2021-08-26 1 126082021001 2021-08-29 Enne laeva nime laevakinnistusraamatusse kandmise otsustamist kontrollib menetleja selle piisavat eristatavust teiste Eesti laevade nimedest tõendi alusel, mille on väljastanud Transpordiamet laeva lipuõiguse ja laevaregistrite seaduse § 25 lõike 6 kohaselt nime kooskõlastamise kohta.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_176_199 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 176_199",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_176_200_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_176_200"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kandemääruse täitmine hõlmab: 1 1) kande või märke jõustamist; 2 2) laevakinnistuspäevikusse vajalike märkuste ja sissekannete tegemist; 3 3) asjaosalistele kande või märke tegemisest teatamist ja selle kohta laevakinnistuspäevikusse märke tegemist; 4 4) muid seadusest või käesolevast määrusest tulenevaid toiminguid. Kandemääruse täitmine hõlmab: kande või märke jõustamist; laevakinnistuspäevikusse vajalike märkuste ja sissekannete tegemist; asjaosalistele kande või märke tegemisest teatamist ja selle kohta laevakinnistuspäevikusse märke tegemist; muid seadusest või käesolevast määrusest tulenevaid toiminguid. 2 (2) Registriasja menetleja tagab, et kandemääruse täitmises osalevad teenistujad teeksid kõik nende ülesandeks olevad toimingud õigel ajal ja nõuetekohaselt. RT I 2014-12-11 1 111122014001 2015-02-03 Registriasja menetleja tagab, et kandemääruse täitmises osalevad teenistujad teeksid kõik nende ülesandeks olevad toimingud õigel ajal ja nõuetekohaselt.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_176_200 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 176_200",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_176_201_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_176_201"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kande jõustab oma digitaalallkirjaga kande otsustamiseks pädev isik. Kande jõustab oma digitaalallkirjaga kande otsustamiseks pädev isik. 2 (2) Kanne on jõustunud, kui see on pärast digitaalallkirjastamist salvestatud laevakinnistusraamatu andmebaasi. RT I 2014-12-11 1 111122014001 2015-02-03 Kanne on jõustunud, kui see on pärast digitaalallkirjastamist salvestatud laevakinnistusraamatu andmebaasi.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_176_201 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 176_201",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_176_202_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
