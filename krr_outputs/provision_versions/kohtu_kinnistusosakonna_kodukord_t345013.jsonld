    {
      "@id": "estleg:Reg_345013_Par_4_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kinnistusosakonnal on 35-millimeetrise läbimõõduga sõõrikujuline väikese riigivapi kujutisega ja oma nimega värvipitsat. Kinnistusosakonnal on 35-millimeetrise läbimõõduga sõõrikujuline väikese riigivapi kujutisega ja oma nimega värvipitsat. 2 (2) Kohtudirektor võib kinnistusosakonna juhataja ettepanekul otsustada kasutusele võtta rohkem kui ühe käesoleva paragrahvi lõikes 1 nimetatud pitsati ning tõestamistoiminguid tegevate kinnistusosakonna teenistujate nimelised pitsatid, lähtudes notariaadiseaduse § 53 lõike 1 punktist 4. RT I 2012-12-29 22 129122012022 2013-01-01 Kohtudirektor võib kinnistusosakonna juhataja ettepanekul otsustada kasutusele võtta rohkem kui ühe käesoleva paragrahvi lõikes 1 nimetatud pitsati ning tõestamistoiminguid tegevate kinnistusosakonna teenistujate nimelised pitsatid, lähtudes notariaadiseaduse § 53 lõike 1 punktist 4. 3 (3) Kohtudirektor korraldab kinnistusosakonna ja selle teenistujate pitsatite kujundamise, registreerimise, kehtetuks tunnistamise, hoidmise ja hävitamise riigivapi seaduses ettenähtud korras. RT I 2012-12-29 22 129122012022 2013-01-01 Kohtudirektor korraldab kinnistusosakonna ja selle teenistujate pitsatite kujundamise, registreerimise, kehtetuks tunnistamise, hoidmise ja hävitamise riigivapi seaduses ettenähtud korras. 4 (4) Kehtetu - RT I 2014-12-11 1 111122014001 2015-01-01 Kehtetu - 5 (5) Kinnistusosakond võib kasutada digitaalset templit. Kinnistusosakond võib kasutada digitaalset templit.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_4 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_40_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusosakonnal on keelatud osutada tasulisi teenuseid, mis ei tulene seadusest. Muu tasu võtmine riigilõivuga maksustatud toimingu eest on keelatud. Kinnistusosakonnal on keelatud osutada tasulisi teenuseid, mis ei tulene seadusest. Muu tasu võtmine riigilõivuga maksustatud toimingu eest on keelatud.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_40 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 40",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_41_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_41"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riigilõivu tagastamine toimub riigilõivuseaduses sätestatud korras. RT I 2012-12-29 22 129122012022 2013-01-01 Riigilõivu tagastamine toimub riigilõivuseaduses sätestatud korras. 2 (2) Kinnistamis- või kandeavalduse täieliku või osalise rahuldamata jätmise korral arvatakse tagastatavast riigilõivust maha kinnistamis- või kandeavalduse läbivaatamisega kaasnenud kulud, sealhulgas postikulud. Kinnistamis- või kandeavalduse täieliku või osalise rahuldamata jätmise korral arvatakse tagastatavast riigilõivust maha kinnistamis- või kandeavalduse läbivaatamisega kaasnenud kulud, sealhulgas postikulud. 3 (3) Tagastatava riigilõivu ja sellest mahaarvatavad kulud määrab kinnistamiseks pädev isik kandemääruses. RT I 2017-12-23 1 123122017001 2018-03-01 Tagastatava riigilõivu ja sellest mahaarvatavad kulud määrab kinnistamiseks pädev isik kandemääruses.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_41 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 41",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_42_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kinnistusraamatu koosseisu kuuluvaid dokumente (kinnistusregister, kinnistustoimik, kinnistuspäevik) ja laevakinnistusraamatu koosseisu kuuluvaid dokumente (laevakinnistusregister, laevatoimik, laevakinnistuspäevik) hoitakse kinnistusosakonna arhiivis. Kinnistusosakonnas peetavate registrite arhiive peetakse digitaalselt. RT I 2017-12-23 1 123122017001 2018-03-01 Kinnistusraamatu koosseisu kuuluvaid dokumente (kinnistusregister, kinnistustoimik, kinnistuspäevik) ja laevakinnistusraamatu koosseisu kuuluvaid dokumente (laevakinnistusregister, laevatoimik, laevakinnistuspäevik) hoitakse kinnistusosakonna arhiivis. Kinnistusosakonnas peetavate registrite arhiive peetakse digitaalselt.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_42 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 42",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_43_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Elektroonilise kinnistusraamatu koosseisu kuuluvaid kinnistusregistriosasid, kinnistustoimikuid ja kinnistuspäevikut ja neisse kantud andmeid säilitatakse alaliselt. Elektroonilise kinnistusraamatu koosseisu kuuluvaid kinnistusregistriosasid, kinnistustoimikuid ja kinnistuspäevikut ja neisse kantud andmeid säilitatakse alaliselt. 2 (2) Kirjavahetust, mis ei kuulu salvestamisele kinnistustoimikus, registriga tutvumise ja ärakirjade raamatut ning kaebuste päevikut säilitatakse kümme aastat pärast nende laekumist või viimase sissekande tegemist. Kirjavahetust, mis ei kuulu salvestamisele kinnistustoimikus, registriga tutvumise ja ärakirjade raamatut ning kaebuste päevikut säilitatakse kümme aastat pärast nende laekumist või viimase sissekande tegemist.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_43 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 43",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_43_45_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_43_45"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Elektroonilise laevakinnistusraamatu koosseisu kuuluvaid laevakinnistusregistriosasid, laevatoimikuid ja laevakinnistuspäevikut ning neisse kantud andmeid säilitatakse alaliselt. Elektroonilise laevakinnistusraamatu koosseisu kuuluvaid laevakinnistusregistriosasid, laevatoimikuid ja laevakinnistuspäevikut ning neisse kantud andmeid säilitatakse alaliselt. 2 (2) Kirjavahetust, mis ei kuulu salvestamisele laevakinnistustoimikus, registriga tutvumise ja ärakirjade raamatut ning kaebuste päevikut säilitatakse kümme aastat pärast nende laekumist või viimase sissekande tegemist. RT I 2014-12-11 1 111122014001 2015-02-03 Kirjavahetust, mis ei kuulu salvestamisele laevakinnistustoimikus, registriga tutvumise ja ärakirjade raamatut ning kaebuste päevikut säilitatakse kümme aastat pärast nende laekumist või viimase sissekande tegemist.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_43_45 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 43_45",
      "estleg:partOfAct": {
