      },
      "estleg:versionText": "Kinnistusraamatu ja laevakinnistusraamatu infosüsteemi kasutamisele kohaldatakse Justiits- ja Digiministeeriumi infotehnoloogia valdkonna planeerimise ja juhtimise korda (edaspidi IT-juhtimise kord). RT I 2017-12-23 1 123122017001 2018-03-01 Kinnistusraamatu ja laevakinnistusraamatu infosüsteemi kasutamisele kohaldatakse Justiits- ja Digiministeeriumi infotehnoloogia valdkonna planeerimise ja juhtimise korda (edaspidi IT-juhtimise kord).",
      "rdfs:label": {
        "@value": "Reg_345013_Par_15 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 15",
