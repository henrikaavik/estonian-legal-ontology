      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Asjaõiguse kinnistusraamatuvälise ülemineku tõttu valeks muutunud kinnistusraamatu kanne parandatakse kinnistusraamatuseaduse § 651 lõigetes 3–6 sätestatud korras. RT I 2012-12-29 22 129122012022 2013-01-01 Asjaõiguse kinnistusraamatuvälise ülemineku tõttu valeks muutunud kinnistusraamatu kanne parandatakse kinnistusraamatuseaduse § 651 lõigetes 3–6 sätestatud korras.",
      "rdfs:label": {
