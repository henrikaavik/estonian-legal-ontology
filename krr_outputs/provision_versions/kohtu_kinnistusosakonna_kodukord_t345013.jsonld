    {
      "@id": "estleg:Reg_345013_Par_4_5_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_4_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Digiteerimine on paberdokumendi skaneerimine, digitembeldamine, menetlusega või selle puudumise korral puudutatud registriosaga või registrikaardiga seostamine ja digitaalsesse arhiivi salvestamine. RT I 2012-12-29 22 129122012022 2013-01-01 Digiteerimine on paberdokumendi skaneerimine, digitembeldamine, menetlusega või selle puudumise korral puudutatud registriosaga või registrikaardiga seostamine ja digitaalsesse arhiivi salvestamine.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_4_5 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 4_5",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_5_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kinnistusosakonna juhataja määramisele kohaldatakse kohtute seaduse § 15 lõiget 4. RT I 2014-12-11 1 111122014001 2015-01-01 Kinnistusosakonna juhataja määramisele kohaldatakse kohtute seaduse § 15 lõiget 4. 2 (2) Kinnistusosakonna juhataja puudumisel täidab tema kohuseid kohtudirektori poolt kinnistusosakonna kohtunikuabide seast nimetatud kohusetäitja. Kinnistusosakonna juhataja puudumisel täidab tema kohuseid kohtudirektori poolt kinnistusosakonna kohtunikuabide seast nimetatud kohusetäitja. 3 (3) Ärakiri lõikes 1 nimetatud juhatajate määramise ning vabastamise kohta saadetakse Justiits- ja Digiministeeriumile teadmiseks. RT I 2014-12-11 1 111122014001 2015-01-01 Ärakiri lõikes 1 nimetatud juhatajate määramise ning vabastamise kohta saadetakse Justiits- ja Digiministeeriumile teadmiseks. 4 (4) Juhatajate vahetumisel võetakse ja antakse asjaajamine üle kohtudirektori nimetatud kohtuteenistuja osavõtul. Üleandmise-vastuvõtmise kohta koostatakse akt. Ärakiri üleandmise-vastuvõtmise kohta koostatud aktist saadetakse Justiits- ja Digiministeeriumile teadmiseks. RT I 2014-12-11 1 111122014001 2015-01-01 Juhatajate vahetumisel võetakse ja antakse asjaajamine üle kohtudirektori nimetatud kohtuteenistuja osavõtul. Üleandmise-vastuvõtmise kohta koostatakse akt. Ärakiri üleandmise-vastuvõtmise kohta koostatud aktist saadetakse Justiits- ja Digiministeeriumile teadmiseks.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_5 (redaktsioon 345013)",
        "@language": "et"
      },
