    {
      "@id": "estleg:Reg_345013_Par_37_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_37"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Dokumentide saatmisel ühest kohtumajast teise korraldab transportimise ja vastutab dokumentide säilimise ja puutumatuse eest kohtudirektor. RT I 2014-12-11 1 111122014001 2015-01-01 Dokumentide saatmisel ühest kohtumajast teise korraldab transportimise ja vastutab dokumentide säilimise ja puutumatuse eest kohtudirektor.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_37 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 37",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_38_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_38"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Enne toimingu tegemist kontrollib kinnistusosakonna juhataja määratud teenistuja riigilõivu laekumist selleks ettenähtud kontole ning fikseerib kontrollimise tulemused infosüsteemis, kandeavalduse vastuvõtupealdise juures või muul viisil. Tehniliste võimaluste olemasolu korral kontrollitakse ja fikseeritakse riigilõivu laekumine automatiseeritult. Enne toimingu tegemist kontrollib kinnistusosakonna juhataja määratud teenistuja riigilõivu laekumist selleks ettenähtud kontole ning fikseerib kontrollimise tulemused infosüsteemis, kandeavalduse vastuvõtupealdise juures või muul viisil. Tehniliste võimaluste olemasolu korral kontrollitakse ja fikseeritakse riigilõivu laekumine automatiseeritult. 2 (2) Kehtetu - RT I 2012-12-29 22 129122012022 2013-01-01 Kehtetu - 3 (3) Kinnistusosakonna teenistuja parandab infosüsteemi sisestatud riigilõivu summa, kui see on tagasi makstud või selle suurus on muutunud teistel põhjustel. Kinnistusosakonna teenistuja parandab infosüsteemi sisestatud riigilõivu summa, kui see on tagasi makstud või selle suurus on muutunud teistel põhjustel.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_38 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 38",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_345013_Map"
      }
    },
    {
      "@id": "estleg:Reg_345013_Par_39_v345013",
      "@type": [
        "owl:NamedIndividual",
