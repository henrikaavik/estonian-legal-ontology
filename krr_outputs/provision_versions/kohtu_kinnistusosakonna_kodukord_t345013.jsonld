      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kande juurde märgitakse, kas kanne on kehtiv või kustutatud. RT I 2014-12-11 1 111122014001 2015-02-03 Kande juurde märgitakse, kas kanne on kehtiv või kustutatud.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_132_147 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
