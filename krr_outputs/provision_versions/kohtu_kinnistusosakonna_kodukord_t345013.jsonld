    {
      "@id": "estleg:Reg_345013_Par_154_v345013",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_345013_Par_154"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Õigusliku tähenduseta kirjavead ja muud ilmsed eksimused parandatakse ametiülesande korras. Võimaluse korral teeb eelnimetatud parandused sama menetleja. Õigusliku tähenduseta kirjavead ja muud ilmsed eksimused parandatakse ametiülesande korras. Võimaluse korral teeb eelnimetatud parandused sama menetleja. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud parandusest puudutatud isikutele ei teatata. Käesoleva paragrahvi lõikes 1 nimetatud parandusest puudutatud isikutele ei teatata.",
      "rdfs:label": {
        "@value": "Reg_345013_Par_154 (redaktsioon 345013)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "345013",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/345013",
      "estleg:sourceAct": "Kohtu kinnistusosakonna kodukord",
      "estleg:provisionRef": "Reg_345013 § 154",
      "estleg:partOfAct": {
