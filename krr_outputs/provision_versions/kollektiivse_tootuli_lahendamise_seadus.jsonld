        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Kehtetu – (2) Käesolevas paragrahvis sätestatud väärtegude kohtuväline menetleja on Tööinspektsioon.",
      "rdfs:label": {
        "@value": "KTL_Par_23_4 (redaktsioon 112072014082)",
        "@language": "et"
      },
