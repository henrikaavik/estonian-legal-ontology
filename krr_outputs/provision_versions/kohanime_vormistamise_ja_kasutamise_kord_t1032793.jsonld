    {
      "@id": "estleg:Reg_1032793_Par_4_v1032793",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1032793_Par_4"
