      }
    },
    {
      "@id": "estleg:Reg_315642_Par_6_v315642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315642_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tööinspektsioonil on oma nime ja väikese riigivapi kujutise või sümboliga dokumendiplangid, mille kasutamise kord määratakse kindlaks Tööinspektsiooni asjaajamiskorras. Tööinspektsioonil on oma nime ja väikese riigivapi kujutise või sümboliga dokumendiplangid, mille kasutamise kord määratakse kindlaks Tööinspektsiooni asjaajamiskorras. 2 (2) Kehtetu - RT I 2014-09-05 7 105092014007 2014-09-08 53 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_315642_Par_6 (redaktsioon 315642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315642",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315642",
      "estleg:sourceAct": "Tööinspektsiooni põhimäärus",
