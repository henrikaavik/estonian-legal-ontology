        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööinspektsioon asub Tallinnas. RT I 2017-09-08 1 108092017001 2017-09-11 34 Tööinspektsioon asub Tallinnas.",
      "rdfs:label": {
        "@value": "Reg_315642_Par_7 (redaktsioon 315642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315642",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315642",
      "estleg:sourceAct": "Tööinspektsiooni põhimäärus",
      "estleg:provisionRef": "Reg_315642 § 7",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_315642_Map"
      }
    },
    {
      "@id": "estleg:Reg_315642_Par_8_v315642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_315642_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööinspektsiooni põhiülesanded on: 1 1) viia ellu töökeskkonnapoliitikat; 2 2) teha järelevalvet töökeskkonnas töötervishoidu, tööohutust ja töösuhteid reguleerivate õigusaktide nõuete täitmise üle; 3 3) teha järelevalvet töövahendusteenust osutavate ja renditööjõudu vahendavate ettevõtjate majandustegevuse nõuete ja piirangute täitmise üle; 4 4) teavitada üldsust, töötajaid ja tööandjaid töökeskkonna ohtudest; 5 5) lahendada töövaidlusi ja viia läbi lepitusmenetlusi kohtuvälises töövaidlusi lahendavas organis. RT I 2020-12-17 1 117122020001 2020-12-20 Tööinspektsiooni põhiülesanded on: viia ellu töökeskkonnapoliitikat; teha järelevalvet töökeskkonnas töötervishoidu, tööohutust ja töösuhteid reguleerivate õigusaktide nõuete täitmise üle; teha järelevalvet töövahendusteenust osutavate ja renditööjõudu vahendavate ettevõtjate majandustegevuse nõuete ja piirangute täitmise üle; teavitada üldsust, töötajaid ja tööandjaid töökeskkonna ohtudest; lahendada töövaidlusi ja viia läbi lepitusmenetlusi kohtuvälises töövaidlusi lahendavas organis.",
      "rdfs:label": {
        "@value": "Reg_315642_Par_8 (redaktsioon 315642)",
        "@language": "et"
      },
