      "estleg:provisionRef": "Reg_315642 § 4",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_315642_Map"
      }
    },
    {
      "@id": "estleg:Reg_315642_Par_5_v315642",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
