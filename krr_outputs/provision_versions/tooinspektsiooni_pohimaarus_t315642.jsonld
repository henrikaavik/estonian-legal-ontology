      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tööinspektsioon on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib tema tegevust ning teostab Tööinspektsiooni üle teenistuslikku järelevalvet õigusaktidega sätestatud korras. RT I 2014-09-10 1 110092014001 2014-09-13 54 Tööinspektsioon on aruandekohustuslik valdkonna eest vastutava ministri ees, kes suunab ja koordineerib tema tegevust ning teostab Tööinspektsiooni üle teenistuslikku järelevalvet õigusaktidega sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_315642_Par_4 (redaktsioon 315642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315642",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315642",
