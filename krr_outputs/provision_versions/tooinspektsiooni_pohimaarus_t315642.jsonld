      },
      "estleg:versionValidFrom": {
        "@value": "2024-09-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Tööinspektsioonil on oma nimega sõõrikujuline 35 mm läbimõõduga pitsat, mille keskel on väikese riigivapi kujutis. Tööinspektsioonil on oma nimega sõõrikujuline 35 mm läbimõõduga pitsat, mille keskel on väikese riigivapi kujutis. 2 (2) Kehtetu - RT I 2015-01-16 3 116012015003 2015-01-19 1 Kehtetu -",
      "rdfs:label": {
        "@value": "Reg_315642_Par_5 (redaktsioon 315642)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "315642",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/315642",
      "estleg:sourceAct": "Tööinspektsiooni põhimäärus",
      "estleg:provisionRef": "Reg_315642 § 5",
      "estleg:partOfAct": {
