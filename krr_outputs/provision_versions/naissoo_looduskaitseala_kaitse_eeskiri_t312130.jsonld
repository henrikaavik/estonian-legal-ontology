      }
    },
    {
      "@id": "estleg:Reg_312130_Par_8_v312130",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_312130_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Sihtkaitsevööndis poollooduslike koosluste esinemisaladel on vajalik rohu niitmine koosluste ilme ja liigikoosseisu säilimise tagamiseks. Sihtkaitsevööndis poollooduslike koosluste esinemisaladel on vajalik rohu niitmine koosluste ilme ja liigikoosseisu säilimise tagamiseks.",
      "rdfs:label": {
        "@value": "Reg_312130_Par_8 (redaktsioon 312130)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "312130",
