      "estleg:provisionRef": "Reg_1056372 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056372_Par_16_v1056372",
