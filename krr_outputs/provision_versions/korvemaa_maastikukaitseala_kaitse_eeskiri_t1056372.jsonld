      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 13. juuni 2019. a käskkirjaga nr 1-2/19/433 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 13. juuni 2019. a käskkirjaga nr 1-2/19/433 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1056372_Par_20 (redaktsioon 1056372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056372",
      "estleg:sourceAct": "Kõrvemaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056372 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056372_Par_21_v1056372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056372_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1056372_Par_21 (redaktsioon 1056372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056372",
      "estleg:sourceAct": "Kõrvemaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056372 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056372_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1056372_Par_3_v1056372",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056372_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-04-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1056372_Par_3 (redaktsioon 1056372)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056372",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056372",
      "estleg:sourceAct": "Kõrvemaa maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1056372 § 3",
      "estleg:partOfAct": {
