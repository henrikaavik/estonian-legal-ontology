      }
    },
    {
      "@id": "estleg:Reg_1001421_Par_8_v1001421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001421_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Koolil on raamatukogu, mille põhiülesanne on toetada trükiste, audiovisuaalsete ja muude teabekandjate hoidmise ja kättesaadavaks tegemise kaudu kooli õppekava järgset õpet, arendada õpilaste iseseisva õpitöö ja teabe hankimise oskust ning lugemishuvi. Koolil on raamatukogu, mille põhiülesanne on toetada trükiste, audiovisuaalsete ja muude teabekandjate hoidmise ja kättesaadavaks tegemise kaudu kooli õppekava järgset õpet, arendada õpilaste iseseisva õpitöö ja teabe hankimise oskust ning lugemishuvi.",
      "rdfs:label": {
        "@value": "Reg_1001421_Par_8 (redaktsioon 1001421)",
        "@language": "et"
      },
