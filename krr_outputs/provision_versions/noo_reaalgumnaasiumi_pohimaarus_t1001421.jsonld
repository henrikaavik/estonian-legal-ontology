    {
      "@id": "estleg:Reg_1001421_Par_6_v1001421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001421_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kooli tegevuse eesmärk on olla Eestis kõrgelt tunnustatud reaal- ja loodusainete süvaõppega innovaatiline, uusi teadmisi ja tehnoloogiaid propageeriv gümnaasium. Kooli tegevuse eesmärk on olla Eestis kõrgelt tunnustatud reaal- ja loodusainete süvaõppega innovaatiline, uusi teadmisi ja tehnoloogiaid propageeriv gümnaasium. 2 (2) Kooli ülesanne on olla oma tegemistes optimistlik, lahendustes paindlik, võimalustes realistlik ning avatud koostööks kõigi huvigruppidega. Kooli ülesanne on olla oma tegemistes optimistlik, lahendustes paindlik, võimalustes realistlik ning avatud koostööks kõigi huvigruppidega.",
      "rdfs:label": {
        "@value": "Reg_1001421_Par_6 (redaktsioon 1001421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001421",
      "estleg:sourceAct": "Nõo Reaalgümnaasiumi põhimäärus",
      "estleg:provisionRef": "Reg_1001421 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001421_Map"
      }
    },
    {
      "@id": "estleg:Reg_1001421_Par_7_v1001421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1001421_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-02-08",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Koolis omandatakse üldkeskharidust statsionaarses õppes. Koolis omandatakse üldkeskharidust statsionaarses õppes. 2 (2) Õpingute alusdokumendiks koolis on „Gümnaasiumi riikliku õppekava” alusel koostatud kooli õppekava. Õpingute alusdokumendiks koolis on „Gümnaasiumi riikliku õppekava” alusel koostatud kooli õppekava. 3 (3) Valikkursuste valikul arvestab kool õppesuundi, õpilaste, lapsevanemate ja õpetajate ettepanekuid ning oma võimalusi. RT I 2013-09-03 4 103092013004 2013-09-06 Valikkursuste valikul arvestab kool õppesuundi, õpilaste, lapsevanemate ja õpetajate ettepanekuid ning oma võimalusi.",
      "rdfs:label": {
        "@value": "Reg_1001421_Par_7 (redaktsioon 1001421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1001421",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1001421",
      "estleg:sourceAct": "Nõo Reaalgümnaasiumi põhimäärus",
      "estleg:provisionRef": "Reg_1001421 § 7",
