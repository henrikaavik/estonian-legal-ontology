      }
    },
    {
      "@id": "estleg:ARHIIV_Par_39_v114032014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_39"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "ARHIIV_Par_39 (redaktsioon 114032014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014007"
    },
    {
      "@id": "estleg:ARHIIV_Par_4_v22403",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Dokument käesoleva seaduse mõistes on mis tahes teabekandjale jäädvustatud teave, mis on loodud või saadud asutuse või isiku tegevuse käigus ning mille sisu, vorm ja struktuur on küllaldane faktide või tegevuse tõestamiseks. (2) Arhivaal käesoleva seaduse mõistes on dokument, millele on kehtestatud säilitustähtaeg või mida säilitatakse tema väärtuse tõttu ühiskonnale, riigile, omanikule või teisele isikule.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_4 (redaktsioon 22403)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22403",
      "estleg:supersededByVersion": {
        "@id": "estleg:ARHIIV_Par_4_v121032011001"
      },
      "estleg:versionValidTo": {
        "@value": "2011-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ARHIIV_Par_4_v121032011001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusarhiivi juhib riigiarhivaar, kelle haridus- ja teadusminister nimetab kooskõlas avaliku teenistuse seadusega ametisse viieks aastaks, kuulanud ära arhiivinõukogu arvamuse.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_4 (redaktsioon 121032011001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032011001",
      "estleg:supersededByVersion": {
        "@id": "estleg:ARHIIV_Par_4_v114032014007"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ARHIIV_Par_4_v114032014007",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Rahvusarhiivi juhib riigiarhivaar, kelle valdkonna eest vastutav minister nimetab kooskõlas avaliku teenistuse seadusega ametisse viieks aastaks, kuulanud ära arhiivinõukogu arvamuse.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_4 (redaktsioon 114032014007)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "114032014007"
    },
    {
      "@id": "estleg:ARHIIV_Par_40_v22403",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juurdepääs arhivaalile on õigus tutvuda arhivaali või selles sisalduva teabega. (2) Riigi- ja kohaliku omavalitsuse asutused ja organid, avalik-õiguslikud asutused ning arhiivid on kohustatud tagama nende valduses olevatele arhivaalidele juurdepääsu kooskõlas käesoleva seaduse, avaliku teabe seaduse ja arhiivieeskirjaga. (3) Juurdepääs avalikule arhivaalile on vaba alates arhivaali tekkimisest, kui sellele ei laiene käesoleva seaduse Paragrahvis 42 kehtestatud piirangud. (4) Igal isikul on õigus nõuda arhivaali valdajalt andmeid teda puudutava teabe olemasolu kohta ning sellega tutvuda. Kui juurdepääs arhivaalile on piiratud, võib isik tutvuda ainult tema kohta käivate andmetega, välja arvatud käesoleva seaduse paragrahv 42 lõigetes 1 ja 6 ettenähtud juhtudel.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_40 (redaktsioon 22403)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22403",
      "estleg:supersededByVersion": {
        "@id": "estleg:ARHIIV_Par_40_v184471"
      },
      "estleg:versionValidTo": {
        "@value": "2002-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ARHIIV_Par_40_v184471",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Juurdepääs arhivaalile on õigus tutvuda arhivaali või selles sisalduva teabega. (2) Riigi- ja kohaliku omavalitsuse asutused ja organid, avalik-õiguslikud asutused ning arhiivid on kohustatud tagama nende valduses olevatele arhivaalidele juurdepääsu kooskõlas käesoleva seaduse, avaliku teabe seaduse ja arhiivieeskirjaga. (3) Juurdepääs avalikule arhivaalile on vaba alates arhivaali tekkimisest, kui sellele ei laiene käesoleva seaduse Paragrahvis 42 kehtestatud piirangud. (4) Igal isikul on õigus nõuda arhivaali valdajalt andmeid teda puudutava teabe olemasolu kohta ning sellega tutvuda. Kui juurdepääs arhivaalile on piiratud, võib isik tutvuda ainult tema kohta käivate andmetega, välja arvatud käesoleva seaduse § 42 lõigetes 1 ja 6 ettenähtud juhtudel.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_40 (redaktsioon 184471)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "184471",
      "estleg:supersededByVersion": {
