      }
    },
    {
      "@id": "estleg:ARHIIV_Par_40_v121032011001",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_40"
      },
      "estleg:versionValidFrom": {
        "@value": "2012-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus jõustub 2012. aasta 1. jaanuaril.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_40 (redaktsioon 121032011001)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121032011001"
    },
    {
      "@id": "estleg:ARHIIV_Par_5_v22403",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ARHIIV_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Avalikud arhivaalid on riigi- või kohaliku omavalitsuse organi või asutuse või avalik-õigusliku juriidilise isiku tegevuse tulemusena loodud või saadud arhivaalid või eraõigusliku juriidilise ja füüsilise isiku arhivaalid, mis on loodud või saadud seaduses või selle alusel sätestatud avalike ülesannete täitmise käigus. (2) Avalikud arhivaalid on osa rahvuslikust kultuuripärandist.",
      "rdfs:label": {
        "@value": "ARHIIV_Par_5 (redaktsioon 22403)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22403",
      "estleg:supersededByVersion": {
