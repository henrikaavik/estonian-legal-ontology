      "estleg:provisionRef": "Reg_1053054 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053054_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053054_Par_3_v1053054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053054_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Elamisloakaardi kiibi kontaktivabale elektroonilisele osale kantakse järgmised andmed: 1 1) dokumendi liik (IR); 2 2) väljaandja riigi kood „EST”; 3 3) dokumendi number; 4 4) kasutaja isikukood; 5 5) kasutaja sünniaeg; 6 6) kasutaja sugu; 7 7) dokumendi kehtivuse viimane kuupäev; 8 8) kasutaja kodakondsus; 9 9) kasutaja perekonnanimi; 10 10) kasutaja eesnimi; 11 11) kasutaja näokujutis; 12 12) kasutaja sõrmejäljekujutised koos sõrme indeksnumbriga ja kiibile salvestatud sõrmejäljekujutiste arv; 13 13) sõrmejäljekujutistele juurdepääsu haldamise avaliku võtme info; 14 14) aktiivse autentimise avaliku võtme info. Elamisloakaardi kiibi kontaktivabale elektroonilisele osale kantakse järgmised andmed: dokumendi liik (IR); väljaandja riigi kood „EST”; dokumendi number; kasutaja isikukood; kasutaja sünniaeg; kasutaja sugu; dokumendi kehtivuse viimane kuupäev; kasutaja kodakondsus; kasutaja perekonnanimi; kasutaja eesnimi; kasutaja näokujutis; kasutaja sõrmejäljekujutised koos sõrme indeksnumbriga ja kiibile salvestatud sõrmejäljekujutiste arv; sõrmejäljekujutistele juurdepääsu haldamise avaliku võtme info; aktiivse autentimise avaliku võtme info. 2 (2) Isikutunnistuse kiibi kontaktivabale elektroonilisele osale kantakse järgmised andmed: 1 1) dokumendi liik (ID); 2 2) väljaandja riigi kood „EST”; 3 3) dokumendi number; 4 4) kasutaja isikukood; 5 5) kasutaja sünniaeg; 6 6) kasutaja sugu; 7 7) kehtivuse viimane kuupäev; 8 8) kasutaja kodakondsus; 9 9) kasutaja eesnimi; 10 10) kasutaja perekonnanimi; 11 11) kasutaja näokujutis; 12 12) kasutaja sõrmejäljekujutised koos sõrme indeksnumbriga ja kiibile salvestatud sõrmejäljekujutiste arv; 13 13) sõrmejäljekujutistele juurdepääsu haldamise avaliku võtme info; 14 14) aktiivse autentimise avaliku võtme info. Isikutunnistuse kiibi kontaktivabale elektroonilisele osale kantakse järgmised andmed: dokumendi liik (ID); väljaandja riigi kood „EST”; dokumendi number; kasutaja isikukood; kasutaja sünniaeg; kasutaja sugu; kehtivuse viimane kuupäev; kasutaja kodakondsus; kasutaja eesnimi; kasutaja perekonnanimi; kasutaja näokujutis; kasutaja sõrmejäljekujutised koos sõrme indeksnumbriga ja kiibile salvestatud sõrmejäljekujutiste arv; sõrmejäljekujutistele juurdepääsu haldamise avaliku võtme info; aktiivse autentimise avaliku võtme info.",
      "rdfs:label": {
        "@value": "Reg_1053054_Par_3 (redaktsioon 1053054)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1053054",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1053054",
      "estleg:sourceAct": "Dokumenti kantavate digitaalset isiku tuvastamist ja digitaalset allkirjastamist võimaldava informatsiooni ja andmete ning teiste asjakohaste digitaalsete andmete loetelu",
      "estleg:provisionRef": "Reg_1053054 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053054_Map"
      }
    },
    {
      "@id": "estleg:Reg_1053054_Par_4_v1053054",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1053054_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-12-17",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Meremehe teenistusraamatu, välismaalase passi, meresõidutunnistuse, diplomaatilise passi, Eesti kodaniku passi, ajutise reisidokumendi ja pagulase reisidokumendi elektroonilisele andmekandjale kantakse järgmised digitaalsed andmed: 1 1) kasutaja näokujutis; 2 2) dokumendi liik; 3 3) väljaandja riigi kood „EST”; 4 4) kasutaja perekonnanimi; 5 5) kasutaja eesnimi; 6 6) dokumendi number; 7 7) kasutaja kodakondsus; 8 8) kasutaja sünniaeg; 9 9) kasutaja sugu; 10 10) dokumendi kehtivuse viimane kuupäev; 11 11) kasutaja isikukood; 12 12) kasutaja sõrmejäljekujutised koos sõrme indeksnumbriga ja kiibile salvestatud sõrmejäljekujutiste arv; 13 13) sõrmejäljekujutistele juurdepääsu haldamise avaliku võtme info; 14 14) aktiivse autentimise avaliku võtme info. Meremehe teenistusraamatu, välismaalase passi, meresõidutunnistuse, diplomaatilise passi, Eesti kodaniku passi, ajutise reisidokumendi ja pagulase reisidokumendi elektroonilisele andmekandjale kantakse järgmised digitaalsed andmed: kasutaja näokujutis; dokumendi liik; väljaandja riigi kood „EST”; kasutaja perekonnanimi; kasutaja eesnimi; dokumendi number; kasutaja kodakondsus; kasutaja sünniaeg; kasutaja sugu; dokumendi kehtivuse viimane kuupäev; kasutaja isikukood; kasutaja sõrmejäljekujutised koos sõrme indeksnumbriga ja kiibile salvestatud sõrmejäljekujutiste arv; sõrmejäljekujutistele juurdepääsu haldamise avaliku võtme info; aktiivse autentimise avaliku võtme info.",
