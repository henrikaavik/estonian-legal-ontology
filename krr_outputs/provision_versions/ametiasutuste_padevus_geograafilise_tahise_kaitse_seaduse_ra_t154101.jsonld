        "@type": "xsd:date"
      },
      "estleg:versionText": "Paragrahvi 1 punktis 2 nimetatud tõendi väljastab Patendiamet. Paragrahvi 1 punktis 2 nimetatud tõendi väljastab Patendiamet.",
      "rdfs:label": {
        "@value": "Reg_154101_Par_3 (redaktsioon 154101)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154101",
