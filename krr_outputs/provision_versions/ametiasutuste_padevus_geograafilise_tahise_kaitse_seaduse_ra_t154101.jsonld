      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Ametiasutuste pädevus «Geograafilise tähise kaitse seaduse» rakendamisel (6 versiooni)",
        "@language": "et"
      },
      "dc:source": "Ametiasutuste pädevus «Geograafilise tähise kaitse seaduse» rakendamisel"
    },
    {
      "@id": "estleg:Reg_154101_Par_1_v154101",
      "@type": [
