        "@id": "estleg:Reg_154101_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154101_Par_2_v154101",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_154101_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Eesti geograafilise tähise registreerimise taotlemiseks on pädevad: 1 1) Regionaal- ja Põllumajandusministeerium mis tahes Eesti geograafilise tähise registreerimisel; RT I 2023-07-05 2 105072023002 2023-07-08 2 2) Majandus- ja Kommunikatsiooniministeerium mis tahes Eesti geograafilise tähise registreerimisel; RT I 2017-12-12 1 112122017001 2018-01-01 3 3) kehtetu - RT I 2017-12-12 1 112122017001 2018-01-01 4 4) linna- ja vallavalitsus ainult sellise geograafilise tähise registreerimisel, millele vastav geograafiline ala asub tema haldusüksuse piirides. Eesti geograafilise tähise registreerimise taotlemiseks on pädevad: Regionaal- ja Põllumajandusministeerium mis tahes Eesti geograafilise tähise registreerimisel; Majandus- ja Kommunikatsiooniministeerium mis tahes Eesti geograafilise tähise registreerimisel; kehtetu - linna- ja vallavalitsus ainult sellise geograafilise tähise registreerimisel, millele vastav geograafiline ala asub tema haldusüksuse piirides.",
      "rdfs:label": {
        "@value": "Reg_154101_Par_2 (redaktsioon 154101)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "154101",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/154101",
      "estleg:sourceAct": "Ametiasutuste pädevus «Geograafilise tähise kaitse seaduse» rakendamisel",
      "estleg:provisionRef": "Reg_154101 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_154101_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_154101_Par_3_v154101",
