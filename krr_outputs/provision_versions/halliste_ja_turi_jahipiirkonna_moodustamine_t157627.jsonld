    {
      "@id": "estleg:Reg_157627_Par_4_v157627",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_157627_Par_4"
