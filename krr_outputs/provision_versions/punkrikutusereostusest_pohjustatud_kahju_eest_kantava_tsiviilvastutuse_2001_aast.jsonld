  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_punkrikutusereostusest_pohjustatud_kahju_eest_kantava_tsiviilvastutuse_2001_aast_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Punkrikütusereostusest põhjustatud kahju eest kantava tsiviilvastutuse 2001. aasta rahvusvahelise konventsiooniga ühinemise seadus (8 versiooni)",
        "@language": "et"
      },
      "dc:source": "Punkrikütusereostusest põhjustatud kahju eest kantava tsiviilvastutuse 2001. aasta rahvusvahelise konventsiooniga ühinemise seadus"
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_1_v1041624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ühineda punkrikütusereostusest põhjustatud kahju eest kantava tsiviilvastutuse rahvusvahelise konventsiooniga (edaspidi punkrikütuse konventsioon), mis võeti vastu 2001. aasta 23. märtsil Londonis.1",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_1 (redaktsioon 1041624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041624"
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_2_v1041624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Teha punkrikütuse konventsiooniga ühinemisel järgmised deklaratsioonid: teiste Euroopa Liidu liikmesriikide kohtuotsuseid, mille on punkrikütuse konventsioonist lähtudes teinud Euroopa Liidu liikmesriigi, välja arvatud Taani Kuningriigi kohus, tunnustatakse Eesti Vabariigis ning nad pööratakse täitmisele Euroopa Ühenduse asjakohaste õigusnormide alusel; tuginedes punkrikütuse konventsiooni artikli 7 lõikele 15 ei kohalda Eesti Vabariik punkrikütuse konventsiooni artiklit 7 laevadele, mis sõidavad üksnes Eesti Vabariigi vetes.",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_2 (redaktsioon 1041624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041624"
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3_v1041624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Veeteede Amet annab laevale punkrikütuse konventsiooni nõuetele vastava kindlustuslepingu või muu rahalise tagatise, nagu pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi olemasolu kinnitava tõendi (edaspidi tõend), kui laevaomanik esitab kindlustuslepingu, pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi, mis vastab punkrikütuse konventsiooni nõuetele ning võimaldab hüvitada punkrikütuse lekkimisest või heitest põhjustatud kahju punkrikütuse konventsiooni artikli 7 lõikega 1 sätestatud piirmäära ulatuses. (2) Tõendi taotlemise, andmise, kehtetuks tunnistamise ja tõendi hoidmise korra ning tõendi vormi , lähtudes punkrikütuse konventsiooni artiklist 7. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"majandus- ja kommunikatsiooniminister\" sõnadega \"valdkonna eest vastutav minister\".",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_3 (redaktsioon 1041624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041624",
      "estleg:supersededByVersion": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3_v210122020004"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3_v210122020004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet annab laevale punkrikütuse konventsiooni nõuetele vastava kindlustuslepingu või muu rahalise tagatise, nagu pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi olemasolu kinnitava tõendi (edaspidi tõend), kui laevaomanik esitab kindlustuslepingu, pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi, mis vastab punkrikütuse konventsiooni nõuetele ning võimaldab hüvitada punkrikütuse lekkimisest või heitest põhjustatud kahju punkrikütuse konventsiooni artikli 7 lõikega 1 sätestatud piirmäära ulatuses. (2) Tõendi taotlemise, andmise, kehtetuks tunnistamise ja tõendi hoidmise korra ning tõendi vormi , lähtudes punkrikütuse konventsiooni artiklist 7. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"majandus- ja kommunikatsiooniminister\" sõnadega \"valdkonna eest vastutav minister\".",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_3 (redaktsioon 210122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "210122020004",
      "estleg:supersededByVersion": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3_v231052021002"
      },
      "estleg:versionValidTo": {
        "@value": "2021-05-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3_v231052021002",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Transpordiamet annab laevale punkrikütuse konventsiooni nõuetele vastava kindlustuslepingu või muu rahalise tagatise, nagu pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi olemasolu kinnitava tõendi (edaspidi tõend), kui laevaomanik esitab kindlustuslepingu, pangagarantii või rahvusvahelise kompensatsioonifondi sertifikaadi, mis vastab punkrikütuse konventsiooni nõuetele ning võimaldab hüvitada punkrikütuse lekkimisest või heitest põhjustatud kahju punkrikütuse konventsiooni artikli 7 lõikega 1 sätestatud piirmäära ulatuses. (2) Tõendi taotlemise, andmise, kehtetuks tunnistamise ja tõendi hoidmise korra , lähtudes punkrikütuse konventsiooni artiklist 7. (3) Kui Transpordiamet väljastab tõendi elektrooniliselt, peab see vastama meresõiduohutuse seaduse § 1 lõikes 71 sätestatud tingimustele.",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_3 (redaktsioon 231052021002)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "231052021002"
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_4_v1041624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõendi olemasolu sadamasse saabuvatel ja sadamast lahkuvatel laevadel ning territoriaalmeres asuvatesse terminalidesse saabuvatel ja nendest lahkuvatel laevadel kontrollib Veeteede Amet või selleks halduslepingu alusel volitatud eraõiguslik juriidiline isik. (2) Valdkonna eest vastutav minister võib halduslepingu alusel anda käesoleva paragrahvi lõikes 1 sätestatud Veeteede Ameti kohustuse täitmise eraõiguslikule juriidilisele isikule. Eraõigusliku juriidilise isiku kohustuste maht, vastutus ning kohustuste täitmisega kaasnevate kulude hüvitamine sätestatakse halduslepinguga. , Vabariigi Valitsuse seaduse § 107³ lõike 4 alusel asendatud alates 2014. aasta 1. juulist \"Majandus- ja kommunikatsiooniminister\" sõnadega \"Valdkonna eest vastutav minister\". (3) Järelevalvet käesoleva paragrahvi lõike 2 kohaselt sõlmitud halduslepingu täitmise üle eraõigusliku juriidilise isiku poolt teostab Majandus- ja Kommunikatsiooniministeerium. (4) Kui haldusleping lõpetatakse ühepoolselt või kui esineb muu põhjus, mis takistab käesoleva paragrahvi lõikes 2 nimetatud eraõiguslikul juriidilisel isikul jätkata haldusülesande edasist täitmist, korraldab haldusülesande edasise täitmise Veeteede Amet.",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_4 (redaktsioon 1041624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041624",
      "estleg:supersededByVersion": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_4_v210122020004"
      },
      "estleg:versionValidTo": {
        "@value": "2020-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_4_v210122020004",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Tõendi olemasolu sadamasse saabuvatel ja sadamast lahkuvatel laevadel ning territoriaalmeres asuvatesse terminalidesse saabuvatel ja nendest lahkuvatel laevadel kontrollib Transpordiamet või selleks halduslepingu alusel volitatud eraõiguslik juriidiline isik. (2) Valdkonna eest vastutav minister võib halduslepingu alusel anda käesoleva paragrahvi lõikes 1 sätestatud Transpordiameti kohustuse täitmise eraõiguslikule juriidilisele isikule. Eraõigusliku juriidilise isiku kohustuste maht, vastutus ning kohustuste täitmisega kaasnevate kulude hüvitamine sätestatakse halduslepinguga. (3) Järelevalvet käesoleva paragrahvi lõike 2 kohaselt sõlmitud halduslepingu täitmise üle eraõigusliku juriidilise isiku poolt teostab Majandus- ja Kommunikatsiooniministeerium. (4) Kui haldusleping lõpetatakse ühepoolselt või kui esineb muu põhjus, mis takistab käesoleva paragrahvi lõikes 2 nimetatud eraõiguslikul juriidilisel isikul jätkata haldusülesande edasist täitmist, korraldab haldusülesande edasise täitmise Transpordiamet.",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_4 (redaktsioon 210122020004)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "210122020004"
    },
    {
      "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_5_v1041624",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:punkrikutusereostusest_pohjustatud_kahju_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-07-16",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse §-d 3 ja 4 jõustuvad punkrikütuse konventsiooni rahvusvahelise jõustumise päeval.",
      "rdfs:label": {
        "@value": "punkrikutusereostusest_pohjustatud_kahju_Par_5 (redaktsioon 1041624)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1041624"
    }
  ]
}
