    {
      "@id": "estleg:Reg_158717_Par_11_v158717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158717_Par_11"
      },
