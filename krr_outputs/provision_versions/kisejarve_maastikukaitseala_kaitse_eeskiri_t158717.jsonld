      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine. Piiranguvööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks vajalik rohu niitmine, loomade karjatamine ning puu- ja põõsarinde harvendamine.",
      "rdfs:label": {
        "@value": "Reg_158717_Par_14 (redaktsioon 158717)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158717",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158717",
      "estleg:sourceAct": "Kisejärve maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158717 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158717_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_158717_Par_15_v158717",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158717_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-06-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse ja maa kasutamisel väljakujunenud traditsioonilise pärandkultuurmaastiku ilme säilitamine. Piiranguvööndi kaitse-eesmärk on sealse elustiku mitmekesisuse ja maa kasutamisel väljakujunenud traditsioonilise pärandkultuurmaastiku ilme säilitamine.",
