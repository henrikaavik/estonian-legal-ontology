    {
      "@id": "estleg:Reg_1013853_Par_11_v1013853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013853_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Järelevalvet andmekogu pidamise seaduslikkuse üle teostavad avaliku teabe seaduse § 531 lõikes 1 sätestatud asutus ja andmekaitse järelevalveasutus avaliku teabe seaduses ja isikuandmete kaitse seaduses sätestatud korras. Järelevalvet andmekogu pidamise seaduslikkuse üle teostavad avaliku teabe seaduse § 531 lõikes 1 sätestatud asutus ja andmekaitse järelevalveasutus avaliku teabe seaduses ja isikuandmete kaitse seaduses sätestatud korras.",
      "rdfs:label": {
        "@value": "Reg_1013853_Par_11 (redaktsioon 1013853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013853",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogu asutamine ja selle põhimäärus",
      "estleg:provisionRef": "Reg_1013853 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013853_Par_12_v1013853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013853_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamist finantseeritakse riigieelarvest vastutavale töötlejale selleks otstarbeks eraldatud vahenditest. Andmekogu pidamist finantseeritakse riigieelarvest vastutavale töötlejale selleks otstarbeks eraldatud vahenditest.",
      "rdfs:label": {
        "@value": "Reg_1013853_Par_12 (redaktsioon 1013853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013853",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogu asutamine ja selle põhimäärus",
      "estleg:provisionRef": "Reg_1013853 § 12",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013853_Par_13_v1013853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013853_Par_13"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu likvideerimise otsustab Vabariigi Valitsus. Andmekogu tegevus lõpetatakse kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega. Andmekogu likvideerimise otsustab Vabariigi Valitsus. Andmekogu tegevus lõpetatakse kooskõlas avaliku teabe seaduses ja arhiiviseaduses sätestatud nõuetega.",
      "rdfs:label": {
        "@value": "Reg_1013853_Par_13 (redaktsioon 1013853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013853",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogu asutamine ja selle põhimäärus",
      "estleg:provisionRef": "Reg_1013853 § 13",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013853_Par_2_v1013853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013853_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmekogu pidamise eesmärk on: 1 1) tagada riigi ametiasutustele, nende hallatavatele riigiasutustele ja andmekoguga liitunud põhiseaduslikele institutsioonidele (edaspidi asutus) strateegiliseks ja personalijuhtimiseks vajaliku informatsiooni olemasolu; 2 2) tagada Rahandusministeeriumile avaliku teenistuse arendamiseks ning Riigikogule ülevaate koostamiseks vajalike statistiliste andmete olemasolu. Andmekogu pidamise eesmärk on: tagada riigi ametiasutustele, nende hallatavatele riigiasutustele ja andmekoguga liitunud põhiseaduslikele institutsioonidele (edaspidi asutus) strateegiliseks ja personalijuhtimiseks vajaliku informatsiooni olemasolu; tagada Rahandusministeeriumile avaliku teenistuse arendamiseks ning Riigikogule ülevaate koostamiseks vajalike statistiliste andmete olemasolu.",
      "rdfs:label": {
        "@value": "Reg_1013853_Par_2 (redaktsioon 1013853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013853",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogu asutamine ja selle põhimäärus",
      "estleg:provisionRef": "Reg_1013853 § 2",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013853_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1013853_Par_3_v1013853",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013853_Par_3"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Andmekogu vastutav töötleja on Riigi Tugiteenuste Keskus. Andmekogu vastutav töötleja on Riigi Tugiteenuste Keskus. 2 (2) Andmekogu volitatud töötlejad on Riigi Tugiteenuste Keskus ja muu asutus, kes sisestab andmeid andmekogusse ning peab andmekogus personali- ja palgaarvestust. Andmekogu volitatud töötlejad on Riigi Tugiteenuste Keskus ja muu asutus, kes sisestab andmeid andmekogusse ning peab andmekogus personali- ja palgaarvestust. 2 (2¹) Rahandusministeerium on andmekogu volitatud töötlejaks avaliku teenistuse seaduse § 9 lõikes 2 ja §-s 66 nimetatud ülesannete täitmiseks ning riigiasutustele ja nende hallatavatele asutustele avaliku teenistuse seaduse § 106 lõikes 1 nimetatud informatsiooni andmiseks kasutatava riigiasutuste kuluanalüüsi tarkvara administreerimiseks, sealhulgas andmete automaatseks ülekandeks, vajalikus ulatuses. RT I 2019-04-17 3 117042019003 2019-04-20 Rahandusministeerium on andmekogu volitatud töötlejaks avaliku teenistuse seaduse § 9 lõikes 2 ja §-s 66 nimetatud ülesannete täitmiseks ning riigiasutustele ja nende hallatavatele asutustele avaliku teenistuse seaduse § 106 lõikes 1 nimetatud informatsiooni andmiseks kasutatava riigiasutuste kuluanalüüsi tarkvara administreerimiseks, sealhulgas andmete automaatseks ülekandeks, vajalikus ulatuses. 3 (3) Rahandusministeeriumi Infotehnoloogiakeskus on volitatud töötlejaks andmekogu majutamisel ja hooldamisel. RT I 2016-11-15 15 115112016015 2016-11-18 Rahandusministeeriumi Infotehnoloogiakeskus on volitatud töötlejaks andmekogu majutamisel ja hooldamisel.",
      "rdfs:label": {
        "@value": "Reg_1013853_Par_3 (redaktsioon 1013853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013853",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogu asutamine ja selle põhimäärus",
      "estleg:provisionRef": "Reg_1013853 § 3",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013853_Map_2026"
      }
    },
    {
