      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1013853_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2022-08-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrusega asutatakse riigi infosüsteemi kuuluv andmekogu ametliku nimetusega „Riigi personali- ja palgaarvestuse andmekogu” (edaspidi andmekogu). Määrusega asutatakse riigi infosüsteemi kuuluv andmekogu ametliku nimetusega „Riigi personali- ja palgaarvestuse andmekogu” (edaspidi andmekogu).",
      "rdfs:label": {
        "@value": "Reg_1013853_Par_1 (redaktsioon 1013853)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1013853",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1013853",
      "estleg:sourceAct": "Riigi personali- ja palgaarvestuse andmekogu asutamine ja selle põhimäärus",
      "estleg:provisionRef": "Reg_1013853 § 1",
