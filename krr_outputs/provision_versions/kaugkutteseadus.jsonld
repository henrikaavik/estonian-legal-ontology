      },
      "estleg:versionRedactionId": "113032014036"
    },
    {
      "@id": "estleg:KAUGKU_Par_25_v264432",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:KAUGKU_Par_25"
      },
      "estleg:versionValidFrom": {
