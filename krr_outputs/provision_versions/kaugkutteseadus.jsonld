      },
      "estleg:versionValidFrom": {
        "@value": "2008-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 7 lõikes 3 nimetatud soojusettevõtja peab tagama soojuse tootmiseks reservkütuse kasutamise võimaluse 2008. aasta 1. juuliks. § 42 [Käesolevast tekstist välja jäetud]",
      "rdfs:label": {
        "@value": "KAUGKU_Par_41_1 (redaktsioon 12894819)",
        "@language": "et"
