        "@value": "2003-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Energiaseaduse (RT I 1997, 52, 833; 2001, 52, 303; 88, 531; 93, 565; 2002, 25, 145; 41, 251; 49, 311; 63, 387; 82, 482) alusel ettevõtja ja riigi vahel sõlmitud leping kehtib turuloas märgitud tähtpäevani.",
      "rdfs:label": {
        "@value": "KAUGKU_Par_39 (redaktsioon 264432)",
        "@language": "et"
      },
