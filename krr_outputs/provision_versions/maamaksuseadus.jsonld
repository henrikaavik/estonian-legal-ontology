      }
    },
    {
      "@id": "estleg:MAAMAK_Par_4_v110032022033",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAMAK_Par_4"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maamaksu ei maksta: kehtetu - kaitsealade loodusreservaadi ja sihtkaitsevööndi maalt ning püsielupaikade sihtkaitsevööndi maalt; välisriikide diplomaatiliste ja konsulaaresinduste hoonete või nende osade juurde kuuluvalt maalt; välisriigi või rahvusvahelise organisatsiooni kasutuses olevalt maalt Vabariigi Valitsuse ja välisriigi või rahvusvahelise organisatsiooni vahel sõlmitud lepingu alusel; kehtetu - kirikute ja koguduste pühakodade aluselt maalt; vastava omavalitsusüksuse haldusalal asuvalt munitsipaalmaalt, välja arvatud käesoleva seaduse §-s 10 ettenähtud juhul; avaliku veekogu ja avalikult kasutatava veekogu aluselt maalt; välislepingus sätestatud juhtudel rahvusvahelise sõjalise peakorteri kasutuses olevalt maalt; riigi omandis olevalt ühiskondlike ehitiste maa sihtotstarbega maalt; üldkasutatava maa sihtotstarbega maalt; riigitee, kohaliku tee ja avalikuks kasutamiseks määratud eratee teemaalt. (2) Looduskaitseseaduse §-s 31 sätestatud piiranguvööndimaalt, 5. peatükis sätestatud hoiualade maalt, § 50 lõike 1 alusel määratud püsielupaiga piiranguvööndi maalt ja § 68 alusel sätestatud looduse üksikobjekti piiranguvööndi maalt ning veeseaduse § 118 alusel sätestatud kalda või ranna veekaitsevööndi maalt makstakse maamaksu 50 protsenti maamaksumäärast. (3) Käesoleva paragrahvi lõike 1 punktides 11, 7 ja 11 ning lõikes 2 nimetatud maksuvabastust kohaldatakse vabastuse aluse tekkimisele järgneva aasta 1. jaanuarist. Kui maksuvabastuse alus tekib 1. jaanuaril, kohaldatakse maksuvabastust samast päevast.",
      "rdfs:label": {
        "@value": "MAAMAK_Par_4 (redaktsioon 110032022033)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "110032022033",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAMAK_Par_4_v130062024005"
      },
      "estleg:versionValidTo": {
