      }
    },
    {
      "@id": "estleg:MAAMAK_Par_1_v110112016010",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAMAK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maamaks on maa maksustamishinnast lähtuv maks. (2) Maa maksustamishind määratakse ja selle vaidlustamise kord kehtestatakse, lähtudes maa hindamise seadusest. (3) Maksu- ja Tolliamet arvutab maamaksu kohaliku omavalitsuse üksuse poolt maamaksu infosüsteemi kaudu esitatud alusandmete põhjal. (4) Maakatastris registreerimata maa maamaks arvutatakse sihtotstarbeta maa maksustamishinna alusel.",
      "rdfs:label": {
        "@value": "MAAMAK_Par_1 (redaktsioon 110112016010)",
