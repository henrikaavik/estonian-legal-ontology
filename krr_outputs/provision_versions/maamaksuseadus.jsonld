      },
      "estleg:versionValidFrom": {
        "@value": "2009-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maamaks on maa maksustamishinnast lähtuv maks. (2) Maa maksustamishind määratakse ja selle vaidlustamise kord kehtestatakse, lähtudes maa hindamise seadusest. (3) Maamaks arvutatakse kohalikust omavalitsusest saadud andmete põhjal.",
      "rdfs:label": {
        "@value": "MAAMAK_Par_1 (redaktsioon 12943879)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12943879",
