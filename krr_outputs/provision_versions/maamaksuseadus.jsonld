      }
    },
    {
      "@id": "estleg:MAAMAK_Par_6_v699646",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAMAK_Par_6"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Maamaks laekub omavalitsusüksuse eelarvesse.",
