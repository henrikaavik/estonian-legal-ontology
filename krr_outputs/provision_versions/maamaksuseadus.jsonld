    },
    {
      "@id": "estleg:MAAMAK_Par_1_v22245",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:MAAMAK_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Maamaks on maa maksustamishinnast lähtuv maks. (2) Maa maksustamishind määratakse ja selle vaidlustamise kord kehtestatakse, lähtudes maa hindamise seadusest (RT I 1994, 13, 231; 94, 1609; 1995, 2/3, 4; 1996, 36, 738). (3) Maamaks arvutatakse kohalikust omavalitsusest saadud andmete põhjal.",
      "rdfs:label": {
        "@value": "MAAMAK_Par_1 (redaktsioon 22245)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22245",
      "estleg:supersededByVersion": {
        "@id": "estleg:MAAMAK_Par_1_v12943879"
      },
      "estleg:versionValidTo": {
        "@value": "2008-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:MAAMAK_Par_1_v12943879",
      "@type": [
