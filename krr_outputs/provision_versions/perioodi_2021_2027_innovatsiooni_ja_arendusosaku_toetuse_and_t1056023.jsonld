    {
      "@id": "estleg:Reg_1056023_Par_11_v1056023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056023_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Taotleja on kohustatud täitma ühendmääruse § 2 lõikes 3 sätestatud nõudeid. Taotleja on kohustatud täitma ühendmääruse § 2 lõikes 3 sätestatud nõudeid.",
      "rdfs:label": {
        "@value": "Reg_1056023_Par_11 (redaktsioon 1056023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056023",
      "estleg:sourceAct": "Perioodi 2021–2027 innovatsiooni- ja arendusosaku toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056023 § 11",
