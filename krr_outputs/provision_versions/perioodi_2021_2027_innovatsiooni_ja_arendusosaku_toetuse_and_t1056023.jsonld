        "@id": "estleg:Reg_1056023_Map"
      }
    },
    {
      "@id": "estleg:Reg_1056023_Par_19_v1056023",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1056023_Par_19"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-05-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotlus jäetakse rahuldamata ühendmääruse § 8 lõigetes 2 ja 3 nimetatud juhtudel. Taotlus jäetakse rahuldamata ühendmääruse § 8 lõigetes 2 ja 3 nimetatud juhtudel. 2 (2) Menetluses olevate taotluste kohta, mille rahaline maht ületab meetme tegevuste rahastamise eelarve vaba jäägi ja mida ei ole võimalik vastavalt ühendmääruse § 9 lõikes 1 sätestatule osaliselt rahuldada, tehakse ühendmääruse § 8 lõike 2 punkti 5 alusel taotluse rahuldamata jätmise otsus. Menetluses olevate taotluste kohta, mille rahaline maht ületab meetme tegevuste rahastamise eelarve vaba jäägi ja mida ei ole võimalik vastavalt ühendmääruse § 9 lõikes 1 sätestatule osaliselt rahuldada, tehakse ühendmääruse § 8 lõike 2 punkti 5 alusel taotluse rahuldamata jätmise otsus.",
      "rdfs:label": {
        "@value": "Reg_1056023_Par_19 (redaktsioon 1056023)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1056023",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1056023",
      "estleg:sourceAct": "Perioodi 2021–2027 innovatsiooni- ja arendusosaku toetuse andmise tingimused ja kord",
      "estleg:provisionRef": "Reg_1056023 § 19",
      "estleg:partOfAct": {
