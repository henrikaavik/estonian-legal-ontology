    {
      "@id": "estleg:RPKS_Par_52_v27442",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPKS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete kandmine registrisse ja andmete saamine registrist toimub vastavalt andmekogude seadusele, isikuandmete kaitse seadusele (RT I 1996, 48, 944; 1998, 59, 941; 111, 1833; 2000, 50, 317; 92, 597; 104, 685; 2001, 50, 283), rahvastikuregistri seadusele (RT I 2000, 50, 317; 2001, 31, 173), sotsiaalmaksuseadusele, käesolevale seadusele ja teistele seadustele ning riikliku pensionikindlustuse registri pidamise põhimäärusele.",
      "rdfs:label": {
        "@value": "RPKS_Par_52 (redaktsioon 27442)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "27442",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPKS_Par_52_v925545"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPKS_Par_52_v925545",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPKS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete kandmine registrisse ja andmete saamine registrist toimub vastavalt andmekogude seadusele, isikuandmete kaitse seadusele (RT I 1996, 48, 944; 1998, 59, 941; 111, 1833; 2000, 50, 317; 92, 597; 104, 685; 2001, 50, 283), rahvastikuregistri seadusele (RT I 2000, 50, 317; 2001, 31, 173), sotsiaalmaksuseadusele, käesolevale seadusele ja teistele seadustele ning riikliku pensionikindlustuse registri pidamise põhimäärusele. [Paragrahvi 52 sõnastus alates 1. 01. 2006]",
      "rdfs:label": {
        "@value": "RPKS_Par_52 (redaktsioon 925545)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "925545",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPKS_Par_52_v1036273"
      },
      "estleg:versionValidTo": {
        "@value": "2006-07-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPKS_Par_52_v1036273",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPKS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-08-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Andmete kandmine registrisse ja andmete saamine registrist toimub vastavalt andmekogude seadusele, isikuandmete kaitse seadusele (RT I 1996, 48, 944; 1998, 59, 941; 111, 1833; 2000, 50, 317; 92, 597; 104, 685; 2001, 50, 283), rahvastikuregistri seadusele (RT I 2000, 50, 317; 2001, 31, 173), sotsiaalmaksuseadusele, käesolevale seadusele ja teistele seadustele ning riikliku pensionikindlustuse registri pidamise põhimäärusele. Registrit võivad muu hulgas kasutada kohtud ja kohtutäiturid isikuandmete osas.",
      "rdfs:label": {
        "@value": "RPKS_Par_52 (redaktsioon 1036273)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1036273",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPKS_Par_52_v12883531"
      },
      "estleg:versionValidTo": {
        "@value": "2007-11-25",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPKS_Par_52_v12883531",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPKS_Par_52"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-11-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Andmete kandmine registrisse ja andmete saamine registrist toimub vastavalt andmekogude seadusele, isikuandmete kaitse seadusele, rahvastikuregistri seadusele, sotsiaalmaksuseadusele, käesolevale seadusele ja teistele seadustele ning riikliku pensionikindlustuse registri pidamise põhimäärusele. Registrit võivad muu hulgas kasutada kohtud ja kohtutäiturid isikuandmete osas. (2) Sotsiaalkindlustusamet esitab andmeid tööturuteenuste ja -toetuste seaduse § 8 1 alusel asutatud andmekogusse selle põhimäärusele vastavas mahus ja korras.",
      "rdfs:label": {
        "@value": "RPKS_Par_52 (redaktsioon 12883531)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12883531",
      "estleg:supersededByVersion": {
        "@id": "estleg:RPKS_Par_52_v12889975"
      },
      "estleg:versionValidTo": {
        "@value": "2007-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:RPKS_Par_52_v12889975",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
