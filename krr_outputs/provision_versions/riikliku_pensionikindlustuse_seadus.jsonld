      "estleg:versionValidFrom": {
        "@value": "2021-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 2002. aasta 1. jaanuaril. (2) Käesoleva seaduse § 71 kehtib kuni 2029. aasta 31. detsembrini.",
      "rdfs:label": {
