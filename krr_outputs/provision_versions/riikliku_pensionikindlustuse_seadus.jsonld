        "@value": "2017-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Pensionärile antakse pensionitunnistus, mille andmete loetelu kehtestab määrusega.",
      "rdfs:label": {
        "@value": "RPKS_Par_35 (redaktsioon 106122016004)",
        "@language": "et"
      },
