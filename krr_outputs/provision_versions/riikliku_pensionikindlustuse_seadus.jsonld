    {
      "@id": "estleg:RPKS_Par_60_1_v121042020032",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPKS_Par_60_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2020-04-22",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Hädaolukorra, eriolukorra, erakorralise seisukorra või sõjaseisukorra ajal võib Sotsiaalkindlustusamet valdkonna eest vastutava ministri ettepanekul pikendada püsiva töövõimetuse ekspertiisi otsuse lõpptähtaega, kui uus hindamine on hädaolukorra, eriolukorra, erakorralise seisukorra või sõjaseisukorra tõttu objektiivsetel põhjustel oluliselt takistatud ja püsiva töövõimetuse ekspertiisi otsuse lõpptähtaja pikendamine on vajalik püsivalt töövõimetule inimesele tema sotsiaalsete tagatiste säilimiseks kuni hädaolukorrast, eriolukorrast, erakorralisest seisukorrast või sõjaseisukorrast tingitud ümberkorralduse vajaduse äralangemiseni. , rakendatakse tagasiulatuvalt 2020. aasta 12. märtsist",
      "rdfs:label": {
        "@value": "RPKS_Par_60_1 (redaktsioon 121042020032)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "121042020032"
    },
    {
