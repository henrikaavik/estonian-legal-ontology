    {
      "@id": "estleg:RPKS_Par_7_v27442",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:RPKS_Par_7"
