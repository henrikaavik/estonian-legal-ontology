      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määruse menetlus viidi läbi keskkonnaministri 11. novembri 2016. a käskkirjaga nr 1-2/16/1121 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas. Määruse menetlus viidi läbi keskkonnaministri 11. novembri 2016. a käskkirjaga nr 1-2/16/1121 algatatud haldusmenetluses, mille ülevaade koos ärakuulamise tulemustega on esitatud käesoleva määruse seletuskirjas.",
      "rdfs:label": {
        "@value": "Reg_1044956_Par_20 (redaktsioon 1044956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044956",
      "estleg:sourceAct": "Vaivara maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044956 § 20",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044956_Par_21_v1044956",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1044956_Par_21"
      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist. Määrust on võimalik vaidlustada, esitades kaebuse halduskohtusse halduskohtumenetluse seadustikus sätestatud korras, osas, millest tulenevad kinnisasja omanikule või valdajale õigused ja kohustused, mis puudutavad kinnisasja kasutamist või käsutamist.",
      "rdfs:label": {
        "@value": "Reg_1044956_Par_21 (redaktsioon 1044956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044956",
      "estleg:sourceAct": "Vaivara maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044956 § 21",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044956_Par_3_v1044956",
      "@type": [
        "owl:NamedIndividual",
