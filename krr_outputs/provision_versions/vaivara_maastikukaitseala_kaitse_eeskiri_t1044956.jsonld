      },
      "estleg:versionValidFrom": {
        "@value": "2018-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kaitseala valitseja on Keskkonnaamet. Kaitseala valitseja on Keskkonnaamet.",
      "rdfs:label": {
        "@value": "Reg_1044956_Par_3 (redaktsioon 1044956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044956",
