        "@value": "2018-12-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Tornimäe sihtkaitsevööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks ja maastikuvaate avamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde kujundamine. Tornimäe sihtkaitsevööndis on poollooduslike koosluste esinemisaladel nende ilme ja liigikoosseisu tagamiseks ja maastikuvaate avamiseks vajalik niitmine, loomade karjatamine ning puu- ja põõsarinde kujundamine.",
      "rdfs:label": {
        "@value": "Reg_1044956_Par_11 (redaktsioon 1044956)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1044956",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1044956",
      "estleg:sourceAct": "Vaivara maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_1044956 § 11",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044956_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1044956_Par_12_v1044956",
