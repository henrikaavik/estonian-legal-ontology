      "estleg:provisionRef": "Reg_1062751 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062751_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062751_Par_15_v1062751",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062751_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käitise tegevuskoha lähteolukorra aruanne, kui selle koostamine on tööstusheite seaduse § 57 lõike 1 alusel nõutav. Käitise tegevuskoha lähteolukorra aruanne, kui selle koostamine on tööstusheite seaduse § 57 lõike 1 alusel nõutav.",
