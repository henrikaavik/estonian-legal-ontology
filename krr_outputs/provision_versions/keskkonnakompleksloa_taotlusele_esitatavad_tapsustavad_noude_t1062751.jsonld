    },
    {
      "@id": "estleg:Reg_1062751_Par_16_v1062751",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062751_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Keskkonnaministri 17. detsembri 2019. a määrus nr 73 „Keskkonnakompleksloa taotlusele esitatavad täpsustavad nõuded ja loa andmise kord ning keskkonnakompleksloa taotluse ja loa andmekoosseis” tunnistatakse kehtetuks. Keskkonnaministri 17. detsembri 2019. a määrus nr 73 „Keskkonnakompleksloa taotlusele esitatavad täpsustavad nõuded ja loa andmise kord ning keskkonnakompleksloa taotluse ja loa andmekoosseis” tunnistatakse kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1062751_Par_16 (redaktsioon 1062751)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1062751",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1062751",
      "estleg:sourceAct": "Keskkonnakompleksloa taotlusele esitatavad täpsustavad nõuded ja loa andmise kord ning keskkonnakompleksloa taotluse ja loa andmekoosseis",
      "estleg:provisionRef": "Reg_1062751 § 16",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062751_Map"
      }
    },
    {
      "@id": "estleg:Reg_1062751_Par_2_v1062751",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1062751_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2026-02-02",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kompleksluba koosneb käesoleva määruse lisas ja keskkonnaministri 23. oktoobri 2019. a määruse nr 56 „Keskkonnaloa taotlusele esitatavad täpsustavad nõuded ja loa andmise kord ning keskkonnaloa taotluse ja loa andmekoosseis” § 1 lõikes 3, §-s 402 ja lisades 1–4 nimetatud andmetest. Kompleksluba koosneb käesoleva määruse lisas ja keskkonnaministri 23. oktoobri 2019. a määruse nr 56 „Keskkonnaloa taotlusele esitatavad täpsustavad nõuded ja loa andmise kord ning keskkonnaloa taotluse ja loa andmekoosseis” § 1 lõikes 3, §-s 402 ja lisades 1–4 nimetatud andmetest. 2 (2) Arvestades alltegevusvaldkonna ja käitise asukoha iseärasuste ning avalikustamise asjaoludega, otsustab loa andja, millised käesolevas määruses nimetatud või muud andmed, materjalid, kirjeldused ja teave on vajalikud kompleksloa nõuete sätestamiseks, ning määrab kompleksloa lõpliku andmekoosseisu. Arvestades alltegevusvaldkonna ja käitise asukoha iseärasuste ning avalikustamise asjaoludega, otsustab loa andja, millised käesolevas määruses nimetatud või muud andmed, materjalid, kirjeldused ja teave on vajalikud kompleksloa nõuete sätestamiseks, ning määrab kompleksloa lõpliku andmekoosseisu. 3 (3) Kompleksluba ja selle andmise otsus vormistatakse keskkonnaotsuste infosüsteemis digitaalselt allkirjastatuna. Kompleksluba ja selle andmise otsus vormistatakse keskkonnaotsuste infosüsteemis digitaalselt allkirjastatuna.",
      "rdfs:label": {
        "@value": "Reg_1062751_Par_2 (redaktsioon 1062751)",
        "@language": "et"
      },
