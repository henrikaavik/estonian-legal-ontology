      }
    },
    {
      "@id": "estleg:Reg_158482_Par_14_v158482",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158482_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2010-03-19",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Piiranguvööndis on keelatud:11)uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liigiline ja vanuseline mitmekesisus;22)puidu kokku- ja väljavedu külmumata pinnasel;33)puhtpuistute kujundamine ja energiapuistute rajamine;44)maavara ja maa-ainese kaevandamine, välja arvatud «Maapõueseaduse» §-des 26 ja 62 sätestatud juhtudel valitsejaga kooskõlastatud kohtades;55)biotsiidi ja taimekaitsevahendi kasutamine;66)uue maaparandussüsteemi rajamine. Piiranguvööndis on keelatud: uuendusraie, välja arvatud turberaie, kusjuures tuleb säilitada koosluse liigiline ja vanuseline mitmekesisus; puidu kokku- ja väljavedu külmumata pinnasel; puhtpuistute kujundamine ja energiapuistute rajamine; maavara ja maa-ainese kaevandamine, välja arvatud «Maapõueseaduse» §-des 26 ja 62 sätestatud juhtudel valitsejaga kooskõlastatud kohtades; biotsiidi ja taimekaitsevahendi kasutamine; uue maaparandussüsteemi rajamine.",
      "rdfs:label": {
        "@value": "Reg_158482_Par_14 (redaktsioon 158482)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "158482",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/158482",
      "estleg:sourceAct": "Peetri jõe maastikukaitseala kaitse-eeskiri",
      "estleg:provisionRef": "Reg_158482 § 14",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158482_Map"
      }
    },
