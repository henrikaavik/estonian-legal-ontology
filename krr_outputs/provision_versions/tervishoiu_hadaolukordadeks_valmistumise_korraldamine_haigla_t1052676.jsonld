    {
      "@id": "estleg:Reg_1052676_Par_2_v1052676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052676_Par_2"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-08-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kooskõlas rakenduskavaga on toetuse andmise eesmärk tagada COVID-19 kriisiks valmisolek ja investeeringud haiglavõrgu jätkusuutlikkusse. Kooskõlas rakenduskavaga on toetuse andmise eesmärk tagada COVID-19 kriisiks valmisolek ja investeeringud haiglavõrgu jätkusuutlikkusse. 2 (2) Toetatav projekt panustab vähemalt ühte järgmistest meetme tegevuse väljundinäitajatest: 1 1) COVID-19 patsientide jaoks loodud voodikohad; 2 2) abi saavate haiglavõrgu kavas nimetatud haiglate arv. Toetatav projekt panustab vähemalt ühte järgmistest meetme tegevuse väljundinäitajatest: COVID-19 patsientide jaoks loodud voodikohad; abi saavate haiglavõrgu kavas nimetatud haiglate arv.",
      "rdfs:label": {
        "@value": "Reg_1052676_Par_2 (redaktsioon 1052676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052676",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052676",
      "estleg:sourceAct": "„Tervishoiu hädaolukordadeks valmistumise korraldamine haiglavõrgu kavas nimetatud haiglates” toetuse andmise tingimused avatud taotlemisel",
      "estleg:provisionRef": "Reg_1052676 § 2",
