      "estleg:provisionRef": "Reg_1052676 § 8",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052676_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1052676_Par_9_v1052676",
      "@type": [
        "owl:NamedIndividual",
