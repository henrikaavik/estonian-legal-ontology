    {
      "@id": "estleg:Reg_1052676_Par_11_v1052676",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052676_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2023-08-26",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Taotleja peab olema tervishoiuteenuste korraldamise seaduse § 55 lõike 1 punkti 1 alusel kehtestatud loetelus nimetatud haigla. Taotleja peab olema tervishoiuteenuste korraldamise seaduse § 55 lõike 1 punkti 1 alusel kehtestatud loetelus nimetatud haigla. 2 (2) Taotleja on lisaks perioodi 2014–2020 struktuuritoetuse seaduse § 21 lõikes 2 sätestatule kohustatud: 1 1) vastama Vabariigi Valitsuse 21. augusti 2014. a määruse nr 133 „Perioodi 2014–2020 struktuuritoetuse taotlemise ja taotluste menetlemise nõuded ja tingimused toetuse andmise tingimuste määruse kehtestamiseks” (edaspidi taotluste menetlemise määrus) §-des 2 ja 3 sätestatud nõuetele; 2 2) täitma teisi õigusaktides sätestatud kohustusi ja esitama rakendusüksusele informatsiooni, mis võib mõjutada taotluse kohta otsuse tegemist. Taotleja on lisaks perioodi 2014–2020 struktuuritoetuse seaduse § 21 lõikes 2 sätestatule kohustatud: vastama Vabariigi Valitsuse 21. augusti 2014. a määruse nr 133 „Perioodi 2014–2020 struktuuritoetuse taotlemise ja taotluste menetlemise nõuded ja tingimused toetuse andmise tingimuste määruse kehtestamiseks” (edaspidi taotluste menetlemise määrus) §-des 2 ja 3 sätestatud nõuetele; täitma teisi õigusaktides sätestatud kohustusi ja esitama rakendusüksusele informatsiooni, mis võib mõjutada taotluse kohta otsuse tegemist.",
      "rdfs:label": {
        "@value": "Reg_1052676_Par_11 (redaktsioon 1052676)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052676",
