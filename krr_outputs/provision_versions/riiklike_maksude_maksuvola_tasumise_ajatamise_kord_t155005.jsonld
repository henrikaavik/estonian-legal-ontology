    {
      "@id": "estleg:Reg_155005_Par_1_v155005",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_155005_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2024-07-10",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Riiklike maksude maksuvõla tasumise ajatamise taotlemisel esitab maksumaksja kirjaliku taotluse ja maksuvõla tasumise ajakava Maksu- ja Tolliametile. RT I 2012-05-25 1 125052012001 2012-06-01 Riiklike maksude maksuvõla tasumise ajatamise taotlemisel esitab maksumaksja kirjaliku taotluse ja maksuvõla tasumise ajakava Maksu- ja Tolliametile. 2 (2) Maksumaksja on kohustatud taotluses põhjendama maksuvõla tekkimise ja tasumise ajatamise vajadust. RTL 2004 9 131 698659 2004-02-01+02:00 Maksumaksja on kohustatud taotluses põhjendama maksuvõla tekkimise ja tasumise ajatamise vajadust.",
      "rdfs:label": {
        "@value": "Reg_155005_Par_1 (redaktsioon 155005)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "155005",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/155005",
      "estleg:sourceAct": "Riiklike maksude maksuvõla tasumise ajatamise kord",
      "estleg:provisionRef": "Reg_155005 § 1",
      "estleg:partOfAct": {
