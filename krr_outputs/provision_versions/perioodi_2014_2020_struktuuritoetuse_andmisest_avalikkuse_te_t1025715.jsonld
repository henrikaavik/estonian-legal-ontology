    {
      "@id": "estleg:Reg_1025715_Par_5_v1025715",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1025715_Par_5"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kleebisega tähistatakse ese, millele ei ole logo paigaldatud tootmise käigus. Kleebisega tähistatakse ese, millele ei ole logo paigaldatud tootmise käigus. 2 (2) Kleebist kasutatakse järgmiselt: 1 1) väikesele objektile paigutatakse vertikaalne 26×45 mm suurune kleebis (lisa, joonis 13) või horisontaalne 45×26 mm suurune kleebis (lisa, joonis 14); 2 2) suurele objektile paigutatakse vertikaalne 70×120 mm suurune kleebis (lisa, joonis 15) või horisontaalne 120×70 mm suurune kleebis (lisa, joonis 16). Kleebist kasutatakse järgmiselt: väikesele objektile paigutatakse vertikaalne 26×45 mm suurune kleebis (lisa, joonis 13) või horisontaalne 45×26 mm suurune kleebis (lisa, joonis 14); suurele objektile paigutatakse vertikaalne 70×120 mm suurune kleebis (lisa, joonis 15) või horisontaalne 120×70 mm suurune kleebis (lisa, joonis 16).",
      "rdfs:label": {
        "@value": "Reg_1025715_Par_5 (redaktsioon 1025715)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1025715",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1025715",
      "estleg:sourceAct": "Perioodi 2014–2020 struktuuritoetuse andmisest avalikkuse teavitamise, toetusest rahastatud objektide tähistamise ning Euroopa Liidu osalusele viitamise nõuded ja kord",
      "estleg:provisionRef": "Reg_1025715 § 5",
