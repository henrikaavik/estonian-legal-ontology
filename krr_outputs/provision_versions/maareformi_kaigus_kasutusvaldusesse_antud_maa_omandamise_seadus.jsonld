        "@language": "et"
      },
      "dc:source": "Maareformi käigus kasutusvaldusesse antud maa omandamise seadus"
    },
    {
      "@id": "estleg:MaaRKMOS_Par_1_v13157586",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
