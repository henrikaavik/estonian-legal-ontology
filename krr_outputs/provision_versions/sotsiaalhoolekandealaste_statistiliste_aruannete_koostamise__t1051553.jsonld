    {
      "@id": "estleg:Reg_1051553_Par_2_v1051553",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1051553_Par_2"
