    {
      "@id": "estleg:Reg_310688_Par_14_v310688",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_310688_Par_14"
