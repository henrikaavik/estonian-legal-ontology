    {
      "@id": "estleg:Reg_322235_Par_2_v322235",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_322235_Par_2"
