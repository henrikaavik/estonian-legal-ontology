      },
      "estleg:versionValidFrom": {
        "@value": "2024-12-11",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Kohtute infosüsteemi kantakse kohtuasjad, mis on alustatud 1. jaanuaril 2006. a ja hiljem. Kohtute infosüsteemi kantakse kohtuasjad, mis on alustatud 1. jaanuaril 2006. a ja hiljem. 2 (2) Registrisse kantakse kohtuasjad, milles ei olnud 1. jaanuariks 2006. a jõustunud menetlust lõpetavat lahendit. Registrisse kantakse kohtuasjad, milles ei olnud 1. jaanuariks 2006. a jõustunud menetlust lõpetavat lahendit. 3 (3) Registrisse kantakse enne 1. jaanuari 2006. a lõpetatud kohtuasjad, milles tuleb pärast 1. jaanuari 2006. a teha menetlustoiminguid. Registrisse kantakse enne 1. jaanuari 2006. a lõpetatud kohtuasjad, milles tuleb pärast 1. jaanuari 2006. a teha menetlustoiminguid.",
      "rdfs:label": {
        "@value": "Reg_301966_Par_21 (redaktsioon 301966)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "301966",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/301966",
      "estleg:sourceAct": "Kohtute infosüsteemi põhimäärus",
      "estleg:provisionRef": "Reg_301966 § 21",
