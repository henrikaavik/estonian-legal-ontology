      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_43"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-04-15",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Kehtetu -",
      "rdfs:label": {
        "@value": "ELEKTR_Par_43 (redaktsioon 729115)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "729115",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELEKTR_Par_43_v12789421"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-19",
