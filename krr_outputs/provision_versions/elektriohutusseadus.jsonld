        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Elektriohutusseadus (267 versiooni)",
        "@language": "et"
      },
      "dc:source": "Elektriohutusseadus"
    },
    {
      "@id": "estleg:ELEKTR_Par_1_v25863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab elektriseadmete, -paigaldiste ja -tööde ning elektromagnetilise ühilduvuse üldnõuded ning nende nõuete täitmise üle riikliku järelevalve teostamise korra.",
      "rdfs:label": {
        "@value": "ELEKTR_Par_1 (redaktsioon 25863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25863",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELEKTR_Par_1_v171142"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELEKTR_Par_1_v171142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab inimesele, varale ja keskkonnale elektrist tulenevate ohtude ja elektromagnetiliste häirete vältimise ja vähendamise eesmärgil nõuded: elektriseadmele ja -paigaldisele, nende turule laskmisele, kasutusele võtmisele ja kasutamisele ning nõuetele vastavuse hindamise ja tõendamise korrale; elektripaigaldise omanikule, tunnustatud asutusele, elektritöö ettevõtjale, tehnilise kontrolli teostajale, isiku nõuetele vastavuse hindajale ja tõendajale, elektripaigaldise käidu korraldajale ja elektritööd juhtivale isikule; ettevõtja registreerimisele ja riikliku järelevalve teostamisele.",
      "rdfs:label": {
        "@value": "ELEKTR_Par_1 (redaktsioon 171142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171142",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELEKTR_Par_1_v12789421"
      },
      "estleg:versionValidTo": {
        "@value": "2007-07-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELEKTR_Par_1_v12789421",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-07-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab inimesele, varale ja keskkonnale elektrist tulenevate ohtude ja elektromagnetiliste häirete vältimise ja vähendamise eesmärgil nõuded: elektriseadmele ja -paigaldisele, nende turule laskmisele, kasutusele võtmisele ja kasutamisele ning nõuetele vastavuse hindamise ja tõendamise korrale; elektripaigaldise omanikule, teavitatud asutusele, elektritöö ettevõtjale, tehnilise kontrolli teostajale, personali sertifitseerimise asutusele, elektripaigaldise käidu korraldajale ja elektritöö juhile; ettevõtja registreerimisele ja riikliku järelevalve teostamisele.",
      "rdfs:label": {
        "@value": "ELEKTR_Par_1 (redaktsioon 12789421)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12789421",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELEKTR_Par_1_v129062014015"
      },
      "estleg:versionValidTo": {
        "@value": "2014-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELEKTR_Par_1_v129062014015",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2014-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus sätestab inimesele, varale ja keskkonnale elektrist tulenevate ohtude ja elektromagnetiliste häirete vältimise ja vähendamise eesmärgil nõuded: elektriseadmele ja -paigaldisele, nende turule laskmisele, kasutusele võtmisele ja kasutamisele ning nõuetele vastavuse hindamise ja tõendamise korrale; elektripaigaldise omanikule, teavitatud asutusele, elektritöö ettevõtjale, tehnilise kontrolli teostajale, personali sertifitseerimise asutusele, elektripaigaldise käidu korraldajale ja elektritöö juhile. kehtetu -",
      "rdfs:label": {
        "@value": "ELEKTR_Par_1 (redaktsioon 129062014015)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "129062014015"
    },
    {
      "@id": "estleg:ELEKTR_Par_10_v25863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Ehitatud või ümberehitatud elektripaigaldise esmakordse kasutuselevõtu kohta peab elektripaigaldise valdaja esitama teatise sellele võrguettevõtjale või elektrienergia tootjale, kelle tegevuspiirkonnas elektripaigaldis asub. (2) Käesoleva seaduse paragrahv 9 lõikes 2 nimetatud elektripaigaldise kohta, mille suhtes viidi läbi nõuetekohasuse hindamine, peab vastavalt kas volitatud tõendamisasutus või lisakontrolliõigusega elektritööde ettevõtja esitama teatise Tehnilise Järelevalve Inspektsioonile. (3) Võrguettevõtjad ja elektrienergia tootjad peavad oma tegevuspiirkonnas asuvate elektripaigaldiste registrit. (4) Käesoleva paragrahvi lõigetes 1 ja 2 ettenähtud teatise esitamise ja lõikes 3 nimetatud registrite pidamise kord kehtestatakse majandusministri määrusega.",
      "rdfs:label": {
        "@value": "ELEKTR_Par_10 (redaktsioon 25863)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "25863",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELEKTR_Par_10_v171142"
      },
      "estleg:versionValidTo": {
        "@value": "2002-06-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELEKTR_Par_10_v171142",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektriseadet tuleb kavandada, projekteerida, toota, remontida ja ümber ehitada nii, et see nõuetele vastava paigaldamise ja ettenähtud otstarbel kasutamise korral ei tekitaks lubamatuid elektrilisi ega elektromagnetilisi häireid ja oleks küllaldaselt häirekindel. (2) Elektripaigaldist tuleb projekteerida, ehitada, katsetada, remontida, hooldada ja kontrollida nii, et see ettenähtud otstarbel kasutamise korral ei tekitaks lubamatuid elektrilisi ega elektromagnetilisi häireid ja oleks küllaldaselt häirekindel. (3) Käesolevas seaduses ja selle alusel kehtestatud elektromagnetilise ühilduvuse nõudeid ei kohaldata järgmistele elektriseadmetele või -paigaldistele: telekommunikatsiooniseadmele, sealhulgas telekommunikatsiooni terminaliseadmele ja raadioseadmele, mille elektromagnetilise ühilduvuse nõuded on osaliselt või täielikult kaetud teises seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetega; varuosale, lisaseadmele ning muudele elektrilistele ja elektroonilistele komponentidele, välja arvatud, kui neid on võimalik iseseisvalt kasutada; raadioamatööride poolt kasutatavale seadmele, välja arvatud, kui sellised seadmed on kaubanduslikult kättesaadavad.",
      "rdfs:label": {
        "@value": "ELEKTR_Par_10 (redaktsioon 171142)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "171142",
      "estleg:supersededByVersion": {
        "@id": "estleg:ELEKTR_Par_10_v235067"
      },
      "estleg:versionValidTo": {
        "@value": "2002-12-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:ELEKTR_Par_10_v235067",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:ELEKTR_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-12-31",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Elektriseadet tuleb kavandada, projekteerida, toota, remontida ja ümber ehitada nii, et see nõuetele vastava paigaldamise ja ettenähtud otstarbel kasutamise korral ei tekitaks lubamatuid elektrilisi ega elektromagnetilisi häireid ja oleks küllaldaselt häirekindel. (2) Elektripaigaldist tuleb projekteerida, ehitada, katsetada, remontida, hooldada ja kontrollida nii, etseeettenähtud otstarbel kasutamise korral ei tekitaks lubamatuid elektrilisi ega elektromagnetilisi häireid ja oleks küllaldaselt häirekindel. (3) Käesolevas seaduses ja selle alusel kehtestatud elektromagnetilise ühilduvuse nõudeid ei kohaldata järgmistele elektriseadmetele või -paigaldistele: telekommunikatsiooniseadmele, sealhulgas telekommunikatsiooni terminaliseadmele ja raadioseadmele, mille elektromagnetilise ühilduvuse nõuded on osaliselt või täielikult kaetud teises seaduses või selle alusel kehtestatud õigusaktides sätestatud nõuetega; varuosale, lisaseadmele ning muudele elektrilistele ja elektroonilistele komponentidele, välja arvatud, kui neid on võimalik iseseisvalt kasutada; raadioamatööride poolt kasutatavale seadmele, välja arvatud, kui sellised seadmed on kaubanduslikult kättesaadavad.",
      "rdfs:label": {
        "@value": "ELEKTR_Par_10 (redaktsioon 235067)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "235067",
