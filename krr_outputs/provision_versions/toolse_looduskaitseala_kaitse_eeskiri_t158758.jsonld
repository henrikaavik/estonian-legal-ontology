    {
      "@id": "estleg:Reg_158758_Par_4_v158758",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_158758_Par_4"
