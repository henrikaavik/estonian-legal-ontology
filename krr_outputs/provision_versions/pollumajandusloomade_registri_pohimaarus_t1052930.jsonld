    {
      "@id": "estleg:Reg_1052930_Par_15_v1052930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052930_Par_15"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Registrisse kantakse andmed järgmiste dokumentide alusel: 1 1) majandustegevuse seadustiku üldosa seaduse §-s 58 nimetatud dokumendid; 2 2) veterinaarseaduse § 25 lõikes 4 nimetatud andmeid sisaldav teade; 3 3) Euroopa Parlamendi ja nõukogu määruse (EL) 2016/429 (ELT L 84, 31.03.2016, lk 1–208) artikli 109 alusel kehtestatud õigusaktis nimetatud dokumendid põllumajandusloomade kohta. Registrisse kantakse andmed järgmiste dokumentide alusel: majandustegevuse seadustiku üldosa seaduse §-s 58 nimetatud dokumendid; veterinaarseaduse § 25 lõikes 4 nimetatud andmeid sisaldav teade; Euroopa Parlamendi ja nõukogu määruse (EL) 2016/429 (ELT L 84, 31.03.2016, lk 1–208) artikli 109 alusel kehtestatud õigusaktis nimetatud dokumendid põllumajandusloomade kohta.",
      "rdfs:label": {
        "@value": "Reg_1052930_Par_15 (redaktsioon 1052930)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1052930",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1052930",
      "estleg:sourceAct": "Põllumajandusloomade registri põhimäärus",
      "estleg:provisionRef": "Reg_1052930 § 15",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052930_Map"
      }
    },
    {
      "@id": "estleg:Reg_1052930_Par_16_v1052930",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1052930_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-09-29",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Registriandmed tunnistatakse kehtetuks majandustegevuse seadustiku üldosa seaduse §-s 61 sätestatud juhtudel. Registriandmed tunnistatakse kehtetuks majandustegevuse seadustiku üldosa seaduse §-s 61 sätestatud juhtudel. 2 (2) Alusdokumente säilitatakse majandustegevuse seadustiku üldosa seaduse § 64 lõikes 3 sätestatud korras ja tähtaja jooksul. Alusdokumente säilitatakse majandustegevuse seadustiku üldosa seaduse § 64 lõikes 3 sätestatud korras ja tähtaja jooksul. 3 (3) Kehtetuks tunnistatud registriandmeid, mis sisaldavad isikuandmeid, säilitatakse lõikes 2 viidatud tähtaja jooksul. Kehtetuks tunnistatud registriandmeid, mis sisaldavad isikuandmeid, säilitatakse lõikes 2 viidatud tähtaja jooksul. 4 (4) Alusdokumente, mis ei ole esitatud majandustegevuse seadustiku üldosa seaduse alusel, säilitatakse viis aastat alates dokumendi esitamisest. Alusdokumente, mis ei ole esitatud majandustegevuse seadustiku üldosa seaduse alusel, säilitatakse viis aastat alates dokumendi esitamisest.",
      "rdfs:label": {
        "@value": "Reg_1052930_Par_16 (redaktsioon 1052930)",
        "@language": "et"
      },
