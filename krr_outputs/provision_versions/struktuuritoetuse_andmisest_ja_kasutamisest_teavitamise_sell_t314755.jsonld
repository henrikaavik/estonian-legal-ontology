    {
      "@id": "estleg:Reg_314755_Par_14_v314755",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_314755_Par_14"
      },
      "estleg:versionValidFrom": {
        "@value": "2017-04-21",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Vastavalt «Perioodi 2007–2013 struktuuritoetuse seaduse» § 25 lõikes 5 sätestatule avalikustab rakendusüksus, Euroopa territoriaalse koostöö rakenduskavade puhul vastava rakenduskava ühine tehniline sekretariaat, struktuuritoetusest rahastatud projekti kohta vähemalt järgmised andmed: 1 1) struktuuritoetuse saaja nimi; 2 2) projekti nimi; 3 3) struktuuritoetuse summa. RT I 2010 6 19 13271790 2010-02-14 Vastavalt «Perioodi 2007–2013 struktuuritoetuse seaduse» § 25 lõikes 5 sätestatule avalikustab rakendusüksus, Euroopa territoriaalse koostöö rakenduskavade puhul vastava rakenduskava ühine tehniline sekretariaat, struktuuritoetusest rahastatud projekti kohta vähemalt järgmised andmed: struktuuritoetuse saaja nimi; projekti nimi; struktuuritoetuse summa. 2 (2) Lisaks lõikes 1 nimetatud andmetele avalikustatakse võimalusel ka projekti kestus. Lisaks lõikes 1 nimetatud andmetele avalikustatakse võimalusel ka projekti kestus. 3 (3) Euroopa territoriaalse koostöö rakenduskavade alusel struktuuritoetusest rahastatud projekti andmed avalikustab vastava rakenduskava ühine tehniline sekretariaat Euroopa territoriaalse koostöö rakenduskavade veebilehel. RT I 2010 6 19 13271790 2010-02-14 Euroopa territoriaalse koostöö rakenduskavade alusel struktuuritoetusest rahastatud projekti andmed avalikustab vastava rakenduskava ühine tehniline sekretariaat Euroopa territoriaalse koostöö rakenduskavade veebilehel.",
      "rdfs:label": {
        "@value": "Reg_314755_Par_14 (redaktsioon 314755)",
        "@language": "et"
      },
