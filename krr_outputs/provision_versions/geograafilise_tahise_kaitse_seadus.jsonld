    {
      "@id": "estleg:GTKS_Par_42_v22457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_42"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Pärast registreeringu tegemist annab Patendiamet 10 tööpäeva jooksul taotlejale välja tunnistuse. (2) Pärast registreeringu andmete muutmist annab Patendiamet taotlejale ühe kuu jooksul välja tunnistuse lisa.",
      "rdfs:label": {
        "@value": "GTKS_Par_42 (redaktsioon 22457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22457",
      "estleg:supersededByVersion": {
