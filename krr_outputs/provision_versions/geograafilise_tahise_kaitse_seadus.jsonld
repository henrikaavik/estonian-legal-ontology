    },
    {
      "@id": "estleg:GTKS_Par_7_v22457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_7"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Geograafilise tähise õiguskaitse on tähtajatu.",
      "rdfs:label": {
        "@value": "GTKS_Par_7 (redaktsioon 22457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22457"
    },
    {
      "@id": "estleg:GTKS_Par_8_v22457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_8"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Õiguskaitset ei tagata tähisele, mis: eksitab avalikkust kauba või teenuse geograafilise päritolu suhtes; tähistab kaupa või teenust, mille konkreetne omadus, maine või muu iseloomulik tunnus ei ole olulisel määral seostatav kauba või teenuse geograafilise päritoluga; vaatamata kauba või teenuse tegeliku geograafilise päritolu tõepärasele kajastamisele võib tekitada avalikkuses vale arusaama, et kaup või teenus pärineb teiselt geograafiliselt alalt; on vastuolus avaliku korra või heade tavadega; on algse geograafilise päritolu tähenduse kaotanud ja muutunud kauba või teenuse üldnimeks ja on kasutusel kauba või teenuse liigi, kvaliteedi, sordi või muude omaduste või tunnuste tähistamiseks; sisaldab loomatõu või taimesordi nime või on sellega eksitavalt sarnane; ei ole saanud õiguskaitset oma päritoluriigis või mille õiguskaitse on seal lõpetatud või mille kasutamisest on seal loobutud.",
      "rdfs:label": {
        "@value": "GTKS_Par_8 (redaktsioon 22457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22457"
    },
    {
      "@id": "estleg:GTKS_Par_9_v22457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_9"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Geograafilise tähise registreerimise taotlemise õigus on: isikul, kes tegutseb tähisega tähistatava kauba tootjana, töötlejana või müügiks ettevalmistajana või teenuse osutajana tähises näidatud geograafilisel alal; tarbijate või käesoleva lõike punktis 1 nimetatud isikute ühendusel, sõltumata selle asukohast ja juriidilisest vormist; kauba või teenuse päritoluriigi pädeval ametiasutusel. (2) Käesoleva paragrahvi lõikes 1 nimetatud isik võib taotleda ainult sellise tähise registreerimist, mis vastab geograafilisele tähisele esitatud nõuetele ja on kooskõlas käesoleva seaduse §-s 4 sätestatuga ega ole §-s 8 sätestatu järgi mittekaitstav. (3) Geograafilise tähise registreerimise taotlemiseks pädevate Eesti ametiasutuste loetelu kinnitab Vabariigi Valitsus.",
      "rdfs:label": {
        "@value": "GTKS_Par_9 (redaktsioon 22457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22457",
      "estleg:supersededByVersion": {
        "@id": "estleg:GTKS_Par_9_v731008"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
