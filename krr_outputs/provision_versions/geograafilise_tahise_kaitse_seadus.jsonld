  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_geograafilise_tahise_kaitse_seadus_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Geograafilise tähise kaitse seadus (137 versiooni)",
        "@language": "et"
      },
      "dc:source": "Geograafilise tähise kaitse seadus"
    },
    {
      "@id": "estleg:GTKS_Par_1_v22457",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-06-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesolev seadus reguleerib loodusliku, põllumajandusliku, käsitööndusliku või tööstusliku päritoluga kaupade, samuti teenuste tähistamiseks kasutatavate geograafiliste tähiste õiguskaitset.",
      "rdfs:label": {
        "@value": "GTKS_Par_1 (redaktsioon 22457)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "22457",
      "estleg:supersededByVersion": {
        "@id": "estleg:GTKS_Par_1_v731008"
      },
      "estleg:versionValidTo": {
        "@value": "2004-04-30",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:GTKS_Par_1_v731008",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2004-05-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib loodusliku, põllumajandusliku, käsitööndusliku või tööstusliku päritoluga kaupade ja teenuste tähistamiseks kasutatavate geograafiliste tähiste õiguskaitset, välja arvatud Euroopa Ühenduse tasandil kaitstavate põllumajandustoodete, toiduainete ja alkohoolsete jookide geograafilisi tähiseid ja päritolunimetusi. (2) EL nõukogu määruses 2081/1992/EÜ põllumajandustoodete ja toiduainete geograafiliste tähiste ja päritolunimetuste kaitse kohta (Euroopa Liidu Teataja L 208, 24.07.1992, lk 1–8) sätestatud siseriiklikke toiminguid ning Euroopa Ühenduse tasandil kaitstavate alkohoolsete jookide geograafiliste tähiste ja päritolunimetuste osas ettenähtud siseriiklikke toiminguid teeb Põllumajandusministeerium.",
      "rdfs:label": {
        "@value": "GTKS_Par_1 (redaktsioon 731008)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "731008",
      "estleg:supersededByVersion": {
        "@id": "estleg:GTKS_Par_1_v12766120"
      },
      "estleg:versionValidTo": {
        "@value": "2006-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:GTKS_Par_1_v12766120",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:GTKS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2007-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus reguleerib loodusliku, põllumajandusliku, käsitööndusliku või tööstusliku päritoluga kaupade ja teenuste tähistamiseks kasutatavate geograafiliste tähiste õiguskaitset, välja arvatud Euroopa Ühenduse tasandil kaitstavate põllumajandustoodete, toiduainete ja alkohoolsete jookide geograafilisi tähiseid ja päritolunimetusi.",
      "rdfs:label": {
        "@value": "GTKS_Par_1 (redaktsioon 12766120)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "12766120",
