      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Euroopa Liidu liikmesriigis elavate ning kooliekskursioonil osalevate kolmandate riikide kodakondsusega õpilaste nimekirja vorm ning selle täitmise kord ja kasutamise juhend (4 versiooni)",
        "@language": "et"
      },
      "dc:source": "Euroopa Liidu liikmesriigis elavate ning kooliekskursioonil osalevate kolmandate riikide kodakondsusega õpilaste nimekirja vorm ning selle täitmise kord ja kasutamise juhend"
    },
    {
      "@id": "estleg:Reg_346267_Par_1_v346267",
