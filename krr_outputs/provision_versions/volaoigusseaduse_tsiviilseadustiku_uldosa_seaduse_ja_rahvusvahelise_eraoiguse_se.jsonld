  "@graph": [
    {
      "@id": "estleg:ProvisionVersions_volaoigusseaduse_tsiviilseadustiku_uldosa_seaduse_ja_rahvusvahelise_eraoiguse_se_Map",
      "@type": [
        "owl:Ontology"
      ],
      "rdfs:label": {
        "@value": "Sätete redaktsioonid: Võlaõigusseaduse, tsiviilseadustiku üldosa seaduse ja rahvusvahelise eraõiguse seaduse rakendamise seadus (53 versiooni)",
        "@language": "et"
      },
      "dc:source": "Võlaõigusseaduse, tsiviilseadustiku üldosa seaduse ja rahvusvahelise eraõiguse seaduse rakendamise seadus"
    },
    {
      "@id": "estleg:VOSRS_Par_1_v174795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_1"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Võlaõigusseadus, tsiviilseadustiku üldosa seadus (RT I 2002, 35, 216) ja rahvusvahelise eraõiguse seadus (RT I 2002, 35, 217) jõustuvad 1. juulil 2002. (2) Võlaõigusseaduse § 323 jõustub 1. juulil 2003. (3) Võlaõigusseaduse 22. peatüki 2. jagu jõustub 1. septembril 2002. (4) Võlaõigusseaduse § 720 lõige 6 jõustub 1. jaanuaril 2003.",
      "rdfs:label": {
        "@value": "VOSRS_Par_1 (redaktsioon 174795)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "174795"
    },
    {
      "@id": "estleg:VOSRS_Par_10_v174795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_10"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Käesoleva seaduse § 9 kohaldatakse vastavalt ka tähtaegade suhtes, millega on seotud õiguse maksmapanek, omandamine või lõppemine.",
      "rdfs:label": {
        "@value": "VOSRS_Par_10 (redaktsioon 174795)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "174795"
    },
    {
      "@id": "estleg:VOSRS_Par_11_v174795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_11"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Võlasuhtele, mis on tekkinud enne 1. juulit 2002, kohaldatakse enne käesoleva seaduse jõustumist kehtinud seadust.",
      "rdfs:label": {
        "@value": "VOSRS_Par_11 (redaktsioon 174795)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "174795"
    },
    {
      "@id": "estleg:VOSRS_Par_12_v174795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_12"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Enne 1. juulit 2002 sõlmitud kestvuslepingutele kohaldatakse alates 1. juulist 2002 tsiviilseadustiku üldosa seaduses ning võlaõigusseaduses sätestatut. (2) Käesoleva paragrahvi lõikes 1 sätestatu ei välista ega piira lepingupoolte õigusi ja kohustusi, mis on tekkinud enne 1. juulit 2002. Kestvuslepinguga seotud asjaoludele või toimingutele, mis on tekkinud või tehtud enne 1. juulit 2002, kohaldatakse senikehtinud seadust. (3) Kui kestvuslepingu tingimus on pärast käesoleva paragrahvi lõikes 1 nimetatud seaduste jõustumist vastuolus seaduse sättega, millest ei ole võimalik lepingupoolte kokkuleppel kõrvale kalduda, kohaldatakse lepingutingimuse asemel seaduses sätestatut. (4) Kui käesoleva paragrahvi lõikes 3 nimetatud lepingutingimus sisaldub ühe lepingupoole tüüptingimustes, on tüüptingimuste kasutaja kohustatud viima 2003. aasta 1. jaanuariks lepingu suhtes kehtivad tüüptingimused kooskõlla seadusega.",
      "rdfs:label": {
        "@value": "VOSRS_Par_12 (redaktsioon 174795)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "174795"
    },
    {
      "@id": "estleg:VOSRS_Par_123_v174795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Ülikooliseaduses (RT I 1995, 12, 119; 1996, 49, 953; 51, 965; 1997, 42, 678; 1998, 57, 859; 1999, 10, 150; 102, 908; 2000, 25, 140; 78, 496; 2001, 16, 71; 2002, 21, 117) tehakse järgmised muudatused ja täiendused: paragrahv 8 muudetakse ja sõnastatakse järgmiselt: « § 8. Ülikooli lõpetamine (1) Ülikooli lõpetamine toimub likvideerimismenetluse korras vastavalt tsiviilseadustiku üldosa seadusele (RT I 2002, 35, 216). (2) Ülikool lõpetatakse, kui: on ära langenud edasise tegevuse vajadus; pole võimalik ülikooli finantseerida; õppetase ei vasta nõuetele. (3) Käesoleva paragrahvi lõike 2 punktis 3 nimetatud juhul eelneb lõpetamisele õppetaseme hindamine vähemalt kahe erineva koosseisuga hindamiskomisjoni poolt. (4) Ülikooli lõpetamise otsustab Vabariigi Valitsuse ettepanekul Riigikogu.»; paragrahvi § 44 lõige 4 ning § 47 lõige 2 tunnistatakse kehtetuks; paragrahvi 48 täiendatakse lõikega 7 järgmises sõnastuses: « (7) Käesolevas paragrahvis sätestatu ei piira ülikooli õigusvõimet.»",
      "rdfs:label": {
        "@value": "VOSRS_Par_123 (redaktsioon 174795)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "174795",
      "estleg:supersededByVersion": {
        "@id": "estleg:VOSRS_Par_123_v927236"
      },
      "estleg:versionValidTo": {
        "@value": "2005-12-31",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VOSRS_Par_123_v927236",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_123"
      },
      "estleg:versionValidFrom": {
        "@value": "2006-01-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "[Käesolevast tekstist välja jäetud.]",
      "rdfs:label": {
        "@value": "VOSRS_Par_123 (redaktsioon 927236)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "927236"
    },
    {
      "@id": "estleg:VOSRS_Par_124_v174795",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_124"
      },
      "estleg:versionValidFrom": {
        "@value": "2002-07-01",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1. juulil 2002. (2) Käesoleva seaduse § 25 jõustub seaduse Riigi Teatajas avaldamisele järgneval päeval. (3) Vabariigi Valitsus korraldab kahe nädala jooksul, arvates käesoleva seaduse jõustumisest, võlaõigusseaduse tervikteksti koos kõigi muudatustega avaldamise Riigi Teatajas. Metaandmetes on vale redaktsiooni kehtivuse lõpu kuupäev 26.12.2003 asendatud õige kuupäevaga 19.12.2003. Alus: \"Riigi Teataja seaduse\" § 17 lõige 3 2 .",
      "rdfs:label": {
        "@value": "VOSRS_Par_124 (redaktsioon 174795)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "174795",
      "estleg:supersededByVersion": {
        "@id": "estleg:VOSRS_Par_124_v687390"
      },
      "estleg:versionValidTo": {
        "@value": "2003-12-19",
        "@type": "xsd:date"
      }
    },
    {
      "@id": "estleg:VOSRS_Par_124_v687390",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:VOSRS_Par_124"
      },
      "estleg:versionValidFrom": {
        "@value": "2003-12-20",
        "@type": "xsd:date"
      },
      "estleg:versionText": "(1) Käesolev seadus jõustub 1. juulil 2002. (2) Käesoleva seaduse § 25 jõustub seaduse Riigi Teatajas avaldamisele järgneval päeval. (3) Vabariigi Valitsus korraldab kahe nädala jooksul, arvates käesoleva seaduse jõustumisest, võlaõigusseaduse tervikteksti koos kõigi muudatustega avaldamise Riigi Teatajas. Õiend Metaandmetes on vale redaktsiooni kehtivuse lõpu kuupäev 31.12.2005 asendatud õige kuupäevaga 26.12.2003 ja § 7-s on eemaldatud 27.12.2003 jõustuv sõnastus. Alus: \"Riigi Teataja seaduse\" § 17 lõige 3 2 .",
      "rdfs:label": {
        "@value": "VOSRS_Par_124 (redaktsioon 687390)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "687390",
