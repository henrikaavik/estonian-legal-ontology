      "estleg:provisionRef": "Reg_1063269 § 6",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063269_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1063269_Par_7_v1063269",
      "@type": [
