      "estleg:versionValidFrom": {
        "@value": "2026-04-13",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetus makstakse toetuse saaja arvelduskontole ettemaksena taotluse rahuldamise otsuses määratud tingimustel kümne tööpäeva jooksul. Toetus makstakse toetuse saaja arvelduskontole ettemaksena taotluse rahuldamise otsuses määratud tingimustel kümne tööpäeva jooksul.",
      "rdfs:label": {
        "@value": "Reg_1063269_Par_17 (redaktsioon 1063269)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1063269",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1063269",
      "estleg:sourceAct": "Tuletõrjespordi edendamiseks toetuse andmise ning selle kasutamise tingimused ja kord",
      "estleg:provisionRef": "Reg_1063269 § 17",
      "estleg:partOfAct": {
