      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse andja on Sihtasutus Kodanikuühiskonna Sihtkapital (edaspidi KÜSK või toetuse andja), kes kuulutab taotlusvooru välja, menetleb toetuse taotlusi (edaspidi taotlus), teeb toetuse väljamakseid ja teostab järelevalvet toetuse kasutamise üle. Toetuse andja on Sihtasutus Kodanikuühiskonna Sihtkapital (edaspidi KÜSK või toetuse andja), kes kuulutab taotlusvooru välja, menetleb toetuse taotlusi (edaspidi taotlus), teeb toetuse väljamakseid ja teostab järelevalvet toetuse kasutamise üle.",
      "rdfs:label": {
        "@value": "Reg_1060767_Par_3 (redaktsioon 1060767)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060767",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060767",
      "estleg:sourceAct": "Kodanikuühiskonna Nupukate Lahenduste starditoetuse tingimused ja kord",
      "estleg:provisionRef": "Reg_1060767 § 3",
