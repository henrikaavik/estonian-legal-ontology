        "@type": "xsd:date"
      },
      "estleg:versionText": "Toetuse saaja otsuse või toimingu peale võib esitada vaide haldusmenetluse seaduses sätestatud korras. Vaide lahendab toetuse andja. Toetuse saaja otsuse või toimingu peale võib esitada vaide haldusmenetluse seaduses sätestatud korras. Vaide lahendab toetuse andja.",
      "rdfs:label": {
