      "estleg:sourceAct": "Kodanikuühiskonna Nupukate Lahenduste starditoetuse tingimused ja kord",
      "estleg:provisionRef": "Reg_1060767 § 19",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060767_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1060767_Par_2_v1060767",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
