      }
    },
    {
      "@id": "estleg:Reg_1060767_Par_16_v1060767",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ProvisionVersion"
      ],
      "estleg:versionOf": {
        "@id": "estleg:Reg_1060767_Par_16"
      },
      "estleg:versionValidFrom": {
        "@value": "2025-04-07",
        "@type": "xsd:date"
      },
      "estleg:versionText": "1 (1) Pärast taotluse rahuldamise otsust sõlmib toetuse andja toetuse saajaga riigieelarvelise toetuse lepingu (edaspidi leping). Lepingu allkirjastab KÜSK-i juhatus. Pärast taotluse rahuldamise otsust sõlmib toetuse andja toetuse saajaga riigieelarvelise toetuse lepingu (edaspidi leping). Lepingu allkirjastab KÜSK-i juhatus. 2 (2) Leping sõlmitakse toetuse andmise tingimuste ja korralduse täpsustamiseks ning aruandluse sätestamiseks. Leping sõlmitakse toetuse andmise tingimuste ja korralduse täpsustamiseks ning aruandluse sätestamiseks. 3 (3) Toetus makstakse toetuse saajale välja lepingus määratud tingimustel. Toetus makstakse toetuse saajale välja lepingus määratud tingimustel. 4 (4) Kui lepingut ei ole võimalik toetuse saaja poolsetel põhjustel sõlmida 20 tööpäeva jooksul arvates taotluse rahuldamise otsuse kättetoimetamisest toetuse saajale, on toetuse andjal õigus tunnistada taotluse rahuldamise otsus kehtetuks. Kui lepingut ei ole võimalik toetuse saaja poolsetel põhjustel sõlmida 20 tööpäeva jooksul arvates taotluse rahuldamise otsuse kättetoimetamisest toetuse saajale, on toetuse andjal õigus tunnistada taotluse rahuldamise otsus kehtetuks.",
      "rdfs:label": {
        "@value": "Reg_1060767_Par_16 (redaktsioon 1060767)",
        "@language": "et"
      },
      "estleg:versionRedactionId": "1060767",
      "estleg:rtUrl": "https://www.riigiteataja.ee/akt/1060767",
      "estleg:sourceAct": "Kodanikuühiskonna Nupukate Lahenduste starditoetuse tingimused ja kord",
      "estleg:provisionRef": "Reg_1060767 § 16",
