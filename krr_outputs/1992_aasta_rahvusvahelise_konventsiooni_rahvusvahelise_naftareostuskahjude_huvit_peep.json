    {
      "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Sissemaksete tegemine",
        "@language": "et"
      },
      "estleg:sourceAct": "1992. aasta rahvusvahelise konventsiooni rahvusvahelise naftareostuskahjude hüvitamise fondi loomisest 2003. aasta protokolliga ühinemise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:1992_aasta_rahvusvahelise_konventsiooni_Map"
      },
      "estleg:summary": {
        "@value": "(1) Lisafondi protokolli artikli 14 lõikes 2 nimetatud juhul teeb sissemaksed naftareostuskahju hüvitamise rahvusvahelisse lisafondi Kliimaministeerium. (2) Kliimaministeeriumil on maksustatavat naftat vastu võtnud isikute suhtes tagasinõudeõigus käesoleva paragrahvi lõike 1 kohaselt tehtud sissemaksete summa ulatuses proportsionaalselt maksustatava nafta kogusega, mille need isikud on vaadeldaval kalendriaastal vastu võtnud lisafondi protokolli artikli 11 kohaselt.",
        "@language": "et"
      },
      "estleg:legalText": "(1) Lisafondi protokolli artikli 14 lõikes 2 nimetatud juhul teeb sissemaksed naftareostuskahju hüvitamise rahvusvahelisse lisafondi Kliimaministeerium. (2) Kliimaministeeriumil on maksustatavat naftat vastu võtnud isikute suhtes tagasinõudeõigus käesoleva paragrahvi lõike 1 kohaselt tehtud sissemaksete summa ulatuses proportsionaalselt maksustatava nafta kogusega, mille need isikud on vaadeldaval kalendriaastal vastu võtnud lisafondi protokolli artikli 11 kohaselt.",
