      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_loomade_heaolu_loomakaitse_seadus_peep"
      },
      "estleg:summary": "Laiendab heaolukaitset ka vabalt elavatele loomadele ning suunab vältima nende põhjendamatut kahjustamist ja häirimist.",
      "estleg:sourceAct": "Loomakaitseseadus",
