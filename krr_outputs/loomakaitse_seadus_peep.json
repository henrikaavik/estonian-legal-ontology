      "rdfs:label": "§ 2. Loom",
      "estleg:requestedCluster": {
        "@id": "estleg:Cluster_loomade_heaolu_loomakaitse_seadus_peep"
      },
      "estleg:summary": "Täpsustab looma mõiste ning seab loomakaitse adressaadi; heaolunõuete rakendamine eeldab looma käsitlemist tundevõimelise olendina.",
      "estleg:sourceAct": "Loomakaitseseadus",
      "estleg:partOfAct": {
        "@id": "estleg:LOOMAKAITSE_Map"
      }
