    {
      "@id": "estleg:ReferenceType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Viite liik (Reference Type)",
      "rdfs:comment": "Closed enum of citation / reference-edge types (issue #513 T-Box). Individuals: estleg:RefType_Citation, estleg:RefType_Repeal, estleg:RefType_LegalBasis, estleg:RefType_Exception, estleg:RefType_Derogation. Existing unreified estleg:references edges remain untyped until a later emission pass attaches estleg:referenceType."
    },
    {
      "@id": "estleg:RefType_Citation",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ReferenceType"
      ],
      "rdfs:label": {
        "@value": "Viide",
        "@language": "et"
      },
      "skos:prefLabel": {
        "@value": "Citation",
        "@language": "en"
      },
      "rdfs:comment": "A general citation or mention, without repeal / legal-basis / exception / derogation force (issue #513)."
    },
    {
      "@id": "estleg:RefType_Repeal",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ReferenceType"
      ],
      "rdfs:label": {
        "@value": "Kehtetuks tunnistamine",
        "@language": "et"
      },
      "skos:prefLabel": {
        "@value": "Repeal",
        "@language": "en"
      },
      "rdfs:comment": "The citing provision or act repeals (tunnistatakse kehtetuks) the cited target (issue #513)."
    },
    {
      "@id": "estleg:RefType_LegalBasis",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ReferenceType"
      ],
      "rdfs:label": {
        "@value": "Õiguslik alus",
        "@language": "et"
      },
      "skos:prefLabel": {
        "@value": "Legal basis",
        "@language": "en"
      },
      "rdfs:comment": "The cited target is the enabling legal basis (kehtestatakse … alusel) for the citing act or provision (issue #513)."
    },
    {
      "@id": "estleg:RefType_Exception",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ReferenceType"
      ],
      "rdfs:label": {
        "@value": "Erand",
        "@language": "et"
      },
      "skos:prefLabel": {
        "@value": "Exception",
        "@language": "en"
      },
      "rdfs:comment": "The citing provision is an exception to the general rule in the cited target (issue #513)."
    },
    {
      "@id": "estleg:RefType_Derogation",
      "@type": [
        "owl:NamedIndividual",
        "estleg:ReferenceType"
      ],
      "rdfs:label": {
        "@value": "Derogatsioon",
        "@language": "et"
      },
      "skos:prefLabel": {
        "@value": "Derogation",
        "@language": "en"
      },
      "rdfs:comment": "The citing provision derogates from the cited target (issue #513)."
    },
    {
      "@id": "estleg:referenceType",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "viite liik (reference type)",
      "rdfs:comment": "Qualifies a reified estleg:Citation, or an rdf:Statement of an estleg:references edge, with one of the estleg:RefType_* individuals (issue #513 T-Box). Existing unreified estleg:references edges are untyped until a later emission pass.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "estleg:Citation"
            },
            {
              "@id": "rdf:Statement"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "estleg:ReferenceType"
      }
    },
    {
      "@id": "estleg:repeals",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "estleg:references"
      },
      "rdfs:label": "tunnistab kehtetuks (repeals)",
      "rdfs:comment": "The citing provision repeals the cited target (tunnistatakse kehtetuks). rdfs:subPropertyOf estleg:references so untyped queries still see the edge (#513)."
    },
    {
      "@id": "estleg:isLegalBasisFor",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "estleg:references"
      },
      "rdfs:label": "on õiguslikuks aluseks (is legal basis for)",
      "rdfs:comment": "The cited target is the enabling legal basis (kehtestatakse … alusel) of the citing provision (#513)."
    },
    {
      "@id": "estleg:exceptionTo",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "estleg:references"
      },
      "rdfs:label": "on erand (exception to)",
      "rdfs:comment": "The citing provision is an exception to the cited general rule (#513)."
    },
    {
      "@id": "estleg:derogatesFrom",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "estleg:references"
      },
      "rdfs:label": "kaldub kõrvale (derogates from)",
      "rdfs:comment": "The citing provision derogates from the cited target (#513)."
    },
    {
      "@id": "estleg:contentHash",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:label": "content hash (sha256)",
      "rdfs:comment": "Hex SHA-256 of the fetched Riigi Teataja / EIS / EUR-Lex body used to generate this act, so consumers can verify byte-integrity (issue #558)."
    }
  ]
}
