      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Institution",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:institutionType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Institution Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:interpretedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Interpreted By",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:isKov",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Is Kov",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:isStatutoryDefault",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Is Statutory Default",
      "rdfs:comment": "True when a sanction's penalty value comes from a statutory ceiling (e.g. KarS § 44 daily-rate cap, KarS § 48 arrest cap) rather than the offence provision text.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "estleg:issuer",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Issuer",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:jsonld",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Jsonld",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:jurisdiction",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Jurisdiction",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:lastAmendmentDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Last Amendment Date",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:legalText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Legal Text",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:mappedPart",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Mapped Part",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:mapsToGeneralPart",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Maps To General Part",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:maxPenalty",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty",
      "rdfs:comment": "Maximum penalty as a human-readable display string (e.g. '5 years', '300 fine units', '15000 EUR'); see estleg:maxPenaltyAmount/Unit/Currency for the structured form."
    },
    {
      "@id": "estleg:maxPenaltyAmount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty Amount",
      "rdfs:comment": "Numeric value of the maximum penalty (e.g. 5, 300, 15000), paired with estleg:maxPenaltyUnit. Emitted only when the display string parses confidently into amount + unit.",
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:maxPenaltyCurrency",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty Currency",
      "rdfs:comment": "Currency code (e.g. 'EUR') for a monetary maximum penalty; present only when estleg:maxPenaltyUnit is 'monetary'.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:maxPenaltyUnit",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty Unit",
      "rdfs:comment": "Unit of estleg:maxPenaltyAmount; one of years, months, days, daily_rates (KarS päevamäär), fine_units (väärteo trahviühik), monetary (a fixed monetary sum).",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:minPenalty",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty",
      "rdfs:comment": "Minimum penalty as a human-readable display string; see estleg:minPenaltyAmount/Unit/Currency for the structured form."
    },
    {
      "@id": "estleg:minPenaltyAmount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty Amount",
      "rdfs:comment": "Numeric value of the minimum penalty, paired with estleg:minPenaltyUnit. Emitted only when the display string parses confidently into amount + unit.",
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:minPenaltyCurrency",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty Currency",
      "rdfs:comment": "Currency code (e.g. 'EUR') for a monetary minimum penalty; present only when estleg:minPenaltyUnit is 'monetary'.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:minPenaltyUnit",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty Unit",
      "rdfs:comment": "Unit of estleg:minPenaltyAmount; same controlled set as estleg:maxPenaltyUnit (years, months, days, daily_rates, fine_units, monetary).",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:normativeType",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Normative Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:note",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Note",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:paragrahv",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Paragrahv",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:phaseOrder",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Phase Order",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:preambleText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Preamble Text",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:referencedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Referenced By",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:references",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "References",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:relatesToConcept",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Relates To Concept",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:repealDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Repeal Date",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:requestedCluster",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Requested Cluster",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:rtReference",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Rt Reference",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sanctionType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Sanction Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:schemaVersion",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Schema Version",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:scope",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Scope",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sectionNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Section Number",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:semanticallySimilarTo",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Semantically Similar To",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sourceAct",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Source Act",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sourceGlobaalID",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Source Globaal I D",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sourceStructure",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Source Structure",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sourceUrl",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Source Url",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:summary",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Summary",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:temporalStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Temporal Status",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:terviktekstId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Terviktekst Id",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:title",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Title",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:totalAmendments",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Total Amendments",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:totalConcepts",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Total Concepts",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:transpositionDeadline",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Transposition Deadline",
      "rdfs:comment": "Deadline by which EU member states must transpose an EU directive into national law (from cdm:directive_date_transposition). Present only on directive nodes that declare one.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:referenceStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Reference Status",
      "rdfs:comment": "Status marker for materialized fallback reference nodes."
    },
    {
      "@id": "estleg:similarityScore",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Similarity Score",
      "rdfs:comment": "Jaccard similarity value (0..1) on a candidate estleg:semanticallySimilarTo link.",
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:similarityStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Similarity Status",
      "rdfs:comment": "Confidence/provenance status of a heuristic similarity link; currently always \"candidate\".",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:ProvisionVersion",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Provision Version",
      "rdfs:comment": "A redaction-specific version of an estleg:LegalProvision's text. Each ProvisionVersion captures the text a provision carried during one Riigi Teataja consolidated-text redaction (terviktekst), together with the validity interval over which that text was in force. Defined for issue #131; population from historical Riigi Teataja redactions is tracked separately (see the follow-up data-completeness issue)."
    },
    {
      "@id": "estleg:versionOf",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Version Of",
      "rdfs:comment": "Links an estleg:ProvisionVersion to the estleg:LegalProvision whose text it captures. The stable provision identity (the LegalProvision IRI) is deliberately distinct from the redaction/version identity (the ProvisionVersion IRI). Inverse of estleg:hasVersion.",
      "rdfs:range": {
        "@id": "estleg:LegalProvision"
      },
      "owl:inverseOf": {
        "@id": "estleg:hasVersion"
      }
    },
    {
      "@id": "estleg:versionValidFrom",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Valid From",
      "rdfs:comment": "Date on which this provision text became effective (the entry-into-force date of the redaction that introduced it).",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:versionValidTo",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Valid To",
      "rdfs:comment": "Date on which this provision text ceased to be in force (the day before the next redaction took effect). Absent when this is the current text.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:versionText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Text",
      "rdfs:comment": "The provision text at this redaction, verbatim.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:versionRedactionId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Redaction Id",
      "rdfs:comment": "The Riigi Teataja terviktekstID (consolidated-text identifier) of the redaction that produced this provision text. Ties the version to its concrete source document, mirroring how estleg:globalId ties an act snapshot to one concrete redaction.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:supersededByVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Superseded By Version",
      "rdfs:comment": "Links an estleg:ProvisionVersion to the chronologically next estleg:ProvisionVersion of the same provision. Absent on the current (latest) version. Forms a single-successor chain so consumers can walk a provision's text history forward.",
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      }
    },
    {
      "@id": "estleg:hasVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Version",
      "rdfs:comment": "Links an estleg:LegalProvision to an estleg:ProvisionVersion in its text history. A provision with a populated history has one estleg:hasVersion triple per redaction. Inverse of estleg:versionOf.",
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      },
      "owl:inverseOf": {
        "@id": "estleg:versionOf"
      }
    },
    {
      "@id": "estleg:currentVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Current Version",
      "rdfs:comment": "Links an estleg:LegalProvision to the latest estleg:ProvisionVersion in its text history (the one with no estleg:versionValidTo and no estleg:supersededByVersion). Convenience pointer so consumers do not have to scan the whole estleg:hasVersion set.",
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      }
    },
    {
      "@id": "estleg:Annotation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Annotation",
      "rdfs:comment": "A practitioner-facing note (guidance, commentary, practice note, warning, or interpretation) about a legal entity — a Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision, and so on. The annotation layer records how the law is applied or interpreted in practice, alongside (not inside) the law-as-written corpus. Defined for issue #40; ingestion of annotation source data is tracked separately (see the follow-up data-completeness issue)."
    },
    {
      "@id": "estleg:annotates",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Annotates",
      "rdfs:comment": "Links an estleg:Annotation to the legal entity it is about. The range is intentionally unconstrained (owl:Thing): an annotation may attach to a Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision, an EU instrument, etc.",
      "rdfs:range": {
        "@id": "owl:Thing"
      }
    },
    {
      "@id": "estleg:annotationText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Text",
      "rdfs:comment": "The body of the annotation — the practitioner note itself.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotationSource",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Source",
      "rdfs:comment": "Where the annotation comes from, as a human-readable string (e.g. \"Õiguskantsler\", \"RT kommentaar\", a commentary publication name). Kept as a string for now; a future iteration may replace it with an IRI to a source node.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotationSourceUrl",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Source Url",
      "rdfs:comment": "Optional link to the annotation's source document.",
      "rdfs:range": {
        "@id": "xsd:anyURI"
      }
    },
    {
      "@id": "estleg:annotationDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Date",
      "rdfs:comment": "Date on which the annotation was authored or published.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:annotationType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Type",
      "rdfs:comment": "Category of the annotation. SHACL constrains it to one of: \"guidance\", \"commentary\", \"practice_note\", \"warning\", \"interpretation\".",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    }
  ]
}