        },
        {
          "@value": "interprets version",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links a court decision to the estleg:ProvisionVersion that was in force (versionValidFrom <= decisionDate <= versionValidTo) for each provision it interpreted (issue #618). Derived offline by scripts/derive_court_interpretation_staleness.py from the provision_versions/ sidecars. NB: deliberately carries NO rdfs:range estleg:ProvisionVersion — the version nodes live in the separate provision_versions load surface, so in the riigikohus/combined surface these objects are bare cross-reference stubs; an rdfs:range would RDFS-type them under the SHACL buckets' rdfs inference and trip ProvisionVersion constraints. This is a version-layer edge: it is STRIPPED from combined_ontology.jsonld via estleg_common.COMBINED_STRIPPED_PREDICATES and resolves only on the full seadusloome load surface (which includes provision_versions/).",
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      }
