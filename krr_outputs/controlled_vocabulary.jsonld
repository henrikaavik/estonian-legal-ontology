    {
      "@id": "estleg:definedIn",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Defined In",
      "rdfs:comment": "Links a provision-local legal-term definition node (estleg:LegalConcept) to the provision where the term is defined. Inverse of estleg:definesTerm. (The canonical estleg:Concept node → definition-node membership uses estleg:hasDefinitionNode instead, so this property's inverse-of axiom does not corrupt the definesTerm semantics.)"
    },
    {
      "@id": "estleg:definesConcept",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Defines Concept",
      "rdfs:comment": "Links a provision-local legal-term definition node (estleg:LegalConcept) to the canonical estleg:Concept node for that term — the hub link that replaces the former O(k²) skos:exactMatch clique."
    },
    {
      "@id": "estleg:definitionCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Definition Count",
      "rdfs:comment": "Number of provision-local definitions aggregated by a canonical estleg:Concept node. Range: xsd:integer."
    },
    {
      "@id": "estleg:definitionVariantCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Definition Variant Count",
      "rdfs:comment": "Total number of distinct definition wordings observed for a canonical estleg:Concept node when only a capped subset is emitted as skos:definition. Range: xsd:integer."
    },
