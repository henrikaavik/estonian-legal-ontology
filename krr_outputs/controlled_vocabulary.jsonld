        },
        {
          "@value": "Interprets Law",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Coverage + combined graph-closure stub for the inverse of estleg:interpretedBy. The canonical T-Box definition (with rdfs:domain/rdfs:range) lives in krr_outputs/riigikohus/riigikohus_schema.json; this stub exists so the estleg:interpretedBy owl:inverseOf axiom resolves inside combined_ontology.jsonld, which does not include riigikohus_schema.json.",
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
