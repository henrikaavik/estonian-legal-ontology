    {
      "@id": "estleg:LegalConceptScheme",
      "@type": [
        "skos:ConceptScheme"
      ],
      "rdfs:label": [
        {
          "@value": "Õigusmõistete skeem",
          "@language": "et"
        },
        {
          "@value": "Legal Concept Scheme",
          "@language": "en"
        }
      ],
      "skos:prefLabel": [
        {
          "@value": "Eesti õiguse mõistete skeem",
          "@language": "et"
        },
        {
          "@value": "Estonian legal-concept scheme",
          "@language": "en"
        }
      ],
      "rdfs:comment": "The SKOS concept scheme that bundles the legal-concept layer (#609): every estleg:Concept (canonical term) and estleg:LegalConcept (provision-local definition) is skos:inScheme this scheme, and the canonical terms are skos:topConceptOf it.",
      "dcterms:title": "Legal Concept Scheme"
    },
    {
      "@id": "estleg:NormType_Definition",
      "@type": [
        "owl:NamedIndividual",
        "estleg:NormativeType"
      ],
      "rdfs:label": [
        {
          "@value": "Definitsioon",
          "@language": "et"
        },
        {
          "@value": "Definition",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A provision that defines a term (heading mõiste, or first-line tähendab/mõistetakse). Issued for #461 so definition §§ are not scored as Permission/Obligation.",
      "owl:sameAs": {
        "@id": "http://docs.oasis-open.org/legalruleml/ns/v1.0/#ConstitutiveStatement"
