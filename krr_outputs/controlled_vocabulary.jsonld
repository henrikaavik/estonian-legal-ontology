    {
      "@id": "estleg:sourceUrl",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Source Url",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:summary",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Summary",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:temporalStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Temporal Status",
      "rdfs:comment": "ABox values are the xsd:string tokens inForce / repealed / unknown (SHACL also admits notYetEffective). Those tokens correspond to the T-Box individuals estleg:TemporalStatus_InForce, estleg:TemporalStatus_Repealed, and estleg:TemporalStatus_Unknown; this property stays a DatatypeProperty and is not rewritten to an ObjectProperty (issue #522)."
    },
    {
      "@id": "estleg:TemporalStatus",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "rdfs:label": "Ajaliselt kehtivuse staatus (Temporal Status)",
      "rdfs:comment": "SKOS-adjacent class for the closed temporal-status vocabulary (issue #522). Members live in estleg:TemporalStatusScheme. ABox estleg:temporalStatus values remain the string tokens inForce / repealed / unknown; they are not rewritten to these IRIs."
    },
    {
      "@id": "estleg:TemporalStatusScheme",
      "@type": [
        "skos:ConceptScheme"
      ],
      "rdfs:label": "Ajaliselt kehtivuse staatuse skeem (Temporal Status Scheme)",
      "skos:prefLabel": [
        {
          "@value": "Õigusakti ajalise kehtivuse staatused",
          "@language": "et"
        },
        {
          "@value": "Act temporal-status scheme",
          "@language": "en"
        }
      ],
      "dcterms:title": "Temporal Status Scheme",
      "skos:hasTopConcept": [
        {
          "@id": "estleg:TemporalStatus_InForce"
        },
        {
          "@id": "estleg:TemporalStatus_Repealed"
        },
        {
          "@id": "estleg:TemporalStatus_Unknown"
        }
      ]
    },
    {
      "@id": "estleg:TemporalStatus_InForce",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TemporalStatus"
      ],
      "rdfs:label": "In force",
      "skos:prefLabel": [
        {
          "@value": "Kehtiv",
          "@language": "et"
        },
        {
          "@value": "In force",
          "@language": "en"
        }
      ],
      "skos:notation": "inForce",
      "skos:inScheme": {
        "@id": "estleg:TemporalStatusScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TemporalStatusScheme"
      },
      "rdfs:comment": "T-Box individual for the ABox token inForce. owl:disjointWith estleg:TemporalStatus_Repealed (issue #522).",
      "owl:disjointWith": {
        "@id": "estleg:TemporalStatus_Repealed"
      }
    },
    {
      "@id": "estleg:TemporalStatus_Repealed",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TemporalStatus"
      ],
      "rdfs:label": "Repealed",
      "skos:prefLabel": [
        {
          "@value": "Kehtetu",
          "@language": "et"
        },
        {
          "@value": "Repealed",
          "@language": "en"
        }
      ],
      "skos:notation": "repealed",
      "skos:inScheme": {
        "@id": "estleg:TemporalStatusScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TemporalStatusScheme"
      },
      "rdfs:comment": "T-Box individual for the ABox token repealed. owl:disjointWith estleg:TemporalStatus_InForce (issue #522).",
      "owl:disjointWith": {
        "@id": "estleg:TemporalStatus_InForce"
      }
    },
    {
      "@id": "estleg:TemporalStatus_Unknown",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TemporalStatus"
      ],
      "rdfs:label": "Unknown",
      "skos:prefLabel": [
        {
          "@value": "Teadmata",
          "@language": "et"
        },
        {
          "@value": "Unknown",
          "@language": "en"
        }
      ],
      "skos:notation": "unknown",
      "skos:inScheme": {
        "@id": "estleg:TemporalStatusScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TemporalStatusScheme"
      },
      "rdfs:comment": "T-Box individual for the ABox token unknown (issue #522)."
    },
    {
      "@id": "estleg:consistencyChecked",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "consistency checked",
      "rdfs:comment": "Dataset-level xsd:boolean stamp that the #522 T-Box consistency checker has run (no list-valued temporalStatus that is both inForce and repealed; no node with two distinct partOfAct IRIs). Not an owlrl proof over combined_ontology.jsonld.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "estleg:targetGroup",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Target Group",
      "rdfs:comment": "Closed target-group classification for LegalProvision deontic effects: citizen, business, public_body, official, or ngo. HEURISTIC: derived by keyword/dutyHolder matching over the provision text (#576), preferring the dutyHolder's subject and capping an unanchored body-text union; treat as an advisory addressee indicator, not a definitive legal determination. The legacy string value is retained; estleg:targetGroupConcept (#609) materializes the equivalent first-class SKOS concept (estleg:TargetGroup_*), bridged by skos:notation."
    },
    {
      "@id": "estleg:TargetGroup",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "rdfs:label": "Sihtrühm (Target Group)",
      "rdfs:comment": "A reified addressee category for the estleg:targetGroup classification (#609). The five members form a SKOS concept scheme (estleg:TargetGroupScheme); each carries skos:notation equal to the legacy estleg:targetGroup string value, so the bare-string assignments resolve to first-class skos:Concepts."
    },
    {
      "@id": "estleg:TargetGroupScheme",
      "@type": [
        "skos:ConceptScheme"
      ],
      "rdfs:label": "Sihtrühmade skeem (Target Group Scheme)",
      "skos:prefLabel": [
        {
          "@value": "Õigusnormi sihtrühmade klassifikaator",
          "@language": "et"
        },
        {
          "@value": "Legal-provision target-group scheme",
          "@language": "en"
        }
      ],
      "dcterms:title": "Target Group Scheme",
      "skos:hasTopConcept": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        },
        {
          "@id": "estleg:TargetGroup_NGO"
        }
      ]
    },
    {
      "@id": "estleg:TargetGroup_Citizen",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TargetGroup"
      ],
      "rdfs:label": "Citizen",
      "skos:prefLabel": [
        {
          "@value": "Kodanik / füüsiline isik",
          "@language": "et"
        },
        {
          "@value": "Citizen / natural person",
          "@language": "en"
        }
      ],
      "skos:notation": "citizen",
      "skos:inScheme": {
        "@id": "estleg:TargetGroupScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TargetGroupScheme"
      }
    },
    {
      "@id": "estleg:TargetGroup_Business",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TargetGroup"
      ],
      "rdfs:label": "Business",
      "skos:prefLabel": [
        {
          "@value": "Ettevõtja",
          "@language": "et"
        },
        {
          "@value": "Business / undertaking",
          "@language": "en"
        }
      ],
      "skos:notation": "business",
      "skos:inScheme": {
        "@id": "estleg:TargetGroupScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TargetGroupScheme"
      }
    },
    {
      "@id": "estleg:TargetGroup_PublicBody",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TargetGroup"
      ],
      "rdfs:label": "Public body",
      "skos:prefLabel": [
        {
          "@value": "Avaliku võimu asutus",
          "@language": "et"
        },
        {
          "@value": "Public body / authority",
          "@language": "en"
        }
      ],
      "skos:notation": "public_body",
      "skos:inScheme": {
        "@id": "estleg:TargetGroupScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TargetGroupScheme"
      }
    },
    {
      "@id": "estleg:TargetGroup_Official",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TargetGroup"
      ],
      "rdfs:label": "Official",
      "skos:prefLabel": [
        {
          "@value": "Ametnik",
          "@language": "et"
        },
        {
          "@value": "Official",
          "@language": "en"
        }
      ],
      "skos:notation": "official",
      "skos:inScheme": {
        "@id": "estleg:TargetGroupScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TargetGroupScheme"
      }
    },
    {
      "@id": "estleg:TargetGroup_NGO",
      "@type": [
        "owl:NamedIndividual",
        "skos:Concept",
        "estleg:TargetGroup"
      ],
      "rdfs:label": "NGO",
      "skos:prefLabel": [
        {
          "@value": "Mittetulundusühing",
          "@language": "et"
        },
        {
          "@value": "NGO / non-profit",
          "@language": "en"
        }
      ],
      "skos:notation": "ngo",
      "skos:inScheme": {
        "@id": "estleg:TargetGroupScheme"
      },
      "skos:topConceptOf": {
        "@id": "estleg:TargetGroupScheme"
      }
    },
    {
      "@id": "estleg:targetGroupConcept",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "sihtrühma mõiste (target group concept)",
      "rdfs:comment": "Links a provision to the reified estleg:TargetGroup skos:Concept(s) for its estleg:targetGroup classification (#609). Materialized alongside the retained legacy estleg:targetGroup string so the addressee category is a first-class, navigable, multilingually-labelled SKOS concept rather than a bare string. Inherits the heuristic caveat of estleg:targetGroup (#576).",
      "rdfs:domain": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:range": {
        "@id": "estleg:TargetGroup"
      }
    },
    {
      "@id": "estleg:LegalConceptScheme",
      "@type": [
        "skos:ConceptScheme"
      ],
      "rdfs:label": "Õigusmõistete skeem (Legal Concept Scheme)",
      "skos:prefLabel": [
        {
          "@value": "Eesti õiguse mõistete skeem",
          "@language": "et"
        },
        {
          "@value": "Estonian legal-concept scheme",
          "@language": "en"
        }
      ],
      "dcterms:title": "Legal Concept Scheme",
      "rdfs:comment": "The SKOS concept scheme that bundles the legal-concept layer (#609): every estleg:Concept (canonical term) and estleg:LegalConcept (provision-local definition) is skos:inScheme this scheme, and the canonical terms are skos:topConceptOf it."
    },
    {
      "@id": "estleg:terviktekstId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Terviktekst Id",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:title",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Title",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:totalAmendments",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Total Amendments",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:totalConcepts",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Total Concepts",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:transpositionDeadline",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Transposition Deadline",
      "rdfs:comment": "Deadline by which EU member states must transpose an EU directive into national law (from cdm:directive_date_transposition). Present only on directive nodes that declare one.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:referenceStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Reference Status",
      "rdfs:comment": "Status marker for materialized fallback reference nodes."
    },
    {
      "@id": "estleg:similarityScore",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Similarity Score",
      "rdfs:comment": "Jaccard similarity value (0..1) on a candidate estleg:semanticallySimilarTo link.",
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:similarityStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Similarity Status",
      "rdfs:comment": "Confidence/provenance status of a heuristic similarity link; currently always \"candidate\".",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:Similarity",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Similarity",
      "rdfs:comment": "Reified act-to-act similarity link (Layer 3 KOV-aware similarity): carries estleg:similarTarget, estleg:similarityScore, and estleg:similarityModel."
    },
    {
      "@id": "estleg:similarAct",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Similar Act",
      "rdfs:comment": "Links an act to a reified estleg:Similarity node describing a similar act (Layer 3 KOV similarity).",
      "rdfs:range": {
        "@id": "estleg:Similarity"
      }
    },
    {
      "@id": "estleg:similarTarget",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Similar Target",
      "rdfs:comment": "The target act of a reified estleg:Similarity link. NB: deliberately carries NO rdfs:range estleg:Act — the similarity records point at bare cross-reference act IRIs whose full, labelled node lives elsewhere in the corpus; under the SHACL buckets' rdfs inference an rdfs:range estleg:Act would RDFS-type those stubs as estleg:Act and trip the #570 ActTemporalShape rdfs:label requirement. The canonical typing comes from the act's own home-bucket node."
    },
    {
      "@id": "estleg:similarityModel",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Similarity Model",
      "rdfs:comment": "Scoring model behind an estleg:Similarity link (e.g. \"tfidf-cosine\").",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:regulationTypeBucket",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Regulation Type Bucket",
      "rdfs:comment": "Regulation-type bucket key (from the normalized title) used to scope KOV act-level similarity comparisons.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:ProvisionVersion",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli:LegalExpression"
      },
      "rdfs:label": "Provision Version",
      "rdfs:comment": "A redaction-specific version of an estleg:LegalProvision's text. Each ProvisionVersion captures the text a provision carried during one Riigi Teataja consolidated-text redaction (terviktekst), together with the validity interval over which that text was in force. Defined for issue #131; population from historical Riigi Teataja redactions is tracked separately (see the follow-up data-completeness issue). In FRBR/ELI terms this is the Expression of the provision Work (eli:LegalExpression) (#440)."
    },
    {
      "@id": "estleg:versionOf",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Version Of",
      "rdfs:comment": "Links an estleg:ProvisionVersion to the estleg:LegalProvision whose text it captures. The stable provision identity (the LegalProvision IRI) is deliberately distinct from the redaction/version identity (the ProvisionVersion IRI). Inverse of estleg:hasVersion.",
      "rdfs:range": {
        "@id": "estleg:LegalProvision"
      },
      "owl:inverseOf": {
        "@id": "estleg:hasVersion"
      }
    },
    {
      "@id": "estleg:versionValidFrom",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Valid From",
      "rdfs:comment": "Date on which this provision text became effective (the entry-into-force date of the redaction that introduced it).",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:versionValidTo",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Valid To",
      "rdfs:comment": "Date on which this provision text ceased to be in force (the day before the next redaction took effect). Absent when this is the current text.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:versionText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Text",
      "rdfs:comment": "The provision text at this redaction, verbatim.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:versionRedactionId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Version Redaction Id",
      "rdfs:comment": "The Riigi Teataja terviktekstID (consolidated-text identifier) of the redaction that produced this provision text. Ties the version to its concrete source document, mirroring how estleg:globalId ties an act snapshot to one concrete redaction.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:supersededByVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Superseded By Version",
      "rdfs:comment": "Links an estleg:ProvisionVersion to the chronologically next estleg:ProvisionVersion of the same provision. Absent on the current (latest) version. Forms a single-successor chain so consumers can walk a provision's text history forward.",
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      }
    },
    {
      "@id": "estleg:hasVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Version",
      "rdfs:comment": "Links an estleg:LegalProvision to an estleg:ProvisionVersion in its text history. A provision with a populated history has one estleg:hasVersion triple per redaction. Inverse of estleg:versionOf. NB: deliberately carries NO rdfs:range estleg:ProvisionVersion — under the RDFS inference the SHACL gate runs, a range would type every bare hasVersion object (whose full node, with estleg:versionValidFrom, lives in an unloaded provision_versions/ sidecar) as an estleg:ProvisionVersion in the 'laws' bucket, raising false MinCount violations. Real ProvisionVersion nodes are explicitly typed in their sidecars and validated by the 'sidecars' bucket.",
      "owl:inverseOf": {
        "@id": "estleg:versionOf"
      }
    },
    {
      "@id": "estleg:currentVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Current Version",
      "rdfs:comment": "Links an estleg:LegalProvision to the latest estleg:ProvisionVersion in its text history (the one with no estleg:versionValidTo and no estleg:supersededByVersion). Convenience pointer so consumers do not have to scan the whole estleg:hasVersion set.",
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      }
    },
    {
      "@id": "estleg:Subsection",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:label": "Subsection (lõige)",
      "rdfs:comment": "A numbered subsection (lõige) of an estleg:LegalProvision — the level Estonian legal citations actually reference (\"TsÜS § 14 lg 2\"). One node per lõige of a paragrahv that has lõige structure; it carries the lõige number (estleg:subsectionNumber), the lõige's own text (estleg:legalText, including the inline (N) punkt markers, mirroring the provision-level legalText), and an estleg:parentProvision link back to the § node. The parent provision keeps its full concatenated estleg:legalText for backward compatibility — the subsections sum to it. Defined for issue #132 (lõige level); modelling the punkt/alapunkt level below lõige is deferred to a follow-up."
    },
    {
      "@id": "estleg:subsectionNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Subsection Number",
      "rdfs:comment": "The lõige number of an estleg:Subsection as a display string, e.g. \"2\" or \"2¹\" (the kuvatavNr form, falling back to loigeNr). Kept as a string because superscripted lõige numbers (lg 2¹) are not integers.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:hasSubsection",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Subsection",
      "rdfs:comment": "Links an estleg:LegalProvision to one of its estleg:Subsection (lõige) nodes. A provision with lõige structure carries one estleg:hasSubsection triple per lõige, in document order; a provision with no lõiked carries none (its text lives directly on the § node). Inverse of estleg:parentProvision.",
      "rdfs:range": {
        "@id": "estleg:Subsection"
      },
      "owl:inverseOf": {
        "@id": "estleg:parentProvision"
      }
    },
    {
      "@id": "estleg:parentProvision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Parent Provision",
      "rdfs:comment": "Links an estleg:Subsection (lõige) to the estleg:LegalProvision (§) it belongs to. Exactly one per Subsection. Inverse of estleg:hasSubsection.",
      "rdfs:range": {
        "@id": "estleg:LegalProvision"
      },
      "owl:inverseOf": {
        "@id": "estleg:hasSubsection"
      }
    },
    {
      "@id": "estleg:Annotation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Annotation",
      "rdfs:comment": "A practitioner-facing note (guidance, commentary, practice note, warning, or interpretation) about a legal entity — a Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision, and so on. The annotation layer records how the law is applied or interpreted in practice, alongside (not inside) the law-as-written corpus. Defined for issue #40; ingestion of annotation source data is tracked separately (see the follow-up data-completeness issue)."
    },
    {
      "@id": "estleg:annotates",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Annotates",
      "rdfs:comment": "Links an estleg:Annotation to the legal entity it is about. The range is intentionally unconstrained (owl:Thing): an annotation may attach to a Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision, an EU instrument, etc.",
      "rdfs:range": {
        "@id": "owl:Thing"
      }
    },
    {
      "@id": "estleg:annotationText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Text",
      "rdfs:comment": "The body of the annotation — the practitioner note itself.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotationSource",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Source",
      "rdfs:comment": "Where the annotation comes from, as a human-readable string (e.g. \"Õiguskantsler\", \"RT kommentaar\", a commentary publication name). Kept as a string for now; a future iteration may replace it with an IRI to a source node.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotationSourceUrl",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Source Url",
      "rdfs:comment": "Optional link to the annotation's source document.",
      "rdfs:range": {
        "@id": "xsd:anyURI"
      }
    },
    {
      "@id": "estleg:annotationDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Date",
      "rdfs:comment": "Date on which the annotation was authored or published.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:annotationType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annotation Type",
      "rdfs:comment": "Category of the annotation. SHACL constrains it to one of: \"guidance\", \"commentary\", \"practice_note\", \"warning\", \"interpretation\".",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:Municipality",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Municipality",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation. A current Estonian municipality (KOV unit) — a territorial entity identified by its EHAK code; the canonical definition lives in metadata.jsonld. Re-asserted here so estleg:succeededBy's rdfs:range (and the metadata.jsonld estleg:currentMunicipality / estleg:enactedByMunicipality ranges) resolve within the published corpus."
    },
    {
      "@id": "estleg:HistoricalMunicipality",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Historical Municipality",
      "rdfs:comment": "A former Estonian municipality (KOV unit) that was merged or abolished by a territorial reform — chiefly the 2017 haldusreform. Modelled as a distinct node (IRI scheme estleg:HistoricalMunicipality_<formerEhakCode>) carrying its pre-merger EHAK code, pre-merger name, and an estleg:succeededBy link to the surviving current municipality, so KOV acts can be queried by issuing-time jurisdiction rather than only by present-day successor. Deliberately NOT a subclass of estleg:Municipality (the latter's SHACL shape constrains the Municipality_EHAK_<code> IRI form and requires estleg:ehakCode/estleg:county, which do not apply to abolished units). Introduced for issue #130; nodes are derived from the issuer registry's mappingEvidence citations."
    },
    {
      "@id": "estleg:formerEhakCode",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Former EHAK Code",
      "rdfs:comment": "The pre-merger four-digit EHAK code of an estleg:HistoricalMunicipality (e.g. \"0105\" for the former Abja vald). Distinct from estleg:ehakCode, which carries the still-current code on estleg:Municipality nodes.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:formerName",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Former Name",
      "rdfs:comment": "The pre-merger name of an estleg:HistoricalMunicipality, including the unit-type word (e.g. \"Abja vald\", \"Kallaste linn\"). Diacritic-correct — sourced from the merger-evidence citation, not the diacritic-stripped issuer slug.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:succeededBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Succeeded By",
      "rdfs:comment": "Links an estleg:HistoricalMunicipality to the current estleg:Municipality that succeeded it after a territorial reform (the surviving EHAK unit). Where a former municipality was split across several successors, this points at the primary successor (the one holding the former administrative centre); the full set is recorded in estleg:mergerEvidence.",
      "rdfs:range": {
        "@id": "estleg:Municipality"
      }
    },
    {
      "@id": "estleg:mergedAt",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Merged At",
      "rdfs:comment": "The date on which an estleg:HistoricalMunicipality ceased to exist as an independent unit (the merger/abolition effective date). For 2017-haldusreform units this is 2017-10-15, the day the post-election councils of the merged municipalities convened. Omitted when the effective date cannot be determined from the source evidence.",
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:mergerEvidence",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Merger Evidence",
      "rdfs:comment": "Free-text citation supporting an estleg:HistoricalMunicipality's pre-merger identity and its successor mapping (e.g. \"Wikidata: Abja vald (EHAK 0105) -> Mulgi vald (EHAK 0480); per RT I 21.06.2017 1\"). Carried verbatim from the issuer registry's mappingEvidence — the auditable trail.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:municipalityType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Municipality Type",
      "rdfs:comment": "The Estonian local-government unit type of an estleg:HistoricalMunicipality. SHACL constrains it to one of: \"vald\" (rural municipality) or \"linn\" (town/city). Derived from the unit-type word in the pre-merger name; omitted if not derivable.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:Law",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:Act"
      },
      "rdfs:label": "Law",
      "rdfs:comment": "An enacted legislative act (seadus)."
    },
    {
      "@id": "estleg:CourtDecision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": {
        "@value": "Kohtulahend (Court Decision)",
        "@language": "et"
      },
      "rdfs:comment": {
        "@value": "Riigikohtu lahend – kohtuotsus, kohtumäärus või resolutsioon.",
        "@language": "et"
      },
      "dc:description": {
        "@value": "A Supreme Court (Riigikohus) decision, including judgments, rulings, and resolutions.",
        "@language": "en"
      }
    },
    {
      "@id": "estleg:DomesticRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "DomesticRegulation",
      "rdfs:comment": "An Estonian domestic regulation (Eesti määrus) of any level — a subordinate legal act issued under an enabling Estonian law. Common superclass of the state-level (estleg:NationalRegulation) and municipal (estleg:MunicipalRegulation) regulation branches; introduced so shared domestic-regulation SHACL constraints have a single conceptual home without forcing a municipal regulation to be (mis-)classified as state-level (issue #424). Disjoint from estleg:EULegislation, which models EU-level acts.",
      "rdfs:subClassOf": {
        "@id": "estleg:Act"
      }
    },
    {
      "@id": "estleg:NationalRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:DomesticRegulation"
      },
      "rdfs:label": "National Regulation",
      "rdfs:comment": "A state-level Estonian regulation (riigi tasandi määrus) issued by a state organ. Superclass of the government and ministerial regulation classes. Subclass of estleg:DomesticRegulation, NOT of estleg:MunicipalRegulation: a municipal regulation is a sibling, not an instance, of this class (issue #424). owl:disjointWith estleg:MunicipalRegulation (issue #439).",
      "owl:disjointWith": {
        "@id": "estleg:MunicipalRegulation"
      }
    },
    {
      "@id": "estleg:MinisterialRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:NationalRegulation"
      },
      "rdfs:label": "Ministerial Regulation",
      "rdfs:comment": "A regulation issued by a minister."
    },
    {
      "@id": "estleg:GovernmentRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:NationalRegulation"
      },
      "rdfs:label": "Government Regulation",
      "rdfs:comment": "A regulation issued by the Government of the Republic."
    },
    {
      "@id": "estleg:MunicipalRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:DomesticRegulation"
      },
      "rdfs:label": "Municipal Regulation",
      "rdfs:comment": "A municipal (KOV) regulation enacted by a local-government issuer (volikogu or valitsus) — kohaliku omavalitsuse määrus. Subclass of estleg:DomesticRegulation. Deliberately NOT a subclass of estleg:NationalRegulation: a KOV määrus is local-government, not state-level, legislation, so no entailment path makes it a state regulation (issue #424; was a logical error corrected from the earlier subClassOf NationalRegulation hack). owl:disjointWith estleg:NationalRegulation (issue #439).",
      "owl:disjointWith": {
        "@id": "estleg:NationalRegulation"
      }
    },
    {
      "@id": "estleg:KovProvision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:label": "Municipal Provision",
      "rdfs:comment": "A provision (§) of a municipal regulation."
    },
    {
      "@id": "estleg:DraftLegislation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli-dl:DraftLegislationWork"
      },
      "rdfs:label": "Eelnõu (Draft Legislation)",
      "rdfs:comment": "Õigusakt, mis ei ole veel jõustunud, kuid on seadusandlikus menetluses.",
      "dc:description": "A legislative draft that has not yet been enacted into law but is in the legislative process."
    },
    {
      "@id": "estleg:Issuer",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Issuer",
      "rdfs:comment": "A body that issues a regulation (a ministry, the Government, or a municipality)."
    },
    {
      "@id": "estleg:EULegislation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "EL õigusakt (EU Legislation)",
      "rdfs:comment": "Euroopa Liidu õigusakt — määrus, direktiiv või otsus.",
      "dc:description": "A European Union legal act — regulation, directive, or decision."
    },
    {
      "@id": "estleg:HarmonisationLink",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Harmoniseerimisseos (Harmonisation link)",
      "rdfs:comment": "Neighbour-state comparative NIM measure (LV/LT/FI/SE) sharing an EU directive with an Estonian act. Instances in combined_ontology.jsonld may be isStubNode closure stubs; real neighbour measures live in krr_outputs/harmonisation/. This class is not Estonian article-level transposition (see estleg:transposesDirective)."
    },
    {
      "@id": "estleg:EUInstitution",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "EL institutsioon (EU Institution)",
      "rdfs:comment": "Euroopa Liidu institutsioon või organ, mis on õigusakti autor."
    },
    {
      "@id": "estleg:CaseType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": {
        "@value": "Kohtuasja liik (Case Type)",
        "@language": "et"
      },
      "rdfs:comment": {
        "@value": "Kohtuasja klassifikatsioon: kriminaalasi, tsiviilasi, haldusasi, väärteoasi, põhiseaduslikkuse järelevalve.",
        "@language": "et"
      }
    },
    {
      "@id": "estleg:EUCourtDecisionType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "EL kohtulahendi liik (EU Court Decision Type)",
      "rdfs:comment": "Euroopa Liidu kohtulahendi klassifikatsioon."
    },
    {
      "@id": "estleg:publicationYear",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Publication Year",
      "rdfs:range": {
        "@id": "xsd:gYear"
      },
      "rdfs:comment": "Year-precision publication year (xsd:gYear) for records whose exact publication date is unknown; emitted instead of a fabricated date (#571)."
    },
    {
      "@id": "estleg:transposesDirective",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "võtab üle direktiivi (transposes directive)",
      "rdfs:comment": "Links an Estonian act to the EU directive it transposes. Canonical TBox declaration folded into the controlled vocabulary so the 376 EU-transposition assertions in combined_ontology.jsonld resolve their predicate (issue #563); previously defined only in krr_outputs/transposition_schema.json, which the combined builder does not merge. NB: deliberately carries NO rdfs:range estleg:EULegislation — in the laws SHACL bucket the directive objects are bare cross-reference IRIs (estleg:EU_<celex>) whose full, labelled node lives in the eurlex corpus; under rdfs inference an rdfs:range would RDFS-type those stubs as estleg:EULegislation and trip the EULegislationShape label/celexNumber/euDocumentType requirements.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      }
    },
    {
      "@id": "estleg:transposedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "üle võetud (transposed by)",
      "rdfs:comment": "Inverse of estleg:transposesDirective — links an EU directive to the national law that transposes it. Folded into the controlled vocabulary for issue #563. NB: deliberately carries NO rdfs:range estleg:Act here — in the eurlex/harmonisation SHACL bucket the national-law objects are bare cross-reference IRIs (their full, labelled node lives in the laws corpus), and an rdfs:range would RDFS-type those stubs as estleg:Act and trip the #570 ActTemporalShape label requirement. The canonical typing comes from the forward estleg:transposesDirective (rdfs:domain estleg:Act).",
      "rdfs:domain": {
        "@id": "estleg:EULegislation"
      },
      "owl:inverseOf": {
        "@id": "estleg:transposesDirective"
      }
    },
    {
      "@id": "estleg:transpositionStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "ülevõtmise staatus (transposition status)",
      "rdfs:comment": "Status of directive transposition: full, partial, or unknown. Folded into the controlled vocabulary for issue #563.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:harmonisedWith",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "harmoniseeritud (harmonised with)",
      "rdfs:comment": "Links an Estonian law to a harmonisation record (estleg:HarmonisationLink) showing parallel implementations of the same EU directive in other member states. Folded into the controlled vocabulary for issue #563. NB: deliberately carries NO rdfs:range estleg:HarmonisationLink — in the laws SHACL bucket the record objects are bare cross-reference IRIs (estleg:Harmonisation_<celex>) whose full, labelled node lives in the harmonisation_by_directive/ corpus; under rdfs inference an rdfs:range would RDFS-type those stubs as estleg:HarmonisationLink and trip the HarmonisationLinkShape rdfs:label requirement.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "owl:inverseOf": {
        "@id": "estleg:harmonises"
      }
    },
    {
      "@id": "estleg:harmonises",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "harmoneerib (harmonises)",
      "rdfs:comment": "Links a harmonisation record to the Estonian act(s) that transpose the shared EU directive. Inverse of estleg:harmonisedWith. Folded into the controlled vocabulary for issue #563. NB: deliberately carries NO rdfs:range estleg:Act here — the harmonisation_by_directive/ records (loaded into the eurlex SHACL bucket) point estleg:harmonises at bare cross-reference IRIs whose full, labelled act node lives in the laws corpus; an rdfs:range estleg:Act would RDFS-type those 117 stubs as estleg:Act and trip the #570 ActTemporalShape label requirement. The canonical typing comes from the forward estleg:harmonisedWith (rdfs:domain estleg:Act).",
      "rdfs:domain": {
        "@id": "estleg:HarmonisationLink"
      },
      "owl:inverseOf": {
        "@id": "estleg:harmonisedWith"
      }
    },
    {
      "@id": "estleg:sharedDirective",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "ühine direktiiv (shared directive)",
      "rdfs:comment": "The EU directive that multiple member states have transposed. Folded into the controlled vocabulary for issue #563. NB: deliberately carries NO rdfs:range estleg:EULegislation — in the eurlex/harmonisation SHACL bucket the directive objects are bare cross-reference IRIs whose full, labelled node lives in the eurlex corpus; under rdfs inference an rdfs:range would RDFS-type those stubs as estleg:EULegislation and trip the EULegislationShape requirements.",
      "rdfs:domain": {
        "@id": "estleg:HarmonisationLink"
      }
    },
    {
      "@id": "estleg:memberStateCode",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "liikmesriigi kood (member state code)",
      "rdfs:comment": "ISO 3166-1 alpha-3 country code of the EU member state. Folded into the controlled vocabulary for issue #563.",
      "rdfs:domain": {
        "@id": "estleg:HarmonisationLink"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
