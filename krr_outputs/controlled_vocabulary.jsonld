      "@id": "estleg:personalDataScreened",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "isikuandmed kontrollitud",
          "@language": "et"
        },
        {
          "@value": "personal data screened",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "True when this decision's published text passed Estonian personal identification code (isikukood) screening before publication, so any code found was replaced by a placeholder. Screening is a GDPR minimisation control over verbatim scraped court prose; see docs/DATA_PROTECTION.md (#683).",
        "@language": "en"
      },
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
