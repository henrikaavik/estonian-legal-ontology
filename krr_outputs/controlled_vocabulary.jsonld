    {
      "@id": "estleg:subsectionNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "lõike number",
          "@language": "et"
        },
        {
          "@value": "Subsection Number",
          "@language": "en"
        }
      ],
      "rdfs:comment": "The lõige number of an estleg:Subsection as a display string, e.g. \"2\" or \"2¹\" (the kuvatavNr form, falling back to loigeNr). Kept as a string because superscripted lõige numbers (lg 2¹) are not integers.",
      "rdfs:domain": {
        "@id": "estleg:Subsection"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:succeededBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "järglane",
          "@language": "et"
        },
        {
          "@value": "Succeeded By",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an estleg:HistoricalMunicipality to the current estleg:Municipality that succeeded it after a territorial reform (the surviving EHAK unit). Where a former municipality was split across several successors, this points at the primary successor (the one holding the former administrative centre); the full set is recorded in estleg:mergerEvidence.",
      "rdfs:domain": {
        "@id": "estleg:HistoricalMunicipality"
      },
      "rdfs:range": {
        "@id": "estleg:Municipality"
      }
    },
    {
      "@id": "estleg:summary",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "kokkuvõte",
          "@language": "et"
        },
        {
          "@value": "Summary",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Short prose summary of an act, provision, or court decision.",
      "rdfs:domain": {
        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:supersededByExpression",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "asendatud redaktsiooniga (superseded by expression)",
          "@language": "et"
        },
        {
          "@value": "asendatud redaktsiooniga (superseded by expression)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an estleg:ActExpression to the next-later consolidation of the same act (#608 phase 2), chaining the act's consolidations into a navigable FRBR temporal sequence; the chain head (no value) is the current consolidation. The per-provision membership of an expression is derivable from the provision_versions sidecars (versionValidFrom <= consolidationDate, latest per provision), so it is not materialised (~1.3M edges).",
      "rdfs:domain": {
        "@id": "estleg:ActExpression"
      },
      "rdfs:range": {
        "@id": "estleg:ActExpression"
      },
      "owl:inverseOf": {
        "@id": "estleg:supersedesExpression"
      }
    },
    {
      "@id": "estleg:supersededByVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "asendatud redaktsiooniga",
          "@language": "et"
        },
        {
          "@value": "Superseded By Version",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an estleg:ProvisionVersion to the chronologically next estleg:ProvisionVersion of the same provision. Absent on the current (latest) version. Forms a single-successor chain so consumers can walk a provision's text history forward.",
      "rdfs:domain": {
        "@id": "estleg:ProvisionVersion"
      },
      "rdfs:range": {
        "@id": "estleg:ProvisionVersion"
      }
    },
    {
      "@id": "estleg:supersedesExpression",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "asendab redaktsiooni (supersedes expression)",
          "@language": "et"
        },
        {
          "@value": "asendab redaktsiooni (supersedes expression)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an estleg:ActExpression to the previous consolidation of the same act it supersedes (#608 phase 2). Inverse of estleg:supersededByExpression.",
      "rdfs:domain": {
        "@id": "estleg:ActExpression"
      },
      "rdfs:range": {
        "@id": "estleg:ActExpression"
      },
      "owl:inverseOf": {
        "@id": "estleg:supersededByExpression"
      }
    },
    {
      "@id": "estleg:targetGroup",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "sihtrühm",
          "@language": "et"
        },
        {
          "@value": "Target Group",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Closed target-group classification for LegalProvision deontic effects. Values are estleg:TargetGroup individuals (#460). HEURISTIC: derived by keyword/dutyHolder matching over the provision text (#576), preferring the dutyHolder's subject and capping an unanchored body-text union; treat as an advisory addressee indicator, not a definitive legal determination. estleg:targetGroupConcept (#609) materializes the equivalent first-class SKOS concept (estleg:TargetGroup_*), bridged by skos:notation.",
      "rdfs:domain": {
        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:targetGroupConcept",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "sihtrühma mõiste",
          "@language": "et"
        },
        {
          "@value": "target group concept",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links a provision to the reified estleg:TargetGroup skos:Concept(s) for its estleg:targetGroup classification (#609). Materialized alongside the retained legacy estleg:targetGroup string so the addressee category is a first-class, navigable, multilingually-labelled SKOS concept rather than a bare string. Inherits the heuristic caveat of estleg:targetGroup (#576).",
      "rdfs:domain": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:range": {
        "@id": "estleg:TargetGroup"
      }
    },
    {
      "@id": "estleg:temporalStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "ajaline staatus",
          "@language": "et"
        },
        {
          "@value": "Temporal Status",
          "@language": "en"
        }
      ],
      "rdfs:comment": "ABox values are the xsd:string tokens inForce / repealed / unknown (SHACL also admits notYetEffective). Those tokens correspond to the T-Box individuals estleg:TemporalStatus_InForce, estleg:TemporalStatus_Repealed, and estleg:TemporalStatus_Unknown; this property stays a DatatypeProperty and is not rewritten to an ObjectProperty (issue #522).",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:terviktekstId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "tervikteksti ID",
          "@language": "et"
        },
        {
          "@value": "Terviktekst Id",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Riigi Teataja terviktekst identifier of a consolidation.",
      "rdfs:domain": {
        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:titleNormalized",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": [
        {
          "@value": "normaliseeritud pealkiri",
          "@language": "et"
        },
        {
          "@value": "titleNormalized",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Lowercased, transliterated title with the municipality-name prefix stripped. Used by Layer 3 bucket detection.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:topicCluster",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "teemaklaster",
          "@language": "et"
        },
        {
          "@value": "Topic Cluster",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links a LegalProvision to its topic-cluster subject node. SHACL-shaped and documented; T-Box node added for issue #341.11.",
      "rdfs:domain": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:range": {
        "@id": "estleg:TopicCluster"
      }
    },
    {
      "@id": "estleg:totalAmendments",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "muudatuste koguarv",
          "@language": "et"
        },
        {
          "@value": "Total Amendments",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Count of AmendmentEvent nodes recorded for an act.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "estleg:totalConcepts",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "mõistete koguarv",
          "@language": "et"
        },
        {
          "@value": "Total Concepts",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Count of LegalConcept nodes extracted from an act.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "estleg:transposedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "üle võetud",
          "@language": "et"
        },
        {
          "@value": "transposed by",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Inverse of estleg:transposesDirective — links an EU directive to the national law that transposes it. Folded into the controlled vocabulary for issue #563. NB: deliberately carries NO rdfs:range estleg:Act here — in the eurlex/harmonisation SHACL bucket the national-law objects are bare cross-reference IRIs (their full, labelled node lives in the laws corpus), and an rdfs:range would RDFS-type those stubs as estleg:Act and trip the #570 ActTemporalShape label requirement. The canonical typing comes from the forward estleg:transposesDirective (rdfs:domain estleg:Act).",
      "rdfs:domain": {
        "@id": "estleg:EULegislation"
      },
      "owl:inverseOf": {
        "@id": "estleg:transposesDirective"
      }
    },
    {
      "@id": "estleg:transposesDirective",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "võtab üle direktiivi",
          "@language": "et"
        },
        {
          "@value": "transposes directive",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an Estonian act to the EU directive it transposes. Canonical TBox declaration folded into the controlled vocabulary so the 376 EU-transposition assertions in combined_ontology.jsonld resolve their predicate (issue #563); previously defined only in krr_outputs/transposition_schema.json, which the combined builder does not merge. NB: deliberately carries NO rdfs:range estleg:EULegislation — in the laws SHACL bucket the directive objects are bare cross-reference IRIs (estleg:EU_<celex>) whose full, labelled node lives in the eurlex corpus; under rdfs inference an rdfs:range would RDFS-type those stubs as estleg:EULegislation and trip the EULegislationShape label/celexNumber/euDocumentType requirements.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "owl:inverseOf": {
        "@id": "estleg:transposedBy"
      }
    },
    {
      "@id": "estleg:transpositionDeadline",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "ülevõtmise tähtaeg",
          "@language": "et"
        },
        {
          "@value": "Transposition Deadline",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Deadline by which EU member states must transpose an EU directive into national law (from cdm:directive_date_transposition). Present only on directive nodes that declare one.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:transpositionStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "ülevõtmise staatus",
          "@language": "et"
        },
        {
          "@value": "transposition status",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Status of directive transposition: full, partial, or unknown. Folded into the controlled vocabulary for issue #563.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:versionOf",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "redaktsioon millest",
          "@language": "et"
        },
        {
          "@value": "Version Of",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an estleg:ProvisionVersion to the estleg:LegalProvision whose text it captures. The stable provision identity (the LegalProvision IRI) is deliberately distinct from the redaction/version identity (the ProvisionVersion IRI). Inverse of estleg:hasVersion.",
      "rdfs:domain": {
        "@id": "estleg:ProvisionVersion"
      },
      "rdfs:range": {
        "@id": "estleg:LegalProvision"
      },
      "owl:inverseOf": {
        "@id": "estleg:hasVersion"
      }
    },
    {
      "@id": "estleg:versionRedactionId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "redaktsiooni ID",
          "@language": "et"
        },
        {
          "@value": "Version Redaction Id",
          "@language": "en"
        }
      ],
      "rdfs:comment": "The Riigi Teataja terviktekstID (consolidated-text identifier) of the redaction that produced this provision text. Ties the version to its concrete source document, mirroring how estleg:globalId ties an act snapshot to one concrete redaction.",
      "rdfs:domain": {
        "@id": "estleg:ProvisionVersion"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:versionText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "redaktsiooni tekst",
          "@language": "et"
        },
        {
          "@value": "Version Text",
          "@language": "en"
        }
      ],
      "rdfs:comment": "The provision text at this redaction, verbatim.",
      "rdfs:domain": {
        "@id": "estleg:ProvisionVersion"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:versionValidFrom",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "redaktsioon kehtib alates",
          "@language": "et"
        },
        {
          "@value": "Version Valid From",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Date on which this provision text became effective (the entry-into-force date of the redaction that introduced it).",
      "rdfs:domain": {
        "@id": "estleg:ProvisionVersion"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:versionValidTo",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "redaktsioon kehtib kuni",
          "@language": "et"
        },
        {
          "@value": "Version Valid To",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Date on which this provision text ceased to be in force (the day before the next redaction took effect). Absent when this is the current text.",
      "rdfs:domain": {
        "@id": "estleg:ProvisionVersion"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
