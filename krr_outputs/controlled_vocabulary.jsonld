{
  "@context": {
    "estleg": "https://w3id.org/estleg/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "eli": "http://data.europa.eu/eli/ontology#",
    "eli-dl": "http://data.europa.eu/eli/eli-draft-legislation-ontology#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/"
  },
  "@graph": [
    {
      "@id": "https://w3id.org/estleg/vocabulary",
      "@type": "owl:Ontology",
      "owl:versionInfo": "1.0.0",
      "rdfs:label": [
        {
          "@value": "Eesti õigusontoloogia sõnavara",
          "@language": "et"
        },
        {
          "@value": "Estonian Legal Ontology vocabulary",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Canonical T-Box for https://w3id.org/estleg/ — classes, class hierarchy, and properties in the default graph (#433).",
      "dcterms:title": {
        "@value": "Estonian Legal Ontology vocabulary",
        "@language": "en"
      }
    },
    {
      "@id": "estleg:Act",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": [
        {
          "@id": "eli:LegalResource"
        },
        {
          "@id": "schema:Legislation"
        }
      ],
      "rdfs:label": [
        {
          "@value": "Akt",
          "@language": "et"
        },
        {
          "@value": "Act",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An Estonian or EU legislative act. In FRBR/ELI terms the act node is the Work (eli:LegalResource); its addressable point-in-time consolidations are estleg:ActExpression nodes (eli:LegalExpression) reachable via estleg:hasExpression (#608). Also rdfs:subClassOf schema:Legislation so generic schema.org clients see acts as Legislation without a 1190-peep rewrite (#543)."
    },
    {
      "@id": "estleg:ActExpression",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli:LegalExpression"
      },
      "rdfs:label": [
        {
          "@value": "Akti redaktsioon",
          "@language": "et"
        },
        {
          "@value": "Act Expression",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An addressable consolidated expression of an act as in force from a given consolidation date — the FRBR Expression / ELI eli:LegalExpression of the act-as-Work (#608). One node per distinct redaction date in the act's provision_versions/ chains; it makes 'the law as of date D' a dereferenceable entity. The provisions in force at that date are the ProvisionVersion nodes whose versionValidFrom <= consolidationDate (resolved on the full load surface)."
    },
    {
      "@id": "estleg:AmendmentEvent",
      "@type": [
        "owl:Class"
      ],
      "owl:disjointWith": {
        "@id": "estleg:ProposedAmendment"
      },
      "rdfs:label": [
        {
          "@value": "Muudatussündmus",
          "@language": "et"
        },
        {
          "@value": "AmendmentEvent",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An effected amendment event — a change actually applied to an act, derived from Riigi Teataja muutmismarge markers. owl:disjointWith estleg:ProposedAmendment: a never-enacted draft proposal is not an effected legal change (issues #423, #439)."
    },
    {
      "@id": "estleg:Annex",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Lisa",
          "@language": "et"
        },
        {
          "@value": "Annex",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An annex (lisa) attached to an act. Structural sibling of Chapter / Division, not a LegalProvision."
    },
    {
      "@id": "estleg:Annotation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Annotatsioon",
          "@language": "et"
        },
        {
          "@value": "Annotation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A practitioner-facing note (guidance, commentary, practice note, warning, or interpretation) about a legal entity — a Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision, and so on. The annotation layer records how the law is applied or interpreted in practice, alongside (not inside) the law-as-written corpus. Defined for issue #40; ingestion of annotation source data is tracked separately (see the follow-up data-completeness issue)."
    },
    {
      "@id": "estleg:CaseType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Kohtuasja liik (Case Type)",
          "@language": "et"
        },
        {
          "@value": "Kohtuasja liik (Case Type)",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Kohtuasja klassifikatsioon: kriminaalasi, tsiviilasi, haldusasi, väärteoasi, põhiseaduslikkuse järelevalve.",
        "@language": "et"
      }
    },
    {
      "@id": "estleg:Chapter",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Peatükk",
          "@language": "et"
        },
        {
          "@value": "Chapter",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A chapter (peatükk) grouping provisions inside an act."
    },
    {
      "@id": "estleg:Citation",
      "@type": "owl:Class",
      "rdfs:label": [
        {
          "@value": "Viide",
          "@language": "et"
        },
        {
          "@value": "Citation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Reified preamble citation (used by KOV layer 2). Carries citationTarget, citationDetail, citationText."
    },
    {
      "@id": "estleg:Competence",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Pädevus",
          "@language": "et"
        },
        {
          "@value": "Competence",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An institutional competence assertion: an institution is competent for a provision or subject area."
    },
    {
      "@id": "estleg:Concept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Kanooniline mõiste",
          "@language": "et"
        },
        {
          "@value": "Canonical Concept",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Canonical legal concept: one node per distinct normalised legal term, aggregating every provision-local definition (estleg:LegalConcept) of that term. Replaces the former pairwise skos:exactMatch cliques between provision-local definition nodes. Kanooniline õigusmõiste — üks sõlm normaliseeritud termini kohta, mis koondab kõik sättepõhised definitsioonid."
    },
    {
      "@id": "estleg:CourtDecision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Kohtulahend",
          "@language": "et"
        },
        {
          "@value": "Court Decision",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Eesti kohtulahend – Riigikohus või esimese/teise astme kohus (maakohus, halduskohus, ringkonnakohus).",
        "@language": "et"
      },
      "dc:description": {
        "@value": "An Estonian court decision. Riigikohus lives under krr_outputs/riigikohus/; maakohus, halduskohus and ringkonnakohus under krr_outputs/kohtud/ (#525).",
        "@language": "en"
      }
    },
    {
      "@id": "estleg:DecisionType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Lahendi liik (Decision Type)",
          "@language": "et"
        },
        {
          "@value": "Lahendi liik (Decision Type)",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Lahendi tüüp: kohtuotsus, kohtumäärus, resolutsioon. Enum class folded into the controlled vocabulary (with its individuals) so estleg:DecisionTypeShape binds in every SHACL bucket (issue #563).",
        "@language": "et"
      }
    },
    {
      "@id": "estleg:Division",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Jagu",
          "@language": "et"
        },
        {
          "@value": "Division",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A division (jagu / jaotis) grouping provisions inside a chapter."
    },
    {
      "@id": "estleg:DomesticRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:Act"
      },
      "rdfs:label": [
        {
          "@value": "Siseriiklik määrus",
          "@language": "et"
        },
        {
          "@value": "DomesticRegulation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An Estonian domestic regulation (Eesti määrus) of any level — a subordinate legal act issued under an enabling Estonian law. Common superclass of the state-level (estleg:NationalRegulation) and municipal (estleg:MunicipalRegulation) regulation branches; introduced so shared domestic-regulation SHACL constraints have a single conceptual home without forcing a municipal regulation to be (mis-)classified as state-level (issue #424). Disjoint from estleg:EULegislation, which models EU-level acts."
    },
    {
      "@id": "estleg:DraftLegislation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli-dl:DraftLegislationWork"
      },
      "rdfs:label": [
        {
          "@value": "Eelnõu",
          "@language": "et"
        },
        {
          "@value": "Draft Legislation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Õigusakt, mis ei ole veel jõustunud, kuid on seadusandlikus menetluses.",
      "dc:description": "A legislative draft that has not yet been enacted into law but is in the legislative process."
    },
    {
      "@id": "estleg:DraftType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Eelnõu liik",
          "@language": "et"
        },
        {
          "@value": "Draft Type",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Eelnõu tüüp: seaduseelnõu, määruse eelnõu, korralduse eelnõu jne. Enum class folded into the controlled vocabulary (with its individuals) so estleg:DraftTypeShape binds in every SHACL bucket (issue #563)."
    },
    {
      "@id": "estleg:EUCourt",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "EL kohus",
          "@language": "et"
        },
        {
          "@value": "EU Court",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Euroopa Liidu kohtuinstants. Enum class folded into the controlled vocabulary (with its individuals) so estleg:EUCourtShape binds in every SHACL bucket (issue #563)."
    },
    {
      "@id": "estleg:EUCourtDecision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "EL kohtulahend (EU Court Decision)",
          "@language": "et"
        },
        {
          "@value": "EL kohtulahend (EU Court Decision)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Euroopa Liidu kohtu lahend — kohtuotsus, kohtumäärus, kohtujuristi ettepanek või kohtu arvamus.",
      "dc:description": "A Court of Justice of the European Union decision, including judgments, orders, AG opinions, and court opinions."
    },
    {
      "@id": "estleg:EUCourtDecisionType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "EL kohtulahendi liik (EU Court Decision Type)",
          "@language": "et"
        },
        {
          "@value": "EL kohtulahendi liik (EU Court Decision Type)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Euroopa Liidu kohtulahendi klassifikatsioon."
    },
    {
      "@id": "estleg:EUDocumentType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "EL õigusakti liik",
          "@language": "et"
        },
        {
          "@value": "EU Document Type",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Euroopa Liidu õigusakti klassifikatsioon. Enum class folded into the controlled vocabulary (with its individuals) so estleg:EUDocumentTypeShape binds in every SHACL bucket (issue #563)."
    },
    {
      "@id": "estleg:EUInstitution",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "EL institutsioon (EU Institution)",
          "@language": "et"
        },
        {
          "@value": "EL institutsioon (EU Institution)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Euroopa Liidu institutsioon või organ, mis on õigusakti autor."
    },
    {
      "@id": "estleg:EULegislation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "EL õigusakt",
          "@language": "et"
        },
        {
          "@value": "EU Legislation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Euroopa Liidu õigusakt — määrus, direktiiv või otsus.",
      "dc:description": "A European Union legal act — regulation, directive, or decision."
    },
    {
      "@id": "estleg:GeneralPartConcept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Üldosa mõiste",
          "@language": "et"
        },
        {
          "@value": "General Part Concept",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A general-part (üldosa) legal concept node, e.g. the canonical concepts the KarS general part maps onto. Declared in the curated TBox for issue #566 — used as @type in combined_ontology.jsonld but previously absent from the curated vocabulary."
    },
    {
      "@id": "estleg:GovernmentRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:NationalRegulation"
      },
      "rdfs:label": [
        {
          "@value": "Vabariigi Valitsuse määrus",
          "@language": "et"
        },
        {
          "@value": "Government Regulation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A regulation issued by the Government of the Republic."
    },
    {
      "@id": "estleg:HarmonisationLink",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Harmoniseerimisseos (Harmonisation link)",
          "@language": "et"
        },
        {
          "@value": "Harmoniseerimisseos (Harmonisation link)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Neighbour-state comparative NIM measure (LV/LT/FI/SE) sharing an EU directive with an Estonian act. Instances in combined_ontology.jsonld may be isStubNode closure stubs; real neighbour measures live in krr_outputs/harmonisation/. This class is not Estonian article-level transposition (see estleg:transposesDirective)."
    },
    {
      "@id": "estleg:HistoricalMunicipality",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Ajalooline omavalitsus",
          "@language": "et"
        },
        {
          "@value": "Historical Municipality",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A former Estonian municipality (KOV unit) that was merged or abolished by a territorial reform — chiefly the 2017 haldusreform. Modelled as a distinct node (IRI scheme estleg:HistoricalMunicipality_<formerEhakCode>) carrying its pre-merger EHAK code, pre-merger name, and an estleg:succeededBy link to the surviving current municipality, so KOV acts can be queried by issuing-time jurisdiction rather than only by present-day successor. Deliberately NOT a subclass of estleg:Municipality (the latter's SHACL shape constrains the Municipality_EHAK_<code> IRI form and requires estleg:ehakCode/estleg:county, which do not apply to abolished units). Introduced for issue #130; nodes are derived from the issuer registry's mappingEvidence citations."
    },
    {
      "@id": "estleg:Institution",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Institutsioon",
          "@language": "et"
        },
        {
          "@value": "Institution",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A public institution that issues, enforces, or is competent for law. Superclass of estleg:Issuer and estleg:EUInstitution."
    },
    {
      "@id": "estleg:Issuer",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:Institution"
      },
      "rdfs:label": [
        {
          "@value": "Väljaandja",
          "@language": "et"
        },
        {
          "@value": "Issuer",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A body that issues a regulation (a ministry, the Government, or a municipality)."
    },
    {
      "@id": "estleg:KovProvision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:label": [
        {
          "@value": "KOV säte",
          "@language": "et"
        },
        {
          "@value": "Municipal Provision",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A provision (§) of a municipal regulation."
    },
    {
      "@id": "estleg:Law",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:Act"
      },
      "rdfs:label": [
        {
          "@value": "Seadus",
          "@language": "et"
        },
        {
          "@value": "Law",
          "@language": "en"
        }
      ],
      "rdfs:comment": "An enacted legislative act (seadus)."
    },
    {
      "@id": "estleg:LegalConcept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Õigusmõiste",
          "@language": "et"
        },
        {
          "@value": "Legal Concept",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Provision-local legal-term definition node: a definition extracted from one law's definition section. Seaduses defineeritud mõiste — sättepõhine definitsioon."
    },
    {
      "@id": "estleg:LegalPart",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Õiguslik osa",
          "@language": "et"
        },
        {
          "@value": "Legal Part",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A part (osa) node within a structured act, distinct from the multipart-file estleg:Part split. Declared in the curated TBox for issue #566 — used as @type in combined_ontology.jsonld but previously absent from the curated vocabulary."
    },
    {
      "@id": "estleg:LegalProvision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli:LegalResourceSubdivision"
      },
      "rdfs:label": [
        {
          "@value": "Õigusnorm",
          "@language": "et"
        },
        {
          "@value": "Legal Provision",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Reusable base class for law and regulation provision nodes. In FRBR/ELI terms a provision is a LegalResourceSubdivision of the act Work (eli:LegalResourceSubdivision) (#440)."
    },
    {
      "@id": "estleg:LegislativePhase",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Seadusandlik etapp (Legislative Phase)",
          "@language": "et"
        },
        {
          "@value": "Seadusandlik etapp (Legislative Phase)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Eelnõu menetlusetapp EIS süsteemis. Enum class folded into the controlled vocabulary (with its individuals) so estleg:LegislativePhaseShape binds in every SHACL bucket instead of validating zero nodes (issue #563)."
    },
    {
      "@id": "estleg:MinisterialRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:NationalRegulation"
      },
      "rdfs:label": [
        {
          "@value": "Ministri määrus",
          "@language": "et"
        },
        {
          "@value": "Ministerial Regulation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A regulation issued by a minister."
    },
    {
      "@id": "estleg:MunicipalRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:DomesticRegulation"
      },
      "owl:disjointWith": {
        "@id": "estleg:NationalRegulation"
      },
      "rdfs:label": [
        {
          "@value": "KOV määrus",
          "@language": "et"
        },
        {
          "@value": "Municipal Regulation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A municipal (KOV) regulation enacted by a local-government issuer (volikogu or valitsus) — kohaliku omavalitsuse määrus. Subclass of estleg:DomesticRegulation. Deliberately NOT a subclass of estleg:NationalRegulation: a KOV määrus is local-government, not state-level, legislation, so no entailment path makes it a state regulation (issue #424; was a logical error corrected from the earlier subClassOf NationalRegulation hack). owl:disjointWith estleg:NationalRegulation (issue #439)."
    },
    {
      "@id": "estleg:Municipality",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Omavalitsus",
          "@language": "et"
        },
        {
          "@value": "Municipality",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Current Estonian municipality (KOV unit). Territorial entity, identified by EHAK code."
    },
    {
      "@id": "estleg:NationalRegulation",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:DomesticRegulation"
      },
      "owl:disjointWith": {
        "@id": "estleg:MunicipalRegulation"
      },
      "rdfs:label": [
        {
          "@value": "Riigi määrus",
          "@language": "et"
        },
        {
          "@value": "National Regulation",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A state-level Estonian regulation (riigi tasandi määrus) issued by a state organ. Superclass of the government and ministerial regulation classes. Subclass of estleg:DomesticRegulation, NOT of estleg:MunicipalRegulation: a municipal regulation is a sibling, not an instance, of this class (issue #424). owl:disjointWith estleg:MunicipalRegulation (issue #439)."
    },
    {
      "@id": "estleg:NormativeType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Normatiivne liik",
          "@language": "et"
        },
        {
          "@value": "NormativeType",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Closed deontic class of a provision or lõige (obligation, permission, prohibition, competence, or other)."
    },
    {
      "@id": "estleg:Part",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Osa",
          "@language": "et"
        },
        {
          "@value": "Part",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Multipart act part node used for large laws split into osa files."
    },
    {
      "@id": "estleg:ParliamentaryResolution",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:Act"
      },
      "rdfs:label": [
        {
          "@value": "Riigikogu otsus",
          "@language": "et"
        },
        {
          "@value": "Parliamentary resolution",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A Riigikogu otsus (parliamentary resolution). Not a seadus. Ingested from RT dokument=otsus (#529)."
    },
    {
      "@id": "estleg:ProcedureStage",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Menetlusetapp",
          "@language": "et"
        },
        {
          "@value": "Procedure Stage",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A procedural-stage node (e.g. a stage of criminal procedure under KrMS). Declared in the curated TBox for issue #566 — used as @type in combined_ontology.jsonld but previously absent from the curated vocabulary."
    },
    {
      "@id": "estleg:PresidentialDecree",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:Act"
      },
      "rdfs:label": [
        {
          "@value": "Vabariigi Presidendi seadlus",
          "@language": "et"
        },
        {
          "@value": "Presidential decree",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A presidential or historically equivalent seadlus. Not a seadus. Ingested from RT dokument=seadlus (algtekst; consolidations are not published) (#529)."
    },
    {
      "@id": "estleg:ProposedAmendment",
      "@type": [
        "owl:Class"
      ],
      "owl:disjointWith": {
        "@id": "estleg:AmendmentEvent"
      },
      "rdfs:label": [
        {
          "@value": "Kavandatud muudatus",
          "@language": "et"
        },
        {
          "@value": "ProposedAmendment",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A draft-based proposed amendment derived from a non-enacted draft bill: it proposes — but has not effected — a change to an act. Deliberately NOT a subclass of estleg:AmendmentEvent (which asserts effected legal changes); owl:disjointWith estleg:AmendmentEvent (issues #423, #439). Proposals carry estleg:proposesToAmend / estleg:publicationDate instead of estleg:amends / estleg:amendmentDate, and never estleg:isCurrentAmendment."
    },
    {
      "@id": "estleg:ProvisionVersion",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli:LegalExpression"
      },
      "rdfs:label": [
        {
          "@value": "Sätte redaktsioon",
          "@language": "et"
        },
        {
          "@value": "Provision Version",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A redaction-specific version of an estleg:LegalProvision's text. Each ProvisionVersion captures the text a provision carried during one Riigi Teataja consolidated-text redaction (terviktekst), together with the validity interval over which that text was in force. Defined for issue #131; population from historical Riigi Teataja redactions is tracked separately (see the follow-up data-completeness issue). In FRBR/ELI terms this is the Expression of the provision Work (eli:LegalExpression) (#440)."
    },
    {
      "@id": "estleg:ReferenceType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Viite liik (Reference Type)",
          "@language": "et"
        },
        {
          "@value": "Viite liik (Reference Type)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Closed enum of citation / reference-edge types (issue #513 T-Box). Individuals: estleg:RefType_Citation, estleg:RefType_Repeal, estleg:RefType_LegalBasis, estleg:RefType_Exception, estleg:RefType_Derogation. Existing unreified estleg:references edges remain untyped until a later emission pass attaches estleg:referenceType."
    },
    {
      "@id": "estleg:ReleaseDelta",
      "@type": "owl:Class",
      "rdfs:label": [
        {
          "@value": "Väljalaske muutus",
          "@language": "et"
        },
        {
          "@value": "ReleaseDelta",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Machine-readable inter-release IRI delta (added/removed act IRIs and counts). Issue #549."
    },
    {
      "@id": "estleg:Sanction",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Sanktsioon",
          "@language": "et"
        },
        {
          "@value": "Sanction",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A sanction or penalty attached to a provision or lõige."
    },
    {
      "@id": "estleg:Section",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Jaotis",
          "@language": "et"
        },
        {
          "@value": "Section",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A structural section (jagu) node of an act's hierarchy. Declared in the curated TBox for issue #566 — it is used as @type on hierarchy nodes in combined_ontology.jsonld but was previously absent from the curated vocabulary, leaving a consumer that loads only the TBox with an undeclared class.",
      "rdfs:subClassOf": {
        "@id": "estleg:LegalProvision"
      }
    },
    {
      "@id": "estleg:Similarity",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Sarnasus",
          "@language": "et"
        },
        {
          "@value": "Similarity",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Reified act-to-act similarity link (Layer 3 KOV-aware similarity): carries estleg:similarTarget, estleg:similarityScore, and estleg:similarityModel."
    },
    {
      "@id": "estleg:Subdivision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Alljaotis",
          "@language": "et"
        },
        {
          "@value": "Subdivision",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A finer subdivision (alljaotis) under a Division."
    },
    {
      "@id": "estleg:Subsection",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:label": [
        {
          "@value": "Lõige",
          "@language": "et"
        },
        {
          "@value": "Subsection",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A numbered subsection (lõige) of an estleg:LegalProvision — the level Estonian legal citations actually reference (\"TsÜS § 14 lg 2\"). One node per lõige of a paragrahv that has lõige structure; it carries the lõige number (estleg:subsectionNumber), the lõige's own text (estleg:legalText, including the inline (N) punkt markers, mirroring the provision-level legalText), and an estleg:parentProvision link back to the § node. The parent provision keeps its full concatenated estleg:legalText for backward compatibility — the subsections sum to it. Defined for issue #132 (lõige level); modelling the punkt/alapunkt level below lõige is deferred to a follow-up."
    },
    {
      "@id": "estleg:TargetGroup",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "rdfs:label": [
        {
          "@value": "Sihtrühm",
          "@language": "et"
        },
        {
          "@value": "Target Group",
          "@language": "en"
        }
      ],
      "rdfs:comment": "A reified addressee category for the estleg:targetGroup classification (#609). The five members form a SKOS concept scheme (estleg:TargetGroupScheme); each carries skos:notation equal to the legacy estleg:targetGroup string value, so the bare-string assignments resolve to first-class skos:Concepts."
    },
    {
      "@id": "estleg:TemporalStatus",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "rdfs:label": [
        {
          "@value": "Ajaliselt kehtivuse staatus (Temporal Status)",
          "@language": "et"
        },
        {
          "@value": "Ajaliselt kehtivuse staatus (Temporal Status)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "SKOS-adjacent class for the closed temporal-status vocabulary (issue #522). Members live in estleg:TemporalStatusScheme. ABox estleg:temporalStatus values remain the string tokens inForce / repealed / unknown; they are not rewritten to these IRIs."
    },
    {
      "@id": "estleg:TopicCluster",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Teemaklaster",
          "@language": "et"
        },
        {
          "@value": "Topic Cluster",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Topic grouping for provisions within a law or regulation."
    },
    {
      "@id": "estleg:UnresolvedReferencePlaceholder",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": [
        {
          "@value": "Lahendamata viite kohatäide",
          "@language": "et"
        },
        {
          "@value": "UnresolvedReferencePlaceholder",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Placeholder individual for a cited provision IRI that is not in the corpus. Kept so dangling citation targets stay dereferenceable."
    },
    {
      "@id": "estleg:actNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "akti number",
          "@language": "et"
        },
        {
          "@value": "Act Number",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Official act number or RT identifier string on an act node.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:added",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": [
        {
          "@value": "lisatud",
          "@language": "et"
        },
        {
          "@value": "added",
          "@language": "en"
        }
      ],
      "rdfs:comment": "IRI added between compared snapshots. Listed sample may be capped; see estleg:addedCount.",
      "rdfs:domain": {
        "@id": "estleg:ReleaseDelta"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:addedCount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": [
        {
          "@value": "lisatud arv",
          "@language": "et"
        },
        {
          "@value": "addedCount",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Full count of IRIs added between compared snapshots.",
      "rdfs:domain": {
        "@id": "estleg:ReleaseDelta"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "estleg:affectedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "mõjutatud",
          "@language": "et"
        },
        {
          "@value": "Affected By",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an act or provision to an AmendmentEvent that changes it.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "estleg:affectedLawName",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "mõjutatud seadus",
          "@language": "et"
        },
        {
          "@value": "affected law name",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Name of existing law this draft proposes to amend or affect. Canonical, populated draft→law link (issue #344): the literal-name form is used in place of the unpopulated IRI property estleg:amendsLaw.",
      "rdfs:domain": {
        "@id": "estleg:DraftLegislation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:amendedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "muudetud",
          "@language": "et"
        },
        {
          "@value": "Amended By",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an act to an AmendmentEvent that amended it. Inverse of estleg:amends.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      },
      "owl:inverseOf": {
        "@id": "estleg:amends"
      }
    },
    {
      "@id": "estleg:amendingAct",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "muutev akt (amending act)",
          "@language": "et"
        },
        {
          "@value": "muutev akt (amending act)",
          "@language": "en"
        }
      ],
      "rdfs:comment": "The source-derived Riigi Teataja identifier of the act that made this amendment (#587) — a citable RT reference (e.g. 'RTL, 2008, 96, 1327') or RT akt URL, parsed from the muutmismarge akt_viide. A literal (not an estleg: object ref): the amending act is often a one-off amendment law outside the enacted-law corpus, so this is a stable citation rather than a graph edge.",
      "rdfs:domain": {
        "@id": "estleg:AmendmentEvent"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:amendingDraft",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "muutev eelnõu",
          "@language": "et"
        },
        {
          "@value": "Amending Draft",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an enacted act to a draft bill that proposes to amend it.",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "estleg:amendmentDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "muudatuse kuupäev",
          "@language": "et"
        },
        {
          "@value": "Amendment Date",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Date an AmendmentEvent took effect, as xsd:date.",
      "rdfs:domain": {
        "@id": "estleg:AmendmentEvent"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:amends",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "muudab",
          "@language": "et"
        },
        {
          "@value": "Amends",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an AmendmentEvent to the act it amends. Inverse of estleg:amendedBy.",
      "rdfs:domain": {
        "@id": "estleg:AmendmentEvent"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "estleg:amendsLaw",
      "@type": [
        "owl:ObjectProperty"
      ],
      "owl:deprecated": true,
      "rdfs:label": [
        {
          "@value": "muudab seadust",
          "@language": "et"
        },
        {
          "@value": "amends law",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Deprecated (issue #344): declared but never populated — the formal draft→provision IRI link is not resolved. Drafts record the affected law as a literal via estleg:affectedLawName (the canonical, populated property) instead. Retained for backward compatibility; do not emit new references.",
      "rdfs:domain": {
        "@id": "estleg:DraftLegislation"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "estleg:annexNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "lisa number",
          "@language": "et"
        },
        {
          "@value": "Annex Number",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Ordinal or official number of an Annex.",
      "rdfs:domain": {
        "@id": "estleg:Annex"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotates",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "annoteerib",
          "@language": "et"
        },
        {
          "@value": "Annotates",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links an estleg:Annotation to the legal entity it is about. The range is intentionally unconstrained (owl:Thing): an annotation may attach to a Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision, an EU instrument, etc.",
      "rdfs:domain": {
        "@id": "estleg:Annotation"
      },
      "rdfs:range": {
        "@id": "owl:Thing"
      }
    },
    {
      "@id": "estleg:annotationDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "annotatsiooni kuupäev",
          "@language": "et"
        },
        {
          "@value": "Annotation Date",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Date on which the annotation was authored or published.",
      "rdfs:domain": {
        "@id": "estleg:Annotation"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:annotationSource",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "annotatsiooni allikas",
          "@language": "et"
        },
        {
          "@value": "Annotation Source",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Where the annotation comes from, as a human-readable string (e.g. \"Õiguskantsler\", \"RT kommentaar\", a commentary publication name). Kept as a string for now; a future iteration may replace it with an IRI to a source node.",
      "rdfs:domain": {
        "@id": "estleg:Annotation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotationSourceUrl",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "annotatsiooni allika URL",
          "@language": "et"
        },
        {
          "@value": "Annotation Source Url",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Optional link to the annotation's source document.",
      "rdfs:domain": {
        "@id": "estleg:Annotation"
      },
      "rdfs:range": {
        "@id": "xsd:anyURI"
      }
    },
    {
      "@id": "estleg:annotationText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "annotatsiooni tekst",
          "@language": "et"
        },
        {
          "@value": "Annotation Text",
          "@language": "en"
        }
      ],
      "rdfs:comment": "The body of the annotation — the practitioner note itself.",
      "rdfs:domain": {
        "@id": "estleg:Annotation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:annotationType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "annotatsiooni liik",
          "@language": "et"
        },
        {
          "@value": "Annotation Type",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Category of the annotation. SHACL constrains it to one of: \"guidance\", \"commentary\", \"practice_note\", \"warning\", \"interpretation\".",
      "rdfs:domain": {
        "@id": "estleg:Annotation"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:applicableProvision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "kohaldatav säte",
          "@language": "et"
        },
        {
          "@value": "Applicable Provision",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Provision that a court decision or annotation treats as applicable.",
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "estleg:appliesToProvision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": [
        {
          "@value": "kohaldub sättele",
          "@language": "et"
        },
        {
          "@value": "Applies To Provision",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Links a competence, sanction, or annotation to the provision it applies to.",
      "rdfs:domain": {
        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "estleg:appliesToProvisionCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "sätete arv",
          "@language": "et"
        },
        {
          "@value": "Applies To Provision Count",
          "@language": "en"
