{
  "@context": {
    "estleg": "https://w3id.org/estleg/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dc": "http://purl.org/dc/elements/1.1/",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "eli": "http://data.europa.eu/eli/ontology#",
    "eli-dl": "http://data.europa.eu/eli/eli-draft-legislation-ontology#",
    "schema": "https://schema.org/"
  },
  "@graph": [
    {
      "@id": "estleg:Act",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": [
        {
          "@id": "eli:LegalResource"
        },
        {
          "@id": "schema:Legislation"
        }
      ],
      "rdfs:label": "Act",
      "rdfs:comment": "An Estonian or EU legislative act. In FRBR/ELI terms the act node is the Work (eli:LegalResource); its addressable point-in-time consolidations are estleg:ActExpression nodes (eli:LegalExpression) reachable via estleg:hasExpression (#608). Also rdfs:subClassOf schema:Legislation so generic schema.org clients see acts as Legislation without a 1190-peep rewrite (#543)."
    },
    {
      "@id": "estleg:ActExpression",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli:LegalExpression"
      },
      "rdfs:label": "Akti redaktsioon (Act Expression)",
      "rdfs:comment": "An addressable consolidated expression of an act as in force from a given consolidation date — the FRBR Expression / ELI eli:LegalExpression of the act-as-Work (#608). One node per distinct redaction date in the act's provision_versions/ chains; it makes 'the law as of date D' a dereferenceable entity. The provisions in force at that date are the ProvisionVersion nodes whose versionValidFrom <= consolidationDate (resolved on the full load surface)."
    },
    {
      "@id": "estleg:expressionOf",
      "@type": [
        "owl:ObjectProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "eli:realizes"
      },
      "rdfs:label": "akti redaktsioon (expression of)",
      "rdfs:comment": "Links an estleg:ActExpression to the act (Work) it consolidates (#608). Aligned to eli:realizes (Expression -> Work).",
      "rdfs:domain": {
        "@id": "estleg:ActExpression"
      },
      "rdfs:range": {
        "@id": "estleg:Act"
      }
    },
    {
      "@id": "estleg:hasExpression",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "on redaktsioon (has expression)",
      "rdfs:comment": "Links an act (Work) to its point-in-time consolidations (estleg:ActExpression). Inverse of estleg:expressionOf (#608).",
      "rdfs:domain": {
        "@id": "estleg:Act"
      },
      "owl:inverseOf": {
        "@id": "estleg:expressionOf"
      }
    },
    {
      "@id": "estleg:consolidationDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "redaktsiooni kuupäev (consolidation date)",
      "rdfs:comment": "The date from which an estleg:ActExpression's consolidated text is in force (#608) — the distinct redaction date drawn from the act's provision_versions/ chains.",
      "rdfs:domain": {
        "@id": "estleg:ActExpression"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:supersededByExpression",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "asendatud redaktsiooniga (superseded by expression)",
      "rdfs:comment": "Links an estleg:ActExpression to the next-later consolidation of the same act (#608 phase 2), chaining the act's consolidations into a navigable FRBR temporal sequence; the chain head (no value) is the current consolidation. The per-provision membership of an expression is derivable from the provision_versions sidecars (versionValidFrom <= consolidationDate, latest per provision), so it is not materialised (~1.3M edges).",
      "rdfs:domain": {
        "@id": "estleg:ActExpression"
      },
      "rdfs:range": {
        "@id": "estleg:ActExpression"
      },
      "owl:inverseOf": {
        "@id": "estleg:supersedesExpression"
      }
    },
    {
      "@id": "estleg:supersedesExpression",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "asendab redaktsiooni (supersedes expression)",
      "rdfs:comment": "Links an estleg:ActExpression to the previous consolidation of the same act it supersedes (#608 phase 2). Inverse of estleg:supersededByExpression.",
      "rdfs:domain": {
        "@id": "estleg:ActExpression"
      },
      "rdfs:range": {
        "@id": "estleg:ActExpression"
      },
      "owl:inverseOf": {
        "@id": "estleg:supersededByExpression"
      }
    },
    {
      "@id": "estleg:AmendmentEvent",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "AmendmentEvent",
      "rdfs:comment": "An effected amendment event — a change actually applied to an act, derived from Riigi Teataja muutmismarge markers. owl:disjointWith estleg:ProposedAmendment: a never-enacted draft proposal is not an effected legal change (issues #423, #439).",
      "owl:disjointWith": {
        "@id": "estleg:ProposedAmendment"
      }
    },
    {
      "@id": "estleg:Annex",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Annex",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:Chapter",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Chapter",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:Competence",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Competence",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:Concept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Kanooniline mõiste (Canonical Concept)",
      "rdfs:comment": "Canonical legal concept: one node per distinct normalised legal term, aggregating every provision-local definition (estleg:LegalConcept) of that term. Replaces the former pairwise skos:exactMatch cliques between provision-local definition nodes. Kanooniline õigusmõiste — üks sõlm normaliseeritud termini kohta, mis koondab kõik sättepõhised definitsioonid."
    },
    {
      "@id": "estleg:Division",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Division",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:Institution",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Institution",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:LegalConcept",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Õigusmõiste (Legal Concept)",
      "rdfs:comment": "Provision-local legal-term definition node: a definition extracted from one law's definition section. Seaduses defineeritud mõiste — sättepõhine definitsioon."
    },
    {
      "@id": "estleg:LegalProvision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:subClassOf": {
        "@id": "eli:LegalResourceSubdivision"
      },
      "rdfs:label": "Legal Provision",
      "rdfs:comment": "Reusable base class for law and regulation provision nodes. In FRBR/ELI terms a provision is a LegalResourceSubdivision of the act Work (eli:LegalResourceSubdivision) (#440)."
    },
    {
      "@id": "estleg:NormativeType",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "NormativeType",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:Part",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Part",
      "rdfs:comment": "Multipart act part node used for large laws split into osa files."
    },
    {
      "@id": "estleg:ProposedAmendment",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "ProposedAmendment",
      "rdfs:comment": "A draft-based proposed amendment derived from a non-enacted draft bill: it proposes — but has not effected — a change to an act. Deliberately NOT a subclass of estleg:AmendmentEvent (which asserts effected legal changes); owl:disjointWith estleg:AmendmentEvent (issues #423, #439). Proposals carry estleg:proposesToAmend / estleg:publicationDate instead of estleg:amends / estleg:amendmentDate, and never estleg:isCurrentAmendment.",
      "owl:disjointWith": {
        "@id": "estleg:AmendmentEvent"
      }
    },
    {
      "@id": "estleg:Sanction",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Sanction",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:Subdivision",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Subdivision",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:TopicCluster",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "Topic Cluster",
      "rdfs:comment": "Topic grouping for provisions within a law or regulation."
    },
    {
      "@id": "estleg:UnresolvedReferencePlaceholder",
      "@type": [
        "owl:Class"
      ],
      "rdfs:label": "UnresolvedReferencePlaceholder",
      "rdfs:comment": "Reusable class materialized for vocabulary coverage validation."
    },
    {
