    {
      "@id": "estleg:amendingAct",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "muutev akt (amending act)",
      "rdfs:comment": "The source-derived Riigi Teataja identifier of the act that made this amendment (#587) — a citable RT reference (e.g. 'RTL, 2008, 96, 1327') or RT akt URL, parsed from the muutmismarge akt_viide. A literal (not an estleg: object ref): the amending act is often a one-off amendment law outside the enacted-law corpus, so this is a stable citation rather than a graph edge.",
      "rdfs:domain": {
        "@id": "estleg:AmendmentEvent"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:amends",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Amends",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:annexNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Annex Number",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:applicableProvision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Applicable Provision",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:appliesToProvision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Applies To Provision",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:appliesToProvisionCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Applies To Provision Count",
      "rdfs:range": {
        "@id": "xsd:integer"
      },
      "rdfs:comment": "Full number of provisions a Competence node applies to, recorded alongside the (capped) estleg:appliesToProvision list on per-institution files — so consumers see the true total even when the IRI list is truncated for size (see scripts/extract_institutional_competence.py)."
    },
    {
      "@id": "estleg:belongsToCluster",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Belongs To Cluster",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:caseTypeCode",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Case Type Code",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:chapterNumber",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Chapter Number",
      "rdfs:comment": "Chapter number literal emitted on estleg:Chapter hierarchy nodes."
    },
    {
      "@id": "estleg:competenceArea",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Competence Area",
      "rdfs:comment": "Coarse thematic area for cross-institution grouping on estleg:Competence nodes."
    },
    {
      "@id": "estleg:competenceType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Competence Type",
      "rdfs:comment": "Type of an institution's competence over a provision: general, enforcement, supervision, regulation, or licensing. HEURISTIC: a single provision-level type is inferred from verb cues and attached to every institution named in the provision (#577); it does not associate each institution with the specific verb it governs, so treat as advisory."
    },
    {
      "@id": "estleg:competentAuthority",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Competent Authority",
      "rdfs:comment": "Links a provision to an institution named as competent in its text. HEURISTIC: extracted by institution-name detection over the provision text (#577); a named institution is not always the competent body for the provision's operative act, so treat as advisory."
    },
    {
      "@id": "estleg:counts",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Counts",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:contentStatus",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Content Status",
      "rdfs:comment": "Structured-body status marker on act nodes, including noStructuredBody stubs."
    },
    {
      "@id": "estleg:contentStatusReason",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Content Status Reason",
      "rdfs:comment": "Human-readable explanation for an act node's estleg:contentStatus marker."
    },
    {
      "@id": "estleg:changeType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Change Type",
      "rdfs:comment": "Type of change a draft proposes: amends, repeals, supplements, or enacts. SHACL-shaped as xsd:string; T-Box node added for issue #341.11.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:coversConcept",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Covers Concept",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:definedIn",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "defineeritud (Defined In)",
      "rdfs:comment": "Links a provision-local legal-term definition node (estleg:LegalConcept) to the provision where the term is defined. Inverse of estleg:definesTerm. (The canonical estleg:Concept node → definition-node membership uses estleg:hasDefinitionNode instead, so this property's inverse-of axiom does not corrupt the definesTerm semantics.)"
    },
    {
      "@id": "estleg:definesConcept",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "defineerib kanoonilise mõiste (Defines Concept)",
      "rdfs:comment": "Links a provision-local legal-term definition node (estleg:LegalConcept) to the canonical estleg:Concept node for that term — the hub link that replaces the former O(k²) skos:exactMatch clique."
    },
    {
      "@id": "estleg:definesTerm",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "defineerib mõiste (Defines Term)",
      "rdfs:comment": "Links a LegalProvision to the provision-local estleg:LegalConcept it defines. Inverse of estleg:definedIn. SHACL-shaped and documented; T-Box node added for issue #341.11.",
      "rdfs:domain": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:range": {
        "@id": "estleg:LegalConcept"
      },
      "owl:inverseOf": {
        "@id": "estleg:definedIn"
      }
    },
    {
      "@id": "estleg:definitionCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "definitsioonide arv (Definition Count)",
      "rdfs:comment": "Number of provision-local definitions aggregated by a canonical estleg:Concept node. Range: xsd:integer."
    },
    {
      "@id": "estleg:definitionVariantCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "definitsioonivariantide arv (Definition Variant Count)",
      "rdfs:comment": "Total number of distinct definition wordings observed for a canonical estleg:Concept node when only a capped subset is emitted as skos:definition. Range: xsd:integer."
    },
    {
      "@id": "estleg:documentType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Document Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:dutyHolder",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Duty Holder",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:entryIntoForce",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "eli:date_entry_in_force"
      },
      "rdfs:label": "Entry Into Force",
      "rdfs:comment": "Date the act or amendment entered into force. rdfs:subPropertyOf eli:date_entry_in_force (#440). Comparable to schema:legislationDate; not a second rdfs:subPropertyOf (#543)."
    },
    {
      "@id": "estleg:euCourtCode",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Eu Court Code",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:euInstitutionCode",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Eu Institution Code",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:globalId",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Global Id",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:grantedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Granted By",
      "rdfs:comment": "Act IRI under which a reified estleg:Competence is granted."
    },
    {
      "@id": "estleg:hasAnnex",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Annex",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:hasChapter",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Chapter",
      "rdfs:comment": "Links a statute part (estleg:LegalPart) to its chapters (#567 OWL-DL TBox completion).",
      "rdfs:domain": {
        "@id": "estleg:LegalPart"
      },
      "rdfs:range": {
        "@id": "estleg:Chapter"
      }
    },
    {
      "@id": "estleg:hasCompetence",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Competence",
      "rdfs:comment": "Links an estleg:Institution to its reified estleg:Competence nodes. Inverse of estleg:institution on Competence nodes (issue #365).",
      "rdfs:domain": {
        "@id": "estleg:Institution"
      },
      "rdfs:range": {
        "@id": "estleg:Competence"
      },
      "owl:inverseOf": {
        "@id": "estleg:institution"
      }
    },
    {
      "@id": "estleg:hasDefinitionNode",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "defineeriv sõlm (Has Definition Node)",
      "rdfs:comment": "Links a canonical estleg:Concept node to every provision-local definition node (estleg:LegalConcept) that defines that term. Inverse of estleg:definesConcept. Introduced (#134, Finding F3) as a property distinct from estleg:definedIn so the latter's owl:inverseOf estleg:definesTerm axiom does not falsely conclude that a LegalConcept estleg:definesTerm a Concept.",
      "owl:inverseOf": {
        "@id": "estleg:definesConcept"
      }
    },
    {
      "@id": "estleg:hasDivision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Division",
      "rdfs:comment": "Links a chapter (estleg:Chapter) to its divisions (#567 OWL-DL TBox completion).",
      "rdfs:domain": {
        "@id": "estleg:Chapter"
      },
      "rdfs:range": {
        "@id": "estleg:Division"
      }
    },
    {
      "@id": "estleg:hasProvision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Provision",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:hasProposedAmendment",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Proposed Amendment",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation. Act-root back-link to estleg:ProposedAmendment nodes (non-enacted draft proposals); the proposal-scoped counterpart of estleg:amendedBy. Inverse of estleg:proposesToAmend. See issue #423.",
      "owl:inverseOf": {
        "@id": "estleg:proposesToAmend"
      }
    },
    {
      "@id": "estleg:hasPart",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Part",
      "rdfs:comment": "Links hierarchy nodes to their child part or division nodes."
    },
    {
      "@id": "estleg:hasSanction",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Sanction",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:hasSection",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Section",
      "rdfs:comment": "Links a hierarchy node (chapter/division/subdivision) to its sections (#567 OWL-DL TBox completion). Deliberately no rdfs:domain and no rdfs:range — sections attach at several hierarchy levels; objects include UnresolvedReferencePlaceholder stubs, and a range would RDFS-type those stubs as estleg:Section under the bucket SHACL gate (issue #377)."
    },
    {
      "@id": "estleg:hasSubdivision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Has Subdivision",
      "rdfs:comment": "Links a division (estleg:Division) to its subdivisions (#567 OWL-DL TBox completion).",
      "rdfs:domain": {
        "@id": "estleg:Division"
      },
      "rdfs:range": {
        "@id": "estleg:Subdivision"
      }
    },
    {
      "@id": "estleg:inChapter",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "In Chapter",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:inDivision",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "In Division",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:inPart",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "In Part",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:institution",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Institution",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:institutionType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Institution Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:interpretedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Interpreted By",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation. Inverse of estleg:interpretsLaw (estleg:interpretsLaw is the canonical T-Box definition; it lives in krr_outputs/riigikohus/riigikohus_schema.json with its rdfs:domain/rdfs:range).",
      "owl:inverseOf": {
        "@id": "estleg:interpretsLaw"
      }
    },
    {
      "@id": "estleg:interpretsEULaw",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "interprets EU law",
      "rdfs:comment": "Links an estleg:EUCourtDecision to an estleg:EULegislation node named in the decision label (CELEX/directive/regulation citation). Domain may be estleg:EUCourtDecision. Deliberately NO rdfs:range — objects are often bare estleg:EU_* stubs inside the curia SHACL bucket; a range would phantom-type them as EULegislation under inference=rdfs.",
      "rdfs:domain": {
        "@id": "estleg:EUCourtDecision"
      }
    },
    {
      "@id": "estleg:interpretsLaw",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Interprets Law",
      "rdfs:comment": "Coverage + combined graph-closure stub for the inverse of estleg:interpretedBy. The canonical T-Box definition (with rdfs:domain/rdfs:range) lives in krr_outputs/riigikohus/riigikohus_schema.json; this stub exists so the estleg:interpretedBy owl:inverseOf axiom resolves inside combined_ontology.jsonld, which does not include riigikohus_schema.json.",
      "owl:inverseOf": {
        "@id": "estleg:interpretedBy"
      }
    },
    {
      "@id": "estleg:interpretsVersion",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "tõlgendab redaktsiooni (interprets version)",
      "rdfs:comment": "Links a court decision to the estleg:ProvisionVersion that was in force (versionValidFrom <= decisionDate <= versionValidTo) for each provision it interpreted (issue #618). Derived offline by scripts/derive_court_interpretation_staleness.py from the provision_versions/ sidecars. NB: deliberately carries NO rdfs:range estleg:ProvisionVersion — the version nodes live in the separate provision_versions load surface, so in the riigikohus/combined surface these objects are bare cross-reference stubs; an rdfs:range would RDFS-type them under the SHACL buckets' rdfs inference and trip ProvisionVersion constraints. This is a version-layer edge: it is STRIPPED from combined_ontology.jsonld via estleg_common.COMBINED_STRIPPED_PREDICATES and resolves only on the full seadusloome load surface (which includes provision_versions/).",
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      }
    },
    {
      "@id": "estleg:interpretationOutdated",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "tõlgendus aegunud (interpretation outdated)",
      "rdfs:comment": "True when at least one provision this decision interpreted has a later redaction (a version whose versionValidFrom is after the decisionDate) — i.e. the law was amended after the ruling, so the precedent may be outdated (issue #618). Derived offline by scripts/derive_court_interpretation_staleness.py. Self-contained on the decision node, so it is retained in combined_ontology.jsonld.",
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "estleg:earliestSupersedingDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "varaseim asendav kuupäev (earliest superseding date)",
      "rdfs:comment": "When estleg:interpretationOutdated is true, the earliest date on which an interpreted provision was superseded by a newer redaction after the decisionDate (issue #618). Derived offline by scripts/derive_court_interpretation_staleness.py.",
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "estleg:isCurrentAmendment",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Is Current Amendment",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation. Boolean flag (xsd:boolean) marking the most recent AmendmentEvent / draft link in an amendment chain."
    },
    {
      "@id": "estleg:isKov",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Is Kov",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:isPartOf",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Is Part Of",
      "rdfs:comment": "Links a provision, division, or hierarchy node to its containing act structure node."
    },
    {
      "@id": "estleg:isStatutoryDefault",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Is Statutory Default",
      "rdfs:comment": "True when a sanction's penalty value comes from a statutory ceiling (e.g. KarS § 44 daily-rate cap, KarS § 48 arrest cap) rather than the offence provision text.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "estleg:isStubNode",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Is Stub Node",
      "rdfs:comment": "Build/serialisation marker, NOT a semantic assertion about the entity (#416). True on a lightweight graph-closure stub minted into combined_ontology.jsonld: a leaf node carrying only @type, rdfs:label, an identifier and an external link for a cross-corpus reference (court/EU/draft/regulation/amendment/harmonisation) whose full node lives in a sibling corpus. It is scoped to the combined artifact so combined loads with zero dangling references. When a consumer ALSO loads the sibling subcorpus, RDF merging yields the complete node still bearing this flag — at that point the complete node takes precedence and the flag should be disregarded. Do not treat it as a published claim that the referenced entity is incomplete.",
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "estleg:issuer",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Issuer",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:jsonld",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Jsonld",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:jurisdiction",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Jurisdiction",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:kehtiv",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Kehtiv",
      "rdfs:comment": "Riigi Teataja snapshot date stamped on generated act nodes — the --kehtiv consolidation date of the committed text, not eli:date_publication (#440, #432)."
    },
    {
      "@id": "estleg:lastAmendmentDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Last Amendment Date",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:legalText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "schema:text"
      },
      "rdfs:label": "Legal Text",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation. rdfs:subPropertyOf schema:text (#543)."
    },
    {
      "@id": "estleg:mappedPart",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Mapped Part",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:mapsToGeneralPart",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Maps To General Part",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:maxPenalty",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty",
      "rdfs:comment": "Maximum penalty as a human-readable display string (e.g. '5 years', '300 fine units', '15000 EUR'); see estleg:maxPenaltyAmount/Unit/Currency for the structured form."
    },
    {
      "@id": "estleg:maxPenaltyAmount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty Amount",
      "rdfs:comment": "Numeric value of the maximum penalty (e.g. 5, 300, 15000), paired with estleg:maxPenaltyUnit. Emitted only when the display string parses confidently into amount + unit.",
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:maxPenaltyCurrency",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty Currency",
      "rdfs:comment": "Currency code (e.g. 'EUR') for a monetary maximum penalty; present only when estleg:maxPenaltyUnit is 'monetary'.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:maxPenaltyUnit",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Max Penalty Unit",
      "rdfs:comment": "Unit of estleg:maxPenaltyAmount; one of years, months, days, daily_rates (KarS päevamäär), fine_units (väärteo trahviühik), monetary (a fixed monetary sum).",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:minPenalty",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty",
      "rdfs:comment": "Minimum penalty as a human-readable display string; see estleg:minPenaltyAmount/Unit/Currency for the structured form."
    },
    {
      "@id": "estleg:minPenaltyAmount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty Amount",
      "rdfs:comment": "Numeric value of the minimum penalty, paired with estleg:minPenaltyUnit. Emitted only when the display string parses confidently into amount + unit.",
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:minPenaltyCurrency",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty Currency",
      "rdfs:comment": "Currency code (e.g. 'EUR') for a monetary minimum penalty; present only when estleg:minPenaltyUnit is 'monetary'.",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:minPenaltyUnit",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Min Penalty Unit",
      "rdfs:comment": "Unit of estleg:minPenaltyAmount; same controlled set as estleg:maxPenaltyUnit (years, months, days, daily_rates, fine_units, monetary).",
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:normativeType",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Normative Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:note",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Note",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:paragrahv",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Paragrahv",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:partOfAct",
      "@type": [
        "owl:ObjectProperty",
        "owl:FunctionalProperty"
      ],
      "rdfs:label": "osa aktist (part of act)",
      "rdfs:comment": "IRI link from a provision (or Chapter) to its parent act root. owl:FunctionalProperty: a provision belongs to at most one act (issue #522). Distinct from the literal estleg:sourceAct title.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "estleg:LegalProvision"
            },
            {
              "@id": "estleg:Chapter"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "estleg:Act"
      }
    },
    {
      "@id": "estleg:phaseOrder",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Phase Order",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:preambleText",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Preamble Text",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:proposesToAmend",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Proposes To Amend",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation. Links an estleg:ProposedAmendment (a non-enacted draft proposal) to the act(s) it proposes to amend; the proposal-scoped counterpart of estleg:amends, which is reserved for effected changes. Inverse of estleg:hasProposedAmendment. See issue #423.",
      "owl:inverseOf": {
        "@id": "estleg:hasProposedAmendment"
      }
    },
    {
      "@id": "estleg:provenanceUnverified",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Provenance Unverified",
      "rdfs:comment": "True on an estleg:Sanction whose source provision text is absent from the published graph: the penalty's municipal-regulation provision (estleg:Reg_<id>_Par_N) exists only as a textless graph-closure stub with no estleg:legalText, so the penalty cannot be verified against its source text. A data-preserving annotation (the sanction is retained, not deleted), set by scripts/flag_unverified_sanctions_586.py (#586).",
      "rdfs:domain": {
        "@id": "estleg:Sanction"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "estleg:provisionCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Provision Count",
      "rdfs:comment": "Number of provisions represented by a generated topic cluster."
    },
    {
      "@id": "estleg:referencedBy",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Referenced By",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:references",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "dcterms:references"
      },
      "rdfs:label": "References",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation. Inverse of estleg:referencedBy. rdfs:subPropertyOf dcterms:references (#543).",
      "owl:inverseOf": {
        "@id": "estleg:referencedBy"
      }
    },
    {
      "@id": "estleg:relatesToConcept",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Relates To Concept",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:repealDate",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:subPropertyOf": {
        "@id": "eli:date_no_longer_in_force"
      },
      "rdfs:label": "Repeal Date",
      "rdfs:comment": "Date the act ceased to be in force. rdfs:subPropertyOf eli:date_no_longer_in_force (#440)."
    },
    {
      "@id": "estleg:requestedCluster",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Requested Cluster",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:topicCluster",
      "@type": [
        "owl:ObjectProperty"
      ],
      "rdfs:label": "Topic Cluster",
      "rdfs:comment": "Links a LegalProvision to its topic-cluster subject node. SHACL-shaped and documented; T-Box node added for issue #341.11.",
      "rdfs:domain": {
        "@id": "estleg:LegalProvision"
      },
      "rdfs:range": {
        "@id": "estleg:TopicCluster"
      }
    },
    {
      "@id": "estleg:rtReference",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Rt Reference",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
    {
      "@id": "estleg:sanctionType",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": "Sanction Type",
      "rdfs:comment": "Reusable property observed in generated corpus and materialized for vocabulary coverage validation."
    },
