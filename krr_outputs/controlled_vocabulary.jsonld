    {
      "@id": "estleg:personalDataMaskedCount",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "eemaldatud isikuandmete arv",
          "@language": "et"
        },
        {
          "@value": "personal data masked count",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "How many Estonian personal identification codes (isikukood) were replaced by the placeholder in this decision's estleg:summary and estleg:legalText. Zero means the decision was screened and nothing matched. Accumulates across the summary and full-text passes; masked forms are recorded in krr_outputs/reports/personal_data_mask_report.json (#683).",
        "@language": "en"
      },
      "rdfs:domain": {
        "@id": "estleg:CourtDecision"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
