        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:sourceStructure",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "lähte struktuur",
          "@language": "et"
        },
        {
          "@value": "Source Structure",
          "@language": "en"
        }
      ],
      "rdfs:comment": "Free-text description of the source document's structure.",
      "rdfs:domain": {
        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "estleg:sourceUrl",
      "@type": [
        "owl:DatatypeProperty"
      ],
      "rdfs:label": [
        {
          "@value": "lähte URL",
          "@language": "et"
        },
        {
          "@value": "Source Url",
          "@language": "en"
        }
      ],
      "rdfs:comment": "HTTP(S) URL of the source document or HTML consolidation.",
