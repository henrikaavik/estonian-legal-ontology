      "estleg:requestedCluster": {
        "@id": "hooldusoigus"
      },
      "estleg:summary": "Kirjeldab isikuhoolduse sisu: kasvatamine, järelevalve, viibimiskoha määramine ja lapse heaolu tagamine.",
