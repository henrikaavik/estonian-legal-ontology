    {
      "@id": "estleg:PKS_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 1",
      "rdfs:label": "§ 1. Abielu sõlmimise eeldused",
      "estleg:requestedCluster": {
        "@id": "abielu"
      },
      "estleg:summary": "Sätestab abielu sõlmimise põhitingimused, sh abiellumisea ja teovõime nõuded.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 4",
      "rdfs:label": "§ 4. Mitme samaaegse abielu keeld",
      "estleg:requestedCluster": {
        "@id": "abielu"
      },
      "estleg:summary": "Keelab abielu sõlmimise isikuga, kes on juba abielus.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_7",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 7",
      "rdfs:label": "§ 7. Abielu sõlmimise kord",
      "estleg:requestedCluster": {
        "@id": "abielu"
      },
      "estleg:summary": "Määrab abielu sõlmimise menetluse perekonnaseisuametniku juuresolekul ja tahteavalduse vorminõuded.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_15",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 15",
      "rdfs:label": "§ 15. Abieluline kooselu ning abikaasade õigused ja kohustused",
      "estleg:requestedCluster": {
        "@id": "abielu"
      },
      "estleg:summary": "Kirjeldab abikaasade võrdsed õigused, vastastikuse lugupidamise kohustuse ja perekonna ühise korraldamise põhimõtted.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_16",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 16",
      "rdfs:label": "§ 16. Perekonna ülalpidamise kohustus",
      "estleg:requestedCluster": {
        "@id": "abielu"
      },
      "estleg:summary": "Paneb abikaasadele vastastikuse kohustuse panustada töö ja varaga perekonna ülalpidamisse.",
      "estleg:sourceAct": "Perekonnaseadus",
      "estleg:referencedBy": [
        {
          "@id": "estleg:Reg_1056858_Par_2"
        }
      ]
    },
    {
      "@id": "estleg:PKS_Par_63",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 63",
      "rdfs:label": "§ 63. Abielu lõppemise alused",
      "estleg:requestedCluster": {
        "@id": "lahutus"
      },
      "estleg:summary": "Määrab abielu lõppemise alused: abikaasa surm või abielu lahutamine.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_64",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 64",
      "rdfs:label": "§ 64. Abielu lahutamine perekonnaseisuasutuses",
      "estleg:requestedCluster": {
        "@id": "lahutus"
      },
      "estleg:summary": "Võimaldab lahutust vastastikusel kokkuleppel perekonnaseisuasutuses ühise avalduse alusel.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_65",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 65",
      "rdfs:label": "§ 65. Abielu lahutamine kohtus",
      "estleg:requestedCluster": {
        "@id": "lahutus"
      },
      "estleg:summary": "Reguleerib lahutust kohtumenetluses, sh vaidluse korral või kui perekonnaseisuasutus pole pädev.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_67",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 67",
      "rdfs:label": "§ 67. Abielusuhete lõppemine",
      "estleg:requestedCluster": {
        "@id": "lahutus"
      },
      "estleg:summary": "Seob lahutuse eeldusega, et abielusuhted on pöördumatult lõppenud, ning sätestab lepitamise võimalused.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_68",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 68",
      "rdfs:label": "§ 68. Perekonna eluase abielu lahutamise korral",
      "estleg:requestedCluster": {
        "@id": "lahutus"
      },
      "estleg:summary": "Annab kohtule õiguse lahutuse korral määrata perekonna eluaseme kasutusõigused, arvestades eeskätt laste heaolu.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_82",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 82",
      "rdfs:label": "§ 82. Põlvnemise õiguslik tähendus",
      "estleg:requestedCluster": {
        "@id": "lapsevanemate_suhted"
      },
      "estleg:summary": "Vanemate ja lapse õigused ning kohustused tulenevad seaduses kindlaks tehtud põlvnemisest.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_83",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 83",
      "rdfs:label": "§ 83. Ema",
      "estleg:requestedCluster": {
        "@id": "lapsevanemate_suhted"
      },
      "estleg:summary": "Määratleb lapse emana naise, kes on lapse sünnitanud.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_84",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 84",
      "rdfs:label": "§ 84. Isa",
      "estleg:requestedCluster": {
        "@id": "lapsevanemate_suhted"
      },
      "estleg:summary": "Sätestab isaduse alused: abielueeldus, isaduse omaksvõtt või kohtulik tuvastamine.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_87",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 87",
      "rdfs:label": "§ 87. Isaduse omaksvõtt",
      "estleg:requestedCluster": {
        "@id": "lapsevanemate_suhted"
      },
      "estleg:summary": "Reguleerib isaduse omaksvõtu eeldusi ja vormi, sh isikliku tahteavalduse nõuet.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_89",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 89",
      "rdfs:label": "§ 89. Isaduse omaksvõtuga nõustumine",
      "estleg:requestedCluster": {
        "@id": "lapsevanemate_suhted"
      },
      "estleg:summary": "Määrab nõusoleku andjad ja tingimused isaduse omaksvõtuks, kaitstes ema ning lapse huve.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_91",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 91",
      "rdfs:label": "§ 91. Isaduse vaidlustamine",
      "estleg:requestedCluster": {
        "@id": "lapsevanemate_suhted"
      },
      "estleg:summary": "Sätestab isaduse vaidlustamise õigustatud isikud ja vaidlustamise tähtajad.",
      "estleg:sourceAct": "Perekonnaseadus"
    },
    {
      "@id": "estleg:PKS_Par_116",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_PKS"
      ],
      "estleg:paragrahv": "§ 116",
      "rdfs:label": "§ 116. Vanema hooldusõiguse põhimõtted",
      "estleg:requestedCluster": {
        "@id": "hooldusoigus"
