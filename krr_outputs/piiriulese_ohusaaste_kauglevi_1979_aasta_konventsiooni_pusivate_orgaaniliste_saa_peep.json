      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Baasaasta valimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Piiriülese õhusaaste kauglevi 1979. aasta konventsiooni püsivate orgaaniliste saasteainete protokolliga ühinemise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:POKKPOSP1979_Map"
      },
      "estleg:summary": {
        "@value": "Ühinemisel teatada, et vastavalt protokolli artikli 3 lõike 5 punktile a valis Eesti Vabariik baasaastad järgmiselt: 1) polütsüklilised aromaatsed süsivesinikud (PAH) – 1995. aasta; 2) polükloriidsed dibensoparadioksiinid (PCDD) ja polükloriidsed dibensofuraanid (PCDF) – 1990. aasta; 3) heksaklorobenseen (HCB) – 1995. aasta.",
        "@language": "et"
      },
      "estleg:legalText": "Ühinemisel teatada, et vastavalt protokolli artikli 3 lõike 5 punktile a valis Eesti Vabariik baasaastad järgmiselt: 1) polütsüklilised aromaatsed süsivesinikud (PAH) – 1995. aasta; 2) polükloriidsed dibensoparadioksiinid (PCDD) ja polükloriidsed dibensofuraanid (PCDF) – 1990. aasta; 3) heksaklorobenseen (HCB) – 1995. aasta.",
