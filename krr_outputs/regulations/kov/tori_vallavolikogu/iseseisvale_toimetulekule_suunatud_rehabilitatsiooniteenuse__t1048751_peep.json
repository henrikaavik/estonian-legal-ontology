        },
        {
          "@id": "estleg:Reg_1048751_Par_4_Lg_4"
        },
        {
          "@id": "estleg:Reg_1048751_Par_4_Lg_5"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_tori_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1048751_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Teenuse osutamiseks hindab Tori Vallavalitsuse sotsiaalosakonna vastav spetsialist isiku teenuse vajadust ja hindamise järgselt korraldab teenuse osutamise.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048751_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_tori_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1048751_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenuse mahu ja teenuse eest tasumise otsustab Tori Vallavalitsuse sotsiaalosakonna vastav spetsialist. Teenusel osalemine on kohustuslik teenusele suunatud toimetulekutoetust taotlevatele mittetöötavatele isikutele ning nende täisealistele mittetöötavatele või töötamisega võrdsustatud tegevusega hõivamata leibkonna liikmetele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048751_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_tori_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1048751_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Teenuse osutamise otsuse järgselt suunatakse isik teenuse pakkuja juurde vastava suunamiskirjaga, millel on märgitud teenuse saaja andmed ning teenuse maht.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048751_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1048751_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Vallavalitsus võib jätta toimetulekutoetuse määramata töövõimelisele 18-aastasele kuni vanaduspensioniealisele isikule, kes ei tööta ega õpi, kui isik on rohkem kui ühel korral ilma mõjuva põhjuseta keeldunud osalemast vallavalitsuse korraldataval iseseisvale toimetulekule suunatud rehabilitatsiooniteenusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048751_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_tori_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1048751_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Teenust osutab asutus, ettevõte või mittetulundusühing, kes omab vastava kvalifikatsiooniga spetsialiste ning kellega vallavalitsus on sõlminud kokkuleppe.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048751_Par_4"
      },
      "rdfs:label": "§ 4 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_tori_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1048751_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Teenuse osutamise tingimused",
        "@language": "et"
      },
      "estleg:sourceAct": "Iseseisvale toimetulekule suunatud rehabilitatsiooniteenuse osutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Teenuse osutaja koostab teenuse saajale vajadusel individuaalse tegevuskava. 2 (2) Sotsiaalosakonna vastaval spetsialistil on õigus kontrollida individuaalse tegevuskava täitmist. 3 (3) Teenuse osutaja tagab teenuse saajatele töises tegevuses osalemisel ohutud tingimused ning tööohutusalase juhendamise. 4 (4) Teenuse osutamise lõpetamise või pikendamise otsustab toimetulekutoetuse määramise eest vastutav spetsialist.",
        "@language": "et"
      },
