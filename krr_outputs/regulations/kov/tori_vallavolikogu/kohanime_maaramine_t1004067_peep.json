      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Paragrahvi pealkiri",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramine",
      "estleg:summary": {
        "@value": "Määrata kohanimi Kääriku tee Tori vallas Selja külas Saare katastriüksustel (tunnus 80801:001:0060) ja (tunnus 80801:001:0065), Pärna katastriüksusel (tunnus 80801:001:0108), Tamme katastriüksusel (tunnus 80801:001:0597), Aivo katastriüksusel (tunnus 80801:001:0107) ja Kääriku katastriüksusel (tunnus 80801:001:0039) asuvale Kääriku teele (reg. nr 8080329). Kääriku tee algab Pärnu – Rakvere - Sõmeru mnt ja Kääriku tee (reg.",
        "@language": "et"
      },
      "estleg:legalText": "Määrata kohanimi Kääriku tee Tori vallas Selja külas Saare katastriüksustel (tunnus 80801:001:0060) ja (tunnus 80801:001:0065), Pärna katastriüksusel (tunnus 80801:001:0108), Tamme katastriüksusel (tunnus 80801:001:0597), Aivo katastriüksusel (tunnus 80801:001:0107) ja Kääriku katastriüksusel (tunnus 80801:001:0039) asuvale Kääriku teele (reg. nr 8080329). Kääriku tee algab Pärnu – Rakvere - Sõmeru mnt ja Kääriku tee (reg. nr 8080329) ristmikust ja lõpeb Selja koolitee (8080045) ja Kääriku tee (reg. nr 8080329) ristmikul.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tori_vallavolikogu"
      },
