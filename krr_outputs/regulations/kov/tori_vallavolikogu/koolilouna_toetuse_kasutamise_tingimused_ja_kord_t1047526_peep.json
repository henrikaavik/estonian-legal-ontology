    },
    {
      "@id": "estleg:Reg_1047526_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Tori valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2 (2) Koolilõuna toetusest kaetakse kulud toiduainetele. 3 (3) Koolilõuna toetuseks eraldatud vahendite sihipärase kasutamise eest vastutab kooli direktor.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Tori valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2 (2) Koolilõuna toetusest kaetakse kulud toiduainetele. 3 (3) Koolilõuna toetuseks eraldatud vahendite sihipärase kasutamise eest vastutab kooli direktor. 4 (4) Koolilõuna toetuseks ette nähtud vahendite sihipärast kasutamist kontrollib Tori Vallavalitsus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tori_vallavolikogu"
      },
