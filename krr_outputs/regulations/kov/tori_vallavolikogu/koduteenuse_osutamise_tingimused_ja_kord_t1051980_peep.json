      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev määrus sätestab koduteenuse (edaspidi teenus) osutamise tingimused ja korra.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051980_Par_1"
