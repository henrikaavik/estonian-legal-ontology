    {
      "@id": "estleg:Reg_1058927_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tasu määr",
        "@language": "et"
      },
      "estleg:sourceAct": "Keskkonnahäiringu hüvitamise tasu määra kehtestamine",
      "estleg:summary": {
        "@value": "Määruse paragrahvis 1 nimetatud keskkonnahäiringu hüvitamise tasu on 1% järgmise kahe näitaja korrutisest: 1 1) tuuleelektrijaama kvartalis toodetud elektrienergia kogus megavatt-tundides, kuid mitte vähem kui 70 protsenti tuuleelektrijaama nimivõimsusest korrutatuna 750-ga; 2 2) vastava kvartali Eesti hinnapiirkonna järgmise päeva turu elektrienergia aritmeetiline keskmine börsihind.",
        "@language": "et"
      },
      "estleg:legalText": "Määruse paragrahvis 1 nimetatud keskkonnahäiringu hüvitamise tasu on 1% järgmise kahe näitaja korrutisest: 1 1) tuuleelektrijaama kvartalis toodetud elektrienergia kogus megavatt-tundides, kuid mitte vähem kui 70 protsenti tuuleelektrijaama nimivõimsusest korrutatuna 750-ga; 2 2) vastava kvartali Eesti hinnapiirkonna järgmise päeva turu elektrienergia aritmeetiline keskmine börsihind.",
