          "@id": "estleg:Reg_1061975_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061975_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Tori vallas maamaksumäärad alates 1. jaanuarist 2026. a järgmiselt: 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumääraks 0,50 % maa maksustamishinnast aastas; 2) punktis 1 nimetamata maatulundusmaa maamaksumääraks 0,20 % maa maksustamishinnast aastas; 3) punktides 1 ja 2 nimetamata sihtotstarbega maa maamaksumääraks 0,50 % maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061975_Par_1"
      },
