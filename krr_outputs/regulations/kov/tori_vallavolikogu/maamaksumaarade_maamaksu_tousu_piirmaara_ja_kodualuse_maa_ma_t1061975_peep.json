      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärade kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade, maamaksu tõusu piirmäära ja kodualuse maa maksusoodustuse kehtestamine 2026. aastaks",
      "estleg:summary": {
        "@value": "Kehtestada Tori vallas maamaksumäärad alates 1. jaanuarist 2026. a järgmiselt: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumääraks 0,50 % maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaa maamaksumääraks 0,20 % maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maa maamaksumääraks 0,50 % maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Tori vallas maamaksumäärad alates 1. jaanuarist 2026. a järgmiselt: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumääraks 0,50 % maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaa maamaksumääraks 0,20 % maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maa maamaksumääraks 0,50 % maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tori_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0809"
      },
