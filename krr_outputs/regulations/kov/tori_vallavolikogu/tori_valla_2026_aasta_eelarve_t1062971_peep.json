      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vallavalitsusel on õigus teha alaeelarvetes muudatusi vastavalt struktuuriüksuste ja hallatavate asutuste poolt esitatud taotlustele.",
      "estleg:parentProvision": {
