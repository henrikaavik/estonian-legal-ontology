      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1062971_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Vallavalitsuse struktuuriüksusel või hallataval asutusel on õigus soetada materiaalset ja immateriaalset põhivara tegevuskuludeks ettenähtud vahendite arvelt peale eelarve muudatusettepaneku esitamist vallavalitsusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062971_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
