      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Tori valla haldusterritooriumil asuvatele munitsipaalomandis olevatele eluruumidele üüri piirmäär.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Tori valla haldusterritooriumil asuvatele munitsipaalomandis olevatele eluruumidele üüri piirmäär.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tori_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0809"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044369_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1044369_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1044369_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Tori valla haldusterritooriumil asuvatele munitsipaalomandis olevatele eluruumidele üüri piirmäär.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044369_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1044369_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üüri piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest. 2 (2) Tori valla munitsipaalomandis olevate eluruumide üüri piirmäär on 14,00 (neliteist) eurot ühe ruutmeetri kohta ühes kuus. RT IV2022-09-2854280920220052022-10-01 3 (3) Eluruumi üüri hulka ei arvata kommunaalkulusid. 4 (4) Konkreetse eluruumi üür ja üürile andmise tingimused määratakse vallavalitsuse korralduse alusel sõlmitavas eluruumi üürilepingus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest. 2 (2) Tori valla munitsipaalomandis olevate eluruumide üüri piirmäär on 14,00 (neliteist) eurot ühe ruutmeetri kohta ühes kuus. RT IV2022-09-2854280920220052022-10-01 3 (3) Eluruumi üüri hulka ei arvata kommunaalkulusid. 4 (4) Konkreetse eluruumi üür ja üürile andmise tingimused määratakse vallavalitsuse korralduse alusel sõlmitavas eluruumi üürilepingus.",
