      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Arvuti kasutuse õiguse saab arvuti kasutusoskusega inimene, kes täidab käesoleva eeskirjaga sätestatud reegleid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019121_Par_5"
      },
      "rdfs:label": "§ 5 lg 2"
    },
    {
