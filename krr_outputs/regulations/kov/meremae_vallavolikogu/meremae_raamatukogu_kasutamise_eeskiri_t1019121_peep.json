      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Maksimaalne kasutusaeg ühele külastajale on üks tund päevas. Pikaks venivate järjekordade korral on raamatukogu juhatajal õigus kasutusaega lühendada. Soovitav on eelregistreerimine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019121_Par_5"
