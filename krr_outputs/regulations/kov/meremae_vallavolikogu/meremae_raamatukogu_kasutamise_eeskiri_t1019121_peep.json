      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Meremäe Raamatukogu kasutamise eeskiri",
      "estleg:summary": {
        "@value": "1(1)Käesolev eeskiri on kehtestatud Rahvaraamatukogude seaduse ning kultuuriministri 12. juuli 2004. a. määrusega nr.9 kinnitatud Rahvaraamatukogu töökorralduse juhendi alusel. 2(2)Eeskiri reguleerib lugejateeninduse korralduse, lugejate õigused ja kohustused ning sisekorra Meremäe Raamatukogus (edaspidi raamatukogus). 3(3)Eeskirja järgimine on raamatukogu lugejatele kohustuslik.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Käesolev eeskiri on kehtestatud Rahvaraamatukogude seaduse ning kultuuriministri 12. juuli 2004. a. määrusega nr.9 kinnitatud Rahvaraamatukogu töökorralduse juhendi alusel. 2(2)Eeskiri reguleerib lugejateeninduse korralduse, lugejate õigused ja kohustused ning sisekorra Meremäe Raamatukogus (edaspidi raamatukogus). 3(3)Eeskirja järgimine on raamatukogu lugejatele kohustuslik.",
