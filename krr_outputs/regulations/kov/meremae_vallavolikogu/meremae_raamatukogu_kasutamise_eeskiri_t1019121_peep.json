      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Väljatrükid arvutitest toimuvad raamatukogu juhataja loal ning need on kasutajale tasulised.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019121_Par_5"
      },
      "rdfs:label": "§ 5 lg 6"
    },
    {
      "@id": "estleg:Reg_1019121_Par_5_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Töö lõpetamisel peab kasutaja sulgema kõik enda poolt avatud programmid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019121_Par_5"
      },
      "rdfs:label": "§ 5 lg 7"
    },
    {
      "@id": "estleg:Reg_1019121_Par_5_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Keelatud on: 1) arvuti omavoliline väljalülitamine ja taaskäivitamine; 2) arvuti häälestuse muutmine; 3) tarkvara ja arvutimängude installeerimine; 4) isikliku disketi, CD või USB (mäluseaded) kasutamine ilma raamatukogu juhataja loata; 5) arvutis mängimine, jututubade ja pornolehekülgede külastamine; 6) arvuti juures söömine ja joomine; 7) teiste raamatukogu külastajate häirimine.",
      "estleg:parentProvision": {
