      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kõikidest arvuti kasutamisel ilmnenud probleemidest peab kasutaja viivitamatult teavitama raamatukogu juhatajat.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019121_Par_5"
      },
      "rdfs:label": "§ 5 lg 5"
    },
    {
