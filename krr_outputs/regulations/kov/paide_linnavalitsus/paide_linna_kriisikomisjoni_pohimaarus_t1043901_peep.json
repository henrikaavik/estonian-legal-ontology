      "rdfs:label": {
        "@value": "§ 3. Komisjoni esimehe pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Paide linna kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Komisjoni esimees:11) esindab komisjoni;22) juhib komisjoni tööd;33) kutsub kokku komisjoni koosoleku;44) kutsub vajaduse korral komisjoni tööst sõnaõigusega osa võtma isikuid, kes ei kuulu komisjoni koosseisu;55) koostab komisjoni iga-aastase tööplaani ning esitab selle komisjonile kinnitamiseks. 2(2)Komisjoni esimehe äraolekul täidab tema ülesandeid komisjoni aseesimees.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Komisjoni esimees:11) esindab komisjoni;22) juhib komisjoni tööd;33) kutsub kokku komisjoni koosoleku;44) kutsub vajaduse korral komisjoni tööst sõnaõigusega osa võtma isikuid, kes ei kuulu komisjoni koosseisu;55) koostab komisjoni iga-aastase tööplaani ning esitab selle komisjonile kinnitamiseks. 2(2)Komisjoni esimehe äraolekul täidab tema ülesandeid komisjoni aseesimees.",
