      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad kõik valimisjaoskonnad. Euroopa Parlamendi valimisel ja rahvahääletusel korraldavad kõik valimisjaoskonnad ka asukohas hääletamist.",
