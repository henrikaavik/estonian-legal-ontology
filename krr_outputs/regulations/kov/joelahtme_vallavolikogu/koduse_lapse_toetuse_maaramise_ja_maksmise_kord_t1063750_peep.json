      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toetuse subjekt",
        "@language": "et"
      },
      "estleg:sourceAct": "Koduse lapse toetuse määramise ja maksmise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063750_Map"
      },
      "estleg:summary": {
        "@value": "1(1)Koduse lapse toetust määratakse ja makstakse lapsevanemale, eestkostjale või lepingulisele hooldajale (edaspidi vanem), kes on esitanud ARNO veebikeskkonnas lapsele lasteaiakoha saamiseks taotluse, kuid kellele pole Jõelähtme Vallavalitsusel lasteaiakohta pakkuda ning laps ei ole kantud ühegi munitsipaallasteaia, -lastehoiu või eralasteaia, -lastehoiu nimekirja. 2(2)Kui 1.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Koduse lapse toetust määratakse ja makstakse lapsevanemale, eestkostjale või lepingulisele hooldajale (edaspidi vanem), kes on esitanud ARNO veebikeskkonnas lapsele lasteaiakoha saamiseks taotluse, kuid kellele pole Jõelähtme Vallavalitsusel lasteaiakohta pakkuda ning laps ei ole kantud ühegi munitsipaallasteaia, -lastehoiu või eralasteaia, -lastehoiu nimekirja. 2(2)Kui 1. jaanuari seisuga ja katkematult on Jõelähtme valla elanikud laps ja mõlemad vanemad või üksikvanem, makstakse koduse lapse toetust kogu toetusmäära ulatuses. Kui 1. jaanuari seisuga ja katkematult on Jõelähtme valla elanik laps ja üks lapse vanematest, makstakse koduse lapse toetust 70% toetusmäärast. Kui laps koos vanema(te)ga on Jõelähtme valla elanik peale 1. jaanuari ja katkematult, makstakse koduse lapse toetust 50% toetusmäärast. 3(3)Õigus saada koduse lapse toetust tekib lapse 18-kuuseks saamisele järgnevast kalendrikuust ning lõpeb lapse minekul lasteaeda või lastehoidu või 30. juunil enne esmakordselt üldhariduskooli õppima asumist.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063750_Par_3_Lg_1"
        },
        {
          "@id": "estleg:Reg_1063750_Par_3_Lg_2"
        },
        {
          "@id": "estleg:Reg_1063750_Par_3_Lg_3"
        }
      ],
