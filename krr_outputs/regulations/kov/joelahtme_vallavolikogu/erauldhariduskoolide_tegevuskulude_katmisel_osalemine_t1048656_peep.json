      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Eraüldhariduskool",
        "@language": "et"
      },
      "estleg:sourceAct": "Eraüldhariduskoolide tegevuskulude katmisel osalemine",
      "estleg:summary": {
        "@value": "Eraüldhariduskool (edaspidi erakool) on eraõigusliku juriidilise isiku (edaspidi erakooli pidaja) asutus, kes tegutseb põhikooli- ja gümnaasiumiseaduse ning erakooliseaduse alusel, omab kehtivat tegevusluba ning võimaldab üldhariduse omandamist riiklikule õppekavale vastava õppekava alusel.",
        "@language": "et"
      },
      "estleg:legalText": "Eraüldhariduskool (edaspidi erakool) on eraõigusliku juriidilise isiku (edaspidi erakooli pidaja) asutus, kes tegutseb põhikooli- ja gümnaasiumiseaduse ning erakooliseaduse alusel, omab kehtivat tegevusluba ning võimaldab üldhariduse omandamist riiklikule õppekavale vastava õppekava alusel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0245"
