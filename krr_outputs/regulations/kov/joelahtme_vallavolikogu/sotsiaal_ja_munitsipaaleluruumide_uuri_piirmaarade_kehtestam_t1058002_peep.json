    {
      "@id": "estleg:Reg_1058002_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Jõelähtme valla sotsiaal-ja munitsipaaleluruumide üüri piirmäärad alljärgnevalt: 1) sotsiaaleluruumid 1,50 €/m²; 2) munitsipaaleluruumid 3,00 €/m².",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058002_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
