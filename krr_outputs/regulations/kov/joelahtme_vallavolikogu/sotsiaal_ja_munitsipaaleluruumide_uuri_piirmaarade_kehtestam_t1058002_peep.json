        "2"
      ]
    },
    {
      "@id": "estleg:Reg_1058002_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Käesoleva määrusega kehtestatud üüri piirmäärad ei sisalda kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muruniitmise, lumetõrje, maja üldelektri jt) kommunaalteenuste eest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058002_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
