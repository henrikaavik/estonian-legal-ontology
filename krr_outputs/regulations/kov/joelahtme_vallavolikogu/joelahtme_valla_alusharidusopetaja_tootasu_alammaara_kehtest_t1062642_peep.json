      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Alusharidusõpetaja töötasu alammäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõelähtme valla alusharidusõpetaja töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega alusharidusõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
        "@language": "et"
      },
      "estleg:legalText": "Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega alusharidusõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0245"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062642_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1062642_Par_2_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062642_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega alusharidusõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062642_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
