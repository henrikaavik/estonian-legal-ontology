    {
      "@id": "estleg:Reg_1062642_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1062642",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Alusharidusõpetaja töötasu alammäär",
      "estleg:sourceAct": "Jõelähtme valla alusharidusõpetaja töötasu alammäära kehtestamine",
      "estleg:summary": "Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega alusharidusõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal. Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korr",
      "estleg:legalText": "Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega alusharidusõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal. Valla lasteaedades töötava keeleseaduse ja selle alusel kehtestatud nõuetele vastava alusharidusõpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega alusharidusõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavolikogu"
      },
