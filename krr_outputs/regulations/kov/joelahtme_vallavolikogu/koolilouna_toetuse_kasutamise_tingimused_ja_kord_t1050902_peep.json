      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Reguleerimisala",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Jõelähtme valla üldhariduskoolides. Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Jõelähtme valla üldhariduskoolides.",
      "estleg:legalText": "Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Jõelähtme valla üldhariduskoolides. Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Jõelähtme valla üldhariduskoolides.",
      "estleg:enactedBy": {
