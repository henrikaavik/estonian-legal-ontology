    {
      "@id": "estleg:Reg_1062395_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hüvitiste ja tasude määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõelähtme Vallavolikogu ja Jõelähtme Vallavalitsuse liikmetele tasu ja hüvitise maksmise kord",
      "estleg:summary": {
        "@value": "1(1)Volikogu esimehele makstakse hüvitist 1300,00 eurot kuus. 2(2)Volikogu aseesimehele makstakse hüvitist 400,00 eurot kuus. 3(3)Volikogu komisjoni esimehele makstakse tasu 300,00 eurot kuus. 4(4)Volikogu komisjoni aseesimehele makstakse tasu 150,00 eurot kuus. 5(5)Volikogu liikmele makstakse volikogu tööst osavõtu eest tasu 200,00 kuus kui volikogu liige on eelneval kalendrikuul osalenud vähemalt ühel volikogu istungil.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Volikogu esimehele makstakse hüvitist 1300,00 eurot kuus. 2(2)Volikogu aseesimehele makstakse hüvitist 400,00 eurot kuus. 3(3)Volikogu komisjoni esimehele makstakse tasu 300,00 eurot kuus. 4(4)Volikogu komisjoni aseesimehele makstakse tasu 150,00 eurot kuus. 5(5)Volikogu liikmele makstakse volikogu tööst osavõtu eest tasu 200,00 kuus kui volikogu liige on eelneval kalendrikuul osalenud vähemalt ühel volikogu istungil. 6(6)Volikogu komisjoni liikmele makstakse tasu 100,00 eurot kuus kui komisjoni liige on eelneval kalendrikuul osalenud vähemalt ühel komisjoni koosolekul. 7(7)Vallavanema töötasu määr on 5400,00 eurot kuus. 8(8)Palgaliste valitsusliikmete töötasu määr on 4100,00 eurot kuus. 9(9)Teistele valitsusliikmetele makstakse hüvitist 700,00 eurot kuus. 10(10)Vallavanemale ja teistele palgalistele vallavalitsuse liikmetele töötervishoiu ja tööohutuse regulatsioonidest tuleneva hüvitise maksmine toimub Jõelähtme Vallavalitsuse poolt kehtestatud korras, samas määras, mis on ette nähtud Jõelähtme Vallavalitsuse teenistujatele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavolikogu"
      },
