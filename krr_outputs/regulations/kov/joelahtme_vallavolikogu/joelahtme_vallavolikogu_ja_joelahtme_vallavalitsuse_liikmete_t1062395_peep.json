        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määruse paragrahvi 5 lõikes 1 ettenähtud preemia või toetus makstakse 5 tööpäeva jooksul alates vastavasisulise otsuse tegemisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062395_Par_2"
