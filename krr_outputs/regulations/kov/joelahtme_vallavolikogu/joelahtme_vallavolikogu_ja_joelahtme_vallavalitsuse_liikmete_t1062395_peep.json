      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1062395_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Määruse paragrahvi 3 lõikes 10 või paragrahvi 5 lõikes 2 nimetatud hüvitis või toetus makstakse 5 tööpäeva jooksul alates vastavasisulise käskkirja vormistamisest. Hüvitise või toetuse maksmise vallavanemale otsustab volikogu esimees, palgaliste vallavalitsuse liikmete korral vallavanem.",
