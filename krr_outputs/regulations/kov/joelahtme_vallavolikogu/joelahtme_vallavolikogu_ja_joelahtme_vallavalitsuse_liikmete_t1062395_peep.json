    {
      "@id": "estleg:Reg_1062395_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tasu, hüvitise, preemia või toetuse maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõelähtme Vallavolikogu ja Jõelähtme Vallavalitsuse liikmetele tasu ja hüvitise maksmise kord",
      "estleg:summary": {
        "@value": "1(1)Määruse paragrahvi 3 lõigetes 1-9 nimetatud hüvitist või tasu makstakse üks kord kuus järgneva kuu kümnendal kuupäeval ülekandega pangakontole. 2(2)Määruse paragrahvi 5 lõikes 1 ettenähtud preemia või toetus makstakse 5 tööpäeva jooksul alates vastavasisulise otsuse tegemisest. 3(3)Määruse paragrahvi 3 lõikes 10 või paragrahvi 5 lõikes 2 nimetatud hüvitis või toetus makstakse 5 tööpäeva jooksul alates vastavasisulise käskkirja vormistamisest.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Määruse paragrahvi 3 lõigetes 1-9 nimetatud hüvitist või tasu makstakse üks kord kuus järgneva kuu kümnendal kuupäeval ülekandega pangakontole. 2(2)Määruse paragrahvi 5 lõikes 1 ettenähtud preemia või toetus makstakse 5 tööpäeva jooksul alates vastavasisulise otsuse tegemisest. 3(3)Määruse paragrahvi 3 lõikes 10 või paragrahvi 5 lõikes 2 nimetatud hüvitis või toetus makstakse 5 tööpäeva jooksul alates vastavasisulise käskkirja vormistamisest. Hüvitise või toetuse maksmise vallavanemale otsustab volikogu esimees, palgaliste vallavalitsuse liikmete korral vallavanem.",
