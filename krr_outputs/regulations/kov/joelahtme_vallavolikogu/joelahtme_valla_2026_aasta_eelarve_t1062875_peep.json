      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Jõelähtme valla 2026. aasta eelarve kinnitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõelähtme valla 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "Kinnitada vastavalt määruse lisale nr 1 Jõelähtme valla 2026. aasta eelarve detailsus ning põhitegevuse tulude eelarve summas 21 975 139 eurot, põhitegevuse kulude eelarve summas 21 420 496 eurot, investeerimistegevuse eelarve summas -1 920 165 eurot, finantseerimistehingute eelarve summas 1 115 522 eurot ning likviidsete varade muutus summas -250 000 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Kinnitada vastavalt määruse lisale nr 1 Jõelähtme valla 2026. aasta eelarve detailsus ning põhitegevuse tulude eelarve summas 21 975 139 eurot, põhitegevuse kulude eelarve summas 21 420 496 eurot, investeerimistegevuse eelarve summas -1 920 165 eurot, finantseerimistehingute eelarve summas 1 115 522 eurot ning likviidsete varade muutus summas -250 000 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0245"
      },
