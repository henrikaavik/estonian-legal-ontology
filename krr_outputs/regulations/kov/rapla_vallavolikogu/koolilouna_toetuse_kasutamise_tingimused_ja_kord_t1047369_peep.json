    {
      "@id": "estleg:Reg_1047369_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1047369",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "1 (1) Toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Rapla vallale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. Toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Rapla vallale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Rapla valla statsionaarse õppega üldhariduskoolides põhiharidust oma",
      "estleg:legalText": "1 (1) Toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Rapla vallale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. Toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Rapla vallale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Rapla valla statsionaarse õppega üldhariduskoolides põhiharidust omandavatele õpilastele kaetakse Rapla valla eelarvest. Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Rapla valla statsionaarse õppega üldhariduskoolides põhiharidust omandavatele õpilastele kaetakse Rapla valla eelarvest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0668"
