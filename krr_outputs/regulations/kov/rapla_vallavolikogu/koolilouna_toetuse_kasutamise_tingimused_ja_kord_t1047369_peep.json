    {
      "@id": "estleg:Reg_1047369_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1047369",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Määruse reguleerimisala",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele. Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele.",
      "estleg:legalText": "Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele. Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0668"
