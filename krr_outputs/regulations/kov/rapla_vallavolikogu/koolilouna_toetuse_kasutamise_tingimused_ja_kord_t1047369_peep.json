    {
      "@id": "estleg:Reg_1047369_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0668"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047369_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1047369_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1047369_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev määrus reguleerib riigieelarve ja Rapla valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamist Rapla valla munitsipaalkoolides statsionaarses õppes õppivatele õpilastele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047369_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1047369_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Rapla vallale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Rapla valla statsionaarse õppega üldhariduskoolides põhiharidust omandavatele õpilastele kaetakse Rapla valla eelarvest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Rapla vallale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Rapla valla statsionaarse õppega üldhariduskoolides põhiharidust omandavatele õpilastele kaetakse Rapla valla eelarvest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavolikogu"
      },
