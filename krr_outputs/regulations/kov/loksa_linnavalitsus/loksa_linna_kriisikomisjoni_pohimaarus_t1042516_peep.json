      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Komisjoni ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Loksa linna kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "Komisjon: 1 1) tutvub ja võtab teadmiseks linna tegevuspiirkonda puudutavad hädaolukorra riskianalüüsid; 2 2) omab ülevaadet linna territooriumil olevate hädaolukorraks vajalike ressursside kohta; 3 3) jälgib ohutuse ja turvalisuse tagamiseks riiklike järelevalveasutuste ettekirjutuste täitmist linna hallatavates asutustes; 4 4) esitab ettepanekuid eksperthinnangute tellimiseks; 5 5) teeb kriisireguleerimisalast koostööd riigiasutuste ja teiste kriisikomisjonidega; 6 6) kooskõlastab linna…",
        "@language": "et"
      },
      "estleg:legalText": "Komisjon: 1 1) tutvub ja võtab teadmiseks linna tegevuspiirkonda puudutavad hädaolukorra riskianalüüsid; 2 2) omab ülevaadet linna territooriumil olevate hädaolukorraks vajalike ressursside kohta; 3 3) jälgib ohutuse ja turvalisuse tagamiseks riiklike järelevalveasutuste ettekirjutuste täitmist linna hallatavates asutustes; 4 4) esitab ettepanekuid eksperthinnangute tellimiseks; 5 5) teeb kriisireguleerimisalast koostööd riigiasutuste ja teiste kriisikomisjonidega; 6 6) kooskõlastab linna evakuatsiooni plaani; 7 7) kooskõlastab linna kriisireguleerimise õppuse kavandi ja tutvub õppuse kokkuvõtete ning järeldustega; 8 8) tagab hädaolukorras abivajajate väljaselgitamise ja nende abistamise; 9 9) abistab vajaduse korral hädaolukorra juhti hädaolukorra lahendamisel ja teabevahenduse korraldamisel ning täidab hädaolukorra juhi antud ülesandeid; 10 10) abistab linna territooriumil hädaolukorra järgsete taastamistööde, kahjude hindamise ja kulude arvestuse korraldamisel; 11 11) kinnitab ja esitab komisjoni järgmise aasta tööplaani koos aastaaruandega regionaalsele kriisikomisjonile (RKK) hiljemalt 31. detsembriks; 12 12) osutab abi linna asutustele ja RKK-le hädaolukordadeks valmistumise, lahendamise, elanikkonnakaitse ja turvalisuse korraldamise kohta omavalitsusüksuse territooriumil.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_loksa_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0424"
      },
