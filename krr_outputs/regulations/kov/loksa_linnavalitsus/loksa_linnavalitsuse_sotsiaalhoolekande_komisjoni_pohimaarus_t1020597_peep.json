    {
      "@id": "estleg:Reg_1020597_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Komisjoni õigused",
        "@language": "et"
      },
      "estleg:sourceAct": "Loksa Linnavalitsuse sotsiaalhoolekande komisjoni põhimäärus",
      "estleg:summary": {
        "@value": "Komisjonil on õigus:11) kaasata oma tegevusse spetsialiste;22) saada linnavalitsuse teenistujate ja linnavalitsuse hallatavatelt asutustelt komisjoni tööks vajalikku informatsiooni;33) vajadusel kutsuda komisjoni koosolekule sotsiaalabi taotlev isik;44) teha linnavalitsuse kaudu järelpärimisi haridus- ja hoolekandeasutustele;55) anda arvamus komisjoni tegevusvaldkonda kuuluvate linnavolikogu või linnavalitsuse õigusaktide eelnõude kohta.",
        "@language": "et"
      },
      "estleg:legalText": "Komisjonil on õigus:11) kaasata oma tegevusse spetsialiste;22) saada linnavalitsuse teenistujate ja linnavalitsuse hallatavatelt asutustelt komisjoni tööks vajalikku informatsiooni;33) vajadusel kutsuda komisjoni koosolekule sotsiaalabi taotlev isik;44) teha linnavalitsuse kaudu järelpärimisi haridus- ja hoolekandeasutustele;55) anda arvamus komisjoni tegevusvaldkonda kuuluvate linnavolikogu või linnavalitsuse õigusaktide eelnõude kohta.",
