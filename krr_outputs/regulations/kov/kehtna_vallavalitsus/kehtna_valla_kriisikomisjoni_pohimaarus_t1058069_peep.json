    {
      "@id": "estleg:Reg_1058069_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjoni esimees: 1) esindab komisjoni maakonna omavalitsusüksustes, riigi- ja valitsusasutustes; 2) kutsub kokku komisjoni koosolekud või käivitab komisjoni töö; 3) vajadusel kutsub komisjoni tööst osa võtma isikuid, kes ei kuulu komisjoni koosseisu; 4) vajadusel organiseerib komisjoni liikmetele kriisireguleerimise alaseid koolitusi.",
