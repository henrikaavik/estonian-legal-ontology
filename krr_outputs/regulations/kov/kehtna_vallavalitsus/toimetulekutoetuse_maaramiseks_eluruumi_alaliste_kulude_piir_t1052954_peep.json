      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Eluruumi alaliste kulude piirmäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Toimetulekutoetuse määramiseks eluruumi alaliste kulude piirmäärad",
      "estleg:summary": {
        "@value": "Toimetuleku arvestamisel võetakse eluasememkulud arvesse järgmistes määrades: 1 1) eluaseme üür kuni 6 eurot m² kohta, korterelamu haldamise kulud kuni 5 eurot m² kohta, korterealmu renoveerimise laenud tagasimakse kuni 4 eurot m² kohta; 2 2) eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse makset kuni 5 eurot m² kohta; 3 3) soojusenergia maksumus kaugkütte korral kuni 13 eurot m² kohta kuus kütteperioodil; 4 4) kütuse maksumus…",
        "@language": "et"
      },
      "estleg:legalText": "Toimetuleku arvestamisel võetakse eluasememkulud arvesse järgmistes määrades: 1 1) eluaseme üür kuni 6 eurot m² kohta, korterelamu haldamise kulud kuni 5 eurot m² kohta, korterealmu renoveerimise laenud tagasimakse kuni 4 eurot m² kohta; 2 2) eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse makset kuni 5 eurot m² kohta; 3 3) soojusenergia maksumus kaugkütte korral kuni 13 eurot m² kohta kuus kütteperioodil; 4 4) kütuse maksumus mittekaugkütte korral kuni 11 eurot m² kohta; 5 5) elektrikütte maksumus kuni 11 eurot m² kohta; 6 6) vee- ja kanalisatsiooniteenuse maksumus 3 kuupmeetri eest iga pereliikme kohta või kuni 19 eurot reovee äravedamisteenuse maksumusest; 7 7) üldelektrienergia maksumus kuni 180 kWh eest üheliikmelise pere kohta ning iga järgneva pereliikme kohta 90 kWh eest; 8 8) majapidamisgaasi maksumus balloonigaasi kasutamisel kuni 8,2 kg eest üheliikmelise pere kohta ning iga järgneva pereliikme kohta 3,8 kg eest; 9 9) hoonekindlustuse kulud kuni 0,25 eurot eluruumi m² kohta; 10 10) olmejäätmete veotasu tegelike kulude järgi kalendrikuus pereliikme kohta. RT IV 2025-01-28 1 428012025001 2025-01-31 , rakendatakse alates 01.01.2025.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kehtna_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0293"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052954_Map"
      },
