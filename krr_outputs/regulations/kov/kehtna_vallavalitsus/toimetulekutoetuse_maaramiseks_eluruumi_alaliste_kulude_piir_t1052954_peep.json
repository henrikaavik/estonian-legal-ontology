        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Tsentraalse soojavarustuseta ahiküttega majades ja elektrikütte korral võib kompenseerida kogu ostetud kütuse ja elektrienergia maksumuse korraga, arvestades kogu kütteperioodi kulu piirmäära vastavate kuude kohta perioodil 01. september – 31. mai.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052954_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:assertionConfidence": {
