      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Arenguvestluse korraldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kehtna valla üldhariduskoolide direktorite arenguvestluse korraldamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064531_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Direktoriga korraldatakse arenguvestlus vähemalt üks kord aastas. 2 (2) Arenguvestluse viib läbi vallavanem või tema määratud isik. 3 (3) Arenguvestluse aeg lepitakse direktoriga kokku vähemalt 14 kalendripäeva enne vestluse toimumist. 4 (4) Direktorile tehakse enne arenguvestlust teatavaks vestlusel käsitletavad põhiteemad.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Direktoriga korraldatakse arenguvestlus vähemalt üks kord aastas. 2 (2) Arenguvestluse viib läbi vallavanem või tema määratud isik. 3 (3) Arenguvestluse aeg lepitakse direktoriga kokku vähemalt 14 kalendripäeva enne vestluse toimumist. 4 (4) Direktorile tehakse enne arenguvestlust teatavaks vestlusel käsitletavad põhiteemad.",
