      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Elamumaa ja maatulundusmaa õuemaa kõlvik 0,5% maa maksustamishinnast aastas. 2 (2) Käesoleva paragrahvi lõikes 1 nimetamata maatulundusmaa 0,5% maa maksustamishinnast aastas. 3 (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetamata sihtotstarbega maa 2,0% maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Elamumaa ja maatulundusmaa õuemaa kõlvik 0,5% maa maksustamishinnast aastas. 2 (2) Käesoleva paragrahvi lõikes 1 nimetamata maatulundusmaa 0,5% maa maksustamishinnast aastas. 3 (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetamata sihtotstarbega maa 2,0% maa maksustamishinnast aastas.",
