    {
      "@id": "estleg:Reg_1054641_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Revisjonikomisjoni liikme täiendav hüvitus revideerimiste läbiviimises ja revisjoniakti koosta‧mises osalemise eest makstakse välja revisjonikomisjoni esimehe esildise alusel järgmisel kalendrikuul pärast seda, kui revideerijad on akti revisjonikomisjonile esitanud.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054641_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1054641_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Volikogu esimehele, aseesimehele, volikogu komisjoni esimehele, volikogu liikmetele ja komisjoni liikmetele makstakse tasu välja üks kord kuus hiljemalt järgneva kuu 15. kuupäevaks ülekandega pangakontole.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054641_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
