        }
      ]
    },
    {
      "@id": "estleg:Reg_1036803_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koolitöötajate koosseisus määratakse kindlaks töökohtade nimetused, töökoha töötasu katmise allikas (riigi või vallaeelarve), töökoha tähtaegsus ja koormus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036803_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1036803_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Koolitöötajate koosseisu kinnitab kooli direktor vastavalt kinnitatud eelarvele käskkirjaga hiljemalt 1. oktoobriks, saates eelnevalt koolitöötajate koosseisu koos palgaarvestuse tabeliga vallavalitsusele kooskõlastamiseks hiljemalt 10. septembriks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036803_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1036803_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Koolitöötajate koosseisu muutmisel eelarveaasta jooksul esitab kooli direktor koos taotlusega seletuskirja vähemalt kaks kuud enne muudatuste sisseviimist, näidates koolitöötajate koosseisu suurendamisel ära vahendid, millest kaetakse täiendav personalikulu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036803_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
