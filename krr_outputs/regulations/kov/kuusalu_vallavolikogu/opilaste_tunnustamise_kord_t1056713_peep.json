        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Õpilase tunnustamise rahalised määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilaste tunnustamise kord",
      "estleg:summary": {
        "@value": "Väärtustamaks haridust ja õppimist, tunnustab vallavalitsus noori, kes on lõpetanud kooli, rahalise tunnustusega järgmiselt:11) gümnaasiumi kuldmedaliga lõpetanule 500 eurot;22) gümnaasiumi hõbemedaliga lõpetanule 300 eurot;33) kutseõppeasutuse kutsekeskhariduse kiitusega lõpetanule 150 eurot;44) põhikooli või huvikooli kiitusega lõpetanule 100 eurot;55) gümnaasiumi või põhikooli heade ja väga heade (lõputunnistusel hinded „4“ ja „5“) õpitulemustega lõpetanule 50 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Väärtustamaks haridust ja õppimist, tunnustab vallavalitsus noori, kes on lõpetanud kooli, rahalise tunnustusega järgmiselt:11) gümnaasiumi kuldmedaliga lõpetanule 500 eurot;22) gümnaasiumi hõbemedaliga lõpetanule 300 eurot;33) kutseõppeasutuse kutsekeskhariduse kiitusega lõpetanule 150 eurot;44) põhikooli või huvikooli kiitusega lõpetanule 100 eurot;55) gümnaasiumi või põhikooli heade ja väga heade (lõputunnistusel hinded „4“ ja „5“) õpitulemustega lõpetanule 50 eurot.",
      "estleg:enactedBy": {
