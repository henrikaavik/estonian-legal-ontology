    },
    {
      "@id": "estleg:Reg_1056713_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kuusalu valla elanikena rahvastikuregistrisse kantud õpilasi tunnustatakse Kuusalu valla elukohajärgsete koolide kiituse või heade ja väga heade õpitulemustega (lõputunnistusel hinded „4“ ja „5“) ning Hugo Lepnurme Kuusalu Kunstide Kooli ja Loksa Muusikakooli kiitusega lõpetamisel vallavalitsuse poolt rahalise tunnustusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1056713_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:targetGroup": [
