      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Viru-Nigula valla ametiautode kasutamise kord",
      "estleg:summary": {
        "@value": "Määruses reguleerib Viru-Nigula valla omandis ja valduses olevate sõidukite sh sõiduauto, kaubik, väikebuss (edaspidi ametiauto) kasutamise, parkimise ning teenistus- ja töösõitudeks kasutamise korda.",
        "@language": "et"
      },
      "estleg:legalText": "Määruses reguleerib Viru-Nigula valla omandis ja valduses olevate sõidukite sh sõiduauto, kaubik, väikebuss (edaspidi ametiauto) kasutamise, parkimise ning teenistus- ja töösõitudeks kasutamise korda.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0903"
      },
