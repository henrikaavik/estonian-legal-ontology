        }
      ]
    },
    {
      "@id": "estleg:Reg_1061597_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 3 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061597_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1061597_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061597_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
