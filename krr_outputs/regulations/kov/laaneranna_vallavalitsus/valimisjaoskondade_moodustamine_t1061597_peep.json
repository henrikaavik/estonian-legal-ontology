    {
      "@id": "estleg:Reg_1061597_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisjaoskonda eelhääletamist valimisjaoskond nr 3. Valimisjaoskond nr 3 korraldab hääletamist vajadusel ka asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061597_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
