    {
      "@id": "estleg:Reg_1062860_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Õppimiskohustuse seire ja abimeetmete pakkumine Lääneranna vallas",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Õppimiskohustuse täitmise seiret Lääneranna Vallavalitsuses koordineerib haridus- ja sotsiaalosakond. 2(2)Igakuise seire eest vastutab valla haridusspetsialist, kes:11) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta;22) selgitab välja õppimiskohustuse täitmata jätmise põhjused;33) edastab info vastavalt väljaselgitatud põhjustele valla haridus- ja sotsiaalosakonna vastavale spetsialistile.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Õppimiskohustuse täitmise seiret Lääneranna Vallavalitsuses koordineerib haridus- ja sotsiaalosakond. 2(2)Igakuise seire eest vastutab valla haridusspetsialist, kes:11) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta;22) selgitab välja õppimiskohustuse täitmata jätmise põhjused;33) edastab info vastavalt väljaselgitatud põhjustele valla haridus- ja sotsiaalosakonna vastavale spetsialistile. 3(3)Valla vastava valdkonna spetsialist korraldab edasist tegevust õppimiskohustuse täitmist toetavate meetmete rakendamise osas kaasates lapse seaduslikud esindajad, teisi valla spetsialiste, sh tugispetsialiste, valdkonnaüleseid spetsialiste jt. 4(4)Kui õppimiskohustuslik õpilane õpib väljaspool elukohajärgset omavalitsust, tehakse vajadusel koostööd kooli ja/või vastava kohaliku omavalitsusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laaneranna_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0430"
