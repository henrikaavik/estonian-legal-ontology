    {
      "@id": "estleg:Reg_1046686_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kinnitada alljärgnev ametikohtade loetelu, mida täitvatel ametnikel on Lääneranna Vallavalitsuse nimel pädevus riikliku järelevalve teostamiseks ning väärteomenetluse läbiviimiseks kõigis väärteoasjades, milles kohalikul omavalitsusel on kohtuvälise menetleja õigused: 1) järelevalvespetsialist; 2) abivallavanem; 3) arendusjuht; 4) varahaldur; 5) keskkonna- ja arendusspetsialist; 6) maa- ja arendusspetsialist; 7) ehitusspetsialist; 8) vallasekretär; 9) vallasekretäri abi 10) sekretär-registripidaja; 11) spordi- ja noorsootöö spetsialist; 12) lastekaitsespetsialist; 13) sotsiaaltöö spetsialist; 14)",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046686_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
