      "estleg:summary": {
        "@value": "1 (1) Nimelise pingi paigaldamise eest tasub taotleja linnavalitsusele Eesti eelmise kalendriaasta keskmise brutokuupalga suuruse summa. 2 (2) Nimelise pingi aluse ehitamise, pingi paigaldamise ja korrashoiu korraldab Viljandi Linnahooldus. 3 (3) Paigaldatud nimeline pink on linna omandis.",
        "@language": "et"
      },
