      "rdfs:label": {
        "@value": "§ 1. Nimeline pink",
        "@language": "et"
      },
      "estleg:sourceAct": "Nimeliste pinkide paigaldamise põhimõtted",
      "estleg:summary": {
        "@value": "1 (1) Nimeline pink on avalikus kasutuses olev pink, millega tunnustatakse isikut, organisatsiooni või tegu. 2 (2) Pingile antakse nimi ja paigaldatakse selgitav teabesilt. 3 (3) Pingile antav nimi ja paigaldatav teabesilt peab olema kooskõlas heade tavade ja kavatsustega.",
        "@language": "et"
      },
