      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Juhul kui komisjon ei ole olnud töövõimeline kvoorumi puuduse tõttu või komisjoni koosolekuid pole muudel põhjustel toimunud, maksatakse komisjoni esimehele tasu kui volikogu liikmele.",
