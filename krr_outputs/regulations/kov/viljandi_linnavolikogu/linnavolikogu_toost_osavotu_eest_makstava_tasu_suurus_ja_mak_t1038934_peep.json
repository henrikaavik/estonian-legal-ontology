      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Linnavolikogu tööst osavõtu eest makstava tasu suurus ja maksmise kord",
      "estleg:summary": {
        "@value": "Käesolev kord reguleerib Viljandi Linnavolikogu (edaspidi linnavolikogu) liikmetele linnavolikogu istungitest osavõtu eest ja linnavolikogu alatiste ning ajutiste komisjonide ning saadikurühmade töö korraldamise eest tasu maksmise suurust ja korda, samuti linnavolikogu esimehele ja aseesimehele hüvituse/töötasu määramist.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev kord reguleerib Viljandi Linnavolikogu (edaspidi linnavolikogu) liikmetele linnavolikogu istungitest osavõtu eest ja linnavolikogu alatiste ning ajutiste komisjonide ning saadikurühmade töö korraldamise eest tasu maksmise suurust ja korda, samuti linnavolikogu esimehele ja aseesimehele hüvituse/töötasu määramist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0897"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038934_Map"
      },
