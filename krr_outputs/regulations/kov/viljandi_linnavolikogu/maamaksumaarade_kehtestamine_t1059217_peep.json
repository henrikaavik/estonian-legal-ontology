    {
      "@id": "estleg:Reg_1059217_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärade kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "(1) Kehtestada Viljandi linnas alates 1. jaanuarist 2025 vastavalt maa sihtotstarbele järgnevad maamaksumäärad: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumääraks 0,5 % maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale maamaksumääraks 0,5 % maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumääraks 1,0 % maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "(1) Kehtestada Viljandi linnas alates 1. jaanuarist 2025 vastavalt maa sihtotstarbele järgnevad maamaksumäärad: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumääraks 0,5 % maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale maamaksumääraks 0,5 % maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumääraks 1,0 % maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0897"
