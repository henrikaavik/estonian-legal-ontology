    {
      "@id": "estleg:Reg_1060722_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Eesmärk on parandada vaimse tervise teenuse kättesaadavust kohalikul tasandil ning elanike vaimse tervise probleemide tekke ja süvenemise ennetamine ning psühholoogilise heaolu toetamine.",
      "estleg:parentProvision": {
