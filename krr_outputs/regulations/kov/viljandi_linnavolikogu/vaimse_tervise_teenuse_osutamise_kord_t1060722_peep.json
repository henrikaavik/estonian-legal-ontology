      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060722_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenust sihtgrupiks on Eesti Rahvastikuregistri andmetel Viljandi linnas elav isik, kes vajab vaimse tervise teenust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060722_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060722_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Olenevalt teenuse saaja vajadustest osutatakse järgmisi vaimse tervise teenuseid: 1) leinanõustamine; 2) psühhosotsiaalne nõustamine; 3) kriisinõustamine; 4) sõltuvusnõustamine; 5) teraapiad (s.h. mänguteraapia, pereteraapia); 6) vajadusel muu nõustamine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060722_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:itemNumber": [
        "1",
        "2",
