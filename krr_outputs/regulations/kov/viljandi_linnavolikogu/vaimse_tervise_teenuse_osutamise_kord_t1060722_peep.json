      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teenuse eesmärk, sihtgrupp ja teenuse kirjeldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Vaimse tervise teenuse osutamise kord",
      "estleg:summary": {
        "@value": "1(1)Eesmärk on parandada vaimse tervise teenuse kättesaadavust kohalikul tasandil ning elanike vaimse tervise probleemide tekke ja süvenemise ennetamine ning psühholoogilise heaolu toetamine. 2(2)Teenust sihtgrupiks on Eesti Rahvastikuregistri andmetel Viljandi linnas elav isik, kes vajab vaimse tervise teenust. 3(3)Olenevalt teenuse saaja vajadustest osutatakse järgmisi vaimse tervise teenuseid:11) leinanõustamine;22) psühhosotsiaalne nõustamine;33) kriisinõustamine;44) sõltuvusnõustamine;55)…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Eesmärk on parandada vaimse tervise teenuse kättesaadavust kohalikul tasandil ning elanike vaimse tervise probleemide tekke ja süvenemise ennetamine ning psühholoogilise heaolu toetamine. 2(2)Teenust sihtgrupiks on Eesti Rahvastikuregistri andmetel Viljandi linnas elav isik, kes vajab vaimse tervise teenust. 3(3)Olenevalt teenuse saaja vajadustest osutatakse järgmisi vaimse tervise teenuseid:11) leinanõustamine;22) psühhosotsiaalne nõustamine;33) kriisinõustamine;44) sõltuvusnõustamine;55) teraapiad (s.h. mänguteraapia, pereteraapia);66) vajadusel muu nõustamine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0897"
