        "4",
        "5",
        "6"
      ]
    },
    {
      "@id": "estleg:Reg_1060722_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Teenuse taotlemine ja rahastamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Vaimse tervise teenuse osutamise kord",
      "estleg:summary": {
        "@value": "1(1)Teenuse taotlus esitatakse suuliselt või kirjalikult Viljandi Laste ja Perede Tugikeskusele, kes teenust korraldab. 2(2)Abi taotluse võib esitada isik enda kohta ise või muu isik, kes märkab abivajadust. 3(3)Abi taotlemisel tuleb kirjeldada abivajadust ja esitada vajalikud andmed, dokumendid või tõendid abivajaduse hindamiseks. 4(4)Psühhosotsiaalse nõustamise korral määratakse isikule kuni 5 nõustamiskorda jooksva aasta kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Teenuse taotlus esitatakse suuliselt või kirjalikult Viljandi Laste ja Perede Tugikeskusele, kes teenust korraldab. 2(2)Abi taotluse võib esitada isik enda kohta ise või muu isik, kes märkab abivajadust. 3(3)Abi taotlemisel tuleb kirjeldada abivajadust ja esitada vajalikud andmed, dokumendid või tõendid abivajaduse hindamiseks. 4(4)Psühhosotsiaalse nõustamise korral määratakse isikule kuni 5 nõustamiskorda jooksva aasta kohta. 5(5)Vaimse tervise teenus on tegevuskavast tulenevas mahus või määratud nõustamiskordade ulatuses tasuta.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
