      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrus kehtestab riigieelarve ja Viljandi linna eelarve vahenditest eraldatud koolilõuna toetuse kasutamise korra Viljandi linna munitsipaalkoolides statsionaarses õppes õppivatele põhikooli õpilastele.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus kehtestab riigieelarve ja Viljandi linna eelarve vahenditest eraldatud koolilõuna toetuse kasutamise korra Viljandi linna munitsipaalkoolides statsionaarses õppes õppivatele põhikooli õpilastele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0897"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1003095_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1003095_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1003095_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrus kehtestab riigieelarve ja Viljandi linna eelarve vahenditest eraldatud koolilõuna toetuse kasutamise korra Viljandi linna munitsipaalkoolides statsionaarses õppes õppivatele põhikooli õpilastele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1003095_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1003095_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarves ette nähtud toetuse ulatuses kaetakse põhiharidust omandavate õpilaste (1.-9. klass) toitlustuskulud riigieelarvest Viljandi linnale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viljandi linna eelarvest. 3 (3) Koolilõuna maksumuse kehtestab Viljandi Linnavalitus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarves ette nähtud toetuse ulatuses kaetakse põhiharidust omandavate õpilaste (1.-9. klass) toitlustuskulud riigieelarvest Viljandi linnale koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viljandi linna eelarvest. 3 (3) Koolilõuna maksumuse kehtestab Viljandi Linnavalitus. 4 (4) Toitlustusteenuse osutajale kaetakse koolilõuna kulud toitlustusteenuse osutamise lepingu alusel, mille sõlmib Viljandi Linnavalitsus toitlustusteenuse korraldava ettevõtjaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0897"
      },
