      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Delegeerida huvikoolide direktoritele huvikooli seaduse alusel kooli pidaja päde...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Pädevuse delegeerimine",
      "estleg:summary": {
        "@value": "Delegeerida huvikoolide direktoritele huvikooli seaduse alusel kooli pidaja pädevusse antud järgmiste küsimuste lahendamine: 1 (1) Huvikoolide õppekavade registreerimine Eesti Hariduse Infosüsteemi (edaspidi EHIS) põhimäärusega sätestatud tingimustel ja korras (HKS § 10 lõige 4). 2 (2) Huvikoolide õppekavade kuuluvuse määramine EHIS-es vastavalt huvikooli seaduses toodud valdkondadele (HKS § 10 lõige 5).",
        "@language": "et"
      },
      "estleg:legalText": "Delegeerida huvikoolide direktoritele huvikooli seaduse alusel kooli pidaja pädevusse antud järgmiste küsimuste lahendamine: 1 (1) Huvikoolide õppekavade registreerimine Eesti Hariduse Infosüsteemi (edaspidi EHIS) põhimäärusega sätestatud tingimustel ja korras (HKS § 10 lõige 4). 2 (2) Huvikoolide õppekavade kuuluvuse määramine EHIS-es vastavalt huvikooli seaduses toodud valdkondadele (HKS § 10 lõige 5). 3 (3) Ettepanekute tegemine huviala õppekava muutmiseks, uue lisamiseks või olemasoleva sulgemiseks (HKS § 10 lg 6). 4 (4) Iga-aastaselt EHIS-ele järgmiste andmete esitamine: 1 1) õppurite arv valdkondade kaupa; 2 2) huvialade õppekavades tehtud muudatused, uue huviala õppekava lisamine või teate esitamine olemasoleva huviala õppekava sulgemise kohta (HKS § 11 lõige 1).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0897"
