      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Alusharidusseaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Alusharidusseaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "Viljandi Linnavalitsusele delegeeritakse alusharidusseaduses kohaliku omavalitsuse üksusele ja lasteaia pidajale pandud ülesannete täitmine, välja arvatud alusharidusseaduse §-s 17 sätestatud lasteaia ümberkorraldamine ja sellega seotud tegevused ning § 46 lõikes 4 nimetatud munitsipaallasteaia osalustasu kehtestamine.",
        "@language": "et"
      },
      "estleg:legalText": "Viljandi Linnavalitsusele delegeeritakse alusharidusseaduses kohaliku omavalitsuse üksusele ja lasteaia pidajale pandud ülesannete täitmine, välja arvatud alusharidusseaduse §-s 17 sätestatud lasteaia ümberkorraldamine ja sellega seotud tegevused ning § 46 lõikes 4 nimetatud munitsipaallasteaia osalustasu kehtestamine.",
