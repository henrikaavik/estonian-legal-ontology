      "rdfs:label": {
        "@value": "§ 1. [Viljandi linna aasta noore preemia (edaspidi preemia) määratakse tunnustusena Vi...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi linna aasta noore preemia",
      "estleg:summary": {
        "@value": "Viljandi linna aasta noore preemia (edaspidi preemia) määratakse tunnustusena Viljandi linna noorele vanuses 7–26 aastat või Viljandi linnas tegutsevale noortekollektiivile, kelle töö, tegevus või saavutused kalendriaasta jooksul on olnud teistele linna noortele eeskujuks ning motivatsiooniks.",
        "@language": "et"
      },
      "estleg:legalText": "Viljandi linna aasta noore preemia (edaspidi preemia) määratakse tunnustusena Viljandi linna noorele vanuses 7–26 aastat või Viljandi linnas tegutsevale noortekollektiivile, kelle töö, tegevus või saavutused kalendriaasta jooksul on olnud teistele linna noortele eeskujuks ning motivatsiooniks.",
