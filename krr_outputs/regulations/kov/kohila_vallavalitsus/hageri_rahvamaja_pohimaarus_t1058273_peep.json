    },
    {
      "@id": "estleg:Reg_1058273_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Rahvamaja aadress on Kohila tee 18, Hageri alevik, Kohila vald, Rapla maakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058273_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1058273_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Rahvamaja on Kohila Vallavalitsuse (edaspidi vallavalitsus) hallatav kultuuriasutus, mille teeninduspiirkod on Kohila valla territoorium.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058273_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
      "@id": "estleg:Reg_1058273_Par_1_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Rahvamaja juhindub oma tegevuses Eesti Vabariigi ja Kohila valla kehtivatest õigusaktidest ja käesolevast põhimäärusest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058273_Par_1"
      },
      "rdfs:label": "§ 1 lg 4"
    },
    {
      "@id": "estleg:Reg_1058273_Par_1_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Rahvamaja tegutseb talle Kohila valla eelarvega kinnitatud vahendite piires.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058273_Par_1"
      },
      "rdfs:label": "§ 1 lg 5"
    },
    {
      "@id": "estleg:Reg_1058273_Par_1_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Rahvamaja põhimääruse kinnitab ja seda muudab vallavalitsus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058273_Par_1"
      },
      "rdfs:label": "§ 1 lg 6"
    },
    {
      "@id": "estleg:Reg_1058273_Par_1_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Rahvamajal võib olla kasutusel oma sümboolika, kuid kasutada võib ka Kohila valla sümboolikat.",
