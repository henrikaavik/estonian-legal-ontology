    {
      "@id": "estleg:Reg_1061546_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Taotlusi menetleb vallavalitsuse sotsiaal- ja haridusosakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061546_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
