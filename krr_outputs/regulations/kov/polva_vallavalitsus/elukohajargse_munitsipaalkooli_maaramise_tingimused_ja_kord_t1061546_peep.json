        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1061546_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Lapse kooli vastuvõtmise otsuse teeb direktor vastavalt kooli vastuvõtu tingimustele ja korrale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061546_Par_4"
