      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse õppimiskohustuslikule lapsele ja õppimiskohustuslikust east nooremale lapsele (edaspidi laps) põhihariduse omandamiseks elukohajärgse munitsipaalkooli määramise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse õppimiskohustuslikule lapsele ja õppimiskohustuslikust east nooremale lapsele (edaspidi laps) põhihariduse omandamiseks elukohajärgse munitsipaalkooli määramise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0622"
      },
