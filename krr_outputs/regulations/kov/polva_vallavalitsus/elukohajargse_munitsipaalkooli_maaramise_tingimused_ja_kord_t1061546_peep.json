        }
      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1061546_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vallavalitsus arvestab elukohajärgse kooli määramisel oluliste asjaoludena esmajärjekorras lapse elukoha lähedust koolile, sama pere teiste laste õppimist samas koolis ja võimaluse korral vanemate soove.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061546_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
