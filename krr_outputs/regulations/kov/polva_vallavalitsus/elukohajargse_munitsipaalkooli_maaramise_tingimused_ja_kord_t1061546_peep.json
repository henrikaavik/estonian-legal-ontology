        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_polva_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061546_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Elukohajärgse kooli määramise otsusest teavitatakse vanemat hiljemalt 1. märtsil taotluses märgitud kontaktaadressil.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061546_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
