      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Edukate õpilaste tunnustamise kord",
      "estleg:summary": {
        "@value": "Käesoleva määrusega reguleeritakse Eesti rahvastikuregistri andmetel Põlva vallas elavate ja Eestis haridusasutustes õppivate õpilaste tunnustamise alused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Käesoleva määrusega reguleeritakse Eesti rahvastikuregistri andmetel Põlva vallas elavate ja Eestis haridusasutustes õppivate õpilaste tunnustamise alused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0622"
      },
