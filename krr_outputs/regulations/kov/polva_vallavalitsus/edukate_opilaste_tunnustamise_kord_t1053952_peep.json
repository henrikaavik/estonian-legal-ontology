        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tunnustusena antavad preemiad",
        "@language": "et"
      },
      "estleg:sourceAct": "Edukate õpilaste tunnustamise kord",
      "estleg:summary": {
        "@value": "1(1)Tunnustusena antakse:11) rahaline preemia õpilasele, kes lõpetab põhikooli kiitusega;22) rahaline preemia õpilasele, kes lõpetab gümnaasiumi hõbemedaliga;33) rahaline preemia õpilasele, kes lõpetab gümnaasiumi kuldmedaliga. 2(2)Otsuse preemia suuruse kohta teeb Põlva Vallavalitsus (edaspidi vallavalitsus).",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Tunnustusena antakse:11) rahaline preemia õpilasele, kes lõpetab põhikooli kiitusega;22) rahaline preemia õpilasele, kes lõpetab gümnaasiumi hõbemedaliga;33) rahaline preemia õpilasele, kes lõpetab gümnaasiumi kuldmedaliga. 2(2)Otsuse preemia suuruse kohta teeb Põlva Vallavalitsus (edaspidi vallavalitsus).",
