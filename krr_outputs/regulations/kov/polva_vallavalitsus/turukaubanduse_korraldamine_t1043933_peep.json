      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Turukaubanduse müügikoht",
        "@language": "et"
      },
      "estleg:sourceAct": "Turukaubanduse korraldamine",
      "estleg:summary": {
        "@value": "Lubada turukaubanduse korras müüa kaupa või teenust Põlva Haldusteenistuse väljastatud müügipileti alusel Põlva linnas asuval Põlva keskväljakul ja lähialal vastavalt lisadele 1 ja 2.",
        "@language": "et"
      },
      "estleg:legalText": "Lubada turukaubanduse korras müüa kaupa või teenust Põlva Haldusteenistuse väljastatud müügipileti alusel Põlva linnas asuval Põlva keskväljakul ja lähialal vastavalt lisadele 1 ja 2.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0622"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043933_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1043933_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043933_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lubada turukaubanduse korras müüa kaupa või teenust Põlva Haldusteenistuse väljastatud müügipileti alusel Põlva linnas asuval Põlva keskväljakul ja lähialal vastavalt lisadele 1 ja 2.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043933_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1043933_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Müügipileti väljastamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Turukaubanduse korraldamine",
      "estleg:summary": {
        "@value": "1(1) Müük turukaubanduse korras on lubatud aastaringselt. 2(2) Müügipilet väljastatakse toidukaupade ja istikute müügiks müügikohas vastavalt lisale 1. 3(3) Müügipilet väljastatakse tööstuskaupade müügiks müügikohas vastavalt lisale 2. 4(4) Müügipileti väljastamise tingimused ja korra ning müügipileti hinna kehtestab Põlva Haldusteenistus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Müük turukaubanduse korras on lubatud aastaringselt. 2(2) Müügipilet väljastatakse toidukaupade ja istikute müügiks müügikohas vastavalt lisale 1. 3(3) Müügipilet väljastatakse tööstuskaupade müügiks müügikohas vastavalt lisale 2. 4(4) Müügipileti väljastamise tingimused ja korra ning müügipileti hinna kehtestab Põlva Haldusteenistus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavalitsus"
      },
