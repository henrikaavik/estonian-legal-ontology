      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Rakendussätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Turukaubanduse korraldamine",
      "estleg:summary": {
        "@value": "1(1) [Käesolevast tekstist välja jäetud]. 2(2) Määrus jõustub 2018. aasta 1. septembril. 3 (3) Lubada alates 09. aprillist 2020. a kuni eriolukorra lõpetamiseni turukaubanduse korras Põlva linnas asuval Põlva keskväljakul ja lähialal kaubelda ainult toidukauba ja istikutega. RT IV2020-04-1584150420200082020-04-18",
        "@language": "et"
      },
      "estleg:legalText": "1(1) [Käesolevast tekstist välja jäetud]. 2(2) Määrus jõustub 2018. aasta 1. septembril. 3 (3) Lubada alates 09. aprillist 2020. a kuni eriolukorra lõpetamiseni turukaubanduse korras Põlva linnas asuval Põlva keskväljakul ja lähialal kaubelda ainult toidukauba ja istikutega. RT IV2020-04-1584150420200082020-04-18",
