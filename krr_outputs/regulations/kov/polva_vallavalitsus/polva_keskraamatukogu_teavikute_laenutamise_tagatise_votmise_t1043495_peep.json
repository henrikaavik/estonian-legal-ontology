      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Tagatise võtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põlva Keskraamatukogu teavikute laenutamise tagatise võtmise ja tagastamise kord",
      "estleg:summary": {
        "@value": "1(1) Tagatise maksmise kohustuse määrab raamatukoguhoidja. 2(2) Tagatise maksmise kohta koostab tagatise määraja kahes eksemplaris kviitungi, millest üks antakse lugejale ja teine jääb raamatukogule.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Tagatise maksmise kohustuse määrab raamatukoguhoidja. 2(2) Tagatise maksmise kohta koostab tagatise määraja kahes eksemplaris kviitungi, millest üks antakse lugejale ja teine jääb raamatukogule.",
