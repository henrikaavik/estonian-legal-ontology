    {
      "@id": "estleg:Reg_1043495_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Tagatise tagastamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põlva Keskraamatukogu teavikute laenutamise tagatise võtmise ja tagastamise kord",
      "estleg:summary": {
        "@value": "1(1) Tagatis tagastatakse lugejale teaviku tagastamisel tagatise maksmisel väljastatud kviitungi esitamisel. 2(2) Lugeja kinnitab tagatise tagastamist oma allkirjaga raamatukogule jääval kviitungi koopial. 3(3) Kui lugeja on raamatukogu kasutamise eeskirja § 9 lõike 7 alusel kohustatud tasuma teaviku kümnekordse hinna, arvatakse tagatiseks makstud summa sellest maha.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Tagatis tagastatakse lugejale teaviku tagastamisel tagatise maksmisel väljastatud kviitungi esitamisel. 2(2) Lugeja kinnitab tagatise tagastamist oma allkirjaga raamatukogule jääval kviitungi koopial. 3(3) Kui lugeja on raamatukogu kasutamise eeskirja § 9 lõike 7 alusel kohustatud tasuma teaviku kümnekordse hinna, arvatakse tagatiseks makstud summa sellest maha. 4(4) Tagastamata teavikute eest makstud tagatise summad arvatakse raamatukogu eelarve tuludesse pärast teaviku laenutähtaja möödumist.",
      "estleg:enactedBy": {
