      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist haiglas ja ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061606_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
