      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Valimisjaoskondade numeratsioon ja hääletamisruumide asukohad",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Valimisjaoskond nr 1 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Põlva Vallavalitsuse administratiivhoones (Maarja tn 2, Põlva linn, Põlva vald, Põlva maakond). 2 (2) Valimisjaoskond nr 2 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Ahja Kultuurimajas (Illimari tn 6, Ahja alevik, Põlva vald, Põlva maakond).",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Valimisjaoskond nr 1 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Põlva Vallavalitsuse administratiivhoones (Maarja tn 2, Põlva linn, Põlva vald, Põlva maakond). 2 (2) Valimisjaoskond nr 2 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Ahja Kultuurimajas (Illimari tn 6, Ahja alevik, Põlva vald, Põlva maakond). 3 (3) Valimisjaoskond nr 3 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Põlva Kooli Tilsi majas (Põhikooli, Tilsi küla, Põlva vald, Põlva maakond). 4 (4) Valimisjaoskonna nr 4 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Mooste Kultuurimajas (Lasteaia tee 3, Mooste alevik, Põlva vald, Põlva maakond). 5 (5) Valimisjaoskonna nr 5 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Vastse-Kuuste Kultuurimajas (Pargi tn 4, Vastse-Kuuste alevik, Põlva vald, Põlva maakond).",
