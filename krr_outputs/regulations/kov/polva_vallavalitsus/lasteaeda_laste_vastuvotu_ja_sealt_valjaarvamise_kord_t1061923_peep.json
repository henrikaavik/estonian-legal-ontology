    {
      "@id": "estleg:Reg_1061923_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Lasteaeda vastuvõtmine ja rühmade komplekteerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lasteaeda laste vastuvõtu ja sealt väljaarvamise kord",
      "estleg:summary": {
        "@value": "1(1)Vallavalitsus edastab väljavõtte andmekogust taotluste kohta lasteaia direktorile hiljemalt 15. märtsil. 2(2)Lapse lasteaeda vastuvõtmise otsustab direktori käskkirjaga. 3(3)Lasteaia direktor teavitab vanemat lasteaiakoha saamise otsusest taotluses märgitud kontaktidel hiljemalt 31. mail. 4(4)Rühmad uueks õppeaastaks komplekteeritakse hiljemalt 1. septembril. 5(5)Lasteaia direktor sõlmib vanemaga lasteaiakoha kasutamise lepingu.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Vallavalitsus edastab väljavõtte andmekogust taotluste kohta lasteaia direktorile hiljemalt 15. märtsil. 2(2)Lapse lasteaeda vastuvõtmise otsustab direktori käskkirjaga. 3(3)Lasteaia direktor teavitab vanemat lasteaiakoha saamise otsusest taotluses märgitud kontaktidel hiljemalt 31. mail. 4(4)Rühmad uueks õppeaastaks komplekteeritakse hiljemalt 1. septembril. 5(5)Lasteaia direktor sõlmib vanemaga lasteaiakoha kasutamise lepingu. 6(6)Vabade kohtade olemasolul võetakse lapsi lasteaeda vastu õppeaasta kestel. 7(7)Lapse lasteaeda vastuvõtmisel informeerib vanem kirjalikult lasteaia direktorit lapse terviseseisundist tulenevatest eritingimustest, esitades vastavad dokumendid. 8(8)Lapse lasteaeda vastuvõtmisel kohustub vanem tasuma igakuiselt lasteaia osalustasu ja toiduraha esitatud arve alusel. 9(9)Valvelasteaias komplekteeritakse rühmad vanemate poolt õigeaegselt esitatud taotluste alusel.",
      "estleg:enactedBy": {
