    {
      "@id": "estleg:Reg_1045935_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Erateele esitatavad nõuded",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhja-Pärnumaa valla erateedel tasuta lumetõrje teostamise kord",
      "estleg:summary": {
        "@value": "1(1)Tasuta lumetõrjet teostatakse erateedel, mis vastavad järgmistele tingimustele:11) eratee on vähemalt 5 meetri laiuses takistustest puhastatud ja eratee servades olevad takistused (nt ilupõõsad, istikud, truubiotsad, kivid jne) on märgistatud viisil, mis tagab nende nähtavuse pimeda ajal ja lumekihi paksusest hoolimata. Tähistamiseks on soovituslik kasutada puidust, vähemalt 1,5 meetri kõrguseid teibaid (võimalusel helkurribaga);22) eratee kohalt on eemaldatud puude oksad minimaalselt 3,5…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Tasuta lumetõrjet teostatakse erateedel, mis vastavad järgmistele tingimustele:11) eratee on vähemalt 5 meetri laiuses takistustest puhastatud ja eratee servades olevad takistused (nt ilupõõsad, istikud, truubiotsad, kivid jne) on märgistatud viisil, mis tagab nende nähtavuse pimeda ajal ja lumekihi paksusest hoolimata. Tähistamiseks on soovituslik kasutada puidust, vähemalt 1,5 meetri kõrguseid teibaid (võimalusel helkurribaga);22) eratee kohalt on eemaldatud puude oksad minimaalselt 3,5 meetri kõrguselt ja tee laiusest laiemalt vähemalt ühe meetri ulatuses mõlemal poolt teed;33) eratee kõrval on ruumi, kuhu on võimalik lund lükata;44) eratee laius ja teekurvid võimaldavad lumetõrjetehnika liikumist ja lumetõrje teostamist. 2(2)Eratee osalise mittevastavuse korral sätestatud nõuetele teostatakse lumetõrjet vaid nõuetele vastava teelõigu osas, kui see on tehniliselt võimalik.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045935_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1045935_Par_3_Lg_1"
        },
        {
          "@id": "estleg:Reg_1045935_Par_3_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1045935_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Tasuta lumetõrjet teostatakse erateedel, mis vastavad järgmistele tingimustele: 1) eratee on vähemalt 5 meetri laiuses takistustest puhastatud ja eratee servades olevad takistused (nt ilupõõsad, istikud, truubiotsad, kivid jne) on märgistatud viisil, mis tagab nende nähtavuse pimeda ajal ja lumekihi paksusest hoolimata. Tähistamiseks on soovituslik kasutada puidust, vähemalt 1,5 meetri kõrguseid teibaid (võimalusel helkurribaga); 2) eratee kohalt on eemaldatud puude oksad minimaalselt 3,5 meetri kõrguselt ja tee laiusest laiemalt vähemalt ühe meetri ulatuses mõlemal poolt teed; 3) eratee kõrval on ruumi, kuhu on võimalik lund lükata; 4) eratee laius ja teekurvid võimaldavad lumetõrjetehnika liikumist ja lumetõrje teostamist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045935_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    {
      "@id": "estleg:Reg_1045935_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Eratee osalise mittevastavuse korral sätestatud nõuetele teostatakse lumetõrjet vaid nõuetele vastava teelõigu osas, kui see on tehniliselt võimalik.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045935_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
