      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Põhja-Pärnumaa vallale riigieelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Põhja-Pärnumaa vallale riigieelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
