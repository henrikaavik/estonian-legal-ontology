    },
    {
      "@id": "estleg:Reg_1042863_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Põhja-Pärnumaa vallale riigieelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042863_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1042863_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuse kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Põhja-Pärnumaa valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest ülejäävat raha kasutatakse õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus. 3(3)Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Põhja-Pärnumaa valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest ülejäävat raha kasutatakse õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus. 3(3)Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042863_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1042863_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1042863_Par_2_Lg_2"
        },
        {
          "@id": "estleg:Reg_1042863_Par_2_Lg_3"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1042863_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Põhja-Pärnumaa valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042863_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1042863_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest ülejäävat raha kasutatakse õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042863_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1042863_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042863_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1042863_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Koolilõuna toetuse vahendite kasutamise arvestus",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Koolilõuna toetuseks eraldatud vahendite sihipärase kasutamise eest vastutab kooli direktor. 2(2)Kool on kohustatud esitama iga kuu lõpus toitlustamiskulude aruande Põhja-Pärnumaa Vallavalitsuse (edaspidi vallavalitsus) raamatupidamisele. 3(3)Koolilõuna toetuseks ette nähtud vahendite kasutamist kontrollib vallavalitsus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Koolilõuna toetuseks eraldatud vahendite sihipärase kasutamise eest vastutab kooli direktor. 2(2)Kool on kohustatud esitama iga kuu lõpus toitlustamiskulude aruande Põhja-Pärnumaa Vallavalitsuse (edaspidi vallavalitsus) raamatupidamisele. 3(3)Koolilõuna toetuseks ette nähtud vahendite kasutamist kontrollib vallavalitsus.",
