      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1042863_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kool on kohustatud esitama iga kuu lõpus toitlustamiskulude aruande Põhja-Pärnumaa Vallavalitsuse (edaspidi vallavalitsus) raamatupidamisele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042863_Par_3"
