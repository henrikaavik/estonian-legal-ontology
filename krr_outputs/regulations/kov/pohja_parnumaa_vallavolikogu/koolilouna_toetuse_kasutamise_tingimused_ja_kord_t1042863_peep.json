      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koolilõuna toetuseks eraldatud vahendite sihipärase kasutamise eest vastutab kooli direktor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042863_Par_3"
