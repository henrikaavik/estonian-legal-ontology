    {
      "@id": "estleg:Reg_1043555_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Mõisted",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse toetamise kord",
      "estleg:summary": {
        "@value": "Käesolevas määruses kasutatakse mõisteid järgmises tähenduses:11) huviharidus - omandatakse Eesti Hariduse Infosüsteemis (edaspidi EHIS) registreeritud huvikoolis õppekavapõhise õppena vastavalt huvikooli seadusele ja selle alusel kehtestatud huviharidusstandardile;22) huvikool - on haridusasutus, mis tegutseb noorsootöö valdkonnas ning loob huvihariduse omandamise ja isiksuse mitmekülgse arengu, sealhulgas oma keele ja kultuuri viljelemise võimalused huvihariduse erinevates valdkondades.33)…",
        "@language": "et"
      },
      "estleg:legalText": "Käesolevas määruses kasutatakse mõisteid järgmises tähenduses:11) huviharidus - omandatakse Eesti Hariduse Infosüsteemis (edaspidi EHIS) registreeritud huvikoolis õppekavapõhise õppena vastavalt huvikooli seadusele ja selle alusel kehtestatud huviharidusstandardile;22) huvikool - on haridusasutus, mis tegutseb noorsootöö valdkonnas ning loob huvihariduse omandamise ja isiksuse mitmekülgse arengu, sealhulgas oma keele ja kultuuri viljelemise võimalused huvihariduse erinevates valdkondades.33) erahuvikool - on koolitusluba omav huvikool, kelle põhikirjaliseks eesmärgiks on huvitegevuse pakkumine ja kelle õppekava on registreeritud Eesti Hariduse Infosüsteemis.44) huvikooli õpilaskoht - on ühe õppuri huvihariduse omandamine ühe õppekava ulatuses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043555_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1043555_Par_2_Lg_1"
