    },
    {
      "@id": "estleg:Reg_1043555_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Erahuvikoolidele, kes on registreeritud teise kohaliku omavalitsuse territooriumil, aga tegutsevad vallas ning on taotlenud tegevustoetust vallavolikogu kehtestatud korra alusel, ei väljastata garantiikirja ja ei maksta toetust käesoleva määruse kohaselt. Välja arvatud juhul, kui õppur osaleb huvitegevuses väljaspool valda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043555_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Institution_kohalik_omavalitsus"
        },
        {
          "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043555_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Makstava toetuse maksimaalne suurus on: 1) munitsipaalhuvikooli pidaja kirjalikult teatatud õppekoha tegevuskulu arvestuslik maksumus; 2) erahuvikooli puhul kuni 10 eurot kuus lapse kohta.",
      "estleg:parentProvision": {
