      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Juhataja äraolekul asendab teda juhataja käskkirjaga määratud isik. Vajadusel määrab juhataja asendaja vallavanem.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058252_Par_3"
      },
      "rdfs:label": "§ 3 lg 6",
      "estleg:targetGroup": [
        {
