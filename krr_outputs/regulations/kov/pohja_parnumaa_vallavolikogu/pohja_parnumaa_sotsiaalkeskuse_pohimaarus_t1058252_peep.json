      "@id": "estleg:Reg_1058252_Par_3_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Juhataja vaba ametikoha täitmiseks korraldatakse avalik konkurss.",
