    {
      "@id": "estleg:Reg_1058252_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Sotsiaalkeskust juhib juhataja, kes tegutseb vastavalt põhimäärusele ja juhindub ametijuhendist ning teistest vallavalitsuse kehtivatest õigusaktidest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058252_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
