        }
      ]
    },
    {
      "@id": "estleg:Reg_1058252_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Sotsiaalkeskuse juhataja kinnitab ametisse vallavalitsus ja töölepingu juhatajaga sõlmib vallavanem.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058252_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:targetGroup": [
