      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1058252_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Sotsiaalkeskuse juhataja: 1) juhib sotsiaalkeskust vastavalt asutuse põhimäärusele, töölepingule ja ametijuhendile; 2) sõlmib töötajatega töölepingud, määrab (käskkirjaga) töötajate töö- ja lisatasud ning muud väljamaksed lähtudes vallavolikogu poolt kinnitatud eelarvevahenditest; 3) esindab oma pädevuse piires sotsiaalkeskust riigi- ja omavalitsusorganites ning muudes institutsioonides; 4) tagab sotsiaalkeskuse tulemusliku töö, sotsiaalkeskuse tegevuse eesmärkide ja ülesannete täitmise, vastutab sotsiaalkeskuse üldseisundi, arengu ja rahaliste vahendite sihipärase ja otstarbeka kasutamise eest; 5) koostab sotsiaalkeskuse eelarve projekti ja esitab selle vallavalitsusele; 6) teeb ettepanekuid sotsiaalkeskuse struktuuri muutmiseks; 7) töötab välja asutuse töökorralduse reeglid, töötajate ametijuhendid ning muud töökorraldust reguleerivad korrad.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058252_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
        },
        {
          "@id": "estleg:Issuer_pohja_parnumaa_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1058252_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Juhatajal on õigus: 1) saada vajalikku informatsiooni, dokumente jms, mis on vajalikud temale antud tööülesannete täitmiseks; 2) saada tööalaselt vajalikku täiendkoolitust, osaleda infopäevadel ja seminaridel; 3) kasutada tööülesannete täitmiseks sotsiaaltöökeskuse ja valla vara; 4) teha ettepanekuid oma töö paremaks korraldamiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058252_Par_3"
      },
      "rdfs:label": "§ 3 lg 5",
      "estleg:itemNumber": [
        "1",
