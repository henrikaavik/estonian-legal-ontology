      "rdfs:label": {
        "@value": "§ 4. Lasteaedades ja huvikoolis töötava õpetaja töötasu alammäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Töötasustamise alused",
      "estleg:summary": {
        "@value": "Lasteaedades ja huvikoolis töötava õpetaja töötasu alammäär on 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal ja huvikooli õpetajal 100% käesoleva määruse paragrahvis 3 nimetatud üldhariduskooli õpetaja töötasu alammäärast. 2025-08-27RT IV2025-08-29614290820250612025-09-015",
        "@language": "et"
      },
      "estleg:legalText": "Lasteaedades ja huvikoolis töötava õpetaja töötasu alammäär on 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal ja huvikooli õpetajal 100% käesoleva määruse paragrahvis 3 nimetatud üldhariduskooli õpetaja töötasu alammäärast. 2025-08-27RT IV2025-08-29614290820250612025-09-015",
      "estleg:enactedBy": {
