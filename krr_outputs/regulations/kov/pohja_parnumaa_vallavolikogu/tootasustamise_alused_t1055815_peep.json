      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Töötasustamise alused",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Põhja-Pärnumaa valla haridusasutuste direktorite, valla üldhariduskoolides ning lasteaedades töötavate õpetajate ja tugispetsialistide ning munitsipaalhuvikoolides (edaspidi huvikool) töötavate õpetajate töötasustamise alused. 2025-08-27RT IV2025-08-29614290820250612025-09-015",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Põhja-Pärnumaa valla haridusasutuste direktorite, valla üldhariduskoolides ning lasteaedades töötavate õpetajate ja tugispetsialistide ning munitsipaalhuvikoolides (edaspidi huvikool) töötavate õpetajate töötasustamise alused. 2025-08-27RT IV2025-08-29614290820250612025-09-015",
      "estleg:enactedBy": {
