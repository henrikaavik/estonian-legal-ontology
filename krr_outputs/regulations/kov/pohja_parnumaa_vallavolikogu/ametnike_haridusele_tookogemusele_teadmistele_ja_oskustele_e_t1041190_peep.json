      "estleg:summary": {
        "@value": "1(1) Ametnikul peab olema vähemalt keskharidus ja sellele lisanduv eri-, kutse või ametialane ettevalmistus. 2(2) Ametiasutuse osakonnajuhatajal peab olema vähemalt kõrgharidus või sellega võrdsustatud haridustase.",
        "@language": "et"
      },
