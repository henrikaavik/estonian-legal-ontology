    {
      "@id": "estleg:Reg_1046625_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Rakendussätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Käesolevat määrust rakendatakse ka kehtivatele üürilepingutele. 2(2)Vallavalitsus hindab kehtivates ja käesoleva määruse kohaselt kohalduvates üürilepingutes kokkulepitud või lepingute alusel arvestatud üüri suurused käesoleva määruse piirmäära ja diferentseerimise aluseid arvestades üle hiljemalt 2019. aasta jooksul. 3(3)Üüri tõstmise korral lähtutakse võlaõigusseaduses sätestatud üüri tõstmist reguleerivatest sätetest. 4(4)Määrus jõustub 1. mail 2019. a.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Käesolevat määrust rakendatakse ka kehtivatele üürilepingutele. 2(2)Vallavalitsus hindab kehtivates ja käesoleva määruse kohaselt kohalduvates üürilepingutes kokkulepitud või lepingute alusel arvestatud üüri suurused käesoleva määruse piirmäära ja diferentseerimise aluseid arvestades üle hiljemalt 2019. aasta jooksul. 3(3)Üüri tõstmise korral lähtutakse võlaõigusseaduses sätestatud üüri tõstmist reguleerivatest sätetest. 4(4)Määrus jõustub 1. mail 2019. a.",
