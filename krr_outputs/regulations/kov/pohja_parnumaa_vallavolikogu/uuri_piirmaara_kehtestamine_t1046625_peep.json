      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Määrusega kehtestatakse Põhja-Pärnumaa valla (edaspidi valla) omandis olevate eluruumide üüri piirmäär. 2(2)Käesolevat määrust ei kohaldata eluruumidele, mis antakse kasutusse sotsiaalhoolekandelise abi korras eluruumi tagamise teenusena.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Määrusega kehtestatakse Põhja-Pärnumaa valla (edaspidi valla) omandis olevate eluruumide üüri piirmäär. 2(2)Käesolevat määrust ei kohaldata eluruumidele, mis antakse kasutusse sotsiaalhoolekandelise abi korras eluruumi tagamise teenusena.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046625_Map"
      },
