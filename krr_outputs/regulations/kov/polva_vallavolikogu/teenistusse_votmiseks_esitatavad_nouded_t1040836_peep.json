    {
      "@id": "estleg:Reg_1040836_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Nõuded haridusele",
        "@language": "et"
      },
      "estleg:sourceAct": "Teenistusse võtmiseks esitatavad nõuded",
      "estleg:summary": {
        "@value": "1(1) Ametnikul peab olema vähemalt keskharidus. 2(2) Struktuuriüksuse juhil peab olema kõrgharidus. 3(3) Vallasekretär peab vastama kohaliku omavalitsuse korralduse seaduse § 55 lõikes 2 sätestatud nõuetele. 4(4) Sotsiaalvaldkonna teenistuja peab omama sotsiaalhoolekande seaduse § 4 punktis 3 nõutud erialast ettevalmistust ja kõrgharidust. 5(5) Lastekaitsespetsialist peab omama lastekaitseseaduse § 19 lõigetes 1–2 nõutud erialast ettevalmistust ja kõrgharidust ning hiljemalt kahe aasta…",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Ametnikul peab olema vähemalt keskharidus. 2(2) Struktuuriüksuse juhil peab olema kõrgharidus. 3(3) Vallasekretär peab vastama kohaliku omavalitsuse korralduse seaduse § 55 lõikes 2 sätestatud nõuetele. 4(4) Sotsiaalvaldkonna teenistuja peab omama sotsiaalhoolekande seaduse § 4 punktis 3 nõutud erialast ettevalmistust ja kõrgharidust. 5(5) Lastekaitsespetsialist peab omama lastekaitseseaduse § 19 lõigetes 1–2 nõutud erialast ettevalmistust ja kõrgharidust ning hiljemalt kahe aasta möödumisel alates teenistusse asumisest peab omandama sotsiaaltöötaja kutse spetsialiseerumisega lastekaitsele. 6(6) Õigusvaldkonna teenistujal peab olema juriidiline kõrgharidus. 7(7) Ametnik, kelle ametikohale on muu õigusaktiga sätestatud haridus- või pädevusnõue, peab vastama õigusaktis sätestatud nõuetele. 8(8) Hariduse nõue loetakse täidetuks, kui seda tõendab vastavat pädevust omava õppeasutuse poolt väljastatud tunnistus või diplom.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavolikogu"
      },
