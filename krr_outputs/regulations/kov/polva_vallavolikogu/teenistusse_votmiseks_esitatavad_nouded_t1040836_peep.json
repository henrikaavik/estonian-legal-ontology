      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ametnikul, kellel puudub kõrgharidus, peab olema vähemalt 2-aastane eelnev töökogemus ametikoha töövaldkonnas.",
      "estleg:parentProvision": {
