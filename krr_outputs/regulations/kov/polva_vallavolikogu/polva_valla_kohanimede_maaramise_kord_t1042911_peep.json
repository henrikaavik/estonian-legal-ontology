    {
      "@id": "estleg:Reg_1042911_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohanime määramise korraldab vallavalitsuse ehitus- ja planeeringuosakond omal algatusel või füüsilise või juriidilise isiku kirjaliku taotluse alusel. Detailplaneeringu menetlemise käigus planeerija poolt nimetatud kohanime käsitletakse kirjaliku taotlusena kohanime määramiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042911_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
