        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_polva_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1042911_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kohanime määramise taotlus peab sisaldama kohanime valiku põhjendust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042911_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:Reg_1042911_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kohanime määramisel ehitus- ja planeeringuosakond: 1) kontrollib taotluse vastavust käesoleva paragrahvi lõikes 2 nimetatud ning kohanimeseaduses sätestatud nõuetele; 2) eraomandis olevale maaüksusele või sellel paiknevale nimeobjektile kohanime määramisel selgitab välja maaomaniku arvamuse vastavalt kohanimeseaduse § 6 lõikele 4; 3) valmistab ette õigusakti eelnõu kohanime määramiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042911_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ],
      "estleg:references": [
        {
          "@id": "estleg:kohanimeseadus_Par_6"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1042911_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kohanime määramisel lähtutakse kohanimeseaduses ning selle alusel kehtestatud rakendusaktides sätestatud kohanimele esitatavatest nõuetest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042911_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
