    {
      "@id": "estleg:Reg_1042911_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Kohanime määramise korraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Põlva valla kohanimede määramise kord",
      "estleg:summary": {
        "@value": "1(1) Kohanime määramise korraldab vallavalitsuse ehitus- ja planeeringuosakond omal algatusel või füüsilise või juriidilise isiku kirjaliku taotluse alusel. Detailplaneeringu menetlemise käigus planeerija poolt nimetatud kohanime käsitletakse kirjaliku taotlusena kohanime määramiseks. 2(2) Kohanime määramise taotlus peab sisaldama kohanime valiku põhjendust.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Kohanime määramise korraldab vallavalitsuse ehitus- ja planeeringuosakond omal algatusel või füüsilise või juriidilise isiku kirjaliku taotluse alusel. Detailplaneeringu menetlemise käigus planeerija poolt nimetatud kohanime käsitletakse kirjaliku taotlusena kohanime määramiseks. 2(2) Kohanime määramise taotlus peab sisaldama kohanime valiku põhjendust. 3(3) Kohanime määramisel ehitus- ja planeeringuosakond:11) kontrollib taotluse vastavust käesoleva paragrahvi lõikes 2 nimetatud ning kohanimeseaduses sätestatud nõuetele;22) eraomandis olevale maaüksusele või sellel paiknevale nimeobjektile kohanime määramisel selgitab välja maaomaniku arvamuse vastavalt kohanimeseaduse § 6 lõikele 4;33) valmistab ette õigusakti eelnõu kohanime määramiseks. 4(4) Kohanime määramisel lähtutakse kohanimeseaduses ning selle alusel kehtestatud rakendusaktides sätestatud kohanimele esitatavatest nõuetest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavolikogu"
      },
