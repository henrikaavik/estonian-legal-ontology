      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Kohanime kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põlva valla kohanimede määramise kord",
      "estleg:summary": {
        "@value": "1(1) Põlva valla õigusaktides, andmekogudes, aluskaardil, aadressiandmetes, teabelevis, avalikul sildil, kuulutustes, viitadel jms tuleb kasutada riiklikku kohanimeregistrisse kantud ametlikku kohanime. Põhi- ja rööpnimi esitatakse riiklikus kohanimeregistris esitatud järjekorras. 2(2) Kohanime sisaldavad aadressid määratakse seaduste ja nende alusel antud õigusaktide alusel.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Põlva valla õigusaktides, andmekogudes, aluskaardil, aadressiandmetes, teabelevis, avalikul sildil, kuulutustes, viitadel jms tuleb kasutada riiklikku kohanimeregistrisse kantud ametlikku kohanime. Põhi- ja rööpnimi esitatakse riiklikus kohanimeregistris esitatud järjekorras. 2(2) Kohanime sisaldavad aadressid määratakse seaduste ja nende alusel antud õigusaktide alusel. 3(3) Kohanime peab muutma, kui see on vastuolus kohanimele esitatavate nõuetega või kui kohanimede eri kujud vajavad ühtlustamist. 4(4) Kohanime võib kehtetuks tunnistada, kui nimeobjekti tegelikkuses ei eksisteeri. Kohanimi tunnistatakse kehtetuks vallavalitsuse korraldusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavolikogu"
      },
