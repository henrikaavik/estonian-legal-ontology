    {
      "@id": "estleg:Reg_1058102_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Erakooli ja eralasteaia pidaja võib käesoleva määruse kohaselt saadud toetust kasutada erakooli ja eralasteaia tegevuskulude katmiseks.",
