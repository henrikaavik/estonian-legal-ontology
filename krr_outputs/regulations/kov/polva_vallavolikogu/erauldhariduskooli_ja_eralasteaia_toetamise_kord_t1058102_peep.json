      "estleg:sourceAct": "Eraüldhariduskooli ja eralasteaia toetamise kord",
      "estleg:summary": {
        "@value": "Erakooli ja eralasteaia pidaja võib käesoleva määruse kohaselt saadud toetust kasutada erakooli ja eralasteaia tegevuskulude katmiseks.",
        "@language": "et"
      },
      "estleg:legalText": "Erakooli ja eralasteaia pidaja võib käesoleva määruse kohaselt saadud toetust kasutada erakooli ja eralasteaia tegevuskulude katmiseks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0622"
