        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Tugiisikuteenust võib osutada isik, kes vastab SHS § 25 esitatud nõuetele.",
