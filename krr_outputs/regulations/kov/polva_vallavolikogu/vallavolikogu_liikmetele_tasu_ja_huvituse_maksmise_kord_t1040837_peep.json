    {
      "@id": "estleg:Reg_1040837_Par_7",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Töötasu, hüvituse ja tasu maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavolikogu liikmetele tasu ja hüvituse maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Volikogu esimehele makstakse töötasu üks kord kuus, tasustatavale kuule järgneva kuu kaheksandal kuupäeval kirjalikult teatatud pangakontole. 2 (2) Volikogu aseesimehele makstakse hüvitust ning komisjoni esimehele, komisjoni aseesimehele ja volikogu liikmele makstakse tasu üks kord kuus, tasustatavale kuule järgneva kuu kaheksandal kuupäeval kirjalikult teatatud pangakontole.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Volikogu esimehele makstakse töötasu üks kord kuus, tasustatavale kuule järgneva kuu kaheksandal kuupäeval kirjalikult teatatud pangakontole. 2 (2) Volikogu aseesimehele makstakse hüvitust ning komisjoni esimehele, komisjoni aseesimehele ja volikogu liikmele makstakse tasu üks kord kuus, tasustatavale kuule järgneva kuu kaheksandal kuupäeval kirjalikult teatatud pangakontole. Hüvitust ja tasu ei maksta juuli- ja augustikuu eest, sõltumata sellest, kas volikogu istungeid toimub või ei toimu.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_polva_vallavolikogu"
      },
