      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maksuvabastust saavad isikud",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksust vabastamise kord",
      "estleg:summary": {
        "@value": "Vabastada maamaksust represseeritu ja represseerituga võrdsustatud isik okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes tema kasutuses oleva elamumaa või maatulundusmaa õuemaa kõlviku osas.",
        "@language": "et"
      },
      "estleg:legalText": "Vabastada maamaksust represseeritu ja represseerituga võrdsustatud isik okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes tema kasutuses oleva elamumaa või maatulundusmaa õuemaa kõlviku osas.",
