      "rdfs:label": {
        "@value": "§ 2. Toetuse taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Toetuse andmise kord",
      "estleg:summary": {
        "@value": "1(1) Toetuse taotlemiseks esitab taotleja Põlva Vallavalitsusele (edaspidi vallavalitsus) põhjendatud taotluse. 2(2) Taotlusele lisatakse kulude eelarve või kulude aluseks oleva kuludokumendi koopia.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Toetuse taotlemiseks esitab taotleja Põlva Vallavalitsusele (edaspidi vallavalitsus) põhjendatud taotluse. 2(2) Taotlusele lisatakse kulude eelarve või kulude aluseks oleva kuludokumendi koopia.",
