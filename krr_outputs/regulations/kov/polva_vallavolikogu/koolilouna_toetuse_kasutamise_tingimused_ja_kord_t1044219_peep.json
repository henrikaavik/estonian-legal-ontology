      "estleg:competenceType": "regulation"
    },
    {
      "@id": "estleg:Reg_1044219_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Põlva valla munitsipaalkoolide statsionaarses õppes õppivate õpilaste koolilõuna kulude katmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044219_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1044219_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Põlva valla üldhariduskoolide statsionaarses õppes õppivate õpilaste koolilõuna tegeliku maksumuse ja riigieelarvest eraldatava toetuse vahe kaetakse Põlva valla eelarve vahenditest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044219_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1044219_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarveliste vahendite sihipärase kasutamise eest vastutab kooli direktor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044219_Par_2"
      },
      "rdfs:label": "§ 2 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044219_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Koolilõuna maksumuse kehtestab Põlva Vallavalitsus.",
      "estleg:parentProvision": {
