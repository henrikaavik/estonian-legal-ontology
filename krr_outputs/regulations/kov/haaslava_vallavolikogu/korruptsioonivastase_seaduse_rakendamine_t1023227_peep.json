    },
    {
      "@id": "estleg:Reg_1023227_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Deklaratsiooni kontrollitakse vajadusel ning süüteokahtluse korral.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1023227_Par_5"
      },
      "rdfs:label": "§ 5 lg 1"
    },
    {
      "@id": "estleg:Reg_1023227_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Deklaratsioone kontrollib Haaslava Vallavolikogu revisjonikomisjon, kellel on õigus kontrollida kõigi käesoleva määruse § 3 lõikes 1 nimetatud deklarantide deklaratsioone.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1023227_Par_5"
      },
      "rdfs:label": "§ 5 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Right"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_haaslava_vallavolikogu"
        }
      ],
      "estleg:competenceType": "enforcement"
    },
    {
      "@id": "estleg:Reg_1023227_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Deklaratsiooni kontrollival komisjoniliikmel on õigus: 1) Nõuda deklarandilt ja kolmandalt isikult selgitusi deklaratsiooni sisu, deklaratsiooni esitamise tähtaja eiramise või deklaratsiooni esitamata jätmise põhjuste kohta; 2) Esitada päringuid ja saada deklarandi kohta deklaratsiooni kontrollimiseks vajalikus ulatuses andmeid krediidiasutustelt ja riigi või kohaliku omavalitsuse andmekogudest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1023227_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
      "estleg:itemNumber": [
        "1",
        "2"
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Right"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Institution_kohalik_omavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1023227_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Deklaratsiooni kontrolliv komisjoni liige protokollib käesoleva paragrahvi lõikes nimetatud kontrolltoimingud ning teavitab deklaranti ja registri pidajat deklaratsiooni kontrollimisest ja läbi viidud kontrolltoimingutest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1023227_Par_5"
      },
      "rdfs:label": "§ 5 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1023227_Par_5_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Juhul kui ametiisiku deklaratsiooni kontrollimise tulemusel on tekkinud süüteokahtlus, teavitab deklaratsiooni kontrolliv komisjoni liige viivitamatult revisjonikomisjoni esimeest, vallavolikogu esimeest või vallavanemat. Vallavolikogu esimees või vallavanem edastab süüteokahtluse korral deklaratsiooni kontrollimise materjalid prokuratuurile või kohtuvälisele menetlejale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1023227_Par_5"
      },
      "rdfs:label": "§ 5 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_haaslava_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1023227_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Vallavanema ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse 1 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi.staatusest ning sellega kaasnevatest kohustustest; 2 2) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3 3) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes; 4 4) arvestuse pidamise ametiasutuse ametnike tegelemise…",
        "@language": "et"
      },
      "estleg:legalText": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse 1 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi.staatusest ning sellega kaasnevatest kohustustest; 2 2) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3 3) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes; 4 4) arvestuse pidamise ametiasutuse ametnike tegelemise üle avaliku teenistuse seaduses nimetatud kõrval tegevustega, samuti kontrolli avaliku teenistuse seaduses kehtestatud keeldude järgimise üle;",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haaslava_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
      },
