      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Sisekord",
        "@language": "et"
      },
      "estleg:sourceAct": "Roiu Raamatukogu kasutamise eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Raamatukogus tuleb säilitada korda ja vaikust. Lubamatu on igasugune tegevus, mis häirib teisi lugejaid (nt. mobiiltelefoniga rääkimine). 2 (2) Raamatukogus on keelatud söömine ja joomine. 3 (3) Alkoholijoobes ja määrdunud riiete ja kätega lugejaid ei teenindata. 4 (4) Pretensioonid ja ettepanekud raamatukoguteenuste korraldamisel lahendab raamatukogu juhataja.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Raamatukogus tuleb säilitada korda ja vaikust. Lubamatu on igasugune tegevus, mis häirib teisi lugejaid (nt. mobiiltelefoniga rääkimine). 2 (2) Raamatukogus on keelatud söömine ja joomine. 3 (3) Alkoholijoobes ja määrdunud riiete ja kätega lugejaid ei teenindata. 4 (4) Pretensioonid ja ettepanekud raamatukoguteenuste korraldamisel lahendab raamatukogu juhataja.",
