      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Komisjoni kooseis, liikme õigused, liikme volitused",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi Linna poolt hallatavate asutuste arengukavade läbivaatamise komisjoni põhimääruse kinnitamine",
      "estleg:summary": {
        "@value": "1 (1) Komisjoni liige võib isikliku avalduse alusel tagasi astuda. 2 (2) Komisjoni liikme volitused lõpevad linnavalitsuse vastava õigusakti jõustumisel. 3 (3) Komisjoni liikmel on õigus: 1 1) avaldada oma arvamust enne komisjoni otsuse tegemist; 2 2) olla oma otsuste tegemisel sõltumatu; 3 3) jääda otsuse tegemisel eriarvamusele ja nõuda kirjaliku eriarvamuse lisamist protokollile.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjoni liige võib isikliku avalduse alusel tagasi astuda. 2 (2) Komisjoni liikme volitused lõpevad linnavalitsuse vastava õigusakti jõustumisel. 3 (3) Komisjoni liikmel on õigus: 1 1) avaldada oma arvamust enne komisjoni otsuse tegemist; 2 2) olla oma otsuste tegemisel sõltumatu; 3 3) jääda otsuse tegemisel eriarvamusele ja nõuda kirjaliku eriarvamuse lisamist protokollile. 4 (4) Komisjoni liige on kohustatud osalema komisjoni töös komisjoni esimehe määratud aegadel või teatama õigeaegselt komisjoni esimehele komisjoni töös osalemast takistavatest asjaoludest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavalitsus"
      },
