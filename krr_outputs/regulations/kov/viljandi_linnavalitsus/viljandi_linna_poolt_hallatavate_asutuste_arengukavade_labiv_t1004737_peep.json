        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 8.",
      "rdfs:label": {
        "@value": "§ 8. Komisjoni töökord",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi Linna poolt hallatavate asutuste arengukavade läbivaatamise komisjoni põhimääruse kinnitamine",
      "estleg:summary": {
        "@value": "1 (1) Komisjoni töövorm on koosolek. 2 (2) Komisjoni tööd juhib komisjoni esimees, tema äraolekul esimehe asetäitja. 3 (3) Koosolekud toimuvad hiljemalt kahe nädala jooksul peale materjalide esitamise tähtaja möödumist. 4 (4) Komisjon on otsustusvõimeline, kui koosolekust võtab osa 1/2 liikmetest ja komisjoni esimees, tema äraolekul esimehe asetäitja. 5 (5) Komisjoni koosolekud protokollitakse. 6 (6) Komisjoni dokumente säilitatakse linnavalitsuse kantseleis.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjoni töövorm on koosolek. 2 (2) Komisjoni tööd juhib komisjoni esimees, tema äraolekul esimehe asetäitja. 3 (3) Koosolekud toimuvad hiljemalt kahe nädala jooksul peale materjalide esitamise tähtaja möödumist. 4 (4) Komisjon on otsustusvõimeline, kui koosolekust võtab osa 1/2 liikmetest ja komisjoni esimees, tema äraolekul esimehe asetäitja. 5 (5) Komisjoni koosolekud protokollitakse. 6 (6) Komisjoni dokumente säilitatakse linnavalitsuse kantseleis. 7 (7) Komisjon oma põhiülesannete täitmiseks: 1 1) töötab välja ühtsed põhimõtted; 2 2) taotleb vajadusel lisainformatsiooni. 8 (8) Komisjon on oma ülesannete täitmisel kohustatud tagama, et komisjonile esitatud materjalid ei satuks asjasse mittepuutuvate isikute kätte.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavalitsus"
      },
