      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Viljandi Linnavalitsuse sotsiaalkomisjoni tegevuse eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi Linnavalitsuse sotsiaalkomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Viljandi Linnavalitsuse (edaspidi linnavalitsus) sotsiaalkomisjoni eesmärgiks on sotsiaaltoetuste ning -teenuste saamiseks esitatud taotluste läbivaatamine ja lahendamine. 2 (2) Komisjon juhindub oma tegevuses riigi ja Viljandi linna õigusaktidest ning käesolevast põhimäärusest. 3 (3) Komisjoni otsused kinnitab linnavalitsus.",
        "@language": "et"
      },
