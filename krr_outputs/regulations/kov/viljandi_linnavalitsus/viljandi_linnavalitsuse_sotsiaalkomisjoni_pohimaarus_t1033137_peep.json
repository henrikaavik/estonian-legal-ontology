        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Komisjoni koosseis, liikme õigused ja volitused",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi Linnavalitsuse sotsiaalkomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Komisjoni koosseisu kuulub vähemalt 5 liiget. 2 (2) Komisjoni liige võib isikliku avalduse alusel tagasi astuda. 3 (3) Komisjoni liikme volitused lõpevad linnavalitsuse vastava õigusakti jõustumisel. 4 (4) Komisjoni liikmel on õigus: 1 1) avaldada oma arvamust enne komisjoni otsuse tegemist; 2 2) olla oma otsuste tegemisel sõltumatu; 3 3) jääda otsuse tegemisel eriarvamusele ja nõuda kirjaliku eriarvamuse lisamist protokollile.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjoni koosseisu kuulub vähemalt 5 liiget. 2 (2) Komisjoni liige võib isikliku avalduse alusel tagasi astuda. 3 (3) Komisjoni liikme volitused lõpevad linnavalitsuse vastava õigusakti jõustumisel. 4 (4) Komisjoni liikmel on õigus: 1 1) avaldada oma arvamust enne komisjoni otsuse tegemist; 2 2) olla oma otsuste tegemisel sõltumatu; 3 3) jääda otsuse tegemisel eriarvamusele ja nõuda kirjaliku eriarvamuse lisamist protokollile. 5 (5) Komisjoni liige on kohustatud: 1 1) osalema komisjoni töös komisjoni esimehe määratud aegadel; 2 2) teatama õigeaegselt komisjoni esimehele komisjoni töös osalemist takistavatest asjaoludest; 3 3) hoidma saladuses talle komisjoni töös osalemisel teatavaks saanud andmed.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_linnavalitsus"
      },
