      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Komisjon juhindub oma tegevuses riigi ja Viljandi linna õigusaktidest ning käesolevast põhimäärusest.",
