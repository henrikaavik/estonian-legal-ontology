      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Komisjoni esimees",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi linna elukohajärgsesse munitsipaalüldhariduskooli suunamise komisjoni põhimääruse kinnitamine",
      "estleg:summary": {
        "@value": "1 (1) Komisjoni esimehe nimetab linnavalitsus. 2 (2) Komisjoni esimees: 1 1) määrab komisjoni liikmete hulgast sekretäri; 2 2) kutsub kokku komisjoni koosoleku. 3 (3) Komisjoni esimehe volitused lõpevad: 1 1) vabastamisega ametikohalt, millega seoses ta esimeheks nimetati; 2 2) teda nimetanud linnavalitsuse motiveeritud otsusel; 3 3) isikliku avalduse alusel.",
        "@language": "et"
      },
