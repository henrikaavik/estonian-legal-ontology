      "rdfs:label": {
        "@value": "§ 2. Õppimiskohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064206_Map"
      },
      "estleg:summary": {
        "@value": "1(1)Õppimiskohustus on õpilase kohustus osaleda põhi-, kesk- või kutsehariduse õppes ning omandada teadmisi, oskusi ja pädevusi, mis toetavad tema arengut ja haridustee jätkamist. 2(2)Õppimiskohustus tekib õpilasel, kes on saanud enne käimasoleva aasta 1. oktoobrit seitsmeaastaseks. 3(3)Õppimiskohustus kestab kuni 18-aastaseks saamiseni. 4(4)Õppimiskohustus loetakse enne 18-aastaseks saamist täidetuks juhul, kui õpilane on omandanud keskhariduse või kutsehariduse.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Õppimiskohustus on õpilase kohustus osaleda põhi-, kesk- või kutsehariduse õppes ning omandada teadmisi, oskusi ja pädevusi, mis toetavad tema arengut ja haridustee jätkamist. 2(2)Õppimiskohustus tekib õpilasel, kes on saanud enne käimasoleva aasta 1. oktoobrit seitsmeaastaseks. 3(3)Õppimiskohustus kestab kuni 18-aastaseks saamiseni. 4(4)Õppimiskohustus loetakse enne 18-aastaseks saamist täidetuks juhul, kui õpilane on omandanud keskhariduse või kutsehariduse.",
