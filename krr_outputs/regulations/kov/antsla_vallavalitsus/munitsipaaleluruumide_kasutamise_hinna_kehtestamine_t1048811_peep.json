        {
          "@id": "estleg:Reg_1048811_Par_1_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1048811_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Antsla valla munitsipaalomandis olevate eluruumide üürimäärad eluruumi üldpinna ühe ruutmeetri kohta kuus on järgmised: 1) keskküttega, veevarustuse ja kanalisatsiooni olemasolul 1,00 kuni 2 eurot/m²; 2) keskkütteta, veevarustuse ja kanalisatsiooni olemasolul 0,80 kuni 1,50 eurot/m²; 3) ahiküttega, veevarustus ja kanalisatsioon puuduvad 0,50 kuni 1,0 eurot/m².",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048811_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1048811_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Eluruumi üürimäärad ei sisalda kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muruniitmise, lumetõrje, maja üldelektri jt) kommunaalteenuste eest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048811_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
