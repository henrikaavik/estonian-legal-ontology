      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Munitsipaaleluruumide üürimäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Munitsipaaleluruumide kasutamise hinna kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Antsla valla munitsipaalomandis olevate eluruumide üürimäärad eluruumi üldpinna ühe ruutmeetri kohta kuus on järgmised:11) keskküttega, veevarustuse ja kanalisatsiooni olemasolul 1,00 kuni 2 eurot/m2;22) keskkütteta, veevarustuse ja kanalisatsiooni olemasolul 0,80 kuni 1,50 eurot/m2;33) ahiküttega, veevarustus ja kanalisatsioon puuduvad 0,50 kuni 1,0 eurot/m2.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Antsla valla munitsipaalomandis olevate eluruumide üürimäärad eluruumi üldpinna ühe ruutmeetri kohta kuus on järgmised:11) keskküttega, veevarustuse ja kanalisatsiooni olemasolul 1,00 kuni 2 eurot/m2;22) keskkütteta, veevarustuse ja kanalisatsiooni olemasolul 0,80 kuni 1,50 eurot/m2;33) ahiküttega, veevarustus ja kanalisatsioon puuduvad 0,50 kuni 1,0 eurot/m2. 2(2)Eluruumi üürimäärad ei sisalda kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muruniitmise, lumetõrje, maja üldelektri jt) kommunaalteenuste eest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0142"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1048811_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1048811_Par_1_Lg_1"
