      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Konguta Rahvamaja ruume annab rendile ja peab ruumide rendi arvestust Konguta Rahvamaja juhataja (edaspidi juhataja) juhindudes kehtestatud rendi hindadest. Aruande ruumide kasutamise kohta esitab juhataja Konguta Vallavalitsuse raamatupidajale aruande kuule järgneva kuu 10. kuupäevaks.",
        "@language": "et"
      },
      "estleg:summary": {
        "@value": "§ 2. Konguta Rahvamaja ruume annab rendile ja peab ruumide rendi arvestust Konguta Rahvamaja juhataja (edaspidi juhataja) juhindudes kehtestatud rendi hindadest. Aruande ruumide kasutamise kohta esitab juhataja Konguta Vallavalitsuse raamatupidajale aruande kuule järgneva kuu 10. kuupäevaks.",
        "@language": "et"
      },
