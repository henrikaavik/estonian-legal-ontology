    {
      "@id": "estleg:Reg_1009791_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Rendihindade kehtestamine:",
        "@language": "et"
      },
      "estleg:sourceAct": "Konguta Rahvamaja ruumide kasutusse andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Konguta rahvamaja ruumide rendi hinnad tegevuste lõikes: 1 1) koosolekud, peied, juubelid, pulmad 6, 40 eurot tund; 2 2) äri-, müügitegevus ja muud üritused 12,80 eurot tund. 2 (2) Konguta rahvamaja ruumide ööpäevase kasutamise rendi hind on 128 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Konguta rahvamaja ruumide rendi hinnad tegevuste lõikes: 1 1) koosolekud, peied, juubelid, pulmad 6, 40 eurot tund; 2 2) äri-, müügitegevus ja muud üritused 12,80 eurot tund. 2 (2) Konguta rahvamaja ruumide ööpäevase kasutamise rendi hind on 128 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_konguta_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0171"
      },
      "estleg:partOfAct": {
