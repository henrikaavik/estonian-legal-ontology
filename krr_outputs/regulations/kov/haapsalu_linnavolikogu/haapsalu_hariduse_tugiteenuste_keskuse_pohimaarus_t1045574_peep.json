        {
          "@id": "estleg:Reg_1045574_Par_2_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1045574_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Keskuse tegevuse põhieesmärgiks on pakkuda laste/õpilaste arenguliste ning hariduslike erivajaduste varajaseks märkamiseks ning individuaalse arengu toetamiseks hariduse tugiteenuseid - psühholoogilist, eripedagoogilist, logopeedilist ning sotsiaalpedagoogilist nõustamist Haapsalu linna lastele, noortele, lastevanematele ja haridusasutuste töötajatele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045574_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1045574_Par_2_Lg_2",
