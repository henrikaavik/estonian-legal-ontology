    },
    {
      "@id": "estleg:Reg_1045574_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu Hariduse Tugiteenuste Keskuse põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Keskuse tegevuse põhiülesandeks on laste ja noorte ning nende vanemate ja haridusasutuste personali sotsiaalpedagoogiline, logopeediline, eripedagoogiline ja psühholoogiline nõustamine ning teenuse korraldamine linna haridusasutustes ja keskuses. 2(2)Keskuse ülesanneteks on:11) koolikohustuse mittetäitmise ja põhihariduseta koolist väljalangevuse ennetamine;22) põhiülesannetest tulenevate ürituste korraldamine;33) tegevuse eesmärkidega seotud erinevate kursuste ja täienduskoolituste…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Keskuse tegevuse põhiülesandeks on laste ja noorte ning nende vanemate ja haridusasutuste personali sotsiaalpedagoogiline, logopeediline, eripedagoogiline ja psühholoogiline nõustamine ning teenuse korraldamine linna haridusasutustes ja keskuses. 2(2)Keskuse ülesanneteks on:11) koolikohustuse mittetäitmise ja põhihariduseta koolist väljalangevuse ennetamine;22) põhiülesannetest tulenevate ürituste korraldamine;33) tegevuse eesmärkidega seotud erinevate kursuste ja täienduskoolituste korraldamine;44) tugispetsialistide koostöö ja ühistegevuse koordineerimine ja suunamine ning laste ja noortega tegelevatele spetsialistidele koostöövõimaluste pakkumine;55) lastele ja noortele tugiteenuse osutamisel koostöö tegemine teiste huvigruppide ning spetsialistidega;66) laste ja noorte arengu toetamiseks ning teenuste analüüsimiseks ühtse andmebaasi haldamine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavolikogu"
      },
