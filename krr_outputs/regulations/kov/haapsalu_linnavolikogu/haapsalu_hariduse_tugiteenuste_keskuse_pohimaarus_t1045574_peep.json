        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Keskuse tegevus lähtub kaasava hariduse põhimõttest, mille kohaselt on haridusasutuse ülesanne tagada igale lapsele/õpilasele tema individuaalsetest võimetest lähtuv jõukohane õpe ja areng.",
