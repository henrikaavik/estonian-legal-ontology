    {
      "@id": "estleg:Reg_1045574_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tegevuse eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu Hariduse Tugiteenuste Keskuse põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Keskuse tegevuse põhieesmärgiks on pakkuda laste/õpilaste arenguliste ning hariduslike erivajaduste varajaseks märkamiseks ning individuaalse arengu toetamiseks hariduse tugiteenuseid - psühholoogilist, eripedagoogilist, logopeedilist ning sotsiaalpedagoogilist nõustamist Haapsalu linna lastele, noortele, lastevanematele ja haridusasutuste töötajatele.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Keskuse tegevuse põhieesmärgiks on pakkuda laste/õpilaste arenguliste ning hariduslike erivajaduste varajaseks märkamiseks ning individuaalse arengu toetamiseks hariduse tugiteenuseid - psühholoogilist, eripedagoogilist, logopeedilist ning sotsiaalpedagoogilist nõustamist Haapsalu linna lastele, noortele, lastevanematele ja haridusasutuste töötajatele. 2(2)Keskuse tegevus lähtub kaasava hariduse põhimõttest, mille kohaselt on haridusasutuse ülesanne tagada igale lapsele/õpilasele tema individuaalsetest võimetest lähtuv jõukohane õpe ja areng.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0184"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045574_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1045574_Par_2_Lg_1"
