        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Lähetuskulude hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu Linnavolikogu ja Haapsalu Linnavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulud ning lähetusülesande täitmisega seotud muud kulud ning makstakse välislähetuses viibimise aja eest päevaraha Vabariigi Valitsuse määrusega kehtestatud ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimustel ja korras vormikohase lähetuskulude õiendi alusel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulud ning lähetusülesande täitmisega seotud muud kulud ning makstakse välislähetuses viibimise aja eest päevaraha Vabariigi Valitsuse määrusega kehtestatud ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimustel ja korras vormikohase lähetuskulude õiendi alusel. 2 (2) Lähetuskulude õiendi ja kulusid tõendavad dokumendid esitab linnavolikogu liige linnavolikogu esimehele ja linnavalitsuse liige linnapeale. Kõik lähetusega seotud hüvitatavad kulud peavad olema dokumentaalselt tõendatud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0184"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028471_Map"
      },
      "estleg:targetGroup": [
