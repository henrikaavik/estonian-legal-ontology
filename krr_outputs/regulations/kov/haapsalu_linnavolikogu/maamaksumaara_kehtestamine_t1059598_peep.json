      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Haapsalu linna haldusterritooriumil järgmised maamaksumäärad: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumäär on 1,0 protsenti maa maksustamishinnast aastas. 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa maamaksumäär on 0,5 protsenti maa maksustamishinnast aastas. 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa maamaksumäär on 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Haapsalu linna haldusterritooriumil järgmised maamaksumäärad: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumäär on 1,0 protsenti maa maksustamishinnast aastas. 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa maamaksumäär on 0,5 protsenti maa maksustamishinnast aastas. 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa maamaksumäär on 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0184"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059598_Map"
      },
