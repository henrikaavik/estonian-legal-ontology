      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) 2026. aasta eelarveperioodiks sõlmida arvelduskrediidi või arvelduslaenu lepinguid maksimaalselt summas 500 000 eurot.",
      "estleg:parentProvision": {
