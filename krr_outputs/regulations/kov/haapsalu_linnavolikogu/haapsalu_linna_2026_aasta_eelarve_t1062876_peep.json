      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1062876_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Väljastada garantiikirju jooksvaks aastaks kinnitatud eelarve piires maksimaalselt tähtajaga kuni 31.12.2026.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062876_Par_2"
