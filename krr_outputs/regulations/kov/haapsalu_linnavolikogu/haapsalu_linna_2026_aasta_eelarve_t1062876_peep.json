        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Korraldada hange ja sõlmida 2026. aastal laenuleping investeeringute finantseerimiseks ja laenude tasumiseks maksimaalselt summas 790 000 eurot ja tähtajaga kuni 180 kuud.",
