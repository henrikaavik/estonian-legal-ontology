    },
    {
      "@id": "estleg:Reg_1062876_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Volitused linnavalitsusele kohustuste võtmiseks",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu linna 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "1 (1) 2026. aasta eelarveperioodiks sõlmida arvelduskrediidi või arvelduslaenu lepinguid maksimaalselt summas 500 000 eurot. 2 (2) Väljastada garantiikirju jooksvaks aastaks kinnitatud eelarve piires maksimaalselt tähtajaga kuni 31.12.2026. 3 (3) Korraldada hange ja sõlmida 2026. aastal laenuleping investeeringute finantseerimiseks ja laenude tasumiseks maksimaalselt summas 790 000 eurot ja tähtajaga kuni 180 kuud.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) 2026. aasta eelarveperioodiks sõlmida arvelduskrediidi või arvelduslaenu lepinguid maksimaalselt summas 500 000 eurot. 2 (2) Väljastada garantiikirju jooksvaks aastaks kinnitatud eelarve piires maksimaalselt tähtajaga kuni 31.12.2026. 3 (3) Korraldada hange ja sõlmida 2026. aastal laenuleping investeeringute finantseerimiseks ja laenude tasumiseks maksimaalselt summas 790 000 eurot ja tähtajaga kuni 180 kuud.",
      "estleg:enactedBy": {
