      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu perearstiteenuse toetuse maksmise kord",
      "estleg:summary": {
        "@value": "1(1)Haapsalu perearstiteenuse toetuse maksmise kord (edaspidi Kord) reguleerib Haapsalu linnas nimistuga tööd alustavale perearstile makstava toetuse taotlemist, maksmist ning tagasinõudmist. 2(2)Perearsti toetus (edaspidi Toetus) on ühekordselt makstav rahaline toetus Haapsalu linnas nimistuga töötamist alustavale perearstile, kelle vastuvõtukoht asub Haapsalu linnas.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Haapsalu perearstiteenuse toetuse maksmise kord (edaspidi Kord) reguleerib Haapsalu linnas nimistuga tööd alustavale perearstile makstava toetuse taotlemist, maksmist ning tagasinõudmist. 2(2)Perearsti toetus (edaspidi Toetus) on ühekordselt makstav rahaline toetus Haapsalu linnas nimistuga töötamist alustavale perearstile, kelle vastuvõtukoht asub Haapsalu linnas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0184"
      },
