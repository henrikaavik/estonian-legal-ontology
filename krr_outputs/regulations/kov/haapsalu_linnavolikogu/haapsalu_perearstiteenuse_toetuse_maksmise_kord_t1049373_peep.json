    {
      "@id": "estleg:Reg_1049373_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Toetuse tagasinõudmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu perearstiteenuse toetuse maksmise kord",
      "estleg:summary": {
        "@value": "1(1) Linnavalitsusel on õigus ja toetuse saajal kohustus toetus tagasi nõuda /maksta, kui toetuse saaja lõpetab enne viie aasta möödumist toetuse saamisest Haapsalu linnas perearstina tegutsemise või töötamise. 2(2)Töötamine või tegutsemine loetakse peatunuks toetust saanud arsti lapsehoolduspuhkuse või ajateenistuskohustuse täitmise ajal ning arsti töötamise või tegutsemise kohustus pikeneb nimetatud aja võrra.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Linnavalitsusel on õigus ja toetuse saajal kohustus toetus tagasi nõuda /maksta, kui toetuse saaja lõpetab enne viie aasta möödumist toetuse saamisest Haapsalu linnas perearstina tegutsemise või töötamise. 2(2)Töötamine või tegutsemine loetakse peatunuks toetust saanud arsti lapsehoolduspuhkuse või ajateenistuskohustuse täitmise ajal ning arsti töötamise või tegutsemise kohustus pikeneb nimetatud aja võrra. Perearst on kohustatud eelnimetatud sündmuse saabumisel teavitama Haapsalu Linnavalitsus. 3(3)Töötamine või tegutsemine loetakse pidevaks perearsti töövõimetuse ajal või juhul, kui toetust saanud isiku perearstina töötamise staaž ei katke viieaastase perioodi kestel rohkem kui kolmeks kuuks korraga. 4(4)Toetus tuleb maksta tagasi toetuse tagasimaksmise teatise esitamisest arvates 2 aasta jooksul igal aastal ühe kahendiku suuruses osas tagasimaksmisele kuuluvast toetuse summast. 5(5)Toetuse saaja peab võimaldama kontrollida toetuse tagastamise aluseks olevaid asjaolusid ning esitama vajadusel selgitusi ja võimaldama tutvuda dokumentidega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavolikogu"
      },
