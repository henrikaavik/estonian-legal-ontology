      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohtuvälise menetleja tunnistus ja menetluse dokumendid",
        "@language": "et"
      },
      "estleg:sourceAct": "Volituste andmine väärteomenetluses osalemiseks",
      "estleg:summary": {
        "@value": "1 (1) Anda käesoleva määruse § 1 nimetatud ametikohti täitvatele ametnikele nende pädevust tõendavad kohtuvälise menetleja tunnistused. 2 (2) Kinnitada väärteomenetlust läbiviiva kohtuvälise menetleja ametniku tunnistuse vorm vastavalt lisale 1.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Anda käesoleva määruse § 1 nimetatud ametikohti täitvatele ametnikele nende pädevust tõendavad kohtuvälise menetleja tunnistused. 2 (2) Kinnitada väärteomenetlust läbiviiva kohtuvälise menetleja ametniku tunnistuse vorm vastavalt lisale 1.",
