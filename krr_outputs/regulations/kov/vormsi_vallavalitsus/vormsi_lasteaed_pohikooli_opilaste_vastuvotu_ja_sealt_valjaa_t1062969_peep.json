      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Vormsi Lasteaed-Põhikooli õpilaste vastuvõtu ja sealt väljaarvamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Määrusega kehtestatakse Vormsi Lasteaed-Põhikooli (edaspidi nimetatud kool) 1.-3. kooliastmesse õpilaste vastuvõtmise tingimused ja kord ning koolist väljaarvamise kord. 2 (2) Kooli 1.-3. kooliastmesse võetakse vastu kõik koolikohustuslikus eas olevad õpilased, kelle elukoht rahvastikuregistri andmetel on Vormsi vallas. Vabade kohtade olemasolul võetakse vastu ka teisi koolikohustuslikus eas olevaid isikuid.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega kehtestatakse Vormsi Lasteaed-Põhikooli (edaspidi nimetatud kool) 1.-3. kooliastmesse õpilaste vastuvõtmise tingimused ja kord ning koolist väljaarvamise kord. 2 (2) Kooli 1.-3. kooliastmesse võetakse vastu kõik koolikohustuslikus eas olevad õpilased, kelle elukoht rahvastikuregistri andmetel on Vormsi vallas. Vabade kohtade olemasolul võetakse vastu ka teisi koolikohustuslikus eas olevaid isikuid. 3 (3) Korras määratakse vastuvõtu taotluse esitamise kord, vastuvõtmisel esitatavad nõuded, vastuvõtu korraldus, muud vastuvõtmisel tähtsust omavad asjaolud ning vastuvõtmisest või sellest keeldumisest teavitamise kord. 4 (4) Õpilase kooli vastuvõtmise tingimused ja kord ning koolist väljaarvamise kord avalikustatakse kooli kodulehel vormsi.edu.ee.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vormsi_vallavalitsus"
      },
