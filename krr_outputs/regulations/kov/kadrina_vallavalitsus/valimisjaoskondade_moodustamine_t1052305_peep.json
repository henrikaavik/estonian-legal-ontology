        }
      ]
    },
    {
      "@id": "estleg:Reg_1052305_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valimisjaoskond nr 1 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Kadrina Kultuurikoja Kadrina rahvamajas ( Viru tn 14 Kadrina alevik, Kadrina vald, Lääne- Viru maakond).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052305_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1052305_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Valimisjaoskond nr 2 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Kadrina Lasteaia Sipsik Hulja majas asuvas Hulja raamatukogu ruumes(Tõnismäe tee 18 Hulja alevik, Kadrina vald, Lääne-Viru maakond).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052305_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1052305_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2(2)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3(3)Kodus hääletamist korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2(2)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3(3)Kodus hääletamist korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2. Euroopa Parlamendi valimistel ja rahvahääletusel korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2 ka asukohas hääletamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kadrina_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0272"
      },
