    {
      "@id": "estleg:Reg_1052305_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Valimisjaoskondade numeratsioon ja hääletamisruumide asukohad",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)Valimisjaoskond nr 1 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Kadrina Kultuurikoja Kadrina rahvamajas ( Viru tn 14 Kadrina alevik, Kadrina vald, Lääne- Viru maakond). 2(2)Valimisjaoskond nr 2 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Kadrina Lasteaia Sipsik Hulja majas asuvas Hulja raamatukogu ruumes(Tõnismäe tee 18 Hulja alevik, Kadrina vald, Lääne-Viru maakond).",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Valimisjaoskond nr 1 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Kadrina Kultuurikoja Kadrina rahvamajas ( Viru tn 14 Kadrina alevik, Kadrina vald, Lääne- Viru maakond). 2(2)Valimisjaoskond nr 2 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Kadrina Lasteaia Sipsik Hulja majas asuvas Hulja raamatukogu ruumes(Tõnismäe tee 18 Hulja alevik, Kadrina vald, Lääne-Viru maakond).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kadrina_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0272"
