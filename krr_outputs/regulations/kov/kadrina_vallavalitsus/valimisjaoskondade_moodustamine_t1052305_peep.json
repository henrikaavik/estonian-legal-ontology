    },
    {
      "@id": "estleg:Reg_1052305_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052305_Par_3"
      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1052305_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052305_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1052305_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2. Euroopa Parlamendi valimistel ja rahvahääletusel korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2 ka asukohas hääletamist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052305_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
