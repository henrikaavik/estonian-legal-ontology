    },
    {
      "@id": "estleg:Reg_1053974_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Konkursiteates märgitakse: 1) konkursi korras täidetava ametikoha nimetus; 2) kandidaadile esitatavad nõuded; 3) koos kandideerimisavaldusega esitatavate dokumentide loetelu; 4) kandideerimisavalduse esitamise tähtaeg; 5) e-posti aadress, kuhu kandideerimisavaldus ja dokumendid tuleb esitada; 6) kontaktisiku andmed.",
