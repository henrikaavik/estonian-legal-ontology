      "rdfs:label": {
        "@value": "§ 6. Konkursi luhtumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lasteaia direktori ametikoha täitmiseks korraldatava konkursi läbiviimise kord",
      "estleg:summary": {
        "@value": "Konkurss on luhtunud, kui:11) konkursil osalemiseks ei esitatud ühtegi avaldust;22) kõik kandidaadid osutusid ametikohale mittevastavaks;33) ükski kandidaat ei kogunud hääletusel nõutavat häälteenamust;44) ühegi konkursitingimustele vastava kandidaadiga ei sõlmita töölepingut.",
        "@language": "et"
      },
      "estleg:legalText": "Konkurss on luhtunud, kui:11) konkursil osalemiseks ei esitatud ühtegi avaldust;22) kõik kandidaadid osutusid ametikohale mittevastavaks;33) ükski kandidaat ei kogunud hääletusel nõutavat häälteenamust;44) ühegi konkursitingimustele vastava kandidaadiga ei sõlmita töölepingut.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kadrina_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0272"
