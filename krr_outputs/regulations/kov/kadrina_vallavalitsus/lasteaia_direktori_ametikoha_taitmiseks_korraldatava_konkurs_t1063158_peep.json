    {
      "@id": "estleg:Reg_1063158_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Komisjon võtab otsused vastu üldjuhul avalikul hääletusel. Igal komisjoniliikmel on üks hääl.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063158_Par_5"
      },
      "rdfs:label": "§ 5 lg 2"
    },
    {
      "@id": "estleg:Reg_1063158_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Valituks osutub kandidaat, kelle poolt hääletab üle poole koosolekul osalevatest komisjoni liikmetest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063158_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
