    {
      "@id": "estleg:Reg_1063158_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Konkursi väljakuulutamise kohta avaldatakse teade Kadrina valla veebilehel, maakonnalehes ja vähemalt ühes otsinguportaalis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063158_Par_2"
