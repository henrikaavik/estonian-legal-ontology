      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjon on otsustusvõimeline, kui koosolekust võtab osa üle poole komisjoni liikmetest, sealhulgas komisjoni esimees.",
      "estleg:parentProvision": {
