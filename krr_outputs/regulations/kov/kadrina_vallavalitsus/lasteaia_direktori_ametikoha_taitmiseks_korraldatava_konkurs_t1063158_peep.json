    },
    {
      "@id": "estleg:Reg_1063158_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kui ükski kandidaat ei kogunud häälteenamust, võib komisjon korraldada kas kordushääletuse kõikide kandidaatide vahel, hääletamise kahe võrdselt enamhääli saanud kandidaadi vahel või teha kandidaatidele lisaülesannete voor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063158_Par_5"
      },
      "rdfs:label": "§ 5 lg 4"
    },
    {
      "@id": "estleg:Reg_1063158_Par_5_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Konkursil osalejate andmeid ei avaldata teistele kandidaatidele ega isikutele, kes valikuprotsessis ei osale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063158_Par_5"
      },
      "rdfs:label": "§ 5 lg 5"
