        }
      ]
    },
    {
      "@id": "estleg:Reg_1058688_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Valimisjaoskond nr 2 hääletamisruum asub valimispäeval Surju Rahvamajas (Sireli, Surju küla, Saarde vald, Pärnu maakond), esimesel päeval enne valimispäeva (laupäeval) Tihemetsa Huvi- ja Spordikeskuses (Valga mnt 21, Tihemetsa, Saarde vald, Pärnu maakond) ja teisel päeval enne valimispäeva (reedel) Tali raamatukogus (Kase tee 1, Tali küla, Saarde vald, Pärnu maakond).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058688_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:mentionsInstitution": [
