      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valimisjaoskond nr 1 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Kilingi-Nõmme klubis (Pärnu tn 73, Kilingi-Nõmme linn, Saarde vald, Pärnu maakond).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058688_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:mentionsInstitution": [
