    {
      "@id": "estleg:Reg_1050475_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Teenuse hind ja teenuse eest tasumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Sotsiaaltranspordi teenuse osutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Teenuse hinnad kehtestab Pärnumaa Ühistranspordikeskus ja kooskõlastab Saarde Vallavalitsus korraldusega. 2 (2) Juhuveo teenuse kasutaja tasub teenuse eest vastavalt sõidutsoonidele. 3 (3) Teenuse eest tasumisel arvestatakse marsruudil läbitud sõidutsoone teenuse saaja elukohast soovitud sihtkohta ja sealt tagasi elukohta. 4 (4) Teenuse kasutamisel mitme inimese poolt korraga tasub iga teenuse kasutaja enda eest eraldi, välja arvatud saatja.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenuse hinnad kehtestab Pärnumaa Ühistranspordikeskus ja kooskõlastab Saarde Vallavalitsus korraldusega. 2 (2) Juhuveo teenuse kasutaja tasub teenuse eest vastavalt sõidutsoonidele. 3 (3) Teenuse eest tasumisel arvestatakse marsruudil läbitud sõidutsoone teenuse saaja elukohast soovitud sihtkohta ja sealt tagasi elukohta. 4 (4) Teenuse kasutamisel mitme inimese poolt korraga tasub iga teenuse kasutaja enda eest eraldi, välja arvatud saatja. 5 (5) Teenuse taotleja õigustatud saatjalt ei võeta tasu teenuse eest. Saatjal on kohustus abistada teenuse saajat kogu teenuse osutamise vältel ning aidata teenuse saajat liikumisel hoonesisesest asukohast (kodust, haiglast vm) teenust osutava sõidukini. 6 (6) Teenuse kasutaja tasub teenuse eest Pärnumaa Ühistranspordikeskusele. 7 (7) Tasuta sotsiaaltranspordi teenuseid osutatakse üldjuhul madala sissetulekuga kõrvalabi vajavale isikule, kelle sissetulek on väiksem riigi poolt kehtestatud kahekordsest toimetulekupiirist ning kellel puuduvad seadusjärgsed ülalpidajad.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saarde_vallavalitsus"
      },
