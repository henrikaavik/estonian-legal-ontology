      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Toidukulu päevamaksumus sisaldab ühes päevas kolme toidukorra maksumust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062259_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
      "@id": "estleg:Reg_1062259_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Toidukulu arvestus",
        "@language": "et"
      },
      "estleg:sourceAct": "Saarde valla munitsipaallasteaedades toidukulu katmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lapse kuu toidukulu arvutatakse toidukulu päevamaksumuse korrutamisel lasteaias oldud päevade arvuga maksustatavas kalendrikuus. Lapse lasteaias oldud päevad on fikseeritud lasteaia poolt peetavas lapse kohaloleku tabelis. 2 (2) Lapse puudumisel lasteaiast tehakse toidukulu ümberarvestus alates teisest puudutud päevast. Kui lapse puudumispäev on eelnevalt teada ja vanem esitab avalduse direktorile vähemalt nädal aega enne, siis arvestatakse toidukulud alates esimesest puudumise päevast.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lapse kuu toidukulu arvutatakse toidukulu päevamaksumuse korrutamisel lasteaias oldud päevade arvuga maksustatavas kalendrikuus. Lapse lasteaias oldud päevad on fikseeritud lasteaia poolt peetavas lapse kohaloleku tabelis. 2 (2) Lapse puudumisel lasteaiast tehakse toidukulu ümberarvestus alates teisest puudutud päevast. Kui lapse puudumispäev on eelnevalt teada ja vanem esitab avalduse direktorile vähemalt nädal aega enne, siis arvestatakse toidukulud alates esimesest puudumise päevast. 3 (3) Toidukulu arvutamisel ei tehta mahaarvamisi toidukordade osas. 4 (4) Toidukulu päevamaksumuse kinnitab Saarde Vallavalitsus.",
      "estleg:enactedBy": {
