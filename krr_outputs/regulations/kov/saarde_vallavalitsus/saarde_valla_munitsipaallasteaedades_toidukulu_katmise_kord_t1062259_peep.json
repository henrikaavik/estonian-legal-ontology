      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lapse kuu toidukulu arvutatakse toidukulu päevamaksumuse korrutamisel lasteaias oldud päevade arvuga maksustatavas kalendrikuus. Lapse lasteaias oldud päevad on fikseeritud lasteaia poolt peetavas lapse kohaloleku tabelis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062259_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1062259_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lapse puudumisel lasteaiast tehakse toidukulu ümberarvestus alates teisest puudutud päevast. Kui lapse puudumispäev on eelnevalt teada ja vanem esitab avalduse direktorile vähemalt nädal aega enne, siis arvestatakse toidukulud alates esimesest puudumise päevast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062259_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1062259_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Toidukulu arvutamisel ei tehta mahaarvamisi toidukordade osas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062259_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1062259_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Toidukulu päevamaksumuse kinnitab Saarde Vallavalitsus.",
