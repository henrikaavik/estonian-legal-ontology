      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Saarde valla munitsipaallasteaedades toidukulu katmise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesolev kord reguleerib Saarde valla munitsipaallasteaedades (edaspidi lasteaed) toidukulu katmist vanema, eeskostja või hooldaja (edaspidi vanem) poolt. 2 (2) Toidukulu kaetakse ettemaksuna maksustatava kuu 25. kuupäevaks. 3 (3) Toidukulu päevamaksumus sisaldab ühes päevas kolme toidukorra maksumust.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesolev kord reguleerib Saarde valla munitsipaallasteaedades (edaspidi lasteaed) toidukulu katmist vanema, eeskostja või hooldaja (edaspidi vanem) poolt. 2 (2) Toidukulu kaetakse ettemaksuna maksustatava kuu 25. kuupäevaks. 3 (3) Toidukulu päevamaksumus sisaldab ühes päevas kolme toidukorra maksumust.",
      "estleg:enactedBy": {
