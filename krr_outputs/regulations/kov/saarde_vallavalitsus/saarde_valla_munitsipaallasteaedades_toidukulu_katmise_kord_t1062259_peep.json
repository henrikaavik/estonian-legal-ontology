      },
      "rdfs:label": "§ 2 lg 4"
    },
    {
      "@id": "estleg:Reg_1062259_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toidukulu katmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Saarde valla munitsipaallasteaedades toidukulu katmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lapse toidukulu lasteaias katab vanem. 2 (2) Lasteaed väljastab iga kuu 10. kuupäevaks vanemale maksuteate, kus on arvestatud eeloleva kuu toiduraha, ettemaks ja võlgnevus kokku. Vanemal on kohustus maksuteatel märgitud summa tasuda maksustatava kuu 25. kuupäevaks. 3 (3) Kui ühest perest käib lasteaias 2 last, katab teise lapse toidukulu 50% ulatuses Saarde vald.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lapse toidukulu lasteaias katab vanem. 2 (2) Lasteaed väljastab iga kuu 10. kuupäevaks vanemale maksuteate, kus on arvestatud eeloleva kuu toiduraha, ettemaks ja võlgnevus kokku. Vanemal on kohustus maksuteatel märgitud summa tasuda maksustatava kuu 25. kuupäevaks. 3 (3) Kui ühest perest käib lasteaias 2 last, katab teise lapse toidukulu 50% ulatuses Saarde vald. 4 (4) Alates kolmandast lapsest katab Saarde vald täielikult lapse toidukulu juhul, kui ühest perest käib ühes lasteaias kolm või enam last.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saarde_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
