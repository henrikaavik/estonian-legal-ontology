      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Maakorraldusseaduses sätestatud ülesannete delegeerimine Keila Linnavalitsusele",
      "estleg:sourceAct": "Maakorraldusega seotud ülesannete delegeerimine",
      "estleg:summary": "1 (1) Maakorraldusseaduse § 3 lõikes 1, § 18 lõikes 2, § 20 lõikes 2, § 21 lõigetes 1 ja 2, § 24 lõikes 4, § 25 lõikes 2, § 26 lõigetes 4 ja 6, § 261 lõigetes 2 ja 3, sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded delegeeritakse Keila Linnavalitsusele kui täitevorganile. Maakorraldusseaduse § 3 lõikes 1, § 18 lõikes 2, § 20 lõikes 2, § 21 lõigetes 1 ja 2, § 24 lõikes 4, § 25 lõikes 2, § 26 lõigetes 4 ja 6, § 261 lõigetes 2 ja 3, sätestatud kohaliku omavalitsuse ja koh",
      "estleg:legalText": "1 (1) Maakorraldusseaduse § 3 lõikes 1, § 18 lõikes 2, § 20 lõikes 2, § 21 lõigetes 1 ja 2, § 24 lõikes 4, § 25 lõikes 2, § 26 lõigetes 4 ja 6, § 261 lõigetes 2 ja 3, sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded delegeeritakse Keila Linnavalitsusele kui täitevorganile. Maakorraldusseaduse § 3 lõikes 1, § 18 lõikes 2, § 20 lõikes 2, § 21 lõigetes 1 ja 2, § 24 lõikes 4, § 25 lõikes 2, § 26 lõigetes 4 ja 6, § 261 lõigetes 2 ja 3, sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded delegeeritakse Keila Linnavalitsusele kui täitevorganile. 2 (2) Maakorraldusseaduse § 4 lõike 2 punktis 2, § 7 lõikes 4, § 17 lõikes 1, § 18 lõikes 1, § 19 lõigetes 4, 6 ja 7, § 20 lõikes 1, § 22 lõikes 3, § 28 lõikes 2 sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded delegeeritakse Keila Linnavalitsusele kui ametiasutusele. Maakorraldusseaduse § 4 lõike 2 punktis 2, § 7 lõikes 4, § 17 lõikes 1, § 18 lõikes 1, § 19 lõigetes 4, 6 ja 7, § 20 lõikes 1, § 22 lõikes 3, § 28 lõikes 2 sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded delegeeritakse Keila Linnavalitsusele kui ametiasutusele.",
