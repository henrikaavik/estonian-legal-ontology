      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Keila linna üldhariduskoolide (edaspidi kool) statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks riigieelarve vahenditest ette nähtud toetuse (edaspidi koolilõuna toetus) kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Keila linna üldhariduskoolide (edaspidi kool) statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks riigieelarve vahenditest ette nähtud toetuse (edaspidi koolilõuna toetus) kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_keila_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0296"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057291_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1057291_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1057291_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Keila linna üldhariduskoolide (edaspidi kool) statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks riigieelarve vahenditest ette nähtud toetuse (edaspidi koolilõuna toetus) kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1057291_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1057291_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna maksumuse kehtestamine ja kulude katmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Koolilõuna maksumuse kehtestab Keila linnavalitsus korraldusega. 2 (2) Riigieelarvest Keila linnale eraldatud koolilõuna toetust kasutatakse koolide statsionaarses õppes 1.-12. klassi õpilaste koolilõuna kulude katmiseks. 3 (3) Keila linna eelarves nähakse ette vahendid käesoleva paragrahvi lõikes 2 nimetatud õpilaste koolilõuna maksumuse katmiseks ulatuses, mis ületab riigieelarvest eraldatud rahalistest vahenditest kaetavat osa. 4 (4) Waldorfkooli Läte 1.-9.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Koolilõuna maksumuse kehtestab Keila linnavalitsus korraldusega. 2 (2) Riigieelarvest Keila linnale eraldatud koolilõuna toetust kasutatakse koolide statsionaarses õppes 1.-12. klassi õpilaste koolilõuna kulude katmiseks. 3 (3) Keila linna eelarves nähakse ette vahendid käesoleva paragrahvi lõikes 2 nimetatud õpilaste koolilõuna maksumuse katmiseks ulatuses, mis ületab riigieelarvest eraldatud rahalistest vahenditest kaetavat osa. 4 (4) Waldorfkooli Läte 1.-9. klassi rahvastikuregistri andmetel Keila linna õpilaste Keila linna eelarvest makstava koolilõuna toetuse suurus ühe õpilase kohta on võrdne munitsipaalkooli õpilastele makstava toetusega. 5 (5) Toitlustusteenuse osutajale kaetakse koolilõuna kulud riigihanke tulemusena toitlustusteenuse osutamiseks Keila linnaga sõlmitud lepingu alusel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_keila_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
