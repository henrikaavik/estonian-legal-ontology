      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koolilõuna maksumuse kehtestab Keila linnavalitsus korraldusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1057291_Par_2"
