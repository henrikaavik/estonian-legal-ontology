    },
    {
      "@id": "estleg:Reg_1033470_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Keila Linnavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametikohad, mida täitvate ametnike ülesandeks on käesoleva paragrahvi lõigetes 1 ja 2 nimetatud ülesannete täitmine.",
      "estleg:parentProvision": {
