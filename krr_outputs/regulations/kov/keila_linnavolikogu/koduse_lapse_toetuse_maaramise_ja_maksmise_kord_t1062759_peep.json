          "@id": "estleg:Reg_1062759_Par_4_Lg_4"
        }
      ],
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_keila_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062759_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toetuse taotleja esitab linnavalitsusele vormikohase taotluse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062759_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_keila_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062759_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenistusel on vajadusel õigus nõuda taotlejalt täiendavaid andmeid või dokumente, millest taotlejat informeeritakse taotluse vastuvõtmisel või kirjalikult viie tööpäeva jooksul pärast taotluse vastuvõtmist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062759_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1062759_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Koduse lapse toetuse taotlus esitatakse linnavalitsusele toetuse maksmisele eelneva kuu jooksul.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062759_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_keila_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062759_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Taotlus jäetakse rahuldamata, kui kümne tööpäeva jooksul taotluse esitamisest või kirjaliku teate saatmisest ei ole esitatud täiendavalt nõutud andmeid või dokumente.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062759_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
    {
      "@id": "estleg:Reg_1062759_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Toetuse määramine ja maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koduse lapse toetuse määramise ja maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Otsuse toetuse andmise või sellest keeldumise kohta teeb teenistus 15 tööpäeva jooksul, arvates toetuse taotlemiseks viimase vajaliku dokumendi saamise päevast. 2 (2) Kui taotlust ei rahuldata, saadab teenistus taotlejale põhjendatud otsuse taotluse mitterahuldamise kohta viie tööpäeva jooksul otsuse tegemisest. 3 (3) Toetus kantakse üle taotluses märgitud arvelduskontole kord kuus. 4 (4) Linnavalitsusel on õigus teha põhjendatud juhtudel toetuse taotleja kasuks erandeid.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Otsuse toetuse andmise või sellest keeldumise kohta teeb teenistus 15 tööpäeva jooksul, arvates toetuse taotlemiseks viimase vajaliku dokumendi saamise päevast. 2 (2) Kui taotlust ei rahuldata, saadab teenistus taotlejale põhjendatud otsuse taotluse mitterahuldamise kohta viie tööpäeva jooksul otsuse tegemisest. 3 (3) Toetus kantakse üle taotluses märgitud arvelduskontole kord kuus. 4 (4) Linnavalitsusel on õigus teha põhjendatud juhtudel toetuse taotleja kasuks erandeid.",
