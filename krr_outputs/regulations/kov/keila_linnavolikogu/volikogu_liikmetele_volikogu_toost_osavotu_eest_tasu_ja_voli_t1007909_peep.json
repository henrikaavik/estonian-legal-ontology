      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Tasu väljamaksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu liikmetele volikogu tööst osavõtu eest tasu ja volikogu ülesannete täitmisel tehtud kulutuste eest hüvitise suuruse ja maksmise korra kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Tasu makstakse välja linna eelarves selleks ettenähtud summadest. 2 (2) Tasudelt arvestatakse üksikisiku tulumaksu. 3 (3) Linnavalitsuse raamatupidamisüksus maksab tasud välja igakuiselt tasu saamise õiguse tekkimisele järgneva kalendrikuu 10-ndaks kuupäevaks, v.a. linnavolikogu alatiste komisjonide liikmete tasud, mida makstakse välja 1 kord kvartalis. RT IV 2024-04-03 19 403042024019 2024-04-06 rakendatakse 9.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Tasu makstakse välja linna eelarves selleks ettenähtud summadest. 2 (2) Tasudelt arvestatakse üksikisiku tulumaksu. 3 (3) Linnavalitsuse raamatupidamisüksus maksab tasud välja igakuiselt tasu saamise õiguse tekkimisele järgneva kalendrikuu 10-ndaks kuupäevaks, v.a. linnavolikogu alatiste komisjonide liikmete tasud, mida makstakse välja 1 kord kvartalis. RT IV 2024-04-03 19 403042024019 2024-04-06 rakendatakse 9. veebruarist 2024 4 (4) Tasud kantakse tasusaajate poolt näidatud pangaarvetele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_keila_linnavolikogu"
      },
