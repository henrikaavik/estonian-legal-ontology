      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Hädaolukorra seaduses kohaliku omavalitsuse üksuse ülesannete delegeerimine linnavalitsusele",
      "estleg:sourceAct": "Hädaolukorra seadusest tulenevate ülesannete delegeerimine",
      "estleg:summary": "Hädaolukorra seaduse § 36 lõikes 4 ja § 37 lõikes 2 kohaliku omavalitsuse üksuse ja selle organi pädevusse antud küsimuste lahendamine delegeeritakse Keila linnavalitsusele kui täitevorganile.",
      "estleg:legalText": "Hädaolukorra seaduse § 36 lõikes 4 ja § 37 lõikes 2 kohaliku omavalitsuse üksuse ja selle organi pädevusse antud küsimuste lahendamine delegeeritakse Keila linnavalitsusele kui täitevorganile. Hädaolukorra seaduse § 36 lõikes 4 ja § 37 lõikes 2 kohaliku omavalitsuse üksuse ja selle organi pädevusse antud küsimuste lahendamine delegeeritakse Keila linnavalitsusele kui täitevorganile.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_keila_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
