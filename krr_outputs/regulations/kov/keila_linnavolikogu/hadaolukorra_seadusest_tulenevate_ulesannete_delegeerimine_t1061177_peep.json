    {
      "@id": "estleg:Reg_1061177_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1061177",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Hädaolukorra seaduses kohaliku omavalitsuse üksuse ülesannete delegeerimine ametiasutusele",
      "estleg:sourceAct": "Hädaolukorra seadusest tulenevate ülesannete delegeerimine",
      "estleg:summary": "1 (1) Hädaolukorra seaduses ja selle alusel antud õigusaktides sätestatud kohaliku omavalitsuse üksuse, selle organi ja elutähtsa teenuse toimepidevust korraldava asutuse pädevusse antud küsimuste lahendamine delegeeritakse Keila Linnavalitsusele kui ametiasutusele (välja arvatud käesoleva määruse § 1 toodud ülesanded). Hädaolukorra seaduses ja selle alusel antud õigusaktides sätestatud kohaliku omavalitsuse üksuse, selle organi ja elutähtsa teenuse toimepidevust korraldava asutuse pädevusse ant",
      "estleg:legalText": "1 (1) Hädaolukorra seaduses ja selle alusel antud õigusaktides sätestatud kohaliku omavalitsuse üksuse, selle organi ja elutähtsa teenuse toimepidevust korraldava asutuse pädevusse antud küsimuste lahendamine delegeeritakse Keila Linnavalitsusele kui ametiasutusele (välja arvatud käesoleva määruse § 1 toodud ülesanded). Hädaolukorra seaduses ja selle alusel antud õigusaktides sätestatud kohaliku omavalitsuse üksuse, selle organi ja elutähtsa teenuse toimepidevust korraldava asutuse pädevusse antud küsimuste lahendamine delegeeritakse Keila Linnavalitsusele kui ametiasutusele (välja arvatud käesoleva määruse § 1 toodud ülesanded). 2 (2) Keila Linnavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametikohad, mida täitvate ametnike ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine. Keila Linnavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametikohad, mida täitvate ametnike ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_keila_linnavolikogu"
      },
