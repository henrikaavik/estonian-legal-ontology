      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Komisjoni ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Järva valla kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "Komisjon: 1 1) koordineerib kriisireguleerimist vallas; 2 2) esitab regionaalsele kriisikomisjonile kord aastas kokkuvõtte valla kriisikomisjoni tegevusest ning järgmise aasta tööplaani; 3 3) täidab muid seadusest ja tema põhimäärusest tulenevaid ülesandeid.",
        "@language": "et"
      },
      "estleg:legalText": "Komisjon: 1 1) koordineerib kriisireguleerimist vallas; 2 2) esitab regionaalsele kriisikomisjonile kord aastas kokkuvõtte valla kriisikomisjoni tegevusest ning järgmise aasta tööplaani; 3 3) täidab muid seadusest ja tema põhimäärusest tulenevaid ülesandeid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jarva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0255"
