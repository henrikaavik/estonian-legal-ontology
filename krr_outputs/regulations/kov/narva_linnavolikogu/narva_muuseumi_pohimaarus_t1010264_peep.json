      }
    },
    {
      "@id": "estleg:Reg_1010264_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Narva Muuseumi tulude allikaks on laekumised kohalikust eelarvest ja teistest seaduslikest allikatest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1010264_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1010264_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Muuseum kasutab rahalisi vahendeid vastavalt rahastajate poolt esitatud tingimustele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1010264_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1010264_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Narva Muuseumi vara kasutamine toimub vastatavalt EV seadusandlusele, linnavara eeskirjadele ja käesolevale põhimäärusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1010264_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
