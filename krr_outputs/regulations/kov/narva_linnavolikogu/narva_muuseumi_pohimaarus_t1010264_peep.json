      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Narva Muuseum on asutus, mille finantseerimine toimub Narva linnaeelarvest Kultuuriosakonna kaudu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1010264_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
