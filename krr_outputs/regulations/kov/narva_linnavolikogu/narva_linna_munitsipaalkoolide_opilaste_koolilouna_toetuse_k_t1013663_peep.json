      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Narva linna munitsipaalkoolide õpilaste koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega sätestatakse Narva linna munitsipaalkoolide õpilaste koolilõuna kulude riigi- ja linnaeelarve vahenditest katmise tingimused ja kord ning kehtestatakse koolilõuna tegelikku maksumust.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega sätestatakse Narva linna munitsipaalkoolide õpilaste koolilõuna kulude riigi- ja linnaeelarve vahenditest katmise tingimused ja kord ning kehtestatakse koolilõuna tegelikku maksumust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_narva_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0511"
      },
