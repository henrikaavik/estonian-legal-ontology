      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "12",
      "estleg:legalText": "(12) Koolilõuna vastavust tervisekaitsenõuetele kontrollib Narva Linnaarstiteenistus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013663_Par_2"
