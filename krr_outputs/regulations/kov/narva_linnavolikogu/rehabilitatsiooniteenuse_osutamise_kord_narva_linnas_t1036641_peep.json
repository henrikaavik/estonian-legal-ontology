    },
    {
      "@id": "estleg:Reg_1036641_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Teenuse maksumust kinnitab Narva Linnavalitsus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036641_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1036641_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenuse kulud kaetakse Narva linna eelarvest ja isiku omaosalusest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036641_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1036641_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Teenuse saajad tasuvad omaosaluse järgmiselt: 1) vanaduspensionärid tasuvad 20% teenuse maksumusest; 2) töövõimetuspensionärid ja vähenenud töövõimega isikud tasuvad 10% teenuse maksumusest; 3) Tšernobõli tuumakatastroofi likvideerijad tasuvad 5% teenuse maksumusest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036641_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1036641_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Pensioni saavad või vähenenud töövõimega Tšernobõli tuumakatastroofi likvideerijad tasuvad 5% teenuse maksumusest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036641_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
    {
      "@id": "estleg:Reg_1036641_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Teenuse osutamiseks linnaeelarvest eraldatud vahendite üle peab arvestust Sotsiaalabiamet.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036641_Par_4"
      },
      "rdfs:label": "§ 4 lg 5"
    },
