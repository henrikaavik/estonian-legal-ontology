      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Eraldatava toetuse konkreetne suurus oleneb eelarve vastavas valdkonnas rahaliste vahendite olemasolust ja finantseerimise vajaduse põhjendatusest.",
      "estleg:parentProvision": {
