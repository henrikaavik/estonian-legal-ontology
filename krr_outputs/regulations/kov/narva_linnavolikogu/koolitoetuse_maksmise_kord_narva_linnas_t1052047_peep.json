      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolitoetuse maksmise kord Narva linnas",
      "estleg:summary": {
        "@value": "1 (1) Määrus sätestab Narva linnas esimesse klassi minevale lapsele ühekordse koolitoetuse (edaspidi toetus) maksmise tingimused ja korra. 2 (2) Toetuse maksmise eesmärgiks on toetada peresid laste kasvatamisel. 3 (3) Toetus makstakse Narva linna eelarves selleks ettenähtud vahenditest. 4 (4) Toetuse määramist ja maksmist korraldab ning linnaeelarvest eraldatud vahendite üle peab arvestust Narva Linna Sotsiaalabiamet (edaspidi Sotsiaalabiamet).",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrus sätestab Narva linnas esimesse klassi minevale lapsele ühekordse koolitoetuse (edaspidi toetus) maksmise tingimused ja korra. 2 (2) Toetuse maksmise eesmärgiks on toetada peresid laste kasvatamisel. 3 (3) Toetus makstakse Narva linna eelarves selleks ettenähtud vahenditest. 4 (4) Toetuse määramist ja maksmist korraldab ning linnaeelarvest eraldatud vahendite üle peab arvestust Narva Linna Sotsiaalabiamet (edaspidi Sotsiaalabiamet).",
