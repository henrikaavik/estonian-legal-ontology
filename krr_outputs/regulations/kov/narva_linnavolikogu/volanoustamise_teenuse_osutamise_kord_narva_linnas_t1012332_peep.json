        "@language": "et"
      },
      "estleg:sourceAct": "Võlanõustamise teenuse osutamise kord Narva linnas",
      "estleg:summary": {
        "@value": "Isik, kes leiab, et teenuse osutamisel või teenusest keeldumisel on rikutud tema õigusi või piiratud tema vabadusi, võib esitada vaide seaduses sätestatud korras.",
        "@language": "et"
      },
      "estleg:legalText": "Isik, kes leiab, et teenuse osutamisel või teenusest keeldumisel on rikutud tema õigusi või piiratud tema vabadusi, võib esitada vaide seaduses sätestatud korras.",
