    {
      "@id": "estleg:Reg_1012332_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teenuse taotlemine ja osutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Võlanõustamise teenuse osutamise kord Narva linnas",
      "estleg:summary": {
        "@value": "1 (1) Teenuse saamiseks pöördub taotleja Sotsiaalabiametisse kirjaliku vormikohase taotlusega (lisa 1), millele lisab vajadusel asjasse puudutavate dokumentide koopiad. 2 (2) Teenus osutatakse lähtudes konkreetsest võlasituatsioonist, kuhu isik või perekond sattunud on. 3 (3) Teenuse osutamise käigus võlanõustaja: 1 1) selgitab välja võlgnevusse sattumise põhjused; 2 2) hindab võlanõuete õiguspärasust; 3 3) hindab võlgniku abivajadust, sealhulgas määratleb tema rahaliste kohustuste hulga ja…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenuse saamiseks pöördub taotleja Sotsiaalabiametisse kirjaliku vormikohase taotlusega (lisa 1), millele lisab vajadusel asjasse puudutavate dokumentide koopiad. 2 (2) Teenus osutatakse lähtudes konkreetsest võlasituatsioonist, kuhu isik või perekond sattunud on. 3 (3) Teenuse osutamise käigus võlanõustaja: 1 1) selgitab välja võlgnevusse sattumise põhjused; 2 2) hindab võlanõuete õiguspärasust; 3 3) hindab võlgniku abivajadust, sealhulgas määratleb tema rahaliste kohustuste hulga ja mahu ning ressursse võlgnevuse kõrvaldamiseks; 4 4) aitab isikul planeerida tema rahalisi vahendeid tekkinud ja tekkivate rahaliste kohustuste täitmiseks ning võlgnevuse kõrvaldamiseks; 5 5) abistab ja nõustab isikut võlgnevuse kõrvaldamiseks sobivate lahenduste väljaselgitamisel ja suhtlemisel võlausaldajatega; 6 6) teeb isiku nõusolekul koostööd füüsiliste ja juriidiliste isikutega, kelle ees isikul on rahaline kohustus täitmata; 7 7) abistab maksegraafikute koostamisel ja täitmisel; 8 8) nõustab ja juhendab isikut, kuidas vältida uute võlgnevuste tekkimist. 4 (4) Võlanõustajal on õigus teenuse osutamisest keelduda juhul, kui isik teadlikult esitab valeandmeid või korduvalt ei täida võlanõustajaga saavutatuid kokkuleppeid.",
