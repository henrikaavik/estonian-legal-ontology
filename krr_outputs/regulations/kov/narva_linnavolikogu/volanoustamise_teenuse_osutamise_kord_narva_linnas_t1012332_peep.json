        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1012332_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Võlanõustajal on õigus teenuse osutamisest keelduda juhul, kui isik teadlikult esitab valeandmeid või korduvalt ei täida võlanõustajaga saavutatuid kokkuleppeid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012332_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
