      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Eluruumi üüri piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluruumi üüri piirmäärade kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Kehtestada Saarde valla munitsipaaleluruumide ja sotsiaaleluruumide üüri alumiseks piirhinnaks 0,70 eurot ja ülemiseks piirhinnaks 5,00 eurot eluruumi üldpinna ruutmeetri kohta ühes kalendrikuus. 2 (2) Käesoleva määrusega kehtestatud üüri piirmäärad ei sisalda kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muru niitmise, lumetõrje, maja üldelektri, korteriühistu makse jt) kommunaalteenuste eest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kehtestada Saarde valla munitsipaaleluruumide ja sotsiaaleluruumide üüri alumiseks piirhinnaks 0,70 eurot ja ülemiseks piirhinnaks 5,00 eurot eluruumi üldpinna ruutmeetri kohta ühes kalendrikuus. 2 (2) Käesoleva määrusega kehtestatud üüri piirmäärad ei sisalda kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muru niitmise, lumetõrje, maja üldelektri, korteriühistu makse jt) kommunaalteenuste eest. 3 (3) Delegeerida eluruumi üüri diferentseerimine ja üüripiirmäärade kehtestamine Saarde Vallavalitsusele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saarde_vallavolikogu"
      },
