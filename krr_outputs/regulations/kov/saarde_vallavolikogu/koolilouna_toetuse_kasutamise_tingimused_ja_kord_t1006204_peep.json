      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrus kehtestab riigieelarve ja Saarde valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja korra Saarde valla üldhariduskoolides (edaspidi kool).",
        "@language": "et"
      },
      "estleg:legalText": "Määrus kehtestab riigieelarve ja Saarde valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja korra Saarde valla üldhariduskoolides (edaspidi kool).",
      "estleg:enactedBy": {
