      "rdfs:label": {
        "@value": "§ 2. Planeerimisseaduse ja ehitusseadustikuga kohaliku omavalitsuse üksuse pädevusse antud küsimuste delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pädevuse delegeerimine",
      "estleg:summary": {
        "@value": "1(1)Delegeerida ehitusseadustiku § 15 lõikes 4, § 28, § 35 lõikes 2, § 39 lõikes 1, § 47 lõikes 3, § 51 lõikes 1, § 616 lõike 1 punktis 3, § 617 lõikes 1 ja lõike 2 punktis 3, § 95 lõikes 3, § 99 lõikes 2, § 100, § 101 lõikes 1, § 105 lõikes 1 ja 3, § 106 lõikes 1, § 107 lõikes 1, § 110 lõikes 1, § 111 lõikes 1, § 124 lõikes 1 ja § 130 lõikes 2 kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Kastre Vallavalitsusele.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Delegeerida ehitusseadustiku § 15 lõikes 4, § 28, § 35 lõikes 2, § 39 lõikes 1, § 47 lõikes 3, § 51 lõikes 1, § 616 lõike 1 punktis 3, § 617 lõikes 1 ja lõike 2 punktis 3, § 95 lõikes 3, § 99 lõikes 2, § 100, § 101 lõikes 1, § 105 lõikes 1 ja 3, § 106 lõikes 1, § 107 lõikes 1, § 110 lõikes 1, § 111 lõikes 1, § 124 lõikes 1 ja § 130 lõikes 2 kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Kastre Vallavalitsusele. 2(2)Delegeerida planeerimisseaduse § 4 lõikes 1, § 74 lõikes 8, § 76 lõikes 1, § 95 lõikes 6, § 124 lõikes 10, § 125 lõikes 5 ja 6, § 126 lõikes 5, § 128 lõikes 1, ning § 142 lõikes 8 kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Kastre Vallavalitsusele. 3(3)Delegeerida ehitusseadustiku ja planeerimisseaduse rakendamise seaduse § 27 lõikes 1 ja 4 ning § 29 lõikes 4, 7 ja 8 kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Kastre Vallavalitsusele.",
