      "rdfs:label": {
        "@value": "§ 1. Sotsiaalhoolekande seadusega kohaliku omavalitsuse üksusele pandud ülesannete täitmise delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Sotsiaalhoolekande seaduse, lastekaitseseaduse, sotsiaalseadustiku üldosa seaduse ja riigilõivuseadusega kohaliku omavalitsuse üksuse pädevusse antud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1(1)Delegeerida sotsiaalhoolekande seaduses sätestatud kohaliku omavalitsuse üksuse pädevusse antud ülesannete täitmine Kastre Vallavalitsusele, välja arvatud sotsiaalhoolekande seaduse § 14, § 133 lõike 6 ja § 156 lõike 32 alusel vastavate kordade kehtestamine. 2(2)Vallavalitsusel on õigus määrata struktuuriüksus või ametnikud, kes täidavad käesoleva määruse § 1 lõikes 1 sätestatud ülesandeid.",
        "@language": "et"
      },
