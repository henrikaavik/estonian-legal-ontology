    },
    {
      "@id": "estleg:Reg_1044534_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Kastre vallale riigieelarvest ja Kastre valla eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044534_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1044534_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Kastre valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2(2)Kastre valla eelarves nähakse vajadusel ette täiendavad rahalised vahendid munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna maksumuse katmiseks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Kastre valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2(2)Kastre valla eelarves nähakse vajadusel ette täiendavad rahalised vahendid munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna maksumuse katmiseks. 3(3)Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarveliste vahendite sihipärase kasutamise eest vastutab kooli direktor. 4(4)Koolilõuna maksumuse kehtestab Kastre Vallavalitsus. 5(5)Riigieelarvest Kastre vallale eraldatud koolilõuna toetuseks ette nähtud raha kasutamise üle peetakse raamatupidamises eraldi arvestust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kastre_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
