      "estleg:legalText": "(1) Volikogu esimehele ja aseesimehel makstakse tasu üks kord kuus kirjalikult teatatud isiklikule pangakontole.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040974_Par_7"
      },
      "rdfs:label": "§ 7 lg 1"
    },
    {
      "@id": "estleg:Reg_1040974_Par_7_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Volikogu liikmetele ja volikogu komisjoni liikmele makstakse tasu toimunud koosoleku eest üks kord kuus kirjalikult teatatud isiklikule pangakontole.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040974_Par_7"
      },
      "rdfs:label": "§ 7 lg 2"
    },
    {
      "@id": "estleg:Reg_1040974_Par_7_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Volikogu liikmetele ja volikogu komisjoni liikmele tasu arvestamise ja väljamaksete tegemise aluseks on volikogu istungite ja komisjonide koosolekute protokollid ja registreerimislehed ning väljamaksed tehakse üldjuhul jooksva kuu viimasel tööpäeval.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040974_Par_7"
      },
      "rdfs:label": "§ 7 lg 3"
    },
