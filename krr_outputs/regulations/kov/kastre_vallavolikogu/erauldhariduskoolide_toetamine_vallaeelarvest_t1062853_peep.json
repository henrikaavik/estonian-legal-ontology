    {
      "@id": "estleg:Reg_1062853_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Toetuse andmine ja määr",
        "@language": "et"
      },
      "estleg:sourceAct": "Eraüldhariduskoolide toetamine vallaeelarvest",
      "estleg:summary": {
        "@value": "1 (1) Erakooli pidajale makstakse õppekoha tegevuskulude katmise toetust, kui on täidetud käesoleva määruse § 3 sätestatud tingimused. 2 (2) Toetust makstakse valla eelarvest erakooli pidajale toetatava õpilase eest kuumääras, mis on Vabariigi Valitsuse poolt igaks kalendriaastaks kehtestatud õppekoha tegevuskulu piirmäära ja riigi poolt rahastatava tegevuskulu vahe.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Erakooli pidajale makstakse õppekoha tegevuskulude katmise toetust, kui on täidetud käesoleva määruse § 3 sätestatud tingimused. 2 (2) Toetust makstakse valla eelarvest erakooli pidajale toetatava õpilase eest kuumääras, mis on Vabariigi Valitsuse poolt igaks kalendriaastaks kehtestatud õppekoha tegevuskulu piirmäära ja riigi poolt rahastatava tegevuskulu vahe. 3 (3) Kui õpilane alustab või lõpetab erakoolis õppimise kalendrikuu kestel, antakse erakooli pidajale toetus päevamäära alusel, lähtudes päevade arvust, mil õpilane vastavas kuus õppekohta kasutas. 4 (4) Erakooli toetus makstakse välja erakooli pidaja esitatud arve alusel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kastre_vallavolikogu"
      },
