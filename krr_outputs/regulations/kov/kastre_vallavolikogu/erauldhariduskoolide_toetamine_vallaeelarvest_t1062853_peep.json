      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Eraüldhariduskool",
        "@language": "et"
      },
      "estleg:sourceAct": "Eraüldhariduskoolide toetamine vallaeelarvest",
      "estleg:summary": {
        "@value": "Valla eelarvest toetatakse erakooli pidajat, kui on täidetud järgmised tingimused: 1 1) erakool tegutseb Eesti Vabariigis; 2 2) erakooli pidaja ja tema tegevus vastab õigusaktides esitatud nõuetele; 3 3) erakooli pidajal on kehtiv tegevusluba; 4 4) erakooli pidajal puudub riiklike ja kohalike maksude või maksete võlgnevus; 5 5) erakoolis õppiva õpilase (edaspidi õpilane) ja ühe tema seadusliku esindaja (edaspidi vanem) elukoha andmetena on Eesti rahvastikuregistrisse kantud Kastre vald; 6 6)…",
        "@language": "et"
      },
      "estleg:legalText": "Valla eelarvest toetatakse erakooli pidajat, kui on täidetud järgmised tingimused: 1 1) erakool tegutseb Eesti Vabariigis; 2 2) erakooli pidaja ja tema tegevus vastab õigusaktides esitatud nõuetele; 3 3) erakooli pidajal on kehtiv tegevusluba; 4 4) erakooli pidajal puudub riiklike ja kohalike maksude või maksete võlgnevus; 5 5) erakoolis õppiva õpilase (edaspidi õpilane) ja ühe tema seadusliku esindaja (edaspidi vanem) elukoha andmetena on Eesti rahvastikuregistrisse kantud Kastre vald; 6 6) õpilane õpib põhikoolis; 7 7) õpilase eest ei maksa riik õppekoha tegevuskulude katmiseks toetust täies ulatuses; 8 8) õpilase andmed peavad olema kantud Eesti Hariduse Infosüsteemi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kastre_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
