      "estleg:summary": {
        "@value": "Erakooli pidaja võib käesoleva määruse kohaselt saadud toetust kasutada erakooli tegevuskulude katteks.",
        "@language": "et"
      },
      "estleg:legalText": "Erakooli pidaja võib käesoleva määruse kohaselt saadud toetust kasutada erakooli tegevuskulude katteks.",
