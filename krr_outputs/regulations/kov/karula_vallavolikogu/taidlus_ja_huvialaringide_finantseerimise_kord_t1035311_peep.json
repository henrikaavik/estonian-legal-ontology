        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Taidlus- ja huviringide tegevuse finantseerimise eesmärgiks on toetada ja arendada valla elanike tegevusi vaba aja sisustamisel.",
      "estleg:parentProvision": {
