        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Konkursi luhtumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Ametnike värbamise ja valiku kord",
      "estleg:summary": {
        "@value": "1(1)Konkurss loetakse luhtunuks, kui:11) sellel osalemiseks ei esitatud ühtegi taotlust;22) ametisse nimetamise õigust omav isik loobus ametikohale asumise ettepaneku tegemisest põhjusel, et ühegi kandidaadi haridus, töökogemus, teadmised ja oskused ei vastanud teenistusülesannete täitmiseks kehtestatud nõuetele määral, mis võimaldaks tal ametiülesandeid täita parimal võimalikul viisil.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Konkurss loetakse luhtunuks, kui:11) sellel osalemiseks ei esitatud ühtegi taotlust;22) ametisse nimetamise õigust omav isik loobus ametikohale asumise ettepaneku tegemisest põhjusel, et ühegi kandidaadi haridus, töökogemus, teadmised ja oskused ei vastanud teenistusülesannete täitmiseks kehtestatud nõuetele määral, mis võimaldaks tal ametiülesandeid täita parimal võimalikul viisil. 2(2)Konkursi luhtumine otsustatakse kirjalikult 120 kalendripäeva jooksul pärast konkursil osalemiseks määratud tähtaega. Kui nimetatud tähtaja jooksul ei ole konkursi alusel ühtegi isikut ametikohale nimetatud, loetakse konkurss automaatselt luhtunuks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0284"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1040852_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1040852_Par_6_Lg_1"
        },
        {
          "@id": "estleg:Reg_1040852_Par_6_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1040852_Par_6_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Konkurss loetakse luhtunuks, kui: 1) sellel osalemiseks ei esitatud ühtegi taotlust; 2) ametisse nimetamise õigust omav isik loobus ametikohale asumise ettepaneku tegemisest põhjusel, et ühegi kandidaadi haridus, töökogemus, teadmised ja oskused ei vastanud teenistusülesannete täitmiseks kehtestatud nõuetele määral, mis võimaldaks tal ametiülesandeid täita parimal võimalikul viisil.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040852_Par_6"
      },
      "rdfs:label": "§ 6 lg 1",
      "estleg:itemNumber": [
        "1",
        "2"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1040852_Par_6_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Konkursi luhtumine otsustatakse kirjalikult 120 kalendripäeva jooksul pärast konkursil osalemiseks määratud tähtaega. Kui nimetatud tähtaja jooksul ei ole konkursi alusel ühtegi isikut ametikohale nimetatud, loetakse konkurss automaatselt luhtunuks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040852_Par_6"
      },
      "rdfs:label": "§ 6 lg 2",
      "estleg:targetGroup": [
