    },
    {
      "@id": "estleg:Reg_1040852_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Avaldatud konkursikuulutus peab sisaldama: 1) ametiasutuse ja ametikoha nimetust; 2) teenistusülesannete lühikirjeldust; 3) kandidaadile esitatavaid nõudeid; 4) konkursil osalemiseks esitatavaid dokumente ja nende esitamise tähtaega; 5) osalise koormusega töötamise korral koormuse suurust; 6) määratud ajaks ametikohale nimetamise korral teenistustähtaega; 7) ametikoha asukohta; 8) kontaktisiku kontaktandmeid.",
