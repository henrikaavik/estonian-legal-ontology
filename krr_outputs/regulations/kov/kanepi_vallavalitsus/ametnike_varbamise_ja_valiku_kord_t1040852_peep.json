      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Konkursikuulutuse (edaspidi kuulutus) avaldab ametiasutus vaba ametikoha ametijuhendi ja/või teenistuskohale kehtestatud nõuete alusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040852_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:targetGroup": [
