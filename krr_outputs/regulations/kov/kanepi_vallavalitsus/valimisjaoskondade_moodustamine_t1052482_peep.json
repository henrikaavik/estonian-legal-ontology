    },
    {
      "@id": "estleg:Reg_1052482_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Valimisjaoskond nr 2 hääletamisruum asub esimesel päeval enne valimispäeva Põlgaste raamatukogu-külakeskuses aadressil Saia tee 2, Põlgaste küla, Kanepi vald, Põlva maakond;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052482_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:mentionsInstitution": [
