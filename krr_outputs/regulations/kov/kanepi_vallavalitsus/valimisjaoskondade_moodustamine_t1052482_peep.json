    {
      "@id": "estleg:Reg_1052482_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 1 hääletamist vajadusel kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052482_Par_3"
