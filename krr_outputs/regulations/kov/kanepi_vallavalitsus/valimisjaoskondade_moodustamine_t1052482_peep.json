        }
      ]
    },
    {
      "@id": "estleg:Reg_1052482_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Valimisjaoskond nr 2 hääletamisruum asub teisel päeval enne valimispäeva ja valimispäeval Krootuse külakeskuses (endine Kõlleste vallamaja) aadressil Pargi tn 3, Krootuse küla, Kanepi vald, Põlva maakond;",
      "estleg:parentProvision": {
