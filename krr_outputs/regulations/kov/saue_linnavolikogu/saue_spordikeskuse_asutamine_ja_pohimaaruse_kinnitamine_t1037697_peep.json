      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega asutatakse Saue Linnavalitsuse hallatav asutus Saue Spordikeskus alates 01.02.2017. a.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1037697_Par_1"
