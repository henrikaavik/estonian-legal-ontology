      "@id": "estleg:Reg_1061617_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 1 hääletamist asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061617_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1061617_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kodus hääletamist korraldavad kõik määruse paragrahvis 2 nimetatud valimisjaoskonnad.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061617_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
