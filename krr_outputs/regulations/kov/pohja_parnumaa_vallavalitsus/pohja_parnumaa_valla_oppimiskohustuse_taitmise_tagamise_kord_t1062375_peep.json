    {
      "@id": "estleg:Reg_1062375_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Juhtumi algatamine kohalikus omavalitsuses väljalangemisohus oleva õpilase kohta",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhja-Pärnumaa valla õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "Põhja-Pärnumaa vallas vastutab õppimiskohustuslike laste õppes osalemise igakuise seire eest haridusvaldkonda kureeriva struktuuriüksuse ametnik, kes: 1 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) algatab Eesti Hariduse Infosüsteemis juhtumimenetluse ja teavitab kooli ning lapsevanemaid juhtumimenetluse alustamisest; 3 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse täitmist toetavate…",
        "@language": "et"
      },
      "estleg:legalText": "Põhja-Pärnumaa vallas vastutab õppimiskohustuslike laste õppes osalemise igakuise seire eest haridusvaldkonda kureeriva struktuuriüksuse ametnik, kes: 1 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) algatab Eesti Hariduse Infosüsteemis juhtumimenetluse ja teavitab kooli ning lapsevanemaid juhtumimenetluse alustamisest; 3 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete rakendamise osas kaasates juhtumipõhiselt valdkonnaüleseid spetsialiste.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062375_Map"
