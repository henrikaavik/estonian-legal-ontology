    },
    {
      "@id": "estleg:Reg_1062375_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Seiret viib läbi kooli poolt määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1) õpilase põhjendamata puudumised õppetööst vähemalt kahe järjestikuse nädala jooksul; 2) õpilase õpivõlgnevused; 3) õpetajate ja tugispetsialistide hinnanguid õpilase täiendava toe vajaduse kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062375_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
