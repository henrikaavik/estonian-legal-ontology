    {
      "@id": "estleg:Reg_1062375_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhja-Pärnumaa valla õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määrusega kehtestatakse rahvastikuregistri andmetel Põhja-Pärnumaa vallas elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus. 2 (2) Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määrusega kehtestatakse rahvastikuregistri andmetel Põhja-Pärnumaa vallas elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus. 2 (2) Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
