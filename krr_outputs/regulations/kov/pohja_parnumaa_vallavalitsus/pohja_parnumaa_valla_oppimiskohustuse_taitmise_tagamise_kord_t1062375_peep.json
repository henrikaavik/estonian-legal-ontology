        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1062375_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Väljalangemisohus oleva õpilase määratlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhja-Pärnumaa valla õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1 (1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Seiret viib läbi kooli poolt määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) õpilase põhjendamata puudumised õppetööst vähemalt kahe järjestikuse nädala jooksul; 2 2) õpilase õpivõlgnevused; 3 3) õpetajate ja tugispetsialistide hinnanguid õpilase täiendava toe vajaduse kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Seiret viib läbi kooli poolt määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) õpilase põhjendamata puudumised õppetööst vähemalt kahe järjestikuse nädala jooksul; 2 2) õpilase õpivõlgnevused; 3 3) õpetajate ja tugispetsialistide hinnanguid õpilase täiendava toe vajaduse kohta. 2 (2) Juhul kui kooli poolt rakendatud tugimeetmed ei ole taganud õpilase õppimiskohustuse täitmist, algatab kooli poolt määratud isik Eesti Hariduse Infosüsteemis juhtumi, kui õppest väljalangemise ohuga õpilase juhtumi ning märgib õpilase andmete juurde juhtumi algatamise kuupäeva.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062375_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
