        }
      ]
    },
    {
      "@id": "estleg:Reg_1062375_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesoleva määrusega kehtestatakse rahvastikuregistri andmetel Põhja-Pärnumaa vallas elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062375_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1062375_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062375_Par_1"
      },
      "rdfs:label": "§ 1 lg 2",
      "estleg:targetGroup": [
