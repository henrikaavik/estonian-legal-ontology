    {
      "@id": "estleg:Reg_1061612_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ekraanide kaudu ei avaldata isiklikku laadi teateid, poliitilisi sõnumeid ning tulunduslikku reklaami, välja arvatud juhul kui tegemist on sündmuse toetajate nimede või logodega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061612_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
