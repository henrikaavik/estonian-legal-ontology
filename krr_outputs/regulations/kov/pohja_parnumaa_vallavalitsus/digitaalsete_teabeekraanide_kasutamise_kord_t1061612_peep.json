      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Ekraanide kasutamise põhimõtted",
        "@language": "et"
      },
      "estleg:sourceAct": "Digitaalsete teabeekraanide  kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Ekraanid on avalikkuse teavitamise kanal, mis on mõeldud: 1 1) vallavalitsuse enda korraldatud või toetatud sündmuste teavitamiseks; 2 2) vallavalitsuse hallatavate asutuste avaliku teabe jagamiseks; 3 3) vallavalitsuse oluliste teadete avaldamiseks (teenuste kättesaadavuse muudatused, teetööd, ohtudest teavitamine jms). 2 (2) Ekraanide kaudu ei avaldata isiklikku laadi teateid, poliitilisi sõnumeid ning tulunduslikku reklaami, välja arvatud juhul kui tegemist on sündmuse toetajate nimede…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ekraanid on avalikkuse teavitamise kanal, mis on mõeldud: 1 1) vallavalitsuse enda korraldatud või toetatud sündmuste teavitamiseks; 2 2) vallavalitsuse hallatavate asutuste avaliku teabe jagamiseks; 3 3) vallavalitsuse oluliste teadete avaldamiseks (teenuste kättesaadavuse muudatused, teetööd, ohtudest teavitamine jms). 2 (2) Ekraanide kaudu ei avaldata isiklikku laadi teateid, poliitilisi sõnumeid ning tulunduslikku reklaami, välja arvatud juhul kui tegemist on sündmuse toetajate nimede või logodega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0638"
      },
