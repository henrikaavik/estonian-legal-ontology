      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ekraanid on avalikkuse teavitamise kanal, mis on mõeldud: 1) vallavalitsuse enda korraldatud või toetatud sündmuste teavitamiseks; 2) vallavalitsuse hallatavate asutuste avaliku teabe jagamiseks; 3) vallavalitsuse oluliste teadete avaldamiseks (teenuste kättesaadavuse muudatused, teetööd, ohtudest teavitamine jms).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061612_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
