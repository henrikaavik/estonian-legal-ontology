      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Arengukava koostamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhja-Pärnumaa valla haridusasutuste arengukavade kinnitamise kord",
      "estleg:summary": {
        "@value": "1 (1) Arengukava koostatakse haridusasutuse järjepideva arengu tagamiseks. 2 (2) Arengukava koostatakse seaduse või käesoleva määruse alusel. 3 (3) Üldhariduskoolis ja lasteaias arvestatakse arengukava koostamisel sisehindamise aruandes esile toodud tugevustega ja parendusvaldkondadega ning riskianalüüsi tulemustega. 4 (4) Arengukava koostatakse lähtuvalt senise tegevuse analüüsist, hetkeolukorra kaardistamisest ja valla arengukavast. 5 (5) Arengukava koostatakse kolmeks aastaks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Arengukava koostatakse haridusasutuse järjepideva arengu tagamiseks. 2 (2) Arengukava koostatakse seaduse või käesoleva määruse alusel. 3 (3) Üldhariduskoolis ja lasteaias arvestatakse arengukava koostamisel sisehindamise aruandes esile toodud tugevustega ja parendusvaldkondadega ning riskianalüüsi tulemustega. 4 (4) Arengukava koostatakse lähtuvalt senise tegevuse analüüsist, hetkeolukorra kaardistamisest ja valla arengukavast. 5 (5) Arengukava koostatakse kolmeks aastaks. 6 (6) Arengukava projekti koostab koostöös töötajatega haridusasutuse direktor (edaspidi direktor) kooskõlastades selle hoolekogu ja õppenõukoguga, õpilasesinduse olemasolul ka õpilasesindusega. 7 (7) Direktor tagab arengukava projekti keelelise ja vormilise korrektsuse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_parnumaa_vallavalitsus"
      },
