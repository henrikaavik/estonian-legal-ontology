      "rdfs:label": {
        "@value": "§ 1. Sotsiaaltoetuste määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Sotsiaaltoetuste määrade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada sotsiaaltoetuste määrad järgmiselt: 1 1) sünnitoetus 400 eurot; 2 2) matusetoetus 250 eurot; 3 3) hooldajatoetus sügava puudega isiku hooldajale 80 eurot kuus; 4 4) hooldajatoetus raske puudega isiku hooldajale 60 eurot kuus.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada sotsiaaltoetuste määrad järgmiselt: 1 1) sünnitoetus 400 eurot; 2 2) matusetoetus 250 eurot; 3 3) hooldajatoetus sügava puudega isiku hooldajale 80 eurot kuus; 4 4) hooldajatoetus raske puudega isiku hooldajale 60 eurot kuus.",
