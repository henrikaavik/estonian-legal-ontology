      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Liiklusseaduses sätestatud kohaliku omavalitsuse ja Saaremaa valla kui tee omaniku ülesanded delegeeritakse Saaremaa Vallavalitsusele.",
      "estleg:parentProvision": {
