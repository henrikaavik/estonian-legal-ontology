    {
      "@id": "estleg:Reg_1049660_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toetuse kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Saaremaa valla esindusvõistkondade toetamise kord",
      "estleg:summary": {
        "@value": "Toetuse kasutamise sihtotstarbelised kulud on: 1 1) esindusvõistkonna (mängijad, treenerid ja teenindav personal) võistlus- ja treeningvarustuse (riided, jalatsid, inventar ja muud vahendid) ost ja rentimine; 2 2) esindusvõistkonna ja mängijate litsentsitasud ning osavõtumaksud; 3 3) võistluste ja treeninglaagri(te) kulud (majutus, toitlustus, transport); 4 4) treeneri(te), mängija(te) ja füsioterapeut(ide) tööjõukulud ja tööjõumaksud; 5 5) spordirajatiste üüri- ja rendikulud; 6 6)…",
        "@language": "et"
      },
      "estleg:legalText": "Toetuse kasutamise sihtotstarbelised kulud on: 1 1) esindusvõistkonna (mängijad, treenerid ja teenindav personal) võistlus- ja treeningvarustuse (riided, jalatsid, inventar ja muud vahendid) ost ja rentimine; 2 2) esindusvõistkonna ja mängijate litsentsitasud ning osavõtumaksud; 3 3) võistluste ja treeninglaagri(te) kulud (majutus, toitlustus, transport); 4 4) treeneri(te), mängija(te) ja füsioterapeut(ide) tööjõukulud ja tööjõumaksud; 5 5) spordirajatiste üüri- ja rendikulud; 6 6) esindusvõistkonna meditsiiniline teenindus ja vahendid; 7 7) rahvusvahelistes sarjades osalemise kulud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saaremaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0714"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1049660_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1049660_Par_3_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1049660_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toetuse kasutamise sihtotstarbelised kulud on: 1) esindusvõistkonna (mängijad, treenerid ja teenindav personal) võistlus- ja treeningvarustuse (riided, jalatsid, inventar ja muud vahendid) ost ja rentimine; 2) esindusvõistkonna ja mängijate litsentsitasud ning osavõtumaksud; 3) võistluste ja treeninglaagri(te) kulud (majutus, toitlustus, transport); 4) treeneri(te), mängija(te) ja füsioterapeut(ide) tööjõukulud ja tööjõumaksud; 5) spordirajatiste üüri- ja rendikulud; 6) esindusvõistkonna meditsiiniline teenindus ja vahendid; 7) rahvusvahelistes sarjades osalemise kulud.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1049660_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:itemNumber": [
