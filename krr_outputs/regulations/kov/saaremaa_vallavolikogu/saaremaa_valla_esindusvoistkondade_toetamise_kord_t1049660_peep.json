      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Toetuse eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Saaremaa valla esindusvõistkondade toetamise kord",
      "estleg:summary": {
        "@value": "Toetuse eraldamise eesmärk on toetada vallas spordi esindusvõistkondi, mille kaudu edendada saavutussporti, liikumisharrastuse, sporditegevuse ja spordialade propageerimist ning kogukonna ühtsustunnet. Tutvustada valda nii kodumaal kui rahvusvahelisel tasandil.",
        "@language": "et"
      },
      "estleg:legalText": "Toetuse eraldamise eesmärk on toetada vallas spordi esindusvõistkondi, mille kaudu edendada saavutussporti, liikumisharrastuse, sporditegevuse ja spordialade propageerimist ning kogukonna ühtsustunnet. Tutvustada valda nii kodumaal kui rahvusvahelisel tasandil.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saaremaa_vallavolikogu"
      },
