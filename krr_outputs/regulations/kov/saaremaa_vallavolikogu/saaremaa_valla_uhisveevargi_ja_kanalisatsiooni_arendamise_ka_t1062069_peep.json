    {
      "@id": "estleg:Reg_1062069_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Määruse kehtetuks tunnistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Saaremaa valla ühisveevärgi ja -kanalisatsiooni arendamise kava aastateks 2024-2035 kinnitamine",
      "estleg:summary": {
        "@value": "Tunnistada kehtetuks Saaremaa Vallavolikogu 27. augusti 2020. a määrus nr 28 \"Saaremaa valla ühisveevärgi ja -kanalisatsiooni arendamise kava aastateks 2020-2031 kinnitamine\". Märkus: Ühisveevärgi ja -kanalisatsiooni seaduse § 14 lõike 1 punktides 4 ja 9 nimetatud teabe alusel koostatud ühisveevärgi ja -kanalisatsiooni arendamise kava koosseisus olevad skeemid on piiratud juurdepääsuga teave avaliku teabe seaduse § 35 lõike 1 punkti 181 tähenduses.",
        "@language": "et"
      },
      "estleg:legalText": "Tunnistada kehtetuks Saaremaa Vallavolikogu 27. augusti 2020. a määrus nr 28 \"Saaremaa valla ühisveevärgi ja -kanalisatsiooni arendamise kava aastateks 2020-2031 kinnitamine\". Märkus: Ühisveevärgi ja -kanalisatsiooni seaduse § 14 lõike 1 punktides 4 ja 9 nimetatud teabe alusel koostatud ühisveevärgi ja -kanalisatsiooni arendamise kava koosseisus olevad skeemid on piiratud juurdepääsuga teave avaliku teabe seaduse § 35 lõike 1 punkti 181 tähenduses. Nendele skeemidele kehtib juurdepääsupiirang 50 aastat alates skeemide koostamisest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saaremaa_vallavolikogu"
      },
