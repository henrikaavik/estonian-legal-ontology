      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Keskkonnaseadustiku üldosa seaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pädevuse delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) Keskkonnaseadustiku üldosa seaduse § 32 lõikes 5 sätestatud kohaliku omavalitsuse üksuse õigus otsustada enda omandis oleval maatükil viibimise piiramine delegeeritakse Saaremaa Vallavalitsusele. 2 (2) Keskkonnaseadustiku üldosa seaduse § 38 lõikes 5 sätestatud kohaliku omavalitsuse üksusele pandud ülesanne delegeeritakse Saaremaa Vallavalitsusele.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Keskkonnaseadustiku üldosa seaduse § 32 lõikes 5 sätestatud kohaliku omavalitsuse üksuse õigus otsustada enda omandis oleval maatükil viibimise piiramine delegeeritakse Saaremaa Vallavalitsusele. 2 (2) Keskkonnaseadustiku üldosa seaduse § 38 lõikes 5 sätestatud kohaliku omavalitsuse üksusele pandud ülesanne delegeeritakse Saaremaa Vallavalitsusele. 3 (3) Keskkonnaseadustiku üldosa seaduse §-s 43 sätestatud kohaliku omavalitsuse üksuse arvamuse andmine delegeeritakse Saaremaa Vallavalitsusele.",
      "estleg:enactedBy": {
