      "estleg:sourceAct": "Katastriüksuste sihtotstarvete muutmine",
      "estleg:summary": {
        "@value": "Muuta Piirissaare valla territooriumil paiknevate kehtiva liigitusega vastuolus olevate katastriüksuste liigid ning kehtestada need alljärgnevalt: <table border=\"0\" cellspacing=\"2\" cellpadding=\"2\" class=\"data\"> <tr> <td>Katastritunnus</td> <td>Nimetus</td> <td>Asula</td> <td>Sihtotstarbe liik</td> <td>Sihtotstarbe alaliik</td> </tr> <tr> <td>59501:001:0063</td> <td>Koguduse</td> <td>Saare küla</td> <td>Sotsiaalmaa</td> <td>Ühiskondlike ehitiste maa (016;Üh)</td> </tr> <tr>…",
        "@language": "et"
      },
      "estleg:legalText": "Muuta Piirissaare valla territooriumil paiknevate kehtiva liigitusega vastuolus olevate katastriüksuste liigid ning kehtestada need alljärgnevalt: <table border=\"0\" cellspacing=\"2\" cellpadding=\"2\" class=\"data\"> <tr> <td>Katastritunnus</td> <td>Nimetus</td> <td>Asula</td> <td>Sihtotstarbe liik</td> <td>Sihtotstarbe alaliik</td> </tr> <tr> <td>59501:001:0063</td> <td>Koguduse</td> <td>Saare küla</td> <td>Sotsiaalmaa</td> <td>Ühiskondlike ehitiste maa (016;Üh)</td> </tr> <tr> <td>59501:001:0072</td> <td>Valla</td> <td>Tooni küla</td> <td>Sotsiaalmaa</td> <td>Ühiskondlike ehitiste maa (016;Üh)</td> </tr> <tr> <td>59501:001:0120</td> <td>Kaupluse</td> <td>Piiri küla</td> <td>Sotsiaalmaa</td> <td>Ühiskondlike ehitiste maa (016;Üh)</td> </tr> <tr> <td>59501:001:0136</td> <td>Kooli</td> <td>Piiri küla</td> <td>Sotsiaalmaa</td> <td>Ühiskondlike ehitiste maa (016;Üh)</td> </tr> <tr> <td>59501:001:0137</td> <td>Klubi</td> <td>Tooni küla</td> <td>Sotsiaalmaa</td> <td>Ühiskondlike ehitiste maa (016;Üh)</td> </tr> </table>",
