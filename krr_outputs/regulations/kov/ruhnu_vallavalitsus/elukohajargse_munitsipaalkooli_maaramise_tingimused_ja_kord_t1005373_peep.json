      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Vabade kohtade olemasolul võetakse vastu ka õpilased, kelle rahvastikuregistrijärgne elukoht ei ole Ruhnu vald.",
      "estleg:parentProvision": {
