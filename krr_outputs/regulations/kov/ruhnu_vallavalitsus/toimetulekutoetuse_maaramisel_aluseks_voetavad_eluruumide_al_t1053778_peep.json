      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata toimetulekutoetuse aluseks võetavad eluruumide alaliste kulude piirmäära...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Toimetulekutoetuse määramisel aluseks võetavad eluruumide alaliste kulude piirmäärad",
      "estleg:summary": {
        "@value": "Määrata toimetulekutoetuse aluseks võetavad eluruumide alaliste kulude piirmäärad: 1 (1) üür – kuni 2.50 eurot 1 m2 kohta kuus; 2 (2) korterelamu haldamise kulu, sh remondiga seotud kulu – kuni 2 eurot 1 m2 kohta kuus; 3 (3) korterelamu renoveerimiseks võetud laenutagasimakse – kuni 2.50 eurot 1 m2 kohta kuus; 4 (4) veevarustuse ja reovee ärajuhtimise teenuste maksumus – kuni 12 eurot üheliikmelise pere kohta kuus ning kuni 8 eurot iga järgneva pereliikme kohta kuus; 5 (5) kütteks tarbitud…",
        "@language": "et"
      },
      "estleg:legalText": "Määrata toimetulekutoetuse aluseks võetavad eluruumide alaliste kulude piirmäärad: 1 (1) üür – kuni 2.50 eurot 1 m2 kohta kuus; 2 (2) korterelamu haldamise kulu, sh remondiga seotud kulu – kuni 2 eurot 1 m2 kohta kuus; 3 (3) korterelamu renoveerimiseks võetud laenutagasimakse – kuni 2.50 eurot 1 m2 kohta kuus; 4 (4) veevarustuse ja reovee ärajuhtimise teenuste maksumus – kuni 12 eurot üheliikmelise pere kohta kuus ning kuni 8 eurot iga järgneva pereliikme kohta kuus; 5 (5) kütteks tarbitud soojusenergia või kütuse maksumus – kuni 2.50 eurot 1 m2 kohta kuus; 6 (6) elektrienergia tarbimisega seotud kulu – kuni 30 eurot üheliikmelise pere kohta kuus ning kuni 20 eurot iga järgneva pereliikme kohta kuus; 7 (7) majapidamisgaasi maksumus – kuni 16 eurot üheliikmelise pere kohta kuus ning kuni 8 eurot iga järgneva pereliikme kohta kuus; 8 (8) maamaksukulud kolmekordse elamualuse pinna ulatuses – kuni 0.80 eurot 1 m2 kohta kuus; 9 (9) hoonekindlustuse kulud – kuni 0.50 eurot 1 m2 kohta kuus; 10 (10) olmejäätmete veotasu – kuni 3 eurot üheliikmelise pere kohta kuus ning kuni 2 eurot iga järgneva pereliikme kohta kuus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_ruhnu_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0689"
