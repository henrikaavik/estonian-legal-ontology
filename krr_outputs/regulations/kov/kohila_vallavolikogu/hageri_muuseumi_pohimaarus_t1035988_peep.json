      ]
    },
    {
      "@id": "estleg:Reg_1035988_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Muuseumi juhtimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hageri muuseumi põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Muuseumi tegevust juhib ja korraldab muuseumi juhataja, kes on muuseumi seadusjärgne esindaja. 2 (2) Muuseumi juhataja vaba ametikoha täitmiseks kuulutab vallavalitsus välja konkursi, sõlmib töölepingu, muudab ning lõpetab selle seaduses sätestatud korras. 3 (3) Muuseumi juhataja: 1 1) juhib muuseumi tegevust; 2 2) kasutab kinnitatud eelarve piires muuseumi rahalisi vahendeid; 3 3) esitab muuseumi eelarve projekti vallavalitsusele; 4 4) täidab muuseumile seatud eesmärke ja tegevusi; 5 5)…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Muuseumi tegevust juhib ja korraldab muuseumi juhataja, kes on muuseumi seadusjärgne esindaja. 2 (2) Muuseumi juhataja vaba ametikoha täitmiseks kuulutab vallavalitsus välja konkursi, sõlmib töölepingu, muudab ning lõpetab selle seaduses sätestatud korras. 3 (3) Muuseumi juhataja: 1 1) juhib muuseumi tegevust; 2 2) kasutab kinnitatud eelarve piires muuseumi rahalisi vahendeid; 3 3) esitab muuseumi eelarve projekti vallavalitsusele; 4 4) täidab muuseumile seatud eesmärke ja tegevusi; 5 5) koostab vallavalitsusega kooskõlastatud kogumispõhimõtted ja sisekorraeeskirjad ning on nende täitmise eest vastutav; 6 6) vastutab muuseumi valduses oleva vara säilimise eest; 7 7) esitab muuseumi eesmärkide ja ülesannete paremaks täimiseks valla arengu- ja tegevuskava täiendamiseks ja parandamiseks ettepanekuid; 8 8) esitab vallavalitsusele ettepanekuid muuseumi struktuuri ja koosseisu muutmiseks; 9 9) korraldab muuseumi kodulehe haldamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kohila_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
