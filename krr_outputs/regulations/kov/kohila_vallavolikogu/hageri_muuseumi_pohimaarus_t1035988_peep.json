    {
      "@id": "estleg:Reg_1035988_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Hageri muuseumi põhimäärus",
      "estleg:summary": {
        "@value": "Eesmärkide täitmiseks muuseum: 1 1) kogub, uurib, säilitab ja vahendab huvilistele eesti rahvuslikku ja piirkondlikku kultuuripärandit; 2 2) kogub ja süstematiseerib museaale ja korraldab nende arvele võtmist muuseumide infosüsteemis; 3 3) teeb koostööd teiste muuseumide, kultuuri- ja haridusasutuste ning organisatsioonidega; 4 4) tutvustab kogutud materjali (sh korraldab üritusi); 5 5) edendab piirkondlikku kultuurielu läbi kursuste, enesetäiendusvõimaluste ja koolituste; 6 6) kogub ja…",
        "@language": "et"
      },
      "estleg:legalText": "Eesmärkide täitmiseks muuseum: 1 1) kogub, uurib, säilitab ja vahendab huvilistele eesti rahvuslikku ja piirkondlikku kultuuripärandit; 2 2) kogub ja süstematiseerib museaale ja korraldab nende arvele võtmist muuseumide infosüsteemis; 3 3) teeb koostööd teiste muuseumide, kultuuri- ja haridusasutuste ning organisatsioonidega; 4 4) tutvustab kogutud materjali (sh korraldab üritusi); 5 5) edendab piirkondlikku kultuurielu läbi kursuste, enesetäiendusvõimaluste ja koolituste; 6 6) kogub ja vahendab turismiinfot; 7 7) võimaldab tutvuda olemasolevate materjalidega ja neid kasutada uurimustöödes.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kohila_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0317"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035988_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1035988_Par_3_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1035988_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Eesmärkide täitmiseks muuseum: 1) kogub, uurib, säilitab ja vahendab huvilistele eesti rahvuslikku ja piirkondlikku kultuuripärandit; 2) kogub ja süstematiseerib museaale ja korraldab nende arvele võtmist muuseumide infosüsteemis; 3) teeb koostööd teiste muuseumide, kultuuri- ja haridusasutuste ning organisatsioonidega; 4) tutvustab kogutud materjali (sh korraldab üritusi); 5) edendab piirkondlikku kultuurielu läbi kursuste, enesetäiendusvõimaluste ja koolituste; 6) kogub ja vahendab turismiinfot; 7) võimaldab tutvuda olemasolevate materjalidega ja neid kasutada uurimustöödes.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1035988_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
