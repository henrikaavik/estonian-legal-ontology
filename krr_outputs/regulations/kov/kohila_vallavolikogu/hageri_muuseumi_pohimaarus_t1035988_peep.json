    {
      "@id": "estleg:Reg_1035988_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Vara ja vahendid",
        "@language": "et"
      },
      "estleg:sourceAct": "Hageri muuseumi põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Muuseumi vara on munitsipaalomand. Muuseumi vara valitsemisel arvestatakse vallavara valitsemise reegleid, arvestades muuseumiseaduse erisusi. 2 (2) Muuseumi tegevust finantseeritakse vallavalitsuse eelarvest ja muudest allikatest (nt toetused, annetused ja muud eraldised). 3 (3) Muuseumi tulu võib kasutada üksnes põhimääruses näidatud eesmärkide saavutamiseks. 4 (4) Muuseumi raamatupidamist korraldab vallavalitsus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Muuseumi vara on munitsipaalomand. Muuseumi vara valitsemisel arvestatakse vallavara valitsemise reegleid, arvestades muuseumiseaduse erisusi. 2 (2) Muuseumi tegevust finantseeritakse vallavalitsuse eelarvest ja muudest allikatest (nt toetused, annetused ja muud eraldised). 3 (3) Muuseumi tulu võib kasutada üksnes põhimääruses näidatud eesmärkide saavutamiseks. 4 (4) Muuseumi raamatupidamist korraldab vallavalitsus. 5 (5) Muuseumile hoiule antud kultuuriväärtusega asjade kasutamine toimub vastavalt vara omanikuga sõlmitud kokkuleppele.",
