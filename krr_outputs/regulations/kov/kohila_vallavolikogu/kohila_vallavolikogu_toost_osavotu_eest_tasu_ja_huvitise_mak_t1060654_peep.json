      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Volikogu komisjoni esimehe ning liikme tasu ja hüvitis",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohila Vallavolikogu tööst osavõtu eest tasu ja hüvitise maksmise kord",
      "estleg:summary": {
        "@value": "1(1) Volikogu komisjoni esimehe või tema asendaja tasu komisjoni koosoleku korraldamise ja juhtimise eest on 100 eurot. 2(2) Volikogu komisjoni liikme tasu komisjoni koosolekul osalemise eest (v.a. komisjoni esimees või teda asendav komisjoni liige) on:11) füüsiliselt komisjoni koosolekul osalemise korral 35 eurot;22) veebi teel osalemise korral 25 eurot;33) e-kirjaga e-koosolekul osalemise korral 20 eurot. 3(3) Volikogu komisjoni koosoleku protokollija tasu on 35 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Volikogu komisjoni esimehe või tema asendaja tasu komisjoni koosoleku korraldamise ja juhtimise eest on 100 eurot. 2(2) Volikogu komisjoni liikme tasu komisjoni koosolekul osalemise eest (v.a. komisjoni esimees või teda asendav komisjoni liige) on:11) füüsiliselt komisjoni koosolekul osalemise korral 35 eurot;22) veebi teel osalemise korral 25 eurot;33) e-kirjaga e-koosolekul osalemise korral 20 eurot. 3(3) Volikogu komisjoni koosoleku protokollija tasu on 35 eurot. 4(4) Volikogu komisjoni esimehe või tema asendaja isikliku sõiduauto kasutamisel volikogu ülesannete täitmiseks on hüvitise suurus kuni 550 eurot aastas tõendatud kuludokumentide alusel.",
      "estleg:enactedBy": {
