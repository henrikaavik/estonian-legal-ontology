    },
    {
      "@id": "estleg:Reg_1060654_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Volikogu komisjoni liikme tasu komisjoni koosolekul osalemise eest (v.a. komisjoni esimees või teda asendav komisjoni liige) on: 1) füüsiliselt komisjoni koosolekul osalemise korral 35 eurot; 2) veebi teel osalemise korral 25 eurot; 3) e-kirjaga e-koosolekul osalemise korral 20 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060654_Par_5"
      },
      "rdfs:label": "§ 5 lg 2",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060654_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Volikogu komisjoni koosoleku protokollija tasu on 35 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060654_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060654_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Volikogu komisjoni esimehe või tema asendaja isikliku sõiduauto kasutamisel volikogu ülesannete täitmiseks on hüvitise suurus kuni 550 eurot aastas tõendatud kuludokumentide alusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060654_Par_5"
      },
      "rdfs:label": "§ 5 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060654_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Tasu ja hüvitise maksmise kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohila Vallavolikogu tööst osavõtu eest tasu ja hüvitise maksmise kord",
      "estleg:summary": {
        "@value": "1(1) Töötasu ja hüvitisi makstakse üks kord kuus. 2(2) Käesoleva määruse §-s 4 ja § 5 lõigetes 1-3 nimetatud tasu makstakse välja üldjuhul kaks korda aastas. 3(3) Volikogu tööst osavõtu eest makstakse tasu ainult juhul, kui volikogu liige on volikogu istungist või komisjoni liige on komisjoni koosolekust osa võtnud. Arvestust osavõtu üle peetakse volikogu istungi ja komisjoni koosoleku protokollide alusel.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Töötasu ja hüvitisi makstakse üks kord kuus. 2(2) Käesoleva määruse §-s 4 ja § 5 lõigetes 1-3 nimetatud tasu makstakse välja üldjuhul kaks korda aastas. 3(3) Volikogu tööst osavõtu eest makstakse tasu ainult juhul, kui volikogu liige on volikogu istungist või komisjoni liige on komisjoni koosolekust osa võtnud. Arvestust osavõtu üle peetakse volikogu istungi ja komisjoni koosoleku protokollide alusel. 4(4) Volikogu tööst osavõtu eest ei maksta tasu selle kuu eest kui volikogu istungeid ei toimu.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kohila_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0317"
