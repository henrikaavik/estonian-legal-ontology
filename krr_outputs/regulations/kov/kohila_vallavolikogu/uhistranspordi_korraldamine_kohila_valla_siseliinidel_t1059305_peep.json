      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Piletihinnad ja sõidusoodustused",
        "@language": "et"
      },
      "estleg:sourceAct": "Ühistranspordi korraldamine Kohila valla siseliinidel",
      "estleg:summary": {
        "@value": "Kohila valla avalikel siseliinidel kehtivad Raplamaa avalike maakonnaliinide piletitsoonid, piletihinnad, sõidusoodustused ja sõidusoodustust tõendavad dokumendid ning riiklikult kehtestatud tasuta sõiduõigus.",
        "@language": "et"
      },
      "estleg:legalText": "Kohila valla avalikel siseliinidel kehtivad Raplamaa avalike maakonnaliinide piletitsoonid, piletihinnad, sõidusoodustused ja sõidusoodustust tõendavad dokumendid ning riiklikult kehtestatud tasuta sõiduõigus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kohila_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0317"
