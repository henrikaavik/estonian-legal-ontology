        {
          "@id": "estleg:Reg_1060773_Par_4_Lg_8"
        }
      ],
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_kohila_vallavalitsus"
        },
        {
          "@id": "estleg:Issuer_kohila_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ümarlaua töövormiks on koosolekud, mis toimuvad vastavalt vajadusele, kuid vähemalt kaks korda aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ümarlaua koosolekud protokollitakse ning protokollid edastatakse vallavalitsusele. Need on kättesaadavad ka valla kodulehel, välja arvatud juhtudel, kui teave sisaldab isikuandmeid või muud piiratud juurdepääsuga infot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_kohila_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ümarlaua otsused võetakse vastu, kui nende poolt hääletab üle poole kohal viibivatest hääleõiguslikest liikmetest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Ümarlaua juhatuse ülesanded on: 1) Ümarlaua töö juhtimine ja korraldamine. 2) Koosolekute ettevalmistamine ja läbiviimine. 3) Vallavolikogule ja -valitsusele informatsiooni edastamine. 4) Ümarlaua liikmete nimekirja haldamine ja ajakohastamine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_kohila_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Hääletamisel on igal ümarlaua liikmel üks hääl. Kui ümarlaua liige on Mittetulundusühing või Seltsing, on ümarlaual hääleõigus Mittetulundusühingu või Seltsingu juhatuse liikmel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_NGO"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Ümarlaua juhatusse kuuluvad esimees ja kaks aseesimeest, kes valitakse ümarlaua liikmete hulgast kaheks aastaks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 6",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Ümarlaua tehnilist teenindamist korraldab vallakantselei.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 7"
    },
    {
      "@id": "estleg:Reg_1060773_Par_4_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Ümarlaua koosolekud võivad toimuda nii füüsiliselt kui ka elektrooniliste sidevahendite kaudu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060773_Par_4"
      },
      "rdfs:label": "§ 4 lg 8"
    },
    {
      "@id": "estleg:Reg_1060773_Par_5",
