      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Pakendiseaduses sätestatud pädevuse delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pädevuse delegeerimine",
      "estleg:summary": {
        "@value": "Delegeerida Paikuse Vallavalitsusele järgmiste pakendiseadusega kohaliku omavalitsuse, kohaliku omavalitsusüksuse või kohaliku omavalitsusorgani pädevusse antud küsimuste lahendamine:11) nõusoleku andmine sellise pakendi, millele on kehtestatud tagatisraha, tagasivõtmise korraldamiseks väljaspool oma müügikoha teenindusmaa piire;22) taaskasutusorganisatsiooniga kokkuleppe sõlmimine.",
        "@language": "et"
      },
      "estleg:legalText": "Delegeerida Paikuse Vallavalitsusele järgmiste pakendiseadusega kohaliku omavalitsuse, kohaliku omavalitsusüksuse või kohaliku omavalitsusorgani pädevusse antud küsimuste lahendamine:11) nõusoleku andmine sellise pakendi, millele on kehtestatud tagatisraha, tagasivõtmise korraldamiseks väljaspool oma müügikoha teenindusmaa piire;22) taaskasutusorganisatsiooniga kokkuleppe sõlmimine.",
