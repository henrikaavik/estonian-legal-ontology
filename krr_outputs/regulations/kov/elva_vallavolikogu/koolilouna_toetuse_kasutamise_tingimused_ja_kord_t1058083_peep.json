    {
      "@id": "estleg:Reg_1058083_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Elva vallale riigieelarvest koolilõuna toetuseks (edaspidi koolilõuna toetus) eraldatavate vahendite kasutamise tingimused ja kord ning koolilõuna maksumusest puudujääva osa kulude katmise kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Elva vallale riigieelarvest koolilõuna toetuseks (edaspidi koolilõuna toetus) eraldatavate vahendite kasutamise tingimused ja kord ning koolilõuna maksumusest puudujääva osa kulude katmise kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_elva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0171"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058083_Map"
      },
      "estleg:hasSubsection": [
