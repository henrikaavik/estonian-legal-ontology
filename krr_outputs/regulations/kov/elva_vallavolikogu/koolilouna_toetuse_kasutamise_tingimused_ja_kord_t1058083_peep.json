    },
    {
      "@id": "estleg:Reg_1058083_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Elva vallale riigieelarvest koolilõuna toetuseks (edaspidi koolilõuna toetus) eraldatavate vahendite kasutamise tingimused ja kord ning koolilõuna maksumusest puudujääva osa kulude katmise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058083_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1058083_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna kulude katmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Elva vallale koolilõuna kulude katmiseks riigieelarves määratud eraldist kasutatakse Elva valla munitsipaalüldhariduskoolides (edaspidi kool) statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmisel. 2 (2) Kooli õpilaste koolilõuna kulud kaetakse riigi poolt ettenähtud eraldiste osas arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ja valla eelarvest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Elva vallale koolilõuna kulude katmiseks riigieelarves määratud eraldist kasutatakse Elva valla munitsipaalüldhariduskoolides (edaspidi kool) statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmisel. 2 (2) Kooli õpilaste koolilõuna kulud kaetakse riigi poolt ettenähtud eraldiste osas arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ja valla eelarvest. RT IV2025-12-30444301220250442026-01-01 3 (3) Koolilõuna toetuse arvelt kaetakse osaliselt põhi- ja gümnaasiumiharidust omandavate õpilaste koolilõuna valmistamise (sh toiduained) kulud. 4 (4) Koolilõuna maksumuse kehtestab Elva Vallavalitsus (edaspidi vallavalitsus). 5 (5) Kehtetu -RT IV2025-12-30444301220250442026-01-01",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_elva_vallavolikogu"
      },
