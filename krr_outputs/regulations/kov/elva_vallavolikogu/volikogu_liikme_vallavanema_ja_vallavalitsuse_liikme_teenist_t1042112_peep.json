      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Välislähetuse käskkirjas märgitakse lähetuse sihtkoht, kuhu lähetatav suunatakse, lähetuse kestus, eesmärk ning lähetuskulude hüvitamise ja päevaraha määr..",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042112_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1042112_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vallavolikogu esimehe ja vallavanema käskkirja valmistab ette ning käskkirja ja alusmaterjalid säilitab valla kantselei..",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042112_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_elva_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1042112_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Lähetus vormistatakse kooskõlas ametiasutuse asjaajamist ning raamatupidamisarvestust ja -aruandlust reguleerivates õigusaktides sätestatud nõuetega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042112_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1042112_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Avansi taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "Lähetatul on õigus nõuda lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses mõistliku aja jooksul enne lähetuse algust. Avansi mittesaamise korral võib lähetatav lähetusest keelduda.",
        "@language": "et"
      },
      "estleg:legalText": "Lähetatul on õigus nõuda lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses mõistliku aja jooksul enne lähetuse algust. Avansi mittesaamise korral võib lähetatav lähetusest keelduda.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_elva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0171"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042112_Map"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
