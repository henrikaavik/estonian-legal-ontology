      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Right"
      }
    },
    {
      "@id": "estleg:Reg_1042112_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Lähetuskulude hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulud ning lähetusülesande täitmisega seotud muud kulud ning makstakse välislähetuses viibimise aja eest päevaraha Vabariigi Valitsuse määrusega kehtestatud ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimustel ja korras, vormikohase lähetuskulude õiendi alusel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulud ning lähetusülesande täitmisega seotud muud kulud ning makstakse välislähetuses viibimise aja eest päevaraha Vabariigi Valitsuse määrusega kehtestatud ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimustel ja korras, vormikohase lähetuskulude õiendi alusel. Riigisisese lähetuse korral ei maksta käesoleva määruse alusel päevaraha ja hüvitist isikliku sõiduauto kasutamise eest.. 2 (2) Lähetuskulude aruande ja kulusid tõendavad dokumendid esitab volikogu esimees volikogu aseesimehele, volikogu liige ja vallavanem volikogu esimehele ning vallavalitsuse liige vallavanemale kinnitamiseks. Lähetuskulud peavad olema dokumentaalselt tõendatud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_elva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0171"
