      }
    },
    {
      "@id": "estleg:Reg_1042112_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lähetatul on õigus nõuda lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses mõistliku aja jooksul enne lähetuse algust. Avansi mittesaamise korral võib lähetatav lähetusest keelduda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042112_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:assertionConfidence": {
        "@value": "0.70",
