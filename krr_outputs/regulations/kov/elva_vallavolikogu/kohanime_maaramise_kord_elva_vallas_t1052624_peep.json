      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohanime määramise pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord Elva vallas",
      "estleg:summary": {
        "@value": "1 (1) Elva Vallavalitsuse kui täitevorgani pädevuses on: 1 1) kohanime määramine, muutmine ja kehtetuks tunnistamine; 2 2) arvamuse andmine ministri või Vabariigi Valitsuse määratavate kohanimede kohta Elva vallas. 2 (2) Muid kohanimeseaduses kohalikule omavalitsusele pandud ülesandeid täidab Elva Vallavalitsuse (ametiasutuse) poolt määratud osakond või ametnik.",
        "@language": "et"
      },
