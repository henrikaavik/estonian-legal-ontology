      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Sissetulekust mittesõltuvate sotsiaaltoetuste määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallaeelarvest makstavate sotsiaaltoetuste määrad",
      "estleg:summary": {
        "@value": "Kehtestada perekonna sissetulekust mittesõltuvate sotsiaaltoetuste määrad järgmiselt: 1 1) sünnitoetus 550 eurot, esimene osa 300 eurot ja teine osa 250 eurot; 2 2) ranitsatoetus 200 eurot; RT IV2026-06-1164110620260062026-09-01 3 3) matusetoetus 250 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada perekonna sissetulekust mittesõltuvate sotsiaaltoetuste määrad järgmiselt: 1 1) sünnitoetus 550 eurot, esimene osa 300 eurot ja teine osa 250 eurot; 2 2) ranitsatoetus 200 eurot; RT IV2026-06-1164110620260062026-09-01 3 3) matusetoetus 250 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_elva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0171"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041287_Map"
