      "rdfs:label": {
        "@value": "§ 2. Hooldajatoetuste määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallaeelarvest makstavate sotsiaaltoetuste määrad",
      "estleg:summary": {
        "@value": "Kehtestada hooldajatoetuste määrad järgmiselt: 1 1) täisealise raske puudega isiku hooldajale 35 eurot; RT IV 2022-02-26 39 426022022039 2022-03-01 3 2 2) täisealise sügava puudega isiku hooldajale 45 eurot; RT IV 2022-02-26 39 426022022039 2022-03-01 3 3 3) puudega lapse hooldajale 60 eurot. 2022-02-18 RT IV 2022-02-26 39 426022022039 2022-03-01 3",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada hooldajatoetuste määrad järgmiselt: 1 1) täisealise raske puudega isiku hooldajale 35 eurot; RT IV 2022-02-26 39 426022022039 2022-03-01 3 2 2) täisealise sügava puudega isiku hooldajale 45 eurot; RT IV 2022-02-26 39 426022022039 2022-03-01 3 3 3) puudega lapse hooldajale 60 eurot. 2022-02-18 RT IV 2022-02-26 39 426022022039 2022-03-01 3",
