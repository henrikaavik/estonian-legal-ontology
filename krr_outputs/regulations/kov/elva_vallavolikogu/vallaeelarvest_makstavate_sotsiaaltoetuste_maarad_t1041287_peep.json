    },
    {
      "@id": "estleg:Reg_1041287_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada perekonna sissetulekust mittesõltuvate sotsiaaltoetuste määrad järgmiselt: 1) sünnitoetus 550 eurot, esimene osa 300 eurot ja teine osa 250 eurot; 2) ranitsatoetus 200 eurot; 3) matusetoetus 250 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041287_Par_1"
      },
