      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Kooli vastuvõtu tingimuste ja korra muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Püünsi Kooli õpilaste vastuvõtmise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Kooli vastuvõtu tingimuste muutmise ettepanekuid on võimalik teha õppeaasta jooksul. Vastavad ettepanekud tuleb esitada hiljemalt 10. jaanuariks kooli direktorile. 2 (2) Kooli vastuvõtu tingimusi ja korda ei muudeta 1. märtsist kuni 30. augustini.",
        "@language": "et"
      },
