      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Komisjoni esimehe pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Vinni valla kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "Komisjoni esimees: 1 1) esindab komisjoni riigi- ja valitsusasutustes; 2 2) kutsub kokku ja juhatab komisjoni koosolekuid; 3 3) kutsub vajaduse korral komisjoni tööst osa võtma isikuid, kes ei kuulu komisjoni koosseisu; 4 4) jälgib komisjoni otsuste täitmist; 5 5) korraldab komisjoni liikmetele kriisireguleerimise alaseid koolitusi.",
        "@language": "et"
      },
      "estleg:legalText": "Komisjoni esimees: 1 1) esindab komisjoni riigi- ja valitsusasutustes; 2 2) kutsub kokku ja juhatab komisjoni koosolekuid; 3 3) kutsub vajaduse korral komisjoni tööst osa võtma isikuid, kes ei kuulu komisjoni koosseisu; 4 4) jälgib komisjoni otsuste täitmist; 5 5) korraldab komisjoni liikmetele kriisireguleerimise alaseid koolitusi.",
