      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata Mõdriku külas asuvatele liikluspindadele ametlikeks kohanimedeks Täkusam...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1018330_Map"
      },
      "estleg:summary": {
        "@value": "Määrata Mõdriku külas asuvatele liikluspindadele ametlikeks kohanimedeks Täkusamba tee, Tiigivahe tee ja Mõisapargi tee vastavalt lisatud asendiplaanidele.",
        "@language": "et"
      },
      "estleg:legalText": "Määrata Mõdriku külas asuvatele liikluspindadele ametlikeks kohanimedeks Täkusamba tee, Tiigivahe tee ja Mõisapargi tee vastavalt lisatud asendiplaanidele."
