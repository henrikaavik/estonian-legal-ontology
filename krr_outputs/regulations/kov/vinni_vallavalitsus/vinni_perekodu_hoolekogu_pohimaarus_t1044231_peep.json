    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Hoolekogu tööd juhib hoolekogu esimees, tema äraolekul hoolekogu aseesimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Hoolekogu koosolekud toimuvad vähemalt kaks korda aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Hoolekogu koosoleku valmistab ette ja kutsub kokku ning asjaajamise korraldab hoolekogu esimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Hoolekogu koosoleku toimumisest ja päevakorrast teatatakse hoolekogu liikmetele vähemalt 7 kalendripäeva ette.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Hoolekogu koosolekud on kinnised.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Hoolekogu koosolek protokollitakse. Protokolli kantakse: 1) koosoleku toimumise aeg ja koht; 2) koosolekust osavõtnud ja puudunud hoolekogu liikmete nimed; 3) koosolekule kutsutud isiku nimi ning ametinimetus; 4) kinnitatud päevakord; 5) ettekandega ja sõnavõtuga esinenud isikute nimed ja sõnavõtu lühike sisu (isikuandmeid ja delikaatseid andmeid protokolli ei märgita); 6) vastuvõetud otsused ja ettepanekud; 7) koosoleku juhataja ja protokollija nimed ning nende allkirjad. Protokollija ei pea olema hoolekogu liige.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 6",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Hoolekogu protokolle koos muude hoolekogu töösse puutuvate materjalidega säilitatakse perekodus ühtsetel alustel muude asutuse dokumentidega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 7",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Hoolekogu on otsustusvõimeline, kui kohal viibib üle poole komisjoni koosseisust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 8",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_9",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "9",
      "estleg:legalText": "(9) Hoolekogu otsustused võetakse vastu üldjuhul avalikul hääletamisel, hoolekogu otsusel võib hääletamine olla salajane. Hoolekogu otsused võetakse vastu lihthäälteenamusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 9",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_10",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "10",
      "estleg:legalText": "(10) Hoolekogu protokollid on avalikud ning asjast huvitatud isikul on õigus nendega perekodus tutvuda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 10",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Right"
      }
    },
    {
      "@id": "estleg:Reg_1044231_Par_4_Lg_11",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "11",
      "estleg:legalText": "(11) Hoolekogu liikmete tegevust ei tasustata.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044231_Par_4"
      },
      "rdfs:label": "§ 4 lg 11",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
