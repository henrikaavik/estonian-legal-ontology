      ]
    },
    {
      "@id": "estleg:Reg_1062131_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Seiret viib läbi selle ülesande täitmiseks määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1) õpilase korduvad põhjendamata puudumised õppetööst; 2) õpilase võlgnevused õppetöös; 3) õpetajate ja tugispetsialistide hinnangud õpilase täiendava toe vajaduse kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062131_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1062131_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Juhul kui kooli poolt rakendatud tugimeetmed ei ole taganud õpilase õppimiskohustuse täitmist, algatab selle ülesande täitmiseks määratud isik Eesti Hariduse Infosüsteemis õppest väljalangemise ohuga õpilase juhtumi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062131_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1062131_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Saue valla hallatavas põhikoolis määrab isiku, kelle tööülesannete hulka kuulub õppimiskohustusega seotud info valla- või linnavalitsusega vahetamise korraldamine, direktor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062131_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1062131_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Õppimiskohustuse seire ja abimeetmete pakkumine Saue vallas",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Õppimiskohustuse täitmise seiret Saue Vallavalitsuses koordineerib haridusosakond. 2(2)Igakuise seire eest vastutab noorte heaolu spetsialist, kes:11) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta;22) selgitab välja õppimiskohustuse täitmata jätmise põhjused;33) edastab info vastavalt väljaselgitatud põhjustele valla haridus- või sotsiaalosakonna vastavale spetsialistile.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Õppimiskohustuse täitmise seiret Saue Vallavalitsuses koordineerib haridusosakond. 2(2)Igakuise seire eest vastutab noorte heaolu spetsialist, kes:11) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta;22) selgitab välja õppimiskohustuse täitmata jätmise põhjused;33) edastab info vastavalt väljaselgitatud põhjustele valla haridus- või sotsiaalosakonna vastavale spetsialistile. 3(3)Valla vastava valdkonna spetsialist korraldab edasist tegevust õppimiskohustuse täitmist toetavate meetmete rakendamise osas kaasates lapse seaduslikud esindajad, teisi valla spetsialiste, sh tugispetsialiste, valdkonnaüleseid spetsialiste jt. 4(4)Saue valla munitsipaalpõhikoolis teavitab isik, kelle tööülesannete hulka kuulub õppimiskohustusega seotud info vallavalitsusega vahetamise korraldamine, koolikohustust mittetäitvast õpilasest Saue valla vastava piirkonna laste heaolu spetsialisti vastavalt osapoolt poolt kokku lepitud korras ja vormil. 5(5)Kui õppimiskohustuslik õpilane õpib väljaspool elukohajärgset omavalitsust, tehakse vajadusel koostööd kooli ja/või vastava kohaliku omavalitsusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saue_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0726"
