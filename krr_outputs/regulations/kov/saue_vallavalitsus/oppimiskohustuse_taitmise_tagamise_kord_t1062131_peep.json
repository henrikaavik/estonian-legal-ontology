    },
    {
      "@id": "estleg:Reg_1062131_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Õppimiskohustuse täitmise seiret Saue Vallavalitsuses koordineerib haridusosakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062131_Par_3"
      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1062131_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Igakuise seire eest vastutab noorte heaolu spetsialist, kes: 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2) selgitab välja õppimiskohustuse täitmata jätmise põhjused; 3) edastab info vastavalt väljaselgitatud põhjustele valla haridus- või sotsiaalosakonna vastavale spetsialistile.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062131_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
