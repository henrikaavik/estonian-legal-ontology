        },
        {
          "@id": "estleg:Reg_1015881_Par_2_Lg_5"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1015881_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) detailplaneeringu kehtestamise teate avaldamine ajalehes ”Põhjarannik” ja valla koduleheküljel;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015881_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1015881_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) kehtestatud detailplaneeringu edastamine Ida-Viru maavanemale;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015881_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1015881_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) kehtestatud detailplaneeringu edastamine Maa-ameti Ida-Viru katastribüroole;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015881_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1015881_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) kehtestatud detailplaneeringu alusel sisse viia muudatused kehtivasse valla üldplaneeringusse;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015881_Par_2"
