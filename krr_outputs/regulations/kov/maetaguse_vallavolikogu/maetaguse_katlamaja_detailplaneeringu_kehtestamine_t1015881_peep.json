      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Mäetaguse Vallavalitsusel korraldada 1 (1) detailplaneeringu kehtestamise teate...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Mäetaguse katlamaja detailplaneeringu kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1015881_Map"
      },
      "estleg:summary": {
        "@value": "Mäetaguse Vallavalitsusel korraldada 1 (1) detailplaneeringu kehtestamise teate avaldamine ajalehes ”Põhjarannik” ja valla koduleheküljel; 2 (2) kehtestatud detailplaneeringu edastamine Ida-Viru maavanemale; 3 (3) kehtestatud detailplaneeringu edastamine Maa-ameti Ida-Viru katastribüroole; 4 (4) kehtestatud detailplaneeringu alusel sisse viia muudatused kehtivasse valla üldplaneeringusse; 5 (5) kehtestatud detailplaneeringu kättesaadavus.",
        "@language": "et"
      },
      "estleg:legalText": "Mäetaguse Vallavalitsusel korraldada 1 (1) detailplaneeringu kehtestamise teate avaldamine ajalehes ”Põhjarannik” ja valla koduleheküljel; 2 (2) kehtestatud detailplaneeringu edastamine Ida-Viru maavanemale; 3 (3) kehtestatud detailplaneeringu edastamine Maa-ameti Ida-Viru katastribüroole; 4 (4) kehtestatud detailplaneeringu alusel sisse viia muudatused kehtivasse valla üldplaneeringusse; 5 (5) kehtestatud detailplaneeringu kättesaadavus.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1015881_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1015881_Par_2_Lg_2"
        },
