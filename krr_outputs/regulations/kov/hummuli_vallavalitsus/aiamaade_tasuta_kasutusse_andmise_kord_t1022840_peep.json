        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Maa kasutamise nõuded",
        "@language": "et"
      },
      "estleg:sourceAct": "Aiamaade tasuta kasutusse andmise kord",
      "estleg:summary": {
        "@value": "1(1) Maa kasutaja on kohustatud:11) kasutama maad vastavalt sihtotstarbele põllumajandussaaduste kasvatamiseks, võimaldades vallavalitsusel kontrollida lepingus nimetatud kohustuste täitmist;22) järgima uue kasvuhoone ehitamisel ja soovituslikult ka vana kasvuhoone korrastamisel keskasula detailplaneeringus näidatud ühtset ehitusjoont;33) järgima head põllumajandustava, täitma kõiki agrotehnilisi ja keskkonnakaitse nõudeid;44) hoidma oma kasutuses oleva maa umbrohust ja kahjuritest puhtana ning…",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Maa kasutaja on kohustatud:11) kasutama maad vastavalt sihtotstarbele põllumajandussaaduste kasvatamiseks, võimaldades vallavalitsusel kontrollida lepingus nimetatud kohustuste täitmist;22) järgima uue kasvuhoone ehitamisel ja soovituslikult ka vana kasvuhoone korrastamisel keskasula detailplaneeringus näidatud ühtset ehitusjoont;33) järgima head põllumajandustava, täitma kõiki agrotehnilisi ja keskkonnakaitse nõudeid;44) hoidma oma kasutuses oleva maa umbrohust ja kahjuritest puhtana ning tagama maa heakorra. 2(2) Maa kasutajal on keelatud:11) tarastada maad eriloata;22) viibida põhjendamatult teiste isikute kasutuses oleval maal;33) pidada eriloata koduloomi ja -linde;44) anda maad omavoliliselt teise isiku kasutusse. 3(3) Maa kasutajal on lubatud:11) ehitada maale korraliku välimusega kasvuhooneid ja –tunneleid arvestades Hummuli keskasula detailplaneeringus näidatud ühtset ehitusjoont;22) istutada maale viljapuid ja marjapõõsaid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_hummuli_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
