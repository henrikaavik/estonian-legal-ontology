        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kaitseala välispiiri kirjeldus on koostatud maakatastri kaardi (mõõtkava 1:10 000) alusel.",
