      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Vallavolikogu esimehe hüvitus on 30% vallavanema töötasust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052892_Par_1"
      },
