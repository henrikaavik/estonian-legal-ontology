    },
    {
      "@id": "estleg:Reg_1041417_Par_1_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Põhja-Sakala Vallavalitsust volitatakse lahendama: 1) alusharidusseaduse § 46 lõikes 4 nimetatud kohaliku omavalitsuse üksuse ülesannet kehtestada munitsipaallasteaia toidukulu päevamaksumust; 2) alusharidusseaduse § 47 lõikes 2 nimetatud kohaliku omavalitsuse üksuse ülesannet kehtestada eralastehoiu ja -lasteaia toetamise tingimused ja korra; 3) alusharidusseaduse § 25 lõikes 4 nimetatud kohaliku omavalitsuse üksuse ülesannet kuulutada välja munitsipaallasteaia direktori ametikoha täitmiseks korraldatav avalik konkurss ja kehtestada konkursi läbiviimise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041417_Par_1_1"
      },
      "rdfs:label": "§ 1<sup>1</sup> lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1041417_Par_1_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Põhja-Sakala vallavanemat volitatakse lahendama alusharidusseaduse § 25 lõikes 4 nimetatud kohaliku omavalitsuse üksuse ülesannet sõlmida direktoriga töölepingut, seda muuta ja öelda üles.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041417_Par_1_1"
      },
      "rdfs:label": "§ 1<sup>1</sup> lg 2"
    },
    {
      "@id": "estleg:Reg_1041417_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kooli pidaja pädevusse antud küsimuste lahendamise volitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Küsimuste lahendamise volitamine",
      "estleg:summary": {
        "@value": "1 (1) Põhja-Sakala Vallavalitsust volitatakse lahendama põhikooli- ja gümnaasiumiseaduses kooli pidaja pädevusse antud ülesannetest § 13, § 26 lõikes 3, § 42 lõikes 1, § 43 lõikes 2, § 44 lõigetes 2 ja 3, § 51 lõikes 2, § 63 lõigetes 2, 3 ja 5, § 71 lõike 2 punktis 4 ning lõikes 5 antud ülesandeid. 2 (2) Valla munitsipaalkoolide direktoreid volitatakse lahendama põhikooli- ja gümnaasiumiseaduses kooli pidaja pädevusse antud ülesannetest § 27 lõikes 5 antud ülesannet.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Põhja-Sakala Vallavalitsust volitatakse lahendama põhikooli- ja gümnaasiumiseaduses kooli pidaja pädevusse antud ülesannetest § 13, § 26 lõikes 3, § 42 lõikes 1, § 43 lõikes 2, § 44 lõigetes 2 ja 3, § 51 lõikes 2, § 63 lõigetes 2, 3 ja 5, § 71 lõike 2 punktis 4 ning lõikes 5 antud ülesandeid. 2 (2) Valla munitsipaalkoolide direktoreid volitatakse lahendama põhikooli- ja gümnaasiumiseaduses kooli pidaja pädevusse antud ülesannetest § 27 lõikes 5 antud ülesannet.",
