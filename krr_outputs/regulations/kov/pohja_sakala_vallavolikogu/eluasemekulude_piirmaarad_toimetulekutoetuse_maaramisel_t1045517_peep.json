    {
      "@id": "estleg:Reg_1045517_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Eluruumi üür ja korterelamu kulud",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluasemekulude piirmäärad toimetulekutoetuse määramisel",
      "estleg:summary": {
        "@value": "1 (1) Eluruumi üüri piirmäär on 12 eurot normpinna 1 m² kohta kuus. RT IV 2021-12-28 4 428122021004 2021-12-31 2 (2) Korterelamu haldamise kulu, sh remondiga seotud kulu kuni 1,00 eurot normpinna 1 m2 kohta kuus. 3 (3) Korterelamu renoveerimiseks võetud laenu tagasimakse kuni 2,00 eurot 1 m2 kohta kuus. 4 (4) Eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse kulu kuni 7,00 eurot normpinna 1 m2 kohta kuus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Eluruumi üüri piirmäär on 12 eurot normpinna 1 m² kohta kuus. RT IV 2021-12-28 4 428122021004 2021-12-31 2 (2) Korterelamu haldamise kulu, sh remondiga seotud kulu kuni 1,00 eurot normpinna 1 m2 kohta kuus. 3 (3) Korterelamu renoveerimiseks võetud laenu tagasimakse kuni 2,00 eurot 1 m2 kohta kuus. 4 (4) Eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse kulu kuni 7,00 eurot normpinna 1 m2 kohta kuus. RT IV 2022-07-09 7 409072022007 2022-07-12 , rakendatakse 01. juulist 2022",
