      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kaugkütte korral tarbitud soojusenergia või kütuse maksumus kuni 4 eurot/m² kohta kuus.",
      "estleg:parentProvision": {
