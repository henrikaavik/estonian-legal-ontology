      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Mittevajalik teavik",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhja-Sakala valla rahvaraamatukogude mittevajalike teavikute tasuta võõrandamise ja müügi kord",
      "estleg:summary": {
        "@value": "1(1)Mittevajalikuks võib tunnistada teaviku:11) mida on raamatukogus eksemplaridena rohkem, kui raamatukogu teenindamiseks vajalik (teaviku liigne eksemplar);22) mille sisu ei ole enam aktuaalne ning teaviku laenutamiseks ja kasutamiseks puudub nõudlus (teavik on aegunud);33) mis on heaks teenindamiseks liialt lagunenud (kasutuskõlbmatu). 2(2)Mittevajalikud teavikud kustutatakse rahvaraamatukogu seaduse ja selle alusel antud õigusaktidega sätestatud korras.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Mittevajalikuks võib tunnistada teaviku:11) mida on raamatukogus eksemplaridena rohkem, kui raamatukogu teenindamiseks vajalik (teaviku liigne eksemplar);22) mille sisu ei ole enam aktuaalne ning teaviku laenutamiseks ja kasutamiseks puudub nõudlus (teavik on aegunud);33) mis on heaks teenindamiseks liialt lagunenud (kasutuskõlbmatu). 2(2)Mittevajalikud teavikud kustutatakse rahvaraamatukogu seaduse ja selle alusel antud õigusaktidega sätestatud korras. 3(3)Mittevajalikest teavikutest valib tasuta võõrandamiseks või müügiks pakutavad välja raamatukogu töötaja või direktor. 4(4)Mittevajalikke teavikuid võib raamatukogu tasuta üle anda või raha eest võõrandada vastavalt direktori kinnitatud kustutusaktis märgitud otsusele. 5(5)Tasuta võõrandamiseks ja müügiks eraldatud teavikus kriipsutatakse läbi kehtinud templi jäljendid ja inventarinumbrid. 6(6)Teavikule lüüakse tempel „maha kantud“.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
