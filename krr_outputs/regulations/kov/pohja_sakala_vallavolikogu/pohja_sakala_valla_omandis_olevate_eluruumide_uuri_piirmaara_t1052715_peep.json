      }
    },
    {
      "@id": "estleg:Reg_1052715_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Põhja-Sakala valla haldusterritooriumil asuvate valla omandis olevate eluruumide üüri piirmääraks kehtestatakse kuni 13 eurot ühe ruutmeetri kohta ühes kuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052715_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1052715_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Eluruumi üüri suuruse määrab Põhja-Sakala Vallavalitsus arvestades eluruumi asukohta, ehituslikku seisukorda, veevarustuse ja kanalisatsiooni olemasolu, heakorda ja muid asjaolusid.",
