    },
    {
      "@id": "estleg:Reg_1040997_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ametnik peab tundma: 1) riigi põhikorda, kodanike põhiõigusi ja -vabadusi ning avaliku halduse organisatsiooni; 2) kohaliku omavalitsuse korraldust reguleerivaid õigusakte ja asjaajamiskorra aluseid; 3) avalikku teenistust reguleerivaid õigusakte; 4) oma teenistusvaldkonda reguleerivaid õigusakte ning oskama neid teenistusülesannete täitmisel rakendada; 5) oskama kasutada kohaliku omavalitsuse infosüsteeme, sh ametikohal vajalikke arvutiprogramme ja andmekogusid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040997_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "@id": "estleg:Reg_1040997_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenistujal peab olema hea suhtlemisoskus, sh oskus koostööks avalike huvide elluviimisel ning hea väljendus- ja kuulamisoskus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040997_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1040997_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ametiasutuse struktuuriüksuse juht peab lisaks lõikes 1 sätestatule omama juhtimisalaseid teadmisi ja oskuseid (sh tundma juhtimisprintsiipe ja oskama neid rakendada) ning oskust planeerida tööprotsessi ja alluvate tööd.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040997_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1040997_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Täpsemad nõuded ametnike haridusele ja nõuded töökogemusele, teadmistele ning oskustele sätestatakse ametniku ametijuhendis, mille kehtestab vallavanem.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040997_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
    {
      "@id": "estleg:Reg_1040997_Par_5",
