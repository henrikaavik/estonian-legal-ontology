      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "Kohanimede määramise kord sätestab kohanimede määramise ja korraldamise ning koha-aadresside määramise Põhja-Sakala valla haldusterritooriumil.",
        "@language": "et"
      },
      "estleg:legalText": "Kohanimede määramise kord sätestab kohanimede määramise ja korraldamise ning koha-aadresside määramise Põhja-Sakala valla haldusterritooriumil.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
