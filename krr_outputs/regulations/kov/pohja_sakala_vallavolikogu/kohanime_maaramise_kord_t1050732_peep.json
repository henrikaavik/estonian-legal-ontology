      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohanime määramise pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1(1)Põhja-Sakala vallas määrab kohanimed Põhja-Sakala Vallavalitsus (edaspidi vallavalitsus) oma korraldusega. 2(2)Juhul, kui kohanime määramine toimub Vabariigi Valitsuse või asjaomase ministri poolt ja puudutab Põhja-Sakala valla haldusterritooriumi, annab vallavalitsus kohanimemäärajale arvamuse kohanime määramise kohta.",
        "@language": "et"
      },
