    },
    {
      "@id": "estleg:Reg_1049079_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesoleva määrusega kehtestatakse Põhja-Sakala valla eelarvest eraldatava huvihariduse või -tegevuse (edaspidi huvitegevus) toetuse taotlemise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1049079_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1049079_Par_1_Lg_2",
