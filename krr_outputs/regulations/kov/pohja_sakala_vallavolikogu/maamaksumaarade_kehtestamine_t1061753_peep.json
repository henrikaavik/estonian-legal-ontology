      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Põhja-Sakala vallas maamaksumäärad: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,45 protsenti maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale maamaksumäär 0,33 protsenti maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumäär 0,95 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Põhja-Sakala vallas maamaksumäärad: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,45 protsenti maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale maamaksumäär 0,33 protsenti maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumäär 0,95 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavolikogu"
      },
