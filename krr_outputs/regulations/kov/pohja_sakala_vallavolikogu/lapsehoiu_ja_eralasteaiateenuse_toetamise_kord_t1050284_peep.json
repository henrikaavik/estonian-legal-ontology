        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Lapsehoiu- ja eralasteaiateenuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Määrusega reguleeritakse lapsehoiuteenuse ja eralasteaias käimise toetamist (edaspidi toetus) pooleteise- kuni seitsmeaastasele lapsele, kellele Põhja-Sakala vald ei ole loonud võimalust käia teeninduspiirkonna munitsipaallasteasutuses. Lapsehoiuteenus toetab last kasvatava isiku toimetulekut või töötamist või aitab vähendada lapse erivajadusest tulenevat hoolduskoormust.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega reguleeritakse lapsehoiuteenuse ja eralasteaias käimise toetamist (edaspidi toetus) pooleteise- kuni seitsmeaastasele lapsele, kellele Põhja-Sakala vald ei ole loonud võimalust käia teeninduspiirkonna munitsipaallasteasutuses. Lapsehoiuteenus toetab last kasvatava isiku toimetulekut või töötamist või aitab vähendada lapse erivajadusest tulenevat hoolduskoormust. 2 (2) Määrusega kehtestatakse toetuse andmise alused, toetuse suurus, toetuse taotlemise, määramise ja maksmise kord ning järelevalve toetuse kasutamise üle.",
      "estleg:enactedBy": {
