    {
      "@id": "estleg:Reg_1050284_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toetuse maksmise tingimused",
        "@language": "et"
      },
      "estleg:sourceAct": "Lapsehoiu- ja eralasteaiateenuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Toetust makstakse taotluse alusel järgmistel tingimustel: 1 1) lapsevanema, eestkostja või lepingulise hooldaja rahvastikuregistrijärgne elukoht on Põhja-Sakala vallas; 2 2) lapse, kelle jaoks toetust taotletakse, rahvastikuregistri järgne elukoht on Põhja-Sakala vallas ja ta on Põhja-Sakala valla lasteasutuse järjekorras. 2 (2) Õigus toetusele lõpeb lapsele koha tagamisel munitsipaallasteasutuses või õppima asumisel üldhariduskoolis.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetust makstakse taotluse alusel järgmistel tingimustel: 1 1) lapsevanema, eestkostja või lepingulise hooldaja rahvastikuregistrijärgne elukoht on Põhja-Sakala vallas; 2 2) lapse, kelle jaoks toetust taotletakse, rahvastikuregistri järgne elukoht on Põhja-Sakala vallas ja ta on Põhja-Sakala valla lasteasutuse järjekorras. 2 (2) Õigus toetusele lõpeb lapsele koha tagamisel munitsipaallasteasutuses või õppima asumisel üldhariduskoolis. 3 (3) Ühe lapse kohta makstakse toetust maksimaalselt 11 kalendrikuud aastas. 4 (4) Põhjendatud juhtudel on õigus määrata toetust seda vajavale perele ka kaalutlusotsuse alusel eeltoodud tingimusi arvestamata.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavolikogu"
