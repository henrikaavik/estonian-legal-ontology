      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teavikute müümine",
        "@language": "et"
      },
      "estleg:sourceAct": "Raamatukogule mittevajalike teavikute tasuta võõrandamise ja müümise kord",
      "estleg:summary": {
        "@value": "1 (1) Teavikuid müüakse vahetult raamatukogust füüsilistele ja juriidilistele isikutele. 2 (2) Müügiks väljavalitud teavikute kohta koostab raamatukogu direktor akti ja määrab müügihinna. Akt kinnitatakse raamatukogu nõukogu poolt. 3 (3) Müümisel lüüakse teavikusse raamatukogutempli kõrvale kustutustempli jäljend ning kriipsutatakse läbi senikehtinud templi jäljend ning inventari - ja vöötkoodinumber.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teavikuid müüakse vahetult raamatukogust füüsilistele ja juriidilistele isikutele. 2 (2) Müügiks väljavalitud teavikute kohta koostab raamatukogu direktor akti ja määrab müügihinna. Akt kinnitatakse raamatukogu nõukogu poolt. 3 (3) Müümisel lüüakse teavikusse raamatukogutempli kõrvale kustutustempli jäljend ning kriipsutatakse läbi senikehtinud templi jäljend ning inventari - ja vöötkoodinumber. 4 (4) Teavikute müümisel täidetakse kviitung, millest üks jääb raamatukogule ja teine antakse ostjale. 5 (5) Teavikute müügist saadud raha ja aruanne edastatakse raamatupidamisele vastavalt raamatupidamise sise-eeskirjas sätestatud korrale. 6 (6) Müümata jäänud teavikute kohta koostatakse kustutusakt.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laeva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0796"
      },
