      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada maamaksumäärad vastavalt maa sihtotstarbegruppidele alljärgnevalt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2 2) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada maamaksumäärad vastavalt maa sihtotstarbegruppidele alljärgnevalt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2 2) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mustvee_vallavolikogu"
      },
