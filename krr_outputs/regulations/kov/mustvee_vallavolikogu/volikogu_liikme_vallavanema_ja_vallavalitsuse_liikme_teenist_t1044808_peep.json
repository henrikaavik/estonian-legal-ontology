    {
      "@id": "estleg:Reg_1044808_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Lähetuse vormistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Otsuses või käskkirjas märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht ja lähetuse eesmärk. 2 (2) Välislähetuse käskkirjas märgitakse lähetuse sihtkoht, kuhu lähetatav suunatakse, lähetuse kestus, eesmärk ning lähetuskulude hüvitamise ja päevaraha määr. 3 (3) Vallavolikogu esimehe ja vallavanema käskkirja valmistab ette ning käskkirja ja alusmaterjalid säilitab valla kantselei.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Otsuses või käskkirjas märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht ja lähetuse eesmärk. 2 (2) Välislähetuse käskkirjas märgitakse lähetuse sihtkoht, kuhu lähetatav suunatakse, lähetuse kestus, eesmärk ning lähetuskulude hüvitamise ja päevaraha määr. 3 (3) Vallavolikogu esimehe ja vallavanema käskkirja valmistab ette ning käskkirja ja alusmaterjalid säilitab valla kantselei. 4 (4) Lähetus vormistatakse kooskõlas ametiasutuse asjaajamist ning raamatupidamisarvestust ja -aruandlust reguleerivates õigusaktides sätestatud nõuetega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mustvee_vallavolikogu"
      },
