    {
      "@id": "estleg:Reg_1044808_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Lähetuskulude hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulu ning muu lähetusülesande täitmisega seotud kulud avaliku teenistuse seadusel sätestatud tingimustel ja korras pärast lähetuskulude aruande esitamist ülekandega lähetatu pangaarvele või sularahas. 2 (2) Lähetuskulude aruande ja kulusid tõendavad dokumendid esitab lähetatu valla kantseleisse.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulu ning muu lähetusülesande täitmisega seotud kulud avaliku teenistuse seadusel sätestatud tingimustel ja korras pärast lähetuskulude aruande esitamist ülekandega lähetatu pangaarvele või sularahas. 2 (2) Lähetuskulude aruande ja kulusid tõendavad dokumendid esitab lähetatu valla kantseleisse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mustvee_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0486"
      },
