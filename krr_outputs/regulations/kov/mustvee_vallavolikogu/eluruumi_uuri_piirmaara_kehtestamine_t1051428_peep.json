    {
      "@id": "estleg:Reg_1051428_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üürilepingute muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluruumi üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Enne käesoleva määruse jõustumist tähtajaliselt sõlmitud sotsiaal- ja munitsipaaleluruumide üürilepingutes sätestatud üüri suurused kehtivad kuni lepingu tähtaja lõppemiseni. 2 (2) Kehtetu - RT IV 2022-04-05 7 405042022007 2022-04-08",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Enne käesoleva määruse jõustumist tähtajaliselt sõlmitud sotsiaal- ja munitsipaaleluruumide üürilepingutes sätestatud üüri suurused kehtivad kuni lepingu tähtaja lõppemiseni. 2 (2) Kehtetu - RT IV 2022-04-05 7 405042022007 2022-04-08",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mustvee_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0486"
      },
