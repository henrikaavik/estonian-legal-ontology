      "estleg:summary": {
        "@value": "1 (1) Mustvee Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel struktuuriüksus, ametnik või ametnikud käesoleva määruse § 1 lõigetes 1 ja 2 nimetatud ülesannete täitmiseks. 2 (2) Käesoleva määruse § 1 lõikes 3 nimetatud ülesandeid täidab maakorraldaja.",
        "@language": "et"
      },
