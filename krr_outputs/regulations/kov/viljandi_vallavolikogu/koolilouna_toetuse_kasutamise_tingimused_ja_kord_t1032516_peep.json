      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrus kehtestab riigieelarve ja Viljandi valla eelarve vahenditest eraldadatud koolilõuna toetuse kasutamise korra Viljandi valla munitsipaalkooli statsionaarses õppes õppivatele õpilastele.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus kehtestab riigieelarve ja Viljandi valla eelarve vahenditest eraldadatud koolilõuna toetuse kasutamise korra Viljandi valla munitsipaalkooli statsionaarses õppes õppivatele õpilastele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0899"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032516_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1032516_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1032516_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrus kehtestab riigieelarve ja Viljandi valla eelarve vahenditest eraldadatud koolilõuna toetuse kasutamise korra Viljandi valla munitsipaalkooli statsionaarses õppes õppivatele õpilastele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1032516_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1032516_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarves ette nähtud toetuse ulatuses kaetakse valla koolides põhiharidust omandavate 1.-9.klassi õpilaste koolilõuna toiduainete kulud. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viljandi valla eelarvest. 3 (3) Koolilõuna hinna kehtestab Viljandi Vallavalitsus. 4 (4) Toitlustusteenuse osutajale kaetakse koolilõuna kulud toitlustusteenuse osutamise lepingu alusel, mille sõlmib Viljandi Vallavalitsus toitlustusteenust korraldava ettevõtjaga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarves ette nähtud toetuse ulatuses kaetakse valla koolides põhiharidust omandavate 1.-9.klassi õpilaste koolilõuna toiduainete kulud. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viljandi valla eelarvest. 3 (3) Koolilõuna hinna kehtestab Viljandi Vallavalitsus. 4 (4) Toitlustusteenuse osutajale kaetakse koolilõuna kulud toitlustusteenuse osutamise lepingu alusel, mille sõlmib Viljandi Vallavalitsus toitlustusteenust korraldava ettevõtjaga.",
