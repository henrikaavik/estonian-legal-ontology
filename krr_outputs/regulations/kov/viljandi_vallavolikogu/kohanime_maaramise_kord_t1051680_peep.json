      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1(1) Kohanime määramise kord reguleerib kohanimede määramise, muutmise, kehtetuks tunnistamise ning ametliku kohanime või nimeobjekti ruumikuju muutmise Viljandi vallas kohanimeseaduse alusel. 2(2) Kohanimi määratakse kohanimeseaduses sätestatud nimeobjektidele või nimeobjektide kogumile. 3(3) Kohanime määramisel lähtutakse kohanimeseaduses sätestatud kohanimele esitatavatest nõuetest.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Kohanime määramise kord reguleerib kohanimede määramise, muutmise, kehtetuks tunnistamise ning ametliku kohanime või nimeobjekti ruumikuju muutmise Viljandi vallas kohanimeseaduse alusel. 2(2) Kohanimi määratakse kohanimeseaduses sätestatud nimeobjektidele või nimeobjektide kogumile. 3(3) Kohanime määramisel lähtutakse kohanimeseaduses sätestatud kohanimele esitatavatest nõuetest. 4(4) Kohanime muutmine, kehtetuks tunnistamine ja ametliku kohanime või nimeobjekti ruumikuju muutmine toimub samas korras nagu kohanime määramine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_vallavolikogu"
      },
