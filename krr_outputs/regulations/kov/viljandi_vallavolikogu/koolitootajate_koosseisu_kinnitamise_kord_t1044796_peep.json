    {
      "@id": "estleg:Reg_1044796_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolitöötajate koosseisu kinnitamine ja muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolitöötajate koosseisu kinnitamise kord",
      "estleg:summary": {
        "@value": "1(1) Koolitöötajate koosseisu kinnitab ja teeb selles muudatused kooli direktor, milles on arvestatud koolile kinnitatud eelarvet ning on tagatud, et õppekava oleks täidetud ja õigusaktides nõutud teenused osutatud. 2(2) Kooli direktor kooskõlastab koolitöötajate koosseisu ja selle muutused enne kinnitamist Viljandi Vallavalitsusega (täitevorgan). 3(3) Koolitöötajate koosseisu muudatused kinnitatakse hiljemalt 1. juuliks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Koolitöötajate koosseisu kinnitab ja teeb selles muudatused kooli direktor, milles on arvestatud koolile kinnitatud eelarvet ning on tagatud, et õppekava oleks täidetud ja õigusaktides nõutud teenused osutatud. 2(2) Kooli direktor kooskõlastab koolitöötajate koosseisu ja selle muutused enne kinnitamist Viljandi Vallavalitsusega (täitevorgan). 3(3) Koolitöötajate koosseisu muudatused kinnitatakse hiljemalt 1. juuliks. 4(4) Koolitöötajate koosseisu muutmisel eelarveaasta jooksul esitab kooli direktor koos taotlusega seletuskirja vähemalt kaks kuud enne muudatuste sisseviimist Viljandi Vallavalitsuse ametiasutusele, näidates koolitöötajate koosseisu suurendamisel ära vahendid, millest kaetakse täiendav personalikulu. Kui taotlus on põhjendatud, kooskõlastatakse taotlus vastavalt määruse § 2 lõikele 2.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0899"
