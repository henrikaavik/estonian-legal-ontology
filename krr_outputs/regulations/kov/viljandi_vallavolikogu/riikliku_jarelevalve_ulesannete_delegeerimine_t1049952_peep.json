      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Riikliku järelevalve ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Riikliku järelevalve ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1(1) Delegeerida Viljandi Vallavalitsusele seadusega kohaliku omavalitsuse, kohaliku omavalitsusüksuse, kohaliku omavalitsusorgani või kohaliku omavalitsusasutuse pädevusse antud riikliku järelevalve ülesannete täitmine. 2(2) Viljandi Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud riikliku järelevalve ülesannete täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Delegeerida Viljandi Vallavalitsusele seadusega kohaliku omavalitsuse, kohaliku omavalitsusüksuse, kohaliku omavalitsusorgani või kohaliku omavalitsusasutuse pädevusse antud riikliku järelevalve ülesannete täitmine. 2(2) Viljandi Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud riikliku järelevalve ülesannete täitmine.",
