      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Viljandi valla territooriumil maa sihtotstarbegruppidele maksumäärad alljärgnevalt: 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5% maa maksustamishinnast aastas; 2) punktis 1 nimetamata maatulundusmaale 0,5% maa maksustamishinnast aastas; 3) punktides 1 ja 2 nimetamata sihtotstarbega maale 1% maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Viljandi valla territooriumil maa sihtotstarbegruppidele maksumäärad alljärgnevalt: 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5% maa maksustamishinnast aastas; 2) punktis 1 nimetamata maatulundusmaale 0,5% maa maksustamishinnast aastas; 3) punktides 1 ja 2 nimetamata sihtotstarbega maale 1% maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
