    {
      "@id": "estleg:Reg_1021363_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Kohanimede määramine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanimede määramine ja liikluspinna mõjuala muutmine",
      "estleg:summary": {
        "@value": "1 (1) Määrata kohanimi Veski põik Kuressaare linna omandis olevale Veski tänav L3 katastriüksusel 34901:010:0536 asuvale liikluspinnale, mis algab Veski tn 5 ja Veski tn 8 katastriüksuste vahelt ja kulgeb kuni Veski tn 7a katastriüksuseni vastavalt lisatud asendiplaanile (lisa 1). 2 (2) Määrata kohanimi Ravila põik liikluspinnale, planeeritavale tänavale, mis ühendab Ravila tänava Paju tänavaga vastavalt Ravila tn 23 detailplaneeringule (lisa 2). 3 (3) Muuta liikluspinna Veski tänav mõjuala.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrata kohanimi Veski põik Kuressaare linna omandis olevale Veski tänav L3 katastriüksusel 34901:010:0536 asuvale liikluspinnale, mis algab Veski tn 5 ja Veski tn 8 katastriüksuste vahelt ja kulgeb kuni Veski tn 7a katastriüksuseni vastavalt lisatud asendiplaanile (lisa 1). 2 (2) Määrata kohanimi Ravila põik liikluspinnale, planeeritavale tänavale, mis ühendab Ravila tänava Paju tänavaga vastavalt Ravila tn 23 detailplaneeringule (lisa 2). 3 (3) Muuta liikluspinna Veski tänav mõjuala. Veski tänav asub katastriüksusel 34901:010:0536. Kinnitada liikluspinna Veski tänav mõjuala vastavalt lisatud asendiplaanile (lisa 3).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kuressaare_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0714"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1021363_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1021363_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_1021363_Par_1_Lg_2"
        },
        {
          "@id": "estleg:Reg_1021363_Par_1_Lg_3"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1021363_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrata kohanimi Veski põik Kuressaare linna omandis olevale Veski tänav L3 katastriüksusel 34901:010:0536 asuvale liikluspinnale, mis algab Veski tn 5 ja Veski tn 8 katastriüksuste vahelt ja kulgeb kuni Veski tn 7a katastriüksuseni vastavalt lisatud asendiplaanile (lisa 1).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1021363_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1021363_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrata kohanimi Ravila põik liikluspinnale, planeeritavale tänavale, mis ühendab Ravila tänava Paju tänavaga vastavalt Ravila tn 23 detailplaneeringule (lisa 2).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1021363_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1021363_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Muuta liikluspinna Veski tänav mõjuala. Veski tänav asub katastriüksusel 34901:010:0536. Kinnitada liikluspinna Veski tänav mõjuala vastavalt lisatud asendiplaanile (lisa 3).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1021363_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
