      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrata kohanimi Roomassaare kergliiklustee liikluspinnale, mis asub Väike-Roomassaare poolsaarel (lisa 2).",
      "estleg:parentProvision": {
