      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Kohanimede andmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanimede määramine",
      "estleg:summary": {
        "@value": "1(1)Anda kohanimi Pootsmani tänav detailplaneeringus kavandatud liikluspinnale vastavalt juurdelisatud skeemile (lisa 1). 2(2)Anda kohanimi Madruse tee detailplaneeringus kavandatud liikluspinnale vastavalt juurdelisatud skeemile (lisa 2). 3(3)Anda kohanimi Junga tänav detailplaneeringus kavandatud liikluspinnale vastavalt juurdelisatud skeemile (lisa 3). 4(4)Anda kohanimi Kuressaare supelrand olemasolevale rannaalale vastavalt juurdelisatud skeemile (lisa 4).",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Anda kohanimi Pootsmani tänav detailplaneeringus kavandatud liikluspinnale vastavalt juurdelisatud skeemile (lisa 1). 2(2)Anda kohanimi Madruse tee detailplaneeringus kavandatud liikluspinnale vastavalt juurdelisatud skeemile (lisa 2). 3(3)Anda kohanimi Junga tänav detailplaneeringus kavandatud liikluspinnale vastavalt juurdelisatud skeemile (lisa 3). 4(4)Anda kohanimi Kuressaare supelrand olemasolevale rannaalale vastavalt juurdelisatud skeemile (lisa 4). 5(5)Anda kohanimi Laiamadala saar vastavalt juurdelisatud skeemile (lisa 5). 6(6)Anda kohanimi Koja bussipeatustele vastavalt juurdelisatud skeemile (lisa 6).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kuressaare_linnavolikogu"
