    {
      "@id": "estleg:Reg_1033996_Par_11",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1033996",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 11.",
      "rdfs:label": "§ 11. Õpilaste ühistransporditoetus",
      "estleg:sourceAct": "Sotsiaaltoetuste maksmise kord",
      "estleg:summary": "1 (1) Ühistransporditoetust linnasisesel kommertsliiniveol võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavatele Kuressaare linna üldhariduskoolide ja Kuressaare Ametikoolis põhikooli baasil kutseharidust omandavale õpilasele õppeperioodil. Ühistransporditoetust linnasisesel kommertsliiniveol võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavatele Kuressaare linna üldhariduskoolide ja Kuressaare Ametikoolis põhikooli baasil kutseharidust omandavale õpilasele õppeper",
      "estleg:legalText": "1 (1) Ühistransporditoetust linnasisesel kommertsliiniveol võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavatele Kuressaare linna üldhariduskoolide ja Kuressaare Ametikoolis põhikooli baasil kutseharidust omandavale õpilasele õppeperioodil. Ühistransporditoetust linnasisesel kommertsliiniveol võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavatele Kuressaare linna üldhariduskoolide ja Kuressaare Ametikoolis põhikooli baasil kutseharidust omandavale õpilasele õppeperioodil. 2 (2) Ühistransporditoetus maakonnaliinidel võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavale, kuid mitte Kuressaare linnas asuvas koolis põhiharidust omandavale õpilasele. Ühistransporditoetus maakonnaliinidel võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavale, kuid mitte Kuressaare linnas asuvas koolis põhiharidust omandavale õpilasele. 3 (3) Toetuse taotleja esitab sotsiaalosakonnale kirjaliku taotluse. Toetuse taotleja esitab sotsiaalosakonnale kirjaliku taotluse.",
      "estleg:enactedBy": {
