      "estleg:paragrahv": "§ 11.",
      "rdfs:label": {
        "@value": "§ 11. Õpilaste ühistransporditoetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Sotsiaaltoetuste maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Ühistransporditoetust linnasisesel kommertsliiniveol võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavatele Kuressaare linna üldhariduskoolide ja Kuressaare Ametikoolis põhikooli baasil kutseharidust omandavale õpilasele õppeperioodil. 2 (2) Ühistransporditoetus maakonnaliinidel võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavale, kuid mitte Kuressaare linnas asuvas koolis põhiharidust omandavale õpilasele.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ühistransporditoetust linnasisesel kommertsliiniveol võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavatele Kuressaare linna üldhariduskoolide ja Kuressaare Ametikoolis põhikooli baasil kutseharidust omandavale õpilasele õppeperioodil. 2 (2) Ühistransporditoetus maakonnaliinidel võimaldatakse rahvastikuregistri järgselt Kuressaare linnas elavale, kuid mitte Kuressaare linnas asuvas koolis põhiharidust omandavale õpilasele. 3 (3) Toetuse taotleja esitab sotsiaalosakonnale kirjaliku taotluse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kuressaare_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0714"
