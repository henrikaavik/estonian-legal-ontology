    {
      "@id": "estleg:Reg_1050724_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hooldekodu juhtimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Tartu Hooldekodu põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Hooldekodu juhib juhataja. 2(2)Hooldekodu juhataja:11) tagab põhimääruses ettenähtud ülesannete täitmise ning hooldekodu tulemusliku tegutsemise ja arengu;22) vastutab hooldekodu üldseisundi, teenuste kvaliteedi, raha õigus- ja sihipärase ning otstarbeka kasutamise, hooldekodule kasutada antud linnavara heaperemeheliku majandamise, kasutamise, säilimise ja korrashoiu eest;33) esindab hooldekodu ja teeb põhimääruses nimetatud tegevusvaldkonda arvestades hooldekodu ülesannete täitmiseks…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Hooldekodu juhib juhataja. 2(2)Hooldekodu juhataja:11) tagab põhimääruses ettenähtud ülesannete täitmise ning hooldekodu tulemusliku tegutsemise ja arengu;22) vastutab hooldekodu üldseisundi, teenuste kvaliteedi, raha õigus- ja sihipärase ning otstarbeka kasutamise, hooldekodule kasutada antud linnavara heaperemeheliku majandamise, kasutamise, säilimise ja korrashoiu eest;33) esindab hooldekodu ja teeb põhimääruses nimetatud tegevusvaldkonda arvestades hooldekodu ülesannete täitmiseks vajalikke toiminguid ning tehinguid;44) koostab ja kooskõlastab Tartu Linnavalitsuse sotsiaal- ja tervishoiuosakonnaga asutuse osutatavate teenuste kirjeldused, sh tegevuste kirjeldused, kui teenuse osutamiseks ei ole vaja õigusaktidest tulenevalt korda kehtestada ja tagab kirjelduste ajakohasuse;55) kinnitab hooldekodu töökorralduse reeglid ja vajadusel palgajuhendi;66) tagab hooldekodus tööohutuse ja töötervishoiu alaste nõuete täitmise;77) kinnitab hooldekodu töötajate ametijuhendid ja täidab töötajate suhtes tööandja ülesandeid;88) korraldab hooldekodu eelarvetaotluse koostamise ja tagab selle esitamise linnavalitsusele;99) sõlmib lepingud hooldusteenuse osutamiseks;1010) korraldab hooldusplaanide ja hooldustoimingute kirjelduste koostamise;1111) tagab õigusaktidega ette nähtud aruannete koostamise ja esitamise;1212) täidab muid linnavalitsuse antud, oma ametikohast ja õigusaktidest tulenevaid kohustusi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0793"
