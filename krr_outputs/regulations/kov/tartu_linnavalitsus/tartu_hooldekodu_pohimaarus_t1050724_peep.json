    {
      "@id": "estleg:Reg_1050724_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Hooldekodu juhib juhataja.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1050724_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
        {
