      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Asutuse ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Anne Sauna põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Asutuse ülesanne on saunateenuse osutamine Anne tn 44 saunas. 2 (2) Asutuse tegevused on järgmised: 1 1) avaliku sauna teenuse osutamine; 2 2) vähekindlustatud isikutele tasuta saunapäevade korraldamine; 3 3) saunateenusega kaasnevate teenuste osutamine; 4 4) saunahoone kujundamine ühtseks keskuseks, mis koondaks saunateenusega sobivaid teenuseid.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Asutuse ülesanne on saunateenuse osutamine Anne tn 44 saunas. 2 (2) Asutuse tegevused on järgmised: 1 1) avaliku sauna teenuse osutamine; 2 2) vähekindlustatud isikutele tasuta saunapäevade korraldamine; 3 3) saunateenusega kaasnevate teenuste osutamine; 4 4) saunahoone kujundamine ühtseks keskuseks, mis koondaks saunateenusega sobivaid teenuseid.",
