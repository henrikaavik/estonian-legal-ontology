    {
      "@id": "estleg:Reg_1050174_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Keskuse direktor",
        "@language": "et"
      },
      "estleg:sourceAct": "Tartu Noorsootöö Keskuse põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Keskust juhib direktor. 2(2)Direktor:11) juhib keskust, tagades põhimääruses ettenähtud ülesannete täitmise ning keskuse tulemusliku tegutsemise ja arengu;22) vastutab keskuse üldseisundi, keskuse raha õigus- ja sihipärase ning otstarbeka kasutamise, keskusele kasutada antud linnavara heaperemeheliku majandamise, kasutamise, säilimise ning korrashoiu eest;33) esindab keskust ning teeb põhimääruses nimetatud tegevusvaldkonda arvestades keskuse ülesannete täitmiseks vajalikke toiminguid ning…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Keskust juhib direktor. 2(2)Direktor:11) juhib keskust, tagades põhimääruses ettenähtud ülesannete täitmise ning keskuse tulemusliku tegutsemise ja arengu;22) vastutab keskuse üldseisundi, keskuse raha õigus- ja sihipärase ning otstarbeka kasutamise, keskusele kasutada antud linnavara heaperemeheliku majandamise, kasutamise, säilimise ning korrashoiu eest;33) esindab keskust ning teeb põhimääruses nimetatud tegevusvaldkonda arvestades keskuse ülesannete täitmiseks vajalikke toiminguid ning tehinguid;44) koostab ja kooskõlastab kultuuriosakonnaga keskuse osutatavate teenuste kirjeldused, kui teenuse osutamiseks ei ole vaja õigusaktidest tulenevalt korda kehtestada ning tagab teenuste ning nende kirjelduse ajakohasuse;55) kinnitab keskuse töötajate koosseisu;66) kinnitab keskuse töökorralduse reeglid ja vajadusel palgajuhendi;77) tagab keskuses tööohutuse ning töötervishoiu alaste nõuete täitmise;88) kinnitab keskuse töötajate ametijuhendid ning täidab töötajate suhtes tööandja ülesandeid;99) korraldab keskuse eelarvetaotluse koostamise ja tagab selle esitamise linnavalitsusele;1010) korraldab keskuse arengukava koostamise ning tagab arengukava projekti esitamise linnavalitsusele;1111) koostab iga kalendriaasta lõpus järgmise kalendriaasta tegevusplaani;1212) tagab õigusaktidega ette nähtud aruannete koostamise ja esitamise;1313) täidab muid linnavalitsuse antud, oma ametikohast ning õigusaktidest tulenevaid kohustusi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_linnavalitsus"
      },
