    {
      "@id": "estleg:Reg_1062229_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Kord sätestab Kuusalu valla haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöökorralduse. 2(2)Korda rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muu omavalitsuse koolis.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kord sätestab Kuusalu valla haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöökorralduse. 2(2)Korda rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muu omavalitsuse koolis.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kuusalu_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0353"
      },
