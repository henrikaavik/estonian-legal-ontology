          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1062229_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppimiskohustuse seire ja toetavate meetmete pakkumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Koolitöötajad algatavad lapse õppimiskohustuse mittetäimise korral hindamise, rakendavad toetavaid meetmeid ning vajadusel teavitavad kohalikku omavalitsust. 2(2)Õppimiskohustuse täitmise seiret kohalikus omavalitsuses koordineerib juhtiv haridusspetsialist. 3(3)Õppimiskohustuse tagamiseks vajalikke tugiteenuseid korraldavad ja osutavad Kuusalu Hariduse Tugikeskuse spetsialistid ja vallavalitsuse laste heaolu spetsialistid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Koolitöötajad algatavad lapse õppimiskohustuse mittetäimise korral hindamise, rakendavad toetavaid meetmeid ning vajadusel teavitavad kohalikku omavalitsust. 2(2)Õppimiskohustuse täitmise seiret kohalikus omavalitsuses koordineerib juhtiv haridusspetsialist. 3(3)Õppimiskohustuse tagamiseks vajalikke tugiteenuseid korraldavad ja osutavad Kuusalu Hariduse Tugikeskuse spetsialistid ja vallavalitsuse laste heaolu spetsialistid. 4(4)Õppimiskohustuse mittetäitmisel kaasatakse toetavate meetmete rakendamisel lapse seaduslik esindaja. 5(5)Kui õppimiskohustuslik laps õpib väljaspool elukohajärgset omavalitsust, tehakse koostööd vastava kohaliku omavalitsusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kuusalu_vallavalitsus"
      },
