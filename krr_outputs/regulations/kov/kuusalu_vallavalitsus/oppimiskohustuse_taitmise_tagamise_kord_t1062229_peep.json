        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Õppimiskohustuse täitmise seiret kohalikus omavalitsuses koordineerib juhtiv haridusspetsialist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062229_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:targetGroup": [
