      }
    },
    {
      "@id": "estleg:Reg_1062229_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Õppimiskohustuse tagamiseks vajalikke tugiteenuseid korraldavad ja osutavad Kuusalu Hariduse Tugikeskuse spetsialistid ja vallavalitsuse laste heaolu spetsialistid.",
      "estleg:parentProvision": {
