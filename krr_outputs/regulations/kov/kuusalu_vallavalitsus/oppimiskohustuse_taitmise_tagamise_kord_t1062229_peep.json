      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Õppimiskohustuse mittetäitmisel kaasatakse toetavate meetmete rakendamisel lapse seaduslik esindaja.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062229_Par_2"
