    {
      "@id": "estleg:Reg_1046239_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Noortekeskuse tegevust juhib ja korraldab noorsootöö koordinaator, kes võetakse tööle avaliku konkursi korras. Konkursi kuulutab välja ja tulemused kinnitab vallavalitsus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046239_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_kuusalu_vallavalitsus"
        }
      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1046239_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Koordinaatoriga sõlmib, peatab, muudab ja ütleb üles töölepingu vallavanem.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046239_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1046239_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Koordinaatori tööülesanded lepitakse kokku temaga sõlmitava töölepingu lisaks olevas ametijuhendis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046239_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1046239_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Koordinaatorit asendab vallavanema poolt määratud isik.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046239_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:targetGroup": [
