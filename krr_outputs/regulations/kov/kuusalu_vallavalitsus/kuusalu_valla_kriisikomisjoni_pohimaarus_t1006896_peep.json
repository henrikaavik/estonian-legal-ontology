    {
      "@id": "estleg:Reg_1006896_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Komisjoni ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Kuusalu valla kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "Komisjon: 1 1) täidab hädaolukorra seadusest tulenevaid omavalitsusele pandud ülesandeid; 2 2) juhib hädaolukordade lahendamist oma vastutusalas; 3 3) tagab hädaolukorras abivajajate väljaselgitamise ja nende abistamise; 4 4) vaatab läbi hädaolukorra lahendamise plaanid ning korraldab seal kirjeldatud omavalitsuse ülesannete täitmise; 5 5) koostab vastavalt riskianalüüsile elanike ümberpaigutamise plaani omavalitsuse territooriumil hädaolukorras; 6 6) koostab ja korrastab informatsiooni…",
        "@language": "et"
      },
      "estleg:legalText": "Komisjon: 1 1) täidab hädaolukorra seadusest tulenevaid omavalitsusele pandud ülesandeid; 2 2) juhib hädaolukordade lahendamist oma vastutusalas; 3 3) tagab hädaolukorras abivajajate väljaselgitamise ja nende abistamise; 4 4) vaatab läbi hädaolukorra lahendamise plaanid ning korraldab seal kirjeldatud omavalitsuse ülesannete täitmise; 5 5) koostab vastavalt riskianalüüsile elanike ümberpaigutamise plaani omavalitsuse territooriumil hädaolukorras; 6 6) koostab ja korrastab informatsiooni omavalitsusüksuses paiknevatest kriisireguleerimisalastest ressurssidest; 7 7) omab ülevaadet omavalitsuse territooriumil paiknevatest suurõnnetuse ohuga ja ohtlikest ettevõtetest ning nendest tulenevatest ohtudest; 8 8) vaatab läbi ja annab hinnanguid valla planeeringutele, mis on seotud kemikaaliohutusega; 9 9) korraldab ennetusmeetmete rakendamise ja riskikommunikatsiooni, sealhulgas elanike informeerimise võimalikest hädaolukordadest, nende mõjudest ning käitumisjuhistest hädaolukorras lähtuvalt riskianalüüsidest; 10 10) teavitab elanikke elutähtsa teenuse toimepidevuse häiretest; 11 11) teavitab elanikke kriisikomisjoni tegevustest; 12 12) korraldab kriisireguleerimise alaseid koolitusi, seminare ja teabepäevi ning teeb volikogule ettepanekuid selleks vahendite eraldamiseks; 13 13) korraldab omavalitsuse kriisireguleerimisõppuse; 14 14) teeb koostööd teiste kriisikomisjonidega; 15 15) kinnitab vajaduse komisjoni tööplaani; 16 16) kinnitab ja esitab komisjoni tegevuse kokkuvõtteid päästekeskusele; 17 17) täidab muid seadusest ja põhimäärusest tulenevaid ülesandeid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kuusalu_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0353"
