      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1061076_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Osalustasu maksmisest vabastamist võimaldatakse Jõhvi valla sotsiaalteenistuses arvel olevatele toimetulekuraskustega peredele, eestkoste-, hooldus- ja lasterikastele (3 ja enam last) ning raske ja sügava puudega lastega peredele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061076_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1061076_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Toimetulekuraskustega pered ning raske ja sügava puudega lastega pered vabastatakse 100% ulatuses osalustasu tasumisest. Kui perest käib lasteaias samaaegselt kaks või enam last, tasub vanem osalustasu esimese lapse eest 100%, teise lapse eest 50% kehtestatud määrast ja kolmanda ning järgnevate laste eest osalustasu ei arvestata.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061076_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1061076_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Erandkorras põhjendatud juhtumi korral võib osalustasu maksmisest vabastada juhul, kui laps lasteaias faktiliselt ei käi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061076_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      }
    },
    {
      "@id": "estleg:Reg_1061076_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Osalustasu maksmisest vabastamise või vähendamise taotlemine toimub e-keskkonna ARNO kaudu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061076_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
    {
      "@id": "estleg:Reg_1061076_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Vallavalitsuse vastav ametnik kontrollib soodustuse kohaldamise aluseks olevaid asjaolusid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061076_Par_4"
      },
      "rdfs:label": "§ 4 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_johvi_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061076_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Otsuse osalustasust osalise või täielikult vabastuse kohta teeb Jõhvi vallavalitsus korralduse andmisega. Vallavalitsus rakendab soodustust selle andmise aluseks olevate asjaolude teatavaks saamisele järgnevast kuust ja lõpetab soodustuse andmise asjaolude muutumisele järgnevast kuust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061076_Par_4"
      },
      "rdfs:label": "§ 4 lg 6",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_johvi_vallavalitsus"
        }
      ],
      "estleg:competenceType": "general"
    },
