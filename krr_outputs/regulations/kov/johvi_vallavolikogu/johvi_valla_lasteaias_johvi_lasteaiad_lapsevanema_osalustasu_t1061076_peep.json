          "@id": "estleg:Reg_1061076_Par_4_Lg_6"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_johvi_vallavalitsus"
