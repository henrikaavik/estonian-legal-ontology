    {
      "@id": "estleg:Reg_1063446_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest ning ei sisalda eluruumi kasutamisega seotud kõrvalkulusid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063446_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1063446_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Jõhvi valla haldusterritooriumil asuvate munitsipaalomandis olevate eluruumide üüri piirmääraks kehtestatakse 5 eurot ühe ruutmeetri kohta ühes kuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063446_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1063446_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Konkreetse eluruumi üüri suuruse määrab Jõhvi Vallavalitsus eluruumi üürile andmisel korraldusega, arvestades eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega ning veevarustuse ja kanalisatsiooni olemasolu, heakorda ja muid asjaolusid, sh üürniku sotsiaalset toimetulekut.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063446_Par_1"
      },
      "rdfs:label": "§ 1 lg 3",
