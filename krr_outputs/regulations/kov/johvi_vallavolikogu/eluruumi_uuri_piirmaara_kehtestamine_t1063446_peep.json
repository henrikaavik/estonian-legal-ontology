    {
      "@id": "estleg:Reg_1063446_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üüri piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluruumi üüri piirmäära kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063446_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest ning ei sisalda eluruumi kasutamisega seotud kõrvalkulusid. 2 (2) Jõhvi valla haldusterritooriumil asuvate munitsipaalomandis olevate eluruumide üüri piirmääraks kehtestatakse 5 eurot ühe ruutmeetri kohta ühes kuus. 3 (3) Konkreetse eluruumi üüri suuruse määrab Jõhvi Vallavalitsus eluruumi üürile andmisel korraldusega, arvestades eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega ning veevarustuse…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest ning ei sisalda eluruumi kasutamisega seotud kõrvalkulusid. 2 (2) Jõhvi valla haldusterritooriumil asuvate munitsipaalomandis olevate eluruumide üüri piirmääraks kehtestatakse 5 eurot ühe ruutmeetri kohta ühes kuus. 3 (3) Konkreetse eluruumi üüri suuruse määrab Jõhvi Vallavalitsus eluruumi üürile andmisel korraldusega, arvestades eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega ning veevarustuse ja kanalisatsiooni olemasolu, heakorda ja muid asjaolusid, sh üürniku sotsiaalset toimetulekut.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063446_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_1063446_Par_1_Lg_2"
