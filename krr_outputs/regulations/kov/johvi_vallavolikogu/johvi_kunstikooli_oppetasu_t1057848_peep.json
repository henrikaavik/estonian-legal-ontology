      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Õppetasu suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõhvi Kunstikooli õppetasu",
      "estleg:summary": {
        "@value": "Kehtestada Jõhvi Kunstikoolis õppekulu osaliseks katmiseks lapsevanema makstava õppetasu suurus järgmiselt: 1 1) ettevalmistuskursusel 15 eurot kuus õpilase kohta; RT IV2024-06-0144010620240042024-09-01 2 2) põhikursustel, täiendkursusel 25 eurot kuus õpilase kohta; RT IV2024-06-0144010620240042024-09-01 3 3) vanemale kui 19 aastasele õppurile 35 eurot kuus. RT IV2024-06-0144010620240042024-09-01",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Jõhvi Kunstikoolis õppekulu osaliseks katmiseks lapsevanema makstava õppetasu suurus järgmiselt: 1 1) ettevalmistuskursusel 15 eurot kuus õpilase kohta; RT IV2024-06-0144010620240042024-09-01 2 2) põhikursustel, täiendkursusel 25 eurot kuus õpilase kohta; RT IV2024-06-0144010620240042024-09-01 3 3) vanemale kui 19 aastasele õppurile 35 eurot kuus. RT IV2024-06-0144010620240042024-09-01",
      "estleg:enactedBy": {
