      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1062992_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Volitused vallavalitsusele",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõhvi valla 2026. aasta eelarve vastuvõtmine",
      "estleg:summary": {
        "@value": "1 (1) Võtta 2026. aasta põhivara soetuse omaosaluse katteks laenu mahus kuni 1 325 500 eurot ning volitada vallavanemat sõlmima vastavat lepingut. 2 (2) Lubada vallavalitsusel alaeelarvetega kinnitada hallatavate asutuste ja struktuuriüksuste tulude ja kulude detailsem jaotus tegevusalade ja kontogruppide lõikes.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Võtta 2026. aasta põhivara soetuse omaosaluse katteks laenu mahus kuni 1 325 500 eurot ning volitada vallavanemat sõlmima vastavat lepingut. 2 (2) Lubada vallavalitsusel alaeelarvetega kinnitada hallatavate asutuste ja struktuuriüksuste tulude ja kulude detailsem jaotus tegevusalade ja kontogruppide lõikes.",
