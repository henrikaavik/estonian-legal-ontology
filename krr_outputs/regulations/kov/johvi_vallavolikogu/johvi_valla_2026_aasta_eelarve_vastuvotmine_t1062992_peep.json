      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Jõhvi valla 2026. aasta eelarve",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõhvi valla 2026. aasta eelarve vastuvõtmine",
      "estleg:summary": {
        "@value": "Võtta vastu Jõhvi valla 2026. aasta vallaeelarve kogumahuga 42 697 686 (nelikümmend kaks miljonit kuussada üheksakümmend seitse tuhat kuussada kaheksakümmend kuus) eurot vastavalt lisadele 1 (koondeelarve) ja 2 (alaeelarved).",
        "@language": "et"
      },
      "estleg:legalText": "Võtta vastu Jõhvi valla 2026. aasta vallaeelarve kogumahuga 42 697 686 (nelikümmend kaks miljonit kuussada üheksakümmend seitse tuhat kuussada kaheksakümmend kuus) eurot vastavalt lisadele 1 (koondeelarve) ja 2 (alaeelarved).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_johvi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0251"
