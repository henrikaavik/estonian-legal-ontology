      "rdfs:label": {
        "@value": "§ 1. Vaimse tervise teenused",
        "@language": "et"
      },
      "estleg:sourceAct": "Vaimse tervise teenuste osutamine ja rahastamine Kiili vallas",
      "estleg:summary": {
        "@value": "Kiili valla poolt pakutavad vaimse tervise teenused on järgmised: 1 1) pereteraapia teenus; 2 2) kogukonnapsühholoogi teenus; 3 3) kunstiteraapia teenus lastele kuni 18. eluaastani.",
        "@language": "et"
      },
      "estleg:legalText": "Kiili valla poolt pakutavad vaimse tervise teenused on järgmised: 1 1) pereteraapia teenus; 2 2) kogukonnapsühholoogi teenus; 3 3) kunstiteraapia teenus lastele kuni 18. eluaastani.",
