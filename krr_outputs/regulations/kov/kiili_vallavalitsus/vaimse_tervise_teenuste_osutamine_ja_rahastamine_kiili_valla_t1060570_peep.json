    {
      "@id": "estleg:Reg_1060570_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teenuse korraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Vaimse tervise teenuste osutamine ja rahastamine Kiili vallas",
      "estleg:summary": {
        "@value": "1 (1) Teenusele saab isik ise või tema seadusjärgne ülalpidaja registreerida veebis Kiili vallaga koostöölepingu sõlminud teenuseosutajate broneerimiskeskkonna kaudu või telefoni teel. 2 (2) Kunstiteraapia ja kogukonnapsühholoogi teenus on Kiili valla elanikele tasuta kuni 5 teenusetunni ulatuses. 3 (3) Pereteraapia teenus on tasuta kuni 10 teenusetunni ulatuses pere kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenusele saab isik ise või tema seadusjärgne ülalpidaja registreerida veebis Kiili vallaga koostöölepingu sõlminud teenuseosutajate broneerimiskeskkonna kaudu või telefoni teel. 2 (2) Kunstiteraapia ja kogukonnapsühholoogi teenus on Kiili valla elanikele tasuta kuni 5 teenusetunni ulatuses. 3 (3) Pereteraapia teenus on tasuta kuni 10 teenusetunni ulatuses pere kohta. 4 (4) Juhul, kui isik või pere vajab suuremas mahus teenust, siis on kohaliku omavalitsuse sot-siaalvaldkonna ametnikul õigus isikule või perele osutatava teenuse mahtu suurendada kokkuleppel teenuseosutajaga.",
