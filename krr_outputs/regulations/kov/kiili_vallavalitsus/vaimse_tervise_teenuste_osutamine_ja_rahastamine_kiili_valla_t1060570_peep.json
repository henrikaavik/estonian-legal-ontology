    {
      "@id": "estleg:Reg_1060570_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Teenuse rahastamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Vaimse tervise teenuste osutamine ja rahastamine Kiili vallas",
      "estleg:summary": {
        "@value": "1 (1) Teenust rahastatakse Kiili valla eelarvest, mis koosneb toetusfondist laekunud vaimse tervi-se toetuse vahenditest ja Kiili valla omavahenditest. 2 (2) Kui isik tühistab teenuse broneeringu vähem kui 24h või kui isik ei ilmu broneeritud ajal teenuseosutaja vastuvõtule, siis tuleb teenust broneerinud isikul tasuda teenuse eest teenu-seosutaja poolt esitatud arve alusel vastavalt kehtivale hinnakirjale.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenust rahastatakse Kiili valla eelarvest, mis koosneb toetusfondist laekunud vaimse tervi-se toetuse vahenditest ja Kiili valla omavahenditest. 2 (2) Kui isik tühistab teenuse broneeringu vähem kui 24h või kui isik ei ilmu broneeritud ajal teenuseosutaja vastuvõtule, siis tuleb teenust broneerinud isikul tasuda teenuse eest teenu-seosutaja poolt esitatud arve alusel vastavalt kehtivale hinnakirjale.",
