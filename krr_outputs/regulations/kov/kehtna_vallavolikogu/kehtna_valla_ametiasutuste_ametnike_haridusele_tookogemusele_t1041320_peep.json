    {
      "@id": "estleg:Reg_1041320_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Nõuded oskustele",
        "@language": "et"
      },
      "estleg:sourceAct": "Kehtna valla ametiasutuste ametnike haridusele, töökogemusele, teadmistele ja oskustele esitatavad nõuded",
      "estleg:summary": {
        "@value": "1(1)Ametnik peab oskama:11) kasutada arvutit, sealhulgas ametikohal vajalike teksti- ja tabeltöötlusprogrammide ning teiste arvutiprogrammide ja andmekogude kasutamise oskus;22) koostada õigusaktide eelnõusid ja haldusakte ning teadma ja järgima haldusmenetlusele kehtestatud reegleid;33) eesti keelt kõrgtasemel ja ühte võõrkeelt suhtlustasandil. 2(2)Ametniku teadmised ja oskused peavad olema kaasaegsed, võimaldamaks töötada kaasaegses keskkonnas.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Ametnik peab oskama:11) kasutada arvutit, sealhulgas ametikohal vajalike teksti- ja tabeltöötlusprogrammide ning teiste arvutiprogrammide ja andmekogude kasutamise oskus;22) koostada õigusaktide eelnõusid ja haldusakte ning teadma ja järgima haldusmenetlusele kehtestatud reegleid;33) eesti keelt kõrgtasemel ja ühte võõrkeelt suhtlustasandil. 2(2)Ametniku teadmised ja oskused peavad olema kaasaegsed, võimaldamaks töötada kaasaegses keskkonnas. 3(3)Ametnikul peab olema väga hea suhtlemisoskus, sealhulgas oskus koostööks avalike huvide elluviimisel. Hea väljendus- ja kuulamisoskus, oskus säilitada rahu probleemsetes olukordades ning motiveerida oma seisukohti arusaadavalt. 4(4)Ametnik peab hoidma oma erialase valdkonna piires kursis toimuvate muudatuste ja nõuetega, ning olema valmis enda eri-, kutse- ja ametialase enesetäiendamiseks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kehtna_vallavolikogu"
      },
