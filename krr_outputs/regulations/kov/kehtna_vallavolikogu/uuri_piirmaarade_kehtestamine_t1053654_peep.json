      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üüri piirmäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtna valla omandis olevate eluruumide üüri piirmäärad ühes kuus on: 1 1) keskkütte ning ühisveevärgiga ühendatud eluruumil 3 eurot/m²; 2 2) keskkütteta ja ühisveevärgi ühendusega eluruumil 1.50 eurot/m²; 3 3) keskkütteta ja ühisveevärgi ühenduseta eluruumil 1.35 eurot/m².",
        "@language": "et"
      },
      "estleg:legalText": "Kehtna valla omandis olevate eluruumide üüri piirmäärad ühes kuus on: 1 1) keskkütte ning ühisveevärgiga ühendatud eluruumil 3 eurot/m²; 2 2) keskkütteta ja ühisveevärgi ühendusega eluruumil 1.50 eurot/m²; 3 3) keskkütteta ja ühisveevärgi ühenduseta eluruumil 1.35 eurot/m².",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kehtna_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0293"
