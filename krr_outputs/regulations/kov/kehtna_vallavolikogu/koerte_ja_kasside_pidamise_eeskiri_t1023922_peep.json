    },
    {
      "@id": "estleg:Reg_1023922_Par_1_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Määrus ei laiene seadusega sätestatud alustel teenistuskoera erivahendina kasutamisel ning juhul, kui teenistuskoera pidamiseks on seadusega sätestatud teistsugused nõuded.",
      "estleg:parentProvision": {
