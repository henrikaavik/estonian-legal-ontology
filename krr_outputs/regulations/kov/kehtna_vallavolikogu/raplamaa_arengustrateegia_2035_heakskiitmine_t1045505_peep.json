      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Raplamaa arengustrateegia 2035+ heakskiitmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Raplamaa arengustrateegia 2035+ heakskiitmine",
      "estleg:summary": {
        "@value": "1 (1) Kiita heaks Raplamaa arengustrateegia 2035+ vastavalt määruse lisale 1. 2 (2) Kehtna Vallavalitsus avalikustab Raplamaa Omavalitsuste Liidu Täiskogu, Kehtna Vallavolikogu ja volikogu komisjonide istungite protokollid ja teabe arengustrateegia menetlemise kohta valla veebilehel seitsme tööpäeva jooksul arengustrateegia vastuvõtmisest arvates.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kiita heaks Raplamaa arengustrateegia 2035+ vastavalt määruse lisale 1. 2 (2) Kehtna Vallavalitsus avalikustab Raplamaa Omavalitsuste Liidu Täiskogu, Kehtna Vallavolikogu ja volikogu komisjonide istungite protokollid ja teabe arengustrateegia menetlemise kohta valla veebilehel seitsme tööpäeva jooksul arengustrateegia vastuvõtmisest arvates.",
