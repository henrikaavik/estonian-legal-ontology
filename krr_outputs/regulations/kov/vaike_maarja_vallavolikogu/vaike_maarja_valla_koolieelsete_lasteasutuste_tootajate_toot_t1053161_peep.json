          "@id": "estleg:Reg_1053161_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1053161_Par_2_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1053161_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koolieelse lasteasutuse õpetaja töötasu alammäär kuus on täistööajaga töötamise korral 90% ja magistrikraadiga või sellega võrdsustatud tasemega õpetajal 100% üldhariduskooli õpetaja kuu töötasu alammäärast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1053161_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1053161_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Nõuetele vastava kvalifikatsiooniga logopeedi, eripedagoogi, psühholoogi ja sotsiaalpedagoogi töötasu alammäär täistööajaga töötamisel on võrdne lasteasutuse õpetaja töötasu alammääraga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1053161_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
