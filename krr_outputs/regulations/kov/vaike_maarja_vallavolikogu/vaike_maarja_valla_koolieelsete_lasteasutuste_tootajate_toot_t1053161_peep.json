      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Väike-Maarja valla koolieelsete lasteasutuste töötajate töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Väike-Maarja valla hallatavate koolieelsete lasteasutuste pedagoogide töötasu alammäärad.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Väike-Maarja valla hallatavate koolieelsete lasteasutuste pedagoogide töötasu alammäärad.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vaike_maarja_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
