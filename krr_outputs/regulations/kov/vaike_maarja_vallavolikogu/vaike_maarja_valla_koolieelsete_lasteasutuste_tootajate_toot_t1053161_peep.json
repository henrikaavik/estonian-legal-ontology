    },
    {
      "@id": "estleg:Reg_1053161_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Pedagoogide töötasu alammäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Väike-Maarja valla koolieelsete lasteasutuste töötajate töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Koolieelse lasteasutuse õpetaja töötasu alammäär kuus on täistööajaga töötamise korral 90% ja magistrikraadiga või sellega võrdsustatud tasemega õpetajal 100% üldhariduskooli õpetaja kuu töötasu alammäärast. 2 (2) Nõuetele vastava kvalifikatsiooniga logopeedi, eripedagoogi, psühholoogi ja sotsiaalpedagoogi töötasu alammäär täistööajaga töötamisel on võrdne lasteasutuse õpetaja töötasu alammääraga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Koolieelse lasteasutuse õpetaja töötasu alammäär kuus on täistööajaga töötamise korral 90% ja magistrikraadiga või sellega võrdsustatud tasemega õpetajal 100% üldhariduskooli õpetaja kuu töötasu alammäärast. 2 (2) Nõuetele vastava kvalifikatsiooniga logopeedi, eripedagoogi, psühholoogi ja sotsiaalpedagoogi töötasu alammäär täistööajaga töötamisel on võrdne lasteasutuse õpetaja töötasu alammääraga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vaike_maarja_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0928"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053161_Map"
      },
