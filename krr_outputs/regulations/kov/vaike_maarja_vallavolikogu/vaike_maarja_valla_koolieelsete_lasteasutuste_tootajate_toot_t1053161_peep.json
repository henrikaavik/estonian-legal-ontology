    {
      "@id": "estleg:Reg_1053161_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Väike-Maarja valla hallatavate koolieelsete lasteasutuste pedagoogide töötasu alammäärad.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1053161_Par_1"
