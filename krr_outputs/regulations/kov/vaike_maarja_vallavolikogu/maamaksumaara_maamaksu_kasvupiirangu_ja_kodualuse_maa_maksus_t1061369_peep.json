      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära, maamaksu kasvupiirangu ja kodualuse maa maksusoodustuse kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Väike-Maarja vallas igale järgmisele maa sihtotstarbegrupile maamaksumäär: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 1,0% maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale 0,5% maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maale 2,0% maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Väike-Maarja vallas igale järgmisele maa sihtotstarbegrupile maamaksumäär: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 1,0% maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale 0,5% maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maale 2,0% maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vaike_maarja_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0928"
