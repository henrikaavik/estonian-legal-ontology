      }
    },
    {
      "@id": "estleg:Reg_1046748_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ametiauto kasutaja süül toimunud liiklusõnnetuse korral kuuluvad kasutaja poolt hüvitamisele ametiauto remondikulud omavastutuse summa ulatuses. Kui liiklusõnnetuse põhjustajaks ei olnud kasutaja, siis remondi hüvitamist ei nõuta. Kui kasutaja oli ametiautot juhtides joobeseisundis, siis kuuluvad ametiauto remondi ja muud liiklusõnnetuse tagajärjel tekkinud kulud hüvitamisele kasutaja poolt kogu kahju ulatuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046748_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1046748_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kui kahju tekib seoses ametiauto ärandamisega, mille võimaldas ametiauto kasutaja hooletus, siis kuulub vallale tekkinud kahju süüdi oleva ametiauto kasutaja poolt täies ulatuses hüvitamisele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046748_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
