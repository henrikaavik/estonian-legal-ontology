      "rdfs:label": {
        "@value": "§ 2. [Lasteaia direktor esitab põhimääruse eelnõu koos lasteaia hoolekogu ja pedagoogi...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Harku valla lasteaia põhimääruse kinnitamise kord",
      "estleg:summary": {
        "@value": "Lasteaia direktor esitab põhimääruse eelnõu koos lasteaia hoolekogu ja pedagoogilise nõukogu arvamusega Harku Vallavalitsusele. Vallavalitsus vaatab eelnõu oma istungil läbi ja 1 1) kiidab eelnõu heaks ning esitab selle Harku Vallavolikogule või 2 2) tagastab eelnõu koos põhjendatud arvamusega lasteaiale. RT IV 2015-05-07 9 407052015009 2015-05-10",
        "@language": "et"
      },
      "estleg:legalText": "Lasteaia direktor esitab põhimääruse eelnõu koos lasteaia hoolekogu ja pedagoogilise nõukogu arvamusega Harku Vallavalitsusele. Vallavalitsus vaatab eelnõu oma istungil läbi ja 1 1) kiidab eelnõu heaks ning esitab selle Harku Vallavolikogule või 2 2) tagastab eelnõu koos põhjendatud arvamusega lasteaiale. RT IV 2015-05-07 9 407052015009 2015-05-10",
