      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Väljaspool elukohajärgset valimisringkonda korraldab eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab vajadusel ka asukohas hääletamist. 2 (2) Kodus hääletamist korraldavad valimisjaoskonnad nr 1 ja 2.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Väljaspool elukohajärgset valimisringkonda korraldab eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab vajadusel ka asukohas hääletamist. 2 (2) Kodus hääletamist korraldavad valimisjaoskonnad nr 1 ja 2.",
