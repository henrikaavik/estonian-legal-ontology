        "@id": "estleg:Reg_1063783_Map"
      },
      "estleg:summary": {
        "@value": "Arengukava täitmisest ja haridusasutuse perspektiividest ülevaate saamiseks toimub vähemalt üks kord kahe aasta tagant haridusasutuse juhi ja Saaremaa Vallavalitsuse haridusvaldkonna eest vastutava struktuuriüksuse teenistuja(te) koostöövestlus.",
        "@language": "et"
      },
      "estleg:legalText": "Arengukava täitmisest ja haridusasutuse perspektiividest ülevaate saamiseks toimub vähemalt üks kord kahe aasta tagant haridusasutuse juhi ja Saaremaa Vallavalitsuse haridusvaldkonna eest vastutava struktuuriüksuse teenistuja(te) koostöövestlus.",
