    {
      "@id": "estleg:Reg_1054426_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolitöötajate koosseisu kinnitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolitöötajate koosseisu kinnitamise kord",
      "estleg:summary": {
        "@value": "1 (1) Koolitöötajate koosseisu kinnitab ja teeb selles muudatused kooli direktor käskkirjaga, arvestades kooli eelarvet ning et kõik õigusaktides nõutud teenused ja õppekava täitmine oleksid tagatud. 2 (2) Kooli direktor kooskõlastab kooli töötajate koosseisu ja selle muudatused enne kinnitamist vallavalitsuse haridus- ja noorsootööosakonnaga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Koolitöötajate koosseisu kinnitab ja teeb selles muudatused kooli direktor käskkirjaga, arvestades kooli eelarvet ning et kõik õigusaktides nõutud teenused ja õppekava täitmine oleksid tagatud. 2 (2) Kooli direktor kooskõlastab kooli töötajate koosseisu ja selle muudatused enne kinnitamist vallavalitsuse haridus- ja noorsootööosakonnaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saaremaa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0714"
