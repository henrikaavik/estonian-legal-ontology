    {
      "@id": "estleg:Reg_1041913_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Ametikohtade loetelu",
        "@language": "et"
      },
      "estleg:sourceAct": "Volituste andmine väärteomenetluses osalemiseks",
      "estleg:summary": {
        "@value": "1 (1) Kinnitada ametikohtade loetelu, mida täitvad ametnikud on pädevad osalema väärteomenetluses Saaremaa Vallavalitsuse nimel, alljärgnevalt: 1 1) järelevalve juhtivspetsialist; RT IV 2023-09-01 33 401092023033 2023-09-04 2 2) järelevalve peaspetsialist. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud ametikohti täitvad ametnikud on pädevad teostama järelevalvet neile antud väärteo menetlemispädevuse piires, kui vallavalitsuse järelevalve teostamise õigus tuleneb seadusest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kinnitada ametikohtade loetelu, mida täitvad ametnikud on pädevad osalema väärteomenetluses Saaremaa Vallavalitsuse nimel, alljärgnevalt: 1 1) järelevalve juhtivspetsialist; RT IV 2023-09-01 33 401092023033 2023-09-04 2 2) järelevalve peaspetsialist. 2 (2) Käesoleva paragrahvi lõikes 1 nimetatud ametikohti täitvad ametnikud on pädevad teostama järelevalvet neile antud väärteo menetlemispädevuse piires, kui vallavalitsuse järelevalve teostamise õigus tuleneb seadusest. 3 (3) Väärteomenetluse seadustiku § 10 lõikes 3 nimetatud kohtuvälise menetleja ametniku pädevust tõendava tunnistuse annab ametnikule vallasekretär. RT IV2025-12-0414041220250012025-12-07",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saaremaa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
