    {
      "@id": "estleg:Reg_1041913_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kinnitada ametikohtade loetelu, mida täitvad ametnikud on pädevad osalema väärteomenetluses Saaremaa Vallavalitsuse nimel, alljärgnevalt: 1) järelevalve juhtivspetsialist; 2) järelevalve peaspetsialist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041913_Par_1"
      },
