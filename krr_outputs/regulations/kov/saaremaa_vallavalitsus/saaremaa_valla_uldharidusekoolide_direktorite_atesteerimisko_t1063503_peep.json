      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Komisjoni liikme kohustused",
        "@language": "et"
      },
      "estleg:sourceAct": "Saaremaa valla üldharidusekoolide direktorite atesteerimiskomisjoni töökord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063503_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Komisjoni liige on oma ülesannete täitmisel kohustatud järgima konfidentsiaalsuse, sõltumatuse ja erapooletuse põhimõtteid. 2 (2) Komisjoni liige võib atesteerimise käigus saadud või loodud isikuandmeid kasutada üksnes atesteerimise eesmärgil.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjoni liige on oma ülesannete täitmisel kohustatud järgima konfidentsiaalsuse, sõltumatuse ja erapooletuse põhimõtteid. 2 (2) Komisjoni liige võib atesteerimise käigus saadud või loodud isikuandmeid kasutada üksnes atesteerimise eesmärgil.",
