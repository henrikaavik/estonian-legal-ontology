    {
      "@id": "estleg:Reg_1063503_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Komisjoni töökord",
        "@language": "et"
      },
      "estleg:sourceAct": "Saaremaa valla üldharidusekoolide direktorite atesteerimiskomisjoni töökord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063503_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Komisjoni töökeel on eesti keel. 2 (2) Ministri määruses sätestatud kooli pidaja või komisjoni moodustaja ülesandeid, välja arvatud § 3 lõikes 1 ja § 5 lõikes 1 sätestatud ülesanded, täidab Saaremaa Vallavalitsuse haridusvaldkonna eest vastutav struktuuriüksus (edaspidi osakond). 3 (3) Osakond teavitab atesteeritavat komisjoni koosseisust ja palub atesteeritaval viivitamata osakonda teavitada, kui atesteeritava hinnangul võib mõnel komisjoni liikmel esineda huvide konflikt.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjoni töökeel on eesti keel. 2 (2) Ministri määruses sätestatud kooli pidaja või komisjoni moodustaja ülesandeid, välja arvatud § 3 lõikes 1 ja § 5 lõikes 1 sätestatud ülesanded, täidab Saaremaa Vallavalitsuse haridusvaldkonna eest vastutav struktuuriüksus (edaspidi osakond). 3 (3) Osakond teavitab atesteeritavat komisjoni koosseisust ja palub atesteeritaval viivitamata osakonda teavitada, kui atesteeritava hinnangul võib mõnel komisjoni liikmel esineda huvide konflikt. 4 (4) Komisjon määrab atesteeritava vestluse aja ja koha ning teatab need atesteeritavale.",
      "estleg:hasSubsection": [
