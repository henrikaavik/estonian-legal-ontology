    {
      "@id": "estleg:Reg_1061567_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Kohaliku omavalitsuse volikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas, haiglas ja ööpäevases hoolekandeasutuses. 2 (2) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohaliku omavalitsuse volikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas, haiglas ja ööpäevases hoolekandeasutuses. 2 (2) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
