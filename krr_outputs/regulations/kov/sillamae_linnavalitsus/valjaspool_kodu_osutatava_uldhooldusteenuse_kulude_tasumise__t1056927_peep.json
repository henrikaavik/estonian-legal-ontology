      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldhooldusteenuse hoolduskulude piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Väljaspool kodu osutatava üldhooldusteenuse kulude tasumise piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada väljaspool isiku kodu ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 700 eurot ühe teenuse saaja kohta kuus. RT IV 2025-12-18 10 418122025010 2025-12-21 , rakendatakse 01. jaanuarist 2026. a.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada väljaspool isiku kodu ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 700 eurot ühe teenuse saaja kohta kuus. RT IV 2025-12-18 10 418122025010 2025-12-21 , rakendatakse 01. jaanuarist 2026. a.",
