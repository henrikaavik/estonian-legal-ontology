      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala ja eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Sillamäe Linnavalitsuse ametnike koolituse kord",
      "estleg:summary": {
        "@value": "1 (1) Sillamäe Linnavalitsuse (edaspidi linnavalitsuse) ametnike koolituse kord reguleerib linnavalitsuse ametnike koolituse põhimõtteid ning korraldust. 2 (2) Linnavalitsuse ametnike koolituse eesmärk on tagada ametnike teadmiste, oskuste ja väärtushinnangute püsiv vastavus teenistuskohal esitatavatele nõuetele ning aidata saavutada linnavalitsuse eesmärke ametnike arendamise kaudu.",
        "@language": "et"
      },
