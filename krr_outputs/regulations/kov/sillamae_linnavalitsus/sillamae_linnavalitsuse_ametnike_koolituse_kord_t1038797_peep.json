    {
      "@id": "estleg:Reg_1038797_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Koolituse korraldamisega seotud ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Sillamäe Linnavalitsuse ametnike koolituse kord",
      "estleg:summary": {
        "@value": "1 (1) Struktuuriüksuse juht: 1 1) hindab alluvate ametnike koolitusvajadust ja taotleb nendele vajalikku koolitust, teeb ettepanekuid koolituse vormide ja sisu osas; 2 2) hindab koolituse taset ning saadud teadmiste ja oskuste kasutamist töös. 2 (2) Vahetu juht toetab ametnike enesetäiendamist, hindab nende koolitusvajadust ja taotleb neile vajalikku koolitust. 3 (3) Linnakantselei spetsialist tagab linnavalitsuses koolitustegevuse korraldamise ja koolitusdokumentatsiooni korrasoleku.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Struktuuriüksuse juht: 1 1) hindab alluvate ametnike koolitusvajadust ja taotleb nendele vajalikku koolitust, teeb ettepanekuid koolituse vormide ja sisu osas; 2 2) hindab koolituse taset ning saadud teadmiste ja oskuste kasutamist töös. 2 (2) Vahetu juht toetab ametnike enesetäiendamist, hindab nende koolitusvajadust ja taotleb neile vajalikku koolitust. 3 (3) Linnakantselei spetsialist tagab linnavalitsuses koolitustegevuse korraldamise ja koolitusdokumentatsiooni korrasoleku. 4 (4) Ametnik: 1 1) vastutab oma teadmiste ja oskuste ning ühtlasi ka oma arendamise eest; 2 2) kasutab enesetäiendamiseks lubatud tööaega maksimaalse tõhususega; 3 3) teeb vahetule juhile põhjendatud ettepaneku enda koolitamise teemade ja liikide osas ning vajaliku kirjanduse ostmiseks; 4 4) esitab ettenähtud koolitustaotluse, annab linnakantselei spetsialistile koolituse läbimise kohta tagasisidet esitades koolituse läbimist tõendavad dokumendid (diplomi, tunnistuse).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_sillamae_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0735"
