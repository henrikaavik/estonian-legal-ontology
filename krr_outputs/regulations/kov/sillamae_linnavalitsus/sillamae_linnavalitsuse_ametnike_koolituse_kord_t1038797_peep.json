        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koolitusele suunamise aluseks on struktuuriüksuse juhi või vahetu juhi korraldus koolitusel osaleda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038797_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1038797_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ametnik täidab koolitustaotluse vähemalt 2 tööpäeva enne koolitust ja edastab selle kooskõlastamiseks linnakantselei spetsialistile, vahetu juhile ja struktuuriüksuse juhile. Pärast kooskõlastuste saamist registreerib ametnik ennast koolitusele. Kui koolitusega kaasnevad kulud või kui koolitus on seotud lähetusega, kooskõlastab ametniku koolitustaotluse linnapea. Pärast kooskõlastuste saamist registreerib ametnik ennast koolitusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038797_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
