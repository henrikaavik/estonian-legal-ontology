        }
      ]
    },
    {
      "@id": "estleg:Reg_1043642_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ametliku kohanime määramist võivad algatada vallavolikogu, vallavalitsus ning füüsilised või juriidilised isikud kirjaliku taotluse alusel. Kohanime määramise või muutmise taotlus peab sisaldama kohanime valiku põhjendust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043642_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_mulgi_vallavolikogu"
        },
        {
          "@id": "estleg:Issuer_mulgi_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043642_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Eraomandis olevale maaüksusele või sellel paiknevale nimeobjektile kohanime määramisest teavitab kohanimemääraja asjaomast maaomanikku posti teel, küsides tema arvamust. Maaomanik peab kirjaliku arvamuse esitama teate saamisest 15 päeva jooksul. Maaomaniku arvamuse tähtajaks esitamata jätmisel loetakse tema nõusolek saaduks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043642_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:Reg_1043642_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kohanimi muudetakse või tunnistatakse kehtetuks kohanimeseaduses sätestatud juhtudel ja korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043642_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1043642_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kohanime määramisest keeldutakse, kui taotletav kohanimi on vastuolus kohanimeseaduses kohanimele esitatavate nõuetega või kui puudub selgesti eristatav objekt, millele nime taotletakse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043642_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
    {
      "@id": "estleg:Reg_1043642_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Kohanime määramise avalikustamine ja avaldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1(1)Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist valla veebilehel. Sätet ei kohaldata maaüksuse nime määramisel. 2(2)Kohanime määramise õigusakt saadetakse10 päeva jooksul pärast õigusakti jõustamist kohanimenõukogule, riikliku kohanimeregistri volitatud töötlejale ja huvitatud isikule.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist valla veebilehel. Sätet ei kohaldata maaüksuse nime määramisel. 2(2)Kohanime määramise õigusakt saadetakse10 päeva jooksul pärast õigusakti jõustamist kohanimenõukogule, riikliku kohanimeregistri volitatud töötlejale ja huvitatud isikule.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mulgi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0480"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043642_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
