    },
    {
      "@id": "estleg:Reg_1054194_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toimetulekutoetuse määramisel võetakse arvesse elamuseaduse § 7 lõike 1 punkti 2 alusel jooksval kuul tasumisele kuuluvad eluasemekulud eluruumi sotsiaalselt põhjendatud normi ulatuses, kuid mitte üle käesolevas määruses kehtestatud piirmäärade.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054194_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": "2"
    },
    {
      "@id": "estleg:Reg_1054194_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Eluruumi sotsiaalselt põhjendatud norm on 18 m² eluruumi üldpinda perekonna iga liikme kohta ja lisaks 15 m² perekonna kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054194_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1054194_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kui eluruumi tubade arv on võrdne selles eluruumis alaliselt elavate inimeste arvuga ja eluruumi üldpind on sotsiaalselt põhjendatud normist suurem, võetakse arvesse eluruumi üldpind.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054194_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1054194_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kui eluruumi kasutab üksinda elav pensionär ning osalise või puuduva töövõimega inimene, loetakse eluruumi sotsiaalselt põhjendatud normiks eluruumi tegelik suurus, kuid mitte rohkem kui 51 m².",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054194_Par_2"
      },
      "rdfs:label": "§ 2 lg 4"
    },
    {
      "@id": "estleg:Reg_1054194_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Eluasemekulude piirmäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Toimetulekutoetuse määramisel aluseks võetavate eluasemekulude piirmäärade kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Toimetulekutoetuse määramisel aluseks võetavate eluasemekulude piirmäärad on järgmised: 1 1) üür 12 eurot ruutmeetri kohta kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 2 2) korterelamu haldamise kulu, sealhulgas remondiga seotud kulu kuni 3 eurot ruutmeetri kohta kuus; 3 3) korterelamu renoveerimiseks võetud laenu tagasimakse kuni 5 eurot ruutmeetri kohta kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 4 4) veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 18 eurot ühe…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toimetulekutoetuse määramisel aluseks võetavate eluasemekulude piirmäärad on järgmised: 1 1) üür 12 eurot ruutmeetri kohta kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 2 2) korterelamu haldamise kulu, sealhulgas remondiga seotud kulu kuni 3 eurot ruutmeetri kohta kuus; 3 3) korterelamu renoveerimiseks võetud laenu tagasimakse kuni 5 eurot ruutmeetri kohta kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 4 4) veevarustuse ja reovee ärajuhtimise teenuste maksumus kuni 18 eurot ühe inimese kohta kuus; 5 5) soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus 10 eurot ühe inimese kohta kuus; 6 6) kütteks tarbitud soojusenergia või kütuse maksumus:kaugküttega eluruumis 14 eurot ruutmeetri kohta kuus;kaugkütteta eluruumis 14 eurot ruutmeetri kohta kuus, kuid mitte rohkem kui 1200 eurot kalendriaastas;elektriküttega eluruumis 10 eurot ruutmeetri kohta kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 7 7) elektrienergia tarbimisega seotud kulu kuni 70 eurot üksi elava inimese või perekonna esimese liikme kohta kuus, perekonna iga järgneva liikme kohta kuni 45 eurot kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 8 8) majapidamisgaasi maksumus kuni 10 eurot üksi elava inimese või perekonna esimese liikme kohta kuus, perekonna iga järgneva liikme kohta kuni 7 eurot kuus; RT IV 2023-04-11 17 411042023017 2023-04-14 9 9) maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,25 eurot ruutmeetri kohta kuus; 10 10) hoonekindlustuse kulu kuni 0,30 eurot eluruumi 1 m2 ruutmeetri kohta kuus; 11 11) tegelik olmejäätmete veotasu kuus; 12 12) eluaseme soetamiseks võetud laen - 10 eurot ruutmeetri kohta kuus. RT IV 2022-08-27 10 427082022010 2022-08-30 13 2 (2) Piirmääradest väiksemate eluasemekulude korral on toimetulekutoetuse määramisel aluseks tegelikud eluasemekulud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mulgi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0480"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054194_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1054194_Par_3_Lg_1"
