      ]
    },
    {
      "@id": "estleg:Reg_1062805_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Osalustasu arvestus ja maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Mulgi valla munitsipaallasteaia ja -lastehoiu vanema osalustasu ja selle tasumise kord",
      "estleg:summary": {
        "@value": "1 (1) Osalustasu maksmise kohustus algab päevast, mil lapsel tekib õigus minna lasteasutusse ja lõpeb lapse lasteasutusest nimekirjast väljaarvamise päevast. 2 (2) Kui laps arvatakse lasteasutusest välja kalendrikuu keskel, arvestatakse osalustasu lõpetamise kuu eest proportsionaalselt lasteasutuses käidud kalendripäevadele. 3 (3) Osalustasu makstakse üldjuhul aastaringselt ja selle suurus ei sõltu lapse lasteaias viibimise päevade arvust.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Osalustasu maksmise kohustus algab päevast, mil lapsel tekib õigus minna lasteasutusse ja lõpeb lapse lasteasutusest nimekirjast väljaarvamise päevast. 2 (2) Kui laps arvatakse lasteasutusest välja kalendrikuu keskel, arvestatakse osalustasu lõpetamise kuu eest proportsionaalselt lasteasutuses käidud kalendripäevadele. 3 (3) Osalustasu makstakse üldjuhul aastaringselt ja selle suurus ei sõltu lapse lasteaias viibimise päevade arvust. 4 (4) Vanema võib vabastada osalustasu maksmisest lasteaia ja lastehoiu mittekasutamisel vanema kirjaliku avalduse alusel maksimaalselt kahe kalendrikuu ulatuses (sh 30 järjestikusest kalendripäeva) aastas lasteaia direktori käskkirja alusel. 5 (5) Vanem vabastatakse osalustasu maksmise kohustusest perioodil, mil lasteasutus on vallavalitsuse korraldusega suletud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mulgi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0480"
