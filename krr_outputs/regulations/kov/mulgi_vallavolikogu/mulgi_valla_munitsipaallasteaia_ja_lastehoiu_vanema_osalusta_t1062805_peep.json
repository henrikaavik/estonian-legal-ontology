      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1062805_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui laps arvatakse lasteasutusest välja kalendrikuu keskel, arvestatakse osalustasu lõpetamise kuu eest proportsionaalselt lasteasutuses käidud kalendripäevadele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062805_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1062805_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Osalustasu makstakse üldjuhul aastaringselt ja selle suurus ei sõltu lapse lasteaias viibimise päevade arvust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062805_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
