    {
      "@id": "estleg:Reg_1062805_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Osalustasu suurus lasteaias ja lastehoius ühe lapse kohta kuus on: 1) alates 1. aprillist 2026. a 44,30 eurot; 2) alates 1. septembrist 2026. a 30 eurot.",
      "estleg:parentProvision": {
