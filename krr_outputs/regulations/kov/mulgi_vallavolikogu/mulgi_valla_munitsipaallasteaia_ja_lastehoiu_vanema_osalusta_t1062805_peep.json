      "rdfs:label": {
        "@value": "§ 2. Osalustasu",
        "@language": "et"
      },
      "estleg:sourceAct": "Mulgi valla munitsipaallasteaia ja -lastehoiu vanema osalustasu ja selle tasumise kord",
      "estleg:summary": {
        "@value": "Osalustasu suurus lasteaias ja lastehoius ühe lapse kohta kuus on: 1 1) alates 1. aprillist 2026. a 44,30 eurot; 2 2) alates 1. septembrist 2026. a 30 eurot. RT IV 2026-03-31 6 431032026006 2026-04-03 , rakendatakse 1. aprillist 2026. a",
        "@language": "et"
      },
      "estleg:legalText": "Osalustasu suurus lasteaias ja lastehoius ühe lapse kohta kuus on: 1 1) alates 1. aprillist 2026. a 44,30 eurot; 2 2) alates 1. septembrist 2026. a 30 eurot. RT IV 2026-03-31 6 431032026006 2026-04-03 , rakendatakse 1. aprillist 2026. a",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mulgi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0480"
      },
      "estleg:partOfAct": {
