      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Mulgi Vallavolikogu tööst osavõtu eest makstava tasu suurus ja maksmise kord",
      "estleg:summary": {
        "@value": "Käesolev kord reguleerib Mulgi Vallavolikogu (edaspidi vallavolikogu) liikmetele vallavolikogu istungitest osavõtu eest ja vallavolikogu alatiste ning ajutiste komisjonide töö korraldamise eest tasu maksmise suurust ja korda, samuti vallavolikogu esimehele ja aseesimeestele hüvituse/töötasu määramist.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev kord reguleerib Mulgi Vallavolikogu (edaspidi vallavolikogu) liikmetele vallavolikogu istungitest osavõtu eest ja vallavolikogu alatiste ning ajutiste komisjonide töö korraldamise eest tasu maksmise suurust ja korda, samuti vallavolikogu esimehele ja aseesimeestele hüvituse/töötasu määramist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mulgi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0480"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062371_Map"
      },
      "estleg:hasSubsection": [
