    },
    {
      "@id": "estleg:Reg_1062371_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev kord reguleerib Mulgi Vallavolikogu (edaspidi vallavolikogu) liikmetele vallavolikogu istungitest osavõtu eest ja vallavolikogu alatiste ning ajutiste komisjonide töö korraldamise eest tasu maksmise suurust ja korda, samuti vallavolikogu esimehele ja aseesimeestele hüvituse/töötasu määramist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062371_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_mulgi_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062371_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tasu suurus ja maksmise alused",
        "@language": "et"
      },
      "estleg:sourceAct": "Mulgi Vallavolikogu tööst osavõtu eest makstava tasu suurus ja maksmise kord",
      "estleg:summary": {
        "@value": "1(1)Vallavolikogu liikmele, välja arvatud vallavolikogu esimees ja vallavolikogu aseesimehed, makstakse tasu vallavolikogu istungist osavõtu eest 100 eurot. 2(2)Vallavolikogu esimehele makstakse igakuist hüvitist 2000 eurot. 3(3)Vallavolikogu aseesimeestele makstakse igakuist hüvitist 1000 eurot. 4(4)Vallavolikogu alatise komisjoni esimehele makstakse komisjoni koosoleku läbiviimise eest igakordset tasu 125 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Vallavolikogu liikmele, välja arvatud vallavolikogu esimees ja vallavolikogu aseesimehed, makstakse tasu vallavolikogu istungist osavõtu eest 100 eurot. 2(2)Vallavolikogu esimehele makstakse igakuist hüvitist 2000 eurot. 3(3)Vallavolikogu aseesimeestele makstakse igakuist hüvitist 1000 eurot. 4(4)Vallavolikogu alatise komisjoni esimehele makstakse komisjoni koosoleku läbiviimise eest igakordset tasu 125 eurot. 5(5)Komisjonide liikmetele makstakse komisjoni koosolekust osavõtu eest igakordset tasu 60 eurot. 6(6)Käesolevas korras ettenähtud tasusid ei maksta vallavolikogu korralise puhkuse aja eest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_mulgi_vallavolikogu"
      },
