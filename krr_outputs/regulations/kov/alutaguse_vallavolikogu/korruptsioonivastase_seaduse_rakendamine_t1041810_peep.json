    {
      "@id": "estleg:Reg_1041810_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Huvide deklareerimise kohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "1(1)Deklaratsiooni on kohustatud esitama:11) vallavolikogu liige;22) vallavalitsuse liige;33) vallavanem;44) vallavalitsuse hallatava asutuse juht;55) valla valitseva mõju all oleva äriühingu või valla asutatud sihtasutuse juhtorgani liige. 2(2)Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks deklaratsioonide registrile.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Deklaratsiooni on kohustatud esitama:11) vallavolikogu liige;22) vallavalitsuse liige;33) vallavanem;44) vallavalitsuse hallatava asutuse juht;55) valla valitseva mõju all oleva äriühingu või valla asutatud sihtasutuse juhtorgani liige. 2(2)Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks deklaratsioonide registrile. Kalendriaasta jooksul ei pea deklarant esitama rohkem kui ühe deklaratsiooni ka juhul, kui ta asub uuele ametikohale. 3(3)Deklaratsiooni esitamise kohustus lõpeb, kui deklarant on esitanud deklaratsiooni ametikohalt lahkumise aastale järgneval kalendriaastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_alutaguse_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0130"
      },
