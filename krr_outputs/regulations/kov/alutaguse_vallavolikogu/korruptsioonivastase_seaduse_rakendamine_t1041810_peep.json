        }
      ]
    },
    {
      "@id": "estleg:Reg_1041810_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Deklaratsiooni on kohustatud esitama: 1) vallavolikogu liige; 2) vallavalitsuse liige; 3) vallavanem; 4) vallavalitsuse hallatava asutuse juht; 5) valla valitseva mõju all oleva äriühingu või valla asutatud sihtasutuse juhtorgani liige.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "@id": "estleg:Reg_1041810_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks deklaratsioonide registrile. Kalendriaasta jooksul ei pea deklarant esitama rohkem kui ühe deklaratsiooni ka juhul, kui ta asub uuele ametikohale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1041810_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Deklaratsiooni esitamise kohustus lõpeb, kui deklarant on esitanud deklaratsiooni ametikohalt lahkumise aastale järgneval kalendriaastal.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1041810_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Deklarantide andmete esitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "1(1)Alusandmed deklarantide kohta esitab deklaratsioonide registrile registritöötaja või vallasekretär. 2(2)Andmed esitatakse ühe kuu jooksul deklarandi deklaratsiooni esitamise kohustuse algusest arvates ning registrit teavitatakse viivitamata deklarandi deklaratsiooni esitamise kohustuse kehtetuks tunnistamisest ja deklarandi ametikohalt lahkumisest.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Alusandmed deklarantide kohta esitab deklaratsioonide registrile registritöötaja või vallasekretär. 2(2)Andmed esitatakse ühe kuu jooksul deklarandi deklaratsiooni esitamise kohustuse algusest arvates ning registrit teavitatakse viivitamata deklarandi deklaratsiooni esitamise kohustuse kehtetuks tunnistamisest ja deklarandi ametikohalt lahkumisest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_alutaguse_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0130"
