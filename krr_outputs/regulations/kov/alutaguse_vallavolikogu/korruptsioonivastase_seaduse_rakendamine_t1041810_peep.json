    },
    {
      "@id": "estleg:Reg_1041810_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Deklaratsiooni kontrollitakse vajadusel ning süüteokahtluse korral.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_5"
      },
      "rdfs:label": "§ 5 lg 1"
    },
    {
      "@id": "estleg:Reg_1041810_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Deklaratsioonide kontrollimiseks moodustatakse komisjon, kuhu kuuluvad vallavolikogu esimees, revisjonikomisjoni esimees, vallasekretär ja registritöötaja.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_5"
      },
      "rdfs:label": "§ 5 lg 2"
    },
    {
      "@id": "estleg:Reg_1041810_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Komisjoni liikmel on õigus: 1) nõuda deklarandilt ja kolmandalt isikult selgitusi deklaratsiooni sisu, deklaratsiooni esitamise tähtaja eiramise või deklaratsiooni esitamata jätmise põhjuste kohta; 2) esitada päringuid ja saada deklarandi kohta deklaratsiooni kontrollimiseks vajalikus ulatuses andmeid krediidiasutustelt ja riigi või kohaliku omavalitsuse andmekogudest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
      "estleg:itemNumber": [
        "1",
        "2"
      ]
    },
    {
      "@id": "estleg:Reg_1041810_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Deklaratsiooni kontrolliv komisjoni liige protokollib kontrolltoimingud ja teavitab deklaranti ja registri pidajat deklaratsiooni kontrollimisest ja läbi viidud toimingutest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_5"
      },
      "rdfs:label": "§ 5 lg 4"
    },
    {
      "@id": "estleg:Reg_1041810_Par_5_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kui deklaratsiooni kontrollimisel on tekkinud süüteokahtlus, teavitab kontrollija viivitamatult vallavolikogu esimeest. Süüteo kahtluse korral esitab vallavolikogu esimees deklaratsiooni kontrollimise materjalid prokuratuurile või kohtuvälisele menetlejale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_5"
      },
      "rdfs:label": "§ 5 lg 5"
    },
    {
      "@id": "estleg:Reg_1041810_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Vallavanema ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab:11) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest;22) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle;33) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes;44) arvestuse pidamise…",
        "@language": "et"
      },
      "estleg:legalText": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab:11) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest;22) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle;33) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes;44) arvestuse pidamise ametiasutuse ametnike tegelemise üle avaliku teenistuse seaduses nimetatud kõrvaltegevustega, samuti kontrolli avaliku teenistuse seaduses kehtestatud keeldude järgimise üle.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_alutaguse_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0130"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041810_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_alutaguse_vallavalitsus"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1041810_Par_6_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1041810_Par_6_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab: 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest; 2) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes; 4) arvestuse pidamise ametiasutuse ametnike tegelemise üle avaliku teenistuse seaduses nimetatud kõrvaltegevustega, samuti kontrolli avaliku teenistuse seaduses kehtestatud keeldude järgimise üle.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041810_Par_6"
      },
      "rdfs:label": "§ 6 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
