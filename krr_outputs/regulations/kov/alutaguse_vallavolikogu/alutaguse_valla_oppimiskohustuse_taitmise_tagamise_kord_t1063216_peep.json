      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Alutaguse valla õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Kord sätestab rahvastikuregistri järgi Alutaguse valla haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöökorralduse. 2(2)Korda rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kord sätestab rahvastikuregistri järgi Alutaguse valla haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöökorralduse. 2(2)Korda rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
      "estleg:enactedBy": {
