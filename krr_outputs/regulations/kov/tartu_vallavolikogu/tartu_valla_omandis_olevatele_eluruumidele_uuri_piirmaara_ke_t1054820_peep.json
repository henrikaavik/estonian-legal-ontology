      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Tartu valla omandis olevatele eluruumidele üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Määrusega kehtestatakse Tartu valla (edaspidi valla) omandis olevate eluruumide üüri piirmäär. 2 (2) Käesolevat määrust ei kohaldata eluruumide kasutusse andmisel sotsiaalhoolekandelise abi korras eluruumi tagamise teenusena. 3 (3) Valla omandis olevaid eluruume antakse üürile ennekõike avalike teenuste osutamisega seotud vajadustest või muudest vallale olulistest asjaoludest lähtuvalt.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega kehtestatakse Tartu valla (edaspidi valla) omandis olevate eluruumide üüri piirmäär. 2 (2) Käesolevat määrust ei kohaldata eluruumide kasutusse andmisel sotsiaalhoolekandelise abi korras eluruumi tagamise teenusena. 3 (3) Valla omandis olevaid eluruume antakse üürile ennekõike avalike teenuste osutamisega seotud vajadustest või muudest vallale olulistest asjaoludest lähtuvalt.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0796"
