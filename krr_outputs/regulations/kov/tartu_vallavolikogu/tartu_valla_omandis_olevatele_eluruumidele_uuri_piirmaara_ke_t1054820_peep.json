      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Tartu valla (edaspidi valla) omandis olevate eluruumide üüri piirmäär.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054820_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1054820_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Käesolevat määrust ei kohaldata eluruumide kasutusse andmisel sotsiaalhoolekandelise abi korras eluruumi tagamise teenusena.",
