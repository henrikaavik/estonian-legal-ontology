      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Tartu vallas 1. jaanuarist 2026 igale järgmisele maa sihtotstarbegrupile maamaksumäär alljärgnevalt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,4 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,21 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,17 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Tartu vallas 1. jaanuarist 2026 igale järgmisele maa sihtotstarbegrupile maamaksumäär alljärgnevalt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,4 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,21 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,17 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0796"
