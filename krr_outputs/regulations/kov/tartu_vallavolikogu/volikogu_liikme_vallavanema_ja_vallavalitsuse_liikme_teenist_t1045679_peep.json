      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Teenistuslähetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Teenistuslähetus (edaspidi lähetus) on volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Volikogu liige ja vallavanem saadetakse lähetusse volikogu esimehe korraldusel ja vallavalitsuse liige vallavanema korraldusel. 2 (2) Lähetust välisriiki loetakse välislähetuseks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenistuslähetus (edaspidi lähetus) on volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Volikogu liige ja vallavanem saadetakse lähetusse volikogu esimehe korraldusel ja vallavalitsuse liige vallavanema korraldusel. 2 (2) Lähetust välisriiki loetakse välislähetuseks.",
