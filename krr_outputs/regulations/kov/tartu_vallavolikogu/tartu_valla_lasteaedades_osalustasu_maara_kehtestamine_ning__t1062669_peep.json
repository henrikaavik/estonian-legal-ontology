      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lapse puudumisel lasteaiast mistahes põhjusel ümberarvestust ei tehta.",
      "estleg:parentProvision": {
