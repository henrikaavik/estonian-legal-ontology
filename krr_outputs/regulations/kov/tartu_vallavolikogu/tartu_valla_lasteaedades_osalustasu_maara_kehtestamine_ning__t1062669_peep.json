        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Osalustasu määra kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Tartu valla lasteaedades osalustasu määra kehtestamine ning tasumise kord",
      "estleg:summary": {
        "@value": "1 (1) Kehtestada Tartu valla lasteaedades osalustasu määraks 8% Vabariigi Valitsuse poolt töölepingu seaduse § 29 lõike 5 alusel kehtestatavast töötasu alammäärast. 2 (2) Kui vanematel on kolm või enam last, kes kasutavad kohta Tartu valla lasteaias, siis kolmanda ja järgneva lapse eest osalustasu maksma ei pea. Nimetatud erisuse rakendamiseks peab vähemalt üks vanem ja kõik lasteaias kohta kasutavad lapsed elama Eesti rahvastikuregistri andmetel Tartu vallas.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kehtestada Tartu valla lasteaedades osalustasu määraks 8% Vabariigi Valitsuse poolt töölepingu seaduse § 29 lõike 5 alusel kehtestatavast töötasu alammäärast. 2 (2) Kui vanematel on kolm või enam last, kes kasutavad kohta Tartu valla lasteaias, siis kolmanda ja järgneva lapse eest osalustasu maksma ei pea. Nimetatud erisuse rakendamiseks peab vähemalt üks vanem ja kõik lasteaias kohta kasutavad lapsed elama Eesti rahvastikuregistri andmetel Tartu vallas. Osalustasu vabastus laieneb ka juhul, kui üks või mitu last kasutavad kohta eralastehoius, kellega on Tartu vallal sõlmitud haldusleping.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0796"
      },
