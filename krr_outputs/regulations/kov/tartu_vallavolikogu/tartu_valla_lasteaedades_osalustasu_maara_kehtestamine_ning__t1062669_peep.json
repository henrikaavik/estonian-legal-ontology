      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Osalustasu arvestamine lõpeb lapse lasteaiast lahkumisel, kui vanem on koha kasutamise lõpetamisest vähemalt 14 päeva ette teatanud. Tähtaja eiramisel tuleb tähtajast puudu jäävate päevade eest tasuda osalustasu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062669_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
