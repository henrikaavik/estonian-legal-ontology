      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Muuseumi finantseerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Sindi Muuseumi põhimäärus",
      "estleg:summary": {
        "@value": "1(1) Muuseumi tegevust finantseeritakse Sindi linna eelarvest. Lisaks saab muuseum rahalisi vahendeid ja/või vara annetustest ja sponsorlusest ning fondide ja sihtkapitalide eraldistest. 2(2) Muuseumi raamatupidamist korraldab linnavalitsus. 3(3) Muuseumi personalikoosseisu ja palgamäärad kinnitab linnavalitsus. 4(4) Muuseumi teenuste ja piletite hinnad kinnitab linnavalitsus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Muuseumi tegevust finantseeritakse Sindi linna eelarvest. Lisaks saab muuseum rahalisi vahendeid ja/või vara annetustest ja sponsorlusest ning fondide ja sihtkapitalide eraldistest. 2(2) Muuseumi raamatupidamist korraldab linnavalitsus. 3(3) Muuseumi personalikoosseisu ja palgamäärad kinnitab linnavalitsus. 4(4) Muuseumi teenuste ja piletite hinnad kinnitab linnavalitsus.",
