    {
      "@id": "estleg:Reg_1008355_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Juhataja juhib muuseumi, tagades põhimääruses ettenähtud ülesannete täitmise ja kannab vastutust muuseumi üldseisundi, varade säilimise, arengu ja rahaliste vahendite õiguspärase kasutamise eest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1008355_Par_5"
      },
      "rdfs:label": "§ 5 lg 1"
    },
    {
      "@id": "estleg:Reg_1008355_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Juhataja 1) esindab muuseumi; 2) teostab tehinguid põhimääruses sätestatud eesmärkide saavutamiseks linnavolikogu poolt kehtestatud korras; 3) kinnitab muuseumi töötajate ametijuhendid ning sõlmib, muudab ja ütleb üles töötajatega töölepingud; 4) esitab muuseumi eelarve projekti linnavalituse poolt kehtestatud korras; 5) koostab muuseumi tööplaani ja kooskõlastab selle nõukoguga; 6) annab kord aastas linnavalitsusele aru muuseumi tegevuse kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1008355_Par_5"
      },
      "rdfs:label": "§ 5 lg 2",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    },
