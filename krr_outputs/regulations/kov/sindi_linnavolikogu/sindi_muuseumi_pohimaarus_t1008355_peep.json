      "estleg:paragrahv": "§ 8.",
      "rdfs:label": {
        "@value": "§ 8. Muuseumi ümberkorraldamine ja tegevuse lõpetamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Sindi Muuseumi põhimäärus",
      "estleg:summary": {
        "@value": "1(1) Muuseumi tegevuse korraldab ümber või lõpetab linnavolikogu. 2(2) Algatuse muuseumi ümberkorraldamiseks või tegevuse lõpetamiseks võivad teha linnavalitsus, linnavolikogu või muuseumi nõukogu. 3(3) Muuseumi tegevuse lõpetamisel antakse muuseumikogud koos arvestus-dokumentatsiooniga üle linnavalitsusele kui volikogu ei otsusta teisiti.",
        "@language": "et"
      },
