      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata Sindi linna territooriumil asuvate parkide ja haljasalade kohanimed (ase...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanimede määramine",
      "estleg:summary": {
        "@value": "Määrata Sindi linna territooriumil asuvate parkide ja haljasalade kohanimed (asendiplaanid lisatud) alljärgnevalt: 1 (1) Sõpruse park (lisa 1); 2 (2) Dendropark (lisa 1); 3 (3) Lohu park (lisa 1); 4 (4) Kiriku park (lisa 2); 5 (5) Hirveaia park (lisa 2); 6 (6) Vabriku park (lisa 2); 7 (7) Klubi park (lisa 2); 8 (8) Wöhrmanni park (lisa 2); 9 (9) Kooli park (lisa 3); 10 (10) Abiturientide park (lisa 3); 11 (11) Lastepark (lisa 3); 12 (12) Raudtee park (lisa 3); 13 (13) Tiigi park (lisa 3); 14…",
        "@language": "et"
      },
      "estleg:legalText": "Määrata Sindi linna territooriumil asuvate parkide ja haljasalade kohanimed (asendiplaanid lisatud) alljärgnevalt: 1 (1) Sõpruse park (lisa 1); 2 (2) Dendropark (lisa 1); 3 (3) Lohu park (lisa 1); 4 (4) Kiriku park (lisa 2); 5 (5) Hirveaia park (lisa 2); 6 (6) Vabriku park (lisa 2); 7 (7) Klubi park (lisa 2); 8 (8) Wöhrmanni park (lisa 2); 9 (9) Kooli park (lisa 3); 10 (10) Abiturientide park (lisa 3); 11 (11) Lastepark (lisa 3); 12 (12) Raudtee park (lisa 3); 13 (13) Tiigi park (lisa 3); 14 (14) Postimaja park (lisa 3); 15 (15) Rabaääre metsapark (lisa 4); 16 (16) Männimetsa park (lisa 4); 17 (17) Kanarbiku park (lisa 4); 18 (18) Sambla park (lisa 4); 19 (19) Eha park (lisa 5), 20 (20) Saviaugu park (lisa 5); 21 (21) Tõela metsapark (lisa 5); 22 (22) Ojakalda park (lisa 6), 23 (23) Ujula park (lisa 6).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_sindi_linnavolikogu"
      },
