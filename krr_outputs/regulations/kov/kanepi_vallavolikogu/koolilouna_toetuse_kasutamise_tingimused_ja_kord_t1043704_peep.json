      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1043704_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuse kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Kanepi valla koolide statsionaarses õppes põhi- ja üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2 (2) Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest ülejäävat raha kasutatakse õpilaste toitlustamiseks pikapäevarühmas. 3 (3) Riigieelarvest eraldatud koolilõuna eraldisest kaetakse toiduainete kulud.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Kanepi valla koolide statsionaarses õppes põhi- ja üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2 (2) Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest ülejäävat raha kasutatakse õpilaste toitlustamiseks pikapäevarühmas. 3 (3) Riigieelarvest eraldatud koolilõuna eraldisest kaetakse toiduainete kulud. 4 (4) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Kanepi valla eelarvest. 4 (4<sup>1</sup>) Õppetöö ajutisel üleviimisel distantsõppele tagatakse õpilastele soovi korral toitlustamine või toidupakk, mille kättesaamise korraldab kool koostöös vallavalitsusega. RT IV 2020-12-23 16 423122020016 2020-12-26 19 5 (5) Toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0284"
