        }
      ]
    },
    {
      "@id": "estleg:Reg_1043704_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest ülejäävat raha kasutatakse õpilaste toitlustamiseks pikapäevarühmas.",
      "estleg:parentProvision": {
