      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Määrus täpsustab korruptsiooni ennetamise korraldust Kanepi vallas, sealhulgas määrab kindlaks huvide deklaratsiooni (edaspidi deklaratsioon) esitama kohustatud isikud (deklarandid) ning huvide deklaratsioonide kontrollimise.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus täpsustab korruptsiooni ennetamise korraldust Kanepi vallas, sealhulgas määrab kindlaks huvide deklaratsiooni (edaspidi deklaratsioon) esitama kohustatud isikud (deklarandid) ning huvide deklaratsioonide kontrollimise.",
