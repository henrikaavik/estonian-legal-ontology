      }
    },
    {
      "@id": "estleg:Reg_1043207_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni esitamise kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks huvide deklaratsiooni registrile. Kalendriaasta jooksul ei pea deklarant esitama rohkem kui ühe deklaratsiooni ka juhul, kui ta asub uuele ametikohale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043207_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
