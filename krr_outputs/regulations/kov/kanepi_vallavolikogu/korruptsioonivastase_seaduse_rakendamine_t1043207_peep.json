    {
      "@id": "estleg:Reg_1043207_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Alusandmed deklarantide kohta esitab huvide deklaratsioonide registrile vallasekretär.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043207_Par_5"
