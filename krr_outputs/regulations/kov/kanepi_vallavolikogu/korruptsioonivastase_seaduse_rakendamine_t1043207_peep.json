      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Isikut teavitatakse viivitamata deklaratsiooni esitamise kohustusest vastava kohustuse tekkimisel. Teavitamise tagab vallasekretär.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043207_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
