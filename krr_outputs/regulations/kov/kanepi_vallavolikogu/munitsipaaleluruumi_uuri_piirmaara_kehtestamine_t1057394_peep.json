    {
      "@id": "estleg:Reg_1057394_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üüri piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Munitsipaaleluruumi üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Kanepi valla omandis olevate eluruumide üüri alammäär on 1 eurot ja ülemmäär 5 eurot kuus eluruumi üldpinna ühe ruutmeetri kohta. Nimetatud piirmäärad ei sisalda eluruumi kasutamisega seotud kõrvalkulusid (vee- ja kanalisatsiooniteenuse, kütte, elektrienergia, prügiveo jms). 2(2)Kanepi Vallavalitsusel on õigus diferentseerida üüri suurust võttes arvesse eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega, veevarustuse ja kanalisatsiooni olemasolu, eluruumis teostatud remonte ja…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kanepi valla omandis olevate eluruumide üüri alammäär on 1 eurot ja ülemmäär 5 eurot kuus eluruumi üldpinna ühe ruutmeetri kohta. Nimetatud piirmäärad ei sisalda eluruumi kasutamisega seotud kõrvalkulusid (vee- ja kanalisatsiooniteenuse, kütte, elektrienergia, prügiveo jms). 2(2)Kanepi Vallavalitsusel on õigus diferentseerida üüri suurust võttes arvesse eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega, veevarustuse ja kanalisatsiooni olemasolu, eluruumis teostatud remonte ja renoveerimisi, samuti taotleja majanduslikku olukorda.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0284"
