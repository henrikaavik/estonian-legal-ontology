      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Volikogu esimehe ja aseesimehe hüvitis",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavolikogu hüvitiste ja tasude määramine ning maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Volikogu esimehele makstakse hüvitist kohaliku omavalitsuse korralduse seaduse paragrahv 42 sätestatud ülesannete täitmise eest 1300 eurot kuus. RT IV 2022-12-27 8 427122022008 2022-12-30 , rakendataske alates 01.01.2023 2 (2) Volikogu aseesimehele makstakse hüvitist 390 eurot kuus. RT IV 2022-12-27 8 427122022008 2022-12-30 , rakendatakse alates 01.01.2023",
        "@language": "et"
      },
