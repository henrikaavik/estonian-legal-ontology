    },
    {
      "@id": "estleg:Reg_1048805_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Volikogu liikmetele hüvitatavad kulutused",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavolikogu hüvitiste ja tasude määramine ning maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Volikogu liikmele hüvitatakse volikogu ülesannete täitmisega seotud järgmised kulud: 1 1) lähetuskulud; 2 2) koolituskulud; 3 3) transpordikulud, v.a istungil osalemisega seotud kulud. 2 (2) Lähetuskäskkirja annab ja lähetuskulude aruande ning muude kulude väljamaksmise volikogu liikmele (välja arvatud volikogu esimehele) kinnitab volikogu esimees. 3 (3) Tehtud kulutuste hüvitamiseks esitab volikogu liige volikogu esimehele kulu tõendavad originaaldokumendid koos aruandega.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Volikogu liikmele hüvitatakse volikogu ülesannete täitmisega seotud järgmised kulud: 1 1) lähetuskulud; 2 2) koolituskulud; 3 3) transpordikulud, v.a istungil osalemisega seotud kulud. 2 (2) Lähetuskäskkirja annab ja lähetuskulude aruande ning muude kulude väljamaksmise volikogu liikmele (välja arvatud volikogu esimehele) kinnitab volikogu esimees. 3 (3) Tehtud kulutuste hüvitamiseks esitab volikogu liige volikogu esimehele kulu tõendavad originaaldokumendid koos aruandega. 4 (4) Volikogu esimehe lähetus- ja koolituskulude hüvitamise otsuse teeb volikogu oma korralisel istungil.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavolikogu"
