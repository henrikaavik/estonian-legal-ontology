      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ühe õpilase kohta kantakse ühe huvikooli õppekoha või ühe huvitegevuse kulud ühes õppeaastas.",
      "estleg:parentProvision": {
