    {
      "@id": "estleg:Reg_1054404_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Toetuse liigid ja määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Huvihariduse ja huvitegevuse toetus on: 1 1) huvikooli toetus, mida makstakse huvikooli kulude katmiseks 100% õpilaskoha ja õppetasu maksumusest kuni 50 eurot õppekuus; 2 2) huvitegevuse toetus, mida makstakse osavõtutasust (õppemaksust, liikmemaksust, vm. teenusel osalemise tasust) kuni 50 eurot õppekuus. 2 (2) Sõidukulude hüvitist on õigus taotleda puudega lapse vanemal, kolme ja enama lapsega või toimetulekutoetust saaval perel huvihariduse omandamise või huvitegevuse harrastamisega…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Huvihariduse ja huvitegevuse toetus on: 1 1) huvikooli toetus, mida makstakse huvikooli kulude katmiseks 100% õpilaskoha ja õppetasu maksumusest kuni 50 eurot õppekuus; 2 2) huvitegevuse toetus, mida makstakse osavõtutasust (õppemaksust, liikmemaksust, vm. teenusel osalemise tasust) kuni 50 eurot õppekuus. 2 (2) Sõidukulude hüvitist on õigus taotleda puudega lapse vanemal, kolme ja enama lapsega või toimetulekutoetust saaval perel huvihariduse omandamise või huvitegevuse harrastamisega tekkinud sõidukulude hüvitamiseks. Sõidukulude hüvitamise toetust makstakse kuni 30 eurot õppekuus kuludokumentide alusel, arvestades ühe läbitud kilomeetri hinnaks 30 senti.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavolikogu"
      },
