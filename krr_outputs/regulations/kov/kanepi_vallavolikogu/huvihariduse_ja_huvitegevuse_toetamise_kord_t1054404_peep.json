      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala ja eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määrusega kehtestatakse huvikoolides õppivatele või muu huvitegevusega tegelevatele, eeskätt 7 kuni 19-aastastele, üldhariduskoolides õppivatele noortele valla eelarvest huvihariduse toetuse (edaspidi ka toetus) andmise kord. Nooremate kui 7-aastaste laste huvihariduses või- tegevuses osalemist toetatakse põhjendatud juhul, lähtuvalt lapse vajadustest ja saavutustest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määrusega kehtestatakse huvikoolides õppivatele või muu huvitegevusega tegelevatele, eeskätt 7 kuni 19-aastastele, üldhariduskoolides õppivatele noortele valla eelarvest huvihariduse toetuse (edaspidi ka toetus) andmise kord. Nooremate kui 7-aastaste laste huvihariduses või- tegevuses osalemist toetatakse põhjendatud juhul, lähtuvalt lapse vajadustest ja saavutustest. 2 (2) Toetuse eesmärk on soodustada Kanepi valla laste ja noorte huvikoolides õppimist ja avardada võimalusi muu huvitegevusega tegelemiseks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0284"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054404_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1054404_Par_1_Lg_1"
