    {
      "@id": "estleg:Reg_1054404_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toetuse määramise kriteeriumid",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Kanepi vald osaleb õpilase huvihariduse toetamisel eelarveliste vahendite olemasolu korral järgmistel tingimustel: 1 1) õpilase ja tema vähemalt ühe vanema või eestkostja alaline elukoht on Eesti rahvastikuregistri andmetel Kanepi vallas; 2 2) toetuse taotleja on vallavalitsusele tähtaegselt esitanud avalduse ja taotleja on esitanud osalustasu maksmist tõendava dokumendi; 3 3) toetuse taotleja perekonnal ei ole toetuse taotlemise ajal võlgnevusi Kanepi valla ees.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kanepi vald osaleb õpilase huvihariduse toetamisel eelarveliste vahendite olemasolu korral järgmistel tingimustel: 1 1) õpilase ja tema vähemalt ühe vanema või eestkostja alaline elukoht on Eesti rahvastikuregistri andmetel Kanepi vallas; 2 2) toetuse taotleja on vallavalitsusele tähtaegselt esitanud avalduse ja taotleja on esitanud osalustasu maksmist tõendava dokumendi; 3 3) toetuse taotleja perekonnal ei ole toetuse taotlemise ajal võlgnevusi Kanepi valla ees. 2 (2) Ühe õpilase kohta kantakse ühe huvikooli õppekoha või ühe huvitegevuse kulud ühes õppeaastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kanepi_vallavolikogu"
      },
