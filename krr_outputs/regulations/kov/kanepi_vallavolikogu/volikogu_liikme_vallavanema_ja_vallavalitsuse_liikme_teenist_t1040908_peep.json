    {
      "@id": "estleg:Reg_1040908_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lähetatule hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulu ning lähetusülesande täitmisega seotud muud kulud ning makstakse välislähetuses viibimise aja eest päevaraha Vabariigi Valitsuse määrusega kehtestatud ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimustel ja korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040908_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
