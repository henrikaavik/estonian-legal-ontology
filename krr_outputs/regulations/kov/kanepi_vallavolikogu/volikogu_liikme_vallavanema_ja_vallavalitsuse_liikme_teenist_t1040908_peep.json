    },
    {
      "@id": "estleg:Reg_1040908_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lähetatul on õigus nõuda lähetusega kaasnevate kulude eeldatavas suuruses avanssi mõistliku aja jooksul, kuid mitte hiljem kui kaks tööpäeva enne lähetuse algust. Kui lähetatu ei saa avanssi, võib ta lähetusest keelduda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040908_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
