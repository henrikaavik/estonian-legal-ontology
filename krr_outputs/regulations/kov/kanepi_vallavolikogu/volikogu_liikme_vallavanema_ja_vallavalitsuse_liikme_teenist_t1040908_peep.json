      }
    },
    {
      "@id": "estleg:Reg_1040908_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lähetuskulusid tõendavad dokumendid esitatakse valla raamatupidamisele. Kõik hüvitatavad kulud peavad olema dokumentaalselt tõendatud.",
      "estleg:parentProvision": {
