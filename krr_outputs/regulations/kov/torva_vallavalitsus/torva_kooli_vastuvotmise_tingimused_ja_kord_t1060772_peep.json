    },
    {
      "@id": "estleg:Reg_1060772_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kool tagab õppimisvõimalused igale selleks soovi avaldanud koolikohustuslikule õpilasele, kellele see kool on elukohajärgne kool.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060772_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1060772_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kooli vastuvõtmiseks esitab kooli sisseastuja või piiratud teovõimega sisseastuja puhul vanem kooli vastuvõtu tingimustes ja korras määratud vormis taotluse, millele lisab: 1) lapse isikut tõendava dokumendi koopia; 2) vanema isikut tõendava dokumendi koopia; 3) tervisekaardi (selle olemasolul); 4) eelmise õppeasutuse ametlikult kinnitatud klassitunnistuse või õpinguraamatu väljavõtte ning hinnetelehe jooksva õppeaasta trimestri/kursuse hinnetega, kui õpilane asub kooli õppima õppeaasta kestel; 5) koolivalmiduskaardi (1. klassi astudes selle olemasolul); 6) nõustamismeeskonna otsuse (selle olemasolul).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060772_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    },
    {
      "@id": "estleg:Reg_1060772_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Sisseastuja või vanem ei pea taotlusele lisama enda isikut tõendava dokumendi koopiat digitaalallkirjaga kinnitatud taotluse esitamise korral.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060772_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1060772_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Taotluse lapse kooli astumiseks esitab lapsevanem elektrooniliselt kooli e-postile kool@torvakool.edu.ee.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060772_Par_2"
      },
      "rdfs:label": "§ 2 lg 4"
