      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kord avalikustatakse kooli kodulehel http://www.torvakool.edu.ee/.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060772_Par_1"
      },
      "rdfs:label": "§ 1 lg 4"
    },
    {
      "@id": "estleg:Reg_1060772_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Vastuvõtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Tõrva Kooli vastuvõtmise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Kool tagab õppimisvõimalused igale selleks soovi avaldanud koolikohustuslikule õpilasele, kellele see kool on elukohajärgne kool. 2(2)Kooli vastuvõtmiseks esitab kooli sisseastuja või piiratud teovõimega sisseastuja puhul vanem kooli vastuvõtu tingimustes ja korras määratud vormis taotluse, millele lisab:11) lapse isikut tõendava dokumendi koopia;22) vanema isikut tõendava dokumendi koopia;33) tervisekaardi (selle olemasolul);44) eelmise õppeasutuse ametlikult kinnitatud klassitunnistuse…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kool tagab õppimisvõimalused igale selleks soovi avaldanud koolikohustuslikule õpilasele, kellele see kool on elukohajärgne kool. 2(2)Kooli vastuvõtmiseks esitab kooli sisseastuja või piiratud teovõimega sisseastuja puhul vanem kooli vastuvõtu tingimustes ja korras määratud vormis taotluse, millele lisab:11) lapse isikut tõendava dokumendi koopia;22) vanema isikut tõendava dokumendi koopia;33) tervisekaardi (selle olemasolul);44) eelmise õppeasutuse ametlikult kinnitatud klassitunnistuse või õpinguraamatu väljavõtte ning hinnetelehe jooksva õppeaasta trimestri/kursuse hinnetega, kui õpilane asub kooli õppima õppeaasta kestel;55) koolivalmiduskaardi (1. klassi astudes selle olemasolul);66) nõustamismeeskonna otsuse (selle olemasolul). 3(3)Sisseastuja või vanem ei pea taotlusele lisama enda isikut tõendava dokumendi koopiat digitaalallkirjaga kinnitatud taotluse esitamise korral. 4(4)Taotluse lapse kooli astumiseks esitab lapsevanem elektrooniliselt kooli e-postile kool@torvakool.edu.ee.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
      },
