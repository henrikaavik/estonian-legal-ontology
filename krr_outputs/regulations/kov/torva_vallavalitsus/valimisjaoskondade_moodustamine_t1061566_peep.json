      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevaringses hoolekandeasutuses. 2(2)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevaringses hoolekandeasutuses. 3(3)Kodus hääletamist korraldavad valimisjaoskonnad nr 1, 2, 3 ja 4.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevaringses hoolekandeasutuses. 2(2)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevaringses hoolekandeasutuses. 3(3)Kodus hääletamist korraldavad valimisjaoskonnad nr 1, 2, 3 ja 4. Euroopa Parlamendi valimistel ja rahvahääletusel korraldavad need jaoskonnad ka asukohas hääletamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
