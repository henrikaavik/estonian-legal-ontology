    },
    {
      "@id": "estleg:Reg_1061566_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevaringses hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061566_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1061566_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad valimisjaoskonnad nr 1, 2, 3 ja 4. Euroopa Parlamendi valimistel ja rahvahääletusel korraldavad need jaoskonnad ka asukohas hääletamist.",
