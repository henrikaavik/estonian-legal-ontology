      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Õppetasu tasumise kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Tõrva Muusikakooli õppetasu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063772_Map"
      },
      "estleg:summary": {
        "@value": "1(1)Õppetasu tasutakse iga kuu 20. kuupäevaks eelmise kuu eest. 2(2)Õppetasu tasumise periood on üheksa kuud aastas, õppetasu ei maksta juuni-, juuli- ja augustikuu eest. 3(3)Õppetasu makstakse arve alusel Tõrva Vallavalitsuse arveldusarvele. 4(4)Õpilase koolist välja langemise korral makstud õppetasu ei tagastata.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Õppetasu tasutakse iga kuu 20. kuupäevaks eelmise kuu eest. 2(2)Õppetasu tasumise periood on üheksa kuud aastas, õppetasu ei maksta juuni-, juuli- ja augustikuu eest. 3(3)Õppetasu makstakse arve alusel Tõrva Vallavalitsuse arveldusarvele. 4(4)Õpilase koolist välja langemise korral makstud õppetasu ei tagastata.",
