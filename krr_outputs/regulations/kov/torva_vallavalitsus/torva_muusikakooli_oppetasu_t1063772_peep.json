      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppetasu suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Tõrva Muusikakooli õppetasu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063772_Map"
      },
      "estleg:summary": {
        "@value": "Õppetasu suurus ühes kuus on:11) põhiõppes 32 eurot;22) lisa-aasta õppes 25 eurot;33) ettevalmistusklassis (1 rühmatund nädalas) 20 eurot;44) ettevalmistusklassis (1 rühmatund ja 1 pillitund nädalas) 25 eurot;55) huviõppes 32 eurot;66) vabaõppes 35 eurot;77) vabaõppes täiskasvanule (1 pillitund nädalas) 50 eurot, iga pillitunnile lisaks valitud tund 25 eurot;88) lauluosakonnas 10 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Õppetasu suurus ühes kuus on:11) põhiõppes 32 eurot;22) lisa-aasta õppes 25 eurot;33) ettevalmistusklassis (1 rühmatund nädalas) 20 eurot;44) ettevalmistusklassis (1 rühmatund ja 1 pillitund nädalas) 25 eurot;55) huviõppes 32 eurot;66) vabaõppes 35 eurot;77) vabaõppes täiskasvanule (1 pillitund nädalas) 50 eurot, iga pillitunnile lisaks valitud tund 25 eurot;88) lauluosakonnas 10 eurot.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063772_Par_2_Lg_1"
        }
      ],
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
      }
    },
    {
      "@id": "estleg:Reg_1063772_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Õppetasu suurus ühes kuus on: 1) põhiõppes 32 eurot; 2) lisa-aasta õppes 25 eurot; 3) ettevalmistusklassis (1 rühmatund nädalas) 20 eurot; 4) ettevalmistusklassis (1 rühmatund ja 1 pillitund nädalas) 25 eurot; 5) huviõppes 32 eurot; 6) vabaõppes 35 eurot; 7) vabaõppes täiskasvanule (1 pillitund nädalas) 50 eurot, iga pillitunnile lisaks valitud tund 25 eurot; 8) lauluosakonnas 10 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063772_Par_2"
      },
