      "estleg:summary": {
        "@value": "Pere teisele ja igale järgmisele Tõrva Muusikakooli põhiõppes õppivale rahvastikuregistri andmetel Tõrva vallas elavale alaealisele õppurile on seaduslikul esindajal õigus taotleda õppetasu vähendamist 50% võrra, esitades vastava avalduse Tõrva Muusikakooli direktorile.",
        "@language": "et"
      },
