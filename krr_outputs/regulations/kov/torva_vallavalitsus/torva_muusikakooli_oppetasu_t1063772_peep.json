      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Tõrva Muusikakoolis õppekulu osaliseks katmiseks õppetasu suurus ja tasu maksmisest vabastamise kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Tõrva Muusikakoolis õppekulu osaliseks katmiseks õppetasu suurus ja tasu maksmisest vabastamise kord.",
