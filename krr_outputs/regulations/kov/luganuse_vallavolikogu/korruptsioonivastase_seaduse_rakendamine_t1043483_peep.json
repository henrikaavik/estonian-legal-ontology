      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Vallavanema ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab:11) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest;22) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle;33) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes;44) arvestuse pidamise…",
        "@language": "et"
      },
      "estleg:legalText": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab:11) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest;22) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle;33) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes;44) arvestuse pidamise ametiasutuse ametnike tegelemise üle avaliku teenistuse seaduses nimetatud kõrvaltegevustega, samuti kontrolli avaliku teenistuse seaduses kehtestatud keeldude järgimise üle.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luganuse_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0442"
      },
