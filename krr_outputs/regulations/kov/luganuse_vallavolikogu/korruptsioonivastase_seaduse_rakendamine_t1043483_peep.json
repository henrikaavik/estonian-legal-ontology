      "estleg:summary": {
        "@value": "1(1)Sonda Vallavolikogu 16.04.2014 määrus nr 5 „Korruptsioonivastase seaduse rakendamise kord“ tunnistatakse kehtetuks. 2(2)Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
        "@language": "et"
