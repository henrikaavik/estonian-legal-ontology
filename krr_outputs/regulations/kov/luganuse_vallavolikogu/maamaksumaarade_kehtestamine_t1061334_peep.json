      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Vastavalt maa sihtotstarbegrupile on maamaksumäärad alates 1. jaanuarist 2026:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Vastavalt maa sihtotstarbegrupile on maamaksumäärad alates 1. jaanuarist 2026:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luganuse_vallavolikogu"
      },
