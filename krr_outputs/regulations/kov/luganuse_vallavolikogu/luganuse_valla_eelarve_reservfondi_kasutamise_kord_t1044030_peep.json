      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reservfondi moodustamine ja käsutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lüganuse valla eelarve reservfondi kasutamise kord",
      "estleg:summary": {
        "@value": "1(1)Lüganuse valla eelarve (edaspidi eelarve) reservfondi (edaspidi reservfond) suuruse igaks eelarveaastaks määrab Lüganuse Vallavolikogu (edaspidi volikogu) eelarve vastuvõtmisel eelarve koosseisus. 2(2)Reservfondi suurust eelarveaasta jooksul võib volikogu muuta lisaeelarve vastuvõtmise teel. 3(3)Reservfondi jaotamisel lisaeelarvet ei koostata. 4(4)Reservfondi käsutab Lüganuse Vallavalitsus (edaspidi vallavalitsus).",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Lüganuse valla eelarve (edaspidi eelarve) reservfondi (edaspidi reservfond) suuruse igaks eelarveaastaks määrab Lüganuse Vallavolikogu (edaspidi volikogu) eelarve vastuvõtmisel eelarve koosseisus. 2(2)Reservfondi suurust eelarveaasta jooksul võib volikogu muuta lisaeelarve vastuvõtmise teel. 3(3)Reservfondi jaotamisel lisaeelarvet ei koostata. 4(4)Reservfondi käsutab Lüganuse Vallavalitsus (edaspidi vallavalitsus).",
