      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Rakendussätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Kiviõli Linnavolikogu 29.06.2010 määrus nr 16 „Üüri piirmäära kehtestamine“ tunnistatakse kehtetuks. 2(2)Sonda Vallavolikogu 18.12.2008 määrus nr 19 „Üüri piirmäära kehtestamine“ tunnistatakse kehtetuks. 3(3)Püssi Linnavolikogu 30.10.2008 määrus nr 40 „Munitsipaalomandis olevate eluruumide üürihindade kehtestamine“ tunnistatakse kehtetuks. 4(4)Maidla Vallavolikogu 26.06.2012 määrus nr 40 „Eluruumide üürihinna piirmäära kehtestamine“ tunnistatakse kehtetuks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kiviõli Linnavolikogu 29.06.2010 määrus nr 16 „Üüri piirmäära kehtestamine“ tunnistatakse kehtetuks. 2(2)Sonda Vallavolikogu 18.12.2008 määrus nr 19 „Üüri piirmäära kehtestamine“ tunnistatakse kehtetuks. 3(3)Püssi Linnavolikogu 30.10.2008 määrus nr 40 „Munitsipaalomandis olevate eluruumide üürihindade kehtestamine“ tunnistatakse kehtetuks. 4(4)Maidla Vallavolikogu 26.06.2012 määrus nr 40 „Eluruumide üürihinna piirmäära kehtestamine“ tunnistatakse kehtetuks. 5(5)Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luganuse_vallavolikogu"
      },
