    {
      "@id": "estleg:Reg_1057275_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üüri piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Kehtestada Lüganuse valla omandis olevate eluruumide üüri maksimaalseks piirmääraks 5,00 eurot eluruumi üldpinna ühe ruutmeetri kohta ühes kalendrikuus. 2(2)Üüri suuruse eluruumi üldpinna ühe ruutmeetri kohta kuus kehtestab Lüganuse Vallavalitsus määrusega. Üüri suurus eluruumi üldpinna ühe ruutmeetri kohta võib olla diferentseeritud arvestades eluruumi heakorrastust, ehituslikku seisundit ja muid olulisi asjaolusid ning käesoleva paragrahvi lõikes 1 sätestatut.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kehtestada Lüganuse valla omandis olevate eluruumide üüri maksimaalseks piirmääraks 5,00 eurot eluruumi üldpinna ühe ruutmeetri kohta ühes kalendrikuus. 2(2)Üüri suuruse eluruumi üldpinna ühe ruutmeetri kohta kuus kehtestab Lüganuse Vallavalitsus määrusega. Üüri suurus eluruumi üldpinna ühe ruutmeetri kohta võib olla diferentseeritud arvestades eluruumi heakorrastust, ehituslikku seisundit ja muid olulisi asjaolusid ning käesoleva paragrahvi lõikes 1 sätestatut.",
      "estleg:enactedBy": {
