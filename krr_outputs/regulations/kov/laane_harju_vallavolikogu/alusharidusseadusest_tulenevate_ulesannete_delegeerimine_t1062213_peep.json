      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Alusharidusseaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Alusharidusseadusest tulenevate ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) Delegeerida alusharidusseaduse § 5 lõigetes 5–8, § 6-s, § 10 lõikes 6, § 12 lõigetes 3 ja 8, § 16 lõikes 4, § 19 lõikes 3, §-des 20 ja 21, § 25 lõigetes 2 ja 4, § 27 lõikes 1, §-s 42, § 46 lõikes 4 toidukulu päevamaksumuse kinnitamise osas ja lõikes 5, § 48 lõikes 1, § 51 lõikes 2 ja §-s 57 kohaliku omavalitsuse üksuse ning lasteaia pidaja pädevusse antud ülesannete lahendamine Lääne-Harju Vallavalitsusele.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Delegeerida alusharidusseaduse § 5 lõigetes 5–8, § 6-s, § 10 lõikes 6, § 12 lõigetes 3 ja 8, § 16 lõikes 4, § 19 lõikes 3, §-des 20 ja 21, § 25 lõigetes 2 ja 4, § 27 lõikes 1, §-s 42, § 46 lõikes 4 toidukulu päevamaksumuse kinnitamise osas ja lõikes 5, § 48 lõikes 1, § 51 lõikes 2 ja §-s 57 kohaliku omavalitsuse üksuse ning lasteaia pidaja pädevusse antud ülesannete lahendamine Lääne-Harju Vallavalitsusele. 2 (2) Lääne-Harju Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel struktuuriüksus või ametnikud, kes täidavad käesoleva paragrahvi lõikes 1 nimetatud ülesandeid.",
      "estleg:enactedBy": {
