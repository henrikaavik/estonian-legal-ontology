      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Piletihinnad ja sõidusoodustused valla siseliinidel",
        "@language": "et"
      },
      "estleg:sourceAct": "Ühistranspordi korraldamine Lääne-Harju valla siseliinidel",
      "estleg:summary": {
        "@value": "Valla siseliinidel kehtivad Harju maakonna avalike maakonnaliinide piletitsoonid, piletihinnad, sõidusoodustused ja sõidusoodustust tõendavad dokumendid ning riiklikult kehtestatud tasuta sõiduõigus.",
        "@language": "et"
      },
      "estleg:legalText": "Valla siseliinidel kehtivad Harju maakonna avalike maakonnaliinide piletitsoonid, piletihinnad, sõidusoodustused ja sõidusoodustust tõendavad dokumendid ning riiklikult kehtestatud tasuta sõiduõigus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_harju_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0431"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060166_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1060166_Par_2_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1060166_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valla siseliinidel kehtivad Harju maakonna avalike maakonnaliinide piletitsoonid, piletihinnad, sõidusoodustused ja sõidusoodustust tõendavad dokumendid ning riiklikult kehtestatud tasuta sõiduõigus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060166_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1060166_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Sõiduõigust tõendavad dokumendid",
        "@language": "et"
      },
      "estleg:sourceAct": "Ühistranspordi korraldamine Lääne-Harju valla siseliinidel",
      "estleg:summary": {
        "@value": "Sõiduõigust tõendavad dokumendid on: 1 1) soodustuseta sõitjale – juhilt ostetud paberüksikpilet, ühiskaardile ostetud e-üksikpilet või ühiskaardil olev perioodipilet; 2 2) õpilasele – süsteemiga kohanduv isikustatud elektrooniline õpilaspilet, sealhulgas ISIC ja ITIC kaart; 3 3) puudega lastele – vaegurluse ekspertiisi komisjoni otsus koos isikut tõendava dokumendi või õpilaspiletiga või puudega isiku kaart; 4 4) sügava puudega 16-aastastele ja vanematele isikutele – vaegurluse ekspertiisi…",
        "@language": "et"
      },
      "estleg:legalText": "Sõiduõigust tõendavad dokumendid on: 1 1) soodustuseta sõitjale – juhilt ostetud paberüksikpilet, ühiskaardile ostetud e-üksikpilet või ühiskaardil olev perioodipilet; 2 2) õpilasele – süsteemiga kohanduv isikustatud elektrooniline õpilaspilet, sealhulgas ISIC ja ITIC kaart; 3 3) puudega lastele – vaegurluse ekspertiisi komisjoni otsus koos isikut tõendava dokumendi või õpilaspiletiga või puudega isiku kaart; 4 4) sügava puudega 16-aastastele ja vanematele isikutele – vaegurluse ekspertiisi komisjoni otsus koos isikut tõendava dokumendiga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_harju_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0431"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060166_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1060166_Par_3_Lg_1"
