      "estleg:sourceAct": "Represseeritu ja represseerituga võrdsustatud isiku maamaksust vabastamise kord",
      "estleg:summary": {
        "@value": "Isik vabastatakse maamaksust tema kasutuses oleva elamumaa või maatulundusmaa õuemaa kõlviku osas.",
        "@language": "et"
      },
      "estleg:legalText": "Isik vabastatakse maamaksust tema kasutuses oleva elamumaa või maatulundusmaa õuemaa kõlviku osas.",
