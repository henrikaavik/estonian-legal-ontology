    {
      "@id": "estleg:Reg_1041335_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksust vabastatavad isikud",
        "@language": "et"
      },
      "estleg:sourceAct": "Represseeritu ja represseerituga võrdsustatud isiku maamaksust vabastamise kord",
      "estleg:summary": {
        "@value": "Maksuvabastust saab okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes represseeritud ja represseerituga võrdsustatud isik, kelle kasutuses on elamumaa sihtotstarbega või õuemaa kõlvikut sisaldav maatulundusmaa sihtotstarbega katastriüksus Lääne-Harju vallas tingimusel, et maksuvabastuse taotleja ei saa maa kasutusõiguse alusel rendi- või üüritulu.",
        "@language": "et"
      },
      "estleg:legalText": "Maksuvabastust saab okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes represseeritud ja represseerituga võrdsustatud isik, kelle kasutuses on elamumaa sihtotstarbega või õuemaa kõlvikut sisaldav maatulundusmaa sihtotstarbega katastriüksus Lääne-Harju vallas tingimusel, et maksuvabastuse taotleja ei saa maa kasutusõiguse alusel rendi- või üüritulu.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_harju_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0431"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041335_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1041335_Par_2_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1041335_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Maksuvabastust saab okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes represseeritud ja represseerituga võrdsustatud isik, kelle kasutuses on elamumaa sihtotstarbega või õuemaa kõlvikut sisaldav maatulundusmaa sihtotstarbega katastriüksus Lääne-Harju vallas tingimusel, et maksuvabastuse taotleja ei saa maa kasutusõiguse alusel rendi- või üüritulu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041335_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:targetGroup": [
