      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Määrus reguleerib Lääne-Harju valla haldusterritooriumil asuva maa maksustamist.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus reguleerib Lääne-Harju valla haldusterritooriumil asuva maa maksustamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_harju_vallavolikogu"
