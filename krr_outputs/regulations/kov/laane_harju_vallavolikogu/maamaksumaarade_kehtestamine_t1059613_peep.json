    {
      "@id": "estleg:Reg_1059613_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Elamumaa ja maatulundusmaa õuemaa kõlviku maksumäär on 0,75 protsenti maa maksustamishinnast aastas. 2 (2) Käesoleva paragrahvi lõikes 1 nimetamata maatulundusmaa maksumäär on 0,5 protsenti maa maksustamishinnast aastas. 3 (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetamata sihtotstarbega maa maksumäär on 1,75 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Elamumaa ja maatulundusmaa õuemaa kõlviku maksumäär on 0,75 protsenti maa maksustamishinnast aastas. 2 (2) Käesoleva paragrahvi lõikes 1 nimetamata maatulundusmaa maksumäär on 0,5 protsenti maa maksustamishinnast aastas. 3 (3) Käesoleva paragrahvi lõigetes 1 ja 2 nimetamata sihtotstarbega maa maksumäär on 1,75 protsenti maa maksustamishinnast aastas.",
