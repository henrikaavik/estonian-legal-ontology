    {
      "@id": "estleg:Reg_1040967_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ametnik peab: 1) tundma riigi põhikorda (põhiseadus ja põhiseaduslikud seadused), kodanike põhiõigusi ja -vabadusi ning avaliku halduse organisatsiooni; 2) tundma kohaliku omavalitsuse korraldust reguleerivaid õigusakte ja asjaajamiskorra aluseid ning neid teenistusülesannete täitmisel täitma; 3) tundma avalikku teenistust reguleerivaid õigusakte; 4) tundma oma teenistusvaldkonda reguleerivaid õigusakte ning oskama neid teenistusülesannete täitmisel rakendada; 5) omama arvuti kasutamise oskust ja oskama kasutada kohaliku omavalitsuse infosüsteeme, sealhulgas ametikohal vajalikke teksti- ja tabeltöötlusprogramme ning teisi ametikohal vajalikke arvutiprogramme ja andmekogusid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040967_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:dutyHolder": [
