        }
      ]
    },
    {
      "@id": "estleg:Reg_1040967_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ametnik peab valdama eesti keelt kõrgtasemel kõnes ja kirjas, osakonnajuhatajatel tuleb kasuks vähemalt ühe võõrkeele oskus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1040967_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:assertionConfidence": {
