    },
    {
      "@id": "estleg:Reg_1043264_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse õppepreemia andmise kord Hiiumaa valla elanikust üldhariduskooli ja kutseõppeasutuse õpilasele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043264_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1043264_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppepreemia taotlemise alused",
        "@language": "et"
      },
      "estleg:sourceAct": "Hiiumaa valla õppepreemia andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Preemiat makstakse õpilasele, kes: 1 1) lõpetab põhikooli kiitusega; 2 2) lõpetab gümnaasiumi kuld- või hõbemedaliga; 3 3) lõpetab kutseõppeasutuse kiitusega. 2 (2) Preemiataotluse esitab kool kirjalikult Hiiumaa Vallavalitsusele igal aastal 25. maiks. 3 (3) Informatsioon preemia taotlemise kohta avaldatakse Hiiumaa valla veebilehel ja valla lehes, lisaks teavitab haridus- ja kultuuriosakond väljaspool Hiiumaad asuvat kooli, kus korra § 1 nimetatud õpilane õpib.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Preemiat makstakse õpilasele, kes: 1 1) lõpetab põhikooli kiitusega; 2 2) lõpetab gümnaasiumi kuld- või hõbemedaliga; 3 3) lõpetab kutseõppeasutuse kiitusega. 2 (2) Preemiataotluse esitab kool kirjalikult Hiiumaa Vallavalitsusele igal aastal 25. maiks. 3 (3) Informatsioon preemia taotlemise kohta avaldatakse Hiiumaa valla veebilehel ja valla lehes, lisaks teavitab haridus- ja kultuuriosakond väljaspool Hiiumaad asuvat kooli, kus korra § 1 nimetatud õpilane õpib.",
