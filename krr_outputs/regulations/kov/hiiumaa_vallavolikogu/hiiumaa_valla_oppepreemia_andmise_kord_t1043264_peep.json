      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Õppepreemia suurus ja määramine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hiiumaa valla õppepreemia andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Väärtustamaks kooliharidust ja õppimist tunnustatakse: 1 1) põhikooli kiitusega lõpetajat 200 euroga; 2 2) gümnaasiumi kuldmedaliga lõpetajat 350 euroga; 3 3) gümnaasiumi hõbemedaliga lõpetajat 200 euroga; 4 4) kutseõppeasutuse kiitusega lõpetajat 350 euroga. 2 (2) Otsuse õppepreemia maksmise kohta teeb Hiiumaa Vallavalitsus korraldusega. 3 (3) Õppepreemiaga kaasneb valla tänukiri. RT IV2021-05-2964290520210062021-06-01",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Väärtustamaks kooliharidust ja õppimist tunnustatakse: 1 1) põhikooli kiitusega lõpetajat 200 euroga; 2 2) gümnaasiumi kuldmedaliga lõpetajat 350 euroga; 3 3) gümnaasiumi hõbemedaliga lõpetajat 200 euroga; 4 4) kutseõppeasutuse kiitusega lõpetajat 350 euroga. 2 (2) Otsuse õppepreemia maksmise kohta teeb Hiiumaa Vallavalitsus korraldusega. 3 (3) Õppepreemiaga kaasneb valla tänukiri. RT IV2021-05-2964290520210062021-06-01",
