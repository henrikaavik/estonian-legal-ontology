        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Hiiumaa valla õppepreemia andmise kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse õppepreemia andmise kord Hiiumaa valla elanikust üldhariduskooli ja kutseõppeasutuse õpilasele.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse õppepreemia andmise kord Hiiumaa valla elanikust üldhariduskooli ja kutseõppeasutuse õpilasele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_hiiumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0205"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043264_Map"
