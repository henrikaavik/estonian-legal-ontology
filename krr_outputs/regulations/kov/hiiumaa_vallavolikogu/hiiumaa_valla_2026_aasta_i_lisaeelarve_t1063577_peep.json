      },
      "estleg:sourceAct": "Hiiumaa valla 2026. aasta I lisaeelarve",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063577_Map"
      },
      "estleg:summary": {
        "@value": "1) paragrahvi 2 punkti 5 muudetakse ja sõnastatakse järgmiselt:\"5) võtta 2026. aasta investeeringute ja põhivara soetamiseks laenu kuni 4 400 000 eurot tähtajaga kuni 10 aastat ning volitada vallavanemat sõlmima vastavat lepingut;\".",
        "@language": "et"
      },
      "estleg:legalText": "1) paragrahvi 2 punkti 5 muudetakse ja sõnastatakse järgmiselt:\"5) võtta 2026. aasta investeeringute ja põhivara soetamiseks laenu kuni 4 400 000 eurot tähtajaga kuni 10 aastat ning volitada vallavanemat sõlmima vastavat lepingut;\".",
