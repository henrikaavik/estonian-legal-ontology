      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Hiiumaa Vallavolikogu 19.02.2026 määrust nr 8 \"Hiiumaa valla 2026. aasta eelarve\" muudetakse järgmiselt:",
