    {
      "@id": "estleg:Reg_1053400_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Toetuse tagasinõudmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hiiumaa valla perearstiteenuse toetuse maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Vallavalitsusel on õigus toetus tagasi nõuda, kui toetuse saaja lõpetab enne viie aasta möödumist toetuse saamisest alates vallas perearstina töötamise. Toetuse saaja on kohustatud eelnimetatud sündmuse saabumisel teavitama kirjalikult vallavalitsust. 2 (2) Töötamine või tegutsemine loetakse peatunuks toetuse saaja lapsehoolduspuhkuse või ajateenistuskohustuse täitmise ajal ning toetuse saaja töötamise või tegutsemise kohustus pikeneb nimetatud aja võrra.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vallavalitsusel on õigus toetus tagasi nõuda, kui toetuse saaja lõpetab enne viie aasta möödumist toetuse saamisest alates vallas perearstina töötamise. Toetuse saaja on kohustatud eelnimetatud sündmuse saabumisel teavitama kirjalikult vallavalitsust. 2 (2) Töötamine või tegutsemine loetakse peatunuks toetuse saaja lapsehoolduspuhkuse või ajateenistuskohustuse täitmise ajal ning toetuse saaja töötamise või tegutsemise kohustus pikeneb nimetatud aja võrra. Toetuse saaja on kohustatud eelnimetatud sündmuse saabumisel kirjalikult vallavalitsust teavitama. 3 (3) Töötamine või tegutsemine loetakse pidevaks perearsti ajutise töövõimetuse ajal või juhul, kui toetust saanud isiku perearstina töötamise staaž ei katke viieaastase perioodi kestel rohkem kui kolmeks kuuks. 4 (4) Toetus tuleb maksta tagasi toetuse tagasimaksmise teatise esitamisest arvates kolme aasta jooksul igal aastal ühe kolmandiku suuruses osas tagasimaksmisele kuuluvast toetuse summast. 5 (5) Toetuse saaja hüvitab talle väljamakstud toetuse proportsionaalselt määruses nimetatud aja lõpuni jäänud ajaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_hiiumaa_vallavolikogu"
      },
