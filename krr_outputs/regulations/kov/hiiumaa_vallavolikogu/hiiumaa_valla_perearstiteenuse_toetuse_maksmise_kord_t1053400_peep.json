    },
    {
      "@id": "estleg:Reg_1053400_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Perearsti toetus (edaspidi toetus) on valla eelarvest ühekordselt makstav rahaline toetus vallas nimistuga töötamist alustavale perearstile, kelle vastuvõtukoht asub vallas.",
