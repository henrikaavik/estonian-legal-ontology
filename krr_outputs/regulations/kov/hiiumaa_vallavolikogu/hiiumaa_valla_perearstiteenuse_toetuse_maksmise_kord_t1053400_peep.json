      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Hiiumaa valla perearstiteenuse toetuse maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Hiiumaa valla (edaspidi vald) perearstiteenuse toetuse maksmise kord (edaspidi kord) reguleerib vallas nimistuga tööd alustavale perearstile makstava toetuse taotlemist, maksmist ning tagasinõudmist. 2 (2) Perearsti toetus (edaspidi toetus) on valla eelarvest ühekordselt makstav rahaline toetus vallas nimistuga töötamist alustavale perearstile, kelle vastuvõtukoht asub vallas.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Hiiumaa valla (edaspidi vald) perearstiteenuse toetuse maksmise kord (edaspidi kord) reguleerib vallas nimistuga tööd alustavale perearstile makstava toetuse taotlemist, maksmist ning tagasinõudmist. 2 (2) Perearsti toetus (edaspidi toetus) on valla eelarvest ühekordselt makstav rahaline toetus vallas nimistuga töötamist alustavale perearstile, kelle vastuvõtukoht asub vallas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_hiiumaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0205"
