      "estleg:summary": {
        "@value": "1 (1) Hiiumaa valla „Aasta õpetaja“ tunnustussüsteem on seotud üleriigilise tunnustussüsteemiga. 2 (2) Hiiumaa vald tunnustab täiendavalt järgmistes kategooriates: 1 1) aasta noorsootöötaja; 2 2) hariduse elutööpreemia.",
        "@language": "et"
      },
