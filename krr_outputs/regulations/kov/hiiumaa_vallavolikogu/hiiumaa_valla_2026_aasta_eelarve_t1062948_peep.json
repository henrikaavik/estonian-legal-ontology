      },
      "estleg:sourceAct": "Hiiumaa valla 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "Kinnitada Hiiumaa valla 2026. aasta: 1 1) koondeelarve vastavalt lisale 1; 2 2) eelarve alaeelarvete lõikes vastavalt lisale 2.",
        "@language": "et"
      },
      "estleg:legalText": "Kinnitada Hiiumaa valla 2026. aasta: 1 1) koondeelarve vastavalt lisale 1; 2 2) eelarve alaeelarvete lõikes vastavalt lisale 2.",
      "estleg:enactedBy": {
