    {
      "@id": "estleg:Reg_1057798_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppetasu suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Väike-Maarja Muusikakooli õppetasu kinnitamine",
      "estleg:summary": {
        "@value": "1 (1) Õppetasu suurus on 35 eurot ja eelklassis 15 eurot kuus. 2 (2) Lõikes 1 toodud õppetasu kehtib õpilastele, kelle elukoht on rahvastikuregistri järgi Väike-Maarja vallas. 3 (3) Õpilastele, kelle elukoht ei ole rahvastikuregistri järgi Väike-Maarja vallas, kehtib Väike-Maarja vallavalitsuse poolt igaks eelarveaastaks kinnitatud muusikakooli õpilaskoha tegevuskulu arvestuslik maksumus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Õppetasu suurus on 35 eurot ja eelklassis 15 eurot kuus. 2 (2) Lõikes 1 toodud õppetasu kehtib õpilastele, kelle elukoht on rahvastikuregistri järgi Väike-Maarja vallas. 3 (3) Õpilastele, kelle elukoht ei ole rahvastikuregistri järgi Väike-Maarja vallas, kehtib Väike-Maarja vallavalitsuse poolt igaks eelarveaastaks kinnitatud muusikakooli õpilaskoha tegevuskulu arvestuslik maksumus.",
