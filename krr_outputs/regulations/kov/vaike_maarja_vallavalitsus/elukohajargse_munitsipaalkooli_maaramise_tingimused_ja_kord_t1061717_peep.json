    {
      "@id": "estleg:Reg_1061717_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Elukohajärgne kool",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Elukohajärgne kool on käesolevas määruses kehtestatud tingimustel määratav kool, mille kaudu tagatakse Väike-Maarja vallas elavale lapsele võimalus omandada põhiharidust. 2 (2) Vallavalitsusel on õigus määrata korraldusega lapsele elukohajärgne kool, kui käesolevas määruses kehtestatud tingimuste alusel ei ole võimalik määrata lapse elukohajärgset kooli (nt ebatäpsed andmed, lapse hooldusõigusega seotud vaidlused vms).",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Elukohajärgne kool on käesolevas määruses kehtestatud tingimustel määratav kool, mille kaudu tagatakse Väike-Maarja vallas elavale lapsele võimalus omandada põhiharidust. 2 (2) Vallavalitsusel on õigus määrata korraldusega lapsele elukohajärgne kool, kui käesolevas määruses kehtestatud tingimuste alusel ei ole võimalik määrata lapse elukohajärgset kooli (nt ebatäpsed andmed, lapse hooldusõigusega seotud vaidlused vms). 3 (3) Õppimiskohustusliku isiku elukohajärgne kool on: 1 1) Aavere, Kiltsi, Liivaküla, Nõmme, Pikevere, Raigu, Uuemõisa, Vao, Varangu ja Vorsti külades elavatel lastel Kiltsi Mõisakool; 2 2) Simuna alevikus ja Avanduse, Hirla, Imukvere, Kurtna, Kärsa, Käru, Määri, Nadalama, Orguse ja Võivere külades elavatel lastel Simuna Kool; 3 3) Väike-Maarja alevikus ja Aburi, Avispea, Ebavere, Eipri, Koonu, Kännuküla, Nadalama, Müüriku, Pandivere, Pudivere, Raeküla, Rastla, Triigi, Äntu ja Ärina külades elavatel lastel Väike-Maarja Gümnaasium; 4 4) Rakke alevikus ja Tammiku, Ao, Suure-Rakke, Salla, Edru, Emumäe, Nõmmküla, Olju, Piibe, Lasinurme, Liigvalla, Mõisamaa, Jäätma, Kamariku, Kaavere, Kadiküla, Kellamäe, Koila, Koluvere, Lahu, Kõpsta, Väike-Tammiku, Väike-Rakke, Sootaguse, Räitsvere, Mäiste, Lammasküla, Villakvere ja Kitsemetsa külades elavatel lastel Rakke Kool.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vaike_maarja_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0928"
