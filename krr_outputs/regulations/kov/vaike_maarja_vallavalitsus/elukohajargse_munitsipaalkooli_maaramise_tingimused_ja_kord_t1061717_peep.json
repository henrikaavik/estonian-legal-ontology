    {
      "@id": "estleg:Reg_1061717_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Õpilase kooli vastuvõtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Kool on kohustatud võtma õpilaseks vastu kõik selleks soovi avaldavad õppimiskohustuslikud isikud, kellele see kool on elukohajärgne kool. 2 (2) Vanema jaoks on õppimiskohustuslikule isikule kooli valik vaba, kui soovitud koolis on vabu õppekohti. 3 (3) Vallavalitsusel on õigus määrata korraldusega lapsele elukohajärgne kool, kui lapse seadusliku esindaja ja kooli vahel tekib vaidlus õppimiskohustusliku isiku kooli vastuvõtmise üle.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kool on kohustatud võtma õpilaseks vastu kõik selleks soovi avaldavad õppimiskohustuslikud isikud, kellele see kool on elukohajärgne kool. 2 (2) Vanema jaoks on õppimiskohustuslikule isikule kooli valik vaba, kui soovitud koolis on vabu õppekohti. 3 (3) Vallavalitsusel on õigus määrata korraldusega lapsele elukohajärgne kool, kui lapse seadusliku esindaja ja kooli vahel tekib vaidlus õppimiskohustusliku isiku kooli vastuvõtmise üle. Põhjendatud juhul võib vallavalitsus määrata põhihariduse omandamiseks teise kooli, kui § 2 lg-s 3 on sätestatud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vaike_maarja_vallavalitsus"
      },
