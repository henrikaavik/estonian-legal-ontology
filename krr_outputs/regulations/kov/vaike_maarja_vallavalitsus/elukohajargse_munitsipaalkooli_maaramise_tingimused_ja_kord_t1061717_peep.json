      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Õpingud katkestanud 18 aastase või vanema isiku põhihariduse omandamise jätkamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:summary": {
        "@value": "Rahvastikuregistri andmetel Väike-Maarja vallas elavale 18-aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, on elukohajärgseks kooliks Väike-Maarja Gümnaasium.",
        "@language": "et"
      },
      "estleg:legalText": "Rahvastikuregistri andmetel Väike-Maarja vallas elavale 18-aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, on elukohajärgseks kooliks Väike-Maarja Gümnaasium.",
