    {
      "@id": "estleg:Reg_1061717_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Rahvastikuregistri andmetel Väike-Maarja vallas elavale 18-aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, on elukohajärgseks kooliks Väike-Maarja Gümnaasium.",
