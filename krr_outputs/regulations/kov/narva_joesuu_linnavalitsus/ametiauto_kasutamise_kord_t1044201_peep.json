      }
    },
    {
      "@id": "estleg:Reg_1044201_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kogus, mis ületab kehtestatud kuulimiiti, kuulub tasumisele ametiauto vastutava kasutaja poolt.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044201_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
        {
