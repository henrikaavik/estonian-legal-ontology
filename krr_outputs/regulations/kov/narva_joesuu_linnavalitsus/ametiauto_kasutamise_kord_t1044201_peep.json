    {
      "@id": "estleg:Reg_1044201_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Aruandlus",
        "@language": "et"
      },
      "estleg:sourceAct": "Ametiauto kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Ametiautod võivad olla varustatud GPS seadmega. Kui GPS seadet pole paigaldatud, siis täidetakse sõidupäevikut (Lisa), milles näidatakse: 1 1) ametiautot kasutava isiku ees- ja perekonnanimi; 2 2) ametiauto riikliku registreerimismärgi andmed; 3 3) ametiauto läbisõidumõõdiku alg- ja lõppnäit iga tehtud sõidu korral; 4 4) kuupäev ja sõidu eesmärk iga tehtud sõidu korral. 2 (2) Narva-Jõesuu Linnavalitsuse teenistuja/töötaja sõidupäeviku või GPS väljatrüki kinnitab linnapea või osakonna juht.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ametiautod võivad olla varustatud GPS seadmega. Kui GPS seadet pole paigaldatud, siis täidetakse sõidupäevikut (Lisa), milles näidatakse: 1 1) ametiautot kasutava isiku ees- ja perekonnanimi; 2 2) ametiauto riikliku registreerimismärgi andmed; 3 3) ametiauto läbisõidumõõdiku alg- ja lõppnäit iga tehtud sõidu korral; 4 4) kuupäev ja sõidu eesmärk iga tehtud sõidu korral. 2 (2) Narva-Jõesuu Linnavalitsuse teenistuja/töötaja sõidupäeviku või GPS väljatrüki kinnitab linnapea või osakonna juht. 3 (3) menetlusteenistuse teenistuja sõidupäeviku või GPS väljatrüki kinnitab menetlusteenistuse juht. 4 (4) hallatava asutuse töötaja sõidupäeviku või GPS väljatrüki kinnitab hallatava asutuse juht. 5 (5) Kinnitatud sõidupäevik (paberkandjal originaal või elektroonselt digitaalallkirjastatuna) esitatakse linnavalitsuse rahandusosakonnale ametiauto kasutamise kuule järgneva kuu viiendaks kuupäevaks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_narva_joesuu_linnavalitsus"
      },
