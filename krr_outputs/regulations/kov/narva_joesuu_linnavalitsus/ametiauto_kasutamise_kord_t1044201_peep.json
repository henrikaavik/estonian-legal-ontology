      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ametiauto tankimine toimub reeglina kütusekaardiga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044201_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1044201_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Erandkorras tekkinud vajadusel on lubatud ametiauto tankimine muude vahenditega, mille maksmist tõendav dokument ja kütusetšekk koos selgitusega esitatakse eelarve eest vastutavale isikule kinnitamiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044201_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
