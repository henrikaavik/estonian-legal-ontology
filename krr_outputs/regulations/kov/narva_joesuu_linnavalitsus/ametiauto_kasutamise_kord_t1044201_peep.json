        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ametiautole määratakse ühes kuus kütuse kasutamise kululimiit auto vastutava kasutaja määramise käskkirjas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044201_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
