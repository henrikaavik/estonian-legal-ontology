      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. [Koopia käesolevast määrusest ja asukohaskeemist saata 10 päeva jooksul riikliku...]",
      "estleg:sourceAct": "Kohanimede määramine",
      "estleg:summary": "Koopia käesolevast määrusest ja asukohaskeemist saata 10 päeva jooksul riikliku kohanimeregistri volitatud töötlejale ja kohanimenõukogule.",
      "estleg:legalText": "Koopia käesolevast määrusest ja asukohaskeemist saata 10 päeva jooksul riikliku kohanimeregistri volitatud töötlejale ja kohanimenõukogule."
