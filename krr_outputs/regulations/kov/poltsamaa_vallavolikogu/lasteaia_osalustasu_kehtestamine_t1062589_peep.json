    {
      "@id": "estleg:Reg_1062589_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Osalustasu ühe lasteasutuses käiva lapse kohta kuus on: 1) 2026. aastal 60 eurot; 2) alates 1. jaanuarist 2027 seitse protsenti Vabariigi Valitsuse kehtestatud töötasu alammäärast. Osalustasu ümardatakse täiseurodeni.",
