          "@id": "estleg:Issuer_poltsamaa_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062589_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Osalustasu makstakse üldjuhul aastaringselt ja selle suurus ei sõltu lapse lasteaias viibimise päevade arvust kuus, välja arvatud lasteaia või rühma ajutise sulgemise ajal (remonditööd, töötajate kollektiivpuhkus, eriolukord, nakkushaiguse puhang jms), mis kestab kauem kui 5 tööpäeva.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062589_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
