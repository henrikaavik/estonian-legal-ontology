      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Osalustasu arvestatakse ja makstakse alates lapse lasteasutuse nimekirja arvamise kuu esimesest päevast kuni lapse lasteasutuse nimekirjast väljaarvamise kuu viimase päevani vallavalitsuse esitatud arve alusel arvel näidatud tähtajaks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062589_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
