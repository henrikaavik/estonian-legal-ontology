      }
    },
    {
      "@id": "estleg:Reg_1062589_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lasteaia ajutise sulgemise ajal makstakse osalustasu proportsionaalselt lasteasutuse lahtioleku ajaga.",
      "estleg:parentProvision": {
