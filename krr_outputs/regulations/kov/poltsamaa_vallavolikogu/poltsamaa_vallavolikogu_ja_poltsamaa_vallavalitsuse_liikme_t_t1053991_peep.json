      "rdfs:label": {
        "@value": "§ 2. Teenistuslähetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Põltsamaa Vallavolikogu ja Põltsamaa Vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1(1)Teenistuslähetus on volikogu esimehe, volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikus täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. 2(2)Lähetust välisriiki loetakse välislähetuseks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Teenistuslähetus on volikogu esimehe, volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikus täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. 2(2)Lähetust välisriiki loetakse välislähetuseks.",
