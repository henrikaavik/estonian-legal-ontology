      "rdfs:label": {
        "@value": "§ 4. Avansi taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põltsamaa Vallavolikogu ja Põltsamaa Vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "Lähetatul on õigus nõuda lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses mõistliku aja jooksul enne lähetuse algust. Avansi mittesaamise korral võib lähetatav lähetusest keelduda.",
