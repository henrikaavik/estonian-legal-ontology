      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. [AIP kasutajal on keelatud: 1 (1) igasugune tarkvara installeerimine ja arvuti hä...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Avalikus internetipunktis interneti kasutamise eeskiri",
      "estleg:summary": {
        "@value": "AIP kasutajal on keelatud: 1 (1) igasugune tarkvara installeerimine ja arvuti häälestuse muutmine; 2 (2) arvuti või mõne teise seadme lahtiühendamine või teisaldamine; 3 (3) arvuti omavoliline väljalülitamine ja restartimine; 4 (4) andmete salvestamine arvuti kõvakettale; 5 (5) isikliku andmekandja kasutamine avaliku internetipunkti arvutis raamatukogu töötaja loata; 6 (6) tasuliste ja pornograafiliste, samuti vägivallale õhutavate või muude eetikareeglitega vastuolus olevate…",
        "@language": "et"
      },
      "estleg:legalText": "AIP kasutajal on keelatud: 1 (1) igasugune tarkvara installeerimine ja arvuti häälestuse muutmine; 2 (2) arvuti või mõne teise seadme lahtiühendamine või teisaldamine; 3 (3) arvuti omavoliline väljalülitamine ja restartimine; 4 (4) andmete salvestamine arvuti kõvakettale; 5 (5) isikliku andmekandja kasutamine avaliku internetipunkti arvutis raamatukogu töötaja loata; 6 (6) tasuliste ja pornograafiliste, samuti vägivallale õhutavate või muude eetikareeglitega vastuolus olevate internetilehekülgede külastamine; 7 (7) teiste AIP ja raamatukogu kasutajate häirimine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vonnu_vallavolikogu"
      },
