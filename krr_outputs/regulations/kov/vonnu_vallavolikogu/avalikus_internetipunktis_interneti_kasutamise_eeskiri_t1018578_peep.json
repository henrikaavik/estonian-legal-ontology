        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) isikliku andmekandja kasutamine avaliku internetipunkti arvutis raamatukogu töötaja loata;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1018578_Par_4"
