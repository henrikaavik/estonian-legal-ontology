      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) tasuliste ja pornograafiliste, samuti vägivallale õhutavate või muude eetikareeglitega vastuolus olevate internetilehekülgede külastamine;",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1018578_Par_4"
