      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaugküttepiirkonna määramine",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Võnnu valla kaugküttepiirkonna piirid, kaugküttevõrguga (edaspidi võrk) liitumise ja võrgust eraldumise tingimused ja kord, kaugkütte üldised kvaliteedinõuded ning soojusettevõtja arenduskohustus.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Võnnu valla kaugküttepiirkonna piirid, kaugküttevõrguga (edaspidi võrk) liitumise ja võrgust eraldumise tingimused ja kord, kaugkütte üldised kvaliteedinõuded ning soojusettevõtja arenduskohustus.",
