    },
    {
      "@id": "estleg:Reg_1036687_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kaugküttepiirkond asub Võnnu alevikus. Kaugküttepiirkonda kuulub Võnnu aleviku katlamaja aadressiga Tartu tn 9c Võnnu alevik Võnnu vald Tartumaa.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036687_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1036687_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kaugküttepiirkonna piirid on toodud määruse lisades 1-2.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1036687_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1036687_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Võrguga liitumise tingimused ja kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaugküttepiirkonna määramine",
      "estleg:summary": {
        "@value": "1 (1) Kaugküttepiirkonnas on võrguga liitumine kohustuslik kõigile kaugküttepiirkonnas asuvatele isikutele, kelle omandis, kaasomandis või valduses on tarbijapaigaldis ehitatava või rekonstrueeritava ehitise soojusega varustamiseks, välja arvatud käesoleva paragrahvi lõikes 4 määratud juhtudel. 2 (2) Isikud, kes kaugküttepiirkonna määruse jõustumise ajal ei kasuta kaugkütet, ei ole kohustatud liituma võrguga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaugküttepiirkonnas on võrguga liitumine kohustuslik kõigile kaugküttepiirkonnas asuvatele isikutele, kelle omandis, kaasomandis või valduses on tarbijapaigaldis ehitatava või rekonstrueeritava ehitise soojusega varustamiseks, välja arvatud käesoleva paragrahvi lõikes 4 määratud juhtudel. 2 (2) Isikud, kes kaugküttepiirkonna määruse jõustumise ajal ei kasuta kaugkütet, ei ole kohustatud liituma võrguga. 3 (3) Võrguga liitumine toimub „Kaugkütteseaduses“ sätestatud korras ja käesoleva määruse sätteid jälgides. 4 (4) Erandid, mille korral kaugküttepiirkonnas ehitatavate või rekonstrueeritavate ehitiste soojusega varustamisel lubatakse kasutada muud kütteviisi kui kaugküte, on:",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vonnu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
