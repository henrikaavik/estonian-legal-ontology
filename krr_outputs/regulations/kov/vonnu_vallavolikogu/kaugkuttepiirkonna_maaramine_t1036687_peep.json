    },
    {
      "@id": "estleg:Reg_1036687_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kaugküttepiirkonna piirid",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaugküttepiirkonna määramine",
      "estleg:summary": {
        "@value": "1 (1) Kaugküttepiirkond asub Võnnu alevikus. Kaugküttepiirkonda kuulub Võnnu aleviku katlamaja aadressiga Tartu tn 9c Võnnu alevik Võnnu vald Tartumaa. 2 (2) Kaugküttepiirkonna piirid on toodud määruse lisades 1-2.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaugküttepiirkond asub Võnnu alevikus. Kaugküttepiirkonda kuulub Võnnu aleviku katlamaja aadressiga Tartu tn 9c Võnnu alevik Võnnu vald Tartumaa. 2 (2) Kaugküttepiirkonna piirid on toodud määruse lisades 1-2.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vonnu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
