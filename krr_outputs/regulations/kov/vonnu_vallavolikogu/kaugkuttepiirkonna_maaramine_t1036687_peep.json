    },
    {
      "@id": "estleg:Reg_1036687_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Võrgust eraldumise kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaugküttepiirkonna määramine",
      "estleg:summary": {
        "@value": "1 (1) Taotleja esitab vallavalitsusele ja võrguettevõtjale läbivaatamiseks ning otsustamiseks:1) taotluse kaugküttest loobumise kohta; 2 (2) Võrguettevõtja esitab eraldumistingimused või põhjendatud keeldumise tarbija taotluse alusel 30 kalendripäeva jooksul. 3 (3) Eraldumistingimustes määratakse kindlaks: 4 (4) Peale võrguettevõtja arvamuse saamist annab vallavalitsus välja korralduse Kaugküttesüsteemist eraldumiseks või mitteeraldumiseks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Taotleja esitab vallavalitsusele ja võrguettevõtjale läbivaatamiseks ning otsustamiseks:1) taotluse kaugküttest loobumise kohta; 2 (2) Võrguettevõtja esitab eraldumistingimused või põhjendatud keeldumise tarbija taotluse alusel 30 kalendripäeva jooksul. 3 (3) Eraldumistingimustes määratakse kindlaks: 4 (4) Peale võrguettevõtja arvamuse saamist annab vallavalitsus välja korralduse Kaugküttesüsteemist eraldumiseks või mitteeraldumiseks. 5 (5) Peale vallavalitsuse nõusolekut kaugküttesüsteemist eraldumiseks lähtutakse ehitise tehnosüsteemide muutmisel ehitusseaduse nõuetest. Projekteerida ja töid teostada võib ainult majandustegevuse registris vastavat registreeringut omav isik. 6 (6) Kõik kulud, mis on seotud kaugküttest loobumisega ja alternatiivküttele üleminekuga katab taotleja. 7 (7) Korterelamus üksiku korteri eraldumine küttesüsteemist ei ole lubatud. 8 (8) Omavoliliselt tarbijapaigaldise väljalülitamisega (väljalõikamisega) tekitatud kahju võrguettevõtjale või teistele ühisomandis olevate tarbijapaigaldiste omanikele katab selle tekitaja seadusega ettenähtud korras.",
      "estleg:enactedBy": {
