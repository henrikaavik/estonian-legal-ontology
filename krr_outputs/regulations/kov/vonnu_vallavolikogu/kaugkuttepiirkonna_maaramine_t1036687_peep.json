      "rdfs:label": {
        "@value": "§ 4. Võrgust eraldumise tingimused",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaugküttepiirkonna määramine",
      "estleg:summary": {
        "@value": "Tarbijapaigaldise omanik või valdaja ei tohi kaugküttepiirkonnas võrguga ühendatud tarbijapaigaldist võrgust eraldada, välja arvatud juhul kui:",
        "@language": "et"
      },
      "estleg:legalText": "Tarbijapaigaldise omanik või valdaja ei tohi kaugküttepiirkonnas võrguga ühendatud tarbijapaigaldist võrgust eraldada, välja arvatud juhul kui:",
