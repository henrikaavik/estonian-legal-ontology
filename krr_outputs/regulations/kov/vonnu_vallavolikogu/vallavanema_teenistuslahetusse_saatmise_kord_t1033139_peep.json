      "rdfs:label": {
        "@value": "§ 2. Teenistuslähetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavanema teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Teenistuslähetus (edaspidi lähetus) on vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Vallavanem saadetakse lähetusse vallavalitsuse korraldusel. 2 (2) Lähetust välisriiki loetakse välislähetuseks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenistuslähetus (edaspidi lähetus) on vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Vallavanem saadetakse lähetusse vallavalitsuse korraldusel. 2 (2) Lähetust välisriiki loetakse välislähetuseks.",
