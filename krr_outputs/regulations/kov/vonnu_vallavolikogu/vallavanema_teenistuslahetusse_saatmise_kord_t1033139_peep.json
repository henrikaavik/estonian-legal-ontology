      "rdfs:label": {
        "@value": "§ 4. Lähetuse vormistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavanema teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Vallavanema lähetus vormistatakse vallavalitsuse korraldusega, milles märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht, ülesanne ning lähetuskulude hüvitamise ulatus. 2 (2) Välislähetuse korral märgitakse käskkirjas ka asutus või üritus, kuhu lähetatu suunatakse, ning välislähetuse päevaraha määr. 3 (3) Vallavalitsuse korralduse eelnõu valmistab ette vallasekretär.",
        "@language": "et"
      },
