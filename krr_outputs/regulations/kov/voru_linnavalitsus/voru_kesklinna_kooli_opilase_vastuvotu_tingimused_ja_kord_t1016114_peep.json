    {
      "@id": "estleg:Reg_1016114_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Vastuvõtu korraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Võru Kesklinna Kooli õpilase vastuvõtu tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) VKK vastuvõtmiseks esitab sisseastuja või piiratud teovõimega sisseastuja puhul tema seaduslik esindaja (edaspidi vanem) kirjaliku vastuvõtu taotluse (määruse lisa) koos järgmiste dokumentidega: 1 1) sisseastuja isikut tõendava dokumendi (selle puudumisel sünnitunnistuse või -tõendi) ametlikult kinnitatud ärakiri või koopia; 2 2) kui taotluse esitab vanem, siis vanema isikut tõendava dokumendi ametlikult kinnitatud ärakiri või koopia; 3 3) ametlikult kinnitatud väljavõtte õpilase…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) VKK vastuvõtmiseks esitab sisseastuja või piiratud teovõimega sisseastuja puhul tema seaduslik esindaja (edaspidi vanem) kirjaliku vastuvõtu taotluse (määruse lisa) koos järgmiste dokumentidega: 1 1) sisseastuja isikut tõendava dokumendi (selle puudumisel sünnitunnistuse või -tõendi) ametlikult kinnitatud ärakiri või koopia; 2 2) kui taotluse esitab vanem, siis vanema isikut tõendava dokumendi ametlikult kinnitatud ärakiri või koopia; 3 3) ametlikult kinnitatud väljavõtte õpilase tervisekaardist selle olemasolul; 4 4) kehtetu - RT IV 2025-07-01 8 401072025008 2025-09-01 5 5) foto sisseastujast, suuruses 3 × 4 cm. 2 (2) Õpilase ületulekul teisest koolist esitatakse lisaks käesoleva paragrahvi lõikes 1 loetletud dokumentidele: 1 1) ametlikult kinnitatud väljavõte õpilasraamatust; 2 2) eelmise kooli direktori allkirja ja kooli pitseriga kinnitatud klassitunnistus jooksva õppeaasta kohta, kui õpilane arvatakse koolist välja pärast õppeperioodi lõppu; 3 3) eelmise kooli direktori allkirja ja kooli pitseriga kinnitatud klassitunnistus ning hinneteleht jooksva õppeveerandi hinnetega, kui õpilane arvatakse koolist välja õppeperioodi kestel; 4 4) väljavõte õpilase tervisekaardist. 3 (3) Õpilase vastuvõtmise otsustab direktor käskkirjaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0919"
