    {
      "@id": "estleg:Reg_1064453_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Esimesse klassi õppima asuva lapse seaduslik esindaja (edaspidi vanem) esitab Võru linnavalitsusele (edaspidi linnavalitsus) kooli määramiseks taotluse Võru linna haridusteenuste haldamise infosüsteemis ARNO õppima asumise aasta 1. märtsiks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064453_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:targetGroup": [
