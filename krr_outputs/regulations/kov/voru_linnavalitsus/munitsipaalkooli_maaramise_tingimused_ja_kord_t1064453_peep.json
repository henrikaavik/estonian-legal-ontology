    },
    {
      "@id": "estleg:Reg_1064453_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Linnavalitsuse moodustatud komisjon (edaspidi komisjon) määrab lapsele kooli, arvestades vanema taotluses märgitud kooli, vajadusel pere teise lapse õppimist taotluses märgitud koolis, vanema töötamist taotluses märgitud koolis, lapse elukoha lähedust koolile. Haridusliku erivajadusega lapsele kooli määramisel lähtutakse kooli võimalustest ning õppekavast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064453_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
