        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1064453_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Komisjon teeb linnavalitsusele ettepaneku esimeste klasside arvu määramiseks kooliti. Linnavalitsus määrab esimeste klasside arvu kooliti igaks õppeaastaks oma korraldusega märtsikuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064453_Par_2"
      },
      "rdfs:label": "§ 2 lg 3",
      "estleg:targetGroup": [
        {
