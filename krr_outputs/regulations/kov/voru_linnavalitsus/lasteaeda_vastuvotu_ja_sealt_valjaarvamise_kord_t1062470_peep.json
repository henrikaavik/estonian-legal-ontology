      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lasteaia direktor (edaspidi direktor) annab lapse lasteaeda vastuvõtu kohta käskkirja ja teeb e-keskkonnas ARNO vastava kande.",
      "estleg:parentProvision": {
