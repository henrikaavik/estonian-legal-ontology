        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kohapakkumuse vastuvõtmata jätmisel või loobumisel jääb taotlus menetlusse järgmise kohapakkumuse tegemiseks ja kuni lapse lasteaeda vastuvõtuni või taotluse tühistamiseni.",
