    {
      "@id": "estleg:Reg_1062470_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Koha pakkumine ja vastuvõtt",
        "@language": "et"
      },
      "estleg:sourceAct": "Lasteaeda vastuvõtu ja sealt väljaarvamise kord",
      "estleg:summary": {
        "@value": "1(1)Koha pakkumisel arvestatakse taotluses märgitud esimest eelistust. Kui eelistatud lasteaias (lasteaia tegevuskohas) vaba kohta ei ole, pakutakse kohta teises Võru linna lasteaias või selle tegevuskohas. 2(2)Teatis kohapakkumusest e-keskkonnas ARNO saadetakse vanemale e-posti aadressile. Vanem võtab koha vastu või loobub kohast seitsme kalendripäeva jooksul alates kohapakkumuse tegemisest.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Koha pakkumisel arvestatakse taotluses märgitud esimest eelistust. Kui eelistatud lasteaias (lasteaia tegevuskohas) vaba kohta ei ole, pakutakse kohta teises Võru linna lasteaias või selle tegevuskohas. 2(2)Teatis kohapakkumusest e-keskkonnas ARNO saadetakse vanemale e-posti aadressile. Vanem võtab koha vastu või loobub kohast seitsme kalendripäeva jooksul alates kohapakkumuse tegemisest. 3(3)Lasteaia direktor (edaspidi direktor) annab lapse lasteaeda vastuvõtu kohta käskkirja ja teeb e-keskkonnas ARNO vastava kande. 4(4)Kohapakkumuse vastuvõtmata jätmisel või loobumisel jääb taotlus menetlusse järgmise kohapakkumuse tegemiseks ja kuni lapse lasteaeda vastuvõtuni või taotluse tühistamiseni.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0919"
