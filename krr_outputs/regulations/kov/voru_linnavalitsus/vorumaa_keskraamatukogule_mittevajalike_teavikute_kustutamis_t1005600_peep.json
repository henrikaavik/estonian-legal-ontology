    {
      "@id": "estleg:Reg_1005600_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. TEAVIKUTE KUSTUTAMINE",
        "@language": "et"
      },
      "estleg:sourceAct": "Võrumaa Keskraamatukogule mittevajalike teavikute kustutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Teavikud kustutatakse kogudest ja raamatukogu kataloogist mahakandmise põhjuste järgi koostatud kustutusaktiga. 2 (2) Kustutusaktis tuuakse järgmised andmed: 1 1) akti koostamise kuupäev; 2 2) akti koostaja nimi; 3 3) kustutatud teavikute kogumaksumus; 4 4) kustutatud teavikute eksemplaride arv laadide kaupa; 5 5) kustutatud raamatute eksemplaride arv liikide järgi; 6 6) kustutatud raamatute eksemplaride arv keelte järgi; 7 7) kustutamise põhjus; 8 8) akti koostaja allkiri.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teavikud kustutatakse kogudest ja raamatukogu kataloogist mahakandmise põhjuste järgi koostatud kustutusaktiga. 2 (2) Kustutusaktis tuuakse järgmised andmed: 1 1) akti koostamise kuupäev; 2 2) akti koostaja nimi; 3 3) kustutatud teavikute kogumaksumus; 4 4) kustutatud teavikute eksemplaride arv laadide kaupa; 5 5) kustutatud raamatute eksemplaride arv liikide järgi; 6 6) kustutatud raamatute eksemplaride arv keelte järgi; 7 7) kustutamise põhjus; 8 8) akti koostaja allkiri. 3 (3) Kustutusaktile lisatakse kustutatud teavikute nimekiri, milles tuuakse ära järgmised andmed: 1 1) autor(id); 2 2) pealkiri; 3 3) ilmumisaasta; 4 4) liik; 5 5) vöötkoodi- või inventarinumber; 6 6) keel; 7 7) hind. 4 (4) Kinnitusakti kinnitab raamatukogu direktor.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0919"
