      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koosolek protokollitakse. Protokolli kantakse koosoleku algus- ja lõppkellaaeg, kuupäev ja toimumiskoht, koosolekul osalenud ja puudunud hoolekogu liikmete ning teiste osalenud isikute nimed, päevakord, päevakorrapunktide sisu ja arutelu lühikokkuvõte, tehtud ettepanekud, vastuvõetud otsused, hääletustulemused (kui küsimus otsustati hääletamise teel) ning esitatud eriarvamused.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062169_Par_9"
      },
      "rdfs:label": "§ 9 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1062169_Par_9_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Protokolli allkirjastab hoolekogu esimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062169_Par_9"
      },
      "rdfs:label": "§ 9 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1062169_Par_9_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Protokoll tehakse kättesaadavaks lasteaias ja lasteaia elektroonilises infosüsteemis ning avalikustatakse lasteaia veebilehel kümne kalendripäeva jooksul koosoleku toimumisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062169_Par_9"
      },
      "rdfs:label": "§ 9 lg 3"
    },
    {
      "@id": "estleg:Reg_1062169_Par_9_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Protokollid säilitatakse alaliselt.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062169_Par_9"
      },
      "rdfs:label": "§ 9 lg 4"
    },
