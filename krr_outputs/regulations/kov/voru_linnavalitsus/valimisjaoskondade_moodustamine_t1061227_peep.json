      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Valimisjaoskondade arv",
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": "Võru linnas moodustatakse neli valimisjaoskonda.",
      "estleg:legalText": "Võru linnas moodustatakse neli valimisjaoskonda. Võru linnas moodustatakse neli valimisjaoskonda.",
