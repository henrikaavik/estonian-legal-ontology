    {
      "@id": "estleg:Reg_1061227_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1061227",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. Hääletamise liigid jaoskondades",
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": "1(1)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 2 hääletamist kinnipidamiskohas ja ööpäevases hoolekandeasutuses ja valija asukohas. Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 2 hääletamist kinnipidamiskohas ja ööpäevases hoolekandeasutuses ja valija asukohas. 2(2)Kodus hääletamist korraldavad kõik valimisjaoskonnad. Kodus hääletamist korraldavad kõik valimisjaoskonnad. 3(3)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu",
      "estleg:legalText": "1(1)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 2 hääletamist kinnipidamiskohas ja ööpäevases hoolekandeasutuses ja valija asukohas. Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 2 hääletamist kinnipidamiskohas ja ööpäevases hoolekandeasutuses ja valija asukohas. 2(2)Kodus hääletamist korraldavad kõik valimisjaoskonnad. Kodus hääletamist korraldavad kõik valimisjaoskonnad. 3(3)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. Valimisjaoskond nr 2 korraldab hääletamist vajadusel ka valija asukohas, kinnipidamiskohas ja ööpäevases hoolekandeasutuses. Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. Valimisjaoskond nr 2 korraldab hääletamist vajadusel ka valija asukohas, kinnipidamiskohas ja ööpäevases hoolekandeasutuses.",
      "estleg:enactedBy": {
