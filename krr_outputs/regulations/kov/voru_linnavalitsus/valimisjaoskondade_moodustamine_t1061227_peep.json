      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 2 hääletamist kinnipidamiskohas ja ööpäevases hoolekandeasutuses ja valija asukohas. 2(2)Kodus hääletamist korraldavad kõik valimisjaoskonnad. 3(3)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 2 hääletamist kinnipidamiskohas ja ööpäevases hoolekandeasutuses ja valija asukohas. 2(2)Kodus hääletamist korraldavad kõik valimisjaoskonnad. 3(3)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. Valimisjaoskond nr 2 korraldab hääletamist vajadusel ka valija asukohas, kinnipidamiskohas ja ööpäevases hoolekandeasutuses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0919"
