        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1016737_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Koolitusele suunatakse teenistuja tema taotluse alusel, mis kooskõlastatakse vahetu juhi ja linnapeaga. Tööalasel koolitusel osalemiseks on vajalik vahetu juhi eelnev nõusolek.",
      "estleg:parentProvision": {
