    {
      "@id": "estleg:Reg_1016737_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Koolitustegevusega seotud ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Võru Linnavalitsuse ametnike ja töötajate koolituse kord",
      "estleg:summary": {
        "@value": "1(1)Linnavalitsus kinnitab osakonna juhatajate ettepanekul eelarveaastaks koolitustegevuseks vajalikud vahendid. 2(2)Linnapea kehtestab vajadusel koolitustegevuste korraldamiseks linnavalitsuses täpsemad protseduurireeglid.",
        "@language": "et"
      },
