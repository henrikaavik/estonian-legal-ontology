    {
      "@id": "estleg:Reg_1016737_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Vahetu juht: 1) analüüsib alluvate koolitusvajadust nii arenguvestluse käigus kui jooksvalt vajaduse esinemisel; 2) hindab alluva koolituste mõju; 3) kooskõlastab alluva teenistuja koolitustaotluse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1016737_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ],
      "estleg:targetGroup": [
