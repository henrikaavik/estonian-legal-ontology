    {
      "@id": "estleg:Reg_1028143_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Vastuvõtu korraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Võru Kreutzwaldi Kooli õpilase vastuvõtu tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Vastuvõtmiseks esitab sisseastuja või piiratud teovõimega sisseastuja puhul tema seaduslik esindaja (edaspidi vanem) vastuvõtutaotluse koos järgmiste lisadega: 1 1) sisseastuja isikut tõendava dokumendi (selle puudumisel sünnitunnistuse või -tõendi) ametlikult kinnitatud ärakiri või koopia, välja arvatud juhul, kui taotlus on kinnitatud sisseastuja digitaalallkirjaga; 2 2) kui taotluse esitab vanem, siis ka vanema isikut tõendava dokumendi ametlikult kinnitatud ärakiri või koopia, välja…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vastuvõtmiseks esitab sisseastuja või piiratud teovõimega sisseastuja puhul tema seaduslik esindaja (edaspidi vanem) vastuvõtutaotluse koos järgmiste lisadega: 1 1) sisseastuja isikut tõendava dokumendi (selle puudumisel sünnitunnistuse või -tõendi) ametlikult kinnitatud ärakiri või koopia, välja arvatud juhul, kui taotlus on kinnitatud sisseastuja digitaalallkirjaga; 2 2) kui taotluse esitab vanem, siis ka vanema isikut tõendava dokumendi ametlikult kinnitatud ärakiri või koopia, välja arvatud juhul, kui taotlus on kinnitatud vanema digitaalallkirjaga; 3 3) ametlikult kinnitatud väljavõte õpilase tervisekaardist selle olemasolul; 4 4) kehtetu - RT IV 2025-07-01 8 401072025008 2025-09-01 5 5) sisseastuja foto suurusega 3 × 4 cm. 2 (2) Õpilase ületulekul teisest koolist esitatakse lisaks käesoleva paragrahvi lõikes 1 loetletud dokumentidele: 1 1) ametlikult kinnitatud väljavõte õpilasraamatust; 2 2) eelmise kooli direktori allkirja ja kooli pitseriga kinnitatud klassitunnistus või õpinguraamat jooksva õppeaasta kohta, kui õpilane arvatakse koolist välja pärast õppeperioodi lõppu; 3 3) eelmise kooli direktori allkirja ja kooli pitseriga kinnitatud klassitunnistus ning hinneteleht jooksva õppeveerandi hinnetega, kui õpilane arvatakse koolist välja õppeperioodi kestel. 3 (3) Vastuvõtutaotluse vormi kinnitab direktor. 4 (4) Õpilaste vastuvõtmise otsustab direktor käskkirjaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavalitsus"
      },
