    {
      "@id": "estleg:Reg_1007333_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Stipendiumi eraldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilasele välisõppe stipendiumi määramise ja maksmise kord",
      "estleg:summary": {
        "@value": "1(1)Stipendiumi eraldamisel arvestatakse muuhulgas taotleja:11) õppeedukust;22) ühiskondlikku aktiivsust;33) tööd ja tegevust Võru linna heaks; 2(2)Stipendium määratakse linnavalitsuse korraldusega komisjoni ettepanekul, võttes aluseks Võru linna eelarves ettenähtud vahendite suurust. 3(3)Stipendiumi saaja ning linnavalitsuse vahel sõlmitakse leping. 4(4)Stipendium kantakse üle taotleja isiklikule arveldusarvele vastavalt käesoleva paragrahvi lõikes 3 märgitud lepingus sätestatule.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Stipendiumi eraldamisel arvestatakse muuhulgas taotleja:11) õppeedukust;22) ühiskondlikku aktiivsust;33) tööd ja tegevust Võru linna heaks; 2(2)Stipendium määratakse linnavalitsuse korraldusega komisjoni ettepanekul, võttes aluseks Võru linna eelarves ettenähtud vahendite suurust. 3(3)Stipendiumi saaja ning linnavalitsuse vahel sõlmitakse leping. 4(4)Stipendium kantakse üle taotleja isiklikule arveldusarvele vastavalt käesoleva paragrahvi lõikes 3 märgitud lepingus sätestatule. 5(5)Stipendiumi saaja peab stipendiumi tagastama, kui lepingut ei täideta või kui taotluses on esitatud valeandmeid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavolikogu"
