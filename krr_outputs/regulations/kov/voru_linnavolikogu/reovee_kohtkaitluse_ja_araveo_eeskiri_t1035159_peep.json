      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Nõuetekohase taotluse menetlustähtaeg on 60 päeva.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1035159_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1035159_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kohtkäitlusnõusolek kehtib kaks aastat. Kui kohtkäitlusnõusoleku aegumise tähtajaks ei ole kinnistule, kus toimub kohtkäitlus, tagatud võimalust liituda ühiskanalisatsiooniga, võib kohtkäitlusnõusolekut pikendada tähtajaga kuni kaks aastat.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1035159_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:assertionConfidence": {
