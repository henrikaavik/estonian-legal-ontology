      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Võru linna 2026. aasta eelarve",
        "@language": "et"
      },
      "estleg:sourceAct": "Võru linna 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "Võtta Võru linna 2026. aasta eelarve vastu järgmises vormingus: 1 1) koondeelarve (lisa 1); 2 2) põhitegevuse tulude eelarve tululiikide lõikes (lisa 2); 3 3) põhitegevuse kulude eelarve asutuste ja osakondade lõikes (lisa 3); 4 4) investeerimistegevuse eelarve asutuste ja osakondade lõikes (lisa 4); 5 5) investeeringutoetuste jaotus (lisa 5).",
        "@language": "et"
      },
      "estleg:legalText": "Võtta Võru linna 2026. aasta eelarve vastu järgmises vormingus: 1 1) koondeelarve (lisa 1); 2 2) põhitegevuse tulude eelarve tululiikide lõikes (lisa 2); 3 3) põhitegevuse kulude eelarve asutuste ja osakondade lõikes (lisa 3); 4 4) investeerimistegevuse eelarve asutuste ja osakondade lõikes (lisa 4); 5 5) investeeringutoetuste jaotus (lisa 5).",
