        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Võru linna üldhariduskoolide statsionaarses õppes õppivate õpilaste koolilõuna tegeliku maksumuse ja riigipoolse toetuse vahe kaetakse Võru linna eelarve vahenditest.",
