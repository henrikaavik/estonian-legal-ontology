      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Huvide deklareerimise kohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvide deklareerimine",
      "estleg:summary": {
        "@value": "1(1)Deklaratsiooni on kohustatud esitama järgmised deklarandid: linnavolikogu liige, linnavalitsuse liige ja linna ametiasutuse juht. 2(2)Deklaranti teavitatakse viivitamata deklaratsiooni esitamise kohustusest vastava kohustuse tekkimisel. 3 (3) Deklarantide ja deklaratsioone kontrolli teostava komisjoni kohta esitab huvide deklaratsioonide registrile andmed: 1 1) volikogu referent, 2 2) linnasekretär. RT IV2014-05-09414090520140412014-05-12",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Deklaratsiooni on kohustatud esitama järgmised deklarandid: linnavolikogu liige, linnavalitsuse liige ja linna ametiasutuse juht. 2(2)Deklaranti teavitatakse viivitamata deklaratsiooni esitamise kohustusest vastava kohustuse tekkimisel. 3 (3) Deklarantide ja deklaratsioone kontrolli teostava komisjoni kohta esitab huvide deklaratsioonide registrile andmed: 1 1) volikogu referent, 2 2) linnasekretär. RT IV2014-05-09414090520140412014-05-12",
