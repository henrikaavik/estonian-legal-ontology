      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lastekaitseseaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) \"Lastekaitseseadus\" sätestatud kohaliku omavalitsuse üksuse ülesanded delegeeritakse Võru Linnavalitsusele. 2 (2) Võru Linnavalitsusel on õigus määrata \"Haldusmenetluse seadus\" § 8 lg 2 alusel struktuuriüksus, ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) \"Lastekaitseseadus\" sätestatud kohaliku omavalitsuse üksuse ülesanded delegeeritakse Võru Linnavalitsusele. 2 (2) Võru Linnavalitsusel on õigus määrata \"Haldusmenetluse seadus\" § 8 lg 2 alusel struktuuriüksus, ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
