      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Põhikooli- ja gümnaasiumiseaduses sätestatud ülesannete delegeerimine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064413_Map"
      },
      "estleg:summary": {
        "@value": "Delegeerida põhikooli- ja gümnaasiumiseaduses sätestatud kohaliku omavalitsuse üksuse ja kooli pidaja ülesanded Võru Linnavalitsusele, välja arvatud järgnevad ülesanded: 1 1) kooli pidaja esindaja määramine kooli hoolekogusse (§ 73 lg 2); 2 2) kooli ümberkorraldamise ja tegevuse lõpetamise otsustamine (§ 80 lg 1); 3 3) munitsipaalkooli pidamise üleandmise ja vastuvõtmise otsustamine (§ 81 lg 1).",
        "@language": "et"
      },
      "estleg:legalText": "Delegeerida põhikooli- ja gümnaasiumiseaduses sätestatud kohaliku omavalitsuse üksuse ja kooli pidaja ülesanded Võru Linnavalitsusele, välja arvatud järgnevad ülesanded: 1 1) kooli pidaja esindaja määramine kooli hoolekogusse (§ 73 lg 2); 2 2) kooli ümberkorraldamise ja tegevuse lõpetamise otsustamine (§ 80 lg 1); 3 3) munitsipaalkooli pidamise üleandmise ja vastuvõtmise otsustamine (§ 81 lg 1).",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1064413_Par_1_Lg_1"
        }
      ],
