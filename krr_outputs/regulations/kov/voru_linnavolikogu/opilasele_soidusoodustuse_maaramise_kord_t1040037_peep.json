      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Sõidusoodustuse taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilasele sõidusoodustuse määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määruse § 2 p 1 ja 2 nimetatud isikule sõidusoodustuse määramiseks esitab Võru linna lastekaitsespetsialist linnavalitsuse määratud ametnikule taotlejate nimekirja. 2 (2) Käesoleva määruse § 2 p 3, 4 ja 5 nimetatud isikule sõidusoodustuse määramiseks esitab õpilase seaduslik esindaja või vähemalt 16-aastane õpilane linnavalitsusele taotluse vastavalt lisale.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määruse § 2 p 1 ja 2 nimetatud isikule sõidusoodustuse määramiseks esitab Võru linna lastekaitsespetsialist linnavalitsuse määratud ametnikule taotlejate nimekirja. 2 (2) Käesoleva määruse § 2 p 3, 4 ja 5 nimetatud isikule sõidusoodustuse määramiseks esitab õpilase seaduslik esindaja või vähemalt 16-aastane õpilane linnavalitsusele taotluse vastavalt lisale.",
