    {
      "@id": "estleg:Reg_1040037_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Sõidusoodustuse saaja",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilasele sõidusoodustuse määramise kord",
      "estleg:summary": {
        "@value": "Sõidusoodustust saab: 1 1) Võru Linnavalitsuse (edaspidi linnavalitsus) taotluse alusel õpilaskodus elav õpilane; 2 2) väljaspool Võru linna hooldusperekonnas elav õpilane; 3 3) Audentese Spordikoolis, Tallinna Muusikakeskkoolis, Tartu Variku Koolis, H. Elleri nimelises Tartu Muusikakoolis ja Eesti Vabariigis vene õppekeelega koolis õppiv õpilane; 4 4) koolivälise nõustamiskomisjoni otsuse kohaselt hariduslike erivajadustega laste koolis õppiv õpilane; 5 5) õpilane, kelle osas on ettepaneku…",
        "@language": "et"
      },
      "estleg:legalText": "Sõidusoodustust saab: 1 1) Võru Linnavalitsuse (edaspidi linnavalitsus) taotluse alusel õpilaskodus elav õpilane; 2 2) väljaspool Võru linna hooldusperekonnas elav õpilane; 3 3) Audentese Spordikoolis, Tallinna Muusikakeskkoolis, Tartu Variku Koolis, H. Elleri nimelises Tartu Muusikakoolis ja Eesti Vabariigis vene õppekeelega koolis õppiv õpilane; 4 4) koolivälise nõustamiskomisjoni otsuse kohaselt hariduslike erivajadustega laste koolis õppiv õpilane; 5 5) õpilane, kelle osas on ettepaneku teinud Võru linna lastekaitsespetsialist või koolikohustuskomisjon.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavolikogu"
