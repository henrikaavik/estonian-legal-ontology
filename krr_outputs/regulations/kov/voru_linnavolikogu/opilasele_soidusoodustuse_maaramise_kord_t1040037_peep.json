      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilasele sõidusoodustuse määramise kord",
      "estleg:summary": {
        "@value": "Määrus reguleerib sõidusoodustuse andmist õpilasele, kelle elukoht on Eesti rahvastikuregistri andmetel Võru linn ning kes omandab põhi- ja üldkeskharidust statsionaarses õppes väljaspool Võru linna.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus reguleerib sõidusoodustuse andmist õpilasele, kelle elukoht on Eesti rahvastikuregistri andmetel Võru linn ning kes omandab põhi- ja üldkeskharidust statsionaarses õppes väljaspool Võru linna.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0919"
