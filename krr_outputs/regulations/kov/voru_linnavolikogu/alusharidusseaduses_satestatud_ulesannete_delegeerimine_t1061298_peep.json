      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Alusharidusseaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "Delegeerida Võru Linnavalitsusele alusharidusseaduses sätestatud kohaliku omavalitsuse üksuse ning lastehoiu ja lasteaia pidaja ülesanded, välja arvatud järgnevad ülesanded: 1 1) lasteaia asutamise otsustamine (§ 16 lg 1); 2 2) lasteaia ümberkorraldamine (§ 17); 3 3) osalustasu kehtestamine (§ 46 lg 4).",
        "@language": "et"
      },
      "estleg:legalText": "Delegeerida Võru Linnavalitsusele alusharidusseaduses sätestatud kohaliku omavalitsuse üksuse ning lastehoiu ja lasteaia pidaja ülesanded, välja arvatud järgnevad ülesanded: 1 1) lasteaia asutamise otsustamine (§ 16 lg 1); 2 2) lasteaia ümberkorraldamine (§ 17); 3 3) osalustasu kehtestamine (§ 46 lg 4).",
