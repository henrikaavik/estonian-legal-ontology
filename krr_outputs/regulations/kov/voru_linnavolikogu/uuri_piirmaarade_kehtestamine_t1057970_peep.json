      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üüri piirmäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Üüri piirmäärade kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Võru linna omandis olevate eluruumide üüri piirmäärad ühes kuus on: 1 1) keskkütte, tsentraalse vee ja kanalisatsiooni olemasoluga eluruumil 2,50 €/m2; 2 2) keskkütteta, veevarustuse ja kanalisatsiooni olemasoluga eluruumil 2,00 €/m2. 2 (2) Üüri piirmäärad aadressil Räpina mnt 22 asuvates eluruumides ühes kuus on 1,50 €/m2. 3 (3) Üüri piirmäärad aadressil F. R. Kreutzwaldi tänav 55 asuvates eluruumides ühes kuus on 1,50 €/m2.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Võru linna omandis olevate eluruumide üüri piirmäärad ühes kuus on: 1 1) keskkütte, tsentraalse vee ja kanalisatsiooni olemasoluga eluruumil 2,50 €/m2; 2 2) keskkütteta, veevarustuse ja kanalisatsiooni olemasoluga eluruumil 2,00 €/m2. 2 (2) Üüri piirmäärad aadressil Räpina mnt 22 asuvates eluruumides ühes kuus on 1,50 €/m2. 3 (3) Üüri piirmäärad aadressil F. R. Kreutzwaldi tänav 55 asuvates eluruumides ühes kuus on 1,50 €/m2.",
      "estleg:enactedBy": {
