      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Tunnistada kehtetuks Muhu Vallavolikogu 19.10.2011. a määrus nr 54 „Kohanime määramise kord Muhu vallas“. 2 (2) Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
        "@language": "et"
      },
