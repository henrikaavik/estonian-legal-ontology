    {
      "@id": "estleg:Reg_1063138_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Kohanime määramise põhimõtted",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Kohanime valikul tuleb lähtuda kohanimeseaduse nõuetest ja piirangutest. 2 (2) Kohanimena eelistatakse ajaloolisi või rahvasuus kasutusel olevaid nimesid, samuti asukohaga seonduvaid või asukohta iseloomustavaid nimesid. 3 (3) Kohanimi võib kajastada kohalikku, murdepärast nimekuju. 4 (4) Maaüksuse jagamisel jäetakse endine nimi maaüksusele, millel asub elamu. 5 (5) Mitme maaüksuse liitmisel eelistatakse tekkinud maaüksuse nimena selle liidetava maaüksuse kohanime, millel asub elamu.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohanime valikul tuleb lähtuda kohanimeseaduse nõuetest ja piirangutest. 2 (2) Kohanimena eelistatakse ajaloolisi või rahvasuus kasutusel olevaid nimesid, samuti asukohaga seonduvaid või asukohta iseloomustavaid nimesid. 3 (3) Kohanimi võib kajastada kohalikku, murdepärast nimekuju. 4 (4) Maaüksuse jagamisel jäetakse endine nimi maaüksusele, millel asub elamu. 5 (5) Mitme maaüksuse liitmisel eelistatakse tekkinud maaüksuse nimena selle liidetava maaüksuse kohanime, millel asub elamu. 6 (6) Kui sama nime kohta esitatakse mitu taotlust, arvestatakse eelkõige ajaloolist kasutust ning selle puudumisel taotluse esitamise aega. 7 (7) Kohanime määramisel arvestatakse taotleja soovidega, kui need ei lähe vastuollu kohanimeseaduse ja keeleseaduse nõuetega ning heade tavadega.",
      "estleg:enactedBy": {
