    },
    {
      "@id": "estleg:Reg_1063138_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohanime määramise menetlus algatatakse vallavalitsuse algatusel, füüsilise või juriidilise isiku kirjaliku taotluse alusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063138_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_muhu_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063138_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kohanime määramise menetlus viiakse läbi kohanimeseaduses sätestatud nõudeid järgides.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063138_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1063138_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vallavalitsus avalikustab kohanime määramise eelnõu vähemalt 15 päeva enne kohanime määramise otsustamist valla kodulehel. Teates märgitakse lühidalt eelnõu sisu, eelnõu väljapaneku aeg ning arvamuste esitamise tähtaeg.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063138_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_muhu_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063138_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Vallavalitsus annab kohanime määramisest avalikkusele teada valla ametlikul veebilehel ja valla infolehes.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063138_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_muhu_vallavalitsus"
        }
      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1063138_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Käesoleva määruse lõigetes 2 ja 3 sätestatud ei kohaldata maaüksuse nime määramisel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063138_Par_4"
      },
      "rdfs:label": "§ 4 lg 5"
    },
    {
      "@id": "estleg:Reg_1063138_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Kohanime määramine vormistatakse vallavalitsuse korraldusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063138_Par_4"
      },
      "rdfs:label": "§ 4 lg 6",
