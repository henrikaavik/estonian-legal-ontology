      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "Määrus reguleerib kohanimede määramise korda Muhu vallas ja sätestab kohanimeseadusega kohaliku omavalitsuse kui kohanimemääraja pädevuse jaotuse kohanimede määramisel.",
        "@language": "et"
      },
