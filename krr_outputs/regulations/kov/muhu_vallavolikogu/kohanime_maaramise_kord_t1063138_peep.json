      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Kohanime määramise korraldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Kohanime määramise menetlus algatatakse vallavalitsuse algatusel, füüsilise või juriidilise isiku kirjaliku taotluse alusel. 2 (2) Kohanime määramise menetlus viiakse läbi kohanimeseaduses sätestatud nõudeid järgides. 3 (3) Vallavalitsus avalikustab kohanime määramise eelnõu vähemalt 15 päeva enne kohanime määramise otsustamist valla kodulehel. Teates märgitakse lühidalt eelnõu sisu, eelnõu väljapaneku aeg ning arvamuste esitamise tähtaeg.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohanime määramise menetlus algatatakse vallavalitsuse algatusel, füüsilise või juriidilise isiku kirjaliku taotluse alusel. 2 (2) Kohanime määramise menetlus viiakse läbi kohanimeseaduses sätestatud nõudeid järgides. 3 (3) Vallavalitsus avalikustab kohanime määramise eelnõu vähemalt 15 päeva enne kohanime määramise otsustamist valla kodulehel. Teates märgitakse lühidalt eelnõu sisu, eelnõu väljapaneku aeg ning arvamuste esitamise tähtaeg. 4 (4) Vallavalitsus annab kohanime määramisest avalikkusele teada valla ametlikul veebilehel ja valla infolehes. 5 (5) Käesoleva määruse lõigetes 2 ja 3 sätestatud ei kohaldata maaüksuse nime määramisel. 6 (6) Kohanime määramine vormistatakse vallavalitsuse korraldusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_muhu_vallavolikogu"
      },
