      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Muhu vallas: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Muhu vallas: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
