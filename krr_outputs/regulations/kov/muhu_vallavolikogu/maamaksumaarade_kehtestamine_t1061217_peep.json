      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Muhu valla haldusterritooriumil asuva maa maamaksumäärad, maamaksu aastase suurenemise maksimaalne piirmäär ja kodualuse maa maksusoodustused.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Muhu valla haldusterritooriumil asuva maa maamaksumäärad, maamaksu aastase suurenemise maksimaalne piirmäär ja kodualuse maa maksusoodustused.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_muhu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0478"
