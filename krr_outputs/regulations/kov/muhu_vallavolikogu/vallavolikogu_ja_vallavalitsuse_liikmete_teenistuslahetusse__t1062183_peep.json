      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Volikogu esimehe lähetus vormistatakse volikogu otsusega, volikogu liikme ja vallavanema lähetus vormistatakse volikogu esimehe käskkirjaga.",
      "estleg:parentProvision": {
