      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1062183_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Taotluses märgitakse lähetatava nimi ja ametikoht, lähetuse aeg ja sihtkoht ja asutus või üritus, kuhu lähetust soovitakse. Samuti ettepanek lähetuskulude hüvitamise ja päevaraha määra kohta, sh soov saada lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses. Kutse või muu alusmaterjali olemasolul võib need lisada taotluse juurde.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062183_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
