    {
      "@id": "estleg:Reg_1062183_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Lähetuse vormistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavolikogu ja vallavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lähetuse vormistamise aluseks on lähetuse soovija taotlus (lisa 1) lähetuskäskkirja allkirjastajale. 2 (2) Taotluses märgitakse lähetatava nimi ja ametikoht, lähetuse aeg ja sihtkoht ja asutus või üritus, kuhu lähetust soovitakse. Samuti ettepanek lähetuskulude hüvitamise ja päevaraha määra kohta, sh soov saada lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses. Kutse või muu alusmaterjali olemasolul võib need lisada taotluse juurde.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lähetuse vormistamise aluseks on lähetuse soovija taotlus (lisa 1) lähetuskäskkirja allkirjastajale. 2 (2) Taotluses märgitakse lähetatava nimi ja ametikoht, lähetuse aeg ja sihtkoht ja asutus või üritus, kuhu lähetust soovitakse. Samuti ettepanek lähetuskulude hüvitamise ja päevaraha määra kohta, sh soov saada lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses. Kutse või muu alusmaterjali olemasolul võib need lisada taotluse juurde. 3 (3) Volikogu esimehe lähetus vormistatakse volikogu otsusega, volikogu liikme ja vallavanema lähetus vormistatakse volikogu esimehe käskkirjaga. RT IV2026-01-28104280120260102026-01-313 4 (4) Valitsuse liikme lähetus vormistatakse vallavanema käskkirjaga. RT IV2026-01-28104280120260102026-01-313 5 (5) Kui lähetusega ei kaasne sõidu-, majutus-, koolitus- või muu kulu tasumist või päevaraha maksmist, ei ole vaja eraldi käskkirja vormistada. Lähetuses võib kokku leppida selleks pädeva isikuga suuliselt või kirjalikku taasesitamist võimaldavas vormis.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_muhu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0478"
      },
