        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Lähetuskulude hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallavolikogu ja vallavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Ametiasutus hüvitab lähetatule dokumentaalselt tõendatud lähetusega seotud sõidu- ja majutuskulud ning muud lähetusülesande täitmisega seotud kulud avaliku teenistuse seaduses sätestatud tingimustel ja korras. 2 (2) Isikliku auto kasutamisel lähetusse minemisel koostatakse aruanne isikliku auto kasutamise kohta (lisa 2). 3 (3) Lähetusest saabudes koostatakse lähetuse aruanne hiljemalt kolme tööpäeva jooksul e-arvete programmi kaudu, kuhu lisatakse kõik lähetusega otseselt seotud…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ametiasutus hüvitab lähetatule dokumentaalselt tõendatud lähetusega seotud sõidu- ja majutuskulud ning muud lähetusülesande täitmisega seotud kulud avaliku teenistuse seaduses sätestatud tingimustel ja korras. 2 (2) Isikliku auto kasutamisel lähetusse minemisel koostatakse aruanne isikliku auto kasutamise kohta (lisa 2). 3 (3) Lähetusest saabudes koostatakse lähetuse aruanne hiljemalt kolme tööpäeva jooksul e-arvete programmi kaudu, kuhu lisatakse kõik lähetusega otseselt seotud kuludokumendid ja välislähetuse korral käskkirjaga lubatud päevaraha summa. 4 (4) Lähetuse aruanne kinnitatakse esitaja ja vahetu juhi poolt e-arvete programmis. 5 (5) Lähetuskulude hüvitamine toimub hiljemalt kolme tööpäeva jooksul pärast korrektse aruande kinnitamist ning kajastamist raamatupidamisprogrammis.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_muhu_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0478"
