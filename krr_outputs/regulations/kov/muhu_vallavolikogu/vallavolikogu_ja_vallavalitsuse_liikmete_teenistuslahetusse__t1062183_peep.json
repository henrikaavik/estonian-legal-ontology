      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kui lähetusega ei kaasne sõidu-, majutus-, koolitus- või muu kulu tasumist või päevaraha maksmist, ei ole vaja eraldi käskkirja vormistada. Lähetuses võib kokku leppida selleks pädeva isikuga suuliselt või kirjalikku taasesitamist võimaldavas vormis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062183_Par_3"
      },
      "rdfs:label": "§ 3 lg 5",
      "estleg:assertionConfidence": {
