      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lähetuse vormistamise aluseks on lähetuse soovija taotlus (lisa 1) lähetuskäskkirja allkirjastajale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062183_Par_3"
