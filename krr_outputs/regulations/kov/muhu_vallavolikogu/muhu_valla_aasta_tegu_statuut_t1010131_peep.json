      "estleg:summary": {
        "@value": "Tunnustuse eesmärk on väärtustada Muhu vallale olulise tähtsusega ettevõtmist või sündmust, mis on positiivselt mõjutanud valla arengut ja tuntust aasta jooksul.",
        "@language": "et"
      },
      "estleg:legalText": "Tunnustuse eesmärk on väärtustada Muhu vallale olulise tähtsusega ettevõtmist või sündmust, mis on positiivselt mõjutanud valla arengut ja tuntust aasta jooksul.",
