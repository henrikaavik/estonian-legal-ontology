      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Ettepanekute menetlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Muhu valla “Aasta Tegu” statuut",
      "estleg:summary": {
        "@value": "1(1)Tunnustuse kandidaatide nimed avalikustatakse Muhu valla kodulehel. 2(2)Volikogu esimees esitab laekunud ettepanekud volikogu istungile hääletamiseks. 3(3)Tunnustuse „Aasta Tegu” laureaadi valib volikogu, mis vormistatakse volikogu otsusega. 4(4)Põhjendatud kaalutlustel võib volikogu jätta tunnustuse välja andmata.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Tunnustuse kandidaatide nimed avalikustatakse Muhu valla kodulehel. 2(2)Volikogu esimees esitab laekunud ettepanekud volikogu istungile hääletamiseks. 3(3)Tunnustuse „Aasta Tegu” laureaadi valib volikogu, mis vormistatakse volikogu otsusega. 4(4)Põhjendatud kaalutlustel võib volikogu jätta tunnustuse välja andmata.",
