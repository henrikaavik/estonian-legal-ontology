      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala ja eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Kortermajale toetuse andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Määrusega kehtestatakse Setomaa valla eelarvest korteriühistule toetuse andmise tingimused ja kord. 2 (2) Toetuse eesmärk on Setomaa valla korteriühistute üldkasutatavate ruumide ning tehnosüsteemide rekonstrueerimine, tuleohutusnõuete tagamine, elukeskkonna parandamine ja atraktiivsemaks muutmine.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega kehtestatakse Setomaa valla eelarvest korteriühistule toetuse andmise tingimused ja kord. 2 (2) Toetuse eesmärk on Setomaa valla korteriühistute üldkasutatavate ruumide ning tehnosüsteemide rekonstrueerimine, tuleohutusnõuete tagamine, elukeskkonna parandamine ja atraktiivsemaks muutmine.",
      "estleg:enactedBy": {
