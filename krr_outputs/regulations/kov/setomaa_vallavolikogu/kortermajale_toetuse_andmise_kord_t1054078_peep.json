    {
      "@id": "estleg:Reg_1054078_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Toetatavad tegevused",
        "@language": "et"
      },
      "estleg:sourceAct": "Kortermajale toetuse andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Toetatavad on alljärgnevad tegevused: 1 1) üldkasutatavate ruumide ja hoone osade rekonstrueerimine; 2 2) üldkasutatava infrastruktuuri (kütte-, ventilatsiooni-, vee-, kanalisatsiooni- ja/või elektrisüsteemi) rekonstrueerimine; 3 3) parkla ehitamine või laiendamine; 4 4) jäätmemajade rajamine (eelistatud mitme korteriühistu koostöö); 5 5) mängu- ja/või spordiväljakute, atraktsioonide rajamine/parendamine (eelistatud mitme korteriühistu koostöö); 6 6) haljastus ja heakord; 7 7)…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetatavad on alljärgnevad tegevused: 1 1) üldkasutatavate ruumide ja hoone osade rekonstrueerimine; 2 2) üldkasutatava infrastruktuuri (kütte-, ventilatsiooni-, vee-, kanalisatsiooni- ja/või elektrisüsteemi) rekonstrueerimine; 3 3) parkla ehitamine või laiendamine; 4 4) jäätmemajade rajamine (eelistatud mitme korteriühistu koostöö); 5 5) mängu- ja/või spordiväljakute, atraktsioonide rajamine/parendamine (eelistatud mitme korteriühistu koostöö); 6 6) haljastus ja heakord; 7 7) kaasfinantseeringu tagamine Ettevõtluse ja Innovatsiooni SA toetusmeetmesse. 2 (2) Uute parklate ja mänguväljakute ehitamisele kohaldatakse ehitusseadustiku sätteid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_setomaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0732"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054078_Map"
      },
      "estleg:hasSubsection": [
