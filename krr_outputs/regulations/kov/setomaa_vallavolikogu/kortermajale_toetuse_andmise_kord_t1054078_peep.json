      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toetuse taotleja",
        "@language": "et"
      },
      "estleg:sourceAct": "Kortermajale toetuse andmise kord",
      "estleg:summary": {
        "@value": "Toetuse taotlejaks võib olla Setomaa vallas asuv 4 või enama korteriomandiga korteriühistu või kaks või enam korteriühistut, kus kokku on kümme või enam korteriomandit (edaspidi taotleja).",
        "@language": "et"
      },
      "estleg:legalText": "Toetuse taotlejaks võib olla Setomaa vallas asuv 4 või enama korteriomandiga korteriühistu või kaks või enam korteriühistut, kus kokku on kümme või enam korteriomandit (edaspidi taotleja).",
