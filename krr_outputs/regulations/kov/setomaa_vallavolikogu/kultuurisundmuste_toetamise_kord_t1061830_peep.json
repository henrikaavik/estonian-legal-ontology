      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_setomaa_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061830_Par_4_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Rahaliste vahendite olemasolul on õigus välja kuulutada erakorraline taotlusvoor.",
