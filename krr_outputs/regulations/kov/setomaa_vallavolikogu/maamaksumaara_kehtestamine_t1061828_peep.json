      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Setomaa valla haldusterritooriumil maamaksumäär:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5% maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,4% maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0% maa maksustamishinnast aastas.44) aastase kasvu piirmääraks 10%.55) koduomaniku soodustuse summa 100 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Setomaa valla haldusterritooriumil maamaksumäär:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5% maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,4% maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0% maa maksustamishinnast aastas.44) aastase kasvu piirmääraks 10%.55) koduomaniku soodustuse summa 100 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_setomaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0732"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061828_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1061828_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061828_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Setomaa valla haldusterritooriumil maamaksumäär: 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5% maa maksustamishinnast aastas; 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,4% maa maksustamishinnast aastas; 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0% maa maksustamishinnast aastas. 4) aastase kasvu piirmääraks 10%. 5) koduomaniku soodustuse summa 100 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061828_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
