        }
      ]
    },
    {
      "@id": "estleg:Reg_1048832_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Setomaa valla punasel vapikilbil on hõbedane Seto suursõlg ja neljast hõbedasest kaldristikesest moodustuv Seto muster päisena (määruse lisa 1).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048832_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1048832_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Setomaa valla vapil punane on kaitsevärv, valge tähistab puhtust, hõbedane tähistab jõukust. Punane ja valge on seto kultuuris/tekstiilis põhivärvid. Geomeetriline muster (kiri) tähistab seto käsitöötraditsioone. Sõle kinnis esindab Setomaad, mille vahel on kontrolljoon.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048832_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1048832_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Setomaa valla lipp",
        "@language": "et"
      },
      "estleg:sourceAct": "Setomaa valla sümbolid",
      "estleg:summary": {
        "@value": "1(1)Setomaa valla lipuna kasutatakse VII Seto Kongressil 29.11.2003 valitud Setomaa lippu (määruse lisa 2). 2(2)Setomaa lipp on valge ristikujuliselt asetseva seto Pankjavitsa vöökirjaga. Vöökiri tähistab seto käsitöötraditsioone. Setomaa lipul valge tähistab puhtust, punane on kaitsevärv, hõbedane tähistab jõukust, roheline metsa, sinine vett ja taevast. 3(3)Lipu laiuse ja pikkuse suhe on 6:11.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Setomaa valla lipuna kasutatakse VII Seto Kongressil 29.11.2003 valitud Setomaa lippu (määruse lisa 2). 2(2)Setomaa lipp on valge ristikujuliselt asetseva seto Pankjavitsa vöökirjaga. Vöökiri tähistab seto käsitöötraditsioone. Setomaa lipul valge tähistab puhtust, punane on kaitsevärv, hõbedane tähistab jõukust, roheline metsa, sinine vett ja taevast. 3(3)Lipu laiuse ja pikkuse suhe on 6:11.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_setomaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0732"
