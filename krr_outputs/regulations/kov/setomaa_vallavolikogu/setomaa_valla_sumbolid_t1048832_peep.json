      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Setomaa valla vapp",
        "@language": "et"
      },
      "estleg:sourceAct": "Setomaa valla sümbolid",
      "estleg:summary": {
        "@value": "1(1)Setomaa valla punasel vapikilbil on hõbedane Seto suursõlg ja neljast hõbedasest kaldristikesest moodustuv Seto muster päisena (määruse lisa 1). 2(2)Setomaa valla vapil punane on kaitsevärv, valge tähistab puhtust, hõbedane tähistab jõukust. Punane ja valge on seto kultuuris/tekstiilis põhivärvid. Geomeetriline muster (kiri) tähistab seto käsitöötraditsioone. Sõle kinnis esindab Setomaad, mille vahel on kontrolljoon.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Setomaa valla punasel vapikilbil on hõbedane Seto suursõlg ja neljast hõbedasest kaldristikesest moodustuv Seto muster päisena (määruse lisa 1). 2(2)Setomaa valla vapil punane on kaitsevärv, valge tähistab puhtust, hõbedane tähistab jõukust. Punane ja valge on seto kultuuris/tekstiilis põhivärvid. Geomeetriline muster (kiri) tähistab seto käsitöötraditsioone. Sõle kinnis esindab Setomaad, mille vahel on kontrolljoon.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_setomaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0732"
      },
