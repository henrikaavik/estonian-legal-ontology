    {
      "@id": "estleg:Reg_1064374_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine 2027. aastaks",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064374_Map"
      },
      "estleg:summary": {
        "@value": "Rakvere valla haldusterritooriumil kehtestatakse maamaksumäärad vastavalt maa sihtotstarbegruppidele alates 1. jaanuarist 2027. a järgmiselt: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumäär on 0,5% kehtivast maa maksustamishinnast aastas; 2 2) maatulundusmaa kõlviku (nt haritav maa, metsamaa) maamaksumäär on 0,5% kehtivast maa maksustamishinnast aastas; 3 3) muu sihtotstarbega maa (nt ärimaa, tootmismaa, transporidmaa) maamaksumäär on 1% kehtivast maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Rakvere valla haldusterritooriumil kehtestatakse maamaksumäärad vastavalt maa sihtotstarbegruppidele alates 1. jaanuarist 2027. a järgmiselt: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumäär on 0,5% kehtivast maa maksustamishinnast aastas; 2 2) maatulundusmaa kõlviku (nt haritav maa, metsamaa) maamaksumäär on 0,5% kehtivast maa maksustamishinnast aastas; 3 3) muu sihtotstarbega maa (nt ärimaa, tootmismaa, transporidmaa) maamaksumäär on 1% kehtivast maa maksustamishinnast aastas.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1064374_Par_1_Lg_1"
        }
      ],
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0661"
      }
    },
    {
      "@id": "estleg:Reg_1064374_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Rakvere valla haldusterritooriumil kehtestatakse maamaksumäärad vastavalt maa sihtotstarbegruppidele alates 1. jaanuarist 2027. a järgmiselt: 1) elamumaa ja maatulundusmaa õuemaa kõlviku maamaksumäär on 0,5% kehtivast maa maksustamishinnast aastas; 2) maatulundusmaa kõlviku (nt haritav maa, metsamaa) maamaksumäär on 0,5% kehtivast maa maksustamishinnast aastas; 3) muu sihtotstarbega maa (nt ärimaa, tootmismaa, transporidmaa) maamaksumäär on 1% kehtivast maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064374_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
