    {
      "@id": "estleg:Reg_1064196_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse rahvastikuregistri andmetel Peipsiääre vallas elavate õppimiskohustuslike laste (edaspidi õpilased) õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöö korralduse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064196_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1064196_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrust rakendatakse kõigile õpilastele, sõltumata sellest, kas nad õpivad elukohajärgses koolis või muu omavalitsuse koolis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064196_Par_1"
      },
      "rdfs:label": "§ 1 lg 2",
      "estleg:targetGroup": [
