      }
    },
    {
      "@id": "estleg:Reg_1064196_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppimiskohustuse täitmise tagamise korraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Peipsiääre valla õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064196_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Õppimiskohustus on kohustus osaleda põhi-, kesk- või kutsehariduse õppes kuni 18-aastaseks saamiseni, välja arvatud juhul, kui laps on omandanud kesk- või kutsehariduse varem. 2 (2) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Kooli direktor määrab ülesande täitmise eest vastutava isiku. 3 (3) Õppimiskohustuse mittetäitmise tuvastamisel algatab kool hindamise ja rakendab esmaseid tugimeetmeid.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Õppimiskohustus on kohustus osaleda põhi-, kesk- või kutsehariduse õppes kuni 18-aastaseks saamiseni, välja arvatud juhul, kui laps on omandanud kesk- või kutsehariduse varem. 2 (2) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Kooli direktor määrab ülesande täitmise eest vastutava isiku. 3 (3) Õppimiskohustuse mittetäitmise tuvastamisel algatab kool hindamise ja rakendab esmaseid tugimeetmeid. 4 (4) Õppimiskohustuse täitmise hindamisel lähtutakse järgmistest näitajatest: 1 1) õpilase korduvad põhjendamata puudumised õppetööst; 2 2) õpilase võlgnevused õppetöös; 3 3) õpetajate ja tugispetsialistide hinnangud õpilase täiendava toe vajaduse kohta. 5 (5) Juhul kui kooli rakendatud tugimeetmed ei ole taganud õpilase õppimiskohustuse täitmist, algatab vastutav isik Eesti Hariduse Infosüsteemis (edaspidi EHIS) õppest väljalangemise ohuga õpilase juhtumi, mille kaudu teavitatakse vallavalitsuse haridusametnikku. 6 (6) Õppimiskohustuse täitmise seiret kohalikus omavalitsuses koordineerib vallavalitsuse määratud ametnik, kes: 1 1) saab EHIS-e kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) menetleb juhtumeid, selgitades välja õppimiskohustuse täitmata jätmise põhjused; 3 3) korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete rakendamise osas, kaasates juhtumipõhiselt õpilase seaduslikud esindaja(d) ja vajadusel valdkonnaülesed spetsialistid. 7 (7) Kui õppimiskohustuslik laps õpib väljaspool elukohajärgset omavalitsust, tehakse koostööd kooli ja vastava kohaliku omavalitsusega.",
      "estleg:hasSubsection": [
