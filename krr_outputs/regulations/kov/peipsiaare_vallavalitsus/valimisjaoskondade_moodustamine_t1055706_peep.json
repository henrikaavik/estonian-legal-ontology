      "rdfs:label": {
        "@value": "§ 4. Määruse rakendamine ja jõustumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Peipsiääre Vallavalitsuse 17. august 2021 määrus nr 4 „Valimisjaoskondade moodustamine“ tunnistatakse kehtetuks. 2 (2) Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Peipsiääre Vallavalitsuse 17. august 2021 määrus nr 4 „Valimisjaoskondade moodustamine“ tunnistatakse kehtetuks. 2 (2) Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
