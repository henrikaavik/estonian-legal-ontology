        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1064410_Par_3_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Komisjoni tööd dokumenteeritakse haridussilmas, komisjoni otsuseid ja protokolle säilitatakse kümme aastat.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064410_Par_3"
      },
      "rdfs:label": "§ 3 lg 7"
