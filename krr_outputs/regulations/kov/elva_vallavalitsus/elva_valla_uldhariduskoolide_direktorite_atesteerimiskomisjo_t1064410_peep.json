        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Atesteerimiskohtumist juhib komisjoni esimees või komisjoni poolt kokkulepitud komisjoni liige.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064410_Par_3"
      },
      "rdfs:label": "§ 3 lg 6",
      "estleg:targetGroup": [
