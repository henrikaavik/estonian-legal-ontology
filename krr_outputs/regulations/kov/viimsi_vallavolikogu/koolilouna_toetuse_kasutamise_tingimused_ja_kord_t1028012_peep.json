        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_viimsi_vallavalitsus"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1028012_Par_2_Lg_1"
