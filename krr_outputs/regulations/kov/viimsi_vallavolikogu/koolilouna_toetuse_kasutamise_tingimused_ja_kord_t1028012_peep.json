      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrus kehtestab riigieelarve ja Viimsi valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise korra Viimsi valla üldhariduskoolides.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus kehtestab riigieelarve ja Viimsi valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise korra Viimsi valla üldhariduskoolides.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viimsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0890"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1028012_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1028012_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1028012_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrus kehtestab riigieelarve ja Viimsi valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise korra Viimsi valla üldhariduskoolides.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1028012_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1028012_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarves ette nähtud toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Viimsi valla koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. RT IV 2019-11-20 3 420112019003 2019-11-23 25 2 (2) Riigieelarves ettenähtud toetuse ja koolilõuna tegeliku maksumuse vahe 1.-9. klasside õpilaste eest kaetakse Viimsi valla eelarvest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarves ette nähtud toetuse ulatuses kaetakse põhiharidust omandavate õpilaste toitlustuskulud riigieelarvest Viimsi valla koolilõuna kuludeks määratud sihtotstarbeliste eraldiste arvelt. RT IV 2019-11-20 3 420112019003 2019-11-23 25 2 (2) Riigieelarves ettenähtud toetuse ja koolilõuna tegeliku maksumuse vahe 1.-9. klasside õpilaste eest kaetakse Viimsi valla eelarvest. RT IV 2019-11-20 3 420112019003 2019-11-23 25 3 (3) Toitlustusteenuse osutajale kaetakse koolilõuna kulud toitlustamisteenuse osutamise lepingu alusel, mille sõlmib vallavalitsus toitlustamist korraldava ettevõtjaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viimsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0890"
      },
