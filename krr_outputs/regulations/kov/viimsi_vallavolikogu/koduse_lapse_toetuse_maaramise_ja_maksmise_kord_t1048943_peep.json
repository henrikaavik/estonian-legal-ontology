      }
    },
    {
      "@id": "estleg:Reg_1048943_Par_4_Lg_2_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2¹",
      "estleg:legalText": "(2¹) Koduse lapse toetuse taotlus esitatakse osakonnale hiljemalt jooksva kalendrikuu 15. kuupäevaks. Taotlused, mis esitatakse peale nimetatud kuupäeva, arvestatakse toetuse määramiseks järgmisest kalendrikuust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048943_Par_4"
      },
      "rdfs:label": "§ 4 lg 2¹"
    },
    {
      "@id": "estleg:Reg_1048943_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Taotlus jäetakse rahuldamata, kui kümne tööpäeva jooksul taotluse esitamisest või kirjaliku teate saatmisest ei ole esitatud täiendavalt nõutud andmeid või dokumente.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048943_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1048943_Par_5",
      "@type": [
