        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1048943_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Toetus kantakse üle taotluses märgitud arvelduskontole kord kuus hiljemalt 25. kuupäevaks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048943_Par_5"
      },
      "rdfs:label": "§ 5 lg 3"
    },
    {
      "@id": "estleg:Reg_1048943_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Vaidluste lahendamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koduse lapse toetuse määramise ja maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Kui toetus on taotleja poolt valeandmete esitamise tagajärjel makstud välja alusetult, on vallavalitsusel õigus nõuda alusetult makstud toetuse summa tagastamist, esitades toetuse saajale sellekohase nõudekirja. 2 (2) Toetuse alusetult saanud isik on kohustatud alusetult saadud toetuse tagasi maksma 15 päeva jooksul arvates vallavalitsuselt nõudekirja saamisest. Alusetult makstud toetusi, mida pole ettenähtud 15 päeva jooksul tagastatud, on vallavalitsusel õigus nõuda tagasi kohtu korras.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui toetus on taotleja poolt valeandmete esitamise tagajärjel makstud välja alusetult, on vallavalitsusel õigus nõuda alusetult makstud toetuse summa tagastamist, esitades toetuse saajale sellekohase nõudekirja. 2 (2) Toetuse alusetult saanud isik on kohustatud alusetult saadud toetuse tagasi maksma 15 päeva jooksul arvates vallavalitsuselt nõudekirja saamisest. Alusetult makstud toetusi, mida pole ettenähtud 15 päeva jooksul tagastatud, on vallavalitsusel õigus nõuda tagasi kohtu korras. Sel juhul on alusetu toetuse saanud isik kohustatud vallavalitsusele hüvitama ka sissenõudmisega seotud kulud. RT IV 2020-09-01 6 401092020006 2020-09-04 31",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viimsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0890"
      },
