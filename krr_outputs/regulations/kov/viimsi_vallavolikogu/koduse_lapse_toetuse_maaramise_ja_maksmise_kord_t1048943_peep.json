      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toetuse taotleja esitab vallavalitsusele kirjaliku vormikohase taotluse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048943_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
