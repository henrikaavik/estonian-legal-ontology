        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Vallavolikogu esimehe käskkirja vormistab ning käskkirja ja alusmaterjalid säilitab Viimsi Vallavolikogu kantselei. Vallavanema käskkirja vormistab ning käskkirja alusmaterjalid säilitab Viimsi vallakantselei.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012884_Par_4"
      },
      "rdfs:label": "§ 4 lg 5",
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_viimsi_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1012884_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Lähetus vormistatakse kooskõlas ametiasutuse asjaajamist ning raamatupidamisarvestust ja -aruandlust reguleerivates õigusaktides sätestatud nõuetega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012884_Par_4"
      },
      "rdfs:label": "§ 4 lg 6",
      "estleg:targetGroup": [
