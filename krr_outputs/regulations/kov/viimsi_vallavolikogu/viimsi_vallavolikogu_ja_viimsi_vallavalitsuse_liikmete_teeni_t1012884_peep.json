    {
      "@id": "estleg:Reg_1012884_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Lähetuse vormistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Viimsi Vallavolikogu ja Viimsi Vallavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Vallavolikogu liikme lähetus vormistatakse vallavolikogu esimehe käskkirjaga ja vallavalitsuse liikme lähetus vallavanema käskkirjaga, milles märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht, ülesanne ning lähetuskulude hüvitamise ulatus. 2 (2) Välislähetuse korral märgitakse käskkirjas ka asutus või üritus, kuhu lähetatu suunatakse ning välislähetuse päevaraha määr. 3 (3) Vallavolikogu esimehe või vallavanema lähetuse korral märgitakse käskkirjas ka tema asendaja.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vallavolikogu liikme lähetus vormistatakse vallavolikogu esimehe käskkirjaga ja vallavalitsuse liikme lähetus vallavanema käskkirjaga, milles märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht, ülesanne ning lähetuskulude hüvitamise ulatus. 2 (2) Välislähetuse korral märgitakse käskkirjas ka asutus või üritus, kuhu lähetatu suunatakse ning välislähetuse päevaraha määr. 3 (3) Vallavolikogu esimehe või vallavanema lähetuse korral märgitakse käskkirjas ka tema asendaja. 4 (4) Käskkiri vormistatakse üldjuhul vähemalt kolm tööpäeva enne lähetuse algust. 5 (5) Vallavolikogu esimehe käskkirja vormistab ning käskkirja ja alusmaterjalid säilitab Viimsi Vallavolikogu kantselei. Vallavanema käskkirja vormistab ning käskkirja alusmaterjalid säilitab Viimsi vallakantselei. 6 (6) Lähetus vormistatakse kooskõlas ametiasutuse asjaajamist ning raamatupidamisarvestust ja -aruandlust reguleerivates õigusaktides sätestatud nõuetega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viimsi_vallavolikogu"
      },
