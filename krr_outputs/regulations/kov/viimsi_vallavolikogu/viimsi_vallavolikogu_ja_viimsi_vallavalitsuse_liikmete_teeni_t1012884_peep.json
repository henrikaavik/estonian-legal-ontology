      "rdfs:label": {
        "@value": "§ 2. Teenistuslähetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Viimsi Vallavolikogu ja Viimsi Vallavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "Teenistuslähetus (edaspidi lähetus) on vallavolikogu või vallavalitsuse liikme saatmine kindlaksmääratud ajavahemikus täitma ametiülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Vallavolikogu liige saadetakse lähetusse vallavolikogu esimehe korraldusel ja vallavalitsuse liige vallavanema korraldusel.",
        "@language": "et"
      },
      "estleg:legalText": "Teenistuslähetus (edaspidi lähetus) on vallavolikogu või vallavalitsuse liikme saatmine kindlaksmääratud ajavahemikus täitma ametiülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Vallavolikogu liige saadetakse lähetusse vallavolikogu esimehe korraldusel ja vallavalitsuse liige vallavanema korraldusel.",
