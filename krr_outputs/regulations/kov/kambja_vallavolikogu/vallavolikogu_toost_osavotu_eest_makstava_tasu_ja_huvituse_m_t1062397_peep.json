      }
    },
    {
      "@id": "estleg:Reg_1062397_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Tasu arvestamise aluseks on komisjoni koosoleku protokolliga fikseeritud osavõtt koosolekust.",
      "estleg:parentProvision": {
