      "estleg:legalText": "(2) Volikogu alatise ja ajutise komisjoni liikmele makstakse komisjoni tööst osavõtu eest tasu 40 eurot koosoleku kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062397_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
