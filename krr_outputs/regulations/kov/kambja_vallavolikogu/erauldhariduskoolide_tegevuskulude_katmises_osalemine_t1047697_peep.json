        }
      ]
    },
    {
      "@id": "estleg:Reg_1047697_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui õpilane õpib teise kohaliku omavalitsuse territooriumil asuvas erakoolis sotsiaalosakonna soovitusel, antakse erakooli pidajale õpilase kohta toetus vastavalt õppekoha tegevuskulu arvestuslikule maksumusele, millest on lahutatud riigi makstav tegevuskulude katmise toetus.",
      "estleg:parentProvision": {
