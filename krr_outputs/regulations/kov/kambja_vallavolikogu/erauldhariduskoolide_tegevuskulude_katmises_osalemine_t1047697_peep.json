    {
      "@id": "estleg:Reg_1047697_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Toetuse andmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Eraüldhariduskoolide tegevuskulude katmises osalemine",
      "estleg:summary": {
        "@value": "1(1)Erakooli pidajale antakse toetatava õpilase kohta toetust kalendrikuu eest kuumäära alusel, kui on täidetud käesoleva määruse paragrahvis 3 sätestatud tingimused. 2(2)Selle, kas antud erakool on vallale vajalik hariduse kättesaadavuse või mitmekesisuse tagamiseks, otsustab vallavalitsus. 3(3)Toetuse maksmise aluseks on erakooli pidaja poolt igakuiselt Kambja Vallavalitsusele (edaspidi vallavalitsus) esitatud arve.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Erakooli pidajale antakse toetatava õpilase kohta toetust kalendrikuu eest kuumäära alusel, kui on täidetud käesoleva määruse paragrahvis 3 sätestatud tingimused. 2(2)Selle, kas antud erakool on vallale vajalik hariduse kättesaadavuse või mitmekesisuse tagamiseks, otsustab vallavalitsus. 3(3)Toetuse maksmise aluseks on erakooli pidaja poolt igakuiselt Kambja Vallavalitsusele (edaspidi vallavalitsus) esitatud arve. 4(4)Kui õpilane alustab või lõpetab erakoolis õppimise kalendrikuu kestel, antakse toetust kuumäära alusel ümardatuna poole kalendrikuu täpsusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kambja_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0283"
      },
