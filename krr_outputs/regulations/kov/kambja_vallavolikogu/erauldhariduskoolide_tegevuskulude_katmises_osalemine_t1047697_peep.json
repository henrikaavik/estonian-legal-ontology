    {
      "@id": "estleg:Reg_1047697_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Erakooli pidajale antakse toetatava õpilase kohta toetust kalendrikuu eest kuumäära alusel, kui on täidetud käesoleva määruse paragrahvis 3 sätestatud tingimused.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047697_Par_5"
      },
      "rdfs:label": "§ 5 lg 1"
    },
    {
      "@id": "estleg:Reg_1047697_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Selle, kas antud erakool on vallale vajalik hariduse kättesaadavuse või mitmekesisuse tagamiseks, otsustab vallavalitsus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047697_Par_5"
      },
      "rdfs:label": "§ 5 lg 2",
      "estleg:targetGroup": [
