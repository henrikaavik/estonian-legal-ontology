    {
      "@id": "estleg:Reg_1047697_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Erakooli pidajale makstava toetuse kuumäär on 0,8–kordne eelmise kalendriaasta Vabariigi Valitsuse kehtestatud õppekoha tegevuskulu piirmäära ja konkreetses kohalikus omavalitsuses tegutsevatele erakoolidele eelmisel kalendriaastal erakooliseaduse paragrahvi 22³ alusel riigi poolt makstud keskmise tegevuskulutoetuse määra vahe Toetuse arvuline suurus arvutatakse euro täpsusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047697_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:targetGroup": [
