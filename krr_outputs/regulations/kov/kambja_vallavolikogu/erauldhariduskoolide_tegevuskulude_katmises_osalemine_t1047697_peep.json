      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Toetuse maksmise aluseks on erakooli pidaja poolt igakuiselt Kambja Vallavalitsusele (edaspidi vallavalitsus) esitatud arve.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047697_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
      "estleg:targetGroup": [
