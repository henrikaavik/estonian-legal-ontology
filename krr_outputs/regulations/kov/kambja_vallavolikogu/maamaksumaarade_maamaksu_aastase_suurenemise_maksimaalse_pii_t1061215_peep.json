      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade, maamaksu aastase suurenemise maksimaalse piirmäära ja kodualuse maa maksusoodustuse kehtestamine",
      "estleg:summary": {
        "@value": "Maamaksumäärad kehtestatakse järgmiselt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2 2) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1 protsent maa maksustamishinnast aastas.",
        "@language": "et"
      },
