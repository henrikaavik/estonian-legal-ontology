      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1048888_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Võru valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavatele õpilastele kaetakse Võru valla eelarvest.",
      "estleg:parentProvision": {
