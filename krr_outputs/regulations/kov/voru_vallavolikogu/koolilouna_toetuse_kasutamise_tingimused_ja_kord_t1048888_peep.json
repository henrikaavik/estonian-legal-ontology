      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Võru vallale riigieelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Võru vallale riigieelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_vallavolikogu"
      },
