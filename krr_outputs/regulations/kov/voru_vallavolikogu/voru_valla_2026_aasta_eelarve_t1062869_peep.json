      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Eelarve vastuvõtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Võru valla 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "Võtta vastu Võru valla 2026. aasta eelarve vastavalt käesoleva määruse lisadele järgmiselt:11) põhitegevuse tulud summas 24 725 098 eurot (lisa 1);22) põhitegevuse kulud summas 24 381 914 eurot (lisa 2);33) investeerimistegevus summas 4 102 887 eurot (lisa 3);44) finantseerimistegevus summas 863 612 eurot (lisa 4);55) likviidsete varade vähenemine summas -2 896 091 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Võtta vastu Võru valla 2026. aasta eelarve vastavalt käesoleva määruse lisadele järgmiselt:11) põhitegevuse tulud summas 24 725 098 eurot (lisa 1);22) põhitegevuse kulud summas 24 381 914 eurot (lisa 2);33) investeerimistegevus summas 4 102 887 eurot (lisa 3);44) finantseerimistegevus summas 863 612 eurot (lisa 4);55) likviidsete varade vähenemine summas -2 896 091 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0917"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062869_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1062869_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062869_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Võtta vastu Võru valla 2026. aasta eelarve vastavalt käesoleva määruse lisadele järgmiselt: 1) põhitegevuse tulud summas 24 725 098 eurot (lisa 1); 2) põhitegevuse kulud summas 24 381 914 eurot (lisa 2); 3) investeerimistegevus summas 4 102 887 eurot (lisa 3); 4) finantseerimistegevus summas 863 612 eurot (lisa 4); 5) likviidsete varade vähenemine summas -2 896 091 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062869_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "@id": "estleg:Reg_1062869_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Määruse jõustumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Võru valla 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "1(1) Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist. 2(2) Määrust rakendatakse tagasiulatuvalt alates 1. jaanuarist 2026. a.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist. 2(2) Määrust rakendatakse tagasiulatuvalt alates 1. jaanuarist 2026. a.",
