      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1043236_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Toetatavad tegevused",
        "@language": "et"
      },
      "estleg:sourceAct": "Kortermajale toetuse andmise kord",
      "estleg:summary": {
        "@value": "1(1)Toetatavad on alljärgnevad tegevused:11) parkla ehitamine või laiendamine;22) jäätmemajade rajamine (eelistatud mitme korteriühistu koostöö);33) kõrghaljastuse ja/või haljasalade rajamine/parendamine;44) mängu- ja/või spordiväljakute-, atraktsioonide rajamine/parendamine (eelistatud mitme korteriühistu koostöö);55) rattahoidlate, pesukuivatuskohtade jms rajamine ja/või parendamine. 2(2)Uute parklate ja mänguväljakute ehitamisele kohaldatakse ehitusseadustiku sätteid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Toetatavad on alljärgnevad tegevused:11) parkla ehitamine või laiendamine;22) jäätmemajade rajamine (eelistatud mitme korteriühistu koostöö);33) kõrghaljastuse ja/või haljasalade rajamine/parendamine;44) mängu- ja/või spordiväljakute-, atraktsioonide rajamine/parendamine (eelistatud mitme korteriühistu koostöö);55) rattahoidlate, pesukuivatuskohtade jms rajamine ja/või parendamine. 2(2)Uute parklate ja mänguväljakute ehitamisele kohaldatakse ehitusseadustiku sätteid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0917"
      },
