      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala ja eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Kortermajale toetuse andmise kord",
      "estleg:summary": {
        "@value": "1(1)Määrusega kehtestatakse Võru valla eelarvest korteriühistule toetuse andmise tingimused ja kord (edaspidi kord). 2(2)Toetuse eesmärk on Võru valla korteriühistutele õuealade korrastamise võimaluste loomine ja edendamine ning sellega elukeskkonna parandamine ja atraktiivsemaks muutmine.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Määrusega kehtestatakse Võru valla eelarvest korteriühistule toetuse andmise tingimused ja kord (edaspidi kord). 2(2)Toetuse eesmärk on Võru valla korteriühistutele õuealade korrastamise võimaluste loomine ja edendamine ning sellega elukeskkonna parandamine ja atraktiivsemaks muutmine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0917"
      },
