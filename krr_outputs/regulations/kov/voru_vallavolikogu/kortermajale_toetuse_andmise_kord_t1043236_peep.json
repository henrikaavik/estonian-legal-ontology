    {
      "@id": "estleg:Reg_1043236_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toetatavad on alljärgnevad tegevused: 1) parkla ehitamine või laiendamine; 2) jäätmemajade rajamine (eelistatud mitme korteriühistu koostöö); 3) kõrghaljastuse ja/või haljasalade rajamine/parendamine; 4) mängu- ja/või spordiväljakute-, atraktsioonide rajamine/parendamine (eelistatud mitme korteriühistu koostöö); 5) rattahoidlate, pesukuivatuskohtade jms rajamine ja/või parendamine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043236_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "@id": "estleg:Reg_1043236_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Uute parklate ja mänguväljakute ehitamisele kohaldatakse ehitusseadustiku sätteid.",
      "estleg:parentProvision": {
