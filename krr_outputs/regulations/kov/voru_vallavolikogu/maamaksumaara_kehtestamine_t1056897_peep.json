      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Võru valla territooriumil järgmised maamaksumäärad:11) elamumaa ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Võru valla territooriumil järgmised maamaksumäärad:11) elamumaa ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0917"
