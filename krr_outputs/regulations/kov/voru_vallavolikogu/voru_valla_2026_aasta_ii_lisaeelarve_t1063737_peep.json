      "estleg:summary": {
        "@value": "Võtta vastu Võru valla 2026. aasta II lisaeelarve vastavalt käesoleva määruse lisale järgmiselt: 1 1) põhitegevuse tulud summas 71 674 eurot; 2 2) põhitegevuse kulud summas 100 046 eurot; 3 3) investeerimistegevus summas 116 888 eurot; 4 4) finantseerimistegevus summas 160 000 eurot; 5 5) likviidsete varade suurenemine summas 14 741 eurot;",
        "@language": "et"
      },
