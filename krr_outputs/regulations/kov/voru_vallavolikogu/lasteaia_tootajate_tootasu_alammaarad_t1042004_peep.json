    },
    {
      "@id": "estleg:Reg_1042004_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Direktori töötasu määrab vallavanem, töötaja töötasu määrab direktor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042004_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1042004_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lasteaiaõpetaja töötasu alammäär täistööajaga töötamisel on: 1) alates 1. jaanuarist 2018 vähemalt 85% Vabariigi Valitsuse poolt kehtestatud üldhariduskooli õpetaja töötasu alammäärast (edaspidi töötasu alammäär); 2) alates 1. jaanuarist 2019 vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% töötasu alammäärast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042004_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:itemNumber": [
        "1",
        "2"
      ]
    },
    {
      "@id": "estleg:Reg_1042004_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Nõuetele vastava kvalifikatsiooniga logopeedi ja eripedagoogi töötasu alammäär täistööajaga töötamisel on võrdne lasteaiaõpetaja töötasu alammääraga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042004_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
