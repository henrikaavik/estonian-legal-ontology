    {
      "@id": "estleg:Reg_1042004_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Lasteaia töötaja töötasu",
        "@language": "et"
      },
      "estleg:sourceAct": "Lasteaia töötajate töötasu alammäärad",
      "estleg:summary": {
        "@value": "1(1) Direktori töötasu määrab vallavanem, töötaja töötasu määrab direktor. 2(2) Lasteaiaõpetaja töötasu alammäär täistööajaga töötamisel on:11) alates 1. jaanuarist 2018 vähemalt 85% Vabariigi Valitsuse poolt kehtestatud üldhariduskooli õpetaja töötasu alammäärast (edaspidi töötasu alammäär);22) alates 1. jaanuarist 2019 vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% töötasu alammäärast.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Direktori töötasu määrab vallavanem, töötaja töötasu määrab direktor. 2(2) Lasteaiaõpetaja töötasu alammäär täistööajaga töötamisel on:11) alates 1. jaanuarist 2018 vähemalt 85% Vabariigi Valitsuse poolt kehtestatud üldhariduskooli õpetaja töötasu alammäärast (edaspidi töötasu alammäär);22) alates 1. jaanuarist 2019 vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% töötasu alammäärast. 3(3) Nõuetele vastava kvalifikatsiooniga logopeedi ja eripedagoogi töötasu alammäär täistööajaga töötamisel on võrdne lasteaiaõpetaja töötasu alammääraga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_voru_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0917"
      },
