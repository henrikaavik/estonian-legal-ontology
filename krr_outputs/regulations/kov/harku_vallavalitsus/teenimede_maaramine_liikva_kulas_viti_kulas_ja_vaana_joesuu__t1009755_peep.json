      }
    },
    {
      "@id": "estleg:Reg_1009755_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1009755",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. [Määrata Vääna-Jõesuu külas seni nimetutele teedele nimed järgmiselt: 1) Terra AÜ...]",
      "estleg:sourceAct": "Teenimede määramine Liikva külas, Viti külas ja Vääna-Jõesuu külas",
      "estleg:summary": "Määrata Vääna-Jõesuu külas seni nimetutele teedele nimed järgmiselt: 1) Terra AÜ piirkonnas Terra tee (lisa nr 9); 2) Hiie AÜ ja Masinaehitaja AÜ juurdepääsuteele nimeks Hiie tee (lisa nr 10.1 ja 10.2); 3) Lennuk 1 AÜ ja Lennuki 2 AÜ piirkonnas Lennuki tee, Kopteri tee ja Tiiva tee (lisa nr 11); 4) Osoon AÜ piirkonnas Osooni tee, Vesiniku tee, Hapniku tee, Oksiidi tee ja Süsiniku tee (lisa nr 12); 5) Vääna AÜ piirkonnas Lingu tee (lisa nr 13); 6) Harju AÜ piirkonnas Harju tee ja Põrnika tee (lis",
      "estleg:legalText": "Määrata Vääna-Jõesuu külas seni nimetutele teedele nimed järgmiselt: 1) Terra AÜ piirkonnas Terra tee (lisa nr 9); 2) Hiie AÜ ja Masinaehitaja AÜ juurdepääsuteele nimeks Hiie tee (lisa nr 10.1 ja 10.2); 3) Lennuk 1 AÜ ja Lennuki 2 AÜ piirkonnas Lennuki tee, Kopteri tee ja Tiiva tee (lisa nr 11); 4) Osoon AÜ piirkonnas Osooni tee, Vesiniku tee, Hapniku tee, Oksiidi tee ja Süsiniku tee (lisa nr 12); 5) Vääna AÜ piirkonnas Lingu tee (lisa nr 13); 6) Harju AÜ piirkonnas Harju tee ja Põrnika tee (lisa nr 14); 7) Endise Maral AÜ piirkonnas Marali tee (lisa nr 15); 8) Inturist AÜ ja Lepatriinu AÜ piirkonnas Putuka tee, Inturisti tee, Lepatriinu tee ja Ritsika tee (lisa nr 16); 9) Tropsi AÜ ja Lahe AÜ piirkonnas Tropsi tee ja Lahe tee (lisa nr 17); 10) Liivaku AÜ ja Laadrevälja AÜ piirkonnas Liivaku tee, Laadrevälja tee ja Raiesmiku tee (lisa nr 18); 11) Ranniku AÜ ja Varia SÜ piirkonnas Aoranniku tee ja Varia tee (lisa nr 19).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_harku_vallavalitsus"
      },
