      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata Liikva külas seni nimetutele teedele nimed järgmiselt: 1) Mardi AÜ piirk...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Teenimede määramine Liikva külas, Viti külas ja Vääna-Jõesuu külas",
      "estleg:summary": {
        "@value": "Määrata Liikva külas seni nimetutele teedele nimed järgmiselt: 1) Mardi AÜ piirkonnas Tarindi tee (lisa nr 1); 2) Mini-Inturist AÜ ja Jakor AÜ piirkonnas Matka tee ja Ankru tee (lisa nr 2).",
        "@language": "et"
      },
      "estleg:legalText": "Määrata Liikva külas seni nimetutele teedele nimed järgmiselt: 1) Mardi AÜ piirkonnas Tarindi tee (lisa nr 1); 2) Mini-Inturist AÜ ja Jakor AÜ piirkonnas Matka tee ja Ankru tee (lisa nr 2).",
