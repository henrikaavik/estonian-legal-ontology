    },
    {
      "@id": "estleg:Reg_1009755_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1009755",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. [Määrata Viti külas seni nimetutele teedele nimed järgmiselt: 1) Martini AÜ piirk...]",
      "estleg:sourceAct": "Teenimede määramine Liikva külas, Viti külas ja Vääna-Jõesuu külas",
      "estleg:summary": "Määrata Viti külas seni nimetutele teedele nimed järgmiselt: 1) Martini AÜ piirkonnas Merihundi tee (lisa nr 3); 2) Arno AÜ piirkonnas Kevade tee ja Sügise tee (lisa nr 4); 3) Ajaloolise Sauevälja talu ja Sulev AÜ piirkonnas Sauevälja tee ja Sule tee (lisa nr 5); 4) Jüri AÜ piirkonnas Säde tee ja Loite tee (lisa nr 6); 5) Mini AÜ piirkonnas Mini tee ja Maksi tee (lisa nr 7); 6) Lembitu AÜ piirkonnas Räitsaka tee, Helbe tee, Lume tee ja Jää tee (lisa nr 8).",
      "estleg:legalText": "Määrata Viti külas seni nimetutele teedele nimed järgmiselt: 1) Martini AÜ piirkonnas Merihundi tee (lisa nr 3); 2) Arno AÜ piirkonnas Kevade tee ja Sügise tee (lisa nr 4); 3) Ajaloolise Sauevälja talu ja Sulev AÜ piirkonnas Sauevälja tee ja Sule tee (lisa nr 5); 4) Jüri AÜ piirkonnas Säde tee ja Loite tee (lisa nr 6); 5) Mini AÜ piirkonnas Mini tee ja Maksi tee (lisa nr 7); 6) Lembitu AÜ piirkonnas Räitsaka tee, Helbe tee, Lume tee ja Jää tee (lisa nr 8).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_harku_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0198"
