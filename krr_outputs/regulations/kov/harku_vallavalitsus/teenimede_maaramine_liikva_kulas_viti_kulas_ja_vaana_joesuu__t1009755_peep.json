      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. [Määrata Liikva külas seni nimetutele teedele nimed järgmiselt: 1) Mardi AÜ piirk...]",
      "estleg:sourceAct": "Teenimede määramine Liikva külas, Viti külas ja Vääna-Jõesuu külas",
      "estleg:summary": "Määrata Liikva külas seni nimetutele teedele nimed järgmiselt: 1) Mardi AÜ piirkonnas Tarindi tee (lisa nr 1); 2) Mini-Inturist AÜ ja Jakor AÜ piirkonnas Matka tee ja Ankru tee (lisa nr 2).",
      "estleg:legalText": "Määrata Liikva külas seni nimetutele teedele nimed järgmiselt: 1) Mardi AÜ piirkonnas Tarindi tee (lisa nr 1); 2) Mini-Inturist AÜ ja Jakor AÜ piirkonnas Matka tee ja Ankru tee (lisa nr 2).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_harku_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0198"
