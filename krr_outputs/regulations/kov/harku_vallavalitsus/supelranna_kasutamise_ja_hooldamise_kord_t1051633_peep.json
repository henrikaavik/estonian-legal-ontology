    {
      "@id": "estleg:Reg_1051633_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Supelranna kasutamise nõuded",
        "@language": "et"
      },
      "estleg:sourceAct": "Supelranna kasutamise ja hooldamise kord",
      "estleg:summary": {
        "@value": "Supelrannas on keelatud: 1 1) müüa jooke klaastaaras või kasutada mistahes viisil klaastaarat; 2 2) kasutada pesemisvahendeid; 3 3) pesta pesu, lemmikloomi, liiklusvahendeid; 4 4) telkida või teha lõket selleks mitte ettenähtud kohas; 5 5) jätta endast maha jäätmeid; 6 6) ujuda joobeseisundis (olles tarvitanud alkoholi, narkootikume või muid psühhotoksilisi aineid); 7 7) suplushooajal sõita veesõidukiga tähistatud supluskoha välispiirile lähemal kui 25 meetrit ning siseneda tähistatud…",
        "@language": "et"
      },
      "estleg:legalText": "Supelrannas on keelatud: 1 1) müüa jooke klaastaaras või kasutada mistahes viisil klaastaarat; 2 2) kasutada pesemisvahendeid; 3 3) pesta pesu, lemmikloomi, liiklusvahendeid; 4 4) telkida või teha lõket selleks mitte ettenähtud kohas; 5 5) jätta endast maha jäätmeid; 6 6) ujuda joobeseisundis (olles tarvitanud alkoholi, narkootikume või muid psühhotoksilisi aineid); 7 7) suplushooajal sõita veesõidukiga tähistatud supluskoha välispiirile lähemal kui 25 meetrit ning siseneda tähistatud supluskohta mistahes liiki veesõidukiga, välja arvatud järelevalveks ja päästetöödeks kasutatava veesõidukiga nende kasutamisel tööülesannete täitmiseks; 8 8) liigelda ja parkida mootorsõidukiga supluskohas, välja arvatud pääste- ja hooldustöödeks; 9 9) suplushooajal 10.00-20.00 loomaga viibida, sealhulgas ujutada ja pesta looma; 10 10) igasugune majandustegevus ilma vallavalitsuse kooskõlastuseta; 11 11) tegevus, millega seatakse ohtu enda või teiste supluskohta kasutavate isikute elu ja tervis või häiritakse teisi kodanikke.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_harku_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0198"
