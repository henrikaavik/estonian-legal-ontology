      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Ess-soo maastikukaitseala kaitse alla võtmine ja kaitse-eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Ess-soo maastikukaitseala kohaliku omavalitsuse tasandil kaitse alla võtmine ja Ess-soo maastikukaitseala kaitse-eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Määrusega võetakse kohaliku kaitse alla Ess-Soo maastikukaitseala (edaspidi kaitseala). 2 (2) Kaitseala kaitse-eesmärk on: 1 1) piirkonnas ainulaadsete sookoosluste säilitamine, kaitsealuste liikide kaitse tagamine, kaitseala väärtuse säilitamine ja loodushariduse andmise võimaldamine (Lisa 1); 2 2) kohalike elanike jaoks traditsioonilise marjakorjeala säilitamine (Lisa 2).",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega võetakse kohaliku kaitse alla Ess-Soo maastikukaitseala (edaspidi kaitseala). 2 (2) Kaitseala kaitse-eesmärk on: 1 1) piirkonnas ainulaadsete sookoosluste säilitamine, kaitsealuste liikide kaitse tagamine, kaitseala väärtuse säilitamine ja loodushariduse andmise võimaldamine (Lisa 1); 2 2) kohalike elanike jaoks traditsioonilise marjakorjeala säilitamine (Lisa 2).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_urvaste_vallavolikogu"
