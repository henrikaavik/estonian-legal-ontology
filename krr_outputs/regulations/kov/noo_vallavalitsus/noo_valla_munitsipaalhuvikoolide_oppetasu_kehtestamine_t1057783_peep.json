      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Õppetasu kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Nõo valla munitsipaalhuvikoolide õppetasu kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Huvikooli õppetasu ühe lapse kohta on 6,2 % eelneval kalendriaastal kehtinud Vabariigi Valitsuse poolt kehtestatud töötasu alammäärast ehk 54 eurot ja 90 senti kuus, olenemata sellest, mitme eriala õppekava alusel laps ühes huvikoolis õpib. RT IV 2025-11-14 3 414112025003 2026-01-01 6 2 (2) Kehtestada Nõo Muusikakooli vabaklassi tunnitasu alljärgnevalt: 1 1) lastele ja õppivatele noortele kuni 19. eluaastani (k.a) 20 eurot tund; 2 2) täiskasvanutele 25 eurot tund.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Huvikooli õppetasu ühe lapse kohta on 6,2 % eelneval kalendriaastal kehtinud Vabariigi Valitsuse poolt kehtestatud töötasu alammäärast ehk 54 eurot ja 90 senti kuus, olenemata sellest, mitme eriala õppekava alusel laps ühes huvikoolis õpib. RT IV 2025-11-14 3 414112025003 2026-01-01 6 2 (2) Kehtestada Nõo Muusikakooli vabaklassi tunnitasu alljärgnevalt: 1 1) lastele ja õppivatele noortele kuni 19. eluaastani (k.a) 20 eurot tund; 2 2) täiskasvanutele 25 eurot tund. 3 (3) Õppetasu ei maksta juuni-, juuli- ja augustikuu eest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_noo_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0528"
