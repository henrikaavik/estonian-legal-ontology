      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Valimisjaoskondade arv ja hääletamisruumide asukohad",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "Nõo vallas moodustatakse 3 valimisjaoskonda, mille asukohad on:11) valimisjaoskond nr 1 – Nõo vallamajas, aadressil Voika tn 23, Nõo alevik, Nõo vald, Tartu maakond;22) valimisjaoskond nr 2 –Tartu Observatooriumi Külastuskeskuses, aadressil Observatooriumi tn 1, Tõravere alevik, Nõo vald, Tartu maakond;33) valimisjaoskond nr 3 – Nõo raamatukogu harukogus Lukel, aadressil Vanajärve tn 2, Luke küla, Nõo vald, Tartu maakond.2023-01-10RT IV2023-01-14144140120230142023-01-171",
        "@language": "et"
      },
      "estleg:legalText": "Nõo vallas moodustatakse 3 valimisjaoskonda, mille asukohad on:11) valimisjaoskond nr 1 – Nõo vallamajas, aadressil Voika tn 23, Nõo alevik, Nõo vald, Tartu maakond;22) valimisjaoskond nr 2 –Tartu Observatooriumi Külastuskeskuses, aadressil Observatooriumi tn 1, Tõravere alevik, Nõo vald, Tartu maakond;33) valimisjaoskond nr 3 – Nõo raamatukogu harukogus Lukel, aadressil Vanajärve tn 2, Luke küla, Nõo vald, Tartu maakond.2023-01-10RT IV2023-01-14144140120230142023-01-171",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_noo_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0528"
