    {
      "@id": "estleg:Reg_1052471_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Valimisjaoskondade töötamise aeg",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "Valimisjaoskondade töötamise aeg määratakse alljärgnevalt:11) valimisjaoskond nr 1 on avatud kõigil eelhääletamise päevadel enne valimispäeva ja valimispäeval;22) valimisjaoskond nr 2 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval;33) valimisjaoskond nr 3 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval.",
        "@language": "et"
      },
      "estleg:legalText": "Valimisjaoskondade töötamise aeg määratakse alljärgnevalt:11) valimisjaoskond nr 1 on avatud kõigil eelhääletamise päevadel enne valimispäeva ja valimispäeval;22) valimisjaoskond nr 2 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval;33) valimisjaoskond nr 3 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval.",
