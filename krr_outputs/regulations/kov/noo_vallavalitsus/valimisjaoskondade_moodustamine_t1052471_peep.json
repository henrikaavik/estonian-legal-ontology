    {
      "@id": "estleg:Reg_1052471_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Nõo vallas moodustatakse 3 valimisjaoskonda, mille asukohad on: 1) valimisjaoskond nr 1 – Nõo vallamajas, aadressil Voika tn 23, Nõo alevik, Nõo vald, Tartu maakond; 2) valimisjaoskond nr 2 –Tartu Observatooriumi Külastuskeskuses, aadressil Observatooriumi tn 1, Tõravere alevik, Nõo vald, Tartu maakond; 3) valimisjaoskond nr 3 – Nõo raamatukogu harukogus Lukel, aadressil Vanajärve tn 2, Luke küla, Nõo vald, Tartu maakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052471_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
