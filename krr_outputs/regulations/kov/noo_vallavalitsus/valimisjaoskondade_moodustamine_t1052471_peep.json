    {
      "@id": "estleg:Reg_1052471_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1052471",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Valimisjaoskondade töötamise aeg",
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": "Valimisjaoskondade töötamise aeg määratakse alljärgnevalt:11) valimisjaoskond nr 1 on avatud kõigil eelhääletamise päevadel enne valimispäeva ja valimispäeval;22) valimisjaoskond nr 2 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval;33) valimisjaoskond nr 3 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval. Valimisjaoskondade töötamise aeg määratakse alljärgnevalt: valimisjaoskond nr 1 on avatud kõigil eelhääletamise päevadel enne valimispäeva ja valimi",
      "estleg:legalText": "Valimisjaoskondade töötamise aeg määratakse alljärgnevalt:11) valimisjaoskond nr 1 on avatud kõigil eelhääletamise päevadel enne valimispäeva ja valimispäeval;22) valimisjaoskond nr 2 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval;33) valimisjaoskond nr 3 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval. Valimisjaoskondade töötamise aeg määratakse alljärgnevalt: valimisjaoskond nr 1 on avatud kõigil eelhääletamise päevadel enne valimispäeva ja valimispäeval; valimisjaoskond nr 2 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval; valimisjaoskond nr 3 on avatud teisel ja esimesel päeval enne valimispäeva ja valimispäeval.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_noo_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
