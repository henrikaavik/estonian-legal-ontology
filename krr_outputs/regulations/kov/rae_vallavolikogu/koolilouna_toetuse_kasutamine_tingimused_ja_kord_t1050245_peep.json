        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Rae valla üldhariduskoolides.",
      "estleg:parentProvision": {
