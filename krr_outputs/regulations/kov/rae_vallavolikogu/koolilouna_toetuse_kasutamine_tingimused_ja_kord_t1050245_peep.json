      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamine tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Rae valla üldhariduskoolides.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse riigieelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Rae valla üldhariduskoolides.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rae_vallavolikogu"
      },
