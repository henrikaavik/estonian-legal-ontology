      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Teenistuslähetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Rae Vallavolikogu ja Rae Vallavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "Teenistuslähetus (edaspidi lähetus) on volikogu esimehe, volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Lähetust välisriiki loetakse välislähetuseks.",
        "@language": "et"
      },
      "estleg:legalText": "Teenistuslähetus (edaspidi lähetus) on volikogu esimehe, volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Lähetust välisriiki loetakse välislähetuseks.",
