    {
      "@id": "estleg:Reg_1058918_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Teenistuslähetus (edaspidi lähetus) on volikogu esimehe, volikogu liikme, vallavalitsuse liikme või vallavanema saatmine kindlaksmääratud ajavahemikuks täitma teenistusülesannet või osalema koolitusel väljaspool alalise teenistuskoha asukohta. Lähetust välisriiki loetakse välislähetuseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1058918_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Lähetusse saatmine ja vormistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Rae Vallavolikogu ja Rae Vallavalitsuse liikmete teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lähetuse vormistamise aluseks on lähetustaotlus (edaspidi taotlus), kuhu märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht ja asutus või üritus, millega seoses taotlus esitatakse ning avansi maksmise vajadus. Kutse või muu alusmaterjali olemasolul lisatakse see taotlusele. Isikliku sõiduautoga lähetusse mineku soovi korral lisatakse taotlusele sõiduauto kasutamise õigust tõendava dokumendi koopia või omaniku koostatud volikiri.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lähetuse vormistamise aluseks on lähetustaotlus (edaspidi taotlus), kuhu märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht ja asutus või üritus, millega seoses taotlus esitatakse ning avansi maksmise vajadus. Kutse või muu alusmaterjali olemasolul lisatakse see taotlusele. Isikliku sõiduautoga lähetusse mineku soovi korral lisatakse taotlusele sõiduauto kasutamise õigust tõendava dokumendi koopia või omaniku koostatud volikiri. 2 (2) Volikogu liikme ja vallavanema lähetus vormistatakse volikogu esimehe käskkirjaga. 3 (3) Volikogu esimehe käskkirja volikogu esimehe lähetusse saatmise kohta allkirjastab volikogu aseesimees. 4 (4) Vallavalitsuse liikme lähetus vormistatakse vallavanema käskkirjaga. 5 (5) Lähetuse käskkirjas märgitakse lähetatava nimi, ametikoht, lähetuse aeg, sihtkoht, lähetuse eesmärk, lähetuskulude hüvitamine ning isikliku sõiduauto lähetusse minekuks kasutamise korral vastav info. Välislähetuse korral märgitakse käskkirjas lisaks päevaraha määr. 6 (6) Lähetuse käskkirja valmistab ette ning käskkirja ja alusdokumendid säilitab vallakantselei.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rae_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0653"
