        {
          "@id": "estleg:Reg_1058918_Par_4_Lg_7"
        },
        {
          "@id": "estleg:Reg_1058918_Par_4_Lg_8"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Hüvitatakse lähetusega seotud dokumentaalselt tõendatud sõidu- ja majutuskulud ning muud lähetusülesande täitmisega seotud kulud. Välislähetusel viibimise aja eest makstakse päevaraha Vabariigi Valitsuse määrusega kehtestatud ametniku teenistuslähetusse saatmise ja lähetuskulude hüvitamise ning päevaraha maksmise tingimustel ja korras. Riigisisese lähetuse korral päevaraha ei maksta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lähetatul on õigus nõuda lähetuskulude katteks avanssi lähetuskulude eeldatavas suuruses mõistliku aja jooksul enne lähetuse algust. Avansi mittesaamise korral võib lähetatav lähetusest keelduda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lähetusega seotud isikliku sõiduauto kasutamise kulud hüvitatakse vastavalt Rae Vallavalitsuse raamatupidamise sise-eeskirjas sätestatule.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Lähetuskulude, kui need tekkisid, hüvitamiseks esitab lähetatu viie tööpäeva jooksul pärast lähetusest saabumist lähetuskulude aruande.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Volikogu liikme ja vallavanema lähetuskulud ja aruande kinnitab volikogu esimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 5"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Volikogu esimehe lähetuskulud ja aruande kinnitab volikogu aseesimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 6"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Vallavalitsuse liikme lähetuskulud ja aruande kinnitab vallavanem.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 7"
    },
    {
      "@id": "estleg:Reg_1058918_Par_4_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Lähetuskulude hüvitise summa kantakse lähetatu arvelduskontole viie tööpäeva jooksul pärast aruande kinnitamist ja esitamist raamatupidamisele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058918_Par_4"
      },
      "rdfs:label": "§ 4 lg 8"
    },
