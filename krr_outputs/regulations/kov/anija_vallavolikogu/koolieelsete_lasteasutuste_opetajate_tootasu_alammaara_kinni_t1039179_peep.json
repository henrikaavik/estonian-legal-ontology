      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Koolieelsete lasteasutuste õpetajate töötasu alammäära kinnitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolieelsete lasteasutuste õpetajate töötasu alammäära kinnitamine",
      "estleg:summary": {
        "@value": "Kinnitada Anija valla koolieelsete lasteasutuste õpetajate töötasu alammäärad järgmiselt:11) 2017. aasta 1. septembrist vähemalt 840 eurot;22) 2018. aasta 1. jaanuarist vähemalt 85% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal;33) 2019. aasta 1. jaanuarist vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
        "@language": "et"
      },
      "estleg:legalText": "Kinnitada Anija valla koolieelsete lasteasutuste õpetajate töötasu alammäärad järgmiselt:11) 2017. aasta 1. septembrist vähemalt 840 eurot;22) 2018. aasta 1. jaanuarist vähemalt 85% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal;33) 2019. aasta 1. jaanuarist vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_anija_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0141"
      },
