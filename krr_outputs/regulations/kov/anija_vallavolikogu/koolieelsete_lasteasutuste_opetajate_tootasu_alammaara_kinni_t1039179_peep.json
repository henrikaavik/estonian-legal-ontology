        }
      ]
    },
    {
      "@id": "estleg:Reg_1039179_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kinnitada Anija valla koolieelsete lasteasutuste õpetajate töötasu alammäärad järgmiselt: 1) 2017. aasta 1. septembrist vähemalt 840 eurot; 2) 2018. aasta 1. jaanuarist vähemalt 85% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal; 3) 2019. aasta 1. jaanuarist vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
