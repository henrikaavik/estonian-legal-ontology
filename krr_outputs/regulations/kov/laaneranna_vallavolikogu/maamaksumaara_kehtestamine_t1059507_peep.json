      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Lääneranna vallas järgmised maamaksumäärad: 1 1) elamumaa ja maatulundusmaa õuemaa kõlvikule 1 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi lõikes 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi lõigetes 1 ja 2 nimetamata sihtotstarbega maale 2 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Lääneranna vallas järgmised maamaksumäärad: 1 1) elamumaa ja maatulundusmaa õuemaa kõlvikule 1 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi lõikes 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi lõigetes 1 ja 2 nimetamata sihtotstarbega maale 2 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laaneranna_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0430"
