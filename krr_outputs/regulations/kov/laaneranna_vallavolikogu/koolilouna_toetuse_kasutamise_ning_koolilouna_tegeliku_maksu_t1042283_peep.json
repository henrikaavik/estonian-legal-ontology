      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise ning koolilõuna tegeliku maksumuse kandmise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Lääneranna vallale riigieelarvest ja Lääneranna valla eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja koolilõuna tegeliku maksumuse kandmise kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Lääneranna vallale riigieelarvest ja Lääneranna valla eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja koolilõuna tegeliku maksumuse kandmise kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laaneranna_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0430"
