    {
      "@id": "estleg:Reg_1042283_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Lääneranna vallale riigieelarvest ja Lääneranna valla eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja koolilõuna tegeliku maksumuse kandmise kord.",
      "estleg:parentProvision": {
