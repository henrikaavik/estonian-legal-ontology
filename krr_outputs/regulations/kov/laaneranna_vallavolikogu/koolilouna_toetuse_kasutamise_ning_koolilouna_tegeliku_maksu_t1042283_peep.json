    },
    {
      "@id": "estleg:Reg_1042283_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud vahendite kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise ning koolilõuna tegeliku maksumuse kandmise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Lääneranna valla koolides põhi- ning üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Lääneranna valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavatele õpilastele kaetakse Lääneranna valla eelarvest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Lääneranna valla koolides põhi- ning üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2 (2) Riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kõikidele Lääneranna valla munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavatele õpilastele kaetakse Lääneranna valla eelarvest. 3 (3) Distantsõppe ajal toimub õpilaste toitlustamine vanemate sooviavalduste alusel hiljemalt distantsõppe perioodi 6-ndast õppepäevas. 4 (4) Listantsõppe ajal otsustab iga kool koostöös valla lastekaitsespetsialisti ja sotsiaalpedagoogiga: 1 1) kuidas õpilasi toitlustada (kas koolilõuna või toidupakk); 2 2) kuidas korraldada koolilõuna või toidupaki kättesaamine. RT IV2020-12-15104151220200102020-12-18, rakendatakse alates 14.12.2020",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laaneranna_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0430"
      },
