      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohtuvälise menetleja pädevust tõendav tunnistus",
        "@language": "et"
      },
      "estleg:sourceAct": "Volituste andmine väärteomenetluses osalemiseks",
      "estleg:summary": {
        "@value": "1(1)Kinnitada väärteomenetluses osaleva ametniku pädevustunnistuse vorm vastavalt lisale 1. 2(2)Kohtuvälise menetleja pädevust tõendavaid tunnistusi väljastab ja nende üle peab arvestust vallasekretär.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kinnitada väärteomenetluses osaleva ametniku pädevustunnistuse vorm vastavalt lisale 1. 2(2)Kohtuvälise menetleja pädevust tõendavaid tunnistusi väljastab ja nende üle peab arvestust vallasekretär.",
