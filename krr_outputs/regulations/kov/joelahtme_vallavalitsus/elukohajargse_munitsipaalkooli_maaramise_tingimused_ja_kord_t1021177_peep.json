      }
    },
    {
      "@id": "estleg:Reg_1021177_Par_1_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kui munitsipaalkoolis on peale elukohajärgsete õppekohtade täitmist vabu kohti, siis õpilaste vastuvõtmisel, kelle elukohajärgseks kooliks on teine Jõelähtme valla kool, lähtutakse alljärgnevatest eelistustest: 1) sama pere teiste laste õppimine samas koolis; 2) õpilase elukoha lähedus koolile; 3) õpilase seadusliku esindaja soov.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1021177_Par_1"
      },
      "rdfs:label": "§ 1 lg 4",
      "estleg:itemNumber": [
