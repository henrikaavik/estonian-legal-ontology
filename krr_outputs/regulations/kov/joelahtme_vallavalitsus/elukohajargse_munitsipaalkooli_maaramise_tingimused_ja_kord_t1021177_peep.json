    {
      "@id": "estleg:Reg_1021177_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kinnitada rahvastikuregistri andmetel Jõelähtme vallas elavate gümnaasiumi õpilaste elukohajärgseks kooliks Loo Keskkool.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1021177_Par_1"
      },
      "rdfs:label": "§ 1 lg 3",
      "estleg:targetGroup": [
