      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Valimisjaoskondade numeratsioon ja hääletamisruumide asukohad",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)V alimisjaoskond nr 1 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Loo Keskkoolis (Saha tee 7, Loo alevik, Jõelähtme vald, Harju maakond). 2(2)Valimisjaoskond nr 2 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Kostivere Kultuurimõisas (Mõisa tee 2, Kostivere alevik, Jõelähtme vald, Harju maakond).",
        "@language": "et"
      },
      "estleg:legalText": "1(1)V alimisjaoskond nr 1 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Loo Keskkoolis (Saha tee 7, Loo alevik, Jõelähtme vald, Harju maakond). 2(2)Valimisjaoskond nr 2 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Kostivere Kultuurimõisas (Mõisa tee 2, Kostivere alevik, Jõelähtme vald, Harju maakond).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavalitsus"
      },
