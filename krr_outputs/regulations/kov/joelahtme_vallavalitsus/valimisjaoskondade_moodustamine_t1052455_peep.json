    {
      "@id": "estleg:Reg_1052455_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)Kohaliku omavalitsuse volikogu valimistel, Riigikogu valimistel, Euroopa Parlamendi valimistel ja rahvahääletusel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. 2(2)Kodus hääletamist ning vajadusel ka asukohas ja ööpäevases hoolekandeasutuses hääletamist korraldab valimisjaoskond nr 2.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kohaliku omavalitsuse volikogu valimistel, Riigikogu valimistel, Euroopa Parlamendi valimistel ja rahvahääletusel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. 2(2)Kodus hääletamist ning vajadusel ka asukohas ja ööpäevases hoolekandeasutuses hääletamist korraldab valimisjaoskond nr 2.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
