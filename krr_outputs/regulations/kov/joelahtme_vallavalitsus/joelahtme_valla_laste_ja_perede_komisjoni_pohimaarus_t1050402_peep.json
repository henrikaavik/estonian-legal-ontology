    {
      "@id": "estleg:Reg_1050402_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjonil on õigus: 1) kaasata komisjoni töösse spetsialiste väljastpoolt komisjoni; 2) saada komisjoni tööks vajalikku teavet teistelt isikutelt ja asutustelt; 3) kutsuda komisjoni koosolekule laps ja tema seaduslik esindaja ning teisi võrgustiku liikmeid; 4) teha ettepanekuid ja anda soovitusi käesoleva põhimääruse paragrahvis 2 sätestatud ülesannete täitmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1050402_Par_3"
      },
