    {
      "@id": "estleg:Reg_1050402_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Komisjoni õigused",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõelähtme valla laste ja perede komisjoni põhimäärus",
      "estleg:summary": {
        "@value": "Komisjonil on õigus:11) kaasata komisjoni töösse spetsialiste väljastpoolt komisjoni;22) saada komisjoni tööks vajalikku teavet teistelt isikutelt ja asutustelt;33) kutsuda komisjoni koosolekule laps ja tema seaduslik esindaja ning teisi võrgustiku liikmeid;44) teha ettepanekuid ja anda soovitusi käesoleva põhimääruse paragrahvis 2 sätestatud ülesannete täitmiseks.",
        "@language": "et"
      },
      "estleg:legalText": "Komisjonil on õigus:11) kaasata komisjoni töösse spetsialiste väljastpoolt komisjoni;22) saada komisjoni tööks vajalikku teavet teistelt isikutelt ja asutustelt;33) kutsuda komisjoni koosolekule laps ja tema seaduslik esindaja ning teisi võrgustiku liikmeid;44) teha ettepanekuid ja anda soovitusi käesoleva põhimääruse paragrahvis 2 sätestatud ülesannete täitmiseks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_joelahtme_vallavalitsus"
      },
