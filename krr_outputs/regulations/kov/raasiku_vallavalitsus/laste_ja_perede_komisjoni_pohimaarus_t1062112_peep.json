    {
      "@id": "estleg:Reg_1062112_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Komisjoni töökord",
        "@language": "et"
      },
      "estleg:sourceAct": "Laste ja perede komisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Komisoni töökord on koosolek. Koosolekud on kinnised, kui komisjon ei otsusta teisiti. 2 (2) Komisjoni tööd juhib komisjoni esimees, tema äraolekul aseesimees. 3 (3) Komisjoni koosoleku toimumisest ning päevakorrast teatatakse asjaosalistele ette vähemalt viis tööpäeva. 4 (4) Komisjoni tegevust korraldab komisjoni esimees, kes: 1 1) valmistab ette ja kutsub kokku komisjoni koosoleku; 2 2) teostab kontrolli komisjoni otsuste täitmise üle.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisoni töökord on koosolek. Koosolekud on kinnised, kui komisjon ei otsusta teisiti. 2 (2) Komisjoni tööd juhib komisjoni esimees, tema äraolekul aseesimees. 3 (3) Komisjoni koosoleku toimumisest ning päevakorrast teatatakse asjaosalistele ette vähemalt viis tööpäeva. 4 (4) Komisjoni tegevust korraldab komisjoni esimees, kes: 1 1) valmistab ette ja kutsub kokku komisjoni koosoleku; 2 2) teostab kontrolli komisjoni otsuste täitmise üle. 5 (5) Komisjoni koosolekud toimuvad vastavalt vajadusele, kuid mitte harvem kui kaks korda aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_raasiku_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0651"
