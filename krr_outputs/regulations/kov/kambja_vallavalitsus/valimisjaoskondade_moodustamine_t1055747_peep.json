    },
    {
      "@id": "estleg:Reg_1055747_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. Valimisjaoskond nr 2 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 2 hääletamist ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad valimisjaoskond nr 1, valimisjaoskond nr 2 ja valimisjaoskond nr 4.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 2. Valimisjaoskond nr 2 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 2 hääletamist ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad valimisjaoskond nr 1, valimisjaoskond nr 2 ja valimisjaoskond nr 4.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kambja_vallavalitsus"
      },
