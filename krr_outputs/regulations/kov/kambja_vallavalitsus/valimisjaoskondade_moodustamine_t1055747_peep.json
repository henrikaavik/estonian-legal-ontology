      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1055747_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Valimisjaoskond nr 2 hääletamisruum asub kõigil eelhääletamise päevadel ja valimispäeval Tõrvandi Raamatukogus (Ringtee tn 1, Tõrvandi alevik, Kambja vald, Tartu maakond).",
      "estleg:parentProvision": {
