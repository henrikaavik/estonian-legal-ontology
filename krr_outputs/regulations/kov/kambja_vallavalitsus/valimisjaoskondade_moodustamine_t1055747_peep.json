      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1055747_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Valimisjaoskond nr 3 hääletamisruum asub teisel ja esimesel päeval enne valimispäeva ja valimispäeval Külitse Coop Konsumis (Kiigemäe tee 2, Külitse alevik, Kambja vald, Tartu maakond).",
