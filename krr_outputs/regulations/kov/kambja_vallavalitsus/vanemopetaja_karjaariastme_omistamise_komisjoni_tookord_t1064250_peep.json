    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Komisjon juhindub hindamisel „Üldhariduse õpetajate karjäärimudeli juhendmaterjalist“ ja selle lisadest 1 ja 2 ning vanemõpetaja tase 7 kutsestandardist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:targetGroup": [
        {
