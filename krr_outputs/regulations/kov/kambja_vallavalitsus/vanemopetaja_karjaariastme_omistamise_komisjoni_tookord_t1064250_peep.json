      }
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Vanemõpetaja karjääriastme taotlemisel hinnatakse nelja kohustuslikku kompetentsi: 1) enesehoiu ja professionaalsuse tagamist; 2) õppijate toetamist; 3) enda organisatsiooni ja selle inimestesse panustamist; 4) panustamist laiemas hariduse ökosüsteemis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 5",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Vanemõpetaja karjääriastme taotlemiseks esitatavad dokumendid: 1) avaldus karjääriastme taotlemiseks; 2) haridust tõendavad dokumendid; 3) enesetäiendust tõendavate dokumentide koopiad ja/või väljavõtted asjakohastest andmekogudest; 4) kohustuslike kompetentside jaotusega töö analüüs ehk portfoolio, mis sisaldab kutsestandardis kirjeldatud kompetentsidele tuginevat kutsealase tegevuse eneseanalüüsi ja kõikide tegevusnäitajate kohta tõendusmaterjale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 6",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Komisjon on otsustusvõimeline, kui astme omistamiseks läbiviidud tegevustest võtavad osa kõik komisjoni liikmed.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 7",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Otsus vormistatakse eraldi iga taotleja kohta kirjalikult 2 nädala jooksul pärast vestluse läbiviimist ning komisjon edastab selle taotlejale ja taotleja kooli direktorile10 tööpäeva jooksul pärast otsuse tegemist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 8",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_9",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "9",
      "estleg:legalText": "(9) Komisjoni otsuse kinnitavad allkirjaga kõik komisjoni liikmed.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 9",
      "estleg:targetGroup": [
