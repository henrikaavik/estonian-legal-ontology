      "estleg:summary": {
        "@value": "Komisjon:11) hindab vanemõpetaja astme taotleja töö analüüsi vastavalt kutsestandardile;22) viib läbi vestluse taotlejaga;33) teeb otsuse vanemõpetaja astme omistamise või mitteomistamise kohta;44) vormistab otsuse.",
        "@language": "et"
      },
      "estleg:legalText": "Komisjon:11) hindab vanemõpetaja astme taotleja töö analüüsi vastavalt kutsestandardile;22) viib läbi vestluse taotlejaga;33) teeb otsuse vanemõpetaja astme omistamise või mitteomistamise kohta;44) vormistab otsuse.",
      "estleg:hasSubsection": [
