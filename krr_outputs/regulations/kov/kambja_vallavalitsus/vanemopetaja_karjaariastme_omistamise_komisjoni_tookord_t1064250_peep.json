      }
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_10",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "10",
      "estleg:legalText": "(10) Komisjoni otsuseid säilitatakse kümme aastat.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 10"
    },
    {
      "@id": "estleg:Reg_1064250_Par_3_Lg_11",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "11",
      "estleg:legalText": "(11) Kui taotlusvoorus ühtegi taotlust ei esitata, ei ole komisjonil kohustust koguneda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1064250_Par_3"
      },
      "rdfs:label": "§ 3 lg 11"
