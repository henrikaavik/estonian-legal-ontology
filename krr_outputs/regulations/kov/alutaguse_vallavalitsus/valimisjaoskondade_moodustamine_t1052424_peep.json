          "@id": "estleg:Institution_kohalik_omavalitsus"
        },
        {
          "@id": "estleg:Institution_riigikogu"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1052424_Par_3_Lg_1"
