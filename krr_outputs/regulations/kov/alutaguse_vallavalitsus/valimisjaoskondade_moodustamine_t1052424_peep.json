    },
    {
      "@id": "estleg:Reg_1052424_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valimisjaoskonna nr 1 hääletamisruumid asuvad: 1) kõigil eelhääletamise päevadel ja valimispäeval Iisaku Kihelkonna Muuseumi hoones (Tartu mnt 49, Iisaku alevik, Alutaguse vald, Ida-Viru maakond); 2) esimesel päeval enne valimispäeva Tudulinna kogukonnamajas (Kooli tn 4, Tudulinna küla, Alutaguse vald, Ida-Viru maakond); 3) teisel päeval enne valimispäeva Alajõe raamatukogus (Valla tn 8, Alajõe küla, Alutaguse vald, Ida-Viru maakond).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052424_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
