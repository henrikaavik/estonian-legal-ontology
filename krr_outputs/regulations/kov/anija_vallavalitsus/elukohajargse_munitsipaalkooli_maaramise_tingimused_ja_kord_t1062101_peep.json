      "rdfs:label": {
        "@value": "§ 2. Õpilase kooli vastuvõtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Kooli võetakse isik vastu kooli vastuvõtu korra alusel. 2(2)Kool on kohustatud võtma õpilaseks kõik selleks soovi avaldavad õppimiskohustuslikud isikud, kellele see kool on elukohajärgne kool. 3(3)Isikule on kooli valik vaba, kui soovitud koolis on vabu õppekohti.",
        "@language": "et"
      },
