        "@language": "et"
      },
      "estleg:legalText": "Osalustasu määr ühe lapse kohta on 10% töötasu alammäärast kuus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vormsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
