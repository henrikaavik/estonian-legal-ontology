    {
      "@id": "estleg:Reg_1055948_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Osalustasu määr ühe lapse kohta on 10% töötasu alammäärast kuus.",
