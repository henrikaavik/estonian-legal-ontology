    {
      "@id": "estleg:Reg_1055948_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Soodustused",
        "@language": "et"
      },
      "estleg:sourceAct": "Vormsi valla lasteaia vanemate poolt kaetava osalustasu määr ja tasumise kord",
      "estleg:summary": {
        "@value": "1 (1) Kui lapse ja vähemalt ühe vanema või eestkostja Eesti Rahvastikuregistri järgne elukoht on Vormsi vallas, siis kehtivad alljärgnevad soodustused: 1 1) 3% töötasu alammäärast kuus kui lasteaias käib üks laps; 2 2) kui ühest perekonnast käib lasteaias 2 last, siis teise lapse eest makstakse 50% punktis 1 nimetatud summast; 3 3) kui ühest perekonnast käib lasteaias kolm või enam last, siis kolmas ja iga järgnev laps on kohatasust vabastatud.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui lapse ja vähemalt ühe vanema või eestkostja Eesti Rahvastikuregistri järgne elukoht on Vormsi vallas, siis kehtivad alljärgnevad soodustused: 1 1) 3% töötasu alammäärast kuus kui lasteaias käib üks laps; 2 2) kui ühest perekonnast käib lasteaias 2 last, siis teise lapse eest makstakse 50% punktis 1 nimetatud summast; 3 3) kui ühest perekonnast käib lasteaias kolm või enam last, siis kolmas ja iga järgnev laps on kohatasust vabastatud. 2 (2) Lõikes 1 nimetatud soodustuse saamiseks lapsevanem avaldust esitama ei pea. 3 (3) Soodustuse andmine lõpetatakse, kui lapse elukoht registreeritakse Eesti Rahvastikuregistris teise omavalitsusse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vormsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0907"
