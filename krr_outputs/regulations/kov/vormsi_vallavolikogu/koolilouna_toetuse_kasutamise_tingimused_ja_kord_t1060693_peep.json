      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Vormsi Lasteaed-Põhikoolile (edaspidi VLP) riigieelarvest Vormsi valla eelarvesse eraldatud koolilõuna toetuse (edaspidi toetus) kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Vormsi Lasteaed-Põhikoolile (edaspidi VLP) riigieelarvest Vormsi valla eelarvesse eraldatud koolilõuna toetuse (edaspidi toetus) kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vormsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0907"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060693_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1060693_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1060693_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Vormsi Lasteaed-Põhikoolile (edaspidi VLP) riigieelarvest Vormsi valla eelarvesse eraldatud koolilõuna toetuse (edaspidi toetus) kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060693_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1060693_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarves ettenähtud koolilõuna eraldisest kaetakse VLP õpilaste koolilõuna eraldisest kaetakse VLP õpilaste koolilõuna toiduainete soetamise kulud. 2 (2) Riigieelarves ettenähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Vormsi valla eelarvest. 3 (3) Koolilõuna maksumuse kehtestab Vormsi Vallavalitsus. 4 (4) VLP direktor reguleerib toitlustamise korda, tagab õpilastele koolilõuna ja vastutab toetuse sihipärase kasutamise eest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarves ettenähtud koolilõuna eraldisest kaetakse VLP õpilaste koolilõuna eraldisest kaetakse VLP õpilaste koolilõuna toiduainete soetamise kulud. 2 (2) Riigieelarves ettenähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Vormsi valla eelarvest. 3 (3) Koolilõuna maksumuse kehtestab Vormsi Vallavalitsus. 4 (4) VLP direktor reguleerib toitlustamise korda, tagab õpilastele koolilõuna ja vastutab toetuse sihipärase kasutamise eest. 5 (5) Kool peab arvestust toetust kasutavate õpilaste arvu ning toidupäevade kohta. 6 (6) Kui koolil puuduvad võimalused õpilaste toitlustamiseks, on koolil õigus rakendada teisi viise (nt toidupakid) koolilõuna toetuse kasutamiseks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vormsi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0907"
