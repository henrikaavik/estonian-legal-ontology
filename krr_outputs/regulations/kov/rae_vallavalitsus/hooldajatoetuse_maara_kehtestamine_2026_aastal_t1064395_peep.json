      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Hooldajatoetuste määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Hooldajatoetuse määra kehtestamine 2026. aastal",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064395_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Hooldajatoetust täiskasvanud puudega ning suure hooldus- ja abivajadusega isiku hooldajale makstakse järgmiselt: 1 1) raske puudega ning suure hooldus- ja abivajadusega isiku hooldajale - 40 eurot kuus; 2 2) sügava puudega isiku hooldajale - 60 eurot kuus. 2 (2) Hooldajatoetus puudega lapse hooldajale - 100 eurot kuus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Hooldajatoetust täiskasvanud puudega ning suure hooldus- ja abivajadusega isiku hooldajale makstakse järgmiselt: 1 1) raske puudega ning suure hooldus- ja abivajadusega isiku hooldajale - 40 eurot kuus; 2 2) sügava puudega isiku hooldajale - 60 eurot kuus. 2 (2) Hooldajatoetus puudega lapse hooldajale - 100 eurot kuus.",
