      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Käesolev määrus (edaspidi kord) reguleerib rahvastikuregistrisse kantud Rae valla elanikele väljaspool kodu osutatava üldhooldusteenuse (edaspidi üldhooldusteenus) raames hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude (edaspidi hoolduskulude)tasumise piirmäära suuruse kehtestamist.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev määrus (edaspidi kord) reguleerib rahvastikuregistrisse kantud Rae valla elanikele väljaspool kodu osutatava üldhooldusteenuse (edaspidi üldhooldusteenus) raames hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude (edaspidi hoolduskulude)tasumise piirmäära suuruse kehtestamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rae_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0653"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056814_Map"
      },
      "estleg:targetGroup": [
