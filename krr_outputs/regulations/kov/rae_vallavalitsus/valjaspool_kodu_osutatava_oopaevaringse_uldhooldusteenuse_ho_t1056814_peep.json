    },
    {
      "@id": "estleg:Reg_1056814_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev määrus (edaspidi kord) reguleerib rahvastikuregistrisse kantud Rae valla elanikele väljaspool kodu osutatava üldhooldusteenuse (edaspidi üldhooldusteenus) raames hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude (edaspidi hoolduskulude)tasumise piirmäära suuruse kehtestamist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1056814_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1056814_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse hoolduskulude tasumise piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Käesolevas määruses käsitatakse üldhooldusteenuse saaja elukohana Eesti rahvastikuregistrisse kantudelukoha aadressi. 2 (2) Väljaspool isiku kodu osutatav üldhooldusteenus on kohaliku omavalitsuse üksuse korraldatavsotsiaalteenus, mille eesmärk on turvalise keskkonna ja toimetuleku tagamine täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesolevas määruses käsitatakse üldhooldusteenuse saaja elukohana Eesti rahvastikuregistrisse kantudelukoha aadressi. 2 (2) Väljaspool isiku kodu osutatav üldhooldusteenus on kohaliku omavalitsuse üksuse korraldatavsotsiaalteenus, mille eesmärk on turvalise keskkonna ja toimetuleku tagamine täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla. 3 (3) Hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kuludeks on: 1 1) tööjõukulud; 2 2) tööriietuse ja isikukaitsevahendite kulud; 3 3) tervisekontrolli ja vaktsineerimise kulud; 4 4) koolituse ja supervisiooni kulud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rae_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0653"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056814_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Institution_kohalik_omavalitsus"
