    {
      "@id": "estleg:Reg_1060995_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Õppuri huvikoolist väljaarvamisest käesoleva paragrahvi lõike 2 punktide 2-4 alusel teatab direktor vanemale kirjalikult ühe nädala jooksul otsuse tegemisest arvates.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060995_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1060995_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Huvikoolist väljaarvamisel makstakse õppetasu täies mahus selle kuu eest, millal õppur välja arvati.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060995_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
    {
      "@id": "estleg:Reg_1060995_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Tasumata jäänud summa nõutakse sisse õigusaktides sätestatud korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1060995_Par_3"
      },
      "rdfs:label": "§ 3 lg 5"
    },
    {
