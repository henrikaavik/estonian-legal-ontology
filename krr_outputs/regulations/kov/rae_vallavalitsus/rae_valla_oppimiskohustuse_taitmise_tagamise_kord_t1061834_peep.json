      }
    },
    {
      "@id": "estleg:Reg_1061834_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Juhtumi algatamine kohalikus omavalitsuses väljalangemisohus oleva õpilase kohta",
        "@language": "et"
      },
      "estleg:sourceAct": "Rae valla õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "Rae vallas vastutab õppimiskohustuslike laste õppes osalemise igakuise seire eest noorte heaolu spetsialist, kes: 1 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) algatab Eesti Hariduse Infosüsteemis juhtumimenetluse ja teavitab kooli ning lapsevanemaid juhtumimenetluse alustamisest; 3 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete rakendamise osas kaasates…",
        "@language": "et"
      },
      "estleg:legalText": "Rae vallas vastutab õppimiskohustuslike laste õppes osalemise igakuise seire eest noorte heaolu spetsialist, kes: 1 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) algatab Eesti Hariduse Infosüsteemis juhtumimenetluse ja teavitab kooli ning lapsevanemaid juhtumimenetluse alustamisest; 3 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete rakendamise osas kaasates juhtumipõhiselt valdkonnaüleseid spetsialiste.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rae_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0653"
