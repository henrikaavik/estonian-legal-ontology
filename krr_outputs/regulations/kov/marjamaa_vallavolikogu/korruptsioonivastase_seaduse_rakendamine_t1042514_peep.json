    {
      "@id": "estleg:Reg_1042514_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Huvide deklareerimise kohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "1 (1) Deklaratsiooni on kohustatud esitama vallavolikogu liige, vallavalitsuse liige ja valla ametiasutuse juht. 2 (2) Isikut teavitatakse viivitamata deklaratsiooni esitamise kohustusest vastava kohustuse tekkimisel. Teavitamise tagab vallasekretär. 3 (3) Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni esitamise kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks huvide deklaratsiooni registrile.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Deklaratsiooni on kohustatud esitama vallavolikogu liige, vallavalitsuse liige ja valla ametiasutuse juht. 2 (2) Isikut teavitatakse viivitamata deklaratsiooni esitamise kohustusest vastava kohustuse tekkimisel. Teavitamise tagab vallasekretär. 3 (3) Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni esitamise kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks huvide deklaratsiooni registrile. Kalendriaasta jooksul ei pea deklarant esitama rohkem kui ühe deklaratsiooni ka juhul, kui ta asub uuele ametikohale. 4 (4) Deklaratsiooni esitamise kohustus lõpeb, kui deklarant on esitanud deklaratsiooni ametikohalt lahkumise aastale järgneval kalendriaastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_marjamaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0503"
