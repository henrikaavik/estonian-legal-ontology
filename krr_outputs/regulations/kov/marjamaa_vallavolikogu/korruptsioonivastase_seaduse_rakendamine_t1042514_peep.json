      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Määrus täpsustab korruptsiooni ennetamise korraldust Märjamaa vallas, sealhulgas määrab kindlaks huvide deklaratsiooni (edaspidi deklaratsioon) esitama kohustatud isikud (deklarandid) ning huvide deklaratsioonide kontrollimise komisjoni koosseisu.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus täpsustab korruptsiooni ennetamise korraldust Märjamaa vallas, sealhulgas määrab kindlaks huvide deklaratsiooni (edaspidi deklaratsioon) esitama kohustatud isikud (deklarandid) ning huvide deklaratsioonide kontrollimise komisjoni koosseisu.",
