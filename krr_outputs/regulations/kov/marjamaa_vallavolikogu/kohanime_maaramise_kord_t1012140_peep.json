    },
    {
      "@id": "estleg:Reg_1012140_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kui kohanime määramine toimub Vabariigi Valitsuse või ministri poolt ja see puudutab Märjamaa valda, annab vallavalitsus kohanimemäärajale kirjaliku arvamuse kohanime määramise kohta.",
