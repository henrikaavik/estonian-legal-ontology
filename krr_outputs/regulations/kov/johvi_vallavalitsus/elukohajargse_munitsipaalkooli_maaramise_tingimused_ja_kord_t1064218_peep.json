    {
      "@id": "estleg:Reg_1064218_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Elukohajärgsesse kooli vastuvõtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064218_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kooli võetakse laps vastu kooli vastuvõtu korra alusel. 2 (2) Kool on kohustatud võtma õpilaseks kõik selleks soovi avaldavad õppimiskohustuslikud isikud, kellele see kool on elukohajärgne kool. 3 (3) Info lapse kooli nimekirja arvamise kohta tehakse seaduslikele esindajatele teatavaks infosüsteemi ARNO kaudu. 4 (4) Kui seaduslik esindaja soovib muuta elukohajärgset kooli, esitab seaduslik esindaja ametiasutusele kahe nädala jooksul, peale elukohajärgse kooli avalikustamist, infosüsteemi…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kooli võetakse laps vastu kooli vastuvõtu korra alusel. 2 (2) Kool on kohustatud võtma õpilaseks kõik selleks soovi avaldavad õppimiskohustuslikud isikud, kellele see kool on elukohajärgne kool. 3 (3) Info lapse kooli nimekirja arvamise kohta tehakse seaduslikele esindajatele teatavaks infosüsteemi ARNO kaudu. 4 (4) Kui seaduslik esindaja soovib muuta elukohajärgset kooli, esitab seaduslik esindaja ametiasutusele kahe nädala jooksul, peale elukohajärgse kooli avalikustamist, infosüsteemi ARNO kaudu vastava taotluse. Taotluse lahendab ametiasutuse haridusnõunik koostöös kooli juhtkonnaga.",
