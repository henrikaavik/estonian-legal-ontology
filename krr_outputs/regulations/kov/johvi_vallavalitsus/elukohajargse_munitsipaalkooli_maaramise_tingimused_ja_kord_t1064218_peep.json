      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064218_Map"
      },
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse õppimiskohustuslikule lapsele või õppimiskohustuslikust east nooremale lapsele või 18-aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, Eesti Vabariiki akrediteeritud välisriigi või rahvusvahelise organisatsiooni esindaja lapsele, kelle elukoha aadress rahvastikuregistris on Jõhvi vald, põhihariduse omandamise võimaluse tagamiseks elukohajärgse munitsipaalkooli määramise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse õppimiskohustuslikule lapsele või õppimiskohustuslikust east nooremale lapsele või 18-aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, Eesti Vabariiki akrediteeritud välisriigi või rahvusvahelise organisatsiooni esindaja lapsele, kelle elukoha aadress rahvastikuregistris on Jõhvi vald, põhihariduse omandamise võimaluse tagamiseks elukohajärgse munitsipaalkooli määramise tingimused ja kord.",
