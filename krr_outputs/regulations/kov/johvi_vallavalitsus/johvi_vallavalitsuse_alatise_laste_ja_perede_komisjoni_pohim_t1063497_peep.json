      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõhvi Vallavalitsuse alatise laste ja perede komisjoni põhimäärus",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063497_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Jõhvi valla laste ja perede komisjon (edaspidi komisjon) on Jõhvi Vallavalitsuse kui täitevorgani (edaspidi valitsus) juurde lastega seotud küsimuste lahendamiseks moodustatud alatine nõuandev komisjon. 2 (2) Komisjoni põhimääruse kinnitab ja muudab valitsus. 3 (3) Komisjoni koosseisu ja muudatused kinnitab valitsus. 4 (4) Komisjoni töö lõpetamise otsustab valitsus. 5 (5) Komisjon lähtub oma töös kehtivatest õigusaktidest ning käesolevast põhimäärusest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Jõhvi valla laste ja perede komisjon (edaspidi komisjon) on Jõhvi Vallavalitsuse kui täitevorgani (edaspidi valitsus) juurde lastega seotud küsimuste lahendamiseks moodustatud alatine nõuandev komisjon. 2 (2) Komisjoni põhimääruse kinnitab ja muudab valitsus. 3 (3) Komisjoni koosseisu ja muudatused kinnitab valitsus. 4 (4) Komisjoni töö lõpetamise otsustab valitsus. 5 (5) Komisjon lähtub oma töös kehtivatest õigusaktidest ning käesolevast põhimäärusest.",
