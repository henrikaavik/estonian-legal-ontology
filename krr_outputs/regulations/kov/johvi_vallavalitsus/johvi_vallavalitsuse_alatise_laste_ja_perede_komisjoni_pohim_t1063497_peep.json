      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Komisjoni ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõhvi Vallavalitsuse alatise laste ja perede komisjoni põhimäärus",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063497_Map"
      },
      "estleg:summary": {
        "@value": "Komisjoni ülesanded on: 1 1) koostöö edendamine valitsuse ning laste ja peredega töötavate organisatsioonide vahel laste ja lastega perekondade heaolu parandamiseks, sh abivajaduse ennetamiseks ja olemasolevate probleemide vähendamiseks; 2 2) ettepanekute tegemine valitsusele laste ja perede heaolu, tervisekäitumist, toimetulekut ning vanemlust toetavate tegevuste ja teenuste algatamiseks ning korraldamiseks; 3 3) koolikohustuse mittetäitjate ja nende perekondade probleemidele lahendite…",
        "@language": "et"
      },
      "estleg:legalText": "Komisjoni ülesanded on: 1 1) koostöö edendamine valitsuse ning laste ja peredega töötavate organisatsioonide vahel laste ja lastega perekondade heaolu parandamiseks, sh abivajaduse ennetamiseks ja olemasolevate probleemide vähendamiseks; 2 2) ettepanekute tegemine valitsusele laste ja perede heaolu, tervisekäitumist, toimetulekut ning vanemlust toetavate tegevuste ja teenuste algatamiseks ning korraldamiseks; 3 3) koolikohustuse mittetäitjate ja nende perekondade probleemidele lahendite otsimine ning neile abi osutamine; 4 4) laste õiguste edendamine; 5 5) lisatugi juhtumimenetluse käigus tehtavate keeruliste otsuste langetamisel.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063497_Par_2_Lg_1"
        }
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
