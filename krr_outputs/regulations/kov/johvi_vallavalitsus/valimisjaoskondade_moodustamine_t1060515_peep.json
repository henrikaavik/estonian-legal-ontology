    {
      "@id": "estleg:Reg_1060515_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldavad väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskonnad nr 1 ja 2. Valimisjaoskond nr 1 korraldab vajadusel hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 1 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldavad väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskonnad nr 1 ja 2. Valimisjaoskond nr 1 korraldab vajadusel hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 1 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
