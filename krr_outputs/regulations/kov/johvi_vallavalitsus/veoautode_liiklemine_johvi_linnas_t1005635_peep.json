      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Veoautode liiklemine Jõhvi linnas",
      "estleg:summary": {
        "@value": "Käesolev kord reguleerib veoautode, registrimassiga üle 8 tonni ning suuremõõtmeliste ja/või raskekaaluliste autode, liiklemise Jõhvi linna territooriumil.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev kord reguleerib veoautode, registrimassiga üle 8 tonni ning suuremõõtmeliste ja/või raskekaaluliste autode, liiklemise Jõhvi linna territooriumil.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_johvi_vallavalitsus"
      },
