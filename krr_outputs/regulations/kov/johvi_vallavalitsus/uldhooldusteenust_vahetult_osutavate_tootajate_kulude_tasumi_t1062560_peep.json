      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldhooldusteenust vahetult osutavate töötajate kulude tasumise piirmäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Üldhooldusteenust vahetult osutavate töötajate kulude tasumise piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada väljapool isiku kodu ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate sotsiaalhoolekande seaduse § 221 lõikes 2 sätestatud kulude tasumise piirmääraks kuni 650 eurot ühe teenuse saaja kohta kalendrikuus.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada väljapool isiku kodu ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate sotsiaalhoolekande seaduse § 221 lõikes 2 sätestatud kulude tasumise piirmääraks kuni 650 eurot ühe teenuse saaja kohta kalendrikuus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_johvi_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0251"
