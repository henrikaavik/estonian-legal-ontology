        }
      ]
    },
    {
      "@id": "estleg:Reg_1063307_Par_3_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Kool pöördub vallavalitsuse poole, kui: 1) hindamise tulemusena tuvastatakse kohaliku omavalitsuse kaasamise vajadus; 2) kooli rakendatud meetmed ei avalda mõju või neid ei ole võimalik rakendada põhjusel, et kool ei saa viie õppepäeva jooksul õpilase või seadusliku esindajaga kontakti.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063307_Par_3"
      },
      "rdfs:label": "§ 3 lg 6",
