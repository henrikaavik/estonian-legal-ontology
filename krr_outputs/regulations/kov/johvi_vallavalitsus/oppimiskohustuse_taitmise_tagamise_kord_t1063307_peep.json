    {
      "@id": "estleg:Reg_1063307_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kooli direktor määrab isiku, kelle tööülesannete hulka kuulub kooli nimekirjas olevate õppimiskohustust mitte täitvate õpilastega seotud info vallavalitsusega vahetamise korraldamine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063307_Par_3"
      },
      "rdfs:label": "§ 3 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
