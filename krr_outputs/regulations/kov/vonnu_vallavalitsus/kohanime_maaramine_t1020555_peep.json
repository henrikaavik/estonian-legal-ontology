    {
      "@id": "estleg:Reg_1020555_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Bussipeatuste kohanime muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramine",
      "estleg:summary": {
        "@value": "1(1)Määrata Võnnu vallas Terikeste külas teel nr 22270 paremal ja vasakul teepoolel asuva:11) Hiiepärna bussipeatuse uueks nimeks Tornimäe;22) Mäe bussipeatuse uueks nimeks Hiiepärna. 2(2)Määrata Võnnu vallas Kõnnu külas teel nr 22286 paremal ja vasakul teepoolel asuva Kõnnu bussipeatuse uueks nimeks Kõnnuring. 3(3)Määrata Võnnu vallas Hammaste külas teel nr 22265 paremal ja vasakul teepoolel asuva Hammaste bussipeatuse uueks nimeks Hammastepõik.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Määrata Võnnu vallas Terikeste külas teel nr 22270 paremal ja vasakul teepoolel asuva:11) Hiiepärna bussipeatuse uueks nimeks Tornimäe;22) Mäe bussipeatuse uueks nimeks Hiiepärna. 2(2)Määrata Võnnu vallas Kõnnu külas teel nr 22286 paremal ja vasakul teepoolel asuva Kõnnu bussipeatuse uueks nimeks Kõnnuring. 3(3)Määrata Võnnu vallas Hammaste külas teel nr 22265 paremal ja vasakul teepoolel asuva Hammaste bussipeatuse uueks nimeks Hammastepõik.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vonnu_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1020555_Map"
      },
