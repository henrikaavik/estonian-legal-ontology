    },
    {
      "@id": "estleg:Reg_1020555_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrata Võnnu vallas Terikeste külas teel nr 22270 paremal ja vasakul teepoolel asuva: 1) Hiiepärna bussipeatuse uueks nimeks Tornimäe; 2) Mäe bussipeatuse uueks nimeks Hiiepärna.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020555_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
