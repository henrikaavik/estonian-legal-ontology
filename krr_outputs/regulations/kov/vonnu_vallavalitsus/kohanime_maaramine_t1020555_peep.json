      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrata Võnnu vallas Kõnnu külas teel nr 22286 paremal ja vasakul teepoolel asuva Kõnnu bussipeatuse uueks nimeks Kõnnuring.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020555_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
