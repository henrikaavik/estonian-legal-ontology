    {
      "@id": "estleg:Reg_1058702_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valimisjaoskonna nr 1 hääletamisruum asub kõigil eelhääletamise päevadel (esmaspäev kuni laupäev) ja valimispäeval Rõuge rahvamajas aadressil Metsa 1, Rõuge alevik, Rõuge vald, Võru maakond.",
