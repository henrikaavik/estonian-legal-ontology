        "@id": "estleg:Reg_1058702_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1058702_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Valimisjaoskonna nr 2 hääletamisruum asub: 1) esimesel päeval enne valimispäeva (laupäev) Misso rahvamajas aadressil Tsiistre tee 3, Misso alevik, Rõuge vald, Võru maakond; 2) teisel päeval enne valimispäeva (reede) ja valimispäeval Haanja teenuskeskuses aadressil Võru tee 15, Haanja küla, Rõuge vald, Võru maakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058702_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:itemNumber": [
        "1",
        "2"
      ]
    },
    {
      "@id": "estleg:Reg_1058702_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Valimisjaoskonna nr 3 hääletamisruum asub: 1) esimesel päeval enne valimispäeva (laupäev) Mõniste teenuskeskuses aadressil Mendise, Mõniste küla, Rõuge vald, Võru maakond; 2) teisel päeval enne valimispäeva (reede) ja valimispäeval Varstu kultuurikeskuses aadressil Kultuuri 1, Varstu alevik, Rõuge vald, Võru maakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058702_Par_2"
      },
      "rdfs:label": "§ 2 lg 3",
      "estleg:itemNumber": [
