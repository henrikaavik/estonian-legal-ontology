      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Valimisjaoskondade numeratsioon ja hääletamisruumide asukohad",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1) Valimisjaoskonna nr 1 hääletamisruum asub kõigil eelhääletamise päevadel (esmaspäev kuni laupäev) ja valimispäeval Rõuge rahvamajas aadressil Metsa 1, Rõuge alevik, Rõuge vald, Võru maakond. 2(2) Valimisjaoskonna nr 2 hääletamisruum asub:11) esimesel päeval enne valimispäeva (laupäev) Misso rahvamajas aadressil Tsiistre tee 3, Misso alevik, Rõuge vald, Võru maakond;22) teisel päeval enne valimispäeva (reede) ja valimispäeval Haanja teenuskeskuses aadressil Võru tee 15, Haanja küla, Rõuge…",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Valimisjaoskonna nr 1 hääletamisruum asub kõigil eelhääletamise päevadel (esmaspäev kuni laupäev) ja valimispäeval Rõuge rahvamajas aadressil Metsa 1, Rõuge alevik, Rõuge vald, Võru maakond. 2(2) Valimisjaoskonna nr 2 hääletamisruum asub:11) esimesel päeval enne valimispäeva (laupäev) Misso rahvamajas aadressil Tsiistre tee 3, Misso alevik, Rõuge vald, Võru maakond;22) teisel päeval enne valimispäeva (reede) ja valimispäeval Haanja teenuskeskuses aadressil Võru tee 15, Haanja küla, Rõuge vald, Võru maakond. 3(3) Valimisjaoskonna nr 3 hääletamisruum asub:11) esimesel päeval enne valimispäeva (laupäev) Mõniste teenuskeskuses aadressil Mendise, Mõniste küla, Rõuge vald, Võru maakond;22) teisel päeval enne valimispäeva (reede) ja valimispäeval Varstu kultuurikeskuses aadressil Kultuuri 1, Varstu alevik, Rõuge vald, Võru maakond.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rouge_vallavalitsus"
      },
