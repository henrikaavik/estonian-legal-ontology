    {
      "@id": "estleg:Reg_1058702_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid valimisjaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab valimisjaoskond nr 1 eelhääletamist väljaspool elukohajärgset valimisringkonda. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3(3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab valimisjaoskond nr 1 eelhääletamist väljaspool elukohajärgset valimisringkonda. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3(3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
