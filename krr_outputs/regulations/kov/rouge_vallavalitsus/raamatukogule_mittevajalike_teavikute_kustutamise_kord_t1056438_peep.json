      "estleg:summary": {
        "@value": "Määrusega reguleeritakse Rõuge valla raamatukogule (edaspidi raamatukogu) mittevajalike teavikute kogudest ja raamatukogu kataloogist kustutamist, sealhulgas vastava akti kinnitamist.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega reguleeritakse Rõuge valla raamatukogule (edaspidi raamatukogu) mittevajalike teavikute kogudest ja raamatukogu kataloogist kustutamist, sealhulgas vastava akti kinnitamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rouge_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0698"
