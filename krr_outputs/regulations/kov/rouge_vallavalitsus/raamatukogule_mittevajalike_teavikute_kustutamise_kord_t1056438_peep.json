    },
    {
      "@id": "estleg:Reg_1056438_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Teavikute kustutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Raamatukogule mittevajalike teavikute kustutamise kord",
      "estleg:summary": {
        "@value": "1(1) Raamatukogul on lubatud kustutada teavikud, mis on liigses eksemplaarsuses, kaotatud, heaks teenindamiseks kasutuskõlbmatud, sisult aegunud või mille järele puudub nõudlus. 2(2) Raamatukogule mittevajalike teavikute kustutamiseks moodustab raamatukogu direktor vähemalt kolmeliikmelise komisjoni. 3(3) Teavikud kustutatakse kogudest ja raamatukogu kataloogist mahakandmise põhjuste järgi koostatud kustutusaktiga.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Raamatukogul on lubatud kustutada teavikud, mis on liigses eksemplaarsuses, kaotatud, heaks teenindamiseks kasutuskõlbmatud, sisult aegunud või mille järele puudub nõudlus. 2(2) Raamatukogule mittevajalike teavikute kustutamiseks moodustab raamatukogu direktor vähemalt kolmeliikmelise komisjoni. 3(3) Teavikud kustutatakse kogudest ja raamatukogu kataloogist mahakandmise põhjuste järgi koostatud kustutusaktiga. 4(4) Kustutamisele määratud teavikusse lüüakse raamatukogutempli peale kustutustempli jäljend või kriipsutatakse läbi seni kehtinud templi jäljend ja inventarinumber ning eemaldatakse või kriipsutatakse läbi vöötkood. 5(5) Kustutatud teavikud võõrandatakse Rõuge Vallavolikogu kehtestatud korras. 6(6) Võõrandamiseks mittesobivad teavikud utiliseeritakse.",
