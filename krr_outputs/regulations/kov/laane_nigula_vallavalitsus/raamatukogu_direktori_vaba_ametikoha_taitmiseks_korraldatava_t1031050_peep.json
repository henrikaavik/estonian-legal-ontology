        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Dokumendivooru tulemusel võtab komisjon iga kandidaadi kohta otsuse, kas kandidaat vastab ametikohale ja kutsutakse vestlusvooru või tunnistada kandidaat ametikohale mittevastavaks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
