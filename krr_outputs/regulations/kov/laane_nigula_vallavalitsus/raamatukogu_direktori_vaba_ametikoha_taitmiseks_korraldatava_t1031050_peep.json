      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjoni esimesel koosolekul kuulatakse ära komisjoni esimehe ülevaade saabunud avaldustest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
