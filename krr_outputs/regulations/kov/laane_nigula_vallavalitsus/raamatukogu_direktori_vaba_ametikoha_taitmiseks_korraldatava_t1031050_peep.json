    {
      "@id": "estleg:Reg_1031050_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Konkursiteade avaldatakse valla kodulehel ja maakonnalehes.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1031050_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Konkursi välja kuulutamise teade avaldatakse arvestusega, et konkursil osalejal (edaspidi kandidaat) oleks kandideerimisavalduse esitamiseks aega vähemalt kaks nädalat konkursiteate avaldamise päevast arvates.",
