        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Esitatud avalduste põhjal viib komisjon läbi dokumendivooru, mille käigus kontrollitakse nõutud dokumentide olemasolu ja hinnatakse kandidaatide ametikohale vastavust.",
      "estleg:parentProvision": {
