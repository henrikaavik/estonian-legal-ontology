        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Ametikohale mittevastavaks tunnistatud kandidaadile teatatakse komisjoni otsusest kirjalikult hiljemalt 3 tööpäeva jooksul otsuse tegemise päevast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
      },
      "rdfs:label": "§ 6 lg 4"
    },
    {
      "@id": "estleg:Reg_1031050_Par_6_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Ametikohale vastavaks tunnistatud kandidaate teavitatakse otsuse tegemisele järgneval tööpäeval ja kutsutakse vestlusvooru.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
      },
      "rdfs:label": "§ 6 lg 5"
    },
    {
      "@id": "estleg:Reg_1031050_Par_6_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Vestlusvooru kutsutud kandidaate teavitatakse e-posti teel vestluse toimumise ajast ja kohast vähemalt 2 päeva enne komisjoni koosolekut.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
      },
      "rdfs:label": "§ 6 lg 6"
    },
    {
      "@id": "estleg:Reg_1031050_Par_6_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Kandidaat osaleb komisjoni koosolekul ainult vestlusvooru ajal.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
      },
      "rdfs:label": "§ 6 lg 7"
    },
    {
      "@id": "estleg:Reg_1031050_Par_6_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Vestlusvooru tulemusel otsustab komisjon, kes kandidaatidest tunnistada ametikohale vastavaks ja konkursi võitjaks loetakse komisjoniliikmete häälteenamuse saanud kandidaat.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1031050_Par_6"
      },
      "rdfs:label": "§ 6 lg 8"
    },
    {
      "@id": "estleg:Reg_1031050_Par_6_Lg_9",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "9",
      "estleg:legalText": "(9) Konkursi võitnud isik kinnitatakse ametisse vallavalitsuse korraldusega ja töölepingu sõlmib vallavanem.",
