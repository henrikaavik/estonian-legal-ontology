    },
    {
      "@id": "estleg:Reg_1063890_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Väljalangemisohus oleva õpilase määratlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne‑Nigula valla õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063890_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret kogu õppeaasta vältel. 2 (2) Seiret viib läbi kooli direktori määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) korduvad põhjendamata puudumised õppetööst; 2 2) õpilase õpivõlgnevused; 3 3) õpetajate ja tugispetsialistide hinnangud õpilase täiendava toe vajaduse kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret kogu õppeaasta vältel. 2 (2) Seiret viib läbi kooli direktori määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) korduvad põhjendamata puudumised õppetööst; 2 2) õpilase õpivõlgnevused; 3 3) õpetajate ja tugispetsialistide hinnangud õpilase täiendava toe vajaduse kohta. 3 (3) Kui kooli rakendatud tugimeetmed ei taga õppimiskohustuse täitmist, algatab kooli määratud isik Eesti Hariduse Infosüsteemis (EHIS) õppest väljalangemise ohuga õpilase juhtumi ning märgib juhtumi algatamise kuupäeva. 4 (4) Kooli direktor määrab töötaja(d), kelle ülesandeks on õppimiskohustusega seotud info vahetamine vallavalitsusega.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063890_Par_2_Lg_1"
