    {
      "@id": "estleg:Reg_1063890_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Juhtumikorraldaja: 1) hindab lapse või noore abivajadust; 2) kaasab lapse seaduslikud esindajad; 3) rakendab õppimiskohustuse täitmist toetavaid meetmeid; 4) kaasab vajadusel tugispetsialiste, valdkonnaüleseid spetsialiste ja teisi koostööpartnereid; 5) teeb koostööd kooli ja vajadusel teise omavalitsusega, kui laps õpib väljaspool elukohajärgset valda.",
