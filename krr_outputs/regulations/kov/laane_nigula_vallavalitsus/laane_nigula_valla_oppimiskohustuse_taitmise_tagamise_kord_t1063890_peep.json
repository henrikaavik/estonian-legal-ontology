      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Õppimiskohustuse täitmist toetavate meetmete lõpetamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne‑Nigula valla õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063890_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Õppimiskohustust mitte täitva lapse puhul lõpetatakse meetmete rakendamine, kui: 1 1) laps asub õppima; 2 2) laps on saanud 18-aastaseks; 3 3) vallavalitsus on saanud tõendi, et laps omandab haridust välisriigis. 2 (2) Väljalangemisohus õpilase puhul lõpetatakse meetmete rakendamine, kui: 1 1) kool ja juhtumikorraldaja ühiselt leiavad, et õpilane ei ole enam väljalangemisohus; 2 2) õpilane on omandanud kesk- või kutsehariduse; 3 3) õpilane on saanud 18-aastaseks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Õppimiskohustust mitte täitva lapse puhul lõpetatakse meetmete rakendamine, kui: 1 1) laps asub õppima; 2 2) laps on saanud 18-aastaseks; 3 3) vallavalitsus on saanud tõendi, et laps omandab haridust välisriigis. 2 (2) Väljalangemisohus õpilase puhul lõpetatakse meetmete rakendamine, kui: 1 1) kool ja juhtumikorraldaja ühiselt leiavad, et õpilane ei ole enam väljalangemisohus; 2 2) õpilane on omandanud kesk- või kutsehariduse; 3 3) õpilane on saanud 18-aastaseks. 3 (3) Meetmete lõpetamisel lõpetab haridusspetsialist vastava menetluse EHISes.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063890_Par_5_Lg_1"
        },
