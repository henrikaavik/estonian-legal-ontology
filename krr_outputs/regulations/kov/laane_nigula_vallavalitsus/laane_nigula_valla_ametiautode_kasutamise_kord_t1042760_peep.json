    {
      "@id": "estleg:Reg_1042760_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Aruandlus",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla ametiautode kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Ametiautod on reeglina varustatud GPS seadmega. Kui GPS seadet pole paigaldatud, siis täidetakse sõidupäevikut, milles näidatakse: 1 1) ametiautot kasutava isiku ees- ja perekonnanimi; 2 2) ametiauto riikliku registreerimismärgi andmed; 3 3) ametiauto läbisõidumõõdiku alg- ja lõppnäit iga tehtud sõidu korral; 4 4) kuupäev ja sõidu eesmärk iga tehtud sõidu korral. 2 (2) Automaatset GPS sõidupäevikut kasutavad autod määratakse ära vallavanema käskkirjaga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ametiautod on reeglina varustatud GPS seadmega. Kui GPS seadet pole paigaldatud, siis täidetakse sõidupäevikut, milles näidatakse: 1 1) ametiautot kasutava isiku ees- ja perekonnanimi; 2 2) ametiauto riikliku registreerimismärgi andmed; 3 3) ametiauto läbisõidumõõdiku alg- ja lõppnäit iga tehtud sõidu korral; 4 4) kuupäev ja sõidu eesmärk iga tehtud sõidu korral. 2 (2) Automaatset GPS sõidupäevikut kasutavad autod määratakse ära vallavanema käskkirjaga. 3 (3) Sõidupäevik (paberkandjal originaal või elektroonselt digitaalallkirjastatuna) esitatakse vallavalitsuse kantseleile ametiauto kasutamise kuule järgneva kuu viiendaks kuupäevaks. 4 (4) Elektroonse sõidupäeviku kasutajad tagavad kantseleile ligipääsu elektroonsesse keskkonda.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavalitsus"
      },
