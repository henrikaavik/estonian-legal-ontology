      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Ametiauto garažeerimine ning ametiauto tähistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla ametiautode kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Ametiautode garažeerimiskohad kinnitab vallavanem käskkirjaga. 2 (2) Sõitu garažeerimise kohast töökohta ja tagasi loetakse ametisõiduks. 3 (3) Ametiauto tähistatakse Lääne-Nigula valla nime ja vapikujutisega.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ametiautode garažeerimiskohad kinnitab vallavanem käskkirjaga. 2 (2) Sõitu garažeerimise kohast töökohta ja tagasi loetakse ametisõiduks. 3 (3) Ametiauto tähistatakse Lääne-Nigula valla nime ja vapikujutisega.",
