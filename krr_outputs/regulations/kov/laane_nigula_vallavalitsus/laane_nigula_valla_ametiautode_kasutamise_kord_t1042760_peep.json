    {
      "@id": "estleg:Reg_1042760_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Ametiauto tankimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla ametiautode kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Ametiautole määratakse ühes kuus kütuse kasutamise kululimiit auto vastutava kasutaja määramise käskkirjas. 2 (2) Kogus, mis ületab kehtestatud kuulimiiti, kuulub tasumisele ametiauto vastutava kasutaja poolt. 3 (3) Kütuselimiidid vaadatakse iga aastaselt vähemalt ühe korra üle, hiljemalt detsembri kuus. 4 (4) Ametiauto tankimine toimub reeglina kütusekaardiga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ametiautole määratakse ühes kuus kütuse kasutamise kululimiit auto vastutava kasutaja määramise käskkirjas. 2 (2) Kogus, mis ületab kehtestatud kuulimiiti, kuulub tasumisele ametiauto vastutava kasutaja poolt. 3 (3) Kütuselimiidid vaadatakse iga aastaselt vähemalt ühe korra üle, hiljemalt detsembri kuus. 4 (4) Ametiauto tankimine toimub reeglina kütusekaardiga. 5 (5) Erandkorras tekkinud vajadusel on lubatud ametiauto tankimine muude vahenditega, mille maksmist tõendav dokument ja kütusetšekk koos selgitusega esitatakse kulujuhile kinnitamiseks. 6 (6) Elektriautode laadimine toimub üldjuhul valla omandis olevates elektrilaadimispunktides.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
