    },
    {
      "@id": "estleg:Reg_1042760_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Ametiauto kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla ametiautode kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Lääne-Nigula valla omandis ja valduses olevaid ametiautosid kasutatakse ainult töö-, ameti- või teenistusülesannetega seotud tegevuseks. 2 (2) Lääne-Nigula valla kasutuses olevate ametiautode kasutamise õigus teenistus- või tööülesannete täitmiseks on vallavalitsuse teenistujatel ja hallatava asutuse juhil/töötajal. 3 (3) Ametiauto eest vastutava isiku ning ametiauto püsikasutajad määrab vallavanem käskkirjaga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lääne-Nigula valla omandis ja valduses olevaid ametiautosid kasutatakse ainult töö-, ameti- või teenistusülesannetega seotud tegevuseks. 2 (2) Lääne-Nigula valla kasutuses olevate ametiautode kasutamise õigus teenistus- või tööülesannete täitmiseks on vallavalitsuse teenistujatel ja hallatava asutuse juhil/töötajal. 3 (3) Ametiauto eest vastutava isiku ning ametiauto püsikasutajad määrab vallavanem käskkirjaga. 4 (4) Ametiauto kasutaja on kohustatud: 1 1) kooskõlastama ametiauto kasutamise vastutava isikuga ja enne väljasõitu veenduma sõiduki korrasolekus; 2 2) kasutama autot hoolikalt, heaperemehelikult ja säästlikult ning kooskõlas ametiauto kasutusse andmise eesmärgiga; 3 3) mitte andma ametiautot kolmandate isikute kasutusse v.a selleks õigustatud isikutel; 4 4) teavitama vastutavat isikut mõistliku aja jooksul ametiauto korrasolekuks vajalikest hooldus- ja remonditöödest; 5 5) viivitamatult informeerima vallavanemat ja vastutavat isikut ametiauto hävimisest, kaotsiminekust, kahjustumisest, valdus- või kasutusõiguse rikkumisest või piiramisest kolmandate isikute poolt, võttes vajadusel tarvitusele esimesed abinõud edasise kahjude ärahoidmiseks ja tagajärgede likvideerimiseks; 6 6) ametiauto osalise või täieliku hävimise, samuti ärandamise korral kasutaja süül hüvitama vallale ametiauto osalise või täieliku hävimisega seotud kulud, kui nimetatud kulud ei kuulu hüvitamisele kindlustuslepingu alusel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0441"
      },
