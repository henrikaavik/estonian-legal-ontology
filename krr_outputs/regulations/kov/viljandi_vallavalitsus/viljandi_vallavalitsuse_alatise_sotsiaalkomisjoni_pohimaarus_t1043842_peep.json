    {
      "@id": "estleg:Reg_1043842_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Komisjoni esimees",
        "@language": "et"
      },
      "estleg:sourceAct": "Viljandi Vallavalitsuse alatise sotsiaalkomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1(1) Komisjoni esimees:11) kutsub kokku komisjoni koosoleku;22) määrab komisjoni liikmete hulgast protokollija;33) koostab koosoleku päevakorra;44) allkirjastab komisjoni otsused;55) kutsub vajadusel komisjoni koosolekule spetsialiste, vallavalitsuse ametnikke ja teisi isikuid, kelle osalus on otsuse tegemisel vajalik ning otsustab neile sõnaõiguse andmise.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Komisjoni esimees:11) kutsub kokku komisjoni koosoleku;22) määrab komisjoni liikmete hulgast protokollija;33) koostab koosoleku päevakorra;44) allkirjastab komisjoni otsused;55) kutsub vajadusel komisjoni koosolekule spetsialiste, vallavalitsuse ametnikke ja teisi isikuid, kelle osalus on otsuse tegemisel vajalik ning otsustab neile sõnaõiguse andmise. 2(2) Komisjoni esimehe volitused lõpevad:11) esildise alusel tagasiastumisega esimehe kohalt;22) vabastamisega ametikohalt, millega seoses ta esimeheks nimetati;33) vallavalitsuse motiveeritud otsusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viljandi_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0899"
