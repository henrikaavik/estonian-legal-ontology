    {
      "@id": "estleg:Reg_1033787_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Liikluse ajutine piiramine või sulgemine valla teedel",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohalikel teedel liikluspiirangute kehtestamise kord",
      "estleg:summary": {
        "@value": "1 (1) Valla teel võidakse ajutiselt liiklust piirata või valla tee liiklemiseks sulgeda kevadise teedelagunemise, avariide, loodusõnnetuste, vihmast tingitud tee kasutuskõlbmatuks muutumise või kandevõime kaotuse korral, teetööde või vallavalitsuses kooskõlastatud ürituse ajaks. 2 (2) Otsuse avalikus kasutuses valla teel liikluse sulgemiseks või piiramiseks teeb vallavalitsus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Valla teel võidakse ajutiselt liiklust piirata või valla tee liiklemiseks sulgeda kevadise teedelagunemise, avariide, loodusõnnetuste, vihmast tingitud tee kasutuskõlbmatuks muutumise või kandevõime kaotuse korral, teetööde või vallavalitsuses kooskõlastatud ürituse ajaks. 2 (2) Otsuse avalikus kasutuses valla teel liikluse sulgemiseks või piiramiseks teeb vallavalitsus. 3 (3) Liiklemiseks käesoleva §-i lõikes 4 nimetatud piirangualadel tuleb vallavalitsusele esitada digitaalselt allkirjastatult taotlus meiliaadressile vallavalitsus@rakverevald.ee või paberkandjal allkirjastatult Rakvere Vallavalitsusele. 4 (4) Koormuspiiranguga vallateedel ja liiklusmärgi „Sissesõidu keeld“ lisa teatetahvliga „välja arvatud Rakvere Vallavalitsuse loal“ keelupiirkonnas liiklemiseks võib vallavalitsus anda loa koormuspiirangut ületava sõidukiga liiklemiseks või piirangualas liiklemiseks. 5 (5) Keelupiirkonnas liiklemise luba väljastatakse tasuta. 6 (6) Ilma luba taotlemata on käesoleva §-i lõikes 4 nimetatud piirangualades liigelda lubatud ühissõidukitel, pääste- ja eriteenistuse sõidukitel, kauba- ja prügiautodel. 7 (7) Valla teel tekkinud otsese ohu korral võib liikluse sulgeda või seda piirata erandina ka politsei. 8 (8) Piirangute kehtestamisest ning piirangute lõpetamisest teatatakse valla veebilehel www.rakverevald.kovtp.ee.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_vallavalitsus"
      },
