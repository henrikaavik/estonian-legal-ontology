    },
    {
      "@id": "estleg:Reg_1044276_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koolitöötajate koosseisu kinnitab ja selles teeb muudatused kooli direktor käskkirjaga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044276_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1044276_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Koolitöötajate koosseisu kavandamisel lähtub direktor vallavolikogu poolt kinnitatud kooli eelarvest ja tagab, et õppekava oleks täidetud ja õigusaktides nõutud teenused osutatud.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044276_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1044276_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Direktor kinnitab koolitöötajate koosseisu tähtajatult.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044276_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1044276_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Eelarve muutmist eeldava koolitöötajate koosseisu muutmise vajaduse tekkimisel eelarveaasta jooksul esitab kooli direktor eelarve muutmise taotluse koos seletuskirjaga vähemalt kaks kuud enne tähtpäeva, millal on vaja muudatust rakendada, näidates koolitöötajate koosseisu muutmisel ära vahendid, millest kaetakse täiendav personalikulu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044276_Par_2"
      },
      "rdfs:label": "§ 2 lg 4"
    },
