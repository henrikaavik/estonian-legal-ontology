    },
    {
      "@id": "estleg:Reg_1044276_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Rakvere valla üldhariduskoolide koolitöötajate koosseisu kinnitamise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044276_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1044276_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolitöötajate koosseisu kinnitamine ja muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolitöötajate koosseisu kinnitamise kord",
      "estleg:summary": {
        "@value": "1(1)Koolitöötajate koosseisu kinnitab ja selles teeb muudatused kooli direktor käskkirjaga. 2(2)Koolitöötajate koosseisu kavandamisel lähtub direktor vallavolikogu poolt kinnitatud kooli eelarvest ja tagab, et õppekava oleks täidetud ja õigusaktides nõutud teenused osutatud. 3(3)Direktor kinnitab koolitöötajate koosseisu tähtajatult. 4(4)Eelarve muutmist eeldava koolitöötajate koosseisu muutmise vajaduse tekkimisel eelarveaasta jooksul esitab kooli direktor eelarve muutmise taotluse koos…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Koolitöötajate koosseisu kinnitab ja selles teeb muudatused kooli direktor käskkirjaga. 2(2)Koolitöötajate koosseisu kavandamisel lähtub direktor vallavolikogu poolt kinnitatud kooli eelarvest ja tagab, et õppekava oleks täidetud ja õigusaktides nõutud teenused osutatud. 3(3)Direktor kinnitab koolitöötajate koosseisu tähtajatult. 4(4)Eelarve muutmist eeldava koolitöötajate koosseisu muutmise vajaduse tekkimisel eelarveaasta jooksul esitab kooli direktor eelarve muutmise taotluse koos seletuskirjaga vähemalt kaks kuud enne tähtpäeva, millal on vaja muudatust rakendada, näidates koolitöötajate koosseisu muutmisel ära vahendid, millest kaetakse täiendav personalikulu.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0661"
      },
