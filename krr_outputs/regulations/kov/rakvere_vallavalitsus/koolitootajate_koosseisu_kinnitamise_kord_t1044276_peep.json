      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolitöötajate koosseisu kinnitamise kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Rakvere valla üldhariduskoolide koolitöötajate koosseisu kinnitamise kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Rakvere valla üldhariduskoolide koolitöötajate koosseisu kinnitamise kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_vallavalitsus"
      },
