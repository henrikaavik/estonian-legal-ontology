      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Valga Keskraamatukogule mittevajalike teavikute tasuta võõrandamise ja müügi kord",
      "estleg:summary": {
        "@value": "1(1)Valga Keskraamatukogule (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamise ja müümise kord sätestab raamatukogule mittevajalike teavikute müümise või tasuta võõrandamise tingimused ja korra. 2(2)Raamatukogudel on lubatud müüa või tasuta üle anda teavikuid, mis on liigses eksemplaarsuses, lagunenud, sisult aegunud või teavikuid, mille järele puudub nõudlus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Valga Keskraamatukogule (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamise ja müümise kord sätestab raamatukogule mittevajalike teavikute müümise või tasuta võõrandamise tingimused ja korra. 2(2)Raamatukogudel on lubatud müüa või tasuta üle anda teavikuid, mis on liigses eksemplaarsuses, lagunenud, sisult aegunud või teavikuid, mille järele puudub nõudlus.",
