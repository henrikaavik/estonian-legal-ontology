    {
      "@id": "estleg:Reg_1062007_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_valga_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0855"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062007_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1062007_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062007_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062007_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1062007_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Valga vallas:11) elamumaa sihtotstarbega maale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;22) punktis 1 nimetamata maatulundusmaa sihtotstarbega maale maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;33) punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumäär 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Valga vallas:11) elamumaa sihtotstarbega maale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;22) punktis 1 nimetamata maatulundusmaa sihtotstarbega maale maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;33) punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumäär 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_valga_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0855"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062007_Map"
      },
      "estleg:hasSubsection": [
