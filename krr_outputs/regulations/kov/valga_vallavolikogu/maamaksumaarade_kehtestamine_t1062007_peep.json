      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Reguleerimisala",
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": "Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust. Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust.",
      "estleg:legalText": "Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust. Määrus reguleerib Valga valla haldusterritooriumil asuva maa maamaksumäärasid, maamaksu aastase suurenemise maksimaalset piirmäära ja kodualuse maa maksusoodustust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_valga_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0855"
      },
