    },
    {
      "@id": "estleg:Reg_1062007_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Valga vallas: 1) elamumaa sihtotstarbega maale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas; 2) punktis 1 nimetamata maatulundusmaa sihtotstarbega maale maamaksumäär 0,5 protsenti maa maksustamishinnast aastas; 3) punktides 1 ja 2 nimetamata sihtotstarbega maale maamaksumäär 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062007_Par_2"
