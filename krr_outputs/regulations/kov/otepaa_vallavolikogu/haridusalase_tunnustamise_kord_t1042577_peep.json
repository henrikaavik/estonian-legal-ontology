    {
      "@id": "estleg:Reg_1042577_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Tunnustamine üleriigilisel olümpiaadil või konkursil edukal esinemisel",
        "@language": "et"
      },
      "estleg:sourceAct": "Haridusalase tunnustamise kord",
      "estleg:summary": {
        "@value": "1 (1) Tartu Ülikooli teaduskooli poolt koordineeritud üleriigilisel olümpiaadil või konkursil edukalt esinenud Otepää valla üldhariduskooli, koolieelse lasteasutuse ja huvikooli õpilast/last/võistkonda ja tema juhendajat tunnustatakse õppeaasta lõpul toimuval üritusel. 2 (2) Haridustoetust võib maksta ka hariduskomisjoni ettepanekul üleriigilisel olümpiaadil või konkursil väga edukalt esinenud Otepää valla üldhariduskooli õpilasele 100 kuni 300 eurot vastavalt Otepää Vallavalitsuse otsusele.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Tartu Ülikooli teaduskooli poolt koordineeritud üleriigilisel olümpiaadil või konkursil edukalt esinenud Otepää valla üldhariduskooli, koolieelse lasteasutuse ja huvikooli õpilast/last/võistkonda ja tema juhendajat tunnustatakse õppeaasta lõpul toimuval üritusel. 2 (2) Haridustoetust võib maksta ka hariduskomisjoni ettepanekul üleriigilisel olümpiaadil või konkursil väga edukalt esinenud Otepää valla üldhariduskooli õpilasele 100 kuni 300 eurot vastavalt Otepää Vallavalitsuse otsusele. 3 (3) Õpilase/lapse/võistkonna ja tema juhendaja tunnustamiseks esitab haridusasutuse juht Otepää Vallavalitsusele vastava ettepaneku.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_otepaa_vallavolikogu"
      },
