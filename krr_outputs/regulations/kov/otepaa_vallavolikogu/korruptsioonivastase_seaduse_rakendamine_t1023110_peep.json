    {
      "@id": "estleg:Reg_1023110_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Huvide deklareerimise kohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "1(1)Deklaratsiooni on kohustatud esitama vallavolikogu liige, vallavalitsuse liige, valla ametiasutuse juht, vallaametnik, valla valitseva mõju all oleva äriühingu juhtorgani liige ja valla asutatud sihtasutuse juhtorgani liige. 2(2)Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni esitamise kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks huvide deklaratsioonide registrile.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Deklaratsiooni on kohustatud esitama vallavolikogu liige, vallavalitsuse liige, valla ametiasutuse juht, vallaametnik, valla valitseva mõju all oleva äriühingu juhtorgani liige ja valla asutatud sihtasutuse juhtorgani liige. 2(2)Deklaratsioon esitatakse nelja kuu jooksul ametisse asumisest või deklaratsiooni esitamise kohustuse tekkimisest arvates ning edaspidi iga aasta 31. maiks huvide deklaratsioonide registrile. Kalendriaasta jooksul ei pea deklarant esitama rohkem kui ühe deklaratsiooni ka juhul, kui ta asub uuele ametikohale. 3(3)Deklaratsiooni esitamise kohustus lõpeb, kui deklarant on esitanud deklaratsiooni ametikohalt lahkumise aastale järgneval kalendriaastal. 4(4)Deklaratsiooni esitab deklarant huvide deklaratsioonide registrile.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_otepaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0557"
      },
