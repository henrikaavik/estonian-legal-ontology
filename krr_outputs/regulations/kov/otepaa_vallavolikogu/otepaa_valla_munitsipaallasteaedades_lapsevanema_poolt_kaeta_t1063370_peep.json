      }
    },
    {
      "@id": "estleg:Reg_1063370_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Osalustasu ei arvestata iga-aastaselt juulikuu eest, välja arvatud juhul, kui kasutatakse valverühma teenust. Lapsevanem esitab hiljemalt 15. maiks (k.a) lasteaia direktorile kirjaliku avalduse valverühma teenuse kasutamiseks. Valverühma registreeritud lapse eest arvestatakse osalustasu täies määras sõltumata teenuse kasutamisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063370_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
