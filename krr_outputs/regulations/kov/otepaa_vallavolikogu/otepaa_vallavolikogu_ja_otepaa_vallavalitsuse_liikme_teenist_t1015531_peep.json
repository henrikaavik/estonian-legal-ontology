      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Teenistuslähetus",
        "@language": "et"
      },
      "estleg:sourceAct": "Otepää Vallavolikogu ja Otepää Vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1(1)Teenistuslähetus on vallavolikogu või vallavalitsuse liikme saatmine kindlaksmääratud ajavahemikus täitma teenistusülesannet väljaspool alalise teenistuskoha asukohta või koolitusele väljaspool alalise teenistuskoha asukohta. Volikogu liige saadetakse teenistuslähetusse vallavolikogu esimehe korraldusel ja vallavalitsuse liige vallavanema korraldusel. 2(2)Lähetust välisriiki loetakse välislähetuseks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Teenistuslähetus on vallavolikogu või vallavalitsuse liikme saatmine kindlaksmääratud ajavahemikus täitma teenistusülesannet väljaspool alalise teenistuskoha asukohta või koolitusele väljaspool alalise teenistuskoha asukohta. Volikogu liige saadetakse teenistuslähetusse vallavolikogu esimehe korraldusel ja vallavalitsuse liige vallavanema korraldusel. 2(2)Lähetust välisriiki loetakse välislähetuseks.",
