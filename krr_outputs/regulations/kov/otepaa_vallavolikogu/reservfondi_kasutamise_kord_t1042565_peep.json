        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Reservfondi kasutamise üle arvestuse pidamine ja kontroll",
        "@language": "et"
      },
      "estleg:sourceAct": "Reservfondi kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Reservfondi kasutamise üle peab arvestust finantsteenistus ja vahendite kasutamise sihtotstarbelisuse tagab vahendite eraldamisel määratud vastutav isik. 2 (2) Vallavalitsus esitab volikogule informatsiooni reservfondi vahendite kasutamise kohta kord kvartalis volikogu istungil ja aruande reservfondi kasutamise kohta koos aastaaruandega. 3 (3) Eraldatud raha mittesihtotstarbelise kasutamise puhul otsustab raha tagasinõudmise vallavalitsus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Reservfondi kasutamise üle peab arvestust finantsteenistus ja vahendite kasutamise sihtotstarbelisuse tagab vahendite eraldamisel määratud vastutav isik. 2 (2) Vallavalitsus esitab volikogule informatsiooni reservfondi vahendite kasutamise kohta kord kvartalis volikogu istungil ja aruande reservfondi kasutamise kohta koos aastaaruandega. 3 (3) Eraldatud raha mittesihtotstarbelise kasutamise puhul otsustab raha tagasinõudmise vallavalitsus. 4 (4) Reservfondist eraldatud vahendite tagastamisel vallavalitsuse arvelduskontole kantakse tagastatud vahendid tagasi reservfondi eelarvesse. 5 (5) Kontrolli reservfondi vahendite kasutamise kohta teostab volikogu revisjonikomisjon.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_otepaa_vallavolikogu"
      },
