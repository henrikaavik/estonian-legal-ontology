    {
      "@id": "estleg:Reg_1060851_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Asutuse juhtimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Otepää Haldusteenused põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Asutuse juhataja kinnitab ametisse ja vabastab ametist vallavalitsus vallavanema ettepanekul. 2(2)Juhataja:11) korraldab asutuse tegevust ja vastutab selle ülesannete täitmise eest;22) vastutab asutuse üldseisundi ja arengu ning asutuse valdusesse antud vallavara säilimise, korrashoiu ja sihtotstarbelise kasutamise eest;33) koostab asutuse eelarve kavandi ning vastutab kinnitatud eelarve täitmise eest;44) esindab asutuse ning sõlmib asutuse nimel lepinguid ilma erivolitusteta oma pädevuse…",
        "@language": "et"
      },
