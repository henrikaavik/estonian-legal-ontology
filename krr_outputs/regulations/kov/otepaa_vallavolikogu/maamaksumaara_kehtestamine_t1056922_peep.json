      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Otepää valla haldusterritooriumil järgmised maamaksumäärad:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,25 protsenti maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,25 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,5 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Otepää valla haldusterritooriumil järgmised maamaksumäärad:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,25 protsenti maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,25 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,5 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_otepaa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0557"
