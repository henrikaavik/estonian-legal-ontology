    {
      "@id": "estleg:Reg_1064192_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Komisjoni töökorraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Pärnu linna üldhariduskooli direktori atesteerimiskomisjoni töökord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064192_Map"
      },
      "estleg:summary": {
        "@value": "1(1)Komisjoni esimese koosoleku kutsub kokku linnavalitsus. 2(2)Komisjon valib esimesel koosolekul komisjoni liikmete hulgast komisjoni esimehe, kes valmistab ette ja kutsub kokku järgnevad koosolekud ning juhib koosolekuid ja atesteerimisvestlust. 3(3)Komisjoni asjaajamise, protokollimise ja tehnilise toe korraldab haridus- ja kultuuriosakond.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Komisjoni esimese koosoleku kutsub kokku linnavalitsus. 2(2)Komisjon valib esimesel koosolekul komisjoni liikmete hulgast komisjoni esimehe, kes valmistab ette ja kutsub kokku järgnevad koosolekud ning juhib koosolekuid ja atesteerimisvestlust. 3(3)Komisjoni asjaajamise, protokollimise ja tehnilise toe korraldab haridus- ja kultuuriosakond.",
