      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042448_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
