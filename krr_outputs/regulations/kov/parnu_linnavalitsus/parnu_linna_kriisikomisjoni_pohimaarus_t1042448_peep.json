        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Komisjoni koosolek",
        "@language": "et"
      },
      "estleg:sourceAct": "Pärnu linna kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Komisjoni töövorm on koosolek. 2 (2) Komisjon koosoleku kutsub kokku komisoni esimees vastavalt vajadusele 3 (3) Komisjoni koosoleku aja, päevakorra ja komisjoni koosolekule kutsutavate isikute nimekiri esitatakse vähemalt kaks tööpäeva enne koosoleku toimumist komisjoni liikmetele ja kutsutavatele isikutele. Komisjoni erakorralise koosoleku kokkukutsumisel võib käesolevas lõikes sätestatut mitte arvestada, kui seda ei võimalda kujunenud olukord. 4 (4) Komisjoni koosolek protokollitakse.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjoni töövorm on koosolek. 2 (2) Komisjon koosoleku kutsub kokku komisoni esimees vastavalt vajadusele 3 (3) Komisjoni koosoleku aja, päevakorra ja komisjoni koosolekule kutsutavate isikute nimekiri esitatakse vähemalt kaks tööpäeva enne koosoleku toimumist komisjoni liikmetele ja kutsutavatele isikutele. Komisjoni erakorralise koosoleku kokkukutsumisel võib käesolevas lõikes sätestatut mitte arvestada, kui seda ei võimalda kujunenud olukord. 4 (4) Komisjoni koosolek protokollitakse. Protokoll vormistatakse kolme tööpäeva jooksul. Protokollile kirjutavad alla koosoleku juhataja ja protokollija.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
