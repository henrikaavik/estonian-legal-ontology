        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Komisjoni koosolek protokollitakse. Protokoll vormistatakse kolme tööpäeva jooksul. Protokollile kirjutavad alla koosoleku juhataja ja protokollija.",
