    {
      "@id": "estleg:Reg_1062265_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Lasteaeda vastuvõtmise alused",
        "@language": "et"
      },
      "estleg:sourceAct": "Pärnu linna lasteaedadesse laste vastuvõtu ja väljaarvamise kord",
      "estleg:summary": {
        "@value": "1 (1) Õigustaotleda lapsele lastehoiukohta on vanemal, kui: 1 1) laps on vanuses poolteise- kuni kolmeaastane; ja 2 2) lapse elukoht on Eesti rahvastikuregistris (edaspidi rahvastikuregistri) Pärnu linn. 2 (2) Õigustaotleda lapsele lasteaiakohta on vanemal, kui: 1 1) laps on vanuses kolm kuni seitse aastat või kuni kooliminekuni; ja 2 2) lapse elukoht on rahvastikuregistris Pärnu linn. 3 (3) Vanematele on lasteaia valik vaba.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Õigustaotleda lapsele lastehoiukohta on vanemal, kui: 1 1) laps on vanuses poolteise- kuni kolmeaastane; ja 2 2) lapse elukoht on Eesti rahvastikuregistris (edaspidi rahvastikuregistri) Pärnu linn. 2 (2) Õigustaotleda lapsele lasteaiakohta on vanemal, kui: 1 1) laps on vanuses kolm kuni seitse aastat või kuni kooliminekuni; ja 2 2) lapse elukoht on rahvastikuregistris Pärnu linn. 3 (3) Vanematele on lasteaia valik vaba. 4 (4) Võimalusel arvestatakse lapse elukoha lähedust lasteaiale ja ühte lasteaeda võetakse järjekorra alusel vastu ühe pere lapsed, kelle elukoha aadress rahvastikuregistris ühtib. 5 (5) Vabade kohtade olemasolul võetakse lasteaeda lapsi väljastpoolt Pärnu linna juhul, kui teise kohaliku omavalitsusega on sõlmitud leping lasteaia koha maksumusega seotud kulude tasumise kohta.",
