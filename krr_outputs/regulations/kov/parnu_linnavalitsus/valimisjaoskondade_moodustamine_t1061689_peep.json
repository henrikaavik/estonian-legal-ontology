      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Valimisjaoskonnad, kus valijad saavad hääletada kuuendast kuni kolmanda päevani enne valimispäeva",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "Kuuendast kuni kolmanda päevani enne valimispäeva saavad valijad hääletada järgmistes valimisjaoskondades:11) valimisjaoskond nr 4 (Pärnu Bussijaam);22) valimisjaoskond nr 5 (Suve Keskus);33) valimisjaoskond nr 6 (Kaubamajakas);44) valimisjaoskond nr 9 (Maksimarket).",
        "@language": "et"
      },
      "estleg:legalText": "Kuuendast kuni kolmanda päevani enne valimispäeva saavad valijad hääletada järgmistes valimisjaoskondades:11) valimisjaoskond nr 4 (Pärnu Bussijaam);22) valimisjaoskond nr 5 (Suve Keskus);33) valimisjaoskond nr 6 (Kaubamajakas);44) valimisjaoskond nr 9 (Maksimarket).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
