        }
      ]
    },
    {
      "@id": "estleg:Reg_1061689_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kuuendast kuni kolmanda päevani enne valimispäeva saavad valijad hääletada järgmistes valimisjaoskondades: 1) valimisjaoskond nr 4 (Pärnu Bussijaam); 2) valimisjaoskond nr 5 (Suve Keskus); 3) valimisjaoskond nr 6 (Kaubamajakas); 4) valimisjaoskond nr 9 (Maksimarket).",
