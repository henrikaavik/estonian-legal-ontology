      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Sissetulekust mittesõltuvate toetuste määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Sotsiaaltoetuste määrad",
      "estleg:summary": {
        "@value": "Sissetulekust mittesõltuvate toetuste määrad on järgmised: 1 1) sünnitoetus: I osa 300 eurot ja II osa 300 eurot; 2 2) esimesse klassi astumise toetus: 100 eurot; 3 3) jõulutoetus: esemeline kingitus; 4 4) toetus asendushooldusel olevale noorele: 50 eurot; 5 5) elluastumistoetus: 150 eurot; 6 6) õnnetusjuhtumi toetus: kuni 500 eurot; 7 7) matusetoetus: 250 eurot; 8 8) hooldajatoetus puudega lapse hooldamise eest: raske puudega lapse hooldamise eest 30-80 eurot kuus, sügava puudega lapse…",
        "@language": "et"
      },
      "estleg:legalText": "Sissetulekust mittesõltuvate toetuste määrad on järgmised: 1 1) sünnitoetus: I osa 300 eurot ja II osa 300 eurot; 2 2) esimesse klassi astumise toetus: 100 eurot; 3 3) jõulutoetus: esemeline kingitus; 4 4) toetus asendushooldusel olevale noorele: 50 eurot; 5 5) elluastumistoetus: 150 eurot; 6 6) õnnetusjuhtumi toetus: kuni 500 eurot; 7 7) matusetoetus: 250 eurot; 8 8) hooldajatoetus puudega lapse hooldamise eest: raske puudega lapse hooldamise eest 30-80 eurot kuus, sügava puudega lapse hooldamise eest 40-100 eurot kuus, hooldajatoetus täisealise isiku hooldamise eest: raske puudega isik 30 eurot kuus ja sügava puudega isik 40 eurot kuus; 9 9) puudega lapse pere toetus: kuni 600 eurot aastas, sealhulgas sõidukulusid hüvitatakse 0,2 eurot kilomeetri kohta; 10 10) toetus üldhooldusteenuse kohamaksu tasumiseks on 50 eurot kuus. RT IV 2022-03-03 3 403032022003 2023-01-01",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0142"
      },
