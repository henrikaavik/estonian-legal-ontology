    {
      "@id": "estleg:Reg_1051242_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist Antsla valla veebilehel. Sätet ei kohaldata maaüksuse nime määramisel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051242_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1051242_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kohanime määramise õigusakt edastatakse 10 päeva jooksul pärast selle jõustumist kohanimenõukogule, riikliku kohanimeregistri volitatud töötlejale ja taotlejale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051242_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
