      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kaugküttepiirkonna piirid",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaugküttepiirkonna määramine",
      "estleg:summary": {
        "@value": "Vana-Antsla aleviku kaugküttepiirkond koosneb kaugküttepiirkonnast 1, millel asuvad korruselamud ( Tammiku tn ) ja piirkonnast 2, millel asuvad Vana-Antsla Kutsekeskkooli hooned. Lisatud on maa-ala kaart.",
        "@language": "et"
      },
      "estleg:legalText": "Vana-Antsla aleviku kaugküttepiirkond koosneb kaugküttepiirkonnast 1, millel asuvad korruselamud ( Tammiku tn ) ja piirkonnast 2, millel asuvad Vana-Antsla Kutsekeskkooli hooned. Lisatud on maa-ala kaart.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavolikogu"
      },
