      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Väljaspool kodu osutatava üldhooldusteenuse hoolduskulu piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse väljaspool kodu osutatava ööpäevaringse üldhooldekodu hooldus- ja abihooldustöötajate kulutuste piirmäär, mille ulatuses kaetakse üldhooldusteenuse kulud Antsla valla eelarvest. Nende kulutuste hulka kuuluvad üldhooldekodu hooldustöötajate tööjõukulud, tööriietuse ja isikukaitsevahendite kulud, tervisekontrolli ja vaktsineerimise kulud, koolituse ja supervisiooni kulud.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse väljaspool kodu osutatava ööpäevaringse üldhooldekodu hooldus- ja abihooldustöötajate kulutuste piirmäär, mille ulatuses kaetakse üldhooldusteenuse kulud Antsla valla eelarvest. Nende kulutuste hulka kuuluvad üldhooldekodu hooldustöötajate tööjõukulud, tööriietuse ja isikukaitsevahendite kulud, tervisekontrolli ja vaktsineerimise kulud, koolituse ja supervisiooni kulud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0142"
      },
