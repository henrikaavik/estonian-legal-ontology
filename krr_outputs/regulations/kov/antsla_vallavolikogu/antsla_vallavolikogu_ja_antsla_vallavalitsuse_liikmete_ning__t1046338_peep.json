      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Lähetuskulude hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Antsla Vallavolikogu ja Antsla Vallavalitsuse liikmete ning vallavanema teenistuslähetusse saatmise kord",
      "estleg:summary": {
        "@value": "1 (1) Lähetatule hüvitatakse lähetusega seotud kulud avaliku teenistuse seaduse alusel kehtestatud Vabariigi Valitsuse määruses „Ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimused ja kord ning päevaraha määr“ (edaspidi Vabariigi Valitsuse määrus) sätestatud tingimustel ja korras. 2 (2) Riigisisese lähetuse korral päevaraha ei maksta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lähetatule hüvitatakse lähetusega seotud kulud avaliku teenistuse seaduse alusel kehtestatud Vabariigi Valitsuse määruses „Ametniku teenistuslähetusse saatmise, lähetuskulude hüvitamise ning päevaraha maksmise tingimused ja kord ning päevaraha määr“ (edaspidi Vabariigi Valitsuse määrus) sätestatud tingimustel ja korras. 2 (2) Riigisisese lähetuse korral päevaraha ei maksta. 3 (3) Lähetatu esitab kokkuvõtte lähetuse tulemustest viie tööpäeva jooksul pärast välislähetuselt saabumist (Lisa 2). 4 (4) Lähetuskulusid tõendavad dokumendid esitatakse valla raamatupidamisele viie päeva jooksul peale lähetuselt saabumist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0142"
