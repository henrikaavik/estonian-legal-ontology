      "@id": "estleg:Reg_1046338_Par_3_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Kui riigisisese lähetusega ei kaasne lähetatavale lähetuskulude hüvitamist, siis lähetusse saatmise käskkirja ei vormistata. Lähetusse minekust tuleb teatada lähetusse saatmise õigust omavale isikule.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046338_Par_3"
      },
      "rdfs:label": "§ 3 lg 7"
    },
    {
      "@id": "estleg:Reg_1046338_Par_3_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Lähetusega seotud korraldused, käskkirjad ning muud dokumendid säilitataks vallakantseleis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046338_Par_3"
      },
      "rdfs:label": "§ 3 lg 8"
    },
    {
      "@id": "estleg:Reg_1046338_Par_4",
      "@type": [
