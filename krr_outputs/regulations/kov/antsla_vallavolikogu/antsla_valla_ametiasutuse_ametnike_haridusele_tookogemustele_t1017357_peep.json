      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ametniku teadmised ja oskused peavad olema kaasaegsed, võimaldamaks töötada kaasaegses keskkonnas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1017357_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:assertionConfidence": {
