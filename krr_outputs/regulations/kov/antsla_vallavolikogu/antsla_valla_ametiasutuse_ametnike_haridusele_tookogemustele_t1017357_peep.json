        }
      ]
    },
    {
      "@id": "estleg:Reg_1017357_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Ametnik peab omama kohusetunnet, otsustus- ja vastutusvõimet, sealhulgas suutlikkust võtta iseseisvalt vastu otsuseid oma ametikoha pädevuse piires, võimet näha ette otsuste tagajärgi ja vastutada nende eest. Ametnikul peab olema väga hea suhtlemisoskus, sealhulgas oskus koostööks avalike huvide elluviimisel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1017357_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
