        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:Reg_1017357_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ametnik peab oskama: 1) kasutada arvutit, sealhulgas ametikohal vajalike teksti- ja tabeltöötlusprogrammide ning teiste arvutiprogrammide ja andmekogude kasutamist; 2) koostada õigusaktide eelnõusid ja haldusakte ning teadma ja järgima haldusmenetlusele kehtestatud reegleid; 3) korrektset eesti keelt nii kõnes kui kirjas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1017357_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ],
      "estleg:assertionConfidence": {
