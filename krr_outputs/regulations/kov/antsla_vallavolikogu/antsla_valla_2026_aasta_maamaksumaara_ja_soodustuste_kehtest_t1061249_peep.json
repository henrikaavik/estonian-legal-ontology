    {
      "@id": "estleg:Reg_1061249_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada 2026. aasta maamaksumääraks: 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
