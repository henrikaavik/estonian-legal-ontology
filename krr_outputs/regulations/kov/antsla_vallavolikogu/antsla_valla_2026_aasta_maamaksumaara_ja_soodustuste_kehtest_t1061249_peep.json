      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Antsla valla 2026. aasta maamaksumäära ja soodustuste kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada 2026. aasta maamaksumääraks:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada 2026. aasta maamaksumääraks:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõike punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0142"
