    {
      "@id": "estleg:Reg_1061249_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Soodustuste kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Antsla valla 2026. aasta maamaksumäära ja soodustuste kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada 2026. aastal järgmised maamaksu soodustused:11) maamaksu aastase suurenemise maksimaalseks piirmääraks 10%;22) kodualuse maa maksusoodustus kuni 25 eurot. Kodualuseks maaks loetakse elamumaa, või maatulundusmaa õuemaa kõlvikut, kui sellel maal asuvas hoones on maa omaniku või kasutaja elukoht rahvastikuregistrisse kantud elukoha andmete järgi.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada 2026. aastal järgmised maamaksu soodustused:11) maamaksu aastase suurenemise maksimaalseks piirmääraks 10%;22) kodualuse maa maksusoodustus kuni 25 eurot. Kodualuseks maaks loetakse elamumaa, või maatulundusmaa õuemaa kõlvikut, kui sellel maal asuvas hoones on maa omaniku või kasutaja elukoht rahvastikuregistrisse kantud elukoha andmete järgi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_antsla_vallavolikogu"
