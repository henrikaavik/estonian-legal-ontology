    {
      "@id": "estleg:Reg_1061945_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Lasteaia rahastamine ja vara",
        "@language": "et"
      },
      "estleg:sourceAct": "Rakvere Linna Lasteaia põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Vanema poolt kaetava lasteaia osalustasu kehtestab Rakvere linnavolikogu. 2(2)Lasteaia toidukulu päevamaksumuse kehtestab Rakvere linnavalitsus. 3(3)Lasteaial on Rakvere linna eelarve koosseisus oma alaeelarve. Lasteaed kasutab ja käsutab oma rahalisi vahendeid õigusaktides kehtestatud korras. 4(4)Lasteaia valitsemisel oleva vara moodustavad talle sihtotstarbeliseks kasutuseks antud maa, hooned ja rajatised ning õppe- ja kasvatustööks vajalikud vahendid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Vanema poolt kaetava lasteaia osalustasu kehtestab Rakvere linnavolikogu. 2(2)Lasteaia toidukulu päevamaksumuse kehtestab Rakvere linnavalitsus. 3(3)Lasteaial on Rakvere linna eelarve koosseisus oma alaeelarve. Lasteaed kasutab ja käsutab oma rahalisi vahendeid õigusaktides kehtestatud korras. 4(4)Lasteaia valitsemisel oleva vara moodustavad talle sihtotstarbeliseks kasutuseks antud maa, hooned ja rajatised ning õppe- ja kasvatustööks vajalikud vahendid. Varaks on ka annetustena, kingitustena ja projektides osalemisega saadud vara. Lasteaia vara valitsemine toimub Rakvere linnavolikogu ja –valitsuse õigusaktides kehtestatud korras ja tingimustel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0663"
