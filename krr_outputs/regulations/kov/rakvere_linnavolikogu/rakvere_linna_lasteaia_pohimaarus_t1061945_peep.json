      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lasteaial on Rakvere linna eelarve koosseisus oma alaeelarve. Lasteaed kasutab ja käsutab oma rahalisi vahendeid õigusaktides kehtestatud korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061945_Par_6"
