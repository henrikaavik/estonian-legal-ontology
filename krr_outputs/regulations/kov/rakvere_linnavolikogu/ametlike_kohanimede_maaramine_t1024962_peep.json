    {
      "@id": "estleg:Reg_1024962_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Isikul, kelle õigusi määrusega või haldusmenetluse käigus rikuti, on õigus esita...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Ametlike kohanimede määramine",
      "estleg:summary": {
        "@value": "Isikul, kelle õigusi määrusega või haldusmenetluse käigus rikuti, on õigus esitada vaie haldusmenetluse seaduses sätestatud korras Rakvere Linnavolikogule asukohaga Rakvere Tallinna tn 5 30 päeva jooksul, arvates päevast, millal isik vaidlustatavast määrusest või toimingust teada sai või oleks pidanud teada saama, või esitada kaebus Tartu Halduskohtule halduskohtumenetluse seadustikus sätestatud korras ja tingimustel.",
        "@language": "et"
      },
      "estleg:legalText": "Isikul, kelle õigusi määrusega või haldusmenetluse käigus rikuti, on õigus esitada vaie haldusmenetluse seaduses sätestatud korras Rakvere Linnavolikogule asukohaga Rakvere Tallinna tn 5 30 päeva jooksul, arvates päevast, millal isik vaidlustatavast määrusest või toimingust teada sai või oleks pidanud teada saama, või esitada kaebus Tartu Halduskohtule halduskohtumenetluse seadustikus sätestatud korras ja tingimustel.",
