      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Rakvere Muusikakooli õppetasu",
        "@language": "et"
      },
      "estleg:sourceAct": "Rakvere Muusikakooli ja Rakvere Spordikooli õppetasu kehtestamine",
      "estleg:summary": {
        "@value": "Rakvere Muusikakoolis on alates 1. septembrist 2024. a õppetasu suurus ühes kuus: 1 1) põhiõppe õppesuund 30 eurot; 2 2) huviõppe õppesuund 30 eurot; 3 3) lisapill (üks tund nädalas Rakvere Muusikakooli õppurile) 10 eurot; 4 4) eelklass 20 eurot; 5 5) eelklass pilliõppega 30 eurot; 6 6) laulustuudio 20 eurot; 7 7) laulustuudio (Rakvere Muusikakooli õppurile) 15 eurot; 8 8) vabaõppe õppesuund 55 eurot. RT IV2024-08-31114310820240112024-09-03",
        "@language": "et"
      },
      "estleg:legalText": "Rakvere Muusikakoolis on alates 1. septembrist 2024. a õppetasu suurus ühes kuus: 1 1) põhiõppe õppesuund 30 eurot; 2 2) huviõppe õppesuund 30 eurot; 3 3) lisapill (üks tund nädalas Rakvere Muusikakooli õppurile) 10 eurot; 4 4) eelklass 20 eurot; 5 5) eelklass pilliõppega 30 eurot; 6 6) laulustuudio 20 eurot; 7 7) laulustuudio (Rakvere Muusikakooli õppurile) 15 eurot; 8 8) vabaõppe õppesuund 55 eurot. RT IV2024-08-31114310820240112024-09-03",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_linnavolikogu"
      },
