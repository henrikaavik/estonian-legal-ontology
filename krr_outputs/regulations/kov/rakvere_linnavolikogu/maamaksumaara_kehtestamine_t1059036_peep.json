          "@id": "estleg:Reg_1059036_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1059036_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Rakvere linnas alates 1. jaanuarist 2025. a maamaksumäärad järgmiselt: 1) elamumaa ja maatulundusmaa õuemaa kõlviku puhul 0,5% maa maksustamishinnast aastas; 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5% maa maksustamishinnast aastas; 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 1% maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059036_Par_1"
      },
