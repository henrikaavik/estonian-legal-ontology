      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Rakvere linnas alates 1. jaanuarist 2025. a maamaksumäärad järgmiselt:11) elamumaa ja maatulundusmaa õuemaa kõlviku puhul 0,5% maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5% maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 1% maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Rakvere linnas alates 1. jaanuarist 2025. a maamaksumäärad järgmiselt:11) elamumaa ja maatulundusmaa õuemaa kõlviku puhul 0,5% maa maksustamishinnast aastas;22) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5% maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 1% maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0663"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059036_Map"
      },
      "estleg:hasSubsection": [
