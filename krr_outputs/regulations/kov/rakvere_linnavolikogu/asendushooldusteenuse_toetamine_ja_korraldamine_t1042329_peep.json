      "estleg:summary": {
        "@value": "Määrus sätestab Rakvere linna eelarvest asendushoolduseteenuse toetuse andmise tingimused ja Rakvere linna korraldatava asendushooldusteenuse osutamise põhimõtted.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus sätestab Rakvere linna eelarvest asendushoolduseteenuse toetuse andmise tingimused ja Rakvere linna korraldatava asendushooldusteenuse osutamise põhimõtted.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rakvere_linnavolikogu"
      },
