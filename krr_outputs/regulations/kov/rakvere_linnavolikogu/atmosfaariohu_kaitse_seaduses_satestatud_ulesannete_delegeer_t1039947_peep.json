      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Atmosfääriõhu kaitse seaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Atmosfääriõhu kaitse seaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1(1)Atmosfääriõhu kaitse seaduse §-s 63, § 66 lõikes 1, § 73 lõigetes 2 ja 3, §-s 75, § 103 lõikes 3, §-s 109, § 225 lõikes 3, § 250 lõikes 1 sätestatud kohaliku omavalitsuse üksuse ülesannete täitmine delegeeritakse Rakvere linnavalitsusele. 2(2)Rakvere linnavalitsus võib haldusmenetluse seaduse § 8 lõike 2 alusel määrata ametniku või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 sätestatud ülesannete täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Atmosfääriõhu kaitse seaduse §-s 63, § 66 lõikes 1, § 73 lõigetes 2 ja 3, §-s 75, § 103 lõikes 3, §-s 109, § 225 lõikes 3, § 250 lõikes 1 sätestatud kohaliku omavalitsuse üksuse ülesannete täitmine delegeeritakse Rakvere linnavalitsusele. 2(2)Rakvere linnavalitsus võib haldusmenetluse seaduse § 8 lõike 2 alusel määrata ametniku või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 sätestatud ülesannete täitmine.",
