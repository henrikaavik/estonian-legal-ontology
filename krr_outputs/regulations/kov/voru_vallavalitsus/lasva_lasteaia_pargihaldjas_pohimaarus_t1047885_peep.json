    {
      "@id": "estleg:Reg_1047885_Par_3_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3<sup>1</sup>.",
      "rdfs:label": {
        "@value": "§ 3<sup>1</sup>. Õppe- ja kasvatuskorraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Lasva Lasteaia Pargihaldjas põhimäärus",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047885_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Lasteaias toimub õppe- ja kasvatustegevus eesti keeles. Paikkondliku pärimuskultuuri väärtustamiseks ja edasikandmiseks kasutatakse lasteaias lisaks eesti keelele võru keelt. Võru keele kasutamine rühmas ühe või enam päeva ulatuses nädalas toimub vastavalt rühma töökorraldusele ja kokkuleppele lapsevanematega. 2 (2) Lapse lasteaeda vastuvõtmine ja sealt väljaarvamine toimub vallavalitsuse kehtestatud korras.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lasteaias toimub õppe- ja kasvatustegevus eesti keeles. Paikkondliku pärimuskultuuri väärtustamiseks ja edasikandmiseks kasutatakse lasteaias lisaks eesti keelele võru keelt. Võru keele kasutamine rühmas ühe või enam päeva ulatuses nädalas toimub vastavalt rühma töökorraldusele ja kokkuleppele lapsevanematega. 2 (2) Lapse lasteaeda vastuvõtmine ja sealt väljaarvamine toimub vallavalitsuse kehtestatud korras. 3 (3) Lasteaia lahtiolekuaja otsustab vallavalitsus direktori ettepanekul, mille kohta on arvamust avaldanud hoolekogu. RT IV 2026-07-28 1 428072026001 2026-09-01 5",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1047885_Par_3_3_Lg_1"
        },
        {
          "@id": "estleg:Reg_1047885_Par_3_3_Lg_2"
        },
        {
          "@id": "estleg:Reg_1047885_Par_3_3_Lg_3"
        }
      ]
    },
