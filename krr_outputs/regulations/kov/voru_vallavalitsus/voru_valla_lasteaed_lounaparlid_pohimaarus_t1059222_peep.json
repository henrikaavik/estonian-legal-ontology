    {
      "@id": "estleg:Reg_1059222_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lasteaed on Võru vallavalitsuse kui ametiasutuse (edaspidi ametiasutus) hallatav asutus. Lasteaed võimaldab lastele hoidu ja alushariduse omandamist vastavalt alushariduse riiklikule õppekavale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059222_Par_1"
      },
      "rdfs:label": "§ 1 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
