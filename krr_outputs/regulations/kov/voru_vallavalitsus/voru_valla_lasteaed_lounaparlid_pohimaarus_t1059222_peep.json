      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lasteaia eelarve tulud moodustuvad eraldisetest riigi ja valla eelarvest, lastevanemate poolt kaetavast osast, annetustest, lasteaia tasulise tegevuse tuludest ja muudest tuludest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059222_Par_14"
      },
      "rdfs:label": "§ 14 lg 3"
    },
