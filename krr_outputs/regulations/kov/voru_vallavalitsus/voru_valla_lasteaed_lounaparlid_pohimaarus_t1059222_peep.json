    {
      "@id": "estleg:Reg_1059222_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lasteaed tegutseb kolmes õppekohas. Lasteaia õppekohad on: 1) Väimela maja aadressil Matussaare tee 5, Väimela alevik, Võru vald, Võru maakond; 2) Parksepa maja, mis tegutseb aadressil Kesk tn 9, Parksepa, Võru vald, Võru maakond; 3) Sõmerpalu maja, mis tegutseb aadressil Pargi tn 8, Sõmerpalu alevik, Võru vald, Võru maakond.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059222_Par_1"
