        }
      ]
    },
    {
      "@id": "estleg:Reg_1059222_Par_1_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Lasteaed juhindub oma tegevuses alusharidusseaduses sätestatust ja teistest Eesti Vabariigi õigusaktidest, Võru Vallavolikogu (edaspidi vallavolikogu) ja Võru Vallavalitsuse (edaspidi vallavalitsus) õigusaktidest ning käesolevast põhimäärusest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059222_Par_1"
      },
      "rdfs:label": "§ 1 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_voru_vallavolikogu"
        },
        {
          "@id": "estleg:Issuer_voru_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1059222_Par_1_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Lasteaial võib olla oma nimetusega pitsat, logo ja sümboolika. Sümboolika kasutamise kord kinnitatakse lasteaia direktori (edaspidi direktor) käskkirjaga.",
