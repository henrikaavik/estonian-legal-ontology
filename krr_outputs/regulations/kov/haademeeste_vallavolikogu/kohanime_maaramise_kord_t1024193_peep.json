      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Otsusest teavitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Vallavalitsus saadab kohanime määramise õigusakti kümne päeva jooksul kohanimenõukogule ja riikliku kohanimeregistri volitatud töötlejale. 2 (2) Vallavalitsus annab kohanime määramisest avalikkusele teada valla ametlikul kodulehel ja kohanime määramise aluseks oleva õigusakti väljapanekuga vallavalitsuse kantseleis.",
        "@language": "et"
      },
