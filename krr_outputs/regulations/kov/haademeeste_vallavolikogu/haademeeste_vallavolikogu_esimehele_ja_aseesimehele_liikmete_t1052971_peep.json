        "@id": "estleg:Reg_1052971_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:itemNumber": [
        "1",
        "2"
      ],
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_haademeeste_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1052971_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Arvestust vallavolikogu liikmete vallavolikogu istungist osavõtu kohta peab vallasekretär, võttes aluseks vallavolikogu istungi protokolli lisaks oleva kohaloleku registreerimislehe.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052971_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:assertionConfidence": {
