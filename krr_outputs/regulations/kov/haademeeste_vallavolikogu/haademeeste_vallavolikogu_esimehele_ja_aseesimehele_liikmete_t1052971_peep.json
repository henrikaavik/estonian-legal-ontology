    {
      "@id": "estleg:Reg_1052971_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Tasu või hüvitise maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Häädemeeste Vallavolikogu esimehele ja aseesimehele, liikmetele ja alatiste komisjonide esimeestele tasu või hüvitise suuruse määramise ja maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määruse paragrahvis 2 nimetatud tasu või hüvitis makstakse välja arvestuskuule järgneva kuu 10. kuupäevaks. 2 (2) Tasu või hüvitist ei maksta: 1 1) kui vallavolikogu liige on esitanud kirjaliku avalduse sellest loobumiseks; 2 2) vallavolikogu istungist mitte osavõtnud vallavolikogu liikmele. 3 (3) Arvestust vallavolikogu liikmete vallavolikogu istungist osavõtu kohta peab vallasekretär, võttes aluseks vallavolikogu istungi protokolli lisaks oleva kohaloleku registreerimislehe.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määruse paragrahvis 2 nimetatud tasu või hüvitis makstakse välja arvestuskuule järgneva kuu 10. kuupäevaks. 2 (2) Tasu või hüvitist ei maksta: 1 1) kui vallavolikogu liige on esitanud kirjaliku avalduse sellest loobumiseks; 2 2) vallavolikogu istungist mitte osavõtnud vallavolikogu liikmele. 3 (3) Arvestust vallavolikogu liikmete vallavolikogu istungist osavõtu kohta peab vallasekretär, võttes aluseks vallavolikogu istungi protokolli lisaks oleva kohaloleku registreerimislehe.",
