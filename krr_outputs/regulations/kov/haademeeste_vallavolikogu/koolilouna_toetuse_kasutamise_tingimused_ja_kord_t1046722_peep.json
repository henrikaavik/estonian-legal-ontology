        }
      ]
    },
    {
      "@id": "estleg:Reg_1046722_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrus reguleerib riigieelarvest Häädemeeste valla eelarvesse koolilõuna toetuseks eraldatud vahendite (edaspidi koolilõuna toetus) kasutamist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046722_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1046722_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna kulude katmise kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Riigieelarvelist koolilõuna toetust kasutatakse Häädemeeste valla haldusterritooriumil asuvates koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Eraldisest üle jäävate vahendite korral on lubatud nimetatud vahendeid kasutada koolisööklate ülalpidamiskulude katteks, samuti toitlustamiseks lastelaagrites ja õpilasüritustel 3(3)Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Riigieelarvelist koolilõuna toetust kasutatakse Häädemeeste valla haldusterritooriumil asuvates koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Eraldisest üle jäävate vahendite korral on lubatud nimetatud vahendeid kasutada koolisööklate ülalpidamiskulude katteks, samuti toitlustamiseks lastelaagrites ja õpilasüritustel 3(3)Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavolikogu"
      },
