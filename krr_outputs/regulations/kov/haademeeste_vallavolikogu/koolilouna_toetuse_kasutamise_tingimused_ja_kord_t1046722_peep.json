      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrus reguleerib riigieelarvest Häädemeeste valla eelarvesse koolilõuna toetuseks eraldatud vahendite (edaspidi koolilõuna toetus) kasutamist.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus reguleerib riigieelarvest Häädemeeste valla eelarvesse koolilõuna toetuseks eraldatud vahendite (edaspidi koolilõuna toetus) kasutamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0214"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046722_Map"
      },
