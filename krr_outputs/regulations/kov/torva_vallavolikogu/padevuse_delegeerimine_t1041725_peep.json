      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Sotsiaalhoolekande seaduses sätestatud ülesannete täitmise delegeerimine",
      "estleg:sourceAct": "Pädevuse delegeerimine",
