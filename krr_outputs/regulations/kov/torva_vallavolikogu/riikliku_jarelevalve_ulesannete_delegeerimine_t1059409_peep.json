    {
      "@id": "estleg:Reg_1059409_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Riikliku järelevalve ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Riikliku järelevalve ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1(1) Tõrva Vallavalitsusele delegeeritakse seadusega kohaliku omavalitsuse, kohaliku omavalitsuse üksuse ja kohaliku omavalitsusorgani pädevusse antud riikliku järelevalve ülesannete täitmine. 2(2) Tõrva Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud riikliku järelevalve ülesannete täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Tõrva Vallavalitsusele delegeeritakse seadusega kohaliku omavalitsuse, kohaliku omavalitsuse üksuse ja kohaliku omavalitsusorgani pädevusse antud riikliku järelevalve ülesannete täitmine. 2(2) Tõrva Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud riikliku järelevalve ülesannete täitmine.",
