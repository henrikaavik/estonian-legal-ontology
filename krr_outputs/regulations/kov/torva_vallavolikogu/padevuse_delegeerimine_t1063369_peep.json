      "rdfs:label": {
        "@value": "§ 1. Alusharidusseaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pädevuse delegeerimine",
      "estleg:summary": {
        "@value": "Alusharidusseaduses sätestatud lasteaia pidaja ja kohaliku omavalitsuse üksuse või lasteaia pidaja pädevusse antud ülesannete täitmine delegeeritakse Tõrva Vallavalitsusele, välja arvatud § 16 lõigetes 1, 2 ja 4, § 17 lõikes 1, § 19 lõikes 3, § 20 lõikes 2, § 41 lõikes 2 ja § 46 lõikes 4 sätestatud ülesanded, mis jäävad volikogu pädevusse.",
        "@language": "et"
      },
      "estleg:legalText": "Alusharidusseaduses sätestatud lasteaia pidaja ja kohaliku omavalitsuse üksuse või lasteaia pidaja pädevusse antud ülesannete täitmine delegeeritakse Tõrva Vallavalitsusele, välja arvatud § 16 lõigetes 1, 2 ja 4, § 17 lõikes 1, § 19 lõikes 3, § 20 lõikes 2, § 41 lõikes 2 ja § 46 lõikes 4 sätestatud ülesanded, mis jäävad volikogu pädevusse.",
