      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärad, maamaksu tõusu piirmäär ja kodualuse maa maksusoodustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade, maamaksu tõusu piirmäära ja kodualuse maa maksusoodustuse kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Kehtestada Tõrva valla haldusterritooriumil maamaksumäärad järgmiselt:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõikes 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas. 2(2)Kehtestada Tõrva valla haldusterritooriumil maamaksu aastase suurenemise maksimaalseks piirmääraks 10%.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kehtestada Tõrva valla haldusterritooriumil maamaksumäärad järgmiselt:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõikes 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas. 2(2)Kehtestada Tõrva valla haldusterritooriumil maamaksu aastase suurenemise maksimaalseks piirmääraks 10%. 3(3)Kehtestada Tõrva valla haldusterritooriumil kodualuse maa maksusoodustuseks 50 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061877_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1061877_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_1061877_Par_1_Lg_2"
        },
        {
          "@id": "estleg:Reg_1061877_Par_1_Lg_3"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061877_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Tõrva valla haldusterritooriumil maamaksumäärad järgmiselt: 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2) käesoleva lõikes 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061877_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1061877_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kehtestada Tõrva valla haldusterritooriumil maamaksu aastase suurenemise maksimaalseks piirmääraks 10%.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061877_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1061877_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kehtestada Tõrva valla haldusterritooriumil kodualuse maa maksusoodustuseks 50 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061877_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
