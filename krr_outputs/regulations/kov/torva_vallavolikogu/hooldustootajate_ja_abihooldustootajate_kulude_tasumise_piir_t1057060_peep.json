      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Hooldustöötajate ja abihooldustöötajate kulude tasumise piirmäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hooldustöötajate ja abihooldustöötajate kulude tasumise piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 500 eurot ühe teenusesaaja kohta kuus.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 500 eurot ühe teenusesaaja kohta kuus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057060_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1057060_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1057060_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 500 eurot ühe teenusesaaja kohta kuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1057060_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
