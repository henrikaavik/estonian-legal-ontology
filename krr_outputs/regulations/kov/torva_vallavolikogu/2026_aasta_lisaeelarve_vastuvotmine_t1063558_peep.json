          "@id": "estleg:Reg_1063558_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063558_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Võtta vastu Tõrva valla 2026. aasta lisaeelarve vastavalt käesoleva määruse lisale järgmiselt: 1) põhitegevuse tulud summas 41 307,00 eurot; 2) põhitegevuse kulud summas 41 307,00 eurot; 3) põhitegevuse kulude ning investeerimistegevuse jaotus tegevusalade järgi summas 41 307,00 eurot.",
