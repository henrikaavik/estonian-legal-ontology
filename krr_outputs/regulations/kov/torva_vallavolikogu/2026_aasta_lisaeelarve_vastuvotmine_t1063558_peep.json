      },
      "estleg:summary": {
        "@value": "Võtta vastu Tõrva valla 2026. aasta lisaeelarve vastavalt käesoleva määruse lisale järgmiselt:11) põhitegevuse tulud summas 41 307,00 eurot;22) põhitegevuse kulud summas 41 307,00 eurot;33) põhitegevuse kulude ning investeerimistegevuse jaotus tegevusalade järgi summas 41 307,00 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Võtta vastu Tõrva valla 2026. aasta lisaeelarve vastavalt käesoleva määruse lisale järgmiselt:11) põhitegevuse tulud summas 41 307,00 eurot;22) põhitegevuse kulud summas 41 307,00 eurot;33) põhitegevuse kulude ning investeerimistegevuse jaotus tegevusalade järgi summas 41 307,00 eurot.",
      "estleg:hasSubsection": [
