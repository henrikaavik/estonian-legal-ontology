      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Haridustoetus kooli edukal lõpetamisel",
        "@language": "et"
      },
      "estleg:sourceAct": "Haridusalase tunnustamise kord",
      "estleg:summary": {
        "@value": "1(1) Haridustoetus kooli eduka lõpetamise eest määratakse Tõrva valla üldhariduskooli ja huvikooli õpilasele või Tõrva valla elanikeregistris olevale üldhariduskooli ja huvikooli õpilasele, kes õppis väljaspool Tõrva valda, järgmiselt:11) gümnaasiumi kuldmedaliga lõpetamisel 150 eurot;22) gümnaasiumi hõbemedaliga lõpetamisel 100 eurot;33) põhikooli kiitusega lõpetamisel 50 eurot;44) huvikooli põhiõppe kiitusega lõpetamisel 50 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Haridustoetus kooli eduka lõpetamise eest määratakse Tõrva valla üldhariduskooli ja huvikooli õpilasele või Tõrva valla elanikeregistris olevale üldhariduskooli ja huvikooli õpilasele, kes õppis väljaspool Tõrva valda, järgmiselt:11) gümnaasiumi kuldmedaliga lõpetamisel 150 eurot;22) gümnaasiumi hõbemedaliga lõpetamisel 100 eurot;33) põhikooli kiitusega lõpetamisel 50 eurot;44) huvikooli põhiõppe kiitusega lõpetamisel 50 eurot. 2(2) Haridustoetuse määramiseks Tõrva valla üldhariduskooli ja huvikooli õpilasele esitab kooli direktor Tõrva Vallavalitsusele ettepaneku, mis peab sisaldama kõiki haridustoetuse määramiseks ja väljamaksmiseks vajalikke andmeid. 3(3) Haridustoetuse määramiseks Tõrva valla elanikeregistris olevale üldhariduskooli ja huvikooli õpilasele, kes õppis väljaspool Tõrva valda, esitab toetust saama õigustatud isik või tema esindaja vallavalitsusele avalduse, mis peab sisaldama kõiki haridustoetuse määramiseks ja väljamaksmiseks vajalikke andmeid. 4(4) Haridustoetus määratakse Tõrva Vallavalitsuse korraldusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
