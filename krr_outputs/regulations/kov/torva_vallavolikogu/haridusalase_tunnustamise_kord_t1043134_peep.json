        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Tunnustamine üleriigilisel olümpiaadil või konkursil edukal esinemisel",
        "@language": "et"
      },
      "estleg:sourceAct": "Haridusalase tunnustamise kord",
      "estleg:summary": {
        "@value": "1(1) Tartu Ülikooli teaduskooli poolt koordineeritud üleriigilisel olümpiaadil või üleriigilisel konkursil edukalt esinenud Tõrva valla üldhariduskooli, koolieelse lasteasutuse ja huvikooli õpilast/last/võistkonda ja tema juhendajat tunnustatakse õppeaasta lõpul toimuval üritusel. 2(2) Õpilase/lapse/võistkonna ja tema juhendaja tunnustamiseks esitab haridusasutuse juht Tõrva Vallavalitsusele vastava ettepaneku.",
        "@language": "et"
      },
