        }
      ]
    },
    {
      "@id": "estleg:Reg_1063368_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Õppimiskohustuse seire hõlmab õppimiskohustuse mittetäitjaid ja väljalangemisohus õpilasi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063368_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1063368_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Tõrva valla hallatava üldhariduskooli direktor määrab töötaja, kes korraldab õppimiskohustusega seotud teabevahetuse vallavalitsusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063368_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_torva_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063368_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Õppimiskohustuse täitmise seiret vallavalitsuses koordineerib haridusspetsialist, kes: 1) saab EHIS-sse kantud väljalangemisohus õpilase kohta teate; 2) võtab juhtumi menetlusse ja teavitab kooli ning lapsevanemaid juhtumimenetluse alustamisest, menetleb juhtumeid; 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete rakendamise osas, kaasates juhtumipõhiselt lapse seaduslikud esindaja(d) või eestkostja, teisi valla spetsialiste, sh tugispetsialiste, valdkonnaüleseid spetsialiste; 4) lisab juhtumi lõpetamisel EHIS-sse juhtumi lõpetamise kuupäeva.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063368_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_torva_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063368_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kui õppimiskohustuslik laps õpib väljaspool elukohajärgset omavalitsust, tehakse koostööd tema kooli ja/või vastava omavalitsusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063368_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
