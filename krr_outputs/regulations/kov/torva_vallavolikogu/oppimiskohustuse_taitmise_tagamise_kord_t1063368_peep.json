      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Käesoleva määrusega kehtestatakse rahvastikuregistri andmetel Tõrva vallas elavate õppimiskohustuslike laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöö korraldus. 2(2)Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses koolis või teises omavalitsuses asuvas koolis.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Käesoleva määrusega kehtestatakse rahvastikuregistri andmetel Tõrva vallas elavate õppimiskohustuslike laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöö korraldus. 2(2)Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses koolis või teises omavalitsuses asuvas koolis.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
