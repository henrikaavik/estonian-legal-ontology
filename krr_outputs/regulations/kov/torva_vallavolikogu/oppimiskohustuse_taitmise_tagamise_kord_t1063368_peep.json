    {
      "@id": "estleg:Reg_1063368_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppimiskohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Õppimiskohustus on õpilase kohustus osaleda põhi-, kesk- või kutsehariduse õppes ning omandada enda arenguks vajalikud teadmised, oskused ja pädevused. Kui õpilane ei ole pärast põhikooli lõpetamist asunud õppima gümnaasiumis või kutseõppes, saab ta õppimiskohustust täita/jätkata ettevalmistavas õppes, mis on mõeldud põhihariduse omandanud õppimiskohustuse eas noortele ning võimaldab omandada õpingute jätkamiseks vajalikud kompetentsid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Õppimiskohustus on õpilase kohustus osaleda põhi-, kesk- või kutsehariduse õppes ning omandada enda arenguks vajalikud teadmised, oskused ja pädevused. Kui õpilane ei ole pärast põhikooli lõpetamist asunud õppima gümnaasiumis või kutseõppes, saab ta õppimiskohustust täita/jätkata ettevalmistavas õppes, mis on mõeldud põhihariduse omandanud õppimiskohustuse eas noortele ning võimaldab omandada õpingute jätkamiseks vajalikud kompetentsid. 2(2)Õppimiskohustus on õpilasel, kes on saanud enne käimasoleva aasta 1. oktoobrit seitsmeaastaseks. Õpilasel on õppimiskohustus 18-aastaseks saamiseni. Õppimiskohustus loetakse täidetuks enne 18-aastaseks saamist juhul, kui õpilane on omandanud kesk- või kutsehariduse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
