      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Sõidukulude hüvitamise ulatus",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilaste sõidukulude hüvitamise kord",
      "estleg:summary": {
        "@value": "Sõiduhüvitist makstakse väljaspool Tõrva valla haldusterritooriumi päevases õppevormis õppivale alg-, põhi- või keskharidust omandavale rahvastikuregistri andmetel Tõrva vallas elavale õpilasele ühistranspordi sõidupiletite alusel, kuid mitte rohkem kui 50 eurot kuus ühe õpilase kohta.",
        "@language": "et"
      },
      "estleg:legalText": "Sõiduhüvitist makstakse väljaspool Tõrva valla haldusterritooriumi päevases õppevormis õppivale alg-, põhi- või keskharidust omandavale rahvastikuregistri andmetel Tõrva vallas elavale õpilasele ühistranspordi sõidupiletite alusel, kuid mitte rohkem kui 50 eurot kuus ühe õpilase kohta.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043989_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1043989_Par_3_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043989_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Sõiduhüvitist makstakse väljaspool Tõrva valla haldusterritooriumi päevases õppevormis õppivale alg-, põhi- või keskharidust omandavale rahvastikuregistri andmetel Tõrva vallas elavale õpilasele ühistranspordi sõidupiletite alusel, kuid mitte rohkem kui 50 eurot kuus ühe õpilase kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043989_Par_3"
      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1043989_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Sõidukulude hüvitamise taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilaste sõidukulude hüvitamise kord",
      "estleg:summary": {
        "@value": "1 (1) Sõidukulude hüvitise saamiseks tuleb käesoleva korra § 2 lõikes 2 nimetatud isikul esitada Tõrva Vallavalitsusele vormikohane taotlus hiljemalt järgmise kuu 15. kuupäevaks. Taotluse vorm on määruse lisa. 2 (2) Taotlusele lisatakse sõitu tõendavad dokumendid, sh. ühistranspordi sõidupiletid, kus on loetavad kuupäev, maksumus, lähte- ja sihtkoht. Õppeaasta algul tuleb taotlusele lisada kooli tõend. Vallavalitsus võib nõuda kulutuste põhjendatuse kontrollimiseks muid täiendavaid dokumente.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Sõidukulude hüvitise saamiseks tuleb käesoleva korra § 2 lõikes 2 nimetatud isikul esitada Tõrva Vallavalitsusele vormikohane taotlus hiljemalt järgmise kuu 15. kuupäevaks. Taotluse vorm on määruse lisa. 2 (2) Taotlusele lisatakse sõitu tõendavad dokumendid, sh. ühistranspordi sõidupiletid, kus on loetavad kuupäev, maksumus, lähte- ja sihtkoht. Õppeaasta algul tuleb taotlusele lisada kooli tõend. Vallavalitsus võib nõuda kulutuste põhjendatuse kontrollimiseks muid täiendavaid dokumente. 3 (3) Taotluses sisalduvate andmete muutumise korral on taotleja kohustatud viivitamatult sellest vallavalitsusele teatama. 4 (4) Sõidusoodustuse taotleja vastutab esitatud andmete ja dokumentide õigsuse eest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_torva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0824"
