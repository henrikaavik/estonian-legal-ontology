      "rdfs:label": {
        "@value": "§ 6. Sõidukulude hüvitamata jätmine või osaline hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õpilaste sõidukulude hüvitamise kord",
      "estleg:summary": {
        "@value": "Tõrva Vallavalitsus võib jätta sõidukulud hüvitamata või hüvitada osaliselt, kui: 1 1) kooli esitatud andmete ja sõidupiletite alusel selgub, et õpilane ei ole kasutanud transporti kooli ja koju sõiduks; 2 2) taotleja on esitanud valeandmeid.",
