      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Munitsipaallasteaedade õpetajate töötasu alammäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Rapla valla munitsipaallasteaedade õpetajate töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "Rapla valla munitsipaallasteaedade õpetajate töötasu alammäärad täistööajaga töötamise korral on järgmised: 1 1) kehtivatele kvalifikatsiooninõuetele vastava magistrikraadiga või sellega võrdsustatud tasemega või alusharidusseaduse § 54 lõike 2 alusel vastavaks loetud lasteaiaõpetajate töötasu alammäär on võrdne Vabariigi Valitsuse kehtestatud üldhariduskooli õpetaja töötasu alammääraga; 2 2) kehtivatele kvalifikatsiooninõuetele vastava muu haridusega või alusharidusseaduse § 54 lõike 2 alusel…",
        "@language": "et"
      },
      "estleg:legalText": "Rapla valla munitsipaallasteaedade õpetajate töötasu alammäärad täistööajaga töötamise korral on järgmised: 1 1) kehtivatele kvalifikatsiooninõuetele vastava magistrikraadiga või sellega võrdsustatud tasemega või alusharidusseaduse § 54 lõike 2 alusel vastavaks loetud lasteaiaõpetajate töötasu alammäär on võrdne Vabariigi Valitsuse kehtestatud üldhariduskooli õpetaja töötasu alammääraga; 2 2) kehtivatele kvalifikatsiooninõuetele vastava muu haridusega või alusharidusseaduse § 54 lõike 2 alusel vastavaks loetud lasteaiaõpetajate töötasu alammäär on vähemalt 90% Vabariigi Valitsuse kehtestatud üldhariduskooli õpetaja töötasu alammäärast.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0668"
