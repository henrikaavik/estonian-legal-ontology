      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tagatise võtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Rapla Keskraamatukogu tagatise võtmise ja tagastamise kord",
      "estleg:summary": {
        "@value": "Raamatukogu võib lugejalt nõuda teaviku kojulaenutamisel tagatist, kui: 1 1) Rapla Keskraamatukogu (Rapla linnas) lugeja rahvastikuregistrijärgne elukoht ei ole Rapla maakonnas; 2 2) harukogude ja välisteeninduspunkti lugeja rahvastikuregistrijärgne elukoht ei ole Rapla vallas; 3 3) see on vajalik teaviku väärtuse tõttu.",
        "@language": "et"
      },
      "estleg:legalText": "Raamatukogu võib lugejalt nõuda teaviku kojulaenutamisel tagatist, kui: 1 1) Rapla Keskraamatukogu (Rapla linnas) lugeja rahvastikuregistrijärgne elukoht ei ole Rapla maakonnas; 2 2) harukogude ja välisteeninduspunkti lugeja rahvastikuregistrijärgne elukoht ei ole Rapla vallas; 3 3) see on vajalik teaviku väärtuse tõttu.",
