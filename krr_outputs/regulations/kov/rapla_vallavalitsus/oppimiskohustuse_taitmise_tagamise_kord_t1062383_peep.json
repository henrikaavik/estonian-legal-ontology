    {
      "@id": "estleg:Reg_1062383_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse õppimiskohustuslike isikute õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062383_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1062383_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrust rakendatakse kõigile Eesti rahvastikuregistri andmetel Rapla vallas elavatele õppimiskohustuslikele isikutele, kes õpivad elukohajärgses või teises kohaliku omavalitsuse üksuses asuvas haridusasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062383_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1062383_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppimiskohustuse mittetäitmise ja õppest väljalangemisohu seire",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1 (1) Haridusasutus korraldab kogu õppeaasta vältel igakuiselt õpilase õppimiskohustuse mittetäitmise ja õppest väljalangemisohu seiret. Seiret viib läbi haridusasutuse määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) õpilase põhjendamata puudumised õppetööst; 2 2) õpilase õpivõlgnevused; 3 3) õpetaja ja/või tugispetsialisti hinnanguid sekkumisvajaduse kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Haridusasutus korraldab kogu õppeaasta vältel igakuiselt õpilase õppimiskohustuse mittetäitmise ja õppest väljalangemisohu seiret. Seiret viib läbi haridusasutuse määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) õpilase põhjendamata puudumised õppetööst; 2 2) õpilase õpivõlgnevused; 3 3) õpetaja ja/või tugispetsialisti hinnanguid sekkumisvajaduse kohta. 2 (2) Õpilase suhtes kohaldatakse põhikooli- ja gümnaasiumiseaduses ja haridusasutuse kodukorras sätestatud asjakohaseid tugimeetmeid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0668"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062383_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1062383_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1062383_Par_2_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1062383_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Haridusasutus korraldab kogu õppeaasta vältel igakuiselt õpilase õppimiskohustuse mittetäitmise ja õppest väljalangemisohu seiret. Seiret viib läbi haridusasutuse määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1) õpilase põhjendamata puudumised õppetööst; 2) õpilase õpivõlgnevused; 3) õpetaja ja/või tugispetsialisti hinnanguid sekkumisvajaduse kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062383_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1062383_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Õpilase suhtes kohaldatakse põhikooli- ja gümnaasiumiseaduses ja haridusasutuse kodukorras sätestatud asjakohaseid tugimeetmeid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062383_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1062383_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Juhtumi menetlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1 (1) Kui haridusasutuses kohaldatud tugimeetmed ei ole taganud õpilase õppimiskohustuse täitmist, algatab haridusasutuse määratud isik Eesti Hariduse Infosüsteemis (edaspidi EHIS) õppest väljalangemisohuga õpilase juhtumi. 2 (2) Kui õpilane on põhjendamatult puudunud ühe trimestri jooksul vähemalt 30 protsenti õppetundidest ning haridusasutuse rakendatavad meetmed ei ole andnud soovitud tulemusi või ei ole saadud kontakti õpilase vanemaga, edastab haridusasutus õppest väljalangemisohuga…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui haridusasutuses kohaldatud tugimeetmed ei ole taganud õpilase õppimiskohustuse täitmist, algatab haridusasutuse määratud isik Eesti Hariduse Infosüsteemis (edaspidi EHIS) õppest väljalangemisohuga õpilase juhtumi. 2 (2) Kui õpilane on põhjendamatult puudunud ühe trimestri jooksul vähemalt 30 protsenti õppetundidest ning haridusasutuse rakendatavad meetmed ei ole andnud soovitud tulemusi või ei ole saadud kontakti õpilase vanemaga, edastab haridusasutus õppest väljalangemisohuga õpilase juhtumi EHIS kaudu menetlemiseks Rapla Vallavalitsusele (edaspidi vallavalitsus). 3 (3) Õppimiskohustuse täitmise seiret vallavalitsuses koordineerib haridusspetsialist, kes: 1 1) teavitab õppimiskohustusliku isiku seaduslikku esindajat juhtumimenetluse jätkamisest vallavalitsuses; 2 2) selgitab ammendavalt välja õppimiskohustuse täitmata jätmise põhjused; 3 3) korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete kohaldamiseks; 4 4) kaasab vajadusel juhtumipõhiselt valdkonnaüleseid spetsialiste. 4 (4) Kui väljalangemisohtu sattunud või õppimiskohustust mittetäitev õppimiskohustuslik isik õpib väljaspool elukohajärgset kohaliku omavalitsuse üksust, tehakse koostööd vastava kohaliku omavalitsuse üksusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapla_vallavalitsus"
      },
