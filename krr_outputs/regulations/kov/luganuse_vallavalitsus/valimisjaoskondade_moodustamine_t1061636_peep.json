    {
      "@id": "estleg:Reg_1061636_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1(1)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka valija asukohas ja ööpäevases hoolekandeasutuses. 2(2)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3(3)Kodus hääletamist korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka valija asukohas ja ööpäevases hoolekandeasutuses. 2(2)Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3(3)Kodus hääletamist korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2. Euroopa Parlamendi valimisel ja rahvahääletusel korraldavad valimisjaoskonnad nr 1 ja nr 2 ka valija asukohas hääletamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luganuse_vallavalitsus"
      },
