        },
        {
          "@id": "estleg:Institution_riigikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1061636_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061636_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1061636_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad valimisjaoskond nr 1 ja valimisjaoskond nr 2. Euroopa Parlamendi valimisel ja rahvahääletusel korraldavad valimisjaoskonnad nr 1 ja nr 2 ka valija asukohas hääletamist.",
