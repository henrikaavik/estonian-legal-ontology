          "@id": "estleg:Institution_kohalik_omavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063949_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kooli direktor määrab isiku, kelle tööülesannete hulka kuulub kooli nimekirjas olevate õppimiskohustust mitte täitvate õpilastega seotud info Lüganuse Vallavalitsusega (edaspidi vallavalitsus) vahetamise korraldamine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063949_Par_3"
      },
      "rdfs:label": "§ 3 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_luganuse_vallavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063949_Par_3_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Kool pöördub vallavalitsuse poole, kui: 1) hindamise tulemusena tuvastatakse kohaliku omavalitsuse kaasamise vajadus; 2) kooli rakendatud meetmed ei avalda mõju või neid ei ole võimalik rakendada põhjusel, et kool ei saa viie õppepäeva jooksul õpilase või seadusliku esindajaga kontakti.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063949_Par_3"
      },
      "rdfs:label": "§ 3 lg 6",
      "estleg:itemNumber": [
        "1",
