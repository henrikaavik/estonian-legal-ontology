      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui õppimiskohustuse täitmist takistab lapse abivajadus lastekaitseseaduse või sotsiaalhoolekande seaduse tähenduses, tagab vald lapse abistamise nimetatud seadustes sätestatud korras.",
      "estleg:parentProvision": {
