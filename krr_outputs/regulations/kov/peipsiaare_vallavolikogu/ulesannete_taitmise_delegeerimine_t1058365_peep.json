      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Ülesannete täitmise delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) Peipsiääre Vallavalitsusele delegeeritakse õigusaktidega kohaliku omavalitsuse, kohaliku omavalitsuse üksuse või kohaliku omavalitsuse organi pädevusse antud järgmiste ülesannete täitmine: 1 1) keskkonnaseadustiku üldosa seaduse paragrahvi 43 lõikes 2 ja 3 sätestatud ülesanded; 2 2) looduskaitseseaduse paragrahvi 9 lõikes 2 ning paragrahvi 42 lõikes 3 ja 4 sätestatud ülesanded; 3 3) veeseaduse paragrahvi 24 lõikes 4 ja paragrahvis 88 sätestatud ülesanded; 4 4) ehitusseadustikus sätestatud…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Peipsiääre Vallavalitsusele delegeeritakse õigusaktidega kohaliku omavalitsuse, kohaliku omavalitsuse üksuse või kohaliku omavalitsuse organi pädevusse antud järgmiste ülesannete täitmine: 1 1) keskkonnaseadustiku üldosa seaduse paragrahvi 43 lõikes 2 ja 3 sätestatud ülesanded; 2 2) looduskaitseseaduse paragrahvi 9 lõikes 2 ning paragrahvi 42 lõikes 3 ja 4 sätestatud ülesanded; 3 3) veeseaduse paragrahvi 24 lõikes 4 ja paragrahvis 88 sätestatud ülesanded; 4 4) ehitusseadustikus sätestatud ülesanded; 5 5) ehitusseadustiku ja planeerimisseaduse rakendamise seaduse paragrahvis 27 ja 29 sätestatud ülesanded; 6 6) planeerimisseaduse paragrahvi 128 lõikes 1 ja paragrahvi 139 lõikes 1 sätestatud ülesanded. 2 (2) Peipsiääre Vallavalitsusel on õigus määrata haldusmenetluse seaduse paragrahvi 8 lõike 2 alusel struktuuriüksus, ametnik või ametnikud, kellele volitatakse käesoleva määruse paragrahvis 1 nimetatud ülesannete täitmine.",
      "estleg:enactedBy": {
