      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Peipsiääre Vallavalitsusel on õigus diferentseerida üüri suurust võttes arvesse...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Munitsipaaleluruumi üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Peipsiääre Vallavalitsusel on õigus diferentseerida üüri suurust võttes arvesse eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega, veevarustuse ja kanalisatsiooni olemasolu, eluruumis teostatud remonte ja renoveerimisi, samuti taotleja majanduslikku olukorda.",
        "@language": "et"
      },
      "estleg:legalText": "Peipsiääre Vallavalitsusel on õigus diferentseerida üüri suurust võttes arvesse eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega, veevarustuse ja kanalisatsiooni olemasolu, eluruumis teostatud remonte ja renoveerimisi, samuti taotleja majanduslikku olukorda.",
