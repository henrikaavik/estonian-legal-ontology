    {
      "@id": "estleg:Reg_1056781_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Peipsiääre valla omandis olevate eluruumide üüri alammäär on 2 eurot ja ülemmäär...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Munitsipaaleluruumi üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Peipsiääre valla omandis olevate eluruumide üüri alammäär on 2 eurot ja ülemmäär 5 eurot kuus eluruumi üldpinna ühe ruutmeetri kohta. Nimetatud piirmäärad ei sisalda eluruumi kasutamisega seotud kõrvalkulusid (vee- ja kanalisatsiooniteenuse, kütte, elektrienergia, prügiveo jms).",
        "@language": "et"
      },
      "estleg:legalText": "Peipsiääre valla omandis olevate eluruumide üüri alammäär on 2 eurot ja ülemmäär 5 eurot kuus eluruumi üldpinna ühe ruutmeetri kohta. Nimetatud piirmäärad ei sisalda eluruumi kasutamisega seotud kõrvalkulusid (vee- ja kanalisatsiooniteenuse, kütte, elektrienergia, prügiveo jms).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_peipsiaare_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0586"
