      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Käesoleva paragrahvi lõigetes 1 - 5 loetletud eelarve muudatuste detailne sisu on esitatud käesoleva määruse lisas 1.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063742_Par_1"
      },
      "rdfs:label": "§ 1 lg 6"
    },
    {
