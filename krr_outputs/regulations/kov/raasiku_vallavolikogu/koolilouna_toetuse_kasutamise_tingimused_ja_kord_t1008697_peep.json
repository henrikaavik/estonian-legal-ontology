      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Eelarveaasta koolilõuna toetuse vabad vahendid kasutatakse põhikooli õpilaste täiendavaks ja pikapäevaõpilaste toitlustamiseks ning koolipiima vahe kompenseerimiseks.",
        "@language": "et"
      },
