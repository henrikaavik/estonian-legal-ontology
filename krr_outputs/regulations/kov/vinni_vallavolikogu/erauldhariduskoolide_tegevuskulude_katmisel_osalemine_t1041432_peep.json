    {
      "@id": "estleg:Reg_1041432_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Toetuse määr",
        "@language": "et"
      },
      "estleg:sourceAct": "Eraüldhariduskoolide tegevuskulude katmisel osalemine",
      "estleg:summary": {
        "@value": "1 (1) Erakooli pidajat toetatakse tegevuskulude katmisel proportsionaalselt selles koolis õppivate õpilaste arvuga, kelle rahvastikuregistrijärgne elukoht on Vinni valla haldusterritooriumil, 25 % ulatuses vastavalt erakooli asukoha munitsipaalkoolide õppekoha tegevuskulude keskmisest maksumusest, kuid mitte rohkem kui riiklikult kinnitatud õppekoha maksumus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Erakooli pidajat toetatakse tegevuskulude katmisel proportsionaalselt selles koolis õppivate õpilaste arvuga, kelle rahvastikuregistrijärgne elukoht on Vinni valla haldusterritooriumil, 25 % ulatuses vastavalt erakooli asukoha munitsipaalkoolide õppekoha tegevuskulude keskmisest maksumusest, kuid mitte rohkem kui riiklikult kinnitatud õppekoha maksumus. 2 (2) Erandkorras võib erakooli pidajat toetada ka lõikes 1 nimetatud määrast suuremas mahus, kui selle aluseks on vastav vallavalitsuse korraldus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vinni_vallavolikogu"
      },
