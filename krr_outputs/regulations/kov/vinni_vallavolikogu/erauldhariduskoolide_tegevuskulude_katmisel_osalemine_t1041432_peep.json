    {
      "@id": "estleg:Reg_1041432_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Toetuse andmise tingimused",
        "@language": "et"
      },
      "estleg:sourceAct": "Eraüldhariduskoolide tegevuskulude katmisel osalemine",
      "estleg:summary": {
        "@value": "(1) Vinni valla eelarvest toetatakse erakooli pidajat, kui: 1 1) tal on kehtiv tegevusluba; 2 2) tal puudub riiklike maksude võlgnevus; 3 3) õpilane õpib või alustab õppimist erakoolis käesoleva määruse kehtimise ajal; 4 4) õpilase elukoha andmetena on rahvastikuregistrisse kantud Vinni vald; 5 5) õpilase eest ei maksa täies ulatuses õppekoha tegevuskulude katmiseks toetust riik.",
        "@language": "et"
      },
      "estleg:legalText": "(1) Vinni valla eelarvest toetatakse erakooli pidajat, kui: 1 1) tal on kehtiv tegevusluba; 2 2) tal puudub riiklike maksude võlgnevus; 3 3) õpilane õpib või alustab õppimist erakoolis käesoleva määruse kehtimise ajal; 4 4) õpilase elukoha andmetena on rahvastikuregistrisse kantud Vinni vald; 5 5) õpilase eest ei maksa täies ulatuses õppekoha tegevuskulude katmiseks toetust riik.",
