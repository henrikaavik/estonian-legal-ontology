    {
      "@id": "estleg:Reg_1040913_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1040913",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. Nõuded töökogemusele",
      "estleg:sourceAct": "Ametnike haridusele, töökogemusele, teadmistele ja oskustele esitatavad nõuded",
      "estleg:summary": "1 (1) Ametniku töökogemust ja kompetentsust hinnatakse ametniku värbamisel. Ametniku töökogemust ja kompetentsust hinnatakse ametniku värbamisel. 2 (2) Ametiasutuse struktuuriüksuse juhil peab olema vähemalt 1-aastane juhtimiskogemus või 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas. Ametiasutuse struktuuriüksuse juhil peab olema vähemalt 1-aastane juhtimiskogemus või 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas.",
      "estleg:legalText": "1 (1) Ametniku töökogemust ja kompetentsust hinnatakse ametniku värbamisel. Ametniku töökogemust ja kompetentsust hinnatakse ametniku värbamisel. 2 (2) Ametiasutuse struktuuriüksuse juhil peab olema vähemalt 1-aastane juhtimiskogemus või 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas. Ametiasutuse struktuuriüksuse juhil peab olema vähemalt 1-aastane juhtimiskogemus või 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas.",
      "estleg:enactedBy": {
