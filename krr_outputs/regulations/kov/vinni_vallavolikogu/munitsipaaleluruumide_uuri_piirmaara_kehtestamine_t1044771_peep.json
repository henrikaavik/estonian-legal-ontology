      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üüri piirmäära ja kõrvalkulude mõiste",
        "@language": "et"
      },
      "estleg:sourceAct": "Munitsipaaleluruumide üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1 (1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest. 2 (2) Eluruumi üür arvestatakse üldpinna ühe ruutmeetri kohta. 3 (3) Eluruumi üüri hulka ei arvata kõrvalkulusid. 4 (4) Kõrvalkulud on tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muruniitmise, lumetõrje, maja üldelektri jm teenuste ja tegude eest, mis on seotud asja kasutamisega.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Üüri piirmäär on üürniku poolt tasutav kõrgeim tasu eluruumi kasutamise eest. 2 (2) Eluruumi üür arvestatakse üldpinna ühe ruutmeetri kohta. 3 (3) Eluruumi üüri hulka ei arvata kõrvalkulusid. 4 (4) Kõrvalkulud on tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muruniitmise, lumetõrje, maja üldelektri jm teenuste ja tegude eest, mis on seotud asja kasutamisega.",
