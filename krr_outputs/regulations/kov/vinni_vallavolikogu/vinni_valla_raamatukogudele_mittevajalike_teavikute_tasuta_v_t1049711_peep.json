      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Vinni valla raamatukogudele mittevajalike teavikute tasuta võõrandamise ja müügi kord",
      "estleg:summary": {
        "@value": "1 (1) Määrusega sätestatakse Vinni valla raamatukogudele (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamise ja müügi tingimused ning kord. 2 (2) Mittevajalikuks võib tunnistada teaviku: 1 1) mida on raamatukogus eksemplaridena rohkem, kui teenindamiseks vajalik; 2 2) mille sisu ei ole enam aktuaalne ning teaviku laenutamiseks ja kasutamiseks puudub nõudlus; 3 3) mis on heaks teenindamiseks liialt lagunenud või kasutuskõlbmatu.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega sätestatakse Vinni valla raamatukogudele (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamise ja müügi tingimused ning kord. 2 (2) Mittevajalikuks võib tunnistada teaviku: 1 1) mida on raamatukogus eksemplaridena rohkem, kui teenindamiseks vajalik; 2 2) mille sisu ei ole enam aktuaalne ning teaviku laenutamiseks ja kasutamiseks puudub nõudlus; 3 3) mis on heaks teenindamiseks liialt lagunenud või kasutuskõlbmatu. 3 (3) Mittevajalikud teavikud kustutatakse rahvaraamatukogu seaduse ja selle alusel antud õigusaktidega sätestatud korras. 4 (4) Mittevajalikud teavikud võib raamatukogu tasuta võõrandada või müüa vastavalt direktori kinnitatud kustutusaktile.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vinni_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0901"
