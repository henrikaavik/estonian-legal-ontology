      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teavikute tasuta võõrandamine ja müük",
        "@language": "et"
      },
      "estleg:sourceAct": "Vinni valla raamatukogudele mittevajalike teavikute tasuta võõrandamise ja müügi kord",
      "estleg:summary": {
        "@value": "1 (1) Tasuta võõrandamiseks eraldatud teavikuid pakutakse esmalt teistele Vinni Vallavalitsuse hallatavatele asutustele ja koostööpartneritele ning seejärel elanikele. 2 (2) Müügiks eraldatud teavikute hinna määrab kustutusaktis olevat hinda arvestades raamatukogu direktor. 3 (3) Teavikute müümisel täidetakse kviitung, millest üks jääb raamatukogule ja teine antakse ostjale.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Tasuta võõrandamiseks eraldatud teavikuid pakutakse esmalt teistele Vinni Vallavalitsuse hallatavatele asutustele ja koostööpartneritele ning seejärel elanikele. 2 (2) Müügiks eraldatud teavikute hinna määrab kustutusaktis olevat hinda arvestades raamatukogu direktor. 3 (3) Teavikute müümisel täidetakse kviitung, millest üks jääb raamatukogule ja teine antakse ostjale. 4 (4) Teavikute müügist saadud raha ja aruanne edastatakse finantsteenistusele vastavalt raamatupidamise sise-eeskirjas sätestatud korrale. 5 (5) Mittevajalikke teavikuid võib tasuta võõrandada ja müüa selleks korraldatud üritustel. 6 (6) Ruumi olemasolul on raamatukogus eraldi riiul vastavate teavikute pidevaks pakkumiseks külastajatele. 7 (7) Võõrandamata teavikud utiliseeritakse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_vinni_vallavolikogu"
      },
