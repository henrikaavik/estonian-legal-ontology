    {
      "@id": "estleg:Reg_1061431_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. [Hääletamise liigid jaoskondades (1) Euroopa Parlamendi valimistel ja rahvahäälet...]",
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": "Hääletamise liigid jaoskondades (1) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. (2) Kodus hääletamist korraldavad valimisjaoskond nr 1, valimisjaoskond nr 2 ja valimisjaoskond nr 3. Euroopa Parlamendi valimisel ja rahvahääletusel korraldab valimisjaoskond nr 1 ka valija asukohas hääletamist. (3) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset",
      "estleg:legalText": "Hääletamise liigid jaoskondades (1) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. (2) Kodus hääletamist korraldavad valimisjaoskond nr 1, valimisjaoskond nr 2 ja valimisjaoskond nr 3. Euroopa Parlamendi valimisel ja rahvahääletusel korraldab valimisjaoskond nr 1 ka valija asukohas hääletamist. (3) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Valimisjaoskond nr 1 korraldab hääletamist vajadusel ka valija asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_maardu_linnavalitsus"
