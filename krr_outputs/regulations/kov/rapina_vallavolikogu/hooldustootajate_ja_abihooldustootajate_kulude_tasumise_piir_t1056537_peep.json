      "rdfs:label": {
        "@value": "§ 1. Hooldustöötajate ja abihooldustöötajate kulude tasumise piirmäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hooldustöötajate ja abihooldustöötajate kulude tasumise piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 600 eurot ühe teenusesaaja kohta kuus. RT IV2026-05-2674260520260072026-05-29, rakendatakse alates 01.07.2026.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada väljaspool kodu osutatava ööpäevaringse üldhooldusteenuse osutamisel vahetult teenust osutavate hooldustöötajate ja abihooldustöötajate kulude tasumise piirmääraks 600 eurot ühe teenusesaaja kohta kuus. RT IV2026-05-2674260520260072026-05-29, rakendatakse alates 01.07.2026.",
