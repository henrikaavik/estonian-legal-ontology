      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Toetuse maksmise lõpetamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Eralasteaia- ja lapsehoiuteenuse toetamise kord",
      "estleg:summary": {
        "@value": "1(1)Toetuse maksmine lõpeb lapse lahkumisel eralasteaia- või lapsehoiuteenuselt. 2(2)Vallavalitsusel on õigus osaliselt või täies mahus lõpetada toetuse maksmine ja/või nõuda toetuse osalist või täielikku tagastamist, kui:11) toetust ei ole kasutatud sihtotstarbeliselt;22) toetuse taotlemisel on kasutatud valeandmeid;33) teenuse osutaja lõpetab tegevuse toetuse eraldamise perioodi kestel.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Toetuse maksmine lõpeb lapse lahkumisel eralasteaia- või lapsehoiuteenuselt. 2(2)Vallavalitsusel on õigus osaliselt või täies mahus lõpetada toetuse maksmine ja/või nõuda toetuse osalist või täielikku tagastamist, kui:11) toetust ei ole kasutatud sihtotstarbeliselt;22) toetuse taotlemisel on kasutatud valeandmeid;33) teenuse osutaja lõpetab tegevuse toetuse eraldamise perioodi kestel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
