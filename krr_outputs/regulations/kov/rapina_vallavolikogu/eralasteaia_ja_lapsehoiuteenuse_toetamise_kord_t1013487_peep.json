      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Eralasteaia- ja lapsehoiuteenuse toetamise kord",
      "estleg:summary": {
        "@value": "1(1)Käesolev kord loob täiendavad võimalused rahvastikuregistri andmetel Räpina vallas elavatele eelkooliealiste lastega peredele, et kasutada eralasteaia- ja lapsehoiuteenust. 2(2)Määrusega kehtestatakse toetuse maksmise alused, toetuse määramise ja maksmise kord.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Käesolev kord loob täiendavad võimalused rahvastikuregistri andmetel Räpina vallas elavatele eelkooliealiste lastega peredele, et kasutada eralasteaia- ja lapsehoiuteenust. 2(2)Määrusega kehtestatakse toetuse maksmise alused, toetuse määramise ja maksmise kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0708"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013487_Map"
      },
      "estleg:hasSubsection": [
