      "estleg:sourceAct": "Eralasteaia- ja lapsehoiuteenuse toetamise kord",
      "estleg:summary": {
        "@value": "Toetuse suurus on 50% Räpina valla munitsipaallasteaia õppekoha ühe kuu kehtivast maksumusest, kuid mitte suurem kui tegelik kohamaksumus lapse kohta kuus.",
        "@language": "et"
      },
      "estleg:legalText": "Toetuse suurus on 50% Räpina valla munitsipaallasteaia õppekoha ühe kuu kehtivast maksumusest, kuid mitte suurem kui tegelik kohamaksumus lapse kohta kuus.",
      "estleg:enactedBy": {
