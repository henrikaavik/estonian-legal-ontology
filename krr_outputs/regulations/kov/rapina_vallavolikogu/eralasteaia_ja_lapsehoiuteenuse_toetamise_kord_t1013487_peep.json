        }
      ]
    },
    {
      "@id": "estleg:Reg_1013487_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev kord loob täiendavad võimalused rahvastikuregistri andmetel Räpina vallas elavatele eelkooliealiste lastega peredele, et kasutada eralasteaia- ja lapsehoiuteenust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013487_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1013487_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrusega kehtestatakse toetuse maksmise alused, toetuse määramise ja maksmise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013487_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1013487_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Mõisted",
        "@language": "et"
      },
      "estleg:sourceAct": "Eralasteaia- ja lapsehoiuteenuse toetamise kord",
      "estleg:summary": {
        "@value": "1(1)Eralasteaed käesoleva korra mõistes on koolieelse lasteasutuse seaduse ja erakooliseaduse alusel tegutsev ning koolitusluba omav koolieelne eralasteasutus, lasteaed-algkool või lasteaed-põhikool (edaspidi eralasteaed). 2(2)Lapsehoiuteenuse osutaja käesoleva korra mõistes on munitsipaallapsehoiuasutus, kellele on maavanema poolt antud kehtiv tegevusluba lapsehoiuteenuse osutamiseks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Eralasteaed käesoleva korra mõistes on koolieelse lasteasutuse seaduse ja erakooliseaduse alusel tegutsev ning koolitusluba omav koolieelne eralasteasutus, lasteaed-algkool või lasteaed-põhikool (edaspidi eralasteaed). 2(2)Lapsehoiuteenuse osutaja käesoleva korra mõistes on munitsipaallapsehoiuasutus, kellele on maavanema poolt antud kehtiv tegevusluba lapsehoiuteenuse osutamiseks. 3(3)Toetuse maksmine on õigustatud lapse suhtes, kelle tegelik elukoht ja rahvastikuregistri järgne elukoht on Räpina vallas ning kelle lapsevanema või seadusliku esindaja (edaspidi lapsevanem) rahvastikuregistri järgne elukoht on Räpina vallas toetuse maksmisele eelneva aasta 31. detsembri seisuga ja jätkuvalt kogu toetuse maksmise perioodil. 4(4)Kohamaksumusena käsitletakse lasteasutuse ülalpidamise kulusid koolieelse lasteasutuse seaduse § 27 lõike 3 tähenduses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0708"
      },
