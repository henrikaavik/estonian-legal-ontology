        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Registrile alusandmete esitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "1 (1) Alusandmed deklarantide kohta esitatakse huvide deklaratsioonide registrile järgmiselt: 1 1) Vallasekretär edastab Räpina vallavolikogu liikmete andmed, Räpina vallavalitsuse liikmete ning vallavalitsuse hallatavate asutuste juhtide andmed; 2 2) Äriühingu juhatuse liige edastab valla valitseva mõju all oleva äriühingu juhtorganite liikmete andmed.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Alusandmed deklarantide kohta esitatakse huvide deklaratsioonide registrile järgmiselt: 1 1) Vallasekretär edastab Räpina vallavolikogu liikmete andmed, Räpina vallavalitsuse liikmete ning vallavalitsuse hallatavate asutuste juhtide andmed; 2 2) Äriühingu juhatuse liige edastab valla valitseva mõju all oleva äriühingu juhtorganite liikmete andmed. 2 (2) Andmed esitatakse ühe kuu jooksul deklarandi deklaratsiooni esitamise kohustuse algusest arvates ning registrit teavitatakse viivitamata deklarandi deklaratsiooni esitamise kohustuse kehtetuks tunnistamisest ja deklarandi ametikohalt lahkumisest.",
