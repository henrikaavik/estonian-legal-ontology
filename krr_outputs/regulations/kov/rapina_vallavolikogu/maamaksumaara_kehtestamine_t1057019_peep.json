      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Räpina valla territooriumil järgmised maamaksumäärad:11) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõike punktis 1 nimetamata maatulundusmaale maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Räpina valla territooriumil järgmised maamaksumäärad:11) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;22) käesoleva lõike punktis 1 nimetamata maatulundusmaale maamaksumäär 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0708"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057019_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1057019_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1057019_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Räpina valla territooriumil järgmised maamaksumäärad: 1) elamumaale ja maatulundusmaa õuemaa kõlvikule maamaksumäär 0,5 protsenti maa maksustamishinnast aastas; 2) käesoleva lõike punktis 1 nimetamata maatulundusmaale maamaksumäär 0,5 protsenti maa maksustamishinnast aastas; 3) käesoleva lõike punktides 1 ja 2 nimetamata sihtotstarbega maale 1,0 protsenti maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1057019_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
