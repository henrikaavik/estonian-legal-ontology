      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Räpina valla 2026. aasta eelarve kinnitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Räpina valla 2026. aasta eelarve kinnitamine",
      "estleg:summary": {
        "@value": "Kinnitada Räpina valla 2026. aasta eelarve vastavalt määruse lisadele 1-4:11) põhitegevuse tulude eelarve summas 12 081 416 eurot;22) põhitegevuse kulude eelarve summas 11 377 940 eurot;33) investeerimistegevuse eelarve summas - 768 476 eurot;44) finantseerimistehingute eelarve summas - 527 448 eurot;55) likviidsete varade muutus summas - 592 448 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "Kinnitada Räpina valla 2026. aasta eelarve vastavalt määruse lisadele 1-4:11) põhitegevuse tulude eelarve summas 12 081 416 eurot;22) põhitegevuse kulude eelarve summas 11 377 940 eurot;33) investeerimistegevuse eelarve summas - 768 476 eurot;44) finantseerimistehingute eelarve summas - 527 448 eurot;55) likviidsete varade muutus summas - 592 448 eurot.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0708"
