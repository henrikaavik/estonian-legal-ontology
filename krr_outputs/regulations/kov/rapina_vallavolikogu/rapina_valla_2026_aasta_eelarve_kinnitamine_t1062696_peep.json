    {
      "@id": "estleg:Reg_1062696_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kinnitada Räpina valla 2026. aasta eelarve vastavalt määruse lisadele 1-4: 1) põhitegevuse tulude eelarve summas 12 081 416 eurot; 2) põhitegevuse kulude eelarve summas 11 377 940 eurot; 3) investeerimistegevuse eelarve summas - 768 476 eurot; 4) finantseerimistehingute eelarve summas - 527 448 eurot; 5) likviidsete varade muutus summas - 592 448 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062696_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
