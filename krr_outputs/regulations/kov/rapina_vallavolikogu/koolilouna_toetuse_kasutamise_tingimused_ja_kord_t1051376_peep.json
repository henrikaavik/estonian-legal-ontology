    },
    {
      "@id": "estleg:Reg_1051376_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse riigieelarvest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Räpina valla üldhariduskoolides.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051376_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1051376_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud vahendite kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Riigieelarvest sihtotstarbeliselt eraldatud koolilõuna toetust kasutatakse Räpina valla üldhariduskoolides (edaspidi kool) põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Riigieelarvest makstav koolilõuna toetus on koolilõuna arvestuslik maksumus, mis tuuakse välja ühe õpilase kohta. 3(3)Juhul, kui riigieelarveline toetus ei kata toidupäeva tegelikku maksumust, kaetakse vahe Räpina valla eelarvelistest vahenditest.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Riigieelarvest sihtotstarbeliselt eraldatud koolilõuna toetust kasutatakse Räpina valla üldhariduskoolides (edaspidi kool) põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Riigieelarvest makstav koolilõuna toetus on koolilõuna arvestuslik maksumus, mis tuuakse välja ühe õpilase kohta. 3(3)Juhul, kui riigieelarveline toetus ei kata toidupäeva tegelikku maksumust, kaetakse vahe Räpina valla eelarvelistest vahenditest. 4(4)Vabariigi Valitsuse ja/või Terviseameti korralduse alusel distantsõppele üleviimisel tagab kool kõikidele seda soovivatele õpilastele koolilõuna toidupaki või võimalusel sooja koolilõuna näol kohaliku omavalitsuse üksusele riigieelarvest koolilõuna toetuseks eraldatud vahendite arvelt õpilase kohta õppepäevas eraldatud summa ulatuses. 5(5)Iga Räpina valla üldhariduskool kavandab koolilõuna toetuse oma kooli eelarvesse. Koolilõuna toetus eraldatakse iga statsionaarses õppes põhi- või keskharidust omandava õpilase kohta 175 õppepäeva ulatuses. 6(6)Koolilõuna toetust kasutatakse statsionaarses õppes õppivate õpilaste rahvatervise seaduse alusel sätestatud tervisekaitsenõuetekohase koolilõuna kulude katmiseks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0708"
