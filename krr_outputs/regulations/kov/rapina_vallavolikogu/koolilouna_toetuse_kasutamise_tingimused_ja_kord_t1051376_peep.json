      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse riigieelarvest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Räpina valla üldhariduskoolides.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse riigieelarvest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Räpina valla üldhariduskoolides.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_rapina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0708"
      },
