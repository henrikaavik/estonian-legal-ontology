    {
      "@id": "estleg:Reg_1062692_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Delegeerida Räpina Vallavalitsusele: 1) põhikooli- ja gümnaasiumiseaduses sätestatud ülesannete lahendamine, välja arvatud § 61 lõigetes 2-3¹, § 66 lõikes 2, § 73 lõikes 1, § 80 lõikes 1 ja § 81 lõikes 1 sätestatud ülesanded, mis jäävad volikogu pädevusse; 2) alusharidusseaduses sätestatud ülesannete lahendamine, välja arvatud § 16 lõigetes 1 ja 2, § 17 lõikes 1 ja § 33 lõikes 2 sätestatud ülesanded, mis jäävad volikogu pädevusse; 3) huvikooli seaduses sätestatud ülesannete lahendamine, välja arvatud § 7 lõikes 2, § 20, § 21 lõikes 1, § 22 lõikes 2 ja § 27 sätestatud ülesanded, mis jäävad volikogu pädevusse; 4) noorsootöö seaduse § 15² lõikes 1 sätestatud ülesanne.",
