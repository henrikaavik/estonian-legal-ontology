      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hüvitatavad kulutused.",
        "@language": "et"
      },
      "estleg:sourceAct": "Volikogu tööst osavõtu eest tasu ja volikogu ülesannete täitmisel tehtud kulutuste eest hüvitise maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Volikogu liikmele (sh volikogu esimehele) hüvitatakse volikogu ülesannete täitmisega seotud järgmised kulud: 1 1) majutuskulud; 2 2) koolituskulud; 3 3) sõidukulud, v.a istungil osalemisega seotud kulud; 4 4) muud volikogu tööga seotud põhjendatud kulud. 2 (2) Käesolevas paragrahvis nimetatud kulude tegemine tuleb eelnevalt kooskõlastada volikogu esimehega. 3 (3) Kulude väljamaksmise volikogu liikmele kinnitab volikogu esimees käskkirjaga.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Volikogu liikmele (sh volikogu esimehele) hüvitatakse volikogu ülesannete täitmisega seotud järgmised kulud: 1 1) majutuskulud; 2 2) koolituskulud; 3 3) sõidukulud, v.a istungil osalemisega seotud kulud; 4 4) muud volikogu tööga seotud põhjendatud kulud. 2 (2) Käesolevas paragrahvis nimetatud kulude tegemine tuleb eelnevalt kooskõlastada volikogu esimehega. 3 (3) Kulude väljamaksmise volikogu liikmele kinnitab volikogu esimees käskkirjaga. 4 (4) Volikogu esimehe puhul kooskõlastab ja kinnitab kulud volikogu aseesimees. 5 (5) Välislähetuse kulude hüvitamise otsuse teeb volikogu oma korralisel istungil, kui lähetus kestab üle seitsme päeva.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kihnu_vallavolikogu"
      },
