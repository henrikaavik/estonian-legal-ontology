      "estleg:sourceAct": "Ametnike haridusele, töökogemusele, teadmistele ja oskustele esitatavad nõuded",
      "estleg:summary": {
        "@value": "Kõrghariduse või kesk-erihariduse puudumisel peab ametnikul olema vähemalt 2-aastane töökogemus oma ametikoha valdkonnas.",
        "@language": "et"
      },
      "estleg:legalText": "Kõrghariduse või kesk-erihariduse puudumisel peab ametnikul olema vähemalt 2-aastane töökogemus oma ametikoha valdkonnas.",
