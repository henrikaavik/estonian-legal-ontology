    {
      "@id": "estleg:Reg_1023747_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määruses sätestatakse Kihnu valla omandis või kasutuses olevate sõidukite (edaspidi ametiauto) kasutamise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1023747_Par_1"
      },
