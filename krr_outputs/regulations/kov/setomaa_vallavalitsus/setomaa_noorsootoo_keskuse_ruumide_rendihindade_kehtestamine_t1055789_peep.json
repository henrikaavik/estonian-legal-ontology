    {
      "@id": "estleg:Reg_1055789_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Setomaa Noorsootöö Keskuse ruumide rendihinnad alljärgnevalt: 1) Värska noortekeskus – 10,00 eurot/üks tund; 2) Mikitamäe noortekeskus – 10,00 eurot/üks tund; 3) Meremäe noortekeskus – 10,00 eurot/üks tund; 4) Obinitsa noortetuba – tasuta; 5) Värska ekstreempark – tasuta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1055789_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
