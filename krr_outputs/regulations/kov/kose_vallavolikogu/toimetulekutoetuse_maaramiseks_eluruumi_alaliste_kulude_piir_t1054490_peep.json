    {
      "@id": "estleg:Reg_1054490_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Eluaseme kulude piirmäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Toimetulekutoetuse määramiseks eluruumi alaliste kulude piirmäärade kehtestamine",
      "estleg:summary": {
        "@value": "Toimetulekutoetuse arvestamisel arvesse võetavate jooksval kuul tasumisele kuuluvate eluasemekulude piirmäärad on:11) üür kuni 12 eurot 1 m² kohta kuus;22) eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse maksed kuni 12 eurot 1 m² kohta kuus;33) korterelamu haldamise kulu, sealhulgas remondiga seotud kulu – kuni 3 eurot 1 m² kohta kuus;44) korterelamu renoveerimiseks võetud laenu tagasimakse – kuni 2 eurot 1 m² kohta kuus;55)…",
        "@language": "et"
      },
      "estleg:legalText": "Toimetulekutoetuse arvestamisel arvesse võetavate jooksval kuul tasumisele kuuluvate eluasemekulude piirmäärad on:11) üür kuni 12 eurot 1 m² kohta kuus;22) eluaseme soetamiseks võetud laenu tagasimakse, mis sisaldab ka laenu intressi ja kohustusliku eluasemekindlustuse maksed kuni 12 eurot 1 m² kohta kuus;33) korterelamu haldamise kulu, sealhulgas remondiga seotud kulu – kuni 3 eurot 1 m² kohta kuus;44) korterelamu renoveerimiseks võetud laenu tagasimakse – kuni 2 eurot 1 m² kohta kuus;55) veevarustuse ja reovee ärajuhtimise teenuste maksumus – kuni 25 eurot ühe pereliikme kohta kuus; RT IV2024-09-2844280920240042024-10-0166) soojaveevarustuseks tarbitud soojusenergia või kütuse maksumus – kuni 25 eurot ühe pereliikme kohta kuus;RT IV2024-09-2844280920240042024-10-0177) kütteks tarbitud soojusenergia või kütuse maksumus kuni 5 eurot 1 m² kohta kuus;88) elektrienergia tarbimisega seotud kulu kuni 40 eurot ühe pereliikme kohta kuus;RT IV2024-09-2844280920240042024-10-0199) majapidamisgaasi maksumus kuni 12,80 eurot üheliikmelise pere kohta kuus ning kuni 6,40 eurot iga järgneva pereliikme kohta kuus;1010) maamaksukulu, mille arvestamise aluseks on kolmekordne elamualune pind kuni 0,13 eurot 1 m² kohta kuus;1111) hoonekindlustuse kulu kuni 0,13 eurot 1 m² kohta kuus;1212) olmejäätmete veotasu kuni 5 eurot ühe pereliikme kohta kuus.RT IV2024-09-2844280920240042024-10-01",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kose_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0338"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1054490_Map"
      },
      "estleg:hasSubsection": [
