    {
      "@id": "estleg:Reg_1054490_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse toimetulekutoetuse määramisel eluasemekulude piirmäärad Kose vallas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054490_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1054490_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Toimetulekutoetuse määramisel võetakse arvesse elamuseaduse § 7 lõike 1 punkti 2 alusel kehtestatud eluruumi sotsiaalselt põhjendatud norm ning jooksval kuul tasumisele kuuluvad eluaseme tegelikud kulud käesoleva määruse paragrahvis 3 sätestatud piirmäärade ulatuses.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054490_Par_1"
      },
      "rdfs:label": "§ 1 lg 2",
      "estleg:itemNumber": "2",
      "estleg:references": [
        {
          "@id": "estleg:ES_Par_7_Lg_1"
        }
      ],
      "estleg:isLegalBasisFor": [
        {
          "@id": "estleg:ES_Par_7_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1054490_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Eluasemekulude tasumisel varem tekkinud võlgnevust ei arvestata toimetulekutoetuse määramisel jooksval kuul tasumisele kuuluvate eluasemekulude hulka ja see ei kuulu katmisele toimetulekutoetuse vahenditest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054490_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
      "@id": "estleg:Reg_1054490_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Eluruumi normpind",
        "@language": "et"
      },
      "estleg:sourceAct": "Toimetulekutoetuse määramiseks eluruumi alaliste kulude piirmäärade kehtestamine",
      "estleg:summary": {
        "@value": "1(1)Toimetulekutoetuse määramisel võetakse arvesse eluruumi sotsiaalselt põhjendatud normpind, milleks on 18 m² eluruumide üldpinda perekonna iga liikme kohta ja lisaks 15 m² perekonna kohta. 2(2) Kui eluruumi tubade arv on võrdne selles eluruumis alaliselt elavate inimeste arvuga ning eluruumi üldpind on sotsiaalselt põhjendatud normist suurem, võetakse normpinnana arvesse eluruumi üldpind.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Toimetulekutoetuse määramisel võetakse arvesse eluruumi sotsiaalselt põhjendatud normpind, milleks on 18 m² eluruumide üldpinda perekonna iga liikme kohta ja lisaks 15 m² perekonna kohta. 2(2) Kui eluruumi tubade arv on võrdne selles eluruumis alaliselt elavate inimeste arvuga ning eluruumi üldpind on sotsiaalselt põhjendatud normist suurem, võetakse normpinnana arvesse eluruumi üldpind. 3 (3) Eluruumis üksinda elavale pensionäridele ning osalise või puuduva töövõimega inimestele võib normpinnaks arvestada kuni 51 m². Kui eluruumi üldpind on väiksem normpinnast, võetakse arvesse tegelik pind.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kose_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0338"
      },
      "estleg:partOfAct": {
