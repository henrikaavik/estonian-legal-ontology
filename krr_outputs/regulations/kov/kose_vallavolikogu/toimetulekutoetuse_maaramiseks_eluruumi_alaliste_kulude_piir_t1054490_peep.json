        },
        {
          "@id": "estleg:Reg_1054490_Par_2_Lg_3"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      }
    },
    {
      "@id": "estleg:Reg_1054490_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toimetulekutoetuse määramisel võetakse arvesse eluruumi sotsiaalselt põhjendatud normpind, milleks on 18 m² eluruumide üldpinda perekonna iga liikme kohta ja lisaks 15 m² perekonna kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054490_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1054490_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui eluruumi tubade arv on võrdne selles eluruumis alaliselt elavate inimeste arvuga ning eluruumi üldpind on sotsiaalselt põhjendatud normist suurem, võetakse normpinnana arvesse eluruumi üldpind.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054490_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1054490_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Eluruumis üksinda elavale pensionäridele ning osalise või puuduva töövõimega inimestele võib normpinnaks arvestada kuni 51 m². Kui eluruumi üldpind on väiksem normpinnast, võetakse arvesse tegelik pind.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054490_Par_2"
      },
      "rdfs:label": "§ 2 lg 3",
