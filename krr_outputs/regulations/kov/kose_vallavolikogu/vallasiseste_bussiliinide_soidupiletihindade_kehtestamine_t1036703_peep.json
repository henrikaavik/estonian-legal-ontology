      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Sõidusoodustused ja sõidusoodustuse õigust tõendavad dokumendid",
        "@language": "et"
      },
      "estleg:sourceAct": "Vallasiseste bussiliinide sõidupiletihindade kehtestamine",
      "estleg:summary": {
        "@value": "Tasuta sõidu õigus vallasisestel bussiliinidel on:11) Eesti Vabariigi eelkooliealisel lapsel, kellelt sõiduõigust tõendavat dokumenti ei nõuta;22) Eesti Vabariigi õpilasel isikustatud elektroonilise ühiskaardiga;33) Kose valla elanikul isikustatud elektroonilise ühiskaardi ja isikut tõendava dokumendiga;44) teistel ühistranspordiseaduse § 34 ja § 36 lõikes 1 nimetatud isikutel ühistranspordiseaduse § 32 sätestatud korras.",
        "@language": "et"
      },
      "estleg:legalText": "Tasuta sõidu õigus vallasisestel bussiliinidel on:11) Eesti Vabariigi eelkooliealisel lapsel, kellelt sõiduõigust tõendavat dokumenti ei nõuta;22) Eesti Vabariigi õpilasel isikustatud elektroonilise ühiskaardiga;33) Kose valla elanikul isikustatud elektroonilise ühiskaardi ja isikut tõendava dokumendiga;44) teistel ühistranspordiseaduse § 34 ja § 36 lõikes 1 nimetatud isikutel ühistranspordiseaduse § 32 sätestatud korras.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kose_vallavolikogu"
      },
