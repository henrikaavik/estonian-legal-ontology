      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Koolieelsete lasteasutuste õpetajate töötasu alammäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolieelsete lasteasutuste õpetajate töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Kose valla koolieelsete lasteasutuste õpetajate töötasu alammäärad järgmiselt:11) alates 1. septembrist 2017 vähemalt 840 eurot;22) alates 1. jaanuarist 2018 vähemalt 85% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal;33) alates 1. jaanuarist 2019 vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Kose valla koolieelsete lasteasutuste õpetajate töötasu alammäärad järgmiselt:11) alates 1. septembrist 2017 vähemalt 840 eurot;22) alates 1. jaanuarist 2018 vähemalt 85% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal;33) alates 1. jaanuarist 2019 vähemalt 90% ning magistrikraadiga või sellega võrdsustatud tasemega lasteaiaõpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kose_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0338"
      },
