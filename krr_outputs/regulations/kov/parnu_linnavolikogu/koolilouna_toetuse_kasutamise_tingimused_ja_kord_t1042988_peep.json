    },
    {
      "@id": "estleg:Reg_1042988_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Pärnu linna munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042988_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1042988_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Pärnu linna eelarves nähakse vajadusel ette täiendavad rahalised vahendid munitsipaal- ja erakoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna maksumuse katmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042988_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1042988_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja linnaeelarveliste vahendite sihipärase kasutamise eest vastutab kooli direktor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042988_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1042988_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Koolilõuna maksumuse kehtestab Pärnu Linnavalitsus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042988_Par_2"
      },
      "rdfs:label": "§ 2 lg 4"
    },
