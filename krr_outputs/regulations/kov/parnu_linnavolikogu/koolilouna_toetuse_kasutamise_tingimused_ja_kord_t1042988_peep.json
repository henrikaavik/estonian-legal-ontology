      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Pärnu linnale riigieelarvest ja Pärnu linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Pärnu linnale riigieelarvest ja Pärnu linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1042988_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1042988_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1042988_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Pärnu linnale riigieelarvest ja Pärnu linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042988_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1042988_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Pärnu linna munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2(2)Pärnu linna eelarves nähakse vajadusel ette täiendavad rahalised vahendid munitsipaal- ja erakoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna maksumuse katmiseks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Pärnu linna munitsipaalüldhariduskoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks, arvestades Vabariigi Valitsuse poolt kehtestatud koolilõuna arvestuslikku maksumust ühe õpilase kohta. 2(2)Pärnu linna eelarves nähakse vajadusel ette täiendavad rahalised vahendid munitsipaal- ja erakoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna maksumuse katmiseks. 3(3)Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja linnaeelarveliste vahendite sihipärase kasutamise eest vastutab kooli direktor. 4(4)Koolilõuna maksumuse kehtestab Pärnu Linnavalitsus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
      },
