      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Reguleerimisala",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "Määrusega kehtestatakse Pärnu linnale riigieelarvest ja Pärnu linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:legalText": "Määrusega kehtestatakse Pärnu linnale riigieelarvest ja Pärnu linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord. Määrusega kehtestatakse Pärnu linnale riigieelarvest ja Pärnu linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
