    {
      "@id": "estleg:Reg_1042730_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1042730",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Linnavalitsuse pädevus",
      "estleg:sourceAct": "Kohanimede määramise kord",
      "estleg:summary": "Pärnu Linnavalitsuse pädevuses on:11) kohanime määramine Pärnu linna teele, tänavale, väikekohale, ühissõidukipeatusele ja maaüksusele ning nende kohanimede muutmine ja kehtetuks tunnistamine;22) arvamuse andmine Vabariigi Valitsuse või ministri määratavate kohanimede kohta Pärnu linnas. Pärnu Linnavalitsuse pädevuses on: kohanime määramine Pärnu linna teele, tänavale, väikekohale, ühissõidukipeatusele ja maaüksusele ning nende kohanimede muutmine ja kehtetuks tunnistamine; arvamuse andmine Vaba",
      "estleg:legalText": "Pärnu Linnavalitsuse pädevuses on:11) kohanime määramine Pärnu linna teele, tänavale, väikekohale, ühissõidukipeatusele ja maaüksusele ning nende kohanimede muutmine ja kehtetuks tunnistamine;22) arvamuse andmine Vabariigi Valitsuse või ministri määratavate kohanimede kohta Pärnu linnas. Pärnu Linnavalitsuse pädevuses on: kohanime määramine Pärnu linna teele, tänavale, väikekohale, ühissõidukipeatusele ja maaüksusele ning nende kohanimede muutmine ja kehtetuks tunnistamine; arvamuse andmine Vabariigi Valitsuse või ministri määratavate kohanimede kohta Pärnu linnas.",
