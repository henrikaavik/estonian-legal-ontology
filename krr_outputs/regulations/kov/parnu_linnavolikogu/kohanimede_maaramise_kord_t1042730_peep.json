    {
      "@id": "estleg:Reg_1042730_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1042730",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": "§ 4. Varasemate õigusaktide kehtetuks tunnistamine",
      "estleg:sourceAct": "Kohanimede määramise kord",
      "estleg:summary": "Kehtetuks tunnistatakse:11) Pärnu Linnavolikogu 20. veebruari 2003 määrus nr 13 “Pärnu linna kohanimede registri pidamise põhimäärus”;22) Pärnu Linnavolikogu 16. detsembri 2004 määrus nr 32 „Kohanime määramise kord“;33) Paikuse Vallavolikogu 16. jaanuari 2006 määrus nr 4 „Kohanimede määramise kord“;44) Audru Vallavolikogu 8. aprilli 2010 määrus nr 18 „Kohanime määramise korra kehtestamine“. Kehtetuks tunnistatakse: Pärnu Linnavolikogu 20. veebruari 2003 määrus nr 13 “Pärnu linna kohanimede regis",
      "estleg:legalText": "Kehtetuks tunnistatakse:11) Pärnu Linnavolikogu 20. veebruari 2003 määrus nr 13 “Pärnu linna kohanimede registri pidamise põhimäärus”;22) Pärnu Linnavolikogu 16. detsembri 2004 määrus nr 32 „Kohanime määramise kord“;33) Paikuse Vallavolikogu 16. jaanuari 2006 määrus nr 4 „Kohanimede määramise kord“;44) Audru Vallavolikogu 8. aprilli 2010 määrus nr 18 „Kohanime määramise korra kehtestamine“. Kehtetuks tunnistatakse: Pärnu Linnavolikogu 20. veebruari 2003 määrus nr 13 “Pärnu linna kohanimede registri pidamise põhimäärus”; Pärnu Linnavolikogu 16. detsembri 2004 määrus nr 32 „Kohanime määramise kord“; Paikuse Vallavolikogu 16. jaanuari 2006 määrus nr 4 „Kohanimede määramise kord“; Audru Vallavolikogu 8. aprilli 2010 määrus nr 18 „Kohanime määramise korra kehtestamine“.",
