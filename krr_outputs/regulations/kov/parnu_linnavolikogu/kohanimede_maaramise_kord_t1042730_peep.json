    {
      "@id": "estleg:Reg_1042730_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1042730",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. Kohanime avalikustamine",
      "estleg:sourceAct": "Kohanimede määramise kord",
      "estleg:summary": "Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Pärnu linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. Sätet ei kohaldata maaüksuse nime määramisel. Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Pärnu linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. Sätet ei kohaldata maaüksuse nime määramisel.",
      "estleg:legalText": "Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Pärnu linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. Sätet ei kohaldata maaüksuse nime määramisel. Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Pärnu linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. Sätet ei kohaldata maaüksuse nime määramisel.",
