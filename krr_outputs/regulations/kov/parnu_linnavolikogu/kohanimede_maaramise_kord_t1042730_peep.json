        "@value": "§ 3. Kohanime avalikustamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanimede määramise kord",
      "estleg:summary": {
        "@value": "Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Pärnu linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. Sätet ei kohaldata maaüksuse nime määramisel.",
        "@language": "et"
      },
      "estleg:legalText": "Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Pärnu linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. Sätet ei kohaldata maaüksuse nime määramisel.",
