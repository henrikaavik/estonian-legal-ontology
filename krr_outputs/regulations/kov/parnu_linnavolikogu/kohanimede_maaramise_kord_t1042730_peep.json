      },
      "estleg:sourceAct": "Kohanimede määramise kord",
      "estleg:summary": {
        "@value": "Pärnu Linnavalitsuse pädevuses on:11) kohanime määramine Pärnu linna teele, tänavale, väikekohale, ühissõidukipeatusele ja maaüksusele ning nende kohanimede muutmine ja kehtetuks tunnistamine;22) arvamuse andmine Vabariigi Valitsuse või ministri määratavate kohanimede kohta Pärnu linnas.",
        "@language": "et"
      },
