      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Hädaolukorra seaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hädaolukorra seaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1(1)Hädaolukorra seaduses ja selle alusel antud õigusaktides sätestatud kohaliku omavalitsuse üksuse ja organi ülesanded delegeeritakse Pärnu Linnavalitsusele, sealhulgas on Pärnu Linnavalitsusel õigus:11) kehtestada hädaolukorra seaduse § 37 lõikes 2 sätestatud elutähtsa teenuse kirjeldus ja elutähtsa teenuse toimepidevuse nõuded;22) kehtestada teisi hädaolukorra seaduse rakendamiseks vajalikke õigusakte.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Hädaolukorra seaduses ja selle alusel antud õigusaktides sätestatud kohaliku omavalitsuse üksuse ja organi ülesanded delegeeritakse Pärnu Linnavalitsusele, sealhulgas on Pärnu Linnavalitsusel õigus:11) kehtestada hädaolukorra seaduse § 37 lõikes 2 sätestatud elutähtsa teenuse kirjeldus ja elutähtsa teenuse toimepidevuse nõuded;22) kehtestada teisi hädaolukorra seaduse rakendamiseks vajalikke õigusakte. 2(2)Pärnu Linnavalitsusel on õigus määrata isik või isikud, kelle ülesanne on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
