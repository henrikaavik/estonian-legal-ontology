        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenistusülesannete täitmiseks vajalikud täpsemad nõuded sätestatakse ametikoha ametijuhendis, arvestades ametikoha eripära.",
