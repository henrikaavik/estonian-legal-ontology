      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Nõuded oskustele ja teadmistele",
        "@language": "et"
      },
      "estleg:sourceAct": "Ametnike haridusele, töökogemusele, teadmistele ja oskustele esitatavad nõuded",
      "estleg:summary": {
        "@value": "1(1) Ametnik peab:1) omama üldisi teadmisi riigi põhikorrast;11) omama põhjalikke teadmisi kohaliku omavalitsuse korraldusest, seda reguleerivatest õigusaktidest ning oma töövaldkonda reguleerivatest õigusaktidest ja parimast praktikast ning oskama neid teenistusülesannete täitmisel rakendada;22) valdama eesti keelt seaduses või seaduse alusel sätestatud ulatuses;33) tundma asutuse asjaajamisele kehtestatud reegleid ning neid teenistusülesannete täitmisel nõuetekohaselt ja täpselt täitma;44)…",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Ametnik peab:1) omama üldisi teadmisi riigi põhikorrast;11) omama põhjalikke teadmisi kohaliku omavalitsuse korraldusest, seda reguleerivatest õigusaktidest ning oma töövaldkonda reguleerivatest õigusaktidest ja parimast praktikast ning oskama neid teenistusülesannete täitmisel rakendada;22) valdama eesti keelt seaduses või seaduse alusel sätestatud ulatuses;33) tundma asutuse asjaajamisele kehtestatud reegleid ning neid teenistusülesannete täitmisel nõuetekohaselt ja täpselt täitma;44) oskama kasutada arvutit, sealhulgas ametikohal vajalikke teksti- ja tabeltöötlusprogramme ning teisi tööks vajalikke arvutiprogramme ja andmekogusid;55) olema avatud koostööks ja hea suhtlemisoskusega. 2(2)Struktuuriüksuse juhataja peab lisaks käesoleva paragrahvi lõikes 1 sätestatule omama juhtimisalaseid teadmisi ja oskuseid ning oskust planeerida tööprotsessi ja alluvate tööd.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
