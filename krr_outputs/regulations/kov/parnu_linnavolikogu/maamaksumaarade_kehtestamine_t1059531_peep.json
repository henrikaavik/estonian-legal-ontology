    {
      "@id": "estleg:Reg_1059531_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Pärnu Linnavolikogu 24. mai 2018 määruse nr 26 „Represseeritu ja represseerituga võrdsustatud isiku maamaksust vabastamise kord“ muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Pärnu Linnavolikogu 24. mai 2018 määruses nr 26 „Represseeritu ja represseerituga võrdsustatud isiku maamaksust vabastamise kord“ tehakse järgmised muudatused: 1 1) paragrahvi 2 tekst muudetakse ja sõnastatakse järgmiselt:„Maksuvabastust antakse maamaksuseaduse mõistes maamaksu subjektile, kes on okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes õigusvastaselt represseeritud isik või represseerituga võrdsustatud isik (edaspidi isik)“.",
        "@language": "et"
      },
      "estleg:legalText": "Pärnu Linnavolikogu 24. mai 2018 määruses nr 26 „Represseeritu ja represseerituga võrdsustatud isiku maamaksust vabastamise kord“ tehakse järgmised muudatused: 1 1) paragrahvi 2 tekst muudetakse ja sõnastatakse järgmiselt:„Maksuvabastust antakse maamaksuseaduse mõistes maamaksu subjektile, kes on okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes õigusvastaselt represseeritud isik või represseerituga võrdsustatud isik (edaspidi isik)“. 2 2) paragrahvi 3 lõige 1 muudetakse ja sõnastatakse järgmiselt:„(1) Isik vabastatakse maamaksuseaduse § 11 lõikes 1 nimetatud tingimustel tema kasutuses oleva maa, mille sihtotstarve või üks sihtotstarvetest on elamumaa, või maatulundusmaa õuemaa kõlviku osas maamaksust osas, millele ei kohaldu maamaksuseaduse § 11 lõiked 1, 2 või 3. 3 3) paragrahvi 3 lõige 1 muudetakse ja sõnastatakse järgmiselt:„(1) Isik vabastatakse maamaksuseaduse § 11 lõikes 11 nimetatud tingimustel tema kasutuses oleva maa, mille sihtotstarve või üks sihtotstarvetest on elamumaa, või maatulundusmaa õuemaa kõlviku osas täielikult maamaksust.“",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059531_Map"
