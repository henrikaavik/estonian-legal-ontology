      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Maamaksumäärade kehtestamine 2025. aastaks",
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": "Kehtestada 2025. aastaks maamaksumäärad erinevatele maa sihtotstarbegruppidele Pärnu linnas järgmiselt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,30 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,33 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,53 protsenti maa maksustamishinnast aastas.",
      "estleg:legalText": "Kehtestada 2025. aastaks maamaksumäärad erinevatele maa sihtotstarbegruppidele Pärnu linnas järgmiselt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,30 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,33 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,53 protsenti maa maksustamishinnast aastas. Kehtestada 2025. aastaks maamaksumäärad erinevatele maa sihtotstarbegruppidele Pärnu linnas järgmiselt: elamumaale ja maatulundusmaa õuemaa kõlvikule 0,30 protsenti maa maksustamishinnast aastas; käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,33 protsenti maa maksustamishinnast aastas; käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,53 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
