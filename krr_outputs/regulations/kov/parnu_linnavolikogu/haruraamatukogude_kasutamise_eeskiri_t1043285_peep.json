    {
      "@id": "estleg:Reg_1043285_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Teenused",
        "@language": "et"
      },
      "estleg:sourceAct": "Haruraamatukogude kasutamise eeskiri",
      "estleg:summary": {
        "@value": "1(1)Raamatukogu põhiteenused (teavikute kojulaenutus, kohapeal kasutamine ja juurdepääs üldkasutatavale andmesidevõrgule) on tasuta. 2(2)Raamatukogu laenutab lugejaile teavikuid nii kohalkasutamiseks kui ka koju, annab informatsiooni, võimaldab avalike andmebaaside ja interneti kasutamist. 3(3)Raamatukogu eriteenused (printimine, kopeerimine, skaneerimine) on tasulised. Eriteenuste eest võetava tasu suuruse kinnitab Pärnu Linnavalitsus (edaspidi linnavalitsus).",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Raamatukogu põhiteenused (teavikute kojulaenutus, kohapeal kasutamine ja juurdepääs üldkasutatavale andmesidevõrgule) on tasuta. 2(2)Raamatukogu laenutab lugejaile teavikuid nii kohalkasutamiseks kui ka koju, annab informatsiooni, võimaldab avalike andmebaaside ja interneti kasutamist. 3(3)Raamatukogu eriteenused (printimine, kopeerimine, skaneerimine) on tasulised. Eriteenuste eest võetava tasu suuruse kinnitab Pärnu Linnavalitsus (edaspidi linnavalitsus).",
