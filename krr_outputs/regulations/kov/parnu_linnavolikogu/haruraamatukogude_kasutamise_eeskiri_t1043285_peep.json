      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Haruraamatukogude kasutamise eeskiri",
      "estleg:summary": {
        "@value": "Käesolev haruraamatukogude kasutamise eeskiri reguleerib Pärnu Keskraamatukogu Aruvälja, Audru, Jõõpre, Lavassaare, Lindi, Pootsi, Tõhela, Tõstamaa ja Paikuse raamatukogude (edaspidi raamatukogu) teeninduse korraldust, lugeja õigusi ja kohustusi.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev haruraamatukogude kasutamise eeskiri reguleerib Pärnu Keskraamatukogu Aruvälja, Audru, Jõõpre, Lavassaare, Lindi, Pootsi, Tõhela, Tõstamaa ja Paikuse raamatukogude (edaspidi raamatukogu) teeninduse korraldust, lugeja õigusi ja kohustusi.",
