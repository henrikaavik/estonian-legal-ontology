      "estleg:legalText": "(3) Volikogu liikme, sh volikogu esimehe ja aseesimehe lähetuskulud hüvitatakse täiendavalt avaliku teenistuse seaduses sätestatud tingimustel ja korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062807_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
