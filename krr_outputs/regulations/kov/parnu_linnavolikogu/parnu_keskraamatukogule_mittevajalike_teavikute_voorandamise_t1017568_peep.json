      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teavikute võõrandamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pärnu Keskraamatukogule mittevajalike teavikute võõrandamise kord",
      "estleg:summary": {
        "@value": "1 (1) Raamatukogule mittevajalikud teavikud võõrandatakse tasuta või müüakse. 2 (2) Teade teavikute müügi kohta avaldatakse raamatukogu kodulehel. Teavikuid müüakse ainult raamatukogus. RT IV 2016-03-29 156 429032016156 2016-04-01 3 (3) Teavikute müügi kassadokumendid esitatakse raamatupidamisele. RT IV 2016-03-29 156 429032016156 2016-04-01 4 (4) Teavikute müügist saadud vahendid laekuvad linnaeelarve tuludesse.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Raamatukogule mittevajalikud teavikud võõrandatakse tasuta või müüakse. 2 (2) Teade teavikute müügi kohta avaldatakse raamatukogu kodulehel. Teavikuid müüakse ainult raamatukogus. RT IV 2016-03-29 156 429032016156 2016-04-01 3 (3) Teavikute müügi kassadokumendid esitatakse raamatupidamisele. RT IV 2016-03-29 156 429032016156 2016-04-01 4 (4) Teavikute müügist saadud vahendid laekuvad linnaeelarve tuludesse.",
