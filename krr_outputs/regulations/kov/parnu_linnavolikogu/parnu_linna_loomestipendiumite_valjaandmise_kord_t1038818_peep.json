      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Pärnu linna loomestipendiumite väljaandmise kord",
      "estleg:summary": {
        "@value": "1(1)Määruse eesmärgiks on loomestipendiumite määramine Pärnu linnas elavatele või tegutsevatele autoritele või esitajatele, kes tegutsevad kujutava või audiovisuaalse kunsti, lavakunsti, kirjanduse, muusika või arhitektuuri erialal, et väärtustada ja soodustada nende tegevust Pärnu linna kultuurielu rikastamisel. 2(2)Stipendiume antakse eelarvevahendite olemasolul.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Määruse eesmärgiks on loomestipendiumite määramine Pärnu linnas elavatele või tegutsevatele autoritele või esitajatele, kes tegutsevad kujutava või audiovisuaalse kunsti, lavakunsti, kirjanduse, muusika või arhitektuuri erialal, et väärtustada ja soodustada nende tegevust Pärnu linna kultuurielu rikastamisel. 2(2)Stipendiume antakse eelarvevahendite olemasolul.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_parnu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0624"
      },
