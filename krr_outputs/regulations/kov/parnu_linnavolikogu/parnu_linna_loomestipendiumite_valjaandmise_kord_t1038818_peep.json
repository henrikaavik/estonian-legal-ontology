      }
    },
    {
      "@id": "estleg:Reg_1038818_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Puuduste esinemisel taotluses informeerib haridus- ja kultuuriosakond sellest taotlejat ning annab puuduste kõrvaldamiseks aega 10 tööpäeva. Juhul, kui taotleja ei kõrvalda antud tähtajaks puudusi, tagastatakse talle esitatud taotlus ja menetlus stipendiumi määramiseks lõpetatakse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038818_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:targetGroup": [
