        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Lasteaiast väljaarvamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hiiumaa valla lasteaeda vastuvõtu ja väljaarvamise kord",
      "estleg:summary": {
        "@value": "1 (1) Lapse lasteaiast väljaarvamiseks esitab vanem 14 kalendripäeva enne lapse lasteasutusest lahkumist taotluse e-keskkonnas ARNO, milles märgitakse lapse lasteasutusest lahkumise kuupäev ja põhjendus. 2 (2) Laps arvatakse lasteaiast välja: 1 1) vanema taotluse alusel; 2 2) kui laps asub täitma õppimiskohustust; 3 3) kui lapsel puuduvad Eesti elukoha andmed, välja arvatud juhul, kui lasteaiale on teada, et laps viibib Eestis ning vanem on lasteaiale esitanud kinnituse, et soovib lasteaiakohta…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lapse lasteaiast väljaarvamiseks esitab vanem 14 kalendripäeva enne lapse lasteasutusest lahkumist taotluse e-keskkonnas ARNO, milles märgitakse lapse lasteasutusest lahkumise kuupäev ja põhjendus. 2 (2) Laps arvatakse lasteaiast välja: 1 1) vanema taotluse alusel; 2 2) kui laps asub täitma õppimiskohustust; 3 3) kui lapsel puuduvad Eesti elukoha andmed, välja arvatud juhul, kui lasteaiale on teada, et laps viibib Eestis ning vanem on lasteaiale esitanud kinnituse, et soovib lasteaiakohta jätkuvalt kasutada; 4 4) lapse surma korral.",
      "estleg:enactedBy": {
