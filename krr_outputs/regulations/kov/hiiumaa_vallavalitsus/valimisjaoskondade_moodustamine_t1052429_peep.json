      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Valimiste ja rahvahääletuse hääletamise korraldamiseks moodustatakse Hiiumaa valla haldusterritooriumil 5 valimisjaoskonda.",
      "estleg:parentProvision": {
