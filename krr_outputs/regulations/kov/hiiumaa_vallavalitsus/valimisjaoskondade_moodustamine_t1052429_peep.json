      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldavad väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskonnad nr 1 ja 3. 2 (2) Valimisjaoskonnad nr 1, 3 ja 5 korraldavad hääletamist vajadusel ka asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldavad väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskonnad nr 1 ja 3. 2 (2) Valimisjaoskonnad nr 1, 3 ja 5 korraldavad hääletamist vajadusel ka asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
