      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Elukohajärgne kool põhihariduse omandamiseks mittestatsionaarses õppes.",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramine",
      "estleg:summary": {
        "@value": "Rahvastikuregistri andmetel Hiiumaa vallas elavale 17 aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, on elukohajärgseks kooliks kool, kus toimub mittestatsionaarne õpe.",
        "@language": "et"
      },
      "estleg:legalText": "Rahvastikuregistri andmetel Hiiumaa vallas elavale 17 aastasele või vanemale isikule, kes ei ole põhiharidust omandanud, on elukohajärgseks kooliks kool, kus toimub mittestatsionaarne õpe.",
