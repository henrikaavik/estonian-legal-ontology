      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Raske ja sügava puudega lastele sotsiaalteenuste osutamise toetuse kasutamise kord",
      "estleg:summary": {
        "@value": "Määrus reguleerib riigieelarvest Mäksa valla eelarvesse eraldatud raske ja sügava puudega laste toetavate sotsiaalteenuste osutamiseks ja arendamiseks eraldatavate vahendiste kasutamist.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus reguleerib riigieelarvest Mäksa valla eelarvesse eraldatud raske ja sügava puudega laste toetavate sotsiaalteenuste osutamiseks ja arendamiseks eraldatavate vahendiste kasutamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_maksa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
      },
