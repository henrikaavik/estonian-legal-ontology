    {
      "@id": "estleg:Reg_1034256_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvate eluruumi alalised kulud järgmiselt: 1) üür – kuni 2 € 1 m2 kohta kuus; 2) korterelamu haldamise tasu, sealhulgas remondiga seotud kulu - kuni 1 € 1 m2 kohta kuus; 3) kütteks ja soojaveevarustuseks tarbitud soojaenergia või kütuse maksumus - kuni 2,50 € 1 m2 kohta kuus; 4) veevarustuse ja reovee ärajuhtimise teenuste maksumus – kuni 8,40 € iga pereliikme kohta kuus; 5) tarbitud elektrienergia maksumus kuni 19,2 € üheliikmelise pere kohta kuus ning kuni 10,5 € iga järgneva pereliikme kohta kuus; 6) tarbitud majapidamisgaasi maksumus kuni 7,0 € üheliikmelise pere kohta kuus ning kuni 5,3 € iga järgneva pereliikme kohta kuus; 7) olmejäätmete veoteenuste maksumus - kuni 2,5 € kuus elaniku kohta; 8) maamaksukulud kuni 0,15 € 1 m2 kohta kuus; 9) hoonekindlustuse kulud kuni 0,15 € 1 m2 kohta kuus; 10) korterelamu renoveerimiseks võetud laenu tagasimakse kulu – kuni 2 € 1 m2 kohta kuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1034256_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
