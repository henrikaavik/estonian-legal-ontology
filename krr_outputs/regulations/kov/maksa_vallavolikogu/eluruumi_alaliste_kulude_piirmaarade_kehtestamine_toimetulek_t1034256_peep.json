    {
      "@id": "estleg:Reg_1034256_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Toimetulekutoetuse arvestamisel arvesse võetavad jooksval kuul tasumisele kuuluvad eluruumi alaliste kulude piirmäärad",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluruumi alaliste kulude piirmäärade kehtestamine toimetulekutoetuse määramisel",
      "estleg:summary": {
        "@value": "Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvate eluruumi alalised kulud järgmiselt: 1 1) üür – kuni 2 € 1 m2 kohta kuus; 2 2) korterelamu haldamise tasu, sealhulgas remondiga seotud kulu - kuni 1 € 1 m2 kohta kuus; 3 3) kütteks ja soojaveevarustuseks tarbitud soojaenergia või kütuse maksumus - kuni 2,50 € 1 m2 kohta kuus; 4 4) veevarustuse ja reovee ärajuhtimise teenuste maksumus – kuni 8,40 € iga pereliikme kohta kuus; 5 5) tarbitud elektrienergia maksumus…",
        "@language": "et"
      },
      "estleg:legalText": "Toimetulekutoetuse määramisel võetakse arvesse jooksval kuul tasumisele kuuluvate eluruumi alalised kulud järgmiselt: 1 1) üür – kuni 2 € 1 m2 kohta kuus; 2 2) korterelamu haldamise tasu, sealhulgas remondiga seotud kulu - kuni 1 € 1 m2 kohta kuus; 3 3) kütteks ja soojaveevarustuseks tarbitud soojaenergia või kütuse maksumus - kuni 2,50 € 1 m2 kohta kuus; 4 4) veevarustuse ja reovee ärajuhtimise teenuste maksumus – kuni 8,40 € iga pereliikme kohta kuus; 5 5) tarbitud elektrienergia maksumus kuni 19,2 € üheliikmelise pere kohta kuus ning kuni 10,5 € iga järgneva pereliikme kohta kuus; 6 6) tarbitud majapidamisgaasi maksumus kuni 7,0 € üheliikmelise pere kohta kuus ning kuni 5,3 € iga järgneva pereliikme kohta kuus; 7 7) olmejäätmete veoteenuste maksumus - kuni 2,5 € kuus elaniku kohta; 8 8) maamaksukulud kuni 0,15 € 1 m2 kohta kuus; 9 9) hoonekindlustuse kulud kuni 0,15 € 1 m2 kohta kuus; 10 10) korterelamu renoveerimiseks võetud laenu tagasimakse kulu – kuni 2 € 1 m2 kohta kuus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_maksa_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0291"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1034256_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
