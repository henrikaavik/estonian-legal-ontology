      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Korruptsioonijuhtumist teavitamise kohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Ametiisik on kohustatud viivitamata teavitama asutuse juhti talle teatavaks saanud korruptsioonivastase seaduse § 3 lõikes 1 sätestatud keelu rikkumisest või muust korruptsioonijuhtumist. Vastavalt korruptsioonivastase seaduse § 6 lõigetele 2 ja 3 tagatakse teavitamise fakti konfidentsiaalsus.",
        "@language": "et"
      },
      "estleg:legalText": "Ametiisik on kohustatud viivitamata teavitama asutuse juhti talle teatavaks saanud korruptsioonivastase seaduse § 3 lõikes 1 sätestatud keelu rikkumisest või muust korruptsioonijuhtumist. Vastavalt korruptsioonivastase seaduse § 6 lõigetele 2 ja 3 tagatakse teavitamise fakti konfidentsiaalsus.",
