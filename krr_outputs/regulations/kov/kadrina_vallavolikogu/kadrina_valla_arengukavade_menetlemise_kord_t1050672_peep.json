    {
      "@id": "estleg:Reg_1050672_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Valdkonna arengukava",
        "@language": "et"
      },
      "estleg:sourceAct": "Kadrina valla arengukavade menetlemise kord",
      "estleg:summary": {
        "@value": "1 (1) Valdkonna arengukava koostatakse, kui selle koostamise kohustus tuleneb seadusest või selle alusel antud õigusaktist või kui vallavalitsus algatab valdkonna arengukava koostamise või muutmise. 2 (2) Valdkonna arengukava eelnõu koostamise korraldab Kadrina Vallavalitsuse struktuuriüksus, mille haldusalas vastav valdkond asub. 3 (3) Vallavalitsus kiidab heaks ja suunab arengukava eelnõu avalikule väljapanekule valla veebilehel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Valdkonna arengukava koostatakse, kui selle koostamise kohustus tuleneb seadusest või selle alusel antud õigusaktist või kui vallavalitsus algatab valdkonna arengukava koostamise või muutmise. 2 (2) Valdkonna arengukava eelnõu koostamise korraldab Kadrina Vallavalitsuse struktuuriüksus, mille haldusalas vastav valdkond asub. 3 (3) Vallavalitsus kiidab heaks ja suunab arengukava eelnõu avalikule väljapanekule valla veebilehel. 4 (4) Pärast avalikustamist esitab vallavalitsus arengukava eelnõu koos avalikul väljapanekul tehtud ettepanekutega ja vallavalitsuse arvamusega volikogule. 5 (5) Valdkonna arengukava kinnitab volikogu. 6 (6) Valdkonna arengukava muutmine toimub käesoleva määruse §-s 3 sätestatud korda järgides.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kadrina_vallavolikogu"
