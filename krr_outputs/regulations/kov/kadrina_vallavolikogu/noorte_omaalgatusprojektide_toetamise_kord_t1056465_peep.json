    {
      "@id": "estleg:Reg_1056465_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala ja eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Noorte omaalgatusprojektide toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Määrus sätestab Kadrina valla eelarvest rahvastikuregistri andmetel vallas elavate või valla koolides õppivate noorte ning Kadrina valla haldusterritooriumil tegutsevate noorteühenduste omaalgatusprojektide (edaspidi „projekt“) toetamise põhimõtted, toetuse taotlemise ja saamise tingimused ning aruandluse ja järelevalve korra. 2 (2) Määruse eesmärgiks on arendada noorte ettevõtlikkust ja innustada noorte osalemist kogukonnaelus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrus sätestab Kadrina valla eelarvest rahvastikuregistri andmetel vallas elavate või valla koolides õppivate noorte ning Kadrina valla haldusterritooriumil tegutsevate noorteühenduste omaalgatusprojektide (edaspidi „projekt“) toetamise põhimõtted, toetuse taotlemise ja saamise tingimused ning aruandluse ja järelevalve korra. 2 (2) Määruse eesmärgiks on arendada noorte ettevõtlikkust ja innustada noorte osalemist kogukonnaelus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kadrina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0272"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056465_Map"
      },
