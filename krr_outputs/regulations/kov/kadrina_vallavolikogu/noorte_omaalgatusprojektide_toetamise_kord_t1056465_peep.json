    {
      "@id": "estleg:Reg_1056465_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Aruandlus ja järelevalve",
        "@language": "et"
      },
      "estleg:sourceAct": "Noorte omaalgatusprojektide toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Toetuse saaja esitab elektroonses keskkonnas toetuse kasutamise kohta vormikohase aruande koos kuludokumentidega 30 kalendripäeva jooksul alates toetuse andmise aluseks oleva tegevuse või korraldatud ürituse lõppemise päevast. 2 (2) Toetuse aruande vormi kehtestab vallavalitsus. 3 (3) Toetuse sihipärast kasutamist kontrollib vastava valdkonna teenistuja. Teenistujal on õigus küsida selgitusi toetuse kasutamise kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetuse saaja esitab elektroonses keskkonnas toetuse kasutamise kohta vormikohase aruande koos kuludokumentidega 30 kalendripäeva jooksul alates toetuse andmise aluseks oleva tegevuse või korraldatud ürituse lõppemise päevast. 2 (2) Toetuse aruande vormi kehtestab vallavalitsus. 3 (3) Toetuse sihipärast kasutamist kontrollib vastava valdkonna teenistuja. Teenistujal on õigus küsida selgitusi toetuse kasutamise kohta. 4 (4) Vallavalitsusel on õigus nõuda toetus tagasi, kui: 1 1) toetuse saaja ei kasuta või ei kasutanud toetust sihtotstarbeliselt;Taotlus esitatakse Kadrina Vallavalitsuse iseteeninduskeskkonna kaudu. 2 2) toetuse saaja esitab taotlemisel või aruandes valeandmeid; 3 3) toetuse saaja ei esita aruannet toetuse kasutamise kohta; 4 4) projekti tegevus ei ole osaliselt või tervikuna lepingus toodud mahus toimunud; 5 5) muudel lepingus sätestatud juhtudel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kadrina_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0272"
