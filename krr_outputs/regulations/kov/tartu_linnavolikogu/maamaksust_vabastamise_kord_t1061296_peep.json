    {
      "@id": "estleg:Reg_1061296_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Täiendava maksusoodustuse taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksust vabastamise kord",
      "estleg:summary": {
        "@value": "1(1)Maksusoodustuse saamiseks esitatakse avaldus linnavalitsuse arhitektuuri ja ehituse osakonnale hiljemalt maksustatava aasta 15. jaanuariks. Avaldusele lisatakse dokumendid, mis tõendavad isiku kuulumist maksuvabastuse subjektide hulka. 2(2)Isik, kes on saanud täiendavat maksuvabastust maksustamisaastale eelnevatel aastatel, ei pea maksuvabastuse saamiseks uut avaldust esitama.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Maksusoodustuse saamiseks esitatakse avaldus linnavalitsuse arhitektuuri ja ehituse osakonnale hiljemalt maksustatava aasta 15. jaanuariks. Avaldusele lisatakse dokumendid, mis tõendavad isiku kuulumist maksuvabastuse subjektide hulka. 2(2)Isik, kes on saanud täiendavat maksuvabastust maksustamisaastale eelnevatel aastatel, ei pea maksuvabastuse saamiseks uut avaldust esitama. Uus avaldus tuleb esitada juhul kui isik on omandanud uue kinnistu või korteriomandi, mille osas ta soovib saada maksusoodustust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0793"
      },
