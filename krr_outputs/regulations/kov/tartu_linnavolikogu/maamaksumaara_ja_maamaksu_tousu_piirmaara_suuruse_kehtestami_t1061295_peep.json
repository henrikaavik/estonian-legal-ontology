      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära ja maamaksu tõusu piirmäära suuruse kehtestamine 2026. aastaks",
      "estleg:summary": {
        "@value": "Kehtestada 2026. aastal Tartu linna haldusterritooriumil igale maa sihtotstarbegrupile maksumäär järgmiselt:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 1,0 protsenti maa maksustamishinnast aastas;22) maatulundusmaa kõlvikutele (välja arvatud õuemaa kõlvik) 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 2,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada 2026. aastal Tartu linna haldusterritooriumil igale maa sihtotstarbegrupile maksumäär järgmiselt:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 1,0 protsenti maa maksustamishinnast aastas;22) maatulundusmaa kõlvikutele (välja arvatud õuemaa kõlvik) 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 2,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0793"
