      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Hädaolukorra seaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hädaolukorra seaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) Hädaolukorra seaduses sätestatud kohaliku omavalitsuse üksuse ja kohaliku omavalitsuse üksuse organi ülesanded delegeeritakse Tartu Linnavalitsusele. 2 (2) Tartu Linnavalitsusel on õigus: 1 1) kehtestada hädaolukorra seaduse rakendamiseks vajalikke õigusakte; 2 2) määrata haldusmenetluse seaduse paragrahvi 8 lõike 2 alusel struktuuriüksus, ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Hädaolukorra seaduses sätestatud kohaliku omavalitsuse üksuse ja kohaliku omavalitsuse üksuse organi ülesanded delegeeritakse Tartu Linnavalitsusele. 2 (2) Tartu Linnavalitsusel on õigus: 1 1) kehtestada hädaolukorra seaduse rakendamiseks vajalikke õigusakte; 2 2) määrata haldusmenetluse seaduse paragrahvi 8 lõike 2 alusel struktuuriüksus, ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
