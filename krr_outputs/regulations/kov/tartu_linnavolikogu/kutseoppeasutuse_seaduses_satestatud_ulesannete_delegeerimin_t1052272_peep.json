      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Kutseõppeasutuse seaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kutseõppeasutuse seaduses sätestatud ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1(1)Tartu Linnavalitsusele delegeeritakse kutseõppeasutuse seaduses kooli pidajale pandud ülesannete täitmine, välja arvatud paragrahvi 32 lõikes 9, paragrahvi 48 lõikes 4 ja paragrahvi 49 lõikes 1 sätestatud ülesannete täitmine. 2(2)Tartu Kutsehariduskeskuse direktorile delegeeritakse kutseõppeasutuse seaduse paragrahvi 32 lõikes 9 ja paragrahvi 48 lõikes 4 kooli pidajale pandud ülesande täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Tartu Linnavalitsusele delegeeritakse kutseõppeasutuse seaduses kooli pidajale pandud ülesannete täitmine, välja arvatud paragrahvi 32 lõikes 9, paragrahvi 48 lõikes 4 ja paragrahvi 49 lõikes 1 sätestatud ülesannete täitmine. 2(2)Tartu Kutsehariduskeskuse direktorile delegeeritakse kutseõppeasutuse seaduse paragrahvi 32 lõikes 9 ja paragrahvi 48 lõikes 4 kooli pidajale pandud ülesande täitmine.",
