      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Tartu Ülikooli Tartu Raefondi stipendium",
        "@language": "et"
      },
      "estleg:sourceAct": "Tartu Ülikooli Tartu Raefondi stipendium",
      "estleg:summary": {
        "@value": "1 (1) Tartu Ülikooli Tartu Raefondi stipendium (edaspidi stipendium) on Tartu linna ja Tartu Ülikooli Sihtasutuse koostöös välja antav stipendium Tartu Ülikooli bakalaureuse- või magistriõppe üliõpilasele, et motiveerida üliõpilast tegema uurimustööd või lõputööd, mis käsitleb Tartu linna väljakutseid või linnaga seotud arenguid seostatult ÜRO kestliku arengu eesmärkidega (UN SDG). RT IV 2025-03-21 3 421032025003 2025-03-24 2 (2) Stipendiumi suurus on 1500 eurot.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Tartu Ülikooli Tartu Raefondi stipendium (edaspidi stipendium) on Tartu linna ja Tartu Ülikooli Sihtasutuse koostöös välja antav stipendium Tartu Ülikooli bakalaureuse- või magistriõppe üliõpilasele, et motiveerida üliõpilast tegema uurimustööd või lõputööd, mis käsitleb Tartu linna väljakutseid või linnaga seotud arenguid seostatult ÜRO kestliku arengu eesmärkidega (UN SDG). RT IV 2025-03-21 3 421032025003 2025-03-24 2 (2) Stipendiumi suurus on 1500 eurot. 3 (3) Aastas antakse Tartu Ülikooli üliõpilastele kuni kümme stipendiumi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_linnavolikogu"
      },
