    {
      "@id": "estleg:Reg_1060422_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Stipendiumi korraldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Tartu Ülikooli Tartu Raefondi stipendium",
      "estleg:summary": {
        "@value": "1 (1) Tartu Ülikooli Sihtasutus kuulutab stipendiumikonkursi välja vähemalt kaks kuud enne taotluste esitamise tähtaega. 2 (2) Stipendiumi taotlemiseks tuleb esitada Tartu Ülikooli Sihtasutusele elektrooniline taotlus Tartu Ülikooli Sihtasutuse määratud tähtpäevaks. Taotlus on vabas vormis essee, milles kirjeldatakse uurimistöö või lõputöö teemat, selle seost Tartu linna väljakutsete või arengutega ja esitatakse kava uurimustöö või lõputöö koostamise kohta õpingute ajal.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Tartu Ülikooli Sihtasutus kuulutab stipendiumikonkursi välja vähemalt kaks kuud enne taotluste esitamise tähtaega. 2 (2) Stipendiumi taotlemiseks tuleb esitada Tartu Ülikooli Sihtasutusele elektrooniline taotlus Tartu Ülikooli Sihtasutuse määratud tähtpäevaks. Taotlus on vabas vormis essee, milles kirjeldatakse uurimistöö või lõputöö teemat, selle seost Tartu linna väljakutsete või arengutega ja esitatakse kava uurimustöö või lõputöö koostamise kohta õpingute ajal. Täiendavalt lisatakse taotleja kohta Tartu Ülikooli soovituskiri ja õppetulemuste tõend, mis sisaldab taotleja kaalutud keskmist hinnet.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tartu_linnavolikogu"
      },
