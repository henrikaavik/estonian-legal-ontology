    {
      "@id": "estleg:Reg_1062051_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1062051",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. Nõuded töökogemusele",
      "estleg:sourceAct": "Ametnike haridusele, töökogemusele, teadmistele ja oskustele esitatavad nõuded",
      "estleg:summary": "Ametiasutuse osakonnajuhatajal peab olema lisaks kõrgharidusele vähemalt 1-aastane juhtimiskogemus või vähemalt 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas. Ametiasutuse osakonnajuhatajal peab olema lisaks kõrgharidusele vähemalt 1-aastane juhtimiskogemus või vähemalt 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas.",
      "estleg:legalText": "Ametiasutuse osakonnajuhatajal peab olema lisaks kõrgharidusele vähemalt 1-aastane juhtimiskogemus või vähemalt 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas. Ametiasutuse osakonnajuhatajal peab olema lisaks kõrgharidusele vähemalt 1-aastane juhtimiskogemus või vähemalt 2-aastane töökogemus ametiasutuse või ametikoha töövaldkonnas.",
