          "@id": "estleg:Reg_1041391_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1041391_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Paide linnale riigieelarvest ja Paide linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041391_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1041391_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuse kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Paide linna munitsipaalüldhariduskoolide statsionaarses õppes põhi- ning üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2 (2) Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele. 3 (3) Kui koolilõuna tegelik maksumus ületab riigi poolt sätestatud arvestusliku maksumuse, kaetakse koolilõuna tegeliku ja arvestusliku maksumuse vahe Paide linna eelarvest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Paide linna munitsipaalüldhariduskoolide statsionaarses õppes põhi- ning üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2 (2) Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele. 3 (3) Kui koolilõuna tegelik maksumus ületab riigi poolt sätestatud arvestusliku maksumuse, kaetakse koolilõuna tegeliku ja arvestusliku maksumuse vahe Paide linna eelarvest. 4 (4) Paide linnale riigieelarvest laekuva toetuse ja linna eelarvest eraldatavate vahendite arvelt kaetakse õpilaste toitlustuskulud: 1 1) koolides toitlustusteenust pakkuvatele ettevõtjatele nendega sõlmitud lepingute ja esitatud arvete alusel; 2 2) koolile, kui toitlustajaks on kool ise. 5 (5) Koolilõuna toetuse kasutamist kontrollib Paide Llinnavalitsus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_paide_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0567"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041391_Map"
      },
