      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Paide linnale riigieelarvest ja Paide linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Paide linnale riigieelarvest ja Paide linna eelarvest koolilõuna toetuseks eraldatavate vahendite kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_paide_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0567"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041391_Map"
