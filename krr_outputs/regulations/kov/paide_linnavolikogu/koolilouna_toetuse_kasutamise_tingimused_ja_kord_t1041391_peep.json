        }
      ]
    },
    {
      "@id": "estleg:Reg_1041391_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarvest eraldatud koolilõuna toetust kasutatakse Paide linna munitsipaalüldhariduskoolide statsionaarses õppes põhi- ning üldkeskharidust omandavate õpilaste koolilõuna kulude katmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041391_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1041391_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Riigieelarvest eraldatud koolilõuna toetust ei maksta välja õpilastele, nende vanematele või eestkostjatele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041391_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1041391_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kui koolilõuna tegelik maksumus ületab riigi poolt sätestatud arvestusliku maksumuse, kaetakse koolilõuna tegeliku ja arvestusliku maksumuse vahe Paide linna eelarvest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041391_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1041391_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Paide linnale riigieelarvest laekuva toetuse ja linna eelarvest eraldatavate vahendite arvelt kaetakse õpilaste toitlustuskulud: 1) koolides toitlustusteenust pakkuvatele ettevõtjatele nendega sõlmitud lepingute ja esitatud arvete alusel; 2) koolile, kui toitlustajaks on kool ise.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041391_Par_2"
      },
      "rdfs:label": "§ 2 lg 4",
      "estleg:itemNumber": [
        "1",
        "2"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
