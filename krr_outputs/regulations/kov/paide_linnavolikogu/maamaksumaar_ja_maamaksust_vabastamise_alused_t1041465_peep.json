      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäär ja maamaksust vabastamise alused",
      "estleg:summary": {
        "@value": "Paide linna haldusterritooriumil kehtestatakse maamaksumäär: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 % kehtivast maa maksustamishinnast aastas; 2 2) maatulundusmaale 0,5 % kehtivast maa maksustamishinnast aastas; 3 3) muu sihtotstarbega maale 1,0 % kehtivast maa maksustamishinnast aastas. RT IV2025-08-1324130820250022026-01-01",
        "@language": "et"
      },
      "estleg:legalText": "Paide linna haldusterritooriumil kehtestatakse maamaksumäär: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 % kehtivast maa maksustamishinnast aastas; 2 2) maatulundusmaale 0,5 % kehtivast maa maksustamishinnast aastas; 3 3) muu sihtotstarbega maale 1,0 % kehtivast maa maksustamishinnast aastas. RT IV2025-08-1324130820250022026-01-01",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_paide_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0567"
