    {
      "@id": "estleg:Reg_1063878_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Välislähetuse kohta esitavad linnavolikogu liige ja linnapea linnavolikogu esimehele ning linnavalitsuse liige linnapeale kirjaliku aruande ja annavad suulise ülevaate välislähetusest linnavolikogu istungil.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063878_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_paide_linnavolikogu"
        },
        {
          "@id": "estleg:Issuer_paide_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1063878_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Aruandes nimetatakse lähetuse käigustoimunud olulised kohtumised ja arutusel olnud teemad, kontaktisikute andmed, edasise koostöö võimalused, kokkulepped ja muu oluline teave. Aruandele lisatakse lähetuses allkirjastatud dokumentide koopiad.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063878_Par_5"
      },
      "rdfs:label": "§ 5 lg 2"
    },
    {
      "@id": "estleg:Reg_1063878_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kirjalik aruanne esitatakse viie tööpäeva jooksul pärast välislähetusest naasmist linna e-posti aadressile paide@paide.ee ja registreeritakse dokumendihaldussüsteemis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063878_Par_5"
      },
      "rdfs:label": "§ 5 lg 3"
    },
    {
      "@id": "estleg:Reg_1063878_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Samas välislähetuses viibinud võivad esitada aruande ühiselt.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1063878_Par_5"
      },
      "rdfs:label": "§ 5 lg 4"
    },
