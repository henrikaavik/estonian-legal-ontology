    {
      "@id": "estleg:Reg_1044940_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üüri piirmäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Paide linna munitsipaalomandis olevate eluruumide üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "1(1) Kehtestada Paide linna haldusterritooriumil asuvatele munitsipaalomandis olevatele eluruumidele (edaspidi eluruumid) üüri piirmäär 3,80 eurot ühe ruutmeetri kohta ühes kuus. 2(2) Üüri piirmäär ei sisalda kõrvalkulusid, mis on seotud eluruumi kasutamisega. 3(3) Konkreetse eluruumi üürisuuruse otsustab Paide Linnavalitsus arvestades eluruumi asukohta, ehituslikku seisukorda, veevarustuse ja kanalisatsiooni olemasolu, heakorda ja muid asjaolusid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Kehtestada Paide linna haldusterritooriumil asuvatele munitsipaalomandis olevatele eluruumidele (edaspidi eluruumid) üüri piirmäär 3,80 eurot ühe ruutmeetri kohta ühes kuus. 2(2) Üüri piirmäär ei sisalda kõrvalkulusid, mis on seotud eluruumi kasutamisega. 3(3) Konkreetse eluruumi üürisuuruse otsustab Paide Linnavalitsus arvestades eluruumi asukohta, ehituslikku seisukorda, veevarustuse ja kanalisatsiooni olemasolu, heakorda ja muid asjaolusid. 4(4) Üüri piirmäära minimaalne suurus on 1,50 eurot ühe ruutmeetri kohta ühes kuus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_paide_linnavolikogu"
      },
