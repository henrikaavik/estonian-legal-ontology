    {
      "@id": "estleg:Reg_1042454_Par_2_Lg_10",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "10",
      "estleg:legalText": "(10) Ametiautot võib garažeerida väljaspool määratud asukohta, kui see on seotud teenistus- töö või ametiülesannete täitmisega. Materiaalset vastutust ametiauto säilimise ja korrasoleku eest kannab garažeerija.",
      "estleg:parentProvision": {
