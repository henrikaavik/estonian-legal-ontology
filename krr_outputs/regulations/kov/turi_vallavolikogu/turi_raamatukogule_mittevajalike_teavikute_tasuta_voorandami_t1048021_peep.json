    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Raamatukogu võib tasuta võõrandada või müüa raamatukogule mittevajalikke teavikuid, mille kohta on koostatud kustutusakt.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Tasuta võõrandamiseks või müümiseks (edaspidi koos nimetatud võõrandamine) määratud teavikusse lüüakse raamatukogutempli peale kustutustempli jäljend ja kriipsutatakse läbi vöötkood.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Tasuta võõrandamiseks määratud teavikuid pakutakse esmalt teistele Türi valla asutustele ja võimalusel nii Türi valla haldusterritooriumil kui ka väljaspool Türi valla haldusterritooriumit asuvatele ning raamatukoguga koostööd tegevatele kultuuri-, haridus- ja sotsiaalasutustele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Tasuta võõrandamata jäänud ning müügiks mõeldud teavikuid võõrandatakse avaliku pakkumisega raamatukogus või avalikel üritusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 4"
    },
    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Teaviku müügihinna määrab raamatukogu direktor oma käskkirjaga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 5"
    },
    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Teade teavikute võõrandamisest, sellega seotud asjaoludest ja võõrandamisele kuuluvate teavikute nimekiri avalikustatakse internetis raamatukogu veebilehel ja teatena raamatukogu ruumides.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 6"
    },
    {
      "@id": "estleg:Reg_1048021_Par_2_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Teavikute võõrandamisega seotud asjaolud ning müügihinna kooskõlastab direktor raamatukogu nõukoguga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048021_Par_2"
      },
      "rdfs:label": "§ 2 lg 7"
    },
