      "estleg:sourceAct": "Türi Raamatukogule mittevajalike teavikute tasuta võõrandamise ja müügi kord",
      "estleg:summary": {
        "@value": "Määrusega sätestatakse Türi Raamatukogule (edaspidi raamatukogu) mittevajalike teavikute tasuta või tasu eest võõrandamise ehk müügi tingimused ning kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega sätestatakse Türi Raamatukogule (edaspidi raamatukogu) mittevajalike teavikute tasuta või tasu eest võõrandamise ehk müügi tingimused ning kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_turi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
