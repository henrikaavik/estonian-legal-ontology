    },
    {
      "@id": "estleg:Reg_1044081_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044081_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1044081_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest üle jäävat raha kasutatakse Türi valla koolides õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1044081_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1044081_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Koolilõuna toetuse kasutamise arvestus",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarve raha sihipärase kasutamise eest vastutab kooli direktor. 2(2)Riigieelarvest Türi vallale eraldatud koolilõuna toetuseks ette nähtud raha kasutamise üle peetakse raamatupidamises eraldi arvestust.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarve raha sihipärase kasutamise eest vastutab kooli direktor. 2(2)Riigieelarvest Türi vallale eraldatud koolilõuna toetuseks ette nähtud raha kasutamise üle peetakse raamatupidamises eraldi arvestust.",
