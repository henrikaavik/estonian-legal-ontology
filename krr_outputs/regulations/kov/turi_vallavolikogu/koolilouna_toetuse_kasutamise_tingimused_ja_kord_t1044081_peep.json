      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuse kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1(1)Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest üle jäävat raha kasutatakse Türi valla koolides õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest üle jäävat raha kasutatakse Türi valla koolides õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_turi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0834"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1044081_Map"
      },
