      ]
    },
    {
      "@id": "estleg:Reg_1044081_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1044081",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. Koolilõuna toetuse kasutamise arvestus",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "1(1)Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarve raha sihipärase kasutamise eest vastutab kooli direktor. Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarve raha sihipärase kasutamise eest vastutab kooli direktor. 2(2)Riigieelarvest Türi vallale eraldatud koolilõuna toetuseks ette nähtud raha kasutamise üle peetaks",
      "estleg:legalText": "1(1)Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarve raha sihipärase kasutamise eest vastutab kooli direktor. Õpilaste toitlustamist ja toitlustatud õpilaste üle arvestuse pidamist korraldab ning koolilõuna toetuseks eraldatud riigi- ja vallaeelarve raha sihipärase kasutamise eest vastutab kooli direktor. 2(2)Riigieelarvest Türi vallale eraldatud koolilõuna toetuseks ette nähtud raha kasutamise üle peetakse raamatupidamises eraldi arvestust. Riigieelarvest Türi vallale eraldatud koolilõuna toetuseks ette nähtud raha kasutamise üle peetakse raamatupidamises eraldi arvestust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_turi_vallavolikogu"
      },
