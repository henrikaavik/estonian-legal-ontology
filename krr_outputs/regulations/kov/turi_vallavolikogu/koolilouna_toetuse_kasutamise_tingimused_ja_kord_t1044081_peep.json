    {
      "@id": "estleg:Reg_1044081_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1044081",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Koolilõuna toetuse kasutamine",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "1(1)Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest üle jäävat raha kasutatakse Türi valla koolides õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus. Õpi",
      "estleg:legalText": "1(1)Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. Riigieelarvest Türi vallale eraldatud koolilõuna toetust kasutatakse Türi valla koolides põhi- ning keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest üle jäävat raha kasutatakse Türi valla koolides õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus. Õpilaste koolilõuna kulude katmisel riigieelarve eraldisest üle jäävat raha kasutatakse Türi valla koolides õpilaste toitlustamiseks pikapäevarühmas ja õpilaskodus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_turi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0834"
      },
