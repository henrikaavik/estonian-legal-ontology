    {
      "@id": "estleg:Reg_1059616_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Erisus ühisveevärgi ja -kanalisatsiooni arendamise kava avalikustamisel",
        "@language": "et"
      },
      "estleg:sourceAct": "Türi valla ühisveevärgi ja -kanalisatsiooni arendamise kava aastateks 2024–2036 kinnitamine",
      "estleg:summary": {
        "@value": "Tulenevalt ühisveevärgi ja -kanalisatsiooniseaduse § 15 lõikest 7 on Türi valla ühisveevärgi ja ‑kanalisatsiooni arendamise kava lisa 1 all märgitud joonistele (skeemidele) avaliku teabe seaduse § 35 lõike 1 punkti 181 alusel kehtestatud juurdepääsupiirang. Juurdepääsupiirang on kehtestatud alates 10. jaanuarist 2024 ja piirang kehtib 10. jaanuarini 2074 (viimane kuupäev kaasa arvatud).",
        "@language": "et"
      },
      "estleg:legalText": "Tulenevalt ühisveevärgi ja -kanalisatsiooniseaduse § 15 lõikest 7 on Türi valla ühisveevärgi ja ‑kanalisatsiooni arendamise kava lisa 1 all märgitud joonistele (skeemidele) avaliku teabe seaduse § 35 lõike 1 punkti 181 alusel kehtestatud juurdepääsupiirang. Juurdepääsupiirang on kehtestatud alates 10. jaanuarist 2024 ja piirang kehtib 10. jaanuarini 2074 (viimane kuupäev kaasa arvatud). Tulenevalt juurdepääsupiirangust ei avalikustata Türi valla ühisveevärgi ja ‑kanalisatsiooni arendamise kava aastateks 2024–2036 lisas 1 märgitud jooniseid (skeeme) Riigi Teatajas ega Türi valla veebilehel. Joonistele juurdepääs toimub avaliku teabe seadusega sätestatud alustel ja korras.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_turi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0834"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059616_Map"
      },
      "estleg:hasSubsection": [
