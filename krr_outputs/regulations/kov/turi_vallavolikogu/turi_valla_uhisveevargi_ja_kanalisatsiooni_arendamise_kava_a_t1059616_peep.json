        }
      ]
    },
    {
      "@id": "estleg:Reg_1059616_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Tulenevalt ühisveevärgi ja -kanalisatsiooniseaduse § 15 lõikest 7 on Türi valla ühisveevärgi ja ‑kanalisatsiooni arendamise kava lisa 1 all märgitud joonistele (skeemidele) avaliku teabe seaduse § 35 lõike 1 punkti 18¹ alusel kehtestatud juurdepääsupiirang. Juurdepääsupiirang on kehtestatud alates 10. jaanuarist 2024 ja piirang kehtib 10. jaanuarini 2074 (viimane kuupäev kaasa arvatud). Tulenevalt juurdepääsupiirangust ei avalikustata Türi valla ühisveevärgi ja ‑kanalisatsiooni arendamise kava aastateks 2024–2036 lisas 1 märgitud jooniseid (skeeme) Riigi Teatajas ega Türi valla veebilehel. Joonistele juurdepääs toimub avaliku teabe seadusega sätestatud alustel ja korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059616_Par_3"
