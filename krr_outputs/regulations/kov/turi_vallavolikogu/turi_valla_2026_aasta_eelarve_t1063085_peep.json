      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Eelarve seletuskiri",
        "@language": "et"
      },
      "estleg:sourceAct": "Türi valla 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "Eelarve täitmiseks ning eelarvesse planeeritud assigneeringute kasutamiseks kinnitada eelarve seletuskiri vastavalt määruse lisale 2.",
        "@language": "et"
      },
      "estleg:legalText": "Eelarve täitmiseks ning eelarvesse planeeritud assigneeringute kasutamiseks kinnitada eelarve seletuskiri vastavalt määruse lisale 2.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_turi_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0834"
      },
