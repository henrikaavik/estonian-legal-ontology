      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Nõo valla haldusterritooriumil maamaksumäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära, maamaksu tõusu piimäära suuruse ja kodualuse maa maksusoodustuse summa kehtestamine 2026. aastaks",
      "estleg:summary": {
        "@value": "Kehtestada 2026. aastal Nõo valla haldusterritooriumil maamaksumäär alljärgnevalt:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) maatulundusmaa kõlvikutele (välja arvatud õuemaa kõlvik) 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 2,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada 2026. aastal Nõo valla haldusterritooriumil maamaksumäär alljärgnevalt:11) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas;22) maatulundusmaa kõlvikutele (välja arvatud õuemaa kõlvik) 0,5 protsenti maa maksustamishinnast aastas;33) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 2,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_noo_vallavolikogu"
      },
