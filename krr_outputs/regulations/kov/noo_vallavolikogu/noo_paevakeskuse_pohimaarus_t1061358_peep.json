    {
      "@id": "estleg:Reg_1061358_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Juhtimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Nõo päevakeskuse põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Päevakeskuse tegevust korraldab päevakeskuse juhataja, kellega sõlmib, peatab, muudab ja lõpetab töölepingu vallavanem. 2(2)Päevakeskuse juhataja:11) esindab päevakeskust ja sõlmib lepinguid oma pädevuse piires;22) vastutab päevakeskuse tegevuse ja asjaajamise eest ning korraldab päevakeskuse tööd;33) on aruandekohustuslik Nõo valla ees päevakeskuse finants-, majandus- ja sisulises tegevuses;44) koostab päevakeskuse eelarve ja vastutab sellest kinnipidamise eest ning aruandluse õigeaegse…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Päevakeskuse tegevust korraldab päevakeskuse juhataja, kellega sõlmib, peatab, muudab ja lõpetab töölepingu vallavanem. 2(2)Päevakeskuse juhataja:11) esindab päevakeskust ja sõlmib lepinguid oma pädevuse piires;22) vastutab päevakeskuse tegevuse ja asjaajamise eest ning korraldab päevakeskuse tööd;33) on aruandekohustuslik Nõo valla ees päevakeskuse finants-, majandus- ja sisulises tegevuses;44) koostab päevakeskuse eelarve ja vastutab sellest kinnipidamise eest ning aruandluse õigeaegse esitamise eest;55) teeb vallavalitsusele ettepanekuid päevakeskuse töö paremaks korraldamiseks.",
