      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Enne käesoleva eeskirja jõustumist kiibiga märgistatud koer tuleb kanda registrisse hiljemalt 01.06.2014. a.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019214_Par_6"
      },
      "rdfs:label": "§ 6 lg 1",
      "estleg:assertionConfidence": {
