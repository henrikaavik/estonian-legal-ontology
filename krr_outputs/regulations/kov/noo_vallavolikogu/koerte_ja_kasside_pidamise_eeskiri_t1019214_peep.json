      }
    },
    {
      "@id": "estleg:Reg_1019214_Par_6_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Enne käesoleva eeskirja jõustumist registrisse kantud ilma kiibita koerad, tuleb märgistada kiibiga ja registreerida registris hiljemalt 1. jaanuariks 2017. Kuni kiibiga märgistamiseni tuleb kinnitada registreerimismärk koera kaelarihmale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1019214_Par_6"
      },
      "rdfs:label": "§ 6 lg 2",
      "estleg:assertionConfidence": {
