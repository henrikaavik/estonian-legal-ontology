        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Määrus jõustub 1. jaanuaril 2014. a.",
      "estleg:parentProvision": {
