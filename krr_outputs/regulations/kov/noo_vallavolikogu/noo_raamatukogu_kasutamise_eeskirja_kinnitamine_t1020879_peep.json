      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lugeja registreeritakse raamatukogu elektroonilises andmebaasis järgmiste andmetega: 1) nimi; 2) sünniaeg; 3) elukoht (aadress, postiindeks); 4) telefon, e-mail; 5) lugejarühm: täiskasvanu ja laps; 6) isikukood.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:itemNumber": [
