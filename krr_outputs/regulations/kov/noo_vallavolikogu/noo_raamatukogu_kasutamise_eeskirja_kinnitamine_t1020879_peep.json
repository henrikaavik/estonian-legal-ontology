        "6"
      ]
    },
    {
      "@id": "estleg:Reg_1020879_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lugejaks registreeritakse foto ja isikukoodiga isikuttõendava dokumendi alusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1020879_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lugejale kirjutatakse välja lugeja registreerimiskaart. Kaardile annab lugeja allkirja, millega võtab endale materiaalse vastutuse laenatud teavikute eest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_1020879_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Lugeja on kohustatud teavitama raamatukogu oma isiku- või kontaktandmete muutumisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
    {
      "@id": "estleg:Reg_1020879_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
