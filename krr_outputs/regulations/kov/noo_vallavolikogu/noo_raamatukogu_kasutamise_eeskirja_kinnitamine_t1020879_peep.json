    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Laenutus registreeritakse elektroonilises andmebaasis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Raamatukogu ei laenuta koju eriti väärtuslikke teavikuid ja ajalehti.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Laenutuste tähtajaks on 21 kalendripäeva, ajakirjadel 7 kalendripäeva.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Lugeja on kohustatud teavikuid hoolikalt hoidma, nende saamisel kontrollima korrasolekut ja rikkumistest teatama raamatukoguhoidjale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 4"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Lugejal ei ole õigust laenutada teavikuid teistele lugejatele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 5"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Lugeja võib teaviku tagastustähtaega pikendada kuni 3 korda, kui teavikut ei ole soovinud laenata teised lugejad.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 6"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Lugeja soovil pannakse ta vajaliku teaviku saamiseks järjekorda.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 7"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Lugeja on kohustatud laenatud teaviku tagastama laenutustähtaja jooksul. Kui lugeja ei tagasta laenatud teavikut tähtajaks, võib raamatukogu nõuda viivitatud aja eest tasu kuni 0,06 € iga viivitatud päeva eest ühe teaviku kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 8"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_9",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "9",
      "estleg:legalText": "(9) Teaviku rikkumise või tagastamata jätmise korral on lugeja kohustatud selle asendama teise eksemplari või raamatukoguhoidja poolt samaväärseks tunnistatud teavikuga või tasuma selle hinna kuni kümnekordses ulatuses. Alaealise poolt tekitatud kahju hüvitab lapsevanem (eestkostja).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 9"
    },
    {
      "@id": "estleg:Reg_1020879_Par_4_Lg_10",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "10",
      "estleg:legalText": "(10) Lugejalt võib nõuda teaviku kojulaenutamisel tagatist, kui lugeja rahvastikuregistrisse kantud elukohaks ei ole Nõo vald ja/või see on vajalik teaviku väärtuse tõttu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1020879_Par_4"
      },
      "rdfs:label": "§ 4 lg 10"
    },
    {
      "@id": "estleg:Reg_1020879_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Sisekord",
        "@language": "et"
      },
      "estleg:sourceAct": "Nõo Raamatukogu kasutamise eeskirja kinnitamine",
      "estleg:summary": {
        "@value": "1(1)Raamatukogu külastaja ei tohi oma käitumisega häirida teisi lugejaid. 2(2)Raamatukogu ruumides on keelatud söömine, joomine, suitsetamine, lärmi tekitamine ja mobiiltelefoniga rääkimine. 3(3)Raamatukogu ruumidesse on keelatud siseneda alkoholijoobes ja määrdunud riietega. 4(4)Avariiulite vahele on keelatud kaasa võtta mahukaid kotte.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Raamatukogu külastaja ei tohi oma käitumisega häirida teisi lugejaid. 2(2)Raamatukogu ruumides on keelatud söömine, joomine, suitsetamine, lärmi tekitamine ja mobiiltelefoniga rääkimine. 3(3)Raamatukogu ruumidesse on keelatud siseneda alkoholijoobes ja määrdunud riietega. 4(4)Avariiulite vahele on keelatud kaasa võtta mahukaid kotte.",
