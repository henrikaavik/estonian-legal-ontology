    },
    {
      "@id": "estleg:Reg_1045084_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Delegeerida sotsiaalhoolekande seaduse § 10 lg-d 2 ja 3, § 11 lg 2, § 15, § 15¹, § 21 lg 1, § 22¹ lõikes 3, § 70 lg 3, § 89, § 130² lg 2 ja 3, § 133 lg 10, § 134, § 135, § 142¹, § 144 lg-d 1, 1¹, 2 ja 3, § 156 lg-d 3², 3³ ja 3⁵ ning § 160 lg-d 1¹ ja 1² sätestatud kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Tapa Vallavalitsusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045084_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1045084_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Delegeerida lastekaitseseaduse § 11, § 15 lg 2, § 17 lg 1, § 23 lg 2, § 29 lg-d 3 ja 5, § 33 lg-tes 1 ja 3, § 34 lg 1, § 38 lg-tes 1 ja 5 ning § 39 lg 2 sätestatud kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine ning § 17 lg-s 2 toodud nõuandva komisjoni moodustamine Tapa Vallavalitsusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045084_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1045084_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Delegeerida riigilõivuseaduse § 35 lg 2, § 38 lg 1, § 39 lg 4 ja § 43 lg 1 sätestatud kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Tapa Vallavalitsusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045084_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
      "@id": "estleg:Reg_1045084_Par_1_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Delegeerida noorsootöö seaduse § 15² sätestatud valla pädevusse antud küsimuste lahendamine Tapa Vallavalitusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045084_Par_1"
      },
      "rdfs:label": "§ 1 lg 4"
    },
    {
      "@id": "estleg:Reg_1045084_Par_1_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Tapa Vallavalitsusel on haldusmenetluse seaduse § 8 lõike 2 alusel õigus määrata ametnik või ametnikud, kes täidavad Tapa Vallavalitsuse nimel käesoleva paragrahvi lõikudes 1 kuni 4 sätestatud ülesandeid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045084_Par_1"
      },
      "rdfs:label": "§ 1 lg 5"
    },
