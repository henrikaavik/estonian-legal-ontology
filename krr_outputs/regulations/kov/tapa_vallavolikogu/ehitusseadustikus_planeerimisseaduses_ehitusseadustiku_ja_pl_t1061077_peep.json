      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Volitada ehitusseadustiku ja planeerimisseaduse rakendamise seaduses kohaliku omavalitsuse üksuse pädevusse antud küsimuste lahendamine Tapa Vallavalitsusele.",
      "estleg:parentProvision": {
