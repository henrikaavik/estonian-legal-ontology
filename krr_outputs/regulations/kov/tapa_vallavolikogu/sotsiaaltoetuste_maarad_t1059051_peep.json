      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Sotsiaaltoetuste määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Sotsiaaltoetuste määrad",
      "estleg:summary": {
        "@value": "Kehtestatakse Tapa vallas makstavate sotsiaaltoetuste määrad järgmiselt: 1 1) sünnitoetus 400 eurot; 2 2) matusetoetus 250 eurot; 3 3) ranitsatoetus 150 eurot; 4 4) eaka sünnipäevatoetus 75 eurot; 5 5) toimetuleku tagamise toetuse piirmäär kuni 500 eurot aastas; 6 6) vältimatu abi toetuse piirmäär kuni 1000 eurot aastas; 7 7) keskmise ja raske puudega isiku hooldajatoetus 100 eurot kuus; 8 8) sügava puudega isiku hooldajatoetus 150 eurot kuus.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestatakse Tapa vallas makstavate sotsiaaltoetuste määrad järgmiselt: 1 1) sünnitoetus 400 eurot; 2 2) matusetoetus 250 eurot; 3 3) ranitsatoetus 150 eurot; 4 4) eaka sünnipäevatoetus 75 eurot; 5 5) toimetuleku tagamise toetuse piirmäär kuni 500 eurot aastas; 6 6) vältimatu abi toetuse piirmäär kuni 1000 eurot aastas; 7 7) keskmise ja raske puudega isiku hooldajatoetus 100 eurot kuus; 8 8) sügava puudega isiku hooldajatoetus 150 eurot kuus.",
      "estleg:enactedBy": {
