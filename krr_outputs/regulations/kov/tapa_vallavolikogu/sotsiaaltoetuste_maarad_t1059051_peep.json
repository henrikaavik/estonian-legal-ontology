    {
      "@id": "estleg:Reg_1059051_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestatakse Tapa vallas makstavate sotsiaaltoetuste määrad järgmiselt: 1) sünnitoetus 400 eurot; 2) matusetoetus 250 eurot; 3) ranitsatoetus 150 eurot; 4) eaka sünnipäevatoetus 75 eurot; 5) toimetuleku tagamise toetuse piirmäär kuni 500 eurot aastas; 6) vältimatu abi toetuse piirmäär kuni 1000 eurot aastas; 7) keskmise ja raske puudega isiku hooldajatoetus 100 eurot kuus; 8) sügava puudega isiku hooldajatoetus 150 eurot kuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059051_Par_1"
      },
