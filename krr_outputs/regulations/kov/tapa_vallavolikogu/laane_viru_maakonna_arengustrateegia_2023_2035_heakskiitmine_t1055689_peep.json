        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Maakonna arengustrateegia loetakse vastuvõetuks ja see jõustub pärast seda, kui...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Viru maakonna arengustrateegia 2023-2035 heakskiitmine",
      "estleg:summary": {
        "@value": "Maakonna arengustrateegia loetakse vastuvõetuks ja see jõustub pärast seda, kui vähemalt kaks kolmandikku maakonna selliste kohaliku omavalitsuse üksuste volikogudest, mille elanike koguarv moodustab vähemalt kaks kolmandikku maakonna elanike koguarvust ning mille hulka peab kuuluma ka maakonnakeskuseks olev kohaliku omavalitsuse üksus, on selle määrusega heaks kiitnud hiljemalt 15. jaanuaril.",
        "@language": "et"
      },
      "estleg:legalText": "Maakonna arengustrateegia loetakse vastuvõetuks ja see jõustub pärast seda, kui vähemalt kaks kolmandikku maakonna selliste kohaliku omavalitsuse üksuste volikogudest, mille elanike koguarv moodustab vähemalt kaks kolmandikku maakonna elanike koguarvust ning mille hulka peab kuuluma ka maakonnakeskuseks olev kohaliku omavalitsuse üksus, on selle määrusega heaks kiitnud hiljemalt 15. jaanuaril. Maakonnakeskuseks loetakse kohaliku omavalitsuse üksust, mis on maakonnaplaneeringus maakonnakeskusena nimetatud.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tapa_vallavolikogu"
      },
