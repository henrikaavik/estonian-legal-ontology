      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Kohanime määramise avalikustamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanimede määramise kord",
      "estleg:summary": {
        "@value": "Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist Tapa valla ajalehes Sõnumed ning Tapa valla veebilehel www.tapa.ee. Sätet ei kohaldata maaüksuse nime määramisel.",
        "@language": "et"
      },
      "estleg:legalText": "Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist Tapa valla ajalehes Sõnumed ning Tapa valla veebilehel www.tapa.ee. Sätet ei kohaldata maaüksuse nime määramisel.",
