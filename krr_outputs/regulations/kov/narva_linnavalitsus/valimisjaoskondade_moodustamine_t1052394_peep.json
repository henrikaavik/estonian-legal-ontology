    {
      "@id": "estleg:Reg_1052394_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 5. Valimisjaoskond nr 5 korraldab hääletamist vajadusel ka asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 5 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik jaoskonnad.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 5. Valimisjaoskond nr 5 korraldab hääletamist vajadusel ka asukohas, kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 5 hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik jaoskonnad. Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 5 ka asukohas hääletamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_narva_linnavalitsus"
      },
