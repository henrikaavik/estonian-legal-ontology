        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad kõik jaoskonnad. Euroopa Parlamendi valimistel ja rahvahääletusel korraldab valimisjaoskond nr 5 ka asukohas hääletamist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052394_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
