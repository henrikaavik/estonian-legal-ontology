    {
      "@id": "estleg:Reg_1047251_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Ametiauto kasutaja kohustused",
        "@language": "et"
      },
      "estleg:sourceAct": "Ametiautode kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Ametiauto kasutaja on kohustatud: 1 1) kooskõlastama ühiskasutatava ametiauto kasutamise ametiasutuse juhi poolt määratud teenistujaga, kes reguleerib ühiskasutuses olevate ametiautode kasutust ja hoiab ametiautode dokumente ja võtmeid. 2 2) jälgima kütuse näidikut ja tankima vajadusel ametiauto oma sõidu lõppedes; 3 3) kasutama autot hoolikalt, heaperemehelikult ja säästlikult ning kooskõlas ametiauto kasutusse andmise eesmärgiga; 4 4) hoidma puhtana ametiauto salongi ja koristama…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ametiauto kasutaja on kohustatud: 1 1) kooskõlastama ühiskasutatava ametiauto kasutamise ametiasutuse juhi poolt määratud teenistujaga, kes reguleerib ühiskasutuses olevate ametiautode kasutust ja hoiab ametiautode dokumente ja võtmeid. 2 2) jälgima kütuse näidikut ja tankima vajadusel ametiauto oma sõidu lõppedes; 3 3) kasutama autot hoolikalt, heaperemehelikult ja säästlikult ning kooskõlas ametiauto kasutusse andmise eesmärgiga; 4 4) hoidma puhtana ametiauto salongi ja koristama ametiauto pärast sõitu; 5 5) mitte andma ametiautot kolmandate isikute kasutusse; 6 6) enne väljasõitu veenduma sõiduki korrasolekus; 7 7) teavitama vastutavat isikut kõikidest ametiautoga seotud probleemidest; 8 8) informeerima vastutavat isikut või asutuse juhti viivitamatult ametiauto hävimisest, ärandamisest, olulisest kahjustumisest; 9 9) tasuma ametiauto kasutamise nõuete rikkumisest tulenevad trahvid ja muud kulud, samuti nende sissenõudmisega seotud kulud, leppetrahvid ja viivised. 2 (2) Ametiauto võib olla varustatud GPS seadmega. Kui ametiautole ei ole paigaldatud GPS seadet on ametiauto kasutaja kohustatud pidama sõidupäevikut, milles näidatakse: 1 1) auto omaniku või vastutava kasutaja nimi, registrikood; 2 2) auto riiklik registreerimismärk; 3 3) sõidu kuupäev; 4 4) läbisõidumõõdiku alg- ja lõppnäit ning läbisõit iga sõidukorra puhul; 5 5) sõidu eesmärk ja sihtkoht iga sõidukorra puhul; 6 6) kasutaja nimi ja allkiri, millega kinnitatakse sõidupäevikusse kantud andmete õigsust.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_narva_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0511"
