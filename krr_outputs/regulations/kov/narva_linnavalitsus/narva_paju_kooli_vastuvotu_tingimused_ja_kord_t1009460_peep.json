    {
      "@id": "estleg:Reg_1009460_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õpilaste vastuvõtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Narva Paju Kooli vastuvõtu tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Vastuvõttu õppimiseks Narva Paju Kooli põhikooli astmes võib taotleda iga koolikohustuslik isik või tema seaduslik esindaja. 2 (2) Kooli vastuvõtmise taotluse esitab isik (piiratud teovõimega õpilase puhul tema seaduslik esindaja) kirjalikult kooli kantseleisse ja vastuvõtu otsustab kooli direktor vastavalt käesolevale korrale. 3 (3) Narva Paju Kool on kohustatud tagama õppimisvõimalused igale koolikohustuslikule isikule, kellele on see kool elukohajärgne.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vastuvõttu õppimiseks Narva Paju Kooli põhikooli astmes võib taotleda iga koolikohustuslik isik või tema seaduslik esindaja. 2 (2) Kooli vastuvõtmise taotluse esitab isik (piiratud teovõimega õpilase puhul tema seaduslik esindaja) kirjalikult kooli kantseleisse ja vastuvõtu otsustab kooli direktor vastavalt käesolevale korrale. 3 (3) Narva Paju Kool on kohustatud tagama õppimisvõimalused igale koolikohustuslikule isikule, kellele on see kool elukohajärgne.",
