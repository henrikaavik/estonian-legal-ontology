      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Suletud tarbijapakendis alkohoolse joogi jaemüük toitlustus- ja majutusettevõttest väljaviimiseks ei ole lubatud.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1014955_Par_1"
      },
      "rdfs:label": "§ 1 lg 4",
