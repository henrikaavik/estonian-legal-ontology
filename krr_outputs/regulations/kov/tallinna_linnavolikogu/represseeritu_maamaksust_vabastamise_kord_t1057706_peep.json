      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Represseeritu maamaksust vabastamise kord",
      "estleg:summary": {
        "@value": "Määrusega reguleeritakse okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes õigusvastaselt represseeritud isiku või represseerituga võrdsustatud isiku (edaspidi koos represseeritu) vabastamist maamaksu tasumisest.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega reguleeritakse okupatsioonirežiimide poolt represseeritud isiku seaduse mõistes õigusvastaselt represseeritud isiku või represseerituga võrdsustatud isiku (edaspidi koos represseeritu) vabastamist maamaksu tasumisest.",
      "estleg:enactedBy": {
