      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Tallinna lemmikloomade pidamise eeskiri",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1064393_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Tallinna lemmikloomade pidamise eeskirjas (edaspidi eeskiri) kehtestatakse lemmikloomade pidamise nõuded Tallinna haldusterritooriumil. 2 (2) Eeskirja on kohustatud täitma kõik loomapidajad. Loomapidaja on füüsiline või juriidiline isik, kelle omandis või valduses on lemmikloom või kes peab lemmiklooma kokkuleppel omanikuga rendi- või muu lepingulise suhte alusel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Tallinna lemmikloomade pidamise eeskirjas (edaspidi eeskiri) kehtestatakse lemmikloomade pidamise nõuded Tallinna haldusterritooriumil. 2 (2) Eeskirja on kohustatud täitma kõik loomapidajad. Loomapidaja on füüsiline või juriidiline isik, kelle omandis või valduses on lemmikloom või kes peab lemmiklooma kokkuleppel omanikuga rendi- või muu lepingulise suhte alusel.",
