      }
    },
    {
      "@id": "estleg:Reg_1038505_Par_6_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kaitsealal on poollooduslike koosluste esinemise aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine ning puu- ja põõsarinde kujundamine.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038505_Par_6"
      },
      "rdfs:label": "§ 6 lg 1"
    },
    {
      "@id": "estleg:Reg_1038505_Par_6_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Külastuskoormuse suunamiseks tuleb osa jalgteid rekonstrueerida või sulgeda looduslähedasel viisil.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038505_Par_6"
      },
      "rdfs:label": "§ 6 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
