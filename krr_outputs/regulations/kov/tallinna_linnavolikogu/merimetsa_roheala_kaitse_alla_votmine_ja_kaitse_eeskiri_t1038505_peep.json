      }
    },
    {
      "@id": "estleg:Reg_1038505_Par_7_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kaitseala valitseja ei kooskõlasta tegevust, mis vajab kaitse-eeskirja kohaselt tema nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038505_Par_7"
      },
      "rdfs:label": "§ 7 lg 1",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      }
    },
    {
      "@id": "estleg:Reg_1038505_Par_7_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuses ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmisel tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt haldusmenetluse seadusele õiguspärast ootust sellise tegevuse õiguspärasuse suhtes.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1038505_Par_7"
      },
      "rdfs:label": "§ 7 lg 2",
      "estleg:targetGroup": [
