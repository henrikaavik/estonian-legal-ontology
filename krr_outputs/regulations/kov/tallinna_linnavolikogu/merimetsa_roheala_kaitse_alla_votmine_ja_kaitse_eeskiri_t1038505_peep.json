    {
      "@id": "estleg:Reg_1038505_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Keelatud  tegevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Merimetsa roheala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Kaitsealal on keelatud: 1 1) maavarade kaevandamine; 2 2) uuendusraie; 3 3) biotsiidi, taimekaitsevahendi ja väetise kasutamine; 4 4) telkimine ja lõkke tegemine. Grillimine on lubatud ainult selleks ette valmistatud kohtades; 5 5) teede ja tehnovõrgu rajatiste rajamine ning ehitiste püstitamine. Erandina võib kaitseala valitseja nõusolekul rajada teid ja tehnovõrgu rajatisi ning püstitada ehitisi kaitsekorraldus- ja puhkeotstarbeks ning teha olemasolevate rajatiste hooldus- ja remonttöid.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaitsealal on keelatud: 1 1) maavarade kaevandamine; 2 2) uuendusraie; 3 3) biotsiidi, taimekaitsevahendi ja väetise kasutamine; 4 4) telkimine ja lõkke tegemine. Grillimine on lubatud ainult selleks ette valmistatud kohtades; 5 5) teede ja tehnovõrgu rajatiste rajamine ning ehitiste püstitamine. Erandina võib kaitseala valitseja nõusolekul rajada teid ja tehnovõrgu rajatisi ning püstitada ehitisi kaitsekorraldus- ja puhkeotstarbeks ning teha olemasolevate rajatiste hooldus- ja remonttöid. 2 (2) Kaitseala valitseja nõusolekuta on kaitsealal keelatud: 1 1) katastriüksuse kõlvikute piiride ja sihtotstarbe muutmine; 2 2) maakorralduskava koostamine ja maakorraldustoimingud; 3 3) metsamajandamiskava väljastamine; 4 4) detail- ja üldplaneeringu kehtestamine; 5 5) ehitusteatise kohustusega või ehitusloakohustusliku ehitise ehitamiseks loa andmine; 6 6) projekteerimistingimuste andmine; 7 7) ehitusloa andmine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
