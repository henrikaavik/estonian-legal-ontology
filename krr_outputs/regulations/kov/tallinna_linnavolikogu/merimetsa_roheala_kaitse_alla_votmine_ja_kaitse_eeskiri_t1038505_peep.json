    {
      "@id": "estleg:Reg_1038505_Par_7",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Tegevuse  kooskõlastamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Merimetsa roheala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Kaitseala valitseja ei kooskõlasta tegevust, mis vajab kaitse-eeskirja kohaselt tema nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit. 2 (2) Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuses ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmisel tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaitseala valitseja ei kooskõlasta tegevust, mis vajab kaitse-eeskirja kohaselt tema nõusolekut, kui see võib kahjustada kaitseala kaitse-eesmärgi saavutamist või kaitseala seisundit. 2 (2) Kui tegevust ei ole kaitseala valitsejaga kooskõlastatud või tegevuses ei ole arvestatud kaitseala valitseja kirjalikult seatud tingimusi, mille täitmisel tegevus ei kahjusta kaitseala kaitse-eesmärgi saavutamist või seisundit, ei teki isikul, kelle huvides nimetatud tegevus on, vastavalt haldusmenetluse seadusele õiguspärast ootust sellise tegevuse õiguspärasuse suhtes.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038505_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1038505_Par_7_Lg_1"
        },
