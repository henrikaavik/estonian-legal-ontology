    {
      "@id": "estleg:Reg_1038505_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Vajalik tegevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Merimetsa roheala kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Kaitsealal on poollooduslike koosluste esinemise aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine ning puu- ja põõsarinde kujundamine. 2 (2) Külastuskoormuse suunamiseks tuleb osa jalgteid rekonstrueerida või sulgeda looduslähedasel viisil. 3 (3) Lodumetsa alal tuleb reguleerida vooluveekogude veetaset (paisutada kraave), et taastada looduslik veerežiim.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaitsealal on poollooduslike koosluste esinemise aladel nende ilme ja liigikoosseisu tagamiseks vajalik niitmine ning puu- ja põõsarinde kujundamine. 2 (2) Külastuskoormuse suunamiseks tuleb osa jalgteid rekonstrueerida või sulgeda looduslähedasel viisil. 3 (3) Lodumetsa alal tuleb reguleerida vooluveekogude veetaset (paisutada kraave), et taastada looduslik veerežiim.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1038505_Map"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
