      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäära kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäära kehtestamine",
      "estleg:summary": {
        "@value": "Tallinna linnas on vastavalt maa sihtotstarbele maamaksumäär alates 1. jaanuarist 2024 järgmine: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku puhul 0,5% maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5% maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 1% maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Tallinna linnas on vastavalt maa sihtotstarbele maamaksumäär alates 1. jaanuarist 2024 järgmine: 1 1) elamumaa ja maatulundusmaa õuemaa kõlviku puhul 0,5% maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5% maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 1% maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
      },
