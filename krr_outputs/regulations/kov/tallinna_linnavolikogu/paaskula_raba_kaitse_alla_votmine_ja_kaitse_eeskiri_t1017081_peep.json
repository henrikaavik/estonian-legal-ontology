    {
      "@id": "estleg:Reg_1017081_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Lubatud tegevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Pääsküla raba kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Inimestel on lubatud viibida kogu kaitsealal ning korjata seal marju, seeni ja muid metsa kõrvalsaadusi. 2 (2) Kaitsealal on lubatud korraldada kuni 50 osalejaga rahvaüritusi paikades, mille kaitseala valitseja on selleks ette valmistanud ja tähistanud. Rohkem kui 50 osalejaga rahvaürituse korraldamine ning rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohtades on lubatud üksnes kaitseala valitseja nõusolekul.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Inimestel on lubatud viibida kogu kaitsealal ning korjata seal marju, seeni ja muid metsa kõrvalsaadusi. 2 (2) Kaitsealal on lubatud korraldada kuni 50 osalejaga rahvaüritusi paikades, mille kaitseala valitseja on selleks ette valmistanud ja tähistanud. Rohkem kui 50 osalejaga rahvaürituse korraldamine ning rahvaürituse korraldamine selleks ettevalmistamata ja tähistamata kohtades on lubatud üksnes kaitseala valitseja nõusolekul. 3 (3) Mootorsõiduki ja maastikusõidukiga võib kaitsealal sõita kaitseala valitseja nõusolekul. Jalgrattaga on lubatud sõita teedel ja kattega radadel. 4 (4) Kaitseala valitseja nõusolekul on lubatud: 1 1) kaitsealuste liikide elutingimuste säilitamiseks vajalik tegevus; 2 2) kraavide sulgemine ja veetaseme reguleerimine sookoosluse veerežiimi taastamiseks; 3 3) metsakoosluste kujundamine vastavalt kaitse-eesmärgile. Kaitseala valitsejal on õigus esitada nõudeid raie tehnoloogia ja aja, puidu kokku- ja väljaveo, raielangi puhastamise viiside ning puistu koosseisu ja täiuse kohta.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
