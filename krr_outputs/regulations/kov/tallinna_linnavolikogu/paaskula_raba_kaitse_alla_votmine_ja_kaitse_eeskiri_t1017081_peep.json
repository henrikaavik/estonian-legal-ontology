    {
      "@id": "estleg:Reg_1017081_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Keelatud tegevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Pääsküla raba kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:summary": {
        "@value": "1 (1) Kaitsealal on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavarade kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) uuendusraie; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine; 6 6) jahipidamine ja kalapüük; 7 7) telkimine ja lõkke tegemine; 8 8) roo varumine külmumata pinnasel; 9 9) tee ja tehnovõrgu rajatiste rajamine ning ehitiste püstitamine.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaitsealal on keelatud: 1 1) uue maaparandussüsteemi rajamine; 2 2) maavarade kaevandamine; 3 3) puhtpuistute kujundamine ja energiapuistute rajamine; 4 4) uuendusraie; 5 5) biotsiidi, taimekaitsevahendi ja väetise kasutamine; 6 6) jahipidamine ja kalapüük; 7 7) telkimine ja lõkke tegemine; 8 8) roo varumine külmumata pinnasel; 9 9) tee ja tehnovõrgu rajatiste rajamine ning ehitiste püstitamine. Erandina võib kaitseala valitseja nõusolekul rajada teid ja tehnovõrgu rajatisi ning püstitada ehitisi kaitsekorraldus- ja virgestusotstarbeks ning teha olemasolevate rajatiste hooldus- ja remonttöid. 2 (2) Kaitseala valitseja nõusolekuta on kaitsealal keelatud: 1 1) katastriüksuse kõlvikute piiride ja sihtotstarbe muutmine; 2 2) maakorralduskava koostamine ja maakorraldustoimingud; 3 3) metsamajandamiskava väljastamine; 4 4) detail- ja üldplaneeringu kehtestamine; 5 5) nõusoleku andmine väikeehitise ehitamiseks; 6 6) projekteerimistingimuste andmine; 7 7) ehitusloa andmine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
