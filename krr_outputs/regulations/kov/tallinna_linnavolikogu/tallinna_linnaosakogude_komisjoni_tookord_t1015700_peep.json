    {
      "@id": "estleg:Reg_1015700_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Komisjoni kokkukutsumise kord ja tähtajad on kehtestatud Tallinna linnaosade ja linnaosade valitsuste põhimääruste §-des 8–9.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015700_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1015700_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Komisjon on otsustusvõimeline, kui selle koosolekust võtab osa vähemalt pool komisjoni koosseisust, sealhulgas esimees või aseesimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015700_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1015700_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Komisjoni koosolek protokollitakse ning neile kirjutavad alla koosoleku juhataja ja protokollija. Protokollid peavad vastama haldusdokumentidele kehtestatud põhinõuetele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015700_Par_4"
      },
      "rdfs:label": "§ 4 lg 4",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:Reg_1015700_Par_4_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Komisjoni koosolek on avalik. Igaühel on õigus tutvuda komisjoni otsusega ja koosoleku protokollidega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015700_Par_4"
      },
      "rdfs:label": "§ 4 lg 5",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Right"
      }
    },
    {
      "@id": "estleg:Reg_1015700_Par_4_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Komisjon otsustab tema pädevuses olevaid asju poolthäälte enamusega. Komisjoni liikme eriarvamus kantakse koosoleku protokolli.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1015700_Par_4"
      },
      "rdfs:label": "§ 4 lg 6",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
