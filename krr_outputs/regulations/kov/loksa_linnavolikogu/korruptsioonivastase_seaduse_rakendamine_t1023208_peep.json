      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Linnapea ülesanded korruptsiooniennetuse koordineerimisel",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "1(1)Linnapea koordineerib korruptsiooniennetust linnavalitsuses ning hallatavates asutustes ja tagab:11) ametiisikute korruptsiooni ennetamise alase teadlikkuse, s.h teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest;22) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle;33) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes;44) arvestuse pidamise ametiasutuse ametnike…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Linnapea koordineerib korruptsiooniennetust linnavalitsuses ning hallatavates asutustes ja tagab:11) ametiisikute korruptsiooni ennetamise alase teadlikkuse, s.h teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest;22) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle;33) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes;44) arvestuse pidamise ametiasutuse ametnike tegelemise üle avaliku teenistuse seaduses (edaspidi ATS) § 60 lõikes 1 nimetatud kõrvaltegevustega, samuti kontrolli ATS § 60 lõike 2 alusel kehtestatud keelu ning ATS § 60 lõigetes 4 ja 5 sätestatud keeldude järgimise üle. 2(2)Iga aasta 30. septembriks esitab linnapea komisjonile ülevaate käesoleva paragrahvi lõikes 1 nimetatud kohustuste täitmise kohta.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_loksa_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
