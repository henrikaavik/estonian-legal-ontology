      }
    },
    {
      "@id": "estleg:Reg_1061822_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppimiskohustuse seire ja abimeetmete pakkumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Kooli valdkonna vastutavad töötajad algatavad lapse õppimiskohustuse mittetäimise korral hindamise, rakendavad esmaseid tugimeetmeid ning vajadusel teavitavad kohalikku omavalitsust. 2(2)Õppimiskohustuse täitmise seiret kohalikus omavalitsuses koordineerib valdkonna abilinnapea. 3(3)Õppimiskohustuse tagamiseks vajalikke meetmeid korraldavad ja osutavad Loksa Gümnaasiumi tugispetsialistid ning linnavalitsuse sotsiaal- ja haridusvaldkonna spetsialistid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kooli valdkonna vastutavad töötajad algatavad lapse õppimiskohustuse mittetäimise korral hindamise, rakendavad esmaseid tugimeetmeid ning vajadusel teavitavad kohalikku omavalitsust. 2(2)Õppimiskohustuse täitmise seiret kohalikus omavalitsuses koordineerib valdkonna abilinnapea. 3(3)Õppimiskohustuse tagamiseks vajalikke meetmeid korraldavad ja osutavad Loksa Gümnaasiumi tugispetsialistid ning linnavalitsuse sotsiaal- ja haridusvaldkonna spetsialistid. 4(4)Õppimiskohustuse mittetäitmisel kaasatakse abinõude rakendamisel last kasvatavad isikud. 5(5)Kui õppimiskohustuslik laps õpib väljaspool elukohajärgset omavalitsust, tehakse koostööd vastava kohaliku omavalitsusega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_loksa_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0424"
