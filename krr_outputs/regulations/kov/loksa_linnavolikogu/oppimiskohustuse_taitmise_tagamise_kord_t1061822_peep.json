    {
      "@id": "estleg:Reg_1061822_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "1(1)Kord sätestab rahvastikuregistri järgi Loksa linna haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöökorralduse. 2(2)Korda rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kord sätestab rahvastikuregistri järgi Loksa linna haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamise ja koostöökorralduse. 2(2)Korda rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_loksa_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0424"
      },
