        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Õppimiskohustuse tagamiseks vajalikke meetmeid korraldavad ja osutavad Loksa Gümnaasiumi tugispetsialistid ning linnavalitsuse sotsiaal- ja haridusvaldkonna spetsialistid.",
