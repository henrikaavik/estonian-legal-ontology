        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kiili valla kaasava eelarve eesmärk on elanike kaasamine valla eelarve koostamisse. Kiili valla elanikel on võimalus teha ettepanekuid valla elu edendamiseks ja osaleda hääletusel parimate ideede väljaselgitamiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1057168_Par_1"
