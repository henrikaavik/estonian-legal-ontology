      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Tasuta lumetõrje teostamiseks esitatakse Kiili Vallavalitsusele vormikohane taotlus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1005017_Par_2"
