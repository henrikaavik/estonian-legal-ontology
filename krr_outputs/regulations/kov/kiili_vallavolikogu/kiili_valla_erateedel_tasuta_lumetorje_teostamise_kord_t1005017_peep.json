      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lumetõrje teostus peab olema lõpetatud 36 h pärast lumesaju lõppu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1005017_Par_2"
