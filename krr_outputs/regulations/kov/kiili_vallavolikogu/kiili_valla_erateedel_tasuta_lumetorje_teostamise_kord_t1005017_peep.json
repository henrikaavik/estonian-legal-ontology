      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1005017_Par_2_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Tasuta lumetõrjet võidakse erandina teostada ka selleks mittekvalifitseeruvate erateede osas, kui selleks on mõjuvad põhjused. Vastavate mõjuvate põhjuste all peetakse eelkõige silmas taotleja või tema leibkonna halba tervislikku seisundit, kõrget iga, sotsiaalset olukorda või muid sarnaseid olukordi.",
      "estleg:parentProvision": {
