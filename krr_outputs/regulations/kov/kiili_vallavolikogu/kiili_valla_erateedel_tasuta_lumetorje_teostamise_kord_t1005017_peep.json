      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1005017_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Tasuta lumetõrjet alustatakse kuni 12 h jooksul peale tuisu või lumesaju lõppemist ning juhul kui lumekihi paksus ületab sõiduteel 10 cm. Lumetõrje teostamine ei sisalda libedusetõrjet.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1005017_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
