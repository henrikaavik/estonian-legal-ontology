        }
      ]
    },
    {
      "@id": "estleg:Reg_1005017_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse avalikuks kasutamiseks määramata ning hajaasustusalal asuvatel erateedel tasuta lumetõrje teostamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1005017_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1005017_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Hajaasustusala all peetakse käesolevas määruses silmas maaala, mis ei ole planeeringuga määratud tiheasustusalaks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1005017_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1005017_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tasuta lumetõrje teostamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kiili valla erateedel tasuta lumetõrje teostamise kord",
      "estleg:summary": {
        "@value": "1(1)Tasuta lumetõrjet teostatakse erateedel, mis viivad hajaasustuses asuvate aastaringselt alalise elukohana kasutatavate majapidamisteni. 2(2)Tasuta lumetõrjet alustatakse kuni 12 h jooksul peale tuisu või lumesaju lõppemist ning juhul kui lumekihi paksus ületab sõiduteel 10 cm. Lumetõrje teostamine ei sisalda libedusetõrjet. 3(3)Lumetõrje teostus peab olema lõpetatud 36 h pärast lumesaju lõppu. 4(4)Tasuta lumetõrje teostamiseks esitatakse Kiili Vallavalitsusele vormikohane taotlus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Tasuta lumetõrjet teostatakse erateedel, mis viivad hajaasustuses asuvate aastaringselt alalise elukohana kasutatavate majapidamisteni. 2(2)Tasuta lumetõrjet alustatakse kuni 12 h jooksul peale tuisu või lumesaju lõppemist ning juhul kui lumekihi paksus ületab sõiduteel 10 cm. Lumetõrje teostamine ei sisalda libedusetõrjet. 3(3)Lumetõrje teostus peab olema lõpetatud 36 h pärast lumesaju lõppu. 4(4)Tasuta lumetõrje teostamiseks esitatakse Kiili Vallavalitsusele vormikohane taotlus. 5(5)Tasuta lumetõrjet ei teostata:11) erateel, mis viib kinnistule, kus alaliselt ei elata;22) erateel,mis asub kogu pikkuses avalikult kasutatava teega piirneval kinnistul ja kinnistul asuv eluhoone on avalikust teest vähem kui 100 meetri kaugusel;33) õuealal;44) kui see ei ole tehniliselt võimalik;55) kui see seab ohtu taotleja, teeomaniku või kolmandate isikute vara või rikub muul viisil puudutatud isikute õiguseid. 6(6)Tasuta lumetõrjet võidakse erandina teostada ka selleks mittekvalifitseeruvate erateede osas, kui selleks on mõjuvad põhjused. Vastavate mõjuvate põhjuste all peetakse eelkõige silmas taotleja või tema leibkonna halba tervislikku seisundit, kõrget iga, sotsiaalset olukorda või muid sarnaseid olukordi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kiili_vallavolikogu"
      },
