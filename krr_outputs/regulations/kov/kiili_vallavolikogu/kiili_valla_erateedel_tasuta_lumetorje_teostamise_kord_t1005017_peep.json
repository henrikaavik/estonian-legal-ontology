        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Kiili valla erateedel tasuta lumetõrje teostamise kord",
      "estleg:summary": {
        "@value": "1(1)Määrusega kehtestatakse avalikuks kasutamiseks määramata ning hajaasustusalal asuvatel erateedel tasuta lumetõrje teostamise tingimused ja kord. 2(2)Hajaasustusala all peetakse käesolevas määruses silmas maaala, mis ei ole planeeringuga määratud tiheasustusalaks.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Määrusega kehtestatakse avalikuks kasutamiseks määramata ning hajaasustusalal asuvatel erateedel tasuta lumetõrje teostamise tingimused ja kord. 2(2)Hajaasustusala all peetakse käesolevas määruses silmas maaala, mis ei ole planeeringuga määratud tiheasustusalaks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kiili_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0304"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1005017_Map"
      },
