    {
      "@id": "estleg:Reg_1013354_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) 1.8.2012.a. moodustada Käina Vallavalitsuse hallatav asutus „Käina Spordikeskus“ asukohaga Hiiumaa Käina vald Käina alevik Mäe tänav 4 valla elanikele sporditeenuste osutamiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013354_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1013354_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kinnitada hallatava asutuse „Käina Spordikeskus“ põhikiri (Lisa 1).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013354_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1013354_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Hallatava asutuse „Käina Spordikeskus“ tööd hakkab juhtima juhataja, kes otseselt allub vallavanemale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013354_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
      "@id": "estleg:Reg_1013354_Par_1_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Määrata määruse täitmise eest vastutavaks vallavanem, kellel koostöös vallavalitsusega tagada uue asutuse registreerimine Riigi- ja kohaliku omavalitsuse riiklikus registris.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1013354_Par_1"
      },
      "rdfs:label": "§ 1 lg 4"
    },
    {
      "@id": "estleg:Reg_1013354_Par_1_Lg_5",
