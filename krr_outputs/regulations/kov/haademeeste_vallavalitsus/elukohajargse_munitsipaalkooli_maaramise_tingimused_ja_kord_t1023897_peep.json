    {
      "@id": "estleg:Reg_1023897_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Põhiharidust omandava õpilase üleminek ühest koolist teise",
        "@language": "et"
      },
      "estleg:sourceAct": "Elukohajärgse munitsipaalkooli määramise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Statsionaarses õppes põhiharidust omandava õpilase üleminekul ühest koolist teise esitab õpilase lapsevanem soovitud kooli direktorile sellekohase taotluse. 2 (2) Kui soovitud koolis on vaba õppekoht, otsustab õpilase kooli vastuvõtmise direktor. 3 (3) Sobiva õppekoha puudumise korral koolis edastab direktor taotluse vallavalitsusele, kes tagab rahvastikuregistri andmetel Häädemeeste vallas elukohta omavale õpilasele põhihariduse jätkamise võimaluse statsionaarses õppes.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Statsionaarses õppes põhiharidust omandava õpilase üleminekul ühest koolist teise esitab õpilase lapsevanem soovitud kooli direktorile sellekohase taotluse. 2 (2) Kui soovitud koolis on vaba õppekoht, otsustab õpilase kooli vastuvõtmise direktor. 3 (3) Sobiva õppekoha puudumise korral koolis edastab direktor taotluse vallavalitsusele, kes tagab rahvastikuregistri andmetel Häädemeeste vallas elukohta omavale õpilasele põhihariduse jätkamise võimaluse statsionaarses õppes.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0214"
