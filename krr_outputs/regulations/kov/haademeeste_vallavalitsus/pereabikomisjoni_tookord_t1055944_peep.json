      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Pereabikomisjoni eesmärk ja ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Pereabikomisjoni töökord",
      "estleg:summary": {
        "@value": "1 (1) Pereabikomisjon (edaspidi komisjon) on Häädemeeste Vallavalitsuse (edaspidi vallavalitsus) moodustatav komisjon, mille tegevuse eesmärgiks on tagada sotsiaalkaitse abivajavatele isikutele, toetada ja suurendada inimese iseseisvat toimetulekut ja sotsiaalset kaasatust, luua võrdseid võimalusi, saavutada tööhõive kõrge tase, ennetada töötust ning toetada töö- ja pereelu ühitamist.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Pereabikomisjon (edaspidi komisjon) on Häädemeeste Vallavalitsuse (edaspidi vallavalitsus) moodustatav komisjon, mille tegevuse eesmärgiks on tagada sotsiaalkaitse abivajavatele isikutele, toetada ja suurendada inimese iseseisvat toimetulekut ja sotsiaalset kaasatust, luua võrdseid võimalusi, saavutada tööhõive kõrge tase, ennetada töötust ning toetada töö- ja pereelu ühitamist. 2 (2) Komisjoni otsusega seotud kulud kaetakse valla sotsiaalhoolekande eelarves toetusteks ja teenusteks ettenähtud vahenditest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavalitsus"
