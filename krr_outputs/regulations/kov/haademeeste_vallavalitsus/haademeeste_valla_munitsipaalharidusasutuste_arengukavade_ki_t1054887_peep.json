      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1054887_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Arengukava kinnitamine, muutmine ja selle täitmisest aruandmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Häädemeeste valla munitsipaalharidusasutuste arengukavade kinnitamise kord",
      "estleg:summary": {
        "@value": "1 (1) Arengukava ja selle muudatused esitatakse enne kinnitamist arvamuse andmiseks haridusasutuse hoolekogule,õpilasesindusele (selle olemasolul) ja pedagoogide esindusele. 2 (2) Haridusasutuse juht esitab peale hoolekogult, pedagoogiliselt ja/või õppenõukogult ning õpilasesinduselt (selle olemasolul) arvamuse saamist arengukava eelnõu Häädemeeste vallavalitsusele kinnitamiseks hiljemalt kaks kuud enne kehtiva arengukava perioodi lõppu.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Arengukava ja selle muudatused esitatakse enne kinnitamist arvamuse andmiseks haridusasutuse hoolekogule,õpilasesindusele (selle olemasolul) ja pedagoogide esindusele. 2 (2) Haridusasutuse juht esitab peale hoolekogult, pedagoogiliselt ja/või õppenõukogult ning õpilasesinduselt (selle olemasolul) arvamuse saamist arengukava eelnõu Häädemeeste vallavalitsusele kinnitamiseks hiljemalt kaks kuud enne kehtiva arengukava perioodi lõppu. 3 (3) Haridusasutuse arengukava kinnitab ja teeb selles muudatusi direktori ettepaneku alusel Häädemeeste Vallavalitsus oma korraldusega. 4 (4) Ettepanekud haridusasutuse kehtiva arengukava muutmiseks esitatakse samas korras arengukava kinnitamisega. 5 (5) Haridusasutuse direktor korraldab arengukava avalikustamise haridusasutuse veebilehel. 6 (6) Haridusasutuse direktor annab Häädemeeste vallavalitsusele arengukava täitmisest aru majandusaasta eelarve taotluse raames.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0214"
