      },
      "estleg:legalText": "Järjepideva arengu tagamiseks koostab Häädemeeste valla munitsipaalharidusasutus (edaspidi haridusasutus) arengukava vähemalt kolmeks aastaks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
