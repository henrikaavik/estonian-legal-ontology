    {
      "@id": "estleg:Reg_1054887_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Järjepideva arengu tagamiseks koostab Häädemeeste valla munitsipaalharidusasutus (edaspidi haridusasutus) arengukava vähemalt kolmeks aastaks.",
