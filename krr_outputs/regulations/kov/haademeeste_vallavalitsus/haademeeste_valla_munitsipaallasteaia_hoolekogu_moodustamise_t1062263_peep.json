        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lasteaia hoolekogu (edaspidi hoolekogu) on alaliselt tegutsev organ, mis lapsevanemate (edaspidi vanemate), lasteaia õpetajate ja pidaja koostöös suunab, planeerib ja jälgib lasteaia õppe- ja kasvatustegevust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062263_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1062263_Par_1_Lg_2",
