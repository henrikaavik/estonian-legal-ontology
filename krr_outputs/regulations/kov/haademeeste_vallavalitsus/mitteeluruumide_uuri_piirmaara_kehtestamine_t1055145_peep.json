      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Häädemeeste valla omandis olevate mitteeluruumide üüri piirmäär on 5,00 (viis) eurot ühe ruutmeetri kohta ühes kuus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1055145_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
