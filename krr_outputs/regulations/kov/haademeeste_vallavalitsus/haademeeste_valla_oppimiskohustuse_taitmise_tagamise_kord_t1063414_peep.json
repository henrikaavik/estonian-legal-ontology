    {
      "@id": "estleg:Reg_1063414_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Väljalangemisohus oleva õpilase määratlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Häädemeeste  valla õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063414_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Seiret viib läbi kooli poolt määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) õpilase korduvad põhjendamata puudumised õppetööst; 2 2) õpilase õpivõlgnevused; 3 3) õpetajate ja tugispetsialistide hinnanguid õpilase täiendava toe vajaduse kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kool korraldab õpilaste õppest väljalangemise riski ja õppimiskohustuse mittetäitmise seiret jooksvalt kogu õppeaasta vältel. Seiret viib läbi kooli poolt määratud isik, kes jälgib eelkõige järgmisi näitajaid: 1 1) õpilase korduvad põhjendamata puudumised õppetööst; 2 2) õpilase õpivõlgnevused; 3 3) õpetajate ja tugispetsialistide hinnanguid õpilase täiendava toe vajaduse kohta. 2 (2) Juhul kui kooli poolt rakendatud tugimeetmed ei ole taganud õpilase õppimiskohustuse täitmist, algatab kooli poolt määratud isik Eesti Hariduse Infosüsteemis õppest väljalangemise ohuga õpilase juhtumi ning märgib õpilase andmete juurde juhtumi algatamise kuupäeva.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063414_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1063414_Par_2_Lg_2"
        }
      ],
