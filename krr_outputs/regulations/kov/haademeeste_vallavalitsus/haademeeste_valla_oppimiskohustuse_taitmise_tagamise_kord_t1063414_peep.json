      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Häädemeeste  valla õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063414_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määrusega kehtestatakse Rahvastikuregistri andmetel Häädemeeste vallas elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus. 2 (2) Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määrusega kehtestatakse Rahvastikuregistri andmetel Häädemeeste vallas elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus. 2 (2) Määrust rakendatakse kõigile õppimiskohustuslikele lastele, sõltumata sellest, kas nad õpivad elukohajärgses või muus omavalitsuses.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063414_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_1063414_Par_1_Lg_2"
        }
