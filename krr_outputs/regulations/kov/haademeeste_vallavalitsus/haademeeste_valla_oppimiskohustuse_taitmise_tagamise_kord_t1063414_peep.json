    {
      "@id": "estleg:Reg_1063414_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Juhtumi algatamine õppest väljalangemisohus oleva õpilase kohta",
        "@language": "et"
      },
      "estleg:sourceAct": "Häädemeeste  valla õppimiskohustuse täitmise tagamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063414_Map"
      },
      "estleg:summary": {
        "@value": "Häädemeeste vallas vastutab õppimiskohustuslike laste õppes osalemise igakuise seire eest Häädemeeste Vallavalitsuse poolt volitatud ametnik, kes: 1 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) algatab Eesti Hariduse Infosüsteemis juhtumimenetluse ja teavitab kooli ning lapsevanemaid ( seaduslikke esindajaid) juhtumimenetluse alustamisest; 3 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse…",
        "@language": "et"
      },
      "estleg:legalText": "Häädemeeste vallas vastutab õppimiskohustuslike laste õppes osalemise igakuise seire eest Häädemeeste Vallavalitsuse poolt volitatud ametnik, kes: 1 1) saab Eesti Hariduse Infosüsteemi kaudu teate väljalangemisohus oleva õpilase kohta; 2 2) algatab Eesti Hariduse Infosüsteemis juhtumimenetluse ja teavitab kooli ning lapsevanemaid ( seaduslikke esindajaid) juhtumimenetluse alustamisest; 3 3) selgitab välja õppimiskohustuse täitmata jätmise põhjused ning korraldab edasise koostöö õppimiskohustuse täitmist toetavate meetmete rakendamise osas kaasates juhtumipõhiselt valdkonnaüleseid spetsialiste ja lapsevanemaid (seaduslikke esindajaid); 4 4) Kui õppimiskohustuslik õpilane õpib väljaspool Häädemeeste valda, teeb koostööd õpilase kooli ja/või vastava kohaliku omavalitsusüksusega.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063414_Par_3_Lg_1"
        }
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
