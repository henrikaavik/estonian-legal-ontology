      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Taotlusi 2.- 9. klassi õppima asumiseks võetakse vastu aastaringselt.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1056079_Par_4"
