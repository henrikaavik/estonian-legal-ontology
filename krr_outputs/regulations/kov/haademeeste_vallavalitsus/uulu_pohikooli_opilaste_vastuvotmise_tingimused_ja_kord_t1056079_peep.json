      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Õpilaste vastuvõtmine 2.- 9. klassi",
        "@language": "et"
      },
      "estleg:sourceAct": "Uulu Põhikooli õpilaste vastuvõtmise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Soovi lapse õppima asumiseks kooli avaldab vanem. 2 (2) Taotlusi 2.- 9. klassi õppima asumiseks võetakse vastu aastaringselt. 3 (3) Taotlus õppima asumiseks rahuldatakse üldjuhul vabade õppekohtade ning õpilasele sobiva õppevormi ja õppekava olemasolul. 4 (4) Õpilase 2.- 9. klassi õppima asumiseks esitab vanem oma isikut tõendava dokumendi või selle ametlikult kinnitatud ärakirja või väljavõtte ja kirjaliku taotluse, millele lisab: 1 1) lapse tervisekaardi või selle ametlikult kinnitatud…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Soovi lapse õppima asumiseks kooli avaldab vanem. 2 (2) Taotlusi 2.- 9. klassi õppima asumiseks võetakse vastu aastaringselt. 3 (3) Taotlus õppima asumiseks rahuldatakse üldjuhul vabade õppekohtade ning õpilasele sobiva õppevormi ja õppekava olemasolul. 4 (4) Õpilase 2.- 9. klassi õppima asumiseks esitab vanem oma isikut tõendava dokumendi või selle ametlikult kinnitatud ärakirja või väljavõtte ja kirjaliku taotluse, millele lisab: 1 1) lapse tervisekaardi või selle ametlikult kinnitatud väljavõtte; 2 2) lapse sünnitõendi või -tunnistuse või isikut tõendava dokumendi; 3 3) ametlikult kinnitatud väljavõtte õpilasraamatust; 4 4) ametlikult kinnitatud klassitunnistuse või õpinguraamatu jooksva õppeaasta kohta, kui õpilane on koolist välja arvatud peale õppeperioodi lõppu; 5 5) ametlikult kinnitatud klassitunnistuse või õpinguraamatu ning hinnetelehe jooksva õppeperioodi kohta, kui õpilane on koolist välja arvatud õppeperioodi kestel; 5 (5) välisriigi õppeasutusest tulnud õpilase puhul tuleb taotlusele lisada välisriigi õppeasutuse vastavat haridustaset tõendav dokument või selle ametlikult kinnitatud ärakiri.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0214"
      },
