    {
      "@id": "estleg:Reg_1056079_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õpilaste vastuvõtmine 1. klassi",
        "@language": "et"
      },
      "estleg:sourceAct": "Uulu Põhikooli õpilaste vastuvõtmise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Lapse 1. klassi õppima asumiseks esitab lapsevanem, eestkostja või hooldaja (edaspidi vanem) koolile perioodil 1. märts kuni 31. märts taotluse (Lisa 1), millele lisab: 1 1) oma isikut tõendava dokumendi või selle ametlikult kinnitatud ärakirja; 2 2) lapse sünnitõendi või -tunnistuse või isikut tõendava dokumendi; 3 3) lapse tervisekaardi või selle ametlikult kinnitatud väljavõtte selle olemasolul; 4 4) koolivalmiduskaardi (võib esitada hiljem, kuid esimesel võimalusel).",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Lapse 1. klassi õppima asumiseks esitab lapsevanem, eestkostja või hooldaja (edaspidi vanem) koolile perioodil 1. märts kuni 31. märts taotluse (Lisa 1), millele lisab: 1 1) oma isikut tõendava dokumendi või selle ametlikult kinnitatud ärakirja; 2 2) lapse sünnitõendi või -tunnistuse või isikut tõendava dokumendi; 3 3) lapse tervisekaardi või selle ametlikult kinnitatud väljavõtte selle olemasolul; 4 4) koolivalmiduskaardi (võib esitada hiljem, kuid esimesel võimalusel). 2 (2) Vanem ei pea taotlusele lisama enda isikut tõendavat dokumenti digitaalallkirjaga kinnitatud taotluse esitamise korral. 3 (3) Kui kooli on soovijaid rohkem, kui koolil on õppekohti, siis arvestatakse vastuvõtmisel põhimõtteid, et tagada ühe pere lastele võimalus õppida ühes koolis, õppimisvõimaluse olemasolu kodulähedasemas Häädemeeste valla haridusasutuses ning avalduste laekumise järjekorda.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haademeeste_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0214"
