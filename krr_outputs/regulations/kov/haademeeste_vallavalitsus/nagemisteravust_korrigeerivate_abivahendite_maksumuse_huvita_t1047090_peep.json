        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hüvitise suurus ja maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Nägemisteravust korrigeerivate abivahendite maksumuse hüvitamise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määruse §-s 2 sätestatud asjaoludel ja teenistuja poolt esitatud arve alusel hüvitatakse prillide soetamise arvel märgitud summast mitte rohkem kui 200 eurot. 2 (2) Teenistujal on hüvitist õigus saada üks kord kahe (2) aasta jooksul ja hüvitise määrab vallavanem oma käskkirjaga. RT IV 2022-04-23 17 423042022017 2022-04-26",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määruse §-s 2 sätestatud asjaoludel ja teenistuja poolt esitatud arve alusel hüvitatakse prillide soetamise arvel märgitud summast mitte rohkem kui 200 eurot. 2 (2) Teenistujal on hüvitist õigus saada üks kord kahe (2) aasta jooksul ja hüvitise määrab vallavanem oma käskkirjaga. RT IV 2022-04-23 17 423042022017 2022-04-26",
