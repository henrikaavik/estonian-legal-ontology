      "estleg:sourceAct": "Õppimiskohustuse täitmise tagamise kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Tori valla haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Tori valla haldusterritooriumil elavate õppimiskohustuslike kuni 18-aastaste laste õppimiskohustuse täitmise seire, toetavate meetmete rakendamine ja koostöökorraldus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tori_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0809"
      },
