      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Õppimiskohustuse täitmata jätmise põhjuste välja selgitamise, täitmiseks vajalike meetmete rakendamise ja juhtumispõhiselt valdkondadeüleste spetsialistide kaasamist korraldab valla lastekaitseteenistus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062656_Par_2"
