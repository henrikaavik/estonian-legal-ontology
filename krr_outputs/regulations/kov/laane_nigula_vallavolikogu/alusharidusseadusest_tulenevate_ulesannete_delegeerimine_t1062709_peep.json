    {
      "@id": "estleg:Reg_1062709_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Alusharidusseaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Alusharidusseadusest tulenevate ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) Delegeerida Lääne-Nigula Vallavalitsusele alusharidusseaduses sätestatud lasteaia ja/või lastehoiu pidaja /kohaliku omavalitsuse üksuse ülesannete täitmine, välja arvatud § 16 lõikes 1, lõikes 2, lõikes 4, § 17, § 20 lõikes 2 ja § 41 lõikes 2 sätestatud ülesanded, mis jäävad volikogu pädevusse. 2 (2) Lääne-Nigula Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel struktuuriüksus või ametnikud, kes täidavad käesoleva paragrahvi lõikes 1 nimetatud ülesandeid.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Delegeerida Lääne-Nigula Vallavalitsusele alusharidusseaduses sätestatud lasteaia ja/või lastehoiu pidaja /kohaliku omavalitsuse üksuse ülesannete täitmine, välja arvatud § 16 lõikes 1, lõikes 2, lõikes 4, § 17, § 20 lõikes 2 ja § 41 lõikes 2 sätestatud ülesanded, mis jäävad volikogu pädevusse. 2 (2) Lääne-Nigula Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lõike 2 alusel struktuuriüksus või ametnikud, kes täidavad käesoleva paragrahvi lõikes 1 nimetatud ülesandeid. 3 (3) Alusharidusseaduse § 46 lõikes 4 sätestatud ülesannete lahendamine korraldatakse selliselt, et volikogu pädevusse jääb munitsipaallastehoiu ja-lasteaia osalustasu kehtestamine ja vallavalitsuse pädevusse delegeeritakse toidukulu päevamaksumuse kehtestamine.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavolikogu"
      },
