      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärade kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade, maamaksu aastase suurenemise maksimaalse piirmäära ja kodualuse maa maksusoodustuse kehtestamine 2026. aastaks",
      "estleg:summary": {
        "@value": "Kehtestada Lääne-Nigula valla haldusterritooriumil maamaksumäärad järgmiselt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 1,0% maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale 0,4% maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata maale 1,0% maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Lääne-Nigula valla haldusterritooriumil maamaksumäärad järgmiselt: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 1,0% maa maksustamishinnast aastas; 2 2) punktis 1 nimetamata maatulundusmaale 0,4% maa maksustamishinnast aastas; 3 3) punktides 1 ja 2 nimetamata maale 1,0% maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
