      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kestaseme- ja tippspetsialisti gruppi kuuluval ametnikul peab olema üldjuhul vähemalt 2 aastat töökogemust ametikoha töövaldkonnas. 1) Erandina võib avaliku konkursi tulemuste põhjal võtta teenistusse tippspetsialisti gruppi kuuluva ametniku, kes vastab § 2 lõikes 3 toodud nõuetele, kuid kellel puudub erialane töökogemus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059130_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:itemNumber": "1",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:normativeType": {
