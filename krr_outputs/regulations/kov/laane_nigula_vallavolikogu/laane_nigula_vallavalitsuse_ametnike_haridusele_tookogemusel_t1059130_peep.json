        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Nõuded töökogemusele",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula Vallavalitsuse ametnike haridusele, töökogemusele, teadmistele ja oskustele esitatavad nõuded",
      "estleg:summary": {
        "@value": "1(1)Ametnikul on soovitav omada töökogemust avalikus teenistuses riigi või kohaliku omavalitsuse asutuses või ametikoha töövaldkonnas. 2(2)Kestaseme- ja tippspetsialisti gruppi kuuluval ametnikul peab olema üldjuhul vähemalt 2 aastat töökogemust ametikoha töövaldkonnas.11) Erandina võib avaliku konkursi tulemuste põhjal võtta teenistusse tippspetsialisti gruppi kuuluva ametniku, kes vastab § 2 lõikes 3 toodud nõuetele, kuid kellel puudub erialane töökogemus.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Ametnikul on soovitav omada töökogemust avalikus teenistuses riigi või kohaliku omavalitsuse asutuses või ametikoha töövaldkonnas. 2(2)Kestaseme- ja tippspetsialisti gruppi kuuluval ametnikul peab olema üldjuhul vähemalt 2 aastat töökogemust ametikoha töövaldkonnas.11) Erandina võib avaliku konkursi tulemuste põhjal võtta teenistusse tippspetsialisti gruppi kuuluva ametniku, kes vastab § 2 lõikes 3 toodud nõuetele, kuid kellel puudub erialane töökogemus. 3(3)Juhtide gruppi kuuluval ametnikul peab olema vähemalt 2 aastat juhtimiskogemust või 3 aastat töökogemus ametiasutuse või ametikoha töövaldkonnas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavolikogu"
      },
