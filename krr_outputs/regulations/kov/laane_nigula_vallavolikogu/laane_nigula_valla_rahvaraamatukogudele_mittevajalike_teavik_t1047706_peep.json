      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla rahvaraamatukogudele mittevajalike teavikute võõrandamise kord",
      "estleg:summary": {
        "@value": "Käesolev kord reguleerib Lääne-Nigula vallas asuvate rahvaraamatukogude ja nende haruraamatukogude (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamist ja müüki.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev kord reguleerib Lääne-Nigula vallas asuvate rahvaraamatukogude ja nende haruraamatukogude (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamist ja müüki.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0441"
      },
