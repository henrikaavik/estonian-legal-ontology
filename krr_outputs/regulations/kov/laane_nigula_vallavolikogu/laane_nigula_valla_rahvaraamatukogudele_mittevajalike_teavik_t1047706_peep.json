    {
      "@id": "estleg:Reg_1047706_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Teavikute võõrandamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla rahvaraamatukogudele mittevajalike teavikute võõrandamise kord",
      "estleg:summary": {
        "@value": "1 (1) Raamatukogule mittevajalikud teavikud võõrandatakse tasuta või müüakse tasu eest. Teade teavikute müügi kohta ava ldatakse raamatukogu kodulehel. 2 (2) Teavikute müügihinna määrab raamatukogu direktor käskkirjaga. 3 (3) Ruumi olemasolul on raamatukogus eraldi riiul antud teavikute pidevaks pakkumiseks raamatukogu külastajatele. Lisaks võib t eavikuid tasuta võõrandada ja müüa selleks korraldatud üritustel. 4 (4) Võõrandamata teavikud utiliseeritakse või antakse hoiuraamatukogule.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Raamatukogule mittevajalikud teavikud võõrandatakse tasuta või müüakse tasu eest. Teade teavikute müügi kohta ava ldatakse raamatukogu kodulehel. 2 (2) Teavikute müügihinna määrab raamatukogu direktor käskkirjaga. 3 (3) Ruumi olemasolul on raamatukogus eraldi riiul antud teavikute pidevaks pakkumiseks raamatukogu külastajatele. Lisaks võib t eavikuid tasuta võõrandada ja müüa selleks korraldatud üritustel. 4 (4) Võõrandamata teavikud utiliseeritakse või antakse hoiuraamatukogule. 5 (5) Teavikute müügi kassadokumendid esitatakse rahandusosakonnale. RT IV 2025-04-10 1 410042025001 2025-05-01 6 (6) Teavikute müügist saadud vahendid laekuvad vallaeelarve tuludesse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_laane_nigula_vallavolikogu"
      },
