    {
      "@id": "estleg:Reg_1047706_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Raamatukogu võib tasuta võõrandada või müüa temale mittevajalikke teavikuid, mille kohta on koostatud kustutusakt.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047706_Par_2"
