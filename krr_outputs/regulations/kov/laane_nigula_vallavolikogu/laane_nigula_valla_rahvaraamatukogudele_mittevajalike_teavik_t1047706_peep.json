    },
    {
      "@id": "estleg:Reg_1047706_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev kord reguleerib Lääne-Nigula vallas asuvate rahvaraamatukogude ja nende haruraamatukogude (edaspidi raamatukogu) mittevajalike teavikute tasuta võõrandamist ja müüki.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047706_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1047706_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Teavikute võõrandamise ettevalmistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lääne-Nigula valla rahvaraamatukogudele mittevajalike teavikute võõrandamise kord",
      "estleg:summary": {
        "@value": "1 (1) Raamatukogu võib tasuta võõrandada või müüa temale mittevajalikke teavikuid, mille kohta on koostatud kustutusakt. 2 (2) Tasuta võõrandamisele või müümisele määratud teavikusse lüüakse kustutustempli jäljend ja kriipsutatakse läbi või eemaldatakse vöötkood.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Raamatukogu võib tasuta võõrandada või müüa temale mittevajalikke teavikuid, mille kohta on koostatud kustutusakt. 2 (2) Tasuta võõrandamisele või müümisele määratud teavikusse lüüakse kustutustempli jäljend ja kriipsutatakse läbi või eemaldatakse vöötkood.",
      "estleg:enactedBy": {
