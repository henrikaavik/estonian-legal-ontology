      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Võõrandamata teavikud utiliseeritakse või antakse hoiuraamatukogule.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047706_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
    {
