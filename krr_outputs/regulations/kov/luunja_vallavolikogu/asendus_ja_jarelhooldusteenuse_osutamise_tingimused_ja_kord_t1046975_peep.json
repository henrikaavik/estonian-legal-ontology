      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Teenuse rahastamine ja lepingu sõlmimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Asendus- ja järelhooldusteenuse osutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Teenuse rahastamine toimub teenuse osutamiseks sõlmitava lepingu alusel ja kohaselt. 2 (2) Asendushooldusteenuse osutajal lasub kohustus tagada SHS paragrahv 4511 lõikes 3 sätestatud nõude täitmine. 3 (3) Asendushooldusteenuse osutajaga sõlmitakse leping vallavalitsuse korralduse alusel. 4 (4) Järelhooldusteenuse osutamiseks sõlmitakse leping vallavalitsuse korralduse alusel. Lepingu sõlmimisel peab teenuse saaja olema üheks lepingupooleks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenuse rahastamine toimub teenuse osutamiseks sõlmitava lepingu alusel ja kohaselt. 2 (2) Asendushooldusteenuse osutajal lasub kohustus tagada SHS paragrahv 4511 lõikes 3 sätestatud nõude täitmine. 3 (3) Asendushooldusteenuse osutajaga sõlmitakse leping vallavalitsuse korralduse alusel. 4 (4) Järelhooldusteenuse osutamiseks sõlmitakse leping vallavalitsuse korralduse alusel. Lepingu sõlmimisel peab teenuse saaja olema üheks lepingupooleks.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luunja_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0432"
