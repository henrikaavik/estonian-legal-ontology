      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Veeseaduses sätestatud ülesannete delegeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Veeseadusest tulenevate ülesannete delegeerimine",
      "estleg:summary": {
        "@value": "1 (1) Veeseaduses sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded, välja arvatud § 32 lõike 5 punktis 5 sätestatu, delegeeritakse Luunja Vallavalitsusele. 2 (2) Luunja Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lg 2 alusel struktuuriüksus, ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Veeseaduses sätestatud kohaliku omavalitsuse ja kohaliku omavalitsuse üksuse ülesanded, välja arvatud § 32 lõike 5 punktis 5 sätestatu, delegeeritakse Luunja Vallavalitsusele. 2 (2) Luunja Vallavalitsusel on õigus määrata haldusmenetluse seaduse § 8 lg 2 alusel struktuuriüksus, ametnik või ametnikud, kelle ülesandeks on käesoleva paragrahvi lõikes 1 nimetatud ülesannete täitmine.",
