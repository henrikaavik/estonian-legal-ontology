        {
          "@id": "estleg:Reg_1047413_Par_3_Lg_6"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_luunja_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1047413_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohanime määramise võib algatada Luunja Vallavolikogu (edaspidi volikogu), valitsus, valitsuse hallatav asutus ning füüsiline ja juriidiline isik kirjaliku taotluse alusel. Kohanime määramise või muutmise taotlus peab sisaldama kohanime muutmise ja uue kohanime valiku põhjendust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_luunja_vallavolikogu"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1047413_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kohanime määramise ettevalmistust korraldab valitsuse vastava valdkonna eest vastutav ametnik.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1047413_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kohanime määramise ettevalmistamisel: 1) kontrollitakse taotluse vastavust kohanimeseaduses sätestatud nõuetele; 2) selgitatakse välja eraomandis oleva katastriüksuse puhul omaniku arvamus; 3) valmistatakse ette korralduse eelnõu kohanime määramiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1047413_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Eraomandis olevale maaüksusele või sellel paiknevale nimeobjektile kohanime määramise kavatsusest teavitab kohanimemääraja asjaomast maaomanikku kirjalikult, küsides tema arvamust. Maaomanik peab kirjaliku arvamuse esitama teate saamisest 15 päeva jooksul. Arvamuse tähtajaks esitamata jätmisel loetakse maaomaniku nõusolek saaduks. Sätet ei kohaldata, kui kohanime määramist taotleb maaomanik ise või tema nõusolek on tuvastatav maaüksuse moodustamise dokumentatsioonist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:Reg_1047413_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kohanimi muudetakse või tunnistatakse kehtetuks kohanimeseaduses sätestatud juhtudel ja korras.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_3"
      },
      "rdfs:label": "§ 3 lg 5"
    },
    {
      "@id": "estleg:Reg_1047413_Par_3_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Kohanime määramisest keeldutakse, kui taotletav kohanimi on vastuolus kohanimeseaduses kohanimele esitatavate nõuetega või kui puudub selgesti eristatav objekt, millele nime taotletakse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_3"
      },
      "rdfs:label": "§ 3 lg 6"
    },
    {
      "@id": "estleg:Reg_1047413_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Kohanime määramise avalikustamine ja avaldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1(1)Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist valla veebilehel ja vallalehes „Kodu Uudised“. 2(2)Pärast kohanime määramist edastatakse kohanime määramise õigusakt 10 päeva jooksul kohanimenõukogule ja riikliku kohanimeregistri volitatud töötlejale.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist valla veebilehel ja vallalehes „Kodu Uudised“. 2(2)Pärast kohanime määramist edastatakse kohanime määramise õigusakt 10 päeva jooksul kohanimenõukogule ja riikliku kohanimeregistri volitatud töötlejale.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luunja_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
