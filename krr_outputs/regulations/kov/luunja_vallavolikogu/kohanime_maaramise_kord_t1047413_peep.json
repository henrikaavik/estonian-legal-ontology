      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kohanime määramise eelnõu avalikustatakse vähemalt 15 päeva enne kohanime määramise otsuse tegemist valla veebilehel ja vallalehes „Kodu Uudised“.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047413_Par_4"
      },
      "rdfs:label": "§ 4 lg 1"
    },
    {
      "@id": "estleg:Reg_1047413_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
