      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Luunja valla 2026. aasta eelarve võetakse vastu vastavalt lisale 1.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062990_Par_1"
      },
