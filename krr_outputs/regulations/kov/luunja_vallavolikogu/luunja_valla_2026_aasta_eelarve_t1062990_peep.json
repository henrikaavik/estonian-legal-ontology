    },
    {
      "@id": "estleg:Reg_1062990_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohustuste võtmise lubamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Luunja valla 2026. aasta eelarve",
      "estleg:summary": {
        "@value": "1 (1) Vallavalitsusel lubatakse võtta laenu investeeringute katteks kokku kuni 1 650 000 euro ulatuses ja tähtajaga kuni 10 aastat. 2 (2) Vallavalitsusel lubatakse võtta lühiajalist arvelduskrediiti 2026. aasta jooksvate kulude katteks kuni 300 000 eurot tähtajaga kuni 31.12.2026. Arvelduskrediiti võetakse lähtudes vajadusest tagada piisav likviidsete vahendite olemasolu rahavoogude juhtimisel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vallavalitsusel lubatakse võtta laenu investeeringute katteks kokku kuni 1 650 000 euro ulatuses ja tähtajaga kuni 10 aastat. 2 (2) Vallavalitsusel lubatakse võtta lühiajalist arvelduskrediiti 2026. aasta jooksvate kulude katteks kuni 300 000 eurot tähtajaga kuni 31.12.2026. Arvelduskrediiti võetakse lähtudes vajadusest tagada piisav likviidsete vahendite olemasolu rahavoogude juhtimisel. 3 (3) Vallavalitsusel lubatakse võtta laenu välisabi vahenditega rahastatavate projektide sildfinantseerimiseks kuni 500 000 euro ulatuses. 4 (4) Vallavalitsusel lubatakse anda sõltuvatele üksustele rahavoogude juhtimise eesmärgil laenu kuni 300 000 eurot tähtajaga kuni 31.12.2026.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_luunja_vallavolikogu"
      },
