    {
      "@id": "estleg:Reg_1051940_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Komisjoni koosseis",
        "@language": "et"
      },
      "estleg:sourceAct": "Läänemaa kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1 (1) Komisjon on vähemalt 12-liikmeline. 2 (2) Komisjoni esimees on Haapsalu linnapea. 3 (3) Komisjoni aseesimees on Lääne-Nigula vallavanem. 4 (4) Komisjoni tööd juhib komisjoni esimees, tema äraolekul komisjoni aseesimees. 5 (5) Komisjoni esimehe ja komisjoni aseesimehe äraolekul juhib komisjoni tööd komisjoni esimehe poolt määratud isik. 6 (6) Juhul, kui komisjoni liikmel ei ole võimalik komisjoni tööst osa võtta, määratakse talle asendusliige.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Komisjon on vähemalt 12-liikmeline. 2 (2) Komisjoni esimees on Haapsalu linnapea. 3 (3) Komisjoni aseesimees on Lääne-Nigula vallavanem. 4 (4) Komisjoni tööd juhib komisjoni esimees, tema äraolekul komisjoni aseesimees. 5 (5) Komisjoni esimehe ja komisjoni aseesimehe äraolekul juhib komisjoni tööd komisjoni esimehe poolt määratud isik. 6 (6) Juhul, kui komisjoni liikmel ei ole võimalik komisjoni tööst osa võtta, määratakse talle asendusliige. 7 (7) Komisjoni koosseisu kinnitavad omavalitsused korraldusega.",
