      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Tunnistada kehtetuks Haapsalu Linnavalitsuse 16. november 2018. a määrus nr 13 „Läänemaa kriisikomisjoni põhimäärus“.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051940_Par_7"
      },
      "rdfs:label": "§ 7 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_haapsalu_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1051940_Par_7_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrust rakendatakse alates Haapsalu linna, Lääne-Nigula valla ning Vormsi valla määruste jõustumisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051940_Par_7"
      },
      "rdfs:label": "§ 7 lg 2"
    },
    {
      "@id": "estleg:Reg_1051940_Par_7_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Määrus jõustub kolmandal päeval peale Riigi Teatajas avaldamist.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051940_Par_7"
      },
      "rdfs:label": "§ 7 lg 3"
    },
