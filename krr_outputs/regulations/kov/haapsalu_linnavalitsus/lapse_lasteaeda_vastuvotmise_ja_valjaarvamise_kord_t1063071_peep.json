    {
      "@id": "estleg:Reg_1063071_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Lasteaiakoha taotlemine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lapse lasteaeda vastuvõtmise ja väljaarvamise kord",
      "estleg:summary": {
        "@value": "1 (1) Vanem esitab lasteaiakoha taotluse e-keskkonnas ARNO või Lasteaiakoha taotluses (lisa 1) märkides koha kasutamise soovitud algusaja ja eelistatud lasteaia tegevuskoha täpsusega. 2 (2) Koha eraldamisel arvestatakse lapse elukoha lähedust lasteaiale ja ühte lasteaeda võetakse üldjuhul vastu ühe pere lapsed, kelle elukoha aadress ühtib. 3 (3) Kui eelistatud lasteaia tegevuskohas vaba kohta ei ole, pakutakse kohta teises Haapsalu linna lasteaias või luuakse võimalus kasutada osaajalist või…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vanem esitab lasteaiakoha taotluse e-keskkonnas ARNO või Lasteaiakoha taotluses (lisa 1) märkides koha kasutamise soovitud algusaja ja eelistatud lasteaia tegevuskoha täpsusega. 2 (2) Koha eraldamisel arvestatakse lapse elukoha lähedust lasteaiale ja ühte lasteaeda võetakse üldjuhul vastu ühe pere lapsed, kelle elukoha aadress ühtib. 3 (3) Kui eelistatud lasteaia tegevuskohas vaba kohta ei ole, pakutakse kohta teises Haapsalu linna lasteaias või luuakse võimalus kasutada osaajalist või asenduskohta. 4 (4) Teatis kohapakkumusest e-keskkonnas ARNO saadetakse vanemale e-posti aadressile. Vanem võtab koha vastu või loobub kohast seitsme kalendripäeva jooksul alates kohapakkumuse tegemisest. 5 (5) Lasteaia direktor (edaspidi direktor) annab lapse lasteaeda vastuvõtu kohta välja käskkirja ja teeb e-keskkonnas ARNO vastava kande. 6 (6) Kohapakkumuse vastuvõtmata jätmisel või loobumisel jääb taotlus menetlusse järgmise kohapakkumuse tegemiseks ja kuni lapse lasteaeda vastuvõtuni või taotluse tühistamiseni.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavalitsus"
      },
