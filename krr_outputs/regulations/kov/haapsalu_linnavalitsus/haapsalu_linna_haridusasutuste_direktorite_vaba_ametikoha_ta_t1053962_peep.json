      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 8.",
      "rdfs:label": {
        "@value": "§ 8. Konkursi luhtumine ja lõpetamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haapsalu linna haridusasutuste direktorite vaba ametikoha täitmiseks korraldatava avaliku konkursi läbiviimise kord",
      "estleg:summary": {
        "@value": "1(1)Konkursi võib kuulutada luhtunuks, kui:11) konkursil osalemiseks ei esitatud ühtegi avaldust;22) kõik kandidaadid osutusid ametikohale esitatud tingimustele mittevastavaks;33) ühegi kandidaadiga ei sõlmita töölepingut. 2(2)Kui konkurss loetakse luhtunuks, otsustab komisjon konkursi edasise käigu. 3(3)Konkurss loetakse lõppenuks, kui direktori ametikohale valitud kandidaadiga on sõlmitud tööleping.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Konkursi võib kuulutada luhtunuks, kui:11) konkursil osalemiseks ei esitatud ühtegi avaldust;22) kõik kandidaadid osutusid ametikohale esitatud tingimustele mittevastavaks;33) ühegi kandidaadiga ei sõlmita töölepingut. 2(2)Kui konkurss loetakse luhtunuks, otsustab komisjon konkursi edasise käigu. 3(3)Konkurss loetakse lõppenuks, kui direktori ametikohale valitud kandidaadiga on sõlmitud tööleping.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavalitsus"
      },
