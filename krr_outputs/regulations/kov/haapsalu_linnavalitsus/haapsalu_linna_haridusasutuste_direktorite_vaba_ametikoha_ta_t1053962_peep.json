      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui konkurss loetakse luhtunuks, otsustab komisjon konkursi edasise käigu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1053962_Par_8"
      },
      "rdfs:label": "§ 8 lg 2"
