    {
      "@id": "estleg:Reg_1053056_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Teenuse osutaja",
        "@language": "et"
      },
      "estleg:sourceAct": "Võlanõustamisteenuse osutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Teenuse osutamine on üldjuhul korraldatud teenust vahetult osutava koostööpartneri kaudu, mille hangib Haapsalu Sotsiaalmaja. 2 (2) Teenuse vahetu osutaja peab vastama sotsiaalhoolekande seaduse § 45 lõikes 1 sätestatud tingimustele. 3 (3) Juhul kui käesoleva paragrahvi lõikes 1 nimetatud teenuse osutaja mõjuvatel põhjustel ei sobi või teenuse vajadus on tavapärasest suurem, on isikul õigus esitada Haapsalu linnavalitsusele vastavasisuline põhjendatud taotlus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenuse osutamine on üldjuhul korraldatud teenust vahetult osutava koostööpartneri kaudu, mille hangib Haapsalu Sotsiaalmaja. 2 (2) Teenuse vahetu osutaja peab vastama sotsiaalhoolekande seaduse § 45 lõikes 1 sätestatud tingimustele. 3 (3) Juhul kui käesoleva paragrahvi lõikes 1 nimetatud teenuse osutaja mõjuvatel põhjustel ei sobi või teenuse vajadus on tavapärasest suurem, on isikul õigus esitada Haapsalu linnavalitsusele vastavasisuline põhjendatud taotlus.",
