      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Võlanõustamisteenuse osutamise kord",
      "estleg:summary": {
        "@value": "Käesolev kord reguleerib võlanõustamisteenuse (edaspidi teenus) taotlemise, määramise ja teenuse osutamise tingimused ja korra.",
        "@language": "et"
      },
      "estleg:legalText": "Käesolev kord reguleerib võlanõustamisteenuse (edaspidi teenus) taotlemise, määramise ja teenuse osutamise tingimused ja korra.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haapsalu_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0184"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1053056_Map"
