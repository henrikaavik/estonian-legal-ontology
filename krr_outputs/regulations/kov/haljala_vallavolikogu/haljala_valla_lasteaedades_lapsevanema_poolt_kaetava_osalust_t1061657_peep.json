      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Osalustasu tasutakse vanema poolt 11 kuu eest aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061657_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
    },
