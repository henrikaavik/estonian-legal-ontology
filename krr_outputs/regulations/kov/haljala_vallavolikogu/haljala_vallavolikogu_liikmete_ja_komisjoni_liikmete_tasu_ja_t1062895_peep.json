        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1062895_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Komisjoni liikmele tasu ei maksta, kui: 1) komisjoni liige komisjoni koosolekul ei osalenud, olenemata põhjusest; 2) komisjoni koosolekut antud kuul ei toimunud.",
      "estleg:parentProvision": {
