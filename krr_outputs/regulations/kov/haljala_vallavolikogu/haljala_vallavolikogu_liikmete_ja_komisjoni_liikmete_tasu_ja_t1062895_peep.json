        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Volikogu liikmele tasu ei maksta, kui: 1) volikogu liige istungil ei osalenud, olenemata põhjusest; 2) volikogu istungit antud kuul ei toimunud.",
