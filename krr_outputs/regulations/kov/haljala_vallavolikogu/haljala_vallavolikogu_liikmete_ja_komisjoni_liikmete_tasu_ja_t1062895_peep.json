      "@id": "estleg:Reg_1062895_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui volikogu komisjoni liige kuulub mitmesse komisjoni, makstakse talle tasu iga komisjoni töös osalemise eest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062895_Par_4"
      },
      "rdfs:label": "§ 4 lg 2",
      "estleg:targetGroup": [
        {
