    {
      "@id": "estleg:Reg_1043152_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesolev määrus reguleerib riigi eelarvest rahastatava raske ja sügava puudega laste sotsiaalteenuste osutamise toetuse rahaliste vahendite kasutamist Haljala vallas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043152_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1043152_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Eelarveaasta lõpuks kasutamata jäänud rahaliste vahendite ülejääk kantakse järgmise eelarveaasta valla eelarvesse raske või sügava puudega laste ja nende peredega seotud sotsiaalteenuste osutamiseks ning arendamiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043152_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1043152_Par_2",
