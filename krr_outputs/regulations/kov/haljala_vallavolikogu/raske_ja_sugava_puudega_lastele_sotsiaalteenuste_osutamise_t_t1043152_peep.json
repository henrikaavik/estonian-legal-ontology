      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Rahaliste vahendite kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Raske ja sügava puudega lastele sotsiaalteenuste osutamise toetuse rahaliste vahendite kasutamise kord",
      "estleg:summary": {
        "@value": "Riigieelarvest raske ja sügava puudega laste sotsiaalteenuste osutamise toetuse rahalisi vahendeid kasutatakse raske või sügava puudega laste ja nende peredega seotud sotsiaalteenuste osutamiseks ja arendamiseks, sealhulgas:11) lapsehoiuteenuseks;22) tugiisikuteenuseks;33) transporditeenuseks haridus-, ravi- või rehabilitatsiooniasutusse;44) nõustamisteenuseks (võlanõustamine, psühholoogiline nõustamine jne);55) erinevateks teraapiateks;66) rehabilitatsiooniplaani tegevuskavas ette nähtud…",
        "@language": "et"
      },
      "estleg:legalText": "Riigieelarvest raske ja sügava puudega laste sotsiaalteenuste osutamise toetuse rahalisi vahendeid kasutatakse raske või sügava puudega laste ja nende peredega seotud sotsiaalteenuste osutamiseks ja arendamiseks, sealhulgas:11) lapsehoiuteenuseks;22) tugiisikuteenuseks;33) transporditeenuseks haridus-, ravi- või rehabilitatsiooniasutusse;44) nõustamisteenuseks (võlanõustamine, psühholoogiline nõustamine jne);55) erinevateks teraapiateks;66) rehabilitatsiooniplaani tegevuskavas ette nähtud teenuste, sh abivahendite võimaldamiseks;77) sotsiaalteenuste arendamiseks;88) rehabilitatsioonilaagrites osalemise tasumiseks;99) sotsiaalteenuste osutajatele (sh lapsehoidjatele, tugiisikutele) koolituste võimaldamiseks;1010) eluruumide kohandamiseks;1111) turva- ja tugikoduteenuse eest tasumiseks;1212) muudeks teenusteks, mis toetavad ja parandavad raske ja sügava puudega lapse arengut ja pere toimetulekut.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haljala_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0191"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1043152_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1043152_Par_2_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043152_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarvest raske ja sügava puudega laste sotsiaalteenuste osutamise toetuse rahalisi vahendeid kasutatakse raske või sügava puudega laste ja nende peredega seotud sotsiaalteenuste osutamiseks ja arendamiseks, sealhulgas: 1) lapsehoiuteenuseks; 2) tugiisikuteenuseks; 3) transporditeenuseks haridus-, ravi- või rehabilitatsiooniasutusse; 4) nõustamisteenuseks (võlanõustamine, psühholoogiline nõustamine jne); 5) erinevateks teraapiateks; 6) rehabilitatsiooniplaani tegevuskavas ette nähtud teenuste, sh abivahendite võimaldamiseks; 7) sotsiaalteenuste arendamiseks; 8) rehabilitatsioonilaagrites osalemise tasumiseks; 9) sotsiaalteenuste osutajatele (sh lapsehoidjatele, tugiisikutele) koolituste võimaldamiseks; 10) eluruumide kohandamiseks; 11) turva- ja tugikoduteenuse eest tasumiseks; 12) muudeks teenusteks, mis toetavad ja parandavad raske ja sügava puudega lapse arengut ja pere toimetulekut.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043152_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
