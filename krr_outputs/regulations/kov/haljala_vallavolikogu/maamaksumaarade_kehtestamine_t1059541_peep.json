    {
      "@id": "estleg:Reg_1059541_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Maamaksumäärade kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Haljala vallas maamaksumäärad alljärgnevalt: 1 1) elamumaal ja maatulundusmaa õuemaa kõlviku puhul 1,0 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 2,0 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Haljala vallas maamaksumäärad alljärgnevalt: 1 1) elamumaal ja maatulundusmaa õuemaa kõlviku puhul 1,0 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 2,0 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_haljala_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0191"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1059541_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1059541_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1059541_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Haljala vallas maamaksumäärad alljärgnevalt: 1) elamumaal ja maatulundusmaa õuemaa kõlviku puhul 1,0 protsenti maa maksustamishinnast aastas; 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaa puhul 0,5 protsenti maa maksustamishinnast aastas; 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maa puhul 2,0 protsenti maa maksustamishinnast aastas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059541_Par_1"
      },
