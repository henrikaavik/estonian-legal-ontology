      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Liiklusseaduses sätestatud kohaliku omavalitsuse, kohaliku omavalitsuse üksuse ja valla kui tee omaniku ülesanded delegeeritakse Haljala Vallavalitsusele.",
      "estleg:parentProvision": {
