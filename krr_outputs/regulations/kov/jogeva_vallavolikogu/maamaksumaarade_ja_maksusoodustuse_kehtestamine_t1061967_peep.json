      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Maamaksumäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Maamaksumäärade ja maksusoodustuse kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada 1. jaanuarist 2026 maamaksumäär järgmistele maa sihtotstarbegruppidele: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,6 protsenti maa maksustamishinnast aastas.",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada 1. jaanuarist 2026 maamaksumäär järgmistele maa sihtotstarbegruppidele: 1 1) elamumaale ja maatulundusmaa õuemaa kõlvikule 0,5 protsenti maa maksustamishinnast aastas; 2 2) käesoleva paragrahvi punktis 1 nimetamata maatulundusmaale 0,5 protsenti maa maksustamishinnast aastas; 3 3) käesoleva paragrahvi punktides 1 ja 2 nimetamata sihtotstarbega maale 0,6 protsenti maa maksustamishinnast aastas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavolikogu"
      },
