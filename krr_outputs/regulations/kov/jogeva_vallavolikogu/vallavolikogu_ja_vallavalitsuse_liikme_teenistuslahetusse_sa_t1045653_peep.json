      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Reguleerimisala",
      "estleg:sourceAct": "Vallavolikogu ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": "Määruse eesmärk on reguleerida Jõgeva vallavolikogu esimehe, vallavolikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmist ning lähetuskulude hüvitamist. Määruse eesmärk on reguleerida Jõgeva vallavolikogu esimehe, vallavolikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmist ning lähetuskulude hüvitamist.",
      "estleg:legalText": "Määruse eesmärk on reguleerida Jõgeva vallavolikogu esimehe, vallavolikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmist ning lähetuskulude hüvitamist. Määruse eesmärk on reguleerida Jõgeva vallavolikogu esimehe, vallavolikogu liikme, vallavanema ja vallavalitsuse liikme teenistuslähetusse saatmist ning lähetuskulude hüvitamist.",
      "estleg:enactedBy": {
