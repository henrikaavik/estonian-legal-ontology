    {
      "@id": "estleg:Reg_1045653_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1045653",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Teenistuslähetusest teavitamine",
      "estleg:sourceAct": "Vallavolikogu ja vallavalitsuse liikme teenistuslähetusse saatmise kord",
      "estleg:summary": "1(1) Teenistuslähetuse vajaduse tekkimisel peab volikogu ja valitsuse liige sellest teada andma vastavalt volikogu esimehele või vallavanemale vähemalt kolm tööpäeva enne planeeritava lähetuse algust koos informatsiooniga lähetuse eesmärgist ja eeldatavatest kuludest. Lähetusse tohib minna vaid volikogu esimehe või vallavanema loal, mis on antud kirjalikku taasesitamist võimaldavas vormis. Teenistuslähetuse vajaduse tekkimisel peab volikogu ja valitsuse liige sellest teada andma vastavalt voliko",
      "estleg:legalText": "1(1) Teenistuslähetuse vajaduse tekkimisel peab volikogu ja valitsuse liige sellest teada andma vastavalt volikogu esimehele või vallavanemale vähemalt kolm tööpäeva enne planeeritava lähetuse algust koos informatsiooniga lähetuse eesmärgist ja eeldatavatest kuludest. Lähetusse tohib minna vaid volikogu esimehe või vallavanema loal, mis on antud kirjalikku taasesitamist võimaldavas vormis. Teenistuslähetuse vajaduse tekkimisel peab volikogu ja valitsuse liige sellest teada andma vastavalt volikogu esimehele või vallavanemale vähemalt kolm tööpäeva enne planeeritava lähetuse algust koos informatsiooniga lähetuse eesmärgist ja eeldatavatest kuludest. Lähetusse tohib minna vaid volikogu esimehe või vallavanema loal, mis on antud kirjalikku taasesitamist võimaldavas vormis. 2(2) Vähemalt kolmepäevase riigisisese ja välislähetuse vajaduse tekkimisel peab volikogu esimees sellest esimesel võimalusel teada andma volikogu eestseisusele ja vallavanem volikogu esimehele koos informatsiooniga lähetuse eeldatavatest kuludest. Vähemalt kolmepäevase riigisisese ja välislähetuse vajaduse tekkimisel peab volikogu esimees sellest esimesel võimalusel teada andma volikogu eestseisusele ja vallavanem volikogu esimehele koos informatsiooniga lähetuse eeldatavatest kuludest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0247"
