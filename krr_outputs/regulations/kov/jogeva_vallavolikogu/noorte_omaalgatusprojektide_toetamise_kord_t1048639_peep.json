    },
    {
      "@id": "estleg:Reg_1048639_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Vallavalitsus moodustab kuni 7-liikmelise noorte omaalgatusprojektide komisjoni, kes hindab projekte järgmiste kriteeriumite alusel: 1) uudsus; 2) laialdane ja positiivne mõju noortele; 3) planeeritav osalejate arv; 4) taotletud toetuse suuruse sobivus projekti tegevustega.",
      "estleg:parentProvision": {
