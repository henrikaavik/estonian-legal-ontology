    },
    {
      "@id": "estleg:Reg_1048639_Par_6_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Toetuse sihipärast kasutamist kontrollib vastava valdkonna teenistuja, kellel on õigus nõuda toetuse kasutamise aruande juurde kuludokumentide koopiad ja selgitusi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048639_Par_6"
      },
      "rdfs:label": "§ 6 lg 2",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Right"
      }
    },
    {
      "@id": "estleg:Reg_1048639_Par_6_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vallavalitsusel on õigus nõuda toetus tagasi, kui: 1) toetuse saaja ei kasuta või ei kasutanud toetust sihtotstarbeliselt; 2) toetuse saaja esitab taotlemisel või aruandes valeandmeid; 3) toetuse saaja ei esita aruannet toetuse kasutamise kohta; 4) projekti tegevus ei ole osaliselt või tervikuna lepingus toodud mahus toimunud; 5) muudel lepingus sätestatud juhtudel.",
      "estleg:parentProvision": {
