    {
      "@id": "estleg:Reg_1048639_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Toetuse andmise otsustamine ja lepingu sõlmimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Noorte omaalgatusprojektide toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Oma projekti kaitseb komisjoni ees taotleja ja/või projektimeeskond suulise esitlusega. 2 (2) Vallavalitsus moodustab kuni 7-liikmelise noorte omaalgatusprojektide komisjoni, kes hindab projekte järgmiste kriteeriumite alusel: RT IV2023-03-0364030320230062023-03-06 1 1) uudsus; 2 2) laialdane ja positiivne mõju noortele; 3 3) planeeritav osalejate arv; 4 4) taotletud toetuse suuruse sobivus projekti tegevustega.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Oma projekti kaitseb komisjoni ees taotleja ja/või projektimeeskond suulise esitlusega. 2 (2) Vallavalitsus moodustab kuni 7-liikmelise noorte omaalgatusprojektide komisjoni, kes hindab projekte järgmiste kriteeriumite alusel: RT IV2023-03-0364030320230062023-03-06 1 1) uudsus; 2 2) laialdane ja positiivne mõju noortele; 3 3) planeeritav osalejate arv; 4 4) taotletud toetuse suuruse sobivus projekti tegevustega. 3 (3) Komisjon esitab oma ettepanekud vallavalitsusele, kes otsustab toetuse andmise, toetuse suuruse või toetuse andmisest keeldumise. 4 (4) Lepingu toetuse andmiseks sõlmib vastava valdkonna teenistuja. Lepingus sätestatakse: 1 1) lepingupartner; 2 2) projekti periood; 3 3) toetuse suurus; 4 4) mentori nõusolek; 5 5) toetuse ülekandmiseks vajalikud andmed; 6 6) toetuse ülekandmise tähtaeg; 7 7) vajadusel taotleja seadusliku esindaja nõusolek.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
