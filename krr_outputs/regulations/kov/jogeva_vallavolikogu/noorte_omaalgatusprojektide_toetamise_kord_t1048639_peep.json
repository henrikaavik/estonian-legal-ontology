      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Oma projekti kaitseb komisjoni ees taotleja ja/või projektimeeskond suulise esitlusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048639_Par_5"
