    {
      "@id": "estleg:Reg_1048639_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Aruandlus ja järelevalve",
        "@language": "et"
      },
      "estleg:sourceAct": "Noorte omaalgatusprojektide toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Toetuse saaja esitab veebipõhises keskkonnas projekti aruande 30 päeva jooksul alates toetuse eraldamise aluseks oleva tegevuse või korraldatud ürituse lõppemise päevast. 2 (2) Toetuse sihipärast kasutamist kontrollib vastava valdkonna teenistuja, kellel on õigus nõuda toetuse kasutamise aruande juurde kuludokumentide koopiad ja selgitusi. 3 (3) Vallavalitsusel on õigus nõuda toetus tagasi, kui: 1 1) toetuse saaja ei kasuta või ei kasutanud toetust sihtotstarbeliselt; 2 2) toetuse saaja…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetuse saaja esitab veebipõhises keskkonnas projekti aruande 30 päeva jooksul alates toetuse eraldamise aluseks oleva tegevuse või korraldatud ürituse lõppemise päevast. 2 (2) Toetuse sihipärast kasutamist kontrollib vastava valdkonna teenistuja, kellel on õigus nõuda toetuse kasutamise aruande juurde kuludokumentide koopiad ja selgitusi. 3 (3) Vallavalitsusel on õigus nõuda toetus tagasi, kui: 1 1) toetuse saaja ei kasuta või ei kasutanud toetust sihtotstarbeliselt; 2 2) toetuse saaja esitab taotlemisel või aruandes valeandmeid; 3 3) toetuse saaja ei esita aruannet toetuse kasutamise kohta; 4 4) projekti tegevus ei ole osaliselt või tervikuna lepingus toodud mahus toimunud; 5 5) muudel lepingus sätestatud juhtudel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
