      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Toetuse saaja esitab veebipõhises keskkonnas projekti aruande 30 päeva jooksul alates toetuse eraldamise aluseks oleva tegevuse või korraldatud ürituse lõppemise päevast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1048639_Par_6"
      },
      "rdfs:label": "§ 6 lg 1",
      "estleg:targetGroup": [
