    {
      "@id": "estleg:Reg_1043714_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Korralduse eelnõu raha eraldamiseks koostab rahandusosakond.",
