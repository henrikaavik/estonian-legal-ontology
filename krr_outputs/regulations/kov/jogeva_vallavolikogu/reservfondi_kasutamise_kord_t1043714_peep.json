    {
      "@id": "estleg:Reg_1043714_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Taotluse läbivaatamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Reservfondi kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Vallavalitsuse vastava valdkonna teenistuja kontrollib taotluse arusaadavust ja põhjendatust. Kui taotluses pole täidetud käesoleva korra § 2 lõikes 2 ettenähtud nõudeid või taotlus pole muudel põhjustel arusaadav, annab teenistuja taotluse esitajale tähtaja puuduste kõrvaldamiseks või täiendavate selgituste edastamiseks. Kui taotleja ei kõrvalda määratud tähtajaks puudusi, jäetakse taotlus läbi vaatamata.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Vallavalitsuse vastava valdkonna teenistuja kontrollib taotluse arusaadavust ja põhjendatust. Kui taotluses pole täidetud käesoleva korra § 2 lõikes 2 ettenähtud nõudeid või taotlus pole muudel põhjustel arusaadav, annab teenistuja taotluse esitajale tähtaja puuduste kõrvaldamiseks või täiendavate selgituste edastamiseks. Kui taotleja ei kõrvalda määratud tähtajaks puudusi, jäetakse taotlus läbi vaatamata. 2 (2) Vallavalitsuse struktuuriüksuse ja vallavalitsuse hallatava asutuse taotluse puhul kontrollib rahandusosakond, kas taotlejal on võimalik neid kulusid katta valla eelarve tulude ülelaekumisest. RT IV 2021-03-24 17 424032021017 2021-03-27 3 (3) Vallavalitsusel on õigus jätta taotlus rahuldamata, rahuldada see osaliselt või täielikult. 4 (4) Korralduse eelnõu raha eraldamiseks koostab rahandusosakond. 2021-03-18 RT IV 2021-03-24 17 424032021017 2021-03-27",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavolikogu"
      },
