      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vallavalitsusel on õigus jätta taotlus rahuldamata, rahuldada see osaliselt või täielikult.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043714_Par_3"
      },
