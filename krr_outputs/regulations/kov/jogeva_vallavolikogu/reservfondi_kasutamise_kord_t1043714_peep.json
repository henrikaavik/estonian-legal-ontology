      "@id": "estleg:Reg_1043714_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Vallavalitsuse struktuuriüksuse ja vallavalitsuse hallatava asutuse taotluse puhul kontrollib rahandusosakond, kas taotlejal on võimalik neid kulusid katta valla eelarve tulude ülelaekumisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043714_Par_3"
      },
      "rdfs:label": "§ 3 lg 2",
      "estleg:targetGroup": [
