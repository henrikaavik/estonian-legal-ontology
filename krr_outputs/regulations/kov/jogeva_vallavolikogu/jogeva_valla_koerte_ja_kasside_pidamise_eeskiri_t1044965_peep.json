      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõgeva valla koerte ja kasside pidamise eeskiri",
      "estleg:summary": {
        "@value": "1(1) Jõgeva valla koerte ja kasside pidamise eeskiri sätestab koerte ja kasside pidamise nõuded Jõgeva valla haldusterritooriumil. 2(2) Lisaks eeskirjale tuleb koerte ja kasside pidamisel lähtuda loomakaitseseadusest, veterinaarseadusest ja muudest loomapidamist reguleerivatest õigusaktidest.2026-02-26RT IV2026-03-03124030320260122026-03-06",
        "@language": "et"
      },
      "estleg:legalText": "1(1) Jõgeva valla koerte ja kasside pidamise eeskiri sätestab koerte ja kasside pidamise nõuded Jõgeva valla haldusterritooriumil. 2(2) Lisaks eeskirjale tuleb koerte ja kasside pidamisel lähtuda loomakaitseseadusest, veterinaarseadusest ja muudest loomapidamist reguleerivatest õigusaktidest.2026-02-26RT IV2026-03-03124030320260122026-03-06",
      "estleg:enactedBy": {
