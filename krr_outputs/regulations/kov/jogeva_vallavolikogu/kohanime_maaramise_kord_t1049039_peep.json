      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohanime määramise pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Jõgeva Vallavalitsuse kui kollegiaalorgani pädevuses on: 1 1) kohanime määramine, muutmine ja kehtetuks tunnistamine; 2 2) arvamuse andmine ministri või Vabariigi Valitsuse määratavate kohanimede kohta Jõgeva vallas. 2 (2) Kõiki teisi kohanimeseaduses kohalikule omavalitsusele pandud ülesandeid täidab ametiasutus Jõgeva Vallavalitsus. 2024-11-21 RT IV 2024-11-29 13 429112024013 2024-12-02",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Jõgeva Vallavalitsuse kui kollegiaalorgani pädevuses on: 1 1) kohanime määramine, muutmine ja kehtetuks tunnistamine; 2 2) arvamuse andmine ministri või Vabariigi Valitsuse määratavate kohanimede kohta Jõgeva vallas. 2 (2) Kõiki teisi kohanimeseaduses kohalikule omavalitsusele pandud ülesandeid täidab ametiasutus Jõgeva Vallavalitsus. 2024-11-21 RT IV 2024-11-29 13 429112024013 2024-12-02",
