      "rdfs:label": {
        "@value": "§ 2. [Konkreetse eluruumi üüri suuruse määrab Jõgeva Vallavalitsus (korraldusega) arve...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluruumi üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Konkreetse eluruumi üüri suuruse määrab Jõgeva Vallavalitsus (korraldusega) arvestades eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega, veevarustuse ja kanalisatsiooni olemasolu, eluruumis teostatud remonte ja renoveerimisi ja muid asjaolusid.",
        "@language": "et"
      },
      "estleg:legalText": "Konkreetse eluruumi üüri suuruse määrab Jõgeva Vallavalitsus (korraldusega) arvestades eluruumi asukohta, ehituslikku seisukorda ja varustatust küttega, veevarustuse ja kanalisatsiooni olemasolu, eluruumis teostatud remonte ja renoveerimisi ja muid asjaolusid.",
