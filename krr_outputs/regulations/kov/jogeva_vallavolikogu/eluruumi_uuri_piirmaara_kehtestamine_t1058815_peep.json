      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Jõgeva valla munitsipaalomandis olevate eluruumide üüri ülemiseks piirmääraks ke...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Eluruumi üüri piirmäära kehtestamine",
      "estleg:summary": {
        "@value": "Jõgeva valla munitsipaalomandis olevate eluruumide üüri ülemiseks piirmääraks kehtestatakse 4 eurot ühe ruutmeetri kohta. Nimetatud üüri piirmäär ei sisalda eluruumi kasutamisega seotud kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muru niitmise, lumetõrje, maja üldelektri, korteriühistu makse jt).",
        "@language": "et"
      },
      "estleg:legalText": "Jõgeva valla munitsipaalomandis olevate eluruumide üüri ülemiseks piirmääraks kehtestatakse 4 eurot ühe ruutmeetri kohta. Nimetatud üüri piirmäär ei sisalda eluruumi kasutamisega seotud kõrvalkulusid (tasu vee- ja kanalisatsiooniteenuse, elektrienergia, prügiveo, muru niitmise, lumetõrje, maja üldelektri, korteriühistu makse jt).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavolikogu"
      },
