      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Üldhooldusteenuse hoolduskulude piirmäär",
      "estleg:summary": {
        "@value": "Määrus reguleerib rahvastikuregistrisse kantud Põhja-Sakala valla elanikele väljaspool kodu osutatava üldhooldusteenuse (edaspidi üldhooldusteenus) raames hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude (edaspidi hoolduskulude) tasumise piirmäära suuruse kehtestamist.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus reguleerib rahvastikuregistrisse kantud Põhja-Sakala valla elanikele väljaspool kodu osutatava üldhooldusteenuse (edaspidi üldhooldusteenus) raames hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kulude (edaspidi hoolduskulude) tasumise piirmäära suuruse kehtestamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0615"
