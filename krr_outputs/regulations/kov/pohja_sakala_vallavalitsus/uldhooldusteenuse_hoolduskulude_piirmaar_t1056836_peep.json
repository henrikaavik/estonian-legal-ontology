    },
    {
      "@id": "estleg:Reg_1056836_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Üldsätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Üldhooldusteenuse hoolduskulude piirmäär",
      "estleg:summary": {
        "@value": "1 (1) Määruses käsitatakse üldhooldusteenuse saaja elukohana Eesti rahvastikuregistrisse kantud elukoha aadressi. 2 (2) Väljaspool isiku kodu osutatav üldhooldusteenus on kohaliku omavalitsuse üksuse korraldatav sotsiaalteenus, mille eesmärk on turvalise keskkonna ja toimetuleku tagamine täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määruses käsitatakse üldhooldusteenuse saaja elukohana Eesti rahvastikuregistrisse kantud elukoha aadressi. 2 (2) Väljaspool isiku kodu osutatav üldhooldusteenus on kohaliku omavalitsuse üksuse korraldatav sotsiaalteenus, mille eesmärk on turvalise keskkonna ja toimetuleku tagamine täisealisele isikule, kes terviseseisundist, tegevusvõimest või elukeskkonnast tulenevatel põhjustel ei suuda kodustes tingimustes ajutiselt või püsivalt iseseisvalt toime tulla. 3 (3) Hoolduskulud makstakse Põhja-Sakala valla eelarvest sotsiaalosakonna poolt hinnatud üldhooldusteenuse vajaduse korral. 4 (4) Hooldusteenust vahetult osutavate hooldustöötajate ja abihooldustöötajate kuludeks on: 1 1) tööjõukulud; 2 2) tööriietuse ja isikukaitsevahendite kulud; 3 3) tervisekontrolli ja vaktsineerimise kulud; 4 4) koolituse ja supervisiooni kulud. 5 (5) Piirmäära suurus tagab teenuse saajale teenuse kättesaadavuse.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0615"
