      "rdfs:label": {
        "@value": "§ 4. Määruse kehtetuks tunnistamine ja jõustumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Põhja-Sakala Vallavalitsuse 09.04.2024. a määrus nr 4 „Valimisjaoskondade moodustamine“ tunnistatakse kehtetuks. 2 (2) Määrus jõustub kolmandal päeval pärast Riigi Teatajas avaldamist.",
        "@language": "et"
      },
