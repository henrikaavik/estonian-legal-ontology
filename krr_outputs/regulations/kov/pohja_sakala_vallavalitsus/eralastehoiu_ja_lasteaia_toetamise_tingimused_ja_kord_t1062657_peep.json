    {
      "@id": "estleg:Reg_1062657_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Järelevalve",
        "@language": "et"
      },
      "estleg:sourceAct": "Eralastehoiu ja -lasteaia toetamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Teenuse osutaja on kohustatud viivitamatult informeerima vallavalitsust riiklikku järelevalvet teostavate ametiisikute poolt tehtud olulisematest ettekirjutustest ja nende täitmisest. Ettekirjutuste põhjendamatul täitmata jätmisel või eiramisel peatatakse toetuse maksmine kuni ettekirjutuste täitmiseni. 2 (2) Vallavalitsuse esindajal on vajadusel õigus nõuda seletusi ning kontrollida toetuse kasutamise sihipärasust.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Teenuse osutaja on kohustatud viivitamatult informeerima vallavalitsust riiklikku järelevalvet teostavate ametiisikute poolt tehtud olulisematest ettekirjutustest ja nende täitmisest. Ettekirjutuste põhjendamatul täitmata jätmisel või eiramisel peatatakse toetuse maksmine kuni ettekirjutuste täitmiseni. 2 (2) Vallavalitsuse esindajal on vajadusel õigus nõuda seletusi ning kontrollida toetuse kasutamise sihipärasust. 3 (3) Vallavalitsusel on õigus osaliselt või täies mahus lõpetada toetuse maksmine ja/või nõuda toetuse osalist või täielikku tagastamist, kui: 1 1) toetuse taotlemisel on esitatud valeandmeid; 2 2) teenuse osutaja lõpetab tegevuse toetuse andmise perioodi kestel; 3 3) muudel lepingus sätestatud juhtudel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0615"
