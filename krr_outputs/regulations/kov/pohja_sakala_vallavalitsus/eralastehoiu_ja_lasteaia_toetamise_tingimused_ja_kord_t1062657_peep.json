    {
      "@id": "estleg:Reg_1062657_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Eralastehoiu ja -lasteaia toetamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Määrusega reguleeritakse eralastehoius ja -lasteaias käimise toetamist (edaspidi toetus) pooleteise- kuni seitsmeaastasele lapsele, kellele Põhja-Sakala vald ei ole loonud võimalust käia teeninduspiirkonna munitsipaallasteaias. 2 (2) Määrusega kehtestatakse toetuse andmise alused, toetuse suurus, toetuse taotlemise, määramise ja maksmise kord ning järelevalve toetuse kasutamise üle.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega reguleeritakse eralastehoius ja -lasteaias käimise toetamist (edaspidi toetus) pooleteise- kuni seitsmeaastasele lapsele, kellele Põhja-Sakala vald ei ole loonud võimalust käia teeninduspiirkonna munitsipaallasteaias. 2 (2) Määrusega kehtestatakse toetuse andmise alused, toetuse suurus, toetuse taotlemise, määramise ja maksmise kord ning järelevalve toetuse kasutamise üle.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
