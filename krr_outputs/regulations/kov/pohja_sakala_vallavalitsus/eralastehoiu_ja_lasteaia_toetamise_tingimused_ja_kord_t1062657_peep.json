        }
      ]
    },
    {
      "@id": "estleg:Reg_1062657_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määrusega kehtestatakse toetuse andmise alused, toetuse suurus, toetuse taotlemise, määramise ja maksmise kord ning järelevalve toetuse kasutamise üle.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062657_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1062657_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Toetuse andmise alused ja suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Eralastehoiu ja -lasteaia toetamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Toetuse määramise korral makstakse toetus teenuse osutajale vastava lepingu alusel Põhja-Sakala valla eelarves selleks ettenähtud vahendite arvelt. 2 (2) Teenuse osutajale makstakse toetust teenuse osutaja hinnakirja alusel, millest on maha arvatud Põhja-Sakala Vallavolikogu poolt kehtestatud lapsevanema osalustasu, kuid mitte rohkem kui vallavalitsuse poolt kehtestatud piirmäära ulatuses. Toidupäeva maksumuse tasub lapsevanem.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetuse määramise korral makstakse toetus teenuse osutajale vastava lepingu alusel Põhja-Sakala valla eelarves selleks ettenähtud vahendite arvelt. 2 (2) Teenuse osutajale makstakse toetust teenuse osutaja hinnakirja alusel, millest on maha arvatud Põhja-Sakala Vallavolikogu poolt kehtestatud lapsevanema osalustasu, kuid mitte rohkem kui vallavalitsuse poolt kehtestatud piirmäära ulatuses. Toidupäeva maksumuse tasub lapsevanem. 3 (3) Toetust makstakse ainult nendel juhtudel, kui teenuse osutaja on eralastehoid või -lasteaed, mis tegutseb alusharidusseaduse ja erakooliseaduse alusel, omab koolitusluba ja kellel on Põhja-Sakala Vallavalitsusega (edaspidi vallavalitsus) sõlmitud vastav leping käesoleva määruse alusel.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_pohja_sakala_vallavalitsus"
      },
