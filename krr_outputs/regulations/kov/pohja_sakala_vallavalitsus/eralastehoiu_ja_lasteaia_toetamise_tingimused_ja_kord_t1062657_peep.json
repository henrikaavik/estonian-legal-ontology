    {
      "@id": "estleg:Reg_1062657_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega reguleeritakse eralastehoius ja -lasteaias käimise toetamist (edaspidi toetus) pooleteise- kuni seitsmeaastasele lapsele, kellele Põhja-Sakala vald ei ole loonud võimalust käia teeninduspiirkonna munitsipaallasteaias.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1062657_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:mentionsInstitution": [
