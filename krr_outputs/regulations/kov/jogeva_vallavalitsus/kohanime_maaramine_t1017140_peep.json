      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Jõgeva vallas määratakse liikluspindadele kohanimed vastavalt juurdelisatud skee...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramine",
      "estleg:summary": {
        "@value": "Jõgeva vallas määratakse liikluspindadele kohanimed vastavalt juurdelisatud skeemidele järgmiselt: 1 1) Jõgeva alevikus Rehe tänav; 2 2) Jõgeva alevikus Sauna tänav; 3 3) Jõgeva alevikus Muru tänav; 4 4) Siimusti alevikus Pütsepa tänav; 5 5) Laiuse alevikus Tupiku tänav.",
        "@language": "et"
      },
      "estleg:legalText": "Jõgeva vallas määratakse liikluspindadele kohanimed vastavalt juurdelisatud skeemidele järgmiselt: 1 1) Jõgeva alevikus Rehe tänav; 2 2) Jõgeva alevikus Sauna tänav; 3 3) Jõgeva alevikus Muru tänav; 4 4) Siimusti alevikus Pütsepa tänav; 5 5) Laiuse alevikus Tupiku tänav.",
