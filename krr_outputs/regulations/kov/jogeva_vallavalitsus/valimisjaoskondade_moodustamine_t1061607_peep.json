        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab hääletamist kinnipidamiskohas, haiglas ja ööpäevases hoolekandeasutuses valimisjaoskond nr 1.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061607_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1061607_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kodus hääletamist korraldavad valimisjaoskonnad nr 1, 7 ja 9. Euroopa Parlamendi valimistel ja rahvahääletusel korraldavad need jaoskonnad ka asukohas hääletamist.",
