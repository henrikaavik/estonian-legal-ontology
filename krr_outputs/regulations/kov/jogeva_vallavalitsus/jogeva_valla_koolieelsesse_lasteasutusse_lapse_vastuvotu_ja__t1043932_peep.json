        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lasteaia rühma (edaspidi rühm) komplekteerimine toimub õppeaasta kaupa.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lasteaia uue õppeaasta rühmade komplekteerimise periood on eelneva õppeaasta 1. aprillist 31. maini.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Lasteaias käivate laste ja 1. aprilliks laekunud avalduste järgi planeerivad ametiasutuse vastava valdkonna ametnik ja lasteaia direktor uuel õppeaastal avatavate rühmade arvu lasteaias.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Lapse rühma paigutamise, rühmade komplekteerimise ja lapse üleviimise ühest rühmast teise otsustab lasteaia direktor, arvestades lapse vanust 30. septembri seisuga ning võimalusel vanema soovi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 4",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Kui vanema eelistatud lasteaias ei ole järgmiseks õppeaastaks kõigile vastava vanuserühma lastele kohti, pakutakse kohta teises Jõgeva valla lasteaias.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 5",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Koha saamisest teavitab lasteaia direktor vanemat maikuu jooksul. Vanem peab kahe nädala jooksul teatama, kas ta soovib kohta lasteaias või mitte.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 6",
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:dutyHolder": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_7",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "7",
      "estleg:legalText": "(7) Kui vanem ei ole oma otsusest teada andnud, on ametiasutusel õigus pakkuda kohta järgmisele koha järjekorras olevale lapsele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 7",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_8",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "8",
      "estleg:legalText": "(8) Vaba koha olemasolul võetakse lasteaeda lapsi ka õppeaasta keskel, lähtudes vastava vanusegrupi laekunud avalduste järjekorrast.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 8"
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_9",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "9",
      "estleg:legalText": "(9) Lasteaia direktor sõlmib vanemaga koha kasutamise lepingu, kus lepitakse kokku koha kasutamise algus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 9",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_10",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "10",
      "estleg:legalText": "(10) Lepingu sõlmimisel informeerib vanem kirjalikult lasteaeda lapse terviseseisundist tulenevatest eritingimustest ja muudest koha kasutamisega seotud asjaoludest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 10",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_11",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "11",
      "estleg:legalText": "(11) Eri- või sobitusrühmas koha taotlemiseks esitab vanem lasteaiale täiendavalt nõustamiskomisjoni otsuse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 11",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1043932_Par_3_Lg_12",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "12",
      "estleg:legalText": "(12) Enne koha kasutamise lepingu sõlmimist tutvub vanem lasteaia põhimääruse, kodukorra, tegevus- ja päevakavaga ning vanema poolt maksmisele kuuluva tasuga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1043932_Par_3"
      },
      "rdfs:label": "§ 3 lg 12",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
