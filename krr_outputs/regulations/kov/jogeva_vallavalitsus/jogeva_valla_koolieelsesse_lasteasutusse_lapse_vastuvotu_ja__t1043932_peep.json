        }
      ]
    },
    {
      "@id": "estleg:Reg_1043932_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Vabade lasteaiakohtade (edaspidi koht) olemasolul võib lasteaeda vastu võtta ka lapsi, kelle Eesti rahvastikuregistrijärgne elukoht ei ole Jõgeva vallas, kooskõlastades selle eelnevalt registrijärgse elukoha vallavalitsusega.",
