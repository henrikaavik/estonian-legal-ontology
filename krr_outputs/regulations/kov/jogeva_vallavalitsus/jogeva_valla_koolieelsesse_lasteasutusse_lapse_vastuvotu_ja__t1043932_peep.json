        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Lasteaeda võetakse eelisjärjekorras vastu 1,5- kuni 7-aastane laps, kelle Eesti rahvastikuregistrijärgne elukoht on Jõgeva vald.",
      "estleg:parentProvision": {
