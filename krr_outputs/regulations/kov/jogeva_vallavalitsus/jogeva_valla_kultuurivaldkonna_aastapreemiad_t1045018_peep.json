      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõgeva valla kultuurivaldkonna aastapreemiad",
      "estleg:summary": {
        "@value": "Jõgeva valla kultuurivaldkonna aastapreemiate andmise eesmärk on tunnustada valla kultuuriellu panustavaid interpreete, kollektiive, kultuurikorraldajaid ja kogukondi.",
        "@language": "et"
      },
      "estleg:legalText": "Jõgeva valla kultuurivaldkonna aastapreemiate andmise eesmärk on tunnustada valla kultuuriellu panustavaid interpreete, kollektiive, kultuurikorraldajaid ja kogukondi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0247"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1045018_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1045018_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1045018_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Jõgeva valla kultuurivaldkonna aastapreemiate andmise eesmärk on tunnustada valla kultuuriellu panustavaid interpreete, kollektiive, kultuurikorraldajaid ja kogukondi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1045018_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1045018_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Aastapreemiate kategooriad",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõgeva valla kultuurivaldkonna aastapreemiad",
      "estleg:summary": {
        "@value": "1 (1) Loomingupreemia antakse autorile, interpreedile, autorite või interpreetide kollektiivile, kelle looming on oluliselt rikastanud nii Jõgeva valla kui kogu maakonna kultuurielu. 2 (2) Korraldajapreemia antakse kultuurikorraldajale (isikule, kultuurikollektiivile, seltsile, ühendusele), kelle korraldatud üritus on oluliselt rikastanud Jõgeva valla kultuurikeskkonda ja tõstnud Jõgeva valla mainet elaniku- ning turistisõbraliku vallana.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Loomingupreemia antakse autorile, interpreedile, autorite või interpreetide kollektiivile, kelle looming on oluliselt rikastanud nii Jõgeva valla kui kogu maakonna kultuurielu. 2 (2) Korraldajapreemia antakse kultuurikorraldajale (isikule, kultuurikollektiivile, seltsile, ühendusele), kelle korraldatud üritus on oluliselt rikastanud Jõgeva valla kultuurikeskkonda ja tõstnud Jõgeva valla mainet elaniku- ning turistisõbraliku vallana. 3 (3) Kogukonnapreemia antakse Jõgeva vallas tegutsevale seltsile või ühendusele, kelle korraldatavad üritused aitavad hoida piirkonna kultuuritraditsioone ja kes on koostööaldis teiste ühenduste, ettevõtjate ja omavalitsusega ning on tuntud ja hea mainega elanike seas.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0247"
      },
