      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Jõgeva vallas Kuremaa alevikus määratakse liikluspindadele kohanimed vastavalt j...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Liikluspindadele kohanime määramine",
      "estleg:summary": {
        "@value": "Jõgeva vallas Kuremaa alevikus määratakse liikluspindadele kohanimed vastavalt juurdelisatud skeemile järgmiselt: 1 1) Palamuse tee; 2 2) Laiuse tee; 3 3) Soomevere tee; 4 4) Tööstuse tänav; 5 5) Farmi tänav; 6 6) Kaalumaja tänav; 7 7) Lossi tänav; 8 8) Tammemetsa tänav; 9 9) Metsa tänav; 10 10) Keskasula tänav; 11 11) Pargi tänav; 12 12) Pargi põik; 13 13) Järve tänav; 14 14) Ranna tänav.",
        "@language": "et"
      },
      "estleg:legalText": "Jõgeva vallas Kuremaa alevikus määratakse liikluspindadele kohanimed vastavalt juurdelisatud skeemile järgmiselt: 1 1) Palamuse tee; 2 2) Laiuse tee; 3 3) Soomevere tee; 4 4) Tööstuse tänav; 5 5) Farmi tänav; 6 6) Kaalumaja tänav; 7 7) Lossi tänav; 8 8) Tammemetsa tänav; 9 9) Metsa tänav; 10 10) Keskasula tänav; 11 11) Pargi tänav; 12 12) Pargi põik; 13 13) Järve tänav; 14 14) Ranna tänav.",
