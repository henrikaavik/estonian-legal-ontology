        }
      ]
    },
    {
      "@id": "estleg:Reg_1041015_Par_4_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Konkursikuulutuses esitatakse: 1) teenistusülesannete lühikirjeldus; 2) kandidaadile esitatavad nõuded; 3) määratud ajaks ametikohale nimetamise korral teenistustähtaeg; 4) osalise koormusega töötamise korral koormuse suurus; 5) kontaktisiku kontaktandmed; 6) konkursil osalemiseks nõutavad dokumendid ja nende esitamise tähtaeg ning viis.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041015_Par_4"
      },
      "rdfs:label": "§ 4 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    },
    {
      "@id": "estleg:Reg_1041015_Par_4_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Konkursikuulutuse avaldab vallakantselei.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041015_Par_4"
      },
      "rdfs:label": "§ 4 lg 2"
    },
    {
      "@id": "estleg:Reg_1041015_Par_4_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Konkursikuulutus avaldatakse avaliku teenistuse kesksel veebilehel ja Jõgeva valla veebilehel. Täiendavate värbamiskanalite kasutamise otsustab vaba teenistuskoha juht koostöös vallakantseleiga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041015_Par_4"
      },
      "rdfs:label": "§ 4 lg 3"
    },
    {
      "@id": "estleg:Reg_1041015_Par_4_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Sisekonkursi konkursikuulutus saadetakse kõikidele vallavalitsuse teenistujatele ametialase personaalse elektronposti kaudu. Teiste sisekonkursiga hõlmatud ametiasutuste sisese infovahetuskanali määrab vastav ametiasutus.",
      "estleg:parentProvision": {
