    {
      "@id": "estleg:Reg_1041015_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Vaba töökoha täitmiseks avalikku konkurssi korraldama ei pea. Vaba töökoha täitmise viisi otsustab vallavanem.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041015_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1041015_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Enne värbamise alustamist hindavad vaba teenistuskoha juht ja vallasekretär teenistuskoha ametijuhendi muutmise tarvidust ning vajadusel esitavad muudatusettepanekud vallavanemale.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1041015_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
