    {
      "@id": "estleg:Reg_1041015_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Konkursikuulutus",
        "@language": "et"
      },
      "estleg:sourceAct": "Teenistujate värbamise ja valiku kord",
      "estleg:summary": {
        "@value": "1(1)Konkursikuulutuses esitatakse:11) teenistusülesannete lühikirjeldus;22) kandidaadile esitatavad nõuded;33) määratud ajaks ametikohale nimetamise korral teenistustähtaeg;44) osalise koormusega töötamise korral koormuse suurus;55) kontaktisiku kontaktandmed;66) konkursil osalemiseks nõutavad dokumendid ja nende esitamise tähtaeg ning viis. 2(2)Konkursikuulutuse avaldab vallakantselei. 3(3)Konkursikuulutus avaldatakse avaliku teenistuse kesksel veebilehel ja Jõgeva valla veebilehel.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Konkursikuulutuses esitatakse:11) teenistusülesannete lühikirjeldus;22) kandidaadile esitatavad nõuded;33) määratud ajaks ametikohale nimetamise korral teenistustähtaeg;44) osalise koormusega töötamise korral koormuse suurus;55) kontaktisiku kontaktandmed;66) konkursil osalemiseks nõutavad dokumendid ja nende esitamise tähtaeg ning viis. 2(2)Konkursikuulutuse avaldab vallakantselei. 3(3)Konkursikuulutus avaldatakse avaliku teenistuse kesksel veebilehel ja Jõgeva valla veebilehel. Täiendavate värbamiskanalite kasutamise otsustab vaba teenistuskoha juht koostöös vallakantseleiga. 4(4)Sisekonkursi konkursikuulutus saadetakse kõikidele vallavalitsuse teenistujatele ametialase personaalse elektronposti kaudu. Teiste sisekonkursiga hõlmatud ametiasutuste sisese infovahetuskanali määrab vastav ametiasutus.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_jogeva_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0247"
      },
