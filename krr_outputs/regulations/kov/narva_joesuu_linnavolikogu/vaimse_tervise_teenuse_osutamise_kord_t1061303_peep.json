          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1061303_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenuse määramise aluseks on abivajaduse hindamine, arvestades koostatud juhtumiplaani või spetsialistide arvamust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061303_Par_5"
      },
      "rdfs:label": "§ 5 lg 2"
    },
    {
      "@id": "estleg:Reg_1061303_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Teenust ei määrata, kui: 1) taotleja on esitanud valeandmed, jätnud nõutud dokumendid tähtajaks esitamata; 2) taotleja keeldub abi määramiseks vajalikust koostööst; 3) hindamise tulemusel selgub, et abivajadus puudub või on kaetav muu teenusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061303_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
