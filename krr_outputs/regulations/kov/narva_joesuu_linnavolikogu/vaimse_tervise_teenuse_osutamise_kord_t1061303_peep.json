      "estleg:legalText": "(1) Teenuse määramise või määramata jätmise otsuse teeb sotsiaalosakonna juhataja või spetsialist 10 tööpäeva jooksul.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061303_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:targetGroup": [
