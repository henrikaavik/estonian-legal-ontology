      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Muude kulude hüvitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Narva-Jõesuu Linnavolikogu liikmetele ja komisjonide liikmetele tasu ja hüvituste maksmise kord",
      "estleg:summary": {
        "@value": "Volikogu ülesannete täitmisel tehtud kulutustest hüvitatakse lähetused, täienduskoolituse õppe- ja ööbimiskulud, ühissõiduki sõidukulud, isikliku sõiduauto kasutamise kulud.",
        "@language": "et"
      },
      "estleg:legalText": "Volikogu ülesannete täitmisel tehtud kulutustest hüvitatakse lähetused, täienduskoolituse õppe- ja ööbimiskulud, ühissõiduki sõidukulud, isikliku sõiduauto kasutamise kulud.",
