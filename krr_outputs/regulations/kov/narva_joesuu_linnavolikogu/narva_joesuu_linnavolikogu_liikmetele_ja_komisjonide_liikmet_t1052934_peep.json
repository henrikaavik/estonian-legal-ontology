    {
      "@id": "estleg:Reg_1052934_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tasu suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Narva-Jõesuu Linnavolikogu liikmetele ja komisjonide liikmetele tasu ja hüvituste maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Volikogu maksab volikogu liikmetele volikogu tööst osavõtu eest tasu ja volikogu ülesannete täitmisel tehtud kulutuste eest hüvitist linnaeelarves selleks ettenähtud summade ulatuses. 2 (2) Volikogu esimehe tasu suuruseks on 2500 eurot kuus. 3 (3) Volikogu aseesimehe tasu suuruseks on 1500 eurot kuus. 4 (4) Volikogu liikme tasu suuruseks on 500 eurot kuus. 5 (5) Volikogu alatise komisjoni esimehe tasu suuruseks on 400 eurot kuus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Volikogu maksab volikogu liikmetele volikogu tööst osavõtu eest tasu ja volikogu ülesannete täitmisel tehtud kulutuste eest hüvitist linnaeelarves selleks ettenähtud summade ulatuses. 2 (2) Volikogu esimehe tasu suuruseks on 2500 eurot kuus. 3 (3) Volikogu aseesimehe tasu suuruseks on 1500 eurot kuus. 4 (4) Volikogu liikme tasu suuruseks on 500 eurot kuus. 5 (5) Volikogu alatise komisjoni esimehe tasu suuruseks on 400 eurot kuus. 6 (6) Volikogu alatise komisjoni aseesimehe tasu suuruseks on 300 eurot kuus. 7 (7) Volikogu alatise komisjoni liikme tasu suuruseks on 75 eurot koosolekul osalemise korral. 8 (8) Volikogu esimees ja aseesimees ei saa lisaks määratud tasule volikogu liikme tasu, volikogu komisjoni esimehe tasu ega volikogu komisjoni aseesimehe tasu. 9 (9) Juulikuus Korra § 2 sätestatud tasusid ei maksta. RT IV2025-12-1814181220250012026-01-01",
