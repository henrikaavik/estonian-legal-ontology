    {
      "@id": "estleg:Reg_1052934_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Tasu väljamaksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Narva-Jõesuu Linnavolikogu liikmetele ja komisjonide liikmetele tasu ja hüvituste maksmise kord",
      "estleg:summary": {
        "@value": "1 (1) Käesoleva määruse § 2 lõikes 7 ning § 4 nimetatud tasu väljamaksmiseks esitavad volikogu liikmed ja komisjonide esimehed volikogu esimehele kinnitamiseks: RT IV 2022-02-26 72 426022022072 2022-03-01 , rakendatakse alates 01.01.2022. 1 1) komisjoni koosolekust osavõtu tabeli; 2 2) kirjaliku aruande koos kuludokumentidega, sõidukulude hüvitamiseks teekonnalehe. 2 (2) Volikogu esimees edastab kinnitatud kuludokumendid igakuiselt linnavalitsuse rahandusosakonnale.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Käesoleva määruse § 2 lõikes 7 ning § 4 nimetatud tasu väljamaksmiseks esitavad volikogu liikmed ja komisjonide esimehed volikogu esimehele kinnitamiseks: RT IV 2022-02-26 72 426022022072 2022-03-01 , rakendatakse alates 01.01.2022. 1 1) komisjoni koosolekust osavõtu tabeli; 2 2) kirjaliku aruande koos kuludokumentidega, sõidukulude hüvitamiseks teekonnalehe. 2 (2) Volikogu esimees edastab kinnitatud kuludokumendid igakuiselt linnavalitsuse rahandusosakonnale. 3 (3) Linnavalitsuse rahandusosakond maksab tasud välja hiljemalt järgneva kuu kümnendaks kuupäevaks tasu saamiseks õigustatud isiku pangaarvele kandmisega.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_narva_joesuu_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0514"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052934_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1052934_Par_5_Lg_1"
        },
        {
          "@id": "estleg:Reg_1052934_Par_5_Lg_2"
        },
        {
          "@id": "estleg:Reg_1052934_Par_5_Lg_3"
        }
      ],
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Issuer_narva_joesuu_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1052934_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesoleva määruse § 2 lõikes 7 ning § 4 nimetatud tasu väljamaksmiseks esitavad volikogu liikmed ja komisjonide esimehed volikogu esimehele kinnitamiseks: 1) komisjoni koosolekust osavõtu tabeli; 2) kirjaliku aruande koos kuludokumentidega, sõidukulude hüvitamiseks teekonnalehe.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052934_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:itemNumber": [
        "1",
        "2"
      ],
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
