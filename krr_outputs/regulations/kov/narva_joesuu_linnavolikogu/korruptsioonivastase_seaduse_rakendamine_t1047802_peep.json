    {
      "@id": "estleg:Reg_1047802_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Deklaratsiooni on kohustatud esitama: 1) linnavolikogu liige; 2) linnavalitsuse liige; 3) linna ametiasutuse hallatava asutuse juht; 4) linna valitseva mõju all oleva äriühingu ja linna asutatud sihtasutuse juhtorganite liikmed; 5) linna ametiasutuse juht.",
