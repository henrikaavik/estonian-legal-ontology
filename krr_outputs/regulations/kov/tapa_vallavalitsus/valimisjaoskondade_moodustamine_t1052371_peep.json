    {
      "@id": "estleg:Reg_1052371_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Hääletamise liigid jaoskondades",
        "@language": "et"
      },
      "estleg:sourceAct": "Valimisjaoskondade moodustamine",
      "estleg:summary": {
        "@value": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Nimetatud valimisjaoskond korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik valimisjaoskonnad.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohaliku omavalitsuse volikogu valimistel ja Riigikogu valimistel korraldab väljaspool elukohajärgset valimisringkonda eelhääletamist valimisjaoskond nr 1. Nimetatud valimisjaoskond korraldab hääletamist vajadusel ka asukohas ja ööpäevases hoolekandeasutuses. 2 (2) Euroopa Parlamendi valimistel ja rahvahääletusel korraldab jaoskond nr 1 hääletamist ööpäevases hoolekandeasutuses. 3 (3) Kodus hääletamist korraldavad kõik valimisjaoskonnad. Euroopa Parlamendi valimistel ja rahvahääletusel korraldavad need jaoskonnad ka asukohas hääletamist.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tapa_vallavalitsus"
      },
