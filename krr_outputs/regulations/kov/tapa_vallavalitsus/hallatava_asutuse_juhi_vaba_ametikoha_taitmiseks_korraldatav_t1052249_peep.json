      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjoni otsus tehakse hääletades. Igal komisjoni liikmel on üks hääl.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052249_Par_5"
      },
      "rdfs:label": "§ 5 lg 1"
    },
    {
      "@id": "estleg:Reg_1052249_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Valituks osutub kandidaat, kelle poolt hääletab üle poole komisjoni liikmetest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052249_Par_5"
      },
      "rdfs:label": "§ 5 lg 2"
    },
    {
      "@id": "estleg:Reg_1052249_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kui ükski kandidaat ei kogunud häälteenamust, võib komisjon korraldada kas kordushääletuse kõikide kandidaatide vahel, hääletamise kahe võrdselt enamhääli saanud kandidaadi vahel või teha kandidaatidele lisaülesannete voor.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052249_Par_5"
      },
      "rdfs:label": "§ 5 lg 3"
    },
    {
      "@id": "estleg:Reg_1052249_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Komisjoni otsustest annab kandidaatidele teada vallakantselei.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052249_Par_5"
      },
      "rdfs:label": "§ 5 lg 4"
    },
    {
      "@id": "estleg:Reg_1052249_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Konkursi nurjumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hallatava asutuse juhi vaba ametikoha täitmiseks korraldatava konkursi läbiviimise kord",
      "estleg:summary": {
        "@value": "1 (1) Konkurss on nurjunud, kui: 1 1) konkursil osalemiseks ei esitatud ühtegi avaldust; 2 2) kõik kandidaadid osutusid ametikohale mittevastavaks; 3 3) ükski kandidaat ei kogunud hääletusel nõutavat häälteenamust; 4 4) ühegi konkursitingimustele vastava kandidaadiga ei sõlmita töölepingut. 2 (2) Asutuse juhi puudumisel või konkursi nurjumisel määrab vallavanem käskkirjaga asutuse juhi ametikohale ajutise asendaja.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Konkurss on nurjunud, kui: 1 1) konkursil osalemiseks ei esitatud ühtegi avaldust; 2 2) kõik kandidaadid osutusid ametikohale mittevastavaks; 3 3) ükski kandidaat ei kogunud hääletusel nõutavat häälteenamust; 4 4) ühegi konkursitingimustele vastava kandidaadiga ei sõlmita töölepingut. 2 (2) Asutuse juhi puudumisel või konkursi nurjumisel määrab vallavanem käskkirjaga asutuse juhi ametikohale ajutise asendaja.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tapa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0792"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052249_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1052249_Par_6_Lg_1"
