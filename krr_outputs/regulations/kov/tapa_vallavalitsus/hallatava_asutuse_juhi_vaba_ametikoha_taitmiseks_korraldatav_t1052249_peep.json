    },
    {
      "@id": "estleg:Reg_1052249_Par_6_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Konkurss on nurjunud, kui: 1) konkursil osalemiseks ei esitatud ühtegi avaldust; 2) kõik kandidaadid osutusid ametikohale mittevastavaks; 3) ükski kandidaat ei kogunud hääletusel nõutavat häälteenamust; 4) ühegi konkursitingimustele vastava kandidaadiga ei sõlmita töölepingut.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052249_Par_6"
      },
      "rdfs:label": "§ 6 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    {
      "@id": "estleg:Reg_1052249_Par_6_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Asutuse juhi puudumisel või konkursi nurjumisel määrab vallavanem käskkirjaga asutuse juhi ametikohale ajutise asendaja.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1052249_Par_6"
      },
      "rdfs:label": "§ 6 lg 2"
    },
