    {
      "@id": "estleg:Reg_1042465_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Komisjoni töö juhtimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Tapa valla kriisikomisjoni põhimäärus",
      "estleg:summary": {
        "@value": "1(1)Komisjoni tööd juhib komisjoni esimees, tema äraolekul komisjoni aseesimees. 2(2)Komisjoni esimehe äraoleku all mõeldakse käesoleva määruse tähenduses olukorda, kus vallavanem ei saa täita komisjoni esimehe ülesandeid.",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Komisjoni tööd juhib komisjoni esimees, tema äraolekul komisjoni aseesimees. 2(2)Komisjoni esimehe äraoleku all mõeldakse käesoleva määruse tähenduses olukorda, kus vallavanem ei saa täita komisjoni esimehe ülesandeid.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tapa_vallavalitsus"
      },
      "estleg:enactedByMunicipality": {
