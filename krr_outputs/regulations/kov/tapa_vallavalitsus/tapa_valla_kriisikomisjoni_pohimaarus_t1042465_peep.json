    {
      "@id": "estleg:Reg_1042465_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjoni tööd juhib komisjoni esimees, tema äraolekul komisjoni aseesimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042465_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
