        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Komisjoni koosolekud protokollitakse. Protokollile kirjutavad alla komisjoni esimees, tema äraolekul komisjoni aseesimees ja protokollija.",
      "estleg:parentProvision": {
