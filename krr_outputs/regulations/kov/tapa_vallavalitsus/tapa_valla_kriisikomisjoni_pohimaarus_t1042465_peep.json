    {
      "@id": "estleg:Reg_1042465_Par_6_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjoni töövorm on koosolek.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042465_Par_6"
      },
      "rdfs:label": "§ 6 lg 1"
    },
    {
      "@id": "estleg:Reg_1042465_Par_6_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Komisjoni koosoleku toimumiskoht, päevakord, aeg, eelnõud ja ettevalmistatud materjalid saadetakse komisjoni liikmetele nende e-posti aadressidele hiljemalt viis tööpäeva enne koosoleku toimumise kuupäeva.",
      "estleg:parentProvision": {
