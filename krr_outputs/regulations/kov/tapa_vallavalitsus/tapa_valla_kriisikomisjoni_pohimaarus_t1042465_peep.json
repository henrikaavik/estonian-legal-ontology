      }
    },
    {
      "@id": "estleg:Reg_1042465_Par_6_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Komisjoni otsused võetakse vastu lihthäälteenamusega. Häälte võrdse jagunemise korral otsustab komisjoni esimehe või tema äraolekul komisjoni aseesimehe hääl. Kui ükski komisjoni liige hääletamist ei nõua, loetakse otsus ühehäälselt vastuvõetuks. Eriarvamused protokollitakse.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042465_Par_6"
      },
      "rdfs:label": "§ 6 lg 4",
      "estleg:targetGroup": [
