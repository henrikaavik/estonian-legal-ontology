      },
      "rdfs:label": "§ 6 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_1042465_Par_6_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Komisjon on otsustusvõimeline kui koosolekust võtab osa vähemalt pool komisjoni koosseisust, sealhulgas komisjoni esimees või tema äraolekul komisjoni aseesimees.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1042465_Par_6"
      },
      "rdfs:label": "§ 6 lg 3",
      "estleg:targetGroup": [
