        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Osalustasu maksmisest vabastamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohtla-Järve linna munitsipaallastehoiu ja -lasteaia osalustasu ning selle tasumise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1063475_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kui perest käib lastehoius või lasteaias samal ajal kaks või enam last, kelle rahvastikuregistrijärgne elukoht vastava kalendriaasta 1. jaanuari seisuga on Kohtla-Järve linn, tasub vanem osalustasu esimese lapse eest täies ulatuses, teise lapse eest pooles ulatuses ning kolmanda ja järgmiste laste eest vabastatakse vanem osalustasu maksmisest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui perest käib lastehoius või lasteaias samal ajal kaks või enam last, kelle rahvastikuregistrijärgne elukoht vastava kalendriaasta 1. jaanuari seisuga on Kohtla-Järve linn, tasub vanem osalustasu esimese lapse eest täies ulatuses, teise lapse eest pooles ulatuses ning kolmanda ja järgmiste laste eest vabastatakse vanem osalustasu maksmisest. 2 (2) Vanem vabastatakse osalustasu maksmisest kalendriaastas kuni kahe kuu eest vanema kirjaliku avalduse alusel, kui laps ei käi sel ajal lastehoius või lasteaias terve kalendrikuu. 3 (3) Vanem vabastatakse osalustasu maksmisest lastehoiu või lasteaia ajutisel sulgemisel terveks kalendrikuuks mistahes põhjusel, kui laps ei kasuta sel ajal lastehoiu või lasteaia teenust mõnes teises lastehoius või lasteaias.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1063475_Par_4_Lg_1"
        },
        {
          "@id": "estleg:Reg_1063475_Par_4_Lg_2"
