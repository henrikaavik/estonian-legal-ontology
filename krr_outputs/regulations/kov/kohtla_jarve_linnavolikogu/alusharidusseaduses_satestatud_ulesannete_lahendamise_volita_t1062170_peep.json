      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Pädevuse volitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Alusharidusseaduses sätestatud ülesannete lahendamise volitamine",
      "estleg:summary": {
        "@value": "Alusharidusseaduses sätestatud kohaliku omavalitsuse üksuse ning munitsipaallastehoiu või -lasteaia pidaja pädevusse antud ülesannete lahendamine volitatakse Kohtla-Järve Linnavalitsusele, välja arvatud ülesanded, mis kuuluvad volikogu ainupädevusse, § 5 lõikes 7 ja § 26 lõikes 3 sätestatud ülesanded ning § 46 lõikes 4 sätestatud munitsipaallastehoiu ja -lasteaia osalustasu kehtestamine.",
        "@language": "et"
      },
      "estleg:legalText": "Alusharidusseaduses sätestatud kohaliku omavalitsuse üksuse ning munitsipaallastehoiu või -lasteaia pidaja pädevusse antud ülesannete lahendamine volitatakse Kohtla-Järve Linnavalitsusele, välja arvatud ülesanded, mis kuuluvad volikogu ainupädevusse, § 5 lõikes 7 ja § 26 lõikes 3 sätestatud ülesanded ning § 46 lõikes 4 sätestatud munitsipaallastehoiu ja -lasteaia osalustasu kehtestamine.",
