      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Lastehoiu ja lasteaia õpetaja töötasu alammäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohtla-Järve Linnavalitsuse hallatava lastehoiu ja lasteaia õpetaja töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "Keeleseaduse ja selle alusel kehtestatud nõuetele vastava lastehoiu ja lasteaia õpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega lastehoiu ja lasteaia õpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.RT IV2025-11-0714071120250012026-01-01",
        "@language": "et"
      },
      "estleg:legalText": "Keeleseaduse ja selle alusel kehtestatud nõuetele vastava lastehoiu ja lasteaia õpetaja töötasu alammäär täistööajaga töötamise korral on vähemalt 90% ning samadele nõuetele vastaval magistrikraadiga või sellega võrdsustatud tasemega lastehoiu ja lasteaia õpetajal vähemalt 100% üldhariduskooli õpetaja töötasu alammäärast toetuse saamise aastal.RT IV2025-11-0714071120250012026-01-01",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_kohtla_jarve_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0321"
      },
