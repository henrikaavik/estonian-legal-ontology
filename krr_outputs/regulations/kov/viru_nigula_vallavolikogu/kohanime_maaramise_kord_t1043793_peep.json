      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kohanime määramine on kohanime määramine määramata nimega nimeobjektile kohanimeseaduse mõistes, määratud kohanime muutmine, määratud kohanime kehtetuks tunnistamine või ametliku kohanime või nimeobjekti ruumikuju muutmine.",
