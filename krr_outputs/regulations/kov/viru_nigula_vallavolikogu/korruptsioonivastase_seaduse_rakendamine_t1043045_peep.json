      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Vallavanema ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab: 1 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest; 2 2) kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3 3) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes; 4 4) arvestuse pidamise…",
        "@language": "et"
      },
      "estleg:legalText": "Vallavanem koordineerib korruptsiooniennetust vallavalitsuses ning vallavalitsuse hallatavates asutustes ja tagab: 1 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest; 2 2) kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3 3) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes; 4 4) arvestuse pidamise ametiasutuse ametnike tegelemise üle avaliku teenistuse seaduses nimetatud kõrvaltegevustega, samuti kontrolli avaliku teenistuse seaduses keeldude järgimise üle.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
