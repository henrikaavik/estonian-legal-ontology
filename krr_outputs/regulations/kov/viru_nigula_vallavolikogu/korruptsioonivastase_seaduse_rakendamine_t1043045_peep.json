      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Isikut teavitatakse viivitamata deklaratsiooni esitamise kohustusest vastava kohustuse tekkimisel. Teavitamise tagamise korraldab vallasekretär.",
      "estleg:parentProvision": {
