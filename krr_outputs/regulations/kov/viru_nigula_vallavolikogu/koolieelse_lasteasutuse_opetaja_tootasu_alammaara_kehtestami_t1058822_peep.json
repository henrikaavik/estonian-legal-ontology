    {
      "@id": "estleg:Reg_1058822_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Koolieelse lasteasutuse õpetaja töötasu alammäär",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolieelse lasteasutuse õpetaja töötasu alammäära kehtestamine",
      "estleg:summary": {
        "@value": "Kehtestada Viru-Nigula valla koolieelse lasteasutuse õpetaja töötasu alammäär täistööajaga töötamise korral keeleseaduse ja selle alusel kehtestatud nõuetele vastaval õpetajal järgmiselt: 1 1) kõrgema või keskeriharidusega kvalifikatsioonile vastava õpetaja töötasu alammäär 90% üldhariduskooli õpetajate töötasu alammäärast toetuse saamise aastal; 2 2) magistrikraadiga või sellega võrdsustatud tasemega õpetaja töötasu alammäär 100% üldhariduskooli õpetajate töötasu alammäärast toetuse saamise…",
        "@language": "et"
      },
      "estleg:legalText": "Kehtestada Viru-Nigula valla koolieelse lasteasutuse õpetaja töötasu alammäär täistööajaga töötamise korral keeleseaduse ja selle alusel kehtestatud nõuetele vastaval õpetajal järgmiselt: 1 1) kõrgema või keskeriharidusega kvalifikatsioonile vastava õpetaja töötasu alammäär 90% üldhariduskooli õpetajate töötasu alammäärast toetuse saamise aastal; 2 2) magistrikraadiga või sellega võrdsustatud tasemega õpetaja töötasu alammäär 100% üldhariduskooli õpetajate töötasu alammäärast toetuse saamise aastal.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0903"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1058822_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1058822_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1058822_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kehtestada Viru-Nigula valla koolieelse lasteasutuse õpetaja töötasu alammäär täistööajaga töötamise korral keeleseaduse ja selle alusel kehtestatud nõuetele vastaval õpetajal järgmiselt: 1) kõrgema või keskeriharidusega kvalifikatsioonile vastava õpetaja töötasu alammäär 90% üldhariduskooli õpetajate töötasu alammäärast toetuse saamise aastal; 2) magistrikraadiga või sellega võrdsustatud tasemega õpetaja töötasu alammäär 100% üldhariduskooli õpetajate töötasu alammäärast toetuse saamise aastal.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1058822_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
        "2"
      ]
    },
