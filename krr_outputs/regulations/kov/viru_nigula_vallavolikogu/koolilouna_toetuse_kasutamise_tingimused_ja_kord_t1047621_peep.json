    {
      "@id": "estleg:Reg_1047621_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1047621",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Reguleerimisala",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "Määrusega kehtestatakse riigieelarve ja Viru-Nigula valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Viru-Nigula valla munitsipaalkoolides.",
      "estleg:legalText": "Määrusega kehtestatakse riigieelarve ja Viru-Nigula valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Viru-Nigula valla munitsipaalkoolides. Määrusega kehtestatakse riigieelarve ja Viru-Nigula valla eelarve vahenditest eraldatud koolilõuna toetuse kasutamise tingimused ja kord Viru-Nigula valla munitsipaalkoolides.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0903"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047621_Map_2026"
      }
    },
    {
      "@id": "estleg:Reg_1047621_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1047621",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Viru-Nigula valla munitsipaalkoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks. Riigieelarvest eraldatud koolilõuna toetust kasutatakse Viru-Nigula valla munitsipaalkoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Riigieelarvest eraldatud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viru-Nigula valla eelarvest. Riigieelarves",
      "estleg:legalText": "1(1)Riigieelarvest eraldatud koolilõuna toetust kasutatakse Viru-Nigula valla munitsipaalkoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks. Riigieelarvest eraldatud koolilõuna toetust kasutatakse Viru-Nigula valla munitsipaalkoolide statsionaarses õppes põhi- ja keskharidust omandavate õpilaste koolilõuna kulude katmiseks. 2(2)Riigieelarvest eraldatud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viru-Nigula valla eelarvest. Riigieelarvest eraldatud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Viru-Nigula valla eelarvest. 3(3)Toitlustusteenuse osutajale kaetakse koolilõuna kulud toitlustusteenuse osutamise lepingu alusel, mille sõlmib vallavalitsus toitlustamist korraldava ettevõtjaga. Toitlustusteenuse osutajale kaetakse koolilõuna kulud toitlustusteenuse osutamise lepingu alusel, mille sõlmib vallavalitsus toitlustamist korraldava ettevõtjaga.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0903"
