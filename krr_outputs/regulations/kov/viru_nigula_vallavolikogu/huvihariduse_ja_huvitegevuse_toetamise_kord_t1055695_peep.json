      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse eesmärk ja reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Määrusega kehtestatakse rahvastikuregistri andmetel Viru-Nigula vallas elavate ja tasemeõppes õppivate 7–19-aastaste laste ja noorte huvihariduse omandamise ja huvitegevuses osalemise toetamise kord (edaspidi kord). 2 (2) Huvihariduse ja huvitegevuse toetuse (edaspidi toetus) määramise eesmärgiks on süsteemse ja juhendatud huvihariduse ja huvitegevuse kättesaadavuse ning mitmekesisuse parandamine Viru-Nigula vallas, et suurendada õppurite võimalusi omandada teadmisi, oskusi ja hoiakuid…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega kehtestatakse rahvastikuregistri andmetel Viru-Nigula vallas elavate ja tasemeõppes õppivate 7–19-aastaste laste ja noorte huvihariduse omandamise ja huvitegevuses osalemise toetamise kord (edaspidi kord). 2 (2) Huvihariduse ja huvitegevuse toetuse (edaspidi toetus) määramise eesmärgiks on süsteemse ja juhendatud huvihariduse ja huvitegevuse kättesaadavuse ning mitmekesisuse parandamine Viru-Nigula vallas, et suurendada õppurite võimalusi omandada teadmisi, oskusi ja hoiakuid valitud huvialal ning vähendada õppurite arengut takistavaid kitsaskohti.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0903"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055695_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1055695_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_1055695_Par_1_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1055695_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse rahvastikuregistri andmetel Viru-Nigula vallas elavate ja tasemeõppes õppivate 7–19-aastaste laste ja noorte huvihariduse omandamise ja huvitegevuses osalemise toetamise kord (edaspidi kord).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1055695_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1055695_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Huvihariduse ja huvitegevuse toetuse (edaspidi toetus) määramise eesmärgiks on süsteemse ja juhendatud huvihariduse ja huvitegevuse kättesaadavuse ning mitmekesisuse parandamine Viru-Nigula vallas, et suurendada õppurite võimalusi omandada teadmisi, oskusi ja hoiakuid valitud huvialal ning vähendada õppurite arengut takistavaid kitsaskohti.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1055695_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1055695_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Mõisted",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "estleg:summary": {
        "@value": "Korras kasutatakse mõisteid järgmises tähenduses:1) huvikool on huvihariduse omandamist pakkuv haridusasutus;2) huvihariduse omandamine on süsteemne ja juhendatud tegelemine huvialaga vaba tahte alusel õppetööst vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal huvikooli seaduse alusel tegutsevas koolis;3) huvitegevuses osalemine on süsteemne ja juhendatud tegevus vaba tahte alusel õppetööst vabal ajal, et omandada teadmised ja oskused valitud huvialal huviringis, klubis,…",
        "@language": "et"
      },
      "estleg:legalText": "Korras kasutatakse mõisteid järgmises tähenduses:1) huvikool on huvihariduse omandamist pakkuv haridusasutus;2) huvihariduse omandamine on süsteemne ja juhendatud tegelemine huvialaga vaba tahte alusel õppetööst vabal ajal, et omandada süvendatud teadmised ja oskused valitud huvialal huvikooli seaduse alusel tegutsevas koolis;3) huvitegevuses osalemine on süsteemne ja juhendatud tegevus vaba tahte alusel õppetööst vabal ajal, et omandada teadmised ja oskused valitud huvialal huviringis, klubis, stuudios vms.4) õppurid on rahvastikuregistri andmetel Viru-Nigula vallas elavad ja tasemeõppes õppivad 7–19-aastased lapsed ja noored, kes omandavad huviharidust või osalevad huvitegevuses.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0903"
