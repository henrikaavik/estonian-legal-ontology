    },
    {
      "@id": "estleg:Reg_1055695_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Huvihariduse ja huvitegevuse toetamise tingimused",
        "@language": "et"
      },
      "estleg:sourceAct": "Huvihariduse ja huvitegevuse toetamise kord",
      "estleg:summary": {
        "@value": "1 (1) Huvihariduse ja huvitegevuse toetust saavad taotleda õppuri seaduslik esindaja ja alates 18. eluaastast õppur ise. Õppuri vanus määratakse iga õppeaasta 1. septembri seisuga. 2 (2) Toetust makstakse õppuri osalemiseks ühes huviringis või huvialal. 3 (3) Toetuse määramise eelduseks on huvitegevuse toimumine õppeperioodi jooksul vähemalt üks kord nädalas. 4 (4) Toetust makstakse õppeperioodi (september-mai) eest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Huvihariduse ja huvitegevuse toetust saavad taotleda õppuri seaduslik esindaja ja alates 18. eluaastast õppur ise. Õppuri vanus määratakse iga õppeaasta 1. septembri seisuga. 2 (2) Toetust makstakse õppuri osalemiseks ühes huviringis või huvialal. 3 (3) Toetuse määramise eelduseks on huvitegevuse toimumine õppeperioodi jooksul vähemalt üks kord nädalas. 4 (4) Toetust makstakse õppeperioodi (september-mai) eest. 5 (5) Toetuse maksimaalmäär on 50% õppemaksust või osalustasust, kuid mitte enam kui 50,00 eurot kuus ühe õppuri kohta. 6 (6) Erandjuhul võib taotleda mõjuvatel sotsiaalsetel või hariduslikel põhjustel ka suuremat toetust. 7 (7) Väljaspool Viru-Nigula valda huvihariduse omandamisel ja huvitegevuses osalemisel makstakse toetust vaid juhul, kui Viru-Nigula vallas ei pakuta vastava huvialaga tegelemise võimalust. 8 (8) Erandjuhul toetuse maksmiseks küsib komisjon vastava valdkonna spetsialistilt põhjendatud seisukohta, miks on erandi tegemine vajalik. 9 (9) Toetust makstakse riigi poolt eraldatud vahenditest. Vahendite lõppemisel on Viru-Nigula vallavalitsusel kui ametiasutusel (edaspidi ametiasutus) õigus loobuda toetuse maksmisest.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_viru_nigula_vallavolikogu"
      },
