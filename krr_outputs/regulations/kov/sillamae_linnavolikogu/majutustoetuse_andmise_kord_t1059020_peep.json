    },
    {
      "@id": "estleg:Reg_1059020_Par_5_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Linnavalitsus kontrollib taotleja vastavust toetuse saamiseks kehtestatud nõuetele ning esitatud andmete õigsust, võrreldes neid Eesti hariduse infosüsteemis ja rahvastikuregistris olevate andmetega ja esitades need kontrollimiseks haridusasutusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059020_Par_5"
      },
      "rdfs:label": "§ 5 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_sillamae_linnavalitsus"
        }
      ],
      "estleg:competenceType": "enforcement"
    },
    {
      "@id": "estleg:Reg_1059020_Par_5_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Linnavalitsus otsustab toetuse andmise või sellest keeldumise ühe kuu jooksul taotluse esitamisest. Toetus otsustatakse igal aastal perioodiks taotluse esitamisest kuni jooksva kalendriaasta lõpuni.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059020_Par_5"
      },
      "rdfs:label": "§ 5 lg 2",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_sillamae_linnavalitsus"
        }
      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1059020_Par_5_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Linnavalitsus keeldub toetuse andmisest, kui taotleja ei vasta toetuse saamiseks kehtestatud nõuetele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059020_Par_5"
      },
      "rdfs:label": "§ 5 lg 3",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:competentAuthority": [
        {
          "@id": "estleg:Issuer_sillamae_linnavalitsus"
        }
      ],
      "estleg:competenceType": "general"
    },
    {
      "@id": "estleg:Reg_1059020_Par_5_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Linnavalitsus teavitab taotlejat toetuse andmise või sellest keeldumise otsusest kirjalikku taasesitamist võimaldavas vormis viie tööpäeva jooksul otsuse tegemisest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1059020_Par_5"
      },
      "rdfs:label": "§ 5 lg 4",
      "estleg:targetGroup": [
