        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Toetuse maksmise peatumine",
        "@language": "et"
      },
      "estleg:sourceAct": "Majutustoetuse andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Emapuhkuse ning vanemapuhkuse ajal toetust ei maksta. Toetuse väljamaksmist jätkatakse pärast emapuhkuse ning vanemapuhkuse lõppemist. 2 (2) Ajateenistuskohustuse täitmisele kutsutud kaitseväekohuslasele toetust ei maksta. Toetuse väljamaksmist jätkatakse pärast ajateenistuskohustuse täitmise lõppemist.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Emapuhkuse ning vanemapuhkuse ajal toetust ei maksta. Toetuse väljamaksmist jätkatakse pärast emapuhkuse ning vanemapuhkuse lõppemist. 2 (2) Ajateenistuskohustuse täitmisele kutsutud kaitseväekohuslasele toetust ei maksta. Toetuse väljamaksmist jätkatakse pärast ajateenistuskohustuse täitmise lõppemist.",
