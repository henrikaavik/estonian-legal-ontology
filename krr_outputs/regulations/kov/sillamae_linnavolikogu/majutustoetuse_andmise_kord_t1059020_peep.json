          "@id": "estleg:Issuer_sillamae_linnavalitsus"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1059020_Par_6",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Toetuse maksmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Majutustoetuse andmise kord",
      "estleg:summary": {
        "@value": "1 (1) Toetus makstakse välja taotlejale igakuiste maksetena alates toetuse andmise otsusele järgnevast kuust. 2 (2) Toetuse suurus on 150 eurot kuus. 3 (3) Toetuse maksmine lõpetatakse, kui taotlejaga sõlmitud tööleping lõppeb või toetuse taotlemise aluseks olevad asjaolud muutuvad selliselt, et taotleja ei vasta toetuse saamiseks kehtestatud nõuetele.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Toetus makstakse välja taotlejale igakuiste maksetena alates toetuse andmise otsusele järgnevast kuust. 2 (2) Toetuse suurus on 150 eurot kuus. 3 (3) Toetuse maksmine lõpetatakse, kui taotlejaga sõlmitud tööleping lõppeb või toetuse taotlemise aluseks olevad asjaolud muutuvad selliselt, et taotleja ei vasta toetuse saamiseks kehtestatud nõuetele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_sillamae_linnavolikogu"
      },
