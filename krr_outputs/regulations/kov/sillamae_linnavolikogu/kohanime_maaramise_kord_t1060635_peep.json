      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kohanime määramise pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Linnavolikogu pädevuses on: 1 1) kohanime määramine, muutmine ja kehtetuks tunnistamine linnaosale, tänavale ja väljakule; 2 2) arvamuse andmine ministri või Vabariigi Valitsuse määratavate kohanimede kohta Sillamäe linnas. 2 (2) Kõiki teisi kohanimeseaduses kohalikule omavalitsusele pandud ülesandeid täidab linnavalitsus.",
        "@language": "et"
      },
