      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Kohanime määramise eelnõu avalikustamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Kohanime määramise kord",
      "estleg:summary": {
        "@value": "1 (1) Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Sillamäe linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. 2 (2) Avalikustama ei pea eelnõu maaüksuse nime määramiseks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kohanime määramise eelnõu avalikustatakse kohalikus ajalehes ja Sillamäe linna veebilehel vähemalt 15 päeva enne kohanime määramise otsuse tegemist. 2 (2) Avalikustama ei pea eelnõu maaüksuse nime määramiseks.",
