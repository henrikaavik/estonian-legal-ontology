    {
      "@id": "estleg:Reg_1041941_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrus sätestab matusetoetuse määramise ja maksmise tingimused ning korra Sillamäe linnas.",
