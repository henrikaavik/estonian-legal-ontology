      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Korruptsioonijuhtumist teavitamise kohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Ametiisik on kohustatud viivitamata teavitama linnapead või linnavolikogu esimeest talle teatavaks saanud „Korruptsioonivastase seaduse“ § 3 lõikes 1 sätestatud keelu rikkumisest või muust korruptsioonijuhtumist. Vastavalt „Korruptsioonivastase seaduse“ § 6 lõigetele 2 ja 3 tagatakse teavitamise fakti konfidentsiaalsus.",
        "@language": "et"
      },
      "estleg:legalText": "Ametiisik on kohustatud viivitamata teavitama linnapead või linnavolikogu esimeest talle teatavaks saanud „Korruptsioonivastase seaduse“ § 3 lõikes 1 sätestatud keelu rikkumisest või muust korruptsioonijuhtumist. Vastavalt „Korruptsioonivastase seaduse“ § 6 lõigetele 2 ja 3 tagatakse teavitamise fakti konfidentsiaalsus.",
