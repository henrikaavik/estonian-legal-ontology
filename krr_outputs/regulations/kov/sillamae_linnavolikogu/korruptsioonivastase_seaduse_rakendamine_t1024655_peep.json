      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Käesoleva määrusega reguleeritakse korruptsiooni ennetamise korraldust Sillamäe linna avalikku ülesannet täitvates asutustes, sealhulgas määratakse kindlaks huvide deklaratsiooni (edaspidi deklaratsioon) esitama kohustatud isikud (edaspidi deklarandid) ning huvide deklaratsioonide kontrollimise komisjoni (edaspidi komisjon) koosseis.",
        "@language": "et"
      },
      "estleg:legalText": "Käesoleva määrusega reguleeritakse korruptsiooni ennetamise korraldust Sillamäe linna avalikku ülesannet täitvates asutustes, sealhulgas määratakse kindlaks huvide deklaratsiooni (edaspidi deklaratsioon) esitama kohustatud isikud (edaspidi deklarandid) ning huvide deklaratsioonide kontrollimise komisjoni (edaspidi komisjon) koosseis.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_sillamae_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0735"
      },
