      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Avalikku ülesannet täitva asutuse ülesanded",
        "@language": "et"
      },
      "estleg:sourceAct": "Korruptsioonivastase seaduse rakendamine",
      "estleg:summary": {
        "@value": "Linnavolikogu, linnavalitsus, linna asutatud sihtasutus ja „Konkurentsiseaduse“ tähenduses avalik ettevõtja peavad tagama nende nimel, ülesandel või järelevalve all avalikku ülesannet täitva ametiisiku: 1 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest; 2 2) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3 3) et ametiisik ei oleks kohustatud…",
        "@language": "et"
      },
      "estleg:legalText": "Linnavolikogu, linnavalitsus, linna asutatud sihtasutus ja „Konkurentsiseaduse“ tähenduses avalik ettevõtja peavad tagama nende nimel, ülesandel või järelevalve all avalikku ülesannet täitva ametiisiku: 1 1) ametiisikute korruptsiooni ennetamise alase teadlikkuse, sh teadlikkuse ametiisiku ja deklarandi staatusest ning sellega kaasnevatest kohustustest; 2 2) tõhusa kontrolli tegevus- ja toimingupiirangutest ning muudest kohustustest kinnipidamise üle; 3 3) et ametiisik ei oleks kohustatud tegema otsust või toimingut iseenda või temaga seotud isiku suhtes.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_sillamae_linnavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0735"
