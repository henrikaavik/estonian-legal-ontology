    {
      "@id": "estleg:Reg_1032470_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Delegeerida „Ehitusseadustiku“ § 28, § 35 lõikes 2, § 39 lõikes 1, § 47 lõikes 3, § 51 lõikes 1, § 99 lõigetes 2 ja 3, § 100, § 101 lõikes 1, § 103 lõikes 7, § 105 lõigetes 1 ja 3, § 106 lõikes 1, § 107 lõikes 1, § 110 lõikes 1, § 111 lõikes 1, § 124, § 128 lõike 3 punktis 2 ning § 130 lõikes 2 sätestatud kohaliku omavalitsuse, kohaliku omavalitsuse üksuse ja linna kui tee omaniku ülesanded Sillamäe Linnavalitsusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1032470_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": "2",
