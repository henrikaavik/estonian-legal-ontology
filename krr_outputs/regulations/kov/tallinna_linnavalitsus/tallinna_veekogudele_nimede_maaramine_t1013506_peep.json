      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. [Määrata Kesklinnas paiknevatele veekogudele nimed järgmiselt: 1 1) Kadrioru asum...]",
      "estleg:sourceAct": "Tallinna veekogudele nimede määramine",
      "estleg:summary": "Määrata Kesklinnas paiknevatele veekogudele nimed järgmiselt: 1 1) Kadrioru asumis Luigetiik (lisa 1), Kirdetiik ja Tagatiik (lisa 2); 2 2) Mõigu asumis Pühamäe järv (lisa 3); 3 3) Aegna saarel Talneeme oja (lisa 4). Kadrioru asumis Luigetiik (lisa 1), Kirdetiik ja Tagatiik (lisa 2); Mõigu asumis Pühamäe järv (lisa 3); Aegna saarel Talneeme oja (lisa 4).",
      "estleg:legalText": "Määrata Kesklinnas paiknevatele veekogudele nimed järgmiselt: 1 1) Kadrioru asumis Luigetiik (lisa 1), Kirdetiik ja Tagatiik (lisa 2); 2 2) Mõigu asumis Pühamäe järv (lisa 3); 3 3) Aegna saarel Talneeme oja (lisa 4). Kadrioru asumis Luigetiik (lisa 1), Kirdetiik ja Tagatiik (lisa 2); Mõigu asumis Pühamäe järv (lisa 3); Aegna saarel Talneeme oja (lisa 4).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1013506_Map_2026"
      }
    },
