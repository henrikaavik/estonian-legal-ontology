    {
      "@id": "estleg:Reg_1014793_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) L...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Ühissõidukipeatuste nimede määramine ja muutmine",
      "estleg:summary": {
        "@value": "Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) Lasnamäe linnaosas Laagna teel paikneva ühissõidukipeatuse senine nimi Võidujooksu asendada nimega Mehaanikakool; 2 2) Haabersti linnaosas Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Seljaku asendada nimega Selja; 3 3) Haabersti linnaosas Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Side asendada nimega Paljandi.",
        "@language": "et"
      },
      "estleg:legalText": "Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) Lasnamäe linnaosas Laagna teel paikneva ühissõidukipeatuse senine nimi Võidujooksu asendada nimega Mehaanikakool; 2 2) Haabersti linnaosas Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Seljaku asendada nimega Selja; 3 3) Haabersti linnaosas Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Side asendada nimega Paljandi.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
