    {
      "@id": "estleg:Reg_1015733_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1015733",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. [Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) L...]",
      "estleg:sourceAct": "Ühissõidukipeatuste nimede määramine ja muutmine",
      "estleg:summary": "Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) Laagna teel paikneva ühissõidukipeatuse senine nimi Uuslinn asendada nimega Kumu; 2 2) Pärnu maanteel paikneva ühissõidukipeatuse senine nimi Järve asendada nimega Virve. Laagna teel paikneva ühissõidukipeatuse senine nimi Uuslinn asendada nimega Kumu; Pärnu maanteel paikneva ühissõidukipeatuse senine nimi Järve asendada nimega Virve.",
      "estleg:legalText": "Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) Laagna teel paikneva ühissõidukipeatuse senine nimi Uuslinn asendada nimega Kumu; 2 2) Pärnu maanteel paikneva ühissõidukipeatuse senine nimi Järve asendada nimega Virve. Laagna teel paikneva ühissõidukipeatuse senine nimi Uuslinn asendada nimega Kumu; Pärnu maanteel paikneva ühissõidukipeatuse senine nimi Järve asendada nimega Virve.",
