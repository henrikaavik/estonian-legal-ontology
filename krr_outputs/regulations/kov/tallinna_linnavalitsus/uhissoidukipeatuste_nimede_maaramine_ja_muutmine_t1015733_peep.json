    {
      "@id": "estleg:Reg_1015733_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1015733",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. [Määrata ühissõidukipeatustele järgmised nimed: 1 1) Valgel tänaval Kunstimuuseum...]",
      "estleg:sourceAct": "Ühissõidukipeatuste nimede määramine ja muutmine",
      "estleg:summary": "Määrata ühissõidukipeatustele järgmised nimed: 1 1) Valgel tänaval Kunstimuuseumi piirkonnas paikneva ühissõidukipeatuse nimeks Kumu vastavalt määruse lisale 1; 2 2) Pärnamäe teel Kõlviku tee ristmiku piirkonnas paikneva ühissõidukipeatuse nimeks Kõlviku tee vastavalt määruse lisale 2; 3 3) Supluse puiesteel, enne E.Bornhöhe tee ristmikku paikneva ühissõidukipeatuse nimeks E.Bornhöhe tee vastavalt lisale 3; 4 4) Pärnu maanteel, enne Järve tänava ristmikku paikneva ühissõidukipeatuse nimeks Järve",
      "estleg:legalText": "Määrata ühissõidukipeatustele järgmised nimed: 1 1) Valgel tänaval Kunstimuuseumi piirkonnas paikneva ühissõidukipeatuse nimeks Kumu vastavalt määruse lisale 1; 2 2) Pärnamäe teel Kõlviku tee ristmiku piirkonnas paikneva ühissõidukipeatuse nimeks Kõlviku tee vastavalt määruse lisale 2; 3 3) Supluse puiesteel, enne E.Bornhöhe tee ristmikku paikneva ühissõidukipeatuse nimeks E.Bornhöhe tee vastavalt lisale 3; 4 4) Pärnu maanteel, enne Järve tänava ristmikku paikneva ühissõidukipeatuse nimeks Järve vastavalt lisale 4; 5 5) Pärnu maanteel, peale Risti tänava ristmikku paikneva ühissõidukipeatuse nimeks Kurni vastavalt määruse lisale 5. Valgel tänaval Kunstimuuseumi piirkonnas paikneva ühissõidukipeatuse nimeks Kumu vastavalt määruse lisale 1; Pärnamäe teel Kõlviku tee ristmiku piirkonnas paikneva ühissõidukipeatuse nimeks Kõlviku tee vastavalt määruse lisale 2; Supluse puiesteel, enne E.Bornhöhe tee ristmikku paikneva ühissõidukipeatuse nimeks E.Bornhöhe tee vastavalt lisale 3; Pärnu maanteel, enne Järve tänava ristmikku paikneva ühissõidukipeatuse nimeks Järve vastavalt lisale 4; Pärnu maanteel, peale Risti tänava ristmikku paikneva ühissõidukipeatuse nimeks Kurni vastavalt määruse lisale 5.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
