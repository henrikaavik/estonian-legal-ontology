      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata ühissõidukipeatustele järgmised nimed: 1 1) Väike-Ameerika tänaval, Tall...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Ühissõidukipeatuste nimede määramine ja muutmine",
      "estleg:summary": {
        "@value": "Määrata ühissõidukipeatustele järgmised nimed: 1 1) Väike-Ameerika tänaval, Tallinna Tehnikakõrgkooli ees, enne Pärnu maantee ristmikku paikneva ühissõidukipeatuse nimeks Uus Maailm vastavalt määruse lisale 1; 2 2) Paljassaare põigus, Paljassaare põik 11a tööstushoone piirkonnas paikneva ühissõidukipeatuse nimeks Paagi vastavalt määruse lisale 2; 3 3) Tehnika tänava pikendusel, enne Kaitseväe kalmistut paikneva ühissõidukipeatuse nimeks Veskiposti vastavalt määruse lisale 3; 4 4) Narva…",
        "@language": "et"
      },
      "estleg:legalText": "Määrata ühissõidukipeatustele järgmised nimed: 1 1) Väike-Ameerika tänaval, Tallinna Tehnikakõrgkooli ees, enne Pärnu maantee ristmikku paikneva ühissõidukipeatuse nimeks Uus Maailm vastavalt määruse lisale 1; 2 2) Paljassaare põigus, Paljassaare põik 11a tööstushoone piirkonnas paikneva ühissõidukipeatuse nimeks Paagi vastavalt määruse lisale 2; 3 3) Tehnika tänava pikendusel, enne Kaitseväe kalmistut paikneva ühissõidukipeatuse nimeks Veskiposti vastavalt määruse lisale 3; 4 4) Narva maanteel, Loopealse asumi piirkonnas paikneva ühissõidukipeatuse nimeks Loopealse vastavalt määruse lisale 4.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012946_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1012946_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1012946_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) 1) Väike-Ameerika tänaval, Tallinna Tehnikakõrgkooli ees, enne Pärnu maantee ristmikku paikneva ühissõidukipeatuse nimeks Uus Maailm vastavalt määruse lisale 1; 2) Paljassaare põigus, Paljassaare põik 11a tööstushoone piirkonnas paikneva ühissõidukipeatuse nimeks Paagi vastavalt määruse lisale 2; 3) Tehnika tänava pikendusel, enne Kaitseväe kalmistut paikneva ühissõidukipeatuse nimeks Veskiposti vastavalt määruse lisale 3; 4) Narva maanteel, Loopealse asumi piirkonnas paikneva ühissõidukipeatuse nimeks Loopealse vastavalt määruse lisale 4.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012946_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    {
      "@id": "estleg:Reg_1012946_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. [Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) N...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Ühissõidukipeatuste nimede määramine ja muutmine",
      "estleg:summary": {
        "@value": "Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) Narva maanteel Tallinna Ülikooli ees paikneva trammipeatuse senine nimi F. R. Kreutzwaldi asendada nimega Tallinna Ülikool; 2 2) Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Selja asendada nimega Õismäe raba; 3 3) Pirita teel paikneva autobussiliini nr 5 peatuse senine nimi Lillepi asendada nimega Lillepi park; 4 4) Vesse kaubanduskvartalis paikneva ühissõidukipeatuse senine nimi Elcoteq II asendada…",
        "@language": "et"
      },
      "estleg:legalText": "Muuta ühissõidukipeatuste senised nimed ja määrata uued nimed järgmiselt: 1 1) Narva maanteel Tallinna Ülikooli ees paikneva trammipeatuse senine nimi F. R. Kreutzwaldi asendada nimega Tallinna Ülikool; 2 2) Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Selja asendada nimega Õismäe raba; 3 3) Pirita teel paikneva autobussiliini nr 5 peatuse senine nimi Lillepi asendada nimega Lillepi park; 4 4) Vesse kaubanduskvartalis paikneva ühissõidukipeatuse senine nimi Elcoteq II asendada nimega Silde.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1012946_Map"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1012946_Par_2_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1012946_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) 1) Narva maanteel Tallinna Ülikooli ees paikneva trammipeatuse senine nimi F. R. Kreutzwaldi asendada nimega Tallinna Ülikool; 2) Vabaõhumuuseumi teel paikneva ühissõidukipeatuse senine nimi Selja asendada nimega Õismäe raba; 3) Pirita teel paikneva autobussiliini nr 5 peatuse senine nimi Lillepi asendada nimega Lillepi park; 4) Vesse kaubanduskvartalis paikneva ühissõidukipeatuse senine nimi Elcoteq II asendada nimega Silde.",
      "estleg:parentProvision": {
