    {
      "@id": "estleg:Reg_1010654_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Komisjon on viieliikmeline. Komisjoni esimees on liikluskorralduse valdkonda kureeriv abilinnapea. Komisjoni liikmed on linna finantsdirektor, Tallinna Transpordiameti liiklusosakonna järelevalve- ja parkimissektori jurist ja vaidemenetluse peaspetsialist ning Tallinna Kesklinna vanema asetäitja.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1010654_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:targetGroup": [
        {
