      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata vastavalt lisale Nõmme linnaosas Pääsküla asumis Raudtee tänava leviala...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Tänavanimede määramine Nõmme linnaosas",
      "estleg:summary": {
        "@value": "Määrata vastavalt lisale Nõmme linnaosas Pääsküla asumis Raudtee tänava leviala täpsustamisena: 1 1) Rännaku puiestee ja Naaritsa tänava vahelise Raudtee tänava lõigu uueks nimeks Liipri tänav; 2 2) Olevi tänava ja Rännaku puiestee vahelise Raudtee tänava lõigu uueks nimeks Relsi tänav .",
        "@language": "et"
      },
      "estleg:legalText": "Määrata vastavalt lisale Nõmme linnaosas Pääsküla asumis Raudtee tänava leviala täpsustamisena: 1 1) Rännaku puiestee ja Naaritsa tänava vahelise Raudtee tänava lõigu uueks nimeks Liipri tänav; 2 2) Olevi tänava ja Rännaku puiestee vahelise Raudtee tänava lõigu uueks nimeks Relsi tänav .",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
