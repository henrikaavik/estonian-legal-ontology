      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata Lasnamäe linnaosas Väo asumis Lagedi tee 8a, 14, 16b ja 16c kruntide det...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Tänavanime määramine Lasnamäe linnaosas",
      "estleg:summary": {
        "@value": "Määrata Lasnamäe linnaosas Väo asumis Lagedi tee 8a, 14, 16b ja 16c kruntide detailplaneeringuga kavandatavatele tänavatele nimed vastavalt lisale järgmiselt: 1 1) Tooma tänav (leviala osaline muutmine ja pikendamine); 2 2) Väo tee (leviala pikendamine); 3 3) Väomurru tänav (uus nimetatav tänav).",
        "@language": "et"
      },
      "estleg:legalText": "Määrata Lasnamäe linnaosas Väo asumis Lagedi tee 8a, 14, 16b ja 16c kruntide detailplaneeringuga kavandatavatele tänavatele nimed vastavalt lisale järgmiselt: 1 1) Tooma tänav (leviala osaline muutmine ja pikendamine); 2 2) Väo tee (leviala pikendamine); 3 3) Väomurru tänav (uus nimetatav tänav).",
