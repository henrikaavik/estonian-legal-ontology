      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. [Määrata Põhja-Tallinna linnaosas Kopli asumis Kopli liinide ja lähiala detailpla...]",
        "@language": "et"
      },
      "estleg:sourceAct": "Tänavanime määramine Põhja-Tallinnas",
      "estleg:summary": {
        "@value": "Määrata Põhja-Tallinna linnaosas Kopli asumis Kopli liinide ja lähiala detailplaneeringuga tekkivatele tänavatele nimed vastavalt lisale järgmiselt: 1 1) Treiali tänav (leviala pikendamine); 2 2) Kaevuri tänav (leviala osaline muutmine); 3 3) 2. liin (leviala täielik muutmine); 4 4) 5. liin (leviala täielik muutmine); 5 5) Liinivahe tänav (uus nimetatav tänav).",
        "@language": "et"
      },
      "estleg:legalText": "Määrata Põhja-Tallinna linnaosas Kopli asumis Kopli liinide ja lähiala detailplaneeringuga tekkivatele tänavatele nimed vastavalt lisale järgmiselt: 1 1) Treiali tänav (leviala pikendamine); 2 2) Kaevuri tänav (leviala osaline muutmine); 3 3) 2. liin (leviala täielik muutmine); 4 4) 5. liin (leviala täielik muutmine); 5 5) Liinivahe tänav (uus nimetatav tänav).",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_tallinna_linnavalitsus"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0784"
