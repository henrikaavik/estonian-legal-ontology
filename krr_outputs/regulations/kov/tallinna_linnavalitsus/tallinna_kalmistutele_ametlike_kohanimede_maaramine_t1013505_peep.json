    {
      "@id": "estleg:Reg_1013505_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1013505"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. [Määrata Kesklinnas paiknevatele kalmistutele nimed järgmiselt: 1 1) Juhkentali a...]",
      "estleg:sourceAct": "Tallinna kalmistutele ametlike kohanimede määramine",
      "estleg:summary": "Määrata Kesklinnas paiknevatele kalmistutele nimed järgmiselt: 1 1) Juhkentali asumis Siselinna kalmistu (lisa 1); 2 2) Juhkentali asumis Kaitseväe kalmistu (lisa 2); Juhkentali asumis Siselinna kalmistu (lisa 1); Juhkentali asumis Kaitseväe kalmistu (lisa 2);",
      "estleg:legalText": "Määrata Kesklinnas paiknevatele kalmistutele nimed järgmiselt: 1 1) Juhkentali asumis Siselinna kalmistu (lisa 1); 2 2) Juhkentali asumis Kaitseväe kalmistu (lisa 2); Juhkentali asumis Siselinna kalmistu (lisa 1); Juhkentali asumis Kaitseväe kalmistu (lisa 2);"
    },
    {
      "@id": "estleg:Reg_1013505_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1013505"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. [Määrata Pirita linnaosas paiknevatele kalmistutele nimed järgmiselt: 1 1) Pirita...]",
      "estleg:sourceAct": "Tallinna kalmistutele ametlike kohanimede määramine",
      "estleg:summary": "Määrata Pirita linnaosas paiknevatele kalmistutele nimed järgmiselt: 1 1) Pirita asumis Pirita kalmistu (lisa 3); 2 2) Kloostrimetsa asumis Metsakalmistu (lisa 4); 3 3) Laiaküla asumis ja Lepiku asumis Pärnamäe kalmistu (lisa 5); Pirita asumis Pirita kalmistu (lisa 3); Kloostrimetsa asumis Metsakalmistu (lisa 4); Laiaküla asumis ja Lepiku asumis Pärnamäe kalmistu (lisa 5);",
      "estleg:legalText": "Määrata Pirita linnaosas paiknevatele kalmistutele nimed järgmiselt: 1 1) Pirita asumis Pirita kalmistu (lisa 3); 2 2) Kloostrimetsa asumis Metsakalmistu (lisa 4); 3 3) Laiaküla asumis ja Lepiku asumis Pärnamäe kalmistu (lisa 5); Pirita asumis Pirita kalmistu (lisa 3); Kloostrimetsa asumis Metsakalmistu (lisa 4); Laiaküla asumis ja Lepiku asumis Pärnamäe kalmistu (lisa 5);"
    },
    {
      "@id": "estleg:Reg_1013505_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_1013505"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": "§ 3. [Määrata Nõmme linnaosas paiknevatele kalmistutele nimed järgmiselt: 1 1) Liiva a...]",
      "estleg:sourceAct": "Tallinna kalmistutele ametlike kohanimede määramine",
      "estleg:summary": "Määrata Nõmme linnaosas paiknevatele kalmistutele nimed järgmiselt: 1 1) Liiva asumis Liiva kalmistu (lisa 6); 2 2) Hiiu asumis Hiiu-Rahu kalmistu (lisa 7); 3 3) Rahumäe asumis Rahumäe kalmistu (lisa 8). Liiva asumis Liiva kalmistu (lisa 6); Hiiu asumis Hiiu-Rahu kalmistu (lisa 7); Rahumäe asumis Rahumäe kalmistu (lisa 8).",
      "estleg:legalText": "Määrata Nõmme linnaosas paiknevatele kalmistutele nimed järgmiselt: 1 1) Liiva asumis Liiva kalmistu (lisa 6); 2 2) Hiiu asumis Hiiu-Rahu kalmistu (lisa 7); 3 3) Rahumäe asumis Rahumäe kalmistu (lisa 8). Liiva asumis Liiva kalmistu (lisa 6); Hiiu asumis Hiiu-Rahu kalmistu (lisa 7); Rahumäe asumis Rahumäe kalmistu (lisa 8)."
    },
