    },
    {
      "@id": "estleg:Reg_1061429_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Käesoleva määruse §-s 1 nimetatud nõudeid: 1) rakendatakse rajatava linnavalgustuspaigaldise projekteerimisel ja ehitamisel, kui linnavalgustuspaigaldis jääb Tallinna linna omandisse; 2) rakendatakse Tallinna linna omandis olevate linnavalgustuspaigaldiste rekonstrueerimisele ja käidule ning alltarbija elektriseadme ühendamisel olemasoleva linnavalgustuspaigaldisega; 3) on soovitatav rakendada valgustuspaigaldise projekteerimisel ja ehitamisel, kui valgustuspaigaldis jääb eraomandisse, ning olemasolevale eraomandis olevale valgustuspaigaldisele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061429_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_1061429_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Linnavalgustuspaigaldisele, mille projekteerimist või ehitamist on alustatud enne käesoleva määruse jõustumist, kohaldatakse seni kehtinud nõudeid.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1061429_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1061429_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Käesoleva määruse § 2 lõike 1 punkti 2 ei kohaldata alltarbija elektriseadme ühendamisele olemasoleva linnavalgustuspaigaldisega, kui ühendus on tehtud enne käesoleva määruse jõustumist.",
      "estleg:parentProvision": {
