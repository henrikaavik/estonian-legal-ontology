      ]
    },
    {
      "@id": "estleg:Reg_1039788_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigieelarves ette nähtud toetust kasutatakse valla koolides 1.-12. klassi õpilaste koolilõuna kulude katmiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039788_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1039788_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) 11.–12. klassi õpilastele riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Saku valla eelarvest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039788_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1039788_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kool peab tagama õpilasele koolilõuna Vabariigi Valitsuse kehtestatud toetuse arvestusliku maksumuse ulatuses. Kooli direktor reguleerib toitlustamise korra koolis, määrates toetuse iga õpilaseni jõudmise viisi.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039788_Par_2"
      },
      "rdfs:label": "§ 2 lg 4"
    },
    {
      "@id": "estleg:Reg_1039788_Par_2_Lg_5",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "5",
      "estleg:legalText": "(5) Lõikes 2 käsitletud 1.–12. klassi õpilastel, kes õpivad väljaspool Saku valda, koolilõuna hinnavahe katmiseks esitab lapsevanem, eestkostja või kool Saku Vallavalitsusele vabas vormis taotluse, milles märgitakse õpilase nimi, isikukood, kool ja klass.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039788_Par_2"
      },
      "rdfs:label": "§ 2 lg 5"
    },
    {
      "@id": "estleg:Reg_1039788_Par_2_Lg_6",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "6",
      "estleg:legalText": "(6) Saku Vallavalitsus esitab laekunud avalduste alusel vastavale koolile õpilaste nimekirja, mille alusel kooli toitlustaja esitab igakuiselt arve Saku Vallavalitsusele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039788_Par_2"
      },
      "rdfs:label": "§ 2 lg 6"
    },
    {
      "@id": "estleg:Reg_1039788_Par_3",
