      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Reguleerimisala",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse Saku valla munitsipaalkoolides (edaspidi kool) riigieelarve ja Saku valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamise tingimused ja kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse Saku valla munitsipaalkoolides (edaspidi kool) riigieelarve ja Saku valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamise tingimused ja kord.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saku_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0718"
      },
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039788_Map"
      },
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1039788_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1039788_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse Saku valla munitsipaalkoolides (edaspidi kool) riigieelarve ja Saku valla eelarve vahenditest eraldatud koolilõuna toetuse (edaspidi toetus) kasutamise tingimused ja kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039788_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1039788_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koolilõuna toetuseks määratud eraldised ja nende kasutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Koolilõuna toetuse kasutamise tingimused ja kord",
      "estleg:summary": {
        "@value": "1 (1) Riigieelarves ette nähtud toetust kasutatakse valla koolides 1.-12. klassi õpilaste koolilõuna kulude katmiseks. 2 (2) 11.–12. klassi õpilastele riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Saku valla eelarvest. RT IV 2022-02-26 6 426022022006 2022-03-01 , rakendatakse alates 1.02.2022 3 (3) Kehtetu – RT IV 2022-02-26 6 426022022006 2022-03-01 4 (4) Kool peab tagama õpilasele koolilõuna Vabariigi Valitsuse kehtestatud toetuse arvestusliku maksumuse…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Riigieelarves ette nähtud toetust kasutatakse valla koolides 1.-12. klassi õpilaste koolilõuna kulude katmiseks. 2 (2) 11.–12. klassi õpilastele riigieelarves ette nähtud toetuse ja koolilõuna tegeliku maksumuse vahe kaetakse Saku valla eelarvest. RT IV 2022-02-26 6 426022022006 2022-03-01 , rakendatakse alates 1.02.2022 3 (3) Kehtetu – RT IV 2022-02-26 6 426022022006 2022-03-01 4 (4) Kool peab tagama õpilasele koolilõuna Vabariigi Valitsuse kehtestatud toetuse arvestusliku maksumuse ulatuses. Kooli direktor reguleerib toitlustamise korra koolis, määrates toetuse iga õpilaseni jõudmise viisi. 5 (5) Lõikes 2 käsitletud 1.–12. klassi õpilastel, kes õpivad väljaspool Saku valda, koolilõuna hinnavahe katmiseks esitab lapsevanem, eestkostja või kool Saku Vallavalitsusele vabas vormis taotluse, milles märgitakse õpilase nimi, isikukood, kool ja klass. RT IV 2022-02-26 6 426022022006 2022-03-01 , rakendatakse alates 1.02.2022 6 (6) Saku Vallavalitsus esitab laekunud avalduste alusel vastavale koolile õpilaste nimekirja, mille alusel kooli toitlustaja esitab igakuiselt arve Saku Vallavalitsusele.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saku_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0718"
