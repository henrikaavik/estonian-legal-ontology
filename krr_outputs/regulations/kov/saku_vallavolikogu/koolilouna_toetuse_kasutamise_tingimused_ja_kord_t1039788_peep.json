          "@id": "estleg:Issuer_saku_vallavalitsus"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1039788_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1039788_Par_2_Lg_2"
        },
        {
          "@id": "estleg:Reg_1039788_Par_2_Lg_4"
