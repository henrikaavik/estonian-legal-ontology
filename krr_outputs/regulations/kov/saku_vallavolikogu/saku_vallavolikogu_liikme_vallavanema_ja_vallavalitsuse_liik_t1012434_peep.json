      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Teenistuslähetus on Saku Vallavolikogu liikme, vallavanema ja Saku Vallavalitsuse liikme (edaspidi koos nimetatud lähetatav) saatmine kindlaksmääratud ajavahemikus täitma teenistusülesannet väljaspool alalise ametikoha asukohta või koolitusele väljaspool alalise ametikoha asukohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012434_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1012434_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Teenistuslähetusse saadetakse: 1) Saku Vallavolikogu (edaspidi volikogu) liige volikogu esimehe või tema asendaja otsuse alusel; 2) vallavanem volikogu esimehe või tema asendaja otsuse alusel; 3) Saku Vallavalitsuse (edaspidi vallavalitsus) liige vallavanema või tema asendaja otsuse alusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012434_Par_1"
      },
      "rdfs:label": "§ 1 lg 2",
      "estleg:itemNumber": [
