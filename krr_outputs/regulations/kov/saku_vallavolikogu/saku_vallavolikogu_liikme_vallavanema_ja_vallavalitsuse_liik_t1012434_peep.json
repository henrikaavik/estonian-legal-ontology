      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Välislähetus on lähetus välisriiki. Välislähetusse saadetakse: 1) volikogu liige volikogu eestseisuse otsuse alusel; 2) vallavanem volikogu esimehe või tema asendaja otsuse alusel; 3) vallavalitsuse liige vallavanema või tema asendaja otsuse alusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1012434_Par_1"
      },
      "rdfs:label": "§ 1 lg 3",
      "estleg:itemNumber": [
