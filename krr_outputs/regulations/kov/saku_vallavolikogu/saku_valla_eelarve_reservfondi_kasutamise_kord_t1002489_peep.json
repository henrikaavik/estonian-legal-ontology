    {
      "@id": "estleg:Reg_1002489_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Reservfondist vahendite taotlemine ja taotluse läbivaatamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Saku valla eelarve reservfondi kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Reservfondist vahendite eraldamiseks esitatakse vallavalitsusele kirjalik põhjendatud taotlus. 2 (2) Põhjendamata taotluse jätab vallavalitsus läbi vaatamata. Taotlejale teatatakse kirjalikult taotluse läbivaatamata jätmisest. 3 (3) Põhjendatud taotlusele lisab vallavalitsuse vastava valdkonna teenistuse juht omapoolse seisukoha taotluse põhjendatuse kohta. Valdkonna teenistuse juht edastab taotluse finantsteenistuse juhile, kes lisab omapoolse seisukoha taotluse põhjendatuse kohta.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Reservfondist vahendite eraldamiseks esitatakse vallavalitsusele kirjalik põhjendatud taotlus. 2 (2) Põhjendamata taotluse jätab vallavalitsus läbi vaatamata. Taotlejale teatatakse kirjalikult taotluse läbivaatamata jätmisest. 3 (3) Põhjendatud taotlusele lisab vallavalitsuse vastava valdkonna teenistuse juht omapoolse seisukoha taotluse põhjendatuse kohta. Valdkonna teenistuse juht edastab taotluse finantsteenistuse juhile, kes lisab omapoolse seisukoha taotluse põhjendatuse kohta. 4 (4) Vallavalitsusel on õigus: 1 1) nõuda taotlejalt täiendavaid põhjendusi või 2 2) jätta taotlus rahuldamata ühes põhjuste äranäitamisega või 3 3) rahuldada taotlus täielikult või osaliselt.",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saku_vallavolikogu"
      },
