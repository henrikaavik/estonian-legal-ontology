      "rdfs:label": {
        "@value": "§ 4. Reservfondist vahendite eraldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Saku valla eelarve reservfondi kasutamise kord",
      "estleg:summary": {
        "@value": "1 (1) Vahendite eraldamine reservfondist vormistatakse vallavalitsuse korraldusega. 2 (2) Reservfondist eraldatud vahendite ulatuses võib taotleja teha sihtotstarbelisi kulusid pärast vallavalitsuse vastava korralduse jõustumist. 3 (3) Vallavalitsus esitab vallavolikogule aruande reservfondi kasutamise kohta koos eelarve täitmise aruandega, samuti vallavolikogu igakordsel nõudmisel.",
        "@language": "et"
      },
