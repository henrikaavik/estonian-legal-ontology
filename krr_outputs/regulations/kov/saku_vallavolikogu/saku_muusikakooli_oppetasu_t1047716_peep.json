    {
      "@id": "estleg:Reg_1047716_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision",
        "estleg:KovProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Õppetasu suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Saku Muusikakooli õppetasu",
      "estleg:summary": {
        "@value": "1 (1) Õppetasu suurus ühe õppuri kohta kuus on, kui õppuri ja tema mõlema vanema või üksikvanema rahvastikuregistrijärgne elukoht on muusikakooli võtmise hetkel ja iga järgneva aasta 1. jaanuari seisuga Saku vald, järgmine: 1 1) ettevalmistusklassis ilma pilliõppeta 10% tegevuskulude arvestuslikust maksumusest; 2 2) ettevalmistusklassis koos pilliõppega 15% tegevuskulude arvestuslikust maksumusest; 3 3) põhi- ja üldõppes ning lisa-aastatel 20% tegevuskulude arvestuslikust maksumusest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Õppetasu suurus ühe õppuri kohta kuus on, kui õppuri ja tema mõlema vanema või üksikvanema rahvastikuregistrijärgne elukoht on muusikakooli võtmise hetkel ja iga järgneva aasta 1. jaanuari seisuga Saku vald, järgmine: 1 1) ettevalmistusklassis ilma pilliõppeta 10% tegevuskulude arvestuslikust maksumusest; 2 2) ettevalmistusklassis koos pilliõppega 15% tegevuskulude arvestuslikust maksumusest; 3 3) põhi- ja üldõppes ning lisa-aastatel 20% tegevuskulude arvestuslikust maksumusest. 2 (2) Õppetasu suurus ühe õppuri kohta kuus on, kui õppuri ja tema ühe vanema rahvastikuregistrijärgne elukoht on Saku vald või mujal, järgmine: 1 1) ettevalmistusklassis ilma pilliõppeta 20% tegevuskulude arvestuslikust maksumusest; 2 2) ettevalmistusklassis koos pilliõppega 30% tegevuskulude arvestuslikust maksumusest; 3 3) põhi- ja üldõppes ning lisa-aastatel 40% tegevuskulude arvestuslikust maksumusest. 3 (3) Üksikvanemana käsitletakse lapsevanemat, kes kinnitab, et kasvatab õppurit üksinda. 4 (4) Pere teisele ja igale järgmisele muusikakoolis õppivale rahvastikuregistri andmetel Saku valla elanikuks olevale alaealisele õppurile on õppetasu 50% väiksem käesoleva määruse paragrahvi 2 lõigetes 1 ja 2 kinnitatud õppetasu suurustest. 5 (5) Õppetasu suurus täiskasvanud õppuri kohta kuus, kui tema rahvastikuregistrijärgne elukoht on Saku vald, on 40% tegevuskulu arvestuslikust maksumusest. 6 (6) Muusikakooli õppurile, kes rahvastikuregistri järgi on Saku valla elanik ja osaleb Saku puhkpilliorkestri tegevuses, on õppetasu 50% väiksem käesoleva määruse paragrahvi 2 lõigetes 1 ja 2 kinnitatud õppetasu suurusest",
      "estleg:enactedBy": {
        "@id": "estleg:Issuer_saku_vallavolikogu"
      },
      "estleg:enactedByMunicipality": {
        "@id": "estleg:Municipality_EHAK_0718"
      },
