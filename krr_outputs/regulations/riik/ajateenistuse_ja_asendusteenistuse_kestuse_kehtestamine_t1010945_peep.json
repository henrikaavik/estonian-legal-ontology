      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Ajateenistuse kestuse erandid",
        "@language": "et"
      },
      "estleg:sourceAct": "Ajateenistuse ja asendusteenistuse kestuse kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1010945_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Ajateenistuse kestus on 11 kuud ajateenijatel, kes omandavad ajateenistuse kestel eriala, mis eeldab mahukat sõjaväelist väljaõpet või praktikat. 2 (2) Ajateenistuse kestus on 11 kuni 12 kuud ajateenijatel, kes: 1 1) omandavad ajateenistuse kestel eriala, mis eeldab mahukat sõjaväelist väljaõpet või praktikat ja 2 2) määratakse ajateenistuse jooksul alalises valmiduses oleva üksuse sõjaaja ametikohale. RT I 2023-05-09 7 109052023007 2023-05-12",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ajateenistuse kestus on 11 kuud ajateenijatel, kes omandavad ajateenistuse kestel eriala, mis eeldab mahukat sõjaväelist väljaõpet või praktikat. 2 (2) Ajateenistuse kestus on 11 kuni 12 kuud ajateenijatel, kes: 1 1) omandavad ajateenistuse kestel eriala, mis eeldab mahukat sõjaväelist väljaõpet või praktikat ja 2 2) määratakse ajateenistuse jooksul alalises valmiduses oleva üksuse sõjaaja ametikohale. RT I 2023-05-09 7 109052023007 2023-05-12",
      "estleg:hasSubsection": [
