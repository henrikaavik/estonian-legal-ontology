      ]
    },
    {
      "@id": "estleg:Reg_158286_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse veini käitleja poolt ekspordiks, hulgimüügiks või jaemüügiks suunatud veini kohta aruande esitamise kord ja aruande vorminõuded.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_158286_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_158286_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Aruande esitamise kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Veini kohta aruande esitamise kord ja aruande vorminõuded",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158286_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Veini käitlev ettevõtja esitab tema poolt eelmisel kalendrikuul ekspordiks, hulgimüügiks või jaemüügiks suunatud veini kohta aruande (edaspidi aruanne) riikliku alkoholiregistri volitatud töötlejale iga kuu 15. kuupäevaks. RTL 2010 11 198 13284060 2010-03-14+02:00 2 (2) Aruanne esitatakse elektrooniliselt infosüsteemide andmevahetuskihi (X-tee) kaudu või paberkandjal.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Veini käitlev ettevõtja esitab tema poolt eelmisel kalendrikuul ekspordiks, hulgimüügiks või jaemüügiks suunatud veini kohta aruande (edaspidi aruanne) riikliku alkoholiregistri volitatud töötlejale iga kuu 15. kuupäevaks. RTL 2010 11 198 13284060 2010-03-14+02:00 2 (2) Aruanne esitatakse elektrooniliselt infosüsteemide andmevahetuskihi (X-tee) kaudu või paberkandjal. RTL 2008 66 939 13006948 2008-08-08+03:00 3 (3) Kui veini käitlev ettevõtja volitab aruannet esitama isiku, kelle esindusõigus ei tulene seadusest, peab ta riikliku alkoholiregistri volitatud töötlejale teatama volitatud isiku nime ja isikukoodi. RTL 2010 11 198 13284060 2010-03-14+02:00",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_158286_Par_2_v158286"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_158286_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_158286_Par_2_Lg_2"
