      },
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse veini käitleja poolt ekspordiks, hulgimüügiks või jaemüügiks suunatud veini kohta aruande esitamise kord ja aruande vorminõuded. RTL 2010 11 198 13284060 2010-03-14+02:00",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse veini käitleja poolt ekspordiks, hulgimüügiks või jaemüügiks suunatud veini kohta aruande esitamise kord ja aruande vorminõuded. RTL 2010 11 198 13284060 2010-03-14+02:00",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
