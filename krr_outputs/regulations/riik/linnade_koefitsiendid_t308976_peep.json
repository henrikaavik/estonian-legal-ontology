        }
      ]
    },
    {
      "@id": "estleg:Reg_308976_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määruse lisaga kehtestatakse linnade koefitsiendid (edaspidi koefitsiendid), mida kasutatakse teenistujale välisesinduses töötamise ajal makstava välislähetustasu arvutamisel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_308976_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_308976_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kui linnale ei ole koefitsienti kehtestatud, kohaldatakse sama riigi muule linnale kehtestatud koefitsienti. Kui riigis on kehtestatud koefitsient mitmele linnale, kohaldatakse lähemal asuvale linnale kehtestatud koefitsienti.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_308976_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_308976_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Koefitsientide määramine ja korrigeerimine",
        "@language": "et"
      },
      "estleg:sourceAct": "Linnade koefitsiendid",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_308976_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Koefitsientide määramisel lähtutakse välisriigi või linna elukallidusest ja turvariskidest, valuutakursside muutustest ja muudest asjaoludest ning võetakse arvesse euro ja asukohariigi valuuta vahetuskursi muutust, tuginedes Euroopa Keskpanga noteeringutele või selle puudumisel asjaomase riigi keskpanga fikseeritud euro kursile. RT I 2010 65 486 13357712 2011-01-01 2 (2) Koefitsiendid vaadatakse üle ja vajaduse korral korrigeeritakse Rahandusministeeriumiga kooskõlastades vähemalt kord…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Koefitsientide määramisel lähtutakse välisriigi või linna elukallidusest ja turvariskidest, valuutakursside muutustest ja muudest asjaoludest ning võetakse arvesse euro ja asukohariigi valuuta vahetuskursi muutust, tuginedes Euroopa Keskpanga noteeringutele või selle puudumisel asjaomase riigi keskpanga fikseeritud euro kursile. RT I 2010 65 486 13357712 2011-01-01 2 (2) Koefitsiendid vaadatakse üle ja vajaduse korral korrigeeritakse Rahandusministeeriumiga kooskõlastades vähemalt kord kvartalis, arvestades eelnenud perioodi valuuta vahetuskursi muutust, ning kord aastas, võttes lisaks valuutakursi muutusele arvesse ka asjaomase välisriigi või linna eelnenud perioodi tarbijahinnaindeksi muutust.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_308976_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_308976_Par_2_Lg_2"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_308976_Par_2_v308976"
        }
      ],
      "estleg:mentionsInstitution": [
        {
          "@id": "estleg:Institution_rahandusministeerium"
        }
      ]
    },
    {
      "@id": "estleg:Reg_308976_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Koefitsientide määramisel lähtutakse välisriigi või linna elukallidusest ja turvariskidest, valuutakursside muutustest ja muudest asjaoludest ning võetakse arvesse euro ja asukohariigi valuuta vahetuskursi muutust, tuginedes Euroopa Keskpanga noteeringutele või selle puudumisel asjaomase riigi keskpanga fikseeritud euro kursile.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_308976_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_308976_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Koefitsiendid vaadatakse üle ja vajaduse korral korrigeeritakse Rahandusministeeriumiga kooskõlastades vähemalt kord kvartalis, arvestades eelnenud perioodi valuuta vahetuskursi muutust, ning kord aastas, võttes lisaks valuutakursi muutusele arvesse ka asjaomase välisriigi või linna eelnenud perioodi tarbijahinnaindeksi muutust.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_308976_Par_2"
      },
      "rdfs:label": "§ 2 lg 2",
      "estleg:targetGroup": [
