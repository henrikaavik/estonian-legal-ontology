      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Kaitsepolitseiameti teavitamiskohustus",
        "@language": "et"
      },
      "estleg:sourceAct": "Lahkumiskohustuse sundtäitmise korraldamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037524_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kaitsepolitseiamet teavitab Politsei- ja Piirivalveametit lahkumisettekirjutuse tegemisest ning väljasaatmise peatamise või kohaldamata jätmise tinginud asjaoludest viivitamata. 2 (2) Kaitsepolitseiamet edastab Politsei- ja Piirivalveametile lahkumisettekirjutuse ja sundtäitmise toimingu protokolli andmed viivitamata. 3 (3) Lisaks lahkumisettekirjutuse andmetele edastab Kaitsepolitseiamet Politsei- ja Piirivalveametile võimaluse korral väljasaadetava kohta järgmised andmed: 1 1) foto või…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaitsepolitseiamet teavitab Politsei- ja Piirivalveametit lahkumisettekirjutuse tegemisest ning väljasaatmise peatamise või kohaldamata jätmise tinginud asjaoludest viivitamata. 2 (2) Kaitsepolitseiamet edastab Politsei- ja Piirivalveametile lahkumisettekirjutuse ja sundtäitmise toimingu protokolli andmed viivitamata. 3 (3) Lisaks lahkumisettekirjutuse andmetele edastab Kaitsepolitseiamet Politsei- ja Piirivalveametile võimaluse korral väljasaadetava kohta järgmised andmed: 1 1) foto või näokujutis; 2 2) sõrmejäljed; 3 3) isikut tõendava dokumendi koopia.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
