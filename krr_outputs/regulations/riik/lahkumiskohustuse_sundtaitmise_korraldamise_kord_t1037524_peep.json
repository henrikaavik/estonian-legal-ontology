      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Väljasaatmise korraldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Lahkumiskohustuse sundtäitmise korraldamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037524_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kinnipidamiskeskuses viibiva või viibinud välismaalase väljasaatmise korraldab Politsei- ja Piirivalveamet. 2 (2) Kui kohus on välismaalasele mõistnud lisakaristusena Eestist väljasaatmise, korraldab selle täitmise Politsei- ja Piirivalveamet. 3 (3) Väljasaatmist korraldav haldusorgan kooskõlastab väljasaadetava üleandmise vastuvõtva riigi pädeva asutusega.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kinnipidamiskeskuses viibiva või viibinud välismaalase väljasaatmise korraldab Politsei- ja Piirivalveamet. 2 (2) Kui kohus on välismaalasele mõistnud lisakaristusena Eestist väljasaatmise, korraldab selle täitmise Politsei- ja Piirivalveamet. 3 (3) Väljasaatmist korraldav haldusorgan kooskõlastab väljasaadetava üleandmise vastuvõtva riigi pädeva asutusega. 4 (4) Väljasaadetava piiriületuse ning vajaduse korral tema üleandmise vastuvõtva riigi pädevale asutusele korraldab Politsei- ja Piirivalveamet. 5 (5) Kui välismaalase väljasaatmist korraldab Kaitsepolitseiamet, siis toimetab väljasaadetava määratud tähtajaks piiripunkti Kaitsepolitseiamet. 6 (6) Politsei- ja Piirivalveamet on kohustatud pidama arvestust ebaseaduslikult Eestis viibinud välismaalaste lahkumise üle.",
      "estleg:targetGroup": [
