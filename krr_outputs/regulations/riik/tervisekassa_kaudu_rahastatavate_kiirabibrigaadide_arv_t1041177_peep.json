      "rdfs:label": {
        "@value": "§ 2. Kiirabibrigaadide arv",
        "@language": "et"
      },
      "estleg:sourceAct": "Tervisekassa kaudu rahastatavate kiirabibrigaadide arv",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1041177_Map"
      },
      "estleg:summary": {
        "@value": "Tervisekassa kaudu rahastatakse vähemalt 102 kiirabibrigaadi ööpäevaringset pidamist. Nimetatud kiirabibrigaadidest 96 on õe- või arstibrigaadid ja kuus on reanimobiilibrigaadid, mille hulgas on kaks laste jaoks kohandatud reanimobiilibrigaadi, mis teostavad üksnes haiglatevahelist transporti. RT I 2023-05-23 1 123052023001 2023-05-26",
        "@language": "et"
      },
      "estleg:legalText": "Tervisekassa kaudu rahastatakse vähemalt 102 kiirabibrigaadi ööpäevaringset pidamist. Nimetatud kiirabibrigaadidest 96 on õe- või arstibrigaadid ja kuus on reanimobiilibrigaadid, mille hulgas on kaks laste jaoks kohandatud reanimobiilibrigaadi, mis teostavad üksnes haiglatevahelist transporti. RT I 2023-05-23 1 123052023001 2023-05-26",
      "estleg:hasVersion": [
