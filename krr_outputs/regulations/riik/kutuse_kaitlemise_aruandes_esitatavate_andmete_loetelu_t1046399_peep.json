      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kütuse käitlemise aruandes esitatavate andmete loetelu",
        "@language": "et"
      },
      "estleg:sourceAct": "Kütuse käitlemise aruandes esitatavate andmete loetelu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046399_Map"
      },
      "estleg:summary": {
        "@value": "Kütusemüüja esitab kütuse käitlemise aruande tegevuskohtade lõikes järgnevate andmetega: 1 1) müüdud kütuse nimetus; 2 2) müüdud kütuse kogus; 3 3) vedelkütuse erimärgistamise seaduse § 12 lõike 3 alusel kogutud andmed, eriotstarbelise diislikütuse müügi kuupäev, välisriigist ostja puhul ostja riik ja isikukoodi puudumisel sünnikuupäev.",
        "@language": "et"
      },
      "estleg:legalText": "Kütusemüüja esitab kütuse käitlemise aruande tegevuskohtade lõikes järgnevate andmetega: 1 1) müüdud kütuse nimetus; 2 2) müüdud kütuse kogus; 3 3) vedelkütuse erimärgistamise seaduse § 12 lõike 3 alusel kogutud andmed, eriotstarbelise diislikütuse müügi kuupäev, välisriigist ostja puhul ostja riik ja isikukoodi puudumisel sünnikuupäev.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1046399_Par_2_Lg_1"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1046399_Par_2_v1046399"
        }
      ]
    },
