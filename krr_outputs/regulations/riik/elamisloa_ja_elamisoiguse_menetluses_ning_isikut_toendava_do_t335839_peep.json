    {
      "@id": "estleg:Reg_335839_Par_7",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 7.",
      "rdfs:label": {
        "@value": "§ 7. Sõrmejäljekujutiste kasutuselevõtmise tähtpäev",
        "@language": "et"
      },
      "estleg:sourceAct": "Elamisloa ja elamisõiguse menetluses ning isikut tõendava dokumendi väljaandmise menetluses sõrmejälgede võtmise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_335839_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Määruse jõustumisest arvates hakatakse dokumendi taotlejalt võtma dokumendi taotluse esitamisel sõrmejälgi. 2 (2) Enne määruse jõustumist esitatud dokumendi taotluste puhul dokumendi taotlejalt sõrmejälgi ei võeta. 3 (3) Määruse jõustumisest arvates rakendatakse „Isikut tõendavate dokumentide seaduse” § 114 lõigetes 2–5 sätestatud isikliku ilmumise nõuet ning sama seaduse §-s 115 sätestatud erisusi.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määruse jõustumisest arvates hakatakse dokumendi taotlejalt võtma dokumendi taotluse esitamisel sõrmejälgi. 2 (2) Enne määruse jõustumist esitatud dokumendi taotluste puhul dokumendi taotlejalt sõrmejälgi ei võeta. 3 (3) Määruse jõustumisest arvates rakendatakse „Isikut tõendavate dokumentide seaduse” § 114 lõigetes 2–5 sätestatud isikliku ilmumise nõuet ning sama seaduse §-s 115 sätestatud erisusi.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
