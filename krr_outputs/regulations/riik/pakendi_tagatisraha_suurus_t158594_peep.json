      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Pakendi tagatisraha suurus",
        "@language": "et"
      },
      "estleg:sourceAct": "Pakendi tagatisraha suurus",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158594_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Pakendi tagatisraha ehk pandi suurus pakendiseaduse § 21 lõigetes 2−31 nimetatud pakendile ühe müügiühiku kohta kehtestatakse järgmiselt: 1 1) korduskasutuse klaaspakendile 0,10 eurot; 2 2) korduskasutuse plastpakendile 0,10 eurot; 3 3) ühekorra klaaspakendile 0,10 eurot; 4 4) ühekorra metallpakendile 0,10 eurot; 5 5) ühekorra plastpakendile mahuga kuni 0,5 liitrit (0,5 liitrit kaasa arvatud) 0,10 eurot; 6 6) ühekorra plastpakendile, mille maht on suurem, kui 0,5 liitrit (0,5 liitrit…",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Pakendi tagatisraha ehk pandi suurus pakendiseaduse § 21 lõigetes 2−31 nimetatud pakendile ühe müügiühiku kohta kehtestatakse järgmiselt: 1 1) korduskasutuse klaaspakendile 0,10 eurot; 2 2) korduskasutuse plastpakendile 0,10 eurot; 3 3) ühekorra klaaspakendile 0,10 eurot; 4 4) ühekorra metallpakendile 0,10 eurot; 5 5) ühekorra plastpakendile mahuga kuni 0,5 liitrit (0,5 liitrit kaasa arvatud) 0,10 eurot; 6 6) ühekorra plastpakendile, mille maht on suurem, kui 0,5 liitrit (0,5 liitrit välja arvatud) 0,10 eurot. 2 (2) Ühekordselt kasutatavale ja korduskasutatavale pakendile, mida ei ole käesoleva paragrahvi lõikes 1 nimetatud võib pakendiettevõtja kehtestada käesoleva paragrahvi lõikes 1 sätestatust erineva tagatisraha suuruse, kui pakendiettevõtjal on kasutusel pakendite tagastussüsteem, mille alusel saab jälgida turule lastud ja tagasivõetud pakendite koguseid. RT I 2025-02-12 1 112022025001 2025-02-15",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_158594_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_158594_Par_1_Lg_2"
        }
      ],
