      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Hasartmängumaksu deklaratsioonide vormide täitmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Hasartmängumaksu deklaratsioonide vormid ja nende täitmise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1026796_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kui hasartmängukorraldaja korraldab õnnemängu, osavusmängu või totot mitmes mängukohas, täidetakse deklaratsioonil iga mängukoha kohta üks rida. 2 (2) Tasumisele kuuluv maksusumma esitatakse eurodes sendi täpsusega.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui hasartmängukorraldaja korraldab õnnemängu, osavusmängu või totot mitmes mängukohas, täidetakse deklaratsioonil iga mängukoha kohta üks rida. 2 (2) Tasumisele kuuluv maksusumma esitatakse eurodes sendi täpsusega.",
