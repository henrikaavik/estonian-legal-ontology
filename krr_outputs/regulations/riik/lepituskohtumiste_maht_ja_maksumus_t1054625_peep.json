    },
    {
      "@id": "estleg:Reg_1054625_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Üks lepituskohtumine kestab 90 minutit ja selle maksumus on 125 eurot.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054625_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1054625_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kui lepitusmenetlus toimub seoses riikliku perelepitusteenuse seaduse § 11 lõikes 1 nimetatud perelepituse erijuhuga ning perelepitaja kaasab lepituskohtumistel osalema teise perelepitaja, arvestatakse lepituskohtumise maksumuseks 125 eurot mõlema perelepitaja kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054625_Par_2"
      },
      "rdfs:label": "§ 2 lg 3",
      "estleg:references": [
        {
          "@id": "estleg:RIIKLI_Par_11_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1054625_Par_2_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Kui lepituskohtumine lapse ärakuulamiseks korraldatakse riikliku perelepitusteenuse seaduse § 10 lõike 1 alusel, kestab üks lepituskohtumine 60 minutit ja selle maksumus on 83 eurot.",
