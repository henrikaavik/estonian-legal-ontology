      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Varumakse määr",
        "@language": "et"
      },
      "estleg:sourceAct": "Vedelkütusevaru maksemäär 2026",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1062309_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) 2026. aasta varumakse määrad on järgmised: 1 1) bensiini puhul 4,60 eurot 1000 liitri kütuse kohta; 2 2) kerge kütteõli ja diislikütuse puhul 3,70 eurot 1000 liitri kütuse kohta; 3 3) raske kütteõli puhul 3,70 eurot 1000 kilogrammi kütuse kohta; 4 4) reaktiivkütuse ja petrooli puhul 7,00 eurot 1000 liitri kohta. 2 (2) Lõikes 1 sätestatud varumakse määrale lisandub käibemaks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) 2026. aasta varumakse määrad on järgmised: 1 1) bensiini puhul 4,60 eurot 1000 liitri kütuse kohta; 2 2) kerge kütteõli ja diislikütuse puhul 3,70 eurot 1000 liitri kütuse kohta; 3 3) raske kütteõli puhul 3,70 eurot 1000 kilogrammi kütuse kohta; 4 4) reaktiivkütuse ja petrooli puhul 7,00 eurot 1000 liitri kohta. 2 (2) Lõikes 1 sätestatud varumakse määrale lisandub käibemaks.",
