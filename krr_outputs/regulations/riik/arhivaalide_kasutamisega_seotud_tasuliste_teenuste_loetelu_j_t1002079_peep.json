        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Rahvusarhiivi tasulised teenused ja tasu määrad",
        "@language": "et"
      },
      "estleg:sourceAct": "Arhivaalide kasutamisega seotud tasuliste teenuste loetelu ja tasu määrad",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002079_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Määrusega kehtestatakse Rahvusarhiivi osutatavate tasuliste teenuste loetelu ja tasu määrad vastavalt käesoleva määruse lisale. 2 (2) Teenuse eest, mille tasu määr on sätestatud tunnihinnana, tasu arvestamisel loetakse minimaalseks tellimuseks 1 tund. Kui tasu määr on sätestatud sekundi hinnana, siis arvestatakse tasu sekundi täpsusega. Teenuse eest, mille tasu määr on sätestatud minuti hinnana, tasu arvestamisel loetakse minimaalseks tellimuseks 15 minutit.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määrusega kehtestatakse Rahvusarhiivi osutatavate tasuliste teenuste loetelu ja tasu määrad vastavalt käesoleva määruse lisale. 2 (2) Teenuse eest, mille tasu määr on sätestatud tunnihinnana, tasu arvestamisel loetakse minimaalseks tellimuseks 1 tund. Kui tasu määr on sätestatud sekundi hinnana, siis arvestatakse tasu sekundi täpsusega. Teenuse eest, mille tasu määr on sätestatud minuti hinnana, tasu arvestamisel loetakse minimaalseks tellimuseks 15 minutit. RT I 2026-03-04 2 104032026002 2026-04-01 3 (3) Tellitud koopiate ja reproduktsioonide väljastamisel posti teel lisanduvad postikulud vastavalt postiteenuse pakkuja hinnakirjale. 2016-12-19 RT I 2016-12-22 16 122122016016 2017-01-01 63",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
