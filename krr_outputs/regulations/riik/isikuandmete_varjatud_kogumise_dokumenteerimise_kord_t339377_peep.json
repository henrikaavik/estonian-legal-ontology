        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Käesoleva määruse § 2 lõikes 2 nimetatud õiendi vormi kehtestab Politsei- ja Piirivalveameti peadirektor.",
