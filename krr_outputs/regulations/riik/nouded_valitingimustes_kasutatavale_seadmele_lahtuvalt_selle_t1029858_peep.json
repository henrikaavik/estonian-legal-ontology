      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Välitingimustes kasutatavale seadmele esitatavad nõuded",
        "@language": "et"
      },
      "estleg:sourceAct": "Nõuded välitingimustes kasutatavale seadmele lähtuvalt selle tekitatavast mürast ja selle seadme vastavushindamisele",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029858_Map"
      },
      "estleg:summary": {
        "@value": "Euroopa Parlamendi ja nõukogu direktiivi 2000/14/EÜ, välitingimustes kasutatavate seadmete müra kohta käivate liikmesriikide seaduste ühtlustamise kohta (EÜT L 162, 3.7.2000, lk 1–78), kohaldamisalas olevad seadmed peavad turule laskmisel ja kasutusele võtmisel vastama direktiivis sätestatud nõuetele, sealhulgas peab nende nõuetele vastavus olema ettenähtud korras tõendatud.",
        "@language": "et"
      },
      "estleg:legalText": "Euroopa Parlamendi ja nõukogu direktiivi 2000/14/EÜ, välitingimustes kasutatavate seadmete müra kohta käivate liikmesriikide seaduste ühtlustamise kohta (EÜT L 162, 3.7.2000, lk 1–78), kohaldamisalas olevad seadmed peavad turule laskmisel ja kasutusele võtmisel vastama direktiivis sätestatud nõuetele, sealhulgas peab nende nõuetele vastavus olema ettenähtud korras tõendatud.",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
