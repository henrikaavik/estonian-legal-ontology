      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Parkide piirid",
      "estleg:sourceAct": "Valga maakonna kaitsealuste parkide ja puistute piirid",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035004_Map_2026"
