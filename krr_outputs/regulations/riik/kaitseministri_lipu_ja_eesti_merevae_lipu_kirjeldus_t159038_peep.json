      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Kaitseministri lipu kirjeldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Kaitseministri lipu ja Eesti mereväe lipu kirjeldus",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_159038_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kaitseministri lipp on Eesti lipu värvikombinatsioonis ja selle mõlemal küljel on väike riigivapp. Vapilõvid lipu mõlemal küljel on suunatud lipuvarda poole. Kaitseministri lipu kujutis on toodud lisas 1. 2 (2) Kaitseministri lipu laiuse ja pikkuse vahekord on 7:11. 3 (3) Riigivapi keskkoht on 4,5 ühiku kaugusel lipu vardapoolsest otsast. Riigivapi ülemine ja alumine äär on lipu servadest 1,5 ühiku kaugusel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kaitseministri lipp on Eesti lipu värvikombinatsioonis ja selle mõlemal küljel on väike riigivapp. Vapilõvid lipu mõlemal küljel on suunatud lipuvarda poole. Kaitseministri lipu kujutis on toodud lisas 1. 2 (2) Kaitseministri lipu laiuse ja pikkuse vahekord on 7:11. 3 (3) Riigivapi keskkoht on 4,5 ühiku kaugusel lipu vardapoolsest otsast. Riigivapi ülemine ja alumine äär on lipu servadest 1,5 ühiku kaugusel.",
      "estleg:targetGroup": [
