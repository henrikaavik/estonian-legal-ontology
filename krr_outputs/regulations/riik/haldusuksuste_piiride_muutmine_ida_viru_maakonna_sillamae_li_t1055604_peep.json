        }
      ]
    },
    {
      "@id": "estleg:Reg_1055604_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ida-Viru maakonnas asuva Sillamäe linna ja Narva-Jõesuu linna piiri muudetakse järgmiselt: 1) Narva-Jõesuu linna Perjatsi küla territooriumiosa antakse Sillamäe linna koosseisu vastavalt lisale 1; 2) Sillamäe linna koosseisu kuuluvad katastriüksused antakse Narva-Jõesuu linna Perjatsi küla koosseisu ja Narva-Jõesuu linna Perjatsi küla katastriüksus antakse Sillamäe linna koosseisu vastavalt lisale 2; 3) Narva-Jõesuu linna Sõtke küla territooriumiosa antakse Sillamäe linna koosseisu vastavalt lisale 3.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1055604_Par_1"
      },
