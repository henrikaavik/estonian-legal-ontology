      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Sillamäe linna ja Narva-Jõesuu linna piiri muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haldusüksuste piiride muutmine Ida-Viru maakonna Sillamäe linnas ja Narva-Jõesuu linnas territooriumiosa üleandmisega",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1055604_Map"
      },
      "estleg:summary": {
        "@value": "Ida-Viru maakonnas asuva Sillamäe linna ja Narva-Jõesuu linna piiri muudetakse järgmiselt: 1 1) Narva-Jõesuu linna Perjatsi küla territooriumiosa antakse Sillamäe linna koosseisu vastavalt lisale 1; 2 2) Sillamäe linna koosseisu kuuluvad katastriüksused antakse Narva-Jõesuu linna Perjatsi küla koosseisu ja Narva-Jõesuu linna Perjatsi küla katastriüksus antakse Sillamäe linna koosseisu vastavalt lisale 2; 3 3) Narva-Jõesuu linna Sõtke küla territooriumiosa antakse Sillamäe linna koosseisu…",
        "@language": "et"
      },
      "estleg:legalText": "Ida-Viru maakonnas asuva Sillamäe linna ja Narva-Jõesuu linna piiri muudetakse järgmiselt: 1 1) Narva-Jõesuu linna Perjatsi küla territooriumiosa antakse Sillamäe linna koosseisu vastavalt lisale 1; 2 2) Sillamäe linna koosseisu kuuluvad katastriüksused antakse Narva-Jõesuu linna Perjatsi küla koosseisu ja Narva-Jõesuu linna Perjatsi küla katastriüksus antakse Sillamäe linna koosseisu vastavalt lisale 2; 3 3) Narva-Jõesuu linna Sõtke küla territooriumiosa antakse Sillamäe linna koosseisu vastavalt lisale 3.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1055604_Par_1_Lg_1"
        }
      ],
      "estleg:semanticallySimilarTo": [
        {
