    },
    {
      "@id": "estleg:Reg_1054547_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse päästeasutusse päästeteenistuja teenistuskohale, ametniku ametikohale või töötaja töökohale ja päästeteenistuse erialale kutseõppesse või rakenduskõrgharidusõppesse või päästeteenistuja teenistuskohale sisekaitselises rakenduskõrgkoolis kandideerija isikuankeedi vorm (lisa).",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1054547_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
