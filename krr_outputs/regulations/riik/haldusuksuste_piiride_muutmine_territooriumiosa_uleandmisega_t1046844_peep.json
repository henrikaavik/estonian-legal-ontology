      },
      "estleg:summary": {
        "@value": "Maa-amet kannab haldusüksuste piiri muudatused riigi maakatastri kaardile vastavalt määruse lisale.",
        "@language": "et"
      },
      "estleg:legalText": "Maa-amet kannab haldusüksuste piiri muudatused riigi maakatastri kaardile vastavalt määruse lisale.",
