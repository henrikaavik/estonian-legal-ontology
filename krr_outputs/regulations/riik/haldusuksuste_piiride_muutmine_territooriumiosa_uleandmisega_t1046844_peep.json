      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Kadrina valla ja Tapa valla piiri muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haldusüksuste piiride muutmine territooriumiosa üleandmisega",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1046844_Map"
      },
      "estleg:summary": {
        "@value": "Lääne-Viru maakonnas asuva Kadrina valla ja Tapa valla piiri muudetakse ning Kadrina valla Ridaküla territooriumil asuv Valgejõe voolujõe ja harujõe vahel olev maa-ala, mis on reformimata riigimaa ja mis paikneb praeguse omavalitsusüksuse lahkmejoone järgi Kadrina valla territooriumil ning piirneb Kadrina vallas Ridakülas asuvate Loobu metskond 309 katastriüksusega (27202:001:0062) ja Jõeääre katastriüksusega (27302:003:0680) ning Tapa vallas asuva Tapa linnaga, arvatakse Tapa vallas asuva Tapa…",
        "@language": "et"
      },
      "estleg:legalText": "Lääne-Viru maakonnas asuva Kadrina valla ja Tapa valla piiri muudetakse ning Kadrina valla Ridaküla territooriumil asuv Valgejõe voolujõe ja harujõe vahel olev maa-ala, mis on reformimata riigimaa ja mis paikneb praeguse omavalitsusüksuse lahkmejoone järgi Kadrina valla territooriumil ning piirneb Kadrina vallas Ridakülas asuvate Loobu metskond 309 katastriüksusega (27202:001:0062) ja Jõeääre katastriüksusega (27302:003:0680) ning Tapa vallas asuva Tapa linnaga, arvatakse Tapa vallas asuva Tapa linna koosseisu.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1046844_Par_1_Lg_1"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1046844_Par_1_v1046844"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1046844_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Lääne-Viru maakonnas asuva Kadrina valla ja Tapa valla piiri muudetakse ning Kadrina valla Ridaküla territooriumil asuv Valgejõe voolujõe ja harujõe vahel olev maa-ala, mis on reformimata riigimaa ja mis paikneb praeguse omavalitsusüksuse lahkmejoone järgi Kadrina valla territooriumil ning piirneb Kadrina vallas Ridakülas asuvate Loobu metskond 309 katastriüksusega (27202:001:0062) ja Jõeääre katastriüksusega (27302:003:0680) ning Tapa vallas asuva Tapa linnaga, arvatakse Tapa vallas asuva Tapa linna koosseisu.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1046844_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
