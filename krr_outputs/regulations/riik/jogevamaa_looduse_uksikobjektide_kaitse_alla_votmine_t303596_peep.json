      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kaitse alla võtmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Jõgevamaa looduse üksikobjektide kaitse alla võtmine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1056296_Map"
      },
      "estleg:summary": {
        "@value": "Jõgevamaal võetakse kaitse alla järgmised üksikobjektid: 1 1) Kivioja rändrahn Pajusi vallas Kaave külas; 2 2) Näkikivi Puurmanni vallas Tammiku külas; 3 3) Ruskavere rändrahn Ruskavere külas; 4 4) Taska-Sepasaare rändrahn Pajusi vallas uuevälja külas; 5 5) Tarakvere allikad (5tk) Saare vallas Tarakvere külas; 6 6) Torma tamm Torma alevikus. RT I 2021-12-23 33 123122021033 2022-01-02",
        "@language": "et"
      },
      "estleg:legalText": "Jõgevamaal võetakse kaitse alla järgmised üksikobjektid: 1 1) Kivioja rändrahn Pajusi vallas Kaave külas; 2 2) Näkikivi Puurmanni vallas Tammiku külas; 3 3) Ruskavere rändrahn Ruskavere külas; 4 4) Taska-Sepasaare rändrahn Pajusi vallas uuevälja külas; 5 5) Tarakvere allikad (5tk) Saare vallas Tarakvere külas; 6 6) Torma tamm Torma alevikus. RT I 2021-12-23 33 123122021033 2022-01-02",
