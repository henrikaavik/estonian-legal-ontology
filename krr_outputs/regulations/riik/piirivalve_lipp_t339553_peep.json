        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse politseiasutuse piirivalve valdkonna lipu (edaspidi piirivalve lipp) kirjeldus.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_339553_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_339553_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Piirivalve lipu kirjeldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Piirivalve lipp",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_339553_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Piirivalve lipp on piirivalve erimärgiga Eesti lipp. Piirivalve lipu kujutis on esitatud määruse lisas. 2 (2) Piirivalve erimärk on kollase äärisega roheline võrdhaarne kolmnurkne väli, millel on valged majusklid «P» ja «V». Erimärgi kõrgus on võrdne lipu laiusega ning kollase äärise laius on 1/10 lipu laiusest. 3 (3) Piirivalve erimärk paigutatakse Eesti lipu vardapoolsesse serva nii, et erimärgi tipp ulatub lipu südapunktini.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Piirivalve lipp on piirivalve erimärgiga Eesti lipp. Piirivalve lipu kujutis on esitatud määruse lisas. 2 (2) Piirivalve erimärk on kollase äärisega roheline võrdhaarne kolmnurkne väli, millel on valged majusklid «P» ja «V». Erimärgi kõrgus on võrdne lipu laiusega ning kollase äärise laius on 1/10 lipu laiusest. 3 (3) Piirivalve erimärk paigutatakse Eesti lipu vardapoolsesse serva nii, et erimärgi tipp ulatub lipu südapunktini.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_339553_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_339553_Par_2_Lg_2"
        },
