        }
      ]
    },
    {
      "@id": "estleg:Reg_339553_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Piirivalve lipp on piirivalve erimärgiga Eesti lipp. Piirivalve lipu kujutis on esitatud määruse lisas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_339553_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_339553_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Piirivalve erimärk on kollase äärisega roheline võrdhaarne kolmnurkne väli, millel on valged majusklid «P» ja «V». Erimärgi kõrgus on võrdne lipu laiusega ning kollase äärise laius on 1/10 lipu laiusest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_339553_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_339553_Par_2_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Piirivalve erimärk paigutatakse Eesti lipu vardapoolsesse serva nii, et erimärgi tipp ulatub lipu südapunktini.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_339553_Par_2"
      },
      "rdfs:label": "§ 2 lg 3"
