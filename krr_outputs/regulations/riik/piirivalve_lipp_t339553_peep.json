      "estleg:summary": {
        "@value": "Määrusega kehtestatakse politseiasutuse piirivalve valdkonna lipu (edaspidi piirivalve lipp) kirjeldus.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse politseiasutuse piirivalve valdkonna lipu (edaspidi piirivalve lipp) kirjeldus.",
      "estleg:hasSubsection": [
