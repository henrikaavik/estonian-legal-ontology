      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Registreerimisele kuuluvad maastikusõidukid",
        "@language": "et"
      },
      "estleg:sourceAct": "Registreerimisele kuuluvate maastikusõidukite loetelu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000726_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Liiklusregistris tuleb registreerida mootorsaan ja ratasmaastikusõiduk. 2 (2) Mootorsaan käesoleva määruse tähenduses on jalaste ja roomikuga varustatud mootori jõul jääl või lumel liikumiseks ette nähtud maastikusõiduk, millel lisaks juhi istekohale on kuni kaks istekohta. 3 (3) Ratasmaastikusõiduk käesoleva määruse tähenduses on maastikusõiduk, millel on vähemalt kolm ratast, mille sisepõlemismootori töömaht on üle 90 cm3 ja mis on valmistaja poolt ette nähtud maastikul liikumiseks.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Liiklusregistris tuleb registreerida mootorsaan ja ratasmaastikusõiduk. 2 (2) Mootorsaan käesoleva määruse tähenduses on jalaste ja roomikuga varustatud mootori jõul jääl või lumel liikumiseks ette nähtud maastikusõiduk, millel lisaks juhi istekohale on kuni kaks istekohta. 3 (3) Ratasmaastikusõiduk käesoleva määruse tähenduses on maastikusõiduk, millel on vähemalt kolm ratast, mille sisepõlemismootori töömaht on üle 90 cm3 ja mis on valmistaja poolt ette nähtud maastikul liikumiseks. Ratasmaastikusõidukiks ei loeta mootorsõidukit, mis on valmistaja poolt lisaks maastikul liikumiseks ette nähtud ka teel liikumiseks.",
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1000726_Par_1_v1000726"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1000726_Par_1_Lg_1"
        },
        {
          "@id": "estleg:Reg_1000726_Par_1_Lg_2"
        },
        {
          "@id": "estleg:Reg_1000726_Par_1_Lg_3"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1000726_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Liiklusregistris tuleb registreerida mootorsaan ja ratasmaastikusõiduk.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1000726_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1000726_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Mootorsaan käesoleva määruse tähenduses on jalaste ja roomikuga varustatud mootori jõul jääl või lumel liikumiseks ette nähtud maastikusõiduk, millel lisaks juhi istekohale on kuni kaks istekohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1000726_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1000726_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ratasmaastikusõiduk käesoleva määruse tähenduses on maastikusõiduk, millel on vähemalt kolm ratast, mille sisepõlemismootori töömaht on üle 90 cm³ ja mis on valmistaja poolt ette nähtud maastikul liikumiseks. Ratasmaastikusõidukiks ei loeta mootorsõidukit, mis on valmistaja poolt lisaks maastikul liikumiseks ette nähtud ka teel liikumiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1000726_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
      "@id": "estleg:Reg_1000726_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Määruse kohaldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Registreerimisele kuuluvate maastikusõidukite loetelu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1000726_Map"
      },
      "estleg:summary": {
        "@value": "Määrus ei laiene kaitseväe ja Kaitseliidu maastikusõidukitele ega maastikusõidukitele, mida kasutatakse ainult omaniku või valdaja territooriumil või selleks ettenähtud kohtades väljaõppeks ja võistlusteks.",
        "@language": "et"
      },
      "estleg:legalText": "Määrus ei laiene kaitseväe ja Kaitseliidu maastikusõidukitele ega maastikusõidukitele, mida kasutatakse ainult omaniku või valdaja territooriumil või selleks ettenähtud kohtades väljaõppeks ja võistlusteks.",
