      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Põhja-Pärnumaa valla ja Tori valla piiri muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haldusüksuste piiride muutmine Pärnu maakonna Põhja-Pärnumaa vallas ja Tori vallas territooriumiosa üleandmisega",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060033_Map"
      },
      "estleg:summary": {
        "@value": "Pärnu maakonnas asuva Põhja-Pärnumaa valla ja Tori valla piiri muudetakse järgmiselt: 1 1) Põhja-Pärnumaa valla Kangru küla katastriüksus antakse Tori valla Parisselja küla koosseisu ja Põhja-Pärnumaa valla Tarva küla katastriüksus antakse Tori valla Elbu küla koosseisu vastavalt määruse lisale 1; 2 2) Tori valla Elbi küla katastriüksused antakse Põhja-Pärnumaa valla Viluvere küla koosseisu vastavalt määruse lisale 2.",
        "@language": "et"
      },
      "estleg:legalText": "Pärnu maakonnas asuva Põhja-Pärnumaa valla ja Tori valla piiri muudetakse järgmiselt: 1 1) Põhja-Pärnumaa valla Kangru küla katastriüksus antakse Tori valla Parisselja küla koosseisu ja Põhja-Pärnumaa valla Tarva küla katastriüksus antakse Tori valla Elbu küla koosseisu vastavalt määruse lisale 1; 2 2) Tori valla Elbi küla katastriüksused antakse Põhja-Pärnumaa valla Viluvere küla koosseisu vastavalt määruse lisale 2.",
      "estleg:semanticallySimilarTo": [
