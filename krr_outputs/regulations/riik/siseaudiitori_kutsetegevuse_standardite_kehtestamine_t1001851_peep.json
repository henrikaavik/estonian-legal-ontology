      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Siseaudiitori kutsetegevuse standardite kehtestamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Siseaudiitori kutsetegevuse standardite kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1001851_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kehtestada järgmised siseaudiitori kutsetegevuse standardid: 1 1) siseauditi missioon, siseauditeerimise definitsioon, siseaudiitori kutsetegevuse aluspõhimõtted ja eetikakoodeks (lisa 1); RT I 2017-04-21 6 121042017006 2017-04-24 2 2) siseauditeerimise standardid (edaspidi standardid) (lisa 2). 2 (2) Siseauditeerimine määruse mõistes on siseaudiitori kutsetegevus „Audiitortegevuse seaduse” §-s 69 toodud tähenduses.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kehtestada järgmised siseaudiitori kutsetegevuse standardid: 1 1) siseauditi missioon, siseauditeerimise definitsioon, siseaudiitori kutsetegevuse aluspõhimõtted ja eetikakoodeks (lisa 1); RT I 2017-04-21 6 121042017006 2017-04-24 2 2) siseauditeerimise standardid (edaspidi standardid) (lisa 2). 2 (2) Siseauditeerimine määruse mõistes on siseaudiitori kutsetegevus „Audiitortegevuse seaduse” §-s 69 toodud tähenduses.",
      "estleg:hasSubsection": [
