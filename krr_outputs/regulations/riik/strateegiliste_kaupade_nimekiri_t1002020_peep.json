      },
      "estleg:summary": {
        "@value": "CAS (Chemical Abstracts Service) numbrid ei hõlma määruses kõiki strateegiliste kaupade nimekirja kantud kemikaale või nende segusid.",
        "@language": "et"
      },
      "estleg:legalText": "CAS (Chemical Abstracts Service) numbrid ei hõlma määruses kõiki strateegiliste kaupade nimekirja kantud kemikaale või nende segusid.",
