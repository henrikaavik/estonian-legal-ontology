      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Kemikaalide tähistus",
        "@language": "et"
      },
      "estleg:sourceAct": "Strateegiliste kaupade nimekiri",
      "estleg:partOfAct": {
