      "estleg:sourceAct": "Auditi audiitorteenuse vandeaudiitori aruande vormide kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_342684_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Audititele, mis käsitlevad 2016. aasta 14. detsembril või varem lõppenud aruandeperioodide aruandeid, kohaldatakse käesoleva määruse 2010. aasta 12. aprillil jõustunud redaktsiooni. 2 (2) Audititele, mis käsitlevad 2016. aasta 15. detsembril või hiljem lõppenud aruandeperioodide aruandeid, kohaldatakse käesoleva määruse 2017. aasta 1. veebruaril jõustunud redaktsiooni. RT I 2017-01-24 1 124012017001 2017-02-01",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Audititele, mis käsitlevad 2016. aasta 14. detsembril või varem lõppenud aruandeperioodide aruandeid, kohaldatakse käesoleva määruse 2010. aasta 12. aprillil jõustunud redaktsiooni. 2 (2) Audititele, mis käsitlevad 2016. aasta 15. detsembril või hiljem lõppenud aruandeperioodide aruandeid, kohaldatakse käesoleva määruse 2017. aasta 1. veebruaril jõustunud redaktsiooni. RT I 2017-01-24 1 124012017001 2017-02-01",
