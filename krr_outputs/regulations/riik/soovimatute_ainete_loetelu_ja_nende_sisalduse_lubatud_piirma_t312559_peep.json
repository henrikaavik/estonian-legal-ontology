    {
      "@id": "estleg:Reg_312559_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Soovimatu aine sisaldus täiendsöödas",
        "@language": "et"
      },
      "estleg:sourceAct": "Soovimatute ainete loetelu ja nende sisalduse lubatud piirmäärad söödas",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312559_Map"
      },
      "estleg:summary": {
        "@value": "Täiendsööta, mis sisaldab soovimatut ainet, mille sisalduse kohta täiendsöödas ei ole kehtestatud piirmäära, võib kasutada juhul, kui soovimatu aine sisaldus looma päevase söödavajaduse rahuldamiseks vajalikus söödakoguses ei ületa täissööda kohta kehtestatud piirmäära.",
        "@language": "et"
      },
      "estleg:legalText": "Täiendsööta, mis sisaldab soovimatut ainet, mille sisalduse kohta täiendsöödas ei ole kehtestatud piirmäära, võib kasutada juhul, kui soovimatu aine sisaldus looma päevase söödavajaduse rahuldamiseks vajalikus söödakoguses ei ületa täissööda kohta kehtestatud piirmäära.",
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_312559_Par_3_Lg_1"
        }
      ],
      "estleg:hasVersion": [
