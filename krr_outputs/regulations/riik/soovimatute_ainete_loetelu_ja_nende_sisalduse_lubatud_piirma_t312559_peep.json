      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Nõuetekohane sööt",
        "@language": "et"
      },
      "estleg:sourceAct": "Soovimatute ainete loetelu ja nende sisalduse lubatud piirmäärad söödas",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_312559_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Soovimatu aine sisaldus söödas ei tohi ületada Euroopa Parlamendi ja nõukogu direktiivi 2002/32/EÜ loomatoidus leiduvate soovimatute ainete kohta (EÜT L 140, 30.05.2002, lk 10–22) I lisas kehtestatud piirmäära. 2 (2) Soovimatu aine sisalduse häirekünnis söödas on kehtestatud Euroopa Parlamendi ja nõukogu direktiivi 2002/32/EÜ II lisas. RT I 2011-09-20 5 120092011005 2011-09-23",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Soovimatu aine sisaldus söödas ei tohi ületada Euroopa Parlamendi ja nõukogu direktiivi 2002/32/EÜ loomatoidus leiduvate soovimatute ainete kohta (EÜT L 140, 30.05.2002, lk 10–22) I lisas kehtestatud piirmäära. 2 (2) Soovimatu aine sisalduse häirekünnis söödas on kehtestatud Euroopa Parlamendi ja nõukogu direktiivi 2002/32/EÜ II lisas. RT I 2011-09-20 5 120092011005 2011-09-23",
