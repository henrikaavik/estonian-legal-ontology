      },
      "estleg:sourceAct": "Ohtlike ainete sisalduse piirväärtused pinnases",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047390_Map"
      },
      "estleg:summary": {
        "@value": "Sihtarv näitab ohtliku aine sellist sisaldust pinnases, millega võrdse või väiksema väärtuse korral loetakse pinnase seisund heaks.",
        "@language": "et"
      },
      "estleg:legalText": "Sihtarv näitab ohtliku aine sellist sisaldust pinnases, millega võrdse või väiksema väärtuse korral loetakse pinnase seisund heaks.",
