      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Määruse eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Ohtlike ainete sisalduse piirväärtused pinnases",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047390_Map"
      },
      "estleg:summary": {
        "@value": "Määruse eesmärk on kehtestada ohtlike ainete sisalduse piirväärtused pinnases pinnase seisundi hindamiseks ning pinnase seisundi parandamise meetmete kavandamiseks ja rakendamiseks.",
        "@language": "et"
      },
      "estleg:legalText": "Määruse eesmärk on kehtestada ohtlike ainete sisalduse piirväärtused pinnases pinnase seisundi hindamiseks ning pinnase seisundi parandamise meetmete kavandamiseks ja rakendamiseks.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1047390_Par_1_Lg_1"
        }
      ],
      "estleg:semanticallySimilarTo": [
        {
          "@id": "estleg:Reg_1047625_Par_1"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1047390_Par_1_v1047390"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1047390_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määruse eesmärk on kehtestada ohtlike ainete sisalduse piirväärtused pinnases pinnase seisundi hindamiseks ning pinnase seisundi parandamise meetmete kavandamiseks ja rakendamiseks.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047390_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1047390_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Ohtlike ainete sisalduse piirväärtused pinnases",
        "@language": "et"
      },
      "estleg:sourceAct": "Ohtlike ainete sisalduse piirväärtused pinnases",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047390_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Ohtlike ainete sisalduse piirväärtusi pinnases väljendatakse piirarvu ja sihtarvu kaudu ning need esitatakse milligrammides ühe kilogrammi pinnase kuivmassi kohta. 2 (2) Ohtlike ainete sisalduse piirväärtused pinnases on esitatud käesoleva määruse lisas.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ohtlike ainete sisalduse piirväärtusi pinnases väljendatakse piirarvu ja sihtarvu kaudu ning need esitatakse milligrammides ühe kilogrammi pinnase kuivmassi kohta. 2 (2) Ohtlike ainete sisalduse piirväärtused pinnases on esitatud käesoleva määruse lisas.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1047390_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1047390_Par_2_Lg_2"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1047390_Par_2_v1047390"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1047390_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Ohtlike ainete sisalduse piirväärtusi pinnases väljendatakse piirarvu ja sihtarvu kaudu ning need esitatakse milligrammides ühe kilogrammi pinnase kuivmassi kohta.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047390_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1047390_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ohtlike ainete sisalduse piirväärtused pinnases on esitatud käesoleva määruse lisas.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047390_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1047390_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Piirarv",
        "@language": "et"
      },
      "estleg:sourceAct": "Ohtlike ainete sisalduse piirväärtused pinnases",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047390_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Piirarv näitab ohtliku aine sellist sisaldust pinnases, millest suurema väärtuse korral loetakse pinnas saastunuks. 2 (2) Ohtlike ainete rühma kuuluvate ainete sisalduse piirarv on selle rühma üksikute ainete summaarne maksimaalne sisaldus pinnases, kui käesoleva määruse lisas ei ole määratud teisiti.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Piirarv näitab ohtliku aine sellist sisaldust pinnases, millest suurema väärtuse korral loetakse pinnas saastunuks. 2 (2) Ohtlike ainete rühma kuuluvate ainete sisalduse piirarv on selle rühma üksikute ainete summaarne maksimaalne sisaldus pinnases, kui käesoleva määruse lisas ei ole määratud teisiti.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1047390_Par_3_Lg_1"
        },
        {
          "@id": "estleg:Reg_1047390_Par_3_Lg_2"
        }
      ],
