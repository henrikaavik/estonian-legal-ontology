      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Loomse paljundusmaterjali pakendi märgistus",
        "@language": "et"
      },
      "estleg:sourceAct": "Loomse paljundusmaterjali märgistamise nõuded",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1052883_Map"
      },
      "estleg:summary": {
        "@value": "Paragrahvis 1 nimetatud loomaliiki kuuluvalt põllumajandusloomalt turustamise eesmärgil kogutud sperma, munarakkude ja embrüote pakendile märgitakse selle paljundusmaterjali kohta järgmised andmed: 1 1) paljundusmaterjali kogumise kuupäev ja aasta; 2 2) põllumajanduslooma nimi ja registreerimise number põllumajandusloomade registris; 3 3) põllumajanduslooma tõug; 4 4) paljundusmaterjali kogumist korraldanud ettevõtte tegevusloa number ning Eestit tähistav kahetäheline kood EE.",
        "@language": "et"
      },
      "estleg:legalText": "Paragrahvis 1 nimetatud loomaliiki kuuluvalt põllumajandusloomalt turustamise eesmärgil kogutud sperma, munarakkude ja embrüote pakendile märgitakse selle paljundusmaterjali kohta järgmised andmed: 1 1) paljundusmaterjali kogumise kuupäev ja aasta; 2 2) põllumajanduslooma nimi ja registreerimise number põllumajandusloomade registris; 3 3) põllumajanduslooma tõug; 4 4) paljundusmaterjali kogumist korraldanud ettevõtte tegevusloa number ning Eestit tähistav kahetäheline kood EE.",
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1052883_Par_2_Lg_1"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1052883_Par_2_v1052883"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1052883_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Paragrahvis 1 nimetatud loomaliiki kuuluvalt põllumajandusloomalt turustamise eesmärgil kogutud sperma, munarakkude ja embrüote pakendile märgitakse selle paljundusmaterjali kohta järgmised andmed: 1) paljundusmaterjali kogumise kuupäev ja aasta; 2) põllumajanduslooma nimi ja registreerimise number põllumajandusloomade registris; 3) põllumajanduslooma tõug; 4) paljundusmaterjali kogumist korraldanud ettevõtte tegevusloa number ning Eestit tähistav kahetäheline kood EE.",
