      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Komisjoni pädevus",
        "@language": "et"
      },
      "estleg:sourceAct": "Rahvusvahelise lapsendamise komisjoni moodustamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_344627_Map"
      },
      "estleg:summary": {
        "@value": "Komisjoni pädevusse kuulub: 1 1) lapse Eestist välisriiki lapsendamise taotluse heakskiitmine; 2 2) lapse välisriigist Eestisse lapsendamise heakskiitmine; 3 3) rahvusvahelises lapsendamises koostööpartnerite heakskiitmine vastavalt Haagi Rahvusvahelise Eraõiguse Konverentsi 1993. a riikidevahelises lapsendamises laste kaitseks tehtava koostöö konventsioonile.",
        "@language": "et"
      },
      "estleg:legalText": "Komisjoni pädevusse kuulub: 1 1) lapse Eestist välisriiki lapsendamise taotluse heakskiitmine; 2 2) lapse välisriigist Eestisse lapsendamise heakskiitmine; 3 3) rahvusvahelises lapsendamises koostööpartnerite heakskiitmine vastavalt Haagi Rahvusvahelise Eraõiguse Konverentsi 1993. a riikidevahelises lapsendamises laste kaitseks tehtava koostöö konventsioonile.",
