      ],
      "estleg:paragrahv": "§ 1<sup>1</sup>.",
      "rdfs:label": {
        "@value": "§ 1<sup>1</sup>. Määruse kohaldamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Käibedeklaratsiooni vorm",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1024828_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Määruse lisa 2 „Vorm KMD INF” 2022. aasta 1. juulil jõustunud redaktsiooni kohaldatakse alates 2022. aasta 1. juulist algavale maksustamisperioodile. RT I 2022-06-28 15 128062022015 2022-07-01 2 (2) Määruse lisa 1 „Vorm KMD” ja lisa 2 „Vorm KMD INF” 2022. aasta 1. augustil jõustunud redaktsiooni kohaldatakse alates 2022. aasta 1. augustist algavatele maksustamisperioodidele. RT I 2022-06-28 15 128062022015 2022-08-01 3 (3) Määruse lisa 1 „Vorm KMD“ ja lisa 2 „Vorm KMD INF“ 2024. aasta 1.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määruse lisa 2 „Vorm KMD INF” 2022. aasta 1. juulil jõustunud redaktsiooni kohaldatakse alates 2022. aasta 1. juulist algavale maksustamisperioodile. RT I 2022-06-28 15 128062022015 2022-07-01 2 (2) Määruse lisa 1 „Vorm KMD” ja lisa 2 „Vorm KMD INF” 2022. aasta 1. augustil jõustunud redaktsiooni kohaldatakse alates 2022. aasta 1. augustist algavatele maksustamisperioodidele. RT I 2022-06-28 15 128062022015 2022-08-01 3 (3) Määruse lisa 1 „Vorm KMD“ ja lisa 2 „Vorm KMD INF“ 2024. aasta 1. jaanuaril jõustunud redaktsiooni kohaldatakse alates 2024. aasta 1. jaanuarist algavatele maksustamisperioodidele. RT I 2023-11-03 2 103112023002 2024-01-01 4 (4) Määruse lisa 1 „Vorm KMD“ ja lisa 2 „Vorm KMD INF“ 2025. aasta 1. jaanuaril jõustunud redaktsiooni kohaldatakse alates 2025. aasta 1. jaanuarist algavatele maksustamisperioodidele. RT I 2024-11-12 1 112112024001 2025-01-01 5 (5) Määruse lisa 1 „Vorm KMD” ja lisa 2 „Vorm KMD INF” 2025. aasta 1. juulil jõustunud redaktsiooni kohaldatakse alates 2025. aasta 1. juulist algavatele maksustamisperioodidele. RT I 2025-05-30 1 130052025001 2025-07-01",
      "estleg:hasVersion": [
