      ]
    },
    {
      "@id": "estleg:Reg_1024828_Par_1_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määruse lisa 2 „Vorm KMD INF” 2022. aasta 1. juulil jõustunud redaktsiooni kohaldatakse alates 2022. aasta 1. juulist algavale maksustamisperioodile.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1024828_Par_1_1"
      },
      "rdfs:label": "§ 1<sup>1</sup> lg 1"
    },
    {
      "@id": "estleg:Reg_1024828_Par_1_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määruse lisa 1 „Vorm KMD” ja lisa 2 „Vorm KMD INF” 2022. aasta 1. augustil jõustunud redaktsiooni kohaldatakse alates 2022. aasta 1. augustist algavatele maksustamisperioodidele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1024828_Par_1_1"
      },
      "rdfs:label": "§ 1<sup>1</sup> lg 2"
    },
    {
      "@id": "estleg:Reg_1024828_Par_1_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Määruse lisa 1 „Vorm KMD“ ja lisa 2 „Vorm KMD INF“ 2024. aasta 1. jaanuaril jõustunud redaktsiooni kohaldatakse alates 2024. aasta 1. jaanuarist algavatele maksustamisperioodidele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1024828_Par_1_1"
      },
      "rdfs:label": "§ 1<sup>1</sup> lg 3"
    },
    {
      "@id": "estleg:Reg_1024828_Par_1_1_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Määruse lisa 1 „Vorm KMD“ ja lisa 2 „Vorm KMD INF“ 2025. aasta 1. jaanuaril jõustunud redaktsiooni kohaldatakse alates 2025. aasta 1. jaanuarist algavatele maksustamisperioodidele.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1024828_Par_1_1"
      },
      "rdfs:label": "§ 1<sup>1</sup> lg 4"
    },
    {
