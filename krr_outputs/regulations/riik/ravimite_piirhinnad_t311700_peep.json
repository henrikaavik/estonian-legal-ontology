    {
      "@id": "estleg:Reg_311700_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_311700"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": "§ 1. Reguleerimisala",
      "estleg:sourceAct": "Ravimite piirhinnad",
      "estleg:summary": "Käesoleva määrusega kehtestatakse kindlustatud isiku ambulatoorseks raviks vajalike ja ravimite loetelusse kantavate ravimite piirhinnad ja toimeaine piirhinnad, mis on toodud käesoleva määruse lisas. Käesoleva määrusega kehtestatakse kindlustatud isiku ambulatoorseks raviks vajalike ja ravimite loetelusse kantavate ravimite piirhinnad ja toimeaine piirhinnad, mis on toodud käesoleva määruse lisas.",
      "estleg:legalText": "Käesoleva määrusega kehtestatakse kindlustatud isiku ambulatoorseks raviks vajalike ja ravimite loetelusse kantavate ravimite piirhinnad ja toimeaine piirhinnad, mis on toodud käesoleva määruse lisas. Käesoleva määrusega kehtestatakse kindlustatud isiku ambulatoorseks raviks vajalike ja ravimite loetelusse kantavate ravimite piirhinnad ja toimeaine piirhinnad, mis on toodud käesoleva määruse lisas.",
      "estleg:targetGroup": [
        "citizen"
      ]
    },
    {
      "@id": "estleg:Reg_311700_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:Regulation_311700"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": "§ 2. Piirhindade lisamine ja muutmine",
      "estleg:sourceAct": "Ravimite piirhinnad",
      "estleg:summary": "Piirhindasid lisatakse ja muudetakse kuni neli korda aastas, jõustumistähtaegadega 1. jaanuaril, 1. aprillil, 1. juulil ja 1. oktoobril. Piirhindasid lisatakse ja muudetakse kuni neli korda aastas, jõustumistähtaegadega 1. jaanuaril, 1. aprillil, 1. juulil ja 1. oktoobril.",
      "estleg:legalText": "Piirhindasid lisatakse ja muudetakse kuni neli korda aastas, jõustumistähtaegadega 1. jaanuaril, 1. aprillil, 1. juulil ja 1. oktoobril. Piirhindasid lisatakse ja muudetakse kuni neli korda aastas, jõustumistähtaegadega 1. jaanuaril, 1. aprillil, 1. juulil ja 1. oktoobril."
    },
