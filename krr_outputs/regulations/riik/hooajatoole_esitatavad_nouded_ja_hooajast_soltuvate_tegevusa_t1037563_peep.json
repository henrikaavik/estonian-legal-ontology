      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Hooajast sõltuvate tegevusalade loetelu",
        "@language": "et"
      },
      "estleg:sourceAct": "Hooajatööle esitatavad nõuded ja hooajast sõltuvate tegevusalade loetelu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1037563_Map"
      },
      "estleg:summary": {
        "@value": "Loetelu hooajast sõltuvatest tegevusaladest, millel töötamiseks võib registreerida välismaalase lühiajalise Eestis töötamise välismaalaste seaduse § 106 lõike 10 alusel, kehtestatakse määruse lisas Eesti majanduse tegevusalade klassifikaatori (EMTAK) kohaselt.",
        "@language": "et"
      },
      "estleg:legalText": "Loetelu hooajast sõltuvatest tegevusaladest, millel töötamiseks võib registreerida välismaalase lühiajalise Eestis töötamise välismaalaste seaduse § 106 lõike 10 alusel, kehtestatakse määruse lisas Eesti majanduse tegevusalade klassifikaatori (EMTAK) kohaselt.",
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
