        "@id": "estleg:Reg_1037563_Map"
      },
      "estleg:summary": {
        "@value": "Hooajatöö peab olema seotud kindla ajaga aastas, mil nõudlus tööjõu järele on hooaja tõttu märkimisväärselt suurem kui muul ajal.",
        "@language": "et"
      },
      "estleg:legalText": "Hooajatöö peab olema seotud kindla ajaga aastas, mil nõudlus tööjõu järele on hooaja tõttu märkimisväärselt suurem kui muul ajal.",
