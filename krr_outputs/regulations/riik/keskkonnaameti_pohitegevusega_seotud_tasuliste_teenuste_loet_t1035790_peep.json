      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Tasuliste teenuste loetelu",
        "@language": "et"
      },
      "estleg:sourceAct": "Keskkonnaameti põhitegevusega seotud tasuliste teenuste loetelu ja tasumäärad",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1035790_Map"
      },
      "estleg:summary": {
        "@value": "Keskkonnaameti põhitegevusega seotud tasulised teenused on: 1 1) kiirgustaseme mõõtmine; 2 2) väga väikese, väikese ja mõõduka ohuga kiirgustegevuse kiirgusohutushinnangu koostamine ning kiirgusvarjestuse arvutamine; RT I 2025-07-23 1 123072025001 2025-07-26 3 3) termoluminestsentsdosimeetri mõõtmine isikudoosi määramiseks; RT I 2020-06-30 1 130062020001 2020-09-01 4 4) aine radioaktiivsuse laboratoorne analüüs; 5 5) radoonisisalduse mõõtmine ruumide õhus.",
        "@language": "et"
      },
      "estleg:legalText": "Keskkonnaameti põhitegevusega seotud tasulised teenused on: 1 1) kiirgustaseme mõõtmine; 2 2) väga väikese, väikese ja mõõduka ohuga kiirgustegevuse kiirgusohutushinnangu koostamine ning kiirgusvarjestuse arvutamine; RT I 2025-07-23 1 123072025001 2025-07-26 3 3) termoluminestsentsdosimeetri mõõtmine isikudoosi määramiseks; RT I 2020-06-30 1 130062020001 2020-09-01 4 4) aine radioaktiivsuse laboratoorne analüüs; 5 5) radoonisisalduse mõõtmine ruumide õhus.",
      "estleg:targetGroup": [
