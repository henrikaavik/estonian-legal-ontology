    },
    {
      "@id": "estleg:Reg_316635_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse riigisaladusele juurdepääsu õigust või selle kehtivuse pikendamist taotlevale isikule (edaspidi isik) julgeolekukontrolli käigus vajadusel tehtava psühhiaatrilise läbivaatuse (edaspidi läbivaatus) ja psühhiaatri järeldusotsuse vormistamise kord.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_316635_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:targetGroup": [
