      "estleg:sourceAct": "Julgeolekukontrolli teostamisel psühhiaatri tehtava läbivaatuse ja järeldusotsuse vormistamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_316635_Map"
      },
      "estleg:summary": {
        "@value": "Määrusega kehtestatakse riigisaladusele juurdepääsu õigust või selle kehtivuse pikendamist taotlevale isikule (edaspidi isik) julgeolekukontrolli käigus vajadusel tehtava psühhiaatrilise läbivaatuse (edaspidi läbivaatus) ja psühhiaatri järeldusotsuse vormistamise kord.",
        "@language": "et"
      },
      "estleg:legalText": "Määrusega kehtestatakse riigisaladusele juurdepääsu õigust või selle kehtivuse pikendamist taotlevale isikule (edaspidi isik) julgeolekukontrolli käigus vajadusel tehtava psühhiaatrilise läbivaatuse (edaspidi läbivaatus) ja psühhiaatri järeldusotsuse vormistamise kord.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
