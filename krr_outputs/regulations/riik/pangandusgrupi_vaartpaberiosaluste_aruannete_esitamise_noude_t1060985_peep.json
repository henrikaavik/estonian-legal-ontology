    {
      "@id": "estleg:Reg_1060985_Par_5",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 5.",
      "rdfs:label": {
        "@value": "§ 5. Aruannete esitamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pangandusgrupi väärtpaberiosaluste aruannete esitamise nõuded",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060985_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Aruanded esitatakse Eesti Pangale elektrooniliselt XML-is (eXtensible Markup Language) vormindatud dokumentidena Eesti Panga presidendi 29. mai 2018. aasta määruse nr 4 „Aruannete elektroonilise esitamise nõuded” (RT I, 05.06.2018, 1) kohaselt. 2 (2) Pärast vigade tuvastamist või arvestuspõhimõtete muutmist esitatakse elektrooniliselt uued korrigeeritud aruanded. 3 (3) Aruannetes esitatav tekst ja tunnused ei või sisaldada järgmiseid sümboleid: >, <, &, ', \".",
        "@language": "et"
      },
