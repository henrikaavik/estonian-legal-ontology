    {
      "@id": "estleg:Reg_1060985_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Aruanded ja nende koostamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Pangandusgrupi väärtpaberiosaluste aruannete esitamise nõuded",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1060985_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Pangandusgrupid on kohustatud koostama ja Eesti Pangale esitama järgmised aruanded: 1 1) ISIN-koodita väärtpaberite aruanne koodiga 2230 (lisa 1); 2 2) väärtpaberite grupipõhine aruanne koodiga 2231 (lisa 2); 3 3) väärtpaberite üksusepõhine aruanne koodiga 2232 (lisa 3). 2 (2) Aruannete koostamisel tuleb lähtuda Euroopa Keskpanga määruse (EL) nr 1011/2012 artiklis 3a sätestatud nõuetest.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Pangandusgrupid on kohustatud koostama ja Eesti Pangale esitama järgmised aruanded: 1 1) ISIN-koodita väärtpaberite aruanne koodiga 2230 (lisa 1); 2 2) väärtpaberite grupipõhine aruanne koodiga 2231 (lisa 2); 3 3) väärtpaberite üksusepõhine aruanne koodiga 2232 (lisa 3). 2 (2) Aruannete koostamisel tuleb lähtuda Euroopa Keskpanga määruse (EL) nr 1011/2012 artiklis 3a sätestatud nõuetest. 3 (3) Määruse lisades 1–3 kasutatakse mõisteid Euroopa Keskpanga määruse (EL) nr 1011/2012 lisa 2 tähenduses. 4 (4) Määruse lisas 1 nimetatud aruande koostamisel tuleb emitendi institutsionaalse sektori määratlemisel lähtuda Euroopa Parlamendi ja nõukogu määruse (EL) nr 549/2013 Euroopa Liidus kasutatava Euroopa rahvamajanduse ja regionaalse arvepidamise süsteemi kohta (ELT L 174, 26.06.2013, lk 1–727) lisa A peatükis 2 sätestatud definitsioonidest.",
      "estleg:assertionConfidence": {
