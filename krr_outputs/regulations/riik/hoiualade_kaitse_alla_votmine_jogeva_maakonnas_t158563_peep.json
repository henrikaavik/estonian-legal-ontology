      "rdfs:label": {
        "@value": "§ 1. Jõgeva maakonnas kaitse alla võetavad hoiualad ja kaitse alla võtmise eesmärk",
        "@language": "et"
      },
      "estleg:sourceAct": "Hoiualade kaitse alla võtmine Jõgeva maakonnas",
      "estleg:partOfAct": {
