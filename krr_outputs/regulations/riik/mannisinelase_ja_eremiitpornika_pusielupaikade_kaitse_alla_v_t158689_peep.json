        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Püsielupaigas on lubatud sõidukiga sõitmine teedel või radadel. Väljaspool teid ja radu on sõidukiga või maastikusõidukiga sõitmine keelatud, välja arvatud järelevalve- ja päästetööl ning selle kaitse-eeskirjaga lubatud töö ja valitsemisega seotud töö tegemisel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_158689_Par_4"
      },
      "rdfs:label": "§ 4 lg 3",
      "estleg:assertionConfidence": {
