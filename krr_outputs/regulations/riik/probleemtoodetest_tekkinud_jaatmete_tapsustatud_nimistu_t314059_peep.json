    {
      "@id": "estleg:Reg_314059_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Rakendussätted",
        "@language": "et"
      },
      "estleg:sourceAct": "Probleemtoodetest tekkinud jäätmete täpsustatud nimistu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_314059_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Jäätmeseaduse § 117 märgitud jäätmearuandele, mis käsitleb aruande esitaja jäätmealast tegevust 2018. kalendriaastal ja mis esitatakse Keskkonnaametile hiljemalt 2019. aasta 31. jaanuariks, kohaldatakse kuni 2018. aasta 31. detsembrini kehtinud määrust. 2 (2) Keskkonnaamet viib enne 2019 aasta 1. jaanuari antud keskkonnaload vastavusse käesoleva määruse lisas sätestatud nimistuga hiljemalt 2019. aasta 31. detsembriks. RT I 2018-12-14 1 114122018001 2019-01-01",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Jäätmeseaduse § 117 märgitud jäätmearuandele, mis käsitleb aruande esitaja jäätmealast tegevust 2018. kalendriaastal ja mis esitatakse Keskkonnaametile hiljemalt 2019. aasta 31. jaanuariks, kohaldatakse kuni 2018. aasta 31. detsembrini kehtinud määrust. 2 (2) Keskkonnaamet viib enne 2019 aasta 1. jaanuari antud keskkonnaload vastavusse käesoleva määruse lisas sätestatud nimistuga hiljemalt 2019. aasta 31. detsembriks. RT I 2018-12-14 1 114122018001 2019-01-01",
