    {
      "@id": "estleg:Reg_346612_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Määr arvutatakse käesoleva määruse lisas esitatud baasvõrrandi või lihtsustatud valemi alusel.",
