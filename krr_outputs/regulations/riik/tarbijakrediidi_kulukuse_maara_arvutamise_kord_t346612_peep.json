    },
    {
      "@id": "estleg:Reg_346612_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Määra arvutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Tarbijakrediidi kulukuse määra arvutamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346612_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Määra arvutamine põhineb eeldusel, et tarbijakrediidileping (edaspidi krediidileping) jääb kehtima kokkulepitud tähtaja jooksul ning et krediidiandja ja tarbija täidavad oma kohustusi krediidilepingus kokku lepitud tingimustel ja tähtaegadel. 2 (2) Krediidi alguskuupäevaks loetakse esimese krediidisumma kasutusele võtmise kuupäev. 3 (3) Arvutustes kasutatavaid ajavahemikke väljendatakse täis- või osaaastates.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määra arvutamine põhineb eeldusel, et tarbijakrediidileping (edaspidi krediidileping) jääb kehtima kokkulepitud tähtaja jooksul ning et krediidiandja ja tarbija täidavad oma kohustusi krediidilepingus kokku lepitud tingimustel ja tähtaegadel. 2 (2) Krediidi alguskuupäevaks loetakse esimese krediidisumma kasutusele võtmise kuupäev. 3 (3) Arvutustes kasutatavaid ajavahemikke väljendatakse täis- või osaaastates. Aasta pikkus on 365 päeva (liigaastal 366 päeva), 52 nädalat või kaksteist võrdset kuud. Võrdses kuus on 30,41666 päeva (ehk 365/12) ka juhul, kui tegemist on liigaastaga. 3 (3<sup>1</sup>) Kui lõikes 3 nimetatud arvutustes kasutatavaid ajavahemikke ei ole võimalik väljendada täisnädalates, -kuudes või -aastates, väljendatakse ajavahemik kohaldades ühte või mitut järgmist: 1 1) võetakse arvesse kõik päevad, sealhulgas nädalavahetused ja pühad; 2 2) võrdsed perioodid koos päevadega loendatakse eest tahapoole kuni kasutusele võetud krediidi esimese väljamakse kuupäevani; 3 3) päevadest koosneva perioodi pikkuse saamiseks jäetakse esimene päev välja ja viimane päev arvatakse sisse ning perioodi pikkus väljendatakse aastates, jagades kõnealuse perioodi täisaasta päevade arvuga (365 või 366 päeva), loendades eest tahapoole alates viimasest päevast kuni eelneva aasta sama päevani. RT I 2021-07-20 4 120072021004 2021-07-23 4 (4) Arvutuse tulemus esitatakse protsentides, ümardatuna vähemalt ühe kümnendkohani.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_346612_Par_3_Lg_1"
        },
        {
          "@id": "estleg:Reg_346612_Par_3_Lg_2"
        },
        {
          "@id": "estleg:Reg_346612_Par_3_Lg_3"
        },
        {
          "@id": "estleg:Reg_346612_Par_3_Lg_3_1"
        },
        {
          "@id": "estleg:Reg_346612_Par_3_Lg_4"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_346612_Par_3_v346612"
        }
      ]
    },
    {
      "@id": "estleg:Reg_346612_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määra arvutamine põhineb eeldusel, et tarbijakrediidileping (edaspidi krediidileping) jääb kehtima kokkulepitud tähtaja jooksul ning et krediidiandja ja tarbija täidavad oma kohustusi krediidilepingus kokku lepitud tingimustel ja tähtaegadel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_346612_Par_3"
      },
      "rdfs:label": "§ 3 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      }
    },
    {
      "@id": "estleg:Reg_346612_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Krediidi alguskuupäevaks loetakse esimese krediidisumma kasutusele võtmise kuupäev.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_346612_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_346612_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Arvutustes kasutatavaid ajavahemikke väljendatakse täis- või osaaastates. Aasta pikkus on 365 päeva (liigaastal 366 päeva), 52 nädalat või kaksteist võrdset kuud. Võrdses kuus on 30,41666 päeva (ehk 365/12) ka juhul, kui tegemist on liigaastaga.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_346612_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
    {
      "@id": "estleg:Reg_346612_Par_3_Lg_3_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3¹",
      "estleg:legalText": "(3¹) Kui lõikes 3 nimetatud arvutustes kasutatavaid ajavahemikke ei ole võimalik väljendada täisnädalates, -kuudes või -aastates, väljendatakse ajavahemik kohaldades ühte või mitut järgmist: 1) võetakse arvesse kõik päevad, sealhulgas nädalavahetused ja pühad; 2) võrdsed perioodid koos päevadega loendatakse eest tahapoole kuni kasutusele võetud krediidi esimese väljamakse kuupäevani; 3) päevadest koosneva perioodi pikkuse saamiseks jäetakse esimene päev välja ja viimane päev arvatakse sisse ning perioodi pikkus väljendatakse aastates, jagades kõnealuse perioodi täisaasta päevade arvuga (365 või 366 päeva), loendades eest tahapoole alates viimasest päevast kuni eelneva aasta sama päevani.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_346612_Par_3"
      },
      "rdfs:label": "§ 3 lg 3¹",
      "estleg:itemNumber": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "@id": "estleg:Reg_346612_Par_3_Lg_4",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "4",
      "estleg:legalText": "(4) Arvutuse tulemus esitatakse protsentides, ümardatuna vähemalt ühe kümnendkohani.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_346612_Par_3"
      },
      "rdfs:label": "§ 3 lg 4"
    },
