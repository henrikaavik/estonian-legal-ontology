      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Määra arvutamise baasvõrrand",
        "@language": "et"
      },
      "estleg:sourceAct": "Tarbijakrediidi kulukuse määra arvutamise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_346612_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Määra arvutamise baasvõrrand väljendab tarbija kasutusse võetud krediidi ajatatud kogusumma, mis on krediidiandja ja tarbija vahel kokku lepitud, ning krediidi tagasimaksete ja krediidiga seotud kulude nüüdisväärtuste võrdust. 2 (2) Määr arvutatakse käesoleva määruse lisas esitatud baasvõrrandi või lihtsustatud valemi alusel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Määra arvutamise baasvõrrand väljendab tarbija kasutusse võetud krediidi ajatatud kogusumma, mis on krediidiandja ja tarbija vahel kokku lepitud, ning krediidi tagasimaksete ja krediidiga seotud kulude nüüdisväärtuste võrdust. 2 (2) Määr arvutatakse käesoleva määruse lisas esitatud baasvõrrandi või lihtsustatud valemi alusel.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
