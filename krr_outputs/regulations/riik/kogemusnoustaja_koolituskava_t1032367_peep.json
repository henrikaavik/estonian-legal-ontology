    },
    {
      "@id": "estleg:Reg_1032367_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Täiendavad õppekava nõuded",
        "@language": "et"
      },
      "estleg:sourceAct": "Kogemusnõustaja koolituskava",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032367_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kogemusnõustaja koolituskava õppekavarühmaks on sotsiaaltöö ja nõustamine. 2 (2) Koolituse lõpetamise tingimused on: 1 1) kirjaliku või suulise lõputöö õigeaegne esitamine või sooritamine; 2 2) koolitaja positiivne kirjalik hinnang õppetööle, praktikale ja lõputööle; 3 3) praktika juhendaja positiivne kirjalik hinnang praktikale. RT I 2018-07-10 2 110072018002 2019-01-01 2 (2<sup>1</sup>) Koolituse lõpetamisel väljastatakse isikule tunnistus.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kogemusnõustaja koolituskava õppekavarühmaks on sotsiaaltöö ja nõustamine. 2 (2) Koolituse lõpetamise tingimused on: 1 1) kirjaliku või suulise lõputöö õigeaegne esitamine või sooritamine; 2 2) koolitaja positiivne kirjalik hinnang õppetööle, praktikale ja lõputööle; 3 3) praktika juhendaja positiivne kirjalik hinnang praktikale. RT I 2018-07-10 2 110072018002 2019-01-01 2 (2<sup>1</sup>) Koolituse lõpetamisel väljastatakse isikule tunnistus. RT I 2018-07-10 2 110072018002 2019-01-01 3 (3) Õpet läbi viivatest õppejõududest vähemalt ühel peab olema psühholoogia, sotsiaaltöö või eripedagoogika alane kõrgharidus. 4 (4) Sotsiaalkindlustusametil on õigus hinnata ja tunnustada varem läbitud õpinguid ning nende vastavust määrusega kehtestatud koolituskava nõuetele. RT I 2018-07-10 2 110072018002 2019-01-01",
