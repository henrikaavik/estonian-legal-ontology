        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Saku valla ja Kiili valla piiri muutmine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haldusüksuste piiride muutmine Saku vallas ja Kiili vallas territooriumiosa üleandmisega",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047213_Map"
      },
      "estleg:summary": {
        "@value": "Harju maakonnas asuva Saku valla ja Kiili valla piiri muudetakse järgmiselt: 1 1) Saku valla Tammejärve küla territooriumiosa antakse Kiili valla Kangru aleviku ja Luige aleviku koosseisu ja Kiili valla Luige aleviku territooriumiosa antakse Saku valla Männiku küla koosseisu vastavalt lisale 1; 2 2) Kiili valla Sausti küla territooriumiosa antakse Saku valla Saustinõmme küla koosseisu vastavalt lisale 2; 3 3) Saku valla Tagadi küla territooriumiosa antakse Kiili valla Kurevere küla koosseisu…",
        "@language": "et"
      },
      "estleg:legalText": "Harju maakonnas asuva Saku valla ja Kiili valla piiri muudetakse järgmiselt: 1 1) Saku valla Tammejärve küla territooriumiosa antakse Kiili valla Kangru aleviku ja Luige aleviku koosseisu ja Kiili valla Luige aleviku territooriumiosa antakse Saku valla Männiku küla koosseisu vastavalt lisale 1; 2 2) Kiili valla Sausti küla territooriumiosa antakse Saku valla Saustinõmme küla koosseisu vastavalt lisale 2; 3 3) Saku valla Tagadi küla territooriumiosa antakse Kiili valla Kurevere küla koosseisu vastavalt lisale 3.",
      "estleg:semanticallySimilarTo": [
        {
          "@id": "estleg:Reg_1060033_Par_1"
        }
      ],
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1047213_Par_1_v1047213"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1047213_Par_1_Lg_1"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1047213_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Harju maakonnas asuva Saku valla ja Kiili valla piiri muudetakse järgmiselt: 1) Saku valla Tammejärve küla territooriumiosa antakse Kiili valla Kangru aleviku ja Luige aleviku koosseisu ja Kiili valla Luige aleviku territooriumiosa antakse Saku valla Männiku küla koosseisu vastavalt lisale 1; 2) Kiili valla Sausti küla territooriumiosa antakse Saku valla Saustinõmme küla koosseisu vastavalt lisale 2; 3) Saku valla Tagadi küla territooriumiosa antakse Kiili valla Kurevere küla koosseisu vastavalt lisale 3.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1047213_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:itemNumber": [
