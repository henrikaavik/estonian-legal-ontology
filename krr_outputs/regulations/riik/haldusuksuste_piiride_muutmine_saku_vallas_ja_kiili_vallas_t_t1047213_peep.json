      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Haldusüksuse piiri kaardistamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Haldusüksuste piiride muutmine Saku vallas ja Kiili vallas territooriumiosa üleandmisega",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1047213_Map"
      },
      "estleg:summary": {
        "@value": "Maa-amet kannab §-s 1 sätestatud haldusüksuste piiride muudatused riigi maakatastri kaardile vastavalt määruse lisadele 1–3.",
        "@language": "et"
      },
      "estleg:legalText": "Maa-amet kannab §-s 1 sätestatud haldusüksuste piiride muudatused riigi maakatastri kaardile vastavalt määruse lisadele 1–3.",
