      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Nõuded raadioseadme juhtmega laadijale",
        "@language": "et"
      },
      "estleg:sourceAct": "Olulised nõuded raadioseadmetele eesmärgiga tagada raadioseadme koostalitlusvõime lisatarvikutega",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1057201_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Raadioseadme juhtmega laadija peab vastama määruse lisas sätestatud nõuetele. 2 (2) Määruses sätestatud nõudeid kohaldatakse järgmisse klassi kuuluvatele raadioseadmetele: 1 1) mobiiltelefon; 2 2) tahvelarvuti; 3 3) digikaamera; 4 4) kõrvaklapid; 5 5) kõneklapid; 6 6) käeshoitav mängukonsool; 7 7) kaasaskantav kõlar; 8 8) e-luger; 9 9) klaviatuur; 10 10) hiir; 11 11) kaasaskantav navigatsioonisüsteem; 12 12) nööpkõrvaklapid; 13 13) sülearvuti.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Raadioseadme juhtmega laadija peab vastama määruse lisas sätestatud nõuetele. 2 (2) Määruses sätestatud nõudeid kohaldatakse järgmisse klassi kuuluvatele raadioseadmetele: 1 1) mobiiltelefon; 2 2) tahvelarvuti; 3 3) digikaamera; 4 4) kõrvaklapid; 5 5) kõneklapid; 6 6) käeshoitav mängukonsool; 7 7) kaasaskantav kõlar; 8 8) e-luger; 9 9) klaviatuur; 10 10) hiir; 11 11) kaasaskantav navigatsioonisüsteem; 12 12) nööpkõrvaklapid; 13 13) sülearvuti.",
