        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Ehitisele määratakse kasutamise otstarve viie koodikoha täpsusega.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1029764_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
    {
