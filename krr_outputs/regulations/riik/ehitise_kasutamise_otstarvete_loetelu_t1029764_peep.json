      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Määruse rakendamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Ehitise kasutamise otstarvete loetelu",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1029764_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Ehitisele enne 2013. aasta 1. jaanuari määratud kasutamise otstarvet ei pea viima käesoleva määrusega kooskõlla. 2 (2) Enne 2013. aasta 1. jaanuari määratud ehitise kasutamise otstarve viiakse ehitisregistris käesoleva määrusega kooskõlla ehitus- või kasutusteatise esitamisel või ehitus- või kasutusloa andmisel.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Ehitisele enne 2013. aasta 1. jaanuari määratud kasutamise otstarvet ei pea viima käesoleva määrusega kooskõlla. 2 (2) Enne 2013. aasta 1. jaanuari määratud ehitise kasutamise otstarve viiakse ehitisregistris käesoleva määrusega kooskõlla ehitus- või kasutusteatise esitamisel või ehitus- või kasutusloa andmisel.",
