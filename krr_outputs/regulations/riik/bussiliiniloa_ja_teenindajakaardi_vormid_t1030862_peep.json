        }
      ]
    },
    {
      "@id": "estleg:Reg_1030862_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Riigisisese bussiveo liiniloa vorm kehtestatakse vastavalt lisale 1.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1030862_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1030862_Par_1_Lg_1_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1¹",
      "estleg:legalText": "(1¹) Kui lõikes 1 nimetatud liiniluba väljastatakse paberil, kantakse andmed A4 formaadis valgele paberile grammkaaluga 100 g/m² või rohkem. Turvaelemendina kasutatakse paberil väikse riigivapi kujutist ja plangi kordumatut numbrit.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1030862_Par_1"
      },
      "rdfs:label": "§ 1 lg 1¹"
    },
    {
      "@id": "estleg:Reg_1030862_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Rahvusvahelise bussiliini, mille alg- või lõpp-punkt või vahepeatus asub väljaspool Euroopa Liidu liikmesriike, loa vorm kehtestatakse vastavalt lisale 2.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1030862_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1030862_Par_1_Lg_2_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2¹",
      "estleg:legalText": "(2¹) Lõikes 2 nimetatud liiniloa väljastamisel kantakse andmed A4 formaadis roosale (Pantone värvikood nr 182) paberile grammkaaluga 100 g/m² või rohkem. Turvaelemendina kasutatakse paberil giljoššmustrit, väikse riigivapi kujutist, ovaalset vesimärki bussi kujutisega ja plangi kordumatut numbrit.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1030862_Par_1"
      },
      "rdfs:label": "§ 1 lg 2¹"
    },
    {
      "@id": "estleg:Reg_1030862_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Teenindajakaardi vorm kehtestatakse vastavalt lisale 3.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1030862_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
