      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Sõjaväelise auastme eraldusmärgi kirjeldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Sõjaväelise auastme eraldusmärgid",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1032206_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Sõjaväelise auastme eraldusmärk näitab isikule antud sõjaväelist auastet. 2 (2) Sõjaväelise auastme eraldusmärgi kujundus arvestab sõjaväelise auastme saanud isiku sõjaväelist väljaõpet lähtuvalt väeliigist. Maaväe ja õhuväe sõjaväelise auastme eraldusmärkide kujundus on sarnane. 3 (3) Sõjaväelise auastme eraldusmärkide kirjeldused on toodud käesoleva määruse lisades 1–4.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Sõjaväelise auastme eraldusmärk näitab isikule antud sõjaväelist auastet. 2 (2) Sõjaväelise auastme eraldusmärgi kujundus arvestab sõjaväelise auastme saanud isiku sõjaväelist väljaõpet lähtuvalt väeliigist. Maaväe ja õhuväe sõjaväelise auastme eraldusmärkide kujundus on sarnane. 3 (3) Sõjaväelise auastme eraldusmärkide kirjeldused on toodud käesoleva määruse lisades 1–4.",
      "estleg:targetGroup": [
