    },
    {
      "@id": "estleg:Reg_1011698_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Määrusega kehtestatakse tegevväelaste sõjaväelise auastmega rahuaja ametikohtade palgaastmestiku palgatasemed ja nendele vastavav palga madalaim, keskmine ja kõrgeim määr.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1011698_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1011698_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Sõjaväelise auastmega rahuaja ametikoha moodustamisel või ümberkujundamisel määratakse lähtuvalt ametikoha ülesannetest ametikohale palgaastmestikus vastav palgatase.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1011698_Par_1"
