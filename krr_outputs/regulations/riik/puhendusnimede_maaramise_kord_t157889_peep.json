    {
      "@id": "estleg:Reg_157889_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Pühendusnimede määramise alused",
        "@language": "et"
      },
      "estleg:sourceAct": "Pühendusnimede määramise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157889_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Isikunime ei või kohale pühendusnimeks määrata selle isiku eluajal. 2 (2) Pühendusnimede määramisel tuleb hoiduda isikunimede hulgalisest kasutamisest riigi, haldusüksuse või asustusüksuse piires. 3 (3) Pühendusnime määramise võib algatada kohanimemääraja või füüsiline või juriidiline isik, kes esitab kirjaliku taotluse pädevale kohanimemäärajale.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Isikunime ei või kohale pühendusnimeks määrata selle isiku eluajal. 2 (2) Pühendusnimede määramisel tuleb hoiduda isikunimede hulgalisest kasutamisest riigi, haldusüksuse või asustusüksuse piires. 3 (3) Pühendusnime määramise võib algatada kohanimemääraja või füüsiline või juriidiline isik, kes esitab kirjaliku taotluse pädevale kohanimemäärajale. 4 (4) Kohanimemääraja teeb otsuse kohale pühendusnime määramise kohta, arvestades asjaomase isiku teeneid kohaliku elu edendamisel, tema seotust selle kohaga, samuti Eesti maa, rahva ja riigiga. 5 (5) Kohanimemääraja võib selgitada enne pühendusnime määramist välja elanike arvamuse. Selle väljaselgitamise otsustamine on kohanimemääraja pädevuses. 6 (6) Elanike arvamuse uuringu tulemustel on kohanimemääraja jaoks soovituslik iseloom.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
