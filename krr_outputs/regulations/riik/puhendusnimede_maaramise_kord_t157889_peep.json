    {
      "@id": "estleg:Reg_157889_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Pühendusnime määramise erisused ametliku kohanime muutmisel",
        "@language": "et"
      },
      "estleg:sourceAct": "Pühendusnimede määramise kord",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_157889_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Juhul, kui pühendusnime määramiseks tahetakse muuta ametlikku kohanime, peab kohanimemääraja välja selgitama vähemalt nende elanike arvamuse, kes muudetava nimega nimeobjekti territooriumil rahvastikuregistri andmetel elavad. 2 (2) Kohanimemääraja esitab vastavalt „Kohanimeseaduse” § 7 lõikele 3 valdkonna eest vastutavale ministrile kohanime muutmise taotluse koos seletuskirjaga, mis sisaldab nime muutmise ja valitud pühendusnime põhjendust ning elanike arvamuse uuringu tulemusi.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Juhul, kui pühendusnime määramiseks tahetakse muuta ametlikku kohanime, peab kohanimemääraja välja selgitama vähemalt nende elanike arvamuse, kes muudetava nimega nimeobjekti territooriumil rahvastikuregistri andmetel elavad. 2 (2) Kohanimemääraja esitab vastavalt „Kohanimeseaduse” § 7 lõikele 3 valdkonna eest vastutavale ministrile kohanime muutmise taotluse koos seletuskirjaga, mis sisaldab nime muutmise ja valitud pühendusnime põhjendust ning elanike arvamuse uuringu tulemusi. RT I 2014-10-14 2 114102014002 2014-10-17 3 (3) Valdkonna eest vastutav minister teeb otsuse pärast kohanimenõukogult arvamuse saamist. RT I 2014-10-14 2 114102014002 2014-10-17",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
