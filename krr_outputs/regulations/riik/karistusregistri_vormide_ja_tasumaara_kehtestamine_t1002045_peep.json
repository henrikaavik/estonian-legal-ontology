          "@id": "estleg:Reg_1002045_Par_1_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1002045_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Karistusregistri registrikaarti peetakse elektrooniliselt e-toimiku süsteemis. Registrikaarte ei väljastata paberil. Registrikaart koosneb „Karistusregistri seaduse” §-des 11 ja 12 sätestatud andmetest.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_1"
      },
      "rdfs:label": "§ 1 lg 1"
    },
    {
      "@id": "estleg:Reg_1002045_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Karistusregister talletab füüsilise isiku kohta määrusega kehtestatud lisas 1 ja juriidilise isiku kohta lisas 2 sätestatud andmed.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_1002045_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Karistuse täitmise andmete esitamise vorm",
        "@language": "et"
      },
      "estleg:sourceAct": "Karistusregistri vormide ja tasumäära kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002045_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kui kohtutäituril, arestimajal, vanglal, kohtul või otsuse teinud või kohtuotsuse täitmist kontrollinud kohtuvälisel menetlejal ei ole võimalik esitada andmeid karistuse täitmise kohta elektrooniliselt e-toimiku süsteemi kaudu, edastatakse andmed karistusregistrile e-posti vahendusel. 2 (2) Karistuse täitmise andmed esitatakse määruse lisas 3 kehtestatud vormil.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui kohtutäituril, arestimajal, vanglal, kohtul või otsuse teinud või kohtuotsuse täitmist kontrollinud kohtuvälisel menetlejal ei ole võimalik esitada andmeid karistuse täitmise kohta elektrooniliselt e-toimiku süsteemi kaudu, edastatakse andmed karistusregistrile e-posti vahendusel. 2 (2) Karistuse täitmise andmed esitatakse määruse lisas 3 kehtestatud vormil.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        },
        {
          "@id": "estleg:TargetGroup_Official"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1002045_Par_2_v1002045"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1002045_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1002045_Par_2_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1002045_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kui kohtutäituril, arestimajal, vanglal, kohtul või otsuse teinud või kohtuotsuse täitmist kontrollinud kohtuvälisel menetlejal ei ole võimalik esitada andmeid karistuse täitmise kohta elektrooniliselt e-toimiku süsteemi kaudu, edastatakse andmed karistusregistrile e-posti vahendusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_2"
      },
      "rdfs:label": "§ 2 lg 1"
    },
    {
      "@id": "estleg:Reg_1002045_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Karistuse täitmise andmed esitatakse määruse lisas 3 kehtestatud vormil.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_2"
      },
      "rdfs:label": "§ 2 lg 2"
    },
    {
      "@id": "estleg:Reg_1002045_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 3.",
      "rdfs:label": {
        "@value": "§ 3. Registriteadete väljastamise kord",
        "@language": "et"
      },
      "estleg:sourceAct": "Karistusregistri vormide ja tasumäära kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002045_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Karistusregistri volitatud töötlejale saab karistusregistri päringu esitada e-toimiku süsteemi, posti ja e-posti vahendusel. 2 (2) Karistusregistri volitatud töötleja kontrollib registriteate andmete korrektsust ja õigsust enne registriteate väljastamist päringu teinud isikule. Registriteate andmed väljastatakse e-toimiku süsteemi, posti või e-posti vahendusel. E-toimiku süsteemi kaudu väljastatud registriteatel ei ole koostaja nime ja seda ei allkirjastata.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Karistusregistri volitatud töötlejale saab karistusregistri päringu esitada e-toimiku süsteemi, posti ja e-posti vahendusel. 2 (2) Karistusregistri volitatud töötleja kontrollib registriteate andmete korrektsust ja õigsust enne registriteate väljastamist päringu teinud isikule. Registriteate andmed väljastatakse e-toimiku süsteemi, posti või e-posti vahendusel. E-toimiku süsteemi kaudu väljastatud registriteatel ei ole koostaja nime ja seda ei allkirjastata. 3 (3) Registriteade esitatakse määruse lisas 4 kehtestatud vormil.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1002045_Par_3_v1002045"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1002045_Par_3_Lg_1"
        },
        {
          "@id": "estleg:Reg_1002045_Par_3_Lg_2"
