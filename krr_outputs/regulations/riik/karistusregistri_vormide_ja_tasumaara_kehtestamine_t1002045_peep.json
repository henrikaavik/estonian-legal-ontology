        {
          "@id": "estleg:Reg_1002045_Par_3_Lg_3"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1002045_Par_3_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Karistusregistri volitatud töötlejale saab karistusregistri päringu esitada e-toimiku süsteemi, posti ja e-posti vahendusel.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_3"
      },
      "rdfs:label": "§ 3 lg 1"
    },
    {
      "@id": "estleg:Reg_1002045_Par_3_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Karistusregistri volitatud töötleja kontrollib registriteate andmete korrektsust ja õigsust enne registriteate väljastamist päringu teinud isikule. Registriteate andmed väljastatakse e-toimiku süsteemi, posti või e-posti vahendusel. E-toimiku süsteemi kaudu väljastatud registriteatel ei ole koostaja nime ja seda ei allkirjastata.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_3"
      },
      "rdfs:label": "§ 3 lg 2"
    },
    {
      "@id": "estleg:Reg_1002045_Par_3_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Registriteade esitatakse määruse lisas 4 kehtestatud vormil.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1002045_Par_3"
      },
      "rdfs:label": "§ 3 lg 3"
    },
