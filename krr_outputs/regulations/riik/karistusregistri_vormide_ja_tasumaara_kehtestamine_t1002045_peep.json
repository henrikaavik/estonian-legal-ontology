    {
      "@id": "estleg:Reg_1002045_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Registrikaardi vorm",
        "@language": "et"
      },
      "estleg:sourceAct": "Karistusregistri vormide ja tasumäära kehtestamine",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1002045_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Karistusregistri registrikaarti peetakse elektrooniliselt e-toimiku süsteemis. Registrikaarte ei väljastata paberil. Registrikaart koosneb „Karistusregistri seaduse” §-des 11 ja 12 sätestatud andmetest. 2 (2) Karistusregister talletab füüsilise isiku kohta määrusega kehtestatud lisas 1 ja juriidilise isiku kohta lisas 2 sätestatud andmed.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Karistusregistri registrikaarti peetakse elektrooniliselt e-toimiku süsteemis. Registrikaarte ei väljastata paberil. Registrikaart koosneb „Karistusregistri seaduse” §-des 11 ja 12 sätestatud andmetest. 2 (2) Karistusregister talletab füüsilise isiku kohta määrusega kehtestatud lisas 1 ja juriidilise isiku kohta lisas 2 sätestatud andmed.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_Citizen"
        },
        {
          "@id": "estleg:TargetGroup_Business"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasVersion": [
