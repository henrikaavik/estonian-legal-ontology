    {
      "@id": "estleg:Reg_1051360_Par_2",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 2.",
      "rdfs:label": {
        "@value": "§ 2. Tuletõrje veevõtukoha ehitusprojektis nõutud andmed",
        "@language": "et"
      },
      "estleg:sourceAct": "Tuletõrje veevõtukoha ehitusprojektile esitatavad nõuded",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1051360_Map"
      },
      "estleg:summary": {
        "@value": "1 (1) Kui tulekustutusvee tagamiseks rajatakse tuletõrje veevõtukoht, peab selleks koostatav ehitusprojekt sisaldama vähemalt järgmist: 1 1) projekteerimisel aluseks võetud nõuded; 2 2) asendiplaan, mis kajastab veevõtukoha katvusala; 3 3) veevõtukoha tüüp ning selle tehniline ja hüdrauliline lahendus; 4 4) veeallikas ja selle tehniline lahendus; 5 5) veevooluhulk veevõtukohas; 6 6) tuletõrje veevõtukoha korrashoiu kirjeldus, välja arvatud ühisveevärgil asuva tuletõrje veevõtukoha korral.",
        "@language": "et"
      },
      "estleg:legalText": "1 (1) Kui tulekustutusvee tagamiseks rajatakse tuletõrje veevõtukoht, peab selleks koostatav ehitusprojekt sisaldama vähemalt järgmist: 1 1) projekteerimisel aluseks võetud nõuded; 2 2) asendiplaan, mis kajastab veevõtukoha katvusala; 3 3) veevõtukoha tüüp ning selle tehniline ja hüdrauliline lahendus; 4 4) veeallikas ja selle tehniline lahendus; 5 5) veevooluhulk veevõtukohas; 6 6) tuletõrje veevõtukoha korrashoiu kirjeldus, välja arvatud ühisveevärgil asuva tuletõrje veevõtukoha korral. 2 (2) Ehitusprojekt peab olema koostatud ja vormistatud ning esitatud viisil, mis võimaldab kontrollida projektlahenduse vastavust tuleohutuse seaduse § 24 lõike 4 alusel kehtestatud nõuetele.",
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:assertionConfidence": {
        "@value": "0.70",
        "@type": "xsd:decimal"
      },
      "estleg:hasVersion": [
        {
          "@id": "estleg:Reg_1051360_Par_2_v1051360"
        }
      ],
      "estleg:hasSubsection": [
        {
          "@id": "estleg:Reg_1051360_Par_2_Lg_1"
        },
        {
          "@id": "estleg:Reg_1051360_Par_2_Lg_2"
        }
      ]
    },
    {
      "@id": "estleg:Reg_1051360_Par_2_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Kui tulekustutusvee tagamiseks rajatakse tuletõrje veevõtukoht, peab selleks koostatav ehitusprojekt sisaldama vähemalt järgmist: 1) projekteerimisel aluseks võetud nõuded; 2) asendiplaan, mis kajastab veevõtukoha katvusala; 3) veevõtukoha tüüp ning selle tehniline ja hüdrauliline lahendus; 4) veeallikas ja selle tehniline lahendus; 5) veevooluhulk veevõtukohas; 6) tuletõrje veevõtukoha korrashoiu kirjeldus, välja arvatud ühisveevärgil asuva tuletõrje veevõtukoha korral.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1051360_Par_2"
      },
      "rdfs:label": "§ 2 lg 1",
      "estleg:itemNumber": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    },
    {
      "@id": "estleg:Reg_1051360_Par_2_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Ehitusprojekt peab olema koostatud ja vormistatud ning esitatud viisil, mis võimaldab kontrollida projektlahenduse vastavust tuleohutuse seaduse § 24 lõike 4 alusel kehtestatud nõuetele.",
