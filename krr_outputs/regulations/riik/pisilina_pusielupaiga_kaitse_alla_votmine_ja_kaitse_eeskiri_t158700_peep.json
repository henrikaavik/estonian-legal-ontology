        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Püsielupaigas on lubatud: 1) inimeste viibimine; 2) marjade, seente ja muude metsa kõrvalsaaduste varumine; 3) jahipidamine; 4) sõidukiga ja maastikusõidukiga sõitmine teedel.",
      "estleg:parentProvision": {
