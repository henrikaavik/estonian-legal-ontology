      ],
      "estleg:paragrahv": "§ 4.",
      "rdfs:label": {
        "@value": "§ 4. Kaitsekord",
        "@language": "et"
      },
      "estleg:sourceAct": "Pisilina püsielupaiga kaitse alla võtmine ja kaitse-eeskiri",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_158700_Map"
      },
      "estleg:summary": {
        "@value": "1(1)Pisilina püsielupaiga maa-ala kuulub sihtkaitsevööndisse. 2(2)Püsielupaigas kehtib «Looduskaitseseadusega» sätestatud kaitsekord selle määruse erisustega. 3(3)Püsielupaigas on lubatud:11)inimeste viibimine;22)marjade, seente ja muude metsa kõrvalsaaduste varumine;33)jahipidamine;44)sõidukiga ja maastikusõidukiga sõitmine teedel. 4(4)Püsielupaiga valitseja nõusolekul on lubatud:11)sõidukiga ja maastikusõidukiga sõitmine väljaspool teid;22)olemasolevate maaparandussüsteemide hoiutööd ja…",
        "@language": "et"
      },
      "estleg:legalText": "1(1)Pisilina püsielupaiga maa-ala kuulub sihtkaitsevööndisse. 2(2)Püsielupaigas kehtib «Looduskaitseseadusega» sätestatud kaitsekord selle määruse erisustega. 3(3)Püsielupaigas on lubatud:11)inimeste viibimine;22)marjade, seente ja muude metsa kõrvalsaaduste varumine;33)jahipidamine;44)sõidukiga ja maastikusõidukiga sõitmine teedel. 4(4)Püsielupaiga valitseja nõusolekul on lubatud:11)sõidukiga ja maastikusõidukiga sõitmine väljaspool teid;22)olemasolevate maaparandussüsteemide hoiutööd ja veerežiimi taastamine;33)olemasolevate tehnovõrgu rajatiste hooldustööd;44)pinnase koorimine ja kobestamine ning konkurenttaimede eelmaldamine, samuti puu- ja põõsarinde kujundamine ja harvendamine kuni mõlema rinde liituvuseni 0,4.<p>____________________<br/><sup>1</sup> «Looduskaitseseaduse» § 53 lõike 2 alusel ei avaldata «Riigi Teatajas» püsielupaikade kaarte, nendega saab tutvuda Keskkonnaministeeriumis või Keskkonnaametis.<br/> [<a href=\"./13126723\">RTL 2009, 11, 131</a> – jõust. 1.02.2009] </p>",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
