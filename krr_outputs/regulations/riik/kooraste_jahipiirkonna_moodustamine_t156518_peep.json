        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Kooraste jahipiirkonna piirikirjeldus on järgmine:",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_156518_Par_1"
      },
      "rdfs:label": "§ 1 lg 2"
    },
    {
      "@id": "estleg:Reg_156518_Par_1_Lg_3",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "3",
      "estleg:legalText": "(3) Kooraste jahipiirkonna piir läheb Otepää–Kanepi maantee ning Valga ja Põlva maakonna vahelise piiri ristumiskohast mööda Otepää–Kanepi maanteed Jõksi teeristini, jätkudes mööda Jõksi–Kooraste maanteed Sillaotsani; sealt mööda Kooraste–Sulbi maanteed Alopi oja sillani; edasi mööda Alopi oja Võhandu jõeni ning mööda Võhandu jõge Kanepi–Urvaste maanteeni; siitpeale mööda Kanepi–Urvaste maanteed Ruhingu teeristini, jätkudes mööda Ruhingu–Koigu maanteed Koiguni; edasi mööda Koigu–Kooraste maanteed Valga ja Põlva maakonna vahelise piirini ning mööda maakondadevahelist piiri Otepää–Kanepi maanteeni.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_156518_Par_1"
      },
      "rdfs:label": "§ 1 lg 3"
    },
