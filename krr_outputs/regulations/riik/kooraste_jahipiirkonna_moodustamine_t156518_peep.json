      "rdfs:label": {
        "@value": "§ 1. Kooraste jahipiirkonna pindala ja piirikirjeldus",
        "@language": "et"
      },
      "estleg:sourceAct": "Kooraste jahipiirkonna moodustamine",
      "estleg:partOfAct": {
