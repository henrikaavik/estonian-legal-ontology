        }
      ]
    },
    {
      "@id": "estleg:Reg_1039196_Par_6_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordiettevõtte poolt riigipiiri ületavale reisile pileti reserveerimist ja reisija registreerimist reisile.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_1039196_Par_6"
      },
      "rdfs:label": "§ 6 lg 1"
