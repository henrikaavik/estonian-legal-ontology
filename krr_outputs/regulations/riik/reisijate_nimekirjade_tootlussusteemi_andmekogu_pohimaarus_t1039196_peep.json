      ],
      "estleg:paragrahv": "§ 6.",
      "rdfs:label": {
        "@value": "§ 6. Andmeobjekt",
        "@language": "et"
      },
      "estleg:sourceAct": "Reisijate nimekirjade töötlussüsteemi andmekogu põhimäärus",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1039196_Map"
      },
      "estleg:summary": {
        "@value": "Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordiettevõtte poolt riigipiiri ületavale reisile pileti reserveerimist ja reisija registreerimist reisile.",
        "@language": "et"
      },
      "estleg:legalText": "Andmeobjekt, mille kohta andmekogus andmeid töödeldakse, on sündmus. Sündmuseks loetakse transpordiettevõtte poolt riigipiiri ületavale reisile pileti reserveerimist ja reisija registreerimist reisile.",
      "estleg:semanticallySimilarTo": [
        {
          "@id": "estleg:Reg_1039220_Par_6"
        },
        {
          "@id": "estleg:Reg_1039254_Par_4"
        }
      ],
      "estleg:hasVersion": [
