    {
      "@id": "estleg:Reg_331436_Par_1_Lg_1",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "1",
      "estleg:legalText": "(1) Vabariigi Valitsuse 9. märtsi 2004. a määruses nr 62 «Kalalaevade alajaotustesse rühmitamise kriteeriumid, segmenti kantavatele kalalaevadele esitatavad nõuded ja kalalaevade segmenti juurdelisamise võimalus» sätestatud kalalaevade riiklikus registris laevade alajaotusse (edaspidi segment) 4S1 kuuluva kalalaeva aktsiisivaba kütuse suurim lubatud kogus ühe tonni kala kohta on 180 liitrit.",
      "estleg:parentProvision": {
        "@id": "estleg:Reg_331436_Par_1"
      },
      "rdfs:label": "§ 1 lg 1",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:mentionsInstitution": [
        {
