        }
      ]
    },
    {
      "@id": "estleg:Reg_331436_Par_1_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Segmenti 4S2 või 4S4 kuuluva kalalaeva aktsiisivaba kütuse suurim lubatud kogus on: 1) kalalaeva puhul, mille peamasina võimsus on kuni 50 kilovatti, – 50 liitrit kilovati kohta; 2) kalalaeva puhul, mille peamasina võimsus on suurem kui 50 kilovatti, – 35 liitrit kilovati kohta.",
