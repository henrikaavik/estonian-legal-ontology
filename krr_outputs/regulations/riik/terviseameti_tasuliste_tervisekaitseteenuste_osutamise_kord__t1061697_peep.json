    {
      "@id": "estleg:Reg_1061697_Par_1",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision"
      ],
      "estleg:paragrahv": "§ 1.",
      "rdfs:label": {
        "@value": "§ 1. Teenuse osutamine",
        "@language": "et"
      },
      "estleg:sourceAct": "Terviseameti tasuliste tervisekaitseteenuste osutamise kord ja hinnad",
      "estleg:partOfAct": {
        "@id": "estleg:Reg_1061697_Map"
      },
      "estleg:summary": {
        "@value": "Terviseamet osutab käesolevas määruses sätestatud hinnakirjade kohaselt tasulisi teenuseid juriidilise või füüsilise isiku, riigi- või kohaliku omavalitsuse asutuse taotluse alusel keemiliste, bioloogiliste ja füüsikaliste ohutegurite määramiseks ja riskihindamiseks ning labori hea laboritava nõuetele vastavuse hindamiseks ja tõendamiseks.",
        "@language": "et"
      },
      "estleg:legalText": "Terviseamet osutab käesolevas määruses sätestatud hinnakirjade kohaselt tasulisi teenuseid juriidilise või füüsilise isiku, riigi- või kohaliku omavalitsuse asutuse taotluse alusel keemiliste, bioloogiliste ja füüsikaliste ohutegurite määramiseks ja riskihindamiseks ning labori hea laboritava nõuetele vastavuse hindamiseks ja tõendamiseks.",
      "estleg:targetGroup": [
        {
          "@id": "estleg:TargetGroup_PublicBody"
        }
      ],
      "estleg:assertionConfidence": {
        "@value": "0.65",
        "@type": "xsd:decimal"
      },
      "estleg:hasSubsection": [
