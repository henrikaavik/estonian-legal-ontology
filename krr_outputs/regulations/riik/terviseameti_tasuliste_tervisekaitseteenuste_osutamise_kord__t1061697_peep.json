      "rdfs:label": {
        "@value": "§ 4. Teenuse osutamine õhtusel või öisel ajal, puhkepäevadel ja riiklikel pühadel",
        "@language": "et"
      },
      "estleg:sourceAct": "Terviseameti tasuliste tervisekaitseteenuste osutamise kord ja hinnad",
