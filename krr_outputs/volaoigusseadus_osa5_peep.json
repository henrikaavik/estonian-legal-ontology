      }
    },
    {
      "@id": "estleg:volaoigusseadus_Osa5_Par_568_Lg_2",
      "@type": [
        "estleg:Subsection",
        "owl:NamedIndividual"
      ],
      "estleg:subsectionNumber": "2",
      "estleg:legalText": "(2) Käesolevas peatükis sätestatut kohaldatakse vastavalt ka seaduse või kohtuotsusega seatud elurendisele, kui seaduse või kohtuotsusega ei ole ette nähtud teisiti.",
      "estleg:parentProvision": {
        "@id": "estleg:volaoigusseadus_Osa5_Par_568"
      },
      "rdfs:label": "§ 568 lg 2"
    },
