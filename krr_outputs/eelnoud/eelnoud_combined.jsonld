    {
      "@id": "estleg:Draft_KLIM15_0863",
      "@type": [
        "owl:NamedIndividual",
        "estleg:DraftLegislation"
      ],
      "rdfs:label": "„Nõuded salvkaevu konstruktsiooni, puurkaevu või -augu ehitusprojekti ja konstruktsiooni ning lammutamise ja ümberehitamise ehitusprojekti kohta, puurkaevu või -augu projekteerimise, rajamise, kasutusele võtmise, ümberehitamise, lammutamise ja konserveerimise korra ning puurkaevu või -augu asukoha kooskõlastamise, ehitusloa ja kasutusloa taotluste, ehitus- või kasutusteatise, puurimispäeviku, salvkaevu ehitus- ja kasutusteatise, puurkaevu või -augu ja salvkaevu andmete keskkonnaregistrisse kandmiseks esitamise ning puurkaevu või -augu ja salvkaevu lammutamise teatise vormid“",
      "estleg:legislativePhase": {
        "@id": "estleg:Phase_Review"
