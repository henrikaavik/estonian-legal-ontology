    {
      "@id": "estleg:JAHI_Par_3",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_3"
      },
      "estleg:paragrahv": "§ 3",
      "rdfs:label": "§ 3. Jahiõigus",
      "estleg:requestedCluster": {
        "@id": "jahtimisõigus"
      },
      "estleg:summary": "Määratleb jahiõiguse olemuse ning seob selle maa kasutamise ja jahimaa korraldusega.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_4",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_4"
      },
      "estleg:paragrahv": "§ 4",
      "rdfs:label": "§ 4. Jahimaa korraldamine",
      "estleg:requestedCluster": {
        "@id": "jahtimisõigus"
      },
      "estleg:summary": "Sätestab jahimaa korraldamise põhimõtted, mille alusel jahtimisõigust ruumiliselt teostatakse.",
      "estleg:sourceAct": "Jahiseadus",
      "estleg:implementedBy": [
        {
          "@id": "estleg:Reg_1014130_Map_2026"
        }
      ],
      "estleg:implementedByCount": 1
    },
    {
      "@id": "estleg:JAHI_Par_7",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_7"
      },
      "estleg:paragrahv": "§ 7",
      "rdfs:label": "§ 7. Jahipiirkonna kasutusõigus",
      "estleg:requestedCluster": {
        "@id": "jahtimisõigus"
      },
      "estleg:summary": "Kirjeldab jahipiirkonna kasutusõiguse sisu ja ulatust ning selle seost jahipidamise korraldamisega.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_8",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_8"
      },
      "estleg:paragrahv": "§ 8",
      "rdfs:label": "§ 8. Jahipiirkonna kasutusõiguse luba",
      "estleg:requestedCluster": {
        "@id": "jahtimisõigus"
      },
      "estleg:summary": "Määrab, et jahipiirkonna kasutusõiguse teostamiseks on vajalik haldusluba ning avab loa kui keskse õigustloova instrumendi.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_49",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_49"
      },
      "estleg:paragrahv": "§ 49",
      "rdfs:label": "§ 49. Maaomaniku omal kinnistul tasuta jahipidamisõigus",
      "estleg:requestedCluster": {
        "@id": "jahtimisõigus"
      },
      "estleg:summary": "Kehtestab maaomaniku õiguse pidada oma kinnistul tasuta jahti seaduses sätestatud tingimustel.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_26",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_26"
      },
      "estleg:paragrahv": "§ 26",
      "rdfs:label": "§ 26. Jahipidamine",
      "estleg:requestedCluster": {
        "@id": "jahihooaeg"
      },
      "estleg:summary": "Sätestab jahipidamise üldised raamid, mille sees hooajalised ja liigilised piirangud rakenduvad.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_27",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_27"
      },
      "estleg:paragrahv": "§ 27",
      "rdfs:label": "§ 27. Jahieeskiri",
      "estleg:requestedCluster": {
        "@id": "jahihooaeg"
      },
      "estleg:summary": "Volitab kehtestama jahieeskirja, kus täpsustatakse jahipidamise tingimusi, sh hooajalisi nõudeid ja lubatud võtteid.",
      "estleg:sourceAct": "Jahiseadus",
      "estleg:implementedBy": [
        {
          "@id": "estleg:Reg_1014130_Map_2026"
        }
      ],
      "estleg:implementedByCount": 1
    },
    {
      "@id": "estleg:JAHI_Par_34",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_34"
      },
      "estleg:paragrahv": "§ 34",
      "rdfs:label": "§ 34. Jahiluba",
      "estleg:requestedCluster": {
        "@id": "jahihooaeg"
      },
      "estleg:summary": "Seob uluki küttimise loa süsteemiga, mille kaudu hooajalisi ja liigilisi küttimistingimusi konkreetselt rakendatakse.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_42",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_42"
      },
      "estleg:paragrahv": "§ 42",
      "rdfs:label": "§ 42. Jahiajad",
      "estleg:requestedCluster": {
        "@id": "jahihooaeg"
      },
      "estleg:summary": "Määratleb eri jahiulukite jahiajad ning loob hooajalisuse keskse õigusliku raami.",
      "estleg:sourceAct": "Jahiseadus",
      "estleg:implementedBy": [
        {
          "@id": "estleg:Reg_1014130_Map_2026"
        },
        {
          "@id": "estleg:Reg_1014859_Map_2026"
        }
      ],
      "estleg:implementedByCount": 2
    },
    {
      "@id": "estleg:JAHI_Par_44",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_44"
      },
      "estleg:paragrahv": "§ 44",
      "rdfs:label": "§ 44. Jahi korraldamise nõuded",
      "estleg:requestedCluster": {
        "@id": "jahihooaeg"
      },
      "estleg:summary": "Täpsustab jahi korralduslikud nõuded, mis mõjutavad jahi läbiviimist jahiaegade ja lubade kontekstis.",
      "estleg:sourceAct": "Jahiseadus",
      "estleg:implementedBy": [
        {
          "@id": "estleg:Reg_1022642_Map_2026"
        }
      ],
      "estleg:implementedByCount": 1
    },
    {
      "@id": "estleg:JAHI_Par_19",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_19"
      },
      "estleg:paragrahv": "§ 19",
      "rdfs:label": "§ 19. Jahiulukid",
      "estleg:requestedCluster": {
        "@id": "ulukite_varumine"
      },
      "estleg:summary": "Määratleb jahiulukite ringi, millele ulukivaru arvestus, küttimine ja ohjemeetmed rakenduvad.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_20",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_20"
      },
      "estleg:paragrahv": "§ 20",
      "rdfs:label": "§ 20. Jahiulukivaru arvestus",
      "estleg:requestedCluster": {
        "@id": "ulukite_varumine"
      },
      "estleg:summary": "Sätestab jahiulukivaru seire ja arvestuse alused, mis on varumise planeerimise eeldus.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_Par_21",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_21"
      },
      "estleg:paragrahv": "§ 21",
      "rdfs:label": "§ 21. Jahiulukite lubatud arvukus",
      "estleg:requestedCluster": {
        "@id": "ulukite_varumine"
      },
      "estleg:summary": "Seob ulukipopulatsiooni soovitud taseme ja ohjamise eesmärgid arvukuse lävenditega.",
      "estleg:sourceAct": "Jahiseadus",
      "estleg:implementedBy": [
        {
          "@id": "estleg:Reg_1014037_Map_2026"
        }
      ],
      "estleg:implementedByCount": 1
    },
    {
      "@id": "estleg:JAHI_Par_23",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_23"
      },
      "estleg:paragrahv": "§ 23",
      "rdfs:label": "§ 23. Jahiulukikahjustuste ärahoidmine",
      "estleg:requestedCluster": {
        "@id": "ulukite_varumine"
      },
      "estleg:summary": "Reguleerib ennetusmeetmeid olukorras, kus ulukite arvukus põhjustab kahjustusi, sidudes varumise praktilise kahjude juhtimisega.",
      "estleg:sourceAct": "Jahiseadus",
      "estleg:implementedBy": [
        {
          "@id": "estleg:Reg_1014127_Map_2026"
        }
      ],
      "estleg:implementedByCount": 1
    },
    {
      "@id": "estleg:JAHI_Par_25",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_JAHI"
      ],
      "owl:sameAs": {
        "@id": "estleg:Jahiseadus_Par_25"
      },
      "estleg:paragrahv": "§ 25",
      "rdfs:label": "§ 25. Jahiulukite loodusest eemaldamine ja tehiskeskkonnas hoidmine",
      "estleg:requestedCluster": {
        "@id": "ulukite_varumine"
      },
      "estleg:summary": "Sätestab tingimused ulukite loodusest eemaldamiseks ja hoidmiseks, mis moodustab ulukivaru haldamise erimeetme.",
      "estleg:sourceAct": "Jahiseadus"
    },
    {
      "@id": "estleg:JAHI_NOTE_001",
      "@type": [
        "owl:NamedIndividual"
      ],
      "rdfs:label": "Märkus kaardistuse kohta",
      "estleg:note": "Kaardistus järgib meeskonna ühtset JSON-LD skeemi. Paragrahvide valik on tehtud kolme tellitud klastri (jahtimisõigus, jahihooaeg, ulukite varumine) kesksete normide alusel ja vajab järgmises iteratsioonis punktipõhist verifitseerimist Riigi Teataja kehtiva redaktsiooni sõnastusega."
    }
