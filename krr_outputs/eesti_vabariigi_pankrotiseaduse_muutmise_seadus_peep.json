        "estleg:LegalProvision_EVPM"
      ],
      "estleg:paragrahv": "§ 133.",
      "rdfs:label": "§ 133. Seaduse kohaldamine pankrotiavalduse esitanud võlausaldaja nõude suurusele",
      "estleg:sourceAct": "Eesti Vabariigi pankrotiseaduse muutmise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:EVPM_Map_2026"
      },
      "estleg:summary": "1 (1) Kuni 1999. aasta 1. septembrini ei kohaldata käesoleva seaduse § 11 lõike 2 punktis 3 sätestatut aktsiaseltsi, osa-, täis- ja usaldusühingu suhtes. Kuni 1999. aasta 1. septembrini ei kohaldata käesoleva seaduse § 11 lõike 2 punktis 3 sätestatut aktsiaseltsi, osa-, täis- ja usaldusühingu suhtes. 2 (2) Kuni 1999. aasta 1. septembrini ei algatata pankrotimenetlust, kui pankrotiavalduse aluseks olevate nõuete suurus ei ületa aktsiaseltsi puhul 25 000 krooni ning osa-, täis- ja usaldusühingu pu",
      "estleg:targetGroup": [
        "citizen",
        "business"
      ],
      "estleg:hasVersion": [
