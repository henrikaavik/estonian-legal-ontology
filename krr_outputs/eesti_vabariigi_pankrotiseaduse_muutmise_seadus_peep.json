        "owl:NamedIndividual",
        "estleg:LegalProvision_EVPM"
      ],
      "estleg:paragrahv": "§ 134.",
      "rdfs:label": "§ 134. Pandiga tagatud nõuded",
      "estleg:sourceAct": "Eesti Vabariigi pankrotiseaduse muutmise seadus",
      "estleg:partOfAct": {
        "@id": "estleg:EVPM_Map_2026"
      },
      "estleg:summary": "1 (1) Kui pankrot on välja kuulutatud enne 1997. aasta 1. veebruari, ei pea võlausaldaja, kelle nõue on pandiga tagatud, esitama pankrotiseaduse §-s 23 nimetatud nõudeavaldust. Kui pankrot on välja kuulutatud enne 1997. aasta 1. veebruari, ei pea võlausaldaja, kelle nõue on pandiga tagatud, esitama pankrotiseaduse §-s 23 nimetatud nõudeavaldust. 2 (2) Kui pankrot on välja kuulutatud enne 2004. aasta 1. jaanuari, ei kohaldata kommertspandiga tagatud nõude rahuldamise järjekorra määramisel pankrot",
