      ],
      "estleg:paragrahv": "§ 201",
      "rdfs:label": "§ 201. Tasaarvestus nõuete paljususe korral",
      "estleg:requestedCluster": {
        "@id": "tasaarvestus"
      },
      "estleg:summary": "Kui tasaarvestuse pooltel on mitu tasaarvestuseks sobivat nõuet, võib tasaarvestav pool määrata nõuded, mis tasaarvestatakse. Kui tasaarvestuse avalduses ei ole määratud, millised nõuded tasaarvestatakse, või kui teine pool vaidleb tasaarvestuse avalduses märgitud määramisele viivitamata vastu, loetakse tasaarvestatuks:",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_202",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 202",
      "rdfs:label": "§ 202. Tasaarvestuse piirang kolmanda isiku kasuks sõlmitud lepingu puhul",
      "estleg:requestedCluster": {
        "@id": "tasaarvestus"
      },
      "estleg:summary": "Kolmanda isiku kasuks sõlmitud lepingu puhul ei või lepingupool, kes peab kohustuse täitma kolmanda isiku suhtes, tasaarvestada tema vastu suunatud kohustuse täitmise nõuet.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_203",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 203",
      "rdfs:label": "§ 203. Jooksev arve",
      "estleg:requestedCluster": {
        "@id": "tasaarvestus"
      },
      "estleg:summary": "Kui mõlema poole püsivas ärisuhtes sõlmitud lepingutest tulenevad rahalised nõuded ja kohustused tuleb summeerida (jooksev arve), loetakse tasaarvestus summeerimisega toimunuks. Sel juhul võlgnetakse nõuete ja kohustuste vahe (saldo).",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:interpretedBy": [
        {
          "@id": "estleg:RK_3_2_1_100_07"
        },
        {
          "@id": "estleg:RK_2_16_9796_46"
        },
        {
          "@id": "estleg:RK_3_20_326_32"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_204",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 204",
      "rdfs:label": "§ 204. Jooksva arvega seotud toimingud",
      "estleg:requestedCluster": {
        "@id": "tasaarvestus"
      },
      "estleg:summary": "Tasaarvestav pool, kes korraldab jooksva arve pidamist, teatab teisele poolele arveldusperioodi lõpus saldo, näidates ära jooksvale arvele kantud nõuded, millest teisele poolele ei ole veel teatatud. Eeldatakse, et arveldusperioodi kestuseks on üks aasta.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:interpretedBy": [
        {
          "@id": "estleg:RK_2_16_9796_46"
        }
      ]
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_205",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 205",
      "rdfs:label": "§ 205. Jooksva arve lepingu lõppemine",
      "estleg:requestedCluster": {
        "@id": "tasaarvestus"
      },
      "estleg:summary": "Kui jooksva arve kohta on sõlmitud leping tähtaega määramata, võib kumbki pool selle üles öelda igaks jooksva arveldusperioodi lõpuks, teatades ülesütlemisest vähemalt 10 päeva ette.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:normativeType": {
        "@id": "estleg:NormType_Permission"
      }
    },
