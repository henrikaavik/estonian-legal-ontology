      "estleg:paragrahv": "§ 80",
      "rdfs:label": "§ 80. Leping kolmanda isiku kasuks",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Lepingus võib ette näha või võlasuhte olemusest tuleneda, et kohustus tuleb võlausaldaja asemel täita kolmandale isikule (leping kolmanda isiku kasuks).",
