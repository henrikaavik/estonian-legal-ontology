      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_82",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 82",
      "rdfs:label": "§ 82. Kohustuse täitmise aeg ja sissenõutavus",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Kui võlgnik on riigihangete seaduse § 5 lõikes 2 nimetatud isik, ei tohi kokku leppida tähtajas, mille möödumisel loetakse, et võlgnik on arve kätte saanud.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Prohibition"
      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_83",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 83",
      "rdfs:label": "§ 83. Kohustuse ositi täitmine",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Kui kohustus tuleb täita ühekorraga, võib võlausaldaja keelduda kohustuse ositi täitmise vastuvõtmisest, välja arvatud juhul, kui see oleks vastuolus hea usu põhimõttega.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_84",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 84",
      "rdfs:label": "§ 84. Kohustuse ennetähtaegne täitmine",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Võlausaldaja ei või nõuda kohustuse täitmist enne täitmise tähtpäeva, kuid ta ei või keelduda kohustuse täitmise vastuvõtmisest enne täitmise tähtpäeva, kui tal ei ole keeldumiseks õigustatud huvi.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ]
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_85",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 85",
      "rdfs:label": "§ 85. Kohustuse täitmise koht",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Võlgnik peab kohustuse täitma lepingu või seadusega kindlaksmääratud kohas. Kui kohustuse täitmise kohta ei ole lepingu või seadusega kindlaks määratud, tuleb kohustus täita kohas, mis tuleneb võlasuhte olemusest.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      },
      "estleg:dutyHolder": "Võlgnik"
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_86",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 86",
      "rdfs:label": "§ 86. Alternatiivkohustus",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Kui võlgnik peab täitma ühe mitmest kohustusest, kuulub valikuõigus võlgnikule, kui seadusest, lepingust või võlasuhte olemusest tulenevalt ei ole seda õigust võlausaldajal või kolmandal isikul.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:interpretedBy": [
        {
          "@id": "estleg:RK_3_2_1_117_12"
        },
        {
          "@id": "estleg:RK_3_2_1_104_13"
        }
      ],
      "estleg:normativeType": {
        "@id": "estleg:NormType_Obligation"
      }
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_87",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 87",
      "rdfs:label": "§ 87. Valikuõiguse üleminek alternatiivkohustuse puhul",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Kui alternatiivkohustuse puhul on valikuõigus võlgnikul või võlausaldajal ja valikut ei ole tehtud kokkulepitud aja jooksul või kokkuleppe puudumise korral mõistliku aja jooksul enne kohustuse sissenõutavaks muutumist, läheb valikuõigus üle võlasuhte teisele poolele.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen",
        "official"
      ]
    },
    {
      "@id": "estleg:VOS_O4_Osa4_Par_88",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 88",
      "rdfs:label": "§ 88. Täitmine erinevate kohustuste katteks",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Kui võlgnik peab võlausaldajale üle andma raha või liigitunnustega esemeid või osutama samaliigilisi teenuseid mitme erineva kohustuse täitmiseks ja üleantud rahast, esemetest või osutatud teenustest ei piisa kõigi kohustuste täitmiseks, võib võlgnik määrata, missuguse kohustuse täitmiseks on raha või esemed üle antud või teenus osutatud.",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:interpretedBy": [
        {
