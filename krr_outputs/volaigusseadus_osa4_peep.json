    {
      "@id": "estleg:VOS_O4_Osa4_Par_81",
      "@type": [
        "owl:NamedIndividual",
        "estleg:LegalProvision_VOS_Osa7_osa4"
      ],
      "estleg:paragrahv": "§ 81",
      "rdfs:label": "§ 81. Kolmandat isikut kaitsev leping",
      "estleg:requestedCluster": {
        "@id": "taitmine"
      },
      "estleg:summary": "Lepinguga võib kaasneda kohustus arvestada kolmanda isiku huvide või õigustega samal määral kui võlausaldaja huvide või õigustega. Sellist kohustust eeldatakse, kui:",
      "estleg:sourceAct": "Võlaõigusseadus",
      "estleg:targetGroup": [
        "citizen"
      ],
      "estleg:interpretedBy": [
