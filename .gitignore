# On-disk scrape caches (not part of the published corpus; resumable re-fetch)
krr_outputs/.cache/
krr_outputs/.regen_state.json
krr_outputs/generation_manifest_laws.json

# Retrieval projection (#523) — heavy DERIVED artifacts regenerated by
# scripts/generate_retrieval_projection.py. The full chunks corpus and the
# per-law outline/context-pack trees are tens-to-hundreds of MB, so they are
# not committed; the lightweight entry points (llms.txt, README.md,
# manifest.json, chunks.sample.jsonl, sample_*.json) ARE committed so the
# projection's shape stays reviewable. Regenerate the heavy files on demand.
krr_outputs/retrieval/chunks.jsonl
krr_outputs/retrieval/chunks.jsonl.tmp
krr_outputs/retrieval/outlines/
krr_outputs/retrieval/outlines.tmp/
krr_outputs/retrieval/context_packs/
krr_outputs/retrieval/context_packs.tmp/
/*-shacl-report.ttl
.cache/
.claude/

# Git worktrees (subagent-driven development workspaces)
.worktrees/
