@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix estleg: <https://w3id.org/estleg/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

estleg:graphClosureExempt
    a owl:AnnotationProperty ;
    rdfs:domain sh:PropertyShape ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Marker: this property shape's predicate carries enum-like controlled values that validate_seadusloome_sync.validate_graph_closure should skip." .

# Shape for act-level metadata shared by laws and domestic regulations.
#
# Temporal enrichment currently describes the selected act snapshot, not
# individual historical provision redactions. Provision-level validity is a
# separate future model; these constraints intentionally target estleg:Act.
estleg:ActTemporalShape
    a sh:NodeShape ;
    sh:targetClass estleg:Act ;
    sh:property [
        sh:path dcterms:subject ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://eurovoc\\.europa\\.eu/[0-9]+$" ;
        sh:severity sh:Warning ;
        sh:name "subject" ;
        sh:description "Optional act-level EuroVoc subject classification URI. When present it must point at a EuroVoc concept." ;
    ] ;
    sh:property [
        sh:path estleg:entryIntoForce ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "entryIntoForce" ;
        sh:description "Date when the selected act snapshot entered into force" ;
    ] ;
    sh:property [
        sh:path estleg:repealDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "repealDate" ;
        sh:description "Date when the selected act snapshot was repealed" ;
    ] ;
    sh:property [
        sh:path estleg:lastAmendmentDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "lastAmendmentDate" ;
        sh:description "Date of the most recent amendment to the selected act snapshot" ;
    ] ;
    sh:property [
        sh:path estleg:publicationDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "publicationDate" ;
        sh:description "Date when the selected act snapshot was published" ;
    ] ;
    sh:property [
        sh:path estleg:temporalStatus ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "inForce" "repealed" "notYetEffective" "unknown" ) ;
        sh:name "temporalStatus" ;
        sh:description "Temporal status evaluated against the declared build evaluation date (#451/#522)" ;
    ] ;
    sh:property [
        sh:path estleg:kehtiv ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "kehtiv" ;
        sh:description "Snapshot date the act text is valid as of (the Riigi Teataja 'kehtiv' redaction date), typed xsd:date (issue #357)." ;
    ] ;
    sh:property [
        sh:path estleg:contentStatus ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "structuredBody" "noStructuredBody" ) ;
        sh:name "contentStatus" ;
        sh:description "Whether the act snapshot was parsed into a structured § body or only a flat text body: structuredBody or noStructuredBody (issue #357)." ;
    ] ;
    sh:property [
        sh:path estleg:transposesDirective ;
        sh:nodeKind sh:IRI ;
        sh:name "transposesDirective" ;
        sh:description "EU directive that this act transposes" ;
    ] ;
    sh:property [
        sh:path estleg:transpositionStatus ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "transpositionStatus" ;
        sh:description "Status of directive transposition for this act" ;
    ] ;
    sh:property [
        sh:path estleg:harmonisedWith ;
        sh:nodeKind sh:IRI ;
        sh:name "harmonisedWith" ;
        sh:description "Harmonisation record(s) (estleg:HarmonisationLink) for directives this act transposes that a Baltic/Nordic neighbour also transposed (issue #197)" ;
    ] ;
    # Issue #570: every statute root (estleg:Act, including the dual-typed
    # estleg:Law roots) must carry a human-readable rdfs:label. ActTemporalShape
    # was otherwise all-optional, leaving the top-level act node with no enforced
    # label while the regulation/subsection shapes guarded everything below it.
    # Verified against every SHACL bucket: all explicitly-typed estleg:Act
    # statute roots carry rdfs:label, so this is a regression guard, not a data
    # fix. (The cross-corpus reference stubs in the eurlex/harmonisation bucket
    # are deliberately NOT RDFS-typed as estleg:Act — see the note on
    # estleg:harmonises / estleg:transposedBy in controlled_vocabulary.jsonld —
    # so they are not targeted here.)
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every statute root (Act/Law) must have a human-readable label" ;
    ] .

# Issue #608 — act-level FRBR Expression. One node per (act, consolidation date):
# the addressable "law as of date D" entity (aligned to eli:LegalExpression).
estleg:ActExpressionShape
    a sh:NodeShape ;
    sh:targetClass estleg:ActExpression ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every ActExpression must have a human-readable label" ;
    ] ;
    sh:property [
        sh:path estleg:expressionOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "expressionOf" ;
        sh:description "The act (Work) this expression consolidates (#608)" ;
    ] ;
    sh:property [
        sh:path estleg:consolidationDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "consolidationDate" ;
        sh:description "The date from which this consolidated expression is in force (#608)" ;
    ] .

# Shape for LegalProvision instances.
#
# The generators in scripts/ emit LegalProvision instances using Estonian-
# native vocabulary that mirrors how Estonian legal documents themselves
# refer to sections: `estleg:paragrahv` is the Estonian word for the
# section reference ("AdvS § 1", "TsÜS § 40 lg 1-2") and `estleg:summary`
# holds the LLM-generated topic-aware summary of what the provision does.
# Full legal text is optional via `estleg:legalText` (populated for a
# small subset — most provisions only need the summary for the topic map).
#
# This shape has two targets (SHACL allows both on one NodeShape):
#   * `sh:targetSubjectsOf estleg:paragrahv` — still needed without RDFS
#     inference. The combined_ontology.jsonld graph contains ~50k
#     per-law-typed instances like `estleg:LegalProvision_KARIST_2`
#     whose classes are declared as `rdfs:subClassOf estleg:LegalProvision`
#     (issue #67). Many SHACL engines do not infer subclasses by default,
#     so a class target alone would miss them. This also catches
#     provisions of domestic regulations (määrused) emitted by
#     `generate_regulations.py` under per-regulation classes like
#     `estleg:Regulation_<terviktekstId>`, also `rdfs:subClassOf
#     estleg:LegalProvision`.
#   * `sh:targetClass estleg:LegalProvision` — so a node typed as
#     LegalProvision that is missing `estleg:paragrahv` is still in
#     scope (issue #450). `sh:targetSubjectsOf` alone is tautological
#     for the required paragrahv property: nodes without the predicate
#     never become focus nodes.
estleg:LegalProvisionShape
    a sh:NodeShape ;
    sh:targetClass estleg:LegalProvision ;
    sh:targetSubjectsOf estleg:paragrahv ;
    sh:property [
        sh:path estleg:paragrahv ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "paragrahv" ;
        sh:description "Every LegalProvision must have a section reference (e.g., 'AdvS § 1', 'TsÜS § 40 lg 1-2')" ;
    ] ;
    sh:property [
        sh:path estleg:summary ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "summary" ;
        sh:description "Every LegalProvision must have a topic-aware summary. Full legal text is optional via estleg:legalText." ;
    ] ;
    sh:property [
        sh:path estleg:legalText ;
        sh:datatype xsd:string ;
        sh:name "legalText" ;
        sh:description "Optional full legal text. Populated for provisions where the full paragraph was sourced verbatim; most provisions only carry the summary." ;
    ] ;
    sh:property [
        sh:path estleg:sourceAct ;
        sh:datatype xsd:string ;
        sh:name "sourceAct" ;
        sh:description "Human-readable name of the law this provision belongs to" ;
    ] ;
    sh:property [
        # Issue #415: structural IRI join to the act root. sourceAct above is
        # the literal title; partOfAct is the graph edge SPARQL traverses to
        # answer "which act does this § belong to" / "all provisions of act X".
        # Emitted by generate_all_laws.py (law + multipart paths) and
        # generate_regulations.py on every provision; KOV provisions also carry
        # it via enrich_kov_layer1.py.
        sh:path estleg:partOfAct ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "partOfAct" ;
        sh:description "Every LegalProvision must link to its parent act root via at least one IRI-valued estleg:partOfAct." ;
    ] ;
    sh:property [
        sh:path estleg:topicCluster ;
        sh:nodeKind sh:IRI ;
        sh:name "topicCluster" ;
        sh:description "Topic cluster reference must be an IRI" ;
    ] ;
    sh:property [
        sh:path estleg:references ;
        sh:nodeKind sh:IRI ;
        sh:name "references" ;
        sh:description "Cross-references must point to valid IRIs" ;
    ] ;
    sh:property [
        sh:path estleg:referencedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "referencedBy" ;
        sh:description "Inverse cross-references — provisions that reference this one" ;
    ] ;
    sh:property [
        sh:path estleg:interpretedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "interpretedBy" ;
        sh:description """Court decisions that interpret this provision. The same predicate is also used on MunicipalRegulation act nodes for KOV act-level citations — the object remains a CourtDecision in both cases; the subject differs.""" ;
    ] ;
    sh:property [
        sh:path estleg:transposesDirective ;
        sh:nodeKind sh:IRI ;
        sh:name "transposesDirective" ;
        sh:description "EU directive that this provision transposes" ;
    ] ;
    sh:property [
        sh:path estleg:enforcedAtLevel ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "state" "municipality" ) ;
        sh:name "enforcedAtLevel" ;
        sh:description "Layer 2c — coarse classification of where this provision's sanctions are enforced. Set only on provisions that also carry estleg:hasSanction. 'state' for provisions in Law, NationalRegulation, GovernmentRegulation, or MinisterialRegulation acts; 'municipality' for provisions in MunicipalRegulation acts." ;
    ] ;
    sh:property [
        sh:path estleg:amendedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "amendedBy" ;
        sh:description "Amending act or draft that modified this provision" ;
    ] ;
    sh:property [
        sh:path estleg:normativeType ;
        estleg:graphClosureExempt true ;
        sh:nodeKind sh:IRI ;
        sh:name "normativeType" ;
        sh:description "Deontic classification: obligation, right, permission, prohibition, definition" ;
    ] ;
    sh:property [
        sh:path estleg:competentAuthority ;
        sh:nodeKind sh:IRI ;
        sh:name "competentAuthority" ;
        sh:description "Institution or Issuer responsible for enforcing or implementing this provision. May be an estleg:Institution_* IRI (named institutions, ministries, courts, generic local-government references) or an estleg:Issuer_* IRI (when the source act is a MunicipalRegulation with enactedByMunicipality scope and the body word resolves to a registered Issuer)." ;
    ] ;
    sh:property [
        sh:path estleg:hasSanction ;
        sh:nodeKind sh:IRI ;
        sh:name "hasSanction" ;
        sh:description "Sanction defined by this provision" ;
    ] ;
    sh:property [
        sh:path estleg:affectedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "affectedBy" ;
        sh:description "Draft legislation that proposes to modify this provision" ;
    ] ;
    sh:property [
        sh:path estleg:semanticallySimilarTo ;
        sh:nodeKind sh:IRI ;
        sh:name "semanticallySimilarTo" ;
        sh:description "Provisions from other laws with similar content" ;
    ] ;
    sh:property [
        sh:path estleg:definesTerm ;
        sh:nodeKind sh:IRI ;
        sh:name "definesTerm" ;
        sh:description "Legal concept defined by this provision" ;
    ] ;
    sh:property [
        sh:path estleg:requestedCluster ;
        sh:nodeKind sh:IRI ;
        sh:name "requestedCluster" ;
        sh:description "Topic cluster this provision is assigned to" ;
    ] ;
    sh:property [
        sh:path estleg:dutyHolder ;
        sh:datatype xsd:string ;
        sh:name "dutyHolder" ;
        sh:description "Entity responsible for fulfilling the duty" ;
    ] ;
    sh:property [
        sh:path estleg:targetGroup ;
        sh:datatype xsd:string ;
        sh:in ( "citizen" "business" "public_body" "official" "ngo" ) ;
        sh:name "targetGroup" ;
        sh:description "The bearer(s) of the deontic norm: which group(s) of actors carry the obligation, hold the right, or otherwise receive the norm's effect. Multi-valued because one provision may target several groups." ;
    ] ;
    # Issue #609: the reified SKOS counterpart of estleg:targetGroup — IRI(s) into
    # estleg:TargetGroupScheme, materialized alongside the retained string value.
    sh:property [
        sh:path estleg:targetGroupConcept ;
        sh:nodeKind sh:IRI ;
        sh:name "targetGroupConcept" ;
        sh:description "Reified estleg:TargetGroup skos:Concept(s) for this provision's addressee classification (#609); the SKOS-navigable form of estleg:targetGroup." ;
    ] ;
    sh:property [
        sh:path estleg:harmonisedWith ;
        sh:nodeKind sh:IRI ;
        sh:name "harmonisedWith" ;
        sh:description "EU or international legislation this provision is harmonised with" ;
    ] ;
    # --- versioned legal-text model (issue #131) ---
    # Both optional on law peeps: ProvisionVersion nodes are emitted into
    # sidecar files, and consumers can query them through estleg:versionOf.
    # Back-links on the stable provision node may be populated later when
    # sidecar loading is part of the consumer graph.
    sh:property [
        sh:path estleg:hasVersion ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:name "hasVersion" ;
        sh:description "Optional inverse links to estleg:ProvisionVersion nodes in this provision's text history. Sidecar version nodes always link back with estleg:versionOf; these back-links may be absent from law peeps." ;
    ] ;
    sh:property [
        sh:path estleg:currentVersion ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:name "currentVersion" ;
        sh:description "Optional convenience pointer to the latest estleg:ProvisionVersion in this provision's text history. May be absent when version nodes live only in sidecars." ;
    ] ;
    # --- subsection (lõige) model (issue #132) ---
    # Optional: a provision with no lõiked carries no estleg:hasSubsection
    # and still conforms; a provision with lõige structure links one
    # estleg:Subsection per lõige (in document order). Each Subsection
    # node is validated by estleg:SubsectionShape below.
    sh:property [
        sh:path estleg:hasSubsection ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:name "hasSubsection" ;
        sh:description "Optional — estleg:Subsection (lõige) nodes belonging to this provision, one per lõige in document order. Absent on provisions with no lõige structure (their text lives directly on the § node)." ;
    ] .

# Shape for Subsection (lõige) instances — issue #132.
#
# An estleg:Subsection is one numbered lõige of an estleg:LegalProvision —
# the level Estonian citations actually reference ("TsÜS § 14 lg 2").
# IRI form: estleg:<PREFIX>[_Osa<N>]_Par_<parSuffix>_Lg_<loigeSuffix>
# (superscript "§ 14 lg 2¹" → ..._Par_14_Lg_2_1). Each node carries the
# lõige number, the lõige's own text (with its (N) marker), and exactly
# one estleg:parentProvision link back to the § node. estleg:parentProvision
# is constrained to be an IRI (not sh:class estleg:LegalProvision),
# mirroring the project-wide convention of dodging subclass-inference
# requirements (see LegalProvisionShape's targetSubjectsOf comment).
estleg:SubsectionShape
    a sh:NodeShape ;
    sh:targetClass estleg:Subsection ;
    sh:property [
        sh:path estleg:subsectionNumber ;
        # #583: optional. A lõige whose number cannot be parsed from the source
        # legitimately has none — omitting it is honest, whereas the former
        # "Unknown_N" placeholder (7,755 nodes) was a fabricated value. maxCount 1
        # still forbids duplicates.
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "subsectionNumber" ;
        sh:description "The lõige number as a display string (e.g. \"2\", \"2¹\"); absent when unparseable." ;
    ] ;
    sh:property [
        sh:path estleg:legalText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "legalText" ;
        sh:description "The lõige's own text (the lõige-and-below text, including its (N) punkt markers), mirroring the provision-level estleg:legalText." ;
    ] ;
    sh:property [
        sh:path estleg:parentProvision ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "parentProvision" ;
        sh:description "Exactly one estleg:LegalProvision (the § node, an IRI) this lõige belongs to." ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:name "label" ;
        sh:description "Optional human label, e.g. \"§ 14 lg 2\"." ;
    ] .

# Shape for TopicCluster instances.
#
# The generators use `rdfs:label` as the display label for topic clusters
# (e.g., "§1–9 ÜLDSÄTTED"). The earlier shape additionally required
# `skos:prefLabel`, but no generator ever emits one, and the explorer
# reads cluster labels from `rdfs:label` anyway. If we ever want to layer
# SKOS labels on top, the shape can be tightened to require them again.
estleg:TopicClusterShape
    a sh:NodeShape ;
    sh:targetClass estleg:TopicCluster ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:datatype xsd:string ;
        sh:name "prefLabel" ;
        sh:description "Optional preferred label for the TopicCluster" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every TopicCluster must have an rdfs:label used as its display name" ;
    ] .

# Shape for LegalConcept instances — the provision-local definition node.
# Each non-noise definition node also carries `estleg:definesConcept`, a hub
# link to the canonical `estleg:Concept` node for that term (#134). This
# replaces the former O(k²) `skos:exactMatch` clique between definition nodes;
# the link is optional because noise-term definition nodes (repealed-marker
# slots etc.) are still emitted but get no canonical concept.
estleg:LegalConceptShape
    a sh:NodeShape ;
    sh:targetClass estleg:LegalConcept ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every LegalConcept must have a label" ;
    ] ;
    sh:property [
        sh:path estleg:definesConcept ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:name "definesConcept" ;
        sh:description "Canonical estleg:Concept node this provision-local definition belongs to (absent for filtered noise terms)" ;
    ] ;
    sh:property [
        sh:path estleg:definedIn ;
        sh:nodeKind sh:IRI ;
        sh:name "definedIn" ;
        sh:description "Provision(s) (an IRI) where this term is defined. Populated on 100% of the provision-local definition nodes (issue #357); optional here because aggregate Concept-style LegalConcept nodes carry the definition text directly without this back-link." ;
    ] ;
    sh:property [
        sh:path estleg:sourceAct ;
        sh:datatype xsd:string ;
        sh:name "sourceAct" ;
        sh:description "Human-readable name of the act this definition comes from." ;
    ] ;
    # Issue #609: SKOS scheme binding (optional — most provision-local definition
    # nodes are bound by the concept-layer pass, but a handful also appear inline
    # in law peeps, so enforcement stays advisory to avoid false-fails).
    sh:property [
        sh:path skos:inScheme ;
        sh:nodeKind sh:IRI ;
        sh:name "inScheme" ;
        sh:description "The estleg:LegalConceptScheme this concept belongs to (#609)." ;
    ] .

# Shape for canonical Concept instances (#134) — one node per distinct
# normalised legal term, aggregating every provision-local definition of it.
estleg:ConceptShape
    a sh:NodeShape ;
    sh:targetClass estleg:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "prefLabel" ;
        sh:description "Exactly one preferred label (a language-tagged literal): the most common surface form of the term" ;
    ] ;
    # Issue #609: SKOS scheme binding for the canonical term (optional, advisory).
    sh:property [
        sh:path skos:inScheme ;
        sh:nodeKind sh:IRI ;
        sh:name "inScheme" ;
        sh:description "The estleg:LegalConceptScheme this canonical concept belongs to (#609)." ;
    ] ;
    sh:property [
        sh:path skos:topConceptOf ;
        sh:nodeKind sh:IRI ;
        sh:name "topConceptOf" ;
        sh:description "Canonical concepts are top concepts of estleg:LegalConceptScheme (#609)." ;
    ] ;
    sh:property [
        sh:path skos:altLabel ;
        sh:nodeKind sh:Literal ;
        sh:name "altLabel" ;
        sh:description "Other surface forms of the term seen across laws (language-tagged literals)" ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:nodeKind sh:Literal ;
        sh:name "definition" ;
        sh:description "Definition(s) of the term — one value when laws agree, otherwise one per distinct wording (capped; see estleg:definitionVariantCount)" ;
    ] ;
    sh:property [
        sh:path estleg:definitionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "definitionCount" ;
        sh:description "Number of provision-local definitions aggregated by this concept" ;
    ] ;
    sh:property [
        sh:path estleg:definitionVariantCount ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:name "definitionVariantCount" ;
        sh:description "Total distinct definition wordings, present only when skos:definition carries a capped subset" ;
    ] ;
    sh:property [
        sh:path estleg:hasDefinitionNode ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:name "hasDefinitionNode" ;
        sh:description "The provision-local definition nodes (estleg:LegalConcept) that define this term. F3 (#134): a property distinct from estleg:definedIn — whose owl:inverseOf estleg:definesTerm axiom is reserved for the provision-local node → provision direction." ;
    ] ;
    sh:property [
        sh:path skos:closeMatch ;
        sh:nodeKind sh:IRI ;
        sh:name "closeMatch" ;
        sh:description "Other canonical Concept nodes with a near-identical term (edit distance < 3)" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Concept must have an rdfs:label" ;
    ] .

# Shape enforcing @type is always a list (validated programmatically)
# Note: JSON-LD @type arrays cannot be validated via SHACL directly;
# use scripts/validate_all.py for this check.

# Shape for generated Section instances. Target by sectionNumber so unresolved
# reference placeholders are not treated as concrete sections under RDFS inference.
estleg:SectionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf estleg:sectionNumber ;
    sh:property [
        sh:path estleg:sectionNumber ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "sectionNumber" ;
        sh:description "Section number must be a string" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for DraftLegislation instances
estleg:DraftLegislationShape
    a sh:NodeShape ;
    sh:targetClass estleg:DraftLegislation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every DraftLegislation must have a label (draft title)" ;
    ] ;
    sh:property [
        sh:path estleg:legislativePhase ;
        estleg:graphClosureExempt true ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "legislativePhase" ;
        sh:description "Every draft must have a legislative phase" ;
    ] ;
    sh:property [
        sh:path estleg:draftType ;
        estleg:graphClosureExempt true ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "draftType" ;
        sh:description "Every draft must have a type classification" ;
    ] ;
    sh:property [
        sh:path estleg:eisNumber ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "eisNumber" ;
        sh:description "EIS reference number (e.g., JDM/26-0268)" ;
    ] ;
    sh:property [
        sh:path estleg:eisLink ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:name "eisLink" ;
        sh:description "Direct link to the draft in EIS" ;
    ] ;
    sh:property [
        sh:path estleg:initiator ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "initiator" ;
        sh:description "Ministry or institution that initiated the draft" ;
    ] ;
    sh:property [
        sh:path estleg:publicationDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "publicationDate" ;
        sh:description "Date when the draft was published in EIS" ;
    ] ;
    sh:property [
        sh:path estleg:amendsLaw ;
        sh:nodeKind sh:IRI ;
        sh:name "amendsLaw" ;
        sh:description "Reference to existing law being amended" ;
    ] ;
    sh:property [
        sh:path estleg:affectedLawName ;
        sh:datatype xsd:string ;
        sh:name "affectedLawName" ;
        sh:description "Name of the law affected by this draft legislation" ;
    ] ;
    sh:property [
        sh:path estleg:changeType ;
        sh:datatype xsd:string ;
        sh:name "changeType" ;
        sh:description "Type of change proposed by draft: amends, repeals, supplements, enacts" ;
    ] .

# Shape for LegislativePhase instances
estleg:LegislativePhaseShape
    a sh:NodeShape ;
    sh:targetClass estleg:LegislativePhase ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every LegislativePhase must have a label" ;
