        sh:nodeKind sh:IRI ;
        sh:name "euInstitution" ;
        sh:description "EU institution that authored the act" ;
    ] ;
    sh:property [
        sh:path estleg:transposedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "transposedBy" ;
        sh:description "Estonian law that transposes this EU directive" ;
    ] .

