        sh:description "Normative type label (obligation, right, permission, prohibition)" ;
    ] .

# ============================================================
# DOMESTIC REGULATION SHAPES
# ============================================================
#
# These shapes cover Estonian domestic regulations (määrused)
# emitted by `scripts/generate_regulations.py`. They are deliberately
# distinct from `EULegislationShape`, which targets EU acts (regulations,
# directives, decisions). Domestic regulations are issued under an
# enabling Estonian law (typically by Vabariigi Valitsus, a minister, or
# a municipal council) and are modelled with `estleg:NationalRegulation`
# plus a more specific subclass (`GovernmentRegulation`,
# `MinisterialRegulation`, or `MunicipalRegulation`).
#
# Provisions of regulations are validated by the LegalProvisionShape
# above — they carry `estleg:paragrahv` and per-regulation classes like
# `estleg:Regulation_<terviktekstId>` that are declared as
# `rdfs:subClassOf estleg:LegalProvision`.

# Shape for NationalRegulation instances (and its subclasses).
#
# Targets the `estleg:NationalRegulation` class. Concrete regulation
# instances additionally declare one of `estleg:GovernmentRegulation`,
# `estleg:MinisterialRegulation`, or `estleg:MunicipalRegulation`; this
# shape applies to all of them via the shared base class.
estleg:NationalRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:NationalRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every NationalRegulation must have a label (regulation title)" ;
    ] ;
    sh:property [
        sh:path estleg:documentType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "documentType" ;
        sh:description "Document type label, e.g. 'määrus'" ;
    ] ;
    sh:property [
        sh:path estleg:terviktekstId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "terviktekstId" ;
        sh:description "Riigi Teataja consolidated-text group identifier (stable per regulation)" ;
    ] ;
    sh:property [
        sh:path estleg:globalId ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "globalId" ;
        sh:description "Riigi Teataja globalID for the concrete text/redaction" ;
    ] ;
    sh:property [
        sh:path estleg:isKov ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "isKov" ;
        sh:description "True when the issuer is a municipality (KOV); false for state-level regulations" ;
    ] ;
    sh:property [
        sh:path estleg:issuer ;
        sh:datatype xsd:string ;
        sh:name "issuer" ;
        sh:description "Issuing authority (e.g. 'Vabariigi Valitsus', 'Sotsiaalminister', a KOV name)" ;
    ] ;
    sh:property [
        sh:path estleg:actNumber ;
        sh:datatype xsd:string ;
        sh:name "actNumber" ;
        sh:description "Act number assigned by the issuer (e.g. '104', '199')" ;
    ] ;
    sh:property [
        sh:path estleg:preambleText ;
        sh:datatype xsd:string ;
        sh:name "preambleText" ;
        sh:description "Preamble text citing the enabling law/provision" ;
    ] ;
    sh:property [
        sh:path estleg:hasAnnex ;
        sh:nodeKind sh:IRI ;
        sh:name "hasAnnex" ;
        sh:description "Annex nodes attached to this regulation" ;
    ] ;
    sh:property [
        sh:path estleg:entryIntoForce ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "entryIntoForce" ;
        sh:description "Date when the regulation entered into force" ;
    ] ;
    sh:property [
        sh:path estleg:repealDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "repealDate" ;
        sh:description "Date when the regulation was repealed" ;
    ] ;
    sh:property [
        sh:path estleg:lastAmendmentDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "lastAmendmentDate" ;
        sh:description "Date of the most recent amendment" ;
    ] .

# Shape for GovernmentRegulation instances (Vabariigi Valitsus määrus).
# Concrete instances also carry estleg:NationalRegulation, so the
# constraints in NationalRegulationShape apply transitively. This shape
# exists so SHACL engines without subclass inference still pick the
# subclass up by class targeting.
estleg:GovernmentRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:GovernmentRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every GovernmentRegulation must have a label" ;
    ] .

# Shape for MinisterialRegulation instances (ministri määrus).
estleg:MinisterialRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:MinisterialRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every MinisterialRegulation must have a label" ;
    ] .

# Shape for MunicipalRegulation instances (KOV määrus).
# Phase 2 of the regulations integration plan; the class is declared now
# so MULTI_VALUED_PROPS and validators recognise it from the start.
estleg:MunicipalRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:MunicipalRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every MunicipalRegulation must have a label" ;
    ] .

# Shape for Annex instances (regulation lisa).
#
# Annex nodes are emitted by the regulation generator as separate
# named individuals and linked from the regulation via
# `estleg:hasAnnex`. They preserve a pointer to the original
# annex document on riigiteataja.ee in `dcterms:source`.
estleg:AnnexShape
    a sh:NodeShape ;
    sh:targetClass estleg:Annex ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Annex must have a label (annex title)" ;
    ] ;
    sh:property [
        sh:path estleg:annexNumber ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "annexNumber" ;
        sh:description "Annex number as printed in the regulation (e.g. 'Lisa 1', '2')" ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:nodeKind sh:IRI ;
        sh:name "source" ;
        sh:description "Optional IRI to the original annex document on riigiteataja.ee" ;
    ] .

# ---------------------------------------------------------------------------
# KOV integration Layer 1 shapes
# ---------------------------------------------------------------------------

estleg:MunicipalityShape
    a sh:NodeShape ;
    sh:targetClass estleg:Municipality ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://data\\.riik\\.ee/ontology/estleg#Municipality_EHAK_[0-9]{4}$" ;
    sh:property [
        sh:path estleg:ehakCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{4}$" ;
        sh:name "ehakCode" ;
    ] ;
    sh:property [
        sh:path estleg:county ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "county" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

estleg:IssuerShape
    a sh:NodeShape ;
    sh:targetClass estleg:Issuer ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://data\\.riik\\.ee/ontology/estleg#Issuer_[a-z0-9_]+$" ;
    sh:property [
        sh:path estleg:bodyType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("volikogu" "valitsus") ;
        sh:name "bodyType" ;
    ] ;
    sh:property [
        sh:path estleg:currentMunicipality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Municipality ;
        sh:name "currentMunicipality" ;
    ] ;
    sh:property [
        sh:path estleg:mappingSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "mappingSource" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

estleg:MunicipalRegulationLayer1Shape
    a sh:NodeShape ;
    sh:targetClass estleg:MunicipalRegulation ;
    sh:property [
        sh:path estleg:enactedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Issuer ;
        sh:name "enactedBy" ;
    ] ;
    sh:property [
        sh:path estleg:enactedByMunicipality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Municipality ;
        sh:name "enactedByMunicipality" ;
    ] ;
    sh:property [
        sh:path estleg:titleNormalized ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "titleNormalized" ;
    ] .

estleg:KovProvisionShape
    a sh:NodeShape ;
    sh:targetClass estleg:KovProvision ;
    sh:property [
        sh:path estleg:enactedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Issuer ;
        sh:name "enactedBy" ;
    ] ;
    sh:property [
        sh:path estleg:enactedByMunicipality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Municipality ;
        sh:name "enactedByMunicipality" ;
    ] ;
    sh:property [
        sh:path estleg:partOfAct ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Act ;
        sh:name "partOfAct" ;
    ] .

# CitationShape — Layer 2b populates instances; Layer 2a declares the shape.
#
# Note on citationTarget: we deliberately do NOT use sh:class
# estleg:LegalProvision for the target, mirroring the project-wide
# convention used by LegalProvisionShape (which uses
# sh:targetSubjectsOf estleg:paragrahv to dodge subclass-inference
# requirements). KovProvision instances are typed as
# estleg:KovProvision (and per-act subclasses) but not directly as
# estleg:LegalProvision; pyshacl with inference="rdfs" needs the
# subclass triples loaded into the data graph to resolve that.
# Validating only that citationTarget is an IRI (sh:nodeKind sh:IRI)
# avoids the brittleness; the LegalProvision range constraint is
# documented via rdfs:range in metadata.jsonld.
estleg:CitationShape
    a sh:NodeShape ;
    sh:targetClass estleg:Citation ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://data\\.riik\\.ee/ontology/estleg#Citation_[A-Za-z0-9_]+_[0-9]+$" ;
    sh:property [
        sh:path estleg:citationTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "citationTarget" ;
    ] ;
    sh:property [
        sh:path estleg:citationDetail ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "citationDetail" ;
    ] ;
    sh:property [
        sh:path estleg:citationText ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "citationText" ;
    ] .

