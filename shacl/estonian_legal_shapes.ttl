# Shape for CourtDecision instances.
# Enum-like IRI predicates must mark their property shape with
# estleg:graphClosureExempt true so the Seadusloome graph-closure gate
# does not require controlled-value individuals in the public load graph.
estleg:CourtDecisionShape
    a sh:NodeShape ;
    sh:targetClass estleg:CourtDecision ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every CourtDecision must have a label" ;
    ] ;
    sh:property [
        sh:path estleg:caseNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "caseNumber" ;
        sh:description "Court case number (e.g., 3-21-2176/52)" ;
    ] ;
    sh:property [
        sh:path estleg:caseType ;
        estleg:graphClosureExempt true ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "caseType" ;
        sh:description "Type of court case (criminal, civil, administrative, etc.)" ;
    ] ;
    sh:property [
        sh:path estleg:decisionDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "decisionDate" ;
        sh:description "Date of the court decision" ;
    ] ;
    sh:property [
        sh:path estleg:decisionLink ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:name "decisionLink" ;
        sh:description "Link to the full decision on riigikohus.ee" ;
    ] ;
    sh:property [
        sh:path estleg:interpretsLaw ;
        sh:nodeKind sh:IRI ;
        sh:name "interpretsLaw" ;
        sh:description """Provisions interpreted by this decision; for KOV citations the target may be a MunicipalRegulation act node when provision-level resolution is unavailable.""" ;
    ] ;
    # Issue #618 (interpretation staleness). All optional — only decisions
    # interpreting provisions that have version-sidecar data carry them.
    sh:property [
        sh:path estleg:interpretsVersion ;
        sh:nodeKind sh:IRI ;
        sh:name "interpretsVersion" ;
        sh:description "estleg:ProvisionVersion(s) in force at the decision date for the provisions this decision interpreted (#618). Stripped from combined; resolves on the full seadusloome load surface." ;
    ] ;
    sh:property [
        sh:path estleg:interpretationOutdated ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "interpretationOutdated" ;
        sh:description "True if at least one interpreted provision gained a later redaction after the decision date (#618)." ;
    ] ;
    sh:property [
        sh:path estleg:earliestSupersedingDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "earliestSupersedingDate" ;
        sh:description "Earliest post-decision redaction date among the interpreted provisions (#618)." ;
    ] ;
    sh:property [
        sh:path estleg:referencedLaw ;
        sh:datatype xsd:string ;
        sh:name "referencedLaw" ;
        sh:description "Name of the law referenced in this court decision" ;
    ] ;
    sh:property [
        sh:path estleg:rikObjectId ;
        sh:datatype xsd:string ;
        sh:name "rikObjectId" ;
        sh:description "Riigikohus object identifier" ;
    ] ;
    sh:property [
        sh:path estleg:legalText ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "legalText" ;
        sh:description "Optional full decision text scraped from the RIK detail page (rikos.rik.ee/?asjaNr=<case_nr>). Populated incrementally by generate_court_decisions.py --fetch-full-text (issue #135); decisions not yet fetched only carry estleg:summary. Plain xsd:string — never language-tagged." ;
    ] ;
    sh:property [
        sh:path estleg:decisionType ;
        estleg:graphClosureExempt true ;
        sh:nodeKind sh:IRI ;
        sh:name "decisionType" ;
        sh:description "Type of court decision (e.g., judgment, ruling, order)" ;
    ] .

# Shape for CaseType instances
estleg:CaseTypeShape
    a sh:NodeShape ;
    sh:targetClass estleg:CaseType ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for DecisionType instances
estleg:DecisionTypeShape
    a sh:NodeShape ;
    sh:targetClass estleg:DecisionType ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for EULegislation instances
estleg:EULegislationShape
    a sh:NodeShape ;
    sh:targetClass estleg:EULegislation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every EULegislation must have a label (Estonian title)" ;
    ] ;
    sh:property [
        sh:path estleg:celexNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "celexNumber" ;
        sh:description "CELEX identifier (e.g., 32016R0679)" ;
    ] ;
    sh:property [
        sh:path estleg:euDocumentType ;
        estleg:graphClosureExempt true ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "euDocumentType" ;
        sh:description "Type of EU legal act (Regulation, Directive, Decision)" ;
    ] ;
    sh:property [
        sh:path estleg:eurLexLink ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:name "eurLexLink" ;
        sh:description "Link to the act in EUR-Lex" ;
    ] ;
    sh:property [
        sh:path estleg:eliIdentifier ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:name "eliIdentifier" ;
        sh:description "European Legislation Identifier (ELI) URI" ;
    ] ;
    sh:property [
        sh:path estleg:documentDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "documentDate" ;
        sh:description "Date of the legal act" ;
    ] ;
    sh:property [
        sh:path estleg:transpositionDeadline ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "transpositionDeadline" ;
        sh:description "Deadline for member states to transpose this EU directive into national law (directives only; optional)" ;
    ] ;
    sh:property [
        sh:path estleg:inForce ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "inForce" ;
        sh:description "Whether the act is currently in force" ;
    ] ;
    sh:property [
        sh:path estleg:euInstitution ;
        estleg:graphClosureExempt true ;
        sh:nodeKind sh:IRI ;
        sh:name "euInstitution" ;
        sh:description "EU institution that authored the act" ;
    ] ;
    sh:property [
        sh:path estleg:transposedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "transposedBy" ;
        sh:description "Estonian law that transposes this EU directive" ;
    ] .

# Shape for HarmonisationLink instances (issue #197).
#
# `generate_harmonisation_links.py` writes two kinds of HarmonisationLink
# node into `krr_outputs/harmonisation/harmonisation_by_directive/*.json`:
#   * one aggregate node per directive (`estleg:Harmonisation_<celex>`)
#     carrying `estleg:sharedDirective` (the EU directive) and
#     `estleg:harmonises` (the Estonian act(s) that transpose it), and
#   * one node per neighbouring-country National Implementing Measure
#     (`estleg:Harm_<celex>_<COUNTRY3>_<n>`) carrying
#     `estleg:memberStateCode` + `estleg:nationalCelex` (+ optional
#     `dcterms:title` / `dcterms:date`).
# Since #425 the link→act back-edge in the harm files uses
# `estleg:harmonises` (HarmonisationLink → Act), the inverse of the
# `estleg:harmonisedWith` edge the law peeps carry (Act → HarmonisationLink);
# the two are declared with mutual `owl:inverseOf` in
# `harmonisation_schema.json`. Both directions are constrained below so a
# regression that re-uses `harmonisedWith` subject-side on a harm node still
# validates for nodeKind, while the canonical inverse is recognised too.
# Every property is therefore optional here so both shapes validate
# against this one NodeShape; only `rdfs:label` is required.
estleg:HarmonisationLinkShape
    a sh:NodeShape ;
    sh:targetClass estleg:HarmonisationLink ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every HarmonisationLink node must have a human-readable label" ;
    ] ;
    sh:property [
        sh:path estleg:sharedDirective ;
        sh:nodeKind sh:IRI ;
        sh:name "sharedDirective" ;
        sh:description "The EU directive that Estonia and the listed neighbouring state(s) both transpose" ;
    ] ;
    sh:property [
        sh:path estleg:harmonisedWith ;
        sh:nodeKind sh:IRI ;
        sh:name "harmonisedWith" ;
        sh:description "Legacy/inverse direction (Act → HarmonisationLink) the law peeps carry. On a harm node it would be the subject-side predicate; since #425 the canonical back-edge here is estleg:harmonises instead, but this stays constrained for nodeKind so a regression that re-introduces it is still type-checked." ;
    ] ;
    sh:property [
        sh:path estleg:harmonises ;
        sh:nodeKind sh:IRI ;
        sh:name "harmonises" ;
        sh:description "On the aggregate node: the Estonian act(s) that transpose the shared directive (HarmonisationLink → Act, #425). Inverse of estleg:harmonisedWith; multi-valued when several parts of a law transpose the same directive." ;
    ] ;
    sh:property [
        sh:path estleg:memberStateCode ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "memberStateCode" ;
        sh:description "ISO 3166-1 alpha-3 code of the neighbouring EU member state (LVA/LTU/FIN/SWE)" ;
    ] ;
    sh:property [
        sh:path estleg:nationalCelex ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "nationalCelex" ;
        sh:description "CELEX identifier of the neighbouring state's National Implementing Measure" ;
    ] ;
    sh:property [
        sh:path dcterms:date ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:string ] ) ;
        sh:name "date" ;
        sh:description "Document date of the neighbouring National Implementing Measure (issue #341): xsd:date when CELLAR supplies a strict YYYY-MM-DD value, otherwise a plain xsd:string fallback. sh:or pins it to one of those two datatypes so a stray IRI or other literal is rejected." ;
    ] .

# Shape for EUDocumentType instances
estleg:EUDocumentTypeShape
    a sh:NodeShape ;
    sh:targetClass estleg:EUDocumentType ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for EUInstitution instances
estleg:EUInstitutionShape
    a sh:NodeShape ;
    sh:targetClass estleg:EUInstitution ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for EUCourtDecision instances
estleg:EUCourtDecisionShape
    a sh:NodeShape ;
    sh:targetClass estleg:EUCourtDecision ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every EUCourtDecision must have a label (Estonian title)" ;
    ] ;
    sh:property [
        sh:path estleg:celexNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "celexNumber" ;
        sh:description "CELEX identifier for the court decision" ;
    ] ;
    sh:property [
        sh:path estleg:euCourtDecisionType ;
        estleg:graphClosureExempt true ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "euCourtDecisionType" ;
        sh:description "Type of court decision (Judgment, Order, AG Opinion, Court Opinion)" ;
    ] ;
    sh:property [
        sh:path estleg:euCourt ;
        estleg:graphClosureExempt true ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "euCourt" ;
        sh:description "EU court that delivered the decision" ;
    ] ;
    sh:property [
        sh:path estleg:ecliIdentifier ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        # Issue #612: enforce the European Case Law Identifier (ECLI) syntax
        # (Council 2011/C 127/01): ECLI:<country>:<court>:<year>:<ordinal>.
        # No sh:minCount — the source genuinely lacks an ECLI for a small number
        # of decisions and we do not fabricate one. Verified against the curia
        # bucket: all 22,225 present ecliIdentifier values already match.
        sh:pattern "^ECLI:[A-Z]{2}:[A-Za-z0-9]{1,7}:[0-9]{4}:[A-Za-z0-9.]{1,25}$" ;
        sh:name "ecliIdentifier" ;
        sh:description "ECLI identifier (e.g., ECLI:EU:C:2016:758)" ;
    ] ;
    sh:property [
        sh:path estleg:curiaLink ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:name "curiaLink" ;
        sh:description "Link to the decision in EUR-Lex" ;
    ] ;
    sh:property [
        sh:path estleg:documentDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "documentDate" ;
        sh:description "Date of the court decision" ;
    ] ;
    sh:property [
        sh:path estleg:euCaseNumber ;
        sh:datatype xsd:string ;
        sh:name "euCaseNumber" ;
        sh:description "EU case number(s), e.g. C-438/14. Multi-valued for joined cases (#606 item 5: 'Liidetud kohtuasjad C-403/08, C-429/08')." ;
    ] .

# Shape for EUCourtDecisionType instances
estleg:EUCourtDecisionTypeShape
    a sh:NodeShape ;
    sh:targetClass estleg:EUCourtDecisionType ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for EUCourt instances
estleg:EUCourtShape
    a sh:NodeShape ;
    sh:targetClass estleg:EUCourt ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] .

# Shape for AmendmentEvent instances.
#
# Every estleg:AmendmentEvent (88,962 in the committed corpus) carries
# exactly one estleg:amends pointer to the act it modifies; the
# constraints below pin the core predicates so a regression that emits
# amends as a plain string, types entryIntoForce as a literal string, or
# drops the RT reference is caught by the SHACL gate (issue #357).
estleg:AmendmentEventShape
    a sh:NodeShape ;
    sh:targetClass estleg:AmendmentEvent ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
    ] ;
    sh:property [
        sh:path estleg:amends ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "amends" ;
        sh:description "The act (or provision) this event amends. Present on 100% of AmendmentEvent nodes and always an IRI." ;
    ] ;
    sh:property [
        sh:path estleg:entryIntoForce ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "entryIntoForce" ;
        sh:description "Date the amendment entered into force (xsd:date)." ;
    ] ;
    sh:property [
        sh:path estleg:rtReference ;
        sh:datatype xsd:string ;
        sh:name "rtReference" ;
        sh:description "Riigi Teataja reference string for the amendment (e.g. 'RT I, 2024, ...')." ;
    ] ;
    sh:property [
        sh:path estleg:isCurrentAmendment ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "isCurrentAmendment" ;
        sh:description "Optional terminal-amendment marker (issue #389): true on the last in-force amendment after chronological sort, letting consumers find the latest amendment without a full date scan. Stamped by generate_amendment_history.py; absent on non-terminal events." ;
    ] .

# Shape for ProposedAmendment instances (issue #423).
#
# Draft-derived amendment nodes (AmendmentLink_Draft_*) reference EIS bills
# that were never enacted, so they are NOT effected legal changes and are
# typed estleg:ProposedAmendment (NOT estleg:AmendmentEvent) by
# generate_amendment_history.py. Act roots link to them via
# estleg:hasProposedAmendment (the inverse of estleg:proposesToAmend),
# never via the effected-only estleg:amendedBy.
#
# The shape pins the predicates the generator always emits (rdfs:label,
# estleg:amendingDraft) and the proposal-scoped optional ones
# (estleg:proposesToAmend, estleg:publicationDate), then FORBIDS the three
# effected-semantics predicates — estleg:amends, estleg:amendmentDate,
# estleg:isCurrentAmendment — via sh:maxCount 0. Those forbiddances are the
# regression guard: re-publishing a never-enacted draft as an effected,
# possibly current amendment (the pre-#423 bug) now fails the SHACL gate.
estleg:ProposedAmendmentShape
    a sh:NodeShape ;
    sh:targetClass estleg:ProposedAmendment ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every ProposedAmendment carries a human-readable label (e.g. 'Eelnõu muudatus: <draft title>')." ;
    ] ;
    sh:property [
        sh:path estleg:amendingDraft ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "amendingDraft" ;
        sh:description "The estleg:Draft_* bill this proposal derives from. Always present and an IRI." ;
    ] ;
    sh:property [
        sh:path estleg:proposesToAmend ;
        sh:nodeKind sh:IRI ;
        sh:name "proposesToAmend" ;
        sh:description "The act (or each part of a multipart act) the draft proposes to amend — IRI(s), the proposal-scoped counterpart of estleg:amends. Optional: omitted when the draft has no resolvable target act." ;
    ] ;
    sh:property [
        sh:path estleg:publicationDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "publicationDate" ;
        sh:description "The draft's EIS publication date (xsd:date), NOT an adoption/amendment date. Optional: undated drafts omit it." ;
    ] ;
    sh:property [
        sh:path estleg:amends ;
        sh:maxCount 0 ;
        sh:name "amends" ;
        sh:description "Forbidden on proposals (#423): estleg:amends asserts an EFFECTED change. A never-enacted draft must use estleg:proposesToAmend instead." ;
    ] ;
    sh:property [
        sh:path estleg:amendmentDate ;
        sh:maxCount 0 ;
        sh:name "amendmentDate" ;
        sh:description "Forbidden on proposals (#423): estleg:amendmentDate is reserved for adoption dates of effected amendments. A draft's date belongs in estleg:publicationDate." ;
    ] ;
    sh:property [
        sh:path estleg:isCurrentAmendment ;
        sh:maxCount 0 ;
        sh:name "isCurrentAmendment" ;
        sh:description "Forbidden on proposals (#423): the terminal-amendment marker applies to effected events only — a stalled draft must never appear as the current amendment." ;
    ] .

# ============================================================
# STRUCTURAL HIERARCHY SHAPES (issue #357)
# ============================================================
#
# Acts are partitioned into chapters (peatükk) and, within some chapters,
# divisions (jagu). These nodes (3,038 estleg:Chapter, 1,903
# estleg:Division in the committed corpus) had no SHACL constraint, so a
# regression dropping their label or mistyping the structural pointers
# passed CI silently. Both shapes require only the universally-present
# rdfs:label; the structural properties are constrained for type but left
# optional because a minority of nodes legitimately omit them
# (chapterNumber absent on ~20 chapters; isPartOf absent on ~59
# top-level divisions).

# Shape for Chapter (peatükk) instances.
estleg:ChapterShape
    a sh:NodeShape ;
    sh:targetClass estleg:Chapter ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Chapter must have an rdfs:label (e.g. '1. peatükk – ÜLDSÄTTED')." ;
    ] ;
    sh:property [
        sh:path estleg:chapterNumber ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "chapterNumber" ;
        sh:description "The chapter number as a display string (e.g. '1'). Optional — a few chapters carry only a label." ;
    ] .

# Shape for Division (jagu) instances.
estleg:DivisionShape
    a sh:NodeShape ;
    sh:targetClass estleg:Division ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Division must have an rdfs:label (e.g. '1. jagu – ...')." ;
    ] ;
    sh:property [
        sh:path estleg:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:name "isPartOf" ;
        sh:description "The parent estleg:Chapter (an IRI) this division belongs to. Optional — top-level divisions may omit it." ;
    ] .

# ============================================================
# NEW INTEGRATION SHAPES (Issues #29-#43)
# ============================================================

# Shape for Sanction instances
estleg:SanctionShape
    a sh:NodeShape ;
    sh:targetClass estleg:Sanction ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Sanction must have a label" ;
    ] ;
    sh:property [
        sh:path estleg:sanctionType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "imprisonment" "fine" "pecuniary_punishment" "arrest" "coercive_payment" ) ;
        sh:name "sanctionType" ;
        sh:description "Type of sanction: imprisonment, fine, pecuniary_punishment, arrest, coercive_payment" ;
    ] ;
    sh:property [
        sh:path estleg:maxPenalty ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "maxPenalty" ;
        sh:description "Maximum penalty, human-readable display string (e.g., '5 years', '300 fine units')" ;
    ] ;
    sh:property [
        sh:path estleg:applicableProvision ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "applicableProvision" ;
        sh:description "Provision that defines this sanction" ;
    ] ;
    sh:property [
        sh:path estleg:minPenalty ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "minPenalty" ;
        sh:description "Minimum penalty if specified, human-readable display string" ;
    ] ;
    # --- structured, computable penalty fields (issue #133) ---
    # All optional: a Sanction whose free-text penalty couldn't be
    # parsed carries only the display string above and still validates.
    sh:property [
        sh:path estleg:isStatutoryDefault ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "isStatutoryDefault" ;
        sh:description "True when the penalty value comes from a statutory ceiling rather than the provision text" ;
    ] ;
    sh:property [
        sh:path estleg:maxPenaltyAmount ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:name "maxPenaltyAmount" ;
        sh:description "Numeric value of the maximum penalty (e.g., 5, 300, 15000)" ;
    ] ;
    sh:property [
        sh:path estleg:minPenaltyAmount ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:name "minPenaltyAmount" ;
        sh:description "Numeric value of the minimum penalty" ;
    ] ;
    sh:property [
        sh:path estleg:maxPenaltyUnit ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "years" "months" "days" "daily_rates" "fine_units" "monetary" ) ;
        sh:name "maxPenaltyUnit" ;
        sh:description "Unit of the maximum penalty amount: years/months/days, daily_rates (KarS päevamäär), fine_units (väärteo trahviühik), or monetary (a fixed sum)" ;
    ] ;
    sh:property [
        sh:path estleg:minPenaltyUnit ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "years" "months" "days" "daily_rates" "fine_units" "monetary" ) ;
        sh:name "minPenaltyUnit" ;
        sh:description "Unit of the minimum penalty amount (same controlled set as maxPenaltyUnit)" ;
    ] ;
    sh:property [
        sh:path estleg:maxPenaltyCurrency ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "maxPenaltyCurrency" ;
        sh:description "Currency code for a monetary maximum penalty (e.g., 'EUR'); present only when maxPenaltyUnit is 'monetary'" ;
    ] ;
    sh:property [
        sh:path estleg:minPenaltyCurrency ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "minPenaltyCurrency" ;
        sh:description "Currency code for a monetary minimum penalty; present only when minPenaltyUnit is 'monetary'" ;
    ] .

# Shape for Institution instances
estleg:InstitutionShape
    a sh:NodeShape ;
    sh:targetClass estleg:Institution ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Institution must have a label" ;
    ] ;
    sh:property [
        sh:path estleg:competenceType ;
        sh:datatype xsd:string ;
        sh:in ( "supervision" "licensing" "enforcement" "regulation" "advisory" "general" ) ;
        sh:name "competenceType" ;
        sh:description "Type of competence: supervision, licensing, enforcement, regulation, advisory, general" ;
    ] ;
    sh:property [
        sh:path estleg:institutionType ;
        sh:datatype xsd:string ;
        sh:in ( "ministry" "agency" "court" "local_government" "parliament" "head_of_state" "government" ) ;
        sh:name "institutionType" ;
        sh:description "Coarse institution classification (issue #357): one of ministry, agency, court, local_government, parliament, head_of_state, government. Present on every materialised Institution; optional here so a fallback-materialised reference node without it still conforms." ;
    ] .

# Shape for reified institutional competence instances
estleg:CompetenceShape
    a sh:NodeShape ;
    sh:targetClass estleg:Competence ;
    sh:property [
        sh:path estleg:institution ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "institution" ;
        sh:description "Institution whose competence is being described" ;
    ] ;
    sh:property [
        sh:path estleg:competenceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "supervision" "licensing" "enforcement" "regulation" "advisory" "general" ) ;
        sh:name "competenceType" ;
        sh:description "Type of competence: supervision, licensing, enforcement, regulation, advisory, or general" ;
    ] ;
    sh:property [
        sh:path estleg:appliesToProvision ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "appliesToProvision" ;
        sh:description "Provision to which this competence applies" ;
    ] ;
    sh:property [
        sh:path estleg:appliesToProvisionCount ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:name "appliesToProvisionCount" ;
        sh:description "Full number of provisions covered by this competence, including any omitted from capped sidecar lists" ;
    ] ;
    sh:property [
        sh:path estleg:grantedBy ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:name "grantedBy" ;
        sh:description "The act under which this competence is granted, usually derived from the majority source act of appliesToProvision" ;
    ] ;
    sh:property [
        sh:path estleg:competenceArea ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "competenceArea" ;
        sh:description "Coarse thematic area for cross-institution grouping" ;
    ] .

# Shape for NormativeType instances
estleg:NormativeTypeShape
    a sh:NodeShape ;
    sh:targetClass estleg:NormativeType ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Normative type label (obligation, right, permission, prohibition)" ;
    ] .

# ============================================================
# DOMESTIC REGULATION SHAPES
# ============================================================
#
# These shapes cover Estonian domestic regulations (määrused)
# emitted by `scripts/generate_regulations.py`. They are deliberately
# distinct from `EULegislationShape`, which targets EU acts (regulations,
# directives, decisions). Domestic regulations are issued under an
# enabling Estonian law (typically by Vabariigi Valitsus, a minister, or
# a municipal council). Since #424 they share a common superclass
# `estleg:DomesticRegulation`, whose two sibling branches are
# `estleg:NationalRegulation` (state-level — Government / Ministerial
# regulations) and `estleg:MunicipalRegulation` (KOV regulations); a KOV
# määrus is therefore NOT a NationalRegulation (there is no entailment
# path between the siblings).
#
# `estleg:DomesticRegulation` is never stamped on instances and the SHACL
# gates run without inference, so `sh:targetClass estleg:DomesticRegulation`
# would match nothing. The shared "domestic regulation" constraints are
# therefore carried by the shape below targeting BOTH concrete classes
# directly (per the contract documented in generate_regulations.py).
#
# Provisions of regulations are validated by the LegalProvisionShape
# above — they carry `estleg:paragrahv` and per-regulation classes like
# `estleg:Regulation_<terviktekstId>` that are declared as
# `rdfs:subClassOf estleg:LegalProvision`.

# Shape for domestic regulations: the constraints shared by state-level
# and municipal regulations (#424).
#
# Targets both `estleg:NationalRegulation` and `estleg:MunicipalRegulation`
# directly. State regulations are typed NationalRegulation (plus a
# GovernmentRegulation / MinisterialRegulation subclass), KOV roots are
# typed MunicipalRegulation only; listing both target classes keeps these
# shared constraints applying to KOV roots under inference=none even though
# they no longer carry NationalRegulation typing (the dual-typing removed
# by the #424 backfill). The KOV-specific additions live in
# `MunicipalRegulationShape` / `MunicipalRegulationLayer1Shape` below.
estleg:NationalRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:NationalRegulation ;
    sh:targetClass estleg:MunicipalRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every NationalRegulation must have a label (regulation title)" ;
    ] ;
    sh:property [
        sh:path estleg:documentType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "documentType" ;
        sh:description "Document type label, e.g. 'määrus'" ;
    ] ;
    sh:property [
        sh:path estleg:terviktekstId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "terviktekstId" ;
        sh:description "Riigi Teataja consolidated-text group identifier (stable per regulation)" ;
    ] ;
    sh:property [
        sh:path estleg:globalId ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "globalId" ;
        sh:description "Riigi Teataja globalID for the concrete text/redaction" ;
    ] ;
    sh:property [
        sh:path estleg:isKov ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "isKov" ;
        sh:description "True when the issuer is a municipality (KOV); false for state-level regulations" ;
    ] ;
    sh:property [
        sh:path estleg:issuer ;
        sh:datatype xsd:string ;
        sh:name "issuer" ;
        sh:description "Issuing authority (e.g. 'Vabariigi Valitsus', 'Sotsiaalminister', a KOV name)" ;
    ] ;
    sh:property [
        sh:path estleg:actNumber ;
        sh:datatype xsd:string ;
        sh:name "actNumber" ;
        sh:description "Act number assigned by the issuer (e.g. '104', '199')" ;
    ] ;
    sh:property [
        sh:path estleg:preambleText ;
        sh:datatype xsd:string ;
        sh:name "preambleText" ;
        sh:description "Preamble text citing the enabling law/provision" ;
    ] ;
    sh:property [
        sh:path estleg:hasAnnex ;
        sh:nodeKind sh:IRI ;
        sh:name "hasAnnex" ;
        sh:description "Annex nodes attached to this regulation" ;
    ] ;
    sh:property [
        sh:path estleg:entryIntoForce ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "entryIntoForce" ;
        sh:description "Date when the regulation entered into force" ;
    ] ;
    sh:property [
        sh:path estleg:repealDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "repealDate" ;
        sh:description "Date when the regulation was repealed" ;
    ] ;
    sh:property [
        sh:path estleg:lastAmendmentDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "lastAmendmentDate" ;
        sh:description "Date of the most recent amendment" ;
    ] .

# Shape for GovernmentRegulation instances (Vabariigi Valitsus määrus).
# Concrete instances also carry estleg:NationalRegulation, so the
# constraints in NationalRegulationShape apply transitively. This shape
# exists so SHACL engines without subclass inference still pick the
# subclass up by class targeting.
estleg:GovernmentRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:GovernmentRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every GovernmentRegulation must have a label" ;
    ] .

# Shape for MinisterialRegulation instances (ministri määrus).
estleg:MinisterialRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:MinisterialRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every MinisterialRegulation must have a label" ;
    ] .

# Shape for MunicipalRegulation instances (KOV määrus).
# KOV roots are typed estleg:MunicipalRegulation (+ estleg:Act) only — a
# sibling of estleg:NationalRegulation under estleg:DomesticRegulation, not
# a subclass of it (#424). The constraints shared with state regulations
# (label, documentType, terviktekstId, …) are applied to KOV roots by
# NationalRegulationShape above, which now targets MunicipalRegulation too;
# this shape adds only the KOV-specific act-level properties.
estleg:MunicipalRegulationShape
    a sh:NodeShape ;
    sh:targetClass estleg:MunicipalRegulation ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every MunicipalRegulation must have a label" ;
    ] ;
    sh:property [
        sh:path estleg:interpretedBy ;
        sh:nodeKind sh:IRI ;
        sh:name "interpretedBy" ;
        sh:description """Court decisions that interpret this municipal act (act-level KOV citation).""" ;
    ] ;
    sh:property [
        sh:path estleg:regulationTypeBucket ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "regulationTypeBucket" ;
        sh:description """Optional Layer 3 regulation-type bucket label (e.g. "jaatmehoolduseeskiri" or "_uncategorized"), stamped by the KOV act-level similarity pass.""" ;
    ] ;
    sh:property [
        sh:path estleg:similarAct ;
        sh:nodeKind sh:IRI ;
        sh:name "similarAct" ;
        sh:description """Optional Layer 3 back-links to reified estleg:Similarity nodes for peer municipal acts.""" ;
    ] .

# Shape for Annex instances (regulation lisa).
#
# Annex nodes are emitted by the regulation generator as separate
# named individuals and linked from the regulation via
# `estleg:hasAnnex`. They preserve a pointer to the original
# annex document on riigiteataja.ee in `dcterms:source`.
estleg:AnnexShape
    a sh:NodeShape ;
    sh:targetClass estleg:Annex ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:name "label" ;
        sh:description "Every Annex must have a label (annex title)" ;
    ] ;
    sh:property [
        sh:path estleg:annexNumber ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "annexNumber" ;
        sh:description "Annex number as printed in the regulation (e.g. 'Lisa 1', '2')" ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:nodeKind sh:IRI ;
        sh:name "source" ;
        sh:description "Optional IRI to the original annex document on riigiteataja.ee" ;
    ] .

# ---------------------------------------------------------------------------
# KOV integration Layer 1 shapes
# ---------------------------------------------------------------------------

estleg:MunicipalityShape
    a sh:NodeShape ;
    sh:targetClass estleg:Municipality ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/estleg/Municipality_EHAK_[0-9]{4}$" ;
    sh:property [
        sh:path estleg:ehakCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{4}$" ;
        sh:name "ehakCode" ;
    ] ;
    sh:property [
        sh:path estleg:county ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "county" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

estleg:IssuerShape
    a sh:NodeShape ;
    sh:targetClass estleg:Issuer ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/estleg/Issuer_[a-z0-9_]+$" ;
    sh:property [
        sh:path estleg:bodyType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("volikogu" "valitsus") ;
        sh:name "bodyType" ;
    ] ;
    sh:property [
        sh:path estleg:currentMunicipality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Municipality ;
        sh:name "currentMunicipality" ;
    ] ;
    sh:property [
        sh:path estleg:mappingSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "mappingSource" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

# HistoricalMunicipalityShape — pre-merger KOV units (issue #130).
#
# A former Estonian municipality merged/abolished by a territorial
# reform (chiefly the 2017 haldusreform). One node per distinct
# pre-merger EHAK code, IRI form
# estleg:HistoricalMunicipality_<formerEhakCode>. estleg:succeededBy
# points at the surviving current municipality; it is only constrained
# to be an IRI here (not sh:class estleg:Municipality) — the live `kov`
# SHACL bucket also loads municipalities_peep.json so the link does
# resolve, but the IRI-only constraint keeps this shape independent of
# RDFS subclass inference, mirroring the convention used elsewhere in
# this file (CitationShape / AnnotationShape). estleg:municipalityType,
# when present, is one of "vald" | "linn".
estleg:HistoricalMunicipalityShape
    a sh:NodeShape ;
    sh:targetClass estleg:HistoricalMunicipality ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/estleg/HistoricalMunicipality_[0-9]{4}$" ;
    sh:property [
        sh:path estleg:formerEhakCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{4}$" ;
        sh:name "formerEhakCode" ;
        sh:description "The pre-merger four-digit EHAK code." ;
    ] ;
    sh:property [
        sh:path estleg:formerName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "formerName" ;
        sh:description "The pre-merger name including the unit-type word (e.g. \"Abja vald\")." ;
    ] ;
    sh:property [
        sh:path estleg:succeededBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "succeededBy" ;
        sh:description "The current estleg:Municipality (an IRI) that succeeded this unit." ;
    ] ;
    sh:property [
        sh:path estleg:mergedAt ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "mergedAt" ;
        sh:description "The merger/abolition effective date (2017-10-15 for haldusreform-2017 units). Absent ⇒ date undetermined." ;
    ] ;
    sh:property [
        sh:path estleg:mergerEvidence ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "mergerEvidence" ;
        sh:description "Free-text citation supporting the pre-merger identity and the successor mapping." ;
    ] ;
    sh:property [
        sh:path estleg:municipalityType ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "vald" "linn" ) ;
        sh:name "municipalityType" ;
        sh:description "The Estonian local-government unit type: \"vald\" or \"linn\"." ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .

estleg:MunicipalRegulationLayer1Shape
    a sh:NodeShape ;
    sh:targetClass estleg:MunicipalRegulation ;
    sh:property [
        sh:path estleg:enactedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Issuer ;
        sh:name "enactedBy" ;
    ] ;
    sh:property [
        sh:path estleg:enactedByMunicipality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Municipality ;
        sh:name "enactedByMunicipality" ;
    ] ;
    sh:property [
        sh:path estleg:titleNormalized ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "titleNormalized" ;
    ] .

estleg:KovProvisionShape
    a sh:NodeShape ;
    sh:targetClass estleg:KovProvision ;
    sh:property [
        sh:path estleg:enactedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Issuer ;
        sh:name "enactedBy" ;
    ] ;
    sh:property [
        sh:path estleg:enactedByMunicipality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Municipality ;
        sh:name "enactedByMunicipality" ;
    ] ;
    sh:property [
        sh:path estleg:partOfAct ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class estleg:Act ;
        sh:name "partOfAct" ;
    ] .

# CitationShape — Layer 2b populates instances; Layer 2a declares the shape.
#
# Note on citationTarget: we deliberately do NOT use sh:class
# estleg:LegalProvision for the target, mirroring the project-wide
# convention used by LegalProvisionShape (which uses
# sh:targetSubjectsOf estleg:paragrahv to dodge subclass-inference
# requirements). KovProvision instances are typed as
# estleg:KovProvision (and per-act subclasses) but not directly as
# estleg:LegalProvision; pyshacl with inference="rdfs" needs the
# subclass triples loaded into the data graph to resolve that.
# Validating only that citationTarget is an IRI (sh:nodeKind sh:IRI)
# avoids the brittleness; the LegalProvision range constraint is
# documented via rdfs:range in metadata.jsonld.
estleg:CitationShape
    a sh:NodeShape ;
    sh:targetClass estleg:Citation ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/estleg/Citation_[A-Za-z0-9_]+_[0-9]+$" ;
    sh:property [
        sh:path estleg:citationTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "citationTarget" ;
    ] ;
    sh:property [
        sh:path estleg:citationDetail ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "citationDetail" ;
    ] ;
    sh:property [
        sh:path estleg:citationText ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "citationText" ;
    ] .

# SimilarityShape — Layer 3 reified KOV act-level similarity link.
#
# Each estleg:Similarity node is emitted by the KOV act-level similarity
# pass (generate_similarity_index.py) and pointed at by an
# estleg:similarAct reference on the source MunicipalRegulation act node.
# similarTarget is validated only as an IRI (sh:nodeKind sh:IRI), mirroring
# CitationShape's note: peer targets may be KOV acts (typed
# estleg:MunicipalRegulation) or state acts (estleg:Act) and the Act range
# is documented via rdfs:range rather than enforced with sh:class to avoid
# requiring subclass inference in the data graph.
estleg:SimilarityShape
    a sh:NodeShape ;
    sh:targetClass estleg:Similarity ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://w3id\\.org/estleg/Similarity_" ;
    sh:property [
        sh:path estleg:similarTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "similarTarget" ;
    ] ;
    sh:property [
        sh:path estleg:similarityScore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:name "similarityScore" ;
    ] ;
    sh:property [
        sh:path estleg:similarityModel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "similarityModel" ;
    ] .

# ============================================================
# Versioned legal-text model — issue #131 (model only; population deferred)
# ============================================================
#
# An estleg:ProvisionVersion captures the text an estleg:LegalProvision
# carried during one Riigi Teataja consolidated-text redaction, plus the
# validity interval over which that text was in force. The redaction/version
# identity (the ProvisionVersion IRI) is deliberately separate from the
# stable provision identity (the LegalProvision IRI, reached via
# estleg:versionOf). No corpus instances exist yet — see the #131
# follow-up data-completeness issue for the ingestion plan; this shape
# is the model the ingestion must satisfy.
estleg:ProvisionVersionShape
    a sh:NodeShape ;
    sh:targetClass estleg:ProvisionVersion ;
    sh:property [
        sh:path estleg:versionOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "versionOf" ;
        sh:description "Exactly one estleg:LegalProvision this version belongs to (an IRI)." ;
    ] ;
    sh:property [
        sh:path estleg:versionValidFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        # Issue #393: interval must be ordered when both ends are present.
        # sh:lessThan is vacuously true if versionValidTo is absent, so
        # open-ended current versions remain valid.
        sh:lessThan estleg:versionValidTo ;
        sh:name "versionValidFrom" ;
        sh:description "Date this provision text became effective. Must precede versionValidTo when both are present (#393)." ;
    ] ;
    sh:property [
        sh:path estleg:versionValidTo ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "versionValidTo" ;
        sh:description "Date this provision text ceased to be in force. Absent ⇒ still current. Not required; when present it must be later than versionValidFrom." ;
    ] ;
    sh:property [
        sh:path estleg:versionText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "versionText" ;
        sh:description "The provision text at this redaction, verbatim." ;
    ] ;
    sh:property [
        sh:path estleg:versionRedactionId ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "versionRedactionId" ;
        sh:description "Riigi Teataja terviktekstID of the redaction that produced this text." ;
    ] ;
    sh:property [
        sh:path estleg:supersededByVersion ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "supersededByVersion" ;
        sh:description "The chronologically next estleg:ProvisionVersion of the same provision (an IRI). Absent on the current version." ;
    ] .

# ============================================================
# Practitioner annotation layer — issue #40 (model only; ingestion deferred)
# ============================================================
#
# An estleg:Annotation is a practitioner-facing note (guidance, commentary,
# practice note, warning, interpretation) attached to a legal entity — a
# Law, an estleg:LegalProvision, a MunicipalRegulation, a CourtDecision,
# an EU instrument, etc. estleg:annotates is intentionally only constrained
# to be an IRI here (not sh:class), mirroring the project-wide convention
# of avoiding sh:class on cross-typed targets. No corpus instances exist
# yet — see the #40 follow-up data-completeness issue for the source
# decision and ingestion plan.
estleg:AnnotationShape
    a sh:NodeShape ;
    sh:targetClass estleg:Annotation ;
    sh:property [
        sh:path estleg:annotates ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "annotates" ;
        sh:description "Exactly one legal entity this annotation is about (an IRI)." ;
    ] ;
    sh:property [
        sh:path estleg:annotationText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:name "annotationText" ;
        sh:description "The body of the annotation." ;
    ] ;
    sh:property [
        sh:path estleg:annotationType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "guidance" "commentary" "practice_note" "warning" "interpretation" ) ;
        sh:name "annotationType" ;
        sh:description "Category of the annotation: guidance, commentary, practice_note, warning, or interpretation." ;
    ] ;
    sh:property [
        sh:path estleg:annotationSource ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "annotationSource" ;
        sh:description "Where the note comes from, as a human-readable string (e.g. \"Õiguskantsler\", \"RT kommentaar\")." ;
    ] ;
    sh:property [
        sh:path estleg:annotationSourceUrl ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:name "annotationSourceUrl" ;
        sh:description "Optional link to the annotation's source document." ;
    ] ;
    sh:property [
        sh:path estleg:annotationDate ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:name "annotationDate" ;
        sh:description "Date the annotation was authored or published." ;
    ] .

# Closed IRI enum for estleg:referenceType (#513 T-Box).
# Existing unreified estleg:references edges do not carry this property;
# the shape only fires when a later emission pass asserts it.
estleg:ReferenceTypeConstraint
    a sh:NodeShape ;
    sh:targetSubjectsOf estleg:referenceType ;
    sh:property [
        sh:path estleg:referenceType ;
        estleg:graphClosureExempt true ;
        sh:nodeKind sh:IRI ;
        sh:in (
            estleg:RefType_Citation
            estleg:RefType_Repeal
            estleg:RefType_LegalBasis
            estleg:RefType_Exception
            estleg:RefType_Derogation
        ) ;
        sh:name "referenceType" ;
        sh:description "Closed citation/reference-edge type (#513 T-Box). Existing estleg:references edges remain untyped until a later emission pass." ;
    ] .
