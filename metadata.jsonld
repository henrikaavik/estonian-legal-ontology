      "@type": "dcat:Distribution",
      "dcterms:title": "Municipal regulations ontology (KOV)",
      "dcat:mediaType": "application/ld+json",
      "dcat:accessURL": {
        "@id": "https://github.com/henrikaavik/estonian-legal-ontology/tree/main/krr_outputs/regulations/kov"
