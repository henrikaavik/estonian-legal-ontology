      },
      "dcat:downloadURL": {
        "@id": "https://github.com/henrikaavik/estonian-legal-ontology/raw/main/krr_outputs/combined_ontology.jsonld"
      },
      "dcterms:description": "Enacted-law index records across the top-level law JSON-LD files (validated counts: estleg:lawIndexRecordCount and estleg:lawFileCount below); combined ontology artifact remains available for consumers that need a single file. Court-decision enum individuals (the estleg:caseType / estleg:decisionType targets estleg:CaseType_* and estleg:DecisionType_*) are defined in krr_outputs/riigikohus/riigikohus_schema.json, which is not merged into combined_ontology.jsonld; consumers that need to resolve those targets must load riigikohus_schema.json alongside the court-decision peeps.",
      "estleg:lawIndexRecordCount": 1145,
      "estleg:lawFileCount": 1190
    },
