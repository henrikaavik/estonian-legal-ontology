      "dcterms:description": "All JSON/JSON-LD files across enacted laws, domestic regulations, draft legislation, court decisions, EU legislation, EU court decisions, cross-border harmonisation links, practitioner annotations, controlled vocabularies, reports, and indexes. File count is the validated estleg:fileCount below.",
      "estleg:fileCount": 23114
    },
    {
      "@type": "dcat:Distribution",
      "dcterms:title": "Combined enacted laws ontology",
      "dcat:mediaType": "application/ld+json",
      "dcat:accessURL": {
